# Dependencies
node_modules/
npm-debug.log
yarn-debug.log
yarn-error.log
pnpm-debug.log

# Build
dist/
build/
.next/
out/
# CMake intermediate output -- appears under android/app/.cxx/ now that the real
# React Native Gradle Plugin's native build step actually runs (granite-adoption
# stage 2/3, 2026-07-12) -- see android/app/build.gradle.kts.
.cxx/
# brick-codegen output (granite-adoption stage 7, 2026-07-12) -- regenerated at
# build time by brick_modules.gradle (android/.brick/) and by the manual
# `brick-codegen` CLI run (packages/saronite/host-app/.brick/), same discipline
# as build/ above. See android/brownfield-module-stub/build.gradle.kts and
# packages/saronite/host-app/brick.json for where this is configured.
.brick/

# Environment
.env
.env.local
.env.*.local
.env.production.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Testing
coverage/
.nyc_output/

# Logs
logs/
*.log

# Temporary files
tmp/
temp/
*.tmp

# Docker
docker-compose.override.yml

# Database dumps -- not migration source. The blanket *.sql rule below silently
# excluded real Flyway migrations under db/migration/ until this fix (2026-07-11);
# the negation pattern keeps dump files ignored without doing that again.
*.sql
!**/db/migration/*.sql
!infra/mysql-init/*.sql
*.db
*.sqlite

# Backend demo persistence snapshot (not a real database)
backend/.data/

# Gradle (local build cache -- never commit, regenerated on first build)
.gradle/

# Mobile
ios/Pods/
android/local.properties

# Tuist-generated (2026-07-11) -- `tuist generate` produces these from ios/Project.swift
# and every ios/**/Sources/** file; regenerate with `tuist generate` (see
# docs/ARCHITECTURE.md §3 for the exact toolchain versions this environment needed),
# never hand-edit or commit them.
ios/*.xcodeproj/
ios/*.xcworkspace/
ios/Derived/

# CocoaPods (2026-07-16) -- `pod install` bridges GraniteBrownfield/BrickModule/React
# Native into the Tuist-generated Itunda.xcodeproj (see ios/Podfile's own comment and
# docs/ARCHITECTURE.md's mini-app host row for why). Podfile/Podfile.lock/.xcode.env are
# committed for reproducibility; these are machine-specific or deterministically
# regenerated by `pod install` itself, same reasoning as the Tuist block above.
ios/.xcode.env.local
ios/PrivacyInfo.xcprivacy

# OS
.DS_Store
Thumbs.db

# Local Redis dump generated by a locally-running redis-server during dev/verification
dump.rdb

# Claude Code local (personal, not shared) settings
.claude/settings.local.json

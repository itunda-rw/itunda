source 'https://cdn.cocoapods.org/'

require_relative '../packages/saronite/node_modules/react-native/scripts/react_native_pods'

platform :ios, min_ios_version_supported
prepare_react_native_project!

# Real, definitive root cause (2026-07-17) for a whole chain of downstream crashes/
# fallbacks this file's own history documents (RNCSafeAreaProvider's legacy event-dispatch
# crash, RNSScreenStackHeaderSubview's "RCTView setType:" crash): react-native-safe-area-
# context's and react-native-screens' own podspecs gate their *real* Fabric component
# source files (react-native-safe-area-context.podspec's `ios/Fabric/**`,
# RNScreens.podspec's new-arch-only sources) behind `ENV['RCT_NEW_ARCH_ENABLED'] == '1'`
# checked at `pod install` time -- a Ruby/CocoaPods-time env var, completely separate from
# the `OTHER_CPLUSPLUSFLAGS`/`OTHER_SWIFT_FLAGS` build-time flags `use_react_native!`
# already sets correctly below. Without this, both podspecs silently compile only their
# legacy (pre-Fabric) Objective-C classes; at runtime RN's real component registry finds
# no Fabric class, falls back to `RCTLegacyViewManagerInteropComponentView`, and every
# prop/event mismatch between that fallback and what Fabric's own codegen expects surfaces
# as a real crash. Confirmed directly by reading both podspecs' own `fabric_enabled =
# ENV['RCT_NEW_ARCH_ENABLED'] == '1'` lines.
ENV['RCT_NEW_ARCH_ENABLED'] = '1'

# Bridges CocoaPods into Tuist's generated Itunda.xcodeproj/Itunda.xcworkspace
# (Tuist 3.x dropped native CocoaPods integration -- no `.cocoapods()` path in
# Dependencies.swift -- so this points a standalone Podfile at the already-generated
# project the same way apps did before Tuist ever had built-in CocoaPods support).
# Regenerating via `tuist generate` overwrites Itunda.xcodeproj; re-run `pod install`
# immediately after any `tuist generate` to reintegrate.
project 'Itunda.xcodeproj'

target 'ItundaApp' do
  use_react_native!(
    path: '../packages/saronite/node_modules/react-native',
    app_path: '../packages/saronite/host-app',
    config_file_dir: '../packages/saronite/host-app'
  )

  pod 'BrickModule', :path => '../packages/saronite/node_modules/brick-module'
  pod 'GraniteBrownfield', :path => '../packages/saronite/node_modules/@granite-js/brownfield-module'
  # Real `brick-codegen --platform ios` output (regenerate via
  # `cd packages/saronite/host-app && node ../node_modules/.bin/brick-codegen
  # --platform ios --output-ios ../../../ios/.brick --projectRoot .` whenever a
  # mini-app's *.brick.ts spec changes) -- its own podspec is the sanctioned
  # integration path (mirrors android/.brick's own separate-module convention),
  # not something to hand-merge into App/Sources.
  pod 'BrickCodegen', :path => '.brick'

  # Real RN third-party native deps pay-bills (via granite/React Native core) actually
  # renders with -- confirmed live: without these, the mini-app screen rendered a real
  # "Unimplemented component: <RNCSafeAreaProvider>" error instead of real content, the
  # same class of missing-native-dependency/autolinking gap Android's pay-bills hit
  # originally (see docs/ARCHITECTURE.md's mini-app host row). Added explicitly by path
  # rather than via `use_native_modules!`'s CLI-based autodiscovery, which needs a
  # `react-native config` run from `host-app`'s own directory -- more moving parts for the
  # same three, already-known dependencies `host-app/package.json` lists.
  #
  # react-native-safe-area-context's onInsetsChange dispatch was patched at one point
  # (a legacy RCTEventDispatcher call itunda's bridgeless RCTHost couldn't handle) --
  # that patch is gone now: the real cause was this pod's own Fabric component never
  # being compiled at all (see the ENV['RCT_NEW_ARCH_ENABLED'] fix above), and once it
  # is, the real Fabric component's own event emission works correctly on its own.
  pod 'react-native-safe-area-context', :path => '../packages/saronite/node_modules/react-native-safe-area-context'
  pod 'RNScreens', :path => '../packages/saronite/node_modules/react-native-screens'
  pod 'RNSVG', :path => '../packages/saronite/node_modules/react-native-svg'

  # Real self-hosted Rwanda map (2026-07-19) -- itunda's own MapLibre GL tile server
  # (see docs/TOSS_PARITY_MATRIX.md's Maps row), not Google/Apple Maps. Real CocoaPods
  # trunk pod, same integration mechanism as every other pod in this file.
  pod 'MapLibre'

  post_install do |installer|
    react_native_post_install(
      installer,
      '../packages/saronite/node_modules/react-native',
      mac_catalyst_enabled: false
    )
  end
end

# Real Maps Feature-module extraction (2026-08-19) -- MapScreenView.swift moved from
# App/Sources into Features/Maps/Sources (see Project.swift's own featureModules doc
# comment). CocoaPods integration here is per-Tuist-target, not global (see this
# Podfile's own header comment on why Tuist 3.x needs this separate bridge) -- ItundaApp's
# own `pod 'MapLibre'` above only links MapLibre.framework for that target, so the new
# FeatureMaps target needs its own real declaration or `import MapLibre` fails to link.
target 'FeatureMaps' do
  pod 'MapLibre'
end

# Real Eats Feature-module extraction (2026-09-06, Eats product-completeness pass) --
# EatsOrders.swift's live rider-tracking (LiveRiderMiniMap.swift, Eats-only, moved
# alongside it) imports MapLibre directly, same per-Tuist-target CocoaPods
# integration requirement as FeatureMaps above.
target 'FeatureEats' do
  pod 'MapLibre'
end

# RouteMiniMap.swift promoted from App/Sources into Core/DesignSystem/Sources/
# Components (same pass) -- it's real, genuinely shared (3 still-App-only Hood
# screens -- Jobs/Marketplace/Property -- use it besides Eats), so it moved to
# CoreDesignSystem instead of FeatureEats. Its own `import MapLibre` needs the
# same per-target declaration.
target 'CoreDesignSystem' do
  pod 'MapLibre'
end

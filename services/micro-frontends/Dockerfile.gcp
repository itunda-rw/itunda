# Itunda customer web app for Google Cloud Run.
# Builds the same customer surface as scripts/cloudflare-build-web-app.sh,
# then serves the static SPA + bundled Module Federation remotes with nginx.

FROM node:22-alpine AS builder
WORKDIR /app

COPY . .
RUN corepack enable && yarn install --immutable

ARG VITE_API_BASE_URL=https://itunda-api-hptgu43hsa-du.a.run.app
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}

RUN yarn workspace host-app build
RUN yarn workspace maps-mfe build
RUN yarn workspace bank-mfe build
RUN yarn workspace kyc-mfe build

RUN rm -rf services/micro-frontends/host-app/dist/remotes \
 && mkdir -p services/micro-frontends/host-app/dist/remotes \
 && cp -R services/micro-frontends/maps-mfe/dist/. services/micro-frontends/host-app/dist/remotes/maps/ \
 && cp -R services/micro-frontends/bank-mfe/dist/. services/micro-frontends/host-app/dist/remotes/bank/ \
 && cp -R services/micro-frontends/kyc-mfe/dist/. services/micro-frontends/host-app/dist/remotes/kyc/ \
 && test -s services/micro-frontends/host-app/dist/index.html \
 && test -s services/micro-frontends/host-app/dist/remotes/maps/index.html \
 && test -s services/micro-frontends/host-app/dist/remotes/bank/index.html \
 && test -s services/micro-frontends/host-app/dist/remotes/kyc/index.html \
 && node -e 'const fs=require("fs"); const path=require("path"); for (const root of ["services/micro-frontends/host-app/dist","services/micro-frontends/host-app/dist/remotes/maps","services/micro-frontends/host-app/dist/remotes/bank","services/micro-frontends/host-app/dist/remotes/kyc"]) { const html=fs.readFileSync(path.join(root,"index.html"),"utf8"); const scripts=[...html.matchAll(/<script[^>]+src="([^"]+)"/g)].map(m=>m[1]); for (const src of scripts) { if (src.startsWith("http")) continue; const rel=src.replace(/^\\//,""); const candidate=path.join("services/micro-frontends/host-app/dist",rel); if (!fs.existsSync(candidate)) throw new Error("Missing script referenced by "+path.join(root,"index.html")+": "+src); } }'

FROM nginx:1.27-alpine
COPY services/micro-frontends/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/services/micro-frontends/host-app/dist /usr/share/nginx/html
EXPOSE 80

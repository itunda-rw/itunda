# Production Itunda Business web image for Cloud Run.
# Builds the standalone merchant-mfe and serves it as its own first-class frontend.
FROM node:22-alpine AS builder
WORKDIR /app

COPY . .
RUN corepack enable && yarn install --immutable

ARG VITE_API_BASE_URL=https://itunda-api-hptgu43hsa-du.a.run.app
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}

RUN yarn workspace merchant-mfe build
RUN test -s services/micro-frontends/merchant-mfe/dist/index.html

FROM nginx:1.27-alpine
COPY services/micro-frontends/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/services/micro-frontends/merchant-mfe/dist /usr/share/nginx/html
EXPOSE 80

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.itunda.woodpecker-exec-agent</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>REPO_ROOT/scripts/woodpecker-exec-agent-run.sh</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/tmp/itunda-woodpecker-exec-agent.launchd.log</string>
	<key>StandardErrorPath</key>
	<string>/tmp/itunda-woodpecker-exec-agent.launchd.log</string>
</dict>
</plist>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.itunda.private-cloud-drills</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>REPO_ROOT/scripts/private-cloud-scheduled-drills.sh</string>
		<string>run</string>
	</array>
	<key>StartInterval</key>
	<integer>21600</integer>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardOutPath</key>
	<string>/tmp/itunda-private-cloud-drills.launchd.log</string>
	<key>StandardErrorPath</key>
	<string>/tmp/itunda-private-cloud-drills.launchd.log</string>
</dict>
</plist>

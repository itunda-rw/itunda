# Config for the macOS "local"-backend Woodpecker agent that runs ios-build --
# see infra/ci/docker-compose.yml's own doc comment for why this one can't be the
# Docker-based agent (Xcode has no Linux container image). Copy to
# infra/ci/woodpecker-exec-agent.env (gitignored, never commit real values) and
# fill in real values before running scripts/woodpecker-exec-agent-install.sh.
#
# SECURITY NOTE (real, not boilerplate): Woodpecker's "local" backend runs every
# pipeline step directly on this host with NO container isolation, as whatever
# user this agent process runs as. Anyone who can merge a change to .woodpecker.yml
# can run arbitrary shell commands on this specific Mac. Only run this on a machine
# you're deliberately dedicating to CI, and keep WOODPECKER_ADMIN in
# infra/ci/.env.example scoped to genuinely trusted accounts.

# Must point at the SAME server the Docker-based agent connects to
# (infra/ci/docker-compose.yml's woodpecker-server) -- host:port, gRPC, not https://.
WOODPECKER_SERVER=your-ci-host.example:9000

# Must be the exact same value as WOODPECKER_AGENT_SECRET in infra/ci/.env --
# both agents authenticate to the one server with this shared secret.
WOODPECKER_AGENT_SECRET=same-value-as-infra-ci-.env

# Selects the non-Docker execution path this whole file exists for. Woodpecker
# auto-labels this agent `backend=local` once set here -- no need to also set
# WOODPECKER_AGENT_LABELS for .woodpecker.yml's ios-build job to route to it.
WOODPECKER_BACKEND=local

# Woodpecker CI configuration -- see infra/ci/docker-compose.yml's own doc comment
# for the full architecture. Copy to infra/ci/.env and fill in real values; never
# commit the real .env (already covered by the repo's root .gitignore pattern for
# *.env, but double-check before a first commit from this directory).

# The two accounts allowed to log in at all (WOODPECKER_OPEN=false means everyone
# else is rejected, even with a valid GitHub account). Comma-separated GitHub
# usernames, not display names -- "partoftrue" confirmed via git log/CONTRIBUTORS.md;
# add the second contributor's real GitHub login here once confirmed (their commits
# show a display name "에릭" with a local-machine email, not a GitHub-linked one --
# don't guess a username).
WOODPECKER_ADMIN=partoftrue

# Public address GitHub's webhook delivery and OAuth redirect need to reach --
# <scheme>://<hostname>, no trailing slash. See this directory's README for where
# to point this (NOT itunda-dc-a, the shared production node -- deploy this compose
# file to separate infrastructure, then use that host's own public address here).
WOODPECKER_HOST=https://your-ci-host.example

# From a new GitHub OAuth App (https://github.com/settings/applications/new,
# org owner: create under the itunda-rw org settings instead so it's not tied to a
# personal account) -- Woodpecker cannot create this itself, GitHub has no API for
# OAuth App creation. Homepage URL = WOODPECKER_HOST above. Authorization callback
# URL = WOODPECKER_HOST + /authorize (e.g. https://your-ci-host.example/authorize).
WOODPECKER_GITHUB_CLIENT=your-oauth-app-client-id
WOODPECKER_GITHUB_SECRET=your-oauth-app-client-secret

# Shared secret every agent (both this compose file's Docker agent and the separate
# macOS exec-agent in woodpecker-exec-agent.env.example) uses for its initial
# handshake with the server. Generate with `openssl rand -hex 32`, never reuse a
# secret from another system.
WOODPECKER_AGENT_SECRET=generate-with-openssl-rand-hex-32

# Signs the agent<->server gRPC session JWTs issued AFTER the handshake above --
# distinct from WOODPECKER_AGENT_SECRET. Left unset, the server picks a new random
# one on every restart (confirmed via a local dry-run, 2026-09-04), forcing every
# agent to reauthenticate each time -- harmless for this single-server setup, but
# avoidable. Generate with `openssl rand -hex 32`, same as above but a separate value.
WOODPECKER_GRPC_SECRET=generate-with-openssl-rand-hex-32

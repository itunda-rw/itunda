{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    // Was "pages" while app.tsx/require.context.ts/router.gen.ts (package
    // root, not pages/) were excluded -- now included, rootDir has to cover
    // the package root too.
    "rootDir": "."
  },
  // app.tsx/require.context.ts/router.gen.ts re-included (2026-07-13): the
  // real upstream TurboModuleRegistry timing bug they were blocked on is
  // fixed (see patches/brick-module+0.5.2.patch and pages/index.tsx's own
  // header comment for the full account).
  "include": ["pages", "app.tsx", "require.context.ts", "router.gen.ts"]
}

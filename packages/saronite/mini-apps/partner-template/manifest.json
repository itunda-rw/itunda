{
  "$schema": "https://raw.githubusercontent.com/itunda-rw/itunda/main/packages/saronite/mini-apps/partner-template/manifest.schema.json",
  "manifestVersion": 1,
  "id": "rw.example.partner",
  "name": "Partner Example",
  "version": "0.1.0",
  "category": "PRODUCTIVITY",
  "description": "Example Apps in Itunda mini-app.",
  "entry": {
    "type": "saronite",
    "bundleUrl": "https://example.com/itunda-mini-app.bundle.js"
  },
  "icon": {
    "url": "https://example.com/icon.png"
  },
  "permissions": [],
  "brandTheme": {
    "themeId": "partner-example",
    "light": {
      "brand": "#8F89FF",
      "brandStrong": "#6F67E8",
      "brandSurface": "#F1EFFF",
      "onBrand": "#FFFFFF",
      "focus": "#6F67E8",
      "pressed": "#7D77F7"
    },
    "dark": {
      "brand": "#A6A2FF",
      "brandStrong": "#B0AEFF",
      "brandSurface": "#25252D",
      "onBrand": "#191F28",
      "focus": "#B0AEFF",
      "pressed": "#A6A2FF"
    }
  }
}

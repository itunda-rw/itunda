      "focus": "#4F46E5",
      "pressed": "#4338CA"
    },
    "dark": {
      "brand": "#A5B4FC",
      "brandStrong": "#C7D2FE",
      "brandSurface": "#312E81",
      "onBrand": "#111827",
      "focus": "#C7D2FE",
      "pressed": "#A5B4FC"

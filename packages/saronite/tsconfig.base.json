{
  // Extends the real, official @react-native/typescript-config@0.84.0 (granite-
  // adoption stage 3, 2026-07-12) rather than a hand-picked subset of its options --
  // a hand-picked jsx+customConditions pair (tried first) still left real component
  // types (View/Text/etc.) failing to satisfy JSX.ElementClass under @types/react
  // 19.2.x, meaning some other option in the official config matters too. Using the
  // real package directly removes the risk of silently omitting one.
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "declaration": true,
    "forceConsistentCasingInFileNames": true
  }
}

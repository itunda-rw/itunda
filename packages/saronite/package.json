{
  "name": "saronite",
  "private": true,
  "version": "0.1.0",
  "description": "Mini-app SDK for itunda, modeled on Toss's Granite framework",
  "workspaces": [
    "packages/*",
    "mini-apps/*",
    "host-app",
    "devtools"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "postinstall": "patch-package",
    "validate:manifest": "node ./scripts/validate-sdk-manifest.mjs"
  },
  "devDependencies": {
    "patch-package": "^8.0.1"
  },
  "packageManager": "yarn@4.17.0"
}

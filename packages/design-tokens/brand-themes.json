{
  "$comment": "Platform-neutral IDS brand theme contract. Apps may customize semantic brand expression while IDS keeps component anatomy, typography, spacing, interaction states, accessibility and non-brand semantics shared.",
  "version": "1.0.0",
  "roles": ["brand", "brandStrong", "brandSurface", "onBrand", "focus", "pressed"],
  "default": "itunda",
  "themes": {
    "itunda": {
      "light": {
        "brand": "#7472F4",
        "brandStrong": "#625FE6",
        "brandSurface": "#F0EFFF",
        "onBrand": "#FFFFFF",
        "focus": "#7472F4",
        "pressed": "#625FE6"
      },
      "dark": {
        "brand": "#9B98FF",
        "brandStrong": "#B0AEFF",
        "brandSurface": "#27244A",
        "onBrand": "#191F28",
        "focus": "#B0AEFF",
        "pressed": "#9B98FF"
      }
    }
  }
}

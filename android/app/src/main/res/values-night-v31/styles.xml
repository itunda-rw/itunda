<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ splash: transparent logo (same drawable as the launcher foreground) on the app's own
         background, so it follows light and dark. -->
    <style name="Theme.Itunda" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">#17171C</item>
        <item name="android:navigationBarColor">#17171C</item>
        <item name="android:statusBarColor">#17171C</item>
        <item name="android:windowSplashScreenBackground">#17171C</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>
</resources>

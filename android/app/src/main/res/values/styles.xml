<resources>
    <!--
      ReactActivity requires a Theme.AppCompat descendant; itunda's main app is
      100% Compose and had no AppCompat theme anywhere. Applied only to the
      mini-app Activities in AndroidManifest.xml; MainActivity's default
      theme is untouched.
    -->
    <style name="Theme.Itunda.MiniApp" parent="Theme.AppCompat.Light.NoActionBar" />

    <!-- Real day/night-aware app theme (2026-07-24), fixing a real bug: the
         application element in AndroidManifest.xml hardcoded
         Theme.Material.Light.NoActionBar regardless of system dark mode, while
         IdsTheme's own Compose-level dark/light logic (isSystemInDarkTheme())
         was completely independent of it. Any screen that forgot to paint its
         own background fell through to this hardcoded light windowBackground
         even in dark mode, showing a cream flash instead of
         Ids.colors.background, matching IdsLightSemanticColors.background
         exactly; see values-night/styles.xml for the dark match.

         Real fix (2026-08-24, direct user directive, real Toss/Coupang
         screenshots): was #F2F4F6, stale after IdsSemanticColors.kt's own
         2026-08-24 fix moved IdsLightSemanticColors.background to white
         (0xFFFFFFFF), since this file has its own separate hardcoded copy the
         Kotlin-side fix doesn't reach, so the SYSTEM status bar and SYSTEM
         navigation bar (native Android chrome, outside Compose) stayed grey
         while the in-app content turned white, the exact "bars don't match
         content" seam the user's reference screenshots show real Toss/Coupang
         never has. -->
    <style name="Theme.Itunda" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">#FFFFFF</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:statusBarColor">#FFFFFF</item>
    </style>
</resources>

#phone .bdnew .bdr{background:var(--tint);border-radius:16px;padding:14px 16px;gap:12px;align-items:center}
#phone .bdnew .bdr .ico{width:44px;height:44px;border-radius:22px;background:var(--bg,#fff);flex:none}
#phone .bdnew .bdr .t{text-wrap:balance;white-space:normal!important;overflow:visible!important;text-overflow:clip!important;font-size:16px;line-height:21px;font-weight:800}
#phone .bdnew .bdr .s{font-size:14px;margin-top:2px;color:var(--lk);font-weight:600}
#phone .bdnew .bdr:active{background:var(--chip)}
</style>
<style id="v193">
/* v193: tap targets, part 2. Chips, small tabs and icon buttons keep their look but get an invisible hit area of about 44px (set by the script below; areas stop short of neighbours). Explore: "Microloan" and "Down payment" were squeezed to "Micro…" next to long titles; in English the title now wraps and the label keeps its full width (fr/rw already show the hint under the title). */
#phone .v193h::after{content:"";position:absolute;inset:calc(var(--hy,0px)*-1) calc(var(--hx,0px)*-1)}
html:lang(en) #phone .xc .ar .t{flex:1 1 0;min-width:0;white-space:normal}
html:lang(en) #phone .xc .ar .s{flex:0 0 auto;margin-left:12px;white-space:nowrap}
</style>
<script>
/* v193 script: marks every visible control under 44px (not already given a hit area) with .v193h and sets how far its hit area extends. Runs after each render. */
(function(){
const SEL='button,a,[onclick],[role=button],.tap,.cch,.chip,.ocp,.go,.pkf,.ib,.sw,.qm,.mm-more';
function fix(){
 const ph=document.getElementById('phone');if(!ph)return;
 ph.querySelectorAll(SEL).forEach(el=>{
  if(el.dataset.h44||el.closest('.tabs'))return;
  const r=el.getBoundingClientRect();if(!r.width||!r.height)return;
  el.dataset.h44='1';
  if(r.height>=44&&r.width>=44)return;
  const cs=getComputedStyle(el);
  if(cs.pointerEvents==='none'||cs.display==='inline')return;
  if(getComputedStyle(el,'::after').content!=='none')return;
  if(cs.position==='static')el.style.position='relative';
  const hy=Math.min(12,Math.max(0,(44-r.height)/2)),hx=Math.min(4,Math.max(0,(44-r.width)/2));
  el.style.setProperty('--hy',hy+'px');el.style.setProperty('--hx',hx+'px');el.classList.add('v193h');
 });
}
/* A tight wrapper that clips (a row that scrolls sideways, a tab strip) also clips the hit area of its children, cutting a chip's 44px back to the wrapper's height. Wrappers get only the padding they are missing above and below, and take it back with negative margin: nothing moves, the hit area fits. */
function pad(){
 const ph=document.getElementById('phone');if(!ph)return;
 ph.querySelectorAll('.hit44a,.hit44b,.v193h').forEach(el=>{
  const er=el.getBoundingClientRect();if(!er.height||er.height>=44)return;
  const e=Math.min(12,(44-er.height)/2);
  let s=el.parentElement;
  while(s&&s!==ph){
   const cs=getComputedStyle(s);
   if(cs.overflowX!=='visible'||cs.overflowY!=='visible'){
    const sr=s.getBoundingClientRect();
    if(sr.height>120||s.dataset.h44s)break;
    s.dataset.h44s='1';
    const dT=Math.max(0,Math.ceil(e-(er.top-sr.top-parseFloat(cs.borderTopWidth)))),
          dB=Math.max(0,Math.ceil(e-(sr.bottom-parseFloat(cs.borderBottomWidth)-er.bottom)));
    if(dT||dB){
     s.style.boxSizing='border-box';
     s.style.height=(sr.height+dT+dB)+'px';
     s.style.paddingTop=(parseFloat(cs.paddingTop)+dT)+'px';
     s.style.paddingBottom=(parseFloat(cs.paddingBottom)+dB)+'px';
     s.style.marginTop=(parseFloat(cs.marginTop)-dT)+'px';
     s.style.marginBottom=(parseFloat(cs.marginBottom)-dB)+'px';
    }
    break;
   }
   s=s.parentElement;
  }
 });
}
let q=0;new MutationObserver(()=>{if(q)return;q=setTimeout(()=>{q=0;try{fix();pad()}catch(e){}},600)}).observe(document.getElementById('phone'),{childList:true,subtree:true});
try{fix();pad()}catch(e){}
document.title='itunda, clickable prototype v193';
})();
</script>
<style id="v194">
/* v194: Maps. Place: Depart and Arrive sit on one row and Share, Call and Follow on the next, so all five are visible (Call and Follow were off-screen in a sideways-scrolling row). Directions: the four travel modes share the width, so bike no longer runs off the edge. Search: each recent place has an icon that fits it (cafe, clinic, market, bus, address) instead of the same house for all. Place photos: the first was a house for a cafe, now a coffee cup, and the photos are named for screen readers. */
#phone .acts:has(>button:nth-child(5)):not(:has(>button:nth-child(6))){display:grid;grid-template-columns:repeat(6,1fr);gap:8px;overflow:visible}
#phone .acts:has(>button:nth-child(5)):not(:has(>button:nth-child(6)))>button{grid-column:span 2;flex:none;width:auto;min-width:0;padding:0 8px;white-space:nowrap}
#phone .acts:has(>button:nth-child(5)):not(:has(>button:nth-child(6)))>button:nth-child(-n+2){grid-column:span 3}
#phone .modes{overflow:visible;gap:4px}
#phone .modes>*{flex:1 1 0;min-width:0;padding-left:6px;padding-right:6px;justify-content:center}
</style>
<script>
(function(){
const ICON=[[/coffee|cafe|bakery|kitchen/i,'\u2615'],[/dental|clinic|hospital|pharmacy|health/i,'\ud83c\udfe5'],[/market|shop|mall|store/i,'\ud83d\uded2'],[/bus|stop|station/i,'\ud83d\ude8c'],[/\d/,'\ud83d\udccd']];
function fix(){
 const ph=document.getElementById('phone');if(!ph)return;
 ph.querySelectorAll('.pl').forEach(r=>{
  if(r.dataset.v194||!r.querySelector('button[aria-label=Remove]'))return;
  r.dataset.v194='1';
  const i=r.querySelector('i'),b=r.querySelector('b');if(!i||!b)return;
  const m=ICON.find(x=>x[0].test(b.textContent));if(!m)return;
  i.innerHTML='<span aria-hidden="true" style="font-size:20px;line-height:1">'+m[1]+'</span>';
 });
 const ph2=ph.querySelectorAll('.mcs>div[aria-label="Expand map"]');
 ph2.forEach((d,k)=>{if(d.dataset.v194)return;d.dataset.v194='1';if(d.textContent.trim()==='\ud83c\udfe0')d.textContent='\u2615';d.setAttribute('aria-label','Photo '+(k+1)+' of '+ph2.length)});
}
let q=0;new MutationObserver(()=>{if(q)return;q=requestAnimationFrame(()=>{q=0;try{fix()}catch(e){}})}).observe(document.getElementById('phone'),{childList:true,subtree:true});
try{fix()}catch(e){}
document.title='itunda, clickable prototype v194';
})();
</script>
<style id="v195">
/* v195: Maps. The category chips on the map (All, Cafe, Food, Bus stops, Hospital, Pharmacy, ATM) were squeezed into a 24px sliver, so only the edge of "All" showed and the filters could not be used. The Money screen's .mvc rule (a 3px line) was also applying to the map's chip row; the row now spans the screen and scrolls sideways again. */
#phone .mcs.mvc{width:auto;height:auto;background:none;border-radius:0;padding:1px 12px;gap:8px}
</style>
<script>document.title='itunda, clickable prototype v195';</script>
<style id="v196">
/* v196: Maps. Place map: "Office Suites" ran off the right edge, "Bus stop" sat under its blue dot, and a blue dot cut through the cafe's name; the three labels are moved clear. French and Kinyarwanda: the map category chips, "Bus stop", the Directions route cards ("Best", "305 + 1 transfer", "Route 311", "Stop 1") and the "Photo 1 of 3" labels were still English. New fr/rw strings need native review. */
</style>
<script>
(function(){
const FR={'\u2615 Cafe':'\u2615 Caf\u00e9','\ud83c\udf7d\ufe0f Food':'\ud83c\udf7d\ufe0f Restos','\ud83d\ude8c Bus stops':'\ud83d\ude8c Arr\u00eats de bus','\ud83c\udfe5 Hospital':'\ud83c\udfe5 H\u00f4pital','\ud83d\udc8a Pharmacy':'\ud83d\udc8a Pharmacie','\ud83c\udfe7 ATM':'\ud83c\udfe7 Distributeur','Bus stop \u00b7 305, 311':'Arr\u00eat de bus \u00b7 305, 311','Cafe, Dessert \u00b7 Avis 495':'Caf\u00e9, Desserts \u00b7 Avis 495','\ud83d\ude8c Best':'\ud83d\ude8c Meilleur','305 + 1 transfer':'305 + 1 correspondance','Route 311':'Ligne 311'};
const RW={'\u2615 Cafe':'\u2615 Caf\u00e9','\ud83c\udf7d\ufe0f Food':'\ud83c\udf7d\ufe0f Ibiryo','\ud83d\ude8c Bus stops':'\ud83d\ude8c Aho bisi zihagarara','\ud83c\udfe5 Hospital':'\ud83c\udfe5 Ibitaro','\ud83d\udc8a Pharmacy':'\ud83d\udc8a Farumasi','Bus stop \u00b7 305, 311':'Aho bisi zihagarara \u00b7 305, 311','\ud83d\ude8c Best':'\ud83d\ude8c Nziza','305 + 1 transfer':'305 + guhindura 1','Route 311':'Inzira 311'};
const STOP={fr:'Arr\u00eat ',rw:'Ahagarara '};
const PH={fr:(k,n)=>'Photo '+k+' sur '+n,rw:(k,n)=>'Ifoto '+k+' kuri '+n};
function fix(){
 const ph=document.getElementById('phone');if(!ph)return;
 const lang=(typeof S!=='undefined'&&S.lang)||'en';
 const svg=ph.querySelector('svg[aria-label="Map of the cafe area"]');
 if(svg&&!svg.dataset.v196){svg.dataset.v196='1';
  svg.querySelectorAll('text').forEach(t=>{const s=t.textContent.trim();
   if(s==='Office Suites')t.setAttribute('x','250');
   else if(s==='Bus stop')t.setAttribute('x','142');
   else if(s==='Nyamirambo Coffee House')t.setAttribute('y','128')})}
 if(lang!=='fr'&&lang!=='rw')return;
 const D=lang==='fr'?FR:RW;
 const w=document.createTreeWalker(ph,NodeFilter.SHOW_TEXT);let n;
 while(n=w.nextNode()){const v=n.nodeValue.trim();if(!v)continue;
  if(D[v]){n.nodeValue=n.nodeValue.replace(v,D[v]);continue}
  const m=/^Stop (\d+)$/.exec(v);if(m)n.nodeValue=n.nodeValue.replace(v,STOP[lang]+m[1]);
  else{const m2=/^Stop (\d{5})$/.exec(v);if(m2)n.nodeValue=n.nodeValue.replace(v,STOP[lang]+m2[1])}}
 const ps=ph.querySelectorAll('.mcs>div[aria-label^="Photo "]');
 ps.forEach((d,k)=>d.setAttribute('aria-label',PH[lang](k+1,ps.length)));
}
let q=0;new MutationObserver(()=>{if(q)return;q=requestAnimationFrame(()=>{q=0;try{fix()}catch(e){}})}).observe(document.getElementById('phone'),{childList:true,subtree:true});
try{fix()}catch(e){}
document.title='itunda, clickable prototype v196';
})();
</script>
<style id="v197">
/* v197: Maps. The "Press and hold the map to drop a pin" hint is a toast that outlived the map: it appeared over the search bar, the Place page and the Directions start field (hiding "Your location"). It now disappears when you leave the map, and on the map it sits below the filter chips instead of on top of them. Map pins show their names (respecting the Place names layer switch), but only the ones that fit: at most 5 at the default zoom, none that collide with neighbourhood names, the buttons, the scale bar, the sheet or the chips, and when zoomed far out the pins become plain dots. Place map: the cafe pin was cut off under the header; it now sits in clear map space and its name has a halo so it reads over roads and blocks. */
#phone .toast.mphint{top:122px;bottom:auto;left:16px;right:16px;padding:10px 16px;border-radius:14px;font-size:13px;text-align:center;pointer-events:none}
</style>
<script>
(function(){
const HINTS=['Press and hold the map to drop a pin','Fata igihe ku ikarita ushyireho ikimenyetso','Appuyez longuement sur la carte pour placer un rep\u00e8re'];
function fix(){
 const ph=document.getElementById('phone');if(!ph)return;
 const top=(typeof S!=='undefined'&&S.stack&&S.stack[S.stack.length-1])||'';
 ph.querySelectorAll('.toast').forEach(t=>{
  if(HINTS.indexOf(t.textContent.trim())<0)return;
  if(top!=='mapview'){t.remove();return}
  t.classList.add('mphint');t.style.top='122px';t.style.bottom='auto'});
 const svg=ph.querySelector('svg[aria-label="Map of the cafe area"]');
 if(svg&&!svg.dataset.v197){svg.dataset.v197='1';
  const g=Array.from(svg.querySelectorAll('g')).find(x=>x.getAttribute('transform')==='translate(150 104)');
  if(g)g.setAttribute('transform','translate(138 152)');
  Array.from(svg.querySelectorAll('text')).forEach(t=>{
   if(t.textContent.trim()==='Nyamirambo Coffee House'){
    t.setAttribute('x','152');t.setAttribute('y','148');t.setAttribute('font-size','11');
    t.setAttribute('stroke','var(--chip)');t.setAttribute('stroke-width','3.5');
    t.setAttribute('stroke-linejoin','round');t.setAttribute('paint-order','stroke')}})}
}
let q=0;new MutationObserver(()=>{if(q)return;q=requestAnimationFrame(()=>{q=0;try{fix()}catch(e){}})}).observe(document.getElementById('phone'),{childList:true,subtree:true});
try{fix()}catch(e){}
/* pin names: the pin layer is rebuilt on every pan/zoom frame, so labels are added synchronously (microtask, before paint) to avoid flicker */
function pinLabels(){
 const ph=document.getElementById('phone');if(!ph)return;
 const m=(typeof S!=='undefined'&&S.mp)||{},z=m.z||1,off=m.nolab;
 ph.querySelectorAll('g[onclick^="mpPin("]:not([data-lb])').forEach(g=>{
  g.dataset.lb='1';
  const tx=g.querySelectorAll('text');
  if(tx.length>1){ /* the map's own name (drawn when zoomed in): selected pin keeps it, others join the declutter pass */
   const id=((g.getAttribute('onclick')||'').match(/mpPin\('([^']+)'/)||[])[1];
   if(id!==m.sel)Array.from(tx).slice(1).forEach(x=>{x.dataset.nl='1'});
   if(z>=0.75)return}
  if(z<0.75){ /* zoomed far out: plain dots, no icons or names */
   const cs=g.querySelectorAll('circle');
   g.querySelectorAll('text').forEach(x=>{x.style.display='none'});
   if(cs[0])cs[0].setAttribute('cy','-7');
   if(cs[1]){cs[1].setAttribute('r','7');cs[1].setAttribute('cy','-7');cs[1].setAttribute('stroke-width','2')}
   return}
  if(off)return;
  let n=(g.getAttribute('aria-label')||'').trim();if(!n)return;
  if(n.length>18)n=n.slice(0,17)+'\u2026';
  const t=document.createElementNS('http://www.w3.org/2000/svg','text');
  t.setAttribute('y','14');t.setAttribute('font-size','11');t.setAttribute('font-weight','800');
  t.setAttribute('text-anchor','middle');t.setAttribute('fill','var(--tx)');
  t.setAttribute('stroke','var(--chip)');t.setAttribute('stroke-width','3.5');
  t.setAttribute('stroke-linejoin','round');t.setAttribute('paint-order','stroke');
  t.setAttribute('pointer-events','none');t.setAttribute('aria-hidden','true');
  t.textContent=n;g.appendChild(t)});
 /* declutter: a name is shown only if it fits. Budget by zoom (5 nearest the centre at the default zoom, all when zoomed in);
    names yield to the neighbourhood names, the map buttons, the scale bar, the bottom sheet and the chip row. */
 const L=Array.from(ph.querySelectorAll('g[onclick^="mpPin("] text[aria-hidden],g[onclick^="mpPin("] text[data-nl]'));
 if(!L.length)return;
 L.forEach(t=>{t.style.display=''});
 const budget=z<1.2?5:99;
 const pr=ph.getBoundingClientRect(),surf=ph.querySelector('.fmsurf'),sr=surf?surf.getBoundingClientRect():pr;
 const cx=sr.left+sr.width/2,cy=sr.top+sr.height*.4;
 let minY=0,maxY=pr.bottom;
 const chips=ph.querySelector('.fmap .mcs');if(chips)minY=chips.getBoundingClientRect().bottom+4;
 const fmb=ph.querySelector('.fmb');
 const obs=[];
 if(fmb){
  fmb.querySelectorAll('*').forEach(e=>{const r=e.getBoundingClientRect();
   if(!r.width||!r.height)return;
   if(r.bottom>=pr.bottom-2&&r.height>100&&r.width>300){if(r.top<maxY)maxY=r.top}
   else if(e.tagName==='BUTTON'||e.id==='fmsc')obs.push(r)})}
 ph.querySelectorAll('#fmov > text').forEach(t=>{const r=t.getBoundingClientRect();if(r.width)obs.push(r)});
 let shown=0;const seen=[];
 L.map(t=>{const r=t.getBoundingClientRect(),g=t.parentNode.getBoundingClientRect();
   return [t,r,Math.hypot(g.left+g.width/2-cx,g.top+g.height/2-cy)]}).sort((a,b)=>a[2]-b[2]).forEach(([t,r])=>{
  const hit=shown>=budget||r.top<minY||r.bottom>maxY-2||r.left<4||r.right>pr.right-4||
   obs.some(o=>r.left<o.right+2&&r.right>o.left-2&&r.top<o.bottom+1&&r.bottom>o.top-1)||
   seen.some(o=>r.left<o.right+3&&r.right>o.left-3&&r.top<o.bottom+2&&r.bottom>o.top-2);
  t.style.display=hit?'none':'';if(!hit){seen.push(r);shown++}})}
new MutationObserver(()=>{try{pinLabels()}catch(e){}}).observe(document.getElementById('phone'),{childList:true,subtree:true});
try{pinLabels()}catch(e){}
document.title='itunda, clickable prototype v197';
})();
</script>
<script>
/* v198: SACCO shares. The old Buy 1 / Buy 5 buttons opened a one-line \"Confirm your purchase\" sheet; the review is now a full one (shares, price, you pay, balance after, dividend, when it can be withdrawn) and its button names the shares. New: \"How many shares?\" with 1, 2, 5 and 10 to pick from, a live line under them (cost, dividend per year, balance after), and a plain reason when the bank balance is too low (the buttons were just greyed out). \"Withdrawals: At year end\" is now a real date. After buying, the page says what you own and when it unlocks. English only; fr/rw copy untouched. */
(function(){
const R=(a,v)=>'<div style="display:flex;justify-content:space-between;gap:12px;min-height:40px;align-items:center;font-size:15px;border-top:0"><span class="mu">'+a+'</span><b style="text-align:right">'+v+'</b></div>';
const yEnd=()=>{const n=new Date(),y=new Date(n.getFullYear(),11,31);return y.toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric'})};
const PR=5000,OPTS=[1,2,5,10];
const sh=n=>n+' share'+(n>1?'s':'');
const _s=screens.sacco,_b=buySh;
S.shn=1;
screens.sacco=()=>{if(S.lang!=='en')return _s();
 const v=S.sh*PR,n=S.shn||1,cost=n*PR,low=S.bank<cost,after=S.bank-cost,div=Math.round(cost*.06);
 const chips=OPTS.map(k=>'<button class="chip'+(k===n?' on':'')+'" aria-pressed="'+(k===n)+'" onclick="shPick('+k+')" style="min-width:56px;height:44px;border-radius:22px;border:0;font-size:16px;font-weight:800;background:'+(k===n?'var(--tx)':'var(--chip)')+';color:'+(k===n?'var(--bg)':'var(--tx)')+'">'+k+'</button>').join('');
 const line=low?'<span style="color:var(--er)">'+sh(n)+' costs '+fmt(cost)+' RWF. Your bank balance is '+fmt(S.bank)+' RWF. Pick fewer shares or add money first.</span>':'<b style="color:var(--tx)">'+fmt(cost)+' RWF</b> from itunda Bank · adds about '+fmt(div)+' RWF a year in dividend · balance after '+fmt(after)+' RWF';
 return bar('SACCO shares')+'<div class="pad" style="padding-top:28px"><div class="sm mu">Your shares</div><div class="big" style="margin-top:4px">'+S.sh+' <span style="font-size:20px;letter-spacing:0">('+fmt(v)+' RWF)</span></div>'+
 '<div class="sm" style="margin-top:8px;font-weight:700;color:var(--ok)">Estimated dividend: '+fmt(Math.round(v*.06))+' RWF a year</div>'+
 (S.sh?'<div class="sm mu" style="margin-top:6px">Your shares unlock on '+yEnd()+'.</div>':'')+
 '<div class="mu" style="font-size:15px;margin-top:16px;line-height:22px">Own a part of your cooperative. Each share is 5,000 RWF and earns a dividend when the SACCO makes a surplus.</div></div>'+
 '<div class="pad" style="padding-top:28px"><div style="font-size:16px;font-weight:800">How many shares?</div><div style="display:flex;gap:10px;margin-top:12px" role="group" aria-label="Number of shares">'+chips+'</div><div class="sm mu" style="margin-top:14px;line-height:20px" aria-live="polite">'+line+'</div></div>'+
 '<div style="margin:24px 24px 0;padding:4px 20px;border-radius:20px;background:var(--chip)">'+
 '<div style="display:flex;justify-content:space-between;height:52px;align-items:center;font-size:15px"><span class="mu">Share price</span><b>5,000 RWF</b></div>'+
 '<div style="display:flex;justify-content:space-between;height:52px;align-items:center;font-size:15px;border-top:0"><span class="mu">Dividend (sample)</span><b>6% a year</b></div>'+
 '<div style="display:flex;justify-content:space-between;height:52px;align-items:center;font-size:15px;border-top:0"><span class="mu">Withdrawals</span><b>'+yEnd()+'</b></div></div>'+
 '<div class="pad fine" style="padding-top:20px">Sample dividend and terms for this prototype.</div>'+
 '<div class="cta"><button class="btn" style="height:52px;font-size:16px;border-radius:16px;white-space:nowrap" '+(low?'disabled':'')+' onclick="shReview()">Buy '+sh(n)+' ('+fmt(cost)+' RWF)</button></div>'};
window.shPick=k=>{S.shn=k;render('fade-none')};
window.shReview=()=>{const n=S.shn||1,cost=n*PR;if(S.bank<cost)return;
 $('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="h1" style="font-size:22px;line-height:30px;margin-top:4px">Buy '+sh(n)+'?</div><div style="margin:12px 0 20px">'+R('Shares',n+' × 5,000 RWF')+R('You pay',fmt(cost)+' RWF')+R('Paid from','itunda Bank')+R('Balance after',fmt(S.bank-cost)+' RWF')+R('Dividend (sample)','About '+fmt(Math.round(cost*.06))+' RWF a year')+R('Can be withdrawn',yEnd())+'</div><div class="row2" style="display:grid;grid-template-columns:1fr 1.8fr"><button class="btn sec2" onclick="closeSheet()">Cancel</button><button class="btn" style="white-space:nowrap" onclick="closeSheet();shBuy('+n+')">Buy '+sh(n)+'</button></div></div>';
 if(typeof focusSheet==='function')focusSheet()};
window.shBuy=n=>{if(S.bank<n*PR)return;_b(n,1);S.shn=1;render('fade-none');toast('You now own '+sh(S.sh))};
document.title='itunda, clickable prototype v198';
})();
</script>
<script>
/* v199: Cash out. Fix: "Cash out" never took the money (your Pay balance stayed the same, nothing showed in Activity) and had no review; it now asks first (amount, where it goes, fee, when it arrives, Pay balance after), takes the money, adds a "Cash out" row to Activity, and the done sheet says what your Pay balance is now. New: your itunda Pay balance on the page, 5,000 / 10,000 / 20,000 / 50,000 shortcuts instead of tapping + up to 49 times, a "Send to" label over the two mobile money numbers, the per-cash-out limit, a plain message when the amount is more than your balance, and a button that names the amount ("Cash out 5,000 RWF"). English only; fr/rw copy untouched. */
(function(){
const R=(a,v)=>'<div style="display:flex;justify-content:space-between;gap:12px;min-height:40px;align-items:center;font-size:15px;border-top:0"><span class="mu">'+a+'</span><b style="text-align:right">'+v+'</b></div>';
const TO=['MTN MoMo \u2022\u20220788','Airtel Money \u2022\u20220732'],AM=[5000,10000,20000,50000],MAX=50000;
const cs=()=>S.sv2.cashout=S.sv2.cashout||{a:5000,tm:0,o:0};
const _s=screens.svc;
screens.svc=()=>{let h=_s();if(S.lang!=='en'||S.svk!=='cashout')return h;
 const s=cs(),bad=s.a>S.pay;
 const sc='<div style="padding:14px 24px 0"><div style="display:flex;gap:10px;flex-wrap:wrap" role="group" aria-label="Amount shortcuts">'+AM.map(v=>'<button class="chip" aria-pressed="'+(v===s.a)+'" onclick="coPick('+v+')" style="min-width:64px;height:44px;border-radius:22px;border:0;padding:0 14px;font-size:15px;font-weight:800;background:'+(v===s.a?'var(--tx)':'var(--chip)')+';color:'+(v===s.a?'var(--bg)':'var(--tx)')+'">'+fmt(v)+'</button>').join('')+'</div>'+
 '<div class="sm" style="margin-top:12px;line-height:20px" aria-live="polite">'+(bad?'<span style="color:var(--er)">This is more than your itunda Pay balance of '+fmt(S.pay)+' RWF. Pick a smaller amount.</span>':'<span class="mu">itunda Pay balance: <b style="color:var(--tx)">'+fmt(S.pay)+' RWF</b> \u00b7 left after: '+fmt(S.pay-s.a)+' RWF</span>')+'</div></div>'+
 '<div style="font-size:16px;font-weight:800;padding:22px 24px 0">Send to</div>';
 h=h.replace('<div class="chp" style="padding:14px 24px 0">',sc+'<div class="chp" style="padding:10px 24px 0">');
 h=h.replace('<div style="height:100px"></div>','<div class="pad sm mu" style="padding-top:14px">Limit: '+fmt(MAX)+' RWF for each cash out.</div><div style="height:100px"></div>');
 h=h.replace('onclick="svcGo()">Cash out</button>',(bad?'disabled ':'')+'onclick="svcGo()" style="white-space:nowrap">Cash out '+fmt(s.a)+' RWF</button>');
 return h};
window.coPick=v=>{cs().a=v;render('fade-none')};
const _g=window.svcGo;
window.svcGo=function(ok){if(S.lang!=='en'||S.svk!=='cashout')return _g.apply(this,arguments);
 const s=cs(),a=s.a,to=TO[s.o]||TO[0];
 if(a>S.pay)return;
 if(ok===1){S.pay-=a;addAct('coin','Cash out \u00b7 '+to,'Sent',-a,'Sent');render('fade-none');
  $('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="g3" style="font-size:56px;line-height:1;margin-bottom:10px">\u2705</div><div class="h1" style="font-size:22px;line-height:30px">Cash out requested</div><div class="mu" style="font-size:15px;margin:8px 0 8px;line-height:22px">'+fmt(a)+' RWF is on its way to '+to+'. It should arrive within a minute.</div><div style="font-weight:800;margin-bottom:24px">itunda Pay balance now '+fmt(S.pay)+' RWF</div><button class="btn" onclick="closeSheet()">OK</button></div>';
  if(typeof focusSheet==='function')focusSheet();return}
 $('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="h1" style="font-size:22px;line-height:30px;margin-top:4px">Cash out '+fmt(a)+' RWF?</div><div style="margin:12px 0 20px">'+R('Amount',fmt(a)+' RWF')+R('Send to',to)+R('Fee','Free')+R('Arrives','Within a minute')+R('Paid from','itunda Pay')+R('Pay balance after',fmt(S.pay-a)+' RWF')+'</div><div class="row2" style="display:grid;grid-template-columns:1fr 1.8fr"><button class="btn sec2" onclick="closeSheet()">Cancel</button><button class="btn" style="white-space:nowrap" onclick="svcGo(1)">Cash out '+fmt(a)+' RWF</button></div></div>';
 if(typeof focusSheet==='function')focusSheet()};
document.title='itunda, clickable prototype v199';
})();
</script>
<script>
/* v200: Auto top-up. Before: the page said "Refill when balance is below" without saying which balance, "Refill amount: Same as the threshold" and "Linked MoMo account" (which one?), and "Turn on auto top-up" only showed a message: reopen the page and it was off again, with no way to turn it off. Now: three plain questions in order ("Refill when itunda Pay is below", "Add this much", "Take it from") with taps instead of +/- and the real MTN and Airtel numbers; one sentence that updates as you choose ("When your itunda Pay balance drops below 10,000 RWF, we add 20,000 RWF from MTN MoMo \u2022\u20220788"); a review before it turns on; it stays on when you come back, shows its status, and can be changed ("Save changes") or turned off (with a confirmation). English only; fr/rw copy untouched. */
(function(){
const R=(a,v)=>'<div style="display:flex;justify-content:space-between;gap:12px;min-height:40px;align-items:center;font-size:15px;border-top:0"><span class="mu">'+a+'</span><b style="text-align:right">'+v+'</b></div>';
const TH=[5000,10000,20000,50000],AMT=[10000,20000,50000],SRC=['MTN MoMo \u2022\u20220788','Airtel Money \u2022\u20220732'];
S.atu=S.atu||{on:false,th:10000,amt:20000,o:0};
const D=()=>S.atuD=S.atuD||Object.assign({},S.atu);
const sent=d=>'When your itunda Pay balance drops below '+fmt(d.th)+' RWF, we add '+fmt(d.amt)+' RWF from '+SRC[d.o]+'.';
const chips=(arr,cur,fn)=>'<div style="display:flex;gap:10px;flex-wrap:wrap;padding:10px 24px 0" role="group">'+arr.map(v=>'<button class="chip" aria-pressed="'+(v===cur)+'" onclick="'+fn+'('+v+')" style="min-width:64px;height:44px;border-radius:22px;border:0;padding:0 14px;font-size:15px;font-weight:800;background:'+(v===cur?'var(--tx)':'var(--chip)')+';color:'+(v===cur?'var(--bg)':'var(--tx)')+'">'+fmt(v)+'</button>').join('')+'</div>';
const lab=(t,s)=>'<div style="padding:22px 24px 0"><div style="font-size:16px;font-weight:800">'+t+'</div>'+(s?'<div class="sm mu" style="margin-top:4px">'+s+'</div>':'')+'</div>';
const _s=screens.svc,_o=window.openSvc;
window.openSvc=function(k){if(k==='atu')S.atuD=Object.assign({},S.atu);return _o.apply(this,arguments)};
screens.svc=()=>{if(S.lang!=='en'||S.svk!=='atu')return _s();
 const d=D(),a=S.atu,dirty=d.th!==a.th||d.amt!==a.amt||d.o!==a.o;
 const status=a.on?'<div style="margin:18px 24px 0;padding:14px 16px;border-radius:16px;background:var(--tint);color:var(--tintfg);font-size:14px;line-height:20px"><b>Auto top-up is on.</b> '+sent(a)+'</div>':'';
 const src=SRC.map((n,i)=>'<div class="row tap" role="radio" aria-checked="'+(d.o===i)+'" tabindex="0" onclick="atuPick(\'o\','+i+')" style="padding:12px 24px;'+(d.o===i?'background:var(--tint)':'')+'"><div style="width:22px;height:22px;border-radius:11px;border:2px solid '+(d.o===i?'var(--lk)':'var(--ln)')+';display:flex;align-items:center;justify-content:center">'+(d.o===i?'<div style="width:10px;height:10px;border-radius:5px;background:var(--lk)"></div>':'')+'</div><div class="t">'+n+'</div></div>').join('');
 const cta=a.on?'<div class="cta"><div style="display:grid;grid-template-columns:1fr 1.6fr;gap:12px"><button class="btn sec2" onclick="atuOff()">Turn off</button><button class="btn" '+(dirty?'':'disabled')+' onclick="atuReview()">Save changes</button></div></div>':'<div class="cta"><button class="btn" onclick="atuReview()">Turn on auto top-up</button></div>';
 return bar('Auto top-up')+'<div style="padding:22px 24px 0"><div style="width:72px;height:72px;border-radius:36px;background:var(--tint);display:flex;align-items:center;justify-content:center;font-size:36px">\ud83d\udd01</div><div class="h1" style="margin-top:16px">Auto top-up</div><div class="mu" style="font-size:15px;line-height:22px;margin-top:8px">Never run out of itunda Pay money. Your balance now: <b style="color:var(--tx)">'+fmt(S.pay)+' RWF</b>.</div></div>'+status+
 lab('Refill when itunda Pay is below')+chips(TH,d.th,'atuTh')+
 lab('Add this much')+chips(AMT,d.amt,'atuAmt')+
 lab('Take it from')+'<div role="radiogroup" style="padding-top:6px">'+src+'</div>'+
 '<div style="margin:22px 24px 0;padding:14px 16px;border-radius:16px;background:var(--chip);font-size:15px;line-height:22px" aria-live="polite">'+sent(d)+' No fee.</div><div class="pad fine" style="padding-top:14px">Sample terms for this prototype.</div><div style="height:100px"></div>'+cta};
window.atuPick=(f,v)=>{D()[f]=v;render('fade-none')};
window.atuTh=v=>atuPick('th',v);window.atuAmt=v=>atuPick('amt',v);
window.atuReview=()=>{const d=D(),on=S.atu.on;
 $('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="h1" style="font-size:22px;line-height:30px;margin-top:4px">'+(on?'Save changes?':'Turn on auto top-up?')+'</div><div style="margin:12px 0 20px">'+R('Refill when below',fmt(d.th)+' RWF')+R('Add',fmt(d.amt)+' RWF')+R('Take it from',SRC[d.o])+R('Refills','itunda Pay')+R('Fee','Free')+'</div><div class="row2" style="display:grid;grid-template-columns:1fr 1.8fr"><button class="btn sec2" onclick="closeSheet()">Cancel</button><button class="btn" style="white-space:nowrap" onclick="atuSave()">'+(on?'Save changes':'Turn on')+'</button></div></div>';
 if(typeof focusSheet==='function')focusSheet()};
window.atuSave=()=>{const was=S.atu.on;S.atu=Object.assign({},D(),{on:true});S.atuD=Object.assign({},S.atu);closeSheet();render('fade-none');toast(was?'Changes saved':'Auto top-up is on')};
window.atuOff=()=>{$('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="h1" style="font-size:22px;line-height:30px;margin-top:4px">Turn off auto top-up?</div><div class="mu" style="font-size:15px;margin:8px 0 24px;line-height:22px">We will stop adding money when your itunda Pay balance is low. Your saved choices are kept for next time.</div><div class="row2" style="display:grid;grid-template-columns:1fr 1.8fr"><button class="btn sec2" onclick="closeSheet()">Keep it on</button><button class="btn" style="white-space:nowrap" onclick="atuOffGo()">Turn off</button></div></div>';
 if(typeof focusSheet==='function')focusSheet()};
window.atuOffGo=()=>{S.atu.on=false;S.atuD=Object.assign({},S.atu);closeSheet();render('fade-none');toast('Auto top-up is off')};
document.title='itunda, clickable prototype v200';
})();
</script>
<script>
/* v201: Harvest advance, VUP microloan and Student loan. Before: tap + up to 28 times to reach an amount, no total to repay, "Needs: Cooperative ID" and "Level: Undergraduate 11%, postgraduate 12%" were just text (nothing asked for the ID and the rate never changed), "Apply" sent at once, and after sending you could apply again. Now: amount shortcuts; "Repay over" label; interest and total to repay under the monthly payment; Student loan asks "Undergraduate 11%" or "Postgraduate 12%" and the payment follows; Harvest advance asks for your cooperative ID (Apply stays off, with a line saying why, until it is filled in); a review before sending (amount, months, payment, total, rate, what happens next) with a button that names the amount; after sending the page shows "Application sent" with the reference and the next step, and the button stays off. English only; fr/rw copy untouched. */
(function(){
const K={harvest:{t:[4,6,8],r:12,sc:[200000,500000,1000000,2000000],nx:'Your cooperative confirms your membership, then we release the funds.',what:'advance'},
 vup:{t:[6,12,18],r:2,sc:[50000,150000,300000,500000],nx:'Your sector office will contact you to confirm eligibility.',what:'microloan'},
 student:{t:[12,24,36],r:11,sc:[500000,1000000,2000000,3000000],nx:'Upload your admission letter in the next step.',what:'student loan'}};
const R=(a,v)=>'<div style="display:flex;justify-content:space-between;gap:12px;min-height:40px;align-items:center;font-size:15px;border-top:0"><span class="mu">'+a+'</span><b style="text-align:right">'+v+'</b></div>';
const esc=x=>String(x).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const short=v=>v>=1e6?v/1e6+'M':v/1e3+'K';
const st=k=>S.sv2[k]=S.sv2[k]||{a:0,tm:0,o:0};
S.apps=S.apps||{};
const rate=(k,s)=>k==='student'?(s.lv?12:11):K[k].r;
const calc=(k,s)=>{const n=K[k].t[s.tm||0],i=rate(k,s)/1200,P=s.a,mo=i?P*i/(1-Math.pow(1+i,-n)):P/n;return{n,mo:Math.round(mo),tot:Math.round(mo*n),int:Math.round(mo*n-P),r:rate(k,s)}};
const lab=t=>'<div style="font-size:16px;font-weight:800;padding:22px 24px 0">'+t+'</div>';
const chipB=(on,fn,txt,al)=>'<button class="chip" aria-pressed="'+on+'" '+(al?'aria-label="'+al+'" ':'')+'onclick="'+fn+'" style="min-width:64px;height:44px;border-radius:22px;border:0;padding:0 14px;font-size:15px;font-weight:800;background:'+(on?'var(--tx)':'var(--chip)')+';color:'+(on?'var(--bg)':'var(--tx)')+'">'+txt+'</button>';
const cidOk=s=>(s.cid||'').trim().length>=4;
const _s=screens.svc;
screens.svc=()=>{const k=S.svk;let h=_s();if(S.lang!=='en'||!K[k])return h;
 const s=st(k),c=K[k],q=calc(k,s),app=S.apps[k],need=k==='harvest'&&!cidOk(s);
 let blk='<div style="padding:14px 24px 0"><div style="display:flex;gap:10px;flex-wrap:wrap" role="group" aria-label="Amount shortcuts">'+c.sc.map(v=>chipB(v===s.a,'svcSet(\'a\','+(v-s.a)+')',short(v),fmt(v)+' RWF')).join('')+'</div></div>';
 if(k==='student')blk+=lab('Your level')+'<div style="display:flex;gap:10px;flex-wrap:wrap;padding:10px 24px 0" role="group">'+chipB(!s.lv,'apLv(0)','Undergraduate 11%')+chipB(!!s.lv,'apLv(1)','Postgraduate 12%')+'</div>';
 if(k==='harvest')blk+=lab('Your cooperative ID')+'<div style="padding:10px 24px 0"><input id="apCid" value="'+esc(s.cid||'')+'" oninput="apCid(this.value)" autocomplete="off" aria-describedby="apH" placeholder="Type the ID on your membership card" style="width:100%;height:48px;border:0;border-radius:14px;background:var(--chip);color:var(--tx);padding:0 16px;font:inherit;font-size:16px"><div id="apH" class="sm mu" style="margin-top:8px">'+(need?(s.cid?'Keep typing, at least 4 characters.':'Your cooperative gives you this ID.'):'Looks good.')+'</div></div>';
 blk+=lab('Repay over');
 h=h.replace('<div class="chp" style="padding:14px 24px 0">',blk+'<div class="chp" style="padding:10px 24px 0">');
 h=h.replace(/Monthly payment<\/span><b>[^<]*<\/b><\/div>/,(k==='student'?'Monthly payment (after you graduate)':'Monthly payment')+'</span><b>'+fmt(q.mo)+' RWF</b></div><div style="margin:8px 24px 0;display:flex;justify-content:space-between;font-size:15px"><span class="mu">Interest ('+q.r+'% a year)</span><b>'+fmt(q.int)+' RWF</b></div><div style="margin:8px 24px 0;display:flex;justify-content:space-between;font-size:15px"><span class="mu">Total to repay</span><b>'+fmt(q.tot)+' RWF</b></div>');
 if(k==='student')h=h.replace(/<div style="display:flex;justify-content:space-between;gap:16px;padding:14px 24px;border-top:0;font-size:15px"><span class="mu">Level<\/span>.*?<\/div>/,'');
 if(app)h=h.replace('<div style="margin-top:18px">','<div style="margin:18px 24px 0;padding:14px 16px;border-radius:16px;background:var(--tint);color:var(--tintfg);font-size:14px;line-height:20px"><b>Application sent.</b> Reference '+app.ref+' \u00b7 '+fmt(app.a)+' RWF. '+c.nx+'</div><div style="margin-top:18px">');
 const btn=app?'<button class="btn" disabled style="white-space:nowrap">Application sent</button>':'<button class="btn" id="apGo" '+(need?'disabled ':'')+'onclick="svcGo()" style="white-space:nowrap">Apply for '+fmt(s.a)+' RWF</button>'+(k==='harvest'?'<div id="apW" class="sm mu" style="text-align:center;margin-top:8px">'+(need?'Enter your cooperative ID to apply.':'')+'</div>':'');
 h=h.replace(/<button class="btn" onclick="svcGo\(\)">[^<]*<\/button>/,btn);
 return h};
window.apLv=v=>{st('student').lv=v;render('fade-none')};
window.apCid=v=>{const s=st('harvest');s.cid=v;const ok=cidOk(s),b=document.getElementById('apGo'),w=document.getElementById('apW'),hh=document.getElementById('apH');
 if(b)b.disabled=!ok;if(w)w.textContent=ok?'':'Enter your cooperative ID to apply.';if(hh)hh.textContent=ok?'Looks good.':(v?'Keep typing, at least 4 characters.':'Your cooperative gives you this ID.')};
const _g=window.svcGo;
window.svcGo=function(ok){const k=S.svk;if(S.lang!=='en'||!K[k])return _g.apply(this,arguments);
 const s=st(k),c=K[k],q=calc(k,s);if(S.apps[k])return;if(k==='harvest'&&!cidOk(s))return;
 if(ok===1){const ref='ITN-'+String(Date.now()).slice(-6);S.apps[k]={ref,a:s.a};closeSheet();render('fade-none');
  $('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="g3" style="font-size:56px;line-height:1;margin-bottom:10px">\ud83d\udce8</div><div class="h1" style="font-size:22px;line-height:30px">Application sent</div><div class="mu" style="font-size:15px;margin:8px 0 8px;line-height:22px">'+c.nx+'</div><div style="font-weight:800;margin-bottom:24px">Reference '+ref+'</div><button class="btn" onclick="closeSheet()">OK</button></div>';
  if(typeof focusSheet==='function')focusSheet();return}
 $('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="h1" style="font-size:22px;line-height:30px;margin-top:4px">Apply for '+fmt(s.a)+' RWF?</div><div style="margin:12px 0 20px">'+R('Amount',fmt(s.a)+' RWF')+(k==='student'?R('Level',s.lv?'Postgraduate':'Undergraduate'):'')+(k==='harvest'?R('Cooperative ID',esc((s.cid||'').trim())):'')+R('Repay over',q.n+' months')+R('Monthly payment',fmt(q.mo)+' RWF')+R('Interest',fmt(q.int)+' RWF ('+q.r+'% a year)')+R('Total to repay',fmt(q.tot)+' RWF')+R('Next',c.nx)+'</div><div class="row2" style="display:grid;grid-template-columns:1fr 1.8fr"><button class="btn sec2" onclick="closeSheet()">Cancel</button><button class="btn" style="white-space:nowrap" onclick="svcGo(1)">Send application</button></div></div>';
 if(typeof focusSheet==='function')focusSheet()};
document.title='itunda, clickable prototype v201';
})();
</script>
<script>
/* v202: Youth account and Group account. Before: you could only pick a child's name from three presets (Keza, Ineza, Kevin) and a group could only be called "Family", "Church" or "Cooperative"; "Send 2,000" and "Add 5,000" took the money the moment you tapped them; the weekly limit had no sentence saying what it does. Now: Youth account asks for your child's first name (typed) and an age group, with a line saying what is missing until you do, a review before opening, amount shortcuts (2,000 / 5,000 / 10,000) under "How much to send?", a review before sending (to, amount, bank balance after, their balance after) and a button that names the amount and the child ("Send 5,000 RWF to Keza"), and a sentence under the weekly limit ("Keza can spend up to 3,000 RWF a week. A change applies straight away."). Group account: pick a type, give the group a name (or keep the suggested one), review before creating, "How much to add?" with 5,000 / 10,000 / 20,000, a review before adding, and a button that names the amount. A plain reason when the bank balance is too low. English only; fr/rw copy untouched. */
(function(){
const R=(a,v)=>'<div style="display:flex;justify-content:space-between;gap:12px;min-height:40px;align-items:center;font-size:15px;border-top:0"><span class="mu">'+a+'</span><b style="text-align:right">'+v+'</b></div>';
const esc=x=>String(x).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const chipB=(on,fn,txt)=>'<button class="chip" aria-pressed="'+on+'" onclick="'+fn+'" style="min-width:64px;height:44px;border-radius:22px;border:0;padding:0 16px;font-size:15px;font-weight:800;background:'+(on?'var(--tx)':'var(--chip)')+';color:'+(on?'var(--bg)':'var(--tx)')+'">'+txt+'</button>';
const chips=(a,cur,fn,lab)=>'<div style="display:flex;gap:10px;flex-wrap:wrap;padding-top:10px" role="group">'+a.map(v=>chipB(v===cur,fn+'('+JSON.stringify(v).replace(/"/g,"'")+')',lab?lab(v):fmt(v))).join('')+'</div>';
const lab=t=>'<div style="font-size:16px;font-weight:800;padding-top:22px">'+t+'</div>';
const inp=(id,v,ph,fn)=>'<input id="'+id+'" value="'+esc(v)+'" oninput="'+fn+'(this.value)" autocomplete="off" placeholder="'+ph+'" style="width:100%;height:48px;margin-top:10px;border:0;border-radius:14px;background:var(--chip);color:var(--tx);padding:0 16px;font:inherit;font-size:16px">';
const sheet=(h,body,no,yes,go)=>{$('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="h1" style="font-size:22px;line-height:30px;margin-top:4px">'+h+'</div><div style="margin:12px 0 20px">'+body+'</div><div class="row2" style="display:grid;grid-template-columns:1fr 1.8fr"><button class="btn sec2" onclick="closeSheet()">'+no+'</button><button class="btn" style="white-space:nowrap" onclick="'+go+'">'+yes+'</button></div></div>';if(typeof focusSheet==='function')focusSheet()};
const need=(id,t)=>'<div id="'+id+'" class="sm mu" style="text-align:center;margin-top:8px">'+t+'</div>';
const AGES=['Under 10','10 to 13','14 to 17'];
S.ya=S.ya||'';S.ysd=S.ysd||2000;S.gnm=S.gnm||'';S.gad=S.gad||5000;
/* ---------- Youth ---------- */
const nm=()=>S.ynTouched?(S.yn||'').trim():'';
const yOk=()=>nm().length>=2&&!!S.ya;
const yMsg=()=>nm().length<2?"Type your child's first name to continue.":(!S.ya?'Pick an age group to continue.':'');
const _y=screens.yth;
screens.yth=()=>{if(S.lang!=='en')return _y();const Y=S.yth;
 if(!Y){const ok=yOk();
  return bar('Youth account')+'<div class="pad" style="padding-top:28px"><div class="h1">A first account for your child</div><div class="mu" style="font-size:15px;margin-top:8px;line-height:22px">For under-18s. You stay in charge: you add money and set the spending limit.</div>'+lab("Your child's first name")+inp('yNm',nm(),'Type their first name','ythName')+lab('Age group')+chips(AGES,S.ya,'ythAge',x=>x)+'</div><div class="pad fine" style="padding-top:20px">Sample account for this prototype.</div><div style="height:100px"></div><div class="cta"><button class="btn" id="yGo" '+(ok?'':'disabled ')+'onclick="ythReview()" style="white-space:nowrap">'+(nm().length>=2?'Open account for '+esc(nm()):'Open account')+'</button>'+need('yW',yMsg())+'</div>'}
 const n=S.ysd,low=S.bank<n,after=S.bank-n;
 return bar(esc(Y.n)+"'s account")+'<div class="pad" style="padding-top:28px"><div class="sm mu">Balance</div><div class="big" style="margin-top:4px">'+fmt(Y.bal)+' RWF</div><div class="sm mu" style="margin-top:6px">Parent-supervised \u00b7 weekly limit '+fmt(Y.l)+' RWF</div></div>'+
 '<div class="pad">'+lab('How much to send?')+chips([2000,5000,10000],n,'ythAmt')+'<div class="sm mu" style="margin-top:14px;line-height:20px" aria-live="polite">'+(low?'<span style="color:var(--er)">'+fmt(n)+' RWF is more than your bank balance of '+fmt(S.bank)+' RWF. Pick a smaller amount.</span>':'From itunda Bank \u00b7 balance after '+fmt(after)+' RWF')+'</div><button class="btn" style="width:100%;margin-top:16px;white-space:nowrap" '+(low?'disabled ':'')+'onclick="ythSendReview()">Send '+fmt(n)+' RWF to '+esc(Y.n)+'</button></div>'+
 '<div class="pad">'+lab('Weekly spending limit')+chips([1000,3000,5000],Y.l,'ythLim')+'<div class="sm mu" style="margin-top:14px;line-height:20px">'+esc(Y.n)+' can spend up to '+fmt(Y.l)+' RWF a week. A change applies straight away.</div></div><div class="pad fine" style="padding-top:20px">Sample data for this prototype.</div>'};
window.ythName=v=>{S.yn=v;S.ynTouched=1;const ok=yOk(),b=document.getElementById('yGo'),w=document.getElementById('yW');if(b){b.disabled=!ok;b.textContent=nm().length>=2?'Open account for '+nm():'Open account'}if(w)w.textContent=yMsg()};
window.ythAge=v=>{S.ya=v;render('fade-none');const i=document.getElementById('yNm');if(i){i.focus();const l=i.value.length;i.setSelectionRange(l,l)}};
window.ythAmt=v=>{S.ysd=v;render('fade-none')};
window.ythLim=v=>{S.yth.l=v;render('fade-none')};
window.ythReview=()=>{if(!yOk())return;sheet('Open an account for '+esc(nm())+'?',R('Child',esc(nm()))+R('Age group',S.ya)+R('In charge','You (parent)')+R('Weekly spending limit','3,000 RWF, you can change it')+R('Cost','Free'),'Cancel','Open account','ythGo()')};
window.ythGo=()=>{closeSheet();S.yth={n:nm(),bal:0,l:3000};render('fade-none');toast('Account opened for '+nm())};
window.ythSendReview=()=>{const n=S.ysd,Y=S.yth;if(S.bank<n)return;sheet('Send '+fmt(n)+' RWF to '+esc(Y.n)+'?',R('To',esc(Y.n)+"'s account")+R('Amount',fmt(n)+' RWF')+R('From','itunda Bank')+R('Bank balance after',fmt(S.bank-n)+' RWF')+R(esc(Y.n)+"'s balance after",fmt(Y.bal+n)+' RWF'),'Cancel','Send '+fmt(n)+' RWF','ythDo()')};
window.ythDo=()=>{const n=S.ysd;closeSheet();ythSend(n)};
/* ---------- Group ---------- */
const gDef=()=>S.gn+' savings',gName=()=>(S.gnm||'').trim()||gDef();
const _g=screens.grp;
screens.grp=()=>{if(S.lang!=='en')return _g();const G=S.grp;
 if(!G)return bar('Group accounts')+'<div class="pad" style="padding-top:28px"><div class="h1">Save together</div><div class="mu" style="font-size:15px;margin-top:8px;line-height:22px">A shared account for family, church or a cooperative. Everyone can add money.</div>'+lab('Group type')+chips(['Family','Church','Cooperative'],S.gn,'grpType',x=>x)+lab('Group name (optional)')+inp('gNm',S.gnm,esc(gDef()),'grpNm')+'<div id="gH" class="sm mu" style="margin-top:8px">Leave it empty to call it \u201c'+esc(gDef())+'\u201d.</div></div><div class="pad fine" style="padding-top:20px">Sample group for this prototype.</div><div style="height:100px"></div><div class="cta"><button class="btn" id="gGo" onclick="grpReview()" style="white-space:nowrap">Create '+esc(gName())+'</button></div>';
 const n=S.gad,low=S.bank<n;
 return bar(esc(G.n))+'<div class="pad" style="padding-top:28px"><div class="sm mu">Group balance</div><div class="big" style="margin-top:4px">'+fmt(G.bal)+' RWF</div></div><div class="sec" style="padding-top:20px"><div class="sech">Members</div>'+G.mem.map(([m,v])=>'<div class="row" style="cursor:default;padding:8px 0"><div class="ico" style="width:36px;height:36px;font-size:14px;font-weight:800">'+esc(m.split(/\s+/).map(w=>w[0]).join('').slice(0,2))+'</div><div class="t" style="font-size:15px">'+esc(m)+'</div><div class="r">'+fmt(v)+' RWF</div></div>').join('')+'</div>'+
 '<div class="pad">'+lab('How much to add?')+chips([5000,10000,20000],n,'grpAmt')+'<div class="sm mu" style="margin-top:14px;line-height:20px" aria-live="polite">'+(low?'<span style="color:var(--er)">'+fmt(n)+' RWF is more than your bank balance of '+fmt(S.bank)+' RWF. Pick a smaller amount.</span>':'From itunda Bank \u00b7 balance after '+fmt(S.bank-n)+' RWF')+'</div><button class="btn" style="width:100%;margin-top:16px;white-space:nowrap" '+(low?'disabled ':'')+'onclick="grpAddReview()">Add '+fmt(n)+' RWF</button></div><div class="pad fine" style="padding-top:20px">Withdrawals need approval from two members. Sample data.</div>'};
window.grpNm=v=>{S.gnm=v;const b=document.getElementById('gGo');if(b)b.textContent='Create '+gName()};
const _gt=window.grpType;window.grpType=function(x){S.gn=x;render('fade-none')};
window.grpAmt=v=>{S.gad=v;render('fade-none')};
window.grpReview=()=>sheet('Create '+esc(gName())+'?',R('Name',esc(gName()))+R('Type',S.gn)+R('Members','You, Eric M., Amina K. (sample)')+R('Who can add money','Everyone')+R('Withdrawals','Two members approve')+R('Cost','Free'),'Cancel','Create group','grpGo()');
window.grpGo=()=>{const n=gName();closeSheet();S.grp={n,bal:0,mem:[['You',0],['Eric M.',0],['Amina K.',0]]};render('fade-none');toast('Group account created')};
window.grpAddReview=()=>{const n=S.gad,G=S.grp;if(S.bank<n)return;sheet('Add '+fmt(n)+' RWF to '+esc(G.n)+'?',R('To',esc(G.n))+R('Amount',fmt(n)+' RWF')+R('From','itunda Bank')+R('Bank balance after',fmt(S.bank-n)+' RWF')+R('Group balance after',fmt(G.bal+n)+' RWF')+R('Your total in the group',fmt(G.mem[0][1]+n)+' RWF'),'Cancel','Add '+fmt(n)+' RWF','grpDo()')};
window.grpDo=()=>{const n=S.gad,G=S.grp;closeSheet();S.bank-=n;G.bal+=n;G.mem[0][1]+=n;addAct('users',G.n,'Paid',-n,'Paid');render('fade-none');toast('Added '+fmt(n)+' RWF')};
document.title='itunda, clickable prototype v202';
})();
</script>
<script>
/* v203: Subscriptions. Before: the dates ("3 Nov", "1 Nov", "Every Mon") were typed in and never moved, nothing said which charge comes next or how much is due soon, tapping a row did nothing (only the switch worked, with no way to see details or cancel), and there was no empty state. Now: real next-charge dates worked out from today, the list sorted by next charge, a line at the top ("Next charge: Gym Kigali, 25,000 RWF, in 14 days"), active and paused subscriptions under their own headings, tap a row for its details (price, billing, next charge, paid from) with Pause / Resume and Cancel, a confirmation before cancelling that says you will not be charged again, and an empty state. English only; fr/rw copy untouched. */
(function(){
const R=(a,v)=>'<div style="display:flex;justify-content:space-between;gap:12px;min-height:40px;align-items:center;font-size:15px;border-top:0"><span class="mu">'+a+'</span><b style="text-align:right">'+v+'</b></div>';
const esc=x=>String(x).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const DAY={'Canal+ Rwanda':3,'MTN data bundle':'Mon','Gym Kigali':1,'Music streaming':9};
const day0=()=>{const d=new Date();d.setHours(0,0,0,0);return d};
const nextOf=s=>{const t=day0(),d=DAY[s[1]];if(d==null)return null;
 if(d==='Mon'){const x=new Date(t);x.setDate(x.getDate()+(1-t.getDay()+7)%7);return x}
 let x=new Date(t.getFullYear(),t.getMonth(),d);if(x<t)x=new Date(t.getFullYear(),t.getMonth()+1,d);return x};
const fd=d=>d.toLocaleDateString('en-GB',{day:'numeric',month:'short'});
const inDays=d=>{const n=Math.round((d-day0())/864e5);return n===0?'today':n===1?'tomorrow':'in '+n+' days'};
const when=s=>{const d=nextOf(s);return d?fd(d):s[4]};
const per=s=>s[3]==='Weekly'?'week':'month';
const _s=screens.subs;
screens.subs=()=>{if(S.lang!=='en')return _s();
 const L=S.subs.map((s,i)=>({s,i,d:nextOf(s)})),on=L.filter(x=>x.s[5]).sort((a,b)=>(a.d||1e15)-(b.d||1e15)),off=L.filter(x=>!x.s[5]);
 const mo=on.reduce((a,x)=>a+x.s[2]*(x.s[3]==='Weekly'?4:1),0);
 const row=x=>{const s=x.s;return '<div class="row tap" onclick="subOpen('+x.i+')" style="padding:12px 24px"><div class="ico">'+s[0]+'</div><div style="flex:1;min-width:0"><div class="t" style="opacity:'+(s[5]?1:.5)+'">'+esc(s[1])+'</div><div class="s">'+fmt(s[2])+' RWF \u00b7 '+s[3]+' \u00b7 '+(s[5]?'Next '+when(s):'Paused')+'</div></div><div class="sw '+(s[5]?'on':'')+'" role="switch" aria-checked="'+!!s[5]+'" aria-label="'+esc(s[1])+(s[5]?', on':', paused')+'" tabindex="0" onclick="event.stopPropagation();subTg('+x.i+')"><i></i></div></div>'};
 const hd=t=>'<div style="padding:22px 24px 0;font-size:16px;font-weight:800">'+t+'</div>';
 const nx=on[0]&&on[0].d?'<div class="sm" style="margin-top:8px;line-height:20px"><span class="mu">Next charge:</span> <b>'+esc(on[0].s[1])+'</b>, '+fmt(on[0].s[2])+' RWF, '+inDays(on[0].d)+'</div>':'';
 if(!S.subs.length)return bar('Subscriptions')+'<div class="pad" style="padding-top:28px"><div class="h1">No subscriptions</div><div class="mu" style="font-size:15px;margin-top:8px;line-height:22px">When you set up a regular payment, it shows here with its next charge date. You can pause or cancel it any time.</div></div>';
 return bar('Subscriptions')+'<div style="padding:20px 24px 4px"><div class="sm mu">Monthly total</div><div class="big" style="font-size:34px">'+fmt(mo)+' RWF</div>'+nx+'<div class="sm mu" style="margin-top:6px">Weekly charges are counted as 4 a month.</div></div>'+
 (on.length?hd('Active')+on.map(row).join(''):'')+(off.length?hd('Paused, not charged')+off.map(row).join(''):'')+
 '<div class="pad fine" style="padding-top:16px">Tap a subscription to see details, pause or cancel. Sample data.</div>'};
const sheet=(h,body,no,yes,go,danger)=>{$('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="h1" style="font-size:22px;line-height:30px;margin-top:4px">'+h+'</div>'+body+'<div class="row2" style="display:grid;grid-template-columns:1fr 1.4fr;gap:12px">'+no+yes+'</div></div>';if(typeof focusSheet==='function')focusSheet()};
window.subOpen=i=>{const s=S.subs[i];if(!s)return;
 $('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div style="display:flex;align-items:center;gap:12px"><div class="ico">'+s[0]+'</div><div class="h1" style="font-size:22px;line-height:30px">'+esc(s[1])+'</div></div><div style="margin:14px 0 18px">'+R('Price',fmt(s[2])+' RWF a '+per(s))+R('Billing',s[3])+R('Next charge',s[5]?when(s):'Paused, not charged')+R('Paid from','itunda Pay')+'</div><div class="row2" style="display:grid;grid-template-columns:1fr 1fr;gap:12px"><button class="btn sec2" onclick="closeSheet();subTg('+i+')">'+(s[5]?'Pause':'Resume')+'</button><button class="btn sec2" style="color:var(--er)" onclick="subAsk('+i+')">Cancel it</button></div><button class="btn" style="margin-top:12px;width:100%" onclick="closeSheet()">Done</button></div>';
 if(typeof focusSheet==='function')focusSheet()};
window.subAsk=i=>{const s=S.subs[i];if(!s)return;
 $('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="h1" style="font-size:22px;line-height:30px;margin-top:4px">Cancel '+esc(s[1])+'?</div><div class="mu" style="font-size:15px;margin:8px 0 24px;line-height:22px">You will not be charged again. To get it back, you set it up again with the provider.</div><div class="row2" style="display:grid;grid-template-columns:1fr 1.4fr;gap:12px"><button class="btn sec2" onclick="closeSheet()">Keep it</button><button class="btn" style="white-space:nowrap" onclick="subDel('+i+')">Cancel subscription</button></div></div>';
 if(typeof focusSheet==='function')focusSheet()};
window.subDel=i=>{const s=S.subs[i];if(!s)return;const n=s[1];S.subs.splice(i,1);closeSheet();render('fade-none');toast(n+' cancelled')};
document.title='itunda, clickable prototype v203';
})();
</script>
<script>
/* v204: Moto-Taxi ownership. Before: "Start saving for a motorbike" said "Savings goal created" but no goal was created (the Savings goal page and the Home card were unchanged), there was no way to say how fast you would save, the page showed "Monthly payment" without saying it starts only after the down payment is saved, and the price took up to 15 taps of +. Now: price shortcuts (1.5M, 2M, 2.5M, 3M); the page is in two parts, "First: save your down payment" (30%, "Save it in" 6 / 12 / 18 months, "about 50,000 RWF a month") and "Then: repay the loan" (months, loan amount, monthly payment, total); a review before it starts; the button really creates the savings goal "Motorbike down payment" (it shows on Home and the Savings goal page) and the page then says how much you have saved with "Open my savings goal"; if you already have a different savings goal, the page says so and links to it instead of replacing it. English only; fr/rw copy untouched. */
(function(){
const R=(a,v)=>'<div style="display:flex;justify-content:space-between;gap:12px;min-height:40px;align-items:center;font-size:15px;border-top:0"><span class="mu">'+a+'</span><b style="text-align:right">'+v+'</b></div>';
const T=[24,36,48],SC=[1500000,2000000,2500000,3000000],MS=[6,12,18],RATE=14,DOWN=.3;
const short=v=>v>=1e6?v/1e6+'M':v/1e3+'K';
S.moMs=S.moMs||12;
const st=()=>S.sv2.moto=S.sv2.moto||{a:2000000,tm:0,o:0};
const chipB=(on,fn,txt,al)=>'<button class="chip" aria-pressed="'+on+'" '+(al?'aria-label="'+al+'" ':'')+'onclick="'+fn+'" style="min-width:64px;height:44px;border-radius:22px;border:0;padding:0 16px;font-size:15px;font-weight:800;background:'+(on?'var(--tx)':'var(--chip)')+';color:'+(on?'var(--bg)':'var(--tx)')+'">'+txt+'</button>';
const lab=t=>'<div style="font-size:16px;font-weight:800;padding:22px 24px 0">'+t+'</div>';
const rw=(a,v,top)=>'<div style="margin:'+(top||8)+'px 24px 0;display:flex;justify-content:space-between;font-size:15px"><span class="mu">'+a+'</span><b>'+v+'</b></div>';
const calc=()=>{const s=st(),dn=Math.round(s.a*DOWN),loan=s.a-dn,n=T[s.tm||0],i=RATE/1200,mo=Math.round(loan*i/(1-Math.pow(1+i,-n)));return{s,dn,loan,n,mo,tot:mo*n,sv:Math.round(dn/S.moMs/1000)*1000||Math.round(dn/S.moMs)}};
const mine=()=>S.goal&&S.goal.moto;
const other=()=>S.goal&&!S.goal.moto;
const _s=screens.svc;
screens.svc=()=>{let h=_s();if(S.lang!=='en'||S.svk!=='moto')return h;
 const q=calc(),s=q.s;
 const sc='<div style="padding:14px 24px 0"><div style="display:flex;gap:10px;flex-wrap:wrap" role="group" aria-label="Price shortcuts">'+SC.map(v=>chipB(v===s.a,'svcSet(\'a\','+(v-s.a)+')',short(v),fmt(v)+' RWF')).join('')+'</div></div>';
 const save=lab('First: save your down payment')+rw('Down payment (30%)',fmt(q.dn)+' RWF',14)+'<div style="padding:12px 24px 0"><div class="sm mu" style="margin-bottom:8px">Save it in</div><div style="display:flex;gap:10px;flex-wrap:wrap" role="group">'+MS.map(v=>chipB(v===S.moMs,'moMs('+v+')',v+' months')).join('')+'</div></div>'+rw('About each month',fmt(q.sv)+' RWF',12)+lab('Then: repay the loan over');
 h=h.replace('<div class="chp" style="padding:14px 24px 0">',sc+save+'<div class="chp" style="padding:10px 24px 0">');
 h=h.replace(/Monthly payment<\/span><b>[^<]*<\/b><\/div>/,'Monthly loan payment</span><b>'+fmt(q.mo)+' RWF</b></div>');
 h=h.replace(/<div style="margin:8px 24px 0;display:flex;justify-content:space-between;font-size:15px"><span class="mu">Down payment to save<\/span><b>[^<]*<\/b><\/div>/,rw('Loan amount (70%)',fmt(q.loan)+' RWF')+rw('Total to repay',fmt(q.tot)+' RWF')+'<div class="pad sm mu" style="padding-top:8px;line-height:20px">The loan opens when your down payment is saved.</div>');
 h=h.replace(/<div style="display:flex;justify-content:space-between;gap:16px;padding:14px 24px;border-top:0;font-size:15px"><span class="mu">Down payment<\/span>.*?<\/div>/,'');
 let card='',btn;
 if(mine()){const g=S.goal;card='<div style="margin:18px 24px 0;padding:14px 16px;border-radius:16px;background:var(--tint);color:var(--tintfg);font-size:14px;line-height:20px"><b>You are saving for a motorbike.</b> '+fmt(g.s)+' of '+fmt(g.t)+' RWF saved.</div>';btn='<button class="btn" style="white-space:nowrap" onclick="openGoal()">Open my savings goal</button>'}
 else if(other()){card='<div style="margin:18px 24px 0;padding:14px 16px;border-radius:16px;background:var(--chip);font-size:14px;line-height:20px">You already have a savings goal: <b>'+String(S.goal.n).replace(/[<>&]/g,'')+'</b>. Finish it or delete it, then come back to start your motorbike goal.</div>';btn='<button class="btn" style="white-space:nowrap" onclick="openGoal()">Open my savings goal</button>'}
 else btn='<button class="btn" style="white-space:nowrap" onclick="svcGo()">Start saving '+fmt(q.dn)+' RWF</button>';
 if(card)h=h.replace('<div style="margin-top:18px">',card+'<div style="margin-top:18px">');
 h=h.replace(/<button class="btn" onclick="svcGo\(\)">[^<]*<\/button>/,btn);
 return h};
window.moMs=v=>{S.moMs=v;render('fade-none')};
const _g=window.svcGo;
window.svcGo=function(ok){if(S.lang!=='en'||S.svk!=='moto')return _g.apply(this,arguments);
 if(S.goal)return;const q=calc();
 if(ok===1){S.goal={n:'Motorbike down payment',t:q.dn,m:S.moMs,s:0,moto:true};closeSheet();render('fade-none');toast('Savings goal created');return}
 $('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="h1" style="font-size:22px;line-height:30px;margin-top:4px">Start saving for a motorbike?</div><div style="margin:12px 0 20px">'+R('Motorbike price',fmt(q.s.a)+' RWF')+R('Down payment (30%)',fmt(q.dn)+' RWF')+R('Save it in',S.moMs+' months')+R('About each month',fmt(q.sv)+' RWF')+R('Then the loan',fmt(q.loan)+' RWF over '+q.n+' months')+R('Loan payment',fmt(q.mo)+' RWF a month')+R('Rate',RATE+'% a year')+'</div><div class="mu sm" style="margin:-8px 0 16px;line-height:20px">This creates a savings goal called \u201cMotorbike down payment\u201d. It shows on Home.</div><div class="row2" style="display:grid;grid-template-columns:1fr 1.8fr"><button class="btn sec2" onclick="closeSheet()">Cancel</button><button class="btn" style="white-space:nowrap" onclick="svcGo(1)">Create my goal</button></div></div>';
 if(typeof focusSheet==='function')focusSheet()};
document.title='itunda, clickable prototype v204';
})();
</script>
<script>
/* v344: Intercity bus, calmer. Before: radio buttons with a tinted card on the chosen city, then three more rows of chips (day, time, seats), and tickets as tinted cards. Now: the page is four plain rows (Where to?, Which day?, Which bus?, Seats) with the choice on the right; tapping one opens a check list (a plain check, no radio, no card); the day list covers a week; each bus shows when it arrives; tickets are plain rows with a text Cancel link. Also: the booking state moved to S.bus, because the bill screen reuses S.bk as a number and could break the bus page. Fare, review, payment, Activity and cancel are unchanged. */
/* v205: Intercity bus. Before: "Book seat" showed a ticket message at once: no day, no departure time, no number of seats, no payment (your balance never changed), nothing in Activity, no ticket to find later, and the page's "Cancel: free up to 2 h before" could not be used. Now: four plain questions in order ("Where to?", "Which day?", "Which bus?", "How many seats?") with taps; a live line with the total and your itunda Pay balance after; a plain reason when something is missing or the balance is too low; a review (route, day, time, seats, total, balance after, cancel rule); the fare is taken from itunda Pay and a row is added to Activity; the ticket code is shown and kept under "Your tickets" on the page, where you can cancel it (refund to itunda Pay, shown in Activity) until 2 hours before departure. English only; fr/rw copy untouched. */
(function(){
const R=(a,v)=>'<div style="display:flex;justify-content:space-between;gap:12px;min-height:40px;align-items:center;font-size:15px;border-top:0"><span class="mu">'+a+'</span><b style="text-align:right">'+v+'</b></div>';
const DEST=[['Huye',3500,'about 2 h'],['Musanze',3000,'about 2 h'],['Rubavu',4000,'about 3 h 30'],['Rusizi',7500,'about 5 h']];
const p2=n=>String(n).padStart(2,'0');
const day=i=>{const d=new Date();d.setHours(0,0,0,0);d.setDate(d.getDate()+i);return d};
const dl=i=>i===0?'Today':i===1?'Tomorrow':day(i).toLocaleDateString('en-GB',{weekday:'short',day:'numeric',month:'short'});
const dfull=i=>day(i).toLocaleDateString('en-GB',{weekday:'short',day:'numeric',month:'short'});
const slots=i=>{if(i>0)return['06:00','08:00','10:00','14:00','16:30','18:00'];
 const n=new Date(),m=n.getHours()*60+n.getMinutes()+30,s=Math.max(Math.ceil(m/30)*30,5*60+30),out=[];
 for(let t=s;t<=22*60+30&&out.length<6;t+=30)out.push(p2(Math.floor(t/60))+':'+p2(t%60));return out};
S.bus=S.bus||{to:0,day:0,time:'',seats:1};S.tix=S.tix||[];
const when=(dayI,time)=>{const d=day(dayI);const[h,m]=time.split(':');d.setHours(+h,+m,0,0);return d};
const DUR=[120,120,210,300];
const arr=(t,m)=>{const[h,mi]=t.split(':'),x=(+h*60+ +mi+m)%1440;return p2(Math.floor(x/60))+':'+p2(x%60)};
const CKS='<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>',CHV='<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--tt)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>';
/* check-list row: plain check on the right of the chosen one, no radio, no tinted card */
const ck=(sel,fn,t,s,r)=>'<div class="row tap" role="radio" aria-checked="'+sel+'" tabindex="0" onclick="'+fn+'" style="padding:14px 24px"><div style="flex:1;min-width:0"><div class="t" style="font-weight:'+(sel?800:600)+'">'+t+'</div>'+(s?'<div class="s">'+s+'</div>':'')+'</div>'+(r?'<span class="mu" style="font-weight:700;white-space:nowrap">'+r+'</span>':'')+'<span style="color:var(--lk);width:24px;height:24px;display:flex;flex:none">'+(sel?CKS:'')+'</span></div>';
const vr=(f,t,v,empty)=>'<div class="row tap" role="button" tabindex="0" onclick="bkOpen(\''+f+'\')" style="padding:14px 24px"><div class="t" style="flex:1">'+t+'</div><b style="color:'+(empty?'var(--tt)':'var(--lk)')+';font-size:16px">'+v+'</b>'+CHV+'</div>';
const head=t=>'<div class="agt">'+t+'</div>';
const _s=screens.svc;
screens.svc=()=>{if(S.svk!=='bus')return _s();
 const b=S.bus,d=DEST[b.to],sl=slots(b.day),total=d[1]*b.seats,low=S.pay<total;
 if(b.time&&sl.indexOf(b.time)<0)b.time='';
 const miss=!b.time?(sl.length?'Pick a bus time to continue.':'No more buses today. Pick another day.'):'';
 const tix=S.tix.length?head('Your tickets')+S.tix.map((t,i)=>{const can=when(t.day,t.time)-new Date()>2*36e5;return '<div class="row" style="padding:12px 24px;align-items:flex-start"><div style="flex:1;min-width:0"><div class="t">Nyabugogo to '+t.to+'</div><div class="s">'+dfull(t.day)+' at '+t.time+' \u00b7 '+t.seats+' seat'+(t.seats>1?'s':'')+' \u00b7 '+fmt(t.total)+' RWF</div>'+(can?'<button onclick="bkCancelAsk('+i+')" style="border:0;background:none;padding:8px 0 0;color:var(--lk);font-weight:800;font-size:14px">Cancel ticket</button>':'<div class="s" style="margin-top:4px">Free cancel closed, less than 2 hours to go.</div>')+'</div><b>'+t.code+'</b></div>'}).join(''):'';
 return bar('Intercity bus')+'<div style="padding:22px 24px 0"><div class="h1">Intercity bus</div><div class="mu" style="font-size:15px;line-height:22px;margin-top:8px">Leaves Nyabugogo, KN 3 Rd. 1 bag included.</div></div>'+tix+
 '<div style="padding-top:18px">'+vr('to','Where to?',d[0])+vr('day','Which day?',dl(b.day))+vr('time','Which bus?',b.time||'Choose',!b.time)+vr('seats','Seats',b.seats)+'</div>'+
 '<div class="pad sm" style="padding-top:16px;line-height:20px" aria-live="polite">'+(low?'<span style="color:var(--er)">'+fmt(total)+' RWF is more than your itunda Pay balance of '+fmt(S.pay)+' RWF. Pick fewer seats.</span>':'<b>'+fmt(total)+' RWF</b> <span class="mu">from itunda Pay \u00b7 balance after '+fmt(S.pay-total)+' RWF \u00b7 free to cancel up to 2 hours before</span>')+'</div><div class="pad fine" style="padding-top:12px">Times and travel times are samples for this prototype.</div><div style="height:100px"></div>'+
 '<div class="cta"><button class="btn" style="white-space:nowrap" '+(miss||low?'disabled ':'')+'onclick="bkReview()">Book '+b.seats+' seat'+(b.seats>1?'s':'')+' \u00b7 '+fmt(total)+' RWF</button>'+(miss?'<div class="sm mu" style="text-align:center;margin-top:8px">'+miss+'</div>':'')+'</div>'};
window.bkOpen=f=>{const b=S.bus,T={to:'Where to?',day:'Which day?',time:'Which bus?',seats:'How many seats?'}[f];let rows='';
 if(f==='to')rows=DEST.map((x,i)=>ck(b.to===i,'bkSet(\'to\','+i+')',x[0],x[2],fmt(x[1])+' RWF')).join('');
 else if(f==='day')rows=[0,1,2,3,4,5,6].map(i=>ck(b.day===i,'bkSet(\'day\','+i+')',dl(i),i<2?dfull(i):'')).join('');
 else if(f==='time'){const sl=slots(b.day),m=DUR[b.to];rows=sl.length?sl.map(t=>ck(b.time===t,'bkSet(\'time\',\''+t+'\')',t,'Arrives about '+arr(t,m))).join(''):'<div class="mu" style="padding:8px 24px;font-size:15px">No more buses today. Pick another day.</div>'}
 else rows=[1,2,3,4].map(n=>ck(b.seats===n,'bkSet(\'seats\','+n+')',n+(n>1?' seats':' seat'),'',fmt(DEST[b.to][1]*n)+' RWF')).join('');
 $('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="h1" style="font-size:22px;line-height:30px;margin:4px 0 8px">'+T+'</div><div style="margin:0 -24px;max-height:56vh;overflow-y:auto">'+rows+'</div></div>';if(typeof focusSheet==='function')focusSheet()};
window.bkSet=(f,v)=>{const b=S.bus;b[f]=v;if(f==='day')b.time='';closeSheet();render('fade-none')};
const sheet=(h,body,no,yes,go)=>{$('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="h1" style="font-size:22px;line-height:30px;margin-top:4px">'+h+'</div><div style="margin:12px 0 20px">'+body+'</div><div class="row2" style="display:grid;grid-template-columns:1fr 1.8fr"><button class="btn sec2" onclick="closeSheet()">'+no+'</button><button class="btn" style="white-space:nowrap" onclick="'+go+'">'+yes+'</button></div></div>';if(typeof focusSheet==='function')focusSheet()};
window.bkReview=()=>{const b=S.bus,d=DEST[b.to],total=d[1]*b.seats;if(!b.time||S.pay<total)return;
 sheet('Book '+b.seats+' seat'+(b.seats>1?'s':'')+' to '+d[0]+'?',R('Route','Nyabugogo to '+d[0])+R('Day',dfull(b.day))+R('Leaves',b.time)+R('Seats',b.seats+' \u00d7 '+fmt(d[1])+' RWF')+R('Total',fmt(total)+' RWF')+R('Paid from','itunda Pay')+R('Balance after',fmt(S.pay-total)+' RWF')+R('Cancel','Free up to 2 h before'),'Cancel','Pay '+fmt(total)+' RWF','bkGo()')};
window.bkGo=()=>{const b=S.bus,d=DEST[b.to],total=d[1]*b.seats;if(!b.time||S.pay<total)return;
 const code='NB-'+String(Date.now()).slice(-5);S.pay-=total;S.tix.push({code,to:d[0],day:b.day,time:b.time,seats:b.seats,total});
 addAct('bus','Intercity bus \u00b7 '+d[0],'Paid',-total,'Paid');const tm=b.time;b.time='';render('fade-none');
 $('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="g3" style="font-size:56px;line-height:1;margin-bottom:10px">\ud83c\udfab</div><div class="h1" style="font-size:22px;line-height:30px">Seat booked</div><div class="mu" style="font-size:15px;margin:8px 0 8px;line-height:22px">Nyabugogo to '+d[0]+', '+dfull(b.day)+' at '+tm+'. Show this code at Nyabugogo.</div><div style="font-weight:800;font-size:20px;margin-bottom:6px">'+code+'</div><div class="sm mu" style="margin-bottom:24px">itunda Pay balance now '+fmt(S.pay)+' RWF. Your ticket stays on this page.</div><button class="btn" onclick="closeSheet()">OK</button></div>';
 if(typeof focusSheet==='function')focusSheet()};
window.bkCancelAsk=i=>{const t=S.tix[i];if(!t)return;sheet('Cancel your ticket to '+t.to+'?',R('Ticket',t.code)+R('Leaves',dfull(t.day)+' at '+t.time)+R('You get back',fmt(t.total)+' RWF in itunda Pay')+R('Fee','Free'),'Keep it','Cancel ticket','bkCancel('+i+')')};
window.bkCancel=i=>{const t=S.tix[i];if(!t)return;S.tix.splice(i,1);S.pay+=t.total;addAct('bus','Intercity bus refund \u00b7 '+t.to,'Received',t.total,'Received');closeSheet();render('fade-none');toast('Ticket cancelled, '+fmt(t.total)+' RWF refunded')};
document.title='itunda, clickable prototype v205';
})();
</script>
<script>
/* v206: Bike rental. Before: "Unlock" showed a code and that was all: no payment, no ride on the page, nothing to end, nothing in Activity, and the price ("20 RWF / min") was never added up. Now: pick Bike or E-scooter (price per minute, and what 15 minutes cost), a short "How it works" in three numbered steps, a plain reason if itunda Pay is too low; a review before unlocking (price per minute, where, paid from, charged when you lock); after unlocking the page shows "Ride in progress" with a live timer and the fare so far, and "End ride"; ending asks first (time, fare, balance after), takes the fare from itunda Pay, adds it to Activity and shows a receipt; the last rides are listed under "Recent rides". A small "Skip 10 minutes" link lets you see the fare grow in this prototype. English only; fr/rw copy untouched. */
(function(){
const R=(a,v)=>'<div style="display:flex;justify-content:space-between;gap:12px;min-height:40px;align-items:center;font-size:15px;border-top:0"><span class="mu">'+a+'</span><b style="text-align:right">'+v+'</b></div>';
const V=[['Bike',20,'\ud83d\udeb2'],['E-scooter',50,'\ud83d\udef4']];
S.busr=S.busr||null;S.bush=S.bush||[];S.busv=S.busv||0;
const A=n=>(/^[aeiou]/i.test(n)?'an ':'a ')+n.toLowerCase();
const lab=t=>'<div style="font-size:16px;font-weight:800;padding:22px 24px 0">'+t+'</div>';
const el=()=>{const r=S.bkr;if(!r)return 0;return Date.now()-r.t0+(r.skip||0)*6e4};
const mins=()=>Math.max(1,Math.ceil(el()/6e4));
const fare=()=>Math.min(S.pay,mins()*V[S.bkr.v][1]);
const clock=()=>{const s=Math.floor(el()/1000),m=Math.floor(s/60),x=s%60;return m+':'+String(x).padStart(2,'0')};
const _s=screens.svc;
screens.svc=()=>{if(S.lang!=='en'||S.svk!=='bike')return _s();
 if(S.bkr){const r=S.bkr,v=V[r.v];
  return bar('Bike rental')+'<div style="margin:22px 24px 0;padding:20px;border-radius:20px;background:var(--tint);text-align:center"><div style="font-size:40px">'+v[2]+'</div><div class="sm" style="color:var(--tintfg);margin-top:6px">Ride in progress \u00b7 '+v[0]+'</div><div id="bkT" class="big" style="margin-top:8px" aria-live="off">'+clock()+'</div><div id="bkF" class="sm" style="margin-top:8px;color:var(--tintfg)">'+fmt(fare())+' RWF so far at '+v[1]+' RWF a minute</div></div>'+
  '<div class="pad sm mu" style="padding-top:14px;line-height:20px">Unlock code <b style="color:var(--tx)">'+r.code+'</b>. Lock the '+v[0].toLowerCase()+' when you are done, then tap End ride. The fare comes from itunda Pay.</div><div class="pad" style="padding-top:6px"><button class="sm" style="background:none;border:0;color:var(--lk);font-weight:700;padding:8px 0" onclick="bkrSkip()">Skip 10 minutes (prototype only)</button></div><div style="height:100px"></div><div class="cta"><button class="btn" onclick="bkrEndAsk()">End ride</button></div>'}
 const v=V[S.bkv],low=S.pay<v[1]*15;
 const rows=V.map((x,i)=>'<div class="row tap" role="radio" aria-checked="'+(S.bkv===i)+'" tabindex="0" onclick="bkrPick('+i+')" style="padding:12px 24px;'+(S.bkv===i?'background:var(--tint)':'')+'"><div class="ico" style="font-size:22px">'+x[2]+'</div><div style="flex:1"><div class="t">'+x[0]+'</div><div class="s">15 minutes cost '+fmt(x[1]*15)+' RWF</div></div><b>'+x[1]+' RWF / min</b></div>').join('');
 const hist=S.bkh.length?lab('Recent rides')+S.bkh.slice(0,3).map(h=>'<div style="display:flex;justify-content:space-between;gap:12px;padding:12px 24px;border-top:0;font-size:15px"><span>'+h.v+' \u00b7 '+h.m+' min</span><b>'+fmt(h.f)+' RWF</b></div>').join(''):'';
 const step=(n,t)=>'<div style="display:flex;gap:12px;align-items:flex-start;padding:6px 24px 0"><div style="width:24px;height:24px;border-radius:12px;background:var(--chip);display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:800;flex:none">'+n+'</div><div style="font-size:15px;line-height:24px">'+t+'</div></div>';
 return bar('Bike rental')+'<div style="padding:22px 24px 0"><div class="h1">Rent by the minute</div><div class="mu" style="font-size:15px;line-height:22px;margin-top:8px">Nearest: Kimironko Market, 120 m. You pay from itunda Pay: <b style="color:var(--tx)">'+fmt(S.pay)+' RWF</b>.</div></div>'+
 lab('Which one?')+'<div role="radiogroup" style="padding-top:6px">'+rows+'</div>'+
 lab('How it works')+step(1,'Scan the QR code on the handlebar.')+step(2,'Enter the unlock code on the lock.')+step(3,'Lock it when you are done. The ride ends and you pay for the minutes used.')+
 '<div class="pad sm" style="padding-top:18px;line-height:20px" aria-live="polite">'+(low?'<span style="color:var(--er)">Keep at least '+fmt(v[1]*15)+' RWF (15 minutes) in itunda Pay to rent '+A(v[0])+'. You have '+fmt(S.pay)+' RWF.</span>':'<span class="mu">Charged when you lock it, '+v[1]+' RWF a minute.</span>')+'</div>'+hist+'<div class="pad fine" style="padding-top:14px">Sample prices and places for this prototype.</div><div style="height:100px"></div>'+
 '<div class="cta"><button class="btn" '+(low?'disabled ':'')+'style="white-space:nowrap" onclick="bkrAsk()">Unlock '+A(v[0])+'</button></div>'};
window.bkrPick=i=>{S.bkv=i;render('fade-none')};
const sheet=(h,body,no,yes,go)=>{$('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="h1" style="font-size:22px;line-height:30px;margin-top:4px">'+h+'</div><div style="margin:12px 0 20px">'+body+'</div><div class="row2" style="display:grid;grid-template-columns:1fr 1.8fr"><button class="btn sec2" onclick="closeSheet()">'+no+'</button><button class="btn" style="white-space:nowrap" onclick="'+go+'">'+yes+'</button></div></div>';if(typeof focusSheet==='function')focusSheet()};
window.bkrAsk=()=>{const v=V[S.bkv];if(S.pay<v[1]*15)return;sheet('Unlock '+A(v[0])+'?',R('Price',v[1]+' RWF a minute')+R('Where','Kimironko Market, 120 m')+R('Paid from','itunda Pay')+R('Charged','When you lock it'),'Cancel','Unlock','bkrGo()')};
window.bkrGo=()=>{const v=V[S.bkv],code=String(1000+Math.floor(Math.random()*9000));S.bkr={v:S.bkv,t0:Date.now(),skip:0,code};render('fade-none');
 $('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="g3" style="font-size:56px;line-height:1;margin-bottom:10px">\ud83d\udd13</div><div class="h1" style="font-size:22px;line-height:30px">Unlock code '+code+'</div><div class="mu" style="font-size:15px;margin:8px 0 24px;line-height:22px">Enter it on the lock. Your ride ends when you lock the '+v[0].toLowerCase()+'.</div><button class="btn" onclick="closeSheet()">OK</button></div>';
 if(typeof focusSheet==='function')focusSheet()};
window.bkrSkip=()=>{if(S.bkr){S.bkr.skip=(S.bkr.skip||0)+10;render('fade-none')}};
window.bkrEndAsk=()=>{const r=S.bkr;if(!r)return;const v=V[r.v],f=fare();sheet('End your ride?',R('Time',mins()+' min')+R('Price',v[1]+' RWF a minute')+R('Fare',fmt(f)+' RWF')+R('Paid from','itunda Pay')+R('Balance after',fmt(S.pay-f)+' RWF'),'Keep riding','Pay '+fmt(f)+' RWF','bkrEnd()')};
window.bkrEnd=()=>{const r=S.bkr;if(!r)return;const v=V[r.v],m=mins(),f=fare();S.pay-=f;S.bkh.unshift({v:v[0],m,f});S.bkr=null;
 addAct('bus','Bike rental \u00b7 '+v[0]+', '+m+' min','Paid',-f,'Paid');render('fade-none');
 $('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="g3" style="font-size:56px;line-height:1;margin-bottom:10px">\u2705</div><div class="h1" style="font-size:22px;line-height:30px">Ride ended</div><div class="mu" style="font-size:15px;margin:8px 0 8px;line-height:22px">'+v[0]+', '+m+' min. '+fmt(f)+' RWF paid from itunda Pay.</div><div style="font-weight:800;margin-bottom:24px">itunda Pay balance now '+fmt(S.pay)+' RWF</div><button class="btn" onclick="closeSheet()">OK</button></div>';
 if(typeof focusSheet==='function')focusSheet()};
setInterval(()=>{if(!S.bkr)return;const t=document.getElementById('bkT'),f=document.getElementById('bkF');if(!t||!f)return;t.textContent=clock();f.textContent=fmt(fare())+' RWF so far at '+V[S.bkr.v][1]+' RWF a minute'},1000);
document.title='itunda, clickable prototype v206';
})();
</script>
<script>
/* v207: Family. Before: "Invite a family member" said "Invite sent" without asking who: no name, no phone number, no child or guardian choice, no limit for a child, and nothing to look at afterwards. Now: "Who are you linking?" (a child, or a guardian) with one plain line saying what each can see; their name and phone number as typed fields with a live count ("7 of 10 digits"), a message if the number does not start with 07 or was already invited; for a child, the weekly spending limit (1,000 / 3,000 / 5,000 RWF); a button that names the person ("Send invite to Aline") and a line saying what is missing while it is off; a review before sending; and "Your family" on the page with each invite and Cancel invite (with a confirmation). English only; fr/rw copy untouched. */
(function(){
const R=(a,v)=>'<div style="display:flex;justify-content:space-between;gap:12px;min-height:40px;align-items:center;font-size:15px;border-top:0"><span class="mu">'+a+'</span><b style="text-align:right">'+v+'</b></div>';
const esc=x=>String(x).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
S.fam=S.fam||[];S.fm=S.fm||{role:'child',n:'',ph:'',lim:3000};
const dg=v=>String(v||'').replace(/\D/g,'').slice(0,10);
const nm=()=>(S.fm.n||'').trim();
const dup=()=>S.fam.some(x=>x.ph===dg(S.fm.ph));
const phMsg=()=>{const d=dg(S.fm.ph);if(!d)return{t:'Type their phone number, for example 078 123 4567.',ok:0};if(d.length<10)return{t:d.length+' of 10 digits',ok:0};if(d.slice(0,2)!=='07')return{t:'Rwandan mobile numbers start with 07.',ok:0,er:1};if(dup())return{t:'You already invited this number.',ok:0,er:1};return{t:'Looks good.',ok:1}};
const miss=()=>nm().length<2?'Type their name to continue.':(!phMsg().ok?'Fix their phone number to continue.':'');
const fmtP=d=>d.replace(/^(\d{3})(\d{0,3})(\d{0,4}).*/,(m,a,b,c)=>[a,b,c].filter(Boolean).join(' '));
const lab=t=>'<div style="font-size:16px;font-weight:800;padding:22px 24px 0">'+t+'</div>';
const chipB=(on,fn,txt)=>'<button class="chip" aria-pressed="'+on+'" onclick="'+fn+'" style="min-width:64px;height:44px;border-radius:22px;border:0;padding:0 16px;font-size:15px;font-weight:800;background:'+(on?'var(--tx)':'var(--chip)')+';color:'+(on?'var(--bg)':'var(--tx)')+'">'+txt+'</button>';
const inp=(id,v,ph,fn,mode)=>'<input id="'+id+'" value="'+esc(v)+'" oninput="'+fn+'(this.value)" autocomplete="off" '+(mode?'inputmode="'+mode+'" ':'')+'placeholder="'+ph+'" aria-describedby="'+id+'H" style="width:100%;height:48px;margin-top:10px;border:0;border-radius:14px;background:var(--chip);color:var(--tx);padding:0 16px;font:inherit;font-size:16px">';
const _s=screens.svc;
screens.svc=()=>{if(S.lang!=='en'||S.svk!=='family')return _s();
 const f=S.fm,ch=f.role==='child',pm=phMsg(),m=miss();
 const roles=[['child','A child','You are their guardian. You see their spending and set their weekly limit.'],['guardian','A guardian','They can see your spending, read-only.']].map(r=>'<div class="row tap" role="radio" aria-checked="'+(f.role===r[0])+'" tabindex="0" onclick="famRole(\''+r[0]+'\')" style="padding:12px 24px;'+(f.role===r[0]?'background:var(--tint)':'')+'"><div style="width:22px;height:22px;border-radius:11px;border:2px solid '+(f.role===r[0]?'var(--lk)':'var(--ln)')+';display:flex;align-items:center;justify-content:center;flex:none">'+(f.role===r[0]?'<div style="width:10px;height:10px;border-radius:5px;background:var(--lk)"></div>':'')+'</div><div style="flex:1"><div class="t">'+r[1]+'</div><div class="s">'+r[2]+'</div></div></div>').join('');
 const list=S.fam.length?lab('Your family')+S.fam.map((x,i)=>'<div class="row" style="cursor:default;padding:12px 24px"><div class="ico" style="font-size:14px;font-weight:800">'+esc(x.n.split(/\s+/).map(w=>w[0]).join('').slice(0,2).toUpperCase())+'</div><div style="flex:1;min-width:0"><div class="t">'+esc(x.n)+'</div><div class="s">'+(x.role==='child'?'Child \u00b7 limit '+fmt(x.lim)+' RWF a week':'Guardian')+' \u00b7 '+fmtP(x.ph)+'<br>Invite sent, waiting for them</div></div><button class="sm" style="background:none;border:0;color:var(--er);font-weight:700;padding:8px 0 8px 8px" onclick="famAsk('+i+')">Cancel</button></div>').join(''):'';
 return bar('Family')+'<div style="padding:22px 24px 0"><div class="h1">Link your family</div><div class="mu" style="font-size:15px;line-height:22px;margin-top:8px">Link a guardian or a child. Guardians see spending, read-only.</div></div>'+list+
 lab('Who are you linking?')+'<div role="radiogroup" style="padding-top:6px">'+roles+'</div>'+
 '<div style="padding:0 24px">'+lab('Their name').replace('padding:22px 24px 0','padding:22px 0 0')+inp('fN',f.n,'Their first name','famName')+lab('Their phone number').replace('padding:22px 24px 0','padding:22px 0 0')+inp('fP',f.ph,'078 123 4567','famPh','tel')+'<div id="fPH" class="sm" style="margin-top:8px;color:'+(pm.er?'var(--er)':pm.ok?'var(--ok)':'var(--mu)')+'" aria-live="polite">'+pm.t+'</div></div>'+
 (ch?lab('Weekly spending limit')+'<div style="display:flex;gap:10px;flex-wrap:wrap;padding:10px 24px 0" role="group">'+[1000,3000,5000].map(v=>chipB(f.lim===v,'famLim('+v+')',fmt(v)+' RWF')).join('')+'</div><div class="pad sm mu" style="padding-top:8px">You can change it later.</div>':'')+
 '<div class="pad fine" style="padding-top:18px">They see a request the next time they open itunda. Sample data.</div><div style="height:100px"></div><div class="cta"><button class="btn" id="fGo" style="white-space:nowrap" '+(m?'disabled ':'')+'onclick="famReview()">'+(nm().length>=2?'Send invite to '+esc(nm()):'Send invite')+'</button><div id="fW" class="sm mu" style="text-align:center;margin-top:8px">'+m+'</div></div>'};
window.famRole=r=>{S.fm.role=r;render('fade-none')};
window.famLim=v=>{S.fm.lim=v;render('fade-none')};
const upd=()=>{const pm=phMsg(),m=miss(),b=document.getElementById('fGo'),w=document.getElementById('fW'),h=document.getElementById('fPH');
 if(b){b.disabled=!!m;b.textContent=nm().length>=2?'Send invite to '+nm():'Send invite'}if(w)w.textContent=m;
 if(h){h.textContent=pm.t;h.style.color=pm.er?'var(--er)':pm.ok?'var(--ok)':'var(--mu)'}};
window.famName=v=>{S.fm.n=v;upd()};
window.famPh=v=>{S.fm.ph=v;upd()};
const sheet=(h,body,note,no,yes,go)=>{$('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="h1" style="font-size:22px;line-height:30px;margin-top:4px">'+h+'</div><div style="margin:12px 0 '+(note?'12':'20')+'px">'+body+'</div>'+(note?'<div class="mu sm" style="margin-bottom:16px;line-height:20px">'+note+'</div>':'')+'<div class="row2" style="display:grid;grid-template-columns:1fr 1.8fr"><button class="btn sec2" onclick="closeSheet()">'+no+'</button><button class="btn" style="white-space:nowrap" onclick="'+go+'">'+yes+'</button></div></div>';if(typeof focusSheet==='function')focusSheet()};
window.famReview=()=>{if(miss())return;const f=S.fm,ch=f.role==='child';
 sheet('Send an invite to '+esc(nm())+'?',R('Linking',ch?'A child':'A guardian')+R('Name',esc(nm()))+R('Phone',fmtP(dg(f.ph)))+(ch?R('Weekly limit',fmt(f.lim)+' RWF'):'')+R(ch?'You can see':'They can see',ch?'Their spending, read-only':'Your spending, read-only'),'They get a request the next time they open itunda. You can cancel it until they accept.','Cancel','Send invite','famGo()')};
window.famGo=()=>{if(miss())return;const f=S.fm,n=nm();S.fam.push({n,ph:dg(f.ph),role:f.role,lim:f.lim});S.fm={role:f.role,n:'',ph:'',lim:f.lim};closeSheet();render('fade-none');toast('Invite sent to '+n)};
window.famAsk=i=>{const x=S.fam[i];if(!x)return;sheet('Cancel the invite to '+esc(x.n)+'?',R('Phone',fmtP(x.ph))+R('Linking',x.role==='child'?'A child':'A guardian'),'','Keep it','Cancel invite','famDel('+i+')')};
window.famDel=i=>{const x=S.fam[i];if(!x)return;S.fam.splice(i,1);closeSheet();render('fade-none');toast('Invite to '+x.n+' cancelled')};
document.title='itunda, clickable prototype v207';
})();
</script>
<script>
/* v208: 31-day savings. Before: "Start saving" only said the feature was not ready, the page showed a made-up "12-day streak" that never changed, and you could not pick an amount, so nothing was saved and the bonus could not be earned. Now: "How much each day?" with 200 / 500 / 1,000 / 2,000 RWF to tap and a live line (31 days x amount = total, and your itunda Bank balance, or a plain reason when it is too low); the four bonus steps (7, 14, 21, 31 days) listed under it; a review before the first save with the terms and a button that names the amount ("Save 500 RWF now"). After starting, the page shows your real streak ("Day 3 of 31"), what you have saved, the bonus you have now and how many days to the next step, and either "Save 500 RWF for today" or "Today is done". Each save takes the money from itunda Bank and adds a row to Activity. Day 31 offers "Collect" with the bonus added; you can stop any time and take your savings back (no bonus). Two small prototype-only buttons let you jump to tomorrow, or skip a day to see the streak restart. English only; fr/rw copy untouched. */
(function(){
const R=(a,v)=>'<div style="display:flex;justify-content:space-between;gap:12px;min-height:40px;align-items:center;font-size:15px;border-top:0"><span class="mu">'+a+'</span><b style="text-align:right">'+v+'</b></div>';
const TI=[[7,2],[14,4],[21,6],[31,10]],AM=[200,500,1000,2000];
const fresh=p=>({on:0,a:p||500,n:0,t:0,d:0,pick:p||500});
const st=()=>S.dsv31=S.dsv31||fresh();
const rate=n=>{let r=0;TI.forEach(([d,p])=>{if(n>=d)r=p});return r};
const nextT=n=>TI.find(([d])=>n<d);
const tiers=n=>'<div style="margin-top:8px">'+TI.map(([d,p])=>'<div style="display:flex;justify-content:space-between;min-height:44px;align-items:center;font-size:15px;border-top:0"><span class="'+(n>=d?'':'mu')+'" style="display:flex;align-items:center;gap:8px">'+(n>=d?ic('check',16,'var(--lk)'):'')+'Day '+d+'</span><b>'+p+'% bonus</b></div>').join('')+'</div>';
const dots=n=>'<div style="display:flex;flex-wrap:wrap;gap:8px" role="img" aria-label="'+n+' of 31 days saved">'+Array.from({length:31},(_,i)=>'<div style="width:18px;height:18px;border-radius:9px;background:'+(i<n?'var(--br)':'var(--chip)')+'"></div>').join('')+'</div>';
const chip=(v,on,fn)=>'<button class="chip" aria-pressed="'+on+'" onclick="'+fn+'('+v+')" style="min-width:64px;height:44px;border-radius:22px;border:0;padding:0 14px;font-size:15px;font-weight:800;background:'+(on?'var(--tx)':'var(--chip)')+';color:'+(on?'var(--bg)':'var(--tx)')+'">'+fmt(v)+'</button>';
const sheet=(h,body,note,no,yes,go)=>{$('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="h1" style="font-size:22px;line-height:30px;margin-top:4px">'+h+'</div><div style="margin:12px 0 '+(note?'12':'20')+'px">'+body+'</div>'+(note?'<div class="mu sm" style="margin-bottom:16px;line-height:20px">'+note+'</div>':'')+'<div class="row2" style="display:grid;grid-template-columns:1fr 1.8fr"><button class="btn sec2" onclick="closeSheet()">'+no+'</button><button class="btn" style="white-space:nowrap" onclick="'+go+'">'+yes+'</button></div></div>';if(typeof focusSheet==='function')focusSheet()};
const _o=screens.save31;
screens.save31=()=>{if(S.lang!=='en')return _o();
 const s=st(),H=bar('31-day savings');
 if(!s.on){
  const a=s.pick,bad=a>S.bank;
  return H+'<div class="pad" style="padding-top:24px"><div class="h1">Save a little every day for 31 days</div><div class="mu" style="font-size:16px;margin-top:12px;line-height:24px">Pick an amount you can save each day. The longer your streak, the higher your bonus, up to 10%.</div></div>'+
  '<div style="font-size:16px;font-weight:800;padding:28px 24px 0">How much each day?</div><div style="padding:12px 24px 0"><div style="display:flex;gap:10px;flex-wrap:wrap" role="group" aria-label="Daily amount">'+AM.map(v=>chip(v,v===a,'s31Pick')).join('')+'</div>'+
  '<div class="sm" style="margin-top:12px;line-height:20px" aria-live="polite">'+(bad?'<span style="color:var(--er)">This is more than your itunda Bank balance of '+fmt(S.bank)+' RWF. Pick a smaller amount.</span>':'<span class="mu">31 days \u00d7 '+fmt(a)+' = <b style="color:var(--tx)">'+fmt(a*31)+' RWF</b> \u00b7 itunda Bank balance '+fmt(S.bank)+' RWF</span>')+'</div></div>'+
  '<div style="font-size:16px;font-weight:800;padding:28px 24px 0">Your bonus grows with your streak</div><div class="pad">'+tiers(0)+'</div>'+
  '<div class="pad fine" style="padding-top:14px;line-height:18px">Save once a day. If you miss a day, your streak starts again at day 1. What you saved stays yours. Rates are sample data. itunda Bank is not a licensed bank.</div><div style="height:100px"></div>'+
  '<div class="cta"><button class="btn" style="white-space:nowrap" '+(bad?'disabled ':'')+'onclick="s31Ask()">Save '+fmt(a)+' RWF to start</button></div>';
 }
 const n=s.n,a=s.a,r=rate(n),nx=nextT(n);
 if(n>=31){
  const b=Math.round(s.t*r/100);
  return H+'<div class="pad" style="padding-top:24px"><div class="h1">You made it: 31 days in a row</div><div class="mu" style="font-size:16px;margin-top:12px;line-height:24px">You saved '+fmt(s.t)+' RWF and earned a '+r+'% bonus of '+fmt(b)+' RWF.</div></div><div class="pad" style="padding-top:28px">'+dots(31)+'</div><div class="pad" style="padding-top:20px">'+R('Your savings',fmt(s.t)+' RWF')+R('Bonus ('+r+'%)','+'+fmt(b)+' RWF')+R('You get',fmt(s.t+b)+' RWF')+'</div><div style="height:100px"></div><div class="cta"><button class="btn" style="white-space:nowrap" onclick="s31CollectAsk()">Collect '+fmt(s.t+b)+' RWF</button></div>';
 }
 const bad=a>S.bank;
 return H+'<div class="pad" style="padding-top:24px"><div class="sm mu" style="font-weight:700">Your streak</div><div class="h1" style="margin-top:4px">'+(n?'Day '+n+' of 31':'Start again today')+'</div><div class="mu" style="font-size:16px;margin-top:10px;line-height:24px">'+(n?'Saved so far <b style="color:var(--tx)">'+fmt(s.t)+' RWF</b> \u00b7 bonus now '+r+'%':'You missed a day, so your streak restarted. You still have <b style="color:var(--tx)">'+fmt(s.t)+' RWF</b> saved.')+'</div></div>'+
 '<div class="pad" style="padding-top:24px">'+dots(n)+'<div class="sm mu" style="margin-top:12px;line-height:20px">'+(nx?'Next bonus: '+nx[1]+'% at day '+nx[0]+' \u00b7 '+(nx[0]-n)+' day'+(nx[0]-n===1?'':'s')+' to go':'')+'</div></div>'+
 '<div class="pad" style="padding-top:20px"><div style="padding:16px 18px;border-radius:20px;background:var(--chip);font-size:15px;line-height:22px;font-weight:700" aria-live="polite">'+(s.d?'Today is done. Come back tomorrow to keep your streak going.':bad?'<span style="color:var(--er)">Your itunda Bank balance is '+fmt(S.bank)+' RWF, which is less than '+fmt(a)+' RWF.</span>':'Today: save '+fmt(a)+' RWF to '+(n?'reach day '+(n+1):'begin day 1')+'.')+'</div></div>'+
 '<div style="font-size:16px;font-weight:800;padding:28px 24px 0">Bonus by streak</div><div class="pad">'+tiers(n)+'</div>'+
 '<div class="pad" style="padding-top:20px"><button onclick="s31StopAsk()" style="border:0;background:none;padding:0;min-height:44px;color:var(--lk);font-weight:700;font-size:15px">Stop and take back '+fmt(s.t)+' RWF</button><div class="fine" style="margin-top:2px">You will not get the bonus if you stop before day 31.</div></div>'+
 '<div class="pad" style="padding-top:12px"><div class="fine" style="margin-bottom:4px">Prototype only</div>'+(s.d?'<button class="chip" onclick="s31Day(1)" style="height:44px;border-radius:22px;border:0;padding:0 16px;font-size:14px;font-weight:700;background:var(--chip);color:var(--tx)">Go to tomorrow</button>':'<button class="chip" onclick="s31Day(0)" style="height:44px;border-radius:22px;border:0;padding:0 16px;font-size:14px;font-weight:700;background:var(--chip);color:var(--tx)">Skip today and restart the streak</button>')+'</div><div style="height:100px"></div>'+
 '<div class="cta"><button class="btn" style="white-space:nowrap" '+(s.d||bad?'disabled ':'')+'onclick="s31Ask()">'+(s.d?'Saved today':'Save '+fmt(a)+' RWF for today')+'</button></div>';
};
window.s31Pick=v=>{st().pick=v;render('fade-none')};
window.s31Ask=()=>{const s=st(),a=s.on?s.a:s.pick;if(a>S.bank||(s.on&&s.d))return;
 if(!s.on)return sheet('Start your 31-day streak?',R('Each day',fmt(a)+' RWF')+R('First save','Today')+R('Total after 31 days',fmt(a*31)+' RWF')+R('Paid from','itunda Bank')+R('Bank balance after',fmt(S.bank-a)+' RWF'),'Save once a day. If you miss a day, your streak starts again at day 1.','Cancel','Save '+fmt(a)+' RWF now','s31Go()');
 sheet('Save '+fmt(a)+' RWF for day '+(s.n+1)+'?',R('Streak after',(s.n+1)+' of 31 days')+R('Saved after',fmt(s.t+a)+' RWF')+R('Paid from','itunda Bank')+R('Bank balance after',fmt(S.bank-a)+' RWF'),'','Cancel','Save '+fmt(a)+' RWF','s31Go()')};
window.s31Go=()=>{const s=st(),a=s.on?s.a:s.pick;if(a>S.bank||(s.on&&s.d))return;
 s.a=a;s.on=1;s.n++;s.t+=a;s.d=1;S.bank-=a;addAct('coin','31-day savings \u00b7 Day '+s.n,'Saved',-a,'Sent');closeSheet();render('fade-none');
 toast(s.n===31?'Day 31 done. Your bonus is ready.':'Day '+s.n+' saved. See you tomorrow.');if(s.n===31)setTimeout(confetti,200)};
window.s31Day=k=>{const s=st();if(k){s.d=0}else{s.n=0;s.d=0}render('fade-none');toast(k?'It is a new day.':'Streak restarted at day 1.')};
window.s31StopAsk=()=>{const s=st();sheet('Stop and take back '+fmt(s.t)+' RWF?',R('Your savings',fmt(s.t)+' RWF')+R('Bonus','None before day 31')+R('Goes to','itunda Bank')+R('Bank balance after',fmt(S.bank+s.t)+' RWF'),'You can start a new 31-day streak any time.','Keep saving','Take back '+fmt(s.t)+' RWF','s31Stop()')};
window.s31Stop=()=>{const s=st(),t=s.t;S.bank+=t;addAct('up','31-day savings \u00b7 Taken back','Received',t,'Received');S.dsv31=fresh(s.a);closeSheet();render('fade-none');toast(fmt(t)+' RWF is back in itunda Bank')};
window.s31CollectAsk=()=>{const s=st(),b=Math.round(s.t*rate(s.n)/100);sheet('Collect '+fmt(s.t+b)+' RWF?',R('Your savings',fmt(s.t)+' RWF')+R('Bonus ('+rate(s.n)+'%)','+'+fmt(b)+' RWF')+R('Goes to','itunda Bank')+R('Bank balance after',fmt(S.bank+s.t+b)+' RWF'),'','Not now','Collect '+fmt(s.t+b)+' RWF','s31Collect()')};
window.s31Collect=()=>{const s=st(),b=Math.round(s.t*rate(s.n)/100),g=s.t+b;S.bank+=g;addAct('up','31-day savings \u00b7 Paid out','Received',g,'Received');S.dsv31=fresh(s.a);closeSheet();render('fade-none');toast(fmt(g)+' RWF added to itunda Bank');setTimeout(confetti,200)};
document.title='itunda, clickable prototype v208';
})();
</script>
<script>
/* v210: Fix: Settings showed "Send limits NaN RWF" and no daily-limit chip was selected, because the Bank transfer limit is stored as S.lim.day and Settings read S.lim.d (and S.lim.a, the PIN threshold, did not exist). Both names now point at the same value, so changing the limit in Settings also changes what Bank transfers allow, and the PIN threshold starts at 50,000 RWF. (v209 also rewired Support, Help, Verification and the link statistics; those were already wired, so that part is removed again.) */
(function(){
if(S.lim){if(!Object.getOwnPropertyDescriptor(S.lim,'d'))Object.defineProperty(S.lim,'d',{get(){return this.day},set(v){this.day=v},enumerable:false,configurable:true});if(S.lim.a===undefined)S.lim.a=50000}
document.title='itunda, clickable prototype v210';
})();
</script>
<script>
/* v211: Fix: on the Bank page, Payees, Scheduled transfers, Budget and Report a problem (and any other row that opens a Bank sub-page) did nothing since v205. The intercity bus booking added a second function named bkGo, which replaced the Bank page's bkGo(page) that opens those sub-pages. bkGo now opens the Bank page when it is given a page name and books the bus when it is not, so both work. */
(function(){
const bus=window.bkGo;
window.bkGo=function(n){if(typeof n==='string'){S.stack.push(n);render('push');return}return typeof bus==='function'?bus.apply(this,arguments):undefined};
if(typeof bkGo!=='undefined'&&bkGo!==window.bkGo){try{bkGo=window.bkGo}catch(e){}}
document.title='itunda, clickable prototype v211';
})();
</script>
<script>/* v212: Fix: the Security page stored the passkey switch in S.pk, the same place your pockets are kept. Turning the passkey on or off replaced every pocket (and its balance) with 0 or 1, and the Pockets page then failed to open. The passkey now has its own flag (S.pkey). */document.title='itunda, clickable prototype v212';</script><script>/* v213: Fix: Pay > Buy airtime showed "Buy NaN RWF" with no network or amount chosen, because the airtime sheet kept its choices in S.at, the same place the Auto-transfer list is kept. The airtime sheet now has its own state (S.atm), starting at MTN and 1,000 RWF. */document.title='itunda, clickable prototype v213';</script><script>/* v214: Fix: the shop product quantity and the property listing form both used S.pq, so opening a product while a listing was half filled (or the other way round) mixed them up. The listing form now has its own state (S.pqf). */document.title='itunda, clickable prototype v214';</script><script>
/* v215: Auto-transfer. Before: "New auto-transfer" added the same fixed row every time (Interest jar, 2,000 RWF, every Monday) without asking anything, rows could only be paused (no way to remove or see details), and nothing explained when the first transfer happens. Now: a page with three plain questions in order ("Where should it go?" with your pockets, "How much each time?" with 1,000 / 5,000 / 10,000 / 20,000 RWF to tap, "How often?" every day, week or month), one sentence that updates as you choose ("Every week, we move 5,000 RWF from itunda Pay to Emergency fund. First transfer: tomorrow."), a review before it is set up, and a button that names what it does. Each row shows where the money goes and when the next transfer is, opens a sheet to pause, resume or delete it (with a confirmation), and an empty state replaces the blank page when none are left. English only; fr/rw copy untouched. */
(function(){
const R=(a,v)=>'<div style="display:flex;justify-content:space-between;gap:12px;min-height:40px;align-items:center;font-size:15px;border-top:0"><span class="mu">'+a+'</span><b style="text-align:right">'+v+'</b></div>';
const AM=[1000,5000,10000,20000],FR=['day','week','month'];
const nw=()=>S.atn=S.atn||{p:'jar',a:5000,f:'week'};
const pk=()=>(Array.isArray(S.pk)?S.pk:[]);
const pn=id=>{const p=pk().find(x=>x.id===id);return p?p.n:'Interest jar'};
const tm=()=>{const d=new Date();d.setDate(d.getDate()+1);return d};
const WD=['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
const ord=n=>n+(n%10===1&&n!==11?'st':n%10===2&&n!==12?'nd':n%10===3&&n!==13?'rd':'th');
const freq=f=>f==='day'?'Every day':f==='week'?'Every '+WD[tm().getDay()]:'Monthly on the '+ord(tm().getDate());
const sentence=n=>(n.f==='day'?'Every day':n.f==='week'?'Every week':'Every month')+', we move '+fmt(n.a)+' RWF from itunda Pay to '+pn(n.p)+'. First transfer: tomorrow.';
const chip=(l,on,fn)=>'<button class="chip" aria-pressed="'+on+'" onclick="'+fn+'" style="min-width:64px;height:44px;border-radius:22px;border:0;padding:0 16px;font-size:15px;font-weight:800;background:'+(on?'var(--tx)':'var(--chip)')+';color:'+(on?'var(--bg)':'var(--tx)')+'">'+l+'</button>';
const sheet=(h,body,note,no,yes,go)=>{$('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="h1" style="font-size:22px;line-height:30px;margin-top:4px">'+h+'</div><div style="margin:12px 0 '+(note?'12':'20')+'px">'+body+'</div>'+(note?'<div class="mu sm" style="margin-bottom:16px;line-height:20px">'+note+'</div>':'')+'<div class="row2" style="display:grid;grid-template-columns:1fr 1.8fr"><button class="btn sec2" onclick="closeSheet()">'+no+'</button><button class="btn" style="white-space:nowrap" onclick="'+go+'">'+yes+'</button></div></div>';if(typeof focusSheet==='function')focusSheet()};
const _a=screens.autot;
screens.autot=()=>{if(S.lang!=='en')return _a();
 const H=bar('Auto-transfer'),L=S.at;
 const rows=L.map((a,i)=>'<div class="row" role="button" tabindex="0" onclick="atOpen('+i+')" style="padding:12px 24px"><div class="ico">'+a[0]+'</div><div style="flex:1;min-width:0"><div class="t" style="opacity:'+(a[4]?1:.5)+'">'+a[1]+'</div><div class="s">'+a[3]+' RWF \u00b7 '+a[2]+(a[4]?'':' \u00b7 Paused')+'</div></div><div class="sw '+(a[4]?'on':'')+'" role="switch" aria-checked="'+!!a[4]+'" aria-label="'+a[1]+'" tabindex="0" onclick="event.stopPropagation();atTg('+i+')"><i></i></div></div>').join('');
 return H+'<div class="pad fine" style="padding-top:16px;line-height:18px">Money moves on its own from your itunda Pay balance. If the balance is too low on the day, we skip that transfer and try again next time.</div>'+(L.length?rows:'<div class="pad" style="padding-top:40px;text-align:center"><div class="h1" style="font-size:20px;line-height:28px">No auto-transfers yet</div><div class="mu" style="font-size:15px;margin-top:8px;line-height:22px">Pick a pocket, an amount and how often. We move the money for you.</div></div>')+'<div style="height:100px"></div><div class="cta"><button class="btn" onclick="atNew()">New auto-transfer</button></div>'};
screens.atnew=()=>{const n=nw(),P=pk(),bad=n.a>S.pay;
 return bar('New auto-transfer')+'<div class="pad" style="padding-top:20px"><div class="h1">Save automatically</div></div>'+
 '<div style="font-size:16px;font-weight:800;padding:24px 24px 0">Where should it go?</div><div style="padding:12px 24px 0;display:flex;gap:10px;flex-wrap:wrap" role="group" aria-label="Where it goes">'+P.map(p=>chip(p.n,p.id===n.p,"atP('"+p.id+"')")).join('')+'</div>'+
 '<div style="font-size:16px;font-weight:800;padding:24px 24px 0">How much each time?</div><div style="padding:12px 24px 0;display:flex;gap:10px;flex-wrap:wrap" role="group" aria-label="Amount">'+AM.map(v=>chip(fmt(v),v===n.a,'atA('+v+')')).join('')+'</div>'+
 '<div style="font-size:16px;font-weight:800;padding:24px 24px 0">How often?</div><div style="padding:12px 24px 0;display:flex;gap:10px;flex-wrap:wrap" role="group" aria-label="How often">'+FR.map(f=>chip(f==='day'?'Every day':f==='week'?'Every week':'Every month',f===n.f,"atF('"+f+"')")).join('')+'</div>'+
 '<div style="margin:24px 24px 0;padding:16px 18px;border-radius:20px;background:var(--chip);font-size:15px;line-height:22px;font-weight:700" aria-live="polite">'+sentence(n)+'</div>'+
 (bad?'<div class="sm" style="padding:12px 24px 0;color:var(--er);line-height:20px">Your itunda Pay balance is '+fmt(S.pay)+' RWF today, so the first transfer would be skipped. You can still set it up.</div>':'')+
 '<div style="height:100px"></div><div class="cta"><button class="btn" style="white-space:nowrap" onclick="atAsk()">Set up auto-transfer</button></div>'};
window.atNew=()=>{if(S.lang!=='en'||!Array.isArray(S.pk)){S.at.push(['🪙','Interest jar','Every Monday','2,000',1]);toast('Auto-transfer added');render('fade-none');return}
 S.atn={p:'jar',a:5000,f:'week'};S.stack.push('atnew');render('push')};
window.atP=id=>{nw().p=id;render('fade-none')};window.atA=v=>{nw().a=v;render('fade-none')};window.atF=f=>{nw().f=f;render('fade-none')};
window.atAsk=()=>{const n=nw();sheet('Set up this auto-transfer?',R('Money goes to',pn(n.p))+R('Each time',fmt(n.a)+' RWF')+R('How often',freq(n.f))+R('First transfer','Tomorrow')+R('Taken from','itunda Pay'),'You can pause or delete it any time from this page.','Cancel','Set up '+fmt(n.a)+' RWF '+(n.f==='day'?'daily':n.f==='week'?'weekly':'monthly'),'atGo()')};
window.atGo=()=>{const n=nw();S.at.push([n.p==='jar'?'🪙':'🎯',pn(n.p),freq(n.f),fmt(n.a),1]);closeSheet();S.stack.pop();render('pop');toast('Auto-transfer set up. First one is tomorrow.')};
window.atOpen=i=>{const a=S.at[i];if(!a)return;
 $('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="h1" style="font-size:22px;line-height:30px;margin-top:4px">'+a[1]+'</div><div style="margin:12px 0 20px">'+R('Each time',a[3]+' RWF')+R('How often',a[2])+R('Status',a[4]?'On':'Paused')+R('Taken from','itunda Pay')+'</div><div class="row2" style="display:grid;grid-template-columns:1fr 1fr"><button class="btn sec2" onclick="atTg('+i+');closeSheet()">'+(a[4]?'Pause':'Resume')+'</button><button class="btn sec2" style="color:var(--er)" onclick="atDelAsk('+i+')">Delete</button></div></div>';if(typeof focusSheet==='function')focusSheet()};
window.atDelAsk=i=>{const a=S.at[i];if(!a)return;sheet('Delete this auto-transfer?',R('Money goes to',a[1])+R('Each time',a[3]+' RWF')+R('How often',a[2]),'Money already moved stays where it is. Nothing else changes.','Keep it','Delete','atDel('+i+')')};
window.atDel=i=>{const a=S.at[i];if(!a)return;S.at.splice(i,1);closeSheet();render('fade-none');toast('Auto-transfer to '+a[1]+' deleted')};
document.title='itunda, clickable prototype v215';
})();
</script>
<style>/* v216: contrast. Red text (errors, "Due in", "Remove", discount %, "left") was 3.1 to 4.4 : 1 and is now 4.5 : 1 or more in both themes (a lighter red in dark mode; red badges keep their own fixed red so white text on them stays readable). Green "Open" and "Seats" were 3.1 : 1 on white and are now a deeper green in light mode. White bus numbers on the route green were 3.5 : 1; the route green is deeper. */
@media (prefers-color-scheme:dark){:root:not([data-theme=light]){--er:#FF6B5E}}:root[data-theme=dark]{--er:#FF6B5E}
#phone [style*="color:#2BA84A"],#phone .lv{color:#0B7A4B!important}
@media (prefers-color-scheme:dark){:root:not([data-theme=light]) #phone [style*="color:#2BA84A"],:root:not([data-theme=light]) #phone .lv{color:#2BA84A!important}}
:root[data-theme=dark] #phone [style*="color:#2BA84A"],:root[data-theme=dark] #phone .lv{color:#2BA84A!important}
</style><script>document.title='itunda, clickable prototype v216';/* v217: Auto-transfer in French and Kinyarwanda. v215 switched its new flow off for anything but English: in fr/rw "New auto-transfer" still added the same fixed row (Interest jar, 2,000 RWF, every Monday) without asking, rows could not be opened, paused or deleted from a sheet, and the page text was half English. The whole flow now works in all three languages: the list and its empty state, the three questions (where, how much, how often) with the sentence that updates as you choose, the low-balance note, the review sheet, the row sheet (pause, resume, delete) and the delete confirmation. Choosing a pocket, amount or frequency no longer sends the page back to the top (it did in every language), and the chips are a little tighter so the four amounts always share one row. Pocket names and frequencies in the list follow the language (Interest jar, Emergency fund, School fees; "Every Friday", "1st of each month"). English wording is unchanged. fr is new copy; rw is new copy and, like v166, needs native review, especially the weekday forms (buri wa gatanu), "tuzimura ... dukuye kuri" and "Kohereza bwa mbere". */
(function(){
const t3=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e,nb=s=>S.lang==='fr'?s.replace(/ ([?:!])/g,'\u00a0$1'):s;
const R=(a,v)=>'<div style="display:flex;justify-content:space-between;gap:12px;min-height:40px;align-items:center;font-size:15px;border-top:0"><span class="mu">'+a+'</span><b style="text-align:right">'+v+'</b></div>';
const AM=[1000,5000,10000,20000],FR=['day','week','month'];
const nw=()=>S.atn=S.atn||{p:'jar',a:5000,f:'week'};
const pk=()=>(Array.isArray(S.pk)?S.pk:[]);
const PN={'Interest jar':['Agasanduku k’inyungu','Tirelire à intérêts'],'Emergency fund':['Amafaranga y’ihutirwa','Fonds d’urgence'],'School fees':['Amafaranga y’ishuri','Frais de scolarité'],'School fees goal':['Intego y’amafaranga y’ishuri','Objectif frais de scolarité'],'Rent':['Ubukode','Loyer']};
const nl=n=>{const x=PN[n];return x?t3(n,x[0],x[1]):n};
const pn=id=>{const p=pk().find(x=>x.id===id);return p?p.n:'Interest jar'};
const pnl=id=>nl(pn(id));
const tm=()=>{const d=new Date();d.setDate(d.getDate()+1);return d};
const WD=['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
const WF=['dimanche','lundi','mardi','mercredi','jeudi','vendredi','samedi'],WR=['cyumweru','wa mbere','wa kabiri','wa gatatu','wa kane','wa gatanu','wa gatandatu'];
const ord=n=>n+(n%10===1&&n!==11?'st':n%10===2&&n!==12?'nd':n%10===3&&n!==13?'rd':'th');
const freq=f=>f==='day'?'Every day':f==='week'?'Every '+WD[tm().getDay()]:'Monthly on the '+ord(tm().getDate());
const freqL=s=>{if(S.lang==='en'||typeof s!=='string')return s;let m;
 if(s==='Every day')return t3(s,'Buri munsi','Tous les jours');
 if(m=s.match(/^Every (Sunday|Monday|Tuesday|Wednesday|Thursday|Friday|Saturday)$/)){const i=WD.indexOf(m[1]);return t3(s,'Buri '+WR[i],'Chaque '+WF[i])}
 if(m=s.match(/^Monthly on the (\d+)(?:st|nd|rd|th)$/))return t3(s,'Buri kwezi, ku itariki '+m[1],'Chaque mois, le '+(m[1]==='1'?'1er':m[1]));
 if(m=s.match(/^(\d+)(?:st|nd|rd|th) of each month$/))return t3(s,'Ku itariki '+m[1]+' buri kwezi','Le '+(m[1]==='1'?'1er':m[1])+' de chaque mois');
 return s};
const fq=f=>{const k=FR.indexOf(f);return t3(['Every day','Every week','Every month'][k],['Buri munsi','Buri cyumweru','Buri kwezi'][k],['Tous les jours','Chaque semaine','Chaque mois'][k])};
const sentence=n=>{const x=fmt(n.a),p=pnl(n.p),a=fq(n.f);return nb(t3(a+', we move '+x+' RWF from itunda Pay to '+p+'. First transfer: tomorrow.',a+', tuzimura '+x+' RWF dukuye kuri itunda Pay tujya muri '+p+'. Kohereza bwa mbere: ejo.',a+', nous déplaçons '+x+' RWF depuis itunda Pay vers '+p+'. Premier virement : demain.'))};
const chip=(l,on,fn)=>'<button class="chip" aria-pressed="'+on+'" onclick="'+fn+'" style="min-width:60px;height:44px;border-radius:22px;border:0;padding:0 14px;font-size:15px;font-weight:800;background:'+(on?'var(--tx)':'var(--chip)')+';color:'+(on?'var(--bg)':'var(--tx)')+'">'+l+'</button>';
const sheet=(h,body,note,no,yes,go)=>{$('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="h1" style="font-size:22px;line-height:30px;margin-top:4px">'+h+'</div><div style="margin:12px 0 '+(note?'12':'20')+'px">'+body+'</div>'+(note?'<div class="mu sm" style="margin-bottom:16px;line-height:20px">'+note+'</div>':'')+'<div class="row2" style="display:grid;grid-template-columns:1fr 1.8fr"><button class="btn sec2" onclick="closeSheet()">'+no+'</button><button class="btn" style="white-space:nowrap" onclick="'+go+'">'+yes+'</button></div></div>';if(typeof focusSheet==='function')focusSheet()};
const T=()=>t3('Auto-transfer','Kohereza byikora','Virement automatique'),TN=()=>t3('New auto-transfer','Kohereza byikora bishya','Nouveau virement automatique');
const CANCEL=()=>t3('Cancel','Reka','Annuler');
screens.autot=()=>{
 const H=bar(T()),L=S.at;
 const rows=L.map((a,i)=>'<div class="row" role="button" tabindex="0" onclick="atOpen('+i+')" style="padding:12px 24px"><div class="ico">'+a[0]+'</div><div style="flex:1;min-width:0"><div class="t" style="opacity:'+(a[4]?1:.5)+'">'+nl(a[1])+'</div><div class="s">'+a[3]+' RWF \u00b7 '+freqL(a[2])+(a[4]?'':' \u00b7 '+t3('Paused','Byahagaritswe','En pause'))+'</div></div><div class="sw '+(a[4]?'on':'')+'" role="switch" aria-checked="'+!!a[4]+'" aria-label="'+nl(a[1])+'" tabindex="0" onclick="event.stopPropagation();atTg('+i+')"><i></i></div></div>').join('');
 return H+'<div class="pad fine" style="padding-top:16px;line-height:18px">'+t3('Money moves on its own from your itunda Pay balance. If the balance is too low on the day, we skip that transfer and try again next time.','Amafaranga ava ku mafaranga yawe ya itunda Pay yikoresha. Iyo asigaye ari make uwo munsi, ntitwohereza tukongera kugerageza ubutaha.','L’argent part tout seul de votre solde itunda Pay. Si le solde est trop bas ce jour-là, nous sautons ce virement et réessayons la fois suivante.')+'</div>'+(L.length?rows:'<div class="pad" style="padding-top:40px;text-align:center"><div class="h1" style="font-size:20px;line-height:28px">'+t3('No auto-transfers yet','Nta kohereza byikora kurimo','Aucun virement automatique')+'</div><div class="mu" style="font-size:15px;margin-top:8px;line-height:22px">'+t3('Pick a pocket, an amount and how often. We move the money for you.','Hitamo agasanduku, umubare n’inshuro. Tuzohereza amafaranga ku bwawe.','Choisissez une cagnotte, un montant et une fréquence. Nous déplaçons l’argent pour vous.')+'</div></div>')+'<div style="height:100px"></div><div class="cta"><button class="btn" onclick="atNew()">'+TN()+'</button></div>'};
screens.atnew=()=>{const n=nw(),P=pk(),bad=n.a>S.pay,H2='font-size:16px;font-weight:800;padding:24px 24px 0';
 return bar(t3('New auto-transfer','Kohereza byikora bishya','Nouveau virement'))+'<div class="pad" style="padding-top:20px"><div class="h1">'+t3('Save automatically','Bika byikora','Épargne automatique')+'</div></div>'+
 '<div style="'+H2+'">'+nb(t3('Where should it go?','Amafaranga ajye he?','Où doit aller l’argent ?'))+'</div><div style="padding:12px 24px 0;display:flex;gap:8px;flex-wrap:wrap" role="group" aria-label="'+t3('Where it goes','Aho ajya','Destination')+'">'+P.map(p=>chip(nl(p.n),p.id===n.p,"atP('"+p.id+"')")).join('')+'</div>'+
 '<div style="'+H2+'">'+nb(t3('How much each time?','Angahe buri gihe?','Combien à chaque fois ?'))+'</div><div style="padding:12px 24px 0;display:grid;grid-template-columns:repeat(4,1fr);gap:8px" role="group" aria-label="'+t3('Amount','Umubare','Montant')+'">'+AM.map(v=>chip(fmt(v),v===n.a,'atA('+v+')').replace('min-width:60px','min-width:0').replace('padding:0 14px','padding:0')).join('')+'</div>'+
 '<div style="'+H2+'">'+nb(t3('How often?','Kangahe?','À quelle fréquence ?'))+'</div><div style="padding:12px 24px 0;display:flex;gap:8px;flex-wrap:wrap" role="group" aria-label="'+t3('How often','Inshuro','Fréquence')+'">'+FR.map(f=>chip(fq(f),f===n.f,"atF('"+f+"')")).join('')+'</div>'+
 '<div style="margin:24px 24px 0;padding:16px 18px;border-radius:20px;background:var(--chip);font-size:15px;line-height:22px;font-weight:700" aria-live="polite">'+sentence(n)+'</div>'+
 (bad?'<div class="sm" style="padding:12px 24px 0;color:var(--er);line-height:20px">'+t3('Your itunda Pay balance is '+fmt(S.pay)+' RWF today, so the first transfer would be skipped. You can still set it up.','Amafaranga yawe kuri itunda Pay ni '+fmt(S.pay)+' RWF uyu munsi, bityo kohereza bwa mbere ntibyakorwa. Ushobora kubitegura nubwo bimeze bityo.','Votre solde itunda Pay est de '+fmt(S.pay)+' RWF aujourd’hui : le premier virement serait ignoré. Vous pouvez quand même le programmer.')+'</div>':'')+
 '<div style="height:100px"></div><div class="cta"><button class="btn" style="white-space:nowrap" onclick="atAsk()">'+t3('Set up auto-transfer','Tegura kohereza byikora','Programmer le virement')+'</button></div>'};
window.atNew=()=>{if(!Array.isArray(S.pk)){S.at.push(['🪙','Interest jar','Every Monday','2,000',1]);toast(t3('Auto-transfer added','Kohereza byikora byongewe','Virement automatique ajouté'));render('fade-none');return}
 S.atn={p:'jar',a:5000,f:'week'};S.stack.push('atnew');render('push')};
const keep=fn=>{const sc=document.querySelector('#phone .screen'),y=sc?sc.scrollTop:0;fn();const s2=document.querySelector('#phone .screen');if(s2)s2.scrollTop=y};
window.atP=id=>{nw().p=id;keep(()=>render('fade-none'))};window.atA=v=>{nw().a=v;keep(()=>render('fade-none'))};window.atF=f=>{nw().f=f;keep(()=>render('fade-none'))};
window.atAsk=()=>{const n=nw(),x=fmt(n.a);sheet(nb(t3('Set up this auto-transfer?','Utegure uku kohereza byikora?','Programmer ce virement automatique ?')),
 R(t3('Money goes to','Amafaranga ajya','Destination'),pnl(n.p))+R(t3('Each time','Buri gihe','À chaque fois'),x+' RWF')+R(t3('How often','Inshuro','Fréquence'),freqL(freq(n.f)))+R(t3('First transfer','Kohereza bwa mbere','Premier virement'),t3('Tomorrow','Ejo','Demain'))+R(t3('Taken from','Ava kuri','Prélevé sur'),'itunda Pay'),
 t3('You can pause or delete it any time from this page.','Ushobora kuwuhagarika cyangwa kuwusiba igihe icyo ari cyo cyose kuri uru rupapuro.','Vous pouvez le suspendre ou le supprimer à tout moment depuis cette page.'),CANCEL(),
 t3('Set up '+x+' RWF '+(n.f==='day'?'daily':n.f==='week'?'weekly':'monthly'),'Tegura '+x+' RWF','Programmer '+x+' RWF'),'atGo()')};
window.atGo=()=>{const n=nw();S.at.push([n.p==='jar'?'🪙':'🎯',pn(n.p),freq(n.f),fmt(n.a),1]);closeSheet();S.stack.pop();render('pop');toast(t3('Auto-transfer set up. First one is tomorrow.','Kohereza byikora byateguwe. Icya mbere ni ejo.','Virement automatique programmé. Le premier a lieu demain.'))};
window.atOpen=i=>{const a=S.at[i];if(!a)return;
 $('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="h1" style="font-size:22px;line-height:30px;margin-top:4px">'+nl(a[1])+'</div><div style="margin:12px 0 20px">'+R(t3('Each time','Buri gihe','À chaque fois'),a[3]+' RWF')+R(t3('How often','Inshuro','Fréquence'),freqL(a[2]))+R(t3('Status','Imimerere','Statut'),a[4]?t3('On','Birakora','Activé'):t3('Paused','Byahagaritswe','En pause'))+R(t3('Taken from','Ava kuri','Prélevé sur'),'itunda Pay')+'</div><div class="row2" style="display:grid;grid-template-columns:1fr 1fr"><button class="btn sec2" onclick="atTg('+i+');closeSheet()">'+(a[4]?t3('Pause','Hagarika','Suspendre'):t3('Resume','Komeza','Reprendre'))+'</button><button class="btn sec2" style="color:var(--er)" onclick="atDelAsk('+i+')">'+t3('Delete','Siba','Supprimer')+'</button></div></div>';if(typeof focusSheet==='function')focusSheet()};
window.atDelAsk=i=>{const a=S.at[i];if(!a)return;sheet(nb(t3('Delete this auto-transfer?','Usibe uku kohereza byikora?','Supprimer ce virement automatique ?')),R(t3('Money goes to','Amafaranga ajya','Destination'),nl(a[1]))+R(t3('Each time','Buri gihe','À chaque fois'),a[3]+' RWF')+R(t3('How often','Inshuro','Fréquence'),freqL(a[2])),t3('Money already moved stays where it is. Nothing else changes.','Amafaranga yamaze koherezwa aguma aho ari. Nta kindi gihinduka.','L’argent déjà transféré reste où il est. Rien d’autre ne change.'),t3('Keep it','Yigumane','Le garder'),t3('Delete','Siba','Supprimer'),'atDel('+i+')')};
window.atDel=i=>{const a=S.at[i];if(!a)return;S.at.splice(i,1);closeSheet();render('fade-none');toast(t3('Auto-transfer to '+a[1]+' deleted','Kohereza byikora kuri '+nl(a[1])+' kwasibwe','Virement automatique vers '+nl(a[1])+' supprimé'))};
document.title='itunda, clickable prototype v217';
})();
</script><script>
/* v218: 31-day savings in French and Kinyarwanda. v208 rebuilt this page, but only for English: in fr/rw the old page came back (English text, a fixed 500 RWF a day, a "0.0%" bonus, no choice of amount, no review, and the new bonus steps, stop and collect were out of reach). The whole v208 flow now works in all three languages with the same behaviour: "How much each day?" with 200 / 500 / 1,000 / 2,000 RWF and a live line (31 days x amount = total, or a plain reason when your itunda Bank balance is too low); the four bonus steps (7, 14, 21, 31 days); the review before the first save; "Day 3 of 31" with what you saved and the bonus you have now; stop and take back; collect after day 31; and every toast. Activity rows for it (for example "31-day savings · Day 3", "Saved") now follow the language too. Tapping an amount no longer sends the page back to the top. English wording is unchanged. fr is new copy; rw is new copy and, like v166 and v217, needs native review, especially "iminsi ukurikiranya" (streak), "igihembo" (bonus) and "Zigama" (save). */
(function(){
const t3=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e,nb=s=>S.lang==='fr'?s.replace(/ ([?:!%])/g,'\u00a0$1'):s;
const R=(a,v)=>'<div style="display:flex;justify-content:space-between;gap:12px;min-height:40px;align-items:center;font-size:15px;border-top:0"><span class="mu">'+a+'</span><b style="text-align:right">'+v+'</b></div>';
const TI=[[7,2],[14,4],[21,6],[31,10]],AM=[200,500,1000,2000];
const fresh=p=>({on:0,a:p||500,n:0,t:0,d:0,pick:p||500});
const st=()=>S.dsv31=S.dsv31||fresh();const rate=n=>{let r=0;TI.forEach(([d,p])=>{if(n>=d)r=p});return r};
const nextT=n=>TI.find(([d])=>n<d);
const keep=fn=>{const sc=document.querySelector('#phone .screen'),y=sc?sc.scrollTop:0;fn();const s2=document.querySelector('#phone .screen');if(s2)s2.scrollTop=y};
const tiers=n=>'<div style="margin-top:8px">'+TI.map(([d,p])=>'<div style="display:flex;justify-content:space-between;min-height:44px;align-items:center;font-size:15px;border-top:0"><span class="'+(n>=d?'':'mu')+'" style="display:flex;align-items:center;gap:8px">'+(n>=d?ic('check',16,'var(--lk)'):'')+t3('Day '+d,'Umunsi wa '+d,'Jour '+d)+'</span><b>'+nb(t3(p+'% bonus','Igihembo cya '+p+'%','Bonus de '+p+' %'))+'</b></div>').join('')+'</div>';
const dots=n=>'<div style="display:flex;flex-wrap:wrap;gap:8px" role="img" aria-label="'+t3(n+' of 31 days saved',n+' kuri 31 zazigamwe',n+' jours sur 31 épargnés')+'">'+Array.from({length:31},(_,i)=>'<div style="width:18px;height:18px;border-radius:9px;background:'+(i<n?'var(--br)':'var(--chip)')+'"></div>').join('')+'</div>';
const chip=(v,on,fn)=>'<button class="chip" aria-pressed="'+on+'" onclick="'+fn+'('+v+')" style="min-width:64px;height:44px;border-radius:22px;border:0;padding:0 14px;font-size:15px;font-weight:800;background:'+(on?'var(--tx)':'var(--chip)')+';color:'+(on?'var(--bg)':'var(--tx)')+'">'+fmt(v)+'</button>';
const sheet=(h,body,note,no,yes,go)=>{$('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="h1" style="font-size:22px;line-height:30px;margin-top:4px">'+nb(h)+'</div><div style="margin:12px 0 '+(note?'12':'20')+'px">'+body+'</div>'+(note?'<div class="mu sm" style="margin-bottom:16px;line-height:20px">'+nb(note)+'</div>':'')+'<div class="row2" style="display:grid;grid-template-columns:1fr 1.8fr"><button class="btn sec2" onclick="closeSheet()">'+no+'</button><button class="btn" style="white-space:nowrap" onclick="'+go+'">'+yes+'</button></div></div>';if(typeof focusSheet==='function')focusSheet()};
const CANCEL=()=>t3('Cancel','Reka','Annuler');
const BANK='itunda Bank';
const H2='font-size:16px;font-weight:800;padding:28px 24px 0';
const T=()=>t3('31-day savings','Kuzigama iminsi 31','Épargne sur 31 jours');
const L={
 paid:()=>t3('Paid from','Ava kuri','Prélevé sur'),
 goes:()=>t3('Goes to','Ajya kuri','Destination'),
 after:()=>t3('Bank balance after','Asigaye kuri Bank','Solde Bank après'),
 yours:()=>t3('Your savings','Ibyo wazigamye','Votre épargne')
};
const save=a=>t3('Save '+fmt(a)+' RWF','Zigama '+fmt(a)+' RWF','Épargner '+fmt(a)+' RWF');
screens.save31=()=>{
 const s=st(),H=bar(T());
 if(!s.on){
  const a=s.pick,bad=a>S.bank;
  return H+'<div class="pad" style="padding-top:24px"><div class="h1">'+nb(t3('Save a little every day for 31 days','Zigama gake buri munsi mu minsi 31','Épargnez un peu chaque jour pendant 31 jours'))+'</div><div class="mu" style="font-size:16px;margin-top:12px;line-height:24px">'+nb(t3('Pick an amount you can save each day. The longer your streak, the higher your bonus, up to 10%.','Hitamo amafaranga ushobora kuzigama buri munsi. Uko iminsi ukurikiranya iba myinshi, ni ko igihembo cyiyongera, kugeza kuri 10%.','Choisissez un montant que vous pouvez épargner chaque jour. Plus votre série est longue, plus votre bonus est élevé, jusqu’à 10 %.'))+'</div></div>'+
  '<div style="'+H2+'">'+nb(t3('How much each day?','Ni angahe buri munsi?','Combien chaque jour ?'))+'</div><div style="padding:12px 24px 0"><div style="display:flex;gap:10px;flex-wrap:wrap" role="group" aria-label="'+t3('Daily amount','Amafaranga ya buri munsi','Montant par jour')+'">'+AM.map(v=>chip(v,v===a,'s31Pick')).join('')+'</div>'+
  '<div class="sm" style="margin-top:12px;line-height:20px" aria-live="polite">'+(bad?'<span style="color:var(--er)">'+t3('This is more than your itunda Bank balance of '+fmt(S.bank)+' RWF. Pick a smaller amount.','Ni menshi kurusha amafaranga ufite kuri itunda Bank angana na '+fmt(S.bank)+' RWF. Hitamo make kurushaho.','C’est plus que le solde de votre itunda Bank, qui est de '+fmt(S.bank)+' RWF. Choisissez un montant plus petit.')+'</span>':'<span class="mu">'+t3('31 days \u00d7 '+fmt(a)+' = <b style="color:var(--tx)">'+fmt(a*31)+' RWF</b> \u00b7 itunda Bank balance '+fmt(S.bank)+' RWF','Iminsi 31 \u00d7 '+fmt(a)+' = <b style="color:var(--tx)">'+fmt(a*31)+' RWF</b> \u00b7 amafaranga kuri itunda Bank '+fmt(S.bank)+' RWF','31 jours \u00d7 '+fmt(a)+' = <b style="color:var(--tx)">'+fmt(a*31)+' RWF</b> \u00b7 solde itunda Bank '+fmt(S.bank)+' RWF')+'</span>')+'</div></div>'+
  '<div style="'+H2+'">'+t3('Your bonus grows with your streak','Igihembo cyawe kiyongera uko iminsi ukurikiranya yiyongera','Votre bonus grandit avec votre série')+'</div><div class="pad">'+tiers(0)+'</div>'+
  '<div class="pad fine" style="padding-top:14px;line-height:18px">'+nb(t3('Save once a day. If you miss a day, your streak starts again at day 1. What you saved stays yours. Rates are sample data. itunda Bank is not a licensed bank.','Zigama rimwe ku munsi. Nusiba umunsi, uzongera gutangira ku munsi wa 1. Ibyo wazigamye bikomeza kuba ibyawe. Ibipimo ni ibyo kugerageza. itunda Bank si banki ifite uruhushya.','Épargnez une fois par jour. Si vous manquez un jour, votre série repart au jour 1. Ce que vous avez épargné reste à vous. Les taux sont des données d’exemple. itunda Bank n’est pas une banque agréée.'))+'</div><div style="height:100px"></div>'+
  '<div class="cta"><button class="btn" style="white-space:nowrap" '+(bad?'disabled ':'')+'onclick="s31Ask()">'+t3('Save '+fmt(a)+' RWF to start','Zigama '+fmt(a)+' RWF utangire','Commencer avec '+fmt(a)+' RWF')+'</button></div>';
 }
 const n=s.n,a=s.a,r=rate(n),nx=nextT(n);
 if(n>=31){
  const b=Math.round(s.t*r/100);
  return H+'<div class="pad" style="padding-top:24px"><div class="h1">'+nb(t3('You made it: 31 days in a row','Wabikoze: iminsi 31 ikurikiranye','Bravo : 31 jours d’affilée'))+'</div><div class="mu" style="font-size:16px;margin-top:12px;line-height:24px">'+nb(t3('You saved '+fmt(s.t)+' RWF and earned a '+r+'% bonus of '+fmt(b)+' RWF.','Wazigamye '+fmt(s.t)+' RWF kandi wabonye igihembo cya '+r+'% cya '+fmt(b)+' RWF.','Vous avez épargné '+fmt(s.t)+' RWF et gagné un bonus de '+r+' % : '+fmt(b)+' RWF.'))+'</div></div><div class="pad" style="padding-top:28px">'+dots(31)+'</div><div class="pad" style="padding-top:20px">'+R(L.yours(),fmt(s.t)+' RWF')+R(nb(t3('Bonus ('+r+'%)','Igihembo ('+r+'%)','Bonus ('+r+' %)')),'+'+fmt(b)+' RWF')+R(t3('You get','Uhawe','Vous recevez'),fmt(s.t+b)+' RWF')+'</div><div style="height:100px"></div><div class="cta"><button class="btn" style="white-space:nowrap" onclick="s31CollectAsk()">'+t3('Collect '+fmt(s.t+b)+' RWF','Akira '+fmt(s.t+b)+' RWF','Récupérer '+fmt(s.t+b)+' RWF')+'</button></div>';
 }
 const bad=a>S.bank,k=nx?nx[0]-n:0;
 return H+'<div class="pad" style="padding-top:24px"><div class="sm mu" style="font-weight:700">'+t3('Your streak','Iminsi ukurikiranya','Votre série')+'</div><div class="h1" style="margin-top:4px">'+(n?t3('Day '+n+' of 31','Umunsi wa '+n+' kuri 31','Jour '+n+' sur 31'):t3('Start again today','Ongera utangire uyu munsi','Recommencez aujourd’hui'))+'</div><div class="mu" style="font-size:16px;margin-top:10px;line-height:24px">'+(n?nb(t3('Saved so far <b style="color:var(--tx)">'+fmt(s.t)+' RWF</b> \u00b7 bonus now '+r+'%','Wamaze kuzigama <b style="color:var(--tx)">'+fmt(s.t)+' RWF</b> \u00b7 igihembo ubu ni '+r+'%','Épargné jusqu’ici <b style="color:var(--tx)">'+fmt(s.t)+' RWF</b> \u00b7 bonus actuel '+r+' %')):nb(t3('You missed a day, so your streak restarted. You still have <b style="color:var(--tx)">'+fmt(s.t)+' RWF</b> saved.','Wasibye umunsi, bityo iminsi ukurikiranya yongeye gutangira. Ugifite <b style="color:var(--tx)">'+fmt(s.t)+' RWF</b> wazigamye.','Vous avez manqué un jour : votre série repart de zéro. Vous gardez <b style="color:var(--tx)">'+fmt(s.t)+' RWF</b> d’épargne.')))+'</div></div>'+
 '<div class="pad" style="padding-top:24px">'+dots(n)+'<div class="sm mu" style="margin-top:12px;line-height:20px">'+(nx?nb(t3('Next bonus: '+nx[1]+'% at day '+nx[0]+' \u00b7 '+k+' day'+(k===1?'':'s')+' to go','Igihembo gikurikira: '+nx[1]+'% ku munsi wa '+nx[0]+' \u00b7 '+(k===1?'hasigaye umunsi 1':'hasigaye iminsi '+k),'Prochain bonus : '+nx[1]+' % au jour '+nx[0]+' \u00b7 encore '+k+' jour'+(k===1?'':'s'))):'')+'</div></div>'+
 '<div class="pad" style="padding-top:20px"><div style="padding:16px 18px;border-radius:20px;background:var(--chip);font-size:15px;line-height:22px;font-weight:700" aria-live="polite">'+(s.d?nb(t3('Today is done. Come back tomorrow to keep your streak going.','Uyu munsi urarangiye. Garuka ejo ukomeze.','C’est fait pour aujourd’hui. Revenez demain pour continuer votre série.')):bad?'<span style="color:var(--er)">'+nb(t3('Your itunda Bank balance is '+fmt(S.bank)+' RWF, which is less than '+fmt(a)+' RWF.','Amafaranga ufite kuri itunda Bank ni '+fmt(S.bank)+' RWF, make kurusha '+fmt(a)+' RWF.','Le solde de votre itunda Bank est de '+fmt(S.bank)+' RWF, soit moins que '+fmt(a)+' RWF.'))+'</span>':nb(t3('Today: save '+fmt(a)+' RWF to '+(n?'reach day '+(n+1):'begin day 1')+'.','Uyu munsi: zigama '+fmt(a)+' RWF '+(n?'ugere ku munsi wa '+(n+1):'utangire umunsi wa 1')+'.','Aujourd’hui : épargnez '+fmt(a)+' RWF '+(n?'pour atteindre le jour '+(n+1):'pour commencer le jour 1')+'.')))+'</div></div>'+
 '<div style="'+H2+'">'+t3('Bonus by streak','Igihembo ku minsi ukurikiranya','Bonus selon la série')+'</div><div class="pad">'+tiers(n)+'</div>'+
 '<div class="pad" style="padding-top:20px"><button onclick="s31StopAsk()" style="border:0;background:none;padding:0;min-height:44px;color:var(--lk);font-weight:700;font-size:15px;text-align:left">'+t3('Stop and take back '+fmt(s.t)+' RWF','Hagarika usubirane '+fmt(s.t)+' RWF','Arrêter et récupérer '+fmt(s.t)+' RWF')+'</button><div class="fine" style="margin-top:2px">'+t3('You will not get the bonus if you stop before day 31.','Utazabona igihembo nuhagarara mbere y’umunsi wa 31.','Vous n’aurez pas le bonus si vous arrêtez avant le jour 31.')+'</div></div>'+
 '<div class="pad" style="padding-top:12px"><div class="fine" style="margin-bottom:4px">'+t3('Prototype only','Prototype gusa','Prototype uniquement')+'</div>'+(s.d?'<button class="chip" onclick="s31Day(1)" style="height:44px;border-radius:22px;border:0;padding:0 16px;font-size:14px;font-weight:700;background:var(--chip);color:var(--tx)">'+t3('Go to tomorrow','Jya ku munsi w’ejo','Passer à demain')+'</button>':'<button class="chip" onclick="s31Day(0)" style="height:44px;border-radius:22px;border:0;padding:0 16px;font-size:14px;font-weight:700;background:var(--chip);color:var(--tx)">'+t3('Skip today and restart the streak','Simbuka uyu munsi wongere utangire','Sauter aujourd’hui et repartir de zéro')+'</button>')+'</div><div style="height:100px"></div>'+
 '<div class="cta"><button class="btn" style="white-space:nowrap" '+(s.d||bad?'disabled ':'')+'onclick="s31Ask()">'+(s.d?t3('Saved today','Byazigamwe uyu munsi','Épargné aujourd’hui'):t3('Save '+fmt(a)+' RWF for today','Zigama '+fmt(a)+' RWF uyu munsi','Épargner '+fmt(a)+' RWF aujourd’hui'))+'</button></div>';
};
window.s31Pick=v=>{st().pick=v;keep(()=>render('fade-none'))};
window.s31Ask=()=>{const s=st(),a=s.on?s.a:s.pick;if(a>S.bank||(s.on&&s.d))return;
 if(!s.on)return sheet(t3('Start your 31-day streak?','Utangire iminsi 31 ukurikiranya?','Commencer votre série de 31 jours ?'),R(t3('Each day','Buri munsi','Chaque jour'),fmt(a)+' RWF')+R(t3('First save','Kuzigama bwa mbere','Premier versement'),t3('Today','Uyu munsi','Aujourd’hui'))+R(t3('Total after 31 days','Yose nyuma y’iminsi 31','Total après 31 jours'),fmt(a*31)+' RWF')+R(L.paid(),BANK)+R(L.after(),fmt(S.bank-a)+' RWF'),t3('Save once a day. If you miss a day, your streak starts again at day 1.','Zigama rimwe ku munsi. Nusiba umunsi, uzongera gutangira ku munsi wa 1.','Épargnez une fois par jour. Si vous manquez un jour, votre série repart au jour 1.'),CANCEL(),t3('Save '+fmt(a)+' RWF now','Zigama '+fmt(a)+' RWF ubu','Épargner '+fmt(a)+' RWF'),'s31Go()');
 sheet(t3('Save '+fmt(a)+' RWF for day '+(s.n+1)+'?','Zigama '+fmt(a)+' RWF ku munsi wa '+(s.n+1)+'?','Épargner '+fmt(a)+' RWF pour le jour '+(s.n+1)+' ?'),R(t3('Streak after','Iminsi ukurikiranya nyuma','Série après'),t3((s.n+1)+' of 31 days',(s.n+1)+' kuri 31',(s.n+1)+' jours sur 31'))+R(t3('Saved after','Ibyazigamwe nyuma','Épargne après'),fmt(s.t+a)+' RWF')+R(L.paid(),BANK)+R(L.after(),fmt(S.bank-a)+' RWF'),'',CANCEL(),save(a),'s31Go()')};
window.s31Go=()=>{const s=st(),a=s.on?s.a:s.pick;if(a>S.bank||(s.on&&s.d))return;
 s.a=a;s.on=1;s.n++;s.t+=a;s.d=1;S.bank-=a;addAct('coin','31-day savings \u00b7 Day '+s.n,'Saved',-a,'Sent');closeSheet();render('fade-none');
 toast(s.n===31?t3('Day 31 done. Your bonus is ready.','Umunsi wa 31 urarangiye. Igihembo cyawe kiruzuye.','Jour 31 terminé. Votre bonus est prêt.'):t3('Day '+s.n+' saved. See you tomorrow.','Umunsi wa '+s.n+' wazigamwe. Tuzabonana ejo.','Jour '+s.n+' enregistré. À demain.'));if(s.n===31)setTimeout(confetti,200)};
window.s31Day=k=>{const s=st();if(k){s.d=0}else{s.n=0;s.d=0}render('fade-none');toast(k?t3('It is a new day.','Ni undi munsi mushya.','C’est un nouveau jour.'):t3('Streak restarted at day 1.','Iminsi ukurikiranya yongeye gutangira ku munsi wa 1.','Série redémarrée au jour 1.'))};
window.s31StopAsk=()=>{const s=st();sheet(t3('Stop and take back '+fmt(s.t)+' RWF?','Uhagarike usubirane '+fmt(s.t)+' RWF?','Arrêter et récupérer '+fmt(s.t)+' RWF ?'),R(L.yours(),fmt(s.t)+' RWF')+R(t3('Bonus','Igihembo','Bonus'),t3('None before day 31','Nta na kimwe mbere y’umunsi wa 31','Aucun avant le jour 31'))+R(L.goes(),BANK)+R(L.after(),fmt(S.bank+s.t)+' RWF'),t3('You can start a new 31-day streak any time.','Ushobora gutangira indi minsi 31 igihe icyo ari cyo cyose.','Vous pouvez commencer une nouvelle série de 31 jours à tout moment.'),t3('Keep saving','Komeza kuzigama','Continuer'),t3('Take back '+fmt(s.t)+' RWF','Subirana '+fmt(s.t)+' RWF','Récupérer '+fmt(s.t)+' RWF'),'s31Stop()')};
window.s31Stop=()=>{const s=st(),t=s.t;S.bank+=t;addAct('up','31-day savings \u00b7 Taken back','Received',t,'Received');S.dsv31=fresh(s.a);closeSheet();render('fade-none');toast(t3(fmt(t)+' RWF is back in itunda Bank',fmt(t)+' RWF yagarutse kuri itunda Bank',fmt(t)+' RWF sont de retour dans itunda Bank'))};
window.s31CollectAsk=()=>{const s=st(),b=Math.round(s.t*rate(s.n)/100);sheet(t3('Collect '+fmt(s.t+b)+' RWF?','Wakire '+fmt(s.t+b)+' RWF?','Récupérer '+fmt(s.t+b)+' RWF ?'),R(L.yours(),fmt(s.t)+' RWF')+R(nb(t3('Bonus ('+rate(s.n)+'%)','Igihembo ('+rate(s.n)+'%)','Bonus ('+rate(s.n)+' %)')),'+'+fmt(b)+' RWF')+R(L.goes(),BANK)+R(L.after(),fmt(S.bank+s.t+b)+' RWF'),'',t3('Not now','Ntibyakorwe ubu','Pas maintenant'),t3('Collect '+fmt(s.t+b)+' RWF','Akira '+fmt(s.t+b)+' RWF','Récupérer '+fmt(s.t+b)+' RWF'),'s31Collect()')};
window.s31Collect=()=>{const s=st(),b=Math.round(s.t*rate(s.n)/100),g=s.t+b;S.bank+=g;addAct('up','31-day savings \u00b7 Paid out','Received',g,'Received');S.dsv31=fresh(s.a);closeSheet();render('fade-none');toast(t3(fmt(g)+' RWF added to itunda Bank',fmt(g)+' RWF yongewe kuri itunda Bank',fmt(g)+' RWF ajoutés à itunda Bank'));setTimeout(confetti,200)};
/* Activity rows keep their English text in the store; the four screens that list them already pass through tr26, so the 31-day wording is translated there. */
const _tr=window.tr26;
window.tr26=h=>{if(S.lang==='rw'||S.lang==='fr'){const rw=S.lang==='rw';
 h=h.replace(/31-day savings \u00b7 (Day (\d+)|Taken back|Paid out)/g,(a,x,n)=>(rw?'Kuzigama iminsi 31':'Épargne sur 31 jours')+' \u00b7 '+(n?(rw?'Umunsi wa '+n:'Jour '+n):x==='Taken back'?(rw?'Byasubijwe':'Récupéré'):(rw?'Byishyuwe':'Versé')))
  .replace(/>Saved \u00b7 Just now</g,rw?'>Byabitswe \u00b7 Ubu nyine<':'>Épargné \u00b7 À l\'instant<')}
 return typeof _tr==='function'?_tr(h):h};
document.title='itunda, clickable prototype v218';
})();
</script>
<script>
/* v219: Family in French and Kinyarwanda. v207 rebuilt "Link your family" for English only, so in fr/rw the old page came back: English text, no name or phone number to type, no choice between a child and a guardian, no weekly limit, no review and no list of invites. The whole v207 flow now works in all three languages with the same rules: "Who are you linking?" with one line on what each can see; their name and phone number as typed fields with a live count ("7 of 10 digits") and messages for a number that does not start with 07 or was already invited; the weekly limit for a child (1,000 / 3,000 / 5,000 RWF); a button that names the person ("Inviter Aline", "Tumira Aline") and a line saying what is missing while it is off; the review before sending; "Your family" with each invite; and Cancel invite with a confirmation. English is untouched (it still runs v207's own code). fr is new copy; rw is new copy and, like v166, v217 and v218, needs native review, especially "umurera" (guardian), "ntarengwa" (limit) and "ubutumire" (invitation). */
(function(){
const t3=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e,nb=s=>S.lang==='fr'?s.replace(/ ([?:!%])/g,'\u00a0$1'):s;
const R=(a,v)=>'<div style="display:flex;justify-content:space-between;gap:12px;min-height:40px;align-items:center;font-size:15px;border-top:0"><span class="mu">'+a+'</span><b style="text-align:right">'+v+'</b></div>';
const esc=x=>String(x).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
S.fam=S.fam||[];S.fm=S.fm||{role:'child',n:'',ph:'',lim:3000};
const dg=v=>String(v||'').replace(/\D/g,'').slice(0,10);
const nm=()=>(S.fm.n||'').trim();
const dup=()=>S.fam.some(x=>x.ph===dg(S.fm.ph));
const phMsg=()=>{const d=dg(S.fm.ph);
 if(!d)return{t:t3('','Andika numero ya telefone ye, urugero 078 123 4567.','Saisissez son numéro, par exemple 078 123 4567.'),ok:0};
 if(d.length<10)return{t:t3('',d.length+' kuri 10',d.length+' chiffres sur 10'),ok:0};
 if(d.slice(0,2)!=='07')return{t:t3('','Numero za telefone z’u Rwanda zitangira kuri 07.','Les numéros mobiles rwandais commencent par 07.'),ok:0,er:1};
 if(dup())return{t:t3('','Waramaze gutumira iyi numero.','Vous avez déjà invité ce numéro.'),ok:0,er:1};
 return{t:t3('','Ni byiza.','C’est bon.'),ok:1}};
const miss=()=>nm().length<2?t3('','Andika izina rye kugira ngo ukomeze.','Saisissez son prénom pour continuer.'):(!phMsg().ok?t3('','Kosora numero ye kugira ngo ukomeze.','Corrigez son numéro pour continuer.'):'');
const fmtP=d=>d.replace(/^(\d{3})(\d{0,3})(\d{0,4}).*/,(m,a,b,c)=>[a,b,c].filter(Boolean).join(' '));
const lab=(t,pad)=>'<div style="font-size:16px;font-weight:800;padding:'+(pad||'22px 24px 0')+'">'+nb(t)+'</div>';
const chipB=(on,fn,txt)=>'<button class="chip" aria-pressed="'+on+'" onclick="'+fn+'" style="min-width:64px;height:44px;border-radius:22px;border:0;padding:0 16px;font-size:15px;font-weight:800;background:'+(on?'var(--tx)':'var(--chip)')+';color:'+(on?'var(--bg)':'var(--tx)')+'">'+txt+'</button>';
const inp=(id,v,ph,fn,mode)=>'<input id="'+id+'" value="'+esc(v)+'" oninput="'+fn+'(this.value)" autocomplete="off" '+(mode?'inputmode="'+mode+'" ':'')+'placeholder="'+ph+'" aria-describedby="'+id+'H" style="width:100%;height:48px;margin-top:10px;border:0;border-radius:14px;background:var(--chip);color:var(--tx);padding:0 16px;font:inherit;font-size:16px">';
const sheet=(h,body,note,no,yes,go)=>{$('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="h1" style="font-size:22px;line-height:30px;margin-top:4px">'+nb(h)+'</div><div style="margin:12px 0 '+(note?'12':'20')+'px">'+body+'</div>'+(note?'<div class="mu sm" style="margin-bottom:16px;line-height:20px">'+nb(note)+'</div>':'')+'<div class="row2" style="display:grid;grid-template-columns:1fr 1.8fr"><button class="btn sec2" onclick="closeSheet()">'+no+'</button><button class="btn" style="white-space:nowrap" onclick="'+go+'">'+yes+'</button></div></div>';if(typeof focusSheet==='function')focusSheet()};
const CANCEL=()=>t3('Cancel','Reka','Annuler');
const KIND=r=>r==='child'?t3('A child','Umwana','Un enfant'):t3('A guardian','Umurera','Un tuteur');
const sendTxt=()=>nm().length>=2?t3('','Tumira '+nm(),'Inviter '+nm()):t3('','Ohereza ubutumire','Envoyer l’invitation');
const _s=screens.svc;
screens.svc=()=>{if(S.lang==='en'||S.svk!=='family')return _s();
 const f=S.fm,ch=f.role==='child',pm=phMsg(),m=miss();
 const roles=[['child',KIND('child'),t3('','Uri umurera we. Ubona ibyo akoresha kandi ugena amafaranga ntarengwa y’icyumweru.','Vous êtes son tuteur. Vous voyez ses dépenses et fixez sa limite hebdomadaire.')],['guardian',KIND('guardian'),t3('','Ashobora kubona ibyo ukoresha, ntashobora kubihindura.','La personne invitée peut voir vos dépenses, en lecture seule.')]].map(r=>'<div class="row tap" role="radio" aria-checked="'+(f.role===r[0])+'" tabindex="0" onclick="famRole(\''+r[0]+'\')" style="padding:12px 24px;'+(f.role===r[0]?'background:var(--tint)':'')+'"><div style="width:22px;height:22px;border-radius:11px;border:2px solid '+(f.role===r[0]?'var(--lk)':'var(--ln)')+';display:flex;align-items:center;justify-content:center;flex:none">'+(f.role===r[0]?'<div style="width:10px;height:10px;border-radius:5px;background:var(--lk)"></div>':'')+'</div><div style="flex:1"><div class="t">'+r[1]+'</div><div class="s">'+nb(r[2])+'</div></div></div>').join('');
 const list=S.fam.length?lab(t3('','Umuryango wawe','Votre famille'))+S.fam.map((x,i)=>'<div class="row" style="cursor:default;padding:12px 24px"><div class="ico" style="font-size:14px;font-weight:800">'+esc(x.n.split(/\s+/).map(w=>w[0]).join('').slice(0,2).toUpperCase())+'</div><div style="flex:1;min-width:0"><div class="t">'+esc(x.n)+'</div><div class="s">'+(x.role==='child'?t3('','Umwana \u00b7 ntarengwa '+fmt(x.lim)+' RWF mu cyumweru','Enfant \u00b7 limite '+fmt(x.lim)+' RWF par semaine'):t3('','Umurera','Tuteur'))+' \u00b7 '+fmtP(x.ph)+'<br>'+t3('','Ubutumire bwoherejwe, butegereje igisubizo','Invitation envoyée, en attente')+'</div></div><button class="sm" style="background:none;border:0;color:var(--er);font-weight:700;padding:8px 0 8px 8px" onclick="famAsk('+i+')">'+CANCEL()+'</button></div>').join(''):'';
 return bar(t3('','Umuryango','Famille'))+'<div style="padding:22px 24px 0"><div class="h1">'+t3('','Huza umuryango wawe','Reliez votre famille')+'</div><div class="mu" style="font-size:15px;line-height:22px;margin-top:8px">'+t3('','Huza umurera cyangwa umwana. Abarera babona ibyakoreshejwe, badashobora kubihindura.','Reliez un tuteur ou un enfant. Les tuteurs voient les dépenses, en lecture seule.')+'</div></div>'+list+
 lab(t3('','Uhuza nde?','Qui reliez-vous ?'))+'<div role="radiogroup" style="padding-top:6px">'+roles+'</div>'+
 '<div style="padding:0 24px">'+lab(t3('','Izina rye','Son prénom'),'22px 0 0')+inp('fN',f.n,t3('','Izina rye rya mbere','Son prénom'),'famName')+lab(t3('','Numero ya telefone ye','Son numéro de téléphone'),'22px 0 0')+inp('fP',f.ph,'078 123 4567','famPh','tel')+'<div id="fPH" class="sm" style="margin-top:8px;color:'+(pm.er?'var(--er)':pm.ok?'var(--ok)':'var(--mu)')+'" aria-live="polite">'+nb(pm.t)+'</div></div>'+
 (ch?lab(t3('','Amafaranga ntarengwa y’icyumweru','Limite de dépenses par semaine'))+'<div style="display:flex;gap:10px;flex-wrap:wrap;padding:10px 24px 0" role="group">'+[1000,3000,5000].map(v=>chipB(f.lim===v,'famLim('+v+')',fmt(v)+' RWF')).join('')+'</div><div class="pad sm mu" style="padding-top:8px">'+t3('','Uzabihindura nyuma.','Vous pourrez la modifier plus tard.')+'</div>':'')+
 '<div class="pad fine" style="padding-top:18px">'+t3('','Azabona ubusabe ubutaha afunguye itunda. Amakuru yo kugerageza.','La personne invitée voit une demande à sa prochaine ouverture d’itunda. Données d’exemple.')+'</div><div style="height:100px"></div><div class="cta"><button class="btn" id="fGo" style="white-space:nowrap" '+(m?'disabled ':'')+'onclick="famReview()">'+sendTxt()+'</button><div id="fW" class="sm mu" style="text-align:center;margin-top:8px">'+m+'</div></div>'};
const upd=()=>{const pm=phMsg(),m=miss(),b=document.getElementById('fGo'),w=document.getElementById('fW'),h=document.getElementById('fPH');
 if(b){b.disabled=!!m;b.textContent=sendTxt()}if(w)w.textContent=m;
 if(h){h.textContent=pm.t;h.style.color=pm.er?'var(--er)':pm.ok?'var(--ok)':'var(--mu)'}};
const wrap=(name,fn)=>{const o=window[name];window[name]=function(){return S.lang==='en'&&typeof o==='function'?o.apply(this,arguments):fn.apply(this,arguments)}};
wrap('famName',v=>{S.fm.n=v;upd()});
wrap('famPh',v=>{S.fm.ph=v;upd()});
wrap('famReview',()=>{if(miss())return;const f=S.fm,ch=f.role==='child';
 sheet(t3('','Wohereze ubutumire kuri '+esc(nm())+'?','Envoyer une invitation à '+esc(nm())+' ?'),R(t3('','Uhuza','Vous reliez'),KIND(f.role))+R(t3('','Izina','Prénom'),esc(nm()))+R(t3('','Telefone','Téléphone'),fmtP(dg(f.ph)))+(ch?R(t3('','Ntarengwa y’icyumweru','Limite hebdomadaire'),fmt(f.lim)+' RWF'):'')+R(ch?t3('','Ubona','Vous pouvez voir'):t3('','Ashobora kubona','Peut voir'),ch?t3('','Ibyo akoresha, ntashobora kubihindura','Ses dépenses, en lecture seule'):t3('','Ibyo ukoresha, ntashobora kubihindura','Vos dépenses, en lecture seule')),t3('','Azabona ubusabe ubutaha afunguye itunda. Ushobora kubuhagarika kugeza igihe azabwemera.','La personne invitée reçoit une demande à sa prochaine ouverture d’itunda. Vous pouvez l’annuler tant qu’elle n’a pas accepté.'),CANCEL(),t3('','Ohereza','Envoyer'),'famGo()')});
wrap('famGo',()=>{if(miss())return;const f=S.fm,n=nm();S.fam.push({n,ph:dg(f.ph),role:f.role,lim:f.lim});S.fm={role:f.role,n:'',ph:'',lim:f.lim};closeSheet();render('fade-none');toast(t3('','Ubutumire bwoherejwe kuri '+n,'Invitation envoyée à '+n))});
wrap('famAsk',i=>{const x=S.fam[i];if(!x)return;sheet(t3('','Uhagarike ubutumire bwa '+esc(x.n)+'?','Annuler l’invitation à '+esc(x.n)+' ?'),R(t3('','Telefone','Téléphone'),fmtP(x.ph))+R(t3('','Uhuza','Vous reliez'),KIND(x.role)),'',t3('','Bugumane','La garder'),t3('','Hagarika','Annuler'),'famDel('+i+')')});
wrap('famDel',i=>{const x=S.fam[i];if(!x)return;S.fam.splice(i,1);closeSheet();render('fade-none');toast(t3('','Ubutumire bwa '+x.n+' bwahagaritswe','Invitation à '+x.n+' annulée'))});
document.title='itunda, clickable prototype v219';
})();
</script>
<script>
/* v223: Home is quieter. The Money manager card (v220 to v222) and the \"Free delivery on your first order / View\" banner are both removed from Home, so Home goes from balances straight to spending, the bill and pockets. The Money manager page itself is still in the file but has no way in from Home for now; the offer is still found in itunda Eats and in the Bank screen. */
/* v222: Home row for the Money manager, Toss style. The row used to look like any other line in the list (plain grey text and a thin arrow), so it was easy to miss and looked like part of the spending row under it. It is now its own soft purple card at the top of the first card: a round white icon, a small purple label (\"Money manager\"), today's suggestion as a bold headline that can use two lines (long French and Kinyarwanda headlines no longer get cut), and a purple arrow. Whole card is one tap target (44 px icon, 16 px padding) and works in light and dark. Same behaviour as v221: it follows the first suggestion still visible and disappears when none is left. No new text. */
/* v221: Money manager, "Not now" and a Back that stays in the manager. Each suggestion now has a quiet "Not now" (fr "Pas maintenant", rw "Si ubu") that hides it for this visit: the next suggestion shows, the Money manager row on Home follows (it shows the first suggestion still visible, and goes away when none is left), and when every suggestion is hidden the page says "All clear" with one link, "Show hidden suggestions (2)", to bring them back. Hidden suggestions are not remembered after a reload (sample data). Also fixed: "Pay 18,500 RWF" used to throw the Money manager out of the Back path (Back went to Home); it now goes back to the manager like Fill pocket does. rw "Si ubu" and "Inama zahishwe" (hidden suggestions) are new copy and need native review, like v166 and v217 to v220. Not in this version: typing or speaking a request, and remembering what you hide. */
/* v220: Money manager. A new page that looks at your own numbers (itunda Pay balance, the bill due on Friday, your monthly auto-transfers, your pockets and your spending) and shows ONE next step at a time: a plain headline, two sentences with the numbers, why you are seeing it, and one button that opens the screen that already does the job (Pay the bill, Add money, Fill a pocket), where you still confirm as usual. "Show another suggestion" moves to the next one. It only suggests: nothing moves from this page. Four suggestions in this version: pay the electricity bill before Friday (only while the bill is still on Home and Pay can cover it), keep enough in Pay for the 1st (only when monthly auto-transfers are more than the Pay balance), how many weeks until a pocket with a goal is full (with and without 1,000 RWF more a week), and the emergency fund measured in days of spending. Home has a "Money manager" row at the top of the first card that shows today's first suggestion. English, French and Kinyarwanda; fr is new copy and rw is new copy that, like v166 and v217 to v219, needs native review, especially "Umujyanama" (manager) and "Inama" (suggestion). Not in this version: typing or speaking a request ("fill school fees"), and learning from what you skip. */
(function(){
const t3=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e,nb=s=>S.lang==='fr'?s.replace(/ ([?:!%])/g,'\u00a0$1'):s;
if(!document.getElementById('mgcss')){const st=document.createElement('style');st.id='mgcss';st.textContent='.mgc{display:flex;align-items:center;gap:14px;margin:8px 8px 6px;padding:16px 18px;border-radius:20px;background:var(--tint);cursor:pointer}.mgi{flex:none;width:44px;height:44px;border-radius:22px;background:var(--bg);display:flex;align-items:center;justify-content:center}.mgt{flex:1;min-width:0}.mgl{font-size:13px;font-weight:700;color:var(--tintfg);line-height:18px}.mgh{font-size:17px;font-weight:800;letter-spacing:-.3px;line-height:24px;margin-top:2px;color:var(--tx)}';document.head.appendChild(st)}
const home0=screens.home;
const NM={'School fees':['Amafaranga y’ishuri','Frais de scolarité'],'Emergency fund':['Amafaranga y’ihutirwa','Fonds d’urgence'],'Interest jar':['Agasanduku k’inyungu','Tirelire à intérêts']};
const pnm=n=>{const x=NM[n];return x?t3(n,x[0],x[1]):n};
const num=s=>parseInt(String(s).replace(/\D/g,''),10)||0;
const pocket=id=>(Array.isArray(S.pk)?S.pk:[]).find(p=>p&&p.id===id);
const cands=all=>{const C=[],pay=S.pay,h=home0();
 // 1. bill due, Pay can cover it
 if(h.indexOf("openBill('REG electricity',18500)")>-1&&pay>=18500)C.push({k:'bill',
  h:t3('Pay your electricity bill before Friday','Ishyura fagitire y’amashanyarazi mbere ya Gatanu','Payez votre facture d’électricité avant vendredi'),
  b:t3('REG electricity is due Friday: 18,500 RWF. Your itunda Pay balance is '+fmt(pay)+' RWF, so you can pay it now.','REG electricity igomba kwishyurwa kuwa Gatanu: 18,500 RWF. Amafaranga ufite kuri itunda Pay ni '+fmt(pay)+' RWF, bityo ushobora kuyishyura ubu.','REG electricity est à payer vendredi : 18,500 RWF. Votre solde itunda Pay est de '+fmt(pay)+' RWF : vous pouvez payer maintenant.'),
  w:t3('Bill due date and your itunda Pay balance','Itariki fagitire igomba kwishyurirwaho n’amafaranga ufite kuri itunda Pay','Échéance de la facture et solde itunda Pay'),
  btn:t3('Pay 18,500 RWF','Ishyura 18,500 RWF','Payer 18,500 RWF'),go:()=>{openBill('REG electricity',18500);S.stack=['mgr','bill']}});
 // 2. monthly auto-transfers more than the Pay balance
 const mo=(Array.isArray(S.at)?S.at:[]).filter(a=>a&&a[4]&&/^1st of each month/.test(a[2])).reduce((s,a)=>s+num(a[3]),0);
 if(mo>pay)C.push({k:'rent',
  h:t3('Keep enough in Pay for the 1st','Bika amafaranga ahagije kuri Pay ku itariki ya 1','Gardez assez sur Pay pour le 1er'),
  b:t3('Your monthly auto-transfers ('+fmt(mo)+' RWF) leave itunda Pay on the 1st. Your balance is '+fmt(pay)+' RWF, which is '+fmt(mo-pay)+' RWF short.','Kohereza byikora bya buri kwezi ('+fmt(mo)+' RWF) bivana kuri itunda Pay ku itariki ya 1. Ufite '+fmt(pay)+' RWF, abura '+fmt(mo-pay)+' RWF.','Vos virements automatiques mensuels ('+fmt(mo)+' RWF) partent d’itunda Pay le 1er. Votre solde est de '+fmt(pay)+' RWF : il manque '+fmt(mo-pay)+' RWF.'),
  w:t3('Your auto-transfers and itunda Pay balance','Kohereza byawe byikora n’amafaranga ufite kuri itunda Pay','Vos virements automatiques et votre solde itunda Pay'),
  btn:t3('Add money','Ongeramo amafaranga','Ajouter de l’argent'),go:()=>tab('pay')});
 // 3. a pocket with a goal
 const g=(Array.isArray(S.pk)?S.pk:[]).find(p=>p&&p.t&&p.t>(p.b||0));
 if(g){const b=g.b||0,p=Math.round(b/g.t*100),p2=Math.round(Math.min(g.t,b+5000)/g.t*100),N=pnm(g.n);
  const ar=(Array.isArray(S.at)?S.at:[]).find(a=>a&&a[4]&&String(a[1]).indexOf(g.n)===0&&/^Every/.test(a[2])),wk=ar?num(ar[3]):0;
  const w1=wk?Math.ceil((g.t-b)/wk):0,w2=wk?Math.ceil((g.t-b)/(wk+1000)):0;
  C.push({k:'goal',
  h:t3(N+' is '+p+'% full',N+': '+p+'% yuzuye',N+' : '+p+' % atteint'),
  b:wk?t3('At '+fmt(wk)+' RWF a week it will be full in '+w1+' weeks. Adding 1,000 RWF a week makes it '+w2+'.','Ku '+fmt(wk)+' RWF mu cyumweru izuzura mu byumweru '+w1+'. Wongeyeho 1,000 RWF mu cyumweru byaba '+w2+'.','À '+fmt(wk)+' RWF par semaine, l’objectif sera atteint en '+w1+' semaines. Avec 1,000 RWF de plus par semaine : '+w2+' semaines.'):t3('Adding 5,000 RWF now takes it to '+p2+'%.','Kongeraho 5,000 RWF ubu bigeza kuri '+p2+'%.','Ajouter 5,000 RWF maintenant porte l’objectif à '+p2+' %.'),
  w:t3('Your pocket goal and auto-transfers','Intego y’agasanduku kawe n’ibyo wateguye byikora','Votre objectif et vos virements automatiques'),
  btn:t3('Fill pocket','Uzuza agasanduku','Alimenter la tirelire'),go:()=>{openPocket(g.id);openMv('in')}})}
 // 4. emergency fund in days of spending
 const e=pocket('emg');
 if(e&&e.b){const d=Math.max(1,Math.round(e.b/(312000/30)));
  C.push({k:'emg',
  h:t3('Build your emergency fund','Kubaka amafaranga y’ihutirwa','Constituez votre fonds d’urgence'),
  b:t3('Your emergency fund of '+fmt(e.b)+' RWF covers about '+d+' days of spending. A common goal is 30 days.','Amafaranga y’ihutirwa ya '+fmt(e.b)+' RWF ahagije ku minsi nka '+d+' y’ibyo ukoresha. Intego isanzwe ni iminsi 30.','Votre fonds d’urgence de '+fmt(e.b)+' RWF couvre environ '+d+' jours de dépenses. Un objectif courant est de 30 jours.'),
  w:t3('Your emergency fund and spending this period (sample data)','Amafaranga y’ihutirwa ufite n’ibyo wakoresheje muri iki gihe (amakuru yo kugerageza)','Votre fonds d’urgence et vos dépenses de la période (données d’exemple)'),
  btn:t3('Fill pocket','Uzuza agasanduku','Alimenter la tirelire'),go:()=>{openPocket('emg');openMv('in')}})}
 return all?C:C.filter(c=>(S.mgx||[]).indexOf(c.k)<0)};
const T=()=>t3('Money manager','Umujyanama w’amafaranga','Gestionnaire d’argent');
const keep=fn=>{const sc=document.querySelector('#phone .screen'),y=sc?sc.scrollTop:0;fn();const s2=document.querySelector('#phone .screen');if(s2)s2.scrollTop=y};
screens.mgr=()=>{const C=cands(),n=C.length,H=bar(T());
 if(!n){const hid=cands(true).length-n;return H+'<div class="pad" style="padding-top:24px"><div class="h1">'+t3('All clear','Byose bimeze neza','Tout est en ordre')+'</div><div class="mu" style="font-size:16px;margin-top:12px;line-height:24px">'+t3('Nothing needs you right now. We will tell you when something does.','Nta kintu gikeneye ko ugikora ubu. Tuzakubwira igihe kizaba gikenewe.','Rien ne demande votre attention pour le moment. Nous vous le dirons quand ce sera le cas.')+'</div></div>'+(hid>0?'<div class="pad" style="padding-top:12px"><button onclick="mgrShow()" style="border:0;background:none;padding:0;min-height:44px;color:var(--lk);font-weight:700;font-size:15px;text-align:left">'+nb(t3('Show hidden suggestions ('+hid+')','Erekana inama zahishwe ('+hid+')','Afficher les suggestions masquées ('+hid+')'))+'</button></div>':'')};
 const i=Math.min(S.mgi||0,n-1),c=C[i];
 return H+'<div class="pad" style="padding-top:24px"><div class="sm mu" style="font-weight:700">'+(n>1?t3('Suggestion '+(i+1)+' of '+n,'Inama '+(i+1)+' kuri '+n,'Suggestion '+(i+1)+' sur '+n):t3('Suggestion','Inama','Suggestion'))+'</div><div class="h1" style="margin-top:6px">'+nb(c.h)+'</div><div class="mu" style="font-size:16px;margin-top:12px;line-height:24px">'+nb(c.b)+'</div></div>'+
 '<div class="pad" style="padding-top:20px"><div style="padding:14px 18px;border-radius:20px;background:var(--chip);font-size:14px;line-height:20px"><b>'+nb(t3('Why you see this','Impamvu ubibona','Pourquoi vous voyez ceci'))+'</b><div class="mu" style="margin-top:2px">'+nb(c.w)+'</div></div></div>'+
 (n>1?'<div class="pad" style="padding-top:8px"><button onclick="mgrNext()" style="border:0;background:none;padding:0;min-height:44px;color:var(--lk);font-weight:700;font-size:15px;text-align:left">'+t3('Show another suggestion','Erekana indi nama','Voir une autre suggestion')+'</button></div>':'')+
 '<div class="pad" style="padding-top:'+(n>1?'0':'8px')+'"><button onclick="mgrHide()" style="border:0;background:none;padding:0;min-height:44px;color:var(--mu);font-weight:700;font-size:15px;text-align:left">'+t3('Not now','Si ubu','Pas maintenant')+'</button></div>'+
 '<div class="pad fine" style="padding-top:8px;line-height:18px">'+nb(t3('We only suggest. Nothing moves until you confirm. Sample data.','Dutanga inama gusa. Nta mafaranga yimuka utarabyemeza. Amakuru yo kugerageza.','Nous ne faisons que suggérer. Rien ne bouge tant que vous n’avez pas confirmé. Données d’exemple.'))+'</div><div style="height:100px"></div>'+
 '<div class="cta"><button class="btn" style="white-space:nowrap" onclick="mgrGo()">'+c.btn+'</button></div>'};
window.mgrOpen=()=>{S.mgi=0;S.stack.push('mgr');render('push')};
window.mgrNext=()=>{const n=cands().length;S.mgi=((S.mgi||0)+1)%Math.max(n,1);keep(()=>render('fade-none'))};
window.mgrHide=()=>{const C=cands(),c=C[Math.min(S.mgi||0,C.length-1)];if(!c)return;S.mgx=(S.mgx||[]).concat(c.k);const n=cands().length;S.mgi=n?Math.min(S.mgi||0,n-1):0;keep(()=>render('fade-none'))};
window.mgrShow=()=>{S.mgx=[];S.mgi=0;keep(()=>render('fade-none'))};
window.mgrGo=()=>{const C=cands(),c=C[Math.min(S.mgi||0,C.length-1)];if(c)c.go()};
screens.home=function(){const h=home0.apply(this,arguments);if(typeof h!=='string')return h;
 return h.replace(/<div class="hc hpm">[\s\S]*?<\/button><div class="tap"[\s\S]*?<\/div><div class="sm"[^>]*>[^<]*<\/div><\/div><\/div>/,'');
 const C=cands();if(!C.length)return h;
 const a='<div class="hr tap" role="button" tabindex="0" onclick="openSpend()">',i=h.indexOf(a);if(i<0)return h;
const row='<div class="mgc tap" role="button" tabindex="0" onclick="mgrOpen()"><div class="mgi"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--tintfg)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9L12 3Z"/><path d="M19 16l.7 1.8L21.5 18.5l-1.8.7L19 21l-.7-1.8-1.8-.7 1.8-.7L19 16Z"/></svg></div><div class="mgt"><div class="mgl">'+T()+'</div><div class="mgh">'+nb(C[0].h)+'</div></div><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--tintfg)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg></div>';
 return h.slice(0,i)+row+h.slice(i)};
document.title='itunda, clickable prototype v223';
})();

/* v224: Clean-up pass. (1) Explore (about 70 services in one run) now has a clear heading on every group, in English, French and Kinyarwanda ("Everyday", "Send & pay", "Borrow" and so on), and the two long groups (Accounts & cards, Borrow) show their first 4 and a "Show 6 more" line, so the page reads as nine short lists. Searching still shows every match. (2) Small secondary text goes from 13 px to 14 px on Home, Pay, Explore and Messages (account names, due dates, row captions, message previews, button labels). (3) Small links and icon buttons (See all, Support, Settings, hide balances, the dots on a message) now have a 44 px touch area without moving anything. rw headings are new copy and need native review, like v166 and v217 to v222. On Explore each service now shows its short caption under its name instead of squeezed to the right, so names like \"Open account\" no longer wrap. Not in this version: the other tabs' inner screens (shop, pockets, loans) were not re-spaced. */
(function(){
const t3=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e;
const H={'Places & trips':['Places & trips','Ahantu n’ingendo','Lieux et trajets'],'Everyday':['Everyday','Buri munsi','Au quotidien'],'Your neighbourhood':['Your neighbourhood','Mu gace utuyemo','Votre quartier'],'Money tools':['Money tools','Ibikoresho by’amafaranga','Outils d’argent'],'Accounts & cards':['Accounts & cards','Konti n’amakarita','Comptes et cartes'],'Send & pay':['Send & pay','Ohereza & wishyure','Envoyer et payer'],'Save & grow':['Save & grow','Zigama & ukure','Épargner et faire fructifier'],'Borrow':['Borrow','Gufata inguzanyo','Emprunter'],'Transport':['Transport','Ingendo','Transport'],'Support':['Support','Ubufasha','Aide']};
const st=document.createElement('style');st.id='v224css';st.textContent=
'.xgh{padding:20px 12px 6px;font-size:18px;font-weight:800;letter-spacing:-.3px;line-height:26px;color:var(--tx)}'+
'.xg .ar.xhide{display:none}'+
'.xg .ar:not(.xhide){display:grid;grid-template-columns:44px 1fr;column-gap:14px;align-items:center;padding-top:10px;padding-bottom:10px}.xg .ar .g{grid-row:1/3;grid-column:1}.xg .ar .t{grid-column:2;grid-row:1;align-self:end;line-height:22px}.xg .ar .s{grid-column:2;grid-row:2;align-self:start;justify-self:start;text-align:left;margin:0!important;padding:0!important;color:var(--mu)}.xg .ar .t{margin:0!important;padding:0!important}.xg .ar:not(.xhide){row-gap:0}'+
'.xmore{display:flex;align-items:center;width:100%;min-height:48px;padding:0 12px;border:0;background:none;color:var(--lk);font-weight:700;font-size:15px;text-align:left}'+
'.sm,.row .s,.xg .ar .s,.hm .sm{font-size:14px;line-height:20px}.hr .hp{font-size:14px;max-width:132px}.pkpn{font-size:14px;line-height:20px}'+
'.sech a,.xl button,.xl{position:relative}.sech a::after,.xl button::after{content:"";position:absolute;inset:-14px -10px}'+
'.pad .hide,button[aria-label="Hide balances"],button[aria-label="Show balances"]{position:relative}button[aria-label="Hide balances"]::after,button[aria-label="Show balances"]::after{content:"";position:absolute;inset:-12px}';
document.head.appendChild(st);
const more=(n)=>t3('Show '+n+' more','Erekana '+n+' zindi','Voir '+n+' de plus'),less=()=>t3('Show less','Erekana bike','Voir moins');
let busy=false;
function tidy(){if(busy)return;busy=true;try{
 document.querySelectorAll('#phone .xp .xg:not([data-v224])').forEach((g,gi)=>{
  g.setAttribute('data-v224','1');
  const k=g.getAttribute('aria-label')||'',h=H[k];
  if(h){const d=document.createElement('div');d.className='xgh';d.textContent=t3(h[0],h[1],h[2]);g.insertBefore(d,g.firstChild)}
  const rows=[...g.children].filter(c=>c.classList&&c.classList.contains('ar'));
  if(false){const n=rows.length-4,open=(S.xpo||{})[k];
   rows.slice(4).forEach(r=>{if(!open)r.classList.add('xhide')});
   const b=document.createElement('button');b.className='xmore';b.setAttribute('aria-expanded',open?'true':'false');b.textContent=open?less():more(n);
   b.onclick=()=>{const o=!((S.xpo||{})[k]);S.xpo=Object.assign({},S.xpo,{[k]:o});rows.slice(4).forEach(r=>r.classList.toggle('xhide',!o));b.textContent=o?less():more(n);b.setAttribute('aria-expanded',o?'true':'false')};
   g.appendChild(b)}
 });
}finally{busy=false}}
new MutationObserver(tidy).observe(document.getElementById('phone'),{childList:true,subtree:true});tidy();
document.title='itunda, clickable prototype v224';
})();

/* v225b: Pay tab, Manage list. The last section on Pay had nine rows in a row. It now shows the first four (Payment history, Saved merchants, Pay limits, Upcoming bills) and a \"Show 5 more\" line that opens the rest and turns into \"Show less\". Same wording and same pattern as Explore (v224), so no new copy. Also on Pay: \"Recent activity\" rows no longer wrap (\"Received · Yesterday\" and \"Kigali Bus Services\" each fit on one line) because the arrow, which did nothing extra there, is gone from those rows. */
/* v225: You tab, shorter. The tab had 17 rows under five headings, and most of them were "0". Partner earnings, My favorites and My listings are now three closed sections: tap the heading (it has an arrow) to open it, tap again to close it. The profile, Verification, Settings, Language and Help stay in view, so the page is about nine lines long instead of twenty-two. The profile line (phone number) is 14 px. Open or closed is remembered while the app is open. Nothing is removed: every row is still one tap after opening the section. English, French and Kinyarwanda use the headings that were already there, so there is no new copy. */
(function(){
const st=document.createElement('style');st.id='v225css';st.textContent=
'.yacc{display:flex;align-items:center;justify-content:space-between;min-height:56px;font-size:17px!important;font-weight:700!important;color:var(--tx)!important;cursor:pointer;user-select:none}'+
'.yacc svg{flex:none;transition:transform .2s ease}.yacc[aria-expanded="true"] svg{transform:rotate(90deg)}'+
'.yhid{display:none!important}'+
'.v174 .row>div:nth-child(2){flex:1 1 auto;min-width:0}.v174 .row .r{flex:none;white-space:nowrap}.v174 .row .r:has(+*){margin-left:0}.noch .row .t{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.noch .r svg{display:none}'+
'.ar[onclick="openProfile()"] .s{font-size:14px!important;line-height:20px}';
document.head.appendChild(st);
let busy=false;
function tidy(){if(busy)return;busy=true;try{
 const t3=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e;
 document.querySelectorAll('#phone .screen').forEach(sc=>{
  if(sc.querySelector('.ppg')){const ab=[...sc.querySelectorAll('.v174')].slice(-2,-1)[0];if(ab)ab.classList.add('noch')}
  if(!sc.getAttribute('data-v225b')&&sc.querySelector('.ppg')){const bl=[...sc.querySelectorAll('.v174')].pop(),rows=bl?[...bl.querySelectorAll('.sec > .row')]:[];
   if(false){sc.setAttribute('data-v225b','1');const k='paymanage',n=rows.length-4,open=(S.xpo||{})[k];
    const more=()=>t3('Show '+n+' more','Erekana '+n+' zindi','Voir '+n+' de plus'),less=()=>t3('Show less','Erekana bike','Voir moins');
    rows.slice(4).forEach(r=>r.classList.toggle('yhid',!open));
    const b=document.createElement('button');b.className='xmore';b.style.padding='0';b.setAttribute('aria-expanded',open?'true':'false');b.textContent=open?less():more();
    b.onclick=()=>{const o=!((S.xpo||{})[k]);S.xpo=Object.assign({},S.xpo,{[k]:o});rows.slice(4).forEach(r=>r.classList.toggle('yhid',!o));b.textContent=o?less():more();b.setAttribute('aria-expanded',o?'true':'false')};
    rows[0].parentNode.appendChild(b)}}
  if(sc.getAttribute('data-v225')||!sc.querySelector('.ar[onclick="openProfile()"]'))return;
  const heads=[...sc.querySelectorAll(':scope > .agt')];if(heads.length<99)return;
  sc.setAttribute('data-v225','1');
  // the last heading (Settings) stays open; the ones before it fold, except none other
  heads.slice(0,-1).forEach((h,i)=>{
   const body=[];let n=h.nextElementSibling;while(n&&!n.classList.contains('agt')&&!n.classList.contains('fine')){body.push(n);n=n.nextElementSibling}
   const key=i,open=!!(S.yo||{})[key];
   h.classList.add('yacc');h.setAttribute('role','button');h.setAttribute('tabindex','0');h.setAttribute('aria-expanded',open?'true':'false');
   const txt=h.textContent;h.textContent='';const sp=document.createElement('span');sp.textContent=txt;h.appendChild(sp);
   h.insertAdjacentHTML('beforeend','<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--tt)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>');
   body.forEach(e=>e.classList.toggle('yhid',!open));
   const tg=()=>{const o=h.getAttribute('aria-expanded')!=='true';S.yo=Object.assign({},S.yo,{[key]:o});h.setAttribute('aria-expanded',o?'true':'false');body.forEach(e=>e.classList.toggle('yhid',!o))};
   h.onclick=tg;h.onkeydown=e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();tg()}};
  });
 });
}finally{busy=false}}
new MutationObserver(tidy).observe(document.getElementById('phone'),{childList:true,subtree:true});tidy();
document.title='itunda, clickable prototype v225';
})();

/* v227: Folding taken out. v224 to v226 hid content behind arrows and \"Show more\" lines (Explore groups, You sections, Pay Manage, Bank sections). That moves clutter out of sight and does not simplify, so every list is open again, as in v223. Kept: Explore group headings and two-line rows, 14 px secondary text, 13 px small print, the Pay Recent activity fix, the quieter Home. */
/* v226: Bank screen, shorter. The Bank page was about 4,000 px of open sections under the balance (Control, Cards & documents, Recommended for you, Save & grow, Borrow, Insights). Balance, the four actions, "Everything you have" and "Coming up" stay in view; the six sections below are now closed rows with an arrow (tap to open, tap again to close), like You (v225). The page is about one and a half screens instead of five. Open or closed is remembered while the app is open. Small print ("sample data" notes) goes from 12 to 13 px across the app. No new copy: headings are the ones already there in English, French and Kinyarwanda. */
(function(){
const st=document.createElement('style');st.id='v226css';st.textContent='.fine{font-size:13px!important;line-height:19px!important}.bacc{display:flex;align-items:center;justify-content:space-between;min-height:56px;cursor:pointer;user-select:none;padding-top:0!important;padding-bottom:0!important;font-size:17px!important;font-weight:700!important;color:var(--tx)!important}.bacc svg{flex:none;transition:transform .2s ease}.bacc[aria-expanded="true"] svg{transform:rotate(90deg)}.bhid{display:none!important}.v174.bsec{padding-top:0!important;padding-bottom:0!important}';
document.head.appendChild(st);
let busy=false;
function tidy(){if(busy)return;busy=true;try{
 document.querySelectorAll('#phone .screen').forEach(sc=>{
  if(sc.getAttribute('data-v226')||!sc.querySelector('.bka'))return;
  const blocks=[...sc.querySelectorAll(':scope > .v174')];if(blocks.length<99)return;
  sc.setAttribute('data-v226','1');
  blocks.forEach((bl,i)=>{
   const h=bl.querySelector(':scope > .v174h');if(!h)return;
   const body=[...bl.children].filter(c=>c!==h);if(!body.length)return;
   bl.classList.add('bsec');
   const open=!!(S.bo||{})[i];
   h.classList.add('bacc');h.setAttribute('role','button');h.setAttribute('tabindex','0');h.setAttribute('aria-expanded',open?'true':'false');
   const txt=h.textContent;h.textContent='';const sp=document.createElement('span');sp.textContent=txt;h.appendChild(sp);
   h.insertAdjacentHTML('beforeend','<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--tt)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>');
   body.forEach(e=>e.classList.toggle('bhid',!open));
   const tg=()=>{const o=h.getAttribute('aria-expanded')!=='true';S.bo=Object.assign({},S.bo,{[i]:o});h.setAttribute('aria-expanded',o?'true':'false');body.forEach(e=>e.classList.toggle('bhid',!o))};
   h.onclick=tg;h.onkeydown=e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();tg()}};
  });
 });
}finally{busy=false}}
new MutationObserver(tidy).observe(document.getElementById('phone'),{childList:true,subtree:true});tidy();
document.title='itunda, clickable prototype v227';
})();
/* v228: Readable colours. Light mode: the grey used for tab labels, small print and hints (#8B95A1) was about 2.9:1 on white, below the 4.5:1 that small text needs, and the green and red used for status text were close to the limit (green 4.1:1). They are darkened a little (grey #69727F about 4.9:1, green #087A4D about 6.8:1). Dark mode: the red (3.1:1) and green (4.3:1) status text on the dark background are lightened (red #FF7B6E, green #35C48B) so \"Failed\", \"Paid\" and similar lines are easy to read. Only colour values change: no layout, copy or behaviour. Buttons and badges keep their fills. */
(function(){
const st=document.createElement('style');st.id='v228css';st.textContent=
':root{--tt:#69727F;--ok:#087A4D}'+
'@media (prefers-color-scheme:dark){:root{--tt:#8F96A2;--ok:#35C48B;--er:#FF7B6E}}'+
':root[data-theme=light]{--tt:#69727F;--ok:#087A4D;--er:#C4281B}'+
':root[data-theme=dark]{--tt:#8F96A2;--ok:#35C48B;--er:#FF7B6E}';
document.head.appendChild(st);
document.title='itunda, clickable prototype v228';
})();
/* v229: Clean-up and redesign pass. Bigger, calmer type and more room, everywhere, with no folding. (1) Type: titles 30 px, section headings 20 px, row titles 17 px, row detail and hints 15 px, buttons 18 px, tab names 13 px, chips 15 px. (2) Space: rows 14 px tall padding, sections 40 px apart, buttons 58 px high, tap targets at least 48 px, list rows divided by a thin line. (3) No folding: the last few screens that still hid content behind arrows (Savings and Pockets detail sections) now show everything open, as headings. (4) Calm: text stays left aligned and long words wrap instead of being cut. No copy, flow or data changes. */
(function(){
const st=document.createElement('style');st.id='v229css';st.textContent=
'.h1{font-size:30px!important;line-height:38px!important;letter-spacing:-.6px}'+
'.sec{padding-top:40px!important}.sech{font-size:20px!important;margin-bottom:12px!important}.sech a{font-size:15px!important}'+
'.row{padding:14px 0!important;gap:16px!important;min-height:64px}'+
'.row .t{font-size:17px!important;line-height:24px}.row .s{font-size:15px!important;line-height:21px!important;margin-top:3px!important}.row .r{font-size:15px!important}'+
'.row+.row{border-top:0}'+
'.gi{font-size:13px!important;gap:10px!important}.g5 .gi{font-size:12px!important}.grid{gap:24px 0!important}'+
'.btn{height:58px!important;font-size:18px!important;border-radius:18px!important}.row2 .btn{height:54px!important;font-size:17px!important}'+
'.cta{padding:14px 24px 28px!important}'+
'.tabs button{font-size:13px!important;gap:5px!important}'+
'.chip,.cch{height:40px!important;font-size:15px!important;padding:0 18px!important}'+
'.chips{gap:10px!important}.ib{width:48px!important;height:48px!important}'+
'.bar b{font-size:20px!important}.pgrid{gap:24px 16px!important}'+
'.mis{font-size:13px!important;padding:16px 8px!important}.mis b{font-size:14px!important}'+
'.fine{font-size:14px!important;line-height:20px!important}'+
'.toast{font-size:15px!important;padding:16px 20px!important}'+
'.sheet{padding:32px 24px 32px!important}'+
'#phone .screen{overflow-wrap:anywhere;line-height:1.4}'+
'#phone details>summary{pointer-events:none;cursor:default;font-size:18px!important;font-weight:800!important}#phone details>summary svg{display:none!important}#phone details>summary::-webkit-details-marker{display:none}';
document.head.appendChild(st);
let busy=false;
function open(){if(busy)return;busy=true;try{document.querySelectorAll('#phone details:not([open])').forEach(d=>d.setAttribute('open',''));document.querySelectorAll('#phone details>summary').forEach(m=>{m.setAttribute('tabindex','-1');m.removeAttribute('aria-expanded')})}finally{busy=false}}
new MutationObserver(open).observe(document.getElementById('phone'),{childList:true,subtree:true});open();
document.title='itunda, clickable prototype v229';
})();
/* v232: Bank screen, the \"Everything you have in itunda\" summary (total, colour bar, itunda Bank / itunda Pay / Pockets amounts) is removed. The balance, the four actions and \"Coming up\" now follow each other with normal spacing. Everything else is as in v231. */
/* v231: Less primary colour, real icons kept. Colour noise here means overusing the purple, not the icons, so the colourful icons and illustrations (they look like real things and help people recognise them) are back as they were in v229. What changes: purple is now kept for the one main button on a screen and for the selected state. Small purple tinted buttons (Send on Home, amount shortcuts) are neutral grey buttons; \"See all\" and section links are bold grey instead of purple; action labels (Scan, Send, Request money, Add) are black. Lines between list rows are gone and arrows are lighter, so space does the separating. Pay > Manage rows show their title and, where there is one, the count or limit (the grey second line repeated the title); all rows remain. Long names in \"Pay or send again\" stay on two lines (never broken mid-word). More air above and below each group. No copy, flow or data changes. */
(function(){
const st=document.createElement('style');st.id='v231css';st.textContent=
'.row+.row{border-top:0!important}.row .r svg{opacity:.45}'+
'.v174{padding-top:12px!important}.v174h{margin-bottom:6px}'+
'.sec{padding-top:44px!important}.row{padding:16px 0!important}'+
'.pman .row .s{display:none!important}.pman .row{min-height:60px;padding:12px 0!important}'+
'.noch .row .s{white-space:nowrap}.noch .row>div:nth-child(2){min-width:0;flex:1 1 auto}'+
'.gi .ico{width:64px!important;height:64px!important;border-radius:24px!important}'+
'.chip[style*="--tint"]{background:var(--chip)!important;color:var(--tx)!important}'+
'.sech a,.sech [onclick]{color:var(--mu)!important;font-weight:700!important}'+
'.pad>div:first-child:not(.row){color:var(--mu)!important}.gi,.gi *{color:var(--tx)!important}';
document.head.appendChild(st);
let busy=false;
function tidy(){if(busy)return;busy=true;try{
 document.querySelectorAll('#phone .screen').forEach(sc=>{
  if(!sc.querySelector('.ppg'))return;
  const all=[...sc.querySelectorAll('.v174')],bl=all.pop();if(bl&&!bl.classList.contains('pman'))bl.classList.add('pman');const ag=all[all.length-2];if(ag&&!ag.getAttribute('data-v230')){ag.setAttribute('data-v230','1');ag.querySelectorAll('*').forEach(e=>{if(!e.children.length&&e.textContent.trim().length>3&&!e.closest('svg')&&!e.closest('.v174h')&&e.textContent.trim()!=='A'){e.style.cssText+=';display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;max-width:96px;font-size:12px;overflow:hidden;overflow-wrap:normal;word-break:normal;text-align:center'}})}});
}finally{busy=false}}
new MutationObserver(tidy).observe(document.getElementById('phone'),{childList:true,subtree:true});tidy();
document.title='itunda, clickable prototype v232';
})();
/* v233: Home, the \"My credit score\" card under Recent activity is removed, so Home ends with Recent activity. The credit score is still in Explore (Credit score) and under Bank. */
(function(){
let busy=false;
function drop(){if(busy)return;busy=true;try{document.querySelectorAll('#phone .screen > .hc').forEach(c=>{if(c.querySelector('[onclick="openScore()"]'))c.remove()})}finally{busy=false}}
new MutationObserver(drop).observe(document.getElementById('phone'),{childList:true,subtree:true});drop();
document.title='itunda, clickable prototype v233';
})();
/* v234: Margin, spacing and type, one system. Side margin 24 px everywhere. Home: more room under the top bar, rows 76 px tall with 16 px between icon and text, balances 24 px, row titles 18 px, helper lines 14 px, buttons 44 px high with 15 px text; card headings (Pockets, Recent activity) 20 px with grey \"See all\"; pocket names 14 px grey above the amount (were 13 px); the Bills / Card / Savings line is 16 px with space above it; every card has 16 px above and below. You: group headings (Partner earnings, My favorites ...) are 20 px black headings with 40 px above instead of small grey labels; rows are 60 px tall. No copy, flow or data changes. */
(function(){
const st=document.createElement('style');st.id='v234css';st.textContent=
'.top{padding:24px 24px 8px!important}'+
'.hc{padding:16px 0!important}'+
'.hc .hr{padding:16px 24px!important;gap:12px!important;min-height:76px}'+
'.hc .ha{font-size:24px!important;line-height:32px!important;white-space:nowrap}.hc .ha .cu{font-size:14px!important}.hc .hi{flex:none}.hc .hm{min-width:0;flex:1 1 auto}.hc .ha2{font-size:18px!important;line-height:26px!important}'+
'.hc .hm .sm{font-size:14px!important;line-height:21px!important}'+
'.hc .pkpn{font-size:14px!important;font-weight:600!important;color:var(--mu)!important;margin-bottom:2px}'+
'.hc .hp{height:44px!important;min-width:60px;padding:0 14px!important;white-space:nowrap;flex:none;font-size:15px!important;border-radius:22px!important}'+
'.hct{padding:12px 24px 4px!important;font-size:20px!important;font-weight:800!important}.hct a{font-size:15px!important;color:var(--mu)!important;font-weight:700!important}'+
'.hc .hf{padding:16px 24px 8px 14px!important;font-size:16px!important}.hc .hf button{font-size:16px!important;font-weight:700!important}'+
'.agt{font-size:20px!important;font-weight:800!important;color:var(--tx)!important;margin-top:40px!important;padding-bottom:4px}'+
'.ar{min-height:60px;padding-top:12px!important;padding-bottom:12px!important}'+
'.ar .t{font-size:17px!important}.ar .s{font-size:15px!important}';
document.head.appendChild(st);
document.title='itunda, clickable prototype v234';
})();
/* v237: Shop sort, in the app's own style. v236 used the phone's plain drop-down list, which does not match the rest of itunda. Tapping \"Recommended ▾\" now opens the same bottom sheet used elsewhere in the app: a \"Sort\" heading and four large rows (Recommended, Price: low to high, Price: high to low, Biggest deals), a tick on the current one, and one tap picks and closes. Same words as before. */
/* v236: Shop, one kind of control instead of six look-alike chips. The page had four sort chips, \"Saved\" and \"My orders\" (all the same pill) followed by the category chips. Now: one line with the sort as a plain bold choice (\"Recommended\" with a small arrow; tap to pick Price low to high, Price high to low or Biggest deals), and two icon buttons on the right, a heart for Saved (with the count, red when on) and a box for My orders (with the count). The only pills left are the categories (All, Food, Fashion, Electronics, Home), so they read as one set. English, French and Kinyarwanda use the words that were already there. */
/* v235: Pay colour fix and Bank/Explore spacing. (1) Fix: since v231 the Pay balance (120,500 RWF) and \"My payment code\" were shown in grey by mistake; they are black again. (2) Pay: the top balance block has more room under the title, the four actions (Scan, Send, Request money, Add) are black 14 px labels and the small \"itunda Pay Money\" label is grey, so the page has one accent colour. (3) Bank: amount and arrow on the right stay on one line, so \"Ikimina · Umurenge Savers\" gets the width left over; action labels (Send, Move, Deposit, Statement) have side room. (4) Explore: the header (name, Support, Settings, search, four shortcuts) has 24 px side margins and more air between the parts. No copy, flow or data changes. */
(function(){
const st=document.createElement('style');st.id='v235css';st.textContent=
'.pad>div:first-child:not(.row),.pad>.row *{color:inherit!important}'+
'.ppa{color:var(--tx)!important;font-size:14px!important}.pad .sm[style*="--tintfg"]{color:var(--mu)!important}'+
'.pad>div:first-child:not(.row) .mu,.pad>div:first-child:not(.row) .s{color:var(--mu)!important}'+
'.g4 .gi{font-size:13px!important;padding:0 2px}.g4{padding-left:12px;padding-right:12px}'+
'.row .r{white-space:nowrap;flex:none;font-size:14px!important}'+
'.row>div:nth-child(2){min-width:0;flex:1 1 auto}';
document.head.appendChild(st);
document.title='itunda, clickable prototype v237';
})();
/* v238: Whole-app scan. All 123 screens were opened and checked by a script for text that is too small, text that is cut off and controls that are hard to hit. Result: tap areas were already 44 px (v-earlier hit areas), nothing runs off the edge except rows that are meant to scroll sideways (chip rows), but about 40 pieces of text were 11 or 12 px: chat times, \"Send / Move / Deposit / Statement\" under the Bank buttons, names under Pay\u2019s recent people, \"13.9K using\" in Mini apps, \"1 km\" on the map, the \"?\" help marks. Everything under 13 px (except tiny badges and the tab bar) is now 13 px, on every screen, including ones added later. No copy, flow or data changes. */
(function(){
const st=document.createElement('style');st.id='v238css';st.textContent='.g4{padding-left:0!important;padding-right:0!important}.g4 .gi{white-space:nowrap;font-weight:600!important}.bka{padding-left:12px!important;padding-right:12px!important}.bka button{white-space:nowrap;font-weight:600!important;letter-spacing:-.2px;padding-left:0!important;padding-right:0!important}';document.head.appendChild(st);
let t=0;
const DONE=new WeakSet();
function floor(){t=0;const c=[],root=document.querySelector('#phone .screen');if(!root)return;
 /* walk text nodes only (far fewer than all elements), read styles first, write after */
 document.querySelectorAll('#phone .screen').forEach(sc=>{const tw=document.createTreeWalker(sc,NodeFilter.SHOW_TEXT);let n;
  while(n=tw.nextNode()){const e=n.parentElement;if(!e||DONE.has(e))continue;DONE.add(e);if(!n.nodeValue.trim()||e.closest('svg,.tabs,input,select'))continue;
   const f=parseFloat(getComputedStyle(e).fontSize);if(f&&f<13)c.push(e)}});
 c.filter(e=>{const r=e.getBoundingClientRect();return!(r.width<22&&r.height<22&&/^\d{1,2}$/.test(e.textContent.trim()))}).forEach(e=>{e.style.fontSize='13px'})}
new MutationObserver(()=>{if(!t)t=requestAnimationFrame(floor)}).observe(document.getElementById('phone'),{childList:true,subtree:true});floor();
document.title='itunda, clickable prototype v238';
})();
/* v239: Second scan, fixes. (1) Send > amount: the four shortcuts (+5,000, +10,000, +50,000, Max) sit on one line instead of leaving \"Max\" alone on a second line. (2) Settings: the group headings inside the grey cards (Authentication & Security, Transfer & Payment) no longer have a big empty gap above them. (3) Bank, Coming up: row titles are 16 px with a little less gap (the Ikimina row still needs three lines; a shorter label would fix it). No copy, flow or data changes. */
(function(){
const st=document.createElement('style');st.id='v239css';st.textContent=
'.chip[onclick^="key("]{padding:0 12px!important;font-size:15px!important;white-space:nowrap;flex:none!important}'+
'*:has(>.chip[onclick^="key("]){flex-wrap:nowrap!important;gap:8px!important;justify-content:center}'+
'.agt:first-child{margin-top:12px!important}'+
'.v174 .row{gap:12px!important}.v174 .row .t{font-size:16px!important}';
document.head.appendChild(st);
document.title='itunda, clickable prototype v239';
})();
/* v240: Third scan. (1) Messages: \"All / Unread · 1 / Archived\" are plain text tabs with an underline on the current one (like Shop / Eats and Portfolio / Market), not pills; the \"...\" on each conversation is lighter so the list reads as names and messages first. (2) One purple button per screen: where a screen showed a purple tinted button next to the main button (Invest: \"Treasury bills\" beside \"Browse stocks\"; Mini apps: \"See deals\"), the tinted one is now a neutral grey button. No copy, flow or data changes. */
(function(){
const st=document.createElement('style');st.id='v240css';st.textContent=
'.mm-chips.mtabs{gap:24px!important}.mtabs .cch{background:none!important;border-radius:0!important;padding:0 2px!important;height:44px!important;font-size:17px!important;font-weight:700!important;color:var(--tt)!important;white-space:nowrap;flex:none}'+
'.mtabs .cch.on{color:var(--tx)!important}.mtabs .cch.on::after{top:auto!important;bottom:2px!important;left:0!important;right:0!important;width:auto!important;height:3px!important;border-radius:2px}'+
'.mm-more{opacity:.4}'+
'.btn.sec2,button[style*="background:var(--tint)"]:not(.cch):not(.on){background:var(--chip)!important;color:var(--tx)!important}';
document.head.appendChild(st);
let f=0;function tabs(){f=0;document.querySelectorAll('#phone .screen').forEach(sc=>{if(sc.querySelector('.mm-more')){const c=sc.querySelector('.mm-chips');if(c)c.classList.add('mtabs')}})}
new MutationObserver(()=>{if(!f)f=requestAnimationFrame(tabs)}).observe(document.getElementById('phone'),{childList:true,subtree:true});tabs();
document.title='itunda, clickable prototype v245';
})();
/* v246: Transit. The page was four stacked blocks with three full-width buttons. Now: balance first (with how many rides it covers), Operator and Fare as two plain rows that open a picker, ride history, and ONE button pinned at the bottom: "Tap 300 RWF", which turns into "Top up to ride" when the balance is too low (it used to be a greyed-out button). Top up opens a sheet (amounts, source balance, one button). Fare notes are folded under "About fares". rw/fr copy for the new lines needs native review. */
(function(){
const T=(e,r,f)=>({en:e,rw:r,fr:f}[S.lang]||e);
const BTN='height:52px;font-size:16px;border-radius:16px';
const row=(lab,val,go)=>`<button class="pkrow" style="width:100%;border:0;background:none;text-align:left" onclick="${go}"><div style="flex:1;min-width:0"><div class="sm mu">${lab}</div><div style="font-size:17px;font-weight:700;margin-top:2px">${val}</div></div><span class="pkch">${ic('chev',16,'var(--tt)')}</span></button>`;
const sheet=(title,body)=>{$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" role="dialog" aria-modal="true" aria-label="${title}"><div class="h1" style="font-size:22px;line-height:30px;margin-bottom:8px">${title}</div>${body}</div>`};
screens.transit=()=>{
 const low=S.tb<S.fare,n=Math.floor(S.tb/S.fare),rides=S.rides.slice(0,10);
 const sub=low
  ?`<div class="sm" style="margin-top:8px;color:var(--er);font-weight:700">${T('Not enough for a '+S.fare+' RWF ride','Ntihagije urugendo rwa '+S.fare+' RWF','Insuffisant pour un trajet de '+S.fare+' RWF')}</div>`
  :`<div class="sm mu" style="margin-top:8px">${T('About '+n+' ride'+(n>1?'s':'')+' at '+S.fare+' RWF','Ingendo ~'+n+' kuri '+S.fare+' RWF','Environ '+n+' trajet'+(n>1?'s':'')+' à '+S.fare+' RWF')}</div>`;
 return `${bar(t('tr_title'))}<div class="pad" style="padding-top:16px;display:flex;align-items:center;gap:16px"><div style="flex:1;min-width:0"><div class="sm mu">${t('tr_bal')}</div><div class="big" style="margin-top:4px">${fmt(S.tb)} RWF</div>${sub}</div><div>${gl('transit',64)}</div></div>
<div class="pad" style="padding-top:14px"><button class="btn sec2" style="width:auto;height:44px;padding:0 20px;font-size:15px;border-radius:14px" onclick="trTop()">${t('tr_top')}</button></div>
<div class="bdband"></div>
<div style="padding-top:8px">${row(T('Operator','Uwukwiyemera','Opérateur'),S.op,"trPick('op')")}${row(T('Fare','Amafaranga y’urugendo','Tarif'),S.fare+' RWF',"trPick('fare')")}</div>
<div class="bdband" style="margin-top:8px"></div>
<div class="pad" style="padding-top:20px;font-size:18px;font-weight:800">${t('tr_hist')}</div>
${rides.length?rides.map(r=>`<div class="ar" style="cursor:default"><div class="g">${gl('busstop',30)}</div><div style="flex:1"><div class="t" style="font-size:15px">${r[0]}</div></div><b>−${r[1]} RWF</b></div>`).join(''):`<div class="pad mu" style="font-size:15px;line-height:22px;padding-top:6px">${t('tr_none')}</div>`}
<details style="margin:0 24px"><summary style="padding:22px 0 10px;font-weight:700;font-size:15px;color:var(--tt);cursor:pointer">${T('About fares','Ibyerekeye ibiciro','À propos des tarifs')}</summary><div class="fine" style="line-height:17px;padding-bottom:12px">${t('tr_tapd')}<br><br>${t('tr_disc').replace(/&/g,'&amp;')}</div></details>
<div class="cta"><button class="btn" style="${BTN}" onclick="${low?'trTop()':'transitTap()'}">${low?T('Top up to ride','Ongeramo amafaranga','Recharger pour voyager'):t('tr_tap').replace('%s',S.fare)}</button></div>`};
window.trTop=()=>{
 const bad=S.topAmt>S.pay;
 sheet(t('tr_top'),`<div class="sm mu">${T('From itunda Pay · ','Kuri itunda Pay · ','Depuis itunda Pay · ')}${fmt(S.pay)} RWF</div><div class="req" style="margin-top:16px">${[1000,2000,5000,10000].map(a=>`<button class="${S.topAmt===a?'on':''}" onclick="trAmt(${a})">${fmt(a)}</button>`).join('')}</div>${bad?`<div style="color:var(--er);font-size:14px;margin-top:12px">${t('insuff').replace('%s',fmt(S.pay))}</div>`:''}<button class="btn" style="${BTN};margin-top:20px" ${bad?'disabled':''} onclick="trTopGo()">${t('tr_top')} ${fmt(S.topAmt)} RWF</button>`)};
window.trAmt=a=>{S.topAmt=a;trTop()};
window.trTopGo=()=>{if(S.topAmt>S.pay)return;closeSheet();transitTop()};
window.trPick=k=>{
 const opts=k==='op'?['Kigali Bus Services','Royal Express'].map(o=>[o,o]):[200,300,400,500].map(f=>[f,f+' RWF']);
 const cur=k==='op'?S.op:S.fare,set=k==='op'?"S.op='%v'":"S.fare=%v";
 sheet(k==='op'?T('Operator','Uwukwiyemera','Opérateur'):T('Fare','Amafaranga y’urugendo','Tarif'),opts.map(([v,l])=>`<button class="pkopt ${cur===v?'on':''}" onclick="${set.replace('%v',v)};closeSheet();render('fade-none')">${l}${cur===v?CK48:''}</button>`).join(''))};
document.title=document.title.replace('v245','v246');
})();
/* v247: Whole-app UI/UX pass (from rendering all 123 screens in a browser). (1) Pages that only had one "+ New …" button at the TOP of an otherwise empty page (price alerts, auto-invest, payees, scheduled transfers, report a problem, saved places, upcoming bills) now keep that button pinned at the bottom, like Bank and Invest. (2) Hard lines are gone: dividers between rows in receipts, totals and cards are invisible (spacing does the work), community posts are separated by a soft grey band, and the home account block and menu rows have no rules. (3) Messages: the black underline under "All / Unread / Archived" sat 14px left of the word (a leftover half-width shift); it now sits exactly under it. (4) Directions: the long "Avoid stairs when traveling with a stroller or wheelchair" banner is one short line, with less padding, so the map gets more room. No flow or data changes. */
(function(){
const st=document.createElement('style');st.id='v247css';st.textContent=
'.mtabs .cch{position:relative!important}.mtabs .cch.on::after{transform:none!important}'+
'div[style*="border-top:0"]:not(.cta):not(.sheet),div[style*="border-bottom:0"]:not(.cta):not(.sheet){border-top-color:transparent!important;border-bottom-color:transparent!important}'+
'.post{border-bottom:8px solid color-mix(in srgb,var(--tx) 2.5%,var(--bg))!important}'+
'.mi,.hc{border-top-color:transparent!important;border-bottom-color:transparent!important}'+
'.fi{border-color:color-mix(in srgb,var(--tx) 5%,transparent)!important}'+
'[onclick="mpNs()"]{padding:8px 14px!important;margin-top:6px!important;min-height:0!important}';
document.head.appendChild(st);
['invAl','invAp','bkpay','bksch','bkcase','mpsaved','bills96'].forEach(n=>{const f=screens[n];if(!f)return;
 screens[n]=()=>{const h=f();if(h.indexOf('class="cta"')>=0)return h;
  const d=document.createElement('div');d.innerHTML=h;
  const b=[...d.querySelectorAll('button.btn')].find(x=>!x.closest('.sheet')&&!x.disabled||false)||[...d.querySelectorAll('button.btn')][0];
  if(!b)return h;
  const par=b.parentElement;b.remove();
  if(par&&par!==d&&!par.children.length&&!par.textContent.trim())par.remove();
  b.style.cssText+=';height:52px;font-size:16px;border-radius:16px;margin:0;width:100%';
  const c=document.createElement('div');c.className='cta';c.appendChild(b);d.appendChild(c);return d.innerHTML}});
{const _r=screens.route;screens.route=()=>_r()
 .replace('Avoid stairs when traveling with a stroller or wheelchair','Avoid stairs')
 .replace('Irinde ingazi ufite akagare k’umwana cyangwa intebe y’abafite ubumuga','Irinde ingazi')
 .replace('Éviter les escaliers (poussette ou fauteuil roulant)','Éviter les escaliers')}
document.title=document.title.replace('v246','v247');
})();
</script>
<script>
/* v248: UI/UX audit pass. Checked all 123 screens in English, French and Kinyarwanda at 390 and 360 px, light and dark, plus 156 taps across the seven main tabs (no script errors, no dead taps). Fixes: (1) Home: the two Recent activity rows were flush to the screen edge while every other Home row sits on the 24 px grid; they now align. (2) Rows with a value on the right (Bank "Coming up", Ikimina, loans and others) no longer squeeze the name into three lines; the value stays on one line and the name wraps to at most two. (3) Settings, Devices, Text size and Pay settings drop the grey rounded cards for flat groups separated by space, matching Bank details; no extra lines or bands were added. (4) Disabled main buttons (Next, Send, Create goal) were a washed-out 35% tint with unreadable text; they now keep a plain grey fill with readable text. (5) The delete key on every number pad had no accessible name; it now reads "Delete" (Siba, Supprimer). (6) Maps contrast: route timeline labels pick white or dark text per bar colour, the green \"Open\" label is darker, and in dark mode text on lavender buttons turns dark (it was 2.9:1) and the red and green route status text is lighter. (7) Pockets: the progress bar was a fixed 140 px, now fills the row. Not changed: Settings still lists Notifications twice (a row and a section), left for a product decision. */
(function(){
const st=document.createElement('style');st.id='v248css';st.textContent=
/* 1 Home alignment */
'#sc .hc>.row{padding-left:24px!important;padding-right:24px!important}'+
/* 2 rows with a right-hand value */
'.row .r{white-space:nowrap;flex-shrink:0}.row>div:nth-child(2){min-width:0}'+
'.row>div:nth-child(2) .t{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}'+
/* 3 flat settings groups */
'.stc{margin:0;background:none;border-radius:0;padding:4px 0 0}'+
'.stc .agt{padding:32px 24px 4px}.stc:first-of-type .agt{padding-top:24px}'+
/* 4 disabled buttons */
'.btn:disabled{opacity:1;background:var(--chip);color:var(--mu);cursor:not-allowed}'+
/* 6 "Open" status green */
'[style*="#2BA84A" i]{color:#067A4C!important}'+
'@media (prefers-color-scheme:dark){:root:not([data-theme=light]) [style*="#2BA84A" i]{color:#3DD17A!important}}'+
':root[data-theme=dark] [style*="#2BA84A" i]{color:#3DD17A!important}'+
/* 7 pockets bar */
'.pkrow>div:nth-child(2){flex:1}.pkrow .pkbar{width:100%!important;max-width:none}';
document.head.appendChild(st);
/* 5 keypad delete key name */
const L={rw:'Siba',fr:'Supprimer'};
const lum=c=>{const a=c.match(/[\d.]+/g).map(Number);const f=x=>{x/=255;return x<=.03928?x/12.92:Math.pow((x+.055)/1.055,2.4)};return .2126*f(a[0])+.7152*f(a[1])+.0722*f(a[2])};
const isDark=()=>{const t=document.documentElement.dataset.theme;return t==='dark'||(t!=='light'&&matchMedia('(prefers-color-scheme: dark)').matches)};
const DK={'rgb(217, 45, 32)':'#FF7A6E','rgb(59, 125, 32)':'#7FD45A'};
function dark(v){if(!isDark())return;
 v.querySelectorAll('*').forEach(e=>{const cs=getComputedStyle(e);
  if(cs.backgroundColor==='rgb(143, 137, 255)'){e.style.color='#17171C';e.querySelectorAll('*').forEach(c=>{if(getComputedStyle(c).color==='rgb(255, 255, 255)')c.style.color='#17171C'})}
  else if(DK[cs.color]&&[...e.childNodes].some(n=>n.nodeType==3&&n.textContent.trim()))e.style.color=DK[cs.color]})}
const cr=(a,b)=>(Math.max(a,b)+.05)/(Math.min(a,b)+.05);
function lab(){const v=document.getElementById('view');if(!v)return;dark(v);
 v.querySelectorAll('.seg>div[style*="background"]').forEach(d=>{const bg=getComputedStyle(d).backgroundColor;if(!/^rgb/.test(bg)||!d.textContent.trim())return;const l=lum(bg),want=cr(l,1)>=cr(l,lum('rgb(18,18,22)'))?'#fff':'#17171C';if(d.style.color!==want)d.style.color=want});
 v.querySelectorAll('.keys button:not([aria-label])').forEach(b=>{if(!b.textContent.trim())b.setAttribute('aria-label',L[S.lang]||'Delete')})}
const v=document.getElementById('view');if(v){new MutationObserver(lab).observe(v,{childList:true,subtree:true});lab()}
document.title=document.title.replace(/v\d+/,'v248');
})();
</script>
<script>
/* v249: Follow-up to v248. (1) Rows with an amount on the right hide their small arrow (the whole row is still tappable) and give the name all the leftover width, so "Ikimina · Umurenge Savers" wraps in two lines instead of being cut off. (2) The green Open / live badge (.lv) goes from 3.1:1 to 5.4:1 on white in light mode; dark mode keeps the bright green. */
(function(){
const st=document.createElement('style');st.id='v249css';st.textContent=
'.row>div:nth-child(2){flex:1}.row>div:nth-child(2) .t{-webkit-line-clamp:2}'+
'.lv{color:#067A4C!important;border-color:#067A4C!important}'+
'@media (prefers-color-scheme:dark){:root:not([data-theme=light]) .lv{color:#3DD17A!important;border-color:#3DD17A!important}}'+
':root[data-theme=dark] .lv{color:#3DD17A!important;border-color:#3DD17A!important}';
document.head.appendChild(st);
function fixr(){document.querySelectorAll('#view .row>.r').forEach(r=>{if(r.textContent.trim()&&r.querySelector('svg')&&!r.dataset.f){r.dataset.f=1;r.querySelector('svg').style.display='none'}})}
const v=document.getElementById('view');if(v){new MutationObserver(fixr).observe(v,{childList:true,subtree:true});fixr()}
document.title=document.title.replace(/v\d+/,'v249');
})();
</script>
<script>
/* v250: Receipt and detail summaries go flat. The grey rounded boxes on Sent, Bill paid, Order placed, Sacco and the bank transfer details lose their fill and corners and keep a single thin line above, so they read as part of the page like Bank details. Input boxes (amount, FX, points, limits) and highlighted callouts keep their boxes. */
(function(){
const st=document.createElement('style');st.id='v250css';st.textContent=
'[style*="border-radius:20px"][style*="background:var(--chip)"][style*="padding:4px 20px"],[style*="border-radius:20px"][style*="background:var(--chip)"][style*="padding:2px 18px"]{background:none!important;border-radius:0!important;padding-left:0!important;padding-right:0!important;border-top:0}';
document.head.appendChild(st);
document.title=document.title.replace(/v\d+/,'v250');
})();
</script>
<script>
/* v251: The REG electricity bill listed on Home ("Due Fri, 23 Oct · 18,500 RWF") opened Pay bills with an empty meter field, so the person had to type 11 digits for a bill the app already knew. The prototype already remembers a meter per provider after the first payment, so a sample REG meter is now saved from the start. Tapping Pay on Home lands on a ready-to-continue form, and Bill paid shows the meter number. Other providers still start empty. */
(function(){
try{S.sm=Object.assign({'REG electricity':'48210937661'},S.sm||{})}catch(e){}
document.title=document.title.replace(/v\d+/,'v251');
})();
</script>
<script>
/* v252: Home shortcut strip (Bills, Card, Savings, All). It is a row of links, not tabs, so it needs no selected state; the extra empty space under it is trimmed so "Spent this period" sits closer, and the line above it is kept. */
(function(){
const st=document.createElement('style');st.id='v252css';st.textContent='.hc .hf{padding-bottom:0!important;padding-top:12px!important}.hf+.hc,.hc:has(.hf)+.hc{margin-top:0}';
document.head.appendChild(st);
document.title=document.title.replace(/v\d+/,'v252');
})();
</script>
<script>
/* v253: Eats list. (1) The "Yes" button in the delivery address banner was squeezed to a clipped "Y"; it now keeps its full width. (2) Category names such as "Brochette" broke mid-word ("Brochet/te"); the category buttons now widen to fit their name and the row scrolls sideways as before. Found by walking the real order flow: restaurant, add item and cart work, and the cart's order button stays off below the 2,000 RWF minimum as designed. */
(function(){
const st=document.createElement('style');st.id='v253css';st.textContent='.bub button{white-space:nowrap;flex-shrink:0;min-width:56px;padding-left:16px;padding-right:16px}.bub span{min-width:0}.ecat{white-space:nowrap;width:auto!important;min-width:72px;padding-left:6px;padding-right:6px;word-break:keep-all}';
document.head.appendChild(st);
document.title=document.title.replace(/v\d+/,'v253');
})();
</script>
<script>
/* v254: fixes found by auditing the whole prototype in a real browser (flows, dark mode, fr/rw, keyboard).
   1 dark mode: dark-brown icon strokes (bank, Eats, Marketplace, Jobs) were 1.75:1 on dark chips
   2 text under 12px (discount badges, chat times, route times) raised to 12px
   3 names on home / bank rows no longer cut with an ellipsis, they wrap to two lines
   4 "+ Add" on Send looked tappable but did nothing: it now takes you to the number field
   5 send confirmation shows the recipient's number under the name, so a wrong contact is easy to spot */
(function(){
const css=`
:root[data-theme=dark] #phone svg [fill="#664500"]{fill:#F2C879}
:root[data-theme=dark] #phone svg [stroke="#664500"]{stroke:#F2C879}
@media (prefers-color-scheme:dark){
 :root:not([data-theme=light]) #phone svg [fill="#664500"]{fill:#F2C879}
 :root:not([data-theme=light]) #phone svg [stroke="#664500"]{stroke:#F2C879}
}
.dbadge,.ti .tm,#phone .mm-t{font-size:12px}
#phone .row .t{white-space:normal;overflow-wrap:anywhere;-webkit-line-clamp:unset;overflow:visible;max-height:none}
#phone .hc .row .t{overflow:hidden;text-overflow:clip;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical}
#phone .sech a[role=button]{min-height:44px;display:inline-flex;align-items:center;margin:-12px 0;cursor:pointer}
@keyframes cf{from{transform:translate(0,0) rotate(0);opacity:1}45%{opacity:1}to{transform:translate(var(--x),calc(var(--y)*.3)) rotate(var(--r));opacity:0}}
#phone .v254who{font-size:13px;font-weight:600;color:var(--tt);margin-top:2px;font-variant-numeric:tabular-nums}
`;
const st=document.createElement('style');st.id='v254css';st.textContent=css;document.head.appendChild(st);
const ph=document.getElementById('phone'),ly=document.getElementById('layer');
const lang=(en,rw,fr)=>{try{return S.lang==='rw'?rw:S.lang==='fr'?fr:en}catch(e){return en}};
function addPick(){
 const f=document.getElementById('rcv');
 if(f){f.focus();try{f.scrollIntoView({block:'center'})}catch(e){}}
 try{toast(lang('Type their number, then tap Next.','Andika nimero yabo, hanyuma ukande Komeza.','Saisissez son numéro, puis touchez Suivant.'))}catch(e){}
}
function fix(){
 const cta=ph.querySelector('.cta');
 if(cta&&!cta.querySelector('.v254act')&&S.auth&&['sent','paydone','billdone'].includes(S.stack[S.stack.length-1])){
  const b=document.createElement('button');b.className='v254act';b.type='button';
  b.textContent=lang('View in activity','Reba mu mateka','Voir dans l’activité');
  b.style.cssText='display:block;width:100%;height:44px;margin-top:8px;border:0;background:none;font-weight:700;font-size:15px;color:var(--lk)';
  b.onclick=()=>{S.stack.push('activity');render('push')};
  cta.appendChild(b);
 }
 ph.querySelectorAll('.cch:not([aria-pressed]),.ecat:not([aria-pressed]),.req button:not([aria-pressed])').forEach(e=>{const g=e.parentElement;if(g&&[...g.children].some(c=>c!==e&&c.classList.contains('on'))||e.classList.contains('on'))e.setAttribute('aria-pressed',e.classList.contains('on')?'true':'false')});
 ph.querySelectorAll('.sech a:not([onclick]):not([role])').forEach(a=>{
  if(!(S.auth&&S.stack[S.stack.length-1]==='recipient'))return;
  a.setAttribute('role','button');a.tabIndex=0;a.setAttribute('aria-label',lang('Add a number','Ongeraho nimero','Ajouter un numéro'));
  a.addEventListener('click',addPick);
  a.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();addPick()}});
 });
 ly.querySelectorAll('.sheet[aria-label="Confirm"]:not([data-v254])').forEach(sh=>{
  sh.dataset.v254='1';
  try{
   const num=String(S.to||'').trim(),name=nm9(S.to);
   if(!/\d{6,}/.test(num.replace(/\s/g,''))||String(name).trim()===num)return;
   const el=[...sh.querySelectorAll('.mu')].find(e=>e.textContent.includes(name));
   if(el&&!el.querySelector('.v254who')){const d=document.createElement('div');d.className='v254who';d.textContent=num;el.appendChild(d)}
  }catch(e){}
 });
}
let q=0;const sched=()=>{if(q)return;q=requestAnimationFrame(()=>{q=0;fix()})};
new MutationObserver(sched).observe(ph,{childList:true,subtree:true});
new MutationObserver(sched).observe(ly,{childList:true,subtree:true});
fix();
document.title=document.title.replace(/v\d+/,'v254');
})();
</script>
<script>
/* v255: Whole-prototype UI/UX audit (123 screens, light and dark, 390 px). Found and fixed: (1) 14 screens lost their 24 px side margin, so text, amounts and switches touched the screen edge (Notifications, Passkeys, Transfer settings, Subscriptions, Devices, Rides, Points, Coupons, Daily challenge, Card cashback, Partner links, Connect friends, Purchase history, Auto-transfer). Cause: the v229/v231 rule .row{padding:Npx 0!important} cancelled the inline 24 px side padding that these rows rely on. (2) On the same screens the on/off switches were stretched into wide pills by the .row>div:nth-child(2){flex:1} rule; they are 48x28 again. (3) Theme: unselected options showed a faint check mark that looked like a selected state; only the chosen option shows a check now. (4) Amount chips in four-column grids (New auto-transfer) broke numbers across two lines (1,00 / 0); they stay on one line. */
(function(){
const st=document.createElement('style');st.id='v255css';st.textContent=
'.row[style*="px 24px"]{padding-left:24px!important;padding-right:24px!important}'+
'.row>.sw{flex:0 0 48px!important;width:48px!important;min-width:48px!important}'+
'.ar svg[stroke="var(--ln)"]{visibility:hidden}'+
'[style*="repeat(4,1fr)"]>.chip{padding:0 6px!important;justify-content:center;white-space:nowrap;min-width:0}';
document.head.appendChild(st);
document.title=document.title.replace(/v\d+/,'v255');
})();
</script>
<script>
/* v256: Second audit pass on v255. (1) Product: the "Buy now · 6,500" button broke onto two lines; the two bottom buttons now keep their labels on one line (Add to cart 40 %, Buy now 60 %). (2) Empty screens: Scheduled transfers and Report a problem showed only a loose sentence. They now follow the same empty-state layout as My orders and Saved places: a short heading saying what is empty, one line of explanation, and the action stays in the bottom bar. */
(function(){
const st=document.createElement('style');st.id='v256css';st.textContent=
'.cta[style*="display:flex"]>.btn{white-space:nowrap;min-width:0;padding-left:10px;padding-right:10px}'+
'.cta[style*="display:flex"]>.btn:first-child:not(:last-child){flex:2 1 0!important}'+
'.cta[style*="display:flex"]>.btn:last-child:not(:first-child){flex:3 1 0!important}'+
'.es256{text-align:center;padding:72px 16px 0}.es256 b{display:block;font-size:18px;font-weight:800}.es256 div{margin-top:8px;font-size:15px;line-height:22px}';
document.head.appendChild(st);
const EMPTY={bksch:'No scheduled transfers yet',bkcase:'No open cases'};
const _r=render;
render=function(){const o=_r.apply(this,arguments);try{
 const k=S.stack&&S.stack[S.stack.length-1];const h=EMPTY[k];
 if(h){const d=document.querySelector('#phone .screen .pad>.mu:not([data-es])');
  if(d&&!d.closest('.es256')){const t=d.textContent.trim();d.parentElement.innerHTML='<div class="es256"><b>'+h+'</b><div class="mu" data-es="1">'+t+'</div></div>'}}
}catch(e){}return o};
document.title=document.title.replace(/v\d+/,'v256');
})();
</script>
<script>
/* v257: Third audit pass (123 screens x light/dark at 390 px, plus 360 px for small Android phones, plus keyboard and screen-reader checks). Found and fixed: (1) At 360 px the Bank header (Back, Card, Statement, Manage) was 11 px wider than the screen, so Manage touched the screen edge; the header buttons now tighten below 380 px and always fit. (2) The bottom bar had no navigation role, no marker for the current tab, and the Messages tab was announced as "1Messages"; it is now a labelled navigation, the open tab is marked, and Messages reads "Messages, 1 unread". (3) Added a higher-contrast mode for people who ask their phone for it: secondary text and dividers get darker. */
(function(){
const st=document.createElement('style');st.id='v257css';st.textContent=
'@media (max-width:380px){#phone .bdt{padding-left:8px;padding-right:8px}#phone .bdt .bb{padding:0 4px;gap:3px;font-size:14px}}'+
'@media (prefers-contrast:more){:root:not([data-theme=dark]){--mu:#4E5968;--tt:#6B7684;--ln:#B0B8C1}}'+
'@media (prefers-contrast:more) and (prefers-color-scheme:dark){:root:not([data-theme=light]){--mu:#C3C9D2;--tt:#AEB5C0;--ln:#4E5968}}'+
':root[data-theme=dark]{--lnx:1}';
document.head.appendChild(st);
const ph=document.getElementById('phone');
function nav(){
 const t=ph.querySelector('.tabs');if(!t)return;
 if(t.getAttribute('role')!=='navigation'){t.setAttribute('role','navigation');t.setAttribute('aria-label','Main')}
 t.querySelectorAll('button').forEach(b=>{
  if(b.classList.contains('on'))b.setAttribute('aria-current','page');else b.removeAttribute('aria-current');
  const badge=[...b.querySelectorAll('*')].find(e=>!e.children.length&&/^\d+\+?$/.test(e.textContent.trim()));
  if(badge){
   const n=badge.textContent.trim();
   const name=b.textContent.replace(n,'').trim();
   const want=name+', '+n+' unread';
   if(b.getAttribute('aria-label')!==want)b.setAttribute('aria-label',want);
  }
 });
}
let q=0;const sched=()=>{if(q)return;q=requestAnimationFrame(()=>{q=0;nav()})};
new MutationObserver(sched).observe(ph,{childList:true,subtree:true,attributes:true,attributeFilter:['class']});
nav();
document.title=document.title.replace(/v\d+/,'v257');
})();
</script>
<script>
/* v258: Fourth pass, a click-through of the whole app (about 900 real taps at 390 and 360 px, light and dark) after v257. Found and fixed: Cash at an agent (Pay and You tabs) threw "agDraw is not defined" when you changed Withdraw/Deposit or the amount, because the screen's buttons call a function that was hidden inside its own block; it is now reachable, so those buttons work. Also checked and found clean: 467 extra taps across all 123 screens (no errors), every small button already has a 44 px touch area, and one overflow flagged on Messages was only the slide-in animation, not a layout fault. */
document.title=document.title.replace(/v\d+/,'v258');
</script>
<script>
/* v259: Language pass. Switching to Français or Kinyarwanda left about 100 phrases in English across Score, Notifications, Invest, Pockets, Eats, Cards and Subscriptions. This adds the missing French and Kinyarwanda for the ones that are real app text (menu, settings, score, savings, notifications); place names, sample people and business names stay as they are. The Kinyarwanda lines are my first draft and should be read by a native speaker before release. */
(function(){
const D={"Debit card for your itunda Bank account": ["Carte de débit liée à votre compte itunda Bank", "Ikarita ya debit ihujwe na konti yawe ya itunda Bank"], "Order placed": ["Commande passée", "Itumiza ryakozwe"], "Prototype: fill a returning number": ["Prototype : remplir un numéro connu", "Prototype: shyiramo nimero yamenyekanye"], "Skip (prototype)": [null, "Simbuka (prototype)"], "Prototype: no real account was created.": [null, "Prototype: nta konti nyayo yafunguwe."], "Menu and prices are sample data.": [null, "Menu n'ibiciro ni ibyitegererezo."], "Paid with itunda Pay": [null, "Byishyuwe na itunda Pay"], "Your delivery": [null, "Iyoherezwa ryawe"], "Order tracking and the rider are simulated for this prototype.": [null, "Gukurikirana itumiza n'uwarijyanye ni igerageza muri iyi prototype."], "What shapes your score": [null, "Ibigena amanota yawe"], "Payment history": [null, "Amateka y'ubwishyu"], "Mobile money activity": [null, "Ibyakozwe kuri mobile money"], "Savings habits": [null, "Uko wizigama"], "Account age": [null, "Igihe konti imaze"], "Interest received": [null, "Inyungu wabonye"], "Paid to you now": ["Versé maintenant", "Wishyurwa ubu"], "Get your interest today": [null, "Fata inyungu yawe uyu munsi"], "Your shares": [null, "Imigabane yawe"], "Share price": [null, "Igiciro cy'umugabane"], "Dividend (sample)": [null, "Inyungu y'umugabane (urugero)"], "Save together": [null, "Zigame hamwe"], "A first account for your child": ["Un premier compte pour votre enfant", "Konti ya mbere y'umwana wawe"], "Total in pockets": ["Total dans les pochettes", "Yose hamwe mu mifuka"], "To Interest jar": ["Vers la tirelire Intérêts", "Ujya mu kibindi cy'inyungu"], "How much to fill?": [null, "Ushyiramo angahe?"], "Try itunda Eats": ["Essayez itunda Eats", "Gerageza itunda Eats"], "Money in, money out, bills": ["Argent reçu, argent envoyé, factures", "Amafaranga yinjiye, yasohotse, fagitire"], "Deals and cashback": ["Offres et cashback", "Ibyatanzwe n'amafaranga asubizwa"], "Replies and neighbourhood posts": ["Réponses et publications du quartier", "Ibisubizo n'ibyatangajwe mu gace utuyemo"], "Map updates": ["Mises à jour de la carte", "Amakuru mashya ya karita"], "Bus delays and saved places": ["Retards de bus et lieux enregistrés", "Gutinda kwa bisi n'ahantu wabitse"], "Choose what itunda can notify you about.": [null, "Hitamo ibyo itunda ishobora kukumenyesha."], "MTN data bundle": ["Forfait data MTN", "Ipaki ya data ya MTN"], "Music streaming": ["Streaming musical", "Umuziki wo kuri murandasi"], "Payments": ["Paiements", "Ubwishyu"], "Good": ["Bon", "Byiza"], "Range 300 to 850": ["De 300 à 850", "Kuva kuri 300 kugeza kuri 850"]};
const W=[[/(🇺🇸 USD|🇪🇺 EUR|🇬🇧 GBP) wallet/,['$1'.length?'Portefeuille ':'', 'Igikapu cya ']]];
const ph=document.getElementById('phone'),ly=document.getElementById('layer');
function tr(root){
 const l=(typeof S!=='undefined'&&S.lang)||'en';if(l==='en')return;const i=l==='fr'?0:1;
 const w=document.createTreeWalker(root,NodeFilter.SHOW_TEXT);let n;
 while(n=w.nextNode()){
  const raw=n.nodeValue,t=raw.trim();if(t.length<4)continue;
  const d=D[t];if(d&&d[i]){n.nodeValue=raw.replace(t,d[i]);continue}
  if(/ · (Monthly|Weekly|Yearly) · Next /.test(t)){n.nodeValue=raw.replace('Monthly',i?'Buri kwezi':'Mensuel').replace('Weekly',i?'Buri cyumweru':'Hebdo').replace('Yearly',i?'Buri mwaka':'Annuel').replace('Next ',i?'Ikurikira ':'Prochain ');continue}
  const m=t.match(/^(🇺🇸 USD|🇪🇺 EUR|🇬🇧 GBP) wallet$/);
  if(m)n.nodeValue=raw.replace(t,(i?'Igikapu cya ':'Portefeuille ')+m[1].replace(/^\S+ /,''));
 }
}
let q=0;const run=()=>{if(q)return;q=requestAnimationFrame(()=>{q=0;try{tr(ph);if(ly)tr(ly)}catch(e){}})};
[ph,ly].forEach(e=>e&&new MutationObserver(run).observe(e,{childList:true,subtree:true}));
run();
document.title=document.title.replace(/v\d+/,'v259');
})();
</script>
<style id="v260css">
.sheet .bpbar{margin:20px -24px -28px;padding:12px 24px 24px;border-top:0;background:var(--bg)}
.sheet .bpbar .btn{height:52px;font-size:16px;border-radius:16px}
</style>
<script>
/* v260: Saved recipient sheet (Landlord, Diane M.): "Send money" now sits in a bottom bar, the same way Fill and Send sit in the Bank detail screen. The bar has a divider line, 52 px button height and 16 px corners, and stays at the bottom of the sheet; Schedule, Favourite, Edit and Delete stay above it. */
document.title=document.title.replace(/v\d+/,'v260');
</script>
<style id="v261css">
/* v261: soft look, no hairlines. Dividers are gone (spacing does the separating) and outlined pills, boxes and fields use the soft grey fill instead of a stroke. */
#phone .acts button,#phone .pbtn,#phone .bds,#phone .rbox,#phone .abox,#phone .sh5-ad,#phone .sh5-in,#phone .sh5-ta,#phone .mm-rx,#phone .ti .tm,#layer .sh5-ad,#layer .sh5-in,#layer .sh5-ta{border:0!important;background:var(--chip)!important}
#phone .mm-rx{background:var(--chip)!important}
@media (max-width:430px){#phone{border:0}}
</style>
<script>document.title=document.title.replace(/v\d+/,'v261');</script>
<script>
/* v262: Softer section bands. The wide grey bands between sections (Pay, Bank, Transit, Contacts and other screens) were 10 px thick and fairly dark. They are now 8 px and about half as dark, in light and dark themes. */
document.title=document.title.replace(/v\d+/,'v262');
</script>
<style id="v263css">
/* Place: restore the two coloured action buttons (v261 had flattened them, which left "Arrive" as white text on light grey) */
#phone .acts button.p{background:var(--tint)!important;color:var(--tintfg)!important}
#phone .acts button.q{background:var(--lk)!important;color:#fff!important}
/* Directions: bottom bar keeps the travel time readable, mode tabs keep "1h34m" on one line */
#phone .cta[style*="align-items:center"]>span[style*="flex-direction:column"]{flex:1 0 auto;min-width:104px}
#phone .cta[style*="align-items:center"]>span .sm{font-size:12px}
#phone .cta[style*="align-items:center"]>.btn[onclick^="mpStart"]{padding:0 14px!important;flex:0 1 auto;min-width:0;white-space:nowrap}
#phone .cta[style*="align-items:center"]>.btn[onclick="mpStart(false)"]{padding:0 18px!important}
#phone .modes button{white-space:nowrap;gap:4px;padding-left:6px;padding-right:6px;min-width:0}
@media (max-width:380px){#phone .cta[style*="align-items:center"]{padding-left:16px;padding-right:16px;gap:8px}#phone .cta[style*="align-items:center"]>span[style*="flex-direction:column"]{min-width:96px}#phone .cta[style*="align-items:center"]>.btn[onclick^="mpStart"]{padding:0 12px!important;flex:0 0 auto}}
/* Search: recent places show the name on one line with the date underneath, instead of a wrapped name beside a date */
#phone .pl:has(>button.ib){display:grid;grid-template-columns:44px minmax(0,1fr) 32px;grid-template-areas:"i b x" "i s x";column-gap:12px;row-gap:1px;align-items:center}
#phone .pl:has(>button.ib)>i{grid-area:i}
#phone .pl:has(>button.ib)>b{grid-area:b;font-size:16px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;align-self:end}
#phone .pl:has(>button.ib)>span{grid-area:s;font-size:13px;color:var(--mu);align-self:start}
#phone .pl:has(>button.ib)>button.ib{grid-area:x}
</style>
<script>
/* v263: Maps pass. (1) Place: my v261 "no outlines" rule had also removed the colour from the two main buttons, so "Arrive" was white text on light grey; Depart and Arrive have their colours back, and read "From here" and "Directions" in English because "Depart / Arrive" did not say what they do. (2) Directions: the bottom bar squeezed "35 min / 2:41 pm arrival" to 42 px under the Preview button; the travel time now has its own space and the buttons are narrower. The walking tab no longer breaks "1h34m" over two lines. (3) Search: recent places keep the place name on one line with the date under it, so names no longer wrap. */
(function(){
const ph=document.getElementById('phone');
function lab(){
 try{if(S.lang!=='en')return}catch(e){return}
 ph.querySelectorAll('.acts button[onclick="mpDepart()"]').forEach(b=>{if(b.textContent.trim()==='Depart')b.textContent='From here'});
 ph.querySelectorAll('.acts button[onclick="mpArrive()"]').forEach(b=>{if(b.textContent.trim()==='Arrive')b.textContent='Directions'});
}
let q=0;const sc=()=>{if(q)return;q=requestAnimationFrame(()=>{q=0;lab()})};
new MutationObserver(sc).observe(ph,{childList:true,subtree:true});lab();
document.title=document.title.replace(/v\d+/,'v263');
})();
</script>
<script>
/* v265: itunda Pay detail, reworked with ideas from the Toss Pay Money screens. (1) Move and Top up sit right under the balance, the way Toss puts Move and Top up there. (2) "Top-up account" in the top bar picks which account Top up uses first (itunda Bank, MTN MoMo, Airtel Money, balances are sample data). (3) Top up and Move are one amount screen: who it is from or to at the top (tap to change), "How much to top up?" turns into "10,000 RWF to top up?" as you type, quick chips, Confirm bar above the keypad. (4) The ledger has a month picker and a "Payments only" switch, lines read "time | from → to", and day headings carry the weekday. (5) Top up and Move change the real balances and show on both the Pay and the Bank ledgers; the Pay tab's Add button now opens Top up. The search and the money in / out filter of v264 are replaced by the month picker and the switch. */
(function(){
const T3=(a,b,c)=>({rw:b,fr:c}[S.lang]||a);
const esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const PAYID='0788-1205-1980';
S.tu=S.tu||{src:'bank',dst:'bank',mtn:85000,airtel:20000};
S.pmo=0;S.pOnly=false;
/* older Pay sample lines, added once at the end of the list so the newest lines stay on top */
if(!S.pd265){S.pd265=1;const ago=(d,h,m)=>{const x=new Date();x.setDate(x.getDate()-d);x.setHours(h,m,0,0);return x.getTime()};
[['food','Kigali Bakery','Paid',-4500,'Paid',ago(6,8,12)],['up','Top up','Received',50000,'Received',ago(7,18,40),'pay','MTN MoMo → Pay'],['bag','itunda Shop','Paid',-18000,'Paid',ago(9,14,5)],['bus','Kigali Bus Services','Paid',-300,'Paid',ago(10,7,50)],['food','Heaven Restaurant','Paid',-12500,'Paid',ago(12,19,25)]].forEach(([g,t,k,a,kk,ts,...r])=>S.act.push([g,t,k+' · '+tm48(ts),a,kk,ts,...r]))}
/* v403: lines that only had a day word ("Paid · Tuesday") get a real time, so every ledger line reads "time" under its name like the Toss list */
S.act.forEach(x=>{if(x&&!x[5]&&typeof x[2]==='string'){const w=(x[2].split(' · ')[1]||'').trim(),d=new Date();if(w==='Yesterday')d.setDate(d.getDate()-1);else{const k=['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'].indexOf(w);if(k<0)return;let n=(d.getDay()-k+7)%7;d.setDate(d.getDate()-(n||7))}d.setHours(x[3]>0?18:8,x[3]>0?20:5,0,0);x[5]=d.getTime()}});
/* which ledger a line belongs to: lines tagged 'pay' or 'bank' (index 6), else the old rule */
const side=x=>x[6]||(BKX(x)?'pay':'bank');
window.ledger50=function(){let bal=S.bank;return S.act.filter(x=>side(x)==='bank').map(x=>{const r={x,bal};bal-=x[3];return r})};
const payLedger=()=>{let bal=S.pay;return S.act.filter(x=>side(x)==='pay').map(x=>{const r={x,bal};bal-=x[3];return r})};
/* accounts */
const SRC=()=>[{k:'bank',n:'itunda Bank',s:'••1980',b:S.bank},{k:'mtn',n:'MTN MoMo',s:'078 ••• 1980',b:S.tu.mtn},{k:'airtel',n:'Airtel Money',s:'073 ••• 1980',b:S.tu.airtel}];
const src=k=>SRC().find(x=>x.k===k)||SRC()[0];
const sico=(k,z)=>k==='bank'?`<span class="pkico" style="width:${z}px;height:${z}px;border-radius:${z/2}px">${gl('bank',Math.round(z*.6))}</span>`:`<span style="width:${z}px;height:${z}px;border-radius:${z/2}px;background:${k==='mtn'?'#FFCB05':'#E4002B'};color:${k==='mtn'?'#111':'#fff'};display:flex;align-items:center;justify-content:center;font-weight:800;font-size:${Math.round(z*.42)}px;flex-shrink:0">${k==='mtn'?'M':'A'}</span>`;
/* dates */
const loc=()=>S.lang==='fr'?'fr-FR':'en-GB';
const isMonth=(x,off)=>{const n=new Date(),m=new Date(n.getFullYear(),n.getMonth()-off,1),d=x[5]?new Date(x[5]):n;return d.getMonth()===m.getMonth()&&d.getFullYear()===m.getFullYear()};
const monthName=(off,y)=>{const n=new Date(),m=new Date(n.getFullYear(),n.getMonth()-off,1);return m.toLocaleDateString(loc(),y?{month:'long',year:'numeric'}:{month:'long'})};
const dayLbl=x=>{if(!x[5])return when50(x);const s=new Date(x[5]).toLocaleDateString(loc(),{weekday:'short',day:'numeric',month:'short'});return day48(x[5])==='Today'?T3('Today','Uyu munsi','Aujourd’hui')+' · '+s:s};
const subOf=x=>{const tm=x[5]?tm48(x[5]):x[2].split(' · ')[0];return x[7]?tm+' | '+x[7]:tm};
const isPay=x=>x[3]<0&&!x[7];
const spentMonth=()=>payLedger().reduce((a,{x})=>isPay(x)&&isMonth(x,0)?a-x[3]:a,0);
function pdList(){const rows=payLedger().filter(({x})=>isMonth(x,S.pmo)&&(!S.pOnly||isPay(x)));
if(!rows.length)return `<div class="pkempty">${S.pOnly?T3('No payments this month.','Nta kwishyura muri uku kwezi.','Aucun paiement ce mois-ci.'):T3('No activity this month.','Nta cyakozwe muri uku kwezi.','Aucune activité ce mois-ci.')}</div>`;
const g=[];rows.forEach(r=>{const d=dayLbl(r.x),l=g[g.length-1];if(l&&l[0]===d)l[1].push(r);else g.push([d,[r]])});
return g.map(([d,rs])=>`<div class="pkg">${d}</div>${rs.map(({x,bal})=>{const inn=x[3]>0;return `<div class="bdr ${inn?'pin':''}" role="button" tabindex="0" onclick="actOpen(${S.act.indexOf(x)})"><div class="ico">${gx(x[0],26)}</div><div style="min-width:0"><div class="t">${esc(x[1]==='Top up'?T3('Top up','Ongeramo','Recharge'):x[1])}</div><div class="s">${esc(subOf(x))}</div></div><div class="pkv"><b>${String(signed(x[3])).replace(/\s*RWF$/,'')}</b></div></div>`}).join('')}`).join('')}
window.openPayDetail=()=>{S.pmo=0;S.pOnly=false;S.stack.push('payd');render('push')};
screens.payd=()=>`<div class="bdt"><button class="ib" aria-label="Back" onclick="back()">${ic('back',24)}</button><button class="bb bq" aria-label="${T3('Code','Kode','Code')}" onclick="ppCode()">${ic('qr',22)}</button><button class="bb" onclick="pdTuSet()">${T3('Top-up account','Konti yo kongeramo','Compte de recharge')}</button></div><div class="pdl1">itunda Pay</div><div class="bdb">${fmt(S.pay)}<small>RWF</small></div><div class="pad row2 pdbt"><button class="btn sec2" onclick="openMove()">${T3('Move','Imura','Déplacer')}</button><button class="btn" onclick="openTopUp()">${T3('Top up','Ongeramo','Recharger')}</button></div><div class="bdband"></div><div class="bdf"><button class="pkf" onclick="pdMonth()" aria-haspopup="dialog">${monthName(S.pmo)}${ic('chev',16)}</button><button role="switch" aria-checked="${S.pOnly}" onclick="S.pOnly=!S.pOnly;render('fade-none')" style="display:flex;align-items:center;gap:10px;border:0;background:none;color:var(--mu);font-size:15px;font-weight:600;padding:0">${T3('Payments only','Kwishyura gusa','Paiements seulement')}<i style="display:block;width:50px;height:30px;border-radius:15px;background:${S.pOnly?'var(--br)':'var(--chip)'};position:relative;transition:background .2s"><b style="position:absolute;top:3px;left:${S.pOnly?23:3}px;width:24px;height:24px;border-radius:12px;background:#fff;transition:left .2s"></b></i></button></div><div id="pdl">${pdList()}</div>`;
window.pdMonth=()=>{$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" role="dialog" aria-modal="true" aria-label="${T3('Month','Ukwezi','Mois')}"><div class="h1" style="font-size:22px;line-height:30px;margin-bottom:8px">${T3('Month','Ukwezi','Mois')}</div>${[0,1,2].map(n=>`<button class="pkopt ${S.pmo===n?'on':''}" onclick="S.pmo=${n};closeSheet();render('fade-none')">${monthName(n,1)}${S.pmo===n?CK48:''}</button>`).join('')}</div>`};
window.pdCopy=()=>{try{navigator.clipboard.writeText(PAYID).catch(()=>{})}catch(e){}toast(T3('Pay number copied','Nimero ya Pay yakoporowe','Numéro Pay copié'))};
/* top-up account screen */
window.pdTuSet=()=>{S.stack.push('putset');render('push')};
screens.putset=()=>`${bar(T3('Top-up account','Konti yo kongeramo','Compte de recharge'))}<div class="pad" style="padding-top:20px"><div class="h1" style="font-size:26px;line-height:34px">${T3('Which account should top up?','Ni iyihe konti yo kongeramo?','Quel compte doit recharger ?')}</div><div class="mu" style="font-size:15px;line-height:22px;margin-top:10px">${T3('Top up starts from this account. You can change it each time.','Kongeramo bitangirira kuri iyi konti. Ushobora kuyihindura buri gihe.','La recharge part de ce compte. Vous pouvez le changer à chaque fois.')}</div></div><div style="padding-top:14px">${SRC().map(a=>`<div class="tap" role="button" tabindex="0" onclick="S.tu.src='${a.k}';render('fade-none')" style="display:flex;align-items:center;gap:14px;padding:12px 24px;cursor:pointer">${sico(a.k,52)}<div style="flex:1;min-width:0"><div style="font-size:17px;font-weight:700">${a.n} ${a.s}</div><div class="sm mu" style="margin-top:2px">${fmt(a.b)} RWF</div></div><span style="color:var(--lk);display:flex;width:24px">${S.tu.src===a.k?CK48:''}</span></div>`).join('')}<div class="tap" role="button" tabindex="0" onclick="toast('${T3('Linking more accounts is not in this prototype yet.','Kongeraho konti ntibiraboneka muri iyi prototype.','Lier d’autres comptes n’est pas encore dans ce prototype.')}')" style="display:flex;align-items:center;gap:14px;padding:12px 24px;cursor:pointer"><span class="pkico" style="width:52px;height:52px;border-radius:26px;background:var(--chip);color:var(--lk)">${ic('plus',22)}</span><b style="font-size:17px">${T3('Add account','Ongeraho konti','Ajouter un compte')}</b></div></div><div class="sec" style="padding-top:26px"><div class="sech">${T3('Account','Konti','Compte')}</div>${row('wallet',T3('Pay number','Nimero ya Pay','Numéro Pay'),PAYID,'','pdCopy()')}${row('user',T3('Account name','Izina rya konti','Nom du compte'),esc(S.name||'You'))}${row('shield',T3('Daily limit','Urugero rwa buri munsi','Limite quotidienne'),'1,000,000 RWF')}</div><div class="pad fine" style="padding-top:18px">${T3('Balances and limits are sample data for this prototype.','Amafaranga n’imbibi ni ibitegererezo.','Soldes et limites : données d’exemple pour ce prototype.')}</div>`;
/* Top up / Move: one amount screen */
window.openTopUp=()=>{S.pu={mode:'top',k:S.tu.src,amt:''};S.stack.push('puamt');render('push')};
window.openMove=()=>{S.pu={mode:'move',k:S.tu.dst,amt:''};S.stack.push('puamt');render('push')};
const DLIM=1000000,dayK=()=>new Date().toDateString();
const usedToday=()=>S.tu.usedD===dayK()?(S.tu.used||0):0;
const limLeft=()=>Math.max(0,DLIM-usedToday());
const puMax=()=>S.pu.mode==='top'?Math.min(src(S.pu.k).b,limLeft()):S.pay;
const lastTop=()=>{const a=(S.act||[]).find(x=>x&&x[0]==='up'&&x[3]>0);return a?a[3]:0};
function puWhy(v){const p=S.pu,o=src(p.k);
 if(p.mode==='top'){if(v>o.b)return T3('Not enough in '+o.n+'. You have '+fmt(o.b)+' RWF.','Nta mafaranga ahagije kuri '+o.n+'. Ufite RWF '+fmt(o.b)+'.','Pas assez sur '+o.n+'. Vous avez '+fmt(o.b)+' RWF.');
  return T3('Daily limit is '+fmt(DLIM)+' RWF. You can add '+fmt(limLeft())+' RWF more today.','Imbibi bya buri munsi ni RWF '+fmt(DLIM)+'. Uyu munsi ushobora kongeramo RWF '+fmt(limLeft())+'.','La limite quotidienne est de '+fmt(DLIM)+' RWF. Vous pouvez encore ajouter '+fmt(limLeft())+' RWF aujourd’hui.')}
 return T3('Not enough in itunda Pay. You have '+fmt(S.pay)+' RWF.','Nta mafaranga ahagije kuri itunda Pay. Ufite RWF '+fmt(S.pay)+'.','Pas assez sur itunda Pay. Vous avez '+fmt(S.pay)+' RWF.')}
function puBody(){const p=S.pu,v=Number(p.amt||0),bad=v>puMax(),top=p.mode==='top',o=src(p.k),mx=puMax();
const ph=top?T3('How much to top up?','Ni angahe wongeramo?','Combien recharger ?'):T3('How much to move?','Ni angahe wimura?','Combien déplacer ?');
const q=v?`<b>${fmt(v)}</b> RWF`:`<span class="pph">${ph}</span>`;
const wd=v>=1e6?(Math.round(v/1e4)/100)+' '+T3('million','miliyoni',v>=2e6?'millions':'million')+' RWF':v>=1e3?(Math.round(v/10)/100)+' '+T3('thousand','ibihumbi','mille')+' RWF':'';
const lt=lastTop(),amts=[20000,50000,100000];
const CS='';
const chips=(bad?'':amts.map(n=>`<button class="chip" style="${CS}" onclick="puKey('add:${n}')">+${fmt(n)}</button>`).join('')+(top&&lt&&!amts.includes(lt)?`<button class="chip" style="${CS}" onclick="puKey('set:${lt}')">${T3('Last','Ubushize','Dernier')} ${fmt(lt)}</button>`:''))+`<button class="chip" style="${CS}${mx>0?'':';opacity:.45'}" ${mx>0?'':'disabled'} onclick="puKey('max')">${T3('All','Byose','Tout')}${mx>0?' · '+fmt(mx):''}</button>`;
const dest=top?S.pay+v:o.b+v,destN=top?'itunda Pay':o.n;
let note='',extra='';
if(bad){note=puWhy(v);if(top&&v>o.b){const alt=SRC().find(x=>x.k!==p.k&&x.b>=v);if(alt)extra=`<button class="chip" style="margin-top:8px;height:40px;padding:0 16px;font-size:14px" onclick="puSet('${alt.k}')">${T3('Use ','Koresha ','Utiliser ')}${alt.n} · ${fmt(alt.b)} RWF</button>`}}
else if(v)note=T3('%n after: %s RWF','%n izaba: RWF %s','%n après : %s RWF').replace('%n',destN).replace('%s',fmt(dest))+' · '+T3('Free, instant','Ni ubuntu, ako kanya','Gratuit, instantané');
else if(top)note=T3('Daily limit left: '+fmt(limLeft())+' RWF','Asigaye uyu munsi: RWF '+fmt(limLeft()),'Limite restante aujourd’hui : '+fmt(limLeft())+' RWF');
return `<div class="pua">${q}</div><div class="puw">${wd}</div><div class="pun${bad?' er':''}" aria-live="polite">${note}</div>${extra}<div class="puc">${chips}</div>`}
const puGoLbl=()=>T3('Confirm','Emeza','Confirmer');
const payIco=z=>`<span style="width:${z}px;height:${z}px;border-radius:${z/2}px;background:var(--tint);color:var(--tintfg);display:flex;align-items:center;justify-content:center;font-weight:800;font-size:${Math.round(z*.42)}px;flex-shrink:0">P</span>`;
screens.puamt=()=>{const p=S.pu,top=p.mode==='top',a=src(p.k),v=Number(p.amt||0),bad=v>puMax();
const row=(who,label,sub,pick)=>`<div class="pur${pick?' tap':''}" ${pick?'role="button" tabindex="0" onclick="puPick()"':''}><div class="put"><span class="pul">${label}</span><span class="pun1">${who}</span>${pick?ic('chev',16,'var(--tt)').replace('<svg','<svg style="transform:rotate(90deg);flex:none;margin-left:2px"'):''}</div><div class="pus">${sub}</div></div>`;
const A=T3('Available ','Ushobora gukoresha ','Disponible '),B=T3('Balance ','Asigaye ','Solde ');
const sb=(l,n)=>`${l}<span>${fmt(n)} RWF</span>`;
const frm=top?row(a.n,T3('From','Biva kuri','Depuis'),sb(A,a.b),1):row('itunda Pay',T3('From','Biva kuri','Depuis'),sb(A,S.pay),0);
const to=top?row('itunda Pay',T3('To','Ujya kuri','Vers'),sb(B,S.pay),0):row(a.n,T3('To','Ujya kuri','Vers'),sb(B,a.b),1);
const ttl=top?T3('Top up','Ongeramo','Recharge'):T3('Move','Imura','Déplacer');
return `<div class="bar puh"><button class="ib" aria-label="Back" onclick="back()">${ic('back',24)}</button><b>${ttl}</b></div><div class="purs">${frm}<button class="pusw" aria-label="${T3('Swap direction','Hindura icyerekezo','Inverser')}" onclick="puSwap()"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 4v16M4 8l4-4 4 4M16 20V4M12 16l4 4 4-4"/></svg></button>${to}</div><div id="pub">${puBody()}</div><div class="keys puk">${['1','2','3','4','5','6','7','8','9','00','0','⌫'].map(k=>`<button onclick="puKey('${k}')" aria-label="${k==='⌫'?'Delete':k}">${k==='⌫'?'<svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 12H4.5M10.5 5.5L4 12l6.5 6.5"/></svg>':k}</button>`).join('')}</div><div class="cta pucta"><button id="pgo" class="btn" ${v&&!bad?'':'disabled'} onclick="puAsk()">${puGoLbl()}</button></div>`};
window.puSwap=()=>{const p=S.pu,top=p.mode==='top';p.mode=top?'move':'top';p.k=top?S.tu.dst:S.tu.src;p.amt='';render('fade-none')};
window.puKey=k=>{const p=S.pu;k=String(k);if(k.startsWith('add:'))p.amt=String(Math.min(Number(p.amt||0)+Number(k.slice(4)),999999999));else if(k.startsWith('set:'))p.amt=k.slice(4);else if(k==='max')p.amt=String(puMax());else if(k==='⌫')p.amt=p.amt.slice(0,-1);else if(k==='00'){if(p.amt&&p.amt.length<8)p.amt+='00'}else if(p.amt.length<9)p.amt=(p.amt+k).replace(/^0+/,'');
const v=Number(p.amt||0),b=$('#pub');if(b)b.innerHTML=puBody();const g=$('#pgo');if(g){g.disabled=!(v&&v<=puMax());g.textContent=puGoLbl()}};
/* v390: quieter top-up / move amount screen */
{
const T=(a,b,c)=>T3(a,b,c);
window.puBody=function(){const p=S.pu,v=Number(p.amt||0),bad=v>puMax(),top=p.mode==='top',o=src(p.k);
const verb=top?T('Top up','Ongeramo','Recharger'):T('Move','Imura','Déplacer');
const ph=top?T('<b>How much</b> to top up?','<b>Ni angahe</b> wongeramo?','<b>Combien</b> recharger ?'):T('<b>How much</b> to move?','<b>Ni angahe</b> wimura?','<b>Combien</b> déplacer ?');
const q=v?`<i>${verb}</i> ${fmt(v)} RWF<i>${S.lang==='fr'?' ?':'?'}</i>`:`<i>${ph}</i>`;
let note='',extra='';
if(bad){note=puWhy(v);if(top&&v>o.b){const alt=SRC().find(x=>x.k!==p.k&&x.b>=v);if(alt)extra=`<button class="chip" style="margin-top:10px" onclick="puSet('${alt.k}')">${T('Use ','Koresha ','Utiliser ')}${alt.n} · ${fmt(alt.b)} RWF</button>`}}
const mx=puMax();
const chips=bad?'':(!v?(mx>0?`<button class="chip" onclick="puKey('max')">${T('All','Byose','Tout')} ${fmt(mx)}</button>`:''):[10000,50000,100000].map(n=>`<button class="chip" ${v+n>mx?'disabled':''} onclick="puKey('add:${n}')">+${fmt(n)}</button>`).join(''));
return `<div class="pua" style="${v>=1e7?'font-size:22px':''}">${q}</div><div class="pun${bad?' er':''}" aria-live="polite">${note}</div>${extra}<div class="puc">${chips}</div>`};
window.puKey=k=>{const p=S.pu;k=String(k);if(k.startsWith('add:'))p.amt=String(Math.min(Number(p.amt||0)+Number(k.slice(4)),999999999));else if(k==='max')p.amt=String(puMax());else if(k==='clear')p.amt='';else if(k==='⌫')p.amt=p.amt.slice(0,-1);else if(p.amt.length<9)p.amt=(p.amt+k).replace(/^0+/,'');
const v=Number(p.amt||0),b=$('#pub');if(b)b.innerHTML=window.puBody();const g=$('#pgo');if(g){g.disabled=!(v&&v<=puMax());g.textContent=puGoLbl()}};
screens.puamt=()=>{const p=S.pu,top=p.mode==='top',a=src(p.k),v=Number(p.amt||0),bad=v>puMax();
const A=T('Available ','Ushobora gukoresha ','Disponible '),B=T('Balance ','Asigaye ','Solde ');
const lab=top?T('From','Biva kuri','Depuis'):T('To','Ujya kuri','Vers');
const sub=a.s;
const chev=ic('chev',16,'var(--tt)').replace('<svg','<svg style="transform:rotate(90deg);flex:none"');
return `<div class="bar puh"><button class="ib" aria-label="Back" onclick="back()"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 12H4.5M10.5 5.5L4 12l6.5 6.5"/></svg></button></div><div class="pus1"><div class="pusr tap" role="button" tabindex="0" aria-label="${lab}" onclick="puPick()">${sico(p.k,44)}<div class="t"><i>${lab}</i><b>${a.n}</b>${chev}</div></div><div class="pusb">${sub}</div></div><div id="pub">${window.puBody()}</div><div class="keys puk">${['1','2','3','4','5','6','7','8','9','','0','⌫'].map(k=>k===''?'<span></span>':`<button onclick="puKey('${k}')" aria-label="${k==='⌫'?'Delete':k}">${k==='⌫'?'<svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 12H4.5M10.5 5.5L4 12l6.5 6.5"/></svg>':k}</button>`).join('')}</div><div class="cta pucta"><button id="pgo" class="btn" ${v&&!bad?'':'disabled'} onclick="puAsk()">${puGoLbl()}</button></div>`};
}
window.puPick=()=>{const p=S.pu,top=p.mode==='top';$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" role="dialog" aria-modal="true"><div class="h1" style="font-size:22px;line-height:30px;margin-bottom:8px">${top?T3('Top up from','Ongeramo biva kuri','Recharger depuis'):T3('Move to','Imura ujya kuri','Déplacer vers')}</div>${SRC().map(a=>`<div class="tap" role="button" tabindex="0" onclick="puSet('${a.k}')" style="display:flex;align-items:center;gap:14px;padding:10px 0;cursor:pointer">${sico(a.k,44)}<div style="flex:1;min-width:0"><div style="font-size:17px;font-weight:700">${a.n}</div><div class="sm mu">${a.s} · ${fmt(a.b)} RWF</div></div><span style="color:var(--lk);display:flex;width:24px">${p.k===a.k?CK48:''}</span></div>`).join('')}</div>`};
window.puSet=k=>{S.pu.k=k;if(S.pu.mode==='top')S.tu.src=k;else S.tu.dst=k;closeSheet();render('fade-none')};
window.puAsk=()=>{const p=S.pu,v=Number(p.amt||0),a=src(p.k),top=p.mode==='top';if(!v||v>puMax())return;
const ln=(l,x)=>`<div style="display:flex;justify-content:space-between;gap:12px;padding:11px 0;font-size:15px"><span class="mu">${l}</span><b style="text-align:right">${x}</b></div>`;
const after=top?S.pay+v:a.b+v;
$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" role="dialog" aria-modal="true"><div class="h1" style="font-size:22px;line-height:30px">${top?T3('Top up '+fmt(v)+' RWF?','Kongeramo RWF '+fmt(v)+'?','Recharger '+fmt(v)+' RWF ?'):T3('Move '+fmt(v)+' RWF?','Kwimura RWF '+fmt(v)+'?','Déplacer '+fmt(v)+' RWF ?')}</div><div style="margin:14px 0 18px;padding:2px 16px;border-radius:16px;background:var(--chip)">${ln(T3('From','Biva kuri','Depuis'),top?a.n+' '+a.s:'itunda Pay')}${ln(T3('To','Ujya kuri','Vers'),top?'itunda Pay':a.n+' '+a.s)}${ln(T3('Fee','Ikiguzi','Frais'),T3('Free','Ni ubuntu','Gratuit'))}${ln(T3('Arrives','Bigera','Arrivée'),T3('Instantly','Ako kanya','Instantanément'))}${ln((top?'itunda Pay':a.n)+' '+T3('after','izaba','après'),fmt(after)+' RWF')}</div><button class="btn" onclick="puDo()">${T3('Confirm','Emeza','Confirmer')}</button><button class="btn sec2" style="margin-top:10px" onclick="closeSheet()">${T3('Cancel','Reka','Annuler')}</button></div>`;if(typeof focusSheet==='function')focusSheet()};
window.puDo=()=>{const p=S.pu,v=Number(p.amt||0),a=src(p.k),top=p.mode==='top';if(!v||v>puMax())return;const ts=Date.now();
if(top){S.tu.used=usedToday()+v;S.tu.usedD=dayK();if(p.k==='bank'){S.bank-=v;S.act.unshift(['cyc','To itunda Pay','Paid · Just now',-v,'Paid',ts,'bank','Bank → Pay'])}else S.tu[p.k]-=v;S.pay+=v;S.act.unshift(['up',T3('Top up','Ongeramo','Recharge'),'Received · Just now',v,'Received',ts,'pay',(a.k==='bank'?'Bank':a.n)+' → Pay'])}
else{S.pay-=v;if(p.k==='bank'){S.bank+=v;S.act.unshift(['cyc','From itunda Pay','Received · Just now',v,'Received',ts,'bank','Pay → Bank'])}else S.tu[p.k]+=v;S.act.unshift(['cyc',T3('Move','Imura','Déplacement'),'Paid · Just now',-v,'Paid',ts,'pay','Pay → '+(a.k==='bank'?'Bank':a.n)])}
closeSheet();back();toast(top?T3(`Topped up ${fmt(v)} RWF · Pay balance ${fmt(S.pay)} RWF`,`Wongeyemo RWF ${fmt(v)} · Asigaye kuri Pay: RWF ${fmt(S.pay)}`,`${fmt(v)} RWF rechargés · Solde Pay ${fmt(S.pay)} RWF`):T3(`Moved ${fmt(v)} RWF`,`Wimuye RWF ${fmt(v)}`,`${fmt(v)} RWF déplacés`))};
/* entry points: Pay tab balance card (and its Add button), Home Pay row, My assets row */
const _p=screens.pay;
screens.pay=()=>{let h=_p();const o='<div style="padding:0 8px"><div class="sm" style="font-weight:700;color:var(--tintfg)">';
if(h.includes(o))h=h.replace(o,`<div class="tap" role="button" tabindex="0" onclick="${S.psrc==='bank'?'openBankDetail()':'openPayDetail()'}" style="padding:0 8px;cursor:pointer;position:relative"><span style="position:absolute;right:10px;top:2px;display:flex">${ic('chev',16,'var(--tintfg)')}</span><div class="sm" style="font-weight:700;color:var(--tintfg)">`);
return h.replace(/sheetAdd\(\)/g,'openTopUp()')};
const _h=screens.home;
screens.home=()=>_h().replace(/(<div class="hr tap" role="button" tabindex="0" )onclick="tab\('pay'\)"(><div class="hi">)/,'$1onclick="openPayDetail()"$2');
const _a=screens.assets;
if(_a)screens.assets=()=>_a().replace(/(<div[^>]*onclick=")tab\('pay'\)("[^>]*>(?:(?!<\/div>\s*<\/div>)[\s\S])*?itunda Pay)/,'$1openPayDetail()$2');
/* the sheet of a line: Pay lines say Pay, transfers show their route */
const _ao=window.actOpen;
window.actOpen=function(i){_ao.apply(this,arguments);const x=S.act[i],y=$('#layer');if(!x||!y||!y.innerHTML)return;
if(x[7])y.innerHTML=y.innerHTML.replace(/<span class="mu">(?:To|From|Kuri|Biva kuri|Vers|De)<\/span><b[^>]*>itunda Bank<\/b>/,`<span class="mu">${T3('Route','Inzira','Trajet')}</span><b style="text-align:right">${esc(x[7])}</b>`);
else if(side(x)==='pay')y.innerHTML=y.innerHTML.replace(/itunda Bank<\/b>/,'itunda Pay</b>')};
document.title=document.title.replace(/v\d+/,'v265');
})();
</script>
<style id="v266css">
/* v266: pages instead of bottom sheets. Only a decision that must interrupt (confirm, cancel, authorise) stays a sheet. */
#phone .sheet.v6pg{inset:0;max-height:none!important;height:auto;border-radius:0;padding:0!important;overflow-y:auto;overflow-x:hidden;z-index:22;touch-action:auto!important;display:flex;flex-direction:column;animation:pgin .3s cubic-bezier(.2,.8,.2,1)}
#phone .sheet.v6pg.v6na{animation:none}
#phone .sheet.v6pg::before{display:none}
@keyframes pgin{from{transform:translateX(100%)}to{transform:none}}
.v6h{position:sticky;top:0;z-index:3;background:var(--bg);display:flex;align-items:center;padding:16px 12px 6px;flex:none}
.v6b{flex:1;padding:6px 24px 24px;min-height:0}
.v6b>.h1:first-child,.v6b>.g3+.h1{font-size:26px!important;line-height:34px!important;letter-spacing:-.4px}
.v6cta{position:sticky!important;left:auto;right:auto;bottom:0;margin-top:auto;flex:none;padding:12px 24px calc(24px + env(safe-area-inset-bottom,0px))}
.v6cta .bpbar{margin:0!important;padding:0!important;border:0!important}
.v6cta .btn+.btn,.v6cta .btn+.row2{margin-top:10px}
.sheet.v6res .v6b{display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding-bottom:48px}
.sheet.v6res .v6b .h1{font-size:26px!important;line-height:34px!important}
</style>
<script>
/* v266: modals audit. Every sheet in the app goes through #layer, so one converter handles them all. Stays a sheet: confirmations and authorisations ("Confirm it's you", "…?" decisions with one or two buttons, the Confirm checkout sheet). Becomes a page: everything else (lists, pickers, forms, receipts, settings, PIN steps). A page has a back arrow, the title large, content that scrolls, and its buttons docked at the bottom. A sheet with only a picture, a message and one button becomes a centred result page. */
(function(){
const ph=document.getElementById('phone'),L=document.getElementById('layer');
function classify(sh){
 if(sh.classList.contains('bs464'))return 'modal';
 const h=((sh.querySelector('.h1')||{}).textContent||'').trim(),lab=sh.getAttribute('aria-label')||'';
 const form=sh.querySelector('input,textarea,select,.req,.chip,.pkauto,.pkopt,[data-pg],[data-cpin],[data-czpin],.keys,.row.tap,.bdr,.cb,.stk,.pkrow,.ar,[role=button],[onclick]:not(button)');
 const btns=sh.querySelectorAll('button').length;
 if(lab==='Confirm'||/^(confirm|confirmez|emeza)/i.test(h))return 'modal';
 if(!form&&btns<=2&&/\s?\?$/.test(h))return 'modal';
 if(!form&&btns===1&&sh.querySelector('.g3')&&sh.textContent.length<260)return 'result';
 return 'page';
}
const DOCK=e=>e.nodeType===1&&(e.matches('button.btn,.row2,.bpbar,.cta'));
function toPage(sh,res){
 sh.classList.add('v6pg');if(res)sh.classList.add('v6res');
 [...sh.children].forEach(k=>{if(k.getAttribute('aria-hidden')==='true'&&/height:4px/.test(k.getAttribute('style')||''))k.remove()});
 const rest=[...sh.children];let i=rest.length;const dock=[];
 while(i>0&&DOCK(rest[i-1])){dock.unshift(rest[i-1]);i--}
 const body=document.createElement('div');body.className='v6b';rest.slice(0,i).forEach(k=>body.appendChild(k));
 const fb=rest.length&&rest[0].querySelector?rest[0].querySelector('button.ib'):null,own=fb&&(/‹/.test(fb.textContent)||/back/i.test((fb.getAttribute('onclick')||'')+(fb.getAttribute('aria-label')||'')));
 if(!res&&!own){const h=document.createElement('div');h.className='v6h';h.innerHTML='<button class="ib" aria-label="Back" onclick="closeSheet()">'+ic('back',24)+'</button>';sh.appendChild(h)}
 sh.appendChild(body);
 if(dock.length){const c=document.createElement('div');c.className='cta v6cta';dock.forEach(d=>c.appendChild(d));sh.appendChild(c)}
}
let lastTitle='',lastScroll=0;
const obs=new MutationObserver(recs=>{
 const sh=L.querySelector('.sheet:not([data-pgd])');if(!sh)return;
 sh.dataset.pgd='1';
 const kind=classify(sh);if(kind==='modal')return;
 const wasPage=recs.some(r=>[...r.removedNodes].some(n=>n.nodeType===1&&(n.classList.contains('v6pg')||(n.querySelector&&n.querySelector('.sheet.v6pg')))));
 obs.disconnect();
 toPage(sh,kind==='result');
 const bg=L.querySelector('.sheetbg');if(bg)bg.remove();
 const title=((sh.querySelector('.h1')||{}).textContent||'').trim();
 if(wasPage){sh.classList.add('v6na');if(title===lastTitle)sh.scrollTop=lastScroll}else lastScroll=0;
 lastTitle=title;
 sh.addEventListener('scroll',()=>{lastScroll=sh.scrollTop},{passive:true});
 obs.observe(L,{childList:true,subtree:true});
});
obs.observe(L,{childList:true,subtree:true});
/* a page is not dragged down like a sheet */
ph.addEventListener('pointerdown',e=>{if(e.target.closest&&e.target.closest('.sheet.v6pg')&&!e.target.closest('.fmsurf'))e.stopImmediatePropagation()},true);
document.title=document.title.replace(/v\d+/,'v266');
})();
</script>
<style id="v267css">
/* v267: Send flow, quieter. No step bar, no "Step n of 3", no disabled-button hint, no duplicate amount lines. */
#view:has([data-send]) .v176,#view:has([data-send]) .dhint{display:none!important}
.screen:has([data-send]) #msg[style*="var(--mu)"]{display:none}
</style>
<script>
/* v267: what changed on Send. Step 1 (who): back arrow only (no "Send" title), no Phone number / Friends tabs (both showed the same contacts), no field label or helper text until there is something to say, no "Contacts + Add" heading. Step 2 (amount): the recipient is a name · number line instead of "To account …", the amount-in-words shows once (the green "5 thousand" line is gone), "Balance after" only appears when there is a problem, three quick chips (+5,000 +10,000 Max). Step 3 (check): no "Step 3 of 3", no amount-in-words again, no Fee row when the fee is 0, no "Go back" button (tap outside the sheet, or drag it down, to close). */
(function(){
const esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const phone=p=>{const d=String(p||'').replace(/\D/g,'');return d.length===10?d.replace(/(\d{4})(\d{3})(\d{3})/,'$1 $2 $3'):String(p||'')};
const names={};
const MARK='<i data-send hidden></i>';
const _r=screens.recipient;
screens.recipient=()=>{S.rtab='a';let h=_r();
 h.replace(/<div class="t">([^<]*)<\/div><div class="s">([\d ]+)<\/div>/g,(m,n,p)=>{names[p.replace(/\D/g,'')]=n;return m});
 h=h.replace('<b>Send</b>','')
  .replace(/<div class="pad" style="padding-top:24px;display:flex;gap:20px[^"]*">(?:<span class="tap" role="tab"[\s\S]*?<\/span>){2}<\/div>/,'')
  .replace(/<div class="sm mu">[^<]*<\/div>(<div style="display:flex;align-items:center;justify-content:space-between;margin-top:4px;min-height:32px">)/,'$1')
  .replace(/placeholder="[^"]*"/,'placeholder="'+esc(t('ta'))+'" aria-label="'+esc(t('rl'))+'"')
  .replace(/(<div id="rch"[^>]*>)[^<]*(<\/div>)/,'$1$2')
  .replace(/<div class="sech">[^<]*<a>[^<]*<\/a><\/div>/,'');
 return h+MARK};
const _ri=window.rcIn;
window.rcIn=function(el){const r=_ri.apply(this,arguments);const e=document.getElementById('rch');if(e&&!el.value.trim())e.textContent='';return r};
const _a=screens.amount;
screens.amount=()=>{let h=_a();
 const d=String(S.to||'').replace(/\D/g,''),nm=names[d],who=(nm?esc(nm)+' · ':'')+esc(phone(S.to));
 h=h.replace('<b>Send</b>','')
  .replace(/<div id="w9"[^>]*>[^<]*<\/div>/,'')
  .replace(/<button[^>]*key\('add:50000'\)[^>]*>[^<]*<\/button>/,'')
  .replace(/(<div class="h1">[^<]*<\/div><div class="mu" style="font-size:14px;margin-top:8px">)[^<]*(<\/div>)/,'$1'+who+'$2');
 return h+MARK};
/* the check sheet */
const ly=document.getElementById('layer');
new MutationObserver(()=>{const sh=ly.querySelector('.sheet[aria-label="Confirm"]:not([data-v267])');if(!sh||!sh.querySelector('button[onclick="finish()"]'))return;
 sh.dataset.v267='1';
 const f=sh.querySelector(':scope>.fine');if(f)f.remove();
 const big=sh.querySelector('.big'),w=big&&big.nextElementSibling;if(w&&/RWF/.test(w.textContent)&&!w.classList.contains('mu')&&!w.querySelector('svg'))w.remove();
 const fee=[...sh.querySelectorAll(':scope>div')].find(e=>/margin:20px 0 18px/.test(e.getAttribute('style')||''));
 if(fee){const bs=[...fee.querySelectorAll('b')];if(bs.length&&bs.every(b=>/^0(\s|$)/.test(b.textContent.trim()))){fee.remove();const bal=[...sh.querySelectorAll(':scope>.mu')].find(e=>/margin:-6px 0 18px/.test(e.getAttribute('style')||''));if(bal)bal.style.margin='14px 0 18px'}}
 if(!S.flagged){const gb=sh.querySelector('button.sec2[onclick="closeSheet()"]');if(gb)gb.remove()}
}).observe(ly,{childList:true,subtree:true});
document.title=document.title.replace(/v\d+/,'v267');
})();
</script>
<style id="v268css">
.v8pill{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:12px 18px;border-radius:24px;background:rgba(255,255,255,.2);color:#fff;font-weight:700;font-size:15px;border:0}
.v8pill.out{border:1.5px solid rgba(255,255,255,.75);background:rgba(0,0,0,.45);padding:14px 26px;font-size:16px}.v8chip{padding:9px 14px;border-radius:18px;background:rgba(255,255,255,.14);color:#fff;font-weight:600;font-size:13px;border:0;white-space:nowrap}
.v8cats{display:flex;gap:8px;overflow-x:auto;padding:14px 24px 0;scrollbar-width:none}.v8cats::-webkit-scrollbar{display:none}
.v8cat{flex:none;padding:10px 16px;border-radius:20px;background:var(--chip);color:var(--tx);font-weight:700;font-size:14px;border:0}
.v8cat.on{background:var(--tint);color:var(--tintfg)}
</style>
<script>
/* v268: ideas from the KakaoPay screens. (1) Scan screen: flash and close on top, headline above the frame, "Type in" and "From photos" under it, "My code" at the bottom, sample codes as small chips; it works for shops and for people. (2) Receive money ("My code"): a code with your picture in the middle, "Set an amount" to put an amount in the code, Save image, Copy link. (3) Send, who: a scan button beside Next, and a star on a contact to keep them at the top. (4) Split a bill in a chat: one page with bill type chips, the amount, and what each person pays, instead of a sheet with three fixed amounts. The sample codes are not real QR codes. */
(function(){
const T3=(a,b,c)=>({rw:b,fr:c}[S.lang]||a);
const esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const svg=(d,z,extra)=>`<svg width="${z||24}" height="${z||24}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" ${extra||''}>${d}</svg>`;
const X=svg('<path d="M6 6l12 12M18 6L6 18"/>'),FLASH=svg('<path d="M13 2L5 14h6l-1 8 8-12h-6z"/>'),SHARE=svg('<path d="M12 3v12M8 7l4-4 4 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7"/>'),PEN=svg('<path d="M4 20l4-1 11-11a2.1 2.1 0 00-3-3L5 16z"/>',18),IMG=svg('<rect x="3" y="4" width="18" height="16" rx="3"/><circle cx="9" cy="10" r="1.6"/><path d="M4 18l5-5 4 4 3-3 4 4"/>',20),STAR=f=>svg('<path d="M12 3.5l2.6 5.4 5.9.8-4.3 4.1 1 5.9L12 16.9l-5.2 2.8 1-5.9L3.5 9.7l5.9-.8z"/>',24,f?'fill="#F5B400" stroke="#F5B400"':'');
const keysHtml=fn=>`<div class="keys" style="position:absolute;left:0;right:0;bottom:104px">${['1','2','3','4','5','6','7','8','9','00','0','⌫'].map(k=>`<button onclick="${fn}('${k}')" aria-label="${k==='⌫'?'Delete':k}">${k==='⌫'?svg('<path d="M20 6H9l-5 6 5 6h11zM12 10l4 4M16 10l-4 4"/>',26):k}</button>`).join('')}</div>`;
/* ---------- scan ---------- */
const _ps=screens.paysc,_g=window.ppGo;
window.ppGo=n=>{if(n==='paysc')S.scanFor='pay';_g(n)};
window.sendScan=()=>{S.scanFor='send';S.stack.push('paysc');render('push')};
screens.paysc=()=>{const o=_ps(),fr=(o.match(/<div class="fr">[\s\S]*?<div class="ln"><\/div><\/div>/)||[''])[0],
 shops=[...o.matchAll(/ppMerch\('(\d+)'\)[\s\S]*?<span style="flex:1">([^<]*)<\/span>/g)].map(m=>[m[1],m[2]]);
 const send=S.scanFor==='send';
 return `<div class="ppv"><div style="position:absolute;top:0;left:0;right:0;display:flex;align-items:center;justify-content:space-between;padding:12px 8px;z-index:2"><button class="ib" aria-label="${T3('Flash','Itara','Flash')}" onclick="scFlash(this)" style="color:#fff;opacity:.6">${FLASH}</button><button class="ib" aria-label="${T3('Close','Funga','Fermer')}" onclick="back()" style="color:#fff">${X}</button></div>
<div style="position:absolute;left:0;right:0;top:84px;text-align:center;padding:0 24px"><div style="font-size:21px;font-weight:800">${send?T3('Scan a code to send','Sikana kode kugira wohereze','Scannez un code pour envoyer'):T3('Scan a QR code','Sikana kode ya QR','Scannez un code QR')}</div><div style="font-size:14px;opacity:.8;margin-top:6px">${T3('Shops and friends both work.','Abacuruzi n’inshuti byose bikora.','Commerçants et amis fonctionnent.')}</div></div>
${fr}
<div style="position:absolute;left:0;right:0;top:calc(34% + 150px);display:flex;gap:10px;justify-content:center"><button class="v8pill" onclick="scType()">${svg('<path d="M4 20l4-1 11-11a2.1 2.1 0 00-3-3L5 16z"/>',20)}${T3('Type in','Andika','Saisir')}</button><button class="v8pill" onclick="toast('${T3('The photo picker is not in this prototype.','Guhitamo ifoto ntibirimo muri iyi prototype.','Le sélecteur de photos n’est pas dans ce prototype.')}')">${IMG}${T3('From photos','Mu mafoto','Depuis les photos')}</button></div>
<div style="position:absolute;left:0;right:0;bottom:104px;padding:0 20px"><div style="font-size:12px;font-weight:700;opacity:.65;margin-bottom:8px">${T3('Try a sample code (prototype)','Gerageza kode y’icyitegererezo','Essayez un code d’exemple')}</div><div style="display:flex;flex-wrap:wrap;gap:8px"><button class="v8chip" onclick="scPerson('0788 000 214')">Amina K.</button>${shops.map(([k,n])=>`<button class="v8chip" onclick="ppMerch('${k}')">${esc(n)}</button>`).join('')}</div></div>
<div style="position:absolute;left:0;right:0;bottom:28px;text-align:center"><button class="v8pill out" onclick="S.stack.push('rcode');render('push')">${gx('qr',24)}${T3('My code','Kode yanjye','Mon code')}</button></div></div>`};
window.scFlash=b=>{b.style.opacity=b.style.opacity==='1'?'.6':'1'};
window.scType=()=>{if(S.scanFor==='send'){back()}else{S.stack[S.stack.length-1]='paytill';render('fade-none')}};
window.scPerson=p=>{S.to=p;S.flagged=false;S.stack[S.stack.length-1]='amount';render('push')};
/* ---------- receive money ---------- */
S.rc=S.rc||{amt:'',tmp:''};
function qr(seed,z){const N=25,c=8;let s=seed;const rnd=()=>{s=(s*1664525+1013904223)>>>0;return s/4294967296},g=[];
 for(let y=0;y<N;y++){g[y]=[];for(let x=0;x<N;x++)g[y][x]=rnd()<.5}
 const fin=(ox,oy)=>{for(let i=-1;i<8;i++)for(let j=-1;j<8;j++){const x=ox+i,y=oy+j;if(x>=0&&y>=0&&x<N&&y<N)g[y][x]=false}for(let y=0;y<7;y++)for(let x=0;x<7;x++)g[oy+y][ox+x]=x===0||y===0||x===6||y===6||(x>=2&&x<=4&&y>=2&&y<=4)};
 fin(0,0);fin(N-7,0);fin(0,N-7);
 for(let y=0;y<N;y++)for(let x=0;x<N;x++)if(Math.abs(x-12)<=4&&Math.abs(y-12)<=4)g[y][x]=false;
 let d='';for(let y=0;y<N;y++)for(let x=0;x<N;x++)if(g[y][x])d+=`M${x*c} ${y*c}h${c}v${c}h-${c}z`;
 const ini=esc((S.name||'You').trim()[0]||'Y').toUpperCase();
 return `<svg viewBox="0 0 ${N*c} ${N*c}" width="${z}" height="${z}" role="img" aria-label="${T3('Your receive code (sample)','Kode yawe yo kwakira (icyitegererezo)','Votre code de réception (exemple)')}"><rect width="${N*c}" height="${N*c}" fill="#fff"/><path d="${d}" fill="#111"/><circle cx="100" cy="100" r="30" fill="#fff"/><circle cx="100" cy="100" r="25" fill="#7472F4"/><text x="100" y="108" text-anchor="middle" font-size="24" font-weight="800" fill="#fff" font-family="sans-serif">${ini}</text></svg>`}
screens.rcode=()=>{const a=Number(S.rc.amt||0);
 return `<div class="bar"><button class="ib" aria-label="Back" onclick="back()">${ic('back',24)}</button><span style="flex:1"></span><button class="ib" aria-label="${T3('Share','Sangiza','Partager')}" onclick="toast('${T3('Shared (prototype)','Byasangijwe (prototype)','Partagé (prototype)')}')">${SHARE}</button></div>
<div class="pad" style="padding-top:12px"><div class="h1">${T3('Receive money','Akira amafaranga','Recevoir de l’argent')}</div><div class="mu" style="font-size:15px;margin-top:8px">${T3('Show this code to the other person.','Erekana iyi kode ku wundi muntu.','Montrez ce code à l’autre personne.')}</div></div>
<div style="margin:22px 24px 0;padding:22px 16px 18px;border-radius:28px;background:var(--chip);text-align:center"><div style="display:inline-block;padding:10px;border-radius:18px;background:#fff;line-height:0">${qr(a+104729,210)}</div>
<div style="margin-top:14px;font-size:17px;font-weight:800">${esc(S.name||'You')}</div><div class="sm mu" style="margin-top:2px">itunda Pay · 0788-1205-1980</div>
<button class="tap" onclick="S.rc.tmp=S.rc.amt;S.stack.push('rcamt');render('push')" style="margin-top:14px;border:0;background:none;color:${a?'var(--tx)':'var(--tt)'};font:inherit;font-size:${a?24:17}px;font-weight:800;display:inline-flex;align-items:center;gap:8px">${a?fmt(a)+' RWF':T3('Set an amount','Shyiraho amafaranga','Définir un montant')}${PEN}</button></div>
<div class="pad row2" style="padding-top:16px"><button class="btn sec2" onclick="toast('${T3('Image saved (prototype)','Ifoto yabitswe (prototype)','Image enregistrée (prototype)')}')">${T3('Save image','Bika ifoto','Enregistrer l’image')}</button><button class="btn sec2" onclick="rcCopy()">${T3('Copy link','Kopera link','Copier le lien')}</button></div>
<div class="pad fine" style="padding-top:12px">${T3('Sample code, not a real one.','Kode y’icyitegererezo, si iyukuri.','Code d’exemple, pas un vrai.')}</div>`};
window.rcCopy=()=>{try{navigator.clipboard.writeText('https://itunda.rw/pay/0788-1205-1980'+(S.rc.amt?'?amount='+S.rc.amt:'')).catch(()=>{})}catch(e){}toast(T3('Link copied','Link yakoporowe','Lien copié'))};
const rcBody=()=>{const v=Number(S.rc.tmp||0);return `<div style="font-size:30px;line-height:40px;letter-spacing:-.4px"><b>${v?fmt(v)+' RWF':T3('How much','Ni angahe','Combien')}</b> <span class="mu">${T3('to receive?','ushaka kwakira?','à recevoir ?')}</span></div><div style="margin-top:16px;display:flex;gap:8px;flex-wrap:wrap">${[1000,5000,10000].map(n=>`<button class="chip" onclick="rcKey('add:${n}')">+${fmt(n)}</button>`).join('')}</div>`};
screens.rcamt=()=>`${bar('')}<div id="rcb" style="padding:20px 24px 0">${rcBody()}</div>${keysHtml('rcKey')}<div class="cta"><button class="btn" onclick="S.rc.amt=S.rc.tmp;back()">${S.rc.tmp&&Number(S.rc.tmp)?T3('Set amount','Shyiraho','Valider'):T3('No amount','Nta mafaranga','Sans montant')}</button></div>`;
window.rcKey=k=>{const r=S.rc;k=String(k);if(k.startsWith('add:'))r.tmp=String(Math.min(Number(r.tmp||0)+Number(k.slice(4)),99999999));else if(k==='⌫')r.tmp=(r.tmp||'').slice(0,-1);else if((r.tmp||'').length<8)r.tmp=((r.tmp||'')+k).replace(/^0+/,'');const b=$('#rcb');if(b)b.innerHTML=rcBody();const c=document.querySelector('.cta .btn');if(c)c.textContent=Number(r.tmp||0)?T3('Set amount','Shyiraho','Valider'):T3('No amount','Nta mafaranga','Sans montant')};
/* ---------- send: who ---------- */
S.fav=S.fav||{};
window.favT=d=>{S.fav[d]=!S.fav[d];render('fade-none')};
const _r=screens.recipient;
screens.recipient=()=>{let h=_r();const rows=[];
 h=h.replace(/<div class="row tap" onclick="pick\('([\d ]+)',(\d)\)"[^>]*>[\s\S]*?<div class="s">[\d ]+<\/div><\/div><\/div>/g,(m,num)=>{const d=num.replace(/\D/g,''),f=!!S.fav[d];
  rows.push([f,m.replace(/<\/div>$/,`<button class="ib" aria-label="${T3('Favourite','Ukunda','Favori')}" aria-pressed="${f}" onclick="event.stopPropagation();favT('${d}')" style="margin-left:auto;color:${f?'#F5B400':'var(--tt)'}">${STAR(f)}</button></div>`)]);return '\u0001ROW\u0001'});
 const sorted=[...rows.filter(r=>r[0]),...rows.filter(r=>!r[0])];let i=0;h=h.replace(/\u0001ROW\u0001/g,()=>sorted[i++][1]);
 return h.replace(/<div class="cta">(<button class="btn"[^>]*>[^<]*<\/button>)<\/div>/,(m,b)=>`<div class="cta" style="display:flex;gap:12px"><button class="btn sec2" aria-label="${T3('Scan a code','Sikana kode','Scanner un code')}" onclick="sendScan()" style="width:68px!important;min-width:68px;flex:0 0 68px!important;padding:0!important;display:flex;align-items:center;justify-content:center">${ic('qr',24)}</button>${b.replace('class="btn"','class="btn" style="flex:1 1 auto!important;width:auto!important"')}</div>`)};
/* ---------- split a bill in a chat ---------- */
const CATS=()=>[['Meal',T3('Meal','Ifunguro','Repas')],['Coffee',T3('Coffee','Ikawa','Café')],['Snack',T3('Snack','Agafunguro','Snack')],['Drinks',T3('Drinks','Ibinyobwa','Boissons')],['Transport',T3('Transport','Ingendo','Transport')]];
window.splitSheet=()=>{closeSheet();S.sp={amt:'',cat:''};S.stack.push('split');render('push')};
const who=()=>{try{return thr().n}catch(e){return T3('Friend','Inshuti','Ami')}};
const shares=v=>{const o=Math.round(v/2);return [v-o,o]};
function spRows(){const v=Number(S.sp.amt||0),[me,ot]=shares(v),av=n=>`<div style="width:44px;height:44px;border-radius:22px;background:var(--tint);color:var(--tintfg);display:flex;align-items:center;justify-content:center;font-weight:800;font-size:17px;flex:none">${esc(n)[0]}</div>`;
 return [[T3('You','Wowe','Vous'),me],[who(),ot]].map(([n,a])=>`<div style="display:flex;align-items:center;gap:14px;padding:10px 24px">${av(n)}<div style="flex:1;font-size:17px;font-weight:700">${esc(n)}</div><b style="font-size:17px">${fmt(a)} RWF</b></div>`).join('')}
screens.split=()=>{const v=Number(S.sp.amt||0);
 return `${bar('')}<div class="pad" style="padding-top:0"><div class="h1">${T3('Split a bill','Gabana fagitire','Partager une addition')}</div></div>
<div class="v8cats">${CATS().map(([k,n])=>`<button class="v8cat ${S.sp.cat===k?'on':''}" onclick="S.sp.cat=S.sp.cat==='${k}'?'':'${k}';render('fade-none')">${n}</button>`).join('')}</div>
<div style="margin:16px 24px 0;padding:16px 18px;border-radius:20px;background:var(--chip)"><div class="sm mu">${T3('How much was the bill?','Fagitire yari angahe?','Combien était l’addition ?')}</div><div id="spa" style="font-size:34px;font-weight:800;letter-spacing:-1px;margin-top:2px">${fmt(v)} RWF</div></div>
<div class="sec" style="padding-top:16px"><div class="sech">${T3('Each pays','Buri wese yishyura','Chacun paie')}</div></div><div id="spr">${spRows()}</div>
${keysHtml('spKey')}<div class="cta"><button id="spb" class="btn" ${v?'':'disabled'} onclick="spGo()">${T3('Send split request','Ohereza ubusabe bwo kugabana','Envoyer la demande')}</button></div>`};
window.spKey=k=>{const p=S.sp;k=String(k);if(k==='⌫')p.amt=p.amt.slice(0,-1);else if(p.amt.length<8)p.amt=(p.amt+k).replace(/^0+/,'');const v=Number(p.amt||0);$('#spa').textContent=fmt(v)+' RWF';$('#spr').innerHTML=spRows();$('#spb').disabled=!v};
window.spGo=()=>{const p=S.sp,v=Number(p.amt||0);if(!v)return;S.msgs[S.chat].push(['split',v,false,p.cat||'']);back();setTimeout(()=>{if(typeof chatEnd==='function')chatEnd()},60)};
if(screens.chat){const _c=screens.chat;screens.chat=()=>{let h=_c();const sp=((S.msgs||{})[S.chat]||[]).filter(m=>m[0]==='split');let k=0;return h.replace(/>Split a bill<\/div>/g,()=>{const m=sp[k++];return '>'+(m&&m[3]?esc(m[3])+' · '+T3('split','kugabana','partage'):'Split a bill')+'</div>'})}}
document.title=document.title.replace(/v\d+/,'v269');
})();
</script>
<script id="v270">
/* v270: no "Step N of M" wording in the flows. Pages lead straight on; the thin progress bars stay, screen-reader labels stay. Trip directions ("Step 1/5" on the nav screen) are left as they are. */
(function(){
const RX=/^\s*(?:Step|\u00c9tape|Etape|Intambwe)\s*\d+\s*(?:of|sur|kuri)\s*\d+\s*(?:[\u00b7\u2022:\-\u2013\u2014]\s*)?/i;
function clean(){
  const ph=document.getElementById('phone');if(!ph)return;
  const w=document.createTreeWalker(ph,NodeFilter.SHOW_TEXT);const hit=[];let n;
  while(n=w.nextNode()){if(RX.test(n.nodeValue))hit.push(n)}
  hit.forEach(n=>{
    const el=n.parentElement;if(!el||el.closest('#nav,.navs,[data-nav]')||/\d\/\d/.test(n.nodeValue.slice(0,20)))return;
    let v=n.nodeValue.replace(RX,'');
    if(v)v=v.charAt(0).toUpperCase()+v.slice(1);
    n.nodeValue=v;
    if(!v.trim()&&!el.querySelector('svg,.sg,input,button,i')){
      el.style.display='none';
      const pr=el.parentElement;
      if(pr&&pr!==ph&&!pr.textContent.trim()&&!pr.querySelector('svg,.sg,input,button,i,img'))pr.style.display='none';
    }
  });
}
let q=0;const sched=()=>{if(q)return;q=requestAnimationFrame(()=>{q=0;clean()})};
new MutationObserver(sched).observe(document.getElementById('phone'),{childList:true,subtree:true});
sched();
document.title=document.title.replace(/v\d+/,'v270');
})();
</script>
<style id="v271css">
.s31h{margin:14px 24px 0;border-radius:28px;background:var(--tint);position:relative;overflow:hidden;height:300px}
.s31h svg{display:block;width:100%;height:100%}
.s31tip{position:absolute;left:14px;top:14px;max-width:128px;padding:8px 12px;border-radius:14px;background:var(--bg);font-size:13px;line-height:18px;font-weight:700}
.s31hl{position:absolute;right:6px;top:6px;border:0;background:none;color:var(--lk);font-weight:800;font-size:13px;padding:12px 10px}
.s31bn{transform-box:fill-box;transform-origin:50% 0;animation:s31sw 3.4s ease-in-out infinite alternate}
@keyframes s31sw{from{transform:rotate(-3deg)}to{transform:rotate(3deg)}}
@media (prefers-reduced-motion:reduce){.s31bn{animation:none}}
.s31d{border-top:0}
.s31d summary{list-style:none;display:flex;justify-content:space-between;align-items:center;min-height:56px;font-size:17px;font-weight:700;cursor:pointer}
.s31d summary::-webkit-details-marker{display:none}
.s31d summary::after{content:"";width:8px;height:8px;border-right:2px solid var(--tt);border-bottom:2px solid var(--tt);transform:rotate(45deg);margin-right:4px;transition:transform .2s}
.s31d[open] summary::after{transform:rotate(-135deg)}
.s31d .b{padding:0 0 14px;font-size:14px;line-height:22px;color:var(--mu)}
</style>
<script id="v271">
/* v271: 31-day savings, ideas from the Toss savings screens. The page now sells the benefit first (a coffee bean hangs from a rope and comes down toward a cup as your streak grows, with the four bonus steps along the side), says in two plain points how it works, and keeps the details in folded sections. "Next" opens a short page that says how it will be set up (bonus, period, amount, where it is paid from) and asks whether you want a reminder after day 31. "Start saving" opens one sheet with only the agreement you need, then a "Streak started" page, then your bean coming down for day 1. No "Step N" wording anywhere. English, French and Kinyarwanda; the Kinyarwanda is new copy and needs native review. */
(function(){
const t3=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e;
const nb=s=>S.lang==='fr'?s.replace(/ ([?:!%])/g,'\u00a0$1'):s;
const TI=[[7,2],[14,4],[21,6],[31,10]],AM=[200,500,1000,2000];
const st=()=>S.dsv31=S.dsv31||{on:0,a:500,n:0,t:0,d:0,pick:500};
const keep=fn=>{const sc=document.querySelector('#phone .screen'),y=sc?sc.scrollTop:0;fn();const s2=document.querySelector('#phone .screen');if(s2)s2.scrollTop=y};
const T=()=>t3('31-day savings','Kuzigama iminsi 31','Épargne sur 31 jours');
const gI=(k,z)=>{try{return gl(k,z)}catch(e){return ''}};
const chip=(v,on)=>'<button class="chip" aria-pressed="'+on+'" onclick="s31Pick('+v+')" style="min-width:64px;height:44px;border-radius:22px;border:0;padding:0 14px;font-size:15px;font-weight:800;background:'+(on?'var(--tx)':'var(--chip)')+';color:'+(on?'var(--bg)':'var(--tx)')+'">'+fmt(v)+'</button>';
const R=(a,v)=>'<div style="display:flex;justify-content:space-between;gap:12px;min-height:44px;align-items:center;font-size:15px"><span class="mu">'+a+'</span><b style="text-align:right">'+v+'</b></div>';
const Y0=64,Y1=186,by=n=>Math.round(Y0+Math.min(n,31)/31*(Y1-Y0));
function hero(n,tip,hist){
  const s=st(),from=by(s.pp==null?n:s.pp),to=by(n),fr=Math.min(n,31)/31;s.pp=n;
  const lbl=d=>t3('Day '+d,'Umunsi '+d,'Jour '+d);
  const rail=TI.map(([d,p])=>{const y=by(d),on=n>=d;return '<circle cx="296" cy="'+y+'" r="6" style="fill:'+(on?'var(--br)':'var(--bg)')+';stroke:'+(on?'var(--br)':'var(--ln)')+';stroke-width:2"/><text x="284" y="'+(y+4)+'" text-anchor="end" font-size="11" font-weight="700" style="fill:var(--mu)">'+lbl(d)+' \u00b7 '+p+'%</text>'}).join('');
  requestAnimationFrame(()=>requestAnimationFrame(()=>{const g=document.getElementById('s31b'),c=document.getElementById('s31f');if(g)g.style.transform='translateY('+to+'px)';if(c)c.style.transform='translateY('+Math.round((1-fr)*46)+'px)'}));
  const svg='<svg viewBox="0 0 342 300" role="img" aria-label="'+t3('A coffee bean on a rope above a cup, day '+n+' of 31','Ikawa ku mugozi hejuru y’igikombe, umunsi wa '+n+' kuri 31','Un grain de café suspendu au-dessus d’une tasse, jour '+n+' sur 31')+'"><defs><clipPath id="s31c"><path d="M125 236h92v10a46 46 0 0 1-46 40a46 46 0 0 1-46-40z"/></clipPath></defs>'
   +'<line x1="296" y1="'+Y0+'" x2="296" y2="'+Y1+'" style="stroke:var(--ln);stroke-width:2"/>'+rail
   +'<g clip-path="url(#s31c)"><rect x="120" y="236" width="102" height="50" style="fill:#F4F1FF"/><rect id="s31f" x="120" y="240" width="102" height="46" fill="#8B5E3C" style="transform:translateY('+Math.round((1-Math.min(n,31)/31)*46)+'px);transition:transform 1.1s cubic-bezier(.2,.8,.2,1)"/></g>'
   +'<path d="M125 236h92v10a46 46 0 0 1-46 40a46 46 0 0 1-46-40z" fill="none" stroke="#B9B1E8" stroke-width="3"/><path d="M217 248h8a12 12 0 0 1 0 24h-12" fill="none" stroke="#B9B1E8" stroke-width="3"/><rect x="108" y="228" width="126" height="8" rx="4" fill="#C9C2F2"/>'
   +'<g id="s31b" style="transform:translateY('+from+'px);transition:transform 1.1s cubic-bezier(.2,.8,.2,1)"><rect x="168.5" y="-420" width="5" height="396" fill="#C9A66B"/><g class="s31bn"><ellipse cx="171" cy="0" rx="21" ry="27" fill="#6F4E37"/><path d="M171-24c-9 10 9 14 0 24c-9 10 9 14 0 24" fill="none" stroke="#D2B48C" stroke-width="3" stroke-linecap="round"/></g></g></svg>';
  return '<div class="s31h">'+svg+(tip?'<div class="s31tip">'+nb(tip)+'</div>':'')+(hist?'<button class="s31hl" onclick="go(\'activity\')">'+t3('Savings history','Amateka yo kuzigama','Historique d’épargne')+'</button>':'')+'</div>';
}
const num=(g,t,sub,last)=>'<div style="display:flex;gap:14px"><div style="display:flex;flex-direction:column;align-items:center"><div style="width:36px;height:36px;display:flex;align-items:center;justify-content:center">'+gI(g,34)+'</div>'+(last?'':'<div style="width:2px;flex:1;min-height:18px;background:var(--ln);margin:6px 0"></div>')+'</div><div style="padding-bottom:'+(last?0:16)+'px"><div style="font-size:17px;font-weight:800;line-height:24px">'+nb(t)+'</div><div class="mu" style="font-size:14px;line-height:20px;margin-top:2px">'+nb(sub)+'</div></div></div>';
const det=(h,b)=>'<details class="s31d"><summary>'+h+'</summary><div class="b">'+nb(b)+'</div></details>';
const H2='font-size:16px;font-weight:800;padding:28px 24px 0';
function intro(){
  const s=st(),a=s.pick,bad=a>S.bank;
  return bar(T())
  +'<div class="pad" style="padding-top:18px"><div class="sm mu" style="font-weight:700">'+T()+'</div><div class="h1" style="margin-top:6px">'+nb(t3('Save a little each day, earn up to 10%','Zigama gake buri munsi, ubone kugeza kuri 10%','Épargnez un peu chaque jour, gagnez jusqu’à 10 %'))+'</div><div class="mu" style="font-size:15px;margin-top:8px;line-height:22px">'+nb(t3('Your bonus grows at day 7, 14, 21 and 31.','Igihembo cyawe kiyongera ku munsi wa 7, 14, 21 na 31.','Votre bonus augmente aux jours 7, 14, 21 et 31.'))+'</div></div>'
  +hero(0,t3('Reach the cup for the full 10% bonus','Gera ku gikombe ubone igihembo cyuzuye cya 10%','Atteignez la tasse pour le bonus complet de 10 %'),0)
  +'<div class="pad" style="padding-top:28px">'+num('money',t3('Save a little each day','Zigama gake buri munsi','Épargnez un peu chaque jour'),t3('Pick 200 to 2,000 RWF a day.','Hitamo hagati ya 200 na 2,000 RWF ku munsi.','Choisissez entre 200 et 2,000 RWF par jour.'),0)+num('flame',t3('Keep your streak going','Komeza iminsi ukurikiranya','Gardez votre série'),t3('Day 31 gets the full 10% bonus.','Umunsi wa 31 uguha igihembo cyuzuye cya 10%.','Le jour 31 donne le bonus complet de 10 %.'),1)+'</div>'
  +'<div style="'+H2+'">'+nb(t3('How much each day?','Ni angahe buri munsi?','Combien chaque jour ?'))+'</div><div style="padding:12px 24px 0"><div style="display:flex;gap:10px;flex-wrap:wrap" role="group" aria-label="'+t3('Daily amount','Amafaranga ya buri munsi','Montant par jour')+'">'+AM.map(v=>chip(v,v===a)).join('')+'</div><div class="sm" style="margin-top:12px;line-height:20px" aria-live="polite">'+(bad?'<span style="color:var(--er)">'+nb(t3('This is more than your itunda Bank balance of '+fmt(S.bank)+' RWF. Pick a smaller amount.','Ni menshi kurusha amafaranga ufite kuri itunda Bank angana na '+fmt(S.bank)+' RWF. Hitamo make kurushaho.','C’est plus que le solde de votre itunda Bank, qui est de '+fmt(S.bank)+' RWF. Choisissez un montant plus petit.'))+'</span>':'<span class="mu">'+t3('31 days \u00d7 '+fmt(a)+' = <b style="color:var(--tx)">'+fmt(a*31)+' RWF</b> \u00b7 itunda Bank balance '+fmt(S.bank)+' RWF','Iminsi 31 \u00d7 '+fmt(a)+' = <b style="color:var(--tx)">'+fmt(a*31)+' RWF</b> \u00b7 amafaranga kuri itunda Bank '+fmt(S.bank)+' RWF','31 jours \u00d7 '+fmt(a)+' = <b style="color:var(--tx)">'+fmt(a*31)+' RWF</b> \u00b7 solde itunda Bank '+fmt(S.bank)+' RWF')+'</span>')+'</div></div>'
  +'<div style="'+H2+'">'+t3('Good to know','Ibyiza kumenya','Bon à savoir')+'</div><div class="pad" style="padding-top:8px">'+num('history',t3('Missed a day?','Wasibye umunsi?','Un jour manqué ?'),t3('Your streak restarts, and what you saved stays yours.','Iminsi ukurikiranya yongera gutangira, ariko ibyo wazigamye ni ibyawe.','Votre série repart de zéro, et votre épargne reste à vous.'),0)+num('cashout',t3('Need it back?','Ukeneye kubisubirana?','Besoin de récupérer ?'),t3('Stop any time and take back what you saved.','Hagarika igihe cyose usubirane ibyo wazigamye.','Arrêtez quand vous voulez et reprenez votre épargne.'),1)+'</div>'
  +'<div class="pad" style="padding-top:20px">'
  +det(t3('Savings info','Amakuru ku kuzigama','Infos sur l’épargne'),t3('Save once a day from itunda Bank. You choose 200, 500, 1,000 or 2,000 RWF a day.','Zigama rimwe ku munsi uvanye kuri itunda Bank. Wihitiramo 200, 500, 1,000 cyangwa 2,000 RWF ku munsi.','Épargnez une fois par jour depuis itunda Bank. Vous choisissez 200, 500, 1,000 ou 2,000 RWF par jour.'))
  +det(t3('Bonus rates','Ibihembo','Taux de bonus'),t3('Day 7: 2%. Day 14: 4%. Day 21: 6%. Day 31: 10%. Rates are sample data.','Umunsi wa 7: 2%. Umunsi wa 14: 4%. Umunsi wa 21: 6%. Umunsi wa 31: 10%. Ibipimo ni ingero.','Jour 7 : 2 %. Jour 14 : 4 %. Jour 21 : 6 %. Jour 31 : 10 %. Taux d’exemple.'))
  +det(t3('Stopping early','Guhagarara hakiri kare','Arrêt anticipé'),t3('You can stop any time and take back what you saved. The bonus is paid only after day 31.','Ushobora guhagarara igihe cyose ugasubirana ibyo wazigamye. Igihembo gitangwa nyuma y’umunsi wa 31 gusa.','Vous pouvez arrêter à tout moment et reprendre votre épargne. Le bonus n’est versé qu’après le jour 31.'))
  +det(t3('Terms','Amabwiriza','Conditions'),t3('itunda Bank is not a licensed bank. Sample terms for this prototype.','itunda Bank si banki ifite uruhushya. Amabwiriza ni ingero muri iyi prototype.','itunda Bank n’est pas une banque agréée. Conditions d’exemple pour ce prototype.'))
  +'</div><div style="height:110px"></div><div class="cta"><button class="btn" '+(bad?'disabled ':'')+'onclick="s31Sum()">'+t3('Next','Komeza','Suivant')+'</button></div>';
}
const prev=screens.save31;
screens.save31=()=>{
  const s=st();if(!s.on)return intro();
  const h=prev(),i=h.indexOf('<div class="pad" style="padding-top:24px">'),n=s.n;
  const blk=hero(n,n>=31?t3('Your cup is full. Collect your bonus.','Igikombe cyawe cyuzuye. Akira igihembo cyawe.','Votre tasse est pleine. Récupérez votre bonus.'):t3('Reach the cup for the full 10% bonus','Gera ku gikombe ubone igihembo cyuzuye cya 10%','Atteignez la tasse pour le bonus complet de 10 %'),1)
   +(s.rem&&n<31?'<div class="pad sm mu" style="padding-top:12px">'+nb(t3('We will remind you after day 31.','Tuzakwibutsa nyuma y’umunsi wa 31.','Nous vous le rappellerons après le jour 31.'))+'</div>':'');
  return i>0?h.slice(0,i)+blk+h.slice(i):h+blk;
};
window.s31Sum=()=>{const s=st();if(s.pick>S.bank)return;s.q=undefined;go('s31sum')};
window.s31Q=v=>{st().q=v;keep(()=>render('fade-none'))};
screens.s31sum=()=>{
  const s=st(),a=s.pick,q=s.q;
  const ask=q===undefined;
  return bar('')
  +'<div class="pad" style="padding-top:12px"><div style="height:64px;display:flex;align-items:center">'+gI('coffee',56)+'</div><div class="h1" style="margin-top:14px">'+nb(t3('We’ll set it up like this','Dore uko tuzabitegura','Voici comment nous la mettons en place'))+'</div></div>'
  +'<div class="pad" style="padding-top:20px">'+R(t3('Bonus','Igihembo','Bonus'),nb(t3('Up to 10%','Kugeza kuri 10%','Jusqu’à 10 %')))+R(t3('Period','Igihe','Durée'),t3('31 days','Iminsi 31','31 jours'))+R(t3('Each day','Buri munsi','Chaque jour'),fmt(a)+' RWF')+R(t3('Paid from','Ava kuri','Prélevé sur'),'itunda Bank')+'</div>'
  +'<div style="height:1px;background:var(--ln);margin:14px 24px 0"></div>'
  +(ask?'<div class="pad" style="padding-top:28px"><div class="h1" style="font-size:22px;line-height:30px">'+nb(t3('Want a reminder to start another round after day 31?','Ushaka kwibutswa gutangira indi nyuma y’umunsi wa 31?','Un rappel pour recommencer après le jour 31 ?'))+'</div><div class="mu" style="font-size:15px;margin-top:8px;line-height:22px">'+t3('Nothing is saved for you without your say. You can change this any time.','Nta cyo tuzigama udahari. Ushobora kubihindura igihe cyose.','Rien n’est épargné sans votre accord. Vous pouvez changer cela à tout moment.')+'</div></div><div style="height:110px"></div><div class="cta"><div class="row2" style="display:grid;grid-template-columns:1fr 1fr"><button class="btn sec2" onclick="s31Q(0)">'+t3('No thanks','Oya, urakoze','Non merci')+'</button><button class="btn" onclick="s31Q(1)">'+t3('Remind me','Nyibutsa','Me rappeler')+'</button></div></div>'
   :'<div class="pad" style="padding-top:14px">'+R(t3('Reminder after day 31','Kwibutswa nyuma y’umunsi wa 31','Rappel après le jour 31'),q?t3('On','Birakora','Activé'):t3('Off','Ntibikora','Désactivé'))+'<a style="color:var(--lk);font-weight:700;font-size:14px" onclick="s31Q(undefined)">'+t3('Change','Hindura','Modifier')+'</a></div><div style="height:110px"></div><div class="cta"><button class="btn" onclick="s31Agree()">'+t3('Start saving','Tangira kuzigama','Commencer à épargner')+'</button></div>');
};
window.s31Agree=()=>{
  const s=st(),a=s.pick;if(a>S.bank)return;
  $('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="h1" style="font-size:22px;line-height:30px;margin-top:4px">'+nb(t3('Only the agreement you need','Amasezerano ukeneye gusa','Seulement l’accord nécessaire'))+'</div>'
  +'<div style="display:flex;gap:10px;align-items:center;margin-top:16px;font-weight:800;font-size:16px">'+ic('check',20,'var(--lk)')+'<span><span style="color:var(--lk)">'+t3('Required','Birakenewe','Obligatoire')+'</span> '+t3('31-day savings terms','Amabwiriza yo kuzigama iminsi 31','Conditions de l’épargne sur 31 jours')+'</span></div>'
  +'<div class="mu" style="font-size:14px;line-height:22px;margin:6px 0 0 30px">'+t3('Savings terms \u00b7 Bonus rules \u00b7 Stopping and taking back','Amabwiriza yo kuzigama \u00b7 Ibihembo \u00b7 Guhagarara no gusubirana','Conditions \u00b7 Règles du bonus \u00b7 Arrêt et récupération')+'</div>'
  +'<div style="margin-top:8px">'+R(t3('First save, today','Kuzigama bwa mbere, uyu munsi','Premier versement, aujourd’hui'),fmt(a)+' RWF')+'</div>'
  +'<div class="mu sm" style="margin:6px 0 18px;line-height:20px">'+nb(t3('If you do not fully understand something, it can be harder to sort out a dispute later. Sample terms for this prototype.','Nudasobanukirwa neza, gukemura ikibazo nyuma bishobora kugorana. Amabwiriza ni ingero muri iyi prototype.','Si vous ne comprenez pas bien un point, il peut être plus difficile de régler un litige plus tard. Conditions d’exemple pour ce prototype.'))+'</div>'
  +'<div class="row2" style="display:grid;grid-template-columns:1fr 1.8fr"><button class="btn sec2" onclick="closeSheet()">'+t3('Not now','Si ubu','Pas maintenant')+'</button><button class="btn" style="white-space:nowrap" onclick="s31Begin()">'+t3('Agree and save','Emera uzigame','Accepter et épargner')+'</button></div></div>';
  if(typeof focusSheet==='function')focusSheet();
};
window.s31Begin=()=>{
  const s=st(),a=s.pick;if(a>S.bank||s.on)return;const rem=s.q===1?1:0;
  window.s31Go();s.rem=rem;
  document.querySelectorAll('#phone .toast').forEach(x=>x.remove());
  S.stack.pop();S.stack.push('s31ok');render('fade');
};
screens.s31ok=()=>bar('')
  +'<div style="display:flex;flex-direction:column;align-items:center;text-align:center;padding:96px 28px 0"><div style="width:84px;height:84px;border-radius:42px;background:var(--lk);display:flex;align-items:center;justify-content:center">'+ic('check',44,'#fff')+'</div><div class="h1" style="margin-top:28px">'+nb(t3('Streak started. Aiming for 10%!','Watangiye! Intego ni 10%!','Série lancée. Cap sur 10 % !'))+'</div><div class="mu" style="font-size:16px;margin-top:12px;line-height:24px">'+nb(t3('Your first day is saved. Tap Next to see your bean.','Umunsi wa mbere wabitswe. Kanda Komeza urebe ikawa yawe.','Votre premier jour est enregistré. Touchez Suivant pour voir votre grain.'))+'</div></div><div class="cta"><button class="btn" onclick="s31Done()">'+t3('Next','Komeza','Suivant')+'</button></div>';
window.s31Done=()=>{S.stack.pop();render('fade')};
document.title=document.title.replace(/v\d+/,'v272');
})();
</script>
<script>
/* v272: Statement is a full screen. Period and format chips on top, Download in a fixed bottom bar (Toss style). */
(()=>{
const L=(e,r,f)=>({en:e,rw:r||e,fr:f||e}[S.lang]||e);
S.bs=S.bs||{per:'This month',fm:'CSV'};
const per=[['This month','Uku kwezi','Ce mois-ci'],['Last 3 months','Amezi 3 ashize','3 derniers mois'],['This year','Uyu mwaka','Cette année']];
const chip=(a,cur,fn)=>`<div class="req" role="radiogroup" style="margin-top:12px">${a.map(x=>`<button role="radio" aria-checked="${cur===x[0]}" class="${cur===x[0]?'on':''}" onclick="${fn}('${x[0]}')">${L(...x)}</button>`).join('')}</div>`;
const lab=t=>`<div style="font-size:15px;font-weight:800;margin-top:28px">${t}</div>`;
screens.bkstmt=()=>{const B=S.bs;
return `${bar(L('Statement','Raporo','Relevé'))}<div class="pad" style="padding-top:12px"><div class="h1">${L('Choose a period and format.','Hitamo igihe n’ubwoko.','Choisissez la période et le format.')}</div>${lab(L('Period','Igihe','Période'))}${chip(per,B.per,'bkSP')}${lab(L('Format','Ubwoko','Format'))}${chip([['CSV'],['PDF']],B.fm,'bkSF')}<div class="fine" style="margin-top:24px">${L('Sample data for this prototype.','Amakuru y’icyitegererezo.','Données d’exemple pour ce prototype.')}</div></div><div style="height:110px"></div><div class="cta"><button class="btn" onclick="bkStmtGo()">${L('Download','Manura','Télécharger')}</button></div>`};
window.bkStmt=()=>{S.stack.push('bkstmt');render('push')};
window.bkSP=p=>{S.bs.per=p;render('fade-none')};
window.bkSF=f=>{S.bs.fm=f;render('fade-none')};
const old=window.bkStmtGo;
window.bkStmtGo=()=>{
 if(S.bs.fm==='PDF'){toast(L('PDF export is not in this prototype. Try CSV.','PDF ntiri muri prototype. Gerageza CSV.','Export PDF indisponible. Essayez CSV.'));return}
 const q=v=>'"'+String(v).replace(/"/g,'""')+'"',rows=[['Description','Detail','Amount (RWF)','Type'],...S.act.map(x=>[x[1],x[2],x[3],x[4]||''])];
 const csv=rows.map(r=>r.map(q).join(',')).join('\n');
 try{const b=new Blob(['\ufeff'+csv],{type:'text/csv'}),a=document.createElement('a');a.href=URL.createObjectURL(b);a.download='itunda-statement.csv';document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(a.href),2000);toast(L('Statement downloaded','Raporo yamanuwe','Relevé téléchargé'));back()}catch(e){toast(L('Download is blocked here','Gukuramo bibujijwe hano','Téléchargement bloqué'))}
};
})();
</script>
<script>
/* v273: Deposit is a full screen. Big amount field, quick-add chips, source rows, balance preview, Deposit in a fixed bottom bar. */
(()=>{
const L=(e,r,f)=>({en:e,rw:r||e,fr:f||e}[S.lang]||e);
const MIN=1000,MAX=2000000;
S.bd=S.bd||{src:'MTN MoMo',amt:20000};
const srcs=[['MTN MoMo','#FFCC00'],['Airtel Money','#E40000']];
const lab=t=>`<div style="font-size:15px;font-weight:800;margin-top:28px">${t}</div>`;
const msg=a=>a>MAX?L('The most you can deposit at once is '+fmt(MAX)+' RWF.','Ntushobora gubika ibirenze '+fmt(MAX)+' RWF icyarimwe.','Maximum '+fmt(MAX)+' RWF par dépôt.')
 :a>0&&a<MIN?L('The least you can deposit is '+fmt(MIN)+' RWF.','Ntoya ni '+fmt(MIN)+' RWF.','Minimum '+fmt(MIN)+' RWF.')
 :L('Free and instant.','Ni ubuntu kandi bihita.','Gratuit et instantané.');
const ok=a=>a>=MIN&&a<=MAX;
const btn=a=>ok(a)?L('Deposit ','Bika ','Déposer ')+fmt(a)+' RWF':L('Enter an amount','Andika amafaranga','Saisissez un montant');
screens.bkdep=()=>{const D=S.bd;
return `${bar(L('Deposit to itunda Bank','Bika kuri itunda Bank','Déposer sur itunda Bank'))}<div class="pad" style="padding-top:12px">
<div class="sm mu">${L('Amount','Amafaranga','Montant')}</div>
<div style="display:flex;align-items:baseline;gap:8px;margin-top:6px"><input id="bkdA" inputmode="numeric" autocomplete="off" aria-label="${L('Amount in RWF','Amafaranga muri RWF','Montant en RWF')}" value="${D.amt?fmt(D.amt):''}" placeholder="0" oninput="bkDI(this)" style="flex:1;min-width:0;border:0;outline:0;background:none;font:inherit;font-size:40px;font-weight:800;letter-spacing:-1px;color:var(--tx);padding:0"><b style="font-size:20px;color:var(--tt)">RWF</b></div>
<div id="bkdM" class="sm" aria-live="polite" style="margin-top:6px;min-height:20px;color:${D.amt>MAX||(D.amt>0&&D.amt<MIN)?'var(--er)':'var(--tt)'}">${msg(D.amt)}</div>
<div class="req" style="margin-top:14px">${[10000,20000,50000,100000].map(x=>`<button onclick="bkDQ(${x})">+${fmt(x)}</button>`).join('')}</div>
${lab(L('From','Uvuye','Depuis'))}
<div style="margin-top:6px">${srcs.map(([n,c])=>`<div class="row tap" role="radio" aria-checked="${D.src===n}" tabindex="0" onclick="bkDS('${n}')" style="padding-left:0;padding-right:0"><span style="width:40px;height:40px;border-radius:20px;background:${c};flex-shrink:0"></span><div style="flex:1;margin-left:14px"><div class="t" style="font-size:16px">${n}</div></div><div class="ck ${D.src===n?'on':''}">${ic('check',18,D.src===n?'#17171C':'var(--tt)')}</div></div>`).join('')}</div>
<div style="margin-top:18px;padding:14px 16px;border-radius:16px;background:var(--chip);display:flex;justify-content:space-between;font-size:15px"><span class="mu">${L('Bank balance after','Amafaranga nyuma','Solde après')}</span><b id="bkdB">${fmt(S.bank+(ok(D.amt)?D.amt:0))} RWF</b></div>
<div class="fine" style="margin-top:14px">${L('Sample deposit. No real money moves.','Icyitegererezo. Nta mafaranga yimuwe.','Dépôt d’exemple. Aucun argent réel.')}</div></div>
<div style="height:110px"></div><div class="cta"><button class="btn" id="bkdG" onclick="bkDepGo()" ${ok(D.amt)?'':'disabled'}>${btn(D.amt)}</button></div>`};
const sync=()=>{const D=S.bd,m=document.getElementById('bkdM'),g=document.getElementById('bkdG'),b=document.getElementById('bkdB');
 if(m){m.textContent=msg(D.amt);m.style.color=D.amt>MAX||(D.amt>0&&D.amt<MIN)?'var(--er)':'var(--tt)'}
 if(g){g.disabled=!ok(D.amt);g.textContent=btn(D.amt)}
 if(b)b.textContent=fmt(S.bank+(ok(D.amt)?D.amt:0))+' RWF'};
window.bkDI=el=>{const n=Math.min(parseInt(el.value.replace(/\D/g,''),10)||0,99999999);S.bd.amt=n;el.value=n?fmt(n):'';sync()};
window.bkDQ=n=>{S.bd.amt=Math.min((S.bd.amt||0)+n,99999999);const i=document.getElementById('bkdA');if(i)i.value=fmt(S.bd.amt);sync()};
window.bkDS=s=>{S.bd.src=s;render('fade-none');const i=document.getElementById('bkdA');if(i&&S.bd.amt)i.blur()};
window.bkDep=()=>{S.stack.push('bkdep');render('push')};
window.bkDepGo=()=>{const D=S.bd;if(!ok(D.amt))return;S.bank+=D.amt;addAct('up','Deposit · '+D.src,'Received',D.amt,'Received');back();toast(L('Deposited ','Byabikijwe ','Déposé ')+fmt(D.amt)+' RWF')};
})();
</script>
<script>
/* v274: Move money is a full screen. From/To card with swap, big amount field, quick chips incl. "All", balances after, Move in a fixed bottom bar. */
(()=>{
const L=(e,r,f)=>({en:e,rw:r||e,fr:f||e}[S.lang]||e);
S.bm=S.bm||{dir:'out',amt:5000};
const names=d=>d==='out'?['itunda Bank','itunda Pay']:['itunda Pay','itunda Bank'];
const avail=()=>S.bm.dir==='out'?S.bank:S.pay;
const ok=()=>S.bm.amt>0&&S.bm.amt<=avail();
const msg=()=>S.bm.amt>avail()?t('insuff').replace('%s',fmt(avail())):L('Available','Bihari','Disponible')+' · '+fmt(avail())+' RWF';
const btn=()=>ok()?L('Move ','Imura ','Transférer ')+fmt(S.bm.amt)+' RWF':L('Enter an amount','Andika amafaranga','Saisissez un montant');
const after=()=>{const M=S.bm,v=ok()?M.amt:0,b=S.bank+(M.dir==='out'?-v:v),p=S.pay+(M.dir==='out'?v:-v);return [['itunda Bank',b],['itunda Pay',p]]};
const rows=()=>after().map(([n,v])=>`<div style="display:flex;justify-content:space-between;font-size:15px;padding:6px 0"><span class="mu">${n}</span><b>${fmt(v)} RWF</b></div>`).join('');
screens.bkmove=()=>{const M=S.bm,[a,b]=names(M.dir);
return `${bar(L('Move money','Imura amafaranga','Transférer'))}<div class="pad" style="padding-top:12px">
<div style="display:flex;align-items:center;gap:10px"><div style="flex:1;padding:14px 16px;border-radius:16px;background:var(--chip)"><div class="sm mu">${L('From','Uvuye','De')}</div><b style="font-size:16px">${a}</b></div>
<button class="ib" aria-label="${L('Swap direction','Guhindura icyerekezo','Inverser')}" onclick="bkMS()" style="background:var(--chip);border-radius:22px;flex-shrink:0">${ic('cyc',22)}</button>
<div style="flex:1;padding:14px 16px;border-radius:16px;background:var(--chip)"><div class="sm mu">${L('To','Ujya','Vers')}</div><b style="font-size:16px">${b}</b></div></div>
<div class="sm mu" style="margin-top:28px">${L('Amount','Amafaranga','Montant')}</div>
<div style="display:flex;align-items:baseline;gap:8px;margin-top:6px"><input id="bkmA" inputmode="numeric" autocomplete="off" aria-label="${L('Amount in RWF','Amafaranga muri RWF','Montant en RWF')}" value="${M.amt?fmt(M.amt):''}" placeholder="0" oninput="bkMI(this)" style="flex:1;min-width:0;border:0;outline:0;background:none;font:inherit;font-size:40px;font-weight:800;letter-spacing:-1px;color:var(--tx);padding:0"><b style="font-size:20px;color:var(--tt)">RWF</b></div>
<div id="bkmM" class="sm" aria-live="polite" style="margin-top:6px;min-height:20px;color:${M.amt>avail()?'var(--er)':'var(--tt)'}">${msg()}</div>
<div class="req" style="margin-top:14px">${[1000,5000,20000,50000].map(x=>`<button onclick="bkMQ(${x})">+${fmt(x)}</button>`).join('')}<button onclick="bkMAll()">${L('All','Byose','Tout')}</button></div>
<div style="margin-top:24px;padding:10px 16px;border-radius:16px;background:var(--chip)"><div class="sm mu" style="padding-top:4px">${L('Balances after','Amafaranga nyuma','Soldes après')}</div><div id="bkmB">${rows()}</div></div>
<div class="fine" style="margin-top:14px">${L('Free and instant. Your own money, between your own accounts.','Ni ubuntu kandi bihita. Amafaranga yawe, hagati ya konti zawe.','Gratuit et instantané, entre vos propres comptes.')}</div></div>
<div style="height:110px"></div><div class="cta"><button class="btn" id="bkmG" onclick="bkMoveGo()" ${ok()?'':'disabled'}>${btn()}</button></div>`};
const sync=()=>{const m=document.getElementById('bkmM'),g=document.getElementById('bkmG'),b=document.getElementById('bkmB');
 if(m){m.textContent=msg();m.style.color=S.bm.amt>avail()?'var(--er)':'var(--tt)'}
 if(g){g.disabled=!ok();g.textContent=btn()}
 if(b)b.innerHTML=rows()};
window.bkMI=el=>{const n=Math.min(parseInt(el.value.replace(/\D/g,''),10)||0,99999999);S.bm.amt=n;el.value=n?fmt(n):'';sync()};
window.bkMQ=n=>{S.bm.amt=Math.min((S.bm.amt||0)+n,99999999);const i=document.getElementById('bkmA');if(i)i.value=fmt(S.bm.amt);sync()};
window.bkMAll=()=>{S.bm.amt=avail();const i=document.getElementById('bkmA');if(i)i.value=S.bm.amt?fmt(S.bm.amt):'';sync()};
window.bkMS=()=>{S.bm.dir=S.bm.dir==='out'?'in':'out';render('fade-none')};
window.bkMove=()=>{S.stack.push('bkmove');render('push')};
window.bkMoveGo=()=>{const M=S.bm,v=M.amt;if(!ok())return;
 if(M.dir==='out'){S.bank-=v;S.pay+=v;addAct('cyc','Moved to itunda Pay','Transfer',-v,'Paid')}else{S.pay-=v;S.bank+=v;addAct('up','Moved to itunda Bank','Transfer',v,'Received')}
 back();toast(fmt(v)+' RWF '+L('moved','yimuwe','transférés'))};
})();
</script>
<script>
/* v275: Request money is a full screen. Big amount field, quick chips, optional note, live code card, Copy and Share in a fixed bottom bar. */
(()=>{
const L=(e,r,f)=>({en:e,rw:r||e,fr:f||e}[S.lang]||e);
const MIN=100,MAX=5000000;
S.rqAmt=S.rqAmt||5000;S.rqNote=S.rqNote||'';
const esc=s=>String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/"/g,'&quot;');
const ok=()=>S.rqAmt>=MIN&&S.rqAmt<=MAX;
const msg=()=>S.rqAmt>MAX?L('The most you can request is '+fmt(MAX)+' RWF.','Ntushobora gusaba ibirenze '+fmt(MAX)+' RWF.','Maximum '+fmt(MAX)+' RWF par demande.')
 :S.rqAmt>0&&S.rqAmt<MIN?L('The least you can request is '+fmt(MIN)+' RWF.','Ntoya ni '+fmt(MIN)+' RWF.','Minimum '+fmt(MIN)+' RWF.')
 :L('Whoever pays the code sends you this amount.','Uwishyura iyi code aguha aya mafaranga.','Qui paie ce code vous envoie ce montant.');
const text=()=>'Please pay me '+fmt(S.rqAmt)+' RWF on itunda. Code: '+reqCode()+(S.rqNote?' · '+S.rqNote:'');
const card=()=>ok()?`<div class="sm mu">${L('Request code','Code y’ubusabe','Code de demande')}</div><div style="font-size:24px;font-weight:800;letter-spacing:1px;margin-top:4px">${reqCode()}</div><div class="sm mu" style="margin-top:4px">${fmt(S.rqAmt)} RWF · ${L('valid 24 hours · sample code','ifite agaciro amasaha 24 · code y’icyitegererezo','valable 24 h · code d’exemple')}</div>`
 :`<div class="sm mu">${L('Request code','Code y’ubusabe','Code de demande')}</div><div style="font-size:24px;font-weight:800;margin-top:4px;color:var(--tt)">—</div><div class="sm mu" style="margin-top:4px">${L('Enter an amount to get a code','Andika amafaranga ubone code','Saisissez un montant pour obtenir un code')}</div>`;
screens.bkreq=()=>`${bar(t('rq'))}<div class="pad" style="padding-top:12px">
<div class="sm mu">${L('Amount','Amafaranga','Montant')}</div>
<div style="display:flex;align-items:baseline;gap:8px;margin-top:6px"><input id="rqA" inputmode="numeric" autocomplete="off" aria-label="${L('Amount in RWF','Amafaranga muri RWF','Montant en RWF')}" value="${S.rqAmt?fmt(S.rqAmt):''}" placeholder="0" oninput="rqI(this)" style="flex:1;min-width:0;border:0;outline:0;background:none;font:inherit;font-size:40px;font-weight:800;letter-spacing:-1px;color:var(--tx);padding:0"><b style="font-size:20px;color:var(--tt)">RWF</b></div>
<div id="rqM" class="sm" aria-live="polite" style="margin-top:6px;min-height:20px;color:${S.rqAmt>MAX||(S.rqAmt>0&&S.rqAmt<MIN)?'var(--er)':'var(--tt)'}">${msg()}</div>
<div class="req" style="margin-top:14px">${[2000,5000,10000,25000].map(x=>`<button onclick="rqQ(${x})">+${fmt(x)}</button>`).join('')}<button onclick="rqC()">${L('Clear','Siba','Effacer')}</button></div>
<div style="font-size:15px;font-weight:800;margin-top:28px">${L('Note (optional)','Icyitonderwa (si ngombwa)','Note (facultatif)')}</div>
<input id="rqN" class="in" maxlength="40" autocomplete="off" aria-label="${L('Note','Icyitonderwa','Note')}" placeholder="${L('For example, lunch','Urugero: ifunguro rya sasita','Par exemple, déjeuner')}" value="${esc(S.rqNote)}" oninput="S.rqNote=this.value.trim()" style="height:44px;font-size:16px;margin-top:6px">
<div id="rqK" style="margin-top:24px;background:var(--chip);border-radius:18px;padding:16px 18px">${card()}</div></div>
<div style="height:110px"></div><div class="cta" style="display:flex;gap:10px"><button class="btn sec2" id="rqCp" onclick="rqCopy()" ${ok()?'':'disabled'}>${L('Copy','Kopora','Copier')}</button><button class="btn" id="rqSh" onclick="rqShare()" ${ok()?'':'disabled'}>${L('Share request','Sangiza ubusabe','Partager la demande')}</button></div>`;
const sync=()=>{const m=document.getElementById('rqM'),k=document.getElementById('rqK');
 if(m){m.textContent=msg();m.style.color=S.rqAmt>MAX||(S.rqAmt>0&&S.rqAmt<MIN)?'var(--er)':'var(--tt)'}
 if(k)k.innerHTML=card();
 ['rqCp','rqSh'].forEach(i=>{const b=document.getElementById(i);if(b)b.disabled=!ok()})};
window.rqI=el=>{const n=Math.min(parseInt(el.value.replace(/\D/g,''),10)||0,99999999);S.rqAmt=n;el.value=n?fmt(n):'';sync()};
window.rqQ=n=>{S.rqAmt=Math.min((S.rqAmt||0)+n,99999999);const i=document.getElementById('rqA');if(i)i.value=fmt(S.rqAmt);sync()};
window.rqC=()=>{S.rqAmt=0;const i=document.getElementById('rqA');if(i){i.value='';i.focus()}sync()};
window.rqCopy=()=>{if(!ok())return;try{navigator.clipboard.writeText(text())}catch(e){}toast(L('Request copied','Ubusabe bwakopowe','Demande copiée'))};
window.rqShare=()=>{if(!ok())return;if(navigator.share){navigator.share({text:text()}).catch(()=>{})}else rqCopy()};
window.reqSheet=()=>{S.stack.push('bkreq');render('push')};
})();
</script>
<script>
/* v276: Buy airtime. One full screen for the mini app and Pay. Network auto-detected from the number, "My number" and recent numbers, big amount field, balance after, Buy in a fixed bottom bar. */
(()=>{
const L=(e,r,f)=>({en:e,rw:r||e,fr:f||e}[S.lang]||e);
const MIN=100,MAX=100000,MINE='0788000214';
S.air=S.air||{op:'MTN',ph:'',amt:1000,done:null,hist:[]};
const prev=screens.airtime;
const grp=p=>p.replace(/(\d{3})(\d{0,3})(\d{0,4})/,(m,a,b,c)=>[a,b,c].filter(Boolean).join(' '));
const dotc={MTN:'#FFCC00',Airtel:'#E40000'};
const okPh=()=>/^07\d{8}$/.test(S.air.ph);
const okAmt=()=>S.air.amt>=MIN&&S.air.amt<=MAX&&S.air.amt<=S.pay;
const ok=()=>okPh()&&okAmt();
const aMsg=()=>S.air.amt>MAX?L('The most you can buy at once is '+fmt(MAX)+' RWF.','Ntushobora kugura ibirenze '+fmt(MAX)+' RWF icyarimwe.','Maximum '+fmt(MAX)+' RWF par achat.')
 :S.air.amt>0&&S.air.amt<MIN?L('The least you can buy is '+fmt(MIN)+' RWF.','Ntoya ni '+fmt(MIN)+' RWF.','Minimum '+fmt(MIN)+' RWF.')
 :S.air.amt>S.pay?L('Not enough balance','Amafaranga ntahagije','Solde insuffisant')+' — RWF '+fmt(S.pay)
 :L('Airtime arrives in seconds.','Airtime ihita ihagera.','Le crédit arrive en quelques secondes.');
const aBad=()=>S.air.amt>MAX||(S.air.amt>0&&S.air.amt<MIN)||S.air.amt>S.pay;
const pMsg=()=>S.air.ph.length>=10&&!okPh()?L('Enter a number that starts with 07.','Andika nimero itangirira kuri 07.','Saisissez un numéro qui commence par 07.'):S.air.ph.length>0&&S.air.ph.length<10?(10-S.air.ph.length)+' '+L('more digits','imibare isigaye','chiffres restants'):'';
const btn=()=>ok()?L('Buy ','Gura ','Acheter ')+fmt(S.air.amt)+' RWF':!okPh()?L('Enter a phone number','Andika nimero ya telefoni','Saisissez un numéro'):L('Enter an amount','Andika amafaranga','Saisissez un montant');
const recents=()=>{const seen=[MINE],o=[];S.air.hist.forEach(h=>{if(!seen.includes(h[1])){seen.push(h[1]);o.push(h[1])}});return o.slice(0,3)};
const after=()=>fmt(S.pay-(ok()?S.air.amt:0))+' RWF';
screens.airtime=()=>{const A=S.air;if(A.done)return prev();
const rc=recents();
return `${bar(L('Buy airtime','Gura airtime','Acheter du crédit'))}<div class="pad" style="padding-top:12px">
<div class="sm mu">${L('Phone number','Nimero ya telefoni','Numéro de téléphone')}</div>
<input id="airph" class="in" inputmode="numeric" autocomplete="off" aria-label="${L('Phone number','Nimero ya telefoni','Numéro de téléphone')}" value="${grp(A.ph)}" placeholder="078 000 0000" oninput="airPh(this.value)" style="font-size:28px;font-weight:800;letter-spacing:-.5px;margin-top:4px">
<div id="airpm" class="sm" aria-live="polite" style="margin-top:6px;min-height:20px;color:var(--tt)">${pMsg()}</div>
<div class="req" style="margin-top:10px"><button onclick="airUse('${MINE}')">${L('My number','Nimero yanjye','Mon numéro')}</button>${rc.map(n=>`<button onclick="airUse('${n}')">${grp(n)}</button>`).join('')}</div>
<div style="font-size:15px;font-weight:800;margin-top:28px">${L('Network','Umuyoboro','Réseau')}</div>
<div class="req" id="airnet" role="radiogroup" style="margin-top:10px">${['MTN','Airtel'].map(o=>`<button role="radio" aria-checked="${A.op===o}" class="${A.op===o?'on':''}" data-o="${o}" onclick="airSet('op','${o}')" style="display:flex;align-items:center;gap:8px"><span style="width:12px;height:12px;border-radius:6px;background:${dotc[o]}"></span>${o}</button>`).join('')}</div>
<div class="sm mu" style="margin-top:28px">${L('Amount','Amafaranga','Montant')}</div>
<div style="display:flex;align-items:baseline;gap:8px;margin-top:6px"><input id="airA" inputmode="numeric" autocomplete="off" aria-label="${L('Amount in RWF','Amafaranga muri RWF','Montant en RWF')}" value="${A.amt?fmt(A.amt):''}" placeholder="0" oninput="airAI(this)" style="flex:1;min-width:0;border:0;outline:0;background:none;font:inherit;font-size:40px;font-weight:800;letter-spacing:-1px;color:var(--tx);padding:0"><b style="font-size:20px;color:var(--tt)">RWF</b></div>
<div id="airM" class="sm" aria-live="polite" style="margin-top:6px;min-height:20px;color:${aBad()?'var(--er)':'var(--tt)'}">${aMsg()}</div>
<div class="req" style="margin-top:14px">${[500,1000,2000,5000].map(x=>`<button onclick="airQ(${x})">+${fmt(x)}</button>`).join('')}<button onclick="airC()">${L('Clear','Siba','Effacer')}</button></div>
<div style="margin-top:24px;padding:14px 16px;border-radius:16px;background:var(--chip)"><div style="display:flex;justify-content:space-between;font-size:15px"><span class="mu">${L('Pay with','Ishyura na','Payer avec')}</span><b>itunda Pay</b></div><div style="display:flex;justify-content:space-between;font-size:15px;margin-top:8px"><span class="mu">${L('Balance after','Amafaranga nyuma','Solde après')}</span><b id="airB">${after()}</b></div></div></div>
<div style="height:110px"></div><div class="cta"><button id="airgo" class="btn" ${ok()?'':'disabled'} onclick="airPay()">${btn()}</button></div>`};
const sync=()=>{const m=document.getElementById('airM'),p=document.getElementById('airpm'),g=document.getElementById('airgo'),b=document.getElementById('airB');
 if(m){m.textContent=aMsg();m.style.color=aBad()?'var(--er)':'var(--tt)'}
 if(p)p.textContent=pMsg();
 if(g){g.disabled=!ok();g.textContent=btn()}
 if(b)b.textContent=after();
 document.querySelectorAll('#airnet button').forEach(x=>{const on=x.dataset.o===S.air.op;x.classList.toggle('on',on);x.setAttribute('aria-checked',on)})};
const detect=()=>{const p=S.air.ph.slice(0,3);if(p==='078'||p==='079')S.air.op='MTN';else if(p==='072'||p==='073')S.air.op='Airtel'};
window.airPh=v=>{S.air.ph=v.replace(/\D/g,'').slice(0,10);const i=document.getElementById('airph');if(i)i.value=grp(S.air.ph);detect();sync()};
window.airUse=n=>{S.air.ph=n;detect();render('fade-none')};
window.airSet=(k,v)=>{S.air[k]=v;sync()};
window.airAI=el=>{const n=Math.min(parseInt(el.value.replace(/\D/g,''),10)||0,99999999);S.air.amt=n;el.value=n?fmt(n):'';sync()};
window.airQ=n=>{S.air.amt=Math.min((S.air.amt||0)+n,99999999);const i=document.getElementById('airA');if(i)i.value=fmt(S.air.amt);sync()};
window.airC=()=>{S.air.amt=0;const i=document.getElementById('airA');if(i){i.value='';i.focus()}sync()};
const netOf=p=>/^07[89]/.test(p)?'MTN':/^07[23]/.test(p)?'Airtel':null;
window.airPay=go=>{const A=S.air;if(!ok())return;
 if(!go){const nt=netOf(A.ph),warn=nt&&nt!==A.op,row=(a,v)=>'<div style="display:flex;justify-content:space-between;gap:12px;min-height:40px;align-items:center;font-size:15px"><span class="mu">'+a+'</span><b style="text-align:right">'+v+'</b></div>';
  $('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="h1" style="font-size:22px;line-height:30px;margin-top:4px">'+L('Review airtime','Suzuma airtime','Vérifier le crédit')+'</div><div style="margin:12px 0 '+(warn?'8px':'22px')+'">'+row(L('Network','Umuyoboro','Réseau'),A.op)+row(L('Phone number','Nimero ya telefoni','Numéro de téléphone'),grp(A.ph))+row(L('Amount','Amafaranga','Montant'),fmt(A.amt)+' RWF')+row(L('Pay with','Ishyura na','Payer avec'),'itunda Pay')+row(L('Balance after','Amafaranga nyuma','Solde après'),fmt(S.pay-A.amt)+' RWF')+'</div>'+(warn?'<div class="sm" style="color:var(--er);margin-bottom:16px;line-height:19px">'+L('This number looks like an '+nt+' number, but you picked '+A.op+'. Airtime sent to the wrong network may not arrive.','Iyi nimero isa n’iya '+nt+', ariko wahisemo '+A.op+'. Airtime yoherejwe ku muyoboro utari wo ntishobora kugerayo.','Ce numéro semble être un numéro '+nt+', mais vous avez choisi '+A.op+'. Le crédit envoyé au mauvais réseau peut ne pas arriver.')+'</div>':'')+'<button class="btn" onclick="closeSheet();airPay(1)">'+L('Buy ','Gura ','Acheter ')+fmt(A.amt)+' RWF</button></div>';
  if(typeof focusSheet==='function')focusSheet();return}
 S.pay-=A.amt;A.hist.unshift([A.op,A.ph,A.amt]);A.done=[A.op,A.ph,A.amt];addAct('phone','Airtime · '+A.op,'Paid',-A.amt,'Paid');render('fade-none')};
window.ppAir=()=>{if(typeof closeSheet==='function')closeSheet();S.air.done=null;go('airtime')};
})();
</script>
<script>
/* v277: Pay bills on one screen. Biller chips that wrap (no side scroll), account number with live check, big amount field, balance after, Pay in a fixed bottom bar, localized confirm sheet and receipt. */
(()=>{
const L=(e,r,f)=>({en:e,rw:r||e,fr:f||e}[S.lang]||e);
const MIN=100;
const esc=s=>String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/"/g,'&quot;');
const nm={'REG electricity':['Electricity','Umuriro','Électricité'],'WASAC water':['Water','Amazi','Eau'],'RRA taxes':['Taxes','Imisoro','Impôts'],'School fees':['School fees','Amafaranga y’ishuri','Frais scolaires'],'Irembo':['Irembo','Irembo','Irembo']};
const name=k=>nm[k]?L(...nm[k]):k;
const lb={'Meter number':['Meter number',0,'Numéro de compteur'],'Water meter number':['Water meter number',0,'Numéro de compteur d’eau'],'Phone number':['Phone number','Nimero ya telefoni','Numéro de téléphone'],'Tax ID (TIN)':['Tax ID (TIN)',0,'N° d’identification fiscale (TIN)'],'Student ID':['Student ID',0,'Numéro d’étudiant'],'Application number':['Application number',0,'Numéro de dossier']};
const lab=l=>lb[l]?L(lb[l][0],lb[l][1],lb[l][2]):l;
const hn={'REG electricity':['Find it on your meter or your last token receipt.',0,'Il figure sur votre compteur ou votre dernier reçu.'],'WASAC water':['Find it on your water meter or your last bill.',0,'Il figure sur votre compteur d’eau ou votre dernière facture.'],'RRA taxes':['It is on your RRA certificate.',0,'Il figure sur votre certificat RRA.'],'School fees':['It is on your school card.',0,'Il figure sur votre carte scolaire.'],'Irembo':['You get it when you submit your application.',0,'Vous le recevez lors du dépôt de votre dossier.']};
const hint=k=>hn[k]?L(hn[k][0],hn[k][1],hn[k][2]):'';
const isPh=P=>P.l==='Phone number';
const ok=()=>{const B=S.bl,P=BP[B.p];return B.num.length===P.n&&B.amt>=MIN&&B.amt<=S.bank};
const numMsg=()=>{const B=S.bl,P=BP[B.p],n=B.num.length;
 if(n===P.n)return S.sm&&S.sm[B.p]===B.num?L('Saved from your last payment','Byabitswe uhereye kwishyura','Enregistré depuis votre dernier paiement'):'';
 return n?(P.n-n)+' '+L('more digits','imibare isigaye','chiffres restants')+(isPh(P)?' '+L('(without the 0)','(nta 0)','(sans le 0)'):''):hint(B.p)};
const amMsg=()=>{const B=S.bl;return B.amt>S.bank?t('insuff').replace('%s',fmt(S.bank)):B.amt>0&&B.amt<MIN?L('The least you can pay is '+fmt(MIN)+' RWF.','Ntoya ni '+fmt(MIN)+' RWF.','Minimum '+fmt(MIN)+' RWF.'):L('From itunda Bank','Biva kuri itunda Bank','Depuis itunda Bank')+' · '+fmt(S.bank)+' RWF '+L('available','bihari','disponibles')};
const amBad=()=>S.bl.amt>S.bank||(S.bl.amt>0&&S.bl.amt<MIN);
const btn=()=>{const B=S.bl,P=BP[B.p];return ok()?L('Pay ','Ishyura ','Payer ')+fmt(B.amt)+' RWF':B.num.length!==P.n?L('Enter the '+lab(P.l).toLowerCase(),'Andika '+lab(P.l).toLowerCase(),'Saisissez : '+lab(P.l).toLowerCase()):L('Enter an amount','Andika amafaranga','Saisissez un montant')};
const after=()=>fmt(S.bank-(ok()?S.bl.amt:0))+' RWF';
screens.bill=()=>{const B=S.bl,P=BP[B.p],keys=Object.keys(BP).filter(k=>!/airtime/.test(k)||k===B.p);
requestAnimationFrame(()=>{const b=document.querySelector('#blk .on');if(b)b.scrollIntoView({inline:'center',block:'nearest'})});
return `${bar(L('Pay bills','Ishyura fagitire','Payer des factures'))}<div class="pad" style="padding-top:12px">
<div class="sm mu">${L('Pay to','Ishyura kuri','Payer à')}</div>
<style>#blk::-webkit-scrollbar{display:none}</style><div class="req" id="blk" role="radiogroup" style="margin:10px -24px 0;padding:0 24px;flex-wrap:nowrap;overflow-x:auto;scrollbar-width:none">${keys.map(k=>`<button role="radio" aria-checked="${B.p===k}" class="${B.p===k?'on':''}" onclick="blSet('${k}')" style="flex:0 0 auto;white-space:nowrap">${esc(name(k))}</button>`).join('')}</div>
<div id="blL" style="font-size:15px;font-weight:800;margin-top:28px">${lab(P.l)}</div>
<input id="bnum" class="in" inputmode="numeric" autocomplete="off" aria-label="${lab(P.l)}" value="${B.num}" oninput="blN(this.value)" placeholder="${isPh(P)?'7'+'X'.repeat(P.n-1):'0'.repeat(P.n)}" style="font-size:28px;font-weight:800;letter-spacing:.5px;margin-top:4px">
<div id="blNM" class="sm" aria-live="polite" style="margin-top:6px;min-height:20px;color:var(--tt)">${numMsg()}</div>
<div class="sm mu" style="margin-top:28px">${L('Amount','Amafaranga','Montant')}</div>
<div style="display:flex;align-items:baseline;gap:8px;margin-top:6px"><input id="blA" inputmode="numeric" autocomplete="off" aria-label="${L('Amount in RWF','Amafaranga muri RWF','Montant en RWF')}" value="${B.amt?fmt(B.amt):''}" placeholder="0" oninput="blAI(this)" style="flex:1;min-width:0;border:0;outline:0;background:none;font:inherit;font-size:40px;font-weight:800;letter-spacing:-1px;color:var(--tx);padding:0"><b style="font-size:20px;color:var(--tt)">RWF</b></div>
<div id="blAM" class="sm" aria-live="polite" style="margin-top:6px;min-height:20px;color:${amBad()?'var(--er)':'var(--tt)'}">${amMsg()}</div>
<div class="req" id="blCh" style="margin-top:14px">${P.a.map(a=>`<button data-v="${a}" class="${B.amt===a?'on':''}" onclick="blQ(${a})">${fmt(a)}</button>`).join('')}</div>
<div style="margin-top:24px;padding:14px 16px;border-radius:16px;background:var(--chip);display:flex;justify-content:space-between;font-size:15px"><span class="mu">${L('Bank balance after','Amafaranga nyuma','Solde après')}</span><b id="blB">${after()}</b></div>
<div class="fine" style="margin-top:14px">${L('Providers and numbers are sample data. No real payment is made.','Abatanga serivisi n’inimero ni ibyitegererezo. Nta bwishyu nyabwo bukorwa.','Fournisseurs et numéros d’exemple. Aucun paiement réel.')}</div></div>
<div style="height:110px"></div><div class="cta"><button id="bgo" class="btn" ${ok()?'':'disabled'} onclick="billPay()">${btn()}</button></div>`};
const sync=()=>{const B=S.bl,m=document.getElementById('blAM'),n=document.getElementById('blNM'),g=document.getElementById('bgo'),b=document.getElementById('blB');
 if(m){m.textContent=amMsg();m.style.color=amBad()?'var(--er)':'var(--tt)'}
 if(n)n.textContent=numMsg();
 if(g){g.disabled=!ok();g.textContent=btn()}
 if(b)b.textContent=after();
 document.querySelectorAll('#blCh button').forEach(x=>x.classList.toggle('on',x.dataset.v==String(B.amt)))};
window.blSet=k=>{const P=BP[k];S.bl={p:k,num:(S.sm&&S.sm[k])||'',amt:P.a[1]};render('fade-none')};
window.blN=v=>{const B=S.bl,P=BP[B.p];let d=v.replace(/\D/g,'');if(isPh(P)){if(d.startsWith('250'))d=d.slice(3);if(d.startsWith('0'))d=d.slice(1)}B.num=d.slice(0,P.n);const i=document.getElementById('bnum');if(i&&i.value!==B.num)i.value=B.num;sync()};
window.blAI=el=>{const n=Math.min(parseInt(el.value.replace(/\D/g,''),10)||0,99999999);S.bl.amt=n;el.value=n?fmt(n):'';sync()};
window.blQ=n=>{S.bl.amt=n;const i=document.getElementById('blA');if(i)i.value=fmt(n);sync()};
/* confirm sheet in three languages */
window.billPay=()=>{const B=S.bl,P=BP[B.p];if(!ok())return;
 const row=(a,v)=>`<div style="display:flex;justify-content:space-between;gap:12px;min-height:40px;align-items:center;font-size:15px"><span class="mu">${a}</span><b style="text-align:right">${v}</b></div>`;
 $('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" role="dialog" aria-modal="true"><div class="h1" style="font-size:22px;line-height:30px;margin-top:4px">${L('Review payment','Suzuma ubwishyu','Vérifier le paiement')}</div><div style="margin:12px 0 22px">${row(L('Pay to','Ishyura kuri','Payer à'),esc(name(B.p)))}${row(lab(P.l),B.num)}${row(L('Amount','Amafaranga','Montant'),fmt(B.amt)+' RWF')}${row(L('Pay with','Ishyura na','Payer avec'),'itunda Bank')}${row(L('Balance after','Amafaranga nyuma','Solde après'),fmt(S.bank-B.amt)+' RWF')}</div><button class="btn" onclick="billDone()">${L('Pay ','Ishyura ','Payer ')+fmt(B.amt)+' RWF'}</button></div>`;
 if(typeof focusSheet==='function')focusSheet()};
/* receipt in three languages */
const _bd=screens.billdone;
screens.billdone=()=>{let h=_bd();if(S.lang==='en')return h;
 const R=[['Paid to ',L('Paid to ','Byishyuwe kuri ','Payé à ')],['Balance now',L('Balance now','Asigaye ubu','Solde actuel')],['Token (sample)',L('Token (sample)','Token (icyitegererezo)','Jeton (exemple)')],['>Done<','>'+L('Done','Byarangiye','Terminé')+'<']];
 R.forEach(([a,b])=>{h=h.split(a).join(b)});
 const P=BP[S.bl.p];if(P)h=h.split('>'+P.l+'<').join('>'+lab(P.l)+'<');return h};
})();
</script>
<script>
/* v278: Receive money on one screen. Code card with a live amount, optional amount field and chips on the same page, Copy link and Share in a fixed bottom bar. The Pay "Receive" tile opens the same screen. */
(()=>{
const L=(e,r,f)=>({en:e,rw:r||e,fr:f||e}[S.lang]||e);
const MIN=100,MAX=5000000,NUM='0788-1205-1980';
S.rc=S.rc||{amt:'',tmp:''};S.rc.raw=S.rc.raw!==undefined?S.rc.raw:(S.rc.amt?String(S.rc.amt):'');
const esc=s=>String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/"/g,'&quot;');
const prev=screens.rcode;
const qrSvg=()=>{const m=prev().match(/<svg viewBox="0 0 200 200"[\s\S]*?<\/svg>/);return m?m[0]:''};
const raw=()=>Number(S.rc.raw||0);
const valid=()=>!raw()||(raw()>=MIN&&raw()<=MAX);
const msg=()=>raw()>MAX?L('The most you can ask for is '+fmt(MAX)+' RWF.','Ntushobora gusaba ibirenze '+fmt(MAX)+' RWF.','Maximum '+fmt(MAX)+' RWF par code.')
 :raw()&&raw()<MIN?L('The least you can ask for is '+fmt(MIN)+' RWF.','Ntoya ni '+fmt(MIN)+' RWF.','Minimum '+fmt(MIN)+' RWF.')
 :raw()?L('The code now asks for '+fmt(raw())+' RWF.','Kode isaba '+fmt(raw())+' RWF.','Le code demande '+fmt(raw())+' RWF.')
 :L('Leave empty and the sender chooses the amount.','Reka ubusa, uwishyura ahitamo amafaranga.','Laissez vide : l’expéditeur choisit le montant.');
const link=()=>'https://itunda.rw/pay/'+NUM+(S.rc.amt?'?amount='+S.rc.amt:'');
const cap=()=>S.rc.amt?fmt(S.rc.amt)+' RWF':L('Any amount','Umubare wose','Montant libre');
screens.rcode=()=>{
 return `${bar(L('Receive money','Akira amafaranga','Recevoir de l’argent'))}<div class="pad" style="padding-top:12px"><div class="mu" style="font-size:15px">${L('Show this code to the other person.','Erekana iyi kode ku wundi muntu.','Montrez ce code à l’autre personne.')}</div></div>
<div style="margin:18px 24px 0;padding:22px 16px 18px;border-radius:28px;background:var(--chip);text-align:center"><div id="rcQ" style="display:inline-block;padding:10px;border-radius:18px;background:#fff;line-height:0">${qrSvg()}</div>
<div style="margin-top:14px;font-size:17px;font-weight:800">${esc(S.name||'You')}</div><div class="sm mu" style="margin-top:2px">itunda Pay · ${NUM}</div>
<div id="rcC" style="margin-top:10px;font-size:24px;font-weight:800;letter-spacing:-.4px">${cap()}</div>
<button class="tap" onclick="toast('${L('Image saved (prototype)','Ifoto yabitswe (prototype)','Image enregistrée (prototype)')}')" style="margin-top:10px;border:0;background:none;color:var(--tt);font:inherit;font-size:15px;font-weight:700;min-height:44px">${L('Save image','Bika ifoto','Enregistrer l’image')}</button></div>
<div class="pad" style="padding-top:24px"><div style="font-size:15px;font-weight:800">${L('Set an amount (optional)','Shyiraho amafaranga (si ngombwa)','Définir un montant (facultatif)')}</div>
<div style="display:flex;align-items:baseline;gap:8px;margin-top:6px"><input id="rcA" inputmode="numeric" autocomplete="off" aria-label="${L('Amount in RWF','Amafaranga muri RWF','Montant en RWF')}" value="${raw()?fmt(raw()):''}" placeholder="0" oninput="rcI(this)" style="flex:1;min-width:0;border:0;outline:0;background:none;font:inherit;font-size:32px;font-weight:800;letter-spacing:-.8px;color:var(--tx);padding:0"><b style="font-size:18px;color:var(--tt)">RWF</b></div>
<div id="rcM" class="sm" aria-live="polite" style="margin-top:6px;min-height:20px;color:${valid()?'var(--tt)':'var(--er)'}">${msg()}</div>
<div class="req" style="margin-top:12px">${[1000,5000,10000].map(x=>`<button onclick="rcQ(${x})">+${fmt(x)}</button>`).join('')}<button onclick="rcC()">${L('Clear','Siba','Effacer')}</button></div>
<div class="fine" style="margin-top:16px">${L('Sample code, not a real one.','Kode y’icyitegererezo, si iyukuri.','Code d’exemple, pas un vrai.')}</div></div>
<div style="height:110px"></div><div class="cta" style="display:flex;gap:10px"><button class="btn sec2" id="rcCp" onclick="rcCopy()" ${valid()?'':'disabled'}>${L('Copy link','Kopera link','Copier le lien')}</button><button class="btn" id="rcSh" onclick="rcShare()" ${valid()?'':'disabled'}>${L('Share code','Sangiza kode','Partager le code')}</button></div>`};
const sync=()=>{S.rc.amt=valid()&&raw()?String(raw()):'';
 const q=document.getElementById('rcQ'),c=document.getElementById('rcC'),m=document.getElementById('rcM');
 if(q)q.innerHTML=qrSvg();if(c)c.textContent=cap();
 if(m){m.textContent=msg();m.style.color=valid()?'var(--tt)':'var(--er)'}
 ['rcCp','rcSh'].forEach(i=>{const b=document.getElementById(i);if(b)b.disabled=!valid()})};
window.rcI=el=>{const n=Math.min(parseInt(el.value.replace(/\D/g,''),10)||0,99999999);S.rc.raw=n?String(n):'';el.value=n?fmt(n):'';sync()};
window.rcQ=n=>{S.rc.raw=String(Math.min(raw()+n,99999999));const i=document.getElementById('rcA');if(i)i.value=fmt(raw());sync()};
window.rcC=()=>{S.rc.raw='';const i=document.getElementById('rcA');if(i){i.value='';i.focus()}sync()};
window.rcCopy=()=>{if(!valid())return;try{navigator.clipboard.writeText(link()).catch(()=>{})}catch(e){}toast(L('Link copied','Link yakoporowe','Lien copié'))};
window.rcShare=()=>{if(!valid())return;const tx=L('Pay me on itunda','Nyishyure kuri itunda','Payez-moi sur itunda')+(S.rc.amt?' · '+fmt(S.rc.amt)+' RWF':'');if(navigator.share){navigator.share({text:tx,url:link()}).catch(()=>{})}else rcCopy()};
window.ppRecv=()=>{if(typeof closeSheet==='function')closeSheet();S.stack.push('rcode');render('push')};
})();
</script>
<script>
/* v280: Split a bill (Pay) on one screen. Bill amount field, category row, pick who to split with, live shares, Request in a fixed bottom bar. */
(()=>{
const L=(e,r,f)=>({en:e,rw:r||e,fr:f||e}[S.lang]||e);
const MIN=200,MAX=5000000;
const PEOPLE=['Amina K.','Eric M.','Grace U.','Jean Paul','Divine N.'];
const esc=s=>String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/"/g,'&quot;');
const CATS=[['Meal','Ifunguro','Repas'],['Coffee','Ikawa','Café'],['Snack','Agafunguro','Snack'],['Drinks','Ibinyobwa','Boissons'],['Transport','Ingendo','Transport']];
S.sb=S.sb||{amt:30000,cat:'',sel:['Amina K.','Eric M.']};
const B=()=>S.sb;
const okAmt=()=>B().amt>=MIN&&B().amt<=MAX;
const k=()=>B().sel.length;
const ok=()=>okAmt()&&k()>0;
const each=()=>okAmt()&&k()?Math.ceil(B().amt/(k()+1)):0;
const mine=()=>okAmt()&&k()?Math.max(B().amt-each()*k(),0):0;
const catName=c=>{const x=CATS.find(y=>y[0]===c);return x?L(x[0],x[1],x[2]):''};
const msg=()=>B().amt>MAX?L('The most you can split is '+fmt(MAX)+' RWF.','Ntushobora gugabana ibirenze '+fmt(MAX)+' RWF.','Maximum '+fmt(MAX)+' RWF.')
 :B().amt>0&&B().amt<MIN?L('The least you can split is '+fmt(MIN)+' RWF.','Ntoya ni '+fmt(MIN)+' RWF.','Minimum '+fmt(MIN)+' RWF.')
 :L('Everyone you pick pays an equal share.','Buri wese uhisemo yishyura ungana.','Chaque personne choisie paie une part égale.');
const bad=()=>B().amt>MAX||(B().amt>0&&B().amt<MIN);
const btn=()=>ok()?L('Request ','Saba ','Demander ')+fmt(each())+' RWF '+L('each','buri umwe','chacun'):!okAmt()?L('Enter the bill amount','Andika fagitire','Saisissez le montant'):L('Pick who to split with','Hitamo abo mugabana','Choisissez avec qui partager');
const sum=()=>`<div style="display:flex;justify-content:space-between;font-size:15px;padding:6px 0"><span class="mu">${L('Each person pays','Buri muntu yishyura','Chaque personne paie')}</span><b>${fmt(each())} RWF</b></div><div style="display:flex;justify-content:space-between;font-size:15px;padding:6px 0"><span class="mu">${L('You pay','Wishyura','Vous payez')}</span><b>${fmt(mine())} RWF</b></div>`;
const prow=n=>{const on=B().sel.includes(n);return `<div class="row tap" role="checkbox" aria-checked="${on}" tabindex="0" onclick="sbT('${n}')" style="padding-left:0;padding-right:0"><span style="width:44px;height:44px;border-radius:22px;background:var(--tint);color:var(--tintfg);display:flex;align-items:center;justify-content:center;font-weight:800;font-size:17px;flex:none">${esc(n)[0]}</span><div style="flex:1;margin-left:14px"><div class="t" style="font-size:16px">${esc(n)}</div></div><div class="ck ${on?'on':''}">${ic('check',18,on?'#17171C':'var(--tt)')}</div></div>`};
screens.splitpay=()=>`${bar(L('Split a bill','Gabana fagitire','Partager une addition'))}<div class="pad" style="padding-top:12px">
<div class="sm mu">${L('How much was the bill?','Fagitire yari angahe?','Combien était l’addition ?')}</div>
<div style="display:flex;align-items:baseline;gap:8px;margin-top:6px"><input id="sbA" inputmode="numeric" autocomplete="off" aria-label="${L('Bill amount in RWF','Amafaranga ya fagitire muri RWF','Montant en RWF')}" value="${B().amt?fmt(B().amt):''}" placeholder="0" oninput="sbI(this)" style="flex:1;min-width:0;border:0;outline:0;background:none;font:inherit;font-size:40px;font-weight:800;letter-spacing:-1px;color:var(--tx);padding:0"><b style="font-size:20px;color:var(--tt)">RWF</b></div>
<div id="sbM" class="sm" aria-live="polite" style="margin-top:6px;min-height:20px;color:${bad()?'var(--er)':'var(--tt)'}">${msg()}</div>
<div class="req" style="margin-top:14px">${[10000,30000,60000].map(x=>`<button onclick="sbQ(${x})">+${fmt(x)}</button>`).join('')}<button onclick="sbC()">${L('Clear','Siba','Effacer')}</button></div>
<style>#sbK::-webkit-scrollbar{display:none}</style><div class="req" id="sbK" style="margin:14px -24px 0;padding:0 24px;flex-wrap:nowrap;overflow-x:auto;scrollbar-width:none">${CATS.map(c=>`<button class="${B().cat===c[0]?'on':''}" onclick="sbCat('${c[0]}')" style="flex:0 0 auto;white-space:nowrap">${L(c[0],c[1],c[2])}</button>`).join('')}</div>
<div style="font-size:15px;font-weight:800;margin-top:28px">${L('Split with','Gabana na','Partager avec')}</div>
<div id="sbP" style="margin-top:4px">${PEOPLE.map(prow).join('')}</div>
<div id="sbS" style="margin-top:14px;padding:10px 16px;border-radius:16px;background:var(--chip)">${sum()}</div>
<div class="fine" style="margin-top:14px">${L('Sample contacts. No real requests are sent.','Abantu b’icyitegererezo. Nta busabe bwoherejwe.','Contacts d’exemple. Aucune demande réelle.')}</div></div>
<div style="height:110px"></div><div class="cta"><button class="btn" id="sbG" onclick="sbGo()" ${ok()?'':'disabled'}>${btn()}</button></div>`;
const sync=()=>{const m=document.getElementById('sbM'),s=document.getElementById('sbS'),g=document.getElementById('sbG');
 if(m){m.textContent=msg();m.style.color=bad()?'var(--er)':'var(--tt)'}
 if(s)s.innerHTML=sum();if(g){g.disabled=!ok();g.textContent=btn()}};
window.sbI=el=>{const n=Math.min(parseInt(el.value.replace(/\D/g,''),10)||0,99999999);B().amt=n;el.value=n?fmt(n):'';sync()};
window.sbQ=n=>{B().amt=Math.min((B().amt||0)+n,99999999);const i=document.getElementById('sbA');if(i)i.value=fmt(B().amt);sync()};
window.sbC=()=>{B().amt=0;const i=document.getElementById('sbA');if(i){i.value='';i.focus()}sync()};
window.sbCat=c=>{B().cat=B().cat===c?'':c;document.querySelectorAll('#sbK button').forEach((b,i)=>b.classList.toggle('on',CATS[i][0]===B().cat))};
window.sbT=n=>{const s=B().sel,i=s.indexOf(n);if(i>=0)s.splice(i,1);else s.push(n);const p=document.getElementById('sbP');if(p)p.innerHTML=PEOPLE.map(prow).join('');sync()};
window.sbGo=()=>{if(!ok())return;const e=each(),l=L('Split bill','Gabana fagitire','Addition partagée')+(B().cat?' · '+catName(B().cat):'');
 B().sel.forEach(n=>S.rqs.push({id:Date.now()+Math.floor(Math.random()*1e4),n,amt:e,l,paid:false}));
 const c=k();back();toast(c+' '+L(c===1?'request sent':'requests sent','ubusabe bwoherejwe','demande(s) envoyée(s)'))};
window.ppSplit=()=>{if(typeof closeSheet==='function')closeSheet();S.stack.push('splitpay');render('push')};
})();
</script>
<script>
/* v281: Receipts. (1) Activity detail is a full Receipt page: name, signed amount, status, detail card, tap-to-copy reference, Copy details and Share receipt in a fixed bottom bar, Report a problem link. (2) The merchant receipt's Share receipt now really shares. */
(()=>{
const L=(e,r,f)=>({en:e,rw:r||e,fr:f||e}[S.lang]||e);
const esc=s=>String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/"/g,'&quot;');
const strip=h=>String(h).replace(/<[^>]*>/g,'').replace(/&amp;/g,'&').replace(/&lt;/g,'<').replace(/&gt;/g,'>').replace(/&quot;/g,'"').trim();
const _ao=window.actOpen;
window.actOpen=function(i){const x=S.act[i];if(!x)return;
 _ao.call(this,i);const y=$('#layer');const h=y?y.innerHTML:'';if(y)y.innerHTML='';
 const rows=[...h.matchAll(/<span class="mu">([\s\S]*?)<\/span><b[^>]*>([\s\S]*?)<\/b>/g)].map(m=>[strip(m[1]),strip(m[2])]);
 S.ra={i,rows};S.stack.push('actrec');render('push')};
const text=()=>{const A=S.ra,x=S.act[A.i];return x[1]+' · '+signed(x[3])+A.rows.slice(1).map(r=>' · '+r[1]).join('')};
screens.actrec=()=>{const A=S.ra,x=A&&S.act[A.i];if(!x)return `${bar(L('Receipt','Fagitire','Reçu'))}`;
 const inn=x[3]>0,rows=A.rows,st=rows[0]?rows[0][1]:L('Completed','Byarangiye','Terminé'),det=rows.slice(1),last=det.length-1;
 const kv=(a,b,c)=>`<div class="px-kv" ${c?`role="button" tabindex="0" onclick="${c}" style="cursor:pointer"`:''}><span class="mu">${esc(a)}</span><b style="text-align:right">${esc(b)}${c?' ⧉':''}</b></div>`;
 return `${bar(L('Receipt','Fagitire','Reçu'))}<div style="display:flex;flex-direction:column;align-items:center;padding:12px 24px 24px;text-align:center"><div class="ico" style="width:64px;height:64px;border-radius:32px">${gx(x[0],34)}</div><div style="font-size:18px;font-weight:800;margin-top:12px">${esc(x[1])}</div><div class="big" style="font-size:36px;margin-top:6px;color:${inn?'var(--ok)':'var(--tx)'}">${signed(x[3])}</div><div style="margin-top:8px"><span class="px-st ok">${esc(st)}</span></div></div>
<div class="px-card">${det.map((r,j)=>kv(r[0],r[1],j===last?'rcpCopyRef()':'')).join('')}</div>
<div class="pad" style="padding-top:14px"><button class="tap" onclick="reportSheet()" style="border:0;background:none;color:var(--tt);font:inherit;font-size:15px;font-weight:700;min-height:44px;padding:0">${L('Report a problem','Menyesha ikibazo','Signaler un problème')}</button><div class="fine" style="padding-top:8px">${L('Sample data for this prototype.','Amakuru y’icyitegererezo.','Données d’exemple pour ce prototype.')}</div></div>
<div style="height:110px"></div><div class="cta" style="display:flex;gap:10px"><button class="btn sec2" onclick="rcpCopy()">${L('Copy details','Kopora amakuru','Copier les détails')}</button><button class="btn" onclick="rcpShare()">${L('Share receipt','Sangiza fagitire','Partager le reçu')}</button></div>`};
window.rcpCopyRef=()=>{const A=S.ra;if(!A||!A.rows.length)return;try{navigator.clipboard.writeText(A.rows[A.rows.length-1][1]).catch(()=>{})}catch(e){}toast(L('Reference copied','Nimero yakopowe','Référence copiée'))};
window.rcpCopy=()=>{try{navigator.clipboard.writeText(text()).catch(()=>{})}catch(e){}toast(L('Details copied','Amakuru yakopowe','Détails copiés'))};
window.rcpShare=()=>{if(navigator.share){navigator.share({text:text()}).catch(()=>{})}else{rcpCopy()}};
/* merchant receipt: real share */
const _pr=screens.payrcd;
screens.payrcd=()=>{const h=_pr();return h.replace(/onclick="toast\('[^']*'\)">(Share receipt|Sangiza fagitire|Partager le reçu)</,'onclick="pxShareRc()">$1<')};
window.pxShareRc=()=>{const q=s=>document.querySelector('#phone '+s),nm=q('.px-av')&&q('.px-av').nextElementSibling,am=q('.big');
 const kv=[...document.querySelectorAll('#phone .px-kv')].map(e=>e.textContent.replace(/\s*⧉\s*$/,'').replace(/\s+/g,' ').trim());
 const tx=[nm&&nm.textContent.trim(),am&&am.textContent.trim()].concat(kv).filter(Boolean).join(' · ');
 if(navigator.share){navigator.share({text:tx}).catch(()=>{})}else{try{navigator.clipboard.writeText(tx).catch(()=>{})}catch(e){}toast(L('Receipt copied','Fagitire yakopowe','Reçu copié'))}};
})();
</script>
<script>
/* v282: Open an account. Explore's "Open account" (and the My assets screen) open a chooser of what you can open, each with a one-line benefit and its status, instead of just landing on the Bank overview. */
(()=>{
const L=(e,r,f)=>({en:e,rw:r||e,fr:f||e}[S.lang]||e);
const stk=()=>typeof stkVal==='function'?stkVal():0;
const pk=()=>S.pk?S.pk.length:0;
const tag=on=>on?`<span class="px-st ok">${L('Active','Irakora','Actif')}</span>`:'';
const go=n=>`S.stack.push('${n}');render('push')`;
screens.openacc=()=>{
 const R=(i,t,s,on,fn)=>row(i,t,s,tag(on),fn);
 return `${bar(L('Open an account','Fungura konti','Ouvrir un compte'))}<div class="pad" style="padding-top:12px"><div class="mu" style="font-size:15px;line-height:22px">${L('Pick what you want to set up. You can open more than one.','Hitamo icyo ushaka gutangiza. Ushobora gufungura byinshi.','Choisissez ce que vous voulez ouvrir. Vous pouvez en ouvrir plusieurs.')}</div></div>
<div class="sec"><div class="sech">${L('Save','Kuzigama','Épargner')}</div>
${R('coin',L('Savings goal','Intego yo kuzigama','Objectif d’épargne'),L('Save toward something, with a target','Zigama ugamije intego','Épargnez pour un objectif'),!!S.goal,'openGoal()')}
${R('coin',L('Interest jar','Interest jar','Tirelire à intérêts'),'4.0% '+L('annual, withdraw any time','ku mwaka, ukuramo igihe cyose','par an, retrait à tout moment'),(S.jar||0)>0,go('jar'))}
${R('lock',L('12-month deposit','Ubwizigame bw’amezi 12','Dépôt 12 mois'),L('Lock money and earn more','Funga amafaranga winjize byinshi','Bloquez et gagnez plus'),!!S.dep,go('dep'))}
${R('wallet','Pockets',L('Separate money for trips, phone or anything','Gabanya amafaranga ku ngendo, telefoni cyangwa ikindi','Séparez l’argent : voyages, téléphone…'),pk()>0,'openPockets()')}</div>
<div class="sec"><div class="sech">${L('Invest','Gushora','Investir')}</div>
${R('trend','Rwanda Stock Exchange',L('Start with a sample portfolio','Tangira na portfolio y’icyitegererezo','Commencez avec un portefeuille d’exemple'),stk()>0,'openInvest()')}</div>
<div class="sec"><div class="sech">${L('Pay','Kwishyura','Payer')}</div>
${R('card','itunda card',L('Spend limits and one-tap freeze','Imbibi n’uburyo bwo guhagarika vuba','Plafonds et gel en un geste'),!!S.card,'openCard()')}</div>
<div class="pad fine" style="padding-top:18px">${L('Sample data for this prototype.','Amakuru y’icyitegererezo.','Données d’exemple pour ce prototype.')}</div>`};
window.openAcc=()=>{S.stack.push('openacc');render('push')};
/* entry points: Explore rows */
try{ASEC.forEach(g=>g[1].forEach(e=>{if(e[1]==='Open account')e[3]='openAcc()'}))}catch(e){}
try{ASHORT.forEach(e=>{if(e[0]==='Open account')e[2]='openAcc()'})}catch(e){}
/* entry point: My assets */
const _as=screens.assets;
screens.assets=()=>{const h=_as(),m='<div class="pad fine" style="padding-top:18px">';const i=h.lastIndexOf(m);if(i<0)return h;
 return h.slice(0,i)+`<div class="sec">${row('plus',L('Open an account','Fungura konti','Ouvrir un compte'),L('Savings, deposit, investments, card','Kuzigama, ubwizigame, imari, ikarita','Épargne, dépôt, investissements, carte'),'','openAcc()')}</div>`+h.slice(i)};
})();
</script>
<script>
/* v283: Daily transfer limit (Bank, Limits & alerts) on one screen. Used / left today with a progress bar, limit field with chips, alerts switch, Save limit in a fixed bottom bar. Nothing changes until you save. */
(()=>{
const L=(e,r,f)=>({en:e,rw:r||e,fr:f||e}[S.lang]||e);
const MIN=10000,UMAX=1000000,VMAX=5000000;
const isV=()=>S.vf&&S.vf.st==='verified';
const needV=()=>!isV()&&D().day>UMAX&&D().day<=VMAX;
S.lim=S.lim||{day:1000000,al:true};S.lim.used=S.lim.used||0;
const D=()=>S.lmd;
const valid=()=>D().day>=MIN&&D().day<=VMAX;
const dirty=()=>D().day!==S.lim.day||!!D().al!==!!S.lim.al;
const ok=()=>valid()&&dirty();
const left=()=>Math.max(0,S.lim.day-S.lim.used);
const pct=()=>Math.min(100,Math.round(S.lim.used/Math.max(S.lim.day,1)*100));
const msg=()=>D().day>VMAX?L('The highest daily limit is '+fmt(VMAX)+' RWF.','Imbibi ntarengwa ni '+fmt(VMAX)+' RWF.','Le plafond maximum est de '+fmt(VMAX)+' RWF.')
 :needV()?L('Limits above 1,000,000 RWF need a verified identity.','Imipaka irenga 1,000,000 RWF isaba indangamuntu yemejwe.','Les plafonds au-delà de 1 000 000 RWF exigent une identité vérifiée.')
 :D().day>0&&D().day<MIN?L('The lowest daily limit is '+fmt(MIN)+' RWF.','Imbibi ntoya ni '+fmt(MIN)+' RWF.','Le plafond minimum est de '+fmt(MIN)+' RWF.')
 :valid()&&D().day<S.lim.used?L('You have already sent '+fmt(S.lim.used)+' RWF today, so new transfers wait until tomorrow.','Wamaze kohereza '+fmt(S.lim.used)+' RWF uyu munsi, ibindi bizategereza ejo.','Vous avez déjà envoyé '+fmt(S.lim.used)+' RWF aujourd’hui : les nouveaux envois attendront demain.')
 :L('Between '+fmt(MIN)+' and '+fmt(isV()?VMAX:UMAX)+' RWF.','Hagati ya '+fmt(MIN)+' na '+fmt(isV()?VMAX:UMAX)+' RWF.','Entre '+fmt(MIN)+' et '+fmt(isV()?VMAX:UMAX)+' RWF.');
const bad=()=>D().day>VMAX||(D().day>0&&D().day<MIN);
const btn=()=>needV()?L('Verify to raise limit','Emeza kugira ngo wongere imipaka','Vérifier pour relever'):!valid()?L('Enter a limit','Andika imbibi','Saisissez un plafond'):!dirty()?L('No changes','Nta cyahindutse','Aucun changement'):L('Save limit','Bika imbibi','Enregistrer');
screens.bklimits=()=>`${bar(L('Limits & alerts','Imbibi n’imenyesha','Plafonds et alertes'))}<div class="pad" style="padding-top:12px">
<div style="padding:16px 18px;border-radius:20px;background:var(--chip)"><div class="sm mu">${L('Sent today','Wohereje uyu munsi','Envoyé aujourd’hui')}</div>
<div style="display:flex;justify-content:space-between;align-items:baseline;margin-top:4px"><b style="font-size:26px;letter-spacing:-.5px">${fmt(S.lim.used)} RWF</b><span class="sm mu">${L('of','kuri','sur')} ${fmt(S.lim.day)}</span></div>
<div role="progressbar" aria-valuemin="0" aria-valuemax="${S.lim.day}" aria-valuenow="${S.lim.used}" style="height:8px;border-radius:4px;background:var(--bg);margin-top:12px;overflow:hidden"><i style="display:block;height:8px;width:${pct()}%;border-radius:4px;background:${pct()>=90?'var(--er)':'var(--br)'}"></i></div>
<div class="sm mu" style="margin-top:10px">${L('Left today','Hasigaye uyu munsi','Reste aujourd’hui')}: <b style="color:var(--tx)">${fmt(left())} RWF</b></div></div>
<div class="sm mu" style="margin-top:28px">${L('Daily transfer limit','Imbibi bya buri munsi','Plafond quotidien')}</div>
<div style="display:flex;align-items:baseline;gap:8px;margin-top:6px"><input id="lmA" inputmode="numeric" autocomplete="off" aria-label="${L('Daily limit in RWF','Imbibi muri RWF','Plafond en RWF')}" value="${D().day?fmt(D().day):''}" placeholder="0" oninput="lmI(this)" style="flex:1;min-width:0;border:0;outline:0;background:none;font:inherit;font-size:40px;font-weight:800;letter-spacing:-1px;color:var(--tx);padding:0"><b style="font-size:20px;color:var(--tt)">RWF</b></div>
<div id="lmM" class="sm" aria-live="polite" style="margin-top:6px;min-height:20px;color:${bad()?'var(--er)':'var(--tt)'}">${msg()}</div>
<div class="req lim4" id="lmC" style="margin-top:14px">${[200000,500000,1000000,2000000].map(x=>`<button data-v="${x}" class="${D().day===x?'on':''}" onclick="lmQ(${x})">${fmt(x)}</button>`).join('')}</div>
<div class="row tap" role="switch" aria-checked="${!!D().al}" tabindex="0" id="lmS" style="margin-top:22px;padding-left:0;padding-right:0" onclick="lmT()"><div style="flex:1"><div class="t" style="font-size:16px">${L('Alerts for large transfers','Imenyesha ry’ihererekanya rinini','Alertes gros virements')}</div><div class="s">${L('Notify me above 100,000 RWF','Menyesha hejuru ya 100,000 RWF','Prévenir au-dessus de 100 000 RWF')}</div></div><div class="ck ${D().al?'on':''}" id="lmK">${ic('check',18,D().al?'#17171C':'var(--tt)')}</div></div></div>
<div style="height:110px"></div><div class="cta"><button class="btn" id="lmG" onclick="lmSave()" ${ok()?'':'disabled'}>${btn()}</button></div>`;
const sync=()=>{const m=document.getElementById('lmM'),g=document.getElementById('lmG'),k=document.getElementById('lmK'),s=document.getElementById('lmS');
 if(m){m.textContent=msg();m.style.color=bad()?'var(--er)':'var(--tt)'}
 if(g){g.disabled=!ok();g.textContent=btn()}
 if(k){k.classList.toggle('on',!!D().al);k.innerHTML=ic('check',18,D().al?'#17171C':'var(--tt)')}
 if(s)s.setAttribute('aria-checked',!!D().al);
 document.querySelectorAll('#lmC button').forEach(b=>b.classList.toggle('on',b.dataset.v==String(D().day)))};
window.lmI=el=>{const n=Math.min(parseInt(el.value.replace(/\D/g,''),10)||0,99999999);D().day=n;el.value=n?fmt(n):'';sync()};
window.lmQ=n=>{D().day=n;const i=document.getElementById('lmA');if(i)i.value=fmt(n);sync()};
window.lmT=()=>{D().al=!D().al;sync()};
window.lmSave=()=>{if(!ok())return;if(needV()){openSvc('verify');return}S.lim.day=D().day;S.lim.al=!!D().al;back();toast(L('Limit saved','Imbibi yabitswe','Plafond enregistré'))};
window.bkLim=()=>{S.lmd={day:S.lim.day,al:!!S.lim.al};S.stack.push('bklimits');render('push')};
})();

/* v284: Daily limits agree everywhere. One value (S.lim.day) now drives Bank > Limits & alerts, Settings > Send limits, Send settings and Profile (before: four separate numbers, Profile always said 2,000,000). Up to 1,000,000 RWF a day until you are verified, up to 5,000,000 after (same rule as Settings and Verify); on the limit screen a higher number turns the button into "Verify to raise limit". "Sent today" now resets each day and also counts money sent to friends, which is now checked against the limit (before only bank transfers were). The amount screen shows what is left today and opens the limit on tap. rw copy needs native review. */
(()=>{
const L=(e,r,f)=>({en:e,rw:r||e,fr:f||e}[S.lang]||e);
const dk=()=>new Date().toDateString();
{const X=S.lim;let u=X.used||0,d=dk();Object.defineProperty(X,'used',{get(){if(d!==dk()){d=dk();u=0}return u},set(v){d=dk();u=v},enumerable:true,configurable:true})}
const left=()=>Math.max(0,S.lim.day-S.lim.used);
{const f=window.finish;let t=0;window.finish=function(){const now=Date.now();if(now-t>4000){const v=Number(S.amt)||0;if(v>left()){closeSheet();toast(L('Over your daily limit. Left today: '+fmt(left())+' RWF.','Birenze imbibi bya none. Hasigaye: '+fmt(left())+' RWF.','Au-dessus de votre plafond. Reste aujourd’hui : '+fmt(left())+' RWF.'));return}S.lim.used+=v;t=now}return f.apply(this,arguments)}}
{const _a=screens.amount,k='<div id="msg"';screens.amount=()=>{const h=_a();return h.includes(k)?h.replace(k,`<div class="sm mu tap" role="button" tabindex="0" onclick="bkLim()" style="margin-top:8px;cursor:pointer">${L('Daily limit left','Hasigaye uyu munsi','Plafond restant')}: <b style="color:var(--tx)">${fmt(left())} RWF</b></div>`+k):h}}
})();
/* v285: Limit chips stay on one line. Bank > Limits & alerts (200,000 / 500,000 / 1,000,000 / 2,000,000) and Pay limits (per payment, per day) now show four equal chips in a single row instead of wrapping; 5,000,000 is no longer a chip on the Bank screen (type it once verified). */
/* v286: Upcoming bills. Top shows what is due in the next 7 days (amount and count). Bills are sorted by due date and grouped This week / Later / Paid, as flat rows (no grey cards). Removing a bill asks first. Adding a bill lets you pick the amount and when it is due (it was always 14 days, default amount). Add a bill is a fixed bottom button. rw copy needs native review. */
/* v287: Cash at an agent is a full screen (it was a pop-up sheet). Withdraw / Deposit switch, big amount field with a live message (fee 1%, at least 100 RWF; 1,000 to 500,000 RWF per code; not enough in Pay), four amount chips on one line, Pay balance, flat summary (you receive / fee / taken from Pay / balance after) that updates as you type, three short steps, and "Get code for 20,000 RWF" in a fixed bottom bar. An expired code no longer throws you back to the form; Done on the receipt returns to where you came from. rw copy needs native review. */
/* v288: Pay limits is a full screen (it was a pop-up sheet with two chip rows). "Paid today" with a bar and what is left, then Per payment and Per day, each a big field with a live message (10,000 minimum; up to 2,000,000 per payment and 5,000,000 a day; a payment can't be more than the daily limit; a daily limit below what you already paid says new payments wait until tomorrow) and four chips on one line. Nothing changes until you tap Save limits in the fixed bottom bar. The Pay hub row now says "500,000 per payment · 2,000,000 a day" instead of one unlabeled number. "Change limits" on the payment confirm opens the same screen. rw copy needs native review. */
/* v289: Pay limits, quieter. Per payment and Per day were two identical blocks (big field, helper line, chips) under a grey card. Now each is one line (name on the left, the amount you can type on the right) with the four chips under it; the helper line shows only when something is wrong (or when the daily limit is below what you already paid), and the ranges moved into the small print. The "Paid today" card is a flat line with a slim bar. */
/* v290: Pay limits has no chips. Per payment and Per day are each a label with one amount field (type the number); the message under it shows only when something is wrong. */
/* v291: New savings goal, step 1. Phone, Trip, Emergency fund and School fees now sit on one line (they wrapped onto two). The chips share the row; in Kinyarwanda and French, where the names are longer, the row scrolls sideways instead of wrapping. */

/* v292 Manage pocket */
{const t3=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e,CH=[50000,100000,250000,500000],MAXG=99999999;
const num=v=>Number(String(v||'').replace(/\D/g,''))||0;
const pk=()=>pkGet(S.pkId);
const mgErr=()=>{const G=S.mg,p=pk(),n=(G.n||'').trim();if(!n)return t3('Enter a name','Andika izina','Saisissez un nom');
if(S.pk.some(x=>x.id!==p.id&&x.n.toLowerCase()===n.toLowerCase()))return t3('You already have a pocket with that name','Usanzwe ufite agasanduku gafite iryo zina','Vous avez déjà une poche portant ce nom');return ''};
const mgDirty=()=>{const G=S.mg,p=pk();return (G.n||'').trim()!==p.n||(G.t||0)!==(p.t||0)};
const mgNote=()=>{const G=S.mg,p=pk(),b=pkBal(p),t=G.t||0;if(!t)return {h:'',w:0};const w=Math.min(100,Math.round(b/t*100));
return {h:b>=t?t3('Your balance has already reached this goal','Amafaranga ufite yamaze kugera kuri iyi ntego','Votre solde a déjà atteint cet objectif'):fmt(b)+' / '+fmt(t)+' RWF · '+w+'%',w}};
function mgUpd(){const G=S.mg,e=mgErr(),n=mgNote(),sv=$('#mgs');if(!sv)return;
$('#mge').textContent=(S.mgTouched&&e)?e:'';$('#pkn').setAttribute('aria-invalid',(S.mgTouched&&e)?'true':'false');
$('#mgn').textContent=n.h;$('#mgbar').style.width=n.w+'%';$('#mgbw').style.display=G.t?'block':'none';
document.querySelectorAll('#mgc button').forEach(b=>{const v=Number(b.dataset.v),on=v===(G.t||0);b.classList.toggle('on',on);b.setAttribute('aria-pressed',on?'true':'false')});
sv.disabled=!!e||!mgDirty()}
window.mgName=v=>{S.mg.n=v;S.mgTouched=true;mgUpd()};
window.mgGoal=v=>{const a=Math.min(MAXG,num(v));S.mg.t=a;const i=$('#mgt');i.value=a?fmt(a):'';mgUpd()};
window.mgChip=v=>{S.mg.t=v;$('#mgt').value=v?fmt(v):'';mgUpd()};
window.pkManage=function(){const p=pk();if(!p)return;
if(p.id==='jar'){$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" role="dialog" aria-modal="true" aria-label="${t3('Manage','Gucunga','Gérer')}"><div class="h1" style="font-size:22px;line-height:30px">${t3('Interest jar','Agasanduku k’inyungu','Tirelire à intérêts')}</div><div class="mu" style="font-size:15px;margin:8px 0 24px;line-height:22px">${t3("Put money aside and take it out any time. This pocket is always here, so it can't be renamed or deleted.",'Bika amafaranga kandi uyakuremo igihe cyose. Aka gasanduku guhoraho, ntigashobora guhindurirwa izina cyangwa gusibwa.','Mettez de l’argent de côté et retirez-le à tout moment. Cette poche est toujours là, elle ne peut pas être renommée ni supprimée.')}</div><button class="btn sec2" onclick="closeSheet()">${t3('Close','Funga','Fermer')}</button></div>`;return}
S.mg={n:p.n,t:p.t||0};S.mgTouched=false;mgDraw()};
window.mgDraw=function(){const p=pk(),b=pkBal(p),G=S.mg,n=mgNote();
$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet mgp" role="dialog" aria-modal="true" aria-label="${t3('Manage pocket','Gucunga agasanduku','Gérer la poche')}" style="max-height:92%;overflow-y:auto"><div class="h1" style="font-size:22px;line-height:30px">${t3('Manage pocket','Gucunga agasanduku','Gérer la poche')}</div>
<div class="mgsum">${pkIco(p,48)}<div style="min-width:0"><b>${esc48(p.n)}</b><span>${fmt(b)} RWF</span></div></div>
<label class="lab" for="pkn">${t3('Name','Izina','Nom')}</label><input class="in" id="pkn" maxlength="20" value="${esc48(G.n)}" autocomplete="off" aria-describedby="mge" aria-invalid="false" oninput="mgName(this.value)" onkeydown="if(event.key==='Enter'&&!$('#mgs').disabled)pkRename()"><div class="mge" id="mge" role="alert"></div>
<label class="lab" for="mgt" style="margin-top:12px">${t3('Savings goal (optional)','Intego yo kubika (si ngombwa)','Objectif d’épargne (facultatif)')}</label><div class="mgf"><input class="in" id="mgt" inputmode="numeric" placeholder="${t3('No goal','Nta ntego','Aucun objectif')}" value="${G.t?fmt(G.t):''}" oninput="mgGoal(this.value)" onkeydown="if(event.key==='Enter'&&!$('#mgs').disabled)pkRename()"><i>RWF</i></div>
<div class="pkauto" id="mgc" role="group" aria-label="${t3('Quick goals','Intego zihuse','Objectifs rapides')}"><button data-v="0" aria-pressed="${!G.t}" class="${G.t?'':'on'}" onclick="mgChip(0)">${t3('None','Nta ntego','Aucun')}</button>${CH.map(v=>`<button data-v="${v}" aria-pressed="${G.t===v}" class="${G.t===v?'on':''}" aria-label="${fmt(v)} RWF" onclick="mgChip(${v})">${v/1000}K</button>`).join('')}</div>
<div class="mgb" id="mgbw" style="display:${G.t?'block':'none'}"><i id="mgbar" style="width:${n.w}%"></i></div><div class="mgn" id="mgn">${n.h}</div>
<button class="btn" id="mgs" style="margin-top:20px" ${mgDirty()&&!mgErr()?'':'disabled'} onclick="pkRename()">${t3('Save changes','Bika impinduka','Enregistrer')}</button>
${b?`<div class="mgk">${t3('To delete this pocket, first take out the '+fmt(b)+' RWF.','Kugira ngo usibe aka gasanduku, banza ukuremo RWF '+fmt(b)+'.','Pour supprimer cette poche, retirez d’abord les '+fmt(b)+' RWF.')} <button onclick="closeSheet();openMv('out')">${t3('Take out','Kuramo','Retirer')}</button></div>`:`<button class="mgd" onclick="pkDelAsk()">${t3('Delete pocket','Siba agasanduku','Supprimer la poche')}</button>`}</div>`};
window.pkRename=function(){const p=pk(),G=S.mg;if(!p||!G)return;S.mgTouched=true;const e=mgErr();if(e){mgUpd();return}
p.n=G.n.trim().slice(0,20);if(G.t)p.t=G.t;else delete p.t;closeSheet();render('fade-none');toast(t3('Changes saved','Impinduka zabitswe','Modifications enregistrées'))};
window.pkDelAsk=function(){const p=pk();if(!p||p.id==='jar'||pkBal(p))return;
$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" role="dialog" aria-modal="true" aria-label="${t3('Delete pocket','Siba agasanduku','Supprimer la poche')}"><div class="h1" style="font-size:22px;line-height:30px">${t3('Delete','Gusiba','Supprimer')} ${esc48(p.n)}?</div><div class="mu" style="font-size:15px;line-height:22px;margin:8px 0 24px">${t3("This pocket and its history will be removed. This can't be undone.",'Aka gasanduku n’amateka yako bizasibwa. Ntibishobora gusubizwaho.','Cette poche et son historique seront supprimés. Cette action est irréversible.')}</div><div class="row2"><button class="btn sec2" onclick="pkManage()">${t3('Cancel','Hagarika','Annuler')}</button><button class="btn mgdel" onclick="pkDelete()">${t3('Delete','Siba','Supprimer')}</button></div></div>`};
window.pkDelete=function(){const p=pk();if(!p||p.id==='jar'||pkBal(p))return;S.pk=S.pk.filter(x=>x.id!==p.id);closeSheet();S.stack.pop();render('pop');toast(t3('Pocket deleted','Agasanduku gasibwe','Poche supprimée'))};
}
/* v292: Manage pocket. Before: a pop-up with a name field and five goal chips, a Delete button beside Save that was greyed out with a small line when the pocket had money, and no check before deleting. Now: the pocket's icon, name and balance at the top; a Name field with the error shown under it as you type (empty, or a name you already use); a Savings goal field where you type any amount (RWF, thousands separators) or tap 50,000 / 100,000 / 250,000 / 500,000 / None, with a slim bar and "120,000 / 300,000 RWF · 40%" under it; one full-width "Save changes" that stays off until something changed and is valid (Enter saves too). Delete is a quiet red line at the bottom; it asks "Delete School fees?" with Cancel / Delete before anything is removed. A pocket that still has money shows "To delete this pocket, first take out the X RWF" with a Take out link that opens the take-out screen. The Interest jar sheet is unchanged apart from language. English, French and Kinyarwanda; fr is new copy and rw is new copy that needs native review, especially "Siba agasanduku" and "Bika impinduka". */

/* v293 itunda card */
{const t3=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e,LIMS=[[100000,'100K'],[250000,'250K'],[500000,'500K'],[1000000,'1M']];
const sw3=(on,fn,l)=>`<div class="sw ${on?'on':''}" role="switch" aria-checked="${!!on}" aria-label="${esc48(l)}" tabindex="0" onclick="${fn}"><i></i></div>`;
const dt3=d=>d.toLocaleDateString(({en:'en-GB',fr:'fr-FR',rw:'en-GB'})[S.lang]||'en-GB',{day:'numeric',month:'long',year:'numeric'});
const cdPays=()=>S.act.filter(x=>x[3]<0&&x[5]&&!['send','cyc','up'].includes(x[0]));
const cdUsed=()=>{const d=new Date().toDateString();return cdPays().reduce((a,x)=>new Date(x[5]).toDateString()===d?a-x[3]:a,0)};
const cdRecent=()=>{const l=cdPays().slice(0,3),dl=ms=>new Date(ms).toLocaleDateString(({en:'en-GB',fr:'fr-FR',rw:'en-GB'})[S.lang]||'en-GB',{day:'numeric',month:'short'});
return `<div class="pad" style="padding-top:26px;padding-bottom:4px"><div class="cdh">${t3('Recent card payments','Ibyishyuwe vuba n’ikarita','Paiements récents par carte')}</div></div><div class="pad" style="padding-top:4px;padding-bottom:0">${l.length?l.map(x=>`<div class="bdr" role="button" tabindex="0" onclick="actOpen(${S.act.indexOf(x)})" style="padding-left:0;padding-right:0"><div class="ico">${gx(x[0],26)}</div><div style="min-width:0"><div class="t">${esc48(x[1])}</div><div class="s">${dl(x[5])}</div></div><div class="pkv"><b>${fmt(-x[3])} RWF</b></div></div>`).join(''):`<div class="mu" style="font-size:15px;line-height:22px;padding:8px 0">${t3('No card payments yet. They will show here.','Nta kwishyura n’ikarita kurakorwa. Bizagaragara hano.','Aucun paiement par carte. Ils apparaîtront ici.')}</div>`}</div>`};
screens.card=()=>{const c=S.card,cc=S.cc,rp=cc.repl,fz=c.frozen,f=FIN[S.finish]||FIN.Indigo,nm=S.name||'Amina Uwase';
const act=(i,l,fn)=>`<button class="ppa" onclick="${fn}"><i>${ic(i,22)}</i>${l}</button>`;
const tg=(k,l,sub)=>`<div class="r95"><div style="flex:1"><div style="font-size:16px;font-weight:700">${l}</div><div class="sm mu">${sub}</div></div>${sw3(cc[k],`ccTg('${k}')`,l)}</div>`;
const face=`<div id="cv" class="cv cdf ${fz?'frozen':''}" role="button" tabindex="0" aria-label="${t3('Show card details','Erekana amakuru y’ikarita','Afficher les détails de la carte')}" onclick="ccShow(0)" onkeydown="if(event.key==='Enter')ccShow(0)" style="margin:24px 24px 0;height:200px;border-radius:28px;background:${f.bg};color:${f.fg};padding:22px;position:relative;box-shadow:none"><div style="display:flex;justify-content:space-between;align-items:flex-start">${knot(44,f.fg)}<span id="cst" style="font-size:13px;font-weight:800;background:rgba(127,127,127,.22);padding:6px 12px;border-radius:14px">${fz?t('c_frz'):t('c_act')}</span></div><div style="position:absolute;left:22px;right:22px;bottom:20px"><div style="display:flex;justify-content:space-between;align-items:baseline;gap:12px;opacity:.85"><span style="min-width:0;font-size:12px;font-weight:800;letter-spacing:1.2px;text-transform:uppercase;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${esc48(nm)}</span><span style="flex:none;font-size:13px;font-weight:700;white-space:nowrap">10/29</span></div><div style="font-size:18px;font-weight:800;letter-spacing:1px;margin-top:6px;white-space:nowrap">•••• •••• •••• ${c.last}</div></div><div class="lk">${gl('lock',64)}</div></div><div class="cdcap">${t3('Spends from your itunda balance. Tap the card for its details.','Ikoresha amafaranga ya itunda yawe. Kanda ku ikarita urebe amakuru yayo.','Dépense depuis votre solde itunda. Touchez la carte pour ses détails.')}</div>`;
const banner=rp?`<div class="ban95"><b>${t3('Card blocked','Ikarita yahagaritswe','Carte bloquée')}</b><br>${t3('Your new card will be ready at ','Ikarita yawe nshya izaba iri kuri ','Votre nouvelle carte sera prête à ')}${esc48(rp.b)} · ${dt3(new Date(rp.eta))}.</div><div class="pad" style="padding-top:12px"><button class="btn" style="margin-top:10px" onclick="ccGot()">${t3('I collected my new card','Mfashe ikarita yanjye nshya','J’ai retiré ma nouvelle carte')}</button></div>`
:`${fz?`<div class="ban95"><b>${t3('Card frozen','Ikarita yahagaritswe by’agateganyo','Carte gelée')}</b><br>${t3('Payments, ATM and online are paused. Unfreeze when you are ready.','Kwishyura, ATM no kuri interineti byarahagaze. Yongere uyikoreshe igihe wiyumvira.','Paiements, DAB et achats en ligne sont suspendus. Dégelez quand vous voulez.')}<br><button class="chip" style="margin-top:10px;background:var(--bg);color:var(--er)" onclick="ccLost()">${t3('Lost or stolen?','Yabuze cyangwa yibwe?','Perdue ou volée ?')}</button></div>`:''}<div class="pad" style="display:flex;gap:8px;padding-top:18px">${act('lock',t3('Details','Amakuru','Détails'),'ccShow(0)')}${act('shield',fz?t3('Unfreeze','Kuvanaho','Dégeler'):t3('Freeze','Hagarika','Geler'),'ccFreeze()')}${act('gear','PIN','ccPin()')}</div>`;
const used=cdUsed(),pc=Math.min(100,Math.round(used/cc.lim*100));
return `${bar(t('c_title'))}${face}${banner}
<div class="pad" style="padding-top:22px;padding-bottom:8px"><div class="cdh">${t3('Controls','Igenzura','Contrôles')}</div></div><div class="cc95 ${fz||rp?'cdoff':''}">${tg('online',t3('Online payments','Kwishyura kuri interineti','Paiements en ligne'),t3('Shops and apps','Amaduka na porogaramu','Boutiques et applications'))}${tg('intl',t3('International use','Gukoresha mu mahanga','Utilisation à l’étranger'),t3('Pay and withdraw abroad','Kwishyura no gukuramo hanze','Payer et retirer à l’étranger'))}${tg('tap',t3('Contactless','Gukoza ikarita','Sans contact'),t3('Tap to pay in shops','Kwishyura ukoza','Payer en approchant'))}${tg('atm',t3('ATM withdrawals','Gukuramo kuri ATM','Retraits DAB'),t3('Cash from machines','Amafaranga kuri mashini','Espèces aux distributeurs'))}</div>
<div class="pad" style="padding-top:26px"><div class="cdh">${t3('Daily spending limit','Imbibi y’amafaranga ya buri munsi','Plafond de dépense quotidien')}</div><div class="sm mu" style="margin-top:4px">${fmt(used)} ${t3('of','kuri','sur')} ${fmt(cc.lim)} RWF ${t3('used today','yakoreshejwe uyu munsi','utilisés aujourd’hui')}</div><div class="cdbar" role="progressbar" aria-valuenow="${pc}" aria-valuemin="0" aria-valuemax="100"><i style="width:${pc}%;${pc>=80?'background:var(--er)':''}"></i></div><div class="cdch" role="group">${LIMS.map(([v,l])=>`<button class="${cc.lim===v?'on':''}" aria-pressed="${cc.lim===v}" aria-label="${fmt(v)} RWF" onclick="ccLim(${v})">${l}</button>`).join('')}</div></div>
${cdRecent()}<div class="pad" style="padding-top:26px;padding-bottom:8px"><div class="cdh">${t3('Online card','Ikarita yo kuri interineti','Carte en ligne')}</div></div><div class="pad" style="padding-top:0;padding-bottom:0">${cc.virt?`<div class="cc95" style="margin:0"><div class="r95"><div style="flex:1"><div style="font-size:16px;font-weight:700">•••• ${cc.virt.pan.slice(-4)}</div><div class="sm mu">${t3('Separate number for online shopping','Nimero yihariye yo kugura kuri interineti','Numéro séparé pour les achats en ligne')}</div></div><button class="chip" onclick="ccShow(1)">${t3('Show','Erekana','Afficher')}</button><button class="chip" aria-label="${t3('Delete','Siba','Supprimer')}" onclick="ccVirtDel()">${ic('plus',16).replace('<svg','<svg style="transform:rotate(45deg)"')}</button></div></div>`:row('card',t3('Create an online card','Kora ikarita yo kuri interineti','Créer une carte en ligne'),t3('A separate number for online shopping. Delete it any time.','Nimero yihariye yo kugura kuri interineti. Ushobora kuyisiba igihe cyose.','Un numéro séparé pour les achats en ligne. Supprimable à tout moment.'),'','ccVirtNew()')}</div>
<div class="pad" style="padding-top:26px;padding-bottom:0"><div class="cdh">${t3('Need help?','Ukeneye ubufasha?','Besoin d’aide ?')}</div></div><div class="pad" style="padding-top:6px">${row('warning3d',t3('Report lost or stolen','Menyesha ko yabuze cyangwa yibwe','Signaler perdue ou volée'),'','','ccLost()')}${row('receipt',t3('Close card','Funga ikarita','Fermer la carte'),'','','ccClose()')}</div><div class="pad fine" style="padding-top:14px;padding-bottom:28px">${t('c_disc')}</div>`};
}
/* v293: itunda card. Before: a plain card (itunda card, last four digits, "Bank"), three actions where "Show details" wrapped onto two lines, the four daily-limit chips wrapped onto a second row, the "Create an online card" row ran into the screen edge, and a frozen card looked the same as an active one apart from a small label. Now: the card shows your name, •••• •••• •••• 4417 and the expiry, with the status (Active / Frozen) at the top right, and tapping it opens the details (PIN first, as before); a line under it says it spends from your itunda balance. Actions are Details, Freeze and PIN on one line each. A frozen card shows a banner ("Payments, ATM and online are paused") and its controls are dimmed until you unfreeze; a blocked card keeps its "collect your new card" banner and also dims the controls. The daily limit has a slim bar under "0 of 500,000 RWF used today" and the four chips (100K, 250K, 500K, 1M) share one line. The online card row is padded like the rest, and Report lost or stolen / Close card sit under a "Need help?" heading. English, French and Kinyarwanda; fr is new copy and rw is new copy that needs native review, especially "Ikarita yahagaritswe by’agateganyo" and "Yongere uyikoreshe igihe wiyumvira". */

/* v294 Manage account */
{const t3=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e;
window.bkManage=()=>{S.stack.push('bkmanage');render('push')};
window.bkMgShare=()=>toast(t3('Details shared (sample)','Amakuru yasangijwe (icyitegererezo)','Détails partagés (exemple)'));
window.bkMgCard=()=>{S.stack.push(S.card?'card':'nocard');render('push')};
window.bkMgSch=()=>{S.stack.push('bksch');render('push')};
window.bkMgAuto=()=>{S.stack.push('autot');render('push')};
screens.bkmanage=()=>{const nm=S.name||'Amina Uwase',ir=S.pk.reduce((a,p)=>a+(p.ir||0),0),ns=(S.bsc||[]).filter(x=>!x.done).length,dl=S.lim&&S.lim.day?S.lim.day:0;
const sec=(h,rows)=>`<div class="sec"><div class="sech">${h}</div>${rows.join('')}</div>`;
return `${bar(t3('Manage account','Gucunga konti','Gérer le compte'))}
<div style="margin:16px 24px 0;padding:18px;border-radius:20px;background:var(--chip)"><div class="sm mu">itunda Bank</div><div style="font-size:20px;font-weight:800;margin-top:4px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${esc48(nm)}</div><div style="font-size:16px;font-weight:700;letter-spacing:1px;margin-top:2px;color:var(--mu)">${ACC50}</div><div style="display:flex;gap:8px;margin-top:14px"><button class="chip tap" style="background:var(--bg)" onclick="bkCopy()">${t3('Copy number','Koporora nimero','Copier le numéro')}</button><button class="chip tap" style="background:var(--bg)" onclick="bkMgShare()">${t3('Share','Sangiza','Partager')}</button></div></div>
${sec(t3('Account','Konti','Compte'),[row('bank',t3('Account details','Amakuru ya konti','Détails du compte'),t3('Holder, number, bank, branch','Nyir’konti, nimero, banki, ishami','Titulaire, numéro, banque, agence'),'','bkAcct()'),row('bolt',t3('Interest','Inyungu','Intérêts'),t3('4.0% a year (sample)','4.0% ku mwaka (icyitegererezo)','4,0 % par an (exemple)'),'<b style="font-size:15px;margin-right:6px">'+fmt(ir)+' RWF</b>','intSheet()')])}
${sec(t3('Money','Amafaranga','Argent'),[row('lock',t3('Limits & alerts','Imbibi n’imenyesha','Plafonds et alertes'),dl?t3('Daily limit ','Imbibi ya buri munsi ','Plafond ')+fmt(dl)+' RWF':'','','bkLim()'),row('cal',t3('Scheduled transfers','Kohereza byateganyijwe','Virements programmés'),ns?ns+' '+t3('scheduled','byateganyijwe','programmé'+(ns>1?'s':'')):t3('Rent, fees, monthly gifts','Ubukode, ishuri, impano','Loyer, frais, cadeaux'),'','bkMgSch()'),row('coin',t3('Auto-transfer','Kohereza byikora','Virement automatique'),t3('Move money on its own','Imura amafaranga byikora','Déplacer l’argent automatiquement'),'','bkMgAuto()')])}
${sec(t3('Documents','Inyandiko','Documents'),[row('bill',t3('Statement','Raporo','Relevé'),t3('Pick a period, CSV or PDF','Hitamo igihe, CSV cyangwa PDF','Choisissez une période, CSV ou PDF'),'','bkStmt()'),row('receipt',t3('Documents & letters','Inyandiko n’amabaruwa','Documents et lettres'),t3('Account letter, proof of balance','Ibaruwa ya konti, icyemezo cy’amafaranga','Lettre de compte, attestation de solde'),'','bkDocs()')])}
${sec(t3('Card','Ikarita','Carte'),[row('card',t3('Card','Ikarita','Carte'),S.card?'•••• '+S.card.last+(S.card.frozen?' · '+t('c_frz'):''):t3('Get your itunda card','Fata ikarita yawe ya itunda','Obtenez votre carte itunda'),'','bkMgCard()')])}
<div class="pad fine" style="padding-top:14px;padding-bottom:28px">${t3('Sample data for this prototype.','Amakuru y’icyitegererezo.','Données d’exemple pour ce prototype.')}</div>`};
}
/* v294: Manage account. Before: a small pop-up with three lines (account number, account name showing "You", interest) and two buttons of different heights (Close, Copy number); nothing in it could be managed. Now Manage opens a page: your name and account number with Copy number and Share; then Account (Account details, Interest with what you have earned), Money (Limits & alerts with your daily transfer limit, Scheduled transfers with how many are set, Auto-transfer), Documents (Statement, Documents & letters) and Card (last four digits, or Get your itunda card). Each row opens the screen that already does the job. The account name now matches the rest of the app (Amina Uwase) instead of "You". English, French and Kinyarwanda; fr is new copy and rw is new copy that needs native review, especially "Gucunga konti" and "Kohereza byikora". */

/* v295 Foreign currency */
{const t3=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e,CODES=['USD','EUR','GBP'],FLAG={USD:'🇺🇸',EUR:'🇪🇺',GBP:'🇬🇧'},RATE={USD:1445,EUR:1680,GBP:1960},MINB=5000,QB=[20000,50000,100000,250000];
const fx=()=>{const x=S.fx;if(!x.d)x.d='buy';if(x.s==null)x.s=0;if(!x.w)x.w={USD:0,EUR:0,GBP:0};return x};
const cur=()=>CODES[fx().c]||'USD',d2=n=>(Math.floor(n*100+1e-6)/100).toFixed(2);
const buy=()=>fx().d==='buy';
const calc=()=>{const x=fx(),c=cur(),r=RATE[c],w=x.w[c]||0;let err='',ok=false,pay,get;
if(buy()){pay=x.a;get=x.a/r;if(!x.a)err='';else if(x.a<MINB)err=t3('Minimum is '+fmt(MINB)+' RWF','Nibura ni RWF '+fmt(MINB),'Minimum : '+fmt(MINB)+' RWF');else if(x.a>S.bank)err=t3('Not enough balance. You have '+fmt(S.bank)+' RWF.','Nta mafaranga ahagije. Ufite RWF '+fmt(S.bank)+'.','Solde insuffisant. Vous avez '+fmt(S.bank)+' RWF.');else ok=true}
else{pay=x.s;get=Math.round(x.s*r);if(!x.s)err='';else if(x.s<1)err=t3('Minimum is 1.00 '+c,'Nibura ni '+c+' 1.00','Minimum : 1,00 '+c);else if(x.s>w+1e-9)err=t3('Not enough in your '+c+' wallet. You have '+d2(w)+' '+c+'.','Nta mafaranga ahagije muri '+c+'. Ufite '+d2(w)+' '+c+'.','Solde insuffisant. Vous avez '+d2(w)+' '+c+'.');else ok=true}
return {c,r,w,err,ok,pay,get}};
const quick=()=>buy()?QB.map(n=>[n,n/1000+'K',fx().a===n]):[[.25,'25%'],[.5,'50%'],[1,t3('All','Byose','Tout')]].map(([p,l])=>[p,l,Math.abs(fx().s-Math.floor((fx().w[cur()]||0)*p*100)/100)<.005&&fx().s>0]);
const lbl=k=>buy()?(k.ok?t3('Convert '+fmt(k.pay)+' RWF to '+k.c,'Hindura RWF '+fmt(k.pay)+' mu '+k.c,'Convertir '+fmt(k.pay)+' RWF en '+k.c):t3('Convert to '+k.c,'Hindura mu '+k.c,'Convertir en '+k.c)):(k.ok?t3('Convert '+d2(k.pay)+' '+k.c+' to RWF','Hindura '+k.c+' '+d2(k.pay)+' mu RWF','Convertir '+d2(k.pay)+' '+k.c+' en RWF'):t3('Convert to RWF','Hindura mu RWF','Convertir en RWF'));
function fxUpd(){const k=calc(),x=fx(),g=$('#fxg'),e=$('#fxe'),n=$('#fxn'),b=$('#fxb');if(!g)return;
g.innerHTML=(buy()?(k.pay?d2(k.get)+' '+k.c:'0.00 '+k.c):(k.pay?fmt(k.get)+' RWF':'0 RWF'));
e.textContent=k.err;$('#fxi').setAttribute('aria-invalid',k.err?'true':'false');
n.textContent=buy()?(k.ok?t3('itunda Bank after: '+fmt(S.bank-k.pay)+' RWF','itunda Bank nyuma: RWF '+fmt(S.bank-k.pay),'itunda Bank après : '+fmt(S.bank-k.pay)+' RWF'):''):(k.ok?t3('itunda Bank after: '+fmt(S.bank+k.get)+' RWF','itunda Bank nyuma: RWF '+fmt(S.bank+k.get),'itunda Bank après : '+fmt(S.bank+k.get)+' RWF'):'');
b.disabled=!k.ok;b.textContent=lbl(k);
document.querySelectorAll('#fxq button').forEach((el,i)=>{const on=quick()[i][2];el.classList.toggle('on',on);el.setAttribute('aria-pressed',on?'true':'false')})}
window.fxIn=v=>{const x=fx();if(buy()){x.a=Math.min(999999999,Number(String(v).replace(/\D/g,''))||0);const i=$('#fxi');i.value=x.a?fmt(x.a):''}else{let q=String(v).replace(/[^\d.]/g,'');const p=q.split('.');q=p[0]+(p.length>1?'.'+p[1].slice(0,2):'');x.s=Number(q)||0;if(q!==String(v))$('#fxi').value=q}fxUpd()};
window.fxQ=i=>{const x=fx(),v=quick()[i][0];if(buy()){x.a=v}else{x.s=Math.floor((x.w[cur()]||0)*v*100)/100}fxDraw()};
window.fxCur=i=>{fx().c=i;fx().s=0;fxDraw()};
window.fxDir=d=>{const x=fx();x.d=d;x.s=0;fxDraw()};
window.fxWal=i=>{const x=fx();x.c=i;x.d=(x.w[CODES[i]]||0)>0?'sell':'buy';x.s=0;fxDraw();const sc=$('#phone .screen');if(sc)sc.scrollTop=0};
function fxDraw(){render('fade-none')}
screens.fx=()=>{const x=fx(),k=calc(),c=k.c,b=buy();
const flagc=CODES.map((cc,i)=>`<button class="${x.c===i?'on':''}" aria-pressed="${x.c===i}" onclick="fxCur(${i})">${FLAG[cc]} ${cc}</button>`).join('');
const seg=`<div class="cdch" style="margin:16px 24px 0" role="group"><button class="${b?'on':''}" aria-pressed="${b}" onclick="fxDir('buy')">${t3('Buy '+c,'Gura '+c,'Acheter '+c)}</button><button class="${b?'':'on'}" aria-pressed="${!b}" onclick="fxDir('sell')">${t3('Sell '+c,'Gurisha '+c,'Vendre '+c)}</button></div>`;
const av=b?t3('Available: '+fmt(S.bank)+' RWF','Ahari: RWF '+fmt(S.bank),'Disponible : '+fmt(S.bank)+' RWF'):t3('In your wallet: '+d2(k.w)+' '+c,'Muri wallet: '+d2(k.w)+' '+c,'Dans votre portefeuille : '+d2(k.w)+' '+c);
const q=quick();
const wal=CODES.map((cc,i)=>{const w=x.w[cc]||0;return `<button class="fxw" onclick="fxWal(${i})"><span class="fxf">${FLAG[cc]}</span><span class="nm"><b>${cc}</b><span>${w>0?t3('Tap to sell','Kanda ugurishe','Touchez pour vendre'):t3('Tap to buy','Kanda ugure','Touchez pour acheter')}</span></span><span class="am"><b>${d2(w)} ${cc}</b><span>≈ ${fmt(Math.round(w*RATE[cc]))} RWF</span></span></button>`}).join('');
return `${bar(t3('Foreign currency','Amafaranga y’amahanga','Devises'))}<div class="fxc" role="group" aria-label="${t3('Currency','Ifaranga','Devise')}">${flagc}</div>${seg}
<div class="fxa"><label class="sm mu" for="fxi">${b?t3('You pay','Wishyura','Vous payez'):t3('You sell','Ugurisha','Vous vendez')}</label><div class="fxr"><input class="in" id="fxi" inputmode="${b?'numeric':'decimal'}" autocomplete="off" placeholder="0" value="${b?(x.a?fmt(x.a):''):(x.s?String(x.s):'')}" oninput="fxIn(this.value)" aria-describedby="fxe" aria-invalid="${!!k.err}"><b>${b?'RWF':c}</b></div><div class="sm mu" style="margin-top:2px">${av}</div></div>
<div class="cdch" id="fxq" style="margin:10px 24px 0" role="group" aria-label="${t3('Quick amounts','Umubare uhuse','Montants rapides')}">${q.map(([v,l,on],i)=>`<button class="${on?'on':''}" aria-pressed="${on}" onclick="fxQ(${i})">${l}</button>`).join('')}</div><div class="fxe" id="fxe" role="alert">${k.err}</div>
<div class="fxg"><div class="sm">${t3('You get','Uhabwa','Vous recevez')}</div><b id="fxg">${b?(k.pay?d2(k.get)+' '+c:'0.00 '+c):(k.pay?fmt(k.get)+' RWF':'0 RWF')}</b></div>
<div class="sm mu" style="padding:12px 24px 0">1 ${c} = ${fmt(k.r)} RWF · ${t3('No fee','Nta kiguzi','Sans frais')} · ${t3('Sample rate, updated just now','Igiciro cy’icyitegererezo, kigezweho','Taux d’exemple, à l’instant')}</div><div class="sm mu" id="fxn" style="padding:4px 24px 0">${k.ok?(b?t3('itunda Bank after: '+fmt(S.bank-k.pay)+' RWF','itunda Bank nyuma: RWF '+fmt(S.bank-k.pay),'itunda Bank après : '+fmt(S.bank-k.pay)+' RWF'):t3('itunda Bank after: '+fmt(S.bank+k.get)+' RWF','itunda Bank nyuma: RWF '+fmt(S.bank+k.get),'itunda Bank après : '+fmt(S.bank+k.get)+' RWF')):''}</div>
<div style="padding:22px 24px 4px;font-size:18px;font-weight:800">${t3('Your wallets','Ama wallet yawe','Vos portefeuilles')}</div>${wal}<div style="height:110px"></div>
<div class="cta"><button class="btn" id="fxb" ${k.ok?'':'disabled'} onclick="fxAsk()">${lbl(k)}</button></div>`};
const rw=(a,v)=>`<div style="display:flex;justify-content:space-between;gap:12px;min-height:40px;align-items:center;font-size:15px"><span class="mu">${a}</span><b style="text-align:right">${v}</b></div>`;
window.fxAsk=()=>{const k=calc();if(!k.ok)return;const c=k.c,b=buy();
const rows=b?rw(t3('You pay','Wishyura','Vous payez'),fmt(k.pay)+' RWF')+rw(t3('You get','Uhabwa','Vous recevez'),d2(k.get)+' '+c)+rw(t3('Rate','Igiciro','Taux'),'1 '+c+' = '+fmt(k.r)+' RWF')+rw(t3('Fee','Kiguzi','Frais'),t3('None','Nta kiguzi','Aucun'))+rw(t3('itunda Bank after','itunda Bank nyuma','itunda Bank après'),fmt(S.bank-k.pay)+' RWF')
:rw(t3('You sell','Ugurisha','Vous vendez'),d2(k.pay)+' '+c)+rw(t3('You get','Uhabwa','Vous recevez'),fmt(k.get)+' RWF')+rw(t3('Rate','Igiciro','Taux'),'1 '+c+' = '+fmt(k.r)+' RWF')+rw(t3('Fee','Kiguzi','Frais'),t3('None','Nta kiguzi','Aucun'))+rw(t3('Goes to','Bijya muri','Versé sur'),'itunda Bank');
$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" role="dialog" aria-modal="true" aria-label="${t3('Review','Suzuma','Vérifier')}"><div class="h1" style="font-size:22px;line-height:30px;margin-top:4px">${b?t3('Convert to '+c+'?','Guhindura mu '+c+'?','Convertir en '+c+' ?'):t3('Sell '+d2(k.pay)+' '+c+'?','Gurisha '+d2(k.pay)+' '+c+'?','Vendre '+d2(k.pay)+' '+c+' ?')}</div><div style="margin:12px 0 20px">${rows}</div><div class="row2" style="display:grid;grid-template-columns:1fr 1.8fr"><button class="btn sec2" onclick="closeSheet()">${t3('Cancel','Reka','Annuler')}</button><button class="btn" style="white-space:nowrap" onclick="fxDo()">${b?t3('Convert','Hindura','Convertir'):t3('Sell','Gurisha','Vendre')}</button></div></div>`;if(typeof focusSheet==='function')focusSheet()};
window.fxDo=()=>{const k=calc();if(!k.ok){closeSheet();return}const x=fx(),c=k.c,b=buy();let tt,bd;
if(b){S.bank-=k.pay;x.w[c]=(x.w[c]||0)+k.pay/k.r;addAct('cyc','Converted to '+c,'Converted',-k.pay,'Moved');tt=t3('Converted to '+c,'Byahinduwe mu '+c,'Converti en '+c);bd=t3(fmt(k.pay)+' RWF became '+d2(k.get)+' '+c+'. It is in your '+c+' wallet.','RWF '+fmt(k.pay)+' yabaye '+d2(k.get)+' '+c+'. Iri muri wallet yawe ya '+c+'.',fmt(k.pay)+' RWF sont devenus '+d2(k.get)+' '+c+'. Ils sont dans votre portefeuille '+c+'.');x.a=50000}
else{x.w[c]=Math.max(0,(x.w[c]||0)-k.pay);if(x.w[c]<.005)x.w[c]=0;S.bank+=k.get;addAct('cyc',c+' converted to RWF','Converted',k.get,'Moved');tt=t3(c+' converted to RWF',c+' yahindutse RWF',c+' converti en RWF');bd=t3(d2(k.pay)+' '+c+' became '+fmt(k.get)+' RWF in itunda Bank.',d2(k.pay)+' '+c+' yabaye RWF '+fmt(k.get)+' muri itunda Bank.',d2(k.pay)+' '+c+' sont devenus '+fmt(k.get)+' RWF sur itunda Bank.');x.s=0;x.d=(x.w[c]||0)>0?'sell':'buy'}
$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" role="dialog" aria-modal="true" aria-label="${esc48(tt)}"><div style="font-size:56px;line-height:1;margin-bottom:10px">💱</div><div class="h1" style="font-size:22px;line-height:30px">${esc48(tt)}</div><div class="mu" style="font-size:15px;margin:8px 0 24px;line-height:22px">${esc48(bd)}</div><button class="btn" onclick="closeSheet();render('fade-none')">OK</button></div>`;if(typeof focusSheet==='function')focusSheet();render('fade-none')};
}
/* v295: Foreign currency. Before: pick USD / EUR / GBP, change the amount with − and + (10,000 a tap) or four shortcut chips, one big "Convert" button; selling back was a small button that only appeared inside a wallet row and moved the whole balance; wallets were plain lines; the new copy (review sheet, shortcuts) was English only. Now: one screen with Buy and Sell tabs for the chosen currency. You type the amount (thousands separators for RWF, two decimals for a currency) or tap 20K / 50K / 100K / 250K (or 25% / 50% / All when selling); the line under the field shows what you have available, mistakes show in red under the amount (minimum, not enough balance), and "You get" updates as you type. The button names the amount ("Convert 50,000 RWF to USD") and opens a review sheet (you pay, you get, rate, fee, balance after); a result sheet confirms it. Selling can be part of a wallet, not only all of it. "Your wallets" shows each balance with its RWF value, and tapping one opens it ready to sell (or to buy when it is empty). Both directions still appear in Activity. English, French and Kinyarwanda; fr is new copy and rw is new copy that needs native review, especially "Gurisha", "Wishyura" and "Amafaranga y’amahanga". */
/* v296 Spending */
{const t3=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e;
const esc48=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const CAT={Food:['restaurant','#6960F9',['Ibyokurya','Alimentation'],'Food'],Shopping:['bag','#E8590C',['Guhaha','Achats'],'Shopping'],Transport:['transit','#0A8F5B',['Ingendo','Transport'],'Transport'],Bills:['bill','#C28A00',['Fagitire','Factures'],'Bills'],Other:['wallet','#8B95A1',['Ibindi','Autres'],'Other']};
const DATA=[
{Food:[128000,[['Simba Supermarket',34500,'Oct 17'],['Inka Kitchen',18200,'Oct 15'],['Eats delivery',12800,'Oct 12']]],Shopping:[61000,[['Kimironko Market',27000,'Oct 16'],['Shop order',21000,'Oct 9']]],Transport:[54000,[['Moto rides',31000,'Oct 18'],['Bus top-up',12000,'Oct 11']]],Bills:[43000,[['MTN airtime & data',15000,'Oct 14'],['Canal+',12000,'Oct 5']]],Other:[26000,[['Pharmacy',14500,'Oct 13'],['Salon',8000,'Oct 6']]]},
{Food:[141000,[['Simba Supermarket',41000,'Sep 26'],['Inka Kitchen',22400,'Sep 19'],['Eats delivery',15600,'Sep 11']]],Shopping:[48000,[['Kimironko Market',24000,'Sep 21'],['Shop order',14000,'Sep 8']]],Transport:[52000,[['Moto rides',30000,'Sep 24'],['Bus top-up',12000,'Sep 10']]],Bills:[43000,[['MTN airtime & data',15000,'Sep 14'],['Canal+',12000,'Sep 5']]],Other:[19000,[['Pharmacy',11000,'Sep 17'],['Salon',6000,'Sep 4']]]}];
const nm=k=>S.lang==='rw'?CAT[k][2][0]:S.lang==='fr'?CAT[k][2][1]:CAT[k][3];
const ord=m=>Object.keys(DATA[m]).sort((a,b)=>DATA[m][b][0]-DATA[m][a][0]);
const tot=m=>Object.values(DATA[m]).reduce((a,x)=>a+x[0],0);
window.spMon=i=>{S.spm=i;S.spx=null;render('fade-none')};
window.spOpen=k=>{S.spx=S.spx===k?null:k;render('fade-none')};
window.spBud=()=>{S.stack.push('bkbud');render('push')};
screens.spend=()=>{const m=S.spm===1?1:0,o=1-m,d=DATA[m],T=tot(m),P=tot(o),df=T-P,pct=Math.round(Math.abs(df)*100/P),ks=ord(m),top=ks[0],tp=Math.round(d[top][0]*100/T);
const days=m===0?Math.max(1,new Date().getDate()):30,avg=Math.round(T/days),B=S.bbg&&S.bbg.lim?S.bbg.lim:0;
const mon=[t3('This month','Uku kwezi','Ce mois-ci'),t3('Last month','Ukwezi gushize','Mois dernier')];
const delta=m===0?`<div class="sm" style="margin-top:6px;font-weight:700;color:${df>0?'var(--er)':'var(--ok)'}">${df>0?'▲ ':'▼ '}${fmt(Math.abs(df))} RWF (${pct}%) ${t3(df>0?'more than last month':'less than last month',df>0?'kurusha ukwezi gushize':'kuri munsi y’ukwezi gushize',df>0?'de plus que le mois dernier':'de moins que le mois dernier')}</div>`:'';
const stack=`<div role="img" aria-label="${ks.map(k=>nm(k)+' '+Math.round(d[k][0]*100/T)+'%').join(', ')}" style="display:flex;gap:3px;height:14px;margin-top:18px">${ks.map(k=>`<div style="flex:${d[k][0]};background:${CAT[k][1]};border-radius:4px;min-width:6px"></div>`).join('')}</div>`;
const budget=m===0?(B?`<div style="margin:20px 24px 0;padding:16px 18px;border-radius:18px;background:var(--chip)"><div style="display:flex;justify-content:space-between;gap:12px;font-size:15px"><b>${t3('Monthly budget','Ingengo y’ukwezi','Budget mensuel')}</b><span class="mu">${fmt(T)} / ${fmt(B)} RWF</span></div><div style="height:8px;border-radius:4px;background:var(--bg);margin-top:10px;overflow:hidden"><div style="height:100%;width:${Math.min(100,Math.round(T*100/B))}%;background:${T>B?'var(--er)':'var(--lk)'}"></div></div><div class="sm" style="margin-top:8px;font-weight:700;color:${T>B?'var(--er)':'var(--mu)'}">${T>B?t3('Over by ','Warengeje ','Dépassé de ')+fmt(T-B)+' RWF':fmt(B-T)+' RWF '+t3('left','busigaye','restants')}</div></div>`:`<button class="row tap" onclick="spBud()" style="margin:20px 24px 0;width:calc(100% - 48px);padding:16px 18px;border:0;border-radius:18px;background:var(--tint);color:var(--tintfg);font:inherit;text-align:left;min-height:56px"><span style="flex:1;font-weight:800">${t3('Set a monthly budget','Shyiraho ingengo y’ukwezi','Fixer un budget mensuel')}</span>${ic('chev',16,'var(--tintfg)')}</button>`):'';
const rows=ks.map(k=>{const v=d[k][0],dv=m===0?v-DATA[o][k][0]:0;
return `<button class="row tap" onclick="spCat('${k}')" style="width:100%;border:0;background:none;font:inherit;color:inherit;text-align:left;padding:12px 0;min-height:68px"><div class="ico" style="box-shadow:inset 0 0 0 2px ${CAT[k][1]}">${gl(CAT[k][0],30)}</div><div style="flex:1;min-width:0"><div style="display:flex;justify-content:space-between;gap:12px"><div class="t">${nm(k)}</div><b style="white-space:nowrap">${fmt(v)} RWF</b></div><div style="display:flex;justify-content:space-between;gap:8px;margin-top:4px" class="sm"><span class="mu">${Math.round(v*100/T)}% ${t('y_ps')}</span>${dv?`<span style="font-weight:700;color:${dv>0?'var(--er)':'var(--ok)'}">${dv>0?'▲':'▼'} ${fmt(Math.abs(dv))}</span>`:''}</div></div>${ic('chev',16,'var(--tt)')}</button>`}).join('');
return `${bar(t('y_sp'))}<div class="seg" role="tablist">${mon.map((l,i)=>`<button role="tab" aria-selected="${m===i}" class="${m===i?'on':''}" onclick="spMon(${i})">${l}</button>`).join('')}</div>
<div class="pad" style="padding-top:22px"><div class="sm mu">${m===0?t3('Spent this month','Wakoresheje uku kwezi','Dépensé ce mois-ci'):t3('Spent last month','Wakoresheje ukwezi gushize','Dépensé le mois dernier')}</div><div class="big">${fmt(T)} RWF</div>${delta}<div class="sm mu" style="margin-top:6px">${t3('About '+fmt(avg)+' RWF a day','Hafi ya RWF '+fmt(avg)+' ku munsi','Environ '+fmt(avg)+' RWF par jour')}</div>${stack}</div>
${budget}
<div class="sec" style="padding-top:26px"><div class="sech">${t3('By category','Ukurikije ibyiciro','Par catégorie')}</div>${rows}</div>
<div class="pad fine" style="padding-top:12px;padding-bottom:28px">${t('y_sd')}</div>`};
window.spCat=k=>{S.spk=k;S.stack.push('spcat');render('push')};
screens.spcat=()=>{const m=S.spm===1?1:0,o=1-m,k=DATA[m][S.spk]?S.spk:'Food',d=DATA[m][k],v=d[0],T=tot(m),dv=m===0?v-DATA[o][k][0]:0,rest=v-d[1].reduce((a,x)=>a+x[1],0);
const R=(n,sub,a,mu)=>`<div style="display:flex;justify-content:space-between;align-items:center;gap:12px;padding:12px 0;min-height:56px"><span style="min-width:0"><span style="display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;${mu?'color:var(--mu)':''}">${n}</span>${sub?`<span class="sm mu">${sub}</span>`:''}</span><b style="white-space:nowrap">${fmt(a)} RWF</b></div>`;
return `${bar(nm(k))}<div class="pad" style="padding-top:22px"><div class="sm mu">${m===0?t3('This month','Uku kwezi','Ce mois-ci'):t3('Last month','Ukwezi gushize','Mois dernier')}</div><div class="big">${fmt(v)} RWF</div><div class="sm mu" style="margin-top:6px">${Math.round(v*100/T)}% ${t('y_ps')}</div>${dv?`<div class="sm" style="margin-top:4px;font-weight:700;color:${dv>0?'var(--er)':'var(--ok)'}">${dv>0?'▲ ':'▼ '}${fmt(Math.abs(dv))} RWF ${t3(dv>0?'more than last month':'less than last month',dv>0?'kurusha ukwezi gushize':'kuri munsi y’ukwezi gushize',dv>0?'de plus que le mois dernier':'de moins que le mois dernier')}</div>`:''}</div>
<div class="sec" style="padding-top:26px"><div class="sech">${t3('Payments','Ibyishyuwe','Paiements')}</div>${d[1].map(([n,a,dt])=>R(esc48(n),dt,a)).join('')}${rest>0?R(t3('Smaller payments','Ibyishyuwe bito','Petits paiements'),'',rest,1):''}</div>
<div class="pad fine" style="padding-top:12px;padding-bottom:28px">${t('y_sd')}</div>`};
}
/* v296: Spending. Before: two tabs and a list of five bars; nothing to tap; the screen shared the state key S.sp with Split expenses, so opening Spending after Split could break it. Now: this/last month, total with the change in RWF and %, one stacked bar of all categories, spend per day and biggest category, the monthly budget (or a link to set one), and each category with its change vs last month that opens to show its biggest payments. Own state (S.spm). English, French and Kinyarwanda; fr/rw new copy needs native review. Sample data. */
/* v297 Points */
{const t3=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e,MIN=1000;
const fm=n=>fmt(Math.round(n)),esc48=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])),hd=t=>`<div class="mh" style="padding-bottom:0"><button class="ib" aria-label="Back" onclick="back()">${ic('back',24)}</button><b style="flex:1;font-size:19px;margin-left:6px">${esc48(t)}</b></div>`,addPh=(e,t,x)=>{S.ph=S.ph||[];S.ph.unshift([e,t,x,'Just now'])};
const lay2=h=>{$('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet">'+h+'</div>'};
const dg=v=>String(v||'').replace(/\D/g,'').slice(0,9);
const st=()=>{if(S.rd3==null)S.rd3=Math.min(MIN,S.pts)>=MIN?MIN:0;return S.rd3};
const chk=()=>{const a=st();let err='';if(S.pts<MIN)err=t3('You need at least 1,000 points to redeem.','Ukeneye nibura amanota 1,000 kugira ngo uyahindure.','Il faut au moins 1 000 points pour échanger.');else if(!a)err='';else if(a<MIN)err=t3('Minimum is 1,000 points','Nibura ni amanota 1,000','Minimum : 1 000 points');else if(a>S.pts)err=t3('You have '+fm(S.pts)+' points','Ufite amanota '+fm(S.pts),'Vous avez '+fm(S.pts)+' points');return {a,err,ok:a>=MIN&&a<=S.pts}};
const lbl=k=>k.ok?t3('Redeem '+fm(k.a)+' points','Hindura amanota '+fm(k.a),'Échanger '+fm(k.a)+' points'):t3('Redeem to Pay money','Hindura mu Pay money','Échanger vers Pay money');
window.ptsUpd=()=>{const k=chk(),e=$('#ptE'),g=$('#ptG'),b=$('#ptB'),i=$('#ptI');if(!e)return;e.textContent=k.err;g.textContent=k.ok?t3('You get '+fm(k.a)+' RWF in Pay money','Wakira RWF '+fm(k.a)+' muri Pay money','Vous recevez '+fm(k.a)+' RWF dans Pay money'):'';b.textContent=lbl(k);b.disabled=!k.ok;if(i)i.setAttribute('aria-invalid',k.err?'true':'false')};
window.ptsType=el=>{const v=dg(el.value);S.rd3=v?Number(v):0;el.value=v?fmt(v):'';ptsUpd();document.querySelectorAll('#ptQ button').forEach(b=>b.classList.toggle('on',Number(b.dataset.v)===S.rd3))};
window.ptsQ=n=>{S.rd3=Math.min(n,S.pts);const i=$('#ptI');if(i)i.value=fmt(S.rd3);ptsUpd();document.querySelectorAll('#ptQ button').forEach(b=>b.classList.toggle('on',Number(b.dataset.v)===S.rd3))};
window.ptsMore=()=>{S.pta=!S.pta;render('fade-none')};
window.ptsGo=k=>{S.stack.push(k);render('push')};
window.ptsReview=()=>{const k=chk();if(!k.ok)return;const R=(a,b)=>`<div style="display:flex;justify-content:space-between;gap:12px;min-height:40px;align-items:center;font-size:15px"><span class="mu">${a}</span><b style="text-align:right">${b}</b></div>`;
lay2(`<div class="h1" style="font-size:22px;line-height:30px">${t3('Redeem '+fm(k.a)+' points?','Guhindura amanota '+fm(k.a)+'?','Échanger '+fm(k.a)+' points ?')}</div><div style="margin:14px 0 18px">${R(t3('You redeem','Uhindura','Vous échangez'),fm(k.a)+' '+t3('points','amanota','points'))}${R(t3('You get','Wakira','Vous recevez'),fm(k.a)+' RWF')}${R(t3('Points after','Amanota asigaye','Points restants'),fm(S.pts-k.a))}${R(t3('Pay money after','Pay money nyuma','Pay money après'),fm(S.pay+k.a)+' RWF')}</div><button class="btn" onclick="ptsRedeem()">${t3('Redeem','Hindura','Échanger')}</button><button class="btn sec2" style="margin-top:10px" onclick="closeSheet()">${t3('Cancel','Hagarika','Annuler')}</button>`)};
window.ptsRedeem=()=>{const k=chk();if(!k.ok){closeSheet();return}const a=k.a;S.pts-=a;S.pay+=a;addPh('💸',t3('Redeemed to Pay money','Byahinduwe mu Pay money','Échangé vers Pay money'),'-'+fm(a));S.rd3=S.pts>=MIN?MIN:0;
lay2(`<div class="g3" style="font-size:56px;line-height:1;margin-bottom:10px">✅</div><div class="h1" style="font-size:22px;line-height:30px">${t3('Redeemed','Byahinduwe','Échangé')}</div><div class="mu" style="font-size:15px;margin:8px 0 24px;line-height:22px">${t3(fm(a)+' points added to your Pay money. New balance '+fm(S.pay)+' RWF.','Amanota '+fm(a)+' yongewe muri Pay money. Asigaye ni RWF '+fm(S.pay)+'.',fm(a)+' points ajoutés à votre Pay money. Nouveau solde : '+fm(S.pay)+' RWF.')}</div><button class="btn" onclick="closeSheet()">OK</button>`);render('fade-none')};
const row=(e,t,s,r,on)=>`<button class="row tap" onclick="${on}" style="width:100%;border:0;background:none;font:inherit;color:inherit;text-align:left;padding:12px 24px;min-height:60px"><div class="ico" style="font-size:20px">${e}</div><div style="flex:1;min-width:0"><div class="t">${t}</div><div class="s">${s}</div></div>${r?`<span class="sm" style="font-weight:700;color:var(--ok);white-space:nowrap">${r}</span>`:''}${ic('chev',16,'var(--tt)')}</button>`;
screens.pts=()=>{const k=chk(),a=st(),dc=S.dc||{claimed:{}},left=[0,1,2].filter(i=>!dc.claimed[i]).length,nc=S.cp.filter(c=>!c[5]).length,of=S.of||{},qs=[1000,2000,5000].filter(n=>n<S.pts),all=S.pts>=MIN?S.pts:0;
const ph=S.ph||[],shown=S.pta?ph:ph.slice(0,4);
return `${hd(t3('Points','Amanota','Points'))}<div style="padding:22px 24px 0"><div class="sm mu">${t3('Your points','Amanota yawe','Vos points')}</div><div class="big">${fm(S.pts)}</div><div class="mu" style="font-size:14px;margin-top:4px">${t3('Worth '+fm(S.pts)+' RWF · 1 point = 1 RWF in Pay money','Afite agaciro ka RWF '+fm(S.pts)+' · ukwezi 1 = RWF 1 muri Pay money','Vaut '+fm(S.pts)+' RWF · 1 point = 1 RWF dans Pay money')}</div></div>
<div style="margin:22px 24px 0;padding:16px;border-radius:20px;background:var(--chip)"><label for="ptI" class="sm mu">${t3('Points to redeem','Amanota yo guhindura','Points à échanger')}</label><input id="ptI" inputmode="numeric" autocomplete="off" value="${a?fmt(a):''}" placeholder="0" oninput="ptsType(this)" ${S.pts<MIN?'disabled':''} style="display:block;width:100%;box-sizing:border-box;margin-top:6px;border:0;border-bottom:2px solid var(--ln);background:none;color:var(--tx);font:inherit;font-size:26px;font-weight:800;padding:6px 0;outline:0;border-radius:0"><div id="ptE" class="sm" role="alert" style="min-height:20px;margin-top:6px;color:var(--er);font-weight:700">${k.err}</div><div id="ptG" class="sm" style="min-height:20px;font-weight:700">${k.ok?t3('You get '+fm(k.a)+' RWF in Pay money','Wakira RWF '+fm(k.a)+' muri Pay money','Vous recevez '+fm(k.a)+' RWF dans Pay money'):''}</div>${S.pts>=MIN?`<div id="ptQ" class="req" style="margin-top:10px;flex-wrap:wrap">${qs.map(n=>`<button data-v="${n}" class="${a===n?'on':''}" onclick="ptsQ(${n})">${fmt(n)}</button>`).join('')}<button data-v="${all}" class="${a===all?'on':''}" onclick="ptsQ(${all})">${t3('All','Byose','Tout')}</button></div>`:''}</div>
<div class="agt">${t3('Ways to earn','Uko wabona amanota','Gagner des points')}</div>
${row('🔥',t3('Daily challenge','Ikibazo cya buri munsi','Défi du jour'),left?t3(left+' of 3 tasks left · +100 bonus',left+' kuri 3 isigaye · +100',left+' tâches sur 3 restantes · +100 bonus'):t3('Done for today','Byarangiye uyu munsi','Terminé pour aujourd’hui'),'',"ptsGo('challenge')")}
${row('🥐','Kigali Bakery',t3('5% back when you pay with QR','5% asubizwa wishyuye na QR','5 % remboursés en payant par QR'),of.bakery?t3('On','Birakora','Activé'):'',"ofOpen('bakery')")}
${row('🚌',t3('Kigali bus fares','Amatike ya bisi ya Kigali','Trajets de bus Kigali'),t3('1 point per 100 RWF of fare','Ukwezi 1 kuri RWF 100','1 point par 100 RWF de trajet'),of.bus?t3('On','Birakora','Activé'):'',"ofOpen('bus')")}
${row('💳',t3('Card cashback','Cashback y’ikarita','Cashback carte'),t3('1% back on every card purchase','1% kuri buri kugura n’ikarita','1 % de cashback sur chaque achat'),'',"ptsGo('cashback')")}
${row('🎟️',t3('Your coupons','Kuponi zawe','Vos coupons'),nc?t3(nc+' ready to use',nc+' ziteguye',nc+' prêt'+(nc>1?'s':'')+' à utiliser'):t3('None right now','Nta kuponi ubu','Aucun pour l’instant'),'',"ptsGo('coupons')")}
<div class="agt">${t3('Recent activity','Ibyakozwe vuba','Activité récente')}</div>${shown.length?shown.map(x=>`<div class="row" style="padding:11px 24px;min-height:56px"><div class="ico" style="font-size:20px">${x[0]}</div><div style="flex:1;min-width:0"><div class="t" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${esc48(x[1])}</div><div class="s">${esc48(x[3])}</div></div><b style="white-space:nowrap;color:${String(x[2]).startsWith('-')?'inherit':'var(--ok)'}">${esc48(String(x[2]).replace('-','−'))}</b></div>`).join(''):`<div class="pad mu" style="padding-top:8px;font-size:15px">${t3('No points activity yet.','Nta bikorwa by’amanota.','Pas encore d’activité.')}</div>`}${ph.length>4?`<div class="pad" style="padding-top:6px"><button class="chip" onclick="ptsMore()" aria-expanded="${!!S.pta}">${S.pta?t3('Show less','Erekana bike','Voir moins'):t3('See all ('+ph.length+')','Reba byose ('+ph.length+')','Tout voir ('+ph.length+')')}</button></div>`:''}
<div style="height:100px"></div><div class="cta"><button id="ptB" class="btn" ${k.ok?'':'disabled'} onclick="ptsReview()">${lbl(k)}</button></div>`};
}
/* v297: Points. Before: the amount could only move in 1,000 steps with − and +, redeeming happened at once with no review, nothing said what you would get, the only other things on the page were three lines of history, and it was English only. Now: your points with what they are worth; a field where you type any amount (1,000 minimum) with shortcuts 1,000 / 2,000 / 5,000 / All, errors in red under it and a line saying what you get; a button that names the amount, a review sheet (points after, Pay money after) and a result; "Ways to earn" linking to Daily challenge (tasks left), the two offers (on/off), Card cashback and Coupons; recent activity with + in green, first four with See all. Own state (S.rd3). English, French and Kinyarwanda; fr/rw new copy needs native review. */
/* v343: Auto top-up, calmer. Before: a balance bar card, a tinted status card, a text field with chips under each amount, radio buttons with a tinted card on the chosen account, and a summary card at the bottom. Now: the sentence at the top says what will happen; Refill when below / Add this much / Monthly limit are plain rows with the value on the right, and tapping one opens a check list (Other amount lets you type); Take it from is a check list with a plain check on the right of the chosen account, no radio and no card; the SMS switch, recent refills and the review sheet are unchanged. */
/* v298 Auto top-up */
{const t3=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e;
const fm=n=>fmt(Math.round(n)),esc48=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const TH=[5000,10000,20000,50000],AM=[10000,20000,50000],CAPS=[100000,300000,500000,0],LO=1000,HI=200000,AMIN=5000;
const SRCN=['MTN MoMo ••0788','Airtel Money ••0732','itunda Bank'];
S.atuSB=S.atuSB||[85000,40000];S.atuH=S.atuH||[];
const base=o=>Object.assign({on:false,th:10000,amt:20000,o:0,cap:300000,sms:true,used:0},o||{});
S.atu=base(S.atu);
const D=()=>S.atuD=S.atuD?base(S.atuD):base(S.atu);
const SB=()=>[S.atuSB[0],S.atuSB[1],S.bank||0];
const sent=d=>t3('When your itunda Pay balance drops below '+fm(d.th)+' RWF, we add '+fm(d.amt)+' RWF from '+SRCN[d.o]+'.'+(d.cap?' Up to '+fm(d.cap)+' RWF a month.':''),'Iyo itunda Pay iri munsi ya RWF '+fm(d.th)+', twongeraho RWF '+fm(d.amt)+' dukuye kuri '+SRCN[d.o]+'.'+(d.cap?' Kugeza kuri RWF '+fm(d.cap)+' ku kwezi.':''),'Quand votre solde itunda Pay passe sous '+fm(d.th)+' RWF, nous ajoutons '+fm(d.amt)+' RWF depuis '+SRCN[d.o]+'.'+(d.cap?' Jusqu’à '+fm(d.cap)+' RWF par mois.':''));
const chk=d=>{const e={};
if(!d.th)e.th='';else if(d.th<LO)e.th=t3('Minimum is '+fm(LO)+' RWF','Nibura ni RWF '+fm(LO),'Minimum : '+fm(LO)+' RWF');else if(d.th>HI)e.th=t3('Maximum is '+fm(HI)+' RWF','Ntarenza RWF '+fm(HI),'Maximum : '+fm(HI)+' RWF');
if(!d.amt)e.amt='';else if(d.amt<AMIN)e.amt=t3('Minimum is '+fm(AMIN)+' RWF','Nibura ni RWF '+fm(AMIN),'Minimum : '+fm(AMIN)+' RWF');else if(d.amt>HI)e.amt=t3('Maximum is '+fm(HI)+' RWF','Ntarenza RWF '+fm(HI),'Maximum : '+fm(HI)+' RWF');
if(d.cap&&d.amt&&d.cap<d.amt)e.cap=t3('The monthly limit must cover at least one refill ('+fm(d.amt)+' RWF)','Imbibi y’ukwezi igomba kwishyura nibura rimwe (RWF '+fm(d.amt)+')','Le plafond mensuel doit couvrir au moins une recharge ('+fm(d.amt)+' RWF)');
e.ok=d.th>=LO&&d.th<=HI&&d.amt>=AMIN&&d.amt<=HI&&!e.cap;
e.warn=e.ok&&SB()[d.o]<d.amt?t3(SRCN[d.o]+' has '+fm(SB()[d.o])+' RWF, less than one refill. We would skip it until it has enough.',SRCN[d.o]+' ifite RWF '+fm(SB()[d.o])+', munsi y’iyo twongeraho. Ntitwakongera kugeza ibonye ihagije.',SRCN[d.o]+' contient '+fm(SB()[d.o])+' RWF, moins qu’une recharge. Elle serait ignorée tant que le solde est insuffisant.'):'';
return e};
const CKS='<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>',CHV='<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--tt)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>';
const PRE={th:TH,amt:AM,cap:CAPS},g48=id=>document.getElementById(id);
const lbl=(f,v)=>f==='cap'&&!v?t3('No limit','Nta mbibi','Sans plafond'):fm(v)+' RWF';
const TT=f=>f==='th'?t3('Refill when below','Uzuza iri munsi ya','Recharger sous'):f==='amt'?t3('Add this much','Ongeraho aya mafaranga','Montant ajouté'):t3('Monthly limit','Imbibi y’ukwezi','Plafond mensuel');
/* a check-list row: label on the left, a plain check on the right when chosen. No radio, no card, no tint. */
const ckRow=(sel,fn,t,s,role)=>`<div class="row tap" role="${role||'checkbox'}" aria-checked="${sel}" tabindex="0" onclick="${fn}" style="padding:14px 24px"><div style="flex:1;min-width:0"><div class="t" style="font-weight:${sel?800:600}">${t}</div>${s?`<div class="s">${s}</div>`:''}</div><span style="color:var(--lk);width:24px;height:24px;display:flex;flex:none">${sel?CKS:''}</span></div>`;
const valRow=(f,v)=>`<div class="row tap" role="button" tabindex="0" onclick="atuOpen('${f}')" style="padding:14px 24px"><div class="t" style="flex:1">${TT(f)}</div><b style="color:var(--lk);font-size:16px">${lbl(f,v)}</b>${CHV}</div>`;
const R=(a,v)=>`<div style="display:flex;justify-content:space-between;gap:12px;min-height:40px;align-items:center;font-size:15px"><span class="mu">${a}</span><b style="text-align:right">${v}</b></div>`;
const lay2=h=>{$('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet">'+h+'</div>';if(typeof focusSheet==='function')focusSheet()};
const cta=(d,k)=>{const a=S.atu,dirty=d.th!==a.th||d.amt!==a.amt||d.o!==a.o||d.cap!==a.cap||d.sms!==a.sms;return a.on?`<div class="cta"><div style="display:grid;grid-template-columns:1fr 1.6fr;gap:12px"><button class="btn sec2" onclick="atuOff()">${t3('Turn off','Zimya','Désactiver')}</button><button id="atuB" class="btn" ${dirty&&k.ok?'':'disabled'} onclick="atuReview()">${t3('Save changes','Bika impinduka','Enregistrer')}</button></div></div>`:`<div class="cta"><button id="atuB" class="btn" ${k.ok?'':'disabled'} onclick="atuReview()">${t3('Turn on auto top-up','Tangiza kuzuza byikora','Activer la recharge automatique')}</button></div>`};
window.atuOpen=f=>{const d=D(),cu=f!=='cap'&&!PRE[f].includes(d[f]);
lay2(`<div class="h1" style="font-size:22px;line-height:30px;margin:4px 0 8px">${TT(f)}</div><div style="margin:0 -24px">${PRE[f].map(v=>ckRow(d[f]===v,`atuPick('${f}',${v})`,lbl(f,v))).join('')}${f==='cap'?'':ckRow(cu,`atuOther('${f}')`,t3('Other amount','Andi mafaranga','Autre montant'),cu?fm(d[f])+' RWF':'')}</div>`)};
window.atuPick=(f,v)=>{D()[f]=v;closeSheet();render('fade-none')};
window.atuOther=f=>{const d=D(),v=PRE[f].includes(d[f])?0:d[f];
lay2(`<div class="h1" style="font-size:22px;line-height:30px;margin:4px 0 8px">${TT(f)}</div><div style="display:flex;align-items:baseline;gap:8px;border-bottom:2px solid var(--ln);margin-top:12px"><input id="atuOI" inputmode="numeric" autocomplete="off" placeholder="0" value="${v?fmt(v):''}" oninput="atuOT('${f}',this)" style="flex:1;min-width:0;border:0;background:none;color:var(--tx);font:inherit;font-size:24px;font-weight:800;padding:6px 0;outline:0;border-radius:0"><span class="mu" style="font-weight:700">RWF</span></div><div id="atuOE" role="alert" class="sm" style="min-height:20px;margin:6px 0 16px;color:var(--er);font-weight:700"></div><button id="atuOB" class="btn" ${v?'':'disabled'} onclick="atuOD('${f}')">${t3('Done','Byarangiye','Terminé')}</button>`);
setTimeout(()=>{const i=g48('atuOI');if(i)i.focus()},60)};
window.atuOT=(f,el)=>{const v=el.value.replace(/\D/g,'').slice(0,7),n=v?Number(v):0,mn=f==='th'?LO:AMIN;el.value=v?fmt(v):'';
const e=!n?'':n<mn?t3('Minimum is '+fm(mn)+' RWF','Nibura ni RWF '+fm(mn),'Minimum : '+fm(mn)+' RWF'):n>HI?t3('Maximum is '+fm(HI)+' RWF','Ntarenza RWF '+fm(HI),'Maximum : '+fm(HI)+' RWF'):'';
g48('atuOE').textContent=e;g48('atuOB').disabled=!n||!!e};
window.atuOD=f=>{const n=Number(g48('atuOI').value.replace(/\D/g,''));D()[f]=n;closeSheet();render('fade-none')};
window.atuSrc=i=>{D().o=i;render('fade-none')};
window.atuSms=()=>{const d=D();d.sms=!d.sms;render('fade-none')};
const screenAtu=()=>{const d=D(),a=S.atu,k=chk(d);
const src=SRCN.map((n,i)=>ckRow(d.o===i,`atuSrc(${i})`,n,t3('Balance ','Asigaye ','Solde ')+fm(SB()[i])+' RWF','radio')).join('');
const hist=a.on?`<div class="agt">${t3('Recent refills','Ibyuzuzwa vuba','Recharges récentes')}</div>${S.atuH.length?S.atuH.slice(0,4).map(x=>`<div class="row" style="padding:11px 24px;min-height:56px"><div style="flex:1;min-width:0"><div class="t">${esc48(x[0])}</div><div class="s">${esc48(x[2])}</div></div><b style="color:var(--ok);white-space:nowrap">+${fm(x[1])} RWF</b></div>`).join(''):`<div class="pad mu" style="padding-top:6px;font-size:15px">${t3('No refills yet.','Nta cyuzuzwa.','Aucune recharge pour l’instant.')}</div>`}<div class="pad" style="padding-top:8px"><button onclick="atuTry()" style="border:0;background:none;padding:8px 0;color:var(--lk);font-weight:800;font-size:15px">${t3('Try a refill (sample)','Gerageza kuzuza (icyitegererezo)','Essayer une recharge (exemple)')}</button></div>`:'';
const sub=k.ok?sent(d):t3('Choose how much and when.','Hitamo angahe n’igihe.','Choisissez le montant et le moment.');
const use=a.on&&a.cap?`<div class="sm mu" style="padding:6px 24px 0">${t3('Used this month: ','Byakoreshejwe uku kwezi: ','Utilisé ce mois-ci : ')}${fm(a.used)} / ${fm(a.cap)} RWF</div>`:'';
return bar(t3('Auto top-up','Kuzuza byikora','Recharge automatique'))+`<div style="padding:22px 24px 0">${a.on?`<div class="sm" style="color:var(--ok);font-weight:800;margin-bottom:6px">${t3('On','Birakora','Activée')}</div>`:''}<div class="h1">${t3('Auto top-up','Kuzuza byikora','Recharge automatique')}</div><div class="mu" style="font-size:15px;line-height:22px;margin-top:8px">${sub}</div></div>
<div style="padding-top:18px">${valRow('th',d.th)}${valRow('amt',d.amt)}${valRow('cap',d.cap)}</div>${k.cap?`<div class="sm" role="alert" style="padding:2px 24px 0;color:var(--er);font-weight:700;line-height:19px">${k.cap}</div>`:''}${use}
<div class="agt">${t3('Take it from','Yakurwe kuri','Prélever depuis')}</div><div role="radiogroup">${src}</div>${k.warn?`<div class="sm mu" role="status" style="padding:4px 24px 0;line-height:19px">${k.warn}</div>`:''}
<div class="row" style="padding:14px 24px;margin-top:8px"><div style="flex:1"><div class="t">${t3('Text me after each refill','Mbwira kuri SMS nyuma ya buri nzuza','M’envoyer un SMS après chaque recharge')}</div></div><div class="sw ${d.sms?'on':''}" role="switch" aria-checked="${!!d.sms}" aria-label="SMS" tabindex="0" onclick="atuSms()"><i></i></div></div>${hist}
<div class="pad fine" style="padding-top:14px">${t3('Free. Sample terms for this prototype.','Ubuntu. Amabwiriza y’icyitegererezo.','Gratuit. Conditions d’exemple pour ce prototype.')}</div><div style="height:100px"></div>${cta(d,k)}`};
window.atuTry=()=>{const a=S.atu;if(!a.on)return;
if(SB()[a.o]<a.amt){toast(t3('Skipped: '+SRCN[a.o]+' has too little','Byasimbutse: '+SRCN[a.o]+' ifite make','Ignoré : '+SRCN[a.o]+' a trop peu'));return}
if(a.cap&&a.used+a.amt>a.cap){toast(t3('Monthly limit reached','Imbibi y’ukwezi yagezweho','Plafond mensuel atteint'));return}
if(a.o===2)S.bank-=a.amt;else S.atuSB[a.o]-=a.amt;S.pay+=a.amt;a.used+=a.amt;S.atuH.unshift([t3('From ','Biturutse kuri ','Depuis ')+SRCN[a.o],a.amt,t3('Just now','Ubu nyine','À l’instant')]);
if(Array.isArray(S.act))S.act.unshift(['wallet','Auto top-up · '+SRCN[a.o],'Received · Just now',a.amt,'Received']);
toast('+'+fm(a.amt)+' RWF '+t3('added to itunda Pay','yongewe muri itunda Pay','ajoutés à itunda Pay')+(a.sms?t3(' · SMS sent',' · SMS yoherejwe',' · SMS envoyé'):''));render('fade-none')};
window.atuReview=()=>{const d=D(),k=chk(d),on=S.atu.on;if(!k.ok)return;
lay2(`<div class="h1" style="font-size:22px;line-height:30px;margin-top:4px">${on?t3('Save changes?','Kubika impinduka?','Enregistrer les modifications ?'):t3('Turn on auto top-up?','Gutangiza kuzuza byikora?','Activer la recharge automatique ?')}</div><div style="margin:12px 0 20px">${R(t3('Refill when below','Uzuza iri munsi ya','Recharger sous'),fm(d.th)+' RWF')}${R(t3('Add','Ongeraho','Ajouter'),fm(d.amt)+' RWF')}${R(t3('Take it from','Yakurwe kuri','Prélever depuis'),SRCN[d.o])}${R(t3('Monthly limit','Imbibi y’ukwezi','Plafond mensuel'),d.cap?fm(d.cap)+' RWF':t3('No limit','Nta mbibi','Sans plafond'))}${R('SMS',d.sms?t3('Yes','Yego','Oui'):t3('No','Oya','Non'))}${R(t3('Fee','Ikiguzi','Frais'),t3('Free','Ubuntu','Gratuit'))}</div>${k.warn?`<div class="sm mu" style="margin:-8px 0 16px;line-height:19px">${k.warn}</div>`:''}<div style="display:grid;grid-template-columns:1fr 1.8fr;gap:12px"><button class="btn sec2" onclick="closeSheet()">${t3('Cancel','Hagarika','Annuler')}</button><button class="btn" style="white-space:nowrap" onclick="atuSave()">${on?t3('Save changes','Bika impinduka','Enregistrer'):t3('Turn on','Tangiza','Activer')}</button></div>`)};
window.atuSave=()=>{const was=S.atu.on,u=S.atu.used||0;S.atu=Object.assign({},D(),{on:true,used:u});S.atuD=Object.assign({},S.atu);closeSheet();render('fade-none');toast(was?t3('Changes saved','Impinduka zabitswe','Modifications enregistrées'):t3('Auto top-up is on','Kuzuza byikora birakora','Recharge automatique activée'))};
window.atuOff=()=>lay2(`<div class="h1" style="font-size:22px;line-height:30px;margin-top:4px">${t3('Turn off auto top-up?','Kuzimya kuzuza byikora?','Désactiver la recharge automatique ?')}</div><div class="mu" style="font-size:15px;margin:8px 0 24px;line-height:22px">${t3('We will stop adding money when your itunda Pay balance is low. Your saved choices are kept for next time.','Tuzahagarika kongeraho amafaranga itunda Pay ibaye nke. Amahitamo yawe azabikwa.','Nous cesserons d’ajouter de l’argent quand votre solde itunda Pay est bas. Vos choix sont conservés.')}</div><div style="display:grid;grid-template-columns:1fr 1.8fr;gap:12px"><button class="btn sec2" onclick="closeSheet()">${t3('Keep it on','Reka bikore','Garder activée')}</button><button class="btn" style="white-space:nowrap" onclick="atuOffGo()">${t3('Turn off','Zimya','Désactiver')}</button></div>`);
window.atuOffGo=()=>{S.atu.on=false;S.atuD=Object.assign({},S.atu);closeSheet();render('fade-none');toast(t3('Auto top-up is off','Kuzuza byikora byazimye','Recharge automatique désactivée'))};
const _p=screens.svc;screens.svc=()=>S.svk==='atu'?screenAtu():_p();
}
/* v298: Auto top-up. Before: English only; refill level and amount were four fixed chips; two sources; no limit, no way to see how a refill would work, and no record of refills. Now: English, French and Kinyarwanda (fr/rw new copy needs native review); a balance bar with your refill level marked on it; you type the refill level and the amount (shortcuts stay), with errors under each field; a third source, itunda Bank, and the balance of each source (a note if one is too low for a refill); a monthly limit (100,000 / 300,000 / 500,000 / none) with how much is used; a switch for an SMS after each refill; a live sentence; a review that lists all of it; when on, Recent refills and "Try a refill (sample)", which adds money to itunda Pay and Activity. */
/* v299 Moto-Taxi ownership */
{const t3=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e;
const fm=n=>fmt(Math.round(n)),esc48=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const SC=[1500000,2000000,2500000,3000000],DP=[30,40,50],MS=[6,12,18],TM=[24,36,48],INC=[5000,8000,12000,15000],RATE=14,PMIN=1000000,PMAX=5000000,DAYS=26;
const short=v=>v>=1e6?(v/1e6)+'M':(v/1e3)+'K';
const old=S.sv2&&S.sv2.moto?S.sv2.moto:null;
S.mo=S.mo||{a:old&&old.a?old.a:2000000,dp:30,ms:S.moMs||12,n:24,inc:8000};
const M=()=>S.mo;
const mine=()=>S.goal&&S.goal.moto,other=()=>S.goal&&!S.goal.moto;
const calc=p=>{const dn=Math.round(p.a*p.dp/100),loan=p.a-dn,i=RATE/1200,mo=Math.round(loan*i/(1-Math.pow(1+i,-p.n))),sv=Math.round(dn/p.ms/1000)*1000||Math.round(dn/p.ms);return{dn,loan,mo,tot:mo*p.n,int:mo*p.n-loan,sv}};
const planOf=()=>{const g=S.goal;if(g&&g.plan)return g.plan;return{a:Math.round(g.t/.3),dp:30,ms:g.m||12,n:24,inc:M().inc}};
const okP=()=>M().a>=PMIN&&M().a<=PMAX;
const perr=()=>{const a=M().a;return !a?'':a<PMIN?t3('Minimum is '+fm(PMIN)+' RWF','Nibura ni RWF '+fm(PMIN),'Minimum : '+fm(PMIN)+' RWF'):a>PMAX?t3('Maximum is '+fm(PMAX)+' RWF','Ntarenza RWF '+fm(PMAX),'Maximum : '+fm(PMAX)+' RWF'):''};
const chip=(on,fn,l,al)=>`<button class="chip" aria-pressed="${on}" ${al?`aria-label="${al}" `:''}onclick="${fn}" style="min-width:64px;height:44px;border-radius:22px;border:0;padding:0 16px;font-size:15px;font-weight:800;background:${on?'var(--tx)':'var(--chip)'};color:${on?'var(--bg)':'var(--tx)'}">${l}</button>`;
const grp=(h,l)=>`<div style="display:flex;gap:10px;flex-wrap:wrap;padding:10px 24px 0" role="group" ${l?`aria-label="${l}"`:''}>${h}</div>`;
const lab=(t,s)=>`<div style="padding:24px 24px 0"><div style="font-size:16px;font-weight:800">${t}</div>${s?`<div class="sm mu" style="margin-top:4px;line-height:19px">${s}</div>`:''}</div>`;
const rw=(a,v,b)=>`<div style="margin:8px 24px 0;display:flex;justify-content:space-between;gap:12px;font-size:15px"><span class="mu">${a}</span><b style="text-align:right;${b?'color:var(--tintfg)':''}">${v}</b></div>`;
const R=(a,v)=>`<div style="display:flex;justify-content:space-between;gap:12px;min-height:40px;align-items:center;font-size:15px"><span class="mu">${a}</span><b style="text-align:right">${v}</b></div>`;
const lay2=h=>{$('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet">'+h+'</div>';if(typeof focusSheet==='function')focusSheet()};
const mon=(a,b,c)=>t3(a,b,c);
const dyn=()=>{const p=M(),q=calc(p),ok=okP(),mi=p.inc*DAYS,s1=mi?Math.round(q.sv*100/mi):0,s2=mi?Math.round(q.mo*100/mi):0;
const tag=s=>s<=30?[t3('Comfortable','Birashoboka','Confortable'),'var(--ok)']:s<=45?[t3('Tight','Biragoye','Serré'),'var(--mu)']:[t3('High','Biri hejuru','Élevé'),'var(--er)'];
const t1=tag(s1),t2=tag(s2);
return `${grp(SC.map(v=>chip(p.a===v,`moSet('a',${v})`,short(v),fm(v)+' RWF')).join(''),t3('Price shortcuts','Ibiciro byihuse','Raccourcis de prix'))}
${lab(t3('First: save your down payment','Banza: bika amafaranga y’ibanze','D’abord : épargnez l’apport'))}
<div style="padding:12px 24px 0"><div class="sm mu" style="margin-bottom:8px">${t3('Down payment','Amafaranga y’ibanze','Apport')}</div><div style="display:flex;gap:10px;flex-wrap:wrap" role="group">${DP.map(v=>chip(p.dp===v,`moSet('dp',${v})`,v+'%')).join('')}</div></div>
<div style="padding:14px 24px 0"><div class="sm mu" style="margin-bottom:8px">${t3('Save it in','Uyabike mu','Épargner en')}</div><div style="display:flex;gap:10px;flex-wrap:wrap" role="group">${MS.map(v=>chip(p.ms===v,`moSet('ms',${v})`,v+' '+t3('months','mezi','mois'))).join('')}</div></div>
${ok?rw(t3('Down payment to save','Ayo ukwiye kubika','Apport à épargner'),fm(q.dn)+' RWF',1)+rw(t3('About each month','Nka buri kwezi','Environ par mois'),fm(q.sv)+' RWF'):''}
${lab(t3('Then: repay the loan over','Hanyuma: ishyura inguzanyo mu','Ensuite : remboursez le prêt sur'))}
${grp(TM.map(v=>chip(p.n===v,`moSet('n',${v})`,v+' '+t3('months','mezi','mois'))).join(''))}
${ok?rw(t3('Loan amount','Inguzanyo','Montant du prêt'),fm(q.loan)+' RWF ('+(100-p.dp)+'%)')+rw(t3('Monthly loan payment','Ishyura buri kwezi','Mensualité du prêt'),fm(q.mo)+' RWF',1)+rw(t3('Interest in total','Inyungu yose','Intérêts au total'),fm(q.int)+' RWF')+rw(t3('Total to repay','Ugomba kwishyura yose','Total à rembourser'),fm(q.tot)+' RWF')+rw(t3('Rate','Inyungu','Taux'),RATE+t3('% a year','% ku mwaka',' % par an'))+`<div class="pad sm mu" style="padding-top:8px;line-height:20px">${t3('The loan opens when your down payment is saved.','Inguzanyo ifungurwa umaze kubika amafaranga y’ibanze.','Le prêt s’ouvre quand votre apport est épargné.')}</div>`:''}
${ok?`${lab(t3('Can you afford it?','Birashoboka?','Est-ce abordable ?'),t3('Tap what you expect to earn each day. This is your own estimate, not a promise.','Kanda ibyo utekereza kwinjiza buri munsi. Ni uko ubitekereza, ntibivuze ko bizaba.','Touchez ce que vous comptez gagner par jour. C’est votre estimation, pas une promesse.'))}
${grp(INC.map(v=>chip(p.inc===v,`moSet('inc',${v})`,fm(v))).join(''),t3('Daily earnings','Ibyo winjiza ku munsi','Gains par jour'))}
<div style="margin:14px 24px 0;padding:14px 16px;border-radius:16px;background:var(--chip);font-size:15px;line-height:22px" aria-live="polite"><div style="display:flex;justify-content:space-between;gap:12px"><span>${t3('Saving ','Kubika ','Épargne ')}${fm(q.sv)} RWF</span><b style="color:${t1[1]}">${s1}% · ${t1[0]}</b></div><div style="display:flex;justify-content:space-between;gap:12px;margin-top:4px"><span>${t3('Loan payment ','Kwishyura ','Mensualité ')}${fm(q.mo)} RWF</span><b style="color:${t2[1]}">${s2}% · ${t2[0]}</b></div><div class="sm mu" style="margin-top:8px">${t3('Share of about '+fm(mi)+' RWF a month ('+DAYS+' working days).','Ku nsimbi nka '+fm(mi)+' ku kwezi (iminsi '+DAYS+' y’akazi).','Part d’environ '+fm(mi)+' RWF par mois ('+DAYS+' jours de travail).')}</div></div>`:''}`};
window.moUpd=()=>{const d=document.getElementById('moD'),e=document.getElementById('moPE'),b=document.getElementById('moB');if(!d)return;d.innerHTML=dyn();e.textContent=perr();document.getElementById('moP').setAttribute('aria-invalid',perr()?'true':'false');if(b){b.disabled=!okP();b.textContent=t3('Start saving '+fm(calc(M()).dn)+' RWF','Tangira kubika RWF '+fm(calc(M()).dn),'Commencer à épargner '+fm(calc(M()).dn)+' RWF')}};
window.moType=el=>{const v=el.value.replace(/\D/g,'').slice(0,8);M().a=v?Number(v):0;el.value=v?fmt(v):'';moUpd()};
window.moSet=(f,v)=>{M()[f]=v;S.moMs=M().ms;if(f==='a'){const i=document.getElementById('moP');if(i)i.value=fmt(v)}moUpd()};
window.moOpenGoal=()=>{S.stack.push('goal');render('push')};
window.moAdd=n=>{const g=S.goal;if(!g||g.s>=g.t)return;const a=Math.min(n,g.t-g.s);if(S.bank<a){toast(t3('Not enough balance. You have '+fm(S.bank)+' RWF.','Nta mafaranga ahagije. Ufite RWF '+fm(S.bank)+'.','Solde insuffisant. Vous avez '+fm(S.bank)+' RWF.'));return}S.bank-=a;g.s+=a;render('fade-none');toast(t3('Saved '+fm(a)+' RWF','Wabitse RWF '+fm(a),fm(a)+' RWF épargnés'));if(g.s>=g.t&&typeof confetti==='function')setTimeout(confetti,200)};
window.moReview=()=>{if(!okP()||S.goal)return;const p=M(),q=calc(p);
lay2(`<div class="h1" style="font-size:22px;line-height:30px;margin-top:4px">${t3('Start saving for a motorbike?','Gutangira kubika moto?','Épargner pour une moto ?')}</div><div style="margin:12px 0 20px">${R(t3('Motorbike price','Igiciro cya moto','Prix de la moto'),fm(p.a)+' RWF')}${R(t3('Down payment ('+p.dp+'%)','Amafaranga y’ibanze ('+p.dp+'%)','Apport ('+p.dp+' %)'),fm(q.dn)+' RWF')}${R(t3('Save it in','Uyabike mu','Épargner en'),p.ms+' '+t3('months','mezi','mois'))}${R(t3('About each month','Nka buri kwezi','Environ par mois'),fm(q.sv)+' RWF')}${R(t3('Then the loan','Hanyuma inguzanyo','Puis le prêt'),fm(q.loan)+' RWF / '+p.n+' '+t3('months','mezi','mois'))}${R(t3('Loan payment','Kwishyura','Mensualité'),fm(q.mo)+' RWF')}${R(t3('Rate','Inyungu','Taux'),RATE+t3('% a year','% ku mwaka',' % par an'))}</div><div class="mu sm" style="margin:-8px 0 16px;line-height:20px">${t3('This creates a savings goal called “Motorbike down payment”. It shows on Home.','Ibi bikora intego yo kubika yitwa “Motorbike down payment”. Igaragara kuri Home.','Cela crée un objectif d’épargne « Motorbike down payment ». Il apparaît sur l’accueil.')}</div><div style="display:grid;grid-template-columns:1fr 1.8fr;gap:12px"><button class="btn sec2" onclick="closeSheet()">${t3('Cancel','Hagarika','Annuler')}</button><button class="btn" style="white-space:nowrap" onclick="moStart()">${t3('Create my goal','Kora intego yanjye','Créer mon objectif')}</button></div>`)};
window.moStart=()=>{if(S.goal||!okP()){closeSheet();return}const p=Object.assign({},M()),q=calc(p);S.goal={n:'Motorbike down payment',t:q.dn,m:p.ms,s:0,moto:true,plan:p};S.moLoan=null;closeSheet();render('fade-none');toast(t3('Savings goal created','Intego yo kubika yashyizweho','Objectif d’épargne créé'))};
window.moApplyReview=()=>{const g=S.goal;if(!g||!g.moto||g.s<g.t||S.moLoan)return;const p=planOf(),q=calc(p);
lay2(`<div class="h1" style="font-size:22px;line-height:30px;margin-top:4px">${t3('Apply for your loan?','Gusaba inguzanyo yawe?','Demander votre prêt ?')}</div><div style="margin:12px 0 20px">${R(t3('Motorbike price','Igiciro cya moto','Prix de la moto'),fm(p.a)+' RWF')}${R(t3('Down payment saved','Ayo wabitse','Apport épargné'),fm(q.dn)+' RWF')}${R(t3('Loan amount','Inguzanyo','Montant du prêt'),fm(q.loan)+' RWF')}${R(t3('Repay over','Kwishyura mu','Remboursement sur'),p.n+' '+t3('months','mezi','mois'))}${R(t3('Monthly payment','Kwishyura buri kwezi','Mensualité'),fm(q.mo)+' RWF')}${R(t3('Rate','Inyungu','Taux'),RATE+t3('% a year','% ku mwaka',' % par an'))}</div><div class="mu sm" style="margin:-8px 0 16px;line-height:20px">${t3('Sample for this prototype. No real loan is made.','Icyitegererezo cy’iyi porogaramu. Nta nguzanyo nyayo itangwa.','Exemple pour ce prototype. Aucun vrai prêt n’est accordé.')}</div><div style="display:grid;grid-template-columns:1fr 1.8fr;gap:12px"><button class="btn sec2" onclick="closeSheet()">${t3('Cancel','Hagarika','Annuler')}</button><button class="btn" style="white-space:nowrap" onclick="moApply()">${t3('Send application','Ohereza ubusabe','Envoyer la demande')}</button></div>`)};
window.moApply=()=>{const p=planOf(),q=calc(p);S.moLoan={loan:q.loan,mo:q.mo,n:p.n};closeSheet();render('fade-none');toast(t3('Application sent (sample)','Ubusabe bwoherejwe (icyitegererezo)','Demande envoyée (exemple)'))};
const screenMoto=()=>{const g=S.goal,isM=mine(),done=isM&&g.s>=g.t,L=S.moLoan,step=!isM?1:L?3:done?2:1;
const steps=[t3('Save','Bika','Épargner'),t3('Apply','Saba','Demander'),t3('Repay','Ishyura','Rembourser')].map((s,i)=>`<div style="flex:1;text-align:center;min-width:0"><div style="width:28px;height:28px;border-radius:14px;margin:0 auto;display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:800;background:${i+1<=step?'var(--lk)':'var(--chip)'};color:${i+1<=step?'#fff':'var(--mu)'}" ${i+1===step?'aria-current="step"':''}>${i+1}</div><div class="sm" style="margin-top:4px;font-weight:${i+1===step?800:500};color:${i+1===step?'var(--tx)':'var(--mu)'}">${s}</div></div>`).join('');
let top='',body='',btn;
if(isM){const p=planOf(),q=calc(p),pc=Math.min(100,Math.round(g.s/g.t*100));
 top=`<div style="margin:18px 24px 0;padding:16px;border-radius:18px;background:var(--tint);color:var(--tintfg)"><div style="font-weight:800">${L?t3('Loan application sent','Ubusabe bw’inguzanyo bwoherejwe','Demande de prêt envoyée'):done?t3('Down payment saved 🎉','Amafaranga y’ibanze yabitswe 🎉','Apport épargné 🎉'):t3('You are saving for a motorbike','Urimo kubika moto','Vous épargnez pour une moto')}</div><div style="height:8px;border-radius:4px;background:var(--bg);margin-top:10px;overflow:hidden" role="progressbar" aria-valuenow="${pc}" aria-valuemin="0" aria-valuemax="100"><div style="height:100%;width:${pc}%;background:var(--lk)"></div></div><div class="sm" style="margin-top:8px;line-height:19px">${fm(g.s)} / ${fm(g.t)} RWF · ${pc}%${L?'<br>'+t3('Loan of '+fm(L.loan)+' RWF over '+L.n+' months, '+fm(L.mo)+' RWF a month. We reply within 1 business day (sample).','Inguzanyo ya RWF '+fm(L.loan)+' mu mezi '+L.n+', RWF '+fm(L.mo)+' ku kwezi. Tuzasubiza mu munsi 1 w’akazi (icyitegererezo).','Prêt de '+fm(L.loan)+' RWF sur '+L.n+' mois, '+fm(L.mo)+' RWF par mois. Réponse sous 1 jour ouvré (exemple).'):''}</div>${isM&&!done?`<div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:12px">${[10000,50000].map(a=>`<button class="chip" style="background:var(--bg);color:var(--tx)" onclick="moAdd(${a})">${t3('Save ','Bika ','Épargner ')}${fm(a)}</button>`).join('')}</div>`:''}</div>`;
 body=`${lab(t3('Your plan','Gahunda yawe','Votre plan'))}${rw(t3('Motorbike price','Igiciro cya moto','Prix de la moto'),fm(p.a)+' RWF')}${rw(t3('Down payment ('+p.dp+'%)','Amafaranga y’ibanze ('+p.dp+'%)','Apport ('+p.dp+' %)'),fm(q.dn)+' RWF')}${rw(t3('Save it in','Uyabike mu','Épargner en'),p.ms+' '+t3('months','mezi','mois'))}${rw(t3('Loan','Inguzanyo','Prêt'),fm(q.loan)+' RWF / '+p.n+' '+t3('months','mezi','mois'))}${rw(t3('Monthly loan payment','Ishyura buri kwezi','Mensualité du prêt'),fm(q.mo)+' RWF',1)}${rw(t3('Total to repay','Ugomba kwishyura yose','Total à rembourser'),fm(q.tot)+' RWF')}`;
 btn=L?`<button class="btn" style="white-space:nowrap" onclick="moOpenGoal()">${t3('Open my savings goal','Fungura intego yanjye','Ouvrir mon objectif')}</button>`:done?`<button class="btn" style="white-space:nowrap" onclick="moApplyReview()">${t3('Apply for your loan','Saba inguzanyo yawe','Demander votre prêt')}</button>`:`<button class="btn" style="white-space:nowrap" onclick="moOpenGoal()">${t3('Open my savings goal','Fungura intego yanjye','Ouvrir mon objectif')}</button>`}
else{if(other())top=`<div style="margin:18px 24px 0;padding:14px 16px;border-radius:16px;background:var(--chip);font-size:14px;line-height:20px">${t3('You already have a savings goal: ','Usanzwe ufite intego yo kubika: ','Vous avez déjà un objectif d’épargne : ')}<b>${esc48(g.n)}</b>. ${t3('Finish it or delete it, then come back to start your motorbike goal.','Yirangize cyangwa uyisibe, hanyuma ugaruke.','Terminez-le ou supprimez-le, puis revenez.')}</div>`;
 body=`${lab(t3('Motorbike price','Igiciro cya moto','Prix de la moto'))}<div style="padding:8px 24px 0"><div style="display:flex;align-items:baseline;gap:8px;border-bottom:2px solid var(--ln)"><input id="moP" inputmode="numeric" autocomplete="off" placeholder="0" value="${M().a?fmt(M().a):''}" oninput="moType(this)" aria-describedby="moPE" style="flex:1;min-width:0;border:0;background:none;color:var(--tx);font:inherit;font-size:24px;font-weight:800;padding:6px 0;outline:0;border-radius:0"><span class="mu" style="font-weight:700">RWF</span></div><div id="moPE" role="alert" class="sm" style="min-height:20px;margin-top:6px;color:var(--er);font-weight:700">${perr()}</div></div><div id="moD">${dyn()}</div>`;
 btn=other()?`<button class="btn" style="white-space:nowrap" onclick="moOpenGoal()">${t3('Open my savings goal','Fungura intego yanjye','Ouvrir mon objectif')}</button>`:`<button id="moB" class="btn" style="white-space:nowrap" ${okP()?'':'disabled'} onclick="moReview()">${t3('Start saving '+fm(calc(M()).dn)+' RWF','Tangira kubika RWF '+fm(calc(M()).dn),'Commencer à épargner '+fm(calc(M()).dn)+' RWF')}</button>`}
const need=`${lab(t3('Before the loan opens','Mbere y’uko inguzanyo ifungurwa','Avant l’ouverture du prêt'))}<div style="padding:8px 24px 0;font-size:15px;line-height:24px"><div>✓ ${t3('Valid driving licence','Uruhushya rwo gutwara rukora','Permis de conduire valide')}</div><div>✓ ${t3('Moto-taxi permit','Uruhushya rwa moto-taxi','Permis moto-taxi')}</div></div>`;
return bar(t3('Moto-Taxi ownership','Kugira moto-taxi yawe','Devenir propriétaire de moto-taxi'))+`<div style="padding:22px 24px 0"><div style="width:72px;height:72px;border-radius:36px;background:var(--tint);display:flex;align-items:center;justify-content:center;font-size:36px">🏍️</div><div class="h1" style="margin-top:16px">${t3('Moto-Taxi ownership','Kugira moto-taxi yawe','Devenir propriétaire de moto-taxi')}</div><div class="mu" style="font-size:15px;line-height:22px;margin-top:8px">${t3('Save the down payment, then turn the rest into a loan.','Bika amafaranga y’ibanze, hanyuma isigaye ibe inguzanyo.','Épargnez l’apport, puis transformez le reste en prêt.')}</div></div><div style="display:flex;gap:8px;padding:18px 24px 0" role="list">${steps}</div>${top}${body}${need}<div class="pad fine" style="padding-top:14px">${t3('Sample terms for this prototype. No real loan is made.','Amabwiriza y’icyitegererezo. Nta nguzanyo nyayo itangwa.','Conditions d’exemple pour ce prototype. Aucun vrai prêt n’est accordé.')}</div><div style="height:100px"></div><div class="cta">${btn}</div>`};
const _p=screens.svc;screens.svc=()=>S.svk==='moto'?screenMoto():_p();
}
/* v299: Moto-Taxi ownership. Before: English only; the price could only be tapped (shortcuts) with no typing; the 30% down payment was fixed; once the goal was created the page only said how much was saved and the loan never opened. Now: English, French and Kinyarwanda (fr/rw new copy needs native review); a three-step strip (Save, Apply, Repay); the price is a field (1,000,000 to 5,000,000 RWF, error under it) with shortcuts; down payment 30 / 40 / 50% (a bigger one gives a smaller loan); save in 6 / 12 / 18 months; repay over 24 / 36 / 48 months with loan amount, monthly payment, interest in total and total to repay; "Can you afford it?" where you tap what you expect to earn a day and see saving and loan payment as a share of a month (Comfortable up to 30%, Tight up to 45%, High above); a review before the goal is created, and the plan is stored with it. After that the page shows progress with "Save 10,000" and "Save 50,000" (taken from itunda Bank) and the plan; when the down payment is full, "Apply for your loan" opens a review and sends a sample application with its status on the page. */
/* v300 Maps place card: one row */
{const st=document.createElement('style');st.id='v300';
st.textContent='#phone .acts.mp5{display:flex!important;flex-wrap:nowrap!important;gap:6px!important;overflow:visible!important}#phone .acts.mp5>button{flex:1 1 auto!important;grid-column:auto!important;width:auto!important;min-width:0!important;padding:0 6px!important;font-size:13px!important;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}#phone .acts.mp5>button.p,#phone .acts.mp5>button.q{flex-grow:1.25!important}#phone .acts.mp5.mp5s>button{font-size:12px!important;padding:0 4px!important}@media (max-width:380px){#phone .acts.mp5{gap:4px!important}#phone .acts.mp5.mp5s>button{font-size:11px!important;padding:0 2px!important}}';
document.head.appendChild(st);
const _m=screens.mapview;
screens.mapview=()=>{const h=_m();const sm=S.lang!=='en';let r=h.replace(/<div class="acts(" style="padding:14px 0 0">[\s\S]*?)<\/div><div class="acts" style="padding:8px 0 0">([\s\S]*?)<\/div>/,'<div class="acts mp5'+(sm?' mp5s':'')+'$1$2</div>');if(S.lang==='fr')r=r.replace(/(☆ |★ )Enregistrer/,'$1Garder');return r};
}
/* v300: Maps place card (French and Kinyarwanda use 12 px, and French says "Garder" for Save, so all five fit at 360 px). Before: Depart, Arrive and Details were on one row and Save and Share on a second row under them. Now all five sit on one line (Depart and Arrive a little wider, the rest share the space, text 13 px), in English, French and Kinyarwanda, also for a dropped pin (four buttons, no Details). */
/* v301 VUP Financial Services */
{const t3=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e;
const fm=n=>fmt(Math.round(n)),esc48=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const AMIN=50000,AMAX=500000,SCS=[50000,150000,300000,500000],TMS=[6,12,18],RATE=2;
const short=v=>v>=1e6?v/1e6+'M':v/1e3+'K';
const PUR=[['farm',['Farming','Ubuhinzi','Agriculture']],['live',['Livestock','Ubworozi','Élevage']],['shop',['Small shop','Iduka rito','Petit commerce']],['tools',['Tools & equipment','Ibikoresho','Outils et matériel']],['other',['Other','Ibindi','Autre']]];
const pname=k=>{const p=PUR.find(x=>x[0]===k);return p?t3(...p[1]):''};
S.vup=S.vup||{hh:null,sec:'',pur:'',a:150000,n:12};
const V=()=>S.vup;const calc=()=>{const p=V().a,n=V().n,i=RATE/1200,mo=Math.round(p*i/(1-Math.pow(1+i,-n)));return{mo,tot:mo*n,int:mo*n-p}};
const aerr=()=>{const a=V().a;return !a?'':a<AMIN?t3('Minimum is '+fm(AMIN)+' RWF','Nibura ni RWF '+fm(AMIN),'Minimum : '+fm(AMIN)+' RWF'):a>AMAX?t3('Maximum is '+fm(AMAX)+' RWF','Ntarenza RWF '+fm(AMAX),'Maximum : '+fm(AMAX)+' RWF'):''};
const miss=()=>{const v=V();if(v.hh===null)return t3('Answer the first question to continue.','Subiza ikibazo cya mbere ukomeze.','Répondez à la première question pour continuer.');if(v.hh==='n')return t3('VUP microloans are for VUP households.','Inguzanyo za VUP ni iz’ingo ziri muri VUP.','Les microcrédits VUP sont pour les ménages du programme VUP.');if((v.sec||'').trim().length<3)return t3('Type your sector to continue.','Andika umurenge wawe ukomeze.','Saisissez votre secteur pour continuer.');if(!v.pur)return t3('Choose what the loan is for.','Hitamo icyo inguzanyo igenewe.','Choisissez l’usage du prêt.');if(!v.a||aerr())return aerr()||t3('Enter an amount to continue.','Andika amafaranga ukomeze.','Saisissez un montant pour continuer.');return ''};
const chip=(on,fn,l,al)=>`<button class="chip" aria-pressed="${on}" ${al?`aria-label="${al}" `:''}onclick="${fn}" style="min-width:64px;height:44px;border-radius:22px;border:0;padding:0 16px;font-size:15px;font-weight:800;background:${on?'var(--tx)':'var(--chip)'};color:${on?'var(--bg)':'var(--tx)'}">${l}</button>`;
const grp=(h,id)=>`<div ${id?`id="${id}" `:''}style="display:flex;gap:10px;flex-wrap:wrap;padding:10px 24px 0" role="group">${h}</div>`;
const lab=(t,s,f)=>`<div style="padding:24px 24px 0"><label ${f?`for="${f}" `:''}style="font-size:16px;font-weight:800;display:block">${t}</label>${s?`<div class="sm mu" style="margin-top:4px;line-height:19px">${s}</div>`:''}</div>`;
const rw=(a,v,b)=>`<div style="margin:8px 24px 0;display:flex;justify-content:space-between;gap:12px;font-size:15px"><span class="mu">${a}</span><b style="text-align:right;${b?'color:var(--tintfg)':''}">${v}</b></div>`;
const R=(a,v)=>`<div style="display:flex;justify-content:space-between;gap:12px;min-height:40px;align-items:center;font-size:15px"><span class="mu">${a}</span><b style="text-align:right">${v}</b></div>`;
const lay2=h=>{$('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet">'+h+'</div>';if(typeof focusSheet==='function')focusSheet()};
const qHH=()=>{const v=V();return grp([['y',t3('Yes','Yego','Oui')],['u',t3('Not sure','Simbizi','Pas sûr')],['n',t3('No','Oya','Non')]].map(([k,l])=>chip(v.hh===k,`vpSet('hh','${k}')`,l)).join(''))};
const qPur=()=>grp(PUR.map(([k,n])=>chip(V().pur===k,`vpSet('pur','${k}')`,t3(...n))).join(''));
const dyn=()=>{const v=V(),q=calc(),ok=!aerr()&&v.a>=AMIN,m=miss();
const hhNote=v.hh==='u'?`<div style="margin:14px 24px 0;padding:12px 14px;border-radius:14px;background:var(--chip);font-size:14px;line-height:20px">${t3('No problem. Your sector office checks this when you apply.','Nta kibazo. Ibiro by’umurenge bibisuzuma usabye.','Pas de souci. Votre bureau de secteur le vérifie à votre demande.')}</div>`:v.hh==='n'?`<div style="margin:14px 24px 0;padding:14px 16px;border-radius:16px;background:var(--chip);font-size:14px;line-height:20px">${t3('VUP microloans are only for households in the VUP programme. You can look at other loans instead.','Inguzanyo za VUP ni iz’ingo ziri muri gahunda ya VUP gusa. Ushobora kureba izindi nguzanyo.','Les microcrédits VUP sont réservés aux ménages du programme VUP. Vous pouvez voir d’autres prêts.')}<div style="margin-top:10px"><button class="chip" onclick="vpOther()">${t3('See other loans','Reba izindi nguzanyo','Voir d’autres prêts')}</button></div></div>`:'';
return `${hhNote}${v.hh==='n'?'':`${grp(SCS.map(x=>chip(v.a===x,`vpSet('a',${x})`,short(x),fm(x)+' RWF')).join(''),'')}
${lab(t3('Repay over','Ishyura mu','Rembourser sur'))}${grp(TMS.map(x=>chip(v.n===x,`vpSet('n',${x})`,x+' '+t3('months','mezi','mois'))).join(''))}
${ok?rw(t3('Monthly payment','Kwishyura buri kwezi','Mensualité'),fm(q.mo)+' RWF',1)+rw(t3('Interest ('+RATE+'% a year)','Inyungu ('+RATE+'% ku mwaka)','Intérêts ('+RATE+' % par an)'),fm(q.int)+' RWF')+rw(t3('Total to repay','Ugomba kwishyura yose','Total à rembourser'),fm(q.tot)+' RWF'):''}
${lab(t3('What to bring to your sector office','Ibyo kujyana ku murenge','À apporter à votre bureau de secteur'))}<div style="padding:8px 24px 0;font-size:15px;line-height:24px"><div>✓ ${t3('National ID','Indangamuntu','Carte d’identité')}</div><div>✓ ${t3('Proof your household is in VUP','Icyemezo ko urugo rwawe ruri muri VUP','Preuve que votre ménage est dans VUP')}</div></div>`}
<div id="vpM" class="sm" role="status" style="margin:16px 24px 0;min-height:20px;text-align:center;color:var(--mu);font-weight:700">${m&&v.hh!=='n'?m:''}</div>`};
window.vpUpd=()=>{const d=document.getElementById('vpD');if(!d)return;d.innerHTML=dyn();const e=document.getElementById('vpAE');if(e)e.textContent=aerr();const q1=document.getElementById('vpQ1'),q3=document.getElementById('vpQ3');if(q1)q1.innerHTML=qHH();if(q3)q3.innerHTML=qPur();const b=document.getElementById('vpB');if(b){b.disabled=!!miss();b.textContent=t3('Apply for '+fm(V().a)+' RWF','Saba RWF '+fm(V().a),'Demander '+fm(V().a)+' RWF')}};
window.vpSet=(f,v)=>{const was=V().hh;V()[f]=v;if(f==='hh'&&(was==='n'||v==='n')){render('fade-none');return}if(f==='a'){const i=document.getElementById('vpA');if(i)i.value=fmt(v)}vpUpd()};
window.vpType=(f,el)=>{if(f==='a'){const x=el.value.replace(/\D/g,'').slice(0,7);V().a=x?Number(x):0;el.value=x?fmt(x):''}else V().sec=el.value.slice(0,40);vpUpd()};
window.vpOther=()=>{S.stack.push('loan');render('push')};
window.vpReview=()=>{if(miss()||S.apps.vup)return;const v=V(),q=calc();
lay2(`<div class="h1" style="font-size:22px;line-height:30px;margin-top:4px">${t3('Apply for '+fm(v.a)+' RWF?','Gusaba RWF '+fm(v.a)+'?','Demander '+fm(v.a)+' RWF ?')}</div><div style="margin:12px 0 16px">${R(t3('Repay over','Kwishyura mu','Remboursement sur'),v.n+' '+t3('months','mezi','mois'))}${R(t3('Monthly payment','Kwishyura buri kwezi','Mensualité'),fm(q.mo)+' RWF')}${R(t3('Total to repay','Ugomba kwishyura yose','Total à rembourser'),fm(q.tot)+' RWF')}${R(t3('Rate','Inyungu','Taux'),RATE+t3('% a year','% ku mwaka',' % par an'))}${R(t3('Sector','Umurenge','Secteur'),esc48(v.sec.trim()))}${R(t3('For','Igenewe','Usage'),pname(v.pur))}${R(t3('Checked by','Bisuzumwa na','Vérifié par'),t3('Your sector office','Ibiro by’umurenge wawe','Votre bureau de secteur'))}</div><div class="mu sm" style="margin:-4px 0 16px;line-height:20px">${t3('Next: your sector office contacts you to confirm. Money is sent to itunda Pay once approved. You can withdraw until it is approved.','Ibikurikira: ibiro by’umurenge bigufata kugira ngo bibyemeze. Amafaranga yoherezwa muri itunda Pay yemejwe. Ushobora kuyikuraho itaremezwa.','Ensuite : votre bureau de secteur vous contacte pour confirmer. L’argent est envoyé sur itunda Pay après approbation. Vous pouvez retirer la demande avant.')}</div><div style="display:grid;grid-template-columns:1fr 1.8fr;gap:12px"><button class="btn sec2" onclick="closeSheet()">${t3('Cancel','Hagarika','Annuler')}</button><button class="btn" style="white-space:nowrap" onclick="vpSend()">${t3('Send application','Ohereza ubusabe','Envoyer la demande')}</button></div>`)};
window.vpSend=()=>{if(miss()||S.apps.vup){closeSheet();return}const v=V(),q=calc();S.apps.vup={ref:'ITN-'+String(Date.now()).slice(-6),a:v.a,n:v.n,mo:q.mo,tot:q.tot,sec:v.sec.trim(),pur:v.pur,stage:0};closeSheet();render('fade-none');
lay2(`<div class="g3" style="font-size:56px;line-height:1;margin-bottom:10px">📨</div><div class="h1" style="font-size:22px;line-height:30px">${t3('Application sent','Ubusabe bwoherejwe','Demande envoyée')}</div><div class="mu" style="font-size:15px;margin:8px 0 24px;line-height:22px">${t3('Reference '+S.apps.vup.ref+'. Your sector office will contact you to confirm.','Nimero '+S.apps.vup.ref+'. Ibiro by’umurenge bizaguhamagara.','Référence '+S.apps.vup.ref+'. Votre bureau de secteur vous contactera.')}</div><button class="btn" onclick="closeSheet()">OK</button>`)};
window.vpNext=()=>{const a=S.apps.vup;if(!a||a.stage>=3)return;a.stage++;if(a.stage===3){S.pay+=a.a;a.at=Date.now();if(Array.isArray(S.act))S.act.unshift(['wallet','VUP microloan · '+a.ref,'Received · Just now',a.a,'Received']);toast('+'+fm(a.a)+' RWF '+t3('added to itunda Pay','yongewe muri itunda Pay','ajoutés à itunda Pay'))}render('fade-none')};
window.vpWithdraw=()=>lay2(`<div class="h1" style="font-size:22px;line-height:30px;margin-top:4px">${t3('Withdraw your application?','Gukuraho ubusabe bwawe?','Retirer votre demande ?')}</div><div class="mu" style="font-size:15px;margin:8px 0 24px;line-height:22px">${t3('Your sector office will not review it. You can apply again later.','Ibiro by’umurenge ntibizabusuzuma. Ushobora gusaba nanone.','Votre bureau de secteur ne l’examinera pas. Vous pourrez redemander plus tard.')}</div><div style="display:grid;grid-template-columns:1fr 1.8fr;gap:12px"><button class="btn sec2" onclick="closeSheet()">${t3('Keep it','Reka ikomeze','Garder')}</button><button class="btn" style="white-space:nowrap" onclick="vpWithdrawGo()">${t3('Withdraw','Kuraho','Retirer')}</button></div>`);
window.vpWithdrawGo=()=>{delete S.apps.vup;closeSheet();render('fade-none');toast(t3('Application withdrawn','Ubusabe bwakuweho','Demande retirée'))};
const screenVup=()=>{const a=S.apps.vup,v=V(),title=t3('VUP Financial Services','Serivisi z’imari za VUP','Services financiers VUP');
const head=bar(title)+`<div style="padding:22px 24px 0"><div style="width:72px;height:72px;border-radius:36px;background:var(--tint);display:flex;align-items:center;justify-content:center;font-size:36px">🌱</div><div class="h1" style="margin-top:16px">${title}</div><div class="mu" style="font-size:15px;line-height:22px;margin-top:8px">${t3('A government microloan for households in the VUP programme. '+RATE+'% a year, checked by your sector office.','Inguzanyo nto ya Leta ku ngo ziri muri gahunda ya VUP. '+RATE+'% ku mwaka, isuzumwa n’ibiro by’umurenge.','Un microcrédit public pour les ménages du programme VUP. '+RATE+' % par an, vérifié par votre bureau de secteur.')}</div></div>`;
if(a){const st=a.stage,names=[t3('Submitted','Cyoherejwe','Envoyée'),t3('Sector office review','Isuzumwa ry’umurenge','Examen du secteur'),t3('Approved','Cyemejwe','Approuvée'),t3('Funds sent to itunda Pay','Amafaranga yoherejwe muri itunda Pay','Fonds envoyés sur itunda Pay')];
 const desc=[t3('We sent your application to your sector office.','Twohereje ubusabe ku biro by’umurenge.','Nous avons envoyé votre demande à votre bureau de secteur.'),t3('They will contact you to confirm your household.','Bazaguhamagara kwemeza urugo rwawe.','Ils vous contacteront pour confirmer votre ménage.'),t3('Your loan is approved. Funds are on the way.','Inguzanyo yawe yemejwe. Amafaranga araje.','Votre prêt est approuvé. Les fonds arrivent.'),t3('The money is in your itunda Pay.','Amafaranga ari muri itunda Pay yawe.','L’argent est sur votre itunda Pay.')];
 const first=a.at?new Date(a.at+30*864e5).toLocaleDateString(S.lang==='fr'?'fr-FR':'en-GB',{day:'numeric',month:'short',year:'numeric'}):'';
 const tl=names.map((n,i)=>`<div style="display:flex;gap:14px;align-items:flex-start;padding:10px 0"><div style="width:26px;height:26px;border-radius:13px;flex:none;display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:800;background:${i<=st?'var(--lk)':'var(--chip)'};color:${i<=st?'#fff':'var(--mu)'}" ${i===st?'aria-current="step"':''}>${i<st||st===3&&i===3?'✓':i+1}</div><div style="min-width:0"><div style="font-weight:${i===st?800:600};color:${i<=st?'var(--tx)':'var(--mu)'}">${n}</div>${i===st?`<div class="sm mu" style="margin-top:2px;line-height:19px">${desc[i]}</div>`:''}</div></div>`).join('');
 return head+`<div style="margin:18px 24px 0;padding:14px 16px;border-radius:16px;background:var(--tint);color:var(--tintfg);font-size:14px;line-height:20px"><b>${t3('Application sent.','Ubusabe bwoherejwe.','Demande envoyée.')}</b> ${t3('Reference ','Nimero ','Référence ')}${a.ref} · ${fm(a.a)} RWF</div><div style="padding:14px 24px 0">${tl}</div>
${lab(t3('Your loan','Inguzanyo yawe','Votre prêt'))}${rw(t3('Amount','Amafaranga','Montant'),fm(a.a)+' RWF')}${rw(t3('Repay over','Kwishyura mu','Remboursement sur'),(a.n||12)+' '+t3('months','mezi','mois'))}${rw(t3('Monthly payment','Kwishyura buri kwezi','Mensualité'),fm(a.mo||0)+' RWF',1)}${rw(t3('Total to repay','Ugomba kwishyura yose','Total à rembourser'),fm(a.tot||0)+' RWF')}${rw(t3('Sector','Umurenge','Secteur'),esc48(a.sec||''))}${rw(t3('For','Igenewe','Usage'),pname(a.pur))}${first?rw(t3('First payment','Kwishyura bwa mbere','Premier paiement'),first):''}
${st<3?`<div class="pad" style="padding-top:18px"><button class="chip" onclick="vpNext()">${t3('Next step (sample)','Intambwe ikurikira (icyitegererezo)','Étape suivante (exemple)')}</button></div>`:''}<div class="pad fine" style="padding-top:14px">${t3('Sample for this prototype. No real loan is made.','Icyitegererezo cy’iyi porogaramu. Nta nguzanyo nyayo itangwa.','Exemple pour ce prototype. Aucun vrai prêt n’est accordé.')}</div><div style="height:100px"></div>${st<2?`<div class="cta"><button class="btn sec2" style="white-space:nowrap" onclick="vpWithdraw()">${t3('Withdraw application','Kuraho ubusabe','Retirer la demande')}</button></div>`:''}`}
return head+`${lab(t3('Is your household in the VUP programme?','Urugo rwawe ruri muri gahunda ya VUP?','Votre ménage est-il dans le programme VUP ?'))}<div id="vpQ1">${qHH()}</div>
${v.hh==='n'?'':`${lab(t3('Your sector','Umurenge wawe','Votre secteur'),t3('Your sector office checks your application.','Ibiro by’umurenge wawe bisuzuma ubusabe bwawe.','Votre bureau de secteur examine votre demande.'),'vpS')}<div style="padding:8px 24px 0"><input id="vpS" value="${esc48(v.sec)}" oninput="vpType('s',this)" autocomplete="off" placeholder="${t3('e.g. Kimironko','urugero: Kimironko','ex. Kimironko')}" style="width:100%;box-sizing:border-box;height:48px;border:0;border-radius:14px;background:var(--chip);color:var(--tx);padding:0 16px;font:inherit;font-size:16px"></div>
${lab(t3('What is the loan for?','Inguzanyo igenewe iki?','À quoi sert le prêt ?'))}<div id="vpQ3">${qPur()}</div>
${lab(t3('Loan amount','Amafaranga y’inguzanyo','Montant du prêt'),'','vpA')}<div style="padding:8px 24px 0"><div style="display:flex;align-items:baseline;gap:8px;border-bottom:2px solid var(--ln)"><input id="vpA" inputmode="numeric" autocomplete="off" placeholder="0" value="${v.a?fmt(v.a):''}" oninput="vpType('a',this)" aria-describedby="vpAE" style="flex:1;min-width:0;border:0;background:none;color:var(--tx);font:inherit;font-size:24px;font-weight:800;padding:6px 0;outline:0;border-radius:0"><span class="mu" style="font-weight:700">RWF</span></div><div id="vpAE" role="alert" class="sm" style="min-height:20px;margin-top:6px;color:var(--er);font-weight:700">${aerr()}</div></div>`}
<div id="vpD">${dyn()}</div><div class="pad fine" style="padding-top:8px">${t3('Sample terms for this prototype. No real loan is made.','Amabwiriza y’icyitegererezo. Nta nguzanyo nyayo itangwa.','Conditions d’exemple pour ce prototype. Aucun vrai prêt n’est accordé.')}</div><div style="height:100px"></div>${v.hh==='n'?'':`<div class="cta"><button id="vpB" class="btn" style="white-space:nowrap" ${miss()?'disabled':''} onclick="vpReview()">${t3('Apply for '+fm(v.a)+' RWF','Saba RWF '+fm(v.a),'Demander '+fm(v.a)+' RWF')}</button></div>`}`};
const _p=screens.svc;screens.svc=()=>S.svk==='vup'?screenVup():_p();
}
/* v301: VUP Financial Services. Before: English only; amount in four chips, three months options, nothing asked about your household, sector or what the loan is for, one line "Application sent" and then nothing to follow. Now: English, French and Kinyarwanda (fr/rw new copy needs native review); three questions first (is your household in VUP: Yes / Not sure / No; your sector; what the loan is for), "No" explains who the loan is for and links to other loans; the amount is a field (50,000 to 500,000 RWF) with shortcuts, repay over 6 / 12 / 18 months with monthly payment, interest and total; what to bring to the sector office; a line under the form saying what is missing; a review before sending; after sending a four-step tracker (Submitted, Sector office review, Approved, Funds sent) with "Next step (sample)", which sends the money to itunda Pay and Activity and shows the first payment date, and "Withdraw application" until it is approved. */
</script>
<script>
/* v303 Auto-fill (pocket) */
{const t3=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e;
const num=v=>Number(String(v||'').replace(/\D/g,''))||0;
const pk=()=>pkGet(S.pkId);
const MIN=500,MAXA=9999999,CH=[1000,5000,10000,20000],CAP=3650;
const sch=pkGet('sch');if(sch&&!sch.by)sch.by='2027-01-31';
const loc=()=>S.lang==='fr'?'fr-FR':'en-GB';
const day0=()=>{const d=new Date();d.setHours(0,0,0,0);return d};
const nxt=f=>{const d=day0();if(f==='Daily')d.setDate(d.getDate()+1);else if(f==='Weekly')d.setDate(d.getDate()+((6-d.getDay()+7)%7||7));else d.setMonth(d.getMonth()+1,1);return d};
const adv=(d,f)=>{const x=new Date(d);if(f==='Daily')x.setDate(x.getDate()+1);else if(f==='Weekly')x.setDate(x.getDate()+7);else x.setMonth(x.getMonth()+1,1);return x};
const nth=(f,n)=>{let d=nxt(f);for(let i=1;i<n;i++)d=adv(d,f);return d};
const cnt=(f,by)=>{let d=nxt(f),n=0;while(d<=by&&n<CAP){n++;d=adv(d,f)}return n};
const dS=(d,y)=>d.toLocaleDateString(loc(),y?{day:'numeric',month:'short',year:'numeric'}:{weekday:'short',day:'numeric',month:'short'});
const byD=p=>p&&p.by?new Date(p.by+'T23:59:59'):null;
const FQ={Daily:[t3('Every day','Buri munsi','Chaque jour'),t3('Daily','Buri munsi','Chaque jour')],
Weekly:[t3('Every Saturday','Buri wa gatandatu','Chaque samedi'),t3('Weekly','Buri cyumweru','Chaque semaine')],
Monthly:[t3('1st of every month','Ku wa 1 buri kwezi','Le 1er de chaque mois'),t3('Monthly','Buri kwezi','Chaque mois')]};
const fq=f=>({Daily:t3('Every day','Buri munsi','Chaque jour'),Weekly:t3('Every Saturday','Buri wa gatandatu','Chaque samedi'),Monthly:t3('1st of every month','Ku wa 1 buri kwezi','Le 1er de chaque mois')}[f]);
const fql=f=>({Daily:t3('Daily','Buri munsi','Chaque jour'),Weekly:t3('Weekly','Buri cyumweru','Chaque semaine'),Monthly:t3('Monthly','Buri kwezi','Chaque mois')}[f]);
const left=p=>p.t?Math.max(0,p.t-pkBal(p)):0;
/* amount that finishes the goal by its date, rounded up to 500 */
const sug=(p,f)=>{const by=byD(p);if(!p.t||!by||!left(p))return 0;const n=cnt(f,by);if(!n)return 0;return Math.max(MIN,Math.ceil(left(p)/n/500)*500)};
const adErr=()=>{const a=S.au.a;if(!a)return t3('Enter an amount','Andika amafaranga','Saisissez un montant');if(a<MIN)return t3('The least you can set is '+fmt(MIN)+' RWF','Ntoya ni RWF '+fmt(MIN),'Le minimum est de '+fmt(MIN)+' RWF');return ''};
const adDirty=()=>{const p=pk();return !p.auto||S.au.f!==p.auto.f||S.au.a!==p.auto.a};
const adInfo=()=>{const p=pk(),A=S.au,out=[];
 if(S.bank<A.a&&A.a)out.push(t3('Your itunda Bank balance is '+fmt(S.bank)+' RWF, less than this amount. We skip a transfer if your balance is too low.','Amafaranga ufite kuri itunda Bank ni RWF '+fmt(S.bank)+', ari munsi y’ayo. Turasimbuka kohereza iyo amafaranga adahagije.','Votre solde itunda Bank est de '+fmt(S.bank)+' RWF, soit moins que ce montant. Nous sautons un virement si le solde est trop bas.'));
 if(p.t&&A.a>=MIN){const L=left(p);
  if(!L)out.push(t3('Goal already reached','Intego yamaze kugerwaho','Objectif déjà atteint'));
  else{const k=Math.ceil(L/A.a);
   if(k>CAP)out.push(t3('At this amount it takes more than 10 years. Try a larger amount.','Kuri ayo mafaranga bifata imyaka irenga 10. Gerageza menshi kurushaho.','Avec ce montant, il faut plus de 10 ans. Essayez un montant plus élevé.'));
   else{const d=nth(A.f,k),by=byD(p),g=fmt(p.t)+' RWF';
    if(by&&d>by){const s=sug(p,A.f);
     out.push(t3('At this pace you reach '+g+' on '+dS(d,1)+', after '+dS(by,1)+'.','Ku muvuduko ugezeho RWF '+fmt(p.t)+' ku wa '+dS(d,1)+', nyuma ya '+dS(by,1)+'.','À ce rythme, vous atteignez '+g+' le '+dS(d,1)+', après le '+dS(by,1)+'.')+(s&&s!==A.a?' <button onclick="adAmt('+s+')">'+t3('Use '+fmt(s)+' RWF','Koresha RWF '+fmt(s),'Utiliser '+fmt(s)+' RWF')+'</button>':''))}
    else out.push(by?t3('On track: you reach '+g+' on '+dS(d,1)+', before '+dS(by,1)+'.','Uri mu nzira nziza: ugera kuri RWF '+fmt(p.t)+' ku wa '+dS(d,1)+', mbere ya '+dS(by,1)+'.','Dans les temps : vous atteignez '+g+' le '+dS(d,1)+', avant le '+dS(by,1)+'.')
     :t3('Reaches '+g+' on '+dS(d,1),'Ugera kuri RWF '+fmt(p.t)+' ku wa '+dS(d,1),'Atteint '+g+' le '+dS(d,1)))}}}
 return out.map(x=>'<div>'+x+'</div>').join('')};
const adNext=()=>fq(S.au.f)+' · '+t3('next on ','ikurikira ku wa ','prochain le ')+dS(nxt(S.au.f));
function adUpd(){const A=S.au,e=adErr(),sv=$('#ads');if(!sv)return;
 $('#ade').textContent=(S.adT&&e)?e:'';$('#ada').setAttribute('aria-invalid',(S.adT&&e)?'true':'false');
 $('#adnx').textContent=adNext();$('#adn').innerHTML=adInfo();
 document.querySelectorAll('#adf button').forEach(b=>{const on=b.dataset.f===A.f;b.classList.toggle('on',on);b.setAttribute('aria-pressed',on?'true':'false')});
 document.querySelectorAll('#adc button').forEach(b=>{const on=Number(b.dataset.v)===A.a;b.classList.toggle('on',on);b.setAttribute('aria-pressed',on?'true':'false')});
 sv.disabled=!!e||!adDirty()}
window.adFreq=f=>{const p=pk();S.au.f=f;if(S.adAuto){const s=sug(p,f);if(s){S.au.a=s;$('#ada').value=fmt(s)}}adUpd()};
window.adAmt=v=>{S.au.a=v;S.adAuto=false;$('#ada').value=v?fmt(v):'';adUpd()};
window.adType=v=>{const a=Math.min(MAXA,num(v));S.au.a=a;S.adAuto=false;S.adT=true;$('#ada').value=a?fmt(a):'';adUpd()};
window.autoSheet=function(){const p=pk();if(!p)return;S.adT=false;
 if(p.auto){S.au={...p.auto};S.adAuto=false}
 else{const s=sug(p,'Weekly');S.au={f:'Weekly',a:s||5000};S.adAuto=!!s}
 drawAuto()};
window.drawAuto=function(){const p=pk(),A=S.au,on=!!p.auto,b=pkBal(p),pct=p.t?Math.min(100,Math.round(b/p.t*100)):0;
 $('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet mgp" role="dialog" aria-modal="true" aria-label="${t3('Auto-fill','Kuzuza byikora','Remplissage auto')}" style="max-height:92%;overflow-y:auto"><div class="h1" style="font-size:22px;line-height:30px">${t3('Auto-fill','Kuzuza byikora','Remplissage auto')} ${esc48(p.n)}</div>
<div class="mu" style="font-size:14px;margin:6px 0 0;line-height:20px">${t3('Moves money from itunda Bank into this pocket on its own.','Yimura amafaranga kuri itunda Bank ikayashyira muri aka gasanduku ubwayo.','Transfère automatiquement de l’argent d’itunda Bank vers cette poche.')}</div>
<div class="mgsum">${pkIco(p,48)}<div style="min-width:0"><b>${esc48(p.n)}</b><span>${fmt(b)}${p.t?' / '+fmt(p.t):''} RWF${p.t?' · '+pct+'%':''}</span></div></div>
${p.t?`<div class="mgb" style="margin-top:0"><i style="width:${pct}%"></i></div>`:''}
<div class="lab" style="margin-top:20px">${t3('How often','Kangahe','Fréquence')}</div>
<div class="pkauto" id="adf" role="group" aria-label="${t3('How often','Kangahe','Fréquence')}" style="margin-top:8px">${Object.keys(FQ).map(f=>`<button data-f="${f}" aria-pressed="${A.f===f}" class="${A.f===f?'on':''}" onclick="adFreq('${f}')">${fql(f)}</button>`).join('')}</div>
<label class="lab" for="ada" style="margin-top:16px">${t3('Amount each time','Amafaranga buri gihe','Montant à chaque fois')}</label>
<div class="mgf"><input class="in" id="ada" inputmode="numeric" autocomplete="off" value="${A.a?fmt(A.a):''}" aria-describedby="ade" aria-invalid="false" oninput="adType(this.value)" onkeydown="if(event.key==='Enter'&&!$('#ads').disabled)autoSave()"><i>RWF</i></div><div class="mge" id="ade" role="alert"></div>
<div class="pkauto" id="adc" role="group" aria-label="${t3('Quick amounts','Amafaranga yihuse','Montants rapides')}">${CH.map(v=>`<button data-v="${v}" aria-pressed="${A.a===v}" class="${A.a===v?'on':''}" aria-label="${fmt(v)} RWF" onclick="adAmt(${v})">${v/1000}K</button>`).join('')}</div>
<div class="pknext" id="adnx">${adNext()}</div>
<div class="mgn" id="adn" style="line-height:19px">${adInfo()}</div>
<button class="btn" id="ads" style="margin-top:16px" ${adErr()||!adDirty()?'disabled':''} onclick="autoSave()">${on?t3('Save changes','Bika impinduka','Enregistrer'):t3('Start auto-fill','Tangira kuzuza byikora','Activer le remplissage auto')}</button>
${on?`<button class="pkopt" style="justify-content:center;height:48px;margin-top:4px;font-size:15px" onclick="autoRun()">${t3('Run next transfer now (demo)','Ohereza ubu (igerageza)','Lancer le prochain virement (démo)')}</button><button class="mgd" onclick="autoOff()">${t3('Turn off auto-fill','Hagarika kuzuza byikora','Désactiver le remplissage auto')}</button>`:''}</div>`};
window.autoSave=function(){const p=pk();if(!p||!S.au)return;S.adT=true;if(adErr()){adUpd();return}
 p.auto={f:S.au.f,a:S.au.a};closeSheet();render('fade-none');toast(t3('Auto-fill on · ','Kuzuza byikora biratangiye · ','Remplissage auto activé · ')+fq(p.auto.f).toLowerCase()+' · '+fmt(p.auto.a)+' RWF')};
window.autoOff=function(){const p=pk();if(!p)return;delete p.auto;closeSheet();render('fade-none');toast(t3('Auto-fill turned off','Kuzuza byikora byahagaritswe','Remplissage auto désactivé'))};
/* pocket screen: the Auto-fill row follows the language and says what is on */
{const _p=screens.pocket;screens.pocket=function(){let h=_p.apply(this,arguments);if(S.lang==='en')return h;const p=pk();if(!p)return h;
 return h.replace(/(<div class="pkpn">)Auto-fill(<\/div><div class="pkpb" style="font-size:17px">)[^<]*(<\/div>)/,(m,a,b,c)=>a+t3('Auto-fill','Kuzuza byikora','Remplissage auto')+b+(p.auto?fq(p.auto.f)+' · '+fmt(p.auto.a)+' RWF':t3('Off','Ntikoreshwa','Désactivé'))+c)}}
document.title='itunda, clickable prototype v303';
}
/* v303: Auto-fill (pocket). Before: a small pop-up with Daily / Weekly / Monthly and four amounts (1,000 to 20,000), always starting at Weekly 5,000 whatever the goal, only English, the amount could not be typed, and Save was always on. Now: the pocket's name, balance and goal bar at the top; "How often" (Daily / Weekly / Monthly) and "Amount each time" as a field you can type (any amount from 500 RWF, separators as you type, error under the field) with 1K / 5K / 10K / 20K shortcuts; a line with the next date ("Every Saturday · next on Sat, 24 Oct"). For a pocket with a goal and a date (School fees: 300,000 RWF by 31 Jan 2027) the first amount is the one that finishes in time (12,000 RWF weekly, 60,000 monthly, 2,000 daily), it follows the frequency until you pick your own amount, and the note under it says "On track: you reach 300,000 RWF on ..." or, when the amount is too small, the date you would reach it, the deadline and a "Use X RWF" button. A note appears when your itunda Bank balance is lower than the amount (we skip a transfer if it is too low). One full-width button, "Start auto-fill" or "Save changes", which stays off until the amount is valid and something changed; when on, "Run next transfer now (demo)" and "Turn off auto-fill" sit below. The Auto-fill row on the pocket screen follows the language. English, French and Kinyarwanda; fr is new copy and rw is new copy that needs native review, especially "Kuzuza byikora", "Buri wa gatandatu" and "Turasimbuka kohereza". Not in this version: choosing the weekday or the day of the month, and an end date for the auto-fill. */
</script>
<script>
/* v304 Bike rental */
(function(){
const T=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e;
const VH=[{k:'Bike',p:20,e:'\ud83d\udeb2'},{k:'E-scooter',p:50,e:'\ud83d\udef4'}];
const vn=i=>[T('Bike','Igare','Vélo'),T('E-scooter','Scooter y’amashanyarazi','Trottinette électrique')][i];
const vnk=k=>vn(VH.findIndex(x=>x.k===k));
const vu=i=>[T('Unlock a bike','Fungura igare','Déverrouiller un vélo'),T('Unlock an e-scooter','Fungura scooter','Déverrouiller une trottinette')][i];
const vq=i=>[T('Unlock a bike?','Gufungura igare?','Déverrouiller un vélo ?'),T('Unlock an e-scooter?','Gufungura scooter?','Déverrouiller une trottinette ?')][i];
const vl=i=>[T('bike','igare','vélo'),T('e-scooter','scooter','trottinette')][i];
const mn=m=>T(m+' min','iminota '+m,m+' min');
const R=(a,v)=>'<div style="display:flex;justify-content:space-between;gap:12px;min-height:40px;align-items:center;font-size:15px"><span class="mu">'+a+'</span><b style="text-align:right">'+v+'</b></div>';
S.bkr=S.bkr||null;S.bkh=S.bkh||[];S.bkv=S.bkv||0;S.bkav=S.bkav||[6,3];
const lab=t=>'<div style="font-size:16px;font-weight:800;padding:22px 24px 0">'+t+'</div>';
const el=()=>{const r=S.bkr;return r?Date.now()-r.t0+(r.skip||0)*6e4:0};
const mins=()=>Math.max(1,Math.ceil(el()/6e4));
const fare=()=>Math.min(S.pay,mins()*VH[S.bkr.v].p);
const clock=()=>{const s=Math.floor(el()/1000);return Math.floor(s/60)+':'+String(s%60).padStart(2,'0')};
const fareTxt=()=>{const p=VH[S.bkr.v].p;return T(fmt(fare())+' RWF so far at '+p+' RWF a minute','RWF '+fmt(fare())+' kugeza ubu, RWF '+p+' ku munota',fmt(fare())+' RWF jusqu’ici, à '+p+' RWF la minute')};
const addBtn=()=>'<button onclick="sheetAdd()" style="border:0;background:none;padding:6px 0;font:inherit;font-weight:800;color:var(--lk);text-decoration:underline">'+T('Add money','Shyiramo amafaranga','Ajouter de l’argent')+'</button>';
const warn=()=>{if(!S.bkr)return '';const p=VH[S.bkr.v].p,n=Math.max(0,Math.floor((S.pay-mins()*p)/p));if(n>5)return '';
 return '<span style="color:var(--er)">'+(n?T('Your itunda Pay balance covers about '+n+' more minute'+(n>1?'s':'')+'.','Amafaranga ufite muri itunda Pay ahagije ku minota nka '+n+' gusa.','Votre solde itunda Pay couvre environ '+n+' minute'+(n>1?'s':'')+' de plus.'):T('Your itunda Pay balance is used up. End your ride or add money.','Amafaranga yo muri itunda Pay yashize. Rangiza urugendo cyangwa ushyiremo andi.','Votre solde itunda Pay est épuisé. Terminez la course ou ajoutez de l’argent.'))+'</span> '+addBtn()};
const _s=screens.svc;
screens.svc=function(){if(S.svk!=='bike')return _s.apply(this,arguments);
 if(S.bkr){const r=S.bkr,v=VH[r.v];
  return bar(T('Bike rental','Gukodesha igare','Location de vélo'))+'<div style="margin:22px 24px 0;padding:20px;border-radius:20px;background:var(--tint);text-align:center"><div style="font-size:40px">'+v.e+'</div><div class="sm" style="color:var(--tintfg);margin-top:6px">'+T('Ride in progress','Urugendo rurakomeje','Course en cours')+' · '+vn(r.v)+'</div><div id="bkT2" class="big" style="margin-top:8px" aria-live="off">'+clock()+'</div><div id="bkF2" class="sm" style="margin-top:8px;color:var(--tintfg)">'+fareTxt()+'</div></div>'+
  '<div id="bkW2" class="pad sm" style="padding-top:12px;line-height:20px" aria-live="polite">'+warn()+'</div>'+
  '<div class="pad sm mu" style="padding-top:8px;line-height:20px">'+T('Unlock code','Kode yo gufungura','Code de déverrouillage')+' <b style="color:var(--tx)">'+r.code+'</b>. '+T('Lock the '+vl(r.v)+' when you are done, then tap End ride. The fare comes from itunda Pay.','Funga '+vl(r.v)+' urangije, hanyuma ukande Rangiza urugendo. Amafaranga akurwa kuri itunda Pay.','Verrouillez le '+vl(r.v)+' à la fin, puis touchez Terminer la course. Le tarif est prélevé sur itunda Pay.')+'</div><div class="pad" style="padding-top:6px"><button class="sm" style="background:none;border:0;color:var(--lk);font-weight:700;padding:8px 0" onclick="bkrSkip()">'+T('Skip 10 minutes (prototype only)','Simbuka iminota 10 (igerageza gusa)','Avancer de 10 minutes (prototype)')+'</button></div><div style="height:100px"></div><div class="cta"><button class="btn" onclick="bkrEndAsk()">'+T('End ride','Rangiza urugendo','Terminer la course')+'</button></div>'}
 const i=S.bkv,v=VH[i],cost=v.p*15,low=S.pay<cost,none=S.bkav[i]<1;
 const rows=VH.map((x,j)=>{const n=S.bkav[j];return '<div class="row tap" role="radio" aria-checked="'+(i===j)+'" tabindex="0" onclick="bkrPick('+j+')" style="padding:12px 24px;'+(i===j?'background:var(--tint)':'')+'"><div class="ico" style="font-size:22px">'+x.e+'</div><div style="flex:1"><div class="t">'+vn(j)+'</div><div class="s">'+(n?T('15 minutes cost '+fmt(x.p*15)+' RWF · '+n+' here','Iminota 15 ni RWF '+fmt(x.p*15)+' · bihari '+n,'15 minutes : '+fmt(x.p*15)+' RWF · '+n+' ici'):T('None here right now','Nta na kimwe gihari ubu','Aucun ici pour le moment'))+'</div></div><b>'+T(x.p+' RWF / min','RWF '+x.p+' / munota',x.p+' RWF / min')+'</b></div>'}).join('');
 const step=(n,t)=>'<div style="display:flex;gap:12px;align-items:flex-start;padding:6px 24px 0"><div style="width:24px;height:24px;border-radius:12px;background:var(--chip);display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:800;flex:none">'+n+'</div><div style="font-size:15px;line-height:24px">'+t+'</div></div>';
 const block=S.bkh.length?lab(T('Recent rides','Ingendo ziheruka','Courses récentes'))+S.bkh.slice(0,3).map(h=>'<div style="display:flex;justify-content:space-between;gap:12px;padding:12px 24px;font-size:15px"><span>'+vnk(h.v)+' · '+mn(h.m)+'</span><b>'+fmt(h.f)+' RWF</b></div>').join('')
  :lab(T('How it works','Uko bikora','Comment ça marche'))+step(1,T('Scan the QR code on the handlebar.','Sikana QR code iri ku gikoresho cyo kuyobora.','Scannez le code QR sur le guidon.'))+step(2,T('Enter the unlock code on the lock.','Andika kode yo gufungura ku gufunga.','Saisissez le code de déverrouillage sur le cadenas.'))+step(3,T('Lock it when you are done. The ride ends and you pay for the minutes used.','Wongere uyifunge urangije. Urugendo rurarangira ukishyura iminota wakoresheje.','Verrouillez-le à la fin. La course se termine et vous payez les minutes utilisées.'));
 const note=low?'<span style="color:var(--er)">'+T('Keep at least '+fmt(cost)+' RWF (15 minutes) in itunda Pay to rent. You have '+fmt(S.pay)+' RWF.','Gumana nibura RWF '+fmt(cost)+' (iminota 15) muri itunda Pay kugira ngo ukodeshe. Ufite RWF '+fmt(S.pay)+'.','Gardez au moins '+fmt(cost)+' RWF (15 minutes) dans itunda Pay pour louer. Vous avez '+fmt(S.pay)+' RWF.')+'</span> '+addBtn()
  :'<span class="mu">'+T('Paid from itunda Pay · '+fmt(S.pay)+' RWF. Charged when you lock it.','Wishyura ukoresheje itunda Pay · RWF '+fmt(S.pay)+'. Wishyurwa ufunze.','Payé depuis itunda Pay · '+fmt(S.pay)+' RWF. Débité au verrouillage.')+'</span>';
 return bar(T('Bike rental','Gukodesha igare','Location de vélo'))+'<div style="padding:22px 24px 0"><div class="h1">'+T('Rent by the minute','Kodesha ku munota','Louez à la minute')+'</div><div class="mu" style="font-size:15px;line-height:22px;margin-top:8px">'+T('Nearest: Kimironko Market, 120 m','Hafi: Isoko rya Kimironko, m 120','Le plus proche : marché de Kimironko, 120 m')+'</div></div>'+
 '<div role="radiogroup" style="padding-top:12px">'+rows+'</div><div class="pad sm" style="padding-top:14px;line-height:20px" aria-live="polite">'+note+'</div>'+block+
 '<div class="pad fine" style="padding-top:14px">'+T('Sample prices and places for this prototype.','Ibiciro n’aho biherereye ni ibyitegererezo kuri iyi porogaramu.','Prix et lieux d’exemple pour ce prototype.')+'</div><div style="height:100px"></div>'+
 '<div class="cta"><button class="btn" '+(low||none?'disabled ':'')+'style="white-space:nowrap" onclick="bkrAsk()">'+vu(i)+'</button></div>'};
window.bkrPick=i=>{S.bkv=i;render('fade-none')};
const sheet=(h,body,no,yes,go)=>{$('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="h1" style="font-size:22px;line-height:30px;margin-top:4px">'+h+'</div><div style="margin:12px 0 20px">'+body+'</div><div class="row2" style="display:grid;grid-template-columns:1fr 1.8fr"><button class="btn sec2" onclick="closeSheet()">'+no+'</button><button class="btn" style="white-space:nowrap" onclick="'+go+'">'+yes+'</button></div></div>';if(typeof focusSheet==='function')focusSheet()};
window.bkrAsk=()=>{const i=S.bkv,v=VH[i];if(S.pay<v.p*15||S.bkav[i]<1)return;
 sheet(vq(i),R(T('Price','Igiciro','Prix'),T(v.p+' RWF a minute','RWF '+v.p+' ku munota',v.p+' RWF la minute'))+R(T('Where','Aho biri','Lieu'),T('Kimironko Market, 120 m','Isoko rya Kimironko, m 120','Marché de Kimironko, 120 m'))+R(T('Paid from','Yishyurwa kuri','Payé depuis'),'itunda Pay')+R(T('Charged','Yishyurwa','Débité'),T('When you lock it','Iyo uyifunze','Au verrouillage')),T('Cancel','Hagarika','Annuler'),T('Unlock','Fungura','Déverrouiller'),'bkrGo()')};
window.bkrGo=()=>{const i=S.bkv;if(S.bkav[i]<1)return;const code=String(1000+Math.floor(Math.random()*9000));S.bkav[i]--;S.bkr={v:i,t0:Date.now(),skip:0,code};render('fade-none');
 $('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="g3" style="font-size:56px;line-height:1;margin-bottom:10px">\ud83d\udd13</div><div class="h1" style="font-size:22px;line-height:30px">'+T('Unlock code','Kode yo gufungura','Code de déverrouillage')+' '+code+'</div><div class="mu" style="font-size:15px;margin:8px 0 24px;line-height:22px">'+T('Enter it on the lock. Your ride ends when you lock the '+vl(i)+'.','Yandike ku gufunga. Urugendo rurangira iyo ufunze '+vl(i)+'.','Saisissez-le sur le cadenas. Votre course se termine quand vous verrouillez le '+vl(i)+'.')+'</div><button class="btn" onclick="closeSheet()">OK</button></div>';
 if(typeof focusSheet==='function')focusSheet()};
window.bkrSkip=()=>{if(S.bkr){S.bkr.skip=(S.bkr.skip||0)+10;render('fade-none')}};
window.bkrEndAsk=()=>{const r=S.bkr;if(!r)return;const v=VH[r.v],f=fare(),m=mins();
 sheet(T('End your ride?','Urashaka kurangiza urugendo?','Terminer votre course ?'),R(T('Time','Igihe','Durée'),mn(m))+R(T('Price','Igiciro','Prix'),T(v.p+' RWF a minute','RWF '+v.p+' ku munota',v.p+' RWF la minute'))+R(T('Fare','Amafaranga y’urugendo','Tarif'),fmt(f)+' RWF')+R(T('Paid from','Yishyurwa kuri','Payé depuis'),'itunda Pay')+R(T('Balance after','Asigaye','Solde après'),fmt(S.pay-f)+' RWF'),T('Keep riding','Komeza','Continuer'),T('Pay '+fmt(f)+' RWF','Ishyura RWF '+fmt(f),'Payer '+fmt(f)+' RWF'),'bkrEnd()')};
window.bkrEnd=()=>{const r=S.bkr;if(!r)return;const v=VH[r.v],m=mins(),f=fare();S.pay-=f;S.bkh.unshift({v:v.k,m,f});S.bkav[r.v]++;S.bkr=null;
 addAct('bus',T('Bike rental','Gukodesha igare','Location de vélo')+' · '+vn(r.v)+', '+mn(m),'Paid',-f,'Paid');render('fade-none');
 $('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="g3" style="font-size:56px;line-height:1;margin-bottom:10px">\u2705</div><div class="h1" style="font-size:22px;line-height:30px">'+T('Ride ended','Urugendo rurangiye','Course terminée')+'</div><div class="mu" style="font-size:15px;margin:8px 0 8px;line-height:22px">'+vn(r.v)+', '+mn(m)+'. '+T(fmt(f)+' RWF paid from itunda Pay.','RWF '+fmt(f)+' yishyuwe kuri itunda Pay.',fmt(f)+' RWF payés depuis itunda Pay.')+'</div><div style="font-weight:800;margin-bottom:24px">'+T('itunda Pay balance now '+fmt(S.pay)+' RWF','Asigaye kuri itunda Pay: RWF '+fmt(S.pay),'Solde itunda Pay : '+fmt(S.pay)+' RWF')+'</div><button class="btn" onclick="closeSheet()">OK</button></div>';
 if(typeof focusSheet==='function')focusSheet()};
setInterval(()=>{if(!S.bkr)return;const t=document.getElementById('bkT2'),f=document.getElementById('bkF2'),w=document.getElementById('bkW2');if(!t||!f)return;t.textContent=clock();f.textContent=fareTxt();if(w){const h=warn();if(w.innerHTML!==h)w.innerHTML=h}},1000);
document.title='itunda, clickable prototype v304';
})();
/* v304: Bike rental. Before: the page from v206 worked only in English; in French and Kinyarwanda it fell back to the old plain card. One screen held the price list, "How it works", the balance warning and Recent rides all at once, always; the nearest station had no count of bikes, so you could unlock a scooter that was not there; if itunda Pay was too low you only got a red line and a greyed button, with no way to add money; and during a ride nothing told you the balance was running out (the fare just stopped at your balance). Now: the same flow in English, French and Kinyarwanda; "How it works" shows only until you have finished a first ride, then "Recent rides" takes its place; each choice shows how many are here (6 bikes, 3 e-scooters at Kimironko Market), one is taken when you unlock and returned when you end the ride, and a choice with none left shows "None here right now" and the button stays off; the balance line says "Paid from itunda Pay · X RWF" and, when it is too low, offers "Add money" (the same sheet as Pay) beside the line; during a ride, when the balance covers 5 minutes or fewer, a red line says how many minutes are left, or that the balance is used up, with "Add money". Unlock review, code, end-ride review, receipt and the Activity entry follow the language. fr is new copy and rw is new copy that needs native review, especially "Gukodesha igare", "Rangiza urugendo", "Wongere uyifunge" and "Simbuka iminota 10". Not in this version: choosing another station, a map of nearby bikes, and a "ride in progress" hint outside this page. */
</script>
<script>
/* v305 Moto-Taxi ownership: one question per page */
{const t3=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e;
const fm=n=>fmt(Math.round(n)),esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const SC=[1500000,2000000,2500000,3000000],DP=[30,40,50],MS=[6,12,18],TM=[24,36,48],INC=[5000,8000,12000,15000],RATE=14,PMIN=1000000,PMAX=5000000,DAYS=26,N=4;
const short=v=>v>=1e6?(v/1e6)+'M':(v/1e3)+'K';
const M=()=>S.mo;
S.moStep=S.moStep||0;
const calc=p=>{const dn=Math.round(p.a*p.dp/100),loan=p.a-dn,i=RATE/1200,mo=Math.round(loan*i/(1-Math.pow(1+i,-p.n))),sv=Math.round(dn/p.ms/1000)*1000||Math.round(dn/p.ms);return{dn,loan,mo,tot:mo*p.n,int:mo*p.n-loan,sv}};
const okP=()=>M().a>=PMIN&&M().a<=PMAX;
const perr=()=>{const a=M().a;return !a?'':a<PMIN?t3('Minimum is '+fm(PMIN)+' RWF','Nibura ni RWF '+fm(PMIN),'Minimum : '+fm(PMIN)+' RWF'):a>PMAX?t3('Maximum is '+fm(PMAX)+' RWF','Ntarenza RWF '+fm(PMAX),'Maximum : '+fm(PMAX)+' RWF'):''};
const title=()=>t3('Moto-Taxi ownership','Kugira moto-taxi yawe','Devenir propriétaire de moto-taxi');
const chip=(on,fn,l,al)=>`<button class="chip" aria-pressed="${on}" ${al?`aria-label="${al}" `:''}onclick="${fn}" style="min-width:64px;height:44px;border-radius:22px;border:0;padding:0 16px;font-size:15px;font-weight:800;background:${on?'var(--tx)':'var(--chip)'};color:${on?'var(--bg)':'var(--tx)'}">${l}</button>`;
const grp=(h,l)=>`<div style="display:flex;gap:10px;flex-wrap:wrap;padding:14px 24px 0" role="group" ${l?`aria-label="${l}"`:''}>${h}</div>`;
const rw=(a,v,b)=>`<div style="margin:10px 24px 0;display:flex;justify-content:space-between;gap:12px;font-size:15px"><span class="mu">${a}</span><b style="text-align:right;${b?'color:var(--tintfg)':''}">${v}</b></div>`;
const sub=t=>`<div class="mu" style="font-size:15px;line-height:22px;margin-top:8px">${t}</div>`;
const mo=n=>n+' '+t3('months','mezi','mois');
const hdr=()=>`<div class="bar"><button class="ib" aria-label="Back" onclick="wzBack()">${ic('back',24)}</button><b>${title()}</b></div>`;
const cta=(h,dis,fn,id)=>`<div style="height:100px"></div><div class="cta"><button ${id?`id="${id}" `:''}class="btn" style="white-space:nowrap" ${dis?'disabled':''} onclick="${fn}">${h}</button></div>`;
const prog=s=>`<div style="padding:16px 24px 0"><div class="sm mu" style="font-weight:700">${t3('Step '+s+' of '+N,'Intambwe '+s+' kuri '+N,'Étape '+s+' sur '+N)}</div><div style="height:4px;border-radius:2px;background:var(--chip);margin-top:8px;overflow:hidden" role="progressbar" aria-valuenow="${s}" aria-valuemin="1" aria-valuemax="${N}"><div style="height:100%;width:${s*100/N}%;background:var(--lk);transition:width .3s"></div></div></div>`;
const ctx=()=>`<div class="sm mu" style="padding:12px 24px 0">${t3('Motorbike','Moto','Moto')} ${fm(M().a)} RWF</div>`;
const head=(s,h,t)=>`${prog(s)}<div style="padding:18px 24px 0"><div class="h1">${h}</div>${t?sub(t):''}</div>`;
const mine=()=>S.goal&&S.goal.moto,other=()=>S.goal&&!S.goal.moto;
const intro=()=>{const st=(n,t)=>`<div style="display:flex;gap:12px;align-items:center;padding:8px 24px 0"><div style="width:28px;height:28px;border-radius:14px;background:var(--chip);display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:800;flex:none">${n}</div><div style="font-size:16px;line-height:24px">${t}</div></div>`;
 const o=other();
 return `<div style="padding:22px 24px 0"><div style="width:72px;height:72px;border-radius:36px;background:var(--tint);display:flex;align-items:center;justify-content:center;font-size:36px">🏍️</div><div class="h1" style="margin-top:16px">${title()}</div>${sub(t3('Save the down payment, then turn the rest into a loan.','Bika amafaranga y’ibanze, hanyuma isigaye ibe inguzanyo.','Épargnez l’apport, puis transformez le reste en prêt.'))}</div>
${o?`<div style="margin:18px 24px 0;padding:14px 16px;border-radius:16px;background:var(--chip);font-size:14px;line-height:20px">${t3('You already have a savings goal: ','Usanzwe ufite intego yo kubika: ','Vous avez déjà un objectif d’épargne : ')}<b>${esc(S.goal.n)}</b>. ${t3('Finish it or delete it, then come back to start your motorbike goal.','Yirangize cyangwa uyisibe, hanyuma ugaruke.','Terminez-le ou supprimez-le, puis revenez.')}</div>`
 :`<div style="padding-top:18px">${st(1,t3('Save your down payment','Bika amafaranga y’ibanze','Épargnez votre apport'))}${st(2,t3('Apply for the loan','Saba inguzanyo','Demandez le prêt'))}${st(3,t3('Repay a little each month','Ishyura gake buri kwezi','Remboursez un peu chaque mois'))}</div>
<div style="padding:24px 24px 0;font-size:16px;font-weight:800">${t3('Before the loan opens','Mbere y’uko inguzanyo ifungurwa','Avant l’ouverture du prêt')}</div><div style="padding:8px 24px 0;font-size:15px;line-height:24px"><div>✓ ${t3('Valid driving licence','Uruhushya rwo gutwara rukora','Permis de conduire valide')}</div><div>✓ ${t3('Moto-taxi permit','Uruhushya rwa moto-taxi','Permis moto-taxi')}</div></div>`}
<div class="pad fine" style="padding-top:14px">${t3('Sample terms for this prototype. No real loan is made.','Amabwiriza y’icyitegererezo. Nta nguzanyo nyayo itangwa.','Conditions d’exemple pour ce prototype. Aucun vrai prêt n’est accordé.')}</div>
${cta(o?t3('Open my savings goal','Fungura intego yanjye','Ouvrir mon objectif'):t3('Plan my motorbike','Tegura moto yanjye','Planifier ma moto'),0,o?'moOpenGoal()':'wzGo()')}`};
const s1=()=>`${head(1,t3('How much is the motorbike?','Moto igura angahe?','Combien coûte la moto ?'))}
<div style="padding:12px 24px 0"><div style="display:flex;align-items:baseline;gap:8px;border-bottom:2px solid var(--ln)"><input id="wzP" inputmode="numeric" autocomplete="off" placeholder="0" value="${M().a?fmt(M().a):''}" oninput="wzType(this)" aria-describedby="wzE" style="flex:1;min-width:0;border:0;background:none;color:var(--tx);font:inherit;font-size:28px;font-weight:800;padding:6px 0;outline:0;border-radius:0"><span class="mu" style="font-weight:700">RWF</span></div><div id="wzE" role="alert" class="sm" style="min-height:20px;margin-top:6px;color:var(--er);font-weight:700">${perr()}</div></div>
${grp(SC.map(v=>chip(M().a===v,`wzSet('a',${v})`,short(v),fm(v)+' RWF')).join(''),t3('Price shortcuts','Ibiciro byihuse','Raccourcis de prix'))}
<div class="pad sm mu" style="padding-top:14px">${t3('Between '+fm(PMIN)+' and '+fm(PMAX)+' RWF.','Hagati ya RWF '+fm(PMIN)+' na '+fm(PMAX)+'.','Entre '+fm(PMIN)+' et '+fm(PMAX)+' RWF.')}</div>
${cta(t3('Next','Komeza','Suivant'),!okP(),'wzGo()','wzB')}`;
const s2=()=>{const p=M(),q=calc(p);return `${head(2,t3('How much will you put down first?','Uzabanza gutanga angahe?','Quel apport versez-vous d’abord ?'),t3('A bigger down payment means a smaller loan.','Ayo utanze menshi, inguzanyo iba nto.','Plus l’apport est grand, plus le prêt est petit.'))}${ctx()}
${grp(DP.map(v=>chip(p.dp===v,`wzSet('dp',${v})`,v+'%')).join(''),t3('Down payment','Amafaranga y’ibanze','Apport'))}
<div style="padding:22px 24px 0;font-size:16px;font-weight:800">${t3('Save it in','Uyabike mu','Épargner en')}</div>${grp(MS.map(v=>chip(p.ms===v,`wzSet('ms',${v})`,mo(v))).join(''))}
<div style="padding-top:8px">${rw(t3('Down payment to save','Ayo ukwiye kubika','Apport à épargner'),fm(q.dn)+' RWF',1)}${rw(t3('About each month','Nka buri kwezi','Environ par mois'),fm(q.sv)+' RWF')}</div>
${cta(t3('Next','Komeza','Suivant'),0,'wzGo()')}`};
const s3=()=>{const p=M(),q=calc(p);return `${head(3,t3('How long will you repay the loan?','Inguzanyo uzayishyura mu gihe kingana iki?','Sur combien de temps remboursez-vous le prêt ?'))}${ctx()}
${grp(TM.map(v=>chip(p.n===v,`wzSet('n',${v})`,mo(v))).join(''),t3('Repay over','Kwishyura mu','Remboursement sur'))}
<div style="padding-top:8px">${rw(t3('Loan amount','Inguzanyo','Montant du prêt'),fm(q.loan)+' RWF ('+(100-p.dp)+'%)')}${rw(t3('Monthly loan payment','Ishyura buri kwezi','Mensualité du prêt'),fm(q.mo)+' RWF',1)}${rw(t3('Interest in total','Inyungu yose','Intérêts au total'),fm(q.int)+' RWF')}${rw(t3('Total to repay','Ugomba kwishyura yose','Total à rembourser'),fm(q.tot)+' RWF')}${rw(t3('Rate','Inyungu','Taux'),RATE+t3('% a year','% ku mwaka',' % par an'))}</div>
<div class="pad sm mu" style="padding-top:12px;line-height:20px">${t3('The loan opens when your down payment is saved.','Inguzanyo ifungurwa umaze kubika amafaranga y’ibanze.','Le prêt s’ouvre quand votre apport est épargné.')}</div>
${cta(t3('Next','Komeza','Suivant'),0,'wzGo()')}`};
const s4=()=>{const p=M(),q=calc(p),mi=p.inc*DAYS,a1=mi?Math.round(q.sv*100/mi):0,a2=mi?Math.round(q.mo*100/mi):0;
 const tag=s=>s<=30?[t3('Comfortable','Birashoboka','Confortable'),'var(--ok)']:s<=45?[t3('Tight','Biragoye','Serré'),'var(--mu)']:[t3('High','Biri hejuru','Élevé'),'var(--er)'];const t1=tag(a1),t2=tag(a2);
 return `${head(4,t3('Can you afford it?','Birashoboka?','Est-ce abordable ?'),t3('Tap what you expect to earn each day. This is your own estimate, not a promise.','Kanda ibyo utekereza kwinjiza buri munsi. Ni uko ubitekereza, ntibivuze ko bizaba.','Touchez ce que vous comptez gagner par jour. C’est votre estimation, pas une promesse.'))}
${grp(INC.map(v=>chip(p.inc===v,`wzSet('inc',${v})`,fm(v))).join(''),t3('Daily earnings','Ibyo winjiza ku munsi','Gains par jour'))}
<div style="margin:18px 24px 0;padding:14px 16px;border-radius:16px;background:var(--chip);font-size:15px;line-height:22px" aria-live="polite"><div style="display:flex;justify-content:space-between;gap:12px"><span>${t3('Saving ','Kubika ','Épargne ')}${fm(q.sv)} RWF</span><b style="color:${t1[1]}">${a1}% · ${t1[0]}</b></div><div style="display:flex;justify-content:space-between;gap:12px;margin-top:4px"><span>${t3('Loan payment ','Kwishyura ','Mensualité ')}${fm(q.mo)} RWF</span><b style="color:${t2[1]}">${a2}% · ${t2[0]}</b></div><div class="sm mu" style="margin-top:8px">${t3('Share of about '+fm(mi)+' RWF a month ('+DAYS+' working days).','Ku nsimbi nka '+fm(mi)+' ku kwezi (iminsi '+DAYS+' y’akazi).','Part d’environ '+fm(mi)+' RWF par mois ('+DAYS+' jours de travail).')}</div></div>
${cta(t3('Start saving '+fm(q.dn)+' RWF','Tangira kubika RWF '+fm(q.dn),'Commencer à épargner '+fm(q.dn)+' RWF'),0,'moReview()')}`};
const _s=screens.svc;
screens.svc=function(){if(S.svk!=='moto'||mine())return _s.apply(this,arguments);
 const st=other()?0:S.moStep;
 return (st===0?`<div class="bar"><button class="ib" aria-label="Back" onclick="back()">${ic('back',24)}</button><b>${title()}</b></div>`:hdr())+[intro,s1,s2,s3,s4][st]()};
window.wzGo=()=>{if(S.moStep===1&&!okP())return;S.moStep=Math.min(N,S.moStep+1);render('fade-none')};
window.wzBack=()=>{if(S.moStep>0){S.moStep--;render('fade-none')}else back()};
window.wzSet=(f,v)=>{M()[f]=v;S.moMs=M().ms;render('fade-none')};
window.wzType=el=>{const v=el.value.replace(/\D/g,'').slice(0,8);M().a=v?Number(v):0;el.value=v?fmt(v):'';const e=document.getElementById('wzE'),b=document.getElementById('wzB');if(e)e.textContent=perr();el.setAttribute('aria-invalid',perr()?'true':'false');if(b)b.disabled=!okP();document.querySelectorAll('.chip[aria-label$=" RWF"]').forEach(c=>{const on=Number(c.getAttribute('aria-label').replace(/\D/g,''))===M().a;c.setAttribute('aria-pressed',on);c.style.background=on?'var(--tx)':'var(--chip)';c.style.color=on?'var(--bg)':'var(--tx)'})};
const _o=window.openSvc;window.openSvc=function(k){if(k==='moto')S.moStep=0;return _o.apply(this,arguments)};
document.title='itunda, clickable prototype v305';
}
/* v305: Moto-Taxi ownership. Before: the first page asked for everything at once: price, shortcuts, down payment, save-in months, down payment to save, repay months, five loan rows, "Can you afford it?" with earnings, the result box, "Before the loan opens" and the small print, in one long scroll; with another savings goal open you still filled in the whole form and then could not start. Now one question per page, with "Step 2 of 4" and a bar: an intro (three plain steps, what you need, "Plan my motorbike"); 1 How much is the motorbike? (typed price or shortcuts, error under it, Next off until it is 1,000,000 to 5,000,000 RWF); 2 How much will you put down first? (30 / 40 / 50%, save in 6 / 12 / 18 months, down payment to save and about each month); 3 How long will you repay the loan? (24 / 36 / 48 months, loan amount, monthly payment, interest, total, rate); 4 Can you afford it? (daily earnings, share of a month, Comfortable / Tight / High) with "Start saving X RWF", which opens the same review as before. Back goes to the previous question, and from the intro leaves the page; the price and choices are kept. With another savings goal open the page now shows only the intro, the note about that goal and "Open my savings goal". Once the goal exists the page (progress, plan, Save 10,000 / 50,000, Apply for your loan, status) is unchanged. English, French and Kinyarwanda; the new copy in fr is new and in rw needs native review, especially "Tegura moto yanjye", "Uzabanza gutanga angahe?" and "Inguzanyo uzayishyura mu gihe kingana iki?". Not in this version: choosing the bike model, and saving the plan before the goal is created. */
</script>
<script>
/* v306 Student loan */
{const t3=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e;
const fm=n=>fmt(Math.round(n)),esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const AMIN=200000,AMAX=3000000,SCS=[500000,1000000,2000000,3000000],YRS=[1,2,3,4],TMS=[12,24,36],RATES=[11,12],N=5;
const short=v=>v>=1e6?v/1e6+'M':v/1e3+'K';
S.apps=S.apps||{};S.stu=S.stu||{lv:0,uni:'',yrs:2,a:1000000,n:24,letter:''};S.stuStep=0;
const D=()=>S.stu,rate=()=>RATES[D().lv];
const calc=()=>{const p=D().a,n=D().n,i=rate()/1200,mo=Math.round(p*i/(1-Math.pow(1+i,-n)));return{mo,tot:mo*n,int:mo*n-p}};
const aerr=()=>{const a=D().a;return !a?'':a<AMIN?t3('Minimum is '+fm(AMIN)+' RWF','Nibura ni RWF '+fm(AMIN),'Minimum : '+fm(AMIN)+' RWF'):a>AMAX?t3('Maximum is '+fm(AMAX)+' RWF','Ntarenza RWF '+fm(AMAX),'Maximum : '+fm(AMAX)+' RWF'):''};
const aOk=()=>D().a>=AMIN&&D().a<=AMAX,uOk=()=>(D().uni||'').trim().length>=3;
const title=()=>t3('Student loan','Inguzanyo y’abanyeshuri','Prêt étudiant');
const lvName=i=>[t3('Undergraduate','Kaminuza (icyiciro cya mbere)','Premier cycle (licence)'),t3('Postgraduate','Nyuma ya kaminuza (Master)','Master ou plus')][i];
const yr=n=>t3(n+(n>1?' years':' year'),'imyaka '+n,n+(n>1?' ans':' an'));
const mo=n=>n+' '+t3('months','mezi','mois');
const locd=()=>S.lang==='fr'?'fr-FR':'en-GB';
const firstPay=(ts,y)=>{const d=new Date(ts);d.setFullYear(d.getFullYear()+y);d.setMonth(d.getMonth()+1);return d.toLocaleDateString(locd(),{month:'long',year:'numeric'})};
const chip=(on,fn,l,al)=>`<button class="chip" aria-pressed="${on}" ${al?`aria-label="${al}" `:''}onclick="${fn}" style="min-width:64px;height:44px;border-radius:22px;border:0;padding:0 16px;font-size:15px;font-weight:800;background:${on?'var(--tx)':'var(--chip)'};color:${on?'var(--bg)':'var(--tx)'}">${l}</button>`;
const grp=(h,l)=>`<div style="display:flex;gap:10px;flex-wrap:wrap;padding:14px 24px 0" role="group" ${l?`aria-label="${l}"`:''}>${h}</div>`;
const lab=t=>`<div style="padding:22px 24px 0;font-size:16px;font-weight:800">${t}</div>`;
const rw=(a,v,b)=>`<div style="margin:10px 24px 0;display:flex;justify-content:space-between;gap:12px;font-size:15px"><span class="mu">${a}</span><b style="text-align:right;${b?'color:var(--tintfg)':''}">${v}</b></div>`;
const R=(a,v)=>`<div style="display:flex;justify-content:space-between;gap:12px;min-height:40px;align-items:center;font-size:15px"><span class="mu">${a}</span><b style="text-align:right">${v}</b></div>`;
const sub=t=>`<div class="mu" style="font-size:15px;line-height:22px;margin-top:8px">${t}</div>`;
const fine=()=>`<div class="pad fine" style="padding-top:14px">${t3('Sample terms for this prototype. No real loan is made.','Amabwiriza y’icyitegererezo. Nta nguzanyo nyayo itangwa.','Conditions d’exemple pour ce prototype. Aucun vrai prêt n’est accordé.')}</div>`;
const lay2=h=>{$('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet">'+h+'</div>';if(typeof focusSheet==='function')focusSheet()};
const cta=(h,dis,fn,id,sec)=>`<div style="height:100px"></div><div class="cta"><button ${id?`id="${id}" `:''}class="btn${sec?' sec2':''}" style="white-space:nowrap" ${dis?'disabled':''} onclick="${fn}">${h}</button></div>`;
const hdr=(back)=>`<div class="bar"><button class="ib" aria-label="Back" onclick="${back}">${ic('back',24)}</button><b>${title()}</b></div>`;
const prog=s=>`<div style="padding:16px 24px 0"><div class="sm mu" style="font-weight:700">${t3('Step '+s+' of '+N,'Intambwe '+s+' kuri '+N,'Étape '+s+' sur '+N)}</div><div style="height:4px;border-radius:2px;background:var(--chip);margin-top:8px;overflow:hidden" role="progressbar" aria-valuenow="${s}" aria-valuemin="1" aria-valuemax="${N}"><div style="height:100%;width:${s*100/N}%;background:var(--lk);transition:width .3s"></div></div></div>`;
const head=(s,h,t)=>`${prog(s)}<div style="padding:18px 24px 0"><div class="h1">${h}</div>${t?sub(t):''}</div>`;
const intro=()=>{const st=(n,t)=>`<div style="display:flex;gap:12px;align-items:center;padding:8px 24px 0"><div style="width:28px;height:28px;border-radius:14px;background:var(--chip);display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:800;flex:none">${n}</div><div style="font-size:16px;line-height:24px">${t}</div></div>`;
 return `<div style="padding:22px 24px 0"><div style="width:72px;height:72px;border-radius:36px;background:var(--tint);display:flex;align-items:center;justify-content:center;font-size:36px">🎓</div><div class="h1" style="margin-top:16px">${title()}</div>${sub(t3('A BRD higher-education loan: 11% a year for undergraduate, 12% for postgraduate. You start repaying after you graduate.','Inguzanyo ya BRD y’amashuri makuru: 11% ku mwaka kuri kaminuza, 12% nyuma ya kaminuza. Utangira kwishyura umaze kurangiza.','Un prêt BRD pour les études supérieures : 11 % par an en premier cycle, 12 % en master. Vous remboursez après l’obtention du diplôme.'))}</div>
<div style="padding-top:18px">${st(1,t3('Tell us about your studies','Tubwire iby’amasomo yawe','Parlez-nous de vos études'))}${st(2,t3('Choose the amount and how long to repay','Hitamo amafaranga n’igihe cyo kwishyura','Choisissez le montant et la durée'))}${st(3,t3('Upload your admission letter','Ohereza ibaruwa ikwemerera kwiga','Envoyez votre lettre d’admission'))}</div>
${lab(t3('Before you apply','Mbere yo gusaba','Avant de demander'))}<div style="padding:8px 24px 0;font-size:15px;line-height:24px">✓ ${t3('Your admission letter (photo or PDF)','Ibaruwa ikwemerera kwiga (ifoto cyangwa PDF)','Votre lettre d’admission (photo ou PDF)')}</div>${fine()}
${cta(t3('Start my application','Tangira gusaba','Commencer ma demande'),0,'stuGo()')}`};
const s1=()=>`${head(1,t3('What are you studying?','Wiga iki?','Quel est votre niveau ?'))}
<div role="radiogroup" style="padding-top:14px">${[0,1].map(i=>`<div class="row tap" role="radio" aria-checked="${D().lv===i}" tabindex="0" onclick="stuSet('lv',${i})" style="padding:14px 24px;${D().lv===i?'background:var(--tint)':''}"><div style="flex:1"><div class="t">${lvName(i)}</div><div class="s">${t3(RATES[i]+'% a year',RATES[i]+'% ku mwaka',RATES[i]+' % par an')}</div></div><div aria-hidden="true" style="font-size:20px">${D().lv===i?'●':'○'}</div></div>`).join('')}</div>${cta(t3('Next','Komeza','Suivant'),0,'stuGo()')}`;
const s2=()=>`${head(2,t3('Where do you study?','Wiga he?','Où étudiez-vous ?'),t3('Type the name of your university or college.','Andika izina rya kaminuza cyangwa ishuri ryawe.','Saisissez le nom de votre université ou école.'))}
<div style="padding:16px 24px 0"><input id="stuU" value="${esc(D().uni)}" oninput="stuUni(this)" autocomplete="off" placeholder="${t3('e.g. University of Rwanda','urugero: University of Rwanda','ex. University of Rwanda')}" style="width:100%;box-sizing:border-box;height:52px;border:0;border-radius:14px;background:var(--chip);color:var(--tx);padding:0 16px;font:inherit;font-size:17px"><div id="stuUH" class="sm mu" style="margin-top:8px;min-height:20px">${D().uni&&!uOk()?t3('Keep typing, at least 3 letters.','Komeza wandike, nibura inyuguti 3.','Continuez, au moins 3 lettres.'):''}</div></div>${cta(t3('Next','Komeza','Suivant'),!uOk(),'stuGo()','stuB')}`;
const s3=()=>`${head(3,t3('How much do you need?','Ukeneye angahe?','De quel montant avez-vous besoin ?'))}
<div style="padding:12px 24px 0"><div style="display:flex;align-items:baseline;gap:8px;border-bottom:2px solid var(--ln)"><input id="stuA" inputmode="numeric" autocomplete="off" placeholder="0" value="${D().a?fmt(D().a):''}" oninput="stuType(this)" aria-describedby="stuE" style="flex:1;min-width:0;border:0;background:none;color:var(--tx);font:inherit;font-size:28px;font-weight:800;padding:6px 0;outline:0;border-radius:0"><span class="mu" style="font-weight:700">RWF</span></div><div id="stuE" role="alert" class="sm" style="min-height:20px;margin-top:6px;color:var(--er);font-weight:700">${aerr()}</div></div>
${grp(SCS.map(v=>chip(D().a===v,`stuSet('a',${v})`,short(v),fm(v)+' RWF')).join(''),t3('Amount shortcuts','Amafaranga yihuse','Raccourcis de montant'))}
<div class="pad sm mu" style="padding-top:14px">${t3('Between '+fm(AMIN)+' and '+fm(AMAX)+' RWF.','Hagati ya RWF '+fm(AMIN)+' na '+fm(AMAX)+'.','Entre '+fm(AMIN)+' et '+fm(AMAX)+' RWF.')}</div>${cta(t3('Next','Komeza','Suivant'),!aOk(),'stuGo()','stuB')}`;
const s4=()=>{const q=calc(),d=D();return `${head(4,t3('When do you finish, and how long will you repay?','Urarangiza ryari, kandi uzishyura mu gihe kingana iki?','Quand finissez-vous, et sur combien de temps remboursez-vous ?'),t3('You pay nothing while you study.','Nta kwishyura mu gihe wiga.','Vous ne payez rien pendant vos études.'))}
${lab(t3('Years until you graduate','Imyaka isigaye ngo urangize','Années avant le diplôme'))}${grp(YRS.map(v=>chip(d.yrs===v,`stuSet('yrs',${v})`,yr(v))).join(''))}
${lab(t3('Repay over','Kwishyura mu','Rembourser sur'))}${grp(TMS.map(v=>chip(d.n===v,`stuSet('n',${v})`,mo(v))).join(''))}
<div style="padding-top:8px">${rw(t3('Monthly payment (after you graduate)','Kwishyura buri kwezi (umaze kurangiza)','Mensualité (après le diplôme)'),fm(q.mo)+' RWF',1)}${rw(t3('Interest ('+rate()+'% a year)','Inyungu ('+rate()+'% ku mwaka)','Intérêts ('+rate()+' % par an)'),fm(q.int)+' RWF')}${rw(t3('Total to repay','Ugomba kwishyura yose','Total à rembourser'),fm(q.tot)+' RWF')}${rw(t3('First payment','Kwishyura bwa mbere','Premier paiement'),firstPay(Date.now(),d.yrs))}</div>
${cta(t3('Next','Komeza','Suivant'),0,'stuGo()')}`};
const s5=()=>{const L=D().letter;return `${head(5,t3('Upload your admission letter','Ohereza ibaruwa ikwemerera kwiga','Envoyez votre lettre d’admission'),t3('A photo or a PDF. It shows your school has admitted you.','Ifoto cyangwa PDF. Yerekana ko ishuri ryakwemeye.','Une photo ou un PDF. Elle prouve que votre école vous a admis.'))}
<div style="padding:18px 24px 0">${L?`<div style="display:flex;align-items:center;gap:12px;padding:14px 16px;border-radius:16px;background:var(--chip)"><div style="font-size:24px">📄</div><div style="flex:1;min-width:0"><div style="font-weight:800;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${esc(L)}</div><div class="sm mu">${t3('Sample file for this prototype','Idosiye y’icyitegererezo','Fichier d’exemple pour ce prototype')}</div></div><button class="chip" onclick="stuLetter(0)">${t3('Remove','Kuraho','Retirer')}</button></div>`
 :`<button class="btn sec2" style="white-space:nowrap" onclick="stuLetter(1)">${t3('Choose a photo or PDF','Hitamo ifoto cyangwa PDF','Choisir une photo ou un PDF')}</button>`}</div>
${cta(t3('Review application','Subiramo ubusabe','Vérifier la demande'),!L,'stuReview()','stuB')}`};
const form=()=>{const st=S.stuStep;return (st===0?hdr('back()'):hdr('stuBack()'))+[intro,s1,s2,s3,s4,s5][st]()};
const tracker=()=>{const a=S.apps.student,st=a.stage,names=[t3('Submitted','Cyoherejwe','Envoyée'),t3('Admission letter check','Isuzuma ry’ibaruwa yo kwemererwa','Vérification de la lettre'),t3('Approved','Cyemejwe','Approuvée'),t3('Funds sent to itunda Pay','Amafaranga yoherejwe muri itunda Pay','Fonds envoyés sur itunda Pay')];
 const desc=[t3('We received your application and your admission letter.','Twakiriye ubusabe bwawe n’ibaruwa yawe.','Nous avons reçu votre demande et votre lettre.'),t3('We check that your school has admitted you.','Turasuzuma ko ishuri ryakwemeye.','Nous vérifions que votre école vous a admis.'),t3('Your loan is approved. Funds are on the way.','Inguzanyo yawe yemejwe. Amafaranga araje.','Votre prêt est approuvé. Les fonds arrivent.'),t3('The money is in your itunda Pay.','Amafaranga ari muri itunda Pay yawe.','L’argent est sur votre itunda Pay.')];
 const tl=names.map((n,i)=>`<div style="display:flex;gap:14px;align-items:flex-start;padding:10px 0"><div style="width:26px;height:26px;border-radius:13px;flex:none;display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:800;background:${i<=st?'var(--lk)':'var(--chip)'};color:${i<=st?'#fff':'var(--mu)'}" ${i===st?'aria-current="step"':''}>${i<st||st===3&&i===3?'✓':i+1}</div><div style="min-width:0"><div style="font-weight:${i===st?800:600};color:${i<=st?'var(--tx)':'var(--mu)'}">${n}</div>${i===st?`<div class="sm mu" style="margin-top:2px;line-height:19px">${desc[i]}</div>`:''}</div></div>`).join('');
 return hdr('back()')+`<div style="padding:22px 24px 0"><div style="width:72px;height:72px;border-radius:36px;background:var(--tint);display:flex;align-items:center;justify-content:center;font-size:36px">🎓</div><div class="h1" style="margin-top:16px">${title()}</div></div>
<div style="margin:18px 24px 0;padding:14px 16px;border-radius:16px;background:var(--tint);color:var(--tintfg);font-size:14px;line-height:20px"><b>${t3('Application sent.','Ubusabe bwoherejwe.','Demande envoyée.')}</b> ${t3('Reference ','Nimero ','Référence ')}${a.ref} · ${fm(a.a)} RWF</div><div style="padding:14px 24px 0">${tl}</div>
${lab(t3('Your loan','Inguzanyo yawe','Votre prêt'))}${rw(t3('Amount','Amafaranga','Montant'),fm(a.a)+' RWF')}${rw(t3('Level','Icyiciro','Niveau'),lvName(a.lv))}${rw(t3('School','Ishuri','École'),esc(a.uni))}${rw(t3('Repay over','Kwishyura mu','Remboursement sur'),mo(a.n))}${rw(t3('Monthly payment','Kwishyura buri kwezi','Mensualité'),fm(a.mo)+' RWF',1)}${rw(t3('Total to repay','Ugomba kwishyura yose','Total à rembourser'),fm(a.tot)+' RWF')}${rw(t3('First payment','Kwishyura bwa mbere','Premier paiement'),firstPay(a.sent,a.yrs))}
${st<3?`<div class="pad" style="padding-top:18px"><button class="chip" onclick="stuNext()">${t3('Next step (sample)','Intambwe ikurikira (icyitegererezo)','Étape suivante (exemple)')}</button></div>`:''}${fine()}<div style="height:100px"></div>${st<2?`<div class="cta"><button class="btn sec2" style="white-space:nowrap" onclick="stuWithdraw()">${t3('Withdraw application','Kuraho ubusabe','Retirer la demande')}</button></div>`:''}`};
const _s=screens.svc;
screens.svc=function(){if(S.svk!=='student')return _s.apply(this,arguments);return S.apps.student?tracker():form()};
window.stuGo=()=>{const s=S.stuStep;if(s===2&&!uOk())return;if(s===3&&!aOk())return;S.stuStep=Math.min(N,s+1);render('fade-none')};
window.stuBack=()=>{if(S.stuStep>0){S.stuStep--;render('fade-none')}else back()};
window.stuSet=(f,v)=>{D()[f]=v;render('fade-none')};
window.stuUni=el=>{D().uni=el.value.slice(0,60);const b=document.getElementById('stuB'),h=document.getElementById('stuUH');if(b)b.disabled=!uOk();if(h)h.textContent=D().uni&&!uOk()?t3('Keep typing, at least 3 letters.','Komeza wandike, nibura inyuguti 3.','Continuez, au moins 3 lettres.'):''};
window.stuType=el=>{const v=el.value.replace(/\D/g,'').slice(0,7);D().a=v?Number(v):0;el.value=v?fmt(v):'';const e=document.getElementById('stuE'),b=document.getElementById('stuB');if(e)e.textContent=aerr();if(b)b.disabled=!aOk();document.querySelectorAll('.chip[aria-label$=" RWF"]').forEach(c=>{const on=Number(c.getAttribute('aria-label').replace(/\D/g,''))===D().a;c.setAttribute('aria-pressed',on);c.style.background=on?'var(--tx)':'var(--chip)';c.style.color=on?'var(--bg)':'var(--tx)'})};
window.stuLetter=on=>{D().letter=on?'admission-letter.pdf':'';render('fade-none')};
window.stuReview=()=>{if(!D().letter||S.apps.student)return;const d=D(),q=calc();
 lay2(`<div class="h1" style="font-size:22px;line-height:30px;margin-top:4px">${t3('Apply for '+fm(d.a)+' RWF?','Gusaba RWF '+fm(d.a)+'?','Demander '+fm(d.a)+' RWF ?')}</div><div style="margin:12px 0 16px">${R(t3('Level','Icyiciro','Niveau'),lvName(d.lv))}${R(t3('School','Ishuri','École'),esc(d.uni.trim()))}${R(t3('You graduate in','Urangiza mu','Diplôme dans'),yr(d.yrs))}${R(t3('Repay over','Kwishyura mu','Remboursement sur'),mo(d.n))}${R(t3('Monthly payment','Kwishyura buri kwezi','Mensualité'),fm(q.mo)+' RWF')}${R(t3('Interest','Inyungu','Intérêts'),fm(q.int)+' RWF ('+rate()+t3('% a year','% ku mwaka',' % par an')+')')}${R(t3('Total to repay','Ugomba kwishyura yose','Total à rembourser'),fm(q.tot)+' RWF')}${R(t3('Admission letter','Ibaruwa yo kwemererwa','Lettre d’admission'),esc(d.letter))}</div><div class="mu sm" style="margin:-4px 0 16px;line-height:20px">${t3('Next: we check your admission letter. Money is sent to itunda Pay once approved. You can withdraw until it is approved.','Ibikurikira: turasuzuma ibaruwa yawe. Amafaranga yoherezwa muri itunda Pay yemejwe. Ushobora kuyikuraho itaremezwa.','Ensuite : nous vérifions votre lettre. L’argent est envoyé sur itunda Pay après approbation. Vous pouvez retirer la demande avant.')}</div><div style="display:grid;grid-template-columns:1fr 1.8fr;gap:12px"><button class="btn sec2" onclick="closeSheet()">${t3('Cancel','Hagarika','Annuler')}</button><button class="btn" style="white-space:nowrap" onclick="stuSend()">${t3('Send application','Ohereza ubusabe','Envoyer la demande')}</button></div>`)};
window.stuSend=()=>{if(!D().letter||S.apps.student){closeSheet();return}const d=D(),q=calc();S.apps.student={ref:'ITN-'+String(Date.now()).slice(-6),a:d.a,n:d.n,mo:q.mo,tot:q.tot,lv:d.lv,uni:d.uni.trim(),yrs:d.yrs,sent:Date.now(),stage:0};closeSheet();render('fade-none');
 lay2(`<div class="g3" style="font-size:56px;line-height:1;margin-bottom:10px">📨</div><div class="h1" style="font-size:22px;line-height:30px">${t3('Application sent','Ubusabe bwoherejwe','Demande envoyée')}</div><div class="mu" style="font-size:15px;margin:8px 0 24px;line-height:22px">${t3('Reference '+S.apps.student.ref+'. We will check your admission letter.','Nimero '+S.apps.student.ref+'. Turasuzuma ibaruwa yawe.','Référence '+S.apps.student.ref+'. Nous allons vérifier votre lettre.')}</div><button class="btn" onclick="closeSheet()">OK</button>`)};
window.stuNext=()=>{const a=S.apps.student;if(!a||a.stage>=3)return;a.stage++;if(a.stage===3){S.pay+=a.a;if(Array.isArray(S.act))S.act.unshift(['wallet',title()+' · '+a.ref,'Received · Just now',a.a,'Received']);toast('+'+fm(a.a)+' RWF '+t3('added to itunda Pay','yongewe muri itunda Pay','ajoutés à itunda Pay'))}render('fade-none')};
window.stuWithdraw=()=>lay2(`<div class="h1" style="font-size:22px;line-height:30px;margin-top:4px">${t3('Withdraw your application?','Gukuraho ubusabe bwawe?','Retirer votre demande ?')}</div><div class="mu" style="font-size:15px;margin:8px 0 24px;line-height:22px">${t3('We will not review it. You can apply again later.','Ntituzabusuzuma. Ushobora gusaba nanone.','Nous ne l’examinerons pas. Vous pourrez redemander plus tard.')}</div><div style="display:grid;grid-template-columns:1fr 1.8fr;gap:12px"><button class="btn sec2" onclick="closeSheet()">${t3('Keep it','Reka ikomeze','Garder')}</button><button class="btn" style="white-space:nowrap" onclick="stuWithdrawGo()">${t3('Withdraw','Kuraho','Retirer')}</button></div>`);
window.stuWithdrawGo=()=>{delete S.apps.student;S.stuStep=0;S.stu.letter='';closeSheet();render('fade-none');toast(t3('Application withdrawn','Ubusabe bwakuweho','Demande retirée'))};
const _o=window.openSvc;window.openSvc=function(k){if(k==='student')S.stuStep=0;return _o.apply(this,arguments)};
document.title='itunda, clickable prototype v306';
}
/* v306: Student loan. Before: the page was English only (French and Kinyarwanda fell back to a plain card); the first screen held amount shortcuts, level, repay months and the totals; "Apply" said "Upload your admission letter in the next step" but there was no next step: nothing asked for the letter, the school or when you graduate, and after sending the page only said "Application sent". Now one question per page, with "Step 2 of 5" and a bar, after an intro (what it is, three steps, what you need): 1 Level (Undergraduate 11% or Postgraduate 12%); 2 Where do you study? (typed, at least 3 letters); 3 How much do you need? (typed or 500K / 1M / 2M / 3M, 200,000 to 3,000,000 RWF, error under it); 4 When do you finish and how long will you repay? (1 to 4 years to graduate, 12 / 24 / 36 months, monthly payment after you graduate, interest, total, and the month of the first payment); 5 Upload your admission letter (the sample file attaches with one tap and can be removed; Review stays off until it is attached). A review lists everything, then \"Send application\". After sending, the page is a tracker (Submitted, Admission letter check, Approved, Funds sent to itunda Pay) with the loan details and the first payment month, \"Next step (sample)\" (which adds the money to itunda Pay and Activity) and \"Withdraw application\" until it is approved. English, French and Kinyarwanda; fr is new copy and rw is new copy that needs native review, especially \"Kaminuza (icyiciro cya mbere)\", \"Nyuma ya kaminuza (Master)\", \"Wiga he?\" and \"Urarangiza ryari, kandi uzishyura mu gihe kingana iki?\". Not in this version: choosing a real file from the phone, paying the school directly, and a grace-period interest rule. */
</script>
<script>
/* v307 Foreign currency */
{const t3=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e,CODES=['USD','EUR','GBP'],FLAG={USD:'🇺🇸',EUR:'🇪🇺',GBP:'🇬🇧'},RATE={USD:1445,EUR:1680,GBP:1960},MINB=5000,QB=[20000,50000,100000,250000],QG=[10,25,50,100];
const esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const fx=()=>{const x=S.fx;if(!x.d)x.d='buy';if(x.s==null)x.s=0;if(!x.w)x.w={USD:0,EUR:0,GBP:0};if(!x.m)x.m='rwf';if(x.g==null)x.g=100;return x};
const cur=()=>CODES[fx().c]||'USD',d2=n=>(Math.floor(n*100+1e-6)/100).toFixed(2);
const buy=()=>fx().d==='buy',inCur=()=>buy()&&fx().m==='cur';
const calc=()=>{const x=fx(),c=cur(),r=RATE[c],w=x.w[c]||0;let err='',ok=false,pay,get;
 if(buy()){
  if(inCur()){get=Math.floor(x.g*100+1e-6)/100;pay=Math.ceil(Math.round(get*r*100)/100);
   if(!get)err='';else if(pay<MINB)err=t3('Minimum is '+fmt(MINB)+' RWF (about '+d2(MINB/r)+' '+c+')','Nibura ni RWF '+fmt(MINB)+' (hafi '+d2(MINB/r)+' '+c+')','Minimum : '+fmt(MINB)+' RWF (environ '+d2(MINB/r)+' '+c+')');
   else if(pay>S.bank)err=t3('That costs '+fmt(pay)+' RWF. You have '+fmt(S.bank)+' RWF.','Bigura RWF '+fmt(pay)+'. Ufite RWF '+fmt(S.bank)+'.','Cela coûte '+fmt(pay)+' RWF. Vous avez '+fmt(S.bank)+' RWF.');else ok=true}
  else{pay=x.a;get=x.a/r;
   if(!x.a)err='';else if(x.a<MINB)err=t3('Minimum is '+fmt(MINB)+' RWF','Nibura ni RWF '+fmt(MINB),'Minimum : '+fmt(MINB)+' RWF');else if(x.a>S.bank)err=t3('Not enough balance. You have '+fmt(S.bank)+' RWF.','Nta mafaranga ahagije. Ufite RWF '+fmt(S.bank)+'.','Solde insuffisant. Vous avez '+fmt(S.bank)+' RWF.');else ok=true}}
 else{pay=x.s;get=Math.round(x.s*r);
  if(!x.s)err='';else if(x.s<1)err=t3('Minimum is 1.00 '+c,'Nibura ni '+c+' 1.00','Minimum : 1,00 '+c);else if(x.s>w+1e-9)err=t3('Not enough in your '+c+' wallet. You have '+d2(w)+' '+c+'.','Nta mafaranga ahagije muri '+c+'. Ufite '+d2(w)+' '+c+'.','Solde insuffisant. Vous avez '+d2(w)+' '+c+'.');else ok=true}
 return {c,r,w,err,ok,pay,get}};
const quick=()=>buy()?(inCur()?QG.map(n=>[n,String(n),fx().g===n]):QB.map(n=>[n,n/1000+'K',fx().a===n])):[[.25,'25%'],[.5,'50%'],[1,t3('All','Byose','Tout')]].map(([p,l])=>[p,l,Math.abs(fx().s-Math.floor((fx().w[cur()]||0)*p*100)/100)<.005&&fx().s>0]);
const lbl=k=>buy()?(k.ok?(inCur()?t3('Buy '+d2(k.get)+' '+k.c+' for '+fmt(k.pay)+' RWF','Gura '+d2(k.get)+' '+k.c+' kuri RWF '+fmt(k.pay),'Acheter '+d2(k.get)+' '+k.c+' pour '+fmt(k.pay)+' RWF'):t3('Convert '+fmt(k.pay)+' RWF to '+k.c,'Hindura RWF '+fmt(k.pay)+' mu '+k.c,'Convertir '+fmt(k.pay)+' RWF en '+k.c)):t3('Convert to '+k.c,'Hindura mu '+k.c,'Convertir en '+k.c)):(k.ok?t3('Convert '+d2(k.pay)+' '+k.c+' to RWF','Hindura '+k.c+' '+d2(k.pay)+' mu RWF','Convertir '+d2(k.pay)+' '+k.c+' en RWF'):t3('Convert to RWF','Hindura mu RWF','Convertir en RWF'));
const out=k=>buy()?(inCur()?(k.pay?fmt(k.pay)+' RWF':'0 RWF'):(k.pay?d2(k.get)+' '+k.c:'0.00 '+k.c)):(k.pay?fmt(k.get)+' RWF':'0 RWF');
const after=k=>k.ok?t3('itunda Bank after: '+fmt(buy()?S.bank-k.pay:S.bank+k.get)+' RWF','itunda Bank nyuma: RWF '+fmt(buy()?S.bank-k.pay:S.bank+k.get),'itunda Bank après : '+fmt(buy()?S.bank-k.pay:S.bank+k.get)+' RWF'):'';
function fxUpd(){const k=calc(),g=$('#fxg'),e=$('#fxe'),n=$('#fxn'),b=$('#fxb');if(!g)return;
 g.textContent=out(k);e.textContent=k.err;$('#fxi').setAttribute('aria-invalid',k.err?'true':'false');n.textContent=after(k);b.disabled=!k.ok;b.textContent=lbl(k);
 const q=quick();document.querySelectorAll('#fxq button').forEach((el,i)=>{const on=q[i][2];el.classList.toggle('on',on);el.setAttribute('aria-pressed',on?'true':'false')})}
window.fxIn=v=>{const x=fx();
 if(buy()&&!inCur()){x.a=Math.min(999999999,Number(String(v).replace(/\D/g,''))||0);const i=$('#fxi');i.value=x.a?fmt(x.a):''}
 else{let q=String(v).replace(/[^\d.]/g,'');const p=q.split('.');q=p[0].slice(0,9)+(p.length>1?'.'+p[1].slice(0,2):'');if(inCur())x.g=Number(q)||0;else x.s=Number(q)||0;if(q!==String(v))$('#fxi').value=q}
 fxUpd()};
window.fxQ=i=>{const x=fx(),v=quick()[i][0];if(buy()){if(inCur())x.g=v;else x.a=v}else x.s=Math.floor((x.w[cur()]||0)*v*100)/100;render('fade-none')};
window.fxMode=()=>{const x=fx();x.m=x.m==='cur'?'rwf':'cur';render('fade-none')};
const row=(a,v)=>`<div style="display:flex;justify-content:space-between;gap:12px;padding:6px 24px 0;font-size:14px"><span class="mu">${a}</span><span>${v}</span></div>`;
screens.fx=()=>{const x=fx(),k=calc(),c=k.c,b=buy(),ic2=inCur();
 const flagc=CODES.map((cc,i)=>`<button class="${x.c===i?'on':''}" aria-pressed="${x.c===i}" onclick="fxCur(${i})">${FLAG[cc]} ${cc}</button>`).join('');
 const seg=`<div class="cdch" style="margin:16px 24px 0" role="group"><button class="${b?'on':''}" aria-pressed="${b}" onclick="fxDir('buy')">${t3('Buy '+c,'Gura '+c,'Acheter '+c)}</button><button class="${b?'':'on'}" aria-pressed="${!b}" onclick="fxDir('sell')">${t3('Sell '+c,'Gurisha '+c,'Vendre '+c)}</button></div>`;
 const av=b?t3('Available: '+fmt(S.bank)+' RWF','Ahari: RWF '+fmt(S.bank),'Disponible : '+fmt(S.bank)+' RWF'):t3('In your wallet: '+d2(k.w)+' '+c,'Muri wallet: '+d2(k.w)+' '+c,'Dans votre portefeuille : '+d2(k.w)+' '+c);
 const unit=b&&!ic2?'RWF':c,top=b?(ic2?t3('You get','Uhabwa','Vous recevez'):t3('You pay','Wishyura','Vous payez')):t3('You sell','Ugurisha','Vous vendez'),bot=b?(ic2?t3('You pay','Wishyura','Vous payez'):t3('You get','Uhabwa','Vous recevez')):t3('You get','Uhabwa','Vous recevez');
 const val=b?(ic2?(x.g?String(x.g):''):(x.a?fmt(x.a):'')):(x.s?String(x.s):'');
 const mode=b?`<button onclick="fxMode()" style="border:0;background:none;padding:10px 0 0;font:inherit;font-size:14px;font-weight:800;color:var(--lk);text-align:left">${ic2?t3('Enter the amount in RWF','Andika amafaranga muri RWF','Saisir le montant en RWF'):t3('I want an exact amount of '+c,'Nshaka umubare nyawo wa '+c,'Je veux un montant exact en '+c)}</button>`:'';
 const q=quick();
 const held=CODES.filter(cc=>(x.w[cc]||0)>0);
 const wal=held.length?held.map(cc=>{const w=x.w[cc],i=CODES.indexOf(cc);return `<button class="fxw" onclick="fxWal(${i})"><span class="fxf">${FLAG[cc]}</span><span class="nm"><b>${cc}</b><span>${t3('Tap to sell','Kanda ugurishe','Touchez pour vendre')}</span></span><span class="am"><b>${d2(w)} ${cc}</b><span>≈ ${fmt(Math.round(w*RATE[cc]))} RWF</span></span></button>`}).join(''):`<div class="mu" style="padding:0 24px;font-size:15px;line-height:22px">${t3('You hold no foreign currency yet.','Nta mafaranga y’amahanga ufite.','Vous ne détenez pas encore de devises.')}</div>`;
 return `${bar(t3('Foreign currency','Amafaranga y’amahanga','Devises'))}<div class="fxc" role="group" aria-label="${t3('Currency','Ifaranga','Devise')}">${flagc}</div>${seg}
<div class="fxa"><label class="sm mu" for="fxi">${top}</label><div class="fxr"><input class="in" id="fxi" inputmode="${b&&!ic2?'numeric':'decimal'}" autocomplete="off" placeholder="0" value="${val}" oninput="fxIn(this.value)" aria-describedby="fxe" aria-invalid="${!!k.err}"><b>${unit}</b></div><div class="sm mu" style="margin-top:2px">${av}</div>${mode}</div>
<div class="cdch" id="fxq" style="margin:10px 24px 0" role="group" aria-label="${t3('Quick amounts','Umubare uhuse','Montants rapides')}">${q.map(([v,l,on],i)=>`<button class="${on?'on':''}" aria-pressed="${on}" onclick="fxQ(${i})">${l}</button>`).join('')}</div><div class="fxe" id="fxe" role="alert">${k.err}</div>
<div class="fxg"><div class="sm">${bot}</div><b id="fxg">${out(k)}</b></div>
<div style="padding-top:8px">${row(t3('Rate','Igiciro','Taux'),'1 '+c+' = '+fmt(k.r)+' RWF')}${row(t3('Fee','Kiguzi','Frais'),t3('None','Nta kiguzi','Aucun'))}<div class="sm mu" id="fxn" style="padding:6px 24px 0">${after(k)}</div><div class="fine" style="padding:6px 24px 0">${t3('Sample rates for this prototype.','Ibiciro by’icyitegererezo kuri iyi porogaramu.','Taux d’exemple pour ce prototype.')}</div></div>
<div style="padding:22px 24px 8px;font-size:18px;font-weight:800">${t3('Your wallets','Ama wallet yawe','Vos portefeuilles')}</div>${wal}<div style="height:110px"></div>
<div class="cta"><button class="btn" id="fxb" ${k.ok?'':'disabled'} onclick="fxAsk()">${lbl(k)}</button></div>`};
const rw=(a,v)=>`<div style="display:flex;justify-content:space-between;gap:12px;min-height:40px;align-items:center;font-size:15px"><span class="mu">${a}</span><b style="text-align:right">${v}</b></div>`;
window.fxAsk=()=>{const k=calc();if(!k.ok)return;const c=k.c,b=buy();
 const rows=b?rw(t3('You pay','Wishyura','Vous payez'),fmt(k.pay)+' RWF')+rw(t3('You get','Uhabwa','Vous recevez'),d2(k.get)+' '+c)+rw(t3('Rate','Igiciro','Taux'),'1 '+c+' = '+fmt(k.r)+' RWF')+rw(t3('Fee','Kiguzi','Frais'),t3('None','Nta kiguzi','Aucun'))+rw(t3('itunda Bank after','itunda Bank nyuma','itunda Bank après'),fmt(S.bank-k.pay)+' RWF')
 :rw(t3('You sell','Ugurisha','Vous vendez'),d2(k.pay)+' '+c)+rw(t3('You get','Uhabwa','Vous recevez'),fmt(k.get)+' RWF')+rw(t3('Rate','Igiciro','Taux'),'1 '+c+' = '+fmt(k.r)+' RWF')+rw(t3('Fee','Kiguzi','Frais'),t3('None','Nta kiguzi','Aucun'))+rw(t3('Goes to','Bijya muri','Versé sur'),'itunda Bank');
 $('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" role="dialog" aria-modal="true" aria-label="${t3('Review','Suzuma','Vérifier')}"><div class="h1" style="font-size:22px;line-height:30px;margin-top:4px">${b?t3('Convert to '+c+'?','Guhindura mu '+c+'?','Convertir en '+c+' ?'):t3('Sell '+d2(k.pay)+' '+c+'?','Gurisha '+d2(k.pay)+' '+c+'?','Vendre '+d2(k.pay)+' '+c+' ?')}</div><div style="margin:12px 0 20px">${rows}</div><div class="row2" style="display:grid;grid-template-columns:1fr 1.8fr"><button class="btn sec2" onclick="closeSheet()">${t3('Cancel','Reka','Annuler')}</button><button class="btn" style="white-space:nowrap" onclick="fxDo()">${b?t3('Convert','Hindura','Convertir'):t3('Sell','Gurisha','Vendre')}</button></div></div>`;if(typeof focusSheet==='function')focusSheet()};
window.fxDo=()=>{const k=calc();if(!k.ok){closeSheet();return}const x=fx(),c=k.c,b=buy();let tt,bd;
 if(b){S.bank-=k.pay;x.w[c]=(x.w[c]||0)+k.pay/k.r;addAct('cyc','Converted to '+c,'Converted',-k.pay,'Moved');tt=t3('Converted to '+c,'Byahinduwe mu '+c,'Converti en '+c);bd=t3(fmt(k.pay)+' RWF became '+d2(k.get)+' '+c+'. It is in your '+c+' wallet.','RWF '+fmt(k.pay)+' yabaye '+d2(k.get)+' '+c+'. Iri muri wallet yawe ya '+c+'.',fmt(k.pay)+' RWF sont devenus '+d2(k.get)+' '+c+'. Ils sont dans votre portefeuille '+c+'.');x.a=50000;x.g=100}
 else{x.w[c]=Math.max(0,(x.w[c]||0)-k.pay);if(x.w[c]<.005)x.w[c]=0;S.bank+=k.get;addAct('cyc',c+' converted to RWF','Converted',k.get,'Moved');tt=t3(c+' converted to RWF',c+' yahindutse RWF',c+' converti en RWF');bd=t3(d2(k.pay)+' '+c+' became '+fmt(k.get)+' RWF in itunda Bank.',d2(k.pay)+' '+c+' yabaye RWF '+fmt(k.get)+' muri itunda Bank.',d2(k.pay)+' '+c+' sont devenus '+fmt(k.get)+' RWF sur itunda Bank.');x.s=0;x.d=(x.w[c]||0)>0?'sell':'buy'}
 $('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" role="dialog" aria-modal="true" aria-label="${esc(tt)}"><div style="font-size:56px;line-height:1;margin-bottom:10px">💱</div><div class="h1" style="font-size:22px;line-height:30px">${esc(tt)}</div><div class="mu" style="font-size:15px;margin:8px 0 24px;line-height:22px">${esc(bd)}</div><button class="btn" onclick="closeSheet();render('fade-none')">OK</button></div>`;if(typeof focusSheet==='function')focusSheet();render('fade-none')};
/* v312 additions: rate trend, rate alert, wallet total, recent conversions */
const OFF={USD:[-1.1,-.8,-.9,-.4,-.2,-.1,0],EUR:[.7,.5,.2,.3,.1,-.2,0],GBP:[-.4,-.7,-.3,-.1,.2,.1,0]};
const series=c=>OFF[c].map(o=>Math.round(RATE[c]*(1+o/100)));
const al=()=>{const x=fx();if(!x.al)x.al={};return x.al};
const alTxt=(c,a)=>(a.dir==='up'?'≥ ':'≤ ')+fmt(a.v)+' RWF';
const _fx=screens.fx;
screens.fx=()=>{let h=_fx();const c=cur(),sr=series(c),mn=Math.min(...sr),mx=Math.max(...sr),ch=(sr[6]-sr[0])*100/sr[0],up=ch>=0,A=al()[c];
const pts=sr.map((v,i)=>(i*50+5)+','+(52-(v-mn)*44/Math.max(1,mx-mn))).join(' '),last=pts.split(' ')[6].split(',');
const card=`<div style="margin:18px 24px 0;padding:16px;border-radius:20px;background:var(--chip)"><div style="display:flex;justify-content:space-between;align-items:baseline;gap:8px"><b>${c} · ${t3('last 7 days','iminsi 7 ishize','7 derniers jours')}</b><span class="sm" style="font-weight:800;color:${up?'var(--ok)':'var(--er)'}">${up?'▲':'▼'} ${Math.abs(ch).toFixed(1)}%</span></div><svg viewBox="0 0 310 60" width="100%" height="60" role="img" aria-label="${t3('Rate trend for '+c+': '+(up?'up ':'down ')+Math.abs(ch).toFixed(1)+'% in 7 days','Uko igiciro cya '+c+' cyagenze','Évolution du taux '+c)}" style="margin-top:8px;display:block"><polyline points="${pts}" fill="none" stroke="${up?'var(--ok)':'var(--er)'}" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/><circle cx="${last[0]}" cy="${last[1]}" r="4.5" fill="${up?'var(--ok)':'var(--er)'}"/></svg><div class="sm mu" style="display:flex;justify-content:space-between;margin-top:4px"><span>${t3('Low','Gito','Bas')} ${fmt(mn)}</span><span>${t3('High','Hejuru','Haut')} ${fmt(mx)}</span></div><button class="tap" onclick="fxAl()" style="margin-top:12px;width:100%;min-height:48px;border:0;border-radius:14px;background:var(--bg);color:var(--tx);font:inherit;display:flex;align-items:center;justify-content:space-between;gap:10px;padding:0 14px;text-align:left"><span style="font-weight:700">${t3('Rate alert','Imenyesha y’igiciro','Alerte de taux')}</span><span class="sm" style="color:${A?'var(--tintfg)':'var(--mu)'};font-weight:700">${A?alTxt(c,A):t3('Off','Ntikora','Désactivée')} ›</span></button></div>`;
h=h.replace(/(<div style="padding:22px 24px 8px;font-size:18px;font-weight:800">)/,card+'$1');
const tot=CODES.reduce((a,k)=>a+Math.round((fx().w[k]||0)*RATE[k]),0);
const rec=S.act.filter(x=>x[0]==='cyc'&&/converted/i.test(x[1])).slice(0,3),dl=ms=>new Date(ms).toLocaleDateString(({en:'en-GB',fr:'fr-FR',rw:'en-GB'})[S.lang]||'en-GB',{day:'numeric',month:'short'});
const extra=(tot>0?`<div style="display:flex;justify-content:space-between;padding:6px 24px 0;font-size:14px" class="mu"><span>${t3('Total value','Agaciro kose','Valeur totale')}</span><b style="color:var(--tx)">≈ ${fmt(tot)} RWF</b></div>`:'')+`<div style="padding:22px 24px 4px;font-size:18px;font-weight:800">${t3('Recent conversions','Ibyahinduwe vuba','Conversions récentes')}</div><div style="padding:0 24px">${rec.length?rec.map(x=>`<div class="bdr" role="button" tabindex="0" onclick="actOpen(${S.act.indexOf(x)})" style="padding-left:0;padding-right:0"><div class="ico">💱</div><div style="min-width:0"><div class="t">${esc48(x[1])}</div><div class="s">${x[5]?dl(x[5]):''}</div></div><div class="pkv"><b>${x[3]>0?'+':'−'}${fmt(Math.abs(x[3]))} RWF</b></div></div>`).join(''):`<div class="mu" style="font-size:15px;line-height:22px;padding:8px 0">${t3('No conversions yet. They will show here.','Nta cyahinduwe. Bizagaragara hano.','Aucune conversion. Elles apparaîtront ici.')}</div>`}</div>`;
return h.replace('<div style="height:110px"></div>',extra+'<div style="height:110px"></div>')};
window.fxAl=()=>{const c=cur(),r=RATE[c],A=al()[c],q=S.fxq||(S.fxq=A?{...A}:{dir:'up',v:Math.round(r*1.02)});S.fxq=q;
const opts=[['up',1],['up',2],['down',1],['down',2]].map(([d,p])=>{const v=Math.round(r*(1+(d==='up'?p:-p)/100)),on=q.v===v&&q.dir===d;return `<button class="${on?'on':''}" aria-pressed="${on}" onclick="fxAlPick('${d}',${v})">${d==='up'?'▲':'▼'} ${fmt(v)}</button>`}).join('');
$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" role="dialog" aria-modal="true" aria-label="${t3('Rate alert','Imenyesha y’igiciro','Alerte de taux')}"><div class="h1" style="font-size:22px;line-height:30px;margin-top:4px">${t3('Rate alert for '+c,'Imenyesha y’igiciro cya '+c,'Alerte de taux '+c)}</div><div class="mu" style="font-size:15px;line-height:22px;margin:8px 0 4px">${t3('Now 1 '+c+' = '+fmt(r)+' RWF. Tell me when it reaches:','None 1 '+c+' = RWF '+fmt(r)+'. Mbwira iyo igeze kuri:','Actuellement 1 '+c+' = '+fmt(r)+' RWF. Prévenez-moi à :')}</div><div class="cdch" role="group" style="margin:12px 0 0">${opts}</div><div class="sm mu" style="margin-top:12px;line-height:19px">${t3('Sample only. No real notification is sent in this prototype.','Icyitegererezo gusa. Nta menyesha nyaryo rizoherezwa.','Exemple uniquement. Aucune vraie notification n’est envoyée.')}</div><button class="btn" style="margin-top:18px" onclick="fxAlSet()">${t3('Set alert','Shyiraho imenyesha','Activer l’alerte')}</button>${A?`<button class="btn sec2" style="margin-top:10px;color:var(--er)" onclick="fxAlOff()">${t3('Turn off','Zimya','Désactiver')}</button>`:''}</div>`;if(typeof focusSheet==='function')focusSheet()};
window.fxAlPick=(d,v)=>{S.fxq={dir:d,v};window.fxAl()};
window.fxAlSet=()=>{const c=cur(),q=S.fxq;if(!q)return;al()[c]={dir:q.dir,v:q.v};S.fxq=null;closeSheet();render('fade-none');toast(t3('Alert set: '+c+' '+alTxt(c,q),'Imenyesha ryashyizweho: '+c,'Alerte activée : '+c+' '+alTxt(c,q)))};
window.fxAlOff=()=>{delete al()[cur()];S.fxq=null;closeSheet();render('fade-none');toast(t3('Alert off','Imenyesha ryazimijwe','Alerte désactivée'))};
document.title='itunda, clickable prototype v307';
}
/* v307: Foreign currency. Before: you could only type what you pay in RWF, so paying a bill of exactly 100 USD meant guessing the RWF; the rate line was one long sentence that wrapped (rate, no fee and "sample rate, updated just now" together); "Your wallets" always listed USD, EUR and GBP, including the empty ones with "0.00 EUR". Now: under the amount, a link switches between "I want an exact amount of USD" and "Enter the amount in RWF". In the exact mode you type what you get (two decimals, shortcuts 10 / 25 / 50 / 100), the box below shows what you pay in whole RWF (rounded up so you get at least what you asked for), the button reads \"Buy 100.00 USD for 144,500 RWF\", and the minimum and \"not enough balance\" messages are in the same terms (\"That costs 144,500 RWF. You have 120,000 RWF.\"). The rate and the fee are two plain lines, with one short line saying the rates are samples. \"Your wallets\" lists only the currencies you hold, or \"You hold no foreign currency yet.\" Selling, the review sheet, the result sheet and Activity are unchanged. English, French and Kinyarwanda; fr is new copy and rw is new copy that needs native review, especially \"Nshaka umubare nyawo wa USD\", \"Bigura RWF\" and \"Nta mafaranga y’amahanga ufite\". Not in this version: more currencies (KES, UGX), a rate alert, and a rate history. */
</script>
<script>
/* v308 Subscriptions */
{const t3=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e;
const esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const DAY0={'Canal+ Rwanda':3,'MTN data bundle':1,'Gym Kigali':1,'Music streaming':9};
const CAT=[['📡','StarTimes',8000,'Monthly'],['🎬','Netflix',9000,'Monthly'],['☁️','Cloud storage',1500,'Monthly'],['🌐','Home internet',20000,'Monthly'],['📰','News app',2000,'Monthly']];
const QA=[2000,5000,10000,20000],AMIN=500,AMAX=1000000,N=3,MD=[1,5,10,15,20,25,28],WD=[1,2,3,4,5,6,0];
const RWM=['Mutarama','Gashyantare','Werurwe','Mata','Gicurasi','Kamena','Nyakanga','Kanama','Nzeri','Ukwakira','Ugushyingo','Ukuboza'];
const RWD=['Ku cyumweru','Kuwa mbere','Kuwa kabiri','Kuwa gatatu','Kuwa kane','Kuwa gatanu','Kuwa gatandatu'];
const mig=()=>{S.subs.forEach(s=>{if(s[6]==null)s[6]=DAY0[s[1]]!=null?DAY0[s[1]]:1;if(s[7]==null)s[7]=0;if(s[8]==null)s[8]=0})};
const t0=()=>{const d=new Date();d.setHours(0,0,0,0);return d};
const nextOf=s=>{const t=t0();if(s[3]==='Weekly'){const x=new Date(t);x.setDate(x.getDate()+(s[6]-t.getDay()+7)%7);return x}
 let x=new Date(t.getFullYear(),t.getMonth(),s[6]);if(x<t)x=new Date(t.getFullYear(),t.getMonth()+1,s[6]);return x};
const firstOf=(b,d)=>nextOf([0,0,0,b,0,1,d]);
const prevOf=(s,n)=>{const o=[];let d=nextOf(s);for(let i=0;i<n;i++){d=s[3]==='Weekly'?new Date(d.getFullYear(),d.getMonth(),d.getDate()-7):new Date(d.getFullYear(),d.getMonth()-1,s[6]);if(s[8]&&d<new Date(s[8]))break;o.push(d)}return o};
const loc=()=>S.lang==='fr'?'fr-FR':'en-GB';
const fd=(d,w)=>S.lang==='rw'?(w?RWD[d.getDay()]+' ':'')+d.getDate()+' '+RWM[d.getMonth()]:d.toLocaleDateString(loc(),w?{weekday:'short',day:'numeric',month:'short'}:{day:'numeric',month:'short'});
const rel=d=>{const n=Math.round((d-t0())/864e5);return n===0?t3('today','uyu munsi','aujourd’hui'):n===1?t3('tomorrow','ejo','demain'):t3('in '+n+' days','mu minsi '+n,'dans '+n+' jours')};
const wdn=i=>S.lang==='rw'?RWD[i]:new Date(2024,0,7+i).toLocaleDateString(loc(),{weekday:S.lang==='fr'?'short':'short'});
const wdl=i=>S.lang==='rw'?RWD[i]:new Date(2024,0,7+i).toLocaleDateString(loc(),{weekday:'long'});
const bl=b=>b==='Weekly'?t3('Weekly','Buri cyumweru','Hebdomadaire'):t3('Monthly','Buri kwezi','Mensuel');
const per=s=>s[3]==='Weekly'?t3('week','cyumweru','semaine'):t3('month','kwezi','mois');
const mo=s=>s[3]==='Weekly'?s[2]*52/12:s[2];
const upto=days=>{const t=t0(),end=new Date(t.getFullYear(),t.getMonth(),t.getDate()+days),r={sum:0,cnt:0};S.subs.forEach(s=>{if(!s[5])return;let d=nextOf(s);while(d<=end){r.sum+=s[2];r.cnt++;if(s[3]==='Weekly')d=new Date(d.getFullYear(),d.getMonth(),d.getDate()+7);else break}});return r};
const leftMonth=()=>{const t=t0(),days=Math.round((new Date(t.getFullYear(),t.getMonth()+1,0)-t)/864e5);return upto(days)};
const R=(a,v)=>`<div style="display:flex;justify-content:space-between;gap:12px;min-height:40px;align-items:center;font-size:15px"><span class="mu">${a}</span><b style="text-align:right">${v}</b></div>`;
const Rd=(a,v,s)=>`<div style="display:flex;justify-content:space-between;gap:16px;min-height:44px;align-items:center;font-size:15px;padding:4px 0"><span class="mu" style="flex:0 1 40%">${a}</span><span style="flex:1;text-align:right"><b>${v}</b>${s?`<div class="mu" style="font-size:13px;font-weight:400">${s}</div>`:''}</span></div>`;
const Rn=(a,v)=>R(a,v).replace('<b style="text-align:right">','<b style="text-align:right;white-space:nowrap">');
const hd=t=>`<div style="padding:22px 24px 0;font-size:16px;font-weight:800">${t}</div>`;
const fine=t=>`<div class="pad fine" style="padding-top:16px">${t}</div>`;
const cta=(h,dis,fn,id)=>`<div style="height:100px"></div><div class="cta"><button ${id?`id="${id}" `:''}class="btn" style="white-space:nowrap" ${dis?'disabled':''} onclick="${fn}">${h}</button></div>`;
const chip=(on,fn,l,al)=>`<button class="chip" aria-pressed="${on}" ${al?`aria-label="${al}" `:''}onclick="${fn}" style="min-width:64px;height:44px;border-radius:22px;border:0;padding:0 16px;font-size:15px;font-weight:800;background:${on?'var(--tx)':'var(--chip)'};color:${on?'var(--bg)':'var(--tx)'}">${l}</button>`;
const grp=(h,l)=>`<div style="display:flex;gap:10px;flex-wrap:wrap;padding:14px 24px 0" role="group" ${l?`aria-label="${l}"`:''}>${h}</div>`;
const ttl=()=>t3('Subscriptions','Kwiyandikisha buri gihe','Abonnements');
const sheet=(h,body,btns)=>{$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" role="dialog" aria-modal="true" aria-label="${esc(h)}"><div class="h1" style="font-size:22px;line-height:30px;margin-top:4px">${esc(h)}</div>${body}${btns}</div>`;if(typeof focusSheet==='function')focusSheet()};
const addMoneyBtn=()=>`<button onclick="(window.sheetAdd||function(){tab('pay')})()" style="border:0;background:none;padding:8px 0 0;font:inherit;font-size:14px;font-weight:800;color:var(--lk);text-align:left">${t3('Add money','Ongeramo amafaranga','Ajouter de l’argent')}</button>`;

/* ---- list ---- */
screens.subs=()=>{mig();
 const L=S.subs.map((s,i)=>({s,i,d:nextOf(s)})),on=L.filter(x=>x.s[5]).sort((a,b)=>a.d-b.d),off=L.filter(x=>!x.s[5]);
 if(!S.subs.length)return `${bar(ttl())}<div class="pad" style="padding-top:28px"><div class="h1">${t3('No subscriptions','Nta bikishyurwa buri gihe','Aucun abonnement')}</div><div class="mu" style="font-size:15px;margin-top:8px;line-height:22px">${t3('When you add a regular payment, it shows here with its next charge date. You can pause or cancel it any time.','Iyo wongeyeho ikishyurwa buri gihe, kigaragara hano n’itariki ikizakwishyurwaho. Ushobora kugihagarika cyangwa kugikuraho igihe icyo ari cyo cyose.','Quand vous ajoutez un paiement régulier, il apparaît ici avec sa prochaine date de prélèvement. Vous pouvez le mettre en pause ou le résilier à tout moment.')}</div></div>${cta(t3('Add a subscription','Ongeraho ikishyurwa','Ajouter un abonnement'),0,'subAdd()')}`;
 const m=Math.round(on.reduce((a,x)=>a+mo(x.s),0)),yr=Math.round(on.reduce((a,x)=>a+x.s[2]*(x.s[3]==='Weekly'?52:12),0));
 const lm=leftMonth(),w=upto(6),short=w.sum>S.pay;
 const nx=on[0]?`<div class="sm" style="margin-top:8px;line-height:20px"><span class="mu">${t3('Next charge:','Kwishyura gukurikira:','Prochain prélèvement :')}</span> <b>${esc(on[0].s[1])}</b>, ${fmt(on[0].s[2])} RWF, ${rel(on[0].d)}</div>`:'';
 const card=on.length?`<div style="margin:16px 24px 0;padding:6px 16px;border-radius:20px;background:var(--chip)">${Rn(t3('Left to pay this month','Asigaye kwishyurwa muri uku kwezi','Reste à payer ce mois-ci'),fmt(lm.sum)+' RWF')}${Rn(t3('Next 7 days','Iminsi 7 iri imbere','7 prochains jours'),fmt(w.sum)+' RWF')}</div>${short?`<div style="padding:10px 24px 0;font-size:14px;line-height:20px;color:var(--er)" role="alert">${t3('The next 7 days need '+fmt(w.sum)+' RWF, but itunda Pay has '+fmt(S.pay)+' RWF.','Iminsi 7 iri imbere ikeneye RWF '+fmt(w.sum)+', ariko itunda Pay ifite RWF '+fmt(S.pay)+'.','Les 7 prochains jours demandent '+fmt(w.sum)+' RWF, mais itunda Pay contient '+fmt(S.pay)+' RWF.')}</div><div style="padding:0 24px">${addMoneyBtn()}</div>`:''}`:'';
 const row=x=>{const s=x.s,a=s[5];return `<div class="row tap" onclick="subOpen(${x.i})" style="padding:12px 24px"><div class="ico">${s[0]}</div><div style="flex:1;min-width:0"><div class="t" style="opacity:${a?1:.5}">${esc(s[1])}</div><div class="s">${fmt(s[2])} RWF · ${bl(s[3])}</div><div class="s" style="${a&&Math.round((x.d-t0())/864e5)<=3?'font-weight:800;color:var(--tx)':''}">${a?t3('Next ','Ikurikira ','Prochain ')+fd(x.d)+' · '+rel(x.d):t3('Paused','Cyahagaritswe','En pause')}</div></div><div class="sw ${a?'on':''}" role="switch" aria-checked="${!!a}" aria-label="${esc(s[1])}${a?', '+t3('on','gikora','actif'):', '+t3('paused','cyahagaritswe','en pause')}" tabindex="0" onclick="event.stopPropagation();subTg(${x.i})"><i></i></div></div>`};
 return `${bar(ttl())}<div style="padding:20px 24px 4px"><div class="sm mu">${t3('Monthly total','Yose ya buri kwezi','Total mensuel')}</div><div class="big" style="font-size:34px">${fmt(m)} RWF</div><div class="sm mu" style="margin-top:2px">${t3('About '+fmt(yr)+' RWF a year','Hafi RWF '+fmt(yr)+' ku mwaka','Environ '+fmt(yr)+' RWF par an')}</div>${nx}</div>${card}
${on.length?hd(t3('Active','Bikora','Actifs'))+on.map(row).join(''):''}${off.length?hd(t3('Paused, not charged','Byahagaritswe, ntibishyurwa','En pause, non facturés'))+off.map(row).join(''):''}
${fine(t3('Tap a subscription for details, to pause or cancel. Weekly charges are counted as 52 weeks ÷ 12 months. Sample data.','Kanda kuri buri kimwe ubone amakuru, ugihagarike cyangwa ukivane. Ibyishyurwa buri cyumweru bibarwa ku byumweru 52 ÷ amezi 12. Amakuru y’icyitegererezo.','Touchez un abonnement pour voir les détails, le mettre en pause ou le résilier. Les prélèvements hebdomadaires sont comptés sur 52 semaines ÷ 12 mois. Données d’exemple.'))}${cta(t3('Add a subscription','Ongeraho ikishyurwa','Ajouter un abonnement'),0,'subAdd()')}`};
window.subTg=i=>{const s=S.subs[i];if(!s)return;s[5]=s[5]?0:1;toast(s[5]?t3(s[1]+' resumed',s[1]+' cyasubukuwe',s[1]+' repris'):t3(s[1]+' paused',s[1]+' cyahagaritswe',s[1]+' mis en pause'));render('fade-none')};
window.subRem=i=>{const s=S.subs[i];if(!s)return;s[7]=s[7]?0:1;toast(s[7]?t3('Reminder on','Ibyibutsa byafunguwe','Rappel activé'):t3('Reminder off','Ibyibutsa byahagaritswe','Rappel désactivé'));render('fade-none')};

/* ---- details ---- */
screens.subd=()=>{mig();const s=S.subs[S.subi];if(!s)return `${bar(ttl())}`;
 const a=s[5],d=nextOf(s),past=prevOf(s,3);
 const bill=s[3]==='Weekly'?t3('Weekly · every '+wdl(s[6]).toLowerCase(),'Buri cyumweru · '+wdl(s[6]).toLowerCase(),'Hebdomadaire · chaque '+wdl(s[6]).toLowerCase()):t3('Monthly · on day '+s[6],'Buri kwezi · ku munsi wa '+s[6],'Mensuel · le jour '+s[6]);
 const hist=!a?`<div class="mu" style="padding:8px 24px 0;font-size:15px;line-height:22px">${t3('Paused. Nothing is charged until you resume.','Cyahagaritswe. Nta cyishyurwa kugeza ugisubukuye.','En pause. Rien n’est prélevé tant que vous ne le reprenez pas.')}</div>`
  :past.length?past.map(p=>`<div style="display:flex;justify-content:space-between;padding:8px 24px 0;font-size:15px"><span>${fd(p,1)}</span><b>${fmt(s[2])} RWF</b></div>`).join('')
  :`<div class="mu" style="padding:8px 24px 0;font-size:15px;line-height:22px">${t3('No charges yet. The first one is on '+fd(d,1)+'.','Nta cyishyuwe. Icya mbere ni ku wa '+fd(d,1)+'.','Aucun prélèvement pour l’instant. Le premier a lieu le '+fd(d,1)+'.')}</div>`;
 return `${bar(ttl())}<div style="padding:20px 24px 0;display:flex;align-items:center;gap:14px"><div class="ico" style="width:56px;height:56px;font-size:28px">${s[0]}</div><div style="min-width:0"><div class="h1" style="font-size:24px;line-height:30px">${esc(s[1])}</div><div class="mu" style="font-size:15px">${fmt(s[2])} RWF ${t3('a','ku','par')} ${per(s)}</div></div></div>
<div style="margin:18px 24px 0;padding:6px 16px;border-radius:20px;background:var(--chip)">${Rd(t3('Next charge','Kwishyura gukurikira','Prochain prélèvement'),a?fd(d,1):t3('Paused','Cyahagaritswe','En pause'),a?rel(d):t3('Not charged','Ntikishyurwa','Non facturé'))}${Rd(t3('Billing','Uko wishyura','Facturation'),bill)}${Rd(t3('Paid from','Bishyurwa na','Payé depuis'),'itunda Pay',fmt(S.pay)+' RWF')}</div>
<div class="row" style="padding:12px 24px;margin-top:6px"><div style="flex:1;min-width:0"><div class="t">${t3('Remind me the day before','Unyibutse umunsi umwe mbere','Me prévenir la veille')}</div></div><div class="sw ${s[7]?'on':''}" role="switch" aria-checked="${!!s[7]}" aria-label="${t3('Remind me the day before','Unyibutse umunsi umwe mbere','Me prévenir la veille')}" tabindex="0" onclick="subRem(${S.subi})"><i></i></div></div>
${hd(t3('Recent charges','Ibyishyuwe vuba','Derniers prélèvements'))}${hist}
<div class="row2" style="display:grid;grid-template-columns:1fr 1fr;gap:12px;padding:26px 24px 0"><button class="btn sec2" onclick="subTg(${S.subi})">${a?t3('Pause','Hagarika','Mettre en pause'):t3('Resume','Subukura','Reprendre')}</button><button class="btn sec2" style="color:var(--er)" onclick="subAsk(${S.subi})">${t3('Cancel it','Kuraho','Résilier')}</button></div>
${fine(t3('Sample data. No real charge is made.','Amakuru y’icyitegererezo. Nta kwishyura nyako gukorwa.','Données d’exemple. Aucun vrai prélèvement.'))}<div style="height:24px"></div>`};
window.subOpen=i=>{if(!S.subs[i])return;S.subi=i;S.stack.push('subd');render('push')};
window.subAsk=i=>{const s=S.subs[i];if(!s)return;
 sheet(t3('Cancel '+s[1]+'?','Kuraho '+s[1]+'?','Résilier '+s[1]+' ?'),`<div class="mu" style="font-size:15px;margin:8px 0 24px;line-height:22px">${t3('You will not be charged again. To get it back, you set it up again with the provider.','Ntuzongera kwishyurwa. Kugira ngo kigaruke, ugisaba nanone ku kigitanga.','Vous ne serez plus prélevé. Pour le retrouver, vous devez le réactiver auprès du fournisseur.')}</div>`,
 `<div class="row2" style="display:grid;grid-template-columns:1fr 1.4fr;gap:12px"><button class="btn sec2" onclick="closeSheet()">${t3('Keep it','Kigumane','Le garder')}</button><button class="btn" style="white-space:nowrap" onclick="subDel(${i})">${t3('Cancel subscription','Kuraho','Résilier')}</button></div>`)};
window.subDel=i=>{const s=S.subs[i];if(!s)return;const n=s[1];S.subs.splice(i,1);closeSheet();if(S.stack[S.stack.length-1]==='subd')back();else render('fade-none');toast(t3(n+' cancelled',n+' cyakuweho',n+' résilié'))};

/* ---- add: 3 steps ---- */
const SA=()=>S.sa||(S.sa={step:1,pick:-1,name:'',a:0,b:'Monthly',d:1});
const avail=()=>CAT.map((c,i)=>[c,i]).filter(([c])=>!S.subs.some(s=>s[1].toLowerCase()===c[1].toLowerCase()));
const nameOf=()=>{const q=SA();return q.pick>=0?CAT[q.pick][1]:(q.name||'').trim()};
const nerr=()=>{const q=SA();if(q.pick>=0||!q.name)return '';const n=q.name.trim();return n.length<2?t3('Use at least 2 letters','Nibura inyuguti 2','Au moins 2 lettres'):S.subs.some(s=>s[1].toLowerCase()===n.toLowerCase())?t3('You already have this subscription','Usanzwe ufite iki kishyurwa','Vous avez déjà cet abonnement'):''};
const nOk=()=>{const q=SA();return q.pick>=0||(q.name.trim().length>=2&&!nerr())};
const aerr=()=>{const a=SA().a;return !a?'':a<AMIN?t3('Minimum is '+fmt(AMIN)+' RWF','Nibura ni RWF '+fmt(AMIN),'Minimum : '+fmt(AMIN)+' RWF'):a>AMAX?t3('Maximum is '+fmt(AMAX)+' RWF','Ntarenza RWF '+fmt(AMAX),'Maximum : '+fmt(AMAX)+' RWF'):''};
const aOk=()=>{const a=SA().a;return a>=AMIN&&a<=AMAX};
const prog=s=>`<div style="padding:16px 24px 0"><div class="sm mu" style="font-weight:700">${t3('Step '+s+' of '+N,'Intambwe '+s+' kuri '+N,'Étape '+s+' sur '+N)}</div><div style="height:4px;border-radius:2px;background:var(--chip);margin-top:8px;overflow:hidden" role="progressbar" aria-valuenow="${s}" aria-valuemin="1" aria-valuemax="${N}"><div style="height:100%;width:${s*100/N}%;background:var(--lk);transition:width .3s"></div></div></div>`;
const head=(s,h,t)=>`${prog(s)}<div style="padding:18px 24px 0"><div class="h1">${h}</div>${t?`<div class="mu" style="font-size:15px;line-height:22px;margin-top:8px">${t}</div>`:''}</div>`;
const hdr=()=>`<div class="bar"><button class="ib" aria-label="Back" onclick="subaBack()">${ic('back',24)}</button><b>${t3('Add a subscription','Ongeraho ikishyurwa','Ajouter un abonnement')}</b></div>`;
const NX=()=>t3('Next','Komeza','Suivant');
window.subAdd=()=>{S.sa={step:1,pick:-1,name:'',a:0,b:'Monthly',d:1};S.stack.push('suba');render('push')};
window.subaBack=()=>{const q=SA();if(q.step>1){q.step--;render('fade-none')}else back()};
window.subaPick=i=>{const q=SA();q.pick=i;if(i>=0){q.a=CAT[i][2];q.b=CAT[i][3]}else{q.a=0}render('fade-none')};
window.subaName=v=>{const q=SA();q.name=String(v).slice(0,24);const e=nerr();const el=$('#sane'),b=$('#sanb'),i=$('#sani');if(el)el.textContent=e;if(i)i.setAttribute('aria-invalid',e?'true':'false');if(b)b.disabled=!nOk()};
window.subaAmt=v=>{const q=SA();q.a=Math.min(99999999,Number(String(v).replace(/\D/g,''))||0);const i=$('#sai');if(i)i.value=q.a?fmt(q.a):'';subaUpd()};
function subaUpd(){const e=aerr(),el=$('#saae'),b=$('#sanb'),i=$('#sai');if(el)el.textContent=e;if(i)i.setAttribute('aria-invalid',e?'true':'false');if(b)b.disabled=!aOk();document.querySelectorAll('#saq button').forEach((x,k)=>{const on=SA().a===QA[k];x.setAttribute('aria-pressed',on?'true':'false');x.style.background=on?'var(--tx)':'var(--chip)';x.style.color=on?'var(--bg)':'var(--tx)'})}
window.subaQ=v=>{SA().a=v;const i=$('#sai');if(i)i.value=fmt(v);subaUpd()};
window.subaBil=b=>{const q=SA();q.b=b;q.d=b==='Weekly'?1:1;render('fade-none')};
window.subaDay=d=>{SA().d=d;render('fade-none')};
window.subaNext=()=>{const q=SA();if(q.step===1){if(!nOk())return;q.step=2;render('fade-none')}else if(q.step===2){if(!aOk())return;q.step=3;render('fade-none')}else subaReview()};
screens.suba=()=>{const q=SA();
 if(q.step===1){const av=avail();
  const rows=av.map(([c,i])=>`<button class="row tap" role="radio" aria-checked="${q.pick===i}" onclick="subaPick(${i})" style="padding:12px 24px;width:100%;border:0;background:none;text-align:left;font:inherit;color:inherit"><div class="ico">${c[0]}</div><div style="flex:1;min-width:0"><div class="t">${esc(c[1])}</div><div class="s">${t3('Sample price '+fmt(c[2])+' RWF a month','Igiciro cy’icyitegererezo RWF '+fmt(c[2])+' ku kwezi','Prix d’exemple '+fmt(c[2])+' RWF par mois')}</div></div>${q.pick===i?'<span style="font-weight:800;color:var(--lk);font-size:20px" aria-hidden="true">✓</span>':''}</button>`).join('');
  const other=`<button class="row tap" role="radio" aria-checked="${q.pick<0&&q.name!==''||q.pick===-2}" onclick="subaPick(-2)" style="padding:12px 24px;width:100%;border:0;background:none;text-align:left;font:inherit;color:inherit"><div class="ico">✨</div><div style="flex:1;min-width:0"><div class="t">${t3('Something else','Ikindi','Autre chose')}</div></div>${q.pick===-2?'<span style="font-weight:800;color:var(--lk);font-size:20px" aria-hidden="true">✓</span>':''}</button>${q.pick===-2?`<div style="padding:4px 24px 0"><label class="sm mu" for="sani">${t3('Name','Izina','Nom')}</label><input class="in" id="sani" autocomplete="off" maxlength="24" value="${esc(q.name)}" oninput="subaName(this.value)" aria-describedby="sane" aria-invalid="false" style="margin-top:6px"><div class="fxe" id="sane" role="alert" style="min-height:20px;color:var(--er);font-size:14px;margin-top:4px">${esc(nerr())}</div></div>`:''}`;
  return `${hdr()}${head(1,t3('What do you want to add?','Ushaka kongeraho iki?','Que voulez-vous ajouter ?'),t3('Pick one, or choose “Something else” and type the name.','Hitamo kimwe, cyangwa uhitemo “Ikindi” wandike izina.','Choisissez-en un, ou « Autre chose » et saisissez le nom.'))}<div style="padding-top:10px" role="radiogroup">${rows}${other}</div>${cta(NX(),q.pick===-2?!nOk():q.pick===-1,'subaNext()','sanb')}`}
 if(q.step===2){const n=nameOf();
  return `${hdr()}${head(2,t3('How much, and how often?','Angahe, kandi kangahe?','Combien, et à quelle fréquence ?'),esc(n))}
<div class="fxa"><label class="sm mu" for="sai">${t3('Amount each time','Amafaranga buri gihe','Montant à chaque fois')}</label><div class="fxr"><input class="in" id="sai" inputmode="numeric" autocomplete="off" placeholder="0" value="${q.a?fmt(q.a):''}" oninput="subaAmt(this.value)" aria-describedby="saae" aria-invalid="false"><b>RWF</b></div></div><div style="padding:0 24px"><div id="saq" style="display:flex;gap:10px;flex-wrap:wrap;margin-top:14px" role="group" aria-label="${t3('Quick amounts','Umubare uhuse','Montants rapides')}">${QA.map(v=>chip(q.a===v,'subaQ('+v+')',v/1000+'K')).join('')}</div><div id="saae" role="alert" style="min-height:20px;color:var(--er);font-size:14px;margin-top:8px">${aerr()}</div></div>
${hd(t3('How often','Kangahe','Fréquence'))}${grp(['Monthly','Weekly'].map(b=>chip(q.b===b,"subaBil('"+b+"')",bl(b))).join(''),t3('How often','Kangahe','Fréquence'))}
${cta(NX(),!aOk(),'subaNext()','sanb')}`}
 const d=firstOf(q.b,q.d),days=q.b==='Weekly'?WD.map(i=>chip(q.d===i,'subaDay('+i+')',wdn(i),wdl(i))).join(''):MD.map(i=>chip(q.d===i,'subaDay('+i+')',i)).join('');
 return `${hdr()}${head(3,t3('When is it charged?','Kwishyura bizaba ryari?','Quand est-ce prélevé ?'),q.b==='Weekly'?t3('Pick a day of the week.','Hitamo umunsi w’icyumweru.','Choisissez un jour de la semaine.'):t3('Pick a day of the month. It stops at 28 so every month has that day.','Hitamo umunsi w’ukwezi. Ntarenza 28, kugira ngo buri kwezi uwuhorane.','Choisissez un jour du mois. Maximum 28, pour que chaque mois l’ait.'))}
${grp(days,q.b==='Weekly'?t3('Day of the week','Umunsi w’icyumweru','Jour de la semaine'):t3('Day of the month','Umunsi w’ukwezi','Jour du mois'))}
<div style="margin:20px 24px 0;padding:6px 16px;border-radius:20px;background:var(--chip)">${R(t3('First charge','Kwishyura bwa mbere','Premier prélèvement'),fd(d,1)+' · '+rel(d))}</div>${fine(t3('Sample prices. No real payment is set up.','Ibiciro by’icyitegererezo. Nta kishyurwa nyakuri gishyizweho.','Prix d’exemple. Aucun vrai paiement n’est programmé.'))}${cta(NX(),0,'subaNext()','sanb')}`};
window.subaReview=()=>{const q=SA(),n=nameOf(),d=firstOf(q.b,q.d),low=S.pay<q.a;
 sheet(t3('Add '+n+'?','Ongeraho '+n+'?','Ajouter '+n+' ?'),`<div style="margin:12px 0 ${low?6:20}px">${R(t3('Amount','Amafaranga','Montant'),fmt(q.a)+' RWF '+t3('a','ku','par')+' '+per([0,0,0,q.b]))}${R(t3('Billing','Uko wishyura','Facturation'),bl(q.b))}${R(t3('First charge','Kwishyura bwa mbere','Premier prélèvement'),fd(d,1))}${R(t3('Paid from','Bishyurwa na','Payé depuis'),'itunda Pay')}</div>${low?`<div style="font-size:14px;line-height:20px;color:var(--er);margin-bottom:16px">${t3('itunda Pay has '+fmt(S.pay)+' RWF. Add money before the first charge.','itunda Pay ifite RWF '+fmt(S.pay)+'. Ongeramo amafaranga mbere y’uko kwishyura bwa mbere.','itunda Pay contient '+fmt(S.pay)+' RWF. Ajoutez de l’argent avant le premier prélèvement.')}</div>`:''}`,
 `<div class="row2" style="display:grid;grid-template-columns:1fr 1.4fr;gap:12px"><button class="btn sec2" onclick="closeSheet()">${t3('Cancel','Reka','Annuler')}</button><button class="btn" style="white-space:nowrap" onclick="subaDo()">${t3('Add','Ongeraho','Ajouter')}</button></div>`)};
window.subaDo=()=>{const q=SA(),n=nameOf(),ic0=q.pick>=0?CAT[q.pick][0]:'✨';if(!aOk()||!n)return;
 S.subs.push([ic0,n,q.a,q.b,'',1,q.d,0,t0().getTime()]);S.sa=null;closeSheet();S.stack.pop();render('pop');toast(t3(n+' added',n+' cyongeweho',n+' ajouté'))};
document.title='itunda, clickable prototype v308';
}
/* v308: Subscriptions. Before: only English had the v203 page (details, pause, cancel); in French and Kinyarwanda the old plain list came back with no details and no cancel; there was no way to add a subscription (the empty page said "when you set up a regular payment" but offered nothing); the top showed only a monthly total, weekly charges counted as exactly 4 a month, nothing said whether itunda Pay could cover what was coming; the details were a small pop-up with no history and no reminder; \"Next 3 Nov\" and the billing sat on one line that wrapped next to the switch. Now: English, French and Kinyarwanda everywhere; the top shows the monthly total, about how much that is a year (weekly charges are counted as 52 weeks ÷ 12 months, so 5,000 a week is about 21,667 a month, not 20,000), and a card with \"Left to pay this month\" (with the number of charges) and \"Next 7 days\"; if the next 7 days cost more than itunda Pay holds, a red line says so with \"Add money\"; each row has the price and billing on one line and \"Next 1 Nov · in 14 days\" on the next (bold when it is 3 days away or less); tapping a row opens a full page (not a pop-up) with price, next charge, billing (\"Monthly · on day 1\" or \"Weekly · every monday\"), paid from with the itunda Pay balance, \"Remind me the day before\", the last 3 charges (or \"No charges yet. The first one is on ...\" for a new one, or \"Paused. Nothing is charged until you resume.\"), Pause / Resume and Cancel it; cancelling still asks first. New: \"Add a subscription\" (button at the bottom of the list and of the empty page), in 3 steps with \"Step 2 of 3\" and a bar: 1 what (StarTimes, Netflix, Cloud storage, Home internet, News app, or \"Something else\" with a name field, at least 2 letters, no duplicates; ones you already have are not offered), 2 how much (typed, 500 to 1,000,000 RWF, shortcuts 2K / 5K / 10K / 20K, error under the field) and how often (Monthly / Weekly), 3 which day (day 1 to 28 for monthly, a weekday for weekly) with the first charge date shown; a review sheet (a red line if itunda Pay is below the price); then it appears in the list. The dates are worked out from today, so they stay correct. fr is new copy and rw is new copy that needs native review, especially \"Kwiyandikisha buri gihe\" (kept from the menu), \"Ongeraho ikishyurwa\", \"Ibyishyuwe vuba\", \"Unyibutse umunsi umwe mbere\", the weekday and month names, and the sentence about 52 weeks ÷ 12 months. Not in this version: a real charge from itunda Pay on the due date, a real reminder in Messages, yearly billing, choosing another card to pay from, a price-change alert, and a Cancelled list with undo. */
</script>
<style id="v309css">
/* v309: Landlord (saved payee) sheet and list improved. */
.pl-hd{display:flex;align-items:center;gap:14px}
.pl-av{width:56px;height:56px;border-radius:28px;background:var(--tint);color:var(--tintfg);display:flex;align-items:center;justify-content:center;font-size:20px;font-weight:800;flex:none}
.pl-st{margin-left:auto;width:44px;height:44px;border-radius:22px;border:0;background:var(--chip);color:var(--mu);font-size:20px;cursor:pointer;flex:none}
.pl-st.on{color:var(--lk)}
.pl-card{background:var(--chip);border-radius:16px;padding:14px 16px;margin-top:16px}
.pl-card .k{font-size:13px;color:var(--mu)}
.pl-card .v{font-size:16px;font-weight:700;margin-top:2px}
.pl-card .s{font-size:13px;color:var(--mu);margin-top:2px}
.pl-acc{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-top:16px;font-size:15px}
.pl-acc button{border:0;background:var(--chip);color:var(--lk);font:inherit;font-size:13px;font-weight:700;height:36px;padding:0 14px;border-radius:18px;cursor:pointer}
.pl-chips{display:flex;gap:8px;margin-top:16px;flex-wrap:wrap}
.pl-chips button{border:0;background:var(--chip);color:var(--tx);font:inherit;font-size:14px;font-weight:600;height:44px;padding:0 16px;border-radius:22px;cursor:pointer}
.pl-chips button.del{color:var(--er)}
.pl-chips button.pr{background:var(--tint);color:var(--tintfg)}
.pl-sub{font-size:13px;color:var(--mu);margin-top:2px}
</style>
<script>
/* v309: Landlord (saved payee) sheet and list. The sheet now shows an initials avatar, a favourite star in the header, the full account number with Copy, the next scheduled transfer or a "Set up monthly rent" suggestion, the last amount sent, and a primary Send money bar; Schedule and Edit are chips and Delete is a quiet red chip. The Payees list shows the next transfer or last payment under each name. rw/fr strings need native review. */
(function(){
const T=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e;
const esc=s=>String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/"/g,'&quot;');
const pay=id=>S.bp.find(p=>p.id===id);
const pn=p=>p.k||p.n;
const sh=h=>{$('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" style="max-height:86%;overflow-y:auto">'+h+'</div>'};
const loc=()=>({en:'en-GB',fr:'fr-FR',rw:'en-GB'})[S.lang]||'en-GB';
const dts=ms=>new Date(ms).toLocaleDateString(loc(),{weekday:'short',day:'numeric',month:'short'});
const dts2=ms=>new Date(ms).toLocaleDateString(loc(),{day:'numeric',month:'short'});
const ini=n=>String(n).trim().split(/\s+/).slice(0,2).map(w=>(w[0]||'').toUpperCase()).join('')||'?';
const grp=a=>String(a).replace(/(\d{4})(?=\d)/g,'$1 ');
const FRQ=()=>({once:T('one time','rimwe','une fois'),week:T('weekly','buri cyumweru','chaque semaine'),month:T('monthly','buri kwezi','chaque mois')});
const nextSch=id=>(S.bsc||[]).filter(s=>s.pid===id&&!s.done).sort((a,b)=>a.next-b.next)[0];
const lastSent=p=>{const t='To '+p.n;const x=(S.act||[]).find(a=>a[3]<0&&typeof a[1]==='string'&&a[1].indexOf(t)===0);return x||null};
const sub=p=>{const s=nextSch(p.id);if(s)return (s.p?T('Paused','Byahagaritswe','En pause')+' · ':T('Next ','Ikurikira ','Prochain ')+dts2(s.next)+' · ')+Number(s.amt).toLocaleString('en-US')+' RWF';const l=lastSent(p);if(l)return T('Last sent ','Wohereje ','Dernier envoi ')+Number(-l[3]).toLocaleString('en-US')+' RWF';return p.n+' · '+p.bank+' ••'+p.acc.slice(-4)};
const prow=p=>`<div class="row tap" role="button" tabindex="0" onclick="bpOpen(${p.id})"><div class="pl-av" style="width:44px;height:44px;border-radius:22px;font-size:16px">${esc(ini(p.n))}</div><div style="flex:1;min-width:0"><div class="t">${esc(pn(p))}${p.fav?' <span style="color:var(--lk)">★</span>':''}</div><div class="s">${esc(sub(p))}</div></div></div>`;
screens.bkpay=()=>{const l=S.bp.slice().sort((a,b)=>(b.fav?1:0)-(a.fav?1:0));return `${bar(T('Payees','Abakwakira','Bénéficiaires'))}<div class="pad" style="padding-top:12px"><button class="btn" onclick="bpEdit(0)">+ ${T('Add a payee','Ongeraho ukwakira','Ajouter un bénéficiaire')}</button>${l.length?'':`<div class="mu" style="padding-top:24px;text-align:center;line-height:22px">${T('Save people you pay often. Sending takes two taps.','Bika abo wishyura kenshi. Kohereza bifata gukanda kabiri.','Enregistrez vos bénéficiaires habituels. Envoyer prend deux touches.')}</div>`}${l.map(prow).join('')}</div>`};
window.bpCopy=id=>{const p=pay(id);if(!p)return;try{navigator.clipboard&&navigator.clipboard.writeText(p.acc)}catch(e){}toast(T('Account number copied','Nimero ya konti yakoporowe','Numéro de compte copié'))};
window.bpFav=id=>{const p=pay(id);p.fav=p.fav?0:1;render('fade-none');window.bpOpen(id)};
window.bpRent=id=>{closeSheet();bsNew(id)};
window.bpOpen=id=>{const p=pay(id);if(!p)return;const s=nextSch(id),l=lastSent(p);
let card='';
if(s){card=`<div class="pl-card"><div class="k">${s.p?T('Scheduled · paused','Biteganyijwe · byahagaritswe','Programmé · en pause'):T('Next transfer','Kohereza gukurikira','Prochain virement')}</div><div class="v">${Number(s.amt).toLocaleString('en-US')} RWF · ${esc(dts(s.next))}</div><div class="s">${esc(FRQ()[s.fr]||'')}${s.n?' · '+s.n+T(' sent',' byoherejwe',' envoyés'):''}</div><div class="pl-chips" style="margin-top:12px"><button class="pr" onclick="closeSheet();bsRun(${s.id})">${T('Send now','Ohereza ubu','Envoyer')}</button><button onclick="closeSheet();bsSkip(${s.id})">${T('Skip next','Simbuka','Passer')}</button></div></div>`}
else card=`<div class="pl-card"><div class="k">${T('Nothing scheduled','Nta cyateganyijwe','Rien de programmé')}</div><div class="v">${T('Set up monthly rent','Tegura ubukode buri kwezi','Programmez le loyer mensuel')}</div><div class="s">${T('Set it once. We remind you before each transfer.','Tegura rimwe. Tukwibutsa mbere ya buri kohereza.','Programmez une fois. Nous vous rappelons avant chaque virement.')}</div><div class="pl-chips" style="margin-top:12px"><button class="pr" onclick="bpRent(${id})">${T('Schedule','Teganya','Programmer')}</button></div></div>`;
const last=l?`<div class="pl-sub" style="margin-top:12px">${T('Last sent ','Wohereje ','Dernier envoi ')}${Number(-l[3]).toLocaleString('en-US')} RWF</div>`:'';
sh(`<div class="pl-hd"><div class="pl-av">${esc(ini(p.n))}</div><div style="min-width:0"><div ${'class="h1" style="font-size:22px;line-height:28px;margin:0"'}>${esc(pn(p))}</div><div class="pl-sub">${esc(p.n)}</div></div><button class="pl-st${p.fav?' on':''}" aria-pressed="${!!p.fav}" aria-label="${T('Favourite','Ukunzwe','Favori')}" onclick="bpFav(${id})">${p.fav?'★':'☆'}</button></div>
<div class="pl-acc"><div><div class="mu" style="font-size:13px">${esc(p.bank)}</div><b style="letter-spacing:.5px">${esc(grp(p.acc))}</b></div><button onclick="bpCopy(${id})">${T('Copy','Koporora','Copier')}</button></div>
${card}${last}
<div class="pl-chips"><button onclick="bpEdit(${id})">${T('Edit','Hindura','Modifier')}</button>${s?`<button onclick="closeSheet();bkGo('bksch')">${T('Manage transfers','Genzura','Gérer les virements')}</button>`:''}<button class="del" onclick="bpDel(${id})">${T('Delete','Siba','Supprimer')}</button></div>
<div class="bpbar"><button class="btn" onclick="bpSend(${id})">${T('Send money','Ohereza amafaranga','Envoyer de l’argent')}</button></div>`)};
document.title=document.title.replace(/v\d+/,'v320');
})();
</script>
<script>
/* v313: Harvest advance. Before: English only (French and Kinyarwanda fell back to a plain card); it asked for one cooperative ID and nothing else; repayment was only a monthly instalment although the advance is meant to be repaid after the harvest; after sending there was a one-line note and nothing to follow. Now: English, French and Kinyarwanda (fr/rw new copy needs native review); asks for your cooperative, your member ID and what the advance is for (seedlings, fertiliser, tools, pest control, other); the amount is a field (100,000 to 2,000,000 RWF) with shortcuts; you choose "One payment after harvest" (pay it all on one date, interest for the months until then) or "Monthly" (equal instalments), then 4 / 6 / 8 months; the page shows the total to repay and the date of the single payment (or the monthly payment); a line under the form says what is missing; a review before sending; after sending the page tracks the application (Submitted, Cooperative confirms membership, Approved, Funds sent to itunda Pay), you can withdraw until it is approved, and once the funds arrive the money is added to itunda Pay, it shows in Activity, and the page shows when you repay. Sample terms: no real advance is made, and there is no real reminder. */
{const t3=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e;
const fm=n=>fmt(Math.round(n)),esc48=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const AMIN=100000,AMAX=2000000,SCS=[200000,500000,1000000,2000000],TMS=[4,6,8],RATE=12;
const short=v=>v>=1e6?v/1e6+'M':v/1e3+'K';
const USE=[['seed',['Seedlings','Imbuto','Plants']],['fert',['Fertiliser','Ifumbire','Engrais']],['tools',['Tools & equipment','Ibikoresho','Outils et matériel']],['pest',['Pest control','Kurwanya udukoko','Lutte antiparasitaire']],['other',['Other','Ibindi','Autre']]];
const uname=k=>{const p=USE.find(x=>x[0]===k);return p?t3(...p[1]):''};
S.hv=S.hv||{coop:'',cid:'',use:'',a:500000,n:6,m:'one'};
S.apps=S.apps||{};
const H=()=>S.hv;
const addM=(d,n)=>{const x=new Date(d);x.setMonth(x.getMonth()+n);return x};
const dts=d=>new Date(d).toLocaleDateString(S.lang==='fr'?'fr-FR':'en-GB',{day:'numeric',month:'short',year:'numeric'});
const calc=(h)=>{h=h||H();const p=h.a,n=h.n,i=RATE/1200;if(h.m==='one'){const int=Math.round(p*RATE/100*n/12);return{mo:0,tot:p+int,int}}const mo=Math.round(p*i/(1-Math.pow(1+i,-n)));return{mo,tot:mo*n,int:mo*n-p}};
const aerr=()=>{const a=H().a;return !a?'':a<AMIN?t3('Minimum is '+fm(AMIN)+' RWF','Nibura ni RWF '+fm(AMIN),'Minimum : '+fm(AMIN)+' RWF'):a>AMAX?t3('Maximum is '+fm(AMAX)+' RWF','Ntarenza RWF '+fm(AMAX),'Maximum : '+fm(AMAX)+' RWF'):''};
const miss=()=>{const h=H();if((h.coop||'').trim().length<3)return t3('Type your cooperative to continue.','Andika koperative yawe ukomeze.','Saisissez votre coopérative pour continuer.');if((h.cid||'').trim().length<4)return t3('Type your member ID (at least 4 characters).','Andika nimero y’umunyamuryango (nibura inyuguti 4).','Saisissez votre numéro de membre (4 caractères minimum).');if(!h.use)return t3('Choose what the advance is for.','Hitamo icyo avansi igenewe.','Choisissez l’usage de l’avance.');if(!h.a||aerr())return aerr()||t3('Enter an amount to continue.','Andika amafaranga ukomeze.','Saisissez un montant pour continuer.');return ''};
const chip=(on,fn,l,al)=>`<button class="chip" aria-pressed="${on}" ${al?`aria-label="${al}" `:''}onclick="${fn}" style="min-width:64px;height:44px;border-radius:22px;border:0;padding:0 16px;font-size:15px;font-weight:800;background:${on?'var(--tx)':'var(--chip)'};color:${on?'var(--bg)':'var(--tx)'}">${l}</button>`;
const grp=(h,id)=>`<div ${id?`id="${id}" `:''}style="display:flex;gap:10px;flex-wrap:wrap;padding:10px 24px 0" role="group">${h}</div>`;
const lab=(t,s,f)=>`<div style="padding:24px 24px 0"><label ${f?`for="${f}" `:''}style="font-size:16px;font-weight:800;display:block">${t}</label>${s?`<div class="sm mu" style="margin-top:4px;line-height:19px">${s}</div>`:''}</div>`;
const rw=(a,v,b)=>`<div style="margin:8px 24px 0;display:flex;justify-content:space-between;gap:12px;font-size:15px"><span class="mu">${a}</span><b style="text-align:right;${b?'color:var(--tintfg)':''}">${v}</b></div>`;
const R=(a,v)=>`<div style="display:flex;justify-content:space-between;gap:12px;min-height:40px;align-items:center;font-size:15px"><span class="mu">${a}</span><b style="text-align:right">${v}</b></div>`;
const lay2=h=>{$('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet">'+h+'</div>';if(typeof focusSheet==='function')focusSheet()};
const inp=(id,val,ph,fn)=>`<div style="padding:8px 24px 0"><input id="${id}" value="${esc48(val)}" oninput="${fn}" autocomplete="off" placeholder="${ph}" style="width:100%;box-sizing:border-box;height:48px;border:0;border-radius:14px;background:var(--chip);color:var(--tx);padding:0 16px;font:inherit;font-size:16px"></div>`;
const qUse=()=>grp(USE.map(([k,n])=>chip(H().use===k,`hvSet('use','${k}')`,t3(...n))).join(''));
const dyn=()=>{const h=H(),q=calc(),ok=!aerr()&&h.a>=AMIN,m=miss(),one=h.m==='one',due=addM(Date.now(),h.n);
return `${grp(SCS.map(x=>chip(h.a===x,`hvSet('a',${x})`,short(x),fm(x)+' RWF')).join(''))}
${lab(t3('How do you want to repay?','Wifuza kwishyura ute?','Comment voulez-vous rembourser ?'),one?t3('Most coffee is harvested from March to June. You pay once, after you sell.','Ikawa nyinshi isarurwa kuva muri Werurwe kugeza muri Kamena. Wishyura rimwe, umaze kugurisha.','Le café est surtout récolté de mars à juin. Vous payez une fois, après la vente.'):t3('Equal payments every month.','Kwishyura kungana buri kwezi.','Mensualités égales.'))}
${grp([['one',t3('One payment after harvest','Kwishyura rimwe nyuma y’isarura','Un paiement après la récolte')],['mo',t3('Monthly','Buri kwezi','Mensuel')]].map(([k,l])=>chip(h.m===k,`hvSet('m','${k}')`,l)).join(''))}
${lab(one?t3('Pay me back in','Nzishyura mu','Je rembourse dans'):t3('Repay over','Ishyura mu','Rembourser sur'))}${grp(TMS.map(x=>chip(h.n===x,`hvSet('n',${x})`,x+' '+t3('months','mezi','mois'))).join(''))}
${ok?(one?rw(t3('One payment on','Kwishyura rimwe ku wa','Un paiement le'),dts(due),1)+rw(t3('Amount','Amafaranga','Montant'),fm(q.tot)+' RWF',1):rw(t3('Monthly payment','Kwishyura buri kwezi','Mensualité'),fm(q.mo)+' RWF',1))+rw(t3('Interest ('+RATE+'% a year)','Inyungu ('+RATE+'% ku mwaka)','Intérêts ('+RATE+' % par an)'),fm(q.int)+' RWF')+rw(t3('Total to repay','Ugomba kwishyura yose','Total à rembourser'),fm(q.tot)+' RWF'):''}
${lab(t3('What happens next','Ibikurikira','La suite'))}<div style="padding:8px 24px 0;font-size:15px;line-height:24px"><div>1. ${t3('Your cooperative confirms you are a member.','Koperative yawe yemeza ko uri umunyamuryango.','Votre coopérative confirme que vous êtes membre.')}</div><div>2. ${t3('We send the money to itunda Pay.','Twohereza amafaranga muri itunda Pay.','Nous envoyons l’argent sur itunda Pay.')}</div><div>3. ${t3('You repay on your chosen date.','Wishyura ku munsi wahisemo.','Vous remboursez à la date choisie.')}</div></div>
<div id="hvM" class="sm" role="status" style="margin:16px 24px 0;min-height:20px;text-align:center;color:var(--mu);font-weight:700">${m||''}</div>`};
window.hvUpd=()=>{const d=document.getElementById('hvD');if(!d)return;d.innerHTML=dyn();const e=document.getElementById('hvAE');if(e)e.textContent=aerr();const q3=document.getElementById('hvQ3');if(q3)q3.innerHTML=qUse();const b=document.getElementById('hvB');if(b){b.disabled=!!miss();b.textContent=t3('Apply for '+fm(H().a)+' RWF','Saba RWF '+fm(H().a),'Demander '+fm(H().a)+' RWF')}};
window.hvSet=(f,v)=>{H()[f]=v;if(f==='a'){const i=document.getElementById('hvA');if(i)i.value=fm(v)}hvUpd()};
window.hvType=(f,el)=>{if(f==='a'){const x=el.value.replace(/\D/g,'').slice(0,7);H().a=x?Number(x):0;el.value=x?fmt(x):''}else H()[f]=el.value.slice(0,40);hvUpd()};
window.hvReview=()=>{if(miss()||S.apps.harvest&&S.apps.harvest.stage!=null)return;const h=H(),q=calc(),one=h.m==='one';
lay2(`<div class="h1" style="font-size:22px;line-height:30px;margin-top:4px">${t3('Apply for '+fm(h.a)+' RWF?','Gusaba RWF '+fm(h.a)+'?','Demander '+fm(h.a)+' RWF ?')}</div><div style="margin:12px 0 16px">${R(t3('Cooperative','Koperative','Coopérative'),esc48(h.coop.trim()))}${R(t3('Member ID','Nimero y’umunyamuryango','N° de membre'),esc48(h.cid.trim()))}${R(t3('For','Igenewe','Usage'),uname(h.use))}${one?R(t3('One payment on','Kwishyura rimwe ku wa','Un paiement le'),dts(addM(Date.now(),h.n))):R(t3('Repay over','Kwishyura mu','Remboursement sur'),h.n+' '+t3('months','mezi','mois'))+R(t3('Monthly payment','Kwishyura buri kwezi','Mensualité'),fm(q.mo)+' RWF')}${R(t3('Total to repay','Ugomba kwishyura yose','Total à rembourser'),fm(q.tot)+' RWF')}${R(t3('Rate','Inyungu','Taux'),RATE+t3('% a year','% ku mwaka',' % par an'))}</div><div class="mu sm" style="margin:-4px 0 16px;line-height:20px">${t3('Next: your cooperative confirms your membership. Money is sent to itunda Pay once approved. You can withdraw until it is approved.','Ibikurikira: koperative yawe yemeza ko uri umunyamuryango. Amafaranga yoherezwa muri itunda Pay yemejwe. Ushobora kuyikuraho itaremezwa.','Ensuite : votre coopérative confirme votre adhésion. L’argent est envoyé sur itunda Pay après approbation. Vous pouvez retirer la demande avant.')}</div><div style="display:grid;grid-template-columns:1fr 1.8fr;gap:12px"><button class="btn sec2" onclick="closeSheet()">${t3('Cancel','Reka','Annuler')}</button><button class="btn" style="white-space:nowrap" onclick="hvSend()">${t3('Send application','Ohereza ubusabe','Envoyer la demande')}</button></div>`)};
window.hvSend=()=>{if(miss())return;const h=H(),q=calc(),ref='ITN-'+String(Date.now()).slice(-6);S.apps.harvest={ref,a:h.a,n:h.n,m:h.m,mo:q.mo,tot:q.tot,coop:h.coop.trim(),cid:h.cid.trim(),use:h.use,stage:0};closeSheet();render('fade-none');
lay2(`<div class="g3" style="font-size:56px;line-height:1;margin-bottom:10px">📨</div><div class="h1" style="font-size:22px;line-height:30px">${t3('Application sent','Ubusabe bwoherejwe','Demande envoyée')}</div><div class="mu" style="font-size:15px;margin:8px 0 24px;line-height:22px">${t3('Reference '+ref+'. Your cooperative will confirm your membership.','Nimero '+ref+'. Koperative yawe izemeza ko uri umunyamuryango.','Référence '+ref+'. Votre coopérative confirmera votre adhésion.')}</div><button class="btn" onclick="closeSheet()">OK</button>`)};
window.hvNext=()=>{const a=S.apps.harvest;if(!a||a.stage==null||a.stage>=3)return;a.stage++;if(a.stage===3){S.pay+=a.a;a.at=Date.now();if(Array.isArray(S.act))S.act.unshift(['wallet','Harvest advance · '+a.ref,'Received · Just now',a.a,'Received']);toast('+'+fm(a.a)+' RWF '+t3('added to itunda Pay','yongewe muri itunda Pay','ajoutés à itunda Pay'))}render('fade-none')};
window.hvWithdraw=()=>lay2(`<div class="h1" style="font-size:22px;line-height:30px;margin-top:4px">${t3('Withdraw your application?','Gukuraho ubusabe bwawe?','Retirer votre demande ?')}</div><div class="mu" style="font-size:15px;margin:8px 0 24px;line-height:22px">${t3('Your cooperative will not review it. You can apply again later.','Koperative yawe ntizabusuzuma. Ushobora gusaba nanone.','Votre coopérative ne l’examinera pas. Vous pourrez redemander plus tard.')}</div><div style="display:grid;grid-template-columns:1fr 1.8fr;gap:12px"><button class="btn sec2" onclick="closeSheet()">${t3('Keep it','Reka ikomeze','Garder')}</button><button class="btn" style="white-space:nowrap" onclick="hvWithdrawGo()">${t3('Withdraw','Kuraho','Retirer')}</button></div>`);
window.hvWithdrawGo=()=>{delete S.apps.harvest;closeSheet();render('fade-none');toast(t3('Application withdrawn','Ubusabe bwakuweho','Demande retirée'))};
const screenHv=()=>{const a=S.apps.harvest,h=H(),title=t3('Harvest advance','Avansi y’isarura','Avance de récolte');
const head=bar(title)+`<div style="padding:22px 24px 0"><div style="width:72px;height:72px;border-radius:36px;background:var(--tint);display:flex;align-items:center;justify-content:center;font-size:36px">☕</div><div class="h1" style="margin-top:16px">${title}</div><div class="mu" style="font-size:15px;line-height:22px;margin-top:8px">${t3('Input financing for coffee cooperative members, repaid after the harvest. '+RATE+'% a year.','Inguzanyo y’ibikoresho ku banyamuryango ba koperative y’ikawa, yishyurwa nyuma y’isarura. '+RATE+'% ku mwaka.','Financement d’intrants pour les membres d’une coopérative de café, remboursé après la récolte. '+RATE+' % par an.')}</div></div>`;
if(a&&a.stage!=null){const st=a.stage,names=[t3('Submitted','Cyoherejwe','Envoyée'),t3('Cooperative confirms membership','Koperative yemeza ko uri umunyamuryango','La coopérative confirme l’adhésion'),t3('Approved','Cyemejwe','Approuvée'),t3('Funds sent to itunda Pay','Amafaranga yoherejwe muri itunda Pay','Fonds envoyés sur itunda Pay')];
const desc=[t3('We sent your application to your cooperative.','Twohereje ubusabe bwawe kuri koperative yawe.','Nous avons envoyé votre demande à votre coopérative.'),t3('They check your membership and ID.','Barasuzuma ko uri umunyamuryango na nimero yawe.','Elle vérifie votre adhésion et votre numéro.'),t3('Your advance is approved. Funds are on the way.','Avansi yawe yemejwe. Amafaranga araje.','Votre avance est approuvée. Les fonds arrivent.'),t3('The money is in your itunda Pay.','Amafaranga ari muri itunda Pay yawe.','L’argent est sur votre itunda Pay.')];
const tl=names.map((n,i)=>`<div style="display:flex;gap:14px;align-items:flex-start;padding:10px 0"><div style="width:26px;height:26px;border-radius:13px;flex:none;display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:800;background:${i<=st?'var(--lk)':'var(--chip)'};color:${i<=st?'#fff':'var(--mu)'}" ${i===st?'aria-current="step"':''}>${i<st||st===3&&i===3?'✓':i+1}</div><div style="min-width:0"><div style="font-weight:${i===st?800:600};color:${i<=st?'var(--tx)':'var(--mu)'}">${n}</div>${i===st?`<div class="sm mu" style="margin-top:2px;line-height:19px">${desc[i]}</div>`:''}</div></div>`).join('');
const one=a.m==='one',base=a.at||Date.now(),pay=one?dts(addM(base,a.n)):dts(addM(base,1));
return head+`<div style="margin:18px 24px 0;padding:14px 16px;border-radius:16px;background:var(--tint);color:var(--tintfg);font-size:14px;line-height:20px"><b>${t3('Application sent.','Ubusabe bwoherejwe.','Demande envoyée.')}</b> ${t3('Reference ','Nimero ','Référence ')}${a.ref} · ${fm(a.a)} RWF</div><div style="padding:14px 24px 0">${tl}</div>
${lab(t3('Your advance','Avansi yawe','Votre avance'))}${rw(t3('Amount','Amafaranga','Montant'),fm(a.a)+' RWF')}${rw(t3('Cooperative','Koperative','Coopérative'),esc48(a.coop||''))}${rw(t3('For','Igenewe','Usage'),uname(a.use))}${a.m==='one'?rw(t3('One payment after harvest','Kwishyura rimwe nyuma y’isarura','Un paiement après la récolte'),fm(a.tot||0)+' RWF',1):rw(t3('Monthly payment','Kwishyura buri kwezi','Mensualité'),fm(a.mo||0)+' RWF',1)+rw(t3('Repay over','Kwishyura mu','Remboursement sur'),a.n+' '+t3('months','mezi','mois'))}${rw(t3('Total to repay','Ugomba kwishyura yose','Total à rembourser'),fm(a.tot||0)+' RWF')}${st===3?rw(one?t3('Pay on','Kwishyura ku wa','À payer le'):t3('First payment','Kwishyura bwa mbere','Premier paiement'),pay,1):''}
${st<3?`<div class="pad" style="padding-top:18px"><button class="chip" onclick="hvNext()">${t3('Next step (sample)','Intambwe ikurikira (icyitegererezo)','Étape suivante (exemple)')}</button></div>`:''}<div class="pad fine" style="padding-top:14px">${t3('Sample for this prototype. No real advance is made and no real reminder is sent.','Icyitegererezo cy’iyi porogaramu. Nta avansi nyayo itangwa kandi nta menyesha nyaryo ryoherezwa.','Exemple pour ce prototype. Aucune vraie avance n’est accordée et aucun vrai rappel n’est envoyé.')}</div><div style="height:100px"></div>${st<2?`<div class="cta"><button class="btn sec2" style="white-space:nowrap" onclick="hvWithdraw()">${t3('Withdraw application','Kuraho ubusabe','Retirer la demande')}</button></div>`:''}`}
return head+`${lab(t3('Your cooperative','Koperative yawe','Votre coopérative'),'','hvC')}${inp('hvC',h.coop,t3('e.g. Musasa Coffee Cooperative','urugero: Koperative y’Ikawa ya Musasa','ex. Coopérative de café de Musasa'),"hvType('coop',this)")}
${lab(t3('Your member ID','Nimero yawe y’umunyamuryango','Votre numéro de membre'),t3('It is on your membership card. Your cooperative can also tell you.','Iri ku ikarita yawe y’umunyamuryango. Koperative yawe nayo irakubwira.','Il figure sur votre carte de membre. Votre coopérative peut aussi vous le donner.'),'hvI')}${inp('hvI',h.cid,t3('Type the ID on your card','Andika nimero iri ku ikarita','Saisissez le numéro de la carte'),"hvType('cid',this)")}
${lab(t3('What is the advance for?','Avansi igenewe iki?','À quoi sert l’avance ?'))}<div id="hvQ3">${qUse()}</div>
${lab(t3('Advance amount','Amafaranga ya avansi','Montant de l’avance'),'','hvA')}<div style="padding:8px 24px 0"><div style="display:flex;align-items:baseline;gap:8px;border-bottom:2px solid var(--ln)"><input id="hvA" inputmode="numeric" autocomplete="off" placeholder="0" value="${h.a?fmt(h.a):''}" oninput="hvType('a',this)" aria-describedby="hvAE" style="flex:1;min-width:0;border:0;background:none;color:var(--tx);font:inherit;font-size:24px;font-weight:800;padding:6px 0;outline:0;border-radius:0"><span class="mu" style="font-weight:700">RWF</span></div><div id="hvAE" role="alert" class="sm" style="min-height:20px;margin-top:6px;color:var(--er);font-weight:700">${aerr()}</div></div>
<div id="hvD">${dyn()}</div><div class="pad fine" style="padding-top:8px">${t3('Sample terms for this prototype. No real advance is made.','Amabwiriza y’icyitegererezo. Nta avansi nyayo itangwa.','Conditions d’exemple pour ce prototype. Aucune vraie avance n’est accordée.')}</div><div style="height:100px"></div><div class="cta"><button id="hvB" class="btn" style="white-space:nowrap" ${miss()?'disabled':''} onclick="hvReview()">${t3('Apply for '+fm(h.a)+' RWF','Saba RWF '+fm(h.a),'Demander '+fm(h.a)+' RWF')}</button></div>`};
const _p=screens.svc;screens.svc=()=>S.svk==='harvest'?screenHv():_p();
document.title=document.title.replace(/v\d+/,'v320');
}

/* v316: Get a loan is three short steps, one choice per page (Amount, Repay over, Check). Before, amount, term, the terms box and Apply all sat on one page and the last row of the terms was hidden behind the button. Step 2 shows what each term costs per month so you can choose before you commit; tapping a term moves on. The last page lists the full terms and the button names the amount. Your active loan page is unchanged. English only; fr/rw keep the old page. */
(function(){
const fd=d=>d.toLocaleDateString('en-GB',{day:'numeric',month:'long',year:'numeric'});
const d15=k=>{const d=new Date();d.setDate(15);d.setMonth(d.getMonth()+k);return d};
const limOf=f=>{const a=S.lp.a;return Math.max(Math.min(...a),Math.floor(Math.max(...a)*f/1000)*1000)};
const lim=()=>limOf(score()>=700?1:score()>=600?.5:.25);
const need=x=>[[0,.25],[600,.5],[700,1]].find(([,f])=>limOf(f)>=x)[0];
const lockSvg='<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="margin-right:6px;vertical-align:-1px"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>';
const ST=['Amount','Repay over','Check'];
const prev=screens.loan;
screens.loan=()=>{
 if(S.loan||S.lang!=='en'||!S.lp||S.lp.n!=='Get a loan')return prev();
 const k=Math.min(2,S.lst|0),L=lim();if(S.la>L)S.la=Math.max(...S.lp.a.filter(x=>x<=L));
 const c=lcalc(S.la,S.lm),A=S.lp.a;
 const head=`${bar('Get a loan')}<div class="v176" role="status" aria-label="Step ${k+1} of 3"><span class="sg" aria-hidden="true">${[0,1,2].map(i=>`<i class="${i<=k?'on':''}"></i>`).join('')}</span><span>Step ${k+1} of 3 · ${ST[k]}</span></div>`;
 if(k===0){const lk=A.filter(x=>x>L);
  return head+`<div class="pad" style="padding-top:20px"><div class="h1">How much do you need?</div><div class="mu" style="font-size:15px;margin-top:8px">You can borrow up to ${fmt(L)} RWF.</div></div><div role="status" style="padding:24px 24px 0;font-size:40px;line-height:48px;font-weight:800;letter-spacing:-1px;font-variant-numeric:tabular-nums">${fmt(S.la)}<span style="font-size:22px;font-weight:700"> RWF</span></div><div class="pad" style="padding-top:20px"><div class="req">${A.map(x=>x>L?`<button class="lkd" aria-disabled="true" onclick="toast('${fmt(x)} RWF opens at a score of ${need(x)}. Yours is ${score()}.')">${lockSvg}${fmt(x)} RWF</button>`:`<button class="${S.la===x?'on':''}" onclick="S.la=${x};render('fade-none')">${fmt(x)} RWF</button>`).join('')}</div>${lk.length?`<div class="sm mu" style="margin-top:14px;line-height:19px">${lk.map(x=>fmt(x)+' RWF opens at a score of '+need(x)).join('. ')}. Yours is ${score()}.</div>`:''}</div><div class="cta"><button class="btn" onclick="lnNext()">Next</button></div>`}
 if(k===1){const T=S.lp.t;
  return head+`<div class="pad" style="padding-top:20px"><div class="h1">How long to repay ${fmt(S.la)} RWF?</div><div class="mu" style="font-size:15px;margin-top:8px">Pick the monthly payment that suits you.</div></div><div style="padding:12px 24px 0">${T.map((m,i)=>{const q=lcalc(S.la,m),on=m===S.lm,tag=i===0?'Least interest':i===T.length-1?'Smallest monthly payment':'';return `<button onclick="lnTerm(${m})" style="display:flex;justify-content:space-between;align-items:center;gap:12px;width:100%;padding:16px 0;border:0;border-bottom:1px solid var(--ln);background:none;color:inherit;font:inherit;text-align:left"><span style="min-width:0"><b style="font-size:17px;${on?'color:var(--lk)':''}">${m} months${on?' ✓':''}</b><span class="sm mu" style="display:block;margin-top:2px">Total ${fmt(q.tot)} RWF</span>${tag?`<span class="sm" style="display:block;margin-top:2px;color:var(--ok);font-weight:700">${tag}</span>`:''}</span><span style="text-align:right;flex:0 0 auto"><b style="font-size:17px">${fmt(q.mo)} RWF</b><span class="sm mu" style="display:block;margin-top:2px">a month</span></span></button>`}).join('')}</div>`}
 const rows=[['Each month',fmt(c.mo)+' RWF for '+S.lm+' months'],['Total to repay',fmt(c.tot)+' RWF'],['Interest',fmt(c.tot-S.la)+' RWF · '+(+(S.lp.r*100).toFixed(2))+'% a month'],['First payment',fd(d15(1))],['Final payment',fd(d15(S.lm))]];
 return head+`<div class="pad" style="padding-top:20px"><div class="h1">Check before you apply</div></div><div style="padding:16px 24px 0"><div class="sm mu">You get</div><div style="font-size:34px;line-height:42px;font-weight:800;letter-spacing:-.8px;margin-top:2px">${fmt(S.la)} RWF</div></div><div style="margin:20px 24px 0;padding:4px 20px;border-radius:20px;background:var(--chip)">${rows.map(([a,b],i)=>lrow(a,b,i)).join('')}</div><div class="pad fine" style="padding-top:14px;padding-bottom:96px">The money is added to itunda Bank right away. Sample terms for this prototype. No real loan is made.</div><div class="cta"><button class="btn" onclick="lnGo()">Apply for ${fmt(S.la)} RWF</button></div>`};
window.lnNext=()=>{S.lst=(S.lst|0)+1;render('fade-none')};
window.lnTerm=m=>{S.lm=m;S.lst=2;render('fade-none')};
window.lnGo=()=>{const c=lcalc(S.la,S.lm);$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" role="dialog" aria-modal="true" aria-label="Confirm"><div style="margin-bottom:12px">${gl('verified3d',60)}</div><div class="h1" style="font-size:22px;line-height:30px">Confirm it's you</div><div class="mu" style="font-size:15px;margin:8px 0 24px">Borrow ${fmt(S.la)} RWF and repay ${fmt(c.mo)} RWF a month for ${S.lm} months.</div><button class="btn" onclick="loanDo()">Borrow ${fmt(S.la)} RWF</button></div>`};
const _bk2=window.back;window.back=function(){if(S.stack[S.stack.length-1]==='loan'&&!S.loan&&S.lp&&S.lp.n==='Get a loan'&&S.lang==='en'&&(S.lst|0)>0){S.lst--;render('fade-none');return}S.lst=0;return _bk2.apply(this,arguments)};
const _d3=loanDo;loanDo=function(){S.lst=0;return _d3.apply(this,arguments)};
})();

/* v318: Directions. Before: three control rows (route filter tabs, "Leave now" + "Best route", "Avoid stairs") sat above the map, and "Leave now" and "Best route" changed to the next value on every tap without showing the choices. Now: one line says what you have chosen ("Leave now · Best route") and opens a "Route options" sheet where every choice is visible (leave time, which routes to show, sort, avoid stairs). The map gets the space back. The swap button now swaps start and destination (it only showed a toast). */
(function(){
const L=(e,r,f)=>({en:e,rw:r,fr:f}[S.lang]||e);
const M=S.mp;let BFL=[];
const DEPL=()=>[L('Now','Ubu','Maintenant'),L('In 15 min','Mu minota 15','Dans 15 min'),L('In 30 min','Mu minota 30','Dans 30 min'),L('In 1 hour','Mu isaha 1','Dans 1 h')];
const SRT=()=>[L('Best route','Inzira nziza','Meilleur itinéraire'),L('Fewest transfers','Guhindura bike','Moins de correspondances'),L('Least walking','Kugenda make','Moins de marche')];
const swapIc='<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 4v16M8 4 4 8M8 4l4 4M16 20V4M16 20l-4-4M16 20l4-4"/></svg>';
const prev=screens.route;
screens.route=()=>{let h=prev();
 h=h.replace(/<button class="ib" aria-label="Swap" onclick="toast\('Start and destination swapped'\)">[\s\S]*?<\/button>/,()=>`<button class="ib" aria-label="${L('Swap start and destination','Hindura intangiriro n’aho ujya','Inverser départ et arrivée')}" onclick="rtSwap()">${swapIc}</button>`);
 if(M.swp&&!M.from){const a='</span>KG 11 Ave, Kimironko</div>',b='</span>'+PL.n+'</div>';if(h.includes(a)&&h.includes(b))h=h.replace(a,()=>'§A§').replace(b,()=>'§B§').replace('§A§',()=>b).replace('§B§',()=>a)}
 const re1=/<div style="display:flex;gap:22px;padding:0 20px;border-bottom:0;overflow-x:auto">((?:<span[^>]*onclick="mpBf\(\d+\)"[^>]*>[^<]*<\/span>)+)<\/div>/,m1=h.match(re1);
 if(!m1)return h;
 BFL=[...m1[1].matchAll(/onclick="mpBf\(\d+\)">([^<]*)<\/span>/g)].map(x=>x[1]);
 h=h.replace(re1,'');
 const d=M.dep|0,bf=M.bf|0,txt=[d?L('Leave ','Genda ','Partir ')+DEPL()[d].toLowerCase():L('Leave now','Genda ubu','Partir maintenant'),SRT()[M.sort|0]].concat(bf&&BFL[bf]?[BFL[bf].replace(/\s+\d+$/,'')]:[],M.ns?[L('No stairs','Nta ngazi','Sans escaliers')]:[]).join(' · ');
 const sum=`<button onclick="rtOpt()" style="display:flex;align-items:center;gap:10px;width:calc(100% - 40px);margin:10px 20px 0;padding:12px 14px;border:0;border-radius:16px;background:var(--chip);color:inherit;font:inherit;font-size:15px;text-align:left"><span style="flex:1;min-width:0;font-weight:700">${txt}</span><span style="color:var(--lk);font-weight:700;white-space:nowrap">${L('Options','Amahitamo','Options')}</span></button>`;
 h=h.replace(/<div style="display:flex;justify-content:space-between;align-items:center;padding:10px 20px;border-bottom:0;font-size:15px;font-weight:700"><span[^>]*onclick="mpDep\(\)">[^<]*<\/span><span[^>]*onclick="mpSort\(\)">[^<]*<\/span><\/div>/,()=>sum);
 h=h.replace(/<div style="margin:12px 16px 0;border-radius:18px;padding:12px 14px;background:var\(--tint\)[^>]*onclick="mpNs\(\)">[\s\S]*?<\/span><\/div>/,'');
 return h};
window.rtSwap=()=>{M.swp=!M.swp;render('fade-none');toast(L('Start and destination swapped','Intangiriro n’aho ujya byahinduwe','Départ et arrivée inversés'))};
const _a=window.mpArriveAt;window.mpArriveAt=id=>{M.swp=false;return _a(id)};
const ref=()=>{render('fade-none');rtOpt()};
window.rtDep=i=>{M.dep=i;ref()};window.rtBf=i=>{M.bf=i;M.opt=0;ref()};window.rtSrt=i=>{M.sort=i;ref()};window.rtNs=()=>{M.ns=!M.ns;ref()};
window.rtOpt=()=>{const g=(t,it,cur,fn)=>`<div class="sm mu" style="margin:18px 0 8px;font-weight:700">${t}</div><div class="req" style="flex-wrap:wrap;gap:8px">${it.map((x,i)=>`<button class="${cur===i?'on':''}" onclick="${fn}(${i})">${x}</button>`).join('')}</div>`;
 $('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" role="dialog" aria-modal="true" aria-label="${L('Route options','Amahitamo y’inzira','Options d’itinéraire')}"><div class="h1" style="font-size:22px;line-height:30px">${L('Route options','Amahitamo y’inzira','Options d’itinéraire')}</div>${g(L('Leave','Genda','Partir'),DEPL(),M.dep|0,'rtDep')}${BFL.length?g(L('Show','Erekana','Afficher'),BFL,M.bf|0,'rtBf'):''}${g(L('Sort by','Tondeka','Trier par'),SRT(),M.sort|0,'rtSrt')}<button onclick="rtNs()" role="switch" aria-checked="${!!M.ns}" style="display:flex;justify-content:space-between;align-items:center;width:100%;margin-top:18px;padding:14px 0 0;border:0;border-top:1px solid var(--ln);background:none;color:inherit;font:inherit;font-size:16px;font-weight:700;text-align:left"><span>${L('Avoid stairs','Irinde ingazi','Éviter les escaliers')}</span><span class="tg">${M.ns?L('ON','BIRAKORA','OUI'):L('OFF','OYA','NON')}</span></button><button class="btn" style="margin-top:22px" onclick="closeSheet()">${L('Done','Byarangiye','Terminé')}</button></div>`};
})();
</script>
<style id="v319">
/* v319: Maps home spacing. Before: the filter chips touched the search pill (0 px gap), the map overlays sat 12 px from the screen edge while the Nearby sheet used 20 px and the rest of the app uses 24 px. Now: 10 px between search and chips, overlays on a 16 px edge, sheet content on the 24 px grid, hint toast moved down with the chips. */
#phone .fmap .mvs{left:16px;right:16px}
#phone .fmap .mcs.mvc{margin-top:10px;padding:1px 16px}
#phone .fmap .fcrow{padding:0 16px 16px}
#phone .fmap .fms{padding:10px 24px 24px}
#phone .fmap .fms .hdl{margin-bottom:16px}
#phone .fmap .fms .pc{padding:10px 0}
#phone .toast.mphint{top:132px!important}
</style>
<script>
/* v320: Kigali Maps. (1) Map pin sheet: "Depart" and "Arrive" did not say what they do and did not match the Place page; they now read "From here" and "Directions" (Kuva hano / Inzira, Depuis ici / Itinéraire; rw and fr need native review). (2) Search: the screen was two rows of chips and then empty space. A new "Explore nearby" section lists the map categories (Cafe, Food, Bus stops, Pharmacy, ATM); tapping one opens the map already filtered. It hides while you type, like the recent list, and the chosen chip scrolls into view on the map. */
{const t=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e;
const st=document.createElement('style');st.id='v320';
st.textContent='#phone .mpx{padding:20px 24px 0}#phone .mpx h3{font-size:17px;font-weight:800;margin:0 0 4px;letter-spacing:-.2px}#phone .mpx .g{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:12px}#phone .mpx button{display:flex;align-items:center;gap:12px;height:56px;padding:0 16px;border:0;border-radius:16px;background:var(--chip);color:var(--tx);font:inherit;font-size:15px;font-weight:700;text-align:left}#phone .mpx button i{font-style:normal;font-size:22px}';
document.head.appendChild(st);
const _a=screens.mapview;
screens.mapview=()=>{let h=_a();const a=t('From here','Kuva hano','Depuis ici'),b=t('Directions','Inzira','Itinéraire');
return h.replace(/(<button class="p"[^>]*>)(Depart|Gutangira|Départ)(<\/button>)/,'$1'+a+'$3').replace(/(<button class="q"[^>]*>)(Arrive|Kugerayo|Arrivée)(<\/button>)/,'$1'+b+'$3')};
const _b=screens.mapsearch;
screens.mapsearch=()=>{let h=_b();
const C=[['cafe','☕',t('Cafe','Ikawa','Café')],['food','🍽️',t('Food','Ibiryo','Repas')],['bus','🚌',t('Bus stops','Bisi','Arrêts de bus')],['pharm','💊',t('Pharmacy','Farumasi','Pharmacie')],['atm','🏧','ATM']];
const x='<div class="mpx"><h3>'+t('Explore nearby','Shakisha hafi yawe','Explorer à proximité')+'</h3><div class="g">'+C.map(c=>'<button onclick="openMaps();mpCat(\''+c[0]+'\');setTimeout(function(){var e=document.querySelector(\'.fmap .ocp.on\');if(e)e.scrollIntoView({inline:\'center\',block:\'nearest\'})},120)"><i>'+c[1]+'</i>'+c[2]+'</button>').join('')+'</div></div>';
return h.replace(/<\/div>\s*$/,x+'</div>')};
}
</script>
<style id="v320b">
/* v320: map pin sheet buttons on two rows (From here + Directions, then Details, Save, Share) so the clearer labels are not cut off */
#phone .fmap .acts.mp5{display:grid!important;grid-template-columns:repeat(6,1fr)!important;gap:8px!important}
#phone .fmap .acts.mp5>button{grid-column:span 2!important;font-size:14px!important;padding:0 8px!important}
#phone .fmap .acts.mp5>button.p,#phone .fmap .acts.mp5>button.q{grid-column:span 3!important;font-size:15px!important}
</style>
<script>
/* v321: Make an offer. Before: three percent chips, a bare amount and a button, so you could not see what you would save, a very low offer went out unchallenged, a non-negotiable note sat under the button, and nothing said what happens next. Now: one sheet, in order: item and asking price, a note at the top if the price is not marked negotiable (you can still offer), quick chips, your own price, a three-line summary (asking price, your offer, you save), a gentle nudge below 60% of the asking price (not blocking), the button with the amount on it, and one line on what happens next. If you already made an offer the title says "Update your offer" and shows it. Enter sends. No foldables. rw and fr need native review. */
{const t=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e;
const esc=s=>String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/"/g,'&quot;');
const H=HD.market,item=id=>H.items.find(x=>x.id===id);
const sh=h=>{$('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" style="max-height:86%;overflow-y:auto">'+h+'</div>'};
const FLD='style="font-size:17px;height:46px"';
const chipBtn=(on,fn,l)=>`<button class="${on?'on':''}" aria-pressed="${!!on}" onclick="${fn}">${l}</button>`;
const num=s=>Number(String(s).replace(/,/g,''));
const fmtIn=v=>v.replace(/\D/g,'').replace(/\B(?=(\d{3})+(?!\d))/g,',');
const amt=()=>{const x=item(S.mxo.id),o=S.mxo;return o.custom?num(o.custom):Math.round(x.p*(1-o.pc/100)/500)*500};
const bad=()=>{const x=item(S.mxo.id),a=amt();return !(a>0&&a<x.p)};
const hint=()=>{const x=item(S.mxo.id),a=amt();
if(!a)return['var(--er)',t('Enter an amount.','Andika umubare.','Saisissez un montant.')];
if(a>=x.p)return['var(--er)',t('Your offer must be lower than the asking price.','Igiciro watanze kigomba kuba munsi y’icyasabwe.','Votre offre doit être inférieure au prix demandé.')];
if(a<x.p*.6)return['var(--mu)',t('Very low offers are often ignored. Try closer to the asking price.','Ibiciro biri hasi cyane akenshi ntibisubizwa. Gerageza kwegera icyasabwe.','Les offres très basses restent souvent sans réponse. Rapprochez-vous du prix demandé.')];
return['var(--mu)',''];};
const row=(l,v,b)=>`<div style="display:flex;justify-content:space-between;align-items:center;min-height:44px;font-size:${b?17:15}px;${b?'font-weight:800':''}"><span class="${b?'':'mu'}">${l}</span><span>${v}</span></div>`;
const sum=()=>{const x=item(S.mxo.id),a=amt(),ok=!bad(),sv=x.p-a;
return row(t('Asking price','Igiciro cyasabwe','Prix demandé'),fmt(x.p)+' RWF')+row(t('Your offer','Igiciro cyawe','Votre offre'),(a>0?fmt(a):'–')+' RWF',1)+(ok?row(t('You save','Uzigama','Vous économisez'),fmt(sv)+' RWF · '+Math.round(sv/x.p*100)+'%'):'')};
const lab=()=>{const a=amt();return t('Send offer','Ohereza igiciro','Envoyer l’offre')+(a>0&&!bad()?' · '+fmt(a)+' RWF':'')};
const draw=()=>{const x=item(S.mxo.id),o=S.mxo,last=S.mxOffs[x.id],hn=hint();
sh(`<div class="h1" style="font-size:22px;line-height:30px">${last?t('Update your offer','Hindura igiciro cyawe','Modifier votre offre'):t('Make an offer','Tanga igiciro','Faire une offre')}</div><div class="mu" style="font-size:15px;margin:8px 0 0">${esc(x.ti)} · ${fmt(x.p)} RWF</div>`
+(x.neg?'':`<div class="sm" style="margin-top:12px;line-height:20px;padding:10px 14px;border-radius:14px;background:var(--chip)">${t('The seller has not marked this price as negotiable. You can still send an offer.','Umugurisha ntiyavuze ko igiciro gishobora kugabanywa. Ushobora gutanga igiciro uko byagenda kose.','Le vendeur n’a pas indiqué un prix négociable. Vous pouvez quand même envoyer une offre.')}</div>`)
+(last?`<div class="sm mu" style="margin-top:10px">${t('Your last offer','Igiciro cyawe giheruka','Votre dernière offre')}: ${fmt(last)} RWF</div>`:'')
+`<div class="chp" id="mxoch" style="padding:16px 0 0">${[5,10,15].map(n=>chipBtn(!o.custom&&o.pc===n,`mkOffPc(${n})`,'−'+n+'%')).join('')}</div><div class="lab" style="margin-top:14px">${t('Or enter your own price','Cyangwa andika igiciro cyawe','Ou saisissez votre prix')}</div><input class="in" id="mxoc" inputmode="numeric" value="${esc(o.custom)}" oninput="mxoIn()" onkeydown="if(event.key==='Enter')mkOffSend()" aria-label="${t('Your offer (RWF)','Igiciro cyawe (RWF)','Votre offre (RWF)')}" placeholder="${fmt(Math.round(x.p*.9/500)*500)}" ${FLD}>`
+`<div id="mxosum" style="margin-top:16px;padding:4px 16px;border-radius:16px;background:var(--chip)">${sum()}</div><div id="mxow" role="status" class="sm" style="min-height:20px;margin-top:10px;line-height:20px;color:${hn[0]}">${hn[1]}</div><button class="btn" id="mxogo" style="margin-top:10px" ${bad()?'disabled':''} onclick="mkOffSend()">${lab()}</button><div class="sm mu" style="margin-top:12px;text-align:center;line-height:20px">${t('The seller replies in Messages. You only pay if you both agree.','Umugurisha agusubiriza muri Messages. Wishyura ari uko mwemeranyije.','Le vendeur répond dans Messages. Vous ne payez que si vous êtes d’accord.')}</div>`)};
window.mkOffer=id=>{S.mxo={id,pc:10,custom:''};draw()};
window.mkOffPc=n=>{S.mxo.pc=n;S.mxo.custom='';draw()};
window.mxoIn=()=>{const i=$('#mxoc');S.mxo.custom=fmtIn(i.value);i.value=S.mxo.custom;const hn=hint(),w=$('#mxow');
$('#mxosum').innerHTML=sum();w.textContent=hn[1];w.style.color=hn[0];const g=$('#mxogo');g.disabled=bad();g.textContent=lab();
document.querySelectorAll('#mxoch button').forEach(b=>{b.classList.remove('on');b.setAttribute('aria-pressed','false')})};
window.mkOffSend=()=>{if(!S.mxo||bad())return;const x=item(S.mxo.id),a=amt(),th='hdmarket'+x.id,m='Hi, would you accept '+fmt(a)+' RWF for "'+x.ti+'"?';
hdThread(th,x.who,x.ti,[['me',m]]);if(S.msgs[th].length>1||S.msgs[th][0][1]!==m)S.msgs[th].push(['me',m]);S.mxOffs[x.id]=a;
closeSheet();S.tab='messages';openChat(th);toast(t('Offer sent','Igiciro cyoherejwe','Offre envoyée'))};
document.title=document.title.replace(/v\d+/,'v321');}
</script>
<style id="v322">
/* v322: calmer filter sheets */
#phone .fsel{width:100%;height:46px;border:0;border-radius:14px;background:var(--chip);color:var(--tx);font:inherit;font-size:16px;font-weight:700;padding:0 12px;margin-top:8px}
#phone .fseg{display:flex;gap:2px;padding:3px;margin-top:8px;border-radius:14px;background:var(--chip)}
#phone .fseg button{flex:1;min-width:0;min-height:42px;border:0;border-radius:11px;background:none;color:var(--tx);font:inherit;font-size:14px;font-weight:700;line-height:16px;padding:0 4px}
#phone .fseg button.on{background:var(--bg);box-shadow:inset 0 0 0 2px var(--lk)}
#phone .fck{display:grid;grid-template-columns:1fr 1fr;gap:0 16px;margin-top:4px}
#phone .fck button{display:flex;align-items:center;gap:10px;min-height:44px;border:0;background:none;color:var(--tx);font:inherit;font-size:15px;font-weight:600;text-align:left;padding:0}
#phone .fck i{flex:0 0 22px;height:22px;border-radius:7px;border:2px solid var(--tt);box-sizing:border-box;display:flex;align-items:center;justify-content:center;color:#fff;font-style:normal;font-size:14px;line-height:1}
#phone .fck button.on i{background:var(--lk);border-color:var(--lk)}
#phone .fsw{display:flex;width:100%;align-items:center;justify-content:space-between;gap:12px;min-height:52px;border:0;background:none;color:var(--tx);font:inherit;font-size:15px;font-weight:700;text-align:left;padding:0}
#phone .fsec{margin-top:20px}
#phone .fsec>.lab{margin-top:0;font-weight:700;color:var(--tx);font-size:14px}
</style>
<script>
/* v322: Filter. Before: each Filter sheet was a wall of pill chips (Property had about 25: area, type, price, 8 must-haves and three on/off options as chips; Marketplace and Jobs had the same pattern), so single choices, multiple choices and on/off options all looked alike. Now each kind of choice has its own quiet control: Area and Type are a dropdown, a few exclusive options (price, pay type, max price) are one segmented control, multiple choices (condition, must-haves) are plain checkboxes, and on/off options are switches. Show N now counts exactly what the list will show, including the category and search you already set, and says "No matches" instead of "Show 0". Reset is off until a filter is on, and the Show button stays in view while the sheet scrolls. Applies to Marketplace, Jobs and Property. rw and fr need native review. */
{const t=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e;
const esc=s=>String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/"/g,'&quot;');
const sh=h=>{$('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" style="max-height:86%;overflow-y:auto">'+h+'</div>'};
const cnt=()=>{try{return (screens.hood().match(/class="hdc"/g)||[]).length}catch(e){return 0}};
const sec=(l,b)=>`<div class="fsec"><div class="lab">${l}</div>${b}</div>`;
const arg=v=>typeof v==='number'?v:`'${v}'`;
const sel=(k,val,opts,l)=>`<select class="fsel" aria-label="${esc(l)}" onchange="v322('${k}',this.value)">${opts.map(([v,n])=>`<option value="${esc(v)}"${v===val?' selected':''}>${esc(n)}</option>`).join('')}</select>`;
const seg=(k,val,opts)=>`<div class="fseg" role="group">${opts.map(([v,n])=>`<button class="${v===val?'on':''}" aria-pressed="${v===val}" onclick="v322('${k}',${arg(v)})">${esc(n)}</button>`).join('')}</div>`;
const ck=(k,arr,opts)=>`<div class="fck">${opts.map(([v,n])=>{const on=arr.includes(v);return `<button class="${on?'on':''}" aria-pressed="${on}" onclick="v322t('${k}','${v}')"><i aria-hidden="true">${on?'✓':''}</i>${esc(n)}</button>`}).join('')}</div>`;
const sw=(k,on,l)=>`<button class="fsw" role="switch" aria-checked="${!!on}" onclick="v322s('${k}')"><span>${l}</span><span class="sw ${on?'on':''}"><i></i></span></button>`;
let cur=null;
const draw=()=>{const o=document.querySelector('#layer .sheet'),y=o?o.scrollTop:0,n=cnt(),a=cur.active();
sh(`<div class="h1" style="font-size:22px;line-height:30px">${t('Filter','Hitamo','Filtrer')}</div>${cur.body()}<div style="position:sticky;bottom:0;margin:20px -24px -28px;padding:12px 24px 28px;background:var(--bg);border-top:1px solid var(--ln)"><div class="row2"><button class="btn sec2" ${a?'':'disabled'} onclick="v322r()">${t('Reset','Subiramo','Réinitialiser')}</button><button class="btn" ${n?'':'disabled'} onclick="v322a()">${n?t('Show ','Erekana ','Voir ')+n:t('No matches','Nta bihuye','Aucun résultat')}</button></div></div>`);
const p=document.querySelector('#layer .sheet');if(p&&y)p.scrollTop=y};
window.v322=(k,v)=>{cur.set(k,v);draw()};
window.v322t=(k,v)=>{const a=cur.arr(k),i=a.indexOf(v);i<0?a.push(v):a.splice(i,1);draw()};
window.v322s=k=>{cur.flip(k);draw()};
window.v322r=()=>{cur.reset();draw()};
window.v322a=()=>{closeSheet();cur.apply()};
const alertToast=on=>toast(on?t('Alerts on. We will notify you (sample).','Imenyesha zifunguye (urugero).','Alertes activées (exemple).'):t('Alerts off','Imenyesha zafunzwe','Alertes désactivées'));
const allAreas=t('All areas','Ahantu hose','Tous les quartiers');
const anyL=t('Any','Byose','Tous');
/* ---- Marketplace ---- */
window.mxFilt=()=>{const H=HD.market,F=()=>S.mxf;
const CD=[['new',t('New','Gishya','Neuf')],['like',t('Like new','Nka gishya','Comme neuf')],['good',t('Good','Meza','Bon')],['fair',t('Fair','Biremewe','Correct')]];
cur={active:()=>F().cond.length+(F().max?1:0)+(F().hood?1:0),
body:()=>sec(t('Max price (RWF)','Igiciro ntarengwa (RWF)','Prix maximum (RWF)'),seg('max',F().max,[[0,anyL],[20000,'20k'],[50000,'50k'],[100000,'100k']]))+sec(t('Area','Agace','Quartier'),sel('hood',F().hood||'',[['',allAreas]].concat(window.MXAREAS.map(a=>[a,a])),t('Area','Agace','Quartier')))+sec(t('Condition','Imiterere','État'),ck('cond',F().cond,CD)),
set:(k,v)=>{F()[k]=k==='max'?Number(v):v},arr:k=>F()[k],flip:()=>{},
reset:()=>{S.mxf={cond:[],max:0,hood:''}},apply:()=>window.rf2()};draw()};
/* ---- Jobs ---- */
window.jbFilt=()=>{const H=HD.jobs,F=()=>S.jbfl;
const U=[['day',t('day','munsi','jour')],['task',t('task','gikorwa','mission')],['month',t('month','kwezi','mois')]].map(([k,v])=>[k,t('Per ','Ku ','Par ')+v]);
cur={active:()=>(F().area?1:0)+(F().unit?1:0)+(F().hide?1:0),
body:()=>sec(t('Area','Agace','Quartier'),sel('area',F().area||'',[['',allAreas]].concat([...new Set(H.items.map(x=>x.loc))].slice(0,8).map(a=>[a,a])),t('Area','Agace','Quartier')))+sec(t('Pay type','Uburyo bwo kwishyurwa','Type de paie'),seg('unit',F().unit||'',[['',anyL]].concat(U)))+`<div class="fsec">${sw('hide',F().hide,t('Hide filled jobs','Hisha akazi kamaze kuboneka','Masquer les offres pourvues'))}${sw('alert',S.jbAlert,t('Alert me about new matching jobs','Menyesha ku kazi gashya gahuye','M’alerter pour les nouvelles offres'))}</div>`,
set:(k,v)=>{F()[k]=v},arr:()=>[],flip:k=>{if(k==='alert'){S.jbAlert=S.jbAlert?0:1;alertToast(S.jbAlert)}else F()[k]=F()[k]?0:1},
reset:()=>{S.jbfl={area:'',unit:'',hide:0}},apply:()=>window.jbCat(S.jbCat)};draw()};
/* ---- Property ---- */
window.pFilt=()=>{const H=HD.property,f=()=>S.pf;
const KD=[['apt',t('Apartment','Inzu y’ibyumba','Appartement')],['house',t('House','Inzu','Maison')],['room',t('Room','Icyumba','Chambre')],['shop',t('Shop','Iduka','Boutique')],['land',t('Land','Ubutaka','Terrain')]];
const AM=[['water',t('Water','Amazi','Eau')],['power',t('Power','Amashanyarazi','Électricité')],['park',t('Parking','Parikingi','Parking')],['sec',t('Security','Umutekano','Sécurité')],['net',t('Internet','Interineti','Internet')],['gar',t('Garden','Ubusitani','Jardin')],['lift',t('Lift','Lifuti','Ascenseur')],['bal',t('Balcony','Balikoni','Balcon')]];
const BD=[t('Any price','Igiciro cyose','Tout prix'),t('Budget','Gito','Petit budget'),t('Mid-range','Hagati','Moyen'),t('Premium','Hejuru','Haut de gamme')].map((l,i)=>[i,l]);
cur={active:()=>(f().area?1:0)+(f().kind?1:0)+(f().band?1:0)+f().am.length+(f().furn?1:0)+(f().hide?1:0),
body:()=>`<div class="fsec" style="display:flex;gap:12px"><div style="flex:1;min-width:0"><div class="lab" style="margin-top:0;font-weight:700;color:var(--tx);font-size:14px">${t('Area','Agace','Quartier')}</div>${sel('area',f().area||'',[['',allAreas]].concat([...new Set(H.items.map(x=>x.loc))].map(a=>[a,a])),t('Area','Agace','Quartier'))}</div><div style="flex:1;min-width:0"><div class="lab" style="margin-top:0;font-weight:700;color:var(--tx);font-size:14px">${t('Property type','Ubwoko bw’inzu','Type de bien')}</div>${sel('kind',f().kind||'',[['',anyL]].concat(KD),t('Property type','Ubwoko bw’inzu','Type de bien'))}</div></div>`
+sec(t('Price','Igiciro','Prix'),seg('band',f().band||0,BD)+`<div class="sm mu" style="margin-top:8px;line-height:18px">${t('Rent: under 100k, 100k to 300k, over 300k a month. Sale: under 50M, 50M to 150M, over 150M.','Gukodesha: munsi ya 100k, 100k–300k, hejuru ya 300k ku kwezi. Kugurisha: munsi ya 50M, 50M–150M, hejuru ya 150M.','Location : moins de 100k, 100k à 300k, plus de 300k par mois. Vente : moins de 50M, 50M à 150M, plus de 150M.')}</div>`)
+sec(t('Must have','Ibigomba kuba bihari','Indispensable'),ck('am',f().am,AM))
+`<div class="fsec">${sw('furn',f().furn,t('Furnished only','Irimo ibikoresho gusa','Meublé seulement'))}${sw('hide',f().hide,t('Hide rented / sold','Hisha ibyakodeshejwe / ibyagurishijwe','Masquer loués / vendus'))}${sw('alert',S.pAl,t('Alert me about new matches','Menyesha ku bishya bihuye','Alertes nouveautés'))}</div>`,
set:(k,v)=>{f()[k]=k==='band'?Number(v):v},arr:k=>f()[k],flip:k=>{if(k==='alert'){S.pAl=S.pAl?0:1;alertToast(S.pAl)}else f()[k]=f()[k]?0:1},
reset:()=>window.pFr(),apply:()=>render('fade-none')};draw()};
document.title=document.title.replace(/v\d+/,'v322');}
</script>
<style id="v323css">
/* v323: Name your pocket */
.npg .npsub{font-size:15px;line-height:22px;margin:8px 0 0}
.npg label.lab{display:block;margin-top:28px}
.npg .npr{display:flex;align-items:center;gap:16px;margin-top:8px}
.npg .npr .pkico{flex:none}
.npg .npf{position:relative;flex:1;min-width:0}
.npg .npf .in{padding-right:48px}
.npg .npcount{position:absolute;right:0;top:0;height:52px;line-height:52px;font-size:13px;font-weight:600;color:var(--mu)}
.npg .npe{min-height:20px;margin-top:6px;font-size:13px;line-height:18px;font-weight:600;color:var(--er)}
.npg .npch{display:flex;flex-wrap:wrap;gap:8px;margin-top:8px}
.npg .npch button{display:inline-flex;align-items:center;gap:6px;height:44px;padding:0 16px 0 12px;border-radius:22px;border:0;background:var(--chip);color:var(--tx);font:inherit;font-weight:700;font-size:15px}
.npg .npch button.on{background:var(--tx);color:var(--bg)}
.npg .in::placeholder{font-weight:500;color:var(--mu);opacity:.7}
.npg .npi{display:flex;flex-wrap:wrap;gap:8px;margin-top:8px;padding:2px}
.npg .npi button{width:44px;height:44px;border-radius:22px;border:0;background:var(--chip);display:flex;align-items:center;justify-content:center;padding:0}
.npg .npi button.on{box-shadow:0 0 0 2px var(--tx)}
</style>
<script>
/* v323: Name your pocket. Before: a bare name field with Cancel / Create, "Enter a name" or "You already have a pocket with that name" only as a toast after tapping Create, nothing to tell you the 10-pocket limit until you hit it, no icon choice (every new pocket got the same wallet), English only. Now: one page with a short line saying what a pocket is for, the pocket's icon next to the name field and updating as you choose, a 0/20 counter, the "already have that name" and "up to 10 pockets" messages shown under the field as you type (so Create is simply off instead of failing), quick ideas (Trip, Phone, Rent, Gift, Wedding, Food; the ones you already have are hidden) that fill the name and icon, an icon row for any other name, and one "Create pocket" button (Back replaces Cancel; Enter creates). The same checks now run in the quick Trip / Phone chips on the Pockets page. English, French and Kinyarwanda; fr is new copy and rw is new copy that needs native review, like v166 and v217 to v222, especially "Tanga izina ry’agasanduku" and "Kora agasanduku". */
{
const t3=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e;
const IDEAS=[['Trip','Urugendo','Voyage','bus'],['Phone','Telefoni','Téléphone','phone'],['Rent','Ubukode','Loyer','home'],['Gift','Impano','Cadeau','gift'],['Wedding','Ubukwe','Mariage','star'],['Food','Ibiribwa','Courses','food']];
const ICONS=[['wallet','Wallet','Igikapu','Portefeuille'],['bus','Trip','Urugendo','Voyage'],['phone','Phone','Telefoni','Téléphone'],['home','Home','Urugo','Maison'],['gift','Gift','Impano','Cadeau'],['star','Celebration','Ibirori','Fête'],['food','Food','Ibiribwa','Courses']];
const nm=()=>((S.np&&S.np.n)||'').trim();
const MAXE=()=>t3('You can have up to 10 pockets. Delete one to add another.','Ushobora kugira udusanduku 10 gusa. Siba kamwe kugira ngo wongereho.','Vous pouvez avoir 10 poches au maximum. Supprimez-en une pour en ajouter.');
const DUPE=()=>t3('You already have a pocket with that name','Usanzwe ufite agasanduku gafite iryo zina','Vous avez déjà une poche portant ce nom');
const err=()=>{if(S.pk.length>=10)return MAXE();const n=nm().toLowerCase();return n&&S.pk.some(x=>x.n.toLowerCase()===n)?DUPE():''};
window.npUpd=function(){const n=nm(),e=err(),i=$('#pkn');if(!i)return;
$('#npe').textContent=e;i.setAttribute('aria-invalid',e?'true':'false');
$('#npcount').textContent=(S.np.n||'').length+'/20';
$('#npic').innerHTML=pkIco({g:S.np.g},56);
$('#nps').disabled=!n||!!e;
document.querySelectorAll('#npch button').forEach(b=>{const on=b.dataset.n.toLowerCase()===n.toLowerCase();b.classList.toggle('on',on);b.setAttribute('aria-pressed',on?'true':'false')});
document.querySelectorAll('#npi button').forEach(b=>{const on=b.dataset.g===S.np.g;b.classList.toggle('on',on);b.setAttribute('aria-pressed',on?'true':'false')})};
window.npName=v=>{S.np.n=v;npUpd()};
window.npIcon=g=>{S.np.g=g;npUpd()};
window.npIdea=(n,g)=>{S.np.n=n;S.np.g=g;const i=$('#pkn');i.value=n;npUpd();i.focus()};
window.npGo=()=>{if($('#nps').disabled)return;pkAdd(S.np.n,S.np.g)};
window.pkNew=function(){S.np={n:'',g:'wallet'};const used=S.pk.map(x=>x.n.toLowerCase());
const ideas=IDEAS.filter(x=>!used.includes(x[0].toLowerCase())&&!used.includes(t3(x[0],x[1],x[2]).toLowerCase()));
const title=t3('Name your pocket','Tanga izina ry’agasanduku','Nommez votre poche');
$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet npg" role="dialog" aria-modal="true" aria-label="${title}"><div class="h1" style="font-size:22px;line-height:30px">${title}</div><div class="mu npsub">${t3('Set money aside for something specific. You can rename it any time.','Bika amafaranga ku kintu runaka. Ushobora guhindura izina igihe cyose.','Mettez de l’argent de côté pour un projet précis. Vous pourrez la renommer à tout moment.')}</div>
<label class="lab" for="pkn">${t3('Pocket name','Izina ry’agasanduku','Nom de la poche')}</label><div class="npr"><div id="npic">${pkIco({g:'wallet'},56)}</div><div class="npf"><input class="in" id="pkn" maxlength="20" autocomplete="off" placeholder="${t3('For example, Wedding','Urugero: Ubukwe','Par exemple : Mariage')}" aria-describedby="npe" aria-invalid="false" oninput="npName(this.value)" onkeydown="if(event.key==='Enter')npGo()"><span class="npcount" id="npcount" aria-hidden="true">0/20</span></div></div><div class="npe" id="npe" role="alert">${S.pk.length>=10?MAXE():''}</div>
${ideas.length?`<div class="lab" style="margin-top:12px">${t3('Quick ideas','Ibitekerezo byihuse','Idées rapides')}</div><div class="npch" id="npch" role="group">${ideas.map(x=>{const l=t3(x[0],x[1],x[2]);return `<button data-n="${esc48(l)}" aria-pressed="false" onclick="npIdea(this.dataset.n,'${x[3]}')">${gx(x[3],20)}${esc48(l)}</button>`}).join('')}</div>`:''}
<div class="lab" style="margin-top:${ideas.length?24:12}px">${t3('Icon','Ikirango','Icône')}</div><div class="npi" id="npi" role="group">${ICONS.map(x=>`<button data-g="${x[0]}" aria-pressed="${x[0]==='wallet'}" class="${x[0]==='wallet'?'on':''}" aria-label="${t3(x[1],x[2],x[3])}" onclick="npIcon('${x[0]}')">${gx(x[0],26)}</button>`).join('')}</div>
<button class="btn" id="nps" style="margin-top:28px" disabled onclick="npGo()">${t3('Create pocket','Kora agasanduku','Créer la poche')}</button></div>`;
setTimeout(()=>{const i=$('#pkn');i&&i.focus()},60)};
window.pkAdd=function(n,g){n=(n||'').trim().slice(0,20);
if(!n){toast(t3('Enter a name','Andika izina','Saisissez un nom'));return}
if(S.pk.length>=10){toast(t3('You can have up to 10 pockets','Ushobora kugira udusanduku 10 gusa','Vous pouvez avoir 10 poches au maximum'));return}
if(S.pk.some(x=>x.n.toLowerCase()===n.toLowerCase())){toast(DUPE());return}
const p={id:'p'+Date.now(),n,g:g||'wallet',b:0,ir:0,h:[]};S.pk.push(p);closeSheet();openPocket(p.id);
toast(t3(n+' pocket created','Agasanduku '+n+' kakozwe','Poche '+n+' créée'))};
}
document.title=document.title.replace(/v\d+/,'v323');
</script>

<style id="v324css">
/* v324: empty pocket */
.pkem{padding:28px 24px 0}
.pkem .pkemt{font-size:18px;font-weight:800;letter-spacing:-.2px;line-height:26px}
.pkem .pkems{margin-top:6px;font-size:15px;line-height:22px;color:var(--mu)}
.pkem .pkemb{margin-top:12px;height:44px;padding:0 16px;border-radius:22px;border:0;background:var(--chip);color:var(--tx);font:inherit;font-weight:700;font-size:15px}
</style>
<script>
/* v324: Empty pocket. Before: a pocket with 0 RWF (the Interest jar, or any pocket you just created) showed a bottom bar where "Fill", the only thing you can do, was squeezed into a thin sliver next to a greyed-out "Take out" and a cramped "Nothing to take out yet." note; above it, an "All" filter with nothing to filter and a grey line saying "No activity yet." Now: when a pocket has nothing in it, the bottom bar is one full-width "Fill" button (no disabled Take out, no note), the filter row is gone, and the empty state says what the pocket is waiting for ("Nothing here yet", how much you have in itunda Bank to fill it from) with a "Set up auto-fill" shortcut. A pocket that has money, or one that was emptied (so it still has history), keeps the two buttons and the list as before; an emptied pocket gets the single Fill button and keeps its history. English, French and Kinyarwanda; fr is new copy and rw is new copy that needs native review, especially "Nta kintu kirimo ubu" and "Shyiraho kuzuza byikora". */
{
const t3=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e;
const _p=screens.pocket;
screens.pocket=function(){let h=_p.apply(this,arguments);const p=pkGet(S.pkId);if(!p||pkBal(p)>0)return h;
const hist=(p.h||[]).length;
const fill=t3('Fill','Uzuza','Alimenter');
const cta=`<div class="cta"><button class="btn" style="height:52px;font-size:16px;border-radius:16px" onclick="openMv('in')">${fill}</button></div>`;
h=h.replace(/<div class="cta"[\s\S]*?<\/div>\s*$/,cta);
if(!hist){
const em=`<div class="pkem"><div class="pkemt">${t3('Nothing here yet','Nta kintu kirimo ubu','Rien ici pour l’instant')}</div><div class="pkems">${t3('Fill it from itunda Bank, which has '+fmt(S.bank)+' RWF. Or let it fill itself.','Uyuzuze uhereye kuri itunda Bank ifite '+fmt(S.bank)+' RWF. Cyangwa ureke yiyuzuze.','Alimentez-la depuis itunda Bank, qui contient '+fmt(S.bank)+' RWF. Ou laissez-la se remplir seule.')}</div><button class="pkemb" onclick="autoSheet()">${t3('Set up auto-fill','Shyiraho kuzuza byikora','Activer le remplissage auto')}</button></div>`;
h=h.replace(/<button class="pkf"[\s\S]*?<\/button>/,'').replace(/<div class="pkempty">[\s\S]*?<\/div>/,em)}
return h};
}
document.title=document.title.replace(/v\d+/,'v324');
</script>

<script>
/* v325: Home pockets. Before: the Pockets section on Home was the only list there with no icon, so "School fees" and "Emergency fund" looked like captions next to a Fill button while Bills and the accounts above all lead with an icon. Each pocket row now starts with that pocket's own icon, the same one shown in the Pockets list and on the pocket page. No text changed, so rw and fr need nothing new. */
{
const _h=screens.home;
screens.home=function(){let h=_h.apply(this,arguments);
h=h.replace(/(<div class="hr tap"[^>]*onclick="openPocket\('([\w-]+)'\)"[^>]*>)(<div class="hm">)/g,(m,a,id,b)=>{const p=pkGet(id);return p?a+pkIco(p,44)+b:m});
return h};
}
document.title=document.title.replace(/v\d+/,'v325');
</script>
<script>
/* v326: School fees icon. Before: the School fees pocket used the same receipt picture as the electricity bill, so on Home the two rows looked alike and you could not tell a pocket from a bill by its icon. School now uses the graduation cap (already in the icon set) everywhere it appears: Home, the Pockets list, the pocket page and the Manage sheet. No text changed. */
delete GM.school;
document.title=document.title.replace(/v\d+/,'v326');
</script>
<script>
/* v327: Pockets list goal. Before: a pocket with a savings goal showed a short unlabeled bar under its balance, so you could see it was part-way but not toward what. The bar now spans the row and a line under it says how far along you are, like "40% of 300,000 RWF", the same wording the pocket page uses. Pockets without a goal are unchanged. rw and fr need native review. */
{
const t3=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e;
const _l=screens.pockets;
screens.pockets=function(){let h=_l.apply(this,arguments);if(typeof h!=='string')return h;
S.pk.filter(p=>p.t).forEach(p=>{const pct=Math.min(100,Math.round(pkBal(p)/p.t*100));
const re=new RegExp(`(onclick="openPocket\\('${p.id}'\\)"[^>]*>[\\s\\S]*?)<div class="pkbar"[^>]*><i style="width:\\d+%"></i></div>`);
const f=t3(pct+'% of '+fmt(p.t)+' RWF',pct+'% kuri '+fmt(p.t)+' RWF',pct+' % de '+fmt(p.t)+' RWF');
h=h.replace(re,`$1<div class="pkbar" role="progressbar" aria-valuenow="${pct}" aria-valuemin="0" aria-valuemax="100" style="margin-top:8px;height:6px"><i style="width:${pct}%"></i></div><div class="pks" style="margin-top:6px">${f}</div>`)});
return h};
}
document.title=document.title.replace(/v\d+/,'v327');
</script>
<style id="v328">
/* v328: Home buttons in rw/fr. Before: the pill buttons on Home (Add money, Pay, Fill, View) were forced to one line, so a longer word like "Ongeramo amafaranga" or "Ajouter de l'argent" ran past the edge of its pill and was cut off at the screen edge. The pill now keeps its shape for short words and wraps to two centred lines when the word is long. No text changed. */
.hr .hp{white-space:normal!important;height:auto!important;min-height:44px;max-width:132px;padding:6px 14px!important;line-height:17px!important;text-align:center;overflow-wrap:anywhere}
</style>
<script>
document.title=document.title.replace(/v\d+/,'v328');
</script>
<script>
/* v329: dates and "From". Before: in Kinyarwanda and French the Pay account and Activity lists still showed English dates ("Tue, 13 Oct", "Mon, 12 Oct", the month picker "October") and the row "From MTN MoMo", next to Kinyarwanda or French labels. Weekdays, months and "From …" are now translated wherever they appear on a screen. rw and fr need native review. */
{
const D={rw:{Mon:'Kuwa mbere',Tue:'Kuwa kabiri',Wed:'Kuwa gatatu',Thu:'Kuwa kane',Fri:'Kuwa gatanu',Sat:'Kuwa gatandatu',Sun:'Ku cyumweru',
Monday:'Kuwa mbere',Tuesday:'Kuwa kabiri',Wednesday:'Kuwa gatatu',Thursday:'Kuwa kane',Friday:'Kuwa gatanu',Saturday:'Kuwa gatandatu',Sunday:'Ku cyumweru',
Jan:'Mutarama',Feb:'Gashyantare',Mar:'Werurwe',Apr:'Mata',May:'Gicurasi',Jun:'Kamena',Jul:'Nyakanga',Aug:'Kanama',Sep:'Nzeri',Oct:'Ukwakira',Nov:'Ugushyingo',Dec:'Ukuboza',
January:'Mutarama',February:'Gashyantare',March:'Werurwe',April:'Mata',June:'Kamena',July:'Nyakanga',August:'Kanama',September:'Nzeri',October:'Ukwakira',November:'Ugushyingo',December:'Ukuboza'},
fr:{Mon:'lun.',Tue:'mar.',Wed:'mer.',Thu:'jeu.',Fri:'ven.',Sat:'sam.',Sun:'dim.',Monday:'Lundi',Tuesday:'Mardi',Wednesday:'Mercredi',Thursday:'Jeudi',Friday:'Vendredi',Saturday:'Samedi',Sunday:'Dimanche',
Jan:'janv.',Feb:'févr.',Mar:'mars',Apr:'avr.',May:'mai',Jun:'juin',Jul:'juil.',Aug:'août',Sep:'sept.',Oct:'oct.',Nov:'nov.',Dec:'déc.',
January:'Janvier',February:'Février',March:'Mars',April:'Avril',June:'Juin',July:'Juillet',August:'Août',September:'Septembre',October:'Octobre',November:'Novembre',December:'Décembre'}};
const W='Mon|Tue|Wed|Thu|Fri|Sat|Sun|Monday|Tuesday|Wednesday|Thursday|Friday|Saturday|Sunday',M='Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec|January|February|March|April|June|July|August|September|October|November|December';
const rx=new RegExp('\\b('+W+'|'+M+')\\b','g');
const tr=x=>{const m=D[S.lang];if(!m)return x;
x=x.replace(/^(\s*)From (.+?)(\s*)$/,(a,p,n,q)=>p+(S.lang==='rw'?'Kuva kuri ':'De ')+n+q);
if(!/^\s*(?:(?:Mon|Tue|Wed|Thu|Fri|Sat|Sun)[a-z]*,?\s*)?(?:\d{1,2}\s+)?(?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)[a-z]*(?:\s+\d{1,4})?\s*$|^\s*(?:Mon|Tue|Wed|Thu|Fri|Sat|Sun)[a-z]*\s*$/.test(x))return x;
return x.replace(rx,w=>m[w]||w)};
Object.keys(screens).forEach(k=>{const f=screens[k];if(typeof f!=='function')return;
screens[k]=function(){const h=f.apply(this,arguments);return typeof h==='string'&&S.lang!=='en'?h.replace(/>([^<>]+)</g,(a,x)=>'>'+tr(x)+'<'):h}});
}
document.title=document.title.replace(/v\d+/,'v329');
</script>
<style id="v330">
/* v330: Pay from and Home edge. Before: on the Pay tab the two "Pay from" options were different-width pills stacked in a ragged column, with the balance squeezed into the same line as the name. They are now two equal full-width rows with the account on the left and its balance on the right, so you can compare the balances at a glance. On Home the "All" link ended 10 px short of the "See all" links below it; it now lines up with them, and the gap under the Bills / Card / Savings strip is a little tighter. No wording changed except that the balance now shows "RWF". */
.v174 .req:has(button[onclick^="ppSrc"]){display:flex;flex-direction:column;gap:8px}
.v174 .req button[onclick^="ppSrc"]{display:flex;align-items:center;justify-content:space-between;gap:12px;width:100%;min-height:52px;padding:12px 18px;border-radius:16px;text-align:left}
.v174 .req button[onclick^="ppSrc"] b{font-weight:800}
.v174 .req button[onclick^="ppSrc"] span{font-variant-numeric:tabular-nums}
.hc .hf{padding-right:14px!important}
.hc:has(.hf)+.hc{padding-top:8px!important}
</style>
<script>
{
const _p=screens.pay;
screens.pay=function(){let h=_p.apply(this,arguments);if(typeof h!=='string')return h;
return h.replace(/(<button[^>]*onclick="ppSrc\('[\w-]+'\)"[^>]*>)([^<>]+?) · ([\d,]+)(<\/button>)/g,(m,a,n,v,z)=>a+'<span>'+n+'</span><span><b>'+v+'</b> RWF</span>'+z)};
}
document.title=document.title.replace(/v\d+/,'v330');
</script>
<style id="v331">
/* v331: Pockets list, add buttons. Before: the three add buttons (Trip, Phone, Custom) wrapped onto two rows of different lengths, so the last one sat alone under the others. They now share one row as three equal buttons, the same way the day-limit amounts sit on a single line. No text changed. */
.pkchips{display:grid!important;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}
.pkchips .chip{justify-content:center;gap:4px;padding-left:6px;padding-right:6px;white-space:nowrap;overflow:visible}
.pkchips .chip svg{flex:none}
</style>
<script>document.title=document.title.replace(/v\d+/,'v331');</script>
<script>
/* v332: Subscriptions summary. Before: "Left to pay this month" and "Next 7 days" sat in a grey rounded box, the only boxed block on an otherwise flat page, and the box was inset 16 px so its text did not line up with the total above it. The two lines now sit directly on the page, aligned with the total and the list below. No text changed. */
{
const _s=screens.subs;
screens.subs=function(){let h=_s.apply(this,arguments);if(typeof h!=='string')return h;
return h.replace('margin:16px 24px 0;padding:6px 16px;border-radius:20px;background:var(--chip)','margin:8px 24px 0;padding:0')};
}
document.title=document.title.replace(/v\d+/,'v332');
</script>
<style id="v333">
/* v333: Messages, conversation options. Before: the "⋯" button on each conversation was drawn at 40% opacity, about 1.9:1 against the white page, so it was hard to see and easy to miss on a bright screen. It is now drawn at a level that reaches about 3:1, the minimum for a control icon, and stays visibly secondary to the message text. Position and tap area did not change. No text changed. */.mm-more{opacity:.75!important}
</style>
<script>document.title=document.title.replace(/v\d+/,'v333');</script>
<script>
/* v334: Settings title. Before: Settings was the only pushed screen whose top bar showed just the back arrow and no title, so after tapping "Settings" on Explore nothing on the screen said where you were. The bar now reads "Settings" like Bank, Benefits and Transit. It uses the same word as the Explore link, so it follows the chosen language. Nothing else moved. */
{
const _st=screens.settings;
screens.settings=function(){let h=_st.apply(this,arguments);if(typeof h!=='string')return h;
return h.replace('<b></b>','<b>Settings</b>')};
}
document.title=document.title.replace(/v\d+/,'v334');
</script>
<style id="v335">
/* v335: Edit profile. Before: (1) Cancel and Save were 10 px out of line, because Save inherited a stacking margin meant for a single button above another; (2) the chosen avatar was only a faint tint, so it was hard to tell which one was selected; (3) the nickname field had no visible label, only a line under the text. Now: the two buttons share one baseline; the chosen avatar has a clear ring and is announced as selected; the field has a "Nickname" label above it and a count (such as 11/16) that follows what you type. Nothing else changed. */
.v335 .row2 .btn{margin-top:0!important}
.v335 .av5{display:flex;gap:8px;margin:14px 0 22px}
.v335 .av5 button{width:48px;height:48px;font-size:26px;border-radius:16px;background:var(--chip);border:2px solid transparent;padding:0}
.v335 .av5 button[aria-pressed=true]{background:var(--tint);border-color:var(--lk)}
.v335 .nl{display:flex;justify-content:space-between;font-size:13px;color:var(--mu);font-weight:600}
.v335 .in{margin-top:4px}
</style>
<script>
{
const _me=window.mpfEdit;
window.mpfEdit=function(){
 const cur=document.getElementById('mpn');if(cur&&S.mpf)S.mpf.n=cur.value;
 const o=_me.apply(this,arguments);
 const sh=document.querySelector('.sheet');if(!sh)return o;
 const inp=sh.querySelector('#mpn');if(!inp||sh.querySelector('.nl'))return o;
 const av=inp.previousElementSibling;if(av){av.classList.add('av5');av.setAttribute('role','group');av.setAttribute('aria-label','Avatar');av.removeAttribute('style');av.querySelectorAll('button').forEach(b=>b.setAttribute('aria-pressed',String(b.textContent.trim()===S.mpf.a)))}
 const nl=document.createElement('div');nl.className='nl';nl.innerHTML='<label for="mpn">Nickname</label><span id="mpc"></span>';
 const upd=()=>{nl.lastChild.textContent=[...inp.value].length+'/16'};upd();inp.addEventListener('input',upd);
 inp.parentNode.insertBefore(nl,inp);inp.removeAttribute('aria-label');
 sh.querySelector('.cta,.v6cta,.row2')&&0;
 (inp.closest('.sheet')||sh).classList.add('v335');
 return o};
}
document.title=document.title.replace(/v\d+/,'v335');
</script>
<style id="v336">
/* v336: Foreign currency. Before: (1) the total value of what you hold was a small grey line at the very bottom, under the wallets; (2) the rate chart and rate alert sat between the amount and "Your wallets", so the money you hold was pushed below a screen of chart; (3) "Sell" looked tappable even with nothing to sell, and led to a screen where every amount gave an error; switching to a currency you did not hold while on Sell did the same. Now: (1) when you hold foreign currency, the top of the screen shows its total in RWF in large type; (2) the order is amount, wallets, rate chart and alert, recent conversions; (3) with an empty wallet the Sell tab is greyed and tapping it says "You hold no USD to sell yet" instead of switching, and changing currency on Sell falls back to Buy when that wallet is empty. Conversion, review sheet, result sheet, Activity and the rate alert are unchanged. English, French and Kinyarwanda; fr and rw are new copy and the Kinyarwanda needs native review. */
.v336h{padding:10px 24px 0}.v336h .sm{font-weight:600}.v336h b{display:block;font-size:30px;line-height:38px;letter-spacing:-.6px;margin-top:2px}
.v336off{opacity:.45}
</style>
<script>
{
const t3=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e,CODES=['USD','EUR','GBP'],RATE={USD:1445,EUR:1680,GBP:1960};
const held=c=>((S.fx&&S.fx.w&&S.fx.w[c])||0)>0.004;
const _s=screens.fx;
screens.fx=function(){let h=_s.apply(this,arguments);if(typeof h!=='string')return h;
 const x=S.fx,c=CODES[x.c]||'USD';
 /* 1. total on top, old bottom line removed */
 const tot=CODES.reduce((a,k)=>a+Math.round(((x.w&&x.w[k])||0)*RATE[k]),0);
 h=h.replace(/<div style="display:flex;justify-content:space-between;padding:6px 24px 0;font-size:14px" class="mu"><span>[^<]*<\/span><b[^>]*>[^<]*<\/b><\/div>/,'');
 if(tot>0)h=h.replace(/(<div class="bar">[\s\S]*?<\/b><\/div>)/,'$1<div class="v336h"><div class="sm mu">'+t3('Foreign currency you hold','Amafaranga y’amahanga ufite','Devises détenues')+'</div><b>≈ '+fmt(tot)+' RWF</b></div>');
 /* 2. chart + alert card moves below the wallets */
 const a=h.indexOf('<div style="margin:18px 24px 0;padding:16px;border-radius:20px;background:var(--chip)"><div style="display:flex;justify-content:space-between;align-items:baseline');
 const w=h.indexOf('<div style="padding:22px 24px 8px;font-size:18px;font-weight:800">',a);
 const r=h.indexOf('<div style="padding:22px 24px 4px;font-size:18px;font-weight:800">',w);
 if(a>0&&w>a&&r>w){const card=h.slice(a,w);h=h.slice(0,a)+h.slice(w,r)+card+h.slice(r)}
 /* 3. Sell greyed when nothing to sell */
 if(!held(c))h=h.replace(/<button class="([^"]*)" aria-pressed="(true|false)" onclick="fxDir\('sell'\)">/,'<button class="$1 v336off" aria-pressed="$2" aria-disabled="true" onclick="fxDir(\'sell\')">');
 return h};
const _d=window.fxDir;
window.fxDir=function(d){const c=CODES[S.fx.c]||'USD';
 if(d==='sell'&&!held(c)){toast(t3('You hold no '+c+' to sell yet','Nta '+c+' ufite yo kugurisha','Vous n’avez pas encore de '+c+' à vendre'));return}
 return _d.apply(this,arguments)};
window.fxCur=function(i){const x=S.fx;x.c=i;x.s=0;if(x.d==='sell'&&!held(CODES[i]))x.d='buy';render('fade-none')};
}
document.title=document.title.replace(/v\d+/,'v336');
</script>
<script>
/* v337: Make an offer. Before (v321): the sheet had percent chips (−5%, −10%, −15%) that did not say what you would offer, a separate "Or enter your own price" label and empty box, a grey three-line summary, a separate warning line and the button, so it was tall and you had to do the sum yourself; typing your own price un-selected the chips and left the amount field empty after a chip; there was no way to take an offer back; the sheet did not announce itself as a dialog. Now: the chips show the amount first and the percent below (45,000 / −10%); the field is one large "Your offer" box that is already filled in (your last offer, or 10% off) and that every chip fills in, so you always see exactly what will be sent; the chip that matches the amount stays selected, also when you type the same number; the summary box and the warning become one line under the field: green \"You save 5,000 RWF · 10%\", or the same gentle notes as before (enter an amount, must be lower than the asking price, very low offers are often ignored); chips and typing update the sheet in place instead of redrawing it, so it no longer flickers; if you already made an offer there is a \"Withdraw offer\" button that clears it from the item page and adds a line to the chat; the sheet is a labelled dialog. The button still names the amount, Enter still sends, the message in Messages and the \"Your offer\" line on the item page are unchanged. rw and fr copy for \"Withdraw offer\" and \"Offer withdrawn\" is new and needs native review. */
{const t=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e;
const esc=s=>String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/"/g,'&quot;');
const item=id=>HD.market.items.find(x=>x.id===id),PCS=[5,10,15];
const rd=n=>Math.round(n/500)*500,ca=(x,n)=>rd(x.p*(1-n/100));
const num=s=>Number(String(s).replace(/,/g,''))||0;
const fi=v=>String(v).replace(/\D/g,'').replace(/\B(?=(\d{3})+(?!\d))/g,',');
const amt=()=>num(S.mxo.custom),bad=()=>{const x=item(S.mxo.id),a=amt();return !(a>0&&a<x.p)};
const msg=()=>{const x=item(S.mxo.id),a=amt();
 if(!a)return['var(--er)',t('Enter an amount.','Andika umubare.','Saisissez un montant.')];
 if(a>=x.p)return['var(--er)',t('Your offer must be lower than the asking price.','Igiciro watanze kigomba kuba munsi y’icyasabwe.','Votre offre doit être inférieure au prix demandé.')];
 if(a<x.p*.6)return['var(--mu)',t('Very low offers are often ignored. Try closer to the asking price.','Ibiciro biri hasi cyane akenshi ntibisubizwa. Gerageza kwegera icyasabwe.','Les offres très basses restent souvent sans réponse. Rapprochez-vous du prix demandé.')];
 return['var(--ok)',t('You save','Uzigama','Vous économisez')+' '+fmt(x.p-a)+' RWF · '+Math.round((x.p-a)/x.p*100)+'%']};
const lab=()=>{const a=amt();return t('Send offer','Ohereza igiciro','Envoyer l’offre')+(a>0&&!bad()?' · '+fmt(a)+' RWF':'')};
const upd=()=>{const x=item(S.mxo.id),a=amt(),m=msg(),w=$('#mxow'),g=$('#mxogo');if(!w||!g)return;
 document.querySelectorAll('#mxoch button').forEach((b,i)=>{const on=ca(x,PCS[i])===a;b.classList.toggle('on',on);b.setAttribute('aria-pressed',on?'true':'false')});
 w.textContent=m[1];w.style.color=m[0];$('#mxoc').setAttribute('aria-invalid',bad()&&a>0?'true':'false');g.disabled=bad();g.textContent=lab()};
const draw=()=>{const x=item(S.mxo.id),last=S.mxOffs[x.id],a=amt(),m=msg();
 const chips=PCS.map(n=>{const on=ca(x,n)===a;return `<button class="${on?'on':''}" aria-pressed="${on}" onclick="mkOffPc(${n})" style="flex:1;min-width:0;min-height:56px;border:0;border-radius:16px;padding:6px 4px;line-height:20px;background:${on?'var(--tx)':'var(--chip)'};color:${on?'var(--bg)':'var(--tx)'}"><b style="display:block;font-size:16px">${fmt(ca(x,n))}</b><span style="font-size:13px;font-weight:600;opacity:.8">−${n}%</span></button>`}).join('');
 $('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" role="dialog" aria-modal="true" aria-label="'+esc(last?t('Update your offer','Hindura igiciro cyawe','Modifier votre offre'):t('Make an offer','Tanga igiciro','Faire une offre'))+'" style="max-height:88%;overflow-y:auto">'
 +`<div class="h1" style="font-size:22px;line-height:30px">${last?t('Update your offer','Hindura igiciro cyawe','Modifier votre offre'):t('Make an offer','Tanga igiciro','Faire une offre')}</div><div class="mu" style="font-size:15px;margin:8px 0 0">${esc(x.ti)} · ${t('asking','bisabwa','demandé')} ${fmt(x.p)} RWF</div>`
 +(x.neg?'':`<div class="sm" style="margin-top:12px;line-height:20px;padding:10px 14px;border-radius:14px;background:var(--chip)">${t('The seller has not marked this price as negotiable. You can still send an offer.','Umugurisha ntiyavuze ko igiciro gishobora kugabanywa. Ushobora gutanga igiciro uko byagenda kose.','Le vendeur n’a pas indiqué un prix négociable. Vous pouvez quand même envoyer une offre.')}</div>`)
 +(last?`<div class="sm mu" style="margin-top:10px">${t('Your last offer','Igiciro cyawe giheruka','Votre dernière offre')}: ${fmt(last)} RWF</div>`:'')
 +`<div id="mxoch" role="group" style="display:flex;gap:8px;margin-top:16px">${chips}</div>`
 +`<label class="sm mu" for="mxoc" style="display:block;margin-top:16px;font-weight:600">${t('Your offer','Igiciro cyawe','Votre offre')}</label><div style="display:flex;align-items:center;gap:8px;margin-top:4px;padding:4px 16px;border-radius:16px;background:var(--chip)"><input class="in" id="mxoc" inputmode="numeric" autocomplete="off" value="${esc(S.mxo.custom)}" oninput="mxoIn()" onkeydown="if(event.key==='Enter')mkOffSend()" aria-describedby="mxow" aria-invalid="${bad()&&a>0}" placeholder="0" style="flex:1;min-width:0;border:0;background:none;margin:0;height:52px;font-size:28px;font-weight:800;letter-spacing:-.5px"><b style="color:var(--mu);font-size:18px">RWF</b></div>`
 +`<div id="mxow" role="status" class="sm" style="min-height:20px;margin-top:10px;line-height:20px;font-weight:600;color:${m[0]}">${m[1]}</div><button class="btn" id="mxogo" style="margin-top:10px" ${bad()?'disabled':''} onclick="mkOffSend()">${lab()}</button>`
 +`<div class="sm mu" style="margin-top:12px;text-align:center;line-height:20px">${t('The seller replies in Messages. You only pay if you both agree.','Umugurisha agusubiriza muri Messages. Wishyura ari uko mwemeranyije.','Le vendeur répond dans Messages. Vous ne payez que si vous êtes d’accord.')}</div>`
 +(last?`<button type="button" onclick="mkOffWd()" style="display:block;margin:4px auto 0;border:0;background:none;min-height:44px;padding:0 16px;font:inherit;font-weight:700;color:var(--er)">${t('Withdraw offer','Kuramo igiciro','Retirer l’offre')}</button>`:'')
 +'</div>'};
window.mkOffer=id=>{const x=item(id),last=S.mxOffs[id];S.mxo={id,pc:10,custom:fi(last||ca(x,10))};draw()};
window.mkOffPc=n=>{const x=item(S.mxo.id);S.mxo.pc=n;S.mxo.custom=fi(ca(x,n));$('#mxoc').value=S.mxo.custom;upd()};
window.mxoIn=()=>{const i=$('#mxoc');S.mxo.custom=fi(i.value);i.value=S.mxo.custom;upd()};
window.mkOffSend=()=>{if(!S.mxo||bad())return;const x=item(S.mxo.id),a=amt(),th='hdmarket'+x.id,m='Hi, would you accept '+fmt(a)+' RWF for "'+x.ti+'"?';
 hdThread(th,x.who,x.ti,[['me',m]]);if(S.msgs[th].length>1||S.msgs[th][0][1]!==m)S.msgs[th].push(['me',m]);S.mxOffs[x.id]=a;
 closeSheet();S.tab='messages';openChat(th);toast(t('Offer sent','Igiciro cyoherejwe','Offre envoyée'))};
window.mkOffWd=()=>{if(!S.mxo)return;const x=item(S.mxo.id),th='hdmarket'+x.id;if(!S.mxOffs[x.id])return;delete S.mxOffs[x.id];
 if(S.msgs[th])S.msgs[th].push(['me','I am withdrawing my offer for "'+x.ti+'".']);closeSheet();render('fade-none');toast(t('Offer withdrawn','Igiciro cyakuweho','Offre retirée'))};
}
/* v338: Scan screen. (1) The camera view is dimmed around the frame so the eye goes to the frame; frame corners are bigger and the scan line fades at its ends. (2) Layout is a column instead of fixed offsets, so nothing overlaps on short phones. (3) A code that is tapped is "found" first: the frame turns green with a tick, the phone buzzes, the headline says "Code found", then the next screen opens (no instant jump). (4) Flash shows on/off (filled icon, soft glow on the frame, aria-pressed) and keeps its state. (5) After 6 seconds with no code, a hint suggests the flash or typing the till number. (6) Sample codes are in one scrolling row with 13 px text, 44 px tap height, labelled as prototype only. (7) Status line is read out by screen readers. No copy or flow changes elsewhere. */
(function(){
const T3=(a,b,c)=>({rw:b,fr:c}[S.lang]||a);
const svg=(d,z)=>`<svg width="${z||24}" height="${z||24}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;
const X=svg('<path d="M6 6l12 12M18 6L6 18"/>'),FLASH=svg('<path d="M13 2L5 14h6l-1 8 8-12h-6z"/>'),IMG=svg('<rect x="3" y="4" width="18" height="16" rx="3"/><circle cx="9" cy="10" r="1.6"/><path d="M4 18l5-5 4 4 3-3 4 4"/>',20);
const st=document.createElement('style');
st.textContent=`
.sc2{position:absolute;inset:0;background:#0D0D10;color:#fff;overflow:hidden;display:flex;flex-direction:column}
.sc2 .top{display:flex;align-items:center;justify-content:space-between;padding:12px 8px 0;flex:0 0 auto;z-index:2}
.sc2 .top .ib{color:#fff}
.sc2 #sc2fl{opacity:.7}.sc2 #sc2fl.on{opacity:1;color:#FFD84D}.sc2 #sc2fl.on svg{fill:#FFD84D}
.sc2 .hd{text-align:center;padding:14px 24px 0;flex:0 0 auto}
.sc2 .hd b{display:block;font-size:22px;line-height:28px;font-weight:800}
.sc2 .hd span{display:block;font-size:15px;line-height:21px;opacity:.8;margin-top:6px;min-height:21px}
.sc2 .mid{flex:1 1 auto;display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:0;padding:12px 0}
.sc2fr{position:relative;width:min(240px,62vw);aspect-ratio:1;border-radius:22px;box-shadow:0 0 0 100vmax rgba(0,0,0,.58);transition:box-shadow .25s}
.sc2fr.lit{box-shadow:0 0 0 100vmax rgba(0,0,0,.4),0 0 40px 6px rgba(255,255,255,.22)}
.sc2fr i{position:absolute;width:44px;height:44px;border:5px solid #fff;transition:border-color .2s}
.sc2fr.ok i{border-color:#3DDC97}
.sc2fr .ln{position:absolute;left:14px;right:14px;height:3px;border-radius:2px;background:linear-gradient(90deg,transparent,var(--br,#7472F4) 20%,var(--br,#7472F4) 80%,transparent);animation:sc2l 2.2s ease-in-out infinite alternate}
.sc2fr.ok .ln{display:none}
@keyframes sc2l{from{top:14px}to{top:calc(100% - 17px)}}
.sc2fr .tk{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;opacity:0;transform:scale(.6);transition:opacity .2s,transform .25s}
.sc2fr.ok .tk{opacity:1;transform:none}
.sc2fr .tk b{width:72px;height:72px;border-radius:36px;background:#3DDC97;color:#0D0D10;display:flex;align-items:center;justify-content:center}
.sc2 .acts{display:flex;gap:10px;justify-content:center;margin-top:22px}
.sc2 .bot{flex:0 0 auto;padding:0 0 26px}
.sc2 .bot .lab{font-size:13px;font-weight:700;opacity:.7;padding:0 20px 8px}
.sc2 .row{display:flex;gap:8px;overflow-x:auto;padding:0 20px 2px;scrollbar-width:none}
.sc2 .row::-webkit-scrollbar{display:none}
.sc2 .v8chip{min-height:44px;flex:0 0 auto}
.sc2 .my{text-align:center;margin-top:16px}
.sc2.busy .bot,.sc2.busy .acts{pointer-events:none}
`;
document.head.appendChild(st);
const prev=screens.paysc;
const shops=[...prev().matchAll(/ppMerch\('(\d+)'\)[\s\S]*?<span style="flex:1">([^<]*)<\/span>/g)].map(m=>[m[1],m[2]]);
screens.paysc=()=>{
 const send=S.scanFor==='send',fl=!!S.scFl;
 clearTimeout(window.scIdle);
 window.scIdle=setTimeout(()=>{const h=document.getElementById('sc2hint');if(h&&!document.querySelector('.sc2.busy'))h.textContent=T3('Too dark? Try the flash, or type the till number.','Hari umwijima? Gerageza itara, cyangwa wandike nimero.','Trop sombre ? Essayez le flash ou saisissez le numéro.')},6000);
 return `<div class="sc2"><div class="top"><button id="sc2fl" class="ib${fl?' on':''}" aria-pressed="${fl}" aria-label="${T3('Flash','Itara','Flash')}" onclick="scFlash(this)">${FLASH}</button><button class="ib" aria-label="${T3('Close','Funga','Fermer')}" onclick="back()">${X}</button></div>
<div class="hd"><b id="sc2t">${send?T3('Scan a code to send','Sikana kode kugira wohereze','Scannez un code pour envoyer'):T3('Scan a QR code','Sikana kode ya QR','Scannez un code QR')}</b><span id="sc2hint" role="status" aria-live="polite">${T3('Shops and friends both work.','Abacuruzi n’inshuti byose bikora.','Commerçants et amis fonctionnent.')}</span></div>
<div class="mid"><div class="sc2fr${fl?' lit':''}" id="sc2fr"><i style="top:0;left:0;border-right:0;border-bottom:0;border-radius:22px 0 0 0"></i><i style="top:0;right:0;border-left:0;border-bottom:0;border-radius:0 22px 0 0"></i><i style="bottom:0;left:0;border-right:0;border-top:0;border-radius:0 0 0 22px"></i><i style="bottom:0;right:0;border-left:0;border-top:0;border-radius:0 0 22px 0"></i><div class="ln"></div><div class="tk"><b>${svg('<path d="M5 12.5l4.5 4.5L19 7.5"/>',40)}</b></div></div>
<div class="acts"><button class="v8pill" onclick="scType()">${svg('<path d="M4 20l4-1 11-11a2.1 2.1 0 00-3-3L5 16z"/>',20)}${send?T3('Type in','Andika','Saisir'):T3('Till number','Nimero y’umucuruzi','N° de caisse')}</button><button class="v8pill" onclick="toast('${T3('The photo picker is not in this prototype.','Guhitamo ifoto ntibirimo muri iyi prototype.','Le sélecteur de photos n’est pas dans ce prototype.')}')">${IMG}${T3('From photos','Mu mafoto','Depuis les photos')}</button></div></div>
<div class="bot"><div class="lab">${T3('Try a sample code (prototype)','Gerageza kode y’icyitegererezo','Essayez un code d’exemple')}</div><div class="row"><button class="v8chip" onclick="scHit(()=>scPerson('0788 000 214'))">Amina K.</button>${shops.map(([k,n])=>`<button class="v8chip" onclick="scHit(()=>ppMerch('${k}'))">${esc(n)}</button>`).join('')}</div>
<div class="my"><button class="v8pill out" onclick="S.stack.push('rcode');render('push')">${gx('qr',24)}${T3('My code','Kode yanjye','Mon code')}</button></div></div></div>`};
window.scFlash=b=>{const on=b.getAttribute('aria-pressed')!=='true';S.scFl=on;b.setAttribute('aria-pressed',on);b.classList.toggle('on',on);const f=document.getElementById('sc2fr');if(f)f.classList.toggle('lit',on)};
window.scHit=fn=>{const r=document.querySelector('.sc2');if(!r||r.classList.contains('busy'))return;r.classList.add('busy');
 document.getElementById('sc2fr').classList.add('ok');document.getElementById('sc2t').textContent=T3('Code found','Kode yabonetse','Code détecté');document.getElementById('sc2hint').textContent='';
 try{navigator.vibrate&&!matchMedia('(prefers-reduced-motion:reduce)').matches&&navigator.vibrate(15)}catch(e){}
 setTimeout(()=>{if(document.querySelector('.sc2')===r&&S.stack[S.stack.length-1]==='paysc')fn()},550)};
})();

/* v339: Foreign currency. Before: the screen showed today's rate but not whether it was a good moment, the review sheet gave no sense of how long the rate holds, and after converting the result sheet did not show what you now hold. Now: (1) under the rate and fee, one line puts today's rate in its 7-day range with a coloured dot: near the low is good for buying and near the high is good for selling, the opposite gets a gentle "you may want to wait", and the middle says so; (2) the review sheet says "Rate locked for 30 s" with a countdown that renews itself at 0, so the price you confirm is the price you get; (3) the result sheet adds a line with your new balance (your USD wallet when you buy, itunda Bank when you sell). Conversion, fees, wallets, the rate chart and alerts are unchanged. Still not here: more currencies (KES, UGX, TZS), which need rates below 1 RWF and new shortcut amounts. rw and fr copy is new and needs native review. */
{const t3=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e,CODES=['USD','EUR','GBP'],RATE={USD:1445,EUR:1680,GBP:1960},OFF={USD:[-1.1,-.8,-.9,-.4,-.2,-.1,0],EUR:[.7,.5,.2,.3,.1,-.2,0],GBP:[-.4,-.7,-.3,-.1,.2,.1,0]};
const d2=n=>(Math.floor(n*100+1e-6)/100).toFixed(2);
const _s=screens.fx;
screens.fx=function(){let h=_s.apply(this,arguments);if(typeof h!=='string')return h;
 const x=S.fx,c=CODES[x.c]||'USD',v=OFF[c],mn=Math.min(...v),mx=Math.max(...v),pos=(0-mn)/Math.max(.001,mx-mn),buy=(x.d||'buy')==='buy';
 const low=pos<=.34,high=pos>=.67;let col='var(--mu)',tx;
 if(low){col=buy?'var(--ok)':'var(--er)';tx=buy?t3('Near its 7-day low. A good time to buy.','Hafi n’igiciro gito mu minsi 7. Ni igihe cyiza cyo kugura.','Près de son plus bas sur 7 jours. Bon moment pour acheter.'):t3('Near its 7-day low. You may want to wait before selling.','Hafi n’igiciro gito mu minsi 7. Wategereza mbere yo kugurisha.','Près de son plus bas sur 7 jours. Mieux vaut attendre pour vendre.')}
 else if(high){col=buy?'var(--er)':'var(--ok)';tx=buy?t3('Near its 7-day high. You may want to wait, or set a rate alert.','Hafi n’igiciro cyo hejuru mu minsi 7. Wategereza, cyangwa ushyireho imenyesha.','Près de son plus haut sur 7 jours. Attendez ou activez une alerte.'):t3('Near its 7-day high. A good time to sell.','Hafi n’igiciro cyo hejuru mu minsi 7. Ni igihe cyiza cyo kugurisha.','Près de son plus haut sur 7 jours. Bon moment pour vendre.')}
 else tx=t3('In the middle of its 7-day range.','Hagati mu minsi 7 ishize.','Au milieu de sa fourchette sur 7 jours.');
 const ins='<div class="sm" style="display:flex;gap:8px;align-items:flex-start;padding:8px 24px 0;line-height:19px"><i aria-hidden="true" style="flex:0 0 9px;height:9px;border-radius:5px;margin-top:5px;background:'+col+'"></i><span>'+tx+'</span></div>';
 return h.replace('<div class="sm mu" id="fxn"',ins+'<div class="sm mu" id="fxn"')};
const lk=()=>t3('Rate locked for ','Igiciro gifunze mu ','Taux garanti pendant ');
const _a=window.fxAsk;
window.fxAsk=function(){clearInterval(window.fxLk);const r=_a.apply(this,arguments),L=document.getElementById('layer'),row=L&&L.querySelector('.row2');
 if(!row)return r;let n=30;row.insertAdjacentHTML('beforebegin','<div class="sm mu" id="fxlk" style="text-align:center;margin:-8px 0 14px">'+lk()+n+' s</div>');
 window.fxLk=setInterval(()=>{const e=document.getElementById('fxlk');if(!e||!e.isConnected){clearInterval(window.fxLk);return}n--;if(n<=0){n=30;e.textContent=t3('Rate refreshed. Locked for 30 s','Igiciro cyavuguruwe. Gifunze mu 30 s','Taux actualisé. Garanti 30 s')}else e.textContent=lk()+n+' s'},1000);return r};
const _d=window.fxDo;
window.fxDo=function(){clearInterval(window.fxLk);const x=S.fx,c=CODES[x.c]||'USD',buy=(x.d||'buy')==='buy',r=_d.apply(this,arguments),L=document.getElementById('layer');
 if(!L||L.innerHTML.indexOf('💱')<0)return r;const ok=L.querySelector('button.btn');if(!ok)return r;
 const line=buy?t3('Your '+c+' wallet: ','Wallet yawe ya '+c+': ','Votre portefeuille '+c+' : ')+d2(x.w[c]||0)+' '+c:t3('itunda Bank balance: ','Amafaranga muri itunda Bank: ','Solde itunda Bank : ')+fmt(S.bank)+' RWF';
 ok.insertAdjacentHTML('beforebegin','<div style="font-size:15px;font-weight:800;margin:-8px 0 18px">'+line+'</div>');return r};
}

/* v340: Youth account. Before: once the account was open, a parent could send money and set a weekly limit and nothing else; French and Kinyarwanda fell back to an older English page; there was no list of what you had sent and no way to stop spending. Now (English, French, Kinyarwanda): (1) the balance shows a red "Spending paused" tag when paused; (2) "Pocket money": Off / 1,000 / 2,000 / 5,000 RWF every Monday, with a sentence naming the child, the amount and the next Monday (sample, nothing is sent automatically in the prototype); (3) "Pause spending": one switch that stops the child spending until you turn it back on, with a sentence saying what it does; (4) "Sent to {name}" lists what you sent, newest first, with date and amount, or says nothing has been sent yet. Sending money, the review sheets, the weekly limit and the sign-up page are unchanged; the sign-up page and the review sheets are still English only. rw and fr copy is new and needs native review. */
{const t3=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e;
const esc=x=>String(x).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const cb=(on,fn,txt)=>'<button class="chip" aria-pressed="'+on+'" onclick="'+fn+'" style="min-width:64px;height:44px;border-radius:22px;border:0;padding:0 16px;font-size:15px;font-weight:800;background:'+(on?'var(--tx)':'var(--chip)')+';color:'+(on?'var(--bg)':'var(--tx)')+'">'+txt+'</button>';
const chs=(a,cur,fn,lb)=>'<div style="display:flex;gap:10px;flex-wrap:wrap;padding-top:10px" role="group">'+a.map(v=>cb(v===cur,fn+'('+v+')',lb?lb(v):fmt(v))).join('')+'</div>';
const hd=x=>'<div style="font-size:16px;font-weight:800;padding-top:22px">'+x+'</div>';
const loc=()=>({en:'en-GB',fr:'fr-FR',rw:'en-GB'})[S.lang]||'en-GB';
const nextMon=()=>{const d=new Date();d.setHours(0,0,0,0);d.setDate(d.getDate()+((8-d.getDay())%7||7));return d};
const fd=d=>new Date(d).toLocaleDateString(loc(),{day:'numeric',month:'short'});
const _y=screens.yth,_s=window.ythSend;
window.ythSend=function(n){const Y=S.yth;if(Y){(Y.h=Y.h||[]).unshift([Date.now(),n])}return _s.apply(this,arguments)};
screens.yth=function(){const Y=S.yth;if(!Y)return _y.apply(this,arguments);
 const n=S.ysd||2000,low=S.bank<n,nm=esc(Y.n),pa=!!Y.pause,pm=Y.pm||0,h=Y.h||[];
 const tag=pa?'<span style="display:inline-block;margin-top:10px;padding:5px 12px;border-radius:14px;background:var(--er);color:#fff;font-size:13px;font-weight:800">'+t3('Spending paused','Gukoresha amafaranga byahagaritswe','Dépenses suspendues')+'</span>':'';
 const sw='<div class="row" style="padding:0;cursor:default"><div style="flex:1;min-width:0"><div class="t">'+t3('Pause spending','Hagarika gukoresha','Suspendre les dépenses')+'</div><div class="s" style="line-height:20px">'+(pa?t3(nm+' cannot spend until you turn this off.',nm+' ntashobora gukoresha amafaranga kugeza ubyuguye.',nm+' ne peut plus dépenser tant que vous ne le réactivez pas.'):t3('Stops '+nm+' spending from this account.','Ahagarika '+nm+' gukoresha amafaranga kuri konti.','Empêche '+nm+' de dépenser depuis ce compte.'))+'</div></div><div class="sw'+(pa?' on':'')+'" role="switch" tabindex="0" aria-checked="'+pa+'" aria-label="'+t3('Pause spending','Hagarika gukoresha','Suspendre les dépenses')+'" onclick="ythPause()"><i></i></div></div>';
 const pmTx=pm?t3(nm+' gets '+fmt(pm)+' RWF every Monday from itunda Bank. Next: '+fd(nextMon())+'.',nm+' ahabwa RWF '+fmt(pm)+' buri wa mbere muri itunda Bank. Ubutaha: '+fd(nextMon())+'.',nm+' reçoit '+fmt(pm)+' RWF chaque lundi depuis itunda Bank. Prochain : '+fd(nextMon())+'.'):t3('Send a fixed amount every Monday, so you do not have to remember.','Ohereza amafaranga angana buri wa mbere, utibagiwe.','Envoyez un montant fixe chaque lundi, sans y penser.');
 const rec=h.length?h.slice(0,5).map(x=>'<div class="row" style="padding:8px 0;cursor:default"><div class="ico" style="width:36px;height:36px">💸</div><div style="flex:1;min-width:0"><div class="t" style="font-size:15px">'+t3('Sent to '+nm,'Byoherejwe kuri '+nm,'Envoyé à '+nm)+'</div><div class="s">'+fd(x[0])+'</div></div><b>'+fmt(x[1])+' RWF</b></div>').join(''):'<div class="mu" style="font-size:15px;line-height:22px;padding-top:8px">'+t3('Nothing sent yet. Money you send shows here.','Nta cyoherejwe. Amafaranga yoherejwe azagaragara hano.','Rien envoyé pour l’instant. Les envois apparaîtront ici.')+'</div>';
 return bar(t3(Y.n+"'s account",'Konti ya '+Y.n,'Compte de '+Y.n))+'<div class="pad" style="padding-top:28px"><div class="sm mu">'+t3('Balance','Amafaranga ahari','Solde')+'</div><div class="big" style="margin-top:4px">'+fmt(Y.bal)+' RWF</div><div class="sm mu" style="margin-top:6px">'+t3('Parent-supervised · weekly limit ','Ugenzurwa n’umubyeyi · umupaka wa buri cyumweru ','Supervisé par un parent · plafond hebdomadaire ')+fmt(Y.l)+' RWF</div>'+tag+'</div>'+
 '<div class="pad">'+hd(t3('How much to send?','Wohereza angahe?','Combien envoyer ?'))+chs([2000,5000,10000],n,'ythAmt')+'<div class="sm mu" style="margin-top:14px;line-height:20px" aria-live="polite">'+(low?'<span style="color:var(--er)">'+t3(fmt(n)+' RWF is more than your bank balance of '+fmt(S.bank)+' RWF. Pick a smaller amount.','RWF '+fmt(n)+' irarenze amafaranga ufite muri banki (RWF '+fmt(S.bank)+'). Hitamo make.',fmt(n)+' RWF dépasse votre solde de '+fmt(S.bank)+' RWF. Choisissez moins.')+'</span>':t3('From itunda Bank · balance after '+fmt(S.bank-n)+' RWF','Muri itunda Bank · nyuma hasigaye RWF '+fmt(S.bank-n),'Depuis itunda Bank · solde après '+fmt(S.bank-n)+' RWF'))+'</div><button class="btn" style="width:100%;margin-top:16px;white-space:nowrap" '+(low?'disabled ':'')+'onclick="ythSendReview()">'+t3('Send '+fmt(n)+' RWF to '+nm,'Ohereza RWF '+fmt(n)+' kuri '+nm,'Envoyer '+fmt(n)+' RWF à '+nm)+'</button></div>'+
 '<div class="pad">'+hd(t3('Pocket money','Amafaranga y’ikiyiko','Argent de poche'))+chs([0,1000,2000,5000],pm,'ythPm',v=>v?fmt(v):t3('Off','Zimya','Non'))+'<div class="sm mu" style="margin-top:14px;line-height:20px">'+pmTx+'</div><div class="fine" style="margin-top:6px">'+t3('Sample only. Nothing is sent automatically in this prototype.','Icyitegererezo gusa. Nta kohereza kwikora muri iyi prototype.','Exemple uniquement. Rien n’est envoyé automatiquement dans ce prototype.')+'</div></div>'+
 '<div class="pad">'+hd(t3('Weekly spending limit','Umupaka wa buri cyumweru','Plafond hebdomadaire'))+chs([1000,3000,5000],Y.l,'ythLim')+'<div class="sm mu" style="margin-top:14px;line-height:20px">'+t3(nm+' can spend up to '+fmt(Y.l)+' RWF a week. A change applies straight away.',nm+' ashobora gukoresha RWF '+fmt(Y.l)+' ku cyumweru. Impinduka zihita zikora.',nm+' peut dépenser jusqu’à '+fmt(Y.l)+' RWF par semaine. Un changement s’applique tout de suite.')+'</div></div>'+
 '<div class="pad" style="padding-top:22px">'+sw+'</div>'+
 '<div class="pad">'+hd(t3('Sent to '+nm,'Byoherejwe kuri '+nm,'Envoyé à '+nm))+rec+'</div><div class="pad fine" style="padding-top:20px">'+t3('Sample data for this prototype.','Amakuru y’icyitegererezo.','Données d’exemple pour ce prototype.')+'</div>'};
window.ythAmt=v=>{S.ysd=v;render('fade-none')};
window.ythLim=v=>{S.yth.l=v;render('fade-none')};
window.ythPm=v=>{S.yth.pm=v;render('fade-none');toast(v?t3('Pocket money on','Amafaranga y’ikiyiko arakora','Argent de poche activé'):t3('Pocket money off','Amafaranga y’ikiyiko yazimijwe','Argent de poche désactivé'))};
window.ythPause=()=>{const Y=S.yth;Y.pause=!Y.pause;render('fade-none');toast(Y.pause?t3('Spending paused','Gukoresha byahagaritswe','Dépenses suspendues'):t3('Spending allowed again','Gukoresha byongeye kwemerwa','Dépenses de nouveau autorisées'))};
}

/* v341: Scan screen, the cases that were missing. Before: the screen only worked when every code was good, and "From photos" only showed a message. Now (English, French, Kinyarwanda): (1) a code that cannot be read turns the frame red with a "!" and a short shake (none when the phone asks for reduced motion), the headline says "Can't read this code", the status line says what to do next (try again or type the till number), and the screen is usable again after 2 seconds; a sample chip "Unreadable code" lets you try it; (2) "From photos" opens a sheet with two sample photos: one with a code (continues like a scanned code) and one without ("No code in this photo. Pick a photo where the whole code is visible."). The camera view, flash, found state, idle hint, sample codes and everything after the scan are unchanged. rw and fr copy is new and needs native review. */
(function(){
const T3=(a,b,c)=>({rw:b,fr:c}[S.lang]||a);
const svg=(d,z)=>`<svg width="${z||24}" height="${z||24}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;
const st=document.createElement('style');
st.textContent=`.sc2fr.bad i{border-color:#FF6B5E}.sc2fr.bad .ln{display:none}.sc2fr.bad .tk{opacity:1;transform:none}.sc2fr.bad .tk b{background:#FF6B5E;color:#0D0D10}.sc2fr.bad{animation:sc2s .35s}@keyframes sc2s{0%,100%{transform:none}25%{transform:translateX(-8px)}75%{transform:translateX(8px)}}@media(prefers-reduced-motion:reduce){.sc2fr.bad{animation:none}}`;
document.head.appendChild(st);
const _p=screens.paysc;
screens.paysc=function(){
 let h=_p.apply(this,arguments);if(typeof h!=='string')return h;
 h=h.replace(/onclick="toast\('(?:The photo picker|Guhitamo ifoto|Le sélecteur)[^']*'\)"/,'onclick="scPhotos()"');
 const chip='<button class="v8chip" onclick="scBad()">'+T3('Unreadable code','Kode itasomeka','Code illisible')+'</button>';
 return h.replace(/<\/div>\n<div class="my">/,chip+'</div>\n<div class="my">')};
window.scBad=msg=>{
 const r=document.querySelector('.sc2');if(!r||r.classList.contains('busy'))return;
 r.classList.add('busy');
 const f=document.getElementById('sc2fr'),t=document.getElementById('sc2t'),hint=document.getElementById('sc2hint'),tk=f&&f.querySelector('.tk b');
 const o=t.textContent,oh=tk?tk.innerHTML:'';
 const none=msg==='photo';
 if(tk)tk.innerHTML=svg('<path d="M12 7v6M12 17h.01"/>',40);
 f.classList.add('bad');
 t.textContent=none?T3('No code in this photo','Nta kode iri kuri iyi foto','Aucun code sur cette photo'):T3('Can’t read this code','Kode ntisomwa','Code illisible');
 hint.textContent=none?T3('Pick a photo where the whole code is visible.','Hitamo ifoto igaragaza kode yose.','Choisissez une photo où tout le code est visible.'):T3('This is not an itunda or shop code. Try again, or type the till number.','Iyi si kode ya itunda cyangwa y’umucuruzi. Ongera ugerageze, cyangwa wandike nimero.','Ce n’est pas un code itunda ou commerçant. Réessayez ou saisissez le numéro.');
 try{navigator.vibrate&&!matchMedia('(prefers-reduced-motion:reduce)').matches&&navigator.vibrate([30,60,30])}catch(e){}
 setTimeout(()=>{if(document.querySelector('.sc2')!==r)return;f.classList.remove('bad');if(tk)tk.innerHTML=oh;t.textContent=o;r.classList.remove('busy')},2000)};
window.scPhotos=()=>{
 const r=document.querySelector('.sc2');if(!r||r.classList.contains('busy'))return;
 const row=(e,tt,s,fn)=>'<button class="row" style="width:100%;text-align:left;background:none;border:0;min-height:64px;padding:8px 0" onclick="'+fn+'"><div class="ico" style="width:44px;height:44px">'+e+'</div><div style="flex:1;min-width:0"><div class="t">'+tt+'</div><div class="s">'+s+'</div></div></button>';
 const ttl=T3('Choose a photo','Hitamo ifoto','Choisir une photo');
 document.getElementById('layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" role="dialog" aria-modal="true" aria-label="'+ttl+'"><div class="h1" style="font-size:22px;line-height:30px;margin-top:4px">'+ttl+'</div><div style="margin:12px 0 8px">'
 +row('🥐',T3('Bakery counter','Aho bakorera imigati','Comptoir de la boulangerie'),T3('Has a code','Ifite kode','Avec un code'),"closeSheet();scHit(()=>ppMerch('123456'))")
 +row('🌆',T3('Street view','Ifoto y’umuhanda','Vue de la rue'),T3('No code','Nta kode','Sans code'),"closeSheet();scBad('photo')")
 +'</div><div class="fine">'+T3('Sample photos for this prototype.','Amafoto y’icyitegererezo.','Photos d’exemple pour ce prototype.')+'</div></div>';
 if(typeof focusSheet==='function')focusSheet()};
})();

/* v342: Pay from is a drop-down. Before: on the Pay tab the two accounts were two full-width rows, and on the amount screen after a scan or till number they were two chips. Now both are one row (or one button) showing the account that will pay, with a small arrow; tapping it opens a "Pay from" sheet like the Top up screen, listing itunda Pay (120,500 RWF) and itunda Bank (837,300 RWF) with a tick on the current one. On the Pay tab the row also says "Available" and the balance; on the amount screen the balance stays in the line under the amount. Choosing an account works as before (same toast, same balance checks). No other screens changed. rw and fr copy is new and needs native review. */
(function(){
const T3=(a,b,c)=>({rw:b,fr:c}[S.lang]||a);
const svg=(d,z)=>`<svg width="${z||24}" height="${z||24}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;
const CH='<span style="color:var(--tt);display:flex;flex:none">'+svg('<path d="M6 9l6 6 6-6"/>',18)+'</span>';
const CK='<span style="color:var(--lk);display:flex;width:24px">'+svg('<path d="M5 12.5l4.5 4.5L19 7.5"/>',24)+'</span>';
const OPT=()=>[['pay','itunda Pay',S.pay],['bank','itunda Bank',S.bank]];
const cur=()=>OPT().find(o=>o[0]===S.psrc)||OPT()[0];
const ico=(k,z)=>`<span style="width:${z}px;height:${z}px;border-radius:${z/2}px;background:var(--tint);color:var(--tintfg);display:flex;align-items:center;justify-content:center;font-weight:800;font-size:${Math.round(z*.42)}px;flex:none">${k==='bank'?'B':'P'}</span>`;
const rowTab=()=>{const [k,n,b]=cur();return `<div class="tap" role="button" tabindex="0" aria-haspopup="dialog" onclick="ppFromPick('ppSrc')" style="display:flex;align-items:center;gap:14px;min-height:64px;margin-top:6px;cursor:pointer">${ico(k,44)}<div style="flex:1;min-width:0"><div style="font-size:18px;font-weight:800;display:flex;align-items:center;gap:4px"><span>${n}</span>${CH}</div><div class="sm mu" style="margin-top:2px">${T3('Available ','Ushobora gukoresha ','Disponible ')}${fmt(b)} RWF</div></div></div>`};
const btnAmt=()=>{const n=cur()[1];return `<div style="display:flex;justify-content:center;margin-top:12px"><button class="chip" aria-haspopup="dialog" onclick="ppFromPick('ppSrc2')" style="height:44px;padding:0 16px;gap:6px;display:inline-flex;align-items:center;font-size:15px;font-weight:800"><span class="mu" style="font-weight:600">${T3('Pay from','Ishyura uvuye kuri','Payer depuis')}</span><span>${n}</span>${CH}</button></div>`};
const wrap=(name,re,mk)=>{const _s=screens[name];screens[name]=function(){const h=_s.apply(this,arguments);return typeof h==='string'?h.replace(re,mk):h}};
wrap('pay',/<div class="req"[^>]*>(?:\s*<button[^>]*onclick="ppSrc\('[\w-]+'\)"[\s\S]*?<\/button>\s*)+<\/div>/,rowTab);
wrap('payamt',/<div class="req"[^>]*>(?:\s*<button[^>]*onclick="ppSrc2\('[\w-]+'\)"[\s\S]*?<\/button>\s*)+<\/div>/,btnAmt);
window.ppFromPick=fn=>{const ttl=T3('Pay from','Ishyura uvuye kuri','Payer depuis');
 document.getElementById('layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" role="dialog" aria-modal="true" aria-label="'+ttl+'"><div class="h1" style="font-size:22px;line-height:30px;margin-bottom:8px">'+ttl+'</div>'
 +OPT().map(([k,n,b])=>'<div class="tap" role="button" tabindex="0" onclick="closeSheet();'+fn+'(\''+k+'\')" style="display:flex;align-items:center;gap:14px;padding:10px 0;cursor:pointer;min-height:56px">'+ico(k,44)+'<div style="flex:1;min-width:0"><div style="font-size:17px;font-weight:700">'+n+'</div><div class="sm mu">'+fmt(b)+' RWF</div></div>'+(S.psrc===k?CK:'<span style="width:24px"></span>')+'</div>').join('')+'</div>';
 if(typeof focusSheet==='function')focusSheet()};
})();

/* v345: Toss-style send flow, amount screen shows From / Balance, done screen has Add a note and a free-forever line */
{
const E=s=>String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const T=(en,rw,fr)=>({rw,fr})[S.lang]||en;
const _a=screens.amount;
screens.amount=function(){const h=_a.apply(this,arguments),k='<div id="msg"';
 const ctx=`<div style="margin:0 24px 6px;padding:12px 16px;border-radius:16px;background:var(--chip);display:flex;justify-content:space-between;align-items:center;font-size:14px;text-align:left"><span><span class="mu">${T('From','Biva kuri','Depuis')}</span> <b>itunda Bank</b></span><span class="mu">${T('Balance','Asigaye','Solde')} <b style="color:var(--tx)">${fmt(S.bank)} RWF</b></span></div>`;
 return h.includes(k)&&!h.includes('data-v345')?h.replace(k,ctx.replace('<div ','<div data-v345 ')+k):h};
window.noteSheet=function(){$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" role="dialog" aria-modal="true" aria-label="${T('Add a note','Ongeraho inyandiko','Ajouter une note')}"><div class="h1" style="font-size:22px;line-height:30px;margin-bottom:12px">${T('Add a note','Ongeraho inyandiko','Ajouter une note')}</div><input id="nt45" maxlength="40" value="${E(S.note45||'')}" placeholder="${T('e.g. Rent for October','Urugero: Ubukode bw’Ukwakira','ex. Loyer d’octobre')}" style="width:100%;height:52px;border:0;border-radius:14px;background:var(--chip);padding:0 16px;font:inherit;font-size:16px;color:var(--tx);outline:0;box-sizing:border-box" onkeydown="if(event.key==='Enter')noteSave()"><button class="btn" style="margin-top:16px" onclick="noteSave()">${T('Save','Bika','Enregistrer')}</button></div>`;setTimeout(()=>{const i=document.getElementById('nt45');if(i)i.focus()},60)};
window.noteSave=function(){const i=document.getElementById('nt45');S.note45=i?i.value.trim():'';closeSheet();render('fade-none')};
const _s=screens.sent;
screens.sent=function(){const h=_s.apply(this,arguments),k='<div class="cta" style="border:0">';
 const chip=`<div style="display:flex;justify-content:center;margin-top:20px"><button class="chip tap" onclick="noteSheet()" style="height:40px;padding:0 18px;font-size:15px">${S.note45?E(S.note45):T('Add a note','Ongeraho inyandiko','Ajouter une note')}</button></div><div class="fine" style="text-align:center;margin-top:14px">${T('Sending is always free','Kohereza ni ubuntu buri gihe','L’envoi est toujours gratuit')}</div>`;
 return h.includes(k)?h.replace(k,chip+k):h};
const _f=window.flow;window.flow=function(){S.note45='';return _f.apply(this,arguments)};
}

/* v346: Eats menu shows how much more is needed to reach the minimum order, with a progress bar */
{
const T=(en,rw,fr)=>({rw,fr})[S.lang]||en;
const _e=screens.erest;
screens.erest=function(){const h=_e.apply(this,arguments);
 const r=REST[S.er],sub=eSub();
 if(!r||!sub||sub>=r.min||h.includes('data-v346'))return h;
 const left=r.min-sub,pct=Math.max(6,Math.round(sub/r.min*100));
 const msg=T('Add '+fmt(left)+' RWF more to order','Ongeraho RWF '+fmt(left)+' kugira ngo utumize','Ajoutez '+fmt(left)+' RWF pour commander');
 const hint=`<div data-v346 role="status" style="padding:10px 24px 0"><div style="font-size:13px;font-weight:700;margin-bottom:6px">${msg}</div><div style="height:6px;border-radius:3px;background:var(--chip);overflow:hidden"><div style="width:${pct}%;height:100%;background:var(--br);border-radius:3px"></div></div><div class="fine" style="margin-top:6px">${T('Minimum order','Ntarengwa','Commande minimum')} ${fmt(r.min)} RWF</div></div>`;
 let i=h.indexOf('Pay with');if(i>0)i=h.lastIndexOf('<div',i);if(i<0)i=h.lastIndexOf('<div class="cta"');
 return i>0?h.slice(0,i)+h.slice(i).replace(/(<div class="cta"[^>]*>)/,'$1'+hint):h};
}

/* v347: Pay tab, tighter section spacing so Pay from and Ways to pay show on the first screen */
{
const _p=screens.pay;
screens.pay=function(){const h=_p.apply(this,arguments);
 if(typeof h!=='string'||h.includes('pay347'))return h;
 return '<style>.pay347 .v174h{padding-top:14px!important;margin-bottom:0!important}.pay347 .v174{padding-top:2px!important}.pay347 .v174h+.sec,.pay347 .v174h+.pad,.pay347 .v174h+.chips{padding-top:2px!important}</style><div class="pay347" style="display:contents">'+h+'</div>'};
}

/* v348: Shop tab, tighter section spacing so products start sooner */
{

/* v406: smoother everything else. (1) the screen you leave no longer vanishes: a ghost of it slides/fades out while the new one comes in; (2) toasts animate out; (3) quantities and cart label tick when they change; (4) inputs/chips/progress ease their state changes. */
(()=>{
const ph=document.getElementById('phone'),view=document.getElementById('view');if(!ph||!view||typeof window.draw!=='function')return;
const rm=()=>matchMedia('(prefers-reduced-motion:reduce)').matches;

 const n=Math.ceil(dt/.004),h=dt/n,tg=P.out?-4:(P.run&&P.ref?48:P.x*.55);
 for(let i=0;i<n;i++){if(P.run){P.v+=(260*(P.t-P.x)-16*P.v)*h;P.x+=P.v*h}P.dv+=(380*(tg-P.dy)-17*P.dv)*h;P.dy+=P.dv*h}
 if(P.ref&&!P.out){P.w+=(6.5-P.w)*Math.min(1,dt*3);P.a+=P.w*dt;P.cm=Math.min(1,(P.cm||0)+dt*3.5)}
 else if(P.out){P.wv+=(50*(P.la-P.a)-9*P.wv)*dt;P.a+=P.wv*dt;P.cm=Math.max(0,(P.cm||0)-dt*6)}
 else P.a=Math.max(0,P.x)/80*TAU;
 if(P.on){const ty='0 '+Math.max(0,P.x).toFixed(2)+'px';if(P.ks)P.ks.forEach(c=>c.style.translate=ty);else P.sc.style.translate=ty}
 dr(P,now);
 if(P.run&&P.t===0&&Math.abs(P.x)<.4&&Math.abs(P.v)<2&&Math.abs(P.dv)<8&&Math.abs(P.dy-tg)<1){fin(P);return}
 raf=requestAnimationFrame(tick)};

 if(!pr.on){if(dy<-6){pr=null;return}if(dy<8)return;pr.on=1;pr.l=now;if(!raf)raf=requestAnimationFrame(tick)}
 const x=140*(1-Math.exp(-Math.max(0,dy)/110)),v=(x-pr.x)/Math.max(.008,(now-pr.l)/1000);pr.v=Math.max(-700,Math.min(700,v*.5));pr.l=now;pr.x=x;
 if(x>=80&&!pr.hit){pr.hit=1;pr.pop=now;try{navigator.vibrate&&navigator.vibrate(8)}catch(_){}}else if(x<80)pr.hit=0;
 if(e.cancelable)e.preventDefault()};
const pu=()=>{if(!pr||pr.run)return;const P=pr;if(!P.on){pr=null;return}sw=true;setTimeout(()=>sw=false,0);
 P.run=1;P.t=0;if(P.x>=80){P.t=96;P.ref=1;P.dv+=120;P.w=11;setTimeout(()=>{P.out=performance.now();P.t=0;P.la=Math.ceil(P.a/TAU+.02)*TAU+TAU;P.wv=P.w},1400)}
 if(!raf)raf=requestAnimationFrame(tick)};

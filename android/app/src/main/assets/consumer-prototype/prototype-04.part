#phone .iv9-st .t{font-size:16px;font-weight:700}
#phone .iv9-st .s{font-size:14px;color:var(--mu);margin-top:2px;line-height:20px}
#phone .iv9-o{display:flex;align-items:center;gap:16px;width:100%;height:64px;border:0;background:none;text-align:left;font-size:17px;font-weight:700;color:var(--tx)}
#phone .iv9-o i{width:44px;height:44px;border-radius:16px;display:flex;align-items:center;justify-content:center;color:#fff;font-style:normal;font-weight:800}
#phone .us9-ph{margin:18px 24px 0;padding:14px;border-radius:28px;background:var(--chip)}
#phone .us9-s{min-height:132px;padding:14px 16px;border-radius:16px;background:var(--bg);font:600 15px/22px ui-monospace,Menlo,Consolas,monospace;white-space:pre-wrap;word-break:break-word;border:1px solid var(--ln)}
#phone .us9-in{margin-top:8px;color:var(--tintfg);font-weight:800}
#phone .us9-in::after{content:"";display:inline-block;width:2px;height:16px;margin-left:2px;vertical-align:-2px;background:var(--tintfg);animation:us9b 1s steps(1) infinite}
@keyframes us9b{50%{opacity:0}}
#phone .us9-g{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:12px}
#phone .us9-k{height:46px;border:0;border-radius:14px;background:var(--bg);font-size:20px;font-weight:700;color:var(--tx)}
#phone .us9-k.go{grid-column:span 2;background:var(--br);color:var(--on);font-size:16px;font-weight:800}
#phone .us9-k:active{transform:scale(.96)}
#phone .bk9-v{display:grid;grid-template-columns:1fr 1fr;gap:10px;padding:16px 24px 0}
#phone .bk9-v button{padding:16px;border:0;border-radius:20px;background:var(--chip);text-align:left;font-size:15px;color:var(--tx);box-shadow:inset 0 0 0 2px transparent;transition:box-shadow .15s,background .15s}
#phone .bk9-v button.on{background:var(--tint);box-shadow:inset 0 0 0 2px var(--br)}
#phone .bk9-v .e{height:36px;color:var(--tintfg)}
#phone .bk9-v b{display:block;font-size:17px;margin-top:6px}
#phone .bk9-v span{display:block;margin-top:2px;color:var(--mu);font-size:14px}
#phone .bk9-q{position:relative;width:240px;height:240px;margin:34px auto 0;border-radius:24px;background:var(--chip);overflow:hidden}
#phone .bk9-q::before,#phone .bk9-q::after{content:"";position:absolute;inset:18px;border-radius:14px;border:3px solid var(--br);-webkit-mask:linear-gradient(#000 0 0) top left/36px 36px no-repeat,linear-gradient(#000 0 0) top right/36px 36px no-repeat,linear-gradient(#000 0 0) bottom left/36px 36px no-repeat,linear-gradient(#000 0 0) bottom right/36px 36px no-repeat;mask:linear-gradient(#000 0 0) top left/36px 36px no-repeat,linear-gradient(#000 0 0) top right/36px 36px no-repeat,linear-gradient(#000 0 0) bottom left/36px 36px no-repeat,linear-gradient(#000 0 0) bottom right/36px 36px no-repeat}
#phone .bk9-q::after{inset:auto 26px;top:30px;height:3px;border:0;border-radius:2px;background:var(--br);-webkit-mask:none;mask:none;animation:bk9s 2s ease-in-out infinite alternate}
@keyframes bk9s{to{transform:translateY(176px)}}
#phone .bk9-d{display:flex;gap:12px;justify-content:center;margin-top:22px}

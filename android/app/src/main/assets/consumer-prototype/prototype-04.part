#phone #sc:has(.check)>div[style*="margin:44px 24px 0"]>div>b{font-size:16px}
</style>
<style id="v947toss">/* v947, Toss-style pass 62. My loan: the amount left is the hero (44px) over a thicker bar, the details are flat 56px lines, the schedule is a timeline (a dot per payment, the next one in the brand colour, "Next" as a pill) and the list now scrolls clear of the two buttons. */
#phone #sc:has(.sched) .big{font-size:44px!important;line-height:52px!important;letter-spacing:-1.2px!important;font-weight:800!important}
#phone #sc:has(.sched) .pad>div[style*="height:8px"]{height:10px!important;border-radius:5px!important;margin-top:18px!important}

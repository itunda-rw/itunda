var all=[].concat(D.line,D.duo,D.solid);
var find=function(n){for(var i=0;i<all.length;i++)if(all[i][0]===n)return all[i][3]};
window.itundaIcon=function(n,s,c){s=s||24;var v=find(n);if(!v)return'';c=c||'currentColor';
 v=v.replace(/currentColor/g,c);return v.replace('<svg ','<svg width="'+s+'" height="'+s+'" aria-hidden="true" ')};
window.itundaFaceOriginal=function(n,s){s=s||32;return O[n]?'<img src="data:image/svg+xml;utf8,'+encodeURIComponent(O[n])+'" width="'+s+'" height="'+s+'" alt="">':''};
var old=document.getElementById('v905toss');if(old)old.remove();
var T=['home','qr','compass','msg','user'],S=['home-solid','qr-solid','compass-solid','chat-solid','user-solid'];
function tabs(){document.querySelectorAll('#phone nav.tabs').forEach(function(nav){[].forEach.call(nav.children,function(b,i){
 if(!T[i])return;var on=b.classList.contains('on'),key=T[i]+(on?'S':'L'),sv=b.querySelector('svg');
 if(!sv||sv.getAttribute('data-i6')===key)return;
 var h=window.itundaIcon(on?S[i]:T[i],24);if(!h)return;var t=document.createElement('div');t.innerHTML=h;var n=t.firstChild;n.setAttribute('data-i6',key);sv.replaceWith(n)})})}
var MAP={'\u2764\uFE0F':'itunda-heart','\u{1F437}':'piggy','\u{1F359}':'gimbap','\u{1F376}':'soju'};
function faces(){document.querySelectorAll('.ef:not(.io)').forEach(function(e){var k=MAP[e.textContent];if(k&&O[k]){e.classList.add('io');e.style.backgroundImage='url("data:image/svg+xml;utf8,'+encodeURIComponent(O[k])+'")'}})}
var q=0;function run(){q=0;tabs();faces()}
new MutationObserver(function(){if(!q){q=1;requestAnimationFrame(run)}}).observe(document.documentElement,{childList:true,subtree:true,attributes:true,attributeFilter:['class']});
run();

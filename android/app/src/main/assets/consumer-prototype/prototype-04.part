<style id="toss-login">
/* Toss-style login & sign-up: big left-aligned titles, underline fields, plain keypad, roomy CTA */
#sc:has(#phv) .h1,#sc:has(.dots6) .h1,#sc:has(.nm94) .h1{font-size:28px;line-height:1.38;letter-spacing:-.02em;font-weight:800;text-align:left}
#sc:has(#phv) .pad,#sc:has(.nm94) .pad{padding-left:24px;padding-right:24px}
#sc:has(.dots6) .pad{text-align:left!important;padding-left:24px!important;padding-right:24px!important}
#sc:has(.dots6) .pad .mu,#sc:has(.dots6) #pe,#sc:has(#phv) #phe,#sc:has(.nm94) .mu{font-size:15px!important;line-height:1.5;margin-top:10px!important}
#sc:has(.dots6) .av94{margin:0 0 18px!important;width:52px;height:52px;font-size:20px}
#sc:has(.dots6) .dots6{justify-content:flex-start!important;margin:30px 0 0 24px!important;gap:14px}
#sc:has(.dots6) .lk94{justify-content:flex-start!important;padding:26px 24px 0!important}
#sc:has(#phv) .field.phf{background:none!important;border-radius:0!important;box-shadow:none!important;border:0!important;border-bottom:2px solid var(--lk)!important;margin:12px 24px 0!important;width:auto!important;padding:4px 0 10px!important}
#sc:has(#phv) #phv{font-size:30px!important;letter-spacing:-.01em}
#sc .nm94{font-size:26px!important;font-weight:800;background:none!important;border:0!important;border-bottom:2px solid var(--lk)!important;border-radius:0!important;box-shadow:none!important;padding:10px 0!important;letter-spacing:-.01em}
#sc:has(#phv) .keys button,#sc:has(.dots6) .keys button{font-weight:500;font-size:26px;border-radius:18px;transition:background .12s}
#sc:has(#phv) .keys button:active,#sc:has(.dots6) .keys button:active{background:var(--ch,rgba(120,120,140,.14))}
#sc:has(#phv) .cta .btn,#sc:has(.nm94) .cta .btn{height:56px;border-radius:16px;font-size:17px;font-weight:800;letter-spacing:-.01em}
#sc:has(#phv) .cta,#sc:has(.nm94) .cta{padding:10px 20px 18px;border:0}
#layer .cb{border-radius:50%}
</style>

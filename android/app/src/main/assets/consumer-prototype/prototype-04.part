#phone .screen:has(.pkempty) .pkempty::before{content:"";display:block;width:72px;height:72px;margin:0 auto 18px;border-radius:50%;background:var(--tint) url("data:image/svg+xml;utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 72 72'%3E%3Crect x='22' y='38' width='8' height='14' rx='4' fill='%23FFC21A'/%3E%3Crect x='32' y='30' width='8' height='22' rx='4' fill='%233DC48B'/%3E%3Crect x='42' y='22' width='8' height='30' rx='4' fill='%238F89FF'/%3E%3C/svg%3E") center/72px no-repeat}
#phone .screen:has(.pkempty) .agt{font-size:19px;font-weight:800;color:var(--tx);padding-top:28px}

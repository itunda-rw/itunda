#phone #sc:has(.sched)>div[style*="margin:24px 24px 0"]{margin:28px 24px 0!important;padding:0!important;background:none!important;border-radius:0!important}
#phone #sc:has(.sched)>div[style*="margin:24px 24px 0"]>div{height:56px!important;border:0!important}
#phone #sc:has(.sched)>div[style*="margin:24px 24px 0"]>div>b{font-size:16px;font-weight:700}
#phone #sc:has(.sched) .pad[style*="padding-bottom:96px"]{padding-bottom:200px!important}
#phone #sc:has(.sched) .pad[style*="padding-bottom:96px"]>div:first-child{font-size:20px!important;letter-spacing:-.4px;margin-bottom:12px!important}
#phone #sc .sched{position:relative;display:flex!important;align-items:center;gap:12px;min-height:60px;padding:0 0 0 28px!important;border:0!important}
#phone #sc .sched::before{content:"";position:absolute;left:5px;top:50%;width:10px;height:10px;margin-top:-5px;border-radius:50%;background:#C9CED6;z-index:1}
#phone #sc .sched::after{content:"";position:absolute;left:9px;top:0;bottom:0;width:2px;background:var(--chip)}
#phone #sc .sched:first-of-type::after,#phone #sc .sched:first-child::after{top:50%}
#phone #sc .sched:last-child::after{bottom:50%}
#phone #sc .sched:has(.s[style*="--lk"])::before{background:var(--lk);box-shadow:0 0 0 4px var(--tint)}
#phone #sc .sched .d{flex:1;font-size:16px;min-width:0}

<style id="v904toss">
/* v904: Toss-style pass 31. Toss Icons share one weight and round ends everywhere. The leftover line icons drawn by older screens (stroke 1.6 to 2, mixed caps) now match the itundaicons set: 2.25 weight, round caps and joins, and the same shapes for chevron, search, pin, bolt, bell, pencil and close. */
#phone svg[data-n904]{stroke-linecap:round;stroke-linejoin:round}

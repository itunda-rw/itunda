<style id="v926toss">
/* v926: Toss-style pass 53. Manage cards: roomy 72px rows with a 64x40 card face (chip detail), 17px names, a soft "Add a card" button. Daily challenge: a seven-day streak strip (done days filled, today outlined), a larger flame and heading. */
#phone .mcl{padding-top:8px}
#phone .mcl .mcr{display:flex;align-items:center;gap:16px;min-height:72px;padding:8px 0}
#phone .mcl .mci{position:relative;flex:0 0 64px;width:64px;height:40px;border-radius:8px;overflow:hidden}
#phone .mcl .mci::before{content:"";position:absolute;left:8px;top:11px;width:11px;height:8px;border-radius:2px;background:rgba(255,255,255,.55)}
#phone .mcl .mci::after{content:"";position:absolute;left:8px;right:8px;bottom:8px;height:3px;border-radius:2px;background:rgba(255,255,255,.35)}
#phone .mcl .mcm b{display:block;font-size:17px;font-weight:700}
#phone .mcl .mcm span{display:block;margin-top:2px;font-size:14px;color:var(--mu);font-variant-numeric:tabular-nums}
#phone#phone#phone .screen .mcl .acb{margin-top:16px;height:52px;border:0;border-radius:16px;background:var(--tint)!important;color:var(--tintfg)!important;font-size:16px;font-weight:800}
#phone .st926{display:flex;justify-content:space-between;gap:6px;padding:20px 24px 4px}
#phone .st926 div{flex:1;display:flex;flex-direction:column;align-items:center;gap:8px;font-size:12px;font-weight:700;color:var(--tt)}
#phone .st926 i{width:36px;height:36px;border-radius:50%;background:var(--chip);display:flex;align-items:center;justify-content:center}
#phone .st926 .d i{background:var(--br)}
#phone .st926 .d i::after{content:"";width:12px;height:7px;border-left:2.5px solid #fff;border-bottom:2.5px solid #fff;transform:rotate(-45deg) translate(1px,-1px);border-radius:1px}
#phone .st926 .t i{background:none;box-shadow:inset 0 0 0 2px var(--br)}
#phone .st926 .t{color:var(--tx)}
#phone .st926 .d i{animation:st926 .4s cubic-bezier(.2,.9,.3,1.3) backwards;animation-delay:calc(var(--k)*70ms)}
@keyframes st926{from{transform:scale(.3);opacity:0}}
@media (prefers-reduced-motion:reduce){#phone .st926 i{animation:none!important}}
#phone .screen.dc926 .h1{font-size:30px;line-height:38px}
#phone .screen.dc926 div[style*="font-size:40px"]{font-size:52px!important;line-height:60px}

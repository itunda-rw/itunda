<style id="glass-polish-v735">
/* v735: consistency pass. (1) Secondary text on glass is darker in light mode and lighter in dark mode, so it stays readable on frosted surfaces. (2) One focus ring for every glass control. CSS only. */
#phone :is(.hc,.sec,.cc95,.nvc,.pz-menu,.pz-stamp,.pz-q,.pz-hub,.bal718,.keys,.field,.emp,.card,.cpn,.map97 .cap,.mps,.mphint,.nvt2){--tt:#5F6A78;--mu:#566170}
@media (prefers-color-scheme:dark){:root:not([data-theme=light]) #phone :is(.hc,.sec,.cc95,.nvc,.pz-menu,.pz-stamp,.pz-q,.pz-hub,.bal718,.keys,.field,.emp,.card,.cpn,.map97 .cap,.mps,.mphint,.nvt2){--tt:#A9B1BE;--mu:#B4BBC7}}
:root[data-theme=dark] #phone :is(.hc,.sec,.cc95,.nvc,.pz-menu,.pz-stamp,.pz-q,.pz-hub,.bal718,.keys,.field,.emp,.card,.cpn,.map97 .cap,.mps,.mphint,.nvt2){--tt:#A9B1BE;--mu:#B4BBC7}

/* keyboard focus: same ring on glass buttons, chips, rows and inputs */

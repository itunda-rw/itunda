})();
</script>
<script>
(function(){try{
if(typeof screens==='undefined'||typeof S==='undefined')return;
var M={fr:[['Use points','Utiliser les points'],[' pts available',' pts disponibles'],[' · using ',' · utilisation de '],['No points yet. Win some in the daily draw','Pas encore de points. Gagnez-en au tirage du jour'],['>You pay<','>Vous payez<'],[' claimed',' réclamé'],[' · almost gone',' · presque épuisé']],
rw:[['Use points','Koresha amanota'],[' pts available',' amanota arahari'],[' · using ',' · ukoresha '],['No points yet. Win some in the daily draw','Nta manota urabona. Yegukure amwe mu mukino w’uyu munsi'],['>Points<','>Amanota<'],['>You pay<','>Wishyura<'],[' claimed',' yatwawe'],[' · almost gone',' · hasigaye bike']]};

<script id="ez666">
try{(()=>{
if(typeof screens==='undefined'||typeof STK==='undefined'||!S.inv)return;
/* v666: itunda 증권, round 9. From the Toss 증권 research (financials shown as simple 5-year bars; the amount you are short is worked out for you). Stock page: a "Financials" block with a Revenue / Operating profit switch and five yearly bars, the latest one highlighted, plus a plain line on how it moved vs last year. Order sheet: when a buy costs more than your itunda Bank balance, the cost summary adds "You need N RWF more in itunda Bank". Sample numbers. */
const I=S.inv,T=(e,f)=>({en:e,fr:f||e,rw:e}[S.lang]||e);
const hash=s=>{let h=2166136261;for(let i=0;i<s.length;i++){h^=s.charCodeAt(i);h=Math.imul(h,16777619)}return h>>>0};
const st=tk=>STK.find(x=>x[0]===tk);
const dom=h=>{const d=document.createElement('div');d.innerHTML=h;return d};
const nf=n=>Math.round(n).toLocaleString('en-US');
I.fz=I.fz||'rev';
window.ezFz=k=>{I.fz=k;render('fade-none')};
const series=(tk,k)=>{const b=60+hash(tk+'fb')%240;let v=b,out=[];for(let i=0;i<5;i++){out.push(v);v=v*(1+((hash(tk+k+i)%21)-6)/100)}
 return k==='op'?out.map((x,i)=>x*(0.12+(hash(tk+'m'+i)%10)/100)):out};
const _sk=screens.stock;
if(_sk)screens.stock=function(){let h=String(_sk.apply(this,arguments));try{
 const tk=I.sk,s=st(tk);if(!s||h.indexOf('ez-fn')>=0)return h;
 const a=series(tk,I.fz),mx=Math.max(...a),yr=[2022,2023,2024,2025,2026],ch=(a[4]/a[3]-1)*100;
 const lab=I.fz==='rev'?T('Revenue','Chiffre d’affaires'):T('Operating profit','Résultat d’exploitation');
 const blk=`<div class="ez-fn"><h3>${T('Financials','Résultats')}</h3><div class="tg"><button class="${I.fz==='rev'?'on':''}" onclick="ezFz('rev')">${T('Revenue','Chiffre d’affaires')}</button><button class="${I.fz==='op'?'on':''}" onclick="ezFz('op')">${T('Operating profit','Résultat d’exploitation')}</button></div><div class="bars">${a.map((x,i)=>`<div class="${i===4?'cur':''}"><em>${x.toFixed(0)}</em><i style="height:${Math.max(8,Math.round(x/mx*92))}px"></i></div>`).join('')}</div><div class="yr">${yr.map(y=>`<span>${y}</span>`).join('')}</div><div class="sum">${lab} ${ch>=0?T('rose','a progressé de'):T('fell','a reculé de')} <b class="${ch>=0?'up':'dn'}">${Math.abs(ch).toFixed(1)}%</b> ${T('vs last year','vs l’an dernier')} · <span class="mu">${T('RWF billion, sample numbers','milliards RWF, chiffres d’exemple')}</span></div></div>`;
 const R=dom(h),at=R.querySelector('.ez-dv')||R.querySelector('.ez-vt');if(!at)return h;
 at.insertAdjacentHTML('beforebegin',blk);return R.innerHTML}catch(e){console.error('ez666 stock',e);return h}};
/* order sheet: shortfall line */
const enh=()=>{try{
 const lay=document.getElementById('layer'),cs=lay&&lay.querySelector('.ez-cs');if(!cs||cs.querySelector('.ez-sf')){return}
 const t=I.tr;if(!t||t.side!=='buy')return;
 const p=(t.type==='limit'&&t.lim)?t.lim:st(t.tk)[2],q=Math.max(0,Number(t.q)||0),v=q*p,f=q?Math.max(100,Math.round(v*.004)):0,need=v+f-S.bank;
 if(q&&need>0)cs.insertAdjacentHTML('beforeend',`<div class="ez-sf" style="color:var(--er);font-weight:700;border-top:1px solid var(--ln)"><span style="color:var(--er)">${T('You need more in itunda Bank','Il manque dans itunda Bank')}</span><b>${nf(need)} RWF</b></div>`)}catch(e){console.error('ez666 sheet',e)}};
const lay=document.getElementById('layer');
if(lay)new MutationObserver(()=>enh()).observe(lay,{childList:true,subtree:true});
})()}catch(x){console.error('v666',x)}
document.title=document.title.replace(/v\d+/,'v666');
</script>
<style id="ez667s">
#phone .ez-tr{margin:22px 24px 0}
#phone .ez-tr h3{margin:0;font-size:18px;font-weight:800}
#phone .ez-tr svg{display:block;width:100%;height:120px;margin-top:12px}
#phone .ez-tr .tg{display:flex;gap:8px;margin-top:10px}
#phone .ez-tr .tg button{height:32px;padding:0 14px;border:0;border-radius:16px;background:var(--chip);color:var(--tx);font:inherit;font-size:13px;font-weight:700}
#phone .ez-tr .tg button.on{background:var(--tx);color:var(--bg)}
#phone .ez-tr .lg{display:flex;gap:16px;margin-top:12px;font-size:13px;color:var(--mu)}
#phone .ez-tr .lg i{display:inline-block;width:14px;height:0;border-top:3px solid;vertical-align:middle;margin-right:6px}
#phone .ez-tr .sm2{margin-top:8px;font-size:14px}
</style>
<script id="ez667">
try{(()=>{
if(typeof screens==='undefined'||typeof STK==='undefined'||!S.inv)return;
/* v667: itunda 증권, round 10. Toss 증권 added an "investment asset trend" (value vs. what you put in, over 1 week / 1 month / 3 months / 1 year). Portfolio: when you hold stocks, an "Asset trend" block with a two-line chart (your value, and the amount you put in as a dashed line), a 1W / 1M / 3M / 1Y switch, and one line saying how far the value is above or below what you put in. The chart is a sample history that always ends at today's real value. */
const I=S.inv,T=(e,f)=>({en:e,fr:f||e,rw:e}[S.lang]||e);
const hash=s=>{let h=2166136261;for(let i=0;i<s.length;i++){h^=s.charCodeAt(i);h=Math.imul(h,16777619)}return h>>>0};
const st=tk=>STK.find(x=>x[0]===tk);
const dom=h=>{const d=document.createElement('div');d.innerHTML=h;return d};
const nf=n=>Math.round(n).toLocaleString('en-US');
I.tp=I.tp||'1M';
window.ezTp=k=>{I.tp=k;render('fade-none')};
const _iv=screens.invest;
if(_iv)screens.invest=function(){let h=String(_iv.apply(this,arguments));try{
 if(I.tab!=='port'||h.indexOf('ez-tr')>=0)return h;
 const ks=Object.keys(S.hold||{}).filter(k=>S.hold[k]&&S.hold[k].q>0&&st(k));if(!ks.length)return h;
 let now=0,cost=0;ks.forEach(k=>{now+=S.hold[k].q*st(k)[2];cost+=S.hold[k].q*S.hold[k].avg});
 const P={'1W':[8,.02],'1M':[16,.05],'3M':[24,.09],'1Y':[32,.16]},[n,amp]=P[I.tp]||P['1M'],sd=hash(ks.join()+I.tp);
 const v=[];for(let i=0;i<n;i++){const f=(n-1-i)/(n-1),w=((hash(sd+'x'+i)%2001)/1000-1);v.push(i===n-1?now:now*(1-f*amp*(((sd%9)-3)/4)+w*amp*.18*Math.min(1,f*3)))}
 const lo=Math.min(...v,cost),hi=Math.max(...v,cost),Y=x=>10+(1-(x-lo)/((hi-lo)||1))*100,X=i=>i/(n-1)*300;
 const up=now>=cost,col=up?'var(--ok)':'var(--er)',d=now-cost,pc=cost?d/cost*100:0;
 const svg=`<svg viewBox="0 0 300 120" preserveAspectRatio="none" role="img" aria-label="${T('Asset trend','Évolution du patrimoine')}"><line x1="0" x2="300" y1="${Y(cost).toFixed(1)}" y2="${Y(cost).toFixed(1)}" stroke="var(--mu)" stroke-width="1.5" stroke-dasharray="4 4" vector-effect="non-scaling-stroke"/><polyline fill="none" stroke="${col}" stroke-width="2.5" stroke-linejoin="round" vector-effect="non-scaling-stroke" points="${v.map((x,i)=>X(i).toFixed(1)+','+Y(x).toFixed(1)).join(' ')}"/></svg>`;
 const blk=`<div class="ez-tr"><h3>${T('Asset trend','Évolution du patrimoine')}</h3>${svg}<div class="tg">${['1W','1M','3M','1Y'].map(k=>`<button class="${I.tp===k?'on':''}" onclick="ezTp('${k}')">${k}</button>`).join('')}</div><div class="lg"><span><i style="border-color:${col}"></i>${T('Value','Valeur')} ${nf(now)}</span><span><i style="border-color:var(--mu);border-top-style:dashed"></i>${T('Put in','Investi')} ${nf(cost)}</span></div><div class="sm2">${T('Your stocks are worth ','Vos actions valent ')}<b class="${up?'up':'dn'}">${nf(Math.abs(d))} RWF ${up?T('more','de plus'):T('less','de moins')} (${Math.abs(pc).toFixed(1)}%)</b> ${T('than you put in.','que ce que vous avez investi.')} <span class="mu">${T('Sample history','Historique d’exemple')}</span></div></div>`;
 const R=dom(h),td=R.querySelector('.ez-td');if(!td)return h;
 const box=td.closest('.pad')||td.parentElement;box.insertAdjacentHTML('afterend',blk);return R.innerHTML}catch(e){console.error('ez667 invest',e);return h}};
})()}catch(x){console.error('v667',x)}
document.title=document.title.replace(/v\d+/,'v667');
</script>
<style id="ez668s">
#phone .ez-gp{margin:24px 0 0}
#phone .ez-gp .hd{display:flex;justify-content:space-between;align-items:center;margin:0 24px}
#phone .ez-gp h3{margin:0;font-size:18px;font-weight:800}
#phone .ez-gp .hd button{border:0;background:none;color:var(--lk);font:inherit;font-weight:700;font-size:14px}
#phone .ez-gp .hint{margin:8px 24px 0;font-size:13px;color:var(--mu)}
#phone .ez-gp .g{display:flex;justify-content:space-between;align-items:center;padding:12px 24px;cursor:pointer}
#phone .ez-gp .g b{display:block;font-size:16px}
#phone .ez-gp .g small{display:block;font-size:13px;color:var(--mu);margin-top:2px}
#phone .ez-gp .g div:last-child{text-align:right}
.ez-gs input{width:100%;box-sizing:border-box;height:52px;border:0;border-radius:14px;background:var(--chip);color:var(--tx);font:inherit;font-size:16px;padding:0 16px;margin-top:12px}
.ez-gs .t{font-size:13px;color:var(--mu);font-weight:600;margin-top:16px}
</style>
<script id="ez668">
try{(()=>{
if(typeof screens==='undefined'||typeof STK==='undefined'||!S.inv)return;
/* v668: itunda 증권, round 11. Toss 증권 added "종목 묶어보기" (group your holdings your own way and see each group's return). Portfolio: a "My groups" block under the asset trend. "+ New group" opens a sheet: a name and the stocks you hold; each group row shows its value and return since you bought; tap a row to edit or delete it. Sample data. */
const I=S.inv,T=(e,f)=>({en:e,fr:f||e,rw:e}[S.lang]||e);
const st=tk=>STK.find(x=>x[0]===tk);
const dom=h=>{const d=document.createElement('div');d.innerHTML=h;return d};
const nf=n=>Math.round(n).toLocaleString('en-US');
const ea=s=>String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
I.grp=I.grp||[];I.gid=I.gid||1;
const held=()=>Object.keys(S.hold||{}).filter(k=>S.hold[k]&&S.hold[k].q>0&&st(k));
const stat=g=>{let v=0,c=0;g.tks.forEach(k=>{if(S.hold[k]&&S.hold[k].q>0&&st(k)){v+=S.hold[k].q*st(k)[2];c+=S.hold[k].q*S.hold[k].avg}});return{v,c,d:v-c,p:c?(v-c)/c*100:0}};
const drawG=()=>{const D=I.gd,lay=document.getElementById('layer');if(!lay)return;
 lay.innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet ez-gs"><div style="font-size:20px;font-weight:800">${D.id?T('Edit group','Modifier le groupe'):T('New group','Nouveau groupe')}</div><input id="ezgn" maxlength="20" value="${ea(D.name)}" placeholder="${T('Group name, like Long term','Nom du groupe, ex. Long terme')}" oninput="I_gname(this.value)" aria-label="${T('Group name','Nom du groupe')}"><div class="t">${T('Stocks you hold','Actions que vous détenez')}</div><div class="req" role="group" style="margin-top:8px">${held().map(k=>`<button class="${D.tks.includes(k)?'on':''}" aria-pressed="${D.tks.includes(k)}" onclick="ezGTk('${k}')">${k}</button>`).join('')}</div><button class="btn" style="margin-top:20px" onclick="ezGSave()">${T('Save','Enregistrer')}</button>${D.id?`<button class="btn sec2" style="margin-top:10px" onclick="ezGDel(${D.id})">${T('Delete group','Supprimer')}</button>`:''}</div>`};
window.I_gname=v=>{I.gd.name=v};
window.ezGNew=id=>{const g=id&&I.grp.find(x=>x.id===id);I.gd=g?{id:g.id,name:g.name,tks:g.tks.slice()}:{id:0,name:'',tks:[]};drawG()};
window.ezGTk=k=>{const a=I.gd.tks,i=a.indexOf(k);i<0?a.push(k):a.splice(i,1);drawG()};
window.ezGSave=()=>{const D=I.gd,n=(D.name||'').trim();if(!n||!D.tks.length){toast(T('Add a name and pick a stock','Ajoutez un nom et une action'));return}
 if(D.id){const g=I.grp.find(x=>x.id===D.id);if(g){g.name=n;g.tks=D.tks.slice()}}else I.grp.push({id:I.gid++,name:n,tks:D.tks.slice()});closeSheet();render('fade-none')};
window.ezGDel=id=>{I.grp=I.grp.filter(x=>x.id!==id);closeSheet();render('fade-none')};
const _iv=screens.invest;
if(_iv)screens.invest=function(){let h=String(_iv.apply(this,arguments));try{
 if(I.tab!=='port'||h.indexOf('ez-gp')>=0||!held().length)return h;
 const rows=I.grp.map(g=>{const s=stat(g);return `<div class="g" onclick="ezGNew(${g.id})" role="button" tabindex="0"><div><b>${ea(g.name)}</b><small>${g.tks.join(' · ')}</small></div><div><b>${nf(s.v)} RWF</b><small class="${s.d>=0?'up':'dn'}">${s.d>=0?'+':'−'}${nf(Math.abs(s.d))} (${(s.p>=0?'+':'−')+Math.abs(s.p).toFixed(1)}%)</small></div></div>`}).join('');
 const blk=`<div class="ez-gp"><div class="hd"><h3>${T('My groups','Mes groupes')}</h3><button onclick="ezGNew(0)">+ ${T('New group','Nouveau groupe')}</button></div>${rows||`<div class="hint">${T('Group your stocks your own way, like Long term or Dividends, and see how each group is doing.','Regroupez vos actions à votre façon, ex. Long terme ou Dividendes, et suivez chaque groupe.')}</div>`}</div>`;
 const R=dom(h),at=R.querySelector('.ez-tr')||R.querySelector('.ez-td');if(!at)return h;
 (at.classList.contains('ez-tr')?at:(at.closest('.pad')||at)).insertAdjacentHTML('afterend',blk);return R.innerHTML}catch(e){console.error('ez668 invest',e);return h}};
})()}catch(x){console.error('v668',x)}
document.title=document.title.replace(/v\d+/,'v668');
</script>
<style id="ez669s">
#phone .ez-gf{margin:22px 24px 0;padding:16px 18px;border-radius:20px;background:var(--chip);display:flex;align-items:center;justify-content:space-between;gap:12px}
#phone .ez-gf b{display:block;font-size:16px}
#phone .ez-gf small{display:block;font-size:13px;color:var(--mu);margin-top:2px}
#phone .ez-gf button{flex:none;height:40px;padding:0 16px;border:0;border-radius:20px;background:var(--tx);color:var(--bg);font:inherit;font-size:14px;font-weight:700}
#phone .ez-gl{margin:24px 0 0}
#phone .ez-gl h3{margin:0 24px 6px;font-size:18px;font-weight:800}
#phone .ez-gl .g{padding:12px 24px}
#phone .ez-gl .g b{display:block;font-size:16px}
#phone .ez-gl .g small{display:block;font-size:13px;color:var(--mu);margin-top:2px}
#phone .ez-gl .g .a{display:flex;gap:8px;margin-top:10px}
#phone .ez-gl .g .a button{height:34px;padding:0 14px;border:0;border-radius:17px;background:var(--chip);color:var(--tx);font:inherit;font-size:13px;font-weight:700}
.ez-gd .q{display:flex;align-items:center;justify-content:space-between;margin-top:16px}
.ez-gd .q div{display:flex;align-items:center;gap:14px}
.ez-gd .q button{width:38px;height:38px;border:0;border-radius:19px;background:var(--chip);color:var(--tx);font:inherit;font-size:20px;font-weight:700}
.ez-gd input{width:100%;box-sizing:border-box;height:52px;border:0;border-radius:14px;background:var(--chip);color:var(--tx);font:inherit;font-size:16px;padding:0 16px;margin-top:10px}
.ez-gd .t{font-size:13px;color:var(--mu);font-weight:600;margin-top:16px}
</style>
<script id="ez669">
try{(()=>{
if(typeof screens==='undefined'||typeof STK==='undefined'||!S.inv)return;
/* v669: itunda 증권, round 12. Toss 증권 lets you gift shares you hold to a friend (just a name and contact; they accept or decline, and a declined gift is cancelled). Stock page: when you hold the stock, a "Gift shares" card opens a sheet to pick a friend (or type a name) and how many shares; sending takes them out of your holding. Portfolio: a "Gifts you sent" list with a Waiting / Accepted / Declined status; for the demo, two buttons play the friend's answer, and a declined gift puts the shares back. A short note says gift tax rules may apply. Sample friends, no real transfer. */
const I=S.inv,T=(e,f)=>({en:e,fr:f||e,rw:e}[S.lang]||e);
const st=tk=>STK.find(x=>x[0]===tk);
const dom=h=>{const d=document.createElement('div');d.innerHTML=h;return d};
const ea=s=>String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const FR=['Aline M.','Eric N.','Grace U.'];
I.gifts=I.gifts||[];I.giid=I.giid||1;
const have=tk=>(S.hold&&S.hold[tk]&&S.hold[tk].q)||0;
const draw=()=>{const G=I.gf,lay=document.getElementById('layer');if(!lay)return;const mx=have(G.tk);
 lay.innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet ez-gd"><div style="font-size:20px;font-weight:800">${T('Gift ','Offrir ')}${G.tk}</div><div class="t">${T('Who is it for?','Pour qui ?')}</div><div class="req" role="group" style="margin-top:8px">${FR.map(n=>`<button class="${G.to===n?'on':''}" aria-pressed="${G.to===n}" onclick="ezGfTo('${n}')">${n}</button>`).join('')}</div><input value="${ea(FR.includes(G.to)?'':G.to)}" maxlength="24" placeholder="${T('Or type a name','Ou saisissez un nom')}" oninput="ezGfName(this.value)" aria-label="${T('Friend name','Nom de l’ami')}"><div class="q"><span>${T('Shares','Actions')} <span class="mu">(${T('you hold ','vous détenez ')}${mx})</span></span><div><button onclick="ezGfQ(-1)" aria-label="${T('Fewer','Moins')}">−</button><b style="min-width:20px;text-align:center">${G.q}</b><button onclick="ezGfQ(1)" aria-label="${T('More','Plus')}">+</button></div></div><div class="sm mu" style="margin-top:14px;line-height:20px">${T('Your friend can accept or decline. If they decline, the shares come back to you. Gift tax rules may apply, so check what applies to you.','Votre ami peut accepter ou refuser. En cas de refus, les actions vous reviennent. Des règles fiscales sur les dons peuvent s’appliquer.')}</div><button class="btn" style="margin-top:18px" onclick="ezGfSend()">${T('Send gift','Envoyer le cadeau')}</button></div>`};
window.ezGfOpen=tk=>{if(!have(tk))return;I.gf={tk,to:'',q:1};draw()};
window.ezGfTo=n=>{I.gf.to=n;draw()};
window.ezGfName=v=>{I.gf.to=v};
window.ezGfQ=d=>{I.gf.q=Math.max(1,Math.min(have(I.gf.tk),I.gf.q+d));draw()};
window.ezGfSend=()=>{const G=I.gf,to=(G.to||'').trim();if(!to){toast(T('Pick a friend or type a name','Choisissez un ami'));return}
 const q=Math.min(G.q,have(G.tk));if(q<1)return;S.hold[G.tk].q-=q;if(S.hold[G.tk].q<=0)delete S.hold[G.tk];
 I.gifts.unshift({id:I.giid++,tk:G.tk,q,to,st:'wait'});closeSheet();render('fade-none');toast(T('Gift sent to ','Cadeau envoyé à ')+to)};
window.ezGfAns=(id,ok)=>{const g=I.gifts.find(x=>x.id===id);if(!g||g.st!=='wait')return;
 if(ok)g.st='ok';else{g.st='no';if(S.hold[g.tk])S.hold[g.tk].q+=g.q;else S.hold[g.tk]={q:g.q,avg:st(g.tk)[2]}}render('fade-none')};
const _sk=screens.stock;
if(_sk)screens.stock=function(){let h=String(_sk.apply(this,arguments));try{
 const tk=I.sk;if(!tk||!st(tk)||!have(tk)||h.indexOf('ez-gf')>=0)return h;
 const R=dom(h),at=R.querySelector('.ez-vt')||R.querySelector('.ez-bx');if(!at)return h;
 at.insertAdjacentHTML('beforebegin',`<div class="ez-gf"><div><b>${T('Gift shares','Offrir des actions')}</b><small>${T('Send some of your ','Envoyez une partie de vos ')}${tk}${T(' to a friend',' à un ami')}</small></div><button onclick="ezGfOpen('${tk}')">${T('Gift','Offrir')}</button></div>`);return R.innerHTML}catch(e){console.error('ez669 stock',e);return h}};
const _iv=screens.invest;
if(_iv)screens.invest=function(){let h=String(_iv.apply(this,arguments));try{
 if(I.tab!=='port'||h.indexOf('ez-gl')>=0||!I.gifts.length)return h;
 const lab={wait:T('Waiting for an answer','En attente'),ok:T('Accepted','Accepté'),no:T('Declined, shares returned','Refusé, actions rendues')};
 const rows=I.gifts.map(g=>`<div class="g"><b>${g.q} ${g.tk} ${T('to','à')} ${ea(g.to)}</b><small>${lab[g.st]}</small>${g.st==='wait'?`<div class="a"><button onclick="ezGfAns(${g.id},1)">${T('Demo: accepted','Démo : accepté')}</button><button onclick="ezGfAns(${g.id},0)">${T('Demo: declined','Démo : refusé')}</button></div>`:''}</div>`).join('');
 const R=dom(h),at=R.querySelector('.ez-gp')||R.querySelector('.ez-tr');if(!at)return h;
 at.insertAdjacentHTML('afterend',`<div class="ez-gl"><h3>${T('Gifts you sent','Cadeaux envoyés')}</h3>${rows}</div>`);return R.innerHTML}catch(e){console.error('ez669 invest',e);return h}};
})()}catch(x){console.error('v669',x)}
document.title=document.title.replace(/v\d+/,'v669');
</script>
<style id="ez670">
/* v670: Eats. The "Popular this week" rail had collapsed (cards drawn on top of each other) because the stocks list reuses the class name ez-rk with a 16px width. Restaurant page: the free-delivery banner repeated "Fee Free" from the line above, Group order sat in a bordered box, and the menu chips were black pills. Restaurant names in the grid are no longer cut to one line. */
#phone .ez-rail>.ez-rk{width:148px;flex:none;font-size:inherit;font-weight:inherit;color:inherit;text-align:left}
#phone .ez-rail>.ez-rk>.ez-c{width:100%}
#phone .ez-rail>.ez-rk>b{left:8px;top:2px}
#phone .e2-pm:not(.tap){display:none}
#phone .e2-sh>div>button.tap{border:0!important;box-shadow:none!important;background:none!important;border-radius:0!important;padding-left:0!important;padding-right:0!important}
#phone .e2-sc button.on{background:var(--tint)!important;color:var(--tintfg)!important}
#phone .ez-g .ez-n{white-space:normal;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;text-overflow:clip;line-height:20px}
</style>

<style id="ez671">
/* v671: Book a viewing, quiet. Before: two rows of grey chips (the chosen one barely different), the time row cut off at the edge, a summary line and a button saying the same thing twice. Now: two plain questions (Which day?, What time?) as rows with a check on the chosen one, and one button that names the slot. */
#phone .ezv-q{font-size:15px;font-weight:800;margin:26px 0 4px}
#phone .ezv-r{display:flex;align-items:center;justify-content:space-between;width:100%;min-height:52px;border:0;background:none!important;box-shadow:none;border-radius:0;padding:0;font:inherit;font-size:17px;color:var(--mu);text-align:left;cursor:pointer}
#phone .ezv-r.on{color:var(--tx);font-weight:800}
#phone .ezv-r svg{width:22px;height:22px;color:var(--lk);fill:none;stroke:currentColor;stroke-width:2.4;stroke-linecap:round;stroke-linejoin:round}
#phone .ezv-n{font-size:13px;line-height:19px;color:var(--mu);text-align:center;margin-top:10px}
/* v671: the three stacked grey toggle bars on List a home, Post a job and the Marketplace radius become plain rows with a check; Perks chips become check rows too. */
#phone .dg-sg{display:block;background:none;border-radius:0;padding:0;margin-top:2px}
#phone .dg-sg button{display:flex;align-items:center;justify-content:space-between;width:100%;height:auto;min-height:44px;padding:0;border:0;border-radius:0;background:none!important;box-shadow:none!important;color:var(--mu);font-size:17px;font-weight:400;text-align:left}
#phone .dg-sg button.on{color:var(--tx);font-weight:800}
#phone .dg-sg button.on::after,#phone #layer .v6b>div[style*="flex-wrap:wrap"]>.cch.on::after{content:"";flex:none;width:16px;height:9px;border-left:2.5px solid var(--lk);border-bottom:2.5px solid var(--lk);transform:rotate(-45deg) translateY(-2px)}
#phone #layer .v6b>div[style*="flex-wrap:wrap"]:has(>.cch){display:block!important}
#phone #layer .v6b>div[style*="flex-wrap:wrap"]>.cch{display:flex;align-items:center;justify-content:space-between;width:100%;min-height:48px;padding:0!important;margin:0!important;border:0;border-radius:0;background:none!important;box-shadow:none!important;color:var(--mu);font-size:17px;font-weight:400;text-align:left}
#phone #layer .v6b>div[style*="flex-wrap:wrap"]>.cch.on{color:var(--tx);font-weight:800}
</style>
<script id="ez671s">
try{(()=>{
const CK='<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>';
const esc=s=>String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;');
const fix=()=>{
 if(S.lang!=='en')return;
 const sh=document.querySelector('#layer .sheet'),b=sh&&(sh.querySelector('.v6b')||null);if(!b||b.dataset.ez671)return;
 const g=b.querySelectorAll('.chp');if(g.length<2)return;
 const read=c=>[...c.querySelectorAll('button')].map(x=>({t:x.textContent.trim(),on:x.classList.contains('on'),f:x.getAttribute('onclick')}));
 const days=read(g[0]),times=read(g[1]); const title=(b.querySelector('.h1')||{}).textContent||'Book a viewing',item=(b.querySelector('.h1+.mu')||{}).textContent||'';
 const m=/we send (.+?) a message/.exec(b.textContent),who=m?m[1]:'The agent';
 const d=days.find(x=>x.on),t=times.find(x=>x.on),go=sh.querySelector('.v6cta .btn,.cta .btn');
 const rows=a=>a.map(x=>'<button type="button" class="ezv-r'+(x.on?' on':'')+'" aria-pressed="'+x.on+'" onclick="'+x.f+'">'+esc(x.t)+(x.on?CK:'')+'</button>').join('');
 b.innerHTML='<div class="h1" style="font-size:22px;line-height:30px">'+esc(title)+'</div><div class="mu" style="font-size:15px;margin:8px 0 0">'+esc(item)+'</div><div class="ezv-q">Which day?</div>'+rows(days)+'<div class="ezv-q">What time?</div>'+rows(times);
 b.dataset.ez671='1';
 if(go){go.textContent='Request '+(d?d.t:'')+(t?', '+t.t:'');go.style.marginTop='0';
  let n=go.parentElement.querySelector('.ezv-n');if(!n){n=document.createElement('div');n.className='ezv-n';go.after(n)}n.textContent=who+' gets a message with this time.'}
};
const wrap=k=>{const o=window[k];if(typeof o!=='function'||o.__ez671)return;const w=function(){const r=o.apply(this,arguments);try{fix()}catch(e){}requestAnimationFrame(()=>{try{fix()}catch(e){}});return r};w.__ez671=1;window[k]=w};
['prView','prVSet'].forEach(wrap);
})()}catch(e){console.error('v671',e)}
document.title=document.title.replace(/v\d+/,'v671');
</script>
<style id="ez672">
/* v672: Property wording. "1 beds" is now "1 bed" (and "1 baths" "1 bath") in the list, the detail tiles and the owner summary; a sale row's price per m2 reads "266,667 RWF/m²" instead of "≈ 266,667 RWF / m²", so it no longer runs off the edge of the row. */
/* v672: list hearts. The save heart was a wide white pill laid over the middle of every thumbnail; it is now a small round button in the thumbnail's top-left corner, clear of the picture. */
#phone .dg-h.dg-h.dg-h.dg-h{left:30px!important;top:30px!important;right:auto!important;bottom:auto!important;width:30px!important;height:30px!important;min-width:0!important;min-height:0!important;padding:0!important;border-radius:50%!important;display:flex;align-items:center;justify-content:center;background:color-mix(in srgb,var(--bg) 88%,transparent)!important}
#phone .dg-h.dg-h.dg-h.dg-h .hrt{position:static!important;margin:0!important;padding:0!important;width:30px!important;height:30px!important;min-width:0!important;min-height:0!important;display:flex!important;align-items:center;justify-content:center;transform:none!important}
#phone .dg-h.dg-h.dg-h.dg-h{pointer-events:none}
#phone .dg-h.dg-h.dg-h.dg-h .hrt{pointer-events:auto}
#phone .dg-h.dg-h.dg-h.dg-h svg{width:17px!important;height:17px!important;margin:0!important;position:static!important}
/* v672: Delivery address. Before: two radio-button rows, an always-open text box and two stacked buttons. Now: a page with an icon per address (home, work, other), an optional rider note shown under it ("Blue gate, 2nd floor"), a "+ Add a new address" row that opens a short form (label Home / Work / Other, street or landmark, note for the rider), Remove on addresses you added, and a bottom bar: Close on the left, "Use this address" on the right. The chosen row shows a check on the right, like Toss lists, with no empty circles. Picking a row no longer closes the page by itself, so you can read the note first. */
#phone .ea-r{display:flex;align-items:center;gap:14px;width:100%;border:0;background:none;font:inherit;color:inherit;text-align:left;padding:14px 0;cursor:pointer}
#phone .ea-ic{flex:none;width:40px;height:40px;border-radius:14px;background:var(--chip);display:flex;align-items:center;justify-content:center;color:var(--tx)}
#phone .ea-ic svg{width:20px;height:20px}
#phone .ea-r.on .ea-ic{background:var(--tint);color:var(--tintfg)}
#phone .ea-tx{flex:1;min-width:0}#phone .ea-tx b{display:block;font-size:17px}
#phone .ea-tx span{display:block;font-size:14px;line-height:20px;color:var(--mu)}
#phone .ea-tx i{display:block;font-style:normal;font-size:13px;line-height:19px;color:var(--tintfg);margin-top:2px}
#phone .ea-rd{flex:none;width:22px;height:22px;color:var(--lk)}
#phone .ea-rd svg{width:22px;height:22px;fill:none;stroke:currentColor;stroke-width:2.6;stroke-linecap:round;stroke-linejoin:round}
#phone .ea-r:not(.on) .ea-rd{visibility:hidden}
#phone .ea-r.on .ea-tx b{font-weight:800}
#phone .ea-r:not(.on) .ea-tx b{font-weight:500}
#phone .ea-rm{border:0;background:none;color:var(--er);font:inherit;font-size:13px;padding:0;margin-top:4px;cursor:pointer}
#phone .ea-add{display:flex;align-items:center;gap:14px;width:100%;border:0;background:none;font:inherit;font-size:17px;font-weight:700;color:var(--lk);padding:14px 0;cursor:pointer;text-align:left}
#phone .ea-add .ea-ic{background:var(--tint);color:var(--tintfg);font-size:22px;font-weight:400}
#phone .ea-f{padding:4px 0 6px}
#phone .ea-f label{display:block;font-size:13px;font-weight:700;color:var(--mu);margin:14px 0 6px}
#phone .ea-f input{width:100%;height:48px;border:0;border-radius:14px;background:var(--chip);padding:0 16px;font:inherit;font-size:16px;color:var(--tx);outline:none}
#phone .ea-f input:focus{box-shadow:0 0 0 2px var(--lk)}
#phone .ea-lb{display:flex;gap:8px}
#phone .ea-lb button{border:0;border-radius:18px;background:var(--chip);color:var(--tx);font:inherit;font-size:15px;padding:0 16px;height:36px;cursor:pointer}
#phone .ea-lb button.on{background:var(--tint);color:var(--tintfg);font-weight:800}
/* v672: no bounce on screen changes. Every screen change used to run four motions at once: the whole screen slid in, each row and card then jumped up with a spring, every button pulsed (scale up and back), and the old screen slid away underneath. Together they read as the next screen bouncing. All of them are now instant (a 0.01 ms duration, so the code that waits for "animation end" still fires). Tab icons and the heart no longer pop either. Bottom sheets (small pickers) still slide up. */
#phone .screen.push,#phone .screen.pop,#phone .screen.push .row,#phone .screen.push .pkrow,#phone .screen.push .xc>*,#phone .screen.push .sec>*,#phone .v144x,#phone .btn,#phone #layer .sheet.v6pg.v6pg,#phone .btn:not(:disabled):not(.off),#view .v406g,#view .v406g.push,#view .v406g.pop,#view .v406g.fade,#view .v406g.fade-none,#phone .sheet.v6pg,#phone .v145pop svg,#phone .tabs button.pop svg{animation-duration:.01ms!important;animation-delay:0s!important;animation-timing-function:linear!important}
#phone .screen.push,#phone .screen.pop{animation-name:v672fade!important}
@keyframes v672fade{from{opacity:1}to{opacity:1}}
/* v672: back button like Toss. It was a thin "‹" chevron; it is now Toss's arrow: a straight shaft with an open arrowhead, about 20 px wide with a long shaft and a wide open head, thin 2 px line, the same arrow as the Toss keypad delete key, no background, and its left edge on the same 24 px margin as the page text. */
#phone .ib[aria-label="Back"] svg,#phone button[onclick^="back()"] svg{stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
/* v672: listing page. The save heart sat 26 px in from the right margin and below the title; it now ends on the 24 px margin, level with the title. A job's picture block (a large empty tint with one icon) is shorter, so the shift, pay and Apply button come into view without scrolling. */
#phone #sc button.hrt[id^="hf_"]{margin:-2px -14px 0 0!important;left:0!important;right:auto!important}
#phone #sc .pim[style*="height:200px"]{height:128px!important;border-radius:24px!important}
#phone #sc .pim[style*="height:200px"] svg{width:68px!important;height:68px!important}
/* v672: place page actions. Six chips ran off the right edge in a sideways-scrolling row ("Shar" was cut in half). They are now a grid of three per row: icon over label, Directions in the accent colour, all visible at once. */
#phone .nm-p{display:grid!important;grid-template-columns:repeat(3,1fr);gap:8px;overflow:visible!important;flex-wrap:wrap}
#phone .nm-p button{display:flex!important;flex-direction:column;align-items:center;justify-content:center;gap:4px;height:64px;min-width:0;padding:0 4px!important;margin:0!important;border-radius:16px;font-size:13px;font-weight:700;white-space:nowrap}
#phone .nm-p button i{font-style:normal;font-size:20px;line-height:22px}
</style>
<script id="ez672a">
try{(()=>{
const esc=s=>String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/"/g,'&quot;');
const oldDraw=window.eAddr;
const ICON=l=>{try{return ic(l==='Home'?'home':l==='Work'?'briefcase':'pin',20)}catch(e){return l==='Home'?'🏠':l==='Work'?'💼':'📍'}};
const draw=()=>{
 const A=S.eaddrs,sel=(S.eapend==null?S.eai:S.eapend),form=!!S.eaform,nl=S.ealab||'Other';
 const rows=A.map((a,i)=>`<div><button type="button" class="ea-r${sel===i?' on':''}" role="radio" aria-checked="${sel===i}" onclick="eaSel(${i})"><span class="ea-ic">${ICON(a[0])}</span><span class="ea-tx"><b>${esc(a[0]==='Other'?a[2].split(',')[0]:a[0])}</b><span>${esc(a[1])}</span>${a[3]?`<i>${esc(a[3])}</i>`:''}</span><span class="ea-rd" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></span></button>${i>1?`<button type="button" class="ea-rm" style="margin:-8px 0 8px 54px" onclick="eaDel(${i})">Remove</button>`:''}</div>`).join('');
 const add=A.length>=5?'':(form?`<div class="ea-f"><label>Label</label><div class="ea-lb">${['Home','Work','Other'].map(l=>`<button type="button" class="${nl===l?'on':''}" onclick="eaLab('${l}')">${l}</button>`).join('')}</div><label for="eanew">Street or landmark</label><input id="eanew" maxlength="40" autocomplete="off" placeholder="e.g. Remera, KG 5 Ave" value="${esc(S.eadraft||'')}" oninput="S.eadraft=this.value"><label for="eanote">Note for the rider (optional)</label><input id="eanote" maxlength="60" autocomplete="off" placeholder="Gate colour, floor, who to ask for" value="${esc(S.eanote||'')}" oninput="S.eanote=this.value"></div>`:`<button type="button" class="ea-add" onclick="eaForm(1)"><span class="ea-ic">+</span>Add a new address</button>`);
 const used=A[sel]?A[sel][1]:'';
 $('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="h1" style="font-size:26px;line-height:34px">Delivery address</div><div class="mu" style="font-size:15px;margin-top:6px">Your rider will go to the address you pick.</div><div role="radiogroup" aria-label="Delivery address" style="margin-top:10px">${rows}</div>${add}<div class="row2"><button class="btn sec2" style="flex:0 0 34%;width:auto" onclick="${form?'eaForm(0)':'closeSheet()'}">${form?'Cancel':'Close'}</button><button class="btn" style="flex:1;width:auto" onclick="${form?'eaSave()':'eaUse()'}">${form?'Save and use':'Use this address'}</button></div></div>`;
};
window.eAddr=()=>{if(S.lang&&S.lang!=='en')return oldDraw();S.eapend=null;S.eaform=0;S.eadraft='';S.eanote='';S.ealab='Other';draw()};
window.eaSel=i=>{S.eapend=i;draw()};
window.eaForm=o=>{S.eaform=o;if(!o){S.eadraft='';S.eanote=''}draw();if(o){const f=$('#eanew');if(f)f.focus()}};
window.eaLab=l=>{S.ealab=l;draw()};
window.eaDel=i=>{S.eaddrs.splice(i,1);if(S.eai===i)S.eai=0;else if(S.eai>i)S.eai--;S.eapend=null;draw();render('fade-none')};
/* Shop "Deliver to" and Eats "Report a problem" get the same check list + bottom bar */
const oldShAddr=window.shAddr,oldHelp=window.eHelp;
const row=(on,ic,t,sub,fn)=>`<button type="button" class="ea-r${on?' on':''}" role="radio" aria-checked="${on}" onclick="${fn}">${ic?`<span class="ea-ic">${ic}</span>`:''}<span class="ea-tx"><b>${esc(t)}</b>${sub?`<span>${esc(sub)}</span>`:''}</span><span class="ea-rd" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></span></button>`;
const page=(h,sub,body,left,lf,right,rf,dis)=>{$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="h1" style="font-size:26px;line-height:34px">${h}</div>${sub?`<div class="mu" style="font-size:15px;margin-top:6px">${sub}</div>`:''}<div style="margin-top:10px">${body}</div><div class="row2"><button class="btn sec2" style="flex:0 0 34%;width:auto" onclick="${lf}">${left}</button><button class="btn" style="flex:1;width:auto" ${dis?'disabled':''} onclick="${rf}">${right}</button></div></div>`};
const shDraw=()=>{const A=S.shAd,sel=S.shApend==null?S.shAi:S.shApend;
 page('Deliver to','Pick where your order should arrive.',`<div role="radiogroup" aria-label="Deliver to">${A.map(([k,a],j)=>row(sel===j,ICON(k),k,a,`shApd(${j})`)).join('')}</div><button type="button" class="ea-add" onclick="shANew()"><span class="ea-ic">+</span>Add a new address</button>`,'Close','closeSheet()','Use this address','shAUse()')};
window.shAddr=()=>{if(S.lang&&S.lang!=='en')return oldShAddr();S.shApend=null;shDraw()};
window.shApd=j=>{S.shApend=j;shDraw()};
window.shAUse=()=>{if(S.shApend!=null)S.shAi=S.shApend;S.shApend=null;closeSheet();render('fade-none')};
const REAS=['Missing item','Wrong item','Food was cold','Order was late','Something else'];
const hDraw2=()=>{const o=(typeof S.ehn==='number')&&document.querySelector('#layer .sheet');if(!o)return;
 const sub=((o.querySelector('.sm.mu')||{}).textContent)||'';
 page('Report a problem',esc(sub),`<div class="ea-q" style="font-size:15px;font-weight:800;margin:18px 0 0">What went wrong?</div><div role="radiogroup" aria-label="What went wrong?">${REAS.map((l,j)=>row(S.ehr===j,'',l,'',`eHr(${j})`)).join('')}</div>`,'Cancel','closeSheet()','Send report','eHSend()',S.ehr<0)};
window.eHelp=function(){const r=oldHelp.apply(this,arguments);if(S.lang&&S.lang!=='en')return r;try{hDraw2()}catch(e){}return r};
window.eHr=j=>{S.ehr=j;hDraw2()};
/* back arrow: put its left edge on the same line (18 px, so the arrow tip sits at the 24 px margin) on every screen */
(()=>{let busy=0;const fix=()=>{if(busy)return;busy=1;try{document.querySelectorAll('#phone .ib[aria-label="Back"],#phone button[onclick^="back()"].ib').forEach(b=>{const sv=b.querySelector('svg');if(!sv||b.dataset.ez672)return;const par=b.offsetParent;if(!par||getComputedStyle(b).position==='absolute'||getComputedStyle(b).position==='fixed')return;const ph=document.querySelector('#phone').getBoundingClientRect().x;const dx=Math.round(18-(sv.getBoundingClientRect().x-ph));if(dx&&Math.abs(dx)<20){b.style.marginLeft=((parseFloat(getComputedStyle(b).marginLeft)||0)+dx)+'px'}b.dataset.ez672='1'})}finally{busy=0}};
new MutationObserver(()=>requestAnimationFrame(fix)).observe(document.querySelector('#phone'),{childList:true,subtree:true});fix()})();
/* place actions: split the icon from the label so the icon can sit above it */
(()=>{let busy=0;const fix=()=>{if(busy)return;busy=1;try{document.querySelectorAll('#phone .nm-p button:not([data-ez672p])').forEach(b=>{b.dataset.ez672p='1';if(b.children.length)return;const m=/^(\S+)\s+(.+)$/.exec(b.textContent.trim());if(m){b.innerHTML='<i>'+m[1]+'</i><span>'+m[2]+'</span>'}})}finally{busy=0}};
new MutationObserver(()=>requestAnimationFrame(fix)).observe(document.querySelector('#phone'),{childList:true,subtree:true});fix()})();
window.eaUse=()=>{const i=S.eapend==null?S.eai:S.eapend;S.eai=i;S.eapend=null;S.addrOk=true;closeSheet();render('fade-none');toast('Address updated')};
window.eaSave=()=>{const v=(S.eadraft||'').trim();if(!v){toast('Enter an address first');return}const l=S.ealab||'Other';S.eaddrs.push([l,v,v.split(',')[0].trim()+', Kigali',(S.eanote||'').trim()]);S.eai=S.eaddrs.length-1;S.eapend=null;S.eaform=0;S.addrOk=true;closeSheet();render('fade-none');toast('Address added')};
})()}catch(e){console.error('v672a',e)}
</script>
<script id="ez672s">
try{(()=>{
const fixTxt=s=>s.replace(/\b1 beds\b/g,'1 bed').replace(/\b1 baths\b/g,'1 bath').replace(/≈ ([\d,]+) RWF \/ m²/g,'$1 RWF/m²');
let busy=0;
const run=()=>{if(busy)return;busy=1;try{
 if(typeof S!=='undefined'&&S.lang&&S.lang!=='en')return;
 const root=document.querySelector('#phone');if(!root)return;
 const w=document.createTreeWalker(root,NodeFilter.SHOW_TEXT);let n;
 while((n=w.nextNode())){const v=n.nodeValue;if(v.indexOf('1 b')<0&&v.indexOf('≈')<0)continue;const f=fixTxt(v);if(f!==v)n.nodeValue=f}
 /* detail tiles: a big number over a label; 1 over "beds"/"baths" */
 root.querySelectorAll('div').forEach(d=>{if(d.children.length===2){const a=d.children[0],b=d.children[1];if(a.children.length||b.children.length)return;const t=b.textContent.trim();if(a.textContent.trim()==='1'){if(t==='beds')b.textContent='bed';else if(t==='baths')b.textContent='bath'}}});
}finally{busy=0}};
new MutationObserver(()=>requestAnimationFrame(run)).observe(document.querySelector('#phone')||document.body,{childList:true,subtree:true,characterData:true});
run();
})()}catch(e){console.error('v672',e)}
document.title=document.title.replace(/v\d+/,'v672');
</script>
<style id="ez673">
/* v673: itunda 증권, round 13. Activity tab: 30-day summary, filter chips and day headers over the flat History list. v674: long titles wrap, time-only subtitle under a day header, and a buy, sell, dividend or cancel row opens its stock. */
#phone .ez-ah{padding:4px 24px 0}
#phone .ez-ah .sm3{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:4px 0 14px}
#phone .ez-ah .sm3>div{background:var(--chip);border-radius:16px;padding:12px 12px}
#phone .ez-ah .sm3 small{display:block;font-size:12px;color:var(--mu);font-weight:600}
#phone .ez-ah .sm3 b{display:block;font-size:15px;margin-top:4px;letter-spacing:-.2px;white-space:nowrap}
#phone .ez-ah .ez-fl{display:flex;gap:8px;overflow-x:auto;scrollbar-width:none;margin:0 -24px;padding:0 24px 4px}
#phone .ez-ah .ez-fl::-webkit-scrollbar{display:none}
#phone .ez-ah .ez-fl button{flex:none;height:36px;padding:0 14px;border-radius:18px;border:0;background:var(--chip);color:var(--mu);font-size:14px;font-weight:700}
#phone .ez-ah .ez-fl button.on{background:var(--tx);color:var(--bg)}
#phone .ez-ah-none{padding:28px 24px;text-align:center;color:var(--mu);font-size:14px}
#phone .ez-dayh{padding:14px 24px 2px;font-size:13px;font-weight:700;color:var(--mu)}
</style>
<script>
try{(function(){
const I=S.inv,T=(e,f,r)=>({en:e,fr:f||e,rw:r||e}[S.lang]||e);
I.hf=I.hf||'all';
const grp=k=>k==='buy'?'buy':k==='sell'?'sell':k==='div'?'div':'oth';
const fm=n=>fmt(Math.round(n));
window.ezAhF=k=>{I.hf=k;const sc=document.getElementById('sc'),y=sc?sc.scrollTop:0;render('fade-none');const n=document.getElementById('sc');if(n)n.scrollTop=y};
const _iv=screens.invest;
if(_iv)screens.invest=function(){let h=String(_iv.apply(this,arguments));try{
 if(I.tab!=='act'||!I.hist.length||h.indexOf('ez-ah')>=0)return h;
 const R=document.createElement('div');R.innerHTML=h;
 const hds=[...R.querySelectorAll('.agt')],at=hds.find(x=>/History|Amateka|Historique/.test(x.textContent));if(!at)return h;
 const rows=[];let n=at.nextElementSibling;while(n&&n.classList.contains('stk')){rows.push(n);n=n.nextElementSibling}
 if(rows.length!==I.hist.length)return h;
 const since=Date.now()-30*864e5;let inv=0,rec=0,dv=0;
 I.hist.forEach(x=>{if(x.ts<since)return;if(x.k==='buy'||x.k==='bond'||x.k==='ipo')inv+=x.a||0;else if(x.k==='sell'||x.k==='bondpay')rec+=x.a||0;else if(x.k==='div')dv+=x.a||0});
 const cnt={all:I.hist.length,buy:0,sell:0,div:0,oth:0};I.hist.forEach(x=>cnt[grp(x.k)]++);
 const chips=[['all',T('All','Byose','Tout')],['buy',T('Buys','Ibyaguzwe','Achats')],['sell',T('Sells','Ibyagurishijwe','Ventes')],['div',T('Dividends','Inyungu','Dividendes')],['oth',T('Other','Ibindi','Autres')]].filter(c=>c[0]==='all'||cnt[c[0]]);
 if(!chips.some(c=>c[0]===I.hf))I.hf='all';
 const head=document.createElement('div');head.className='ez-ah';
 head.innerHTML=`<div class="sm3"><div><small>${T('Invested','Washoye','Investi')}</small><b>${fm(inv)}</b></div><div><small>${T('Received','Wabonye','Reçu')}</small><b>${fm(rec)}</b></div><div><small>${T('Dividends','Inyungu','Dividendes')}</small><b class="${dv?'up':''}">${dv?'+':''}${fm(dv)}</b></div></div><div class="mu sm" style="margin:-6px 0 12px">${T('Last 30 days, RWF','Iminsi 30 ishize, RWF','30 derniers jours, RWF')}</div>`+(chips.length>2?`<div class="ez-fl" role="group">${chips.map(c=>`<button class="${I.hf===c[0]?'on':''}" aria-pressed="${I.hf===c[0]}" onclick="ezAhF('${c[0]}')">${c[1]}</button>`).join('')}</div>`:'');
 at.insertAdjacentElement('afterend',head);
 let last='',shown=0;
 rows.forEach((r,i)=>{const x=I.hist[i];if(I.hf!=='all'&&grp(x.k)!==I.hf){r.remove();return}
  shown++;const d=new Date(x.ts),t=new Date(),y=new Date(Date.now()-864e5);
  const key=d.toDateString(),lab=key===t.toDateString()?T('Today','Uyu munsi',"Aujourd’hui"):key===y.toDateString()?T('Yesterday','Ejo','Hier'):d.toLocaleDateString('en-GB',{day:'numeric',month:'short'});
  if(key!==last){last=key;r.insertAdjacentHTML('beforebegin',`<div class="ez-dayh">${lab}</div>`)}
  /* v674: long titles wrap instead of being cut, the time stands alone under a day header, and a stock row opens the stock */
  const c=r.children[1];if(c){const t=c.children[0],s2=c.children[1];if(t)t.style.cssText='font-weight:700;font-size:16px;line-height:22px';if(s2){const m=s2.textContent.indexOf(', ');if(m>0)s2.textContent=s2.textContent.slice(m+2)}}
  if(x.tk&&STK.some(q=>q[0]===x.tk)&&x.k!=='ipo'&&x.k!=='ipocancel'&&x.k!=='iposhare'){r.style.cursor='pointer';r.setAttribute('onclick',"openStock('"+x.tk+"')");r.setAttribute('role','button')}});
 if(!shown)head.insertAdjacentHTML('afterend',`<div class="ez-ah-none">${T('Nothing here yet.','Nta cyo kiragaragara.','Rien pour le moment.')}</div>`);
 return R.innerHTML}catch(e){console.error('ez673',e);return h}};
})()}catch(x){console.error('v673',x)}
document.title=document.title.replace(/v\d+/,'v674');
</script>
<style id="ez675">
/* v675: Market > Stocks list. Names were cut ("I&M Bank R…", "Bank of Kig…") and "Construction · 4.6%" broke onto two lines. The name column is wider (smaller gaps and chart) and a long name wraps to a second line instead of being cut; the sector line stays on one line. */
#phone .stk:has(>.ez-rk){gap:10px}
#phone .stk:has(>.ez-rk)>svg{width:40px;flex:none}
#phone .stk:has(>.ez-rk)>div[style*="flex:1"]>div:first-child{white-space:normal!important;overflow:visible!important;text-overflow:clip!important;line-height:20px}
#phone .stk:has(>.ez-rk)>div[style*="flex:1"]>.sm{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-size:12px;letter-spacing:-.2px}
#phone .stk:has(>.ez-rk)>div[style*="min-width:68px"]{min-width:60px}
</style>
<style id="ez676">
/* v676: Stock page, tidy order. "Key stats" repeated four things already on the page (P/E and dividend yield in Investment metrics, dividend per share in the Dividend card, 52-week high and low in the 52-week range bar), so those tiles are gone (Sector and Market cap stay, and Volume today takes the full row). Tile rows are closer together (20 px of padding above each is now 10). Market cap also read "91 RWF.0 bn" for a stock under 100 bn; it now reads "91 bn RWF". The page now reads: chart, 52-week range, Key stats, Investment metrics, Financials, Dividend, then the market block (Order book, Buyers and sellers, Will it rise today?), News. Before, the 52-week range sat below the vote card and Key stats came after the order book. */
#phone [data-ez676="ks"]+div{padding-bottom:2px}
#phone .ez-bx[data-ez676="rg"]{margin-top:22px}
#phone [data-ez676="ks"]+div>div:last-child:nth-child(odd){grid-column:1/-1}
#phone [data-ez676="ks"]+div>div{padding-top:10px!important;padding-bottom:6px!important}
</style>
<script id="ez676s">
try{(()=>{
const T=(e,f)=>({en:e,fr:f||e,rw:e}[S.lang]||e);
const dom=h=>{const d=document.createElement('div');d.innerHTML=h;return d};
const _sk=screens.stock;
if(_sk)screens.stock=function(){let h=String(_sk.apply(this,arguments));try{
 if(h.indexOf('data-ez676')>=0)return h;
 const tk=S.inv.sk,R=dom(h);
 const bx=[...R.querySelectorAll('.ez-bx')];
 const rg=bx.find(e=>e.querySelector('.ez-rg')),ob=bx.find(e=>e.querySelector('.ez-ob')),bs=bx.find(e=>e.querySelector('.ez-br'));
 const vt=R.querySelector('.ez-vt'),mt=R.querySelector('.ez-mt');
 const kh=[...R.querySelectorAll('.agt')].find(e=>{const g=e.nextElementSibling;return g&&/grid-template-columns/.test(g.getAttribute('style')||'')&&g.children.length===8}),kg=kh&&kh.nextElementSibling;
 /* 1. Key stats: keep Sector, Market cap, Volume; drop the four repeats; fix the market cap text */
 if(kg&&kg.children.length===8){
  [7,6,4,3,2].forEach(i=>kg.children[i].remove());
  const mc=kg.children[1].querySelector('b'),m=mc&&mc.textContent.replace(/\s*RWF\s*/,'').match(/([\d.,]+)\s*bn/);
  if(m){const v=parseFloat(m[1].replace(/,/g,''));if(v>0)mc.textContent=(v>=100?v.toFixed(0):String(+v.toFixed(1)))+' '+T('bn RWF','Md RWF')}
  kh.setAttribute('data-ez676','ks')}
 /* 2. 52-week range and Key stats come right after the chart block (before Investment metrics) */
 if(mt){
  if(rg){rg.setAttribute('data-ez676','rg');mt.insertAdjacentElement('beforebegin',rg)}
  if(kh&&kg){mt.insertAdjacentElement('beforebegin',kh);mt.insertAdjacentElement('beforebegin',kg)}}
 /* 3. the vote card joins the market block, after Buyers and sellers */
 if(vt&&bs)bs.insertAdjacentElement('afterend',vt);
 if(!R.querySelector('[data-ez676]'))return h;
 return R.innerHTML}catch(e){console.error('ez676 stock',e);return h}};
})()}catch(x){console.error('v676',x)}
</script>
<script>document.title=document.title.replace(/v\d+/,'v676');</script>
<style id="ez677">
/* v677: itunda 증권, round 14. One set of numbers per stock, readable bars, tidier headers. */
#phone .ez-fn .bars i{background:var(--tint)}
#phone .ez-fn .bars div.cur i{background:var(--lk)}
#phone .ez-gp .hd{padding:0;gap:0}
#phone .ez-gp .hd button{height:auto;padding:6px 0;border-radius:0;background:none;color:var(--lk);font-size:14px;font-weight:700}
</style>
<script id="ez677">
try{(()=>{
if(typeof screens==='undefined'||!window.STKX||!S.inv)return;
const I=S.inv,T=(e,f)=>({en:e,fr:f||e,rw:e}[S.lang]||e);
const nf=n=>Number.isInteger(n)?Math.round(n).toLocaleString('en-US'):n.toFixed(1);
const dom=h=>{const d=document.createElement('div');d.innerHTML=h;return d};
/* Stock page: dividend, yield, P/E and P/B all come from the same per-stock data as the list and "Your position" */
const _sk=screens.stock;
if(_sk)screens.stock=function(){let h=String(_sk.apply(this,arguments));try{
 if(h.indexOf('data-ez677')>=0)return h;
 const tk=I.sk,x=window.STKX[tk],s=STK.find(r=>r[0]===tk);
 if(!x||!s)return h;
 const p=s[2],R=dom(h),q=S.hold&&S.hold[tk]?S.hold[tk].q:0;
 let did=false;
 const dv=R.querySelector('.ez-dv');
 if(dv){
  const r=dv.querySelectorAll('.r');
  if(r[1]&&r[1].querySelector('b'))r[1].querySelector('b').textContent=nf(x.dv/2)+' RWF';
  if(r[2]&&r[2].querySelector('b'))r[2].querySelector('b').textContent=T('Twice a year','Deux fois par an');
  const pb=dv.querySelector('.pay b');if(pb)pb.textContent=nf(q*x.dv/2)+' RWF';
  dv.setAttribute('data-ez677','1');did=true}
 const g=R.querySelector('.ez-mt .g');
 if(g&&g.children.length===4){
  const b=i=>g.children[i].querySelector('b'),roe=parseFloat(b(2).textContent)||12,pe=p/x.eps;
  b(0).textContent=pe.toFixed(1)+'x';
  b(1).textContent=(pe*roe/100).toFixed(1)+'x';
  b(3).textContent=(x.dv/p*100).toFixed(1)+'%';
  g.setAttribute('data-ez677','1');did=true}
 return did?R.innerHTML:h}catch(e){console.error('ez677 stock',e);return h}};
/* Invest: drop the Sector mix bar when it repeats the stock split; one-line "4 up · 2 down" */
const _iv=screens.invest;
if(_iv)screens.invest=function(){let h=String(_iv.apply(this,arguments));try{
 if(h.indexOf('data-ez677')>=0)return h;
 const R=dom(h);let did=false;
 if(I.tab==='port'){
  const bars=[...R.querySelectorAll('.nwb')];
  if(bars.length>=2){
   const n=b=>b.parentElement.querySelectorAll('.nwl').length,last=bars[bars.length-1],first=bars[0];
   if(n(last)===n(first)){
    const pad=last.parentElement,hd=pad.previousElementSibling;
    if(hd&&hd.classList.contains('agt'))hd.remove();
    pad.remove();did=true}}}
 if(I.tab==='mkt'){
  const e=[...R.querySelectorAll('div.sm.mu')].find(d=>d.querySelector('br')&&/·/.test(d.textContent));
  if(e){const parts=e.innerHTML.split('<br>');if(parts.length===2&&/^\s*0\s/.test(parts[1])){e.innerHTML=parts[0];did=true}}}
 if(!did)return h;
 R.firstElementChild&&R.firstElementChild.setAttribute('data-ez677','1');
 return R.innerHTML}catch(e){console.error('ez677 invest',e);return h}};
})()}catch(x){console.error('v677',x)}
document.title=document.title.replace(/v\d+/,'v677');
</script>
<style id="ez678">
/* v678: round 15. Stock page "Key stats": tiles still carried 20px of top padding (an older rule outranked v676's), so rows sat about 80px apart; now 8px top, 4px bottom. The Buy bar gets a soft fade above it so text no longer looks sliced off at its edge. */
#phone [data-ez676="ks"]+div>div[style]{padding-top:8px!important;padding-bottom:4px!important}
#phone [data-ez676="ks"]+div{row-gap:0!important;padding-top:0!important}
#phone .cta{box-shadow:0 -14px 14px -4px var(--bg)}
</style>
<script>document.title=document.title.replace(/v\d+/,'v678');</script>
<style id="ez679">
/* v679: round 16. Invest, Portfolio: "Treasury bills" and "Browse stocks" were sized by their text, so the first looked cramped; the two buttons now share the row equally. Market: the chip rows (Stocks, Bonds, IPO, Watchlist; Top movers, Rising, Falling) end with 24px of space, so the last chip can be scrolled fully clear of the screen edge instead of stopping flush against it. */
#phone .cta>.btn:not([style*="flex:"]){flex:1 1 0!important;min-width:0;padding:0 8px;white-space:nowrap}
#phone .chips::after{content:"";flex:0 0 24px}
</style>
<script>document.title=document.title.replace(/v\d+/,'v679');</script>
<style id="ez680">
/* v680: round 17. Portfolio: the "Invested value" label was near-black while "Cash", "Dividends" and the other labels are grey; it is grey now, so the big number is what stands out. Market, Stocks: with nothing followed yet, the "My stocks" block took a full heading plus a hint line above "Market today"; it is now a smaller heading with the hint close beneath and less space around it. Once a stock is followed, the block looks as before. */
#phone .pad:has(>.big)>.sm.mu{color:var(--mu)!important}
#phone .ez-my:has(>.hint){margin-top:18px}
#phone .ez-my:has(>.hint) h3{font-size:16px;margin-bottom:2px}
</style>
<script>document.title=document.title.replace(/v\d+/,'v680');</script>
<script id="ez681">
/* v681: round 18. Invest, IPO: Kigali Solar's dates were fixed (closes 21 Oct, lists 28 Oct 2026), so from 22 Oct the screen offered "Apply for shares" for an IPO that had already closed. The sample IPO now closes 3 days from today and lists 10 days from today. */
document.title=document.title.replace(/v\d+/,'v681');
</script>
<script>/* v682: round 19. Order screen: "1 shares × 420" now reads "1 share × 420", and the fee line says "Fee (0.4%, min 100)" like the review screen, because on a small order the 100 RWF minimum applies and "0.4%" alone looked wrong (0.4% of 420 is under 2 RWF). */
document.title=document.title.replace(/v\d+/,'v682');</script>
<style id="ez683">
/* v683: round 20. Table pay screen: the way-to-pay list used round radio dots; it is now a checklist like Toss, a grey check on every line and a purple check with a bolder name on the one you picked. Every keypad screen (phone number, Send, Top up, Pay, Review...): the main button had shrunk to a thin 20px strip. Round 16 (v679) made buttons share a row equally with flex:1 1 0, but on keypad screens the button sits in a column, so that rule overrode its 53px height. Keypad buttons are back to the full 53px height. */
#phone #view:has(.keys)>.cta>.btn{flex:0 0 auto!important;height:53px!important;padding:0 24px!important}
#phone .frck .frck-i path{transition:stroke .15s ease}
</style>
<script>document.title=document.title.replace(/v\d+/,'v683');</script>
<script>/* v684: round 21. Pay: the "Request" button used the same circular-arrows icon as the "New code" refresh above it, so it read as "refresh". It now has a down-left arrow (money coming in), the opposite of Send's right arrow. The same icon is used on the "Request" row under More on Home and Pay. */
document.title=document.title.replace(/v\d+/,'v684');</script>
<style id="ez685">
/* v685: round 22. Taps respond at once on phones (no double-tap-zoom delay) on buttons, rows and tabs. On notched phones the bottom tab bar and Buy/Continue bar now sit clear of the home indicator, and the toast rises with them. Sheets return keyboard focus to the button that opened them when they close. */
#phone button,#phone .row,#phone .gi,#phone .pc,#phone [role=button]{touch-action:manipulation}
@media (max-width:430px){
#phone .tabs{height:calc(80px + env(safe-area-inset-bottom,0px));padding-bottom:env(safe-area-inset-bottom,0px)}
#phone .cta{padding-bottom:calc(24px + env(safe-area-inset-bottom,0px))}
#phone .toast{bottom:calc(100px + env(safe-area-inset-bottom,0px))}
#phone .screen{padding-bottom:calc(96px + env(safe-area-inset-bottom,0px))}
}
</style>
<script>/* v685 focus return */
(function(){try{var L=document.getElementById('layer'),last=null;
document.addEventListener('click',function(e){var b=e.target.closest&&e.target.closest('button,[role=button],.row,.gi');if(b&&!b.closest('#layer'))last=b},true);
new MutationObserver(function(){if(!L.innerHTML&&last&&document.contains(last)&&!document.activeElement.closest('input,textarea')){try{last.focus({preventScroll:true})}catch(x){}}}).observe(L,{childList:true});
}catch(e){console.error('v685',e)}
document.title=document.title.replace(/v\d+/,'v685');})();</script>
<style id="ez686">
/* v686: round 23. Native parts the browser draws itself (scrollbars, text-field autofill, the keyboard on iOS, date pickers, checkboxes) now follow the app's light or dark choice, not just the phone's. Text no longer jumps in size when a phone is turned sideways. Long names and amounts wrap instead of pushing a row wider than the screen. */
:root{color-scheme:light dark;-webkit-text-size-adjust:100%;text-size-adjust:100%;accent-color:var(--br)}
:root[data-theme=light]{color-scheme:light}
:root[data-theme=dark]{color-scheme:dark}
#phone .row>div:not(.ico):not(.r){min-width:0;overflow-wrap:anywhere}
#phone input::placeholder{color:var(--tt);opacity:1}
</style>
<script>document.title=document.title.replace(/v\d+/,'v686');</script>
<style id="ez687">
/* v687: round 24. On the first screen, "Skip (prototype)" and "Prototype: fill a returning number" were only 20px tall, too small for a thumb. Each now has an invisible 44px-tall touch area that adds no space and moves nothing. */
#phone .ahead>a.sm,#phone a.sm[onclick]{position:relative}
#phone .ahead>a.sm::after,#phone a.sm[onclick]::after{content:"";position:absolute;left:-6px;right:-6px;top:50%;height:44px;transform:translateY(-50%)}
</style>
<script>document.title=document.title.replace(/v\d+/,'v687');</script>
<style id="ez688">
/* v688: round 25. Shop, the five round shortcuts under the banner (Daily draw, Deals, My orders, Rewards, Wishlist): the buttons kept their default side padding, so on a narrow column "Rewards" broke in the middle of the word ("Reward / s"). The padding is gone and the label stays on one line. Eats, Cart: when the last item is taken out, the screen used to show "Total 0 RWF", a greyed "Add 2,000 RWF to order" and two stacked Delivery/Pickup controls. It now says the cart is empty, names the restaurant, and the bottom button goes back to its menu. */
#phone button[style*="flex:1;border:0;background:none;display:flex;flex-direction:column"]{padding:0 2px!important;min-width:0;white-space:nowrap}
#phone .ez688e{padding:88px 32px 0;text-align:center}
#phone .ez688e .g{width:96px;height:96px;margin:0 auto 20px;border-radius:32px;background:var(--chip);display:flex;align-items:center;justify-content:center}
#phone .ez688e .t{font-size:20px;font-weight:800;letter-spacing:-.3px;line-height:28px}
#phone .ez688e .s{font-size:15px;color:var(--mu);line-height:22px;margin-top:8px}
</style>
<script>
(function(){try{
if(typeof screens==='undefined'||!screens.echeck||typeof eCount==='undefined'||typeof bar==='undefined'||typeof gl==='undefined')return;
var _e=screens.echeck;

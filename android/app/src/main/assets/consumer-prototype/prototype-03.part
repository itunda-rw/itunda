 const d=['Mon','Tue','Wed','Thu','Fri','Sat','Sun'],td=(new Date().getDay()+6)%7,hrs=(p.c==='atm'||p.c==='hosp')?'24 hours':'7:00 am to '+((m=>m?((+m[1]%12||12)+':'+m[2]+' '+(+m[1]>=12?'pm':'am')):'9:00 pm')(h.match(/closes (\d{1,2}):(\d{2})/)));
 const row=`<button class="hrt" aria-expanded="${!!M.hrs}" onclick="hrTg()">Open today <span>${hrs}</span> ${M.hrs?'⌃':'⌄'}</button>`;
 const wk=M.hrs?`<div class="hw">${d.map((x,k)=>`<div class="${k===td?'t':''}"><span>${x}</span><span>${hrs}</span></div>`).join('')}</div>`:'';
 return h.slice(0,i)+row+wk+h.slice(i)};
})()}catch(x){console.error('naver-v559',x)}
</script>

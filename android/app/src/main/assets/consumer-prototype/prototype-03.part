screens.echeck=function(){
 var n=1;try{n=eCount()}catch(x){}
 if(n>0)return _e.apply(this,arguments);
 var r=null;try{r=REST[S.er]}catch(x){}
 var nm=r&&r.n?String(r.n).replace(/[<>&]/g,''):'';
 return bar(T('Cart','Panier','Igitebo'))
  +'<div class="ez688e"><div class="g">'+gl('bag',56)+'</div>'
  +'<div class="t">'+T('Your cart is empty','Votre panier est vide','Igitebo cyawe nta kintu kirimo')+'</div>'
  +'<div class="s">'+(nm?T('Add something from '+nm+' to order.','Ajoutez un article de '+nm+' pour commander.','Shyiramo ikintu cya '+nm+' kugira ngo utumize.'):T('Add something to order.','Ajoutez un article pour commander.','Shyiramo ikintu kugira ngo utumize.'))+'</div></div>'
  +'<div class="cta"><button class="btn" onclick="back()">'+T('Back to the menu','Retour au menu','Subira kuri menu')+'</button></div>';
};
}catch(e){console.error('v688',e)}

#phone#phone #sc.h9 .hc .hr .hi.b774{width:36px;height:36px;border-radius:12px;background:var(--chip);display:flex;align-items:center;justify-content:center;font-size:20px;line-height:1;flex:none}
#phone#phone #sc.h9 .hc .row .r.e774{display:block;text-align:right}
#phone#phone #sc.h9 .hc .row .r.e774 .a{font-size:16px;font-weight:700;color:var(--tx);white-space:nowrap}
#phone#phone #sc.h9 .hc .row .r.e774 .a .cu{display:none}
#phone#phone #sc.h9 .hc .row:has(.e774) .t{font-size:16px}
#phone#phone #sc.h9 .hc .row .r.e774 small{display:block;margin-top:2px;font-size:13px;line-height:20px;font-weight:400;color:var(--lk);white-space:nowrap}
</style>
<script>
try{(function(){
const _h=screens.home;
const L=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e;
screens.home=function(){
 const h=_h.apply(this,arguments);if(typeof h!=='string')return h;
 const m=h.indexOf('<div class="hct"><span>Pockets');
 const at=m<0?-1:Math.max(h.lastIndexOf('<div class="hc"',m),h.lastIndexOf('<div class="hc ',m));
 if(at<0)return h;
 const t1=L('6,400 RWF earned','6,400 RWF wungutse','6 400 RWF gagnés'),t2=L('Points and coupons','Amanota na kuponi','Points et coupons'),bt=L('View','Reba','Voir');
 const card=`<div class="hc"><div class="hr tap" role="button" tabindex="0" onclick="benHome774()"><div class="hi b774" aria-hidden="true">⭐</div><div class="hm"><div class="ha2">${t1}</div><div class="sm mu">${t2}</div></div><button class="hp pr" onclick="event.stopPropagation();benHome774()">${bt}</button></div></div>`;
 return h.slice(0,at)+card+h.slice(at)};
window.benHome774=()=>tab('pay');
const earned=L('+9 earned','+9 wungutse','+9 gagnés');
const fix=()=>{const sc=document.getElementById('sc');if(!sc)return;
 sc.querySelectorAll('.hc .row[onclick^="actOpen("] .r').forEach(r=>{
  if(r.classList.contains('e774'))return;
  const row=r.closest('.row'),paid=/actOpen\(1\)/.test(row.getAttribute('onclick'));
  const amt=(r.firstChild&&r.firstChild.nodeType===3?r.firstChild.textContent:'').trim();
  const cu=r.querySelector('.cu');if(!amt||!cu)return;
  const a=document.createElement('div');a.className='a';a.append(amt+' ',cu);
  r.textContent='';r.classList.add('e774');r.append(a);
  if(paid){const s=document.createElement('small');s.textContent=earned;r.append(s)}})};
const _r=window.render;window.render=render=function(){const x=_r.apply(this,arguments);try{fix()}catch(e){}return x};
try{fix()}catch(e){}
const v=document.getElementById('view');if(v)new MutationObserver(()=>{try{fix()}catch(e){}}).observe(v,{childList:true,subtree:true});
})()}catch(e){console.error('home-pay-v774',e)}
document.title=document.title.replace(/v\d+/,'v774');
</script>
<style id="home-pay-surface-v775">
/* v775: Home takes the Pay screen's surfaces and spacing. Measured on Pay: light page #F2F4F6 with white cards; dark page #101013 with cards #191F28 (Home had #101013 under #17171C cards, and its Invite card was a different dark from the rest); cards 15px from the edge, 12px apart, 24px radius, 20px above the first line; icon tiles #F2F4F6 / #333D4B; row titles 17px bold with -.3px tracking and 13px grey subtitles. Home now uses the same values, so moving between Home and Pay no longer changes the colour of the page or the cards. */
#phone#phone{--hc775:#fff;--tile775:#F2F4F6;--pg775:#F2F4F6}
@media (prefers-color-scheme:dark){:root:not([data-theme=light]) #phone#phone{--hc775:#191F28;--tile775:#333D4B;--pg775:#101013}}
:root[data-theme=dark] #phone#phone{--hc775:#191F28;--tile775:#333D4B;--pg775:#101013}
#phone#phone #sc.h9{background:var(--pg775)!important}
#phone#phone #sc.h9 .top{background:var(--pg775)!important}
#phone#phone #sc.h9 :is(.hc,.top+.hc,.hc.hpm,.hc.nud){background:var(--hc775)!important}
#phone#phone #sc.h9 .hc{margin:12px 15px 0!important;border-radius:24px!important}
#phone#phone #sc.h9 .hc:not(.nud){padding:20px 0 6px!important}
#phone#phone #sc.h9 .hc.nud{margin-top:8px!important}
#phone#phone #sc.h9 .hc .hct{padding-top:0!important}
#phone#phone #sc.h9 .hc .hr .hi,#phone#phone #sc.h9 .hc .hr .hi.b774,#phone#phone #sc.h9 .hc .row .ico{background:var(--tile775)!important}
#phone#phone #sc.h9 .hc .hp,#phone#phone #sc.h9 .hc .hr .hp.pr,#phone#phone #sc.h9 .hc:not(.nud) .hr:first-of-type .hp.pr{background:var(--tile775)!important}
#phone#phone #sc.h9 .hc .pkico{width:40px!important;height:40px!important;border-radius:12px!important;background:var(--tile775)!important}
#phone#phone #sc.h9 .hc .row{gap:14px}
#phone#phone #sc.h9 .hc .row .ico{width:40px;height:40px;border-radius:12px}
#phone#phone #sc.h9 .hc .row .t{font-weight:700;letter-spacing:-.3px}
#phone#phone #sc.h9 .hc .row .s{font-size:13px;line-height:18px;color:var(--tt)!important}
</style>
<script>document.title=document.title.replace(/v\d+/,'v775');</script>
<style id="explore-pay-v776">
/* v776: Explore takes the same Pay surfaces and spacing Home got in v775. Before: a white header band and a white chip rail cut across the grey page, the dark header was a lighter purple-grey than every card, cards sat 14px from the edge and 10px apart with the section title 36px below the card edge, and row icons were 44px circles. Now: header, search and chip rail sit on the page colour (#F2F4F6 / #101013) with the search field and chips as white (#191F28) pills; cards are 15px from the edge, 12px apart, 24px radius, 20px above the title; icon tiles are 40px rounded squares in the Pay tile colour; row titles are 17px bold with -.3px tracking over 13px grey subtitles. */
#phone#phone #sc .xp .xh{background:var(--pg775)!important}
#phone#phone #sc .xp .xh::before{background:var(--pg775)!important}
#phone#phone #sc .xp .asr{background:var(--hc775)!important;margin:4px 15px 8px!important}
#phone#phone #sc .xp .xpills{background:var(--hc775)!important;margin:12px 15px 0!important;border-radius:24px!important}
#phone#phone #sc .xp [aria-label=Sections]{background:var(--pg775)!important;padding:10px 15px 6px!important}
#phone#phone #sc .xp [aria-label=Sections] .chip:not(.on):not([aria-selected=true]):not([aria-pressed=true]){background:var(--hc775)!important}
#phone#phone #sc .xp .xc{background:var(--hc775)!important;margin:12px 15px 0!important;padding:20px 0 6px!important;border-radius:24px!important}
#phone#phone #sc .xp .xc .xgh{padding:0 20px 8px!important}
#phone#phone #sc .xp .xc .ar{padding:8px 20px!important;grid-template-columns:40px 1fr!important;column-gap:14px!important}
#phone#phone #sc .xp .xc .ar .g{width:40px!important;height:40px!important;border-radius:12px!important;background:var(--tile775)!important}
#phone#phone #sc .xp .xc .ar .t{font-size:17px;font-weight:700;letter-spacing:-.3px;color:var(--tx)!important}
#phone#phone #sc .xp .xc .ar .s{font-size:13px;line-height:18px;color:var(--tt)!important}
</style>
<script>document.title=document.title.replace(/v\d+/,'v776');</script>
<style id="you-pay-v777">
/* v777: You takes the Pay / Home / Explore surfaces. Before: the white header band cut across the grey page, section titles floated outside their cards on the page, cards sat 14px from the edge and 10px apart, rows had hairline dividers, and icons were 44px circles. Now: the header sits on the page colour; each section title lives inside its card, 20px from the top (the "Earn 3%..." line sits under Partner earnings inside its card); cards are 15px from the edge, 12px apart, 24px radius, in the card colour (#fff / #191F28); rows have no dividers; icon tiles are 40px rounded squares in the Pay tile colour; row titles are 17px bold over 13px grey subtitles. The profile photo stays round. */
#phone#phone #sc .ahead,#phone#phone #sc .ahead::before{background:var(--pg775)!important}
#phone#phone #sc>.glx,#phone#phone #sc .glx{background:var(--hc775)!important;margin:12px 15px 0!important;border-radius:24px!important;padding:20px 0 6px!important}
#phone#phone #sc .glx:not(:has(.agt)){padding:8px 0 6px!important}
#phone#phone #sc .glx .agt{margin:0!important;padding:0 20px 6px!important;font-size:20px;font-weight:800;color:var(--tx)}
#phone#phone #sc .glx>.pad.sm{padding:0 20px 8px!important;font-size:13px;line-height:18px;color:var(--tt)!important}
#phone#phone #sc .glx>.ar{padding:8px 20px!important;gap:14px}
#phone#phone #sc .glx>.ar+.ar::before{display:none!important}
#phone#phone #sc .glx .ar .g{width:40px!important;height:40px!important;border-radius:12px!important;background:var(--tile775)!important}
#phone#phone #sc .glx .ar .t{font-size:17px;font-weight:700;letter-spacing:-.3px;color:var(--tx)!important}
#phone#phone #sc .glx .ar .s{font-size:13px;line-height:18px;color:var(--tt)!important}
#phone#phone #sc .glx .ar[onclick="openProfile()"] .s{font-size:14px;color:var(--mu)!important}
</style>
<script>
try{(function(){
const fix=()=>{const sc=document.getElementById('sc');if(!sc)return;
 sc.querySelectorAll('.agt').forEach(t=>{
  if(t.closest('.glx'))return;
  const n=t.nextElementSibling,cap=n&&n.classList.contains('pad')&&n.classList.contains('sm')?n:null,card=cap?cap.nextElementSibling:n;
  if(!card||!card.classList.contains('glx'))return;
  card.prepend(...[t,cap].filter(Boolean))})};
const v=document.getElementById('view');
if(v)new MutationObserver(()=>{try{fix()}catch(e){}}).observe(v,{childList:true,subtree:true});
try{fix()}catch(e){}
})()}catch(e){console.error('you-pay-v777',e)}
/* v778 icon-centering: optically centre every icon's ink inside its viewBox so it sits dead-centre in its circle/tile/button. */
(function(){try{
const ph=document.getElementById('phone');if(!ph)return;
const st=document.createElement('style');st.textContent='#phone .ar .g,#phone .ar .ico{align-items:center;justify-content:center}';document.head.appendChild(st);
const NS='http://www.w3.org/2000/svg';
function fixOne(svg){
 if(svg.dataset.ctr||svg.closest('defs')||svg.querySelector('svg'))return;
 const w=svg.getAttribute('width');if(w==='0')return;
 const r=svg.getBoundingClientRect();if(r.width<8||r.width>110||r.height<8)return;
 const par=svg.parentElement;if(!par)return;
 const kids=[...par.childNodes].filter(n=>n.nodeType===1||(n.nodeType===3&&n.textContent.trim()));
 if(kids.length!==1)return;
 if(!(par instanceof SVGElement)&&getComputedStyle(svg).display==='inline'&&getComputedStyle(par).display==='block'&&par.getBoundingClientRect().width-r.width<8)svg.style.display='block';
 const vb=svg.viewBox&&svg.viewBox.baseVal;if(!vb||!vb.width||vb.width>100)return;
 if(svg.getAttribute('role')==='img'&&!par.classList.length)return;
 const first=svg.querySelector('path,circle,rect,line,polyline,polygon,ellipse,g,text');if(!first)return;
 try{if(getComputedStyle(first).animationName!=='none')return}catch(e){}
 let bb;try{bb=svg.getBBox()}catch(e){return}
 if(!bb.width||!bb.height)return;
 let dx=vb.x+vb.width/2-(bb.x+bb.width/2),dy=vb.y+vb.height/2-(bb.y+bb.height/2);
 const cap=vb.width*.16;dx=Math.max(-cap,Math.min(cap,dx));dy=Math.max(-cap,Math.min(cap,dy));
 svg.dataset.ctr='1';
 const px=r.width/vb.width;
 if(Math.abs(dx)*px<.2&&Math.abs(dy)*px<.2)return;
 const g=document.createElementNS(NS,'g');g.setAttribute('data-ctr-g','1');
 g.setAttribute('transform','translate('+dx.toFixed(2)+' '+dy.toFixed(2)+')');
 while(svg.firstChild)g.appendChild(svg.firstChild);svg.appendChild(g);
}
let busy=false,q=0;
function run(){if(busy)return;busy=true;try{ph.querySelectorAll('svg:not([data-ctr])').forEach(fixOne)}catch(e){}busy=false}
new MutationObserver(()=>{if(busy)return;run()}).observe(ph,{childList:true,subtree:true});
window.addEventListener('load',run);run();
}catch(e){console.error('v778-icons',e)}})();

/* v779: remove the Explore section-chip row (noise) */
(function(){try{const ph=document.getElementById('phone');if(!ph)return;const st=document.createElement('style');st.textContent='#phone [role=navigation][aria-label=Sections]{display:none!important}';document.head.appendChild(st);
const rm=()=>ph.querySelectorAll('[role=navigation][aria-label=Sections]').forEach(e=>e.remove());new MutationObserver(rm).observe(ph,{childList:true,subtree:true});rm()}catch(e){}})();
/* v783: the + tile is now a real stop on the rail. When it is in the middle, the QR code is replaced by an "Add a card" panel (illustration, Add card, Manage cards); Add card opens a card form, and the new card joins the rail and becomes what pays. (v782: smoother and haptic. Scroll now reads cached card positions (no layout work per frame), the middle card highlights and the tip changes live as you pass it, every card you pass gives a light buzz (Android; iPhone Safari does not let web pages vibrate), and the code redraw waits until the strip stops. (v781: the rail now loops like an escalator: cards keep coming back round, so there is always a card on both sides and no dead end. (v780: Pay code card rail behaves like Naver Pay / Kakao Pay. Swipe (or drag) sideways: cards glide and snap, the one in the middle grows and is the one you pay with, the code and "Pays from" update in place without redrawing the rail. Tap a side card to bring it to the middle.) */
(function(){try{
const ph=document.getElementById('phone');if(!ph)return;
const T=window.T3||((a)=>a);
const st=document.createElement('style');st.textContent=`
#phone .pcd .pcrl{scroll-snap-type:x mandatory;overscroll-behavior-x:contain;-webkit-overflow-scrolling:touch;touch-action:pan-x;gap:0!important;cursor:grab;align-items:flex-end}
#phone .pcd .pcrl.drag{cursor:grabbing}
#phone .pcd .pcmc.rcard,#phone .pcd .pcmc.add{width:100px!important;height:159px!important;margin:0 2px;flex:0 0 100px;scroll-snap-align:center;scroll-snap-stop:normal;transform:scale(var(--s,.8));transform-origin:50% 100%;will-change:transform,opacity;animation:none!important;transition:none;-webkit-tap-highlight-color:transparent;user-select:none;-webkit-user-select:none}
#phone .pcd .pcmc.rcard:active,#phone .pcd .pcmc.add:active{transform:scale(calc(var(--s,.8)*.97))}
#phone .pcd .pcmc.add{border-radius:14px}
`;document.head.appendChild(st);
const key=b=>b.dataset.k||(b.classList.contains('add')?'add':b.classList.contains('bank')?'bank':b.classList.contains('cardm')?'cardm':b.classList.contains('transit')?'transit':'pay');
const SEL=()=>{const s=S.pcSel;if(s&&(!/^u\d+$/.test(s)||(S.xc&&S.xc[+s.slice(1)])))return s;return S.psrc==='bank'?'bank':'pay'};
const rail=()=>document.getElementById('pcrail');
let lastScroll=0,moved=false,SET=0,N=0;
function recenter(r){if(!SET)return;const c=layout(r);if(!c)return;const all=[...r.querySelectorAll('.pcmc')],i=all.indexOf(c),shift=(2-Math.floor(i/N))*SET;if(!shift)return;const sb=r.style.scrollBehavior,ss=r.style.scrollSnapType;r.style.scrollBehavior='auto';r.style.scrollSnapType='none';r.scrollLeft+=shift;r.style.scrollSnapType=ss;r.style.scrollBehavior=sb;layout(r)}
function cache(r){r._cs=[...r.querySelectorAll('.pcmc')].map(b=>(b._c=b.offsetLeft+b.offsetWidth/2,b))}
function layout(r){const c=r.scrollLeft+r.clientWidth/2;let best=null,bd=1e9;
 if(!r._cs)cache(r);r._cs.forEach(b=>{const d=Math.abs(b._c-c),t=Math.max(0,1-d/104);b.style.setProperty('--s',(.8+.2*t).toFixed(3));b.style.opacity=(.5+.5*t).toFixed(2);if(d<bd){bd=d;best=b}});return best}
const centerOf=(r,b)=>b.offsetLeft+b.offsetWidth/2-r.clientWidth/2;
function goTo(b,smooth){const r=rail();if(!r||!b)return;r.scrollTo({left:centerOf(r,b),behavior:smooth?'smooth':'auto'});if(!smooth)layout(r)}
const nameOf=k=>{if(/^u\d+$/.test(k)){const c=S.xc[+k.slice(1)];return c.brand+' ·· '+c.last}return names()[k]};
const names=()=>({pay:'itunda Pay Money',bank:'itunda Bank',cardm:S.card?'itunda card ·· '+S.card.last:T('itunda card (not issued yet)','Ikarita itunda (ntiratangwa)','Carte itunda (non émise)'),transit:'itunda Transit'});
function tipFor(k){if(/^u\d+$/.test(k))return T('Paying with ','Kwishyura na ','Paiement avec ')+nameOf(k);if(k==='add')return null;return k==='cardm'?(S.card?T('Tap the card again to open it','Kanda ikarita nanone uyifungure','Touchez à nouveau pour l’ouvrir'):T('Tap again to get the itunda card','Kanda nanone ufate ikarita itunda','Touchez à nouveau pour obtenir la carte')):k==='transit'?T('Tap again to pay your bus fare','Kanda nanone wishyure itike y’imodoka','Touchez à nouveau pour payer votre trajet'):null}
function addHTML(){const b=(x)=>x;return `<div class="adc"><svg width="176" height="132" viewBox="0 0 176 132" aria-hidden="true"><ellipse cx="88" cy="124" rx="62" ry="5" fill="#000" opacity=".12"/><rect x="40" y="46" width="100" height="70" rx="13" fill="#3A3F4B"/><g transform="rotate(-9 82 52)"><rect x="46" y="12" width="82" height="54" rx="9" fill="#12D25B"/><rect x="55" y="23" width="15" height="11" rx="2.5" fill="#F7E3A0"/><circle cx="114" cy="26" r="6" fill="#04260F" opacity=".85"/></g><g transform="rotate(5 94 60)"><rect x="54" y="26" width="82" height="54" rx="9" fill="#8F89FF"/><rect x="63" y="37" width="15" height="11" rx="2.5" fill="#F7E3A0"/></g><path d="M40 74h100v28a14 14 0 0 1-14 14H54a14 14 0 0 1-14-14z" fill="#4A505E"/><path d="M76 74c0 8 6 13 14 13s14-5 14-13" fill="#3A3F4B"/><g><ellipse cx="30" cy="112" rx="17" ry="6" fill="#0E8F44"/><rect x="13" y="100" width="34" height="12" fill="#12D25B"/><ellipse cx="30" cy="100" rx="17" ry="6" fill="#3DF58A"/><ellipse cx="30" cy="92" rx="17" ry="6" fill="#0E8F44"/><rect x="13" y="80" width="34" height="12" fill="#12D25B"/><ellipse cx="30" cy="80" rx="17" ry="6" fill="#3DF58A"/></g><ellipse cx="132" cy="119" rx="15" ry="5" fill="#0E8F44"/><ellipse cx="132" cy="116" rx="15" ry="5" fill="#3DF58A"/></svg><h3>${T('Add a card and pay with ease','Ongeramo ikarita wishyure byoroshye','Ajoutez une carte et payez simplement')}</h3><button class="b1" onclick="S.stack.push('addcard');render('push')">${T('Add a card','Ongeramo ikarita','Ajouter une carte')}</button><button class="b2" onclick="S.stack.push('mycards');render('push')">${T('Manage cards','Genzura amakarita','Gérer les cartes')}</button></div>`}
function patch(){const k=SEL(),bd=document.querySelector('.pcd .bd'),tip=document.querySelector('.pcd .pctip');
 if(tip)tip.style.visibility=k==='add'?'hidden':'';
 if(k==='add'){if(bd){const o=bd.firstElementChild;if(o&&!o.classList.contains('pcar')&&!o.classList.contains('addui')){const d=document.createElement('div');d.className='addui';d.style.cssText='flex:1;overflow-y:auto';d.innerHTML=addHTML();bd.replaceChild(d,o)}}return}
 if(k==='pay'||k==='bank')return;const n=nameOf(k);
 const s=document.querySelector('.pcd .src span');if(s)s.innerHTML='<small>'+T('Pays from','Yishyura ikoresheje','Payé depuis')+'</small>'+n;
 const tb=document.querySelector('.pcd .tpb small');if(tb)tb.textContent=n;const ts=document.querySelector('.pcd .tpb strong');if(ts)ts.style.visibility='hidden';
 if(tip)tip.textContent=tipFor(k)}
function swap(){const bd=document.querySelector('.pcd .bd');if(!bd||typeof screens.pcode!=='function')return;
 const tmp=document.createElement('div');tmp.innerHTML=screens.pcode();const nb=tmp.querySelector('.bd');if(!nb)return;
 const o=bd.firstElementChild,n=nb.firstElementChild;if(o&&n&&!o.classList.contains('pcar')&&!n.classList.contains('pcar'))bd.replaceChild(n,o);
 const ot=bd.querySelector('.pctip'),nt=nb.querySelector('.pctip');if(ot&&nt)ot.textContent=nt.textContent;
 const ts=bd.querySelector('.tpb strong');if(ts)ts.style.visibility=''}
function press(r,k){r.querySelectorAll('.pcmc').forEach(b=>{b.setAttribute('aria-pressed',String(key(b)===k))})}
function commit(k,tick){const r=rail();if(!r)return;S.pcSel=k;if(k==='pay'||k==='bank')S.psrc=k;press(r,k);swap();patch();if(tick){try{navigator.vibrate&&navigator.vibrate(10)}catch(e){}}}
function settle(){const r=rail();if(!r)return;recenter(r);const b=layout(r);if(!b)return;const k=key(b);if(k!==SEL()){commit(k,true)}else if(pending){swap();patch();buzz(14)}pending=0;lastBest=b}
const buzz=(ms)=>{try{const n=Date.now();if(n-(buzz.t||0)>35){buzz.t=n;navigator.vibrate&&navigator.vibrate(ms)}}catch(e){}};
let pending=0,lastBest=null;
const tipLive=k=>{const t=document.querySelector('.pcd .pctip');if(!t)return;t.style.visibility=k==='add'?'hidden':'';const o=tipFor(k);t.textContent=o||(k==='bank'?T('Pay straight from your bank account','Ishyura ukoresheje konti ya banki','Payez depuis votre compte bancaire'):T('Earn 3% back with itunda Pay Money','Ubone 3% ukoresheje itunda Pay Money','Gagnez 3 % avec itunda Pay Money'))};
function live(r,b){if(!b||b===lastBest)return;if(lastBest)buzz(8);lastBest=b;const k=key(b);if(k===SEL())return;S.pcSel=k;if(k==='pay'||k==='bank')S.psrc=k;press(r,k);tipLive(k);pending=1}
let tm,raf;
document.addEventListener('scroll',e=>{const r=rail();if(!r||e.target!==r)return;lastScroll=Date.now();if(SET&&(r.scrollLeft<SET*.6||r.scrollLeft>SET*3.4))recenter(r);if(!raf)raf=requestAnimationFrame(()=>{raf=0;live(r,layout(r))});clearTimeout(tm);tm=setTimeout(settle,90)},true);
/* in-place source switch (replaces the old full redraw) */
const _old=window.pcSrc;
window.pcSrc=function(k){const r=rail();if(!r)return _old&&_old(k);if(Date.now()-lastScroll<450)return;const cc=r.scrollLeft+r.clientWidth/2;const b=[...r.querySelectorAll('.pcmc')].filter(x=>key(x)===k).sort((a,c)=>Math.abs(a.offsetLeft+a.offsetWidth/2-cc)-Math.abs(c.offsetLeft+c.offsetWidth/2-cc))[0];if(b){goTo(b,true);if(k!==SEL())commit(k,false)}};
/* tap: side card -> glide to the middle; middle card keeps its own action (open card / transit / add money) */
function bind(r){
 r.addEventListener('click',e=>{const b=e.target.closest('.pcmc');if(!b)return;if(moved){e.preventDefault();e.stopImmediatePropagation();return}
  const k=key(b);const c=layout(r);
  if(b!==c){e.preventDefault();e.stopImmediatePropagation();buzz(8);goTo(b,true)}
  else if(k==='pay'||k==='bank'||k==='add'){e.preventDefault();e.stopImmediatePropagation()}},true);
 /* mouse drag (touch already scrolls natively) */
 let down=false,sx=0,sl=0;
 r.addEventListener('mousedown',e=>{if(e.button!==0)return;down=true;moved=false;sx=e.clientX;sl=r.scrollLeft});
 window.addEventListener('mousemove',e=>{if(!down)return;const dx=e.clientX-sx;if(!moved&&Math.abs(dx)>4){moved=true;r.classList.add('drag');r.style.scrollSnapType='none';r.style.scrollBehavior='auto'}if(moved)r.scrollLeft=sl-dx});
 window.addEventListener('mouseup',()=>{if(!down)return;down=false;r.classList.remove('drag');if(moved){const c=layout(r);r.style.scrollSnapType='';r.style.scrollBehavior='';goTo(c,true);setTimeout(()=>{moved=false},0)}});
}
function init(){const r=rail();if(!r||r.dataset.sm)return;r.dataset.sm='1';bind(r);
 {const nf=(r.querySelector('.rnf')||{}).innerHTML||'',G={Visa:'linear-gradient(158deg,#3F6BFF,#1A3FBF 50%,#0B1F6B)',Mastercard:'linear-gradient(158deg,#FF8A4C,#D8402B 50%,#6E1B13)',Card:'linear-gradient(158deg,#4FD1C5,#1E8E87 50%,#0C4A47)'};const last=r.querySelector('.pcmc.transit')||r.lastElementChild;let ref=last.nextSibling;(S.xc||[]).forEach((c,i)=>{const bt=document.createElement('button');bt.className='pcmc rcard usr';bt.dataset.k='u'+i;bt.style.background=G[c.brand]||G.Card;bt.style.setProperty('--cf','#fff');bt.setAttribute('aria-label',c.brand+' '+c.last);bt.setAttribute('onclick',"S.stack.push('mycards');render('push')");bt.innerHTML='<span class="rch"></span><span class="rno">•• '+c.last+'</span><span class="rnm">'+c.brand+'<small> ·· '+c.last+'</small></span><span class="rnf">'+nf+'</span>';r.insertBefore(bt,ref)})}
 const orig=[...r.querySelectorAll('.pcmc')];N=orig.length;
 const mk=()=>orig.map(b=>{const c=b.cloneNode(true);c.setAttribute('aria-hidden','true');c.tabIndex=-1;return c});
 const first=orig[0],after=document.createDocumentFragment();
 for(let i=0;i<2;i++){mk().forEach(c=>r.insertBefore(c,first))}
 for(let i=0;i<2;i++){mk().forEach(c=>after.appendChild(c))}r.appendChild(after);
 const all0=[...r.querySelectorAll('.pcmc')];SET=all0[2*N].offsetLeft-all0[N].offsetLeft;cache(r);window.addEventListener('resize',()=>{const q=rail();if(q)cache(q)});
 const k=SEL();press(r,k);const b=[...r.querySelectorAll('.pcmc')].filter(x=>key(x)===k)[2];r.style.scrollBehavior='auto';
 if(b)r.scrollLeft=centerOf(r,b);layout(r);patch()}
new MutationObserver(()=>{try{init()}catch(e){}}).observe(ph,{childList:true,subtree:true});
try{init()}catch(e){}
}catch(e){console.error('v780-cards',e)}})();

/* v783: Add-a-card form + Manage cards */
try{(function(){
const T=window.T3||(a=>a);
const st=document.createElement('style');st.textContent=`
#phone .pcd .adc{margin:20px 20px 0;border-radius:28px;background:#fff;color:#191F28;padding:26px 20px 20px;text-align:center;display:flex;flex-direction:column;align-items:center}
#phone .pcd .adc h3{margin:10px 0 22px;font-size:21px;line-height:30px;font-weight:800;letter-spacing:-.3px;padding:0 6px}
#phone .pcd .adc button{width:100%;min-height:54px;border-radius:27px;font:inherit;font-size:17px;cursor:pointer}
#phone .pcd .adc .b1{border:0;background:#8F89FF;color:#17171C;font-weight:800}
#phone .pcd .adc .b2{margin-top:10px;border:1.5px solid #D9DDE3;background:#fff;color:#191F28;font-weight:500}
.acf label{display:block;margin-top:14px;font-size:13px;font-weight:600;color:var(--mu)}
.acf input{display:block;width:100%;box-sizing:border-box;height:54px;margin-top:6px;border:2px solid transparent;border-radius:14px;background:var(--chip);color:var(--tx);font:inherit;font-size:17px;padding:0 16px;outline:0}
.acf input:focus{border-color:var(--br)}
.acf .acr{display:flex;gap:12px}.acf .acr label{flex:1}
.acp{height:150px;border-radius:18px;background:linear-gradient(158deg,#A9A5FF,#7472F4 46%,#4B43C9);color:#fff;padding:18px 20px;display:flex;flex-direction:column;justify-content:flex-end;gap:6px;font-weight:700;letter-spacing:.5px;box-shadow:0 10px 24px -10px rgba(75,67,201,.7)}
.acp #acp_n{font-size:20px;font-variant-numeric:tabular-nums}.acp #acp_x{font-size:14px;opacity:.85}
.acb{display:block;width:100%;min-height:56px;margin-top:22px;border:0;border-radius:28px;background:var(--br);color:var(--on);font:inherit;font-size:18px;font-weight:800;cursor:pointer}
.acb:disabled{opacity:.4;cursor:default}
.acf .lnkb{display:block;margin:6px auto 0;min-height:44px;border:0;background:none;color:var(--lk,var(--br));font:inherit;font-size:14px;font-weight:600}
.acf .acn{margin-top:4px;font-size:13px;line-height:19px;color:var(--mu);text-align:center}
.mcl .mcr{display:flex;align-items:center;gap:14px;padding:12px 0}
.mcl .mci{flex:0 0 auto;width:44px;height:30px;border-radius:7px}
.mcl .mcm{flex:1;min-width:0}.mcl .mcm b{display:block;font-size:16px;font-weight:700}.mcl .mcm span{display:block;font-size:13px;color:var(--mu);margin-top:2px}
.mcl .mcx{min-height:44px;padding:0 14px;border:0;border-radius:22px;background:var(--chip);color:var(--tx);font:inherit;font-size:14px;font-weight:700}
`;document.head.appendChild(st);
const G={Visa:'linear-gradient(158deg,#3F6BFF,#0B1F6B)',Mastercard:'linear-gradient(158deg,#FF8A4C,#6E1B13)',Card:'linear-gradient(158deg,#4FD1C5,#0C4A47)'};
screens.addcard=()=>`${bar(T('Add a card','Ongeramo ikarita','Ajouter une carte'))}<div class="pad acf" style="padding-top:8px"><div class="acp" aria-hidden="true"><span id="acp_n">•••• •••• •••• ••••</span><span id="acp_x">MM/YY</span></div>
<label>${T('Card number','Nimero y’ikarita','Numéro de carte')}<input id="ac_n" inputmode="numeric" autocomplete="off" maxlength="19" placeholder="1234 5678 9012 3456" oninput="acIn()"></label>
<label>${T('Name on card','Izina riri ku ikarita','Nom sur la carte')}<input id="ac_m" autocomplete="off" placeholder="AMINA UWASE" oninput="acIn()"></label>
<div class="acr"><label>${T('Expiry','Itariki irangira','Expiration')}<input id="ac_e" inputmode="numeric" autocomplete="off" maxlength="5" placeholder="MM/YY" oninput="acIn()"></label><label>CVC<input id="ac_c" inputmode="numeric" autocomplete="off" maxlength="3" placeholder="123" oninput="acIn()"></label></div>
<button class="acb" id="ac_go" disabled onclick="acGo()">${T('Add card','Ongeramo ikarita','Ajouter la carte')}</button>
<button class="lnkb" onclick="acSample()">${T('Prototype: fill a sample card','Prototype: uzuza ikarita y’icyitegererezo','Prototype : remplir une carte d’exemple')}</button>
<div class="acn">${T('Your card details are encrypted. Only the last 4 digits are shown in the app.','Amakuru y’ikarita yawe arahishwa. Imibare 4 ya nyuma ni yo igaragara.','Vos données sont chiffrées. Seuls les 4 derniers chiffres s’affichent.')}</div></div>`;
const $=id=>document.getElementById(id);
window.acIn=()=>{const n=$('ac_n'),e=$('ac_e'),c=$('ac_c'),m=$('ac_m');if(!n)return;
 n.value=n.value.replace(/\D/g,'').slice(0,16).replace(/(.{4})/g,'$1 ').trim();
 let ev=e.value.replace(/\D/g,'').slice(0,4);if(ev.length>2)ev=ev.slice(0,2)+'/'+ev.slice(2);e.value=ev;c.value=c.value.replace(/\D/g,'').slice(0,3);
 $('acp_n').textContent=(n.value+' ••••••••••••••••').replace(/ /g,'').slice(0,16).replace(/(.{4})/g,'$1 ').trim();
 $('acp_x').textContent=(m.value.trim().toUpperCase()||'')+(m.value.trim()?'  ':'')+(ev||'MM/YY');
 const mm=+ev.slice(0,2);$('ac_go').disabled=!(n.value.replace(/\D/g,'').length===16&&ev.length===5&&mm>=1&&mm<=12&&c.value.length===3&&m.value.trim().length>1)};
window.acSample=()=>{$('ac_n').value='4242424242424242';$('ac_m').value='AMINA UWASE';$('ac_e').value='1228';$('ac_c').value='123';acIn()};
window.acGo=()=>{const d=$('ac_n').value.replace(/\D/g,'');const brand=d[0]==='4'?'Visa':d[0]==='5'?'Mastercard':'Card';
 S.xc=S.xc||[];S.xc.push({brand,last:d.slice(-4),name:$('ac_m').value.trim(),exp:$('ac_e').value});S.pcSel='u'+(S.xc.length-1);S.pcT=1;
 try{navigator.vibrate&&navigator.vibrate(15)}catch(e){}
 S.stack.pop();render('pop');toast(T(brand+' ·· '+d.slice(-4)+' added',brand+' ·· '+d.slice(-4)+' yongeweho',brand+' ·· '+d.slice(-4)+' ajoutée'))};
screens.mycards=()=>{const w=(n,s,g)=>`<div class="mcr"><div class="mci" style="background:${g}"></div><div class="mcm"><b>${n}</b><span>${s}</span></div></div>`;
 const u=(S.xc||[]).map((c,i)=>`<div class="mcr"><div class="mci" style="background:${G[c.brand]||G.Card}"></div><div class="mcm"><b>${c.brand} ·· ${c.last}</b><span>${T('Expires','Irangira','Expire')} ${c.exp}</span></div><button class="mcx" onclick="mcRm(${i})">${T('Remove','Kuramo','Retirer')}</button></div>`).join('');
 return `${bar(T('Manage cards','Genzura amakarita','Gérer les cartes'))}<div class="pad mcl" style="padding-top:8px">${w('itunda Pay Money',fmt(S.pay)+' RWF','linear-gradient(158deg,#3DF58A,#06A845)')}${w('itunda Bank',fmt(S.bank)+' RWF','linear-gradient(158deg,#A9A5FF,#4B43C9)')}${u}<button class="acb" onclick="S.stack.push('addcard');render('push')">${T('Add a card','Ongeramo ikarita','Ajouter une carte')}</button></div>`};
window.mcRm=i=>{S.xc.splice(i,1);S.pcSel='pay';render('fade-none');toast(T('Card removed','Ikarita yakuweho','Carte retirée'))};
})()}catch(e){console.error('v783-screens',e)}

/* v784: Home app bar, Toss-style. No rounded wrappers behind the icons, thinner grey line icons (scan-to-pay frame with "Pay", bell with a red dot), and the logo with a bold grey "itunda bank" wordmark. Light and dark. */

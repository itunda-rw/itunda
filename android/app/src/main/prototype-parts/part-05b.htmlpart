#phone#phone .pkpb{font-size:14px;font-weight:500;letter-spacing:-.2px;color:var(--mu);margin-top:2px;font-variant-numeric:tabular-nums}
#phone#phone .pkh .pkn{font-size:20px;font-weight:700;letter-spacing:-.5px}
#phone#phone .pkh .pkb{font-size:40px;line-height:48px;font-weight:800;letter-spacing:-1.4px;font-variant-numeric:tabular-nums}
#phone#phone .pkh .pkbar{height:10px;border-radius:5px;background:var(--chip);overflow:hidden}

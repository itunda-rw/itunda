const st=document.createElement('style');st.textContent='#phone button[onclick="egStart()"].g816{border:0!important;border-radius:0!important;background:none!important;padding:6px 0!important;min-height:44px;gap:0!important}#phone button[onclick="egStart()"].g816>span:first-child,#phone button[onclick="egStart()"].g816 .sm.mu{display:none!important}#phone button[onclick="egStart()"].g816 b{font-size:15px!important}';document.head.appendChild(st);
setInterval(()=>{try{document.querySelectorAll('#phone button[onclick="egStart()"]:not(.g816)').forEach(b=>b.classList.add('g816'))}catch(e){}},400);
})()}catch(x){console.error('v816',x)}
/* v819: Eats tracking: after 60 seconds with no rider, the line under "Finding you a rider" says it is taking longer and that we are still looking. rw and fr need native review. */

/* v824: Eats tracking: when the promised time passes and the order is not delivered, the "Arrives by" line says it is running late and gives a new time (8 minutes on), once. rw and fr need native review. */
try{(function(){
const T=(e,f,r)=>({en:e,fr:f,rw:r}[S.lang]||e);
const hm=t=>{const d=new Date(t);return String(d.getHours()).padStart(2,'0')+':'+String(d.getMinutes()).padStart(2,'0')};
setInterval(()=>{try{
 if(S.stack[S.stack.length-1]!=='etrack'||S.ecancel)return;
 const o=S.orders.find(x=>x.k==='Eats order'&&x.items);if(!o||!o.eta)return;
 const bus=(window.__itundaBus||{orders:[]}).orders.find(x=>x.id===o.id);if(bus&&(bus.delivered||bus.cancelled))return;
 if(!o.late824&&Date.now()>o.eta){o.late824=1;o.eta=Date.now()+8*6e4}
 if(!o.late824)return;
 const el=document.querySelector('.ez-ts>div');if(!el)return;
 const t=o.pickup?T('Running late, ready by ','En retard, prêt vers ','Birakererewe, bizaba byiteguye saa '):T('Running late, now by ','En retard, maintenant vers ','Birakererewe, bizahagera saa ');
 const s=t+hm(o.eta);if(el.textContent!==s)el.textContent=s;
}catch(e){}},2000);
})()}catch(x){console.error('v824',x)}

/* v827: Eats tracking: after 2 minutes with no rider, the line says we are still looking and that cancelling is free. rw and fr need native review. */
try{(function(){
const T=(e,f,r)=>({en:e,fr:f,rw:r}[S.lang]||e);
setInterval(()=>{try{
 if(S.stack[S.stack.length-1]!=='etrack'||S.pickup||S.ecancel)return;
 const o=S.orders.find(x=>x.k==='Eats order'&&x.id);if(!o)return;
 const e=(window.__itundaBus||{orders:[]}).orders.find(x=>x.id===o.id);if(!e||e.cancelled||e.claimed||!e.fAt||Date.now()-e.fAt<120000)return;
 const R=document.getElementById('rider');if(!R||R.style.display==='none')return;
 const sub=R.querySelector('.sm.mu');if(!sub)return;
 const s=T('Still looking for a rider. You can cancel for a full refund.','Nous cherchons toujours un livreur. Vous pouvez annuler et être remboursé.','Turacyashaka umushoferi. Ushobora guhagarika ukisubiza amafaranga yose.');
 if(sub.textContent!==s)sub.textContent=s;

#phone#phone .screen:has([onclick="goalDel()"]) div[style*="height:8px"]>div,#phone#phone .screen:has([onclick="loanPay()"]) div[style*="height:8px"]>div{height:10px!important;border-radius:5px!important;background:var(--cta,#6258F5)!important}

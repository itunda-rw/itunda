#phone#phone .p712 .card{border-radius:20px}
#phone#phone .p712 .pill{height:36px;padding:0 16px;border:0;border-radius:12px;background:var(--tint);color:var(--tintfg);font-size:14px;font-weight:700}
#phone#phone .p712 .pill:active{transform:scale(.96)}
#phone#phone .p712 .pill.d{background:var(--chip);color:var(--tx)}
#phone#phone .p712 .ad{border-radius:20px}
#phone#phone .p712 .ad .big{font-size:24px;font-weight:800;letter-spacing:-.7px;line-height:31px}
#phone#phone .p712 .ad .go{height:52px;border:0;border-radius:16px;background:var(--cta,#6258F5);color:var(--ctafg,#fff);font-size:16px;font-weight:700}
#phone#phone .p712 .ad .go:active{transform:scale(.98)}
#phone#phone .p712 #p712q{height:48px;padding:0 16px;border:0;border-radius:14px;background:var(--chip);font-size:16px}
#phone#phone .p712 #p712q:focus{outline:0;box-shadow:inset 0 0 0 2px var(--cta,#6258F5)}
#phone#phone .p712 .ch button{height:36px;padding:0 14px;border:0;border-radius:18px;background:var(--chip);color:var(--tx);font-size:14px;font-weight:600;white-space:nowrap}
#phone#phone .p712 .ch button.on{background:var(--tx);color:var(--bg)}
</style>
<style id="v898toss">
/* v898: Toss-style pass 26. Kigali Maps feature screens: Transit, Discover, Book, Parking, Offline maps. 19px section titles, 17px names on roomy rows, pill chips with a dark selected one, tinted 36px action buttons, solid violet primary buttons, soft grey info cards without borders. */
#phone#phone .screen:has(.trh) .nb button,#phone#phone .screen:has(.dh) .nb button,#phone#phone .screen:has(.dvh) .inf button{height:36px;padding:0 14px;border:0;border-radius:18px;background:var(--chip);color:var(--tx);font-size:14px;font-weight:600;white-space:nowrap}
#phone#phone .screen:has(.trh) .nb button.on,#phone#phone .screen:has(.dh) .nb button.on,#phone#phone .screen:has(.dvh) .inf button.on{background:var(--tx);color:var(--bg)}
#phone#phone .trh,#phone#phone .dh,#phone#phone .bkh,#phone#phone .dvh{font-size:19px;font-weight:700;letter-spacing:-.4px}
#phone#phone .tr,#phone#phone .dc,#phone#phone .dvr{min-height:68px;border-radius:16px}
#phone#phone .tr:active,#phone#phone .dc:active,#phone#phone .dvr:active{background:color-mix(in srgb,var(--tx) 4%,transparent)}
#phone#phone .dc .mv,#phone#phone .tr .mn{font-weight:800;letter-spacing:-.3px}
#phone#phone .cpn{border-radius:16px;background:var(--tint)}
#phone#phone .cpn button{height:36px;padding:0 16px;border:0;border-radius:12px;background:var(--cta,#6258F5);color:var(--ctafg,#fff);font-size:14px;font-weight:700}
#phone#phone .bk{padding:14px 0}
#phone#phone .bk button{height:36px;padding:0 14px;border:0;border-radius:12px;background:var(--tint);color:var(--tintfg);font-size:14px;font-weight:700}
#phone#phone .bk button.m{background:var(--cta,#6258F5);color:var(--ctafg,#fff)}
#phone#phone .bk button:active{transform:scale(.96)}
#phone#phone .inc{border:0;border-radius:16px;background:var(--chip)}
#phone#phone .screen:has(.dvh) .dvr button:not(.ib):not(.tg){height:36px;padding:0 16px;border:0;border-radius:12px;background:var(--tint);color:var(--tintfg);font-size:14px;font-weight:700}
#phone#phone .screen:has(.pks) .g+button,#phone#phone .screen:has(.pks) button.m{height:52px;border:0;border-radius:16px;background:var(--cta,#6258F5);color:var(--ctafg,#fff);font-size:16px;font-weight:700}
</style>
<script id="v899fix">
/* v899: fix. Display & haptics, Theme crashed with "T is not defined" (the Accent colour block used a helper that only exists inside other scopes), so tapping Theme did nothing. The Pay order screen (Order ahead) had the same problem with srcN. T and srcN are now a global (English, Kinyarwanda, French) helper. */
(function(){try{if(typeof window.T==='undefined'){window.T=function(e,r,f){return {en:e,rw:r,fr:f}[S.lang]||e}}}catch(x){}try{if(typeof window.srcN==='undefined'){window.srcN=function(){return S.psrc==='bank'?'itunda Bank':'itunda Pay'}}}catch(x){}})();
</script>
<style id="v900toss">
/* v900: Toss-style pass 27. Pay, My code: the two links under the QR card overlapped the card edge by 9px at 11px size. They now start 7px below the card, at 13px, and the helper link is muted. */
#phone#phone .screen:has(.pctip) div:has(>.lnk){margin-top:7px;max-height:20px;padding:0 16px}
#phone#phone .screen:has(.pctip) .lnk{font-size:13px!important;font-weight:600;height:20px!important;line-height:20px}
#phone#phone .screen:has(.pctip) .lnk+.lnk{color:var(--tt)!important;font-weight:500}
</style>
<style id="v901toss">
/* v901: Toss-style pass 28. Kigali Maps: Share list, Report a map error, Safe driving, Street view. Share options are roomy 64px rows, info cards are soft grey with no border, driving cards and the Report button are soft 16px blocks, and Street view buttons are 52px with a solid violet primary. Settings rows (Haptics) use 17px names. */
#phone#phone .slo{min-height:64px;border-radius:16px;font-size:17px}
#phone#phone .slo:active{background:color-mix(in srgb,var(--tx) 4%,transparent)}
#phone#phone .slo b,#phone#phone .slo .t{font-size:17px;font-weight:600;letter-spacing:-.3px}
#phone#phone .dvc{border:0;border-radius:20px}
#phone#phone .dvrb{height:48px;border:0;border-radius:14px;background:var(--chip);font-size:15px;font-weight:700}
#phone#phone .dvrb:active{transform:scale(.97)}
#phone#phone .dvrp{border:0;border-radius:16px}
#phone#phone .screen:has(.dvh) .dvr.tap{min-height:68px;border-radius:16px}
#phone#phone .screen:has(button.btn.sec2):not(:has(.stt)) .btn{height:52px;border:0;border-radius:16px;font-size:16px;font-weight:700}
#phone#phone .screen:has(button.btn.sec2):not(:has(.stt)) .btn:not(.sec2){background:var(--cta,#6258F5);color:var(--ctafg,#fff)}
#phone#phone .screen:has(button.btn.sec2):not(:has(.stt)) .btn.sec2{background:var(--tint)!important;color:var(--tintfg)!important}
#phone#phone .screen:has(.stt) .ar .t{font-size:17px;font-weight:600;letter-spacing:-.3px}
</style>
<style id="v902toss">
/* v902: Toss-style pass 29. Kigali Maps task screens: Drive, Walk, Around you, Road alerts, Place Agent, Visit Kigali, Indoor. One treatment: 19px section titles, 68px rows with a soft press, quiet pill chips with a dark selected one, soft 48px text fields, tinted 36px small buttons, solid violet 52px primary button. */
#phone#phone .screen:has(.dvh) .dvh{font-size:19px;font-weight:700;letter-spacing:-.4px}
#phone#phone .screen:has(.dvh) .dvr{min-height:68px;border-radius:16px}
#phone#phone .screen:has(.dvh) .dvr.tap:active{background:color-mix(in srgb,var(--tx) 4%,transparent)}
#phone#phone .screen:has(.dvh) .dvr .t,#phone#phone .screen:has(.dvh) .dvr b{font-size:16px;font-weight:600;letter-spacing:-.3px}
#phone#phone .screen:has(.dvh) .dvc,#phone#phone .inc,#phone#phone .dvb2{border:0;border-radius:20px;background:var(--chip)}
#phone#phone .screen:has(.dvt) :is(.dvt,.inf) button:not(.v420hit.hit44b:has(span)),#phone#phone .screen:has(.inf) .inf button{height:36px;padding:0 14px;border:0;border-radius:18px;background:var(--chip);color:var(--tx);font-size:14px;font-weight:600;white-space:nowrap}
#phone#phone .screen:has(.dvt) :is(.dvt,.inf) button:not(.v420hit.hit44b:has(span)).on,#phone#phone .screen:has(.inf) .inf button.on{background:var(--tx);color:var(--bg)}
#phone#phone .screen:has(.dvh) .dvr button:not(.ib):not(.tg),#phone#phone .screen:has(.rdb) .rdb button,#phone#phone .screen:has(.dvh) button.gh{height:36px;padding:0 14px;border:0;border-radius:12px;background:var(--tint);color:var(--tintfg);font-size:14px;font-weight:700}
#phone#phone .screen:has(.dvh) .dvr button:active,#phone#phone .screen:has(.rdb) .rdb button:active{transform:scale(.96)}
#phone#phone .screen:has(.mh) input.in{height:48px;padding:0 16px;border:0;border-radius:14px;background:var(--chip);font-size:16px}
#phone#phone .screen:has(.mh) input.in:focus{outline:0;box-shadow:inset 0 0 0 2px var(--cta,#6258F5)}
#phone#phone .screen:has(.dvh) .btn,#phone#phone .screen:has(.wkq) .btn{height:52px;border:0;border-radius:16px;font-size:16px;font-weight:700;background:var(--cta,#6258F5);color:var(--ctafg,#fff)}
</style>
<style id="v903toss">
/* v903: Toss-style pass 30. Toss draws its UI marks with Toss Icons and keeps the font glyphs for text only. itunda now does the same: the typed marks that were still font characters (★ ☆ ✓ ✕ ⌄ ⌃ → ← ↑ ↓ ↗ ⇄ ⇅ ♡ ♥ ✎ ↰ ↱ ⏸ ⌫) are drawn as itundaicons line shapes (24px grid, round caps, same weight as the other line icons). The character stays in the page (hidden), so copy, search and screen readers still see the same text. */
#phone .ig{display:inline-block!important;width:1em!important;height:1em!important;vertical-align:-.17em!important;margin:0 .03em!important;padding:0!important;overflow:hidden!important;text-indent:200%!important;white-space:nowrap!important;line-height:1!important;letter-spacing:0!important;background-color:currentColor;-webkit-mask:var(--igm) center/contain no-repeat;mask:var(--igm) center/contain no-repeat;font-style:normal}
#phone .ig.ig-s{width:.95em!important;height:.95em!important;vertical-align:-.14em!important}
#phone .ig.ig-c{width:.85em!important;height:.85em!important;vertical-align:-.1em!important}
#phone .ig.ig-gold{color:#FFB800!important}
#phone .ig.ig-gold.ig-off{color:var(--tt,#B0B8C1)!important}
#phone .ig.ig-red{color:#F65669!important}
#phone .ig.ig-ok{color:inherit}
@media (forced-colors:active){#phone .ig{background-color:CanvasText}}
</style>
<script id="v903js">

#phone .ar .g.fv{position:relative}
#phone .ar .g.fv .fvb{position:absolute;right:-3px;bottom:-3px;width:16px;height:16px;border-radius:8px;background:#EF4A63;box-shadow:0 0 0 2px var(--chip,#F2F4F6);display:flex;align-items:center;justify-content:center}

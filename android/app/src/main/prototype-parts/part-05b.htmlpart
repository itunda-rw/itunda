#phone#phone .screen:has([onclick^="invTab"]) .agt{font-size:19px!important;font-weight:700!important;letter-spacing:-.5px!important;color:var(--tx)!important;padding:28px 24px 8px!important}
#phone#phone .screen:has([onclick^="invTab"]) div[style*="background:var(--chip);border-radius:20px;padding:14px 18px"]{border-radius:16px!important}
#phone#phone .screen:has([onclick^="invTab"]) .asr{border-radius:16px;height:48px}
#phone#phone .screen:has([onclick^="invTab"]) .asr input{font-size:16px;font-weight:500;letter-spacing:-.3px}
#phone#phone .screen:has([onclick^="invTab"]) .cch{height:36px;font-size:14px;font-weight:600;letter-spacing:-.2px;background:var(--chip);color:var(--mu)}
#phone#phone .screen:has([onclick^="invTab"]) .cch.on{background:var(--tx);color:var(--bg)}
#phone#phone .stk{min-height:68px;gap:14px}
#phone#phone .stk .tk{border-radius:50%;background:var(--chip);color:var(--mu);font-size:11px;font-weight:700;letter-spacing:-.2px}
#phone#phone .stk>div[style*="flex:1"]>div:first-child{font-weight:600!important;font-size:16px!important;letter-spacing:-.3px}
#phone#phone .stk>div[style*="flex:1"]>.sm{font-size:13px;color:var(--mu)}
#phone#phone .stk>div[style*="text-align:right"]>div:first-child{font-weight:700!important;font-size:16px;letter-spacing:-.3px;white-space:nowrap}
#phone#phone .stk>div[style*="text-align:right"]>.sm{font-size:13px;font-weight:600!important;letter-spacing:-.2px}
#phone#phone .stk:active{background:color-mix(in srgb,var(--tx) 5%,transparent)}
</style>
<style id="v883toss">
/* v883: Toss-style pass 12. Messages list: round 48px avatars, 17px names, grey time, one-line 15px preview, 76px rows with a soft press, quiet filter chips with a solid dark selected one, violet unread dots. */
#phone#phone .c24-tabs{gap:8px;padding:12px 24px 4px}
#phone#phone .c24-tabs .cch{height:36px;padding:0 16px;font-size:14px;font-weight:600;letter-spacing:-.2px;background:var(--chip);color:var(--mu)}
#phone#phone .c24-tabs .cch.on{background:var(--tx);color:var(--bg)}
#phone#phone .t25-dot{background:var(--cta,#6258F5)}
#phone#phone .mm-row{min-height:76px;padding:14px 24px;gap:16px}
#phone#phone .mm-row:active{background:color-mix(in srgb,var(--tx) 5%,transparent)}
#phone#phone .mm-row .t25-a{width:48px;height:48px;flex:0 0 48px}
#phone#phone .mm-row .t25-th{width:48px;height:48px;border-radius:50%}
#phone#phone .mm-row .t25-th svg{width:30px;height:30px}
#phone#phone .mm-row .t25-av{right:-4px;bottom:-4px;width:22px;height:22px;border-radius:11px}
#phone#phone .mm-row .t25-top b{font-size:17px;font-weight:600;letter-spacing:-.3px}
#phone#phone .mm-row .t25-m{font-size:13px;color:var(--tt)}
#phone#phone .mm-row .sm{font-size:15px;line-height:21px;letter-spacing:-.2px;color:var(--mu);margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#phone#phone .mm-row .mm-bd{min-width:20px;height:20px;font-size:12px;font-weight:700}
</style>
<style id="v884toss">
/* v884: Toss-style pass 13. Pay, My code. The two links under the QR ("Receive money instead" and the prototype helper) had the same colour and size and ran together. The real action is now white and semibold; the prototype helper is smaller and dimmer, separated by a dot. Row height is unchanged so the cards below do not move. */
#phone#phone div:has(>button[onclick*="ppGo('rcode')"]){flex-wrap:nowrap!important;gap:0!important;align-items:center}
#phone#phone button[onclick*="ppGo('rcode')"]{color:#fff!important;font-size:13px!important;font-weight:700;letter-spacing:-.2px;padding-inline:6px}
#phone#phone button[onclick*="pcMerch("]{color:rgba(255,255,255,.62)!important;font-size:12px!important;font-weight:500;padding-inline:8px;position:relative;white-space:nowrap}
#phone#phone button[onclick*="pcMerch("]::before{content:"";position:absolute;left:-2px;top:50%;width:3px;height:3px;margin-top:-1.5px;border-radius:50%;background:rgba(255,255,255,.4)}
#phone#phone button[onclick*="ppGo('rcode')"]:active,#phone#phone button[onclick*="pcMerch("]:active{opacity:.6}
</style>
<style id="v885toss">
/* v885: Toss-style pass 14. Eats restaurant: a 126px empty white band sat above the hero image (the top bar had padding but no content), so the photo started a third of the way down; it now starts at the top and the back, share and save buttons float over it. Places: result cards are one clean block with a 17px name, grey category, and the photo strip and extra buttons stay out of the list. Directions: the Home and Work strip loses its grey band and its chips get room. */
#phone#phone #sc:has(.g3)>.e2-tb{padding-top:0!important}
#phone#phone .e2-tbi{padding-top:10px}
#phone#phone .nvc{padding:18px 24px;border-bottom:0}
#phone#phone .nvc .n{font-size:17px;font-weight:600;letter-spacing:-.3px}
#phone#phone .nvc .n small{display:block;margin-top:2px;font-size:13px;font-weight:500;color:var(--tt)}
#phone#phone .nvc .r,#phone#phone .nvc .s{font-size:14px;letter-spacing:-.2px;margin-top:3px}
#phone#phone .nvc:active{background:color-mix(in srgb,var(--tx) 5%,transparent)}
#phone#phone .screen:has([onclick^="dhMode"]) div:has(>button[aria-label="Edit"]){background:transparent;gap:8px}
#phone#phone .screen:has([onclick^="dhMode"]) div:has(>button[aria-label="Edit"])>button:not([aria-label="Edit"]){background:var(--chip);border-radius:18px;padding:8px 14px;height:36px;color:var(--tx);font-weight:600}
#phone#phone .screen:has([onclick^="dhMode"]) .pl:active{background:color-mix(in srgb,var(--tx) 5%,transparent)}
</style>
<script id="v885js">
/* v885: Directions, Recent routes. "KG 7 Ave 22, Kacyiru" and "Kimironko Market" only said "coming soon" when tapped; they now open the address as Home and the nearby market stop route. */
(function(){const d=screens.dirhub;if(!d)return;screens.dirhub=function(){let h=String(d.apply(this,arguments));
h=h.replace(/onclick="soon\(\)"([^>]*>(?:(?!<\/div><\/div>)[\s\S])*?KG 7 Ave 22, Kacyiru)/,"onclick=\"mpAddr('Home','KG 7 Ave 22, Kacyiru')\"$1");
h=h.replace(/onclick="soon\(\)"([^>]*>(?:(?!<\/div><\/div>)[\s\S])*?Kimironko Market<\/b>)/,"onclick=\"dhGo('bus2','bus')\"$1");
return h}})();
</script>
<style id="v886toss">
/* v886: Toss-style pass 15. Savings goal and Loan. One big number, thicker violet bar with a soft end, plain grey meta, summary rows without a box, quiet tinted secondary button. */
#phone#phone .screen:has([onclick="goalDel()"]) .big,#phone#phone .screen:has([onclick="loanPay()"]) .big{font-size:40px;line-height:48px;font-weight:800;letter-spacing:-1.4px;font-variant-numeric:tabular-nums}
#phone#phone .screen:has([onclick="goalDel()"]) .pad .sm.mu:first-child,#phone#phone .screen:has([onclick="loanPay()"]) .pad .sm.mu:first-child{font-size:14px;font-weight:600;letter-spacing:-.2px}

<style id="v888toss">
/* v888: Toss-style pass 17. Foreign currency. Currency chips are quiet pills with a solid dark selected one, You pay and You get are two soft 20px cards with big numbers, round 48px stepper buttons, grey rate line, 64px wallet rows. */
#phone#phone .screen:has(button[onclick^="fxSet('c'"]) .chp{display:flex;gap:8px;overflow-x:auto;scrollbar-width:none;padding:18px 24px 0!important}
#phone#phone .screen:has(button[onclick^="fxSet('c'"]) .chp::-webkit-scrollbar{display:none}
#phone#phone .screen:has(button[onclick^="fxSet('c'"]) .chp button{flex:0 0 auto;height:36px;padding:0 16px;border:0;border-radius:18px;background:var(--chip);color:var(--mu);font-size:14px;font-weight:600;letter-spacing:-.2px;white-space:nowrap}
#phone#phone .screen:has(button[onclick^="fxSet('c'"]) .chp button.on{background:var(--tx);color:var(--bg)}
#phone#phone .screen:has(button[onclick^="fxSet('c'"]) div[style*="margin:22px 24px 0;padding:16px;border-radius:20px;background:var(--chip)"]{margin:24px 24px 0!important;padding:18px 16px!important;border-radius:20px!important;background:var(--chip)!important}
#phone#phone .screen:has(button[onclick^="fxSet('c'"]) div[style*="margin:22px 24px 0;padding:16px;border-radius:20px;background:var(--chip)"] .sm{font-size:14px;font-weight:600;letter-spacing:-.2px}
#phone#phone .screen:has(button[onclick^="fxSet('c'"]) div[style*="margin:22px 24px 0;padding:16px;border-radius:20px;background:var(--chip)"] b{font-size:28px!important;font-weight:800;letter-spacing:-1px!important;font-variant-numeric:tabular-nums}
#phone#phone .screen:has(button[onclick^="fxSet('c'"]) div[style*="margin:22px 24px 0;padding:16px;border-radius:20px;background:var(--chip)"] .ib{width:48px;height:48px;border-radius:24px!important;font-size:24px;font-weight:500}
#phone#phone .screen:has(button[onclick^="fxSet('c'"]) div[style*="margin:22px 24px 0;padding:16px;border-radius:20px;background:var(--chip)"] .ib:active{transform:scale(.92)}
#phone#phone .screen:has(button[onclick^="fxSet('c'"]) div[style*="text-align:center;padding:14px 0 0;font-size:20px"]{color:var(--tt);font-size:18px!important;padding-top:10px!important}
#phone#phone .screen:has(button[onclick^="fxSet('c'"]) div[style*="margin:6px 24px 0;padding:16px;border-radius:20px;background:var(--tint)"]{margin:6px 24px 0!important;padding:18px 16px!important;border-radius:20px!important;background:var(--tint)!important}
#phone#phone .screen:has(button[onclick^="fxSet('c'"]) div[style*="margin:6px 24px 0;padding:16px;border-radius:20px;background:var(--tint)"] .sm{font-size:14px;font-weight:600;letter-spacing:-.2px}
#phone#phone .screen:has(button[onclick^="fxSet('c'"]) div[style*="margin:6px 24px 0;padding:16px;border-radius:20px;background:var(--tint)"] b{display:block;margin-top:6px;font-size:32px!important;line-height:40px;font-weight:800;letter-spacing:-1.1px!important;font-variant-numeric:tabular-nums}
#phone#phone .screen:has(button[onclick^="fxSet('c'"]) div.mu[style*="padding:18px 24px 0;font-size:14px"]{font-size:14px!important;font-weight:500;letter-spacing:-.2px;padding-top:16px!important}
#phone#phone .screen:has(button[onclick^="fxSet('c'"]) div[style*="padding:14px 24px;border-top:0;font-size:15px"]{min-height:64px;align-items:center;padding:12px 24px!important;font-size:16px!important;letter-spacing:-.3px}
#phone#phone .screen:has(button[onclick^="fxSet('c'"]) div[style*="padding:14px 24px;border-top:0;font-size:15px"] span{font-weight:500}
#phone#phone .screen:has(button[onclick^="fxSet('c'"]) div[style*="padding:14px 24px;border-top:0;font-size:15px"] b{font-weight:700;font-variant-numeric:tabular-nums}
</style>
<style id="v889toss">
/* v889: Toss-style pass 18. Card cashback and Coupons. One big earned number, 19px section titles, pill category chips with a solid violet selected one, 64px history rows with a violet plus amount, small tinted Use buttons. */
#phone#phone .screen:has(button[onclick^="cbSet("]) .big{font-size:40px;line-height:48px;font-weight:800;letter-spacing:-1.4px;font-variant-numeric:tabular-nums}
#phone#phone .screen:has(button[onclick^="cbSet("]) .big+.mu{font-size:14px;line-height:20px;letter-spacing:-.2px;margin-top:6px!important}
#phone#phone .screen:has(button[onclick^="cbSet("]) .agt{font-size:19px;font-weight:700;letter-spacing:-.5px;color:var(--tx);padding:28px 24px 10px}
#phone#phone .screen:has(button[onclick^="cbSet("]) .chp{display:flex;flex-wrap:wrap;gap:8px;padding:0 24px!important}
#phone#phone .screen:has(button[onclick^="cbSet("]) .chp button{height:40px;padding:0 16px;border:0;border-radius:20px;background:var(--chip);color:var(--tx);font-size:15px;font-weight:600;letter-spacing:-.2px}
#phone#phone .screen:has(button[onclick^="cbSet("]) .chp button.on{background:var(--cta,#6258F5);color:var(--ctafg,#fff)}
#phone#phone .screen:has(button[onclick^="cbSet("]) .chp button:active{transform:scale(.96)}
#phone#phone .screen:has(button[onclick^="cbSet("]) .row{min-height:64px;gap:16px}
#phone#phone .screen:has(button[onclick^="cbSet("]) .row .t{font-size:16px;font-weight:600;letter-spacing:-.3px}
#phone#phone .screen:has(button[onclick^="cbSet("]) .row .s{font-size:13px;color:var(--tt)}
#phone#phone .screen:has(button[onclick^="cbSet("]) .row>b{font-size:16px;font-weight:700;letter-spacing:-.3px;color:var(--cta,#6258F5);font-variant-numeric:tabular-nums}
#phone#phone button.chip[onclick^="cpUse("]{height:36px;padding:0 16px;border-radius:12px;background:var(--tint);color:var(--tintfg);font-size:14px;font-weight:700;letter-spacing:-.2px}
#phone#phone button.chip[onclick^="cpUse("]:active{transform:scale(.96);background:color-mix(in srgb,var(--tintfg) 18%,var(--bg))}
</style>
<style id="v890fix">
/* v890: fixes found by rendering v889. (1) Cashback chips: an older !important rule kept them grey with no selected state and a grey band behind them. (2) Goal and Loan bars: my bar rule also matched the inner fill and pushed it out of view. (3) Pockets: the Parking map CSS (#phone .pkb, a 10px bar) was squashing the pocket balance on the detail page, in v885 too, so the balance was invisible; labels and balances in the list now read as grey label over dark bold balance. */
#phone#phone .screen:has(button[onclick^="cbSet("]) .chp{background:transparent!important;height:auto!important;padding:0 24px!important}
#phone#phone .screen:has(button[onclick^="cbSet("]) .chp button{background:var(--chip)!important;color:var(--tx)!important;font-weight:600!important}
#phone#phone .screen:has(button[onclick^="cbSet("]) .chp button.on{background:var(--cta,#6258F5)!important;color:var(--ctafg,#fff)!important}
#phone#phone .screen:has([onclick="goalDel()"]) div[style*="height:8px"]:has(>div),#phone#phone .screen:has([onclick="loanPay()"]) div[style*="height:8px"]:has(>div){height:10px!important;border-radius:5px!important;background:var(--chip)!important;margin-top:18px!important;overflow:hidden}
#phone#phone .screen:has([onclick="goalDel()"]) div[style*="height:8px"]>div,#phone#phone .screen:has([onclick="loanPay()"]) div[style*="height:8px"]>div{margin-top:0!important;height:10px!important;border-radius:5px!important;background:var(--cta,#6258F5)!important}
#phone#phone .pkh .pkb{height:auto!important;overflow:visible!important;background:none!important;margin-top:4px!important;border-radius:0!important;color:var(--tx);font-size:40px;line-height:48px;font-weight:800;letter-spacing:-1.4px}
#phone#phone .pkh .pkn{color:var(--mu);font-size:15px;font-weight:600;margin-top:12px}
#phone#phone .screen .pkrow .pkpn{font-size:14px!important;font-weight:500!important;letter-spacing:-.2px;color:var(--mu)!important}
#phone#phone .screen .pkrow .pkpb{font-size:18px!important;font-weight:700!important;letter-spacing:-.4px;color:var(--tx)!important;margin-top:2px}
#phone#phone button.pkf{margin:14px 0 4px 24px!important}
#phone#phone .screen .pkrow .pkpb .cu{font-size:14px;font-weight:600;color:var(--mu)}
</style>
<style id="v891toss">
/* v891: Toss-style pass 19, checked in a render. Daily challenge: the Go button sat inside the text column under the points, so rows looked broken; it is now a tinted 36px button on the right of a 72px row with the points in violet. Mini apps: Start buttons are the same tinted button. */
#phone#phone .screen:has(button[onclick^="dcGo("]) .row{min-height:72px;gap:16px}
#phone#phone .screen:has(button[onclick^="dcGo("]) .row>div[style*="flex:1"]{display:grid;grid-template-columns:minmax(0,1fr) auto;column-gap:12px;align-items:center}
#phone#phone .screen:has(button[onclick^="dcGo("]) .row .t{grid-column:1;font-size:17px;font-weight:600;letter-spacing:-.3px}
#phone#phone .screen:has(button[onclick^="dcGo("]) .row .s{grid-column:1;font-size:13px;font-weight:600;color:var(--cta,#6258F5)}
#phone#phone .screen:has(button[onclick^="dcGo("]) .row button.chip{grid-column:2;grid-row:1/3;margin:0!important;height:36px;padding:0 16px;border-radius:12px;background:var(--tint);color:var(--tintfg);font-size:14px;font-weight:700}
#phone#phone .screen:has(button[onclick^="dcGo("]) .row button.chip:active{transform:scale(.96);background:color-mix(in srgb,var(--tintfg) 18%,var(--bg))}
#phone#phone .screen:has(button[onclick^="dcGo("]) .h1{font-size:28px;letter-spacing:-.8px}
#phone#phone .ar button.go[onclick^="startApp("]{height:36px;padding:0 16px;border:0;border-radius:12px;background:var(--tint)!important;color:var(--tintfg)!important;font-size:14px;font-weight:700;letter-spacing:-.2px}
#phone#phone .ar button.go[onclick^="startApp("]:active{transform:scale(.96)}
</style>
<style id="v892toss">
/* v892: Toss-style pass 20, found by an audit of all 203 screens in a render. Text links such as "See all" were only 21-24px tall to tap (Toss keeps every target near 44px). The link looks the same but now has an invisible 44px hit area; the buttons that already had one are untouched. */
#phone#phone .screen a:not([class]){position:relative;z-index:1}
#phone#phone .screen a:not([class])::after{content:"";position:absolute;inset:-12px -12px}
</style>
<style id="v893toss">
/* v893: Toss-style pass 21, checked by walking a real order (add items, cart, pay, confirm, tracking: no errors, no NaN). Eats cart: the quantity stepper was two 48px grey squares that outweighed the item name; it is now a compact pair of 36px soft buttons with a bold count and the item name and price in Toss sizes. */
#phone#phone .screen button[aria-label="Remove one"],#phone#phone .screen button[aria-label="Add one"]{width:36px!important;height:36px!important;min-width:36px;border-radius:12px!important;background:var(--chip)!important}
#phone#phone .screen button[aria-label="Remove one"]:active,#phone#phone .screen button[aria-label="Add one"]:active{transform:scale(.92)}
#phone#phone .screen button[aria-label="Add one"]+b,#phone#phone .screen button[aria-label="Remove one"]+b{font-size:16px;font-weight:700;min-width:20px!important}
#phone#phone .screen div:has(>button[aria-label="Remove one"])>div[style*="flex:1"]{font-size:16px!important;font-weight:600!important;letter-spacing:-.3px}
#phone#phone .screen div:has(>button[aria-label="Remove one"])>div[style*="flex:1"] .sm{font-size:14px;color:var(--mu)}
</style>
<style id="v894toss">
/* v894: Toss-style pass 22. Settings cluster: Settings, Security, Profile, Language, Airtime. 17px names on 60px rows, grey 13px section labels, big soft field on Profile with a round avatar, violet selected check on Language, airtime amount chips as quiet pills. */
#phone#phone .screen:has(#pname) #pav{width:96px;height:96px;border-radius:48px;font-size:38px}
#phone#phone .screen:has(#pname) .in{height:56px;padding:0 16px;border:0;border-radius:16px;background:var(--chip);font-size:18px;font-weight:600;letter-spacing:-.3px}
#phone#phone .screen:has(#pname) .in:focus{outline:0;box-shadow:inset 0 0 0 2px var(--cta,#6258F5)}
#phone#phone .screen:has(#pname) .lab{font-size:13px;font-weight:600;color:var(--mu);margin-bottom:8px}
#phone#phone .screen:has(.stt) .ar,#phone#phone .screen:has(.stt) .row{min-height:60px}
#phone#phone .screen:has(.stt) .ar .t,#phone#phone .screen:has(.stt) .row .t{font-size:17px;font-weight:600;letter-spacing:-.3px}
#phone#phone .screen:has(.stt) .ar .s,#phone#phone .screen:has(.stt) .row .s{font-size:13px;color:var(--mu);font-weight:500}
#phone#phone .stt{font-size:26px;font-weight:800;letter-spacing:-.8px;line-height:34px}
#phone#phone .ck{width:28px;height:28px;border-radius:14px;border:0;background:var(--chip)}
#phone#phone .ck.on{background:var(--cta,#6258F5)}
#phone#phone .ck.on svg *{stroke:#fff!important}
#phone#phone .screen:has(.stt) .ar:active{background:color-mix(in srgb,var(--tx) 4%,transparent)}
#phone#phone .screen:has(#pname) .btn:disabled{background:var(--chip);color:var(--tt);opacity:1}
</style>
<style id="v895toss">
/* v895: Toss-style pass 23. Airtime, Kigali Maps search, Manage contacts, Delete account. Soft 60px phone field, pill network and amount choices with a solid violet selected one, 48px soft map search with quiet pill shortcuts, tinted Import button, plain bullets. */
#phone#phone #airph{height:60px;padding:0 16px;border:0;border-radius:16px;background:var(--chip);font-size:24px!important}
#phone#phone #airph:focus{outline:0;box-shadow:inset 0 0 0 2px var(--cta,#6258F5)}
#phone#phone .screen:has(#airph) .req button{height:40px;padding:0 16px;border:0;border-radius:20px;background:var(--chip);color:var(--tx);font-size:15px;font-weight:600}
#phone#phone .screen:has(#airph) .req button.on,#phone#phone .screen:has(#airph) .req button[aria-pressed="true"]{background:var(--cta,#6258F5);color:var(--ctafg,#fff)}
#phone#phone .screen:has(#airph) .req button:active{transform:scale(.96)}
#phone#phone .screen:has(#airph) .pad>div[style*="font-size:15px"]{font-size:13px!important;font-weight:600!important;color:var(--mu)}
#phone#phone .mps{height:48px;border:0;border-radius:14px;background:var(--chip)}
#phone#phone .screen:has(.mps) .chp{background:none;padding:12px 24px 0;gap:8px}
#phone#phone .screen:has(.mps) .chp button{height:36px;padding:0 14px;border:0;border-radius:18px;background:var(--chip);color:var(--tx);font-size:14px;font-weight:600}
#phone#phone .screen:has(.mps) .chp button.on{background:var(--tx);color:var(--bg)}
#phone#phone .pl{min-height:68px;border-radius:16px}
#phone#phone .pl b{font-size:16px;font-weight:600;letter-spacing:-.3px}
#phone#phone .pl:active{background:color-mix(in srgb,var(--tx) 5%,transparent)}
#phone#phone .screen:has(button[onclick^="impContacts"]) .hd .t{font-size:19px;font-weight:700;letter-spacing:-.4px}
#phone#phone .screen:has(button[onclick^="impContacts"]) .hd button{height:36px;padding:0 16px;border:0;border-radius:12px;background:var(--tint);color:var(--tintfg);font-size:14px;font-weight:700}
#phone#phone .screen:has(button[onclick^="impContacts"]) .hd button:active{transform:scale(.96)}
#phone#phone .screen:has(.bl) .ar .t{font-size:17px!important;font-weight:600;letter-spacing:-.3px}
#phone#phone .bl span{font-size:14px;line-height:21px;color:var(--mu)}
#phone#phone#phone .screen:has(#airph) .req button.on,#phone#phone#phone .screen:has(#airph) .req button[aria-pressed="true"]{background:var(--cta,#6258F5)!important;color:var(--ctafg,#fff)!important}
#phone#phone#phone .screen:has(.mps) .chp button.on{background:var(--tx)!important;color:var(--bg)!important}
</style>
<style id="v896toss">
/* v896: Toss-style pass 24. Add card, Top up, Add coupon, Pay settings, Coupons empty state. Soft 56px fields with a violet focus ring, 13px grey labels, quiet disabled buttons (grey, not pale violet), big top-up amount, white setting groups on the grey canvas, solid empty-state button. */
#phone#phone .acf label{font-size:13px;font-weight:600;color:var(--mu)}
#phone#phone .acf input,#phone#phone #cpin{height:56px;padding:0 16px;border:0;border-radius:16px;background:var(--chip);font-size:17px;font-weight:600;color:var(--tx)}
#phone#phone .acf input:focus,#phone#phone #cpin:focus{outline:0;box-shadow:inset 0 0 0 2px var(--cta,#6258F5)}
#phone#phone .acf input::placeholder,#phone#phone #cpin::placeholder{color:var(--tt);font-weight:500}
#phone#phone .screen:has(#cpin) .lab{color:var(--mu);font-size:13px;font-weight:600;margin-bottom:8px}
#phone#phone .acb,#phone#phone .acb:disabled{border:0;border-radius:16px;height:56px;font-size:17px;font-weight:700}
#phone#phone .acb:disabled,#phone#phone .screen:has(#cpgo) .btn:disabled,#phone#phone .screen:has(button[onclick="tpGo()"]) .btn:disabled{background:var(--chip)!important;color:var(--tt)!important;opacity:1}
#phone#phone .acp{border-radius:20px}

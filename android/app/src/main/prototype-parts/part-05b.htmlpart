<style id="v916toss">
/* v916: Toss-style pass 43. Spending: skeleton on first open, sliding month pill, rolling total, growing category bar you can tap, budget gauge that fills. */
#phone .sp16-seg{position:relative}
#phone .sp16-pill{position:absolute;top:6px;left:0;height:calc(100% - 12px);border-radius:999px;pointer-events:none;transition:transform .34s cubic-bezier(.3,.9,.3,1),width .34s cubic-bezier(.3,.9,.3,1)}
#phone#phone .sp16-seg button.on{background:transparent!important;box-shadow:none!important}
#phone#phone .sp16-stack{height:18px!important}
#phone .sp16-stack>div{position:relative;cursor:pointer;transform-origin:left center;transition:opacity .2s,transform .16s}
#phone .sp16-stack>div::before{content:"";position:absolute;inset:-12px 0}
#phone .sp16-stack>div:active{transform:scaleY(1.18)}
#phone .sp16-stack:not(.sp16go)>div{transform:scaleX(0)}
#phone .sp16-stack.sp16go>div{animation:sp16grow .72s cubic-bezier(.2,.9,.2,1) backwards;animation-delay:calc(var(--i)*70ms)}
@keyframes sp16grow{from{transform:scaleX(0)}to{transform:scaleX(1)}}
#phone .sp16-stack.has>div:not(.on){opacity:.25}
#phone .sp16-cap{display:flex;align-items:center;gap:8px;height:0;margin-top:0;opacity:0;overflow:hidden;font-size:14px;font-weight:700;color:var(--tx);transition:height .22s,margin .22s,opacity .22s}
#phone .sp16-cap.on{height:22px;margin-top:12px;opacity:1}
#phone .sp16-cap i{flex:none;width:10px;height:10px;border-radius:50%}
#phone .sp16-cap span{margin-left:auto;font-weight:600;color:var(--mu)}
#phone .sp16-row{transition:opacity .2s,background-color .2s,box-shadow .2s}
#phone .sp16-row>*{transition:opacity .2s}
#phone .sp16-has .sp16-row:not(.on)>*{opacity:.4}
#phone#phone .sp16-row.on{background:var(--chip,#F2F4F6)!important;border-radius:16px;box-shadow:-12px 0 0 var(--chip,#F2F4F6),12px 0 0 var(--chip,#F2F4F6)}
#phone .sp16-load .big,#phone .sp16-load .sp16-line,#phone .sp16-load .sp16-row .t,#phone .sp16-load .sp16-row b,#phone .sp16-load .sp16-row .sm span{color:transparent!important;width:fit-content;border-radius:8px;background:linear-gradient(90deg,var(--ln,#E5E8EB) 25%,var(--chip,#F2F4F6) 50%,var(--ln,#E5E8EB) 75%);background-size:220% 100%;animation:sp16sh 1s linear infinite}
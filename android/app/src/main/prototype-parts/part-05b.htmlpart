<style id="v912toss">
/* v912: Toss-style pass 39. Bank picker as a 2-column grid of tiles with the bank glyph; chosen tile is outlined in the brand colour. */
#phone .bkg12{display:grid!important;grid-template-columns:1fr 1fr;gap:10px!important}
#phone .bkg12>button{display:flex!important;align-items:center;gap:10px;height:64px;border-radius:18px!important;padding:0 16px!important;text-align:left;justify-content:flex-start;font-weight:700;transition:transform .14s,background-color .14s}
#phone .bkg12>button:active{transform:scale(.97)}
#phone#phone .bkg12>button.on{background:var(--tint,#EEEDFF)!important;box-shadow:inset 0 0 0 2px var(--br,#8F89FF)}
#phone .bkg12 svg{flex:0 0 28px}
</style>

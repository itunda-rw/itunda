const HB='<span class="fvb" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 21s-8-5.2-8-11a4.6 4.6 0 0 1 8-3 4.6 4.6 0 0 1 8 3c0 5.800-8 11-8 11z" fill="#fff"/></svg></span>';
const _y=screens.you,order=['bag','market','briefcase','house','restaurant'];
screens.you=function(){let h=_y.apply(this,arguments);if(typeof h!=='string')return h;
 const old='<div class="g">'+gl('heartred',32)+'</div>';let i=0;
 return h.split(old).reduce((a,part,k)=>k===0?part:a+'<div class="g fv">'+gl(order[Math.min(k-1,4)],32)+HB+'</div>'+part,'')};
}catch(e){console.error('v788-fav',e)}})();

document.title=document.title.replace(/v\d+/,'v788');
</script>
<script>
/* v796 itunda Front, Toss Front pass 4 (Toss Place / Toss Front research). (1) Front home: the assistive options become one small "Aa" button in the app bar (Toss kiosk keeps assistive functions in one place, out of the content) and the things you may want to resume (your table, order again) come before the promo strip, so the first screen answers "what do I do now" first. (2) Points by phone number: Toss Front's flow is phone number > short privacy line > pay. Turning points on now shows the number field with one plain line about how it is used; Pay waits until the number is complete or points are turned off. (3) Sold-out items leave "Start with these", sink to the bottom of the menu and are dimmed (Toss POS marks sold-out items instead of letting people add them). (4) The way you paid last time moves to the top of the pay list. (5) A short haptic tick on Add and on a finished payment (Toss uses haptics for confirmations). */
try{(()=>{
const FR=window.__FR;if(!FR||typeof screens==='undefined'||!screens.fronthome)return;
const tr=(a,b)=>S.lang==='fr'?b:a,vib=p=>{try{navigator.vibrate&&navigator.vibrate(p)}catch(x){}};
const digs=v=>String(v||'').replace(/\D/g,''),fmtPh=v=>{const d=digs(v).slice(0,10);return[d.slice(0,3),d.slice(3,6),d.slice(6)].filter(Boolean).join(' ')};
const phOk=()=>!FR.pt||digs(FR.ph).length===10;
FR.ph=FR.ph||'078 812 3214';
let baseDis=false;
const hint=ok=>ok?tr('Only used to add your points.','Utilisé seulement pour ajouter vos points.'):tr('Enter your 10 digit number, or turn points off.','Saisissez vos 10 chiffres, ou désactivez les points.');

/* 1. Front home */
const oh=screens.fronthome;
screens.fronthome=function(){let h=oh.apply(this,arguments);if(typeof h!=='string')return h;
h=h.replace(/<div style="padding:12px 24px 0"><button class="fta"[^>]*onclick="frAxO\(\)">[^<]*<\/button><\/div>/,'');
h=h.replace('Order, pay and go</div></div>','Order, pay and go</div></div><button class="ib" aria-label="'+tr('Accessibility','Accessibilité')+'" onclick="frAxO()" style="font-weight:800;font-size:17px;color:var(--tx)">Aa</button>');
const grab=re=>{const m=h.match(re);if(!m)return'';h=h.replace(m[0],'');return m[0]};
const live=grab(/<div class="tap" onclick="frResume\(\)".*?<\/div><\/div>/s),again=grab(/<div class="tap" onclick="frAgain\(\)".*?›<\/div>/s);
const k=h.indexOf('<div class="fts"');if(k>=0&&(live||again))h=h.slice(0,k)+live+again+h.slice(k);
return h};

/* 2 + 4. Pay: points by phone number, last used way first */
const op=screens.frontpay;
screens.frontpay=function(){let h=op.apply(this,arguments);if(typeof h!=='string')return h;
baseDis=/<button class="btn" disabled/.test(h);
const a=h.indexOf('<div class="tap frck'),z=h.lastIndexOf('</svg></div>');
if(a>=0&&z>a){const rows=h.slice(a,z+12).split(/(?=<div class="tap frck)/),i=rows.findIndex(r=>/Last used/.test(r));
if(i>0){const r=rows.splice(i,1)[0];rows.unshift(r);h=h.slice(0,a)+rows.join('')+h.slice(z+12)}}
if(FR.pt){const ok=digs(FR.ph).length===10;
const row=`<div style="margin:8px 24px 0;padding:14px 16px;border-radius:20px;background:var(--chip)"><label class="mu" for="frph" style="font-size:13px;display:block">${tr('Phone number for points','Numéro pour les points')}</label><input id="frph" type="tel" inputmode="numeric" autocomplete="tel" maxlength="12" value="${FR.ph}" placeholder="078 123 4567" aria-describedby="frphh" oninput="frPh(this)" style="width:100%;box-sizing:border-box;height:44px;border:0;background:none;padding:0;font:inherit;font-size:22px;font-weight:800;letter-spacing:.3px;color:var(--tx);border-radius:10px;outline-offset:2px"><div id="frphh" class="mu" aria-live="polite" style="font-size:13px;color:${ok?'var(--mu)':'var(--er)'}">${hint(ok)}</div></div>`;
h=h.replace(/(<b>Collect points<\/b>.*?<\/button><\/div>)/s,'$1'+row);
if(!ok)h=h.replace('onclick="frPay()"','disabled onclick="frPay()"')}
return h};
window.frPh=el=>{const v=fmtPh(el.value);el.value=v;FR.ph=v;const ok=digs(v).length===10,hn=document.getElementById('frphh');
if(hn){hn.textContent=hint(ok);hn.style.color=ok?'var(--mu)':'var(--er)'}
const b=document.querySelector('.cta .btn');if(b)b.disabled=baseDis||!ok};
const opy=window.frPay;
window.frPay=function(){if(!phOk()){toast(tr('Enter your phone number or turn points off','Saisissez votre numéro ou désactivez les points'));return}
const r=opy.apply(this,arguments);if(S.stack&&S.stack[S.stack.length-1]==='frontdone')vib([12,50,12]);return r};

/* 3. Menu: sold-out items */
const om=screens.frontmenu;
screens.frontmenu=function(){let h=om.apply(this,arguments);if(typeof h!=='string')return h;
h=h.replace(/<div class="fpk">(?:(?!<\/div>).)*Sold out(?:(?!<\/div>).)*<\/div>/gs,'');
const T='<div style="height:110px"></div>',M='<div style="display:flex;align-items:center;gap:14px;padding:12px 24px">',ti=h.indexOf(T);
if(ti>0){const parts=h.slice(0,ti).split(M);if(parts.length>2){const head=parts.shift(),ok=parts.filter(r=>!/Sold out/.test(r)),so=parts.filter(r=>/Sold out/.test(r));
if(so.length)h=head+ok.map(r=>M+r).join('')+so.map(r=>M.replace('padding:12px 24px','padding:12px 24px;opacity:.5')+r).join('')+h.slice(ti)}}
return h};

/* 5. haptic tick on Add */
const oq=window.frQ;window.frQ=function(i,d){if(d>0)vib(8);return oq.apply(this,arguments)};
try{document.title=document.title.replace(/v\d+/,'v796')}catch(x){}
})()}catch(x){console.error('v796',x)}
</script>
<script>
/* v797 itunda Front, Toss Front pass 5. The done screen now says what happens next, live: a three step bar (Order received > Cooking now > Ready / On its way, demo timing) inside the number tile, the way Toss shows order progress once you have paid, so you do not have to ask the counter. When the bill was split, one "Share pay link" button gives friends a link to pay their share (it was only a sentence before). */
try{(()=>{
const FR=window.__FR;if(!FR||typeof screens==='undefined'||!screens.frontdone)return;
const fr=()=>S.lang==='fr';
const L=h=>fr()?['Commande reçue','En cuisine',h?'En route':'Prête à retirer']:['Order received','Cooking now',h?'On its way':'Ready for pickup'];
const stage=()=>{const t=(Date.now()-(FR.dk||Date.now()))/1000;return t<6?0:t<14?1:2};
const paint=()=>{const el=document.getElementById('frdst');if(!el)return;const k=stage(),h=FR.m==='here';
el.querySelectorAll('i').forEach((b,i)=>b.style.background=i<=k?'var(--lk)':'var(--ln)');
const l=el.querySelector('b');if(l)l.textContent=L(h)[k]};
const od=screens.frontdone;
screens.frontdone=function(){let h=od.apply(this,arguments);if(typeof h!=='string')return h;
if(FR.dn!==FR.pn){FR.dn=FR.pn;FR.dk=Date.now()}
const i=h.indexOf('class="ftn"'),j=i<0?-1:h.indexOf('</span></div>',i);if(j<0)return h;
const here=FR.m==='here',k=stage();
let add=`<div id="frdst" style="margin-top:14px;text-align:left" role="status" aria-live="polite"><div style="display:flex;gap:6px">${[0,1,2].map(n=>`<i style="flex:1;height:4px;border-radius:2px;background:${n<=k?'var(--lk)':'var(--ln)'}"></i>`).join('')}</div><b style="display:block;font-size:15px;line-height:22px;margin-top:8px;letter-spacing:0">${L(here)[k]}</b></div>`;
if(here&&FR.sp)add+=`<button class="fta" style="margin-top:12px;background:var(--bg);color:var(--tx);height:44px" onclick="frShare()">${fr()?'Partager le lien de paiement':'Share pay link'}</button>`;
return h.slice(0,j+7)+add+h.slice(j+7)};
window.frShare=()=>{const u='https://itunda.rw/pay/'+encodeURIComponent((FR.p||'table').replace(/\s+/g,'-').toLowerCase())+'-t'+FR.t;
try{navigator.clipboard&&navigator.clipboard.writeText(u)}catch(x){}toast(fr()?'Lien copié':'Link copied')};
setInterval(paint,1000);
try{document.title=document.title.replace(/v\d+/,'v797')}catch(x){}
})()}catch(x){console.error('v797',x)}
</script>
<script>
/* v798 itunda Front, Toss Front pass 6 (Toss Order table order research). (1) Item detail: tap a menu row to open the item (big picture, short description, one option such as spice, how many, one Add button), as Toss table order has a menu detail screen before "add to cart". The option goes to the kitchen note. (2) Order together: Toss table order lets several people scan the same table code, each add their own items and watch one shared list. Eat-here menus get an "Order together" button (copy table link, or try it with a demo friend); friend items show in the order sheet with who added them. */
try{(()=>{
const FR=window.__FR;if(!FR||typeof screens==='undefined'||!screens.frontmenu)return;
const fr=()=>S.lang==='fr',tr=(a,b)=>fr()?b:a,vib=p=>{try{navigator.vibrate&&navigator.vibrate(p)}catch(x){}};
const num=s=>+String(s).replace(/\D/g,'')||0;
window.FRI=window.FRI||{};
const OPT=n=>/chick|brochet|goat|beef|skewer|grill/i.test(n)?[tr('Spice','Piment'),[tr('Mild','Doux'),tr('Medium','Moyen'),tr('Hot','Fort')]]:/coffee|macchiato|cappuccino|latte|espresso|\btea\b/i.test(n)?[tr('Serve','Service'),[tr('Hot','Chaud'),tr('Iced','Glacé')]]:/soda|juice|water|drink/i.test(n)?[tr('Serve','Service'),[tr('Cold','Frais'),tr('Room temperature','Ambiante')]]:null;
const layer=h=>{document.getElementById('layer').innerHTML=h};
const nFr=()=>Object.keys(FR.fl||{}).reduce((a,k)=>a+FR.fl[k],0);

/* menu: tappable rows, Order together */
const om=screens.frontmenu;
screens.frontmenu=function(){let h=om.apply(this,arguments);if(typeof h!=='string')return h;
window.FRI={};
const T='<div style="height:110px"></div>',ti=h.indexOf(T),R='<div style="display:flex;align-items:center;gap:14px;padding:12px 24px';
if(ti>0){const parts=h.slice(0,ti).split(R);if(parts.length>1){const head=parts.shift();
h=head+parts.map(p=>{const m=p.match(/frQ\((\d+),/);if(!m)return R+p;const i=m[1];
window.FRI[i]={n:(p.match(/display:block">([^<]*)</)||[])[1]||'',d:(p.match(/class="mu" style="font-size:14px">([^<]*)</)||[])[1]||'',p:num((p.match(/font-weight:700">([\d,]+) RWF/)||[])[1]),a:(p.match(/aria-hidden="true">([^<]*)</)||[])[1]||''};
return '<div class="tap" role="button" tabindex="0" onclick="if(event.target.closest(\'button\'))return;frItem('+i+')" style="display:flex;align-items:center;gap:14px;padding:12px 24px'+p}).join('')+h.slice(ti)}}
if(FR.m==='here'){const n=nFr(),chip=FR.tg?`<div class="mu" style="font-size:14px;margin-top:8px">Eric M. ${tr('is at your table','est à votre table')}${n?' · '+tr('added '+n+' item'+(n>1?'s':''),'a ajouté '+n+' article'+(n>1?'s':'')):''}</div>`:'';
h=h.replace(/(🔔 [^<]*<\/button>)/,'$1<button class="fta" style="background:var(--chip);color:var(--tx);height:44px;margin-left:8px" onclick="frTog()">'+tr('Order together','Commander ensemble')+'</button>'+chip)}
return h};

/* item detail */
const draw=()=>{const s=FR.it,d=window.FRI[s.i];if(!d)return;const o=OPT(d.n);
layer(`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" role="dialog" aria-label="${d.n}"><div style="height:150px;border-radius:20px;background:var(--chip);display:grid;place-items:center;font-size:76px" aria-hidden="true">${d.a||'🍽️'}</div><b style="display:block;font-size:24px;letter-spacing:-.4px;margin-top:14px">${d.n}</b>${d.d?`<div class="mu" style="font-size:15px;line-height:22px;margin-top:2px">${d.d}</div>`:''}<div style="font-weight:800;font-size:18px;margin-top:8px">${fmt(d.p)} RWF</div>${o?`<div class="mu" style="font-size:14px;font-weight:700;margin:16px 0 8px">${o[0]}</div><div class="fseg" role="group">${o[1].map((x,k)=>`<button class="${(s.o||0)===k?'on':''}" aria-pressed="${(s.o||0)===k}" onclick="frItemO(${k})">${x}</button>`).join('')}</div>`:''}<div style="display:flex;align-items:center;justify-content:space-between;margin:16px 0 14px"><b>${tr('How many','Combien')}</b><span class="ftq"><button aria-label="${tr('Fewer','Moins')}" onclick="frItemQ(-1)">−</button><b>${s.q}</b><button aria-label="${tr('More','Plus')}" onclick="frItemQ(1)">+</button></span></div><button class="btn" onclick="frItemAdd()">${tr('Add','Ajouter')} · ${fmt(d.p*s.q)} RWF</button></div>`)};
window.frItem=i=>{FR.it={i:String(i),q:1,o:0};draw()};
window.frItemQ=d=>{FR.it.q=Math.max(1,Math.min(9,FR.it.q+d));draw()};
window.frItemO=k=>{FR.it.o=k;draw()};
window.frItemAdd=()=>{const s=FR.it,d=window.FRI[s.i];if(!d)return;const o=OPT(d.n);
FR.c[s.i]=(FR.c[s.i]||0)+s.q;
if(o){const t=d.n+': '+o[1][s.o||0];FR.nt=FR.nt?(FR.nt.indexOf(t)>=0?FR.nt:FR.nt+'; '+t):t}
vib(8);closeSheet();render('fade-none')};

/* order together */
window.frTog=()=>{const on=FR.tg;
layer(`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" role="dialog" aria-label="${tr('Order together','Commander ensemble')}"><b style="font-size:22px;letter-spacing:-.4px">${tr('Order together','Commander ensemble')}</b><div class="mu" style="font-size:15px;line-height:22px;margin:6px 0 16px">${on?tr('Eric M. is at your table. Everything you both add shows in one list.','Eric M. est à votre table. Tout ce que vous ajoutez apparaît dans une seule liste.'):tr('Friends scan the same table code. Everyone adds their own items and you all see one list.','Vos amis scannent le même code de table. Chacun ajoute ses articles et vous voyez tous une seule liste.')}</div>${on?`<button class="btn" onclick="closeSheet()">${tr('Done','Terminé')}</button>`:`<button class="btn" onclick="frTogStart()">${tr('Try with a friend','Essayer avec un ami')}</button><button class="btn sec2" style="margin-top:8px" onclick="frTogCopy()">${tr('Copy table link','Copier le lien de la table')}</button>`}</div>`)};
window.frTogCopy=()=>{try{navigator.clipboard&&navigator.clipboard.writeText('https://itunda.rw/t/'+FR.t)}catch(x){}toast(tr('Link copied','Lien copié'))};
window.frTogStart=()=>{FR.tg=1;FR.fl={};closeSheet();toast(tr('Eric M. joined your table','Eric M. a rejoint votre table'));render('fade-none');
setTimeout(()=>{if(!FR.tg)return;const I=window.FRI||{},ids=Object.keys(I).sort((a,b)=>I[a].p-I[b].p);if(!ids.length)return;const i=ids[0];
FR.c[i]=(FR.c[i]||0)+1;FR.fl=FR.fl||{};FR.fl[i]=(FR.fl[i]||0)+1;toast('Eric M. '+tr('added','a ajouté')+' '+I[i].n);
if(S.stack&&S.stack[S.stack.length-1]==='frontmenu'&&!document.querySelector('#layer .sheet'))render('fade-none')},3000)};
const lab=()=>{const s=document.querySelector('#layer .sheet');if(!s||!FR.fl)return;
s.querySelectorAll('button[onclick^="frQ("]').forEach(b=>{const k=(b.getAttribute('onclick').match(/frQ\((\d+)/)||[])[1];if(k==null||!FR.fl[k])return;
const row=b.closest('div[style*="padding:10px 0"]');if(!row||row.querySelector('.frfl'))return;const c=row.querySelector('div[style*="flex:1"]');
if(c)c.insertAdjacentHTML('beforeend','<div class="frfl mu" style="font-size:13px">Eric M. '+tr('added','a ajouté')+' '+FR.fl[k]+'</div>')})};
['frCart','frQ','frM2'].forEach(n=>{const o=window[n];if(typeof o!=='function')return;window[n]=function(){const r=o.apply(this,arguments);lab();return r}});
const os=window.frSend;window.frSend=function(){const r=os.apply(this,arguments);FR.fl={};return r};
const oo=window.frOpen;window.frOpen=function(){FR.tg=0;FR.fl={};return oo.apply(this,arguments)};
try{document.title=document.title.replace(/v\d+/,'v798')}catch(x){}
})()}catch(x){console.error('v798',x)}
</script>
<script>
/* v799 itunda Front, Toss Front pass 7 (Toss Place points, stamps and coupons research). Toss Front takes the phone number, shows what you can use, and lets coupons and points stack before you pick how to pay; a first-time points sign-up with consent earns a welcome coupon. Now: (1) Pay shows "Use points" (your balance, switch) and, when you have one, the welcome coupon (10% off, switch, applied by default); the amount to pay, the button and the points you earn all follow, with one plain line showing how the total was made. (2) First time at a restaurant, under the phone number: one switch "Welcome coupon" (consent to offers); turning it on earns the coupon after paying. (3) The done screen says how many points you used and shows the new coupon with its 30 day validity. Sample balance 1,200 points, 1 point = 1 RWF. */
try{(()=>{
const FR=window.__FR;if(!FR||typeof screens==='undefined'||!screens.frontpay)return;
const tr=(a,b)=>S.lang==='fr'?b:a,num=s=>+String(s).replace(/\D/g,'')||0,dg=v=>String(v||'').replace(/\D/g,'');
window.FRC=window.FRC||{};window.FRG=window.FRG||{};window.FRB=window.FRB==null?1200:window.FRB;
const phv=()=>!!FR.pt&&dg(FR.ph).length===10;
const disc=a=>{let c=0,u=0;if(phv()){if(window.FRC[FR.p]&&FR.cp!==0)c=Math.round(a*.1);if(FR.up)u=Math.min(window.FRB,a-c)}return{c:c,u:u,t:c+u}};
const sw=(t,s,on,f)=>`<div style="display:flex;align-items:center;gap:12px;margin:8px 24px 0;padding:14px 16px;border-radius:20px;background:var(--chip)"><div style="flex:1"><b>${t}</b><div class="mu" style="font-size:14px">${s}</div></div><button class="ftsw" role="switch" aria-checked="${!!on}" aria-label="${t}" onclick="${f}"></button></div>`;
const rr=()=>render('fade-none');
const op=screens.frontpay;
screens.frontpay=function(){let h=op.apply(this,arguments);if(typeof h!=='string')return h;
const m=h.match(/Pay (\d[\d,]*) RWF<\/button>/);if(!m)return h;const a=num(m[1]);FR.pa=a;
const D=disc(a),na=a-D.t,had=!!window.FRC[FR.p];
if(D.t)h=h.split(fmt(a)+' RWF').join(fmt(na)+' RWF');
h=h.replace(/You earn (\d+) points on this order/,'You earn '+Math.floor(na/100)+' points on this order');
if(phv()&&!had&&!window.FRG[FR.p])h=h.replace(/(id="frphh"[^>]*>[^<]*<\/div><\/div>)/,'$1'+sw(tr('Welcome coupon','Coupon de bienvenue'),tr('10% off your next order here. We may text you offers.','10 % sur votre prochaine commande ici. Nous pouvons vous envoyer des offres par SMS.'),FR.mk,'frMk()'));
let rows='';
if(D.t)rows+=`<div class="mu" style="padding:0 24px;font-size:14px">${fmt(a)} RWF${D.c?' − '+fmt(D.c)+' '+tr('coupon','coupon'):''}${D.u?' − '+fmt(D.u)+' '+tr('points','points'):''}</div>`;
if(phv()){
if(had)rows+=sw(tr('Welcome coupon','Coupon de bienvenue'),tr('10% off','10 % de réduction')+(FR.cp!==0?' · −'+fmt(Math.round(a*.1))+' RWF':''),FR.cp!==0,'frCp()');
if(window.FRB>0)rows+=sw(tr('Use points','Utiliser les points'),tr('You have ','Vous avez ')+fmt(window.FRB)+' '+tr('points','points')+(FR.up&&D.u?' · −'+fmt(D.u)+' RWF':''),FR.up,'frUp()')}
h=h.replace('<div class="agt">Pay with</div>',rows+'<div class="agt">Pay with</div>');
const low=FR.pm==='pay'&&S.pay<na,bad=!!FR.pt&&!phv();
h=h.replace(/<div class="pad" style="color:var\(--er\);font-size:14px">Not enough in itunda Pay[^<]*<\/div>/,'');
if(low)h=h.replace('<div style="height:110px"></div>','<div class="pad" style="color:var(--er);font-size:14px">Not enough in itunda Pay. Pick another way to pay.</div><div style="height:110px"></div>');
h=h.replace(/<button class="btn"[^>]*onclick="frPay\(\)">/,'<button class="btn" '+(low||bad?'disabled':'')+' onclick="frPay()">');
return h};
window.frUp=()=>{FR.up=FR.up?0:1;rr()};window.frCp=()=>{FR.cp=FR.cp===0?1:0;rr()};window.frMk=()=>{FR.mk=FR.mk?0:1;rr()};
/* typing the last digit brings the points rows in */
const oph=window.frPh;if(typeof oph==='function')window.frPh=function(el){const was=dg(FR.ph).length===10;const r=oph.apply(this,arguments);const now=dg(FR.ph).length===10;
if(was!==now){rr();const i=document.getElementById('frph');if(i){i.focus();try{i.setSelectionRange(i.value.length,i.value.length)}catch(x){}}}return r};
/* pay */
const opy=window.frPay;
window.frPay=function(){const a=FR.pa||0,D=disc(a),had=!!window.FRC[FR.p],bump=FR.pm==='pay'?D.t:0;
S.pay+=bump;const r=opy.apply(this,arguments);
if(!(S.stack&&S.stack[S.stack.length-1]==='frontdone')){S.pay-=bump;return r}
if(D.t)FR.amt=a-D.t;
FR.newcp=0;FR.du=D.u;FR.dc=D.c;
if(phv()){window.FRB=Math.max(0,window.FRB-D.u)+Math.floor(FR.amt/100);
if(D.c)delete window.FRC[FR.p];
if(FR.mk&&!had&&!window.FRG[FR.p]){window.FRC[FR.p]=true;window.FRG[FR.p]=1;FR.newcp=1}}
if(D.t||FR.newcp)rr();return r};
/* done */
const od=screens.frontdone;
screens.frontdone=function(){let h=od.apply(this,arguments);if(typeof h!=='string')return h;
if(FR.du)h=h.replace(/(Paid with [^<]*<\/div>)/,'$1<div class="mu" style="font-size:14px;margin-top:2px">'+tr('Used ','Utilisé : ')+fmt(FR.du)+' '+tr('points','points')+'</div>');
if(FR.newcp){const c=`<div style="display:flex;gap:12px;align-items:center;margin:16px 24px 0;padding:14px 16px;border-radius:20px;background:var(--tint);text-align:left"><span style="font-size:26px" aria-hidden="true">🎟️</span><div><b>${tr('Welcome coupon','Coupon de bienvenue')}</b><div class="mu" style="font-size:14px">${tr('10% off your next order at '+FR.p+'. Valid for 30 days.','10 % sur votre prochaine commande chez '+FR.p+'. Valable 30 jours.')}</div></div></div>`;
const k=h.indexOf('<div class="agt" style="text-align:center">');if(k>=0)h=h.slice(0,k)+c+h.slice(k)}
return h};
const oo=window.frOpen;window.frOpen=function(){FR.up=0;delete FR.cp;FR.mk=0;FR.newcp=0;FR.du=0;return oo.apply(this,arguments)};
try{document.title=document.title.replace(/v\d+/,'v799')}catch(x){}
})()}catch(x){console.error('v799',x)}
</script>
<script>
/* v800 itunda Front, Toss Front pass 8 (Toss Order pickup research). Toss Order pickup: you choose when you will collect (now, 5, 10, 15 min), the order number is the last 4 digits of your phone, the shop has 5 minutes to accept, you can cancel until it does, then it asks you to come and you can say you have arrived. Now: (1) Take away Pay asks "When will you pick it up?" (Now / 5 / 10 / 15 / 20 min). (2) Done: with points on, your number is the last 4 digits of your phone; the status reads Waiting for the shop to accept > Accepted, cooking > Ready, come pick it up; "Cancel order" is there only while waiting and gives your money, points and coupon back; "I am here" appears when it is ready. (3) The Front list shows the nearest places first. (4) Fix: after Done, the home no longer shows the finished order as "Your table". */
try{(()=>{
const FR=window.__FR;if(!FR||typeof screens==='undefined'||!screens.frontdone)return;
const tr=(a,b)=>S.lang==='fr'?b:a,dg=v=>String(v||'').replace(/\D/g,''),phv=()=>!!FR.pt&&dg(FR.ph).length===10,rr=()=>render('fade-none');
const stage=()=>{const t=(Date.now()-(FR.dk||Date.now()))/1000;return t<3?0:t<12?1:2};
const LB=()=>[tr('Waiting for '+FR.p+' to accept','En attente de '+FR.p),tr('Accepted · cooking now','Acceptée · en cuisine'),tr('Ready. Come pick it up','Prête. Venez la retirer')];
const no=()=>phv()?dg(FR.ph).slice(-4):'Q-'+FR.no;

/* 1. pickup time */
const op=screens.frontpay;
screens.frontpay=function(){let h=op.apply(this,arguments);if(typeof h!=='string'||FR.m==='here')return h;
const seg=`<div class="agt">${tr('When will you pick it up?','Quand viendrez-vous la retirer ?')}</div><div style="padding:6px 24px 0"><div class="fseg" role="group">${[0,5,10,15,20].map(v=>`<button class="${FR.pk===v?'on':''}" aria-pressed="${FR.pk===v}" onclick="frPk(${v})">${v?v+' min':tr('Now','Tout de suite')}</button>`).join('')}</div></div>`;
return h.replace('<div class="agt">Pay with</div>',seg+'<div class="agt">Pay with</div>')};
window.frPk=v=>{FR.pk=v;rr()};

/* 2. done: number, acceptance, cancel, I am here */
const od=screens.frontdone;
screens.frontdone=function(){let h=od.apply(this,arguments);if(typeof h!=='string'||FR.m==='here')return h;
h=h.replace('Q-'+FR.no,no());
const k=stage();
const blk=`<div id="frtg" style="margin-top:14px;text-align:left" role="status" aria-live="polite"><div style="display:flex;gap:6px">${[0,1,2].map(n=>`<i style="flex:1;height:4px;border-radius:2px;background:${n<=k?'var(--lk)':'var(--ln)'}"></i>`).join('')}</div><b id="frtgl" style="display:block;font-size:15px;line-height:22px;margin-top:8px;letter-spacing:0">${LB()[k]}</b><div class="mu" style="font-size:14px;margin-top:2px">${tr('Pickup: ','Retrait : ')}${FR.pk?tr('in '+FR.pk+' min','dans '+FR.pk+' min'):tr('now','tout de suite')}${phv()?' · '+tr('your number is the last 4 digits of your phone','votre numéro est la fin de votre téléphone'):''}</div><button id="frtgc" class="fta" style="margin-top:12px;background:var(--bg);color:var(--tx);height:44px;${k===0?'':'display:none'}" onclick="frCancel()">${tr('Cancel order','Annuler la commande')}</button><button id="frtgh" class="fta" style="margin-top:12px;background:var(--bg);color:var(--tx);height:44px;${k===2?'':'display:none'}" onclick="frHere()">${tr('I am here','Je suis là')}</button></div>`;
const re=/<div id="frdst".*?<\/b><\/div>/s;
return re.test(h)?h.replace(re,blk):h};
const paint=()=>{const el=document.getElementById('frtg');if(!el)return;const k=stage();
el.querySelectorAll('i').forEach((b,i)=>b.style.background=i<=k?'var(--lk)':'var(--ln)');
const l=document.getElementById('frtgl');if(l)l.textContent=LB()[k];
const c=document.getElementById('frtgc'),g=document.getElementById('frtgh');if(c)c.style.display=k===0?'':'none';if(g)g.style.display=k===2?'':'none'};
setInterval(paint,1000);
window.frCancel=()=>{if(FR.pm==='pay')S.pay+=FR.amt;
const earned=phv()?Math.floor(FR.amt/100):0;window.FRB=Math.max(0,(window.FRB||0)+(FR.du||0)-earned);
if(FR.dc)window.FRC[FR.p]=true;if(FR.newcp){delete window.FRC[FR.p];delete window.FRG[FR.p]}
FR.s={};FR.c={};S.stack=['fronthome'];render('fade');
toast(tr('Order cancelled. Your money is back.','Commande annulée. Vous êtes remboursé.'))};
window.frHere=()=>toast(tr('Great. Show '+no()+' at the counter.','Parfait. Montrez '+no()+' au comptoir.'));

/* 3. nearest first */
const oh=screens.fronthome;
screens.fronthome=function(){let h=oh.apply(this,arguments);if(typeof h!=='string')return h;
const a=h.search(/<div class="agt"[^>]*>(Eat here|Take away) near you<\/div>/);if(a<0)return h;
const e1=h.indexOf('</div>',a)+6,z=h.lastIndexOf('<div style="height:24px"></div>');if(z<e1)return h;
const M='<div class="tap" onclick="frOpen(',parts=h.slice(e1,z).split(M);if(parts.length<3)return h;
const head=parts.shift(),km=p=>{const m=p.match(/([\d.]+) km/);return m?+m[1]:1e9};
parts.sort((x,y)=>km(x)-km(y));
return h.slice(0,e1)+head+parts.map(p=>M+p).join('')+h.slice(z)};

/* 4. finished order is not a live table */
const odn=window.frDone;window.frDone=function(){FR.s={};FR.c={};return odn.apply(this,arguments)};
const oo=window.frOpen;window.frOpen=function(){FR.pk=10;return oo.apply(this,arguments)};
try{document.title=document.title.replace(/v\d+/,'v800')}catch(x){}
})()}catch(x){console.error('v800',x)}
</script>
<script>(function(){try{var D={"Picks for you": "Nos suggestions", "All menu": "Tout le menu", "Add": "Ajouter", "Most ordered": "Le plus commandé", "Owner’s pick": "Choix du patron", "New": "Nouveau", "Order, pay and go": "Commandez, payez, c’est parti", "Lunch deal": "Offre du midi", "Skip the queue": "Évitez la file", "How would you like your order?": "Comment souhaitez-vous votre commande ?", "Take away": "À emporter", "We bring it to your table": "Nous l’apportons à votre table", "Pick up at the counter": "À récupérer au comptoir", "Voice guide": "Guide vocal", "Reads each step aloud": "Lit chaque étape à voix haute", "Your order": "Votre commande", "Total": "Total", "Send to kitchen": "Envoyer en cuisine", "Pay with": "Payer avec", "Collect points": "Cumuler des points", "Receipt": "Reçu", "In my app": "Dans mon app", "Print": "Imprimer", "No receipt": "Sans reçu", "Your table": "Votre table", "Your order number": "Numéro de commande", "We will bring it to you.": "Nous vous l’apportons.", "To pay": "À payer", "Your share": "Votre part", "No tip": "Sans pourboire", "Pay all": "Tout payer", "Scan the table code": "Scannez le code de la table"};var P=[[/^View order · (\d+) · (.+)$/,'Voir la commande · $1 · $2'],[/^Pay (.+ RWF)$/,'Payer $1'],[/^Pay · (.+)$/,'Payer · $1'],[/^Take away · (.+)$/,'À emporter · $1'],[/^You earn (\d+) points on this order$/,'Vous gagnez $1 points'],[/^(.+) RWF paid$/,'$1 RWF payés'],[/^We will call “(.+)” when it is ready\.$/,'Nous appellerons « $1 » quand ce sera prêt.']];function tx(t){var m=t.match(/^(\s*)([\s\S]*?)(\s*)$/),c=m[2];if(!c)return t;if(D.hasOwnProperty(c))return m[1]+D[c]+m[3];for(var i=0;i<P.length;i++)if(P[i][0].test(c))return m[1]+c.replace(P[i][0],P[i][1])+m[3];return t}Object.keys(screens).forEach(function(k){if(!/^front/.test(k)||typeof screens[k]!=='function')return;var o=screens[k];screens[k]=function(){var h=o.apply(this,arguments);try{if(S.lang!=='fr'||typeof h!=='string')return h;return h.replace(/>([^<>]+)</g,function(m,t){return '>'+tx(t)+'<'})}catch(e){return h}}})}catch(e){console.error('v790',e)}})()</script><style id="v801">
.frst{margin:16px 24px 0;padding:16px;border-radius:20px;background:var(--chip);text-align:left}
.frstt{display:flex;justify-content:space-between;align-items:baseline;gap:12px}
.frstt b{font-size:16px;line-height:22px}
.frstt span{font-size:14px;color:var(--mu);font-variant-numeric:tabular-nums;white-space:nowrap}
.frstd{display:flex;gap:8px;margin-top:12px}
.frstd i{flex:1;max-width:34px;aspect-ratio:1;border-radius:50%;border:2px dashed var(--tt);box-sizing:border-box;display:flex;align-items:center;justify-content:center;font-style:normal;font-size:14px;line-height:1}
.frstd i.on{background:var(--lk);border:0}
.frstd i.gift{opacity:.7}
.frstm{font-size:14px;line-height:20px;color:var(--mu);margin-top:10px}
.frstm.ok{color:var(--ok);font-weight:700}
.frpt{margin:8px 24px 0;padding:14px 16px;border-radius:20px;background:var(--chip);display:flex;align-items:center;gap:12px}
.frpt .m{flex:1;min-width:0}
.frpt .m small{display:block;font-size:13px;line-height:18px;color:var(--mu)}
.frpt .m b{display:block;font-size:19px;line-height:26px;letter-spacing:.2px;font-variant-numeric:tabular-nums}
.frpt button{border:0;height:40px;padding:0 14px;border-radius:12px;background:var(--bg);color:var(--tx);font:inherit;font-size:14px;font-weight:700;flex-shrink:0}
.frpt button:focus-visible{outline:2px solid var(--lk);outline-offset:2px}
@keyframes v801pop{0%{transform:scale(.4);opacity:0}60%{transform:scale(1.15);opacity:1}100%{transform:scale(1);opacity:1}}
.frstd i.new{animation:v801pop .45s cubic-bezier(.2,.8,.2,1) .25s both}
@media (prefers-reduced-motion:reduce){.frstd i.new{animation:none}}
</style>
<script>
/* v801 itunda Front, Toss Front pass 9 (Toss Place "earn later", stamps and regulars research). Toss Front added "earn later in the Toss app" because typing a phone number at the counter was a hassle, and Toss Place runs stamp cards that bring regulars back. itunda already knows who is paying, so: (1) Points and stamps go to your itunda account with no typing; the number shows as one line with a Change button, and the field only opens when you tap it. (2) Stamp card on the done screen (cafes and restaurants): 1 stamp per order, 8 stamps earn a free item; the new stamp pops in once; cancelling a take-away order takes the stamp back. (3) Fix: the rating stars were almost invisible (pale tint on white); they now show as clear empty stars until chosen. */
try{(()=>{
const FR=window.__FR;if(!FR||typeof screens==='undefined'||!screens.frontdone||!screens.frontpay)return;
const tr=(a,b)=>S.lang==='fr'?b:a,digs=v=>String(v||'').replace(/\D/g,''),rr=()=>render('fade-none');
const NEED=8,DEF='078 812 3214';
window.FRS=window.FRS||{'Kigali Roast':4,'Nyamirambo Coffee House':7,'Sweet Tooth Cakes':2};
const poi=()=>{try{return POI.find(p=>p.n===FR.p)||{}}catch(x){return{}}};
const stampOn=()=>/^(cafe|food)$/.test(poi().c||'');
const seed=p=>[...String(p)].reduce((a,c)=>a+c.charCodeAt(0),0)%6+1;
const have=()=>FRS[FR.p]==null?seed(FR.p):FRS[FR.p];
const reward=()=>poi().c==='cafe'?tr('free coffee','café offert'):tr('free dessert','dessert offert');
const esc=s=>String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));

/* 1. Pay: points and stamps go to the account, no typing */
const op=screens.frontpay;
screens.frontpay=function(){let h=op.apply(this,arguments);if(typeof h!=='string')return h;
if(stampOn())h=h.replace('<b>Collect points</b>','<b>'+tr('Collect points and stamps','Cumuler points et tampons')+'</b>');
if(FR.pt&&!FR.phe){
const re=/<div style="margin:8px 24px 0;padding:14px 16px;border-radius:20px;background:var\(--chip\)"><label[^>]*for="frph".*?<div id="frphh"[^>]*>[^<]*<\/div><\/div>/s;
if(re.test(h))h=h.replace(re,'<div class="frpt"><div class="m"><small>'+tr('Added to your itunda account','Ajouté à votre compte itunda')+'</small><b>'+esc(FR.ph)+'</b></div><button onclick="frPhe()">'+tr('Change','Modifier')+'</button></div>')}
return h};
window.frPhe=()=>{FR.phe=1;rr();setTimeout(()=>{const i=document.getElementById('frph');if(i){i.focus();try{i.select()}catch(x){}}},80)};

/* 2. Stamps: count on payment, undo on cancel */
const opy=window.frPay;
window.frPay=function(){let pre=null;
if(FR.pt&&stampOn()&&!FR._st){const cur=have();pre={prev:FRS[FR.p],b:cur>=NEED?0:cur};FR._sb=pre.b;FRS[FR.p]=pre.b+1;FR._st=1;FR._sp=pre.prev;FR._sa=0}
const r=opy.apply(this,arguments);
if(pre&&!(S.stack&&S.stack[S.stack.length-1]==='frontdone')){if(pre.prev==null)delete FRS[FR.p];else FRS[FR.p]=pre.prev;FR._st=0;delete FR._sb;delete FR._sp}
return r};
const ocn=window.frCancel;
if(ocn)window.frCancel=function(){if(FR._st){if(FR._sp==null)delete FRS[FR.p];else FRS[FR.p]=FR._sp;FR._st=0}return ocn.apply(this,arguments)};
const oo=window.frOpen;
window.frOpen=function(){FR._st=0;FR._sa=0;FR.phe=0;if(digs(FR.ph).length!==10)FR.ph=DEF;return oo.apply(this,arguments)};

/* 3. Done: stamp card + visible stars */
const od=screens.frontdone;
screens.frontdone=function(){let h=od.apply(this,arguments);if(typeof h!=='string')return h;
h=h.replace(/font-size:32px;color:var\(--tint\)/g,'font-size:32px;color:color-mix(in srgb,var(--tt) 50%,transparent)');
if(FR._st&&stampOn()){const n=Math.min(NEED,FRS[FR.p]||1),first=!FR._sa;
if(first)setTimeout(()=>{FR._sa=1},1400);
const dots=Array.from({length:NEED},(_,i)=>i<n?'<i class="on'+(first&&i===n-1?' new':'')+'" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5 9-10"/></svg></i>':(i===NEED-1?'<i class="gift" aria-hidden="true">🎁</i>':'<i aria-hidden="true"></i>')).join('');
const full=n>=NEED,msg=full?tr('Card complete. Your '+reward()+' is ready on your next visit.','Carte complète. Votre '+reward()+' vous attend à la prochaine visite.'):tr((NEED-n)+' more '+(NEED-n===1?'stamp':'stamps')+' for a '+reward()+'. 1 stamp per order.',(NEED-n)+' '+(NEED-n===1?'tampon':'tampons')+' de plus pour un '+reward()+'. 1 tampon par commande.');
const card='<div class="frst" role="group" aria-label="'+esc(tr('Stamps '+n+' of '+NEED,'Tampons '+n+' sur '+NEED))+'"><div class="frstt"><b>'+esc(FR.p)+'</b><span>'+n+' / '+NEED+'</span></div><div class="frstd">'+dots+'</div><div class="frstm'+(full?' ok':'')+'" role="status">'+msg+'</div></div>';
const k=h.indexOf('<div class="agt" style="text-align:center">');if(k>=0)h=h.slice(0,k)+card+h.slice(k)}
return h};
try{document.title=document.title.replace(/v\d+/,'v801')}catch(x){}
})()}catch(x){console.error('v801',x)}
</script>
<style id="v802">
.fts .fpk{flex-basis:168px}
.fpk .ftb{display:block;max-width:100%;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;box-sizing:border-box}
.fpk .fta{margin-top:auto}
.fta[aria-label^="Add "]{min-height:44px;min-width:80px}
.v802h{padding:20px 24px 0;display:flex;flex-wrap:wrap;gap:8px}
.v802h .fta{margin:0!important}
</style>
<script>
/* v802 itunda Front, Toss Front pass 10 (Toss Front / kiosk UX research). Toss chose a small terminal screen on purpose: Fitts's law says targets that are near and right-sized cause fewer mistakes. Critics of kiosks say the work moves to the customer (choosing, options, coupons) and that dense, differently laid out menus tire older users. So on the Front menu: (1) the menu comes first. Call waiter and Order together moved from above the menu to a quiet row below it, so the first thing you see is what you can order. (2) Add buttons are at least 44 px tall and 80 px wide everywhere (they were about 40 px). (3) The Start with these cards are one width and the Add buttons line up at the bottom; the reason badge stays on one line (it wrapped on Owner's pick and pushed one card out of line). */
try{(()=>{
if(typeof screens==='undefined'||!screens.frontmenu)return;
const om=screens.frontmenu;
screens.frontmenu=function(){let h=om.apply(this,arguments);if(typeof h!=='string')return h;
const re=/<div style="padding:12px 24px 0"><button class="fta"[^>]*onclick="frWaiter\(\)">.*?<\/button>(?:<button class="fta"(?:(?!<\/div>).)*?<\/button>)*<\/div>/s;
const m=h.match(re);if(!m)return h;
const row='<div class="v802h">'+m[0].slice(m[0].indexOf('<button'),m[0].lastIndexOf('</div>'))+'</div>';
h=h.replace(m[0],'');
const T='<div style="height:110px"></div>',i=h.lastIndexOf(T);
return i>0?h.slice(0,i)+row+h.slice(i):h+row};
const opf=screens.frontpay;screens.frontpay=function(){let h=opf.apply(this,arguments);return typeof h==='string'?h.replace('<b>Cumuler des points</b>','<b>Cumuler points et tampons</b>'):h};
try{document.title=document.title.replace(/v\d+/,'v802')}catch(x){}
})()}catch(x){console.error('v802',x)}
</script>
<style id="v803">
.v803c{display:flex;gap:8px}
.v803c .btn{flex:1;width:auto}
.v803c .v803s{background:var(--chip)!important;color:var(--tx)!important}
.v804p{margin:16px 24px 0;padding:14px 16px;border-radius:20px;background:var(--chip)}
.v803n{margin:12px 24px 0;padding:12px 16px;border-radius:16px;background:var(--chip);font-size:14px;line-height:20px}
.v803i{flex:1;min-width:0;height:44px;border:0;border-radius:12px;padding:0 12px;font:inherit;font-size:17px;background:var(--bg);color:var(--tx)}
</style>
<script>
/* v803 itunda Front, Toss Front pass 11 (Toss Front kiosk / Toss Place research). (1) Language: the Toss kiosk has a language mode, but Front was only half translated (Kinyarwanda showed English titles, picks, badges, descriptions, the cart sheet, the pay and done screens, and screen reader labels). One layer now translates every Front screen, sheet, label and toast into Kinyarwanda and French. (2) Receipt with my TIN: Toss Front can issue a receipt for business expenses (cash receipt). The done screen gets one row to add a 9 digit TIN, remembered for the next order. (3) Order more: Toss lets post-pay tables change the order after payment. After paying at a table there is now an Order more button next to Done; it opens the menu again at the same table and says the new items are a separate bill. */
try{(()=>{
const FR=window.__FR;if(!FR||typeof screens==='undefined'||!screens.frontdone||!screens.frontmenu)return;
const L=[
['Order, pay and go','Commandez, payez, c’est parti','Tumiza, ishyura, ugende'],
['Lunch deal','Offre du midi','Ifunguro rya saa sita ku giciro cyiza'],
['Pay with itunda and earn double points','Payez avec itunda et gagnez le double de points','Ishyura na itunda ubone amanota akubye kabiri'],
['New on the menu','Nouveau au menu','Bishya ku biryo'],
['Fresh juice, passion or mango','Jus frais, fruit de la passion ou mangue','Umutobe mushya, marakuja cyangwa umwembe'],
['Skip the queue','Évitez la file','Irinde umurongo'],
['Order here, we call your name','Commandez ici, nous appelons votre nom','Tumiza hano, tuzakuhamagara'],
['How would you like your order?','Comment souhaitez-vous votre commande ?','Wifuza kubifata ute?'],
['We bring it to your table','Nous l’apportons à votre table','Tubikugezaho ku meza yawe'],
['Take away','À emporter','Fata ujyane'],
['Pick up at the counter','À récupérer au comptoir','Ubifatire aho bishyurira'],
['Eat here near you','Sur place près de vous','Rya hano hafi yawe'],
['Take away near you','À emporter près de vous','Fata ujyane hafi yawe'],
['Eat here','Sur place','Rya hano'],
['Back','Retour','Subira inyuma'],
['Accessibility','Accessibilité','Ubufasha mu gukoresha'],
['Larger text','Texte plus grand','Inyandiko nini'],
['Easier to read','Plus facile à lire','Byoroshye gusoma'],
['Voice guide','Guide vocal','Ubuyobozi bw’amajwi'],
['Reads each step aloud','Lit chaque étape à voix haute','Isoma buri ntambwe mu ijwi riranguruye'],
['Start with these','Commencez par ceux-ci','Tangira kuri ibi'],
['Easy picks if you are not sure','Des choix simples si vous hésitez','Amahitamo yoroshye niba utazi icyo uhitamo'],
['#1 seller','N° 1 des ventes','Icyatumijwe cyane'],
['All menu','Tout le menu','Ibiryo byose'],
['Drinks','Boissons','Ibinyobwa'],
['Sides and sweets','Accompagnements et douceurs','Ibyongerwaho n’ibiryohe'],
['Espresso with steamed milk','Espresso au lait vapeur','Espresso n’amata ashyushye'],
['Baked this morning','Cuit ce matin','Byatetswe mu gitondo'],
['Passion or mango','Fruit de la passion ou mangue','Marakuja cyangwa umwembe'],
['Call waiter','Appeler le serveur','Hamagara uguhereza'],
['Order together','Commander ensemble','Mutumirize hamwe'],
['Pick something to order','Choisissez quelque chose','Hitamo icyo utumiza'],
['Your order','Votre commande','Ibyo watumije'],
['Goes well with your order','Va bien avec votre commande','Bijyana neza n’ibyo watumije'],
['Send to kitchen','Envoyer en cuisine','Ohereza mu gikoni'],
['Note for the kitchen','Un mot pour la cuisine','Ubutumwa ku gikoni'],
['Menu categories','Catégories du menu','Ibyiciro by’ibiryo'],
['Collect points','Cumuler des points','Bika amanota'],
['Collect points and stamps','Cumuler points et tampons','Bika amanota n’amakashe'],
['Added to your itunda account','Ajouté à votre compte itunda','Byashyizwe kuri konti yawe ya itunda'],
['Change','Modifier','Hindura'],
['Save','Enregistrer','Bika'],
['Last used','Dernier utilisé','Iheruka gukoreshwa'],
['When will you pick it up?','Quand viendrez-vous la retirer ?','Uzabifata ryari?'],
['Now','Tout de suite','Ako kanya'],
['Your table','Votre table','Ameza yawe'],
['We will bring it to you.','Nous vous l’apportons.','Turabikugezaho.'],
['Order received','Commande reçue','Komande yakiriwe'],
['Your order number','Votre numéro de commande','Nomero ya komande yawe'],
['Receipt','Reçu','Inyemezabwishyu'],
['In my app','Dans mon app','Muri app yanjye'],
['Print','Imprimer','Capa'],
['No receipt','Sans reçu','Nta nyemezabwishyu'],
['RWF paid','RWF payés','RWF byishyuwe'],
['Cancel order','Annuler la commande','Hagarika komande'],
['I am here','Je suis là','Ndi hano'],
['How should we call you?','Comment vous appeler ?','Tukuhamagare dute?'],
['Nickname','Surnom','Izina ryo guhamagara'],
['Text me','M’envoyer un SMS','Ntumira ubutumwa'],
['Welcome coupon','Coupon de bienvenue','Kuponi yo kukwakira'],
['10% off your next order here. We may text you offers.','10 % sur votre prochaine commande ici. Nous pouvons vous envoyer des offres par SMS.','10% ku komande yawe itaha hano. Dushobora kukohereza ubutumwa bw’ibyo dutanga.'],
['Use points','Utiliser les points','Koresha amanota'],
['Not enough in itunda Pay. Pick another way to pay.','Solde itunda Pay insuffisant. Choisissez un autre moyen de payer.','itunda Pay ntihagije. Hitamo ubundi buryo bwo kwishyura.'],
['Order more','Commander encore','Ongera utumize'],
['Edit order','Modifier la commande','Hindura komande'],
['Money is back. Edit your order, then pay again.','Vous êtes remboursé. Modifiez votre commande, puis payez à nouveau.','Amafaranga yagarutse. Hindura komande, hanyuma wishyure nanone.'],
['Already ordered','Déjà commandé','Byamaze gutumizwa'],
['Split or pay','Partager ou payer','Gabanya cyangwa wishyure'],
['Your first order is paid. New items are a separate bill.','Votre première commande est payée. Les nouveaux articles seront facturés à part.','Komande yawe ya mbere yishyuwe. Ibishya bizishyurwa ukwabyo.'],
['For business expenses','Pour vos frais professionnels','Ku mikoreshereze y’ubucuruzi'],
['Receipt with my TIN','Reçu avec mon TIN','Inyemezabwishyu ifite TIN yanjye'],
['Your TIN, 9 digits','Votre TIN, 9 chiffres','TIN yawe, imibare 9'],
['Order received. We are on it.','Commande reçue. Nous nous en occupons.','Komande yakiriwe. Turayikoraho.'],
['Sent to the kitchen','Envoyé en cuisine','Byoherejwe mu gikoni'],
['A waiter is on the way','Le serveur arrive','Uguhereza araje'],
['Link copied','Lien copié','Link yakopowe'],
['Sent with your note','Envoyé avec votre note','Byoherejwe n’ubutumwa bwawe'],
['Order cancelled. Your money is back.','Commande annulée. Vous êtes remboursé.','Komande yahagaritswe. Amafaranga yawe yagarutse.']
];
const D={};L.forEach(r=>D[r[0]]=[r[1],r[2]]);
const P=[
[/^You earn (\d+) points on this order$/,'Vous gagnez $1 points sur cette commande','Uhembwa amanota $1 kuri iyi komande'],
[/^View order · (.+)$/,'Voir la commande · $1','Reba ibyatumijwe · $1'],
[/^Add one (.+)$/,'Ajouter un $1','Ongeraho kimwe: $1'],
[/^Remove one (.+)$/,'Retirer un $1','Kuramo kimwe: $1'],
[/^Add (?!one )(.+)$/,'Ajouter $1','Ongeraho $1'],
[/^Pay · (.+)$/,'Payer · $1','Ishyura · $1'],
[/^Take away · /,'À emporter · ','Fata ujyane · '],
[/^Eat here · /,'Sur place · ','Rya hano · '],
[/^Table (\d+)$/,'Table $1','Ameza $1'],
[/^(\d) star$/,'$1 étoile(s)','Inyenyeri $1'],
[/^Stamps (\d+) of (\d+)$/,'Tampons $1 sur $2','Amakashe $1 kuri $2'],
[/^How was (.+)\?$/,'Comment était $1 ?','Byari bimeze bite kuri $1?'],
[/^Thanks for rating (.+)$/,'Merci pour votre avis sur $1','Urakoze gutanga igitekerezo kuri $1'],
[/^We will call (.+) when it is ready\.$/,'Nous vous appellerons $1 quand ce sera prêt.','Tuzakuhamagara $1 igihe bizaba byiteguye.'],
[/^Waiting for (.+) to accept$/,'En attente de $1','Dutegereje ko $1 yemera'],
[/^Accepted · cooking now$/,'Acceptée · en cuisine','Yemewe · irakorwa'],
[/^Ready\. Come pick it up$/,'Prête. Venez la retirer','Biriteguye. Ngwino ubifate'],
[/^Pickup: in (\d+) min/,'Retrait : dans $1 min','Gufata: nyuma y’iminota $1'],
[/^Pickup: now/,'Retrait : tout de suite','Gufata: ako kanya'],
[/your number is the last 4 digits of your phone/,'votre numéro est la fin de votre téléphone','nomero yawe ni imibare 4 ya nyuma ya telefone yawe'],
[/^(\d+) more stamps? for a (.+)\. 1 stamp per order\.$/,'Encore $1 tampons pour un $2. 1 tampon par commande.','Hasigaye amakashe $1 ngo ubone $2. Ikashe 1 kuri komande.'],
[/^Card complete\. Your (.+) is ready on your next visit\.$/,'Carte complète. Votre $1 vous attend à la prochaine visite.','Ikarita yuzuye. Ubutaha uzaza, uzabona $1.'],
[/^Receipt with TIN (.+)$/,'Reçu avec le TIN $1','Inyemezabwishyu ifite TIN $1'],
[/^Great\. Show (.+) at the counter\.$/,'Parfait. Montrez $1 au comptoir.','Neza. Garagaza $1 aho bishyurira.'],
[/free coffee/,'café offert','ikawa y’ubuntu'],
[/free dessert/,'dessert offert','ibiryohe by’ubuntu'],
[/Owner’s pick/,'Choix du patron','Icyo nyiri ahantu ahitamo'],
[/First time\?/,'Première fois ?','Ni ubwa mbere?'],
[/Fresh juice/,'Jus frais','Umutobe mushya']
];
const idx=()=>S.lang==='fr'?0:S.lang==='rw'?1:-1;
const inF=()=>{const k=S.stack&&S.stack[S.stack.length-1];return typeof k==='string'&&/^front/.test(k)};
const tx=(s,i)=>{const m=s.match(/^(\s*)([\s\S]*?)(\s*)$/),c=m[2];if(!c)return s;
if(Object.prototype.hasOwnProperty.call(D,c))return m[1]+D[c][i]+m[3];
let o=c;for(const p of P)if(p[0].test(o))o=o.replace(p[0],p[i+1]);return o===c?s:m[1]+o+m[3]};
const tn=(n,i)=>{if(n.nodeType===3){const v=tx(n.nodeValue,i);if(v!==n.nodeValue)n.nodeValue=v;return}
if(n.nodeType!==1)return;const w=document.createTreeWalker(n,NodeFilter.SHOW_TEXT);let t;while(t=w.nextNode()){if(t.parentNode&&/^(SCRIPT|STYLE|INPUT|TEXTAREA)$/.test(t.parentNode.tagName))continue;const v=tx(t.nodeValue,i);if(v!==t.nodeValue)t.nodeValue=v}
const els=[n,...n.querySelectorAll('[aria-label],[placeholder]')];els.forEach(e=>{['aria-label','placeholder'].forEach(a=>{const v=e.getAttribute&&e.getAttribute(a);if(v){const r=tx(v,i);if(r!==v)e.setAttribute(a,r)}})})};
const ph=document.getElementById('phone');
if(ph)new MutationObserver(ms=>{const i=idx();if(i<0||!inF())return;ms.forEach(m=>{if(m.type==='characterData')tn(m.target,i);else m.addedNodes.forEach(n=>tn(n,i))})}).observe(ph,{childList:true,subtree:true,characterData:true});
const ou=window.__ux;window.__ux=m=>{m=ou?ou(m):m;const i=idx();return typeof m==='string'&&i>=0&&inF()?tx(m,i):m};

/* 2. Receipt with my TIN */
const dg=v=>String(v||'').replace(/\D/g,'').slice(0,9),ft=d=>d.replace(/(\d{3})(?=\d)/g,'$1 ').trim(),rr=()=>render('fade-none');
window.FRT=window.FRT||'';
window.frTe=()=>{FR.te=1;rr();setTimeout(()=>{const e=document.getElementById('frtin');if(e){e.focus();try{e.setSelectionRange(e.value.length,e.value.length)}catch(x){}}},80)};
window.frTi=el=>{const d=dg(el.value);el.value=ft(d);window.FRT_=d;const b=document.getElementById('frtins');if(b)b.disabled=d.length!==9};
window.frTs=()=>{if(dg(window.FRT_).length===9){window.FRT=dg(window.FRT_);FR.te=0;rr()}};

/* 3. Order more at the table */
window.frMore=()=>{const p=FR.p,t=FR.t;window.frOpen(p,'here');FR.t=t;FR.more=1;S.stack=['fronthome','frontmenu'];render('fade')};
const oo=window.frOpen;window.frOpen=function(){FR.te=0;FR.more=0;return oo.apply(this,arguments)};
const od=screens.frontdone;
screens.frontdone=function(){let h=od.apply(this,arguments);if(typeof h!=='string')return h;
const row=FR.te?`<div class="frpt" style="margin:12px 24px 0;display:block"><label for="frtin" style="font-size:13px;color:var(--mu)">Your TIN, 9 digits</label><div style="display:flex;gap:8px;margin-top:6px"><input id="frtin" class="v803i" inputmode="numeric" autocomplete="off" maxlength="11" value="${ft(window.FRT)}" oninput="frTi(this)"><button id="frtins" ${window.FRT.length===9?'':'disabled'} onclick="frTs()">Save</button></div></div>`
:`<div class="frpt" style="margin:12px 24px 0"><div class="m"><small>For business expenses</small><b>${window.FRT?'Receipt with TIN '+ft(window.FRT):'Receipt with my TIN'}</b></div><button onclick="frTe()">${window.FRT?'Change':'Add'}</button></div>`;
h=h.replace(/(onclick="frRc\('none'\)"[^>]*>[^<]*<\/button><\/div><\/div>)/,'$1'+row);
if(FR.m==='here')h=h.replace(/<div class="cta"><button class="btn"\s+onclick="frDone\(\)">([^<]*)<\/button><\/div>/,'<div class="cta v803c"><button class="btn v803s" onclick="frMore()">Order more</button><button class="btn" onclick="frDone()">$1</button></div>');
return h};
const om=screens.frontmenu;
screens.frontmenu=function(){let h=om.apply(this,arguments);if(typeof h!=='string'||!FR.more)return h;
const k=h.indexOf('<div class="agt"');return k<0?h:h.slice(0,k)+'<div class="v803n">Your first order is paid. New items are a separate bill.</div>'+h.slice(k)};
/* v804 (Toss POS research: earlier orders stay visible with the new ones, and split sits on the order screen, not behind Pay). At a table, once something is sent to the kitchen, the menu shows an Already ordered card with what was sent and a Split or pay button. */
const om2=screens.frontmenu;
screens.frontmenu=function(){let h=om2.apply(this,arguments);if(typeof h!=='string'||FR.m!=='here')return h;
const ks=Object.keys(FR.s||{}).filter(k=>FR.s[k]>0);if(!ks.length)return h;
const nm={};h.replace(/aria-label="[^"]*? ([^"]+)" onclick="frQ\((\d+),1\)"/g,(a,n,i)=>{nm[i]=n.replace(/^(Add|Ajouter|Ongeraho)\s+/,'');return a});
const ln=ks.map(k=>`<div style="font-size:14px;color:var(--mu);margin-top:6px">${FR.s[k]} × ${nm[k]||'#'+k}</div>`).join('');
const card=`<div class="v804p"><div style="display:flex;justify-content:space-between;align-items:center;gap:8px"><b>Already ordered</b><button class="fta" style="background:var(--bg);color:var(--tx);height:40px" onclick="frBill()">Split or pay</button></div>${ln}</div>`;
const k=h.indexOf('<div class="v802h">');return k<0?h:h.slice(0,k)+card+h.slice(k)};
/* v805 (Toss Order pickup: you can change the order until the shop accepts it). Take away, while it says Waiting for the shop: an Edit order button next to Cancel. It refunds, puts the same items back in the cart and opens the menu to change them, then pay again. */
const od3=screens.frontdone;
screens.frontdone=function(){let h=od3.apply(this,arguments);if(typeof h!=='string'||FR.m==='here')return h;
return h.replace(/(<button id="frtgc"[\s\S]*?<\/button>)/,'$1<button id="frtge" class="fta" style="margin-top:8px;background:var(--bg);color:var(--tx);height:44px;display:none" onclick="frEdit()">Edit order</button>')};
window.frEdit=()=>{const s=Object.assign({},FR.s);window.frCancel();FR.c=s;FR.s={};S.stack=['fronthome','frontmenu'];render('fade');toast('Money is back. Edit your order, then pay again.')};
setInterval(()=>{const c=document.getElementById('frtgc'),e=document.getElementById('frtge');if(c&&e&&e.style.display!==c.style.display)e.style.display=c.style.display},300);
try{document.title=document.title.replace(/v\d+/,'v805')}catch(x){}
})()}catch(x){console.error('v803',x)}
</script>
<script>
/* v806 itunda Front, Toss Front pass 12 (Toss Place kiosk accessibility update, Toss Tech senior UX + Front field research). Toss Front research: (1) the 2026 Toss kiosk accessibility mode has lower screen, larger view, clear (high contrast) view, voice and an always-there "call staff" button that pings the POS; Front had voice and larger text only, so the Accessibility sheet now also has High contrast, Easy reach (content moves to the lower half for one hand, like Toss lower screen) and Call staff, and Call staff is also on Pay. (2) Toss Tech senior study: a question used as a title is read as a literal question to the person; three titles are now plain instructions (Choose how to order, Choose how we call you, Choose a pickup time). (3) Toss Front field test: plain screens with the same key info shown again beat flashy ones, and a risky button must not sit where a moving screen can land a tap; the cart sheet repeats the points you earn, Clear all lives in the sheet header away from the main button and is undone with Undo, not a confirm box. (4) Paying now shows what is happening (itunda Pay, MoMo approve, card, cash), blocks a double tap and lets you pay another way. */
try{(()=>{const FR=window.__FR;if(!FR||typeof screens==='undefined'||!screens.fronthome||!window.frAxO)return;
const lg=()=>S.lang==='fr'?1:S.lang==='rw'?2:0,T=(a,b,c)=>[a,b,c||a][lg()],re=()=>render('fade-none');
const css=document.createElement('style');css.textContent='.fth{--bg:#fff;--tx:#000;--mu:#3A3A44;--tt:#3A3A44;--ln:#000;--chip:#fff;--tint:#fff;--tintfg:#000;--lk:#000;background:#fff;color:#000}.fth .fta,.fth .ftq,.fth .fpk,.fth .ftm,.fth .fti,.fth .fseg,.fth .ftn,.fth .ocp{border:2px solid #000}.fth .btn{background:#000;color:#fff}.fth .cta{background:#fff;border-top:2px solid #000}.ftr{padding-top:240px}.ftsp{width:56px;height:56px;margin:6px auto 16px;border-radius:50%;border:5px solid var(--chip);border-top-color:var(--lk);animation:ftrot .9s linear infinite}@keyframes ftrot{to{transform:rotate(360deg)}}@media (prefers-reduced-motion:reduce){.ftsp{animation:none}}';document.head.appendChild(css);
/* 1 + 2: titles as instructions, high contrast, easy reach, call staff on Pay */
const IM=[['How would you like your order?',['Choose how to order','Choisissez comment commander','Hitamo uko utumiza']],['How should we call you?',['Choose how we call you','Choisissez comment vous appeler','Hitamo uko tuguhamagara']],['When will you pick it up?',['Choose a pickup time','Choisissez l’heure de retrait','Hitamo igihe uzabifatira']]];
const cls=()=>(FR.hc?'fth ':'')+(FR.rch?'ftr':'');
['home','menu','bill','pay','done'].forEach(k=>{const o=screens['front'+k];if(!o)return;screens['front'+k]=function(){let h=o.apply(this,arguments);if(typeof h!=='string')return h;
IM.forEach(x=>{h=h.split(x[0]).join(x[1][lg()])});
if(k==='pay'){const i=h.indexOf('<div style="height:110px"></div>');const b=`<div style="padding:10px 24px 0"><button class="fta" style="background:var(--chip);color:var(--tx);height:44px" onclick="frWaiter()">🔔 ${T('Call staff','Appeler le personnel','Hamagara umukozi')}</button></div>`;if(i>=0)h=h.slice(0,i)+b+h.slice(i)}
const c=cls().trim();return c?`<div class="${c}">${h}</div>`:h}});
const axr=(t,s,on,f)=>`<div style="display:flex;align-items:center;gap:12px;padding:14px 0"><div style="flex:1"><b>${t}</b><div class="mu" style="font-size:14px">${s}</div></div><button class="ftsw" role="switch" aria-checked="${!!on}" aria-label="${t}" onclick="${f}"></button></div>`;
const ox=window.frAxO;window.frAxO=function(){ox.apply(this,arguments);const s=document.querySelector('#layer .sheet');if(!s||s.querySelector('#ftax2'))return;const b=[...s.querySelectorAll('button.btn')].pop(),d=document.createElement('div');d.id='ftax2';
d.innerHTML=axr(T('High contrast','Contraste élevé','Amabara asobanutse'),T('Black on white, clear edges','Noir sur blanc, bords nets','Umukara ku cyera, impande zigaragara'),FR.hc,'frHc()')+axr(T('Easy reach','Accès facile','Bimanure hasi'),T('Moves the screen down so your thumb reaches it','Descend l’écran pour l’atteindre du pouce','Bimanura hasi ngo ubigereho'),FR.rch,'frRc2()')+`<button class="btn" style="margin-top:4px;background:var(--chip);color:var(--tx)" onclick="closeSheet();frWaiter()">🔔 ${T('Call staff','Appeler le personnel','Hamagara umukozi')}</button>`;s.insertBefore(d,b)};
window.frHc=()=>{FR.hc=FR.hc?0:1;re();window.frAxO()};window.frRc2=()=>{FR.rch=FR.rch?0:1;re();window.frAxO()};
/* 3: cart sheet repeats points, Clear all with Undo */
const snack=(m,u)=>{document.querySelectorAll('#phone .toast').forEach(x=>x.remove());const t=document.createElement('div');t.className='toast';t.style.cssText='display:flex;align-items:center;gap:12px';const s=document.createElement('span');s.textContent=m;const b=document.createElement('button');b.textContent=T('Undo','Annuler','Subiza inyuma');b.style.cssText='border:0;background:none;color:inherit;font:inherit;font-weight:800;text-decoration:underline;min-height:44px;padding:0 4px';b.onclick=()=>{t.remove();u()};t.append(s,b);$('#phone').appendChild(t);setTimeout(()=>t.remove(),5500)};
window.frClr=()=>{const sn=Object.assign({},FR.c);FR.c={};closeSheet();re();snack(T('Order cleared','Commande vidée','Ibyo watumije byasibwe'),()=>{FR.c=sn;re();window.frCart()})};
const cart=()=>{const s=document.querySelector('#layer .sheet');if(!s||!/frSend|frTogo/.test(s.innerHTML))return;const hd=s.firstElementChild,bt=[...s.querySelectorAll('button.btn')].pop();
if(hd&&!s.querySelector('#ftclr')){const c=document.createElement('button');c.id='ftclr';c.className='fta';c.style.cssText='background:none;color:var(--mu);font-weight:700';c.textContent=T('Clear all','Tout vider','Siba byose');c.onclick=window.frClr;hd.appendChild(c)}
if(bt&&FR.pt&&!s.querySelector('#ftpt')){const m=window.frMenuOf(FR.p),t=Object.keys(FR.c).reduce((a,k)=>a+(FR.c[k]||0)*((m[k]||[0,0,0])[2]),0),p=Math.floor(t/100);if(p>0){const d=document.createElement('div');d.id='ftpt';d.style.cssText='font-size:14px;font-weight:700;margin:-4px 0 10px';d.textContent='⭐ '+T(`You earn +${p} points when you pay`,`Vous gagnez +${p} points en payant`,`Uzabona amanota +${p} wishyuye`);s.insertBefore(d,bt)}}};
['frCart','frQ','frM2'].forEach(n=>{const o=window[n];if(!o)return;window[n]=function(){const r=o.apply(this,arguments);cart();return r}});
/* 4: paying shows what is happening, blocks a double tap */
const op=window.frPay;window.frPay=function(){if(FR.pb2)return;const pm=FR.pm||'pay',M={pay:[T('Paying with itunda Pay…','Paiement avec itunda Pay…','Kwishyura na itunda Pay…'),'',1100],mtn:[T('Approve on your phone','Validez sur votre téléphone','Emeza kuri telefoni yawe'),T('We sent a request to your MoMo number.','Nous avons envoyé une demande à votre numéro MoMo.','Twohereje ubusabe kuri nimero yawe ya MoMo.'),2800],card:[T('The cashier is bringing the card machine','Le caissier apporte le terminal','Umucungamari araje afite icyuma cya karita'),'',2200],cash:[T('The cashier is coming to you','Le caissier vient vers vous','Umucungamari araje aho uri'),'',2200]},m=M[pm]||M.pay;FR.pb2=1;
document.getElementById('layer').innerHTML=`<div class="sheetbg"></div><div class="sheet" role="alertdialog" aria-live="polite" aria-label="${m[0]}" style="text-align:center"><div class="ftsp" aria-hidden="true"></div><b style="font-size:22px;letter-spacing:-.4px">${m[0]}</b>${m[1]?`<div class="mu" style="margin-top:6px">${m[1]}</div>`:''}${pm==='pay'?'':`<button class="btn" style="margin-top:18px;background:var(--chip);color:var(--tx)" onclick="frPayX()">${T('Pay another way','Payer autrement','Ishyura ukundi')}</button>`}</div>`;
FR.pt2=setTimeout(()=>{FR.pb2=0;closeSheet();op()},m[2])};
window.frPayX=()=>{clearTimeout(FR.pt2);FR.pb2=0;closeSheet()};
try{document.title=document.title.replace(/v\d+/,'v806')}catch(x){}
})()}catch(x){console.error('v806',x)}
</script>
<script>
/* v807 itunda Front, Toss Front pass 13 (Toss Front / Toss table order / Toss Place research: one decision per screen, answers pre-chosen, extras one tap away). Pay was one long page: points, four payment methods, collect points, phone number and coupon all at once. Now: (1) Pay shows the amount, ONE "Pay with" row (your usual method already chosen, Change opens a small sheet with the four ways), and ONE "Points and offers" row that opens in place, so the whole screen fits without scrolling and the Pay button is the obvious next step. (2) Done keeps what you need now (paid, your table or number, stamps) and puts Receipt (app, print, none, TIN) behind one row. (3) Split now says what each person pays, right under the choice. (4) Amounts count up or down when the tip or split changes, like the Toss number roll (off when reduce motion is on). (5) The cart and the Pay with picker are floating bottom sheets like the Toss order sheet, not full pages. */
try{(()=>{const FR=window.__FR;if(!FR||typeof screens==='undefined'||!screens.frontpay||!screens.frontdone||!screens.frontbill)return;
const lg=()=>S.lang==='fr'?1:S.lang==='rw'?2:0,T=(a,b,c)=>[a,b,c||a][lg()],re=()=>render('fade-none'),F=x=>typeof fmt==='function'?fmt(x):String(x);
const css=document.createElement('style');css.id='v807';css.textContent='.ftrc{margin:14px 24px 0;border-radius:20px;background:var(--chip);overflow:hidden}.ftrw{display:flex;align-items:center;gap:12px;width:100%;min-height:64px;padding:14px 16px;border:0;background:none;color:var(--tx);font:inherit;text-align:left}.ftrw b{display:block;font-size:17px}.ftrw .mu{font-size:14px}.ftrw .ftc{margin-left:auto;font-weight:800;font-size:15px;color:var(--lk);padding:8px 0 8px 12px}.ftrw .ftch{margin-left:auto;font-size:24px;line-height:1;color:var(--tt);transition:transform .2s ease}.ftrw:active{background:var(--tint)}.fth .ftrc{border:2px solid #000}@media (prefers-reduced-motion:reduce){.ftrw .ftch{transition:none}}';document.head.appendChild(css);
const mk=h=>{const d=document.createElement('div');d.innerHTML=h;let r=d;while(r.children.length===1&&r.firstElementChild.tagName==='DIV'&&!r.querySelector(':scope>.mh'))r=r.firstElementChild;return[d,r]};
const out=(d,r,a)=>{r.innerHTML=a.map(c=>typeof c==='string'?c:c.outerHTML).join('');return d.innerHTML};
const hs=(c,f)=>c.outerHTML.indexOf(f+'(')>=0;
const tag=r=>{[...r.children].slice(0,6).some(c=>{const x=[...c.querySelectorAll('div')].find(y=>!y.children.length&&/^[\d,]+ RWF$/.test(y.textContent.trim()));if(x){x.setAttribute('data-ftamt',x.textContent.replace(/\D/g,''));return true}return false})};
/* 1: Pay, one decision */
const oP=screens.frontpay;screens.frontpay=function(){const h=oP.apply(this,arguments);if(typeof h!=='string')return h;
try{const[d,r]=mk(h),K=[...r.children],mi=K.findIndex(c=>hs(c,'frUp')||hs(c,'frPm')||c.classList.contains('agt'));if(mi<0)return h;
const head=K.slice(0,mi),pre=[],rows=[],sec=[],oth=[],tail=[];let wt=null;
K.slice(mi).forEach((c,i,A)=>{const nx=A[i+1];
if(c.classList.contains('cta')||(!c.textContent.trim()&&!c.children.length)){tail.push(c);return}
if(c.classList.contains('agt')&&nx&&hs(nx,'frPk')){pre.push(c);return}
if(hs(c,'frPk')){pre.push(c);return}
if(c.classList.contains('agt')&&nx&&nx.classList.contains('frck'))return;
if(c.classList.contains('frck')){rows.push(c);return}
if(hs(c,'frUp')||hs(c,'frPt')||hs(c,'frPhe')||hs(c,'frMk')){sec.push(c);return}
if(hs(c,'frWaiter')){wt=c;return}
oth.push(c)});
if(!rows.length)return h;
const on=rows.find(x=>x.classList.contains('on'))||rows[0],nm=on.querySelector('b').innerHTML,sb=(on.querySelector('.mu')||{}).innerHTML||'';
window.__ftRows=rows.map(x=>x.outerHTML.replace(/frPm\(/g,'frPm2(').replace('padding:14px 24px','padding:14px 4px')).join('');
const sm=[FR.up?T('Using points','Points utilisés'):'',FR.pt?T('Earning points','Points gagnés'):'',FR.mk?T('Coupon on','Coupon activé'):''].filter(Boolean).join(' · ')||T('Nothing selected','Aucun choix');
const pay=`<div class="ftrc"><button class="ftrw" aria-haspopup="dialog" onclick="frPmO()"><div style="flex:1;min-width:0"><div class="mu">${T('Pay with','Payer avec','Ishyura ukoresheje')}</div><b>${nm}</b><div class="mu">${sb}</div></div><span class="ftc">${T('Change','Modifier','Hindura')}</span></button></div>`;
const off=`<div class="ftrc"><button class="ftrw" aria-expanded="${!!FR.pmo}" onclick="frPmx()"><div style="flex:1;min-width:0"><b>${T('Points and offers','Points et offres')}</b><div class="mu">${sm}</div></div><span class="ftch" style="transform:rotate(${FR.pmo?90:0}deg)" aria-hidden="true">›</span></button></div>${FR.pmo?sec.map(c=>c.outerHTML).join(''):''}`;
tag(r);const res=out(d,r,[...head,...pre,pay,...oth,off,...(wt?[wt]:[]),...tail]);
if(!r.querySelector('[data-ftamt]')){const[d2,r2]=mk(res);tag(r2);return d2.innerHTML}return res}catch(x){console.error('v807 pay',x);return h}};
/* 3: Bill, what each person pays */
const oB=screens.frontbill;screens.frontbill=function(){const h=oB.apply(this,arguments);if(typeof h!=='string')return h;
try{const[d,r]=mk(h);tag(r);const a=r.querySelector('[data-ftamt]');
if(FR.sp&&a){const k=[...r.children].find(c=>hs(c,'frSp'));if(k){const m=F(+a.getAttribute('data-ftamt'))+' RWF';k.insertAdjacentHTML('afterend',`<div class="mu" style="padding:10px 24px 0;font-size:14px">${T(FR.sp+' people · each pays '+m,FR.sp+' personnes · '+m+' chacune','Abantu '+FR.sp+' · umuntu wese yishyura '+m)}</div>`)}}
return d.innerHTML}catch(x){console.error('v807 bill',x);return h}};
/* 2: Done, receipt behind one row */
const oD=screens.frontdone;screens.frontdone=function(){const h=oD.apply(this,arguments);if(typeof h!=='string')return h;
try{const[d,r]=mk(h),K=[...r.children],i=K.findIndex((c,j)=>c.classList.contains('agt')&&K[j+1]&&hs(K[j+1],'frRc'));if(i<0)return h;
const g=[];let j=i+2;while(K[j]&&K[j].classList.contains('frpt'))g.push(K[j++]);
const L={app:T('In my app','Dans mon app'),print:T('Print','Imprimer'),none:T('No receipt','Sans reçu')}[FR.rc||'app'];
const row=`<div class="ftrc"><button class="ftrw" aria-expanded="${!!FR.rco}" onclick="frRcx()"><div style="flex:1;min-width:0"><b>${T('Receipt','Reçu','Inyemezabwishyu')}</b><div class="mu">${L}</div></div><span class="ftch" style="transform:rotate(${FR.rco?90:0}deg)" aria-hidden="true">›</span></button></div>`;
if(K[0]&&K[0].getAttribute('style'))K[0].setAttribute('style',K[0].getAttribute('style').replace('padding-top:72px','padding-top:28px'));
const A=[...K.slice(0,i),row,...(FR.rco?[K[i+1],...g]:[]),...K.slice(j)];return out(d,r,A)}catch(x){console.error('v807 done',x);return h}};
/* handlers */
Object.assign(window,{frPmx:()=>{FR.pmo=FR.pmo?0:1;re()},frRcx:()=>{FR.rco=FR.rco?0:1;re();if(FR.rco)setTimeout(()=>{const b=document.querySelector('#phone [onclick="frRcx()"]');if(b)b.scrollIntoView({block:'center',behavior:'smooth'})},120)},frPm2:k=>{window.frPm(k);closeSheet()},
frPmO:()=>{document.getElementById('layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet bs464" role="dialog" aria-label="${T('Pay with','Payer avec','Ishyura ukoresheje')}"><div class="bsh" aria-hidden="true"></div><b style="font-size:22px;letter-spacing:-.4px;padding:0 4px">${T('Pay with','Payer avec','Ishyura ukoresheje')}</b><div style="margin-top:6px">${window.__ftRows||''}</div></div>`}});
['frOpen','frPay'].forEach(n=>{const o=window[n];if(!o)return;window[n]=function(){FR.pmo=0;FR.rco=0;return o.apply(this,arguments)}});
/* 5: the cart is a bottom sheet (Toss order sheet), not a full page */
const bsify=()=>{const s=document.querySelector('#layer .sheet');if(!s||s.classList.contains('bs464')||!/frSend|frTogo/.test(s.innerHTML))return;s.classList.add('bs464');s.insertAdjacentHTML('afterbegin','<div class="bsh" aria-hidden="true"></div>')};
['frCart','frQ','frM2'].forEach(n=>{const o=window[n];if(!o)return;window[n]=function(){const r=o.apply(this,arguments);bsify();return r}});
/* 4: count-up amounts */
const cu=()=>{const el=document.querySelector('#phone [data-ftamt]'),key=(S.stack||[]).slice(-1)[0];if(!el){window.__ftA=null;return}
const v=+el.getAttribute('data-ftamt'),p=window.__ftA;window.__ftA={k:key,v};
if(!p||p.k!==key||p.v===v||matchMedia('(prefers-reduced-motion: reduce)').matches)return;
const t0=performance.now();el.textContent=F(p.v)+' RWF';
const st=t=>{const q=Math.min(1,(t-t0)/320),e=1-Math.pow(1-q,3);el.textContent=F(Math.round(p.v+(v-p.v)*e))+' RWF';if(q<1)requestAnimationFrame(st)};requestAnimationFrame(st)};
const orr=render;render=function(){const x=orr.apply(this,arguments);try{requestAnimationFrame(cu)}catch(e){}return x};
try{document.title=document.title.replace(/v\d+/,'v807')}catch(x){}
})()}catch(x){console.error('v807',x)}
</script>

<script id="v809">
/* v809: Eats tracking shows what you ordered. Before: after the rider card the screen was empty. Now: a plain "Your order" summary under it, like Coupang Eats' order status page: order number, items and prices, where it goes (or where to pick up), your note, the total and how you paid. English, French and Kinyarwanda. */
try{(function(){
const L=(a,b,c)=>S.lang==='fr'?b:S.lang==='rw'?c:a;
const esc=x=>String(x==null?'':x).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
function html(o){
 const r=REST[o.r]||REST[S.er]||{n:'',items:[]},its=(o.items||[]).map(i=>{const m=r.items[i.k]||['',,0];return '<div style="display:flex;justify-content:space-between;gap:12px;padding:6px 0"><span>'+i.q+' × '+esc(m[0])+'</span><span class="mu">'+fmt(m[2]*i.q)+'</span></div>'}).join('');
 const row=(a,b)=>'<div style="display:flex;justify-content:space-between;gap:12px;padding:6px 0"><span class="mu">'+a+'</span><span style="text-align:right">'+b+'</span></div>';
 return '<div id="e809" style="margin:16px 24px 24px;padding:16px;border-radius:20px;background:var(--chip)"><div style="font-weight:800;font-size:17px;line-height:24px">'+L('Your order','Votre commande','Itegeko ryawe')+'</div><div class="mu sm" style="margin-top:2px">'+esc(r.n)+', '+esc(o.id)+'</div><div style="margin-top:8px;font-size:15px;line-height:22px">'+its+'</div>'
 +'<div style="border-top:1px solid var(--ln);margin-top:8px;padding-top:6px;font-size:15px;line-height:22px">'
 +row(o.pickup?L('Pick up at','Retrait à','Gufatira kuri'):L('Delivery to','Livraison à','Bizagezwa kuri'),o.pickup?esc(r.n):'Kimironko, KG 11 Ave')
 +(o.note?row(L('Your note','Votre note','Icyitonderwa cyawe'),esc(o.note)):'')
 +row(L('Paid with','Payé avec','Byishyuwe na'),'itunda Pay')
 +'<div style="display:flex;justify-content:space-between;padding:8px 0 0;font-weight:800;font-size:17px"><span>'+L('Total','Total','Yose hamwe')+'</span><span>'+fmt(o.t)+' RWF</span></div></div></div>';
}
setInterval(()=>{try{
 if(!S.stack||S.stack[S.stack.length-1]!=='etrack')return;
 const x=document.getElementById('etx'),o=S.orders.find(v=>v.k==='Eats order');
 if(!x||!o)return;
 const k=o.id+S.lang;let e=document.getElementById('e809');
 if(e&&e.dataset.k===k)return;
 if(e)e.remove();
 x.insertAdjacentHTML('afterend',html(o));
 document.getElementById('e809').dataset.k=k;
}catch(e){}},500);
try{document.title=document.title.replace(/v\d+/,'v809')}catch(x){}
})()}catch(x){console.error('v809',x)}
</script>

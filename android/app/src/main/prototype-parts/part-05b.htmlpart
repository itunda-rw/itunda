<style id="v907toss">
/* v907: Toss-style pass 34. Larger glyphs in service tiles with squircle corners, search fields with a leading magnifier, calmer Pay footer, softer cards. */
#phone .g,#phone .ico{border-radius:16px}
#phone .g>svg[viewBox="0 0 80 80"],#phone .ico>svg[viewBox="0 0 80 80"]{width:31px;height:31px}
#phone .ar.tap:active{background:color-mix(in srgb,var(--chip) 55%,transparent);border-radius:18px;transform:scale(.985);transition:transform .14s,background-color .14s}
#phone .xc,#phone .card{box-shadow:0 1px 2px rgba(25,31,40,.04)}
#phone#phone div[data-h44s]:has(.v420hit){padding-left:20px!important;padding-right:20px!important;gap:12px;justify-content:space-between}
#phone #sq,#phone input[type=search]:not(.hs13){padding-left:44px!important;background-repeat:no-repeat!important;background-position:15px center!important;background-size:20px!important}
#phone #sq:focus-visible{box-shadow:0 0 0 2px var(--br)}
</style>

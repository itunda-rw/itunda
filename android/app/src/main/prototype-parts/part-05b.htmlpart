#phone#phone .screen:has(button[onclick="tpGo()"]) .req button{height:40px;padding:0 16px;border:0;border-radius:20px;background:var(--chip);color:var(--tx);font-size:15px;font-weight:600}
#phone#phone .screen:has(button[onclick="tpGo()"]) .req button:active{transform:scale(.96)}
#phone#phone .p712 .grp .r .t{font-size:17px;font-weight:600;letter-spacing:-.3px}
#phone#phone .p712 .grp .r .t small{font-size:13px;font-weight:500;color:var(--mu);margin-top:2px}
#phone#phone .p712 .grp .r:active{background:color-mix(in srgb,var(--tx) 4%,transparent)}
#phone#phone .p712 .emp .go{height:48px;padding:0 24px;border:0;border-radius:14px;background:var(--cta,#6258F5);color:var(--ctafg,#fff);font-size:16px;font-weight:700}
#phone#phone .p712 .emp .go:active{transform:scale(.96)}
#phone#phone .p712 .emp b{font-size:19px;letter-spacing:-.4px}
#phone#phone .p712 .ch button{height:36px;padding:0 14px;border:0;border-radius:18px;background:var(--chip);color:var(--tx);font-size:14px;font-weight:600}
#phone#phone .p712 .ch button.on{background:var(--tx);color:var(--bg)}
#phone#phone#phone .acb:not(:disabled){background:var(--cta,#6258F5)!important;color:var(--ctafg,#fff)!important}
</style>
<style id="v897toss">
/* v897: Toss-style pass 25. Points, My points, Find coupons. One big grey-labelled total, 17px names on 68px rows with round logo marks and bold right-aligned values, solid ink chips, tinted Get and Cash out buttons, soft search, solid violet ad button. */
#phone#phone .p712 .h .cap{font-size:13px;font-weight:600;color:var(--mu)}
#phone#phone .p712 .h .big{font-size:36px;font-weight:800;letter-spacing:-1.2px;margin-top:4px}
#phone#phone .p712 .sh{font-size:19px;font-weight:700;letter-spacing:-.4px}
#phone#phone .p712 .r:has(.ic){min-height:68px;gap:14px;border-radius:16px}
#phone#phone .p712 .r:has(.ic):active{background:color-mix(in srgb,var(--tx) 4%,transparent)}
#phone#phone .p712 .r .ic{width:44px;height:44px;border-radius:22px;font-size:15px;font-weight:800}
#phone#phone .p712 .r .t{font-size:17px;font-weight:600;letter-spacing:-.3px}
#phone#phone .p712 .r .t b{font-size:17px;font-weight:800;letter-spacing:-.4px}
#phone#phone .p712 .r .t small{font-size:13px;font-weight:500;color:var(--mu);margin-top:2px}

</style>
<script>
/* v833: Talk safety nudge. In a Marketplace, Jobs or Property chat, if what you are typing asks to pay outside itunda Pay (mobile money to a number, a deposit first, a link, WhatsApp), a calm note appears above the message box: pay with itunda Pay so your money is held until you confirm. It does not block sending. rw and fr need native review. */
try{(function(){
const T=(e,f,r)=>({en:e,fr:f,rw:r}[S.lang]||e);
const RX=/(momo|mobile money|western union|send (it |money )?to my|pay (me )?(outside|first|before)|deposit first|advance|whatsapp|https?:\/\/|www\.|bit\.ly)/i;
document.addEventListener('input',e=>{try{
 const i=e.target;if(!i||i.id!=='msg'||!/^hd/.test(S.chat||''))return;
 const bar=i.closest('.cta');if(!bar)return;let n=bar.querySelector('.v833');
 if(!RX.test(i.value)){if(n)n.remove();return}
 if(n)return;
 n=document.createElement('div');n.className='v833';n.setAttribute('role','status');
 n.style.cssText='flex:1 0 100%;background:var(--chip);border-radius:14px;padding:10px 14px;font-size:13px;line-height:18px';
 n.innerHTML='<b>'+T('Pay with itunda Pay','Payez avec itunda Pay','Ishyura ukoresheje itunda Pay')+'</b><br>'+T('Your money is held until you confirm you got the item. Do not pay in advance or outside itunda.','Votre argent est bloqué jusqu’à ce que vous confirmiez avoir reçu l’article. Ne payez pas d’avance ni en dehors d’itunda.','Amafaranga yawe ategereza kugeza wemeje ko wabonye ikintu. Ntukishyure mbere cyangwa hanze ya itunda.');
 bar.insertBefore(n,bar.firstChild);
}catch(x){}});
})()}catch(x){console.error('v833',x)}
</script>
<style id="v834">/* v834: Property page had the same clipped bottom bar as Marketplace in v831 ("Book a viewing" cut off at 390px). Any two-button bar whose first button is meant to be compact (Message) now keeps that width and the main button takes the rest without clipping. */
#phone .cta>button.btn.sec2[style*="flex:0 0 auto;width:auto"]:first-child:nth-last-child(2){flex:0 0 auto!important;width:auto!important;padding:0 18px!important}
#phone .cta>button.btn.sec2[style*="flex:0 0 auto;width:auto"]:first-child:nth-last-child(2)+button.btn{flex:1 1 auto!important;min-width:max-content;padding:0 14px!important;white-space:nowrap}
</style>
<style id="v834b">/* v834: Property and Jobs list rows. A price like "120,000 RWF / month" broke onto two lines. Prices with a period ("/ month", "/ day") stay on one line, with the period a little lighter. */
#phone .dg-p.v834{white-space:nowrap;font-size:17px}
#phone .dg-p.v834 i{font-style:normal;font-weight:600;color:var(--mu);font-size:14px}
</style>
<script>try{(function(){const fix=()=>{try{document.querySelectorAll('#phone .dg-p:not(.v834)').forEach(e=>{const m=e.textContent.match(/^(.*?\sRWF)\s?(\/\s?\S+)$/);if(m&&e.children.length===0){e.classList.add('v834');e.innerHTML=m[1]+' <i>'+m[2]+'</i>'}})}catch(x){}};new MutationObserver(fix).observe(document.body,{childList:true,subtree:true});fix()})()}catch(x){console.error('v834',x)}</script>
<script>
/* v835: Talk, report a risky message in one tap. When the other person's message asks you to pay outside itunda Pay (mobile money to a number, a deposit first, a link, WhatsApp), a small line under that message offers Report. One tap sends the report with the reason filled in and the line changes to "Reported". The sample chat with Patrick H. now has such a message so it can be tried. rw and fr need native review. */
try{(function(){
const T=(e,f,r)=>({en:e,fr:f,rw:r}[S.lang]||e);
const RX=/(momo|mobile money|western union|send (it |money )?to my|pay (me )?(outside|first|before)|deposit first|advance|whatsapp|https?:\/\/|www\.|bit\.ly)/i;
window.v835Rep=id=>{try{window.__v835=window.__v835||{};window.__v835[id]=1}catch(e){}toast(T('Reported. We will review it within a day','Signalé. Nous l’examinerons sous un jour','Byatanzwe. Turabisuzuma mu munsi umwe'));mark()};
function seed(){try{const ms=S.msgs&&S.msgs['hdmarket4'];if(ms&&ms.length&&!ms.some(x=>x.v835)){const x=['them','Send 20,000 to my MoMo first and I will keep the bicycle for you.'];x.v835=1;x.ts=Date.now();ms.push(x);return 1}}catch(e){}}
function mark(){try{if(!/^hd/.test(S.chat||''))return;const id=S.chat;document.querySelectorAll('#view .mm-b.th').forEach(b=>{const w=b.closest('.t26-w')||b.parentElement;if(!w||(w.nextElementSibling&&w.nextElementSibling.classList.contains('v835')))return;if(!RX.test(b.textContent))return;const d=document.createElement('div'),done=(window.__v835||{})[id];d.className='v835';d.style.cssText='font-size:13px;line-height:18px;margin:4px 0 0 34px;color:var(--mu)';
 d.innerHTML=done?T('Reported. We will review it.','Signalé. Nous allons l’examiner.','Byatanzwe. Turabisuzuma.'):T('Asks you to pay outside itunda? ','Demande de payer hors itunda ? ','Bagusabye kwishyura hanze ya itunda? ')+'<button style="all:unset;cursor:pointer;color:var(--er);font-weight:700;text-decoration:underline;padding:6px 0" onclick="v835Rep(\''+id+'\')">'+T('Report','Signaler','Tanga raporo')+'</button>';
 w.after(d)});document.querySelectorAll('#view .v835').forEach(d=>{if((window.__v835||{})[id]&&d.querySelector('button')){d.textContent=T('Reported. We will review it.','Signalé. Nous allons l’examiner.','Byatanzwe. Turabisuzuma.')}})}catch(e){}}
const _co=window.cvOpen;window.cvOpen=function(id){const r=_co.apply(this,arguments);if(id==='hdmarket4'&&seed()){try{render('fade-none')}catch(e){}}return r};
new MutationObserver(mark).observe(document.body,{childList:true,subtree:true});
})()}catch(x){console.error('v835',x)}
</script>
<script>
/* v836: Jobs and Property pages get the same calm safety note Marketplace has. Jobs: never pay a fee to apply. Property: never pay a deposit before you have seen the home. It sits just above the employer or agent row. rw and fr need native review. */
try{(function(){
const T=(e,f,r)=>({en:e,fr:f,rw:r}[S.lang]||e);
function note(){try{const sc=document.querySelector('#view #sc');if(!sc||sc.querySelector('.v836'))return;
 const h=S.hd;if(h!=='jobs'&&h!=='property')return;
 const leaf=[...sc.querySelectorAll('div')].find(e=>e.children.length===0&&/^(Employer|Agent|Owner) ·/.test(e.textContent.trim()));if(!leaf)return;
 let row=leaf.closest('.tap[onclick]')||leaf.closest('.dg-sr');if(!row)return;row=row.closest('.dg-sel')||row;if(!row.parentElement)return;
 const d=document.createElement('div');d.className='v836';d.setAttribute('role','note');d.style.cssText='margin:12px 0;background:var(--chip);border-radius:14px;padding:12px 14px;font-size:13px;line-height:19px';
 d.innerHTML='<b>'+(h==='jobs'?T('Never pay to apply','Ne payez jamais pour postuler','Ntukishyure kugira ngo usabe akazi'):T('Pay only after you have seen the home','Ne payez qu’après avoir visité le bien','Ishyura umaze kubona inzu'))+'</b><br>'+(h==='jobs'?T('A real employer does not ask for a fee. If someone does, report the job.','Un vrai employeur ne demande pas de frais. Si on vous en demande, signalez l’offre.','Umukoresha nyawe ntasaba amafaranga. Nibabigusaba, tanga raporo kuri aka kazi.'):T('Do not send a deposit before a viewing. Meet at the home and use itunda Pay.','N’envoyez pas d’acompte avant la visite. Retrouvez-vous au bien et utilisez itunda Pay.','Ntugatange avansi mbere yo kureba inzu. Muhurire ku nzu mukoreshe itunda Pay.'));
 row.parentElement.insertBefore(d,row)}catch(e){}}
new MutationObserver(note).observe(document.body,{childList:true,subtree:true});
})()}catch(x){console.error('v836',x)}
</script>
<script>
/* v837: Community post, privacy nudge. If the text has a phone number (07x xxx xxxx or +250 ...), a note under the box says every neighbour can read it, to use messages instead, and never to share someone else's number. It does not block posting. rw and fr need native review. */
try{(function(){
const T=(e,f,r)=>({en:e,fr:f,rw:r}[S.lang]||e);
const RX=/(?<!\d)(\+?250|0)7[2389]\d{7}(?!\d)/;
document.addEventListener('input',e=>{try{
 const i=e.target;if(!i||i.id!=='cqt')return;
 let n=document.querySelector('.v837');
 if(!RX.test(i.value.replace(/[\s-]+/g,''))){if(n)n.remove();return}
 if(n)return;
 n=document.createElement('div');n.className='v837';n.setAttribute('role','status');
 n.style.cssText='margin-top:12px;background:var(--chip);border-radius:14px;padding:10px 14px;font-size:13px;line-height:18px';
 n.innerHTML='<b>'+T('Everyone nearby can read this number','Tous vos voisins peuvent lire ce numéro','Abaturanyi bose bashobora kubona uyu mubare')+'</b><br>'+T('Use messages instead. Never share someone else’s number.','Utilisez plutôt les messages. Ne partagez jamais le numéro de quelqu’un d’autre.','Koresha ubutumwa. Ntugashyire hanze nomero y’undi muntu.');
 const host=i.parentElement;host.appendChild(n);
}catch(x){}});
})()}catch(x){console.error('v837',x)}
</script>
<style id="v838css">
/* v838: Pay tab = quick pay (Scan / My code / Tap). The appbar "itunda pay >" opens itunda Pay, like "itunda bank >" opens itunda Bank on Home. */
#phone .pcd.pcd838{padding-bottom:calc(80px + env(safe-area-inset-bottom,0px));box-sizing:border-box}
#phone#phone#phone#phone .pcd838 .top{background:transparent!important;box-shadow:none!important;border:0!important;-webkit-backdrop-filter:none!important;backdrop-filter:none!important;position:relative!important;flex:none}
#phone#phone#phone#phone .pcd838 .top::before{content:none!important;display:none!important}
/* v932: the itunda Pay logo, name and arrow use the same greys as itunda Bank on Home (icon #8E919B, name #C9CBD2); the icons on the right stay white. */
#phone#phone#phone .pcd838 .top:has(.tp704bar){--hb-tx:#C9CBD2!important;--hb-ic:#fff!important}
#phone#phone#phone .pcd838 .top .tp704bar>svg:first-child g{stroke:#8E919B!important}
#phone#phone#phone .pcd838 .top .tp704bar>svg.pchev838{stroke:#8E919B!important}
#phone .pcd838 .pb838{background:none;border:0;cursor:pointer;font:inherit;color:inherit;-webkit-tap-highlight-color:transparent;text-align:left}
#phone .pcd838 .pb838:focus-visible{outline:2px solid #fff;outline-offset:4px;border-radius:8px}
#phone#phone#phone .pcd838 .top .tp704bar>svg.pchev838{width:18px!important;height:18px!important;stroke:var(--hb-tx)!important;stroke-width:2.6;margin:0 0 0 -2px!important;position:relative;top:2px}
</style>
<script>
/* v838: Pay appbar opens itunda Pay (balance, Move, Top up, ledger); the Pay tab itself shows the quick-pay UI that the QR icon used to open. The old Pay hub (map, benefits, coupons, history) is no longer on the tab. */
try{(function(){
const T=window.T3||((a)=>a);
const _pc=screens.pcode;
const _hub=screens.pay;/* the old Pay hub, kept as its own screen */

/* 1. Pay tab body = quick pay, with the appbar on top instead of the back arrow */
screens.pay=function(){
 if(S.pcT==null)S.pcT=1;S.scanFor='pay';
 const h=_pc.apply(this,arguments);if(typeof h!=='string')return h;
 const gear=(h.match(/<div class="pch">[\s\S]*?(<button class="ib" aria-label="Pay settings"[\s\S]*?<\/button>)<\/div>/)||[])[1]||'';
 const chev=ic('chev',18).replace('<svg ','<svg class="pchev838" ');
 const bar='<div class="top"><button class="tp704bar pb838" onclick="openPayHub()" aria-label="itunda Pay">'+knot(32)+'<span>Pay</span>'+chev+'</button><div style="display:flex;gap:4px">'+gear+'</div></div>';
 return h.replace('<div class="pcd">','<div class="pcd pcd838">')
  .replace(/<div class="pch">[\s\S]*?<\/button><\/div>/,bar)
  .replace("S.stack[S.stack.length-1]='paytill';render('fade-none')","ppGo('paytill')");
};


/* 1b. The old Pay hub lives on as its own screen, opened from the appbar */
screens.payhub=function(){
 const h=_hub.apply(this,arguments);if(typeof h!=='string')return h;
 const d=document.createElement('div');d.innerHTML=h;
 const top=d.querySelector('.top');
 if(top){top.querySelectorAll('button[aria-label="QR"]').forEach(b=>b.remove());
  top.insertAdjacentHTML('afterbegin','<button class="ib" aria-label="Back" onclick="back()" style="margin-left:-8px">'+ic('back',24)+'</button>')}
 return d.innerHTML};
window.openPayHub=()=>{S.stack.push('payhub');render('push')};

/* 2. These helpers swap the top of the stack ("pcode" -> next screen). On the tab the stack is empty, so give them a placeholder first; Back then returns to the Pay tab. */
const _pm=window.pcMerch;
window.pcMerch=function(k){if(!S.stack.length)S.stack.push('pcode');return _pm.apply(this,arguments)};
window.pcHit=function(fn){
 const f=document.getElementById('pcfr');if(!f||f.dataset.b)return;
 f.dataset.b=1;f.className='fr ok';
 document.getElementById('pcst').textContent=T('Code found','Kode yabonetse','Code détecté');
 document.getElementById('pcsh').textContent='';
 try{navigator.vibrate&&navigator.vibrate(15)}catch(e){}
 setTimeout(()=>{
  if(!S.stack.length&&S.tab==='pay'){S.stack.push('pcode');fn()}
  else if(S.stack[S.stack.length-1]==='pcode')fn()
 },550)};

/* 3. Opening Pay from another tab starts on My code */
const _tab=window.tab;
window.tab=function(k){if(k==='pay'&&S.tab!=='pay'){S.pcT=1;S.scanFor='pay'}return _tab.apply(this,arguments)};

document.querySelectorAll('title').forEach(t=>t.textContent=t.textContent.replace(/v\d+/,'v838'));
document.title=document.title.replace(/v\d+/,'v838');
})()}catch(x){console.error('v838',x)}
</script>
<script id="grp-v842">try{(function(){
const B64="";
let fr=null;
const phone=()=>document.getElementById('phone');
const top=()=>S.stack&&S.stack[S.stack.length-1];
function mk(){
  look.pending=1;
  const html=new TextDecoder('utf-8').decode(Uint8Array.from(atob(B64),c=>c.charCodeAt(0)));
  fr=document.createElement('iframe');
  fr.id='grpframe';fr.title='Group account';
  fr.setAttribute('sandbox','allow-scripts allow-same-origin allow-popups allow-forms');
  fr.style.cssText='position:absolute;inset:0;width:100%;height:100%;border:0;background:var(--bg);z-index:6;display:none';
  fr.srcdoc=html;
  phone().insertBefore(fr,document.getElementById('layer'));
}
function sync(){
  if(top()==='grp'){
    if(!fr||!fr.isConnected)mk();
    if(fr.style.display==='none'){fr.style.display='block';fr.style.animation='push .32s cubic-bezier(.2,.8,.2,1)'}
  }else if(fr)fr.style.display='none';
}

/* v843: accent colours (from the group account's theme picker) and a live group summary on Bank */
const ACC=[['Itunda','Itunda','Itunda','#8F89FF','#EEEDFF','#5B54D6','#8F89FF','#2A2850','#B3AEFF','#FFC21A',0],
['Blue','Ubururu','Bleu','#3182F6','#E8F3FF','#1B64DA','#4593FC','#1E2A3F','#8EC0FF','#3182F6',1],
['Mint','Mint','Menthe','#00B386','#E0F7F0','#00805E','#2FD3A6','#14332B','#7FE3C8','#2FD3A6',2],
['Coral','Coral','Corail','#F2573D','#FFEDE9','#C93B24','#FF7A62','#3A2420','#FFB3A5','#FF7A62',4],
['Red','Umutuku','Rouge','#F04452','#FEEAEC','#D22030','#F66570','#3A1C20','#FFADB3','#F66570',6],
['Orange','Orange','Orange','#F98600','#FFF1DD','#B35C00','#FFA938','#3A2A12','#FFD08A','#FFA938',7],
['Green','Icyatsi','Vert','#03B26C','#E3F7EE','#028A55','#2FD08A','#12342A','#8FE6BF','#2FD08A',8],
['Teal','Teal','Sarcelle','#18A5A5','#E1F5F5','#117A7A','#3CC5C5','#123334','#92E0E0','#3CC5C5',9],
['Purple','Umuhengeri','Violet','#A234C7','#F6E8FB','#7F229D','#C063E0','#2F1A38','#E2B0F3','#C063E0',10],
['Rose','Roza','Rose','#E8457A','#FDE8EF','#B92B5B','#F27098','#3A1D28','#F9B5CB','#F27098',11],
['Ink','Wino','Encre','#191F28','#F2F4F6','#191F28','#3A4150','#2C2C35','#F9FAFB','#F9FAFB',3],
['Midnight','Ijoro','Minuit','#1F2A44','#E8ECF5','#1F2A44','#4A5E8F','#1C2438','#B7C4E6','#8FA6E0',12]];
const lum=h=>{const c=[1,3,5].map(i=>{const v=parseInt(h.substr(i,2),16)/255;return v<=.03928?v/12.92:Math.pow((v+.055)/1.055,2.4)});return .2126*c[0]+.7152*c[1]+.0722*c[2]};
const onC=h=>lum(h)>.3?'#10131A':'#fff';
let ai=0;try{ai=Math.min(ACC.length-1,Math.max(0,+localStorage.getItem('itunda_accent')||0))}catch(e){}
function look(){if(fr&&fr.contentWindow)try{fr.contentWindow.postMessage({t:'itunda:look',th:ACC[ai][10],thm:(document.documentElement.dataset.theme||'system')==='system'?'system':document.documentElement.dataset.theme},'*')}catch(e){}}
function paint(){
  let e=document.getElementById('acc843');if(!e){e=document.createElement('style');e.id='acc843';document.head.appendChild(e)}
  window.__grpTh=ACC[ai][10];
  if(!ai){e.textContent='';return}
  const [,,,L,T,F,L2,TD,FD,A2]=ACC[ai],LD=lum(L2)>=.124?L2:A2;
  const lt='--lk:'+L+';--br:'+LD+';--on:'+onC(LD)+';--tint:'+T+';--tintfg:'+F,dk='--lk:'+LD+';--br:'+LD+';--on:'+onC(LD)+';--tint:'+TD+';--tintfg:'+FD;
  e.textContent=':root:root,:root[data-theme=light]:root{'+lt+'}@media(prefers-color-scheme:dark){:root:root:not([data-theme=light]){'+dk+'}}:root[data-theme=dark]:root{'+dk+'}';
  const mc=document.querySelector('meta[name=theme-color]');if(mc)mc.content=LD;
}
window.pickAccent=i=>{ai=i;try{localStorage.setItem('itunda_accent',i)}catch(e){}paint();look();render('fade-none')};
paint();
const _th=screens.theme;
screens.theme=()=>{const h=_th();const nm=a=>S.lang==='rw'?a[1]:S.lang==='fr'?a[2]:a[0];
 const sw=ACC.map((a,i)=>{const on=i===ai;return '<button class="tap" onclick="pickAccent('+i+')" aria-label="'+nm(a)+'" aria-pressed="'+on+'" style="border:0;background:none;padding:0;display:flex;flex-direction:column;align-items:center;gap:6px;font-size:12px;font-weight:'+(on?800:600)+';color:'+(on?'var(--tx)':'var(--mu)')+'"><span style="width:48px;height:48px;border-radius:50%;background:'+a[3]+';display:grid;place-items:center;box-shadow:'+(on?'0 0 0 3px var(--bg),0 0 0 5px '+a[3]:'inset 0 0 0 1px var(--ln)')+'">'+(on?'<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="'+onC(a[3])+'" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>':'')+'</span>'+nm(a)+'</button>'}).join('');
 return h+'<div class="sec" style="padding-top:28px"><div class="sech">'+T('Accent colour','Ibara ry’ibanze','Couleur d’accent')+'</div><div class="mu sm" style="margin-bottom:16px">'+T('Changes buttons, links and highlights everywhere. Saved on this device.','Rihindura utubuto, amahuza n’ibyerekanwa byose. Ribikwa kuri iki gikoresho.','Change les boutons, liens et accents partout. Enregistré sur cet appareil.')+'</div><div style="display:grid;grid-template-columns:repeat(4,1fr);gap:18px 0">'+sw+'</div><div style="display:flex;gap:10px;margin-top:28px"><button class="btn" style="flex:1" data-m="'+T('Looks good','Biraryoshye','Ça rend bien')+'" onclick="toast(this.dataset.m)">'+T('Primary','Ibanze','Principal')+'</button><button class="btn sec2" style="flex:1">'+T('Secondary','Ibindi','Secondaire')+'</button></div></div>'};
const _stm=window.setTheme;window.setTheme=function(){const r=_stm.apply(this,arguments);look();return r};
window.GRPO=()=>S.gg?{v:fmt(S.gg.bal)+' RWF',s:S.gg.name+' · '+S.gg.n+' '+T('members','abanyamuryango','membres')}:{};
window.openGrp=()=>{S.stack.push('grp');render('push')};
screens.grp=()=>'<div id="grpslot"></div>';
const _d=window.draw;
window.draw=function(){const r=_d.apply(this,arguments);try{sync()}catch(e){console.error('grp842',e)}return r};
addEventListener('message',e=>{const d=e.data;if(d==='itunda:group:exit'&&top()==='grp')back();if(d&&d.t==='itunda:group:state')S.gg={name:d.name||'Group',bal:d.bal||0,n:d.n||1}});
document.title=document.title.replace(/v\d+/,'v846');
})()}catch(e){console.error('grp-v842',e)}</script>
<script id="ikimina-v844">try{(function(){
/* v844: Ikimina, using the group account's patterns: dues progress, remind unpaid members, payout order, confirm sheet before paying */
const T=(a,f)=>S.lang==='fr'?f:a;
const NM=['Eric M.','Marie C.','Aline U.','Patrick N.','You','Diane K.','Joseph B.','Claire M.'],EACH=10000;
const mo=k=>{const n=new Date();return new Date(n.getFullYear(),n.getMonth()+k,1)};
const fd=d=>d.toLocaleDateString(S.lang==='fr'?'fr-FR':'en-GB',{day:'numeric',month:'short'});
const due=()=>{const d=new Date();d.setDate(d.getDate()+(5-d.getDay()+7)%7);return d.toDateString()===new Date().toDateString()?T('today','aujourd\u2019hui'):d.toLocaleDateString(S.lang==='fr'?'fr-FR':'en-GB',{weekday:'short',day:'numeric',month:'short'})};
screens.ikim=()=>{
 const you=!!S.ik,jo=!!S.ikj,paid=6+(you?1:0)+(jo?1:0),col=paid*EACH,low=S.bank<EACH&&!you;
 const ok=i=>i===4?you:i===6?jo:true,ord=NM.map((_,i)=>i).sort((a,b)=>ok(a)-ok(b));
 const pill=(c,t)=>`<span style="color:${c};font-weight:700;font-size:14px">${t}</span>`;
 const mem=i=>{const r=ok(i)?pill('var(--ok)',T('Paid','Pay\u00e9')):i===4?pill('var(--er)',T('Due','\u00c0 payer')):(S.ikr&&S.ikr[i])?pill('var(--mu)',T('Reminded','Rappel\u00e9')):`<button class="tap" onclick="ikRemind(${i})" style="height:36px;padding:0 14px;border:0;border-radius:12px;background:var(--tint);color:var(--tintfg);font-size:14px;font-weight:800">${T('Remind','Rappeler')}</button>`;
  return `<div class="row" style="cursor:default;padding:8px 0"><div class="ico" style="width:36px;height:36px">${gl('community',24)}</div><div class="t" style="font-size:15px">${i===4?T('You','Vous'):NM[i]}</div><div class="r">${r}</div></div>`};
 const ord2=NM.map((n,i)=>{const r=i+1,dn=r<3,now=r===3;return `<div class="row" style="cursor:default;padding:8px 0"><div class="ico" style="width:36px;height:36px;font-size:14px;font-weight:800">${dn?'\u2713':r}</div><div class="t" style="font-size:15px;${i===4?'font-weight:800':''}">${i===4?T('You','Vous'):n}</div><div class="r" style="${now?'color:var(--tintfg);font-weight:700':'color:var(--mu)'}">${dn?T('Done','Fait'):now?T('This round','Ce tour'):fd(mo(r-2))}</div></div>`}).join('');
 return `${bar('Umurenge Savers')}<div class="pad" style="padding-top:24px"><div class="sm mu">${T('Round 3 of 8','Tour 3 sur 8')} \u00b7 ${T('due ','\u00e0 payer ')}${due()}</div><div class="big" style="margin-top:4px">${fmt(col)} RWF</div><div class="sm mu" style="margin-top:4px">${T('of 80,000 RWF \u00b7 10,000 RWF each','sur 80 000 RWF \u00b7 10 000 RWF chacun')}</div><div style="height:8px;border-radius:4px;background:var(--chip);margin-top:14px"><div style="height:8px;border-radius:4px;background:var(--br);width:${paid/8*100}%;transition:width .4s"></div></div><div class="sm mu" style="margin-top:8px">${paid} ${T('of 8 members paid','membres sur 8 ont pay\u00e9')}</div></div>`+
 `<div style="margin:20px 24px 0;padding:14px 18px;border-radius:20px;background:var(--tint)"><div class="sm" style="font-weight:800;color:var(--tintfg)">${T('Receives this pot','Re\u00e7oit la cagnotte')}</div><div style="font-size:18px;font-weight:800;margin-top:2px">Aline U. \u00b7 ${fd(mo(1))}</div><div class="sm mu" style="margin-top:2px">${T('Your turn: round 5, ','Votre tour : tour 5, ')}${fd(mo(3))}</div></div>`+
 `<div class="sec" style="padding-top:20px"><div class="sech">${T('This round','Ce tour')}</div>${ord.map(mem).join('')}</div><div class="sec" style="padding-top:12px"><div class="sech">${T('Payout order','Ordre des versements')}</div>${ord2}</div>`+
 `<div class="pad" style="padding-top:12px"><button class="btn sec2" style="height:48px;font-size:16px" onclick="openChat('ikimina')">${T('Open group chat','Ouvrir le chat du groupe')}</button></div>${low?`<div class="pad sm" style="padding-top:8px;color:var(--er)">${T('Not enough in itunda Bank. Add money first.','Solde itunda Bank insuffisant. Ajoutez de l\u2019argent.')}</div>`:''}<div class="pad fine" style="padding-top:16px">${you?T('You\u2019re all set. Sample group for this prototype.','Tout est en ordre. Groupe d\u2019exemple pour ce prototype.'):T('Sample group for this prototype.','Groupe d\u2019exemple pour ce prototype.')}</div><div class="cta"><button class="btn" ${you||low?'disabled':''} onclick="cs40('Umurenge Savers',${EACH},0,'ikPay2','${T('Round 3 of 8','Tour 3 sur 8')}')">${you?T('Paid for this round','Pay\u00e9 pour ce tour'):T('Contribute 10,000 RWF','Verser 10 000 RWF')}</button></div>`};
window.ikPay2=()=>{closeSheet();ikPay()};
window.ikRemind=i=>{(S.ikr=S.ikr||{})[i]=1;toast(T('Reminder sent to ','Rappel envoy\u00e9 \u00e0 ')+NM[i]);render('fade-none');
 if(i===6)setTimeout(()=>{S.ikj=1;if(S.stack[S.stack.length-1]==='ikim')render('fade-none');toast(NM[6]+T(' just paid',' vient de payer'))},2600)};
})()}catch(e){console.error('v844',e)}</script>
<script id="yreq-v845">try{(function(){
/* v845: Youth account, requests. Taken from the group account: a member asks, the owner approves or declines, and an approval opens a confirm sheet before any money moves. */
const L=(a,b,c)=>({rw:b,fr:c}[S.lang]||a);
const e=s=>String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const rq=Y=>Y.rq=Y.rq||[{w:L('School notebooks','Ibitabo by’ishuri','Cahiers d’école'),i:'📓',a:3500,s:0},{w:L('Bus fare','Amafaranga y’ingendo','Ticket de bus'),i:'🚌',a:1500,s:0}];
const _y=screens.yth;
screens.yth=function(){
 const h=_y.apply(this,arguments),Y=S.yth;if(!Y)return h;
 const R=rq(Y),nm=e(Y.n),open=R.filter(x=>!x.s).length;
 const btn=(bg,fg,fn,i,tx)=>'<button class="tap" onclick="'+fn+'('+i+')" style="flex:1;height:44px;border:0;border-radius:14px;background:'+bg+';color:'+fg+';font:700 15px inherit;font-family:inherit">'+tx+'</button>';
 const card=(x,i)=>x.s?'<div class="row" style="padding:8px 0;cursor:default"><div class="ico" style="width:36px;height:36px">'+x.i+'</div><div style="flex:1;min-width:0"><div class="t" style="font-size:15px">'+x.w+'</div><div class="s">'+fmt(x.a)+' RWF</div></div><b style="color:var(--'+(x.s===1?'ok':'mu')+')">'+(x.s===1?L('Approved','Byemewe','Approuvé'):L('Declined','Byanzwe','Refusé'))+'</b></div>'
 :'<div style="margin-top:10px;padding:14px;border-radius:20px;background:var(--chip)"><div style="display:flex;align-items:center;gap:12px"><div class="ico" style="width:40px;height:40px">'+x.i+'</div><div style="flex:1;min-width:0"><div class="t" style="font-size:16px;font-weight:700">'+x.w+'</div><div class="sm mu">'+L(nm+' asks for ',nm+' arasaba ',nm+' demande ')+fmt(x.a)+' RWF</div></div></div><div style="display:flex;gap:8px;margin-top:12px">'+btn('var(--card,transparent)','inherit','ythReqNo',i,L('Decline','Anira','Refuser'))+btn('var(--br)','var(--on)','ythReqAsk',i,L('Approve','Emera','Approuver'))+'</div></div>';
 const sec='<div class="pad" style="padding-top:8px"><div class="sech" style="padding:0">'+L('Requests from '+nm,'Ibyasabwe na '+nm,'Demandes de '+nm)+(open?' · '+open:'')+'</div>'+R.map(card).join('')+(open?'':'<div class="sm mu" style="margin-top:10px;line-height:20px">'+L('All caught up. When '+nm+' asks for money, it shows here.','Nta cyasabwe. '+nm+' nasaba amafaranga, azagaragara hano.','Tout est traité. Quand '+nm+' demande de l’argent, cela apparaît ici.')+'</div>')+'</div>';
 const k=h.indexOf('<div class="pad">');
 return k<0?h+sec:h.slice(0,k)+sec+h.slice(k)};
window.ythReqNo=i=>{const x=rq(S.yth)[i];x.s=2;render('fade-none');toast(L('Declined: '+x.w,'Byanzwe: '+x.w,'Refusé : '+x.w))};
window.ythReqAsk=i=>{const Y=S.yth,x=rq(Y)[i],low=S.bank<x.a,n=e(Y.n);
 const r=(a,b)=>'<div style="display:flex;justify-content:space-between;gap:12px;padding:10px 0;font-size:15px"><span class="mu">'+a+'</span><b>'+b+'</b></div>';
 $('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="h1" style="font-size:22px;line-height:30px;margin-top:4px">'+L('Approve '+x.w+'?','Wemeze '+x.w+'?','Approuver '+x.w+' ?')+'</div><div style="margin:12px 0 20px">'+r(L('Send to','Ohereza kuri','Envoyer à'),n)+r(L('Amount','Amafaranga','Montant'),fmt(x.a)+' RWF')+r(L('Paid from','Yishyuwe na','Payé depuis'),'itunda Bank')+r(L('Balance after','Asigaye','Solde après'),fmt(S.bank-x.a)+' RWF')+(low?'<div class="sm" style="color:var(--er);margin-top:6px">'+L('Not enough in your bank balance.','Nta mafaranga ahagije ufite muri banki.','Solde insuffisant.')+'</div>':'')+'</div><div class="row2" style="display:grid;grid-template-columns:1fr 1.8fr;gap:8px"><button class="btn sec2" onclick="closeSheet()">'+L('Cancel','Hagarika','Annuler')+'</button><button class="btn" style="white-space:nowrap" '+(low?'disabled ':'')+'onclick="ythReqOk('+i+')">'+L('Approve and send','Emera kandi ohereze','Approuver et envoyer')+'</button></div></div>';
 if(typeof focusSheet==='function')focusSheet()};
window.ythReqOk=i=>{const x=rq(S.yth)[i];if(S.bank<x.a)return;x.s=1;closeSheet();ythSend(x.a)};
})()}catch(e){console.error('v845',e)}
</script>
<script id="pflow-v846">try{(function(){
/* v846: product flows, taken from the group account. The group account explains the product first, then asks one thing per page (type, name, terms, "did you understand?"), and ends on a page that says what to do next. Five products now open the same way: Youth account, 12-month deposit, SACCO shares, Ikimina and 26-Week Savings. Before: each opened straight on a form or a balance page with no explanation. Now: (1) an intro page that says what it is, shows one example, lists three benefits and the key facts, with one button; (2) one decision per page with a thin progress line; (3) for products that lock money, hold shares, involve a child or a group: terms in plain words, then "Did you understand everything?"; (4) a last page that checks the money (amount, what you get, balance after) before anything moves; (5) a done page with one next step. 26-Week Savings is light (intro, check, done) because nothing is locked. 31-Day Savings already had its own intro and steps, so it is unchanged. English only; fr and rw still open the old pages. */
const e=s=>String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
S.pf=S.pf||{};S.pfD=S.pfD||{};
const P={};
const F=k=>{if(!S.pf[k])S.pf[k]={i:0,d:P[k].d0(),ck:[0,0,0],done:0};return S.pf[k]};
const started=k=>k==='dep'?!!S.dep:k==='sacco'?(+S.sh>0):k==='yth'?!!S.yth:k==='ikim'?!!(S.ikJ||S.ik):!!(S.pfD.w26||+S.w26>0);
const SUG={'7–9':1000,'10–12':3000,'13–15':3000,'16–17':5000};

/* ---------- small parts ---------- */
const hd=(h,s)=>'<div class="h1">'+h+'</div>'+(s?'<div class="mu" style="font-size:16px;line-height:24px;margin-top:10px">'+s+'</div>':'');
const opt=(on,fn,l,r)=>'<button class="tap pfb" role="radio" aria-checked="'+on+'" onclick="'+fn+'" style="display:flex;justify-content:space-between;align-items:center;gap:12px;width:100%;min-height:64px;margin-top:10px;padding:0 18px;border:0;border-radius:18px;font:inherit;text-align:left;cursor:pointer;color:var(--tx);background:'+(on?'var(--tint)':'var(--chip)')+';box-shadow:'+(on?'inset 0 0 0 2px var(--br)':'none')+'"><span style="font-size:17px;font-weight:800">'+l+'</span>'+(r?'<span style="font-size:14px;font-weight:700;color:'+(on?'var(--tintfg)':'var(--mu)')+'">'+r+'</span>':'')+'</button>';
const grp=h=>'<div role="radiogroup" style="margin-top:22px">'+h+'</div>';
const note=(t,err)=>'<div class="sm" style="margin-top:14px;line-height:20px;color:var('+(err?'--er':'--mu')+')" aria-live="polite">'+t+'</div>';
const rw=(a,b)=>'<div style="display:flex;justify-content:space-between;gap:16px;min-height:48px;align-items:center;font-size:15px"><span class="mu">'+a+'</span><b style="text-align:right">'+b+'</b></div>';
const disc=(ic,sz,bg)=>'<div style="width:'+sz+'px;height:'+sz+'px;flex:none;border-radius:50%;background:'+(bg||'var(--tint)')+';color:var(--tintfg);display:grid;place-items:center">'+gl(ic,Math.round(sz*.55))+'</div>';
const big=t=>'<div class="big" style="margin-top:14px;color:var(--tx)">'+t+'</div>';
const cap=t=>'<div style="font-size:15px;line-height:22px;margin-top:6px;font-weight:600">'+t+'</div>';
const ring=ic=>'<div style="display:flex;justify-content:center">'+disc(ic,72,'var(--bg)')+'</div>';
const ckRow=(on,fn,tit,sub,strong)=>'<button class="tap pfb" role="checkbox" aria-checked="'+on+'" onclick="'+fn+'" style="display:flex;gap:14px;align-items:flex-start;width:100%;text-align:left;border:0;background:none;color:inherit;font:inherit;padding:14px 0;cursor:pointer"><span aria-hidden="true" style="flex:none;width:28px;height:28px;border-radius:14px;box-sizing:border-box;display:grid;place-items:center;font-size:15px;font-weight:800;margin-top:1px;'+(on?'background:var(--br);color:var(--on)':'border:2px solid var(--tt);color:transparent')+'">✓</span><span style="min-width:0"><span style="display:block;font-size:'+(strong?17:16)+'px;font-weight:'+(strong?800:700)+'">'+tit+'</span>'+(sub?'<span class="mu" style="display:block;font-size:14px;line-height:20px;margin-top:2px">'+sub+'</span>':'')+'</span></button>';
const req=' <span class="mu" style="font-weight:600;font-size:14px">(required)</span>';

/* ---------- the shared pages ---------- */
const G={
intro:k=>{const c=P[k];
 const ben=c.ben.map(x=>'<div style="display:flex;gap:14px;align-items:flex-start;padding:10px 0"><div class="ico" style="width:44px;height:44px;flex:none">'+gl(x[0],26)+'</div><div style="min-width:0"><div style="font-size:16px;font-weight:800">'+x[1]+'</div><div class="mu" style="font-size:15px;line-height:22px;margin-top:2px">'+x[2]+'</div></div></div>').join('');
 return {b:'<div class="pad" style="padding-top:12px">'+hd(c.h,c.s)+'</div><div style="margin:26px 24px 0;padding:28px 20px 24px;border-radius:28px;background:var(--tint);color:var(--tintfg);text-align:center">'+c.vis()+'</div><div class="pad" style="padding-top:22px">'+ben+'</div><div style="margin:12px 24px 0;padding:4px 20px;border-radius:20px;background:var(--chip)">'+c.facts.map(x=>rw(x[0],x[1])).join('')+'</div><div class="pad fine" style="padding-top:16px">'+c.fine+'</div>',cta:{t:c.cta,fn:"pfNext('"+k+"')"}}},
terms:k=>{const c=P[k],f=F(k),all=f.ck.every(Boolean);
 return {b:'<div class="pad" style="padding-top:12px">'+disc(c.ic,64)+'<div class="h1" style="margin-top:18px">'+c.th()+'</div><div class="mu" style="font-size:16px;margin-top:8px">Review these before you begin.</div><div style="margin-top:20px;padding:2px 16px;border-radius:18px;background:var(--chip)">'+ckRow(all,"pfCkAll('"+k+"')",'Agree to all required terms','',1)+'</div><div style="margin-top:6px">'+c.docs().map((x,i)=>ckRow(f.ck[i],"pfCk('"+k+"',"+i+")",x[0]+req,x[1])).join('')+'</div><div class="sm mu" style="margin-top:12px;line-height:20px">'+c.key+'</div></div>',cta:{t:'Agree',fn:"pfNext('"+k+"')",dis:!all}}},
ask:k=>({b:'<div class="pad" style="padding-top:40px">'+disc('verify',72)+'<div class="h1" style="margin-top:22px">Did you understand<br>everything?</div><div class="mu" style="font-size:16px;line-height:24px;margin-top:10px">If you agree without understanding, it can be hard to use your rights later.</div></div>',cta:{t:'I understand',fn:"pfNext('"+k+"')"},sec:{t:'Read again',fn:"pfPrev('"+k+"')"}}),
review:k=>{const r=P[k].rev();return {b:'<div class="pad" style="padding-top:12px">'+hd(r.h)+'<div style="margin-top:20px;padding:4px 20px;border-radius:20px;background:var(--chip)">'+r.rows.map(x=>rw(x[0],x[1])).join('')+'</div>'+(r.note?note(r.note):'')+(r.err?note(r.err,1):'')+'</div>',cta:{t:r.cta,fn:"pfNext('"+k+"')",dis:!!r.err}}},
done:k=>{const r=P[k].dn();return {b:'<div class="pad" style="padding-top:24px"><div class="pfpop" style="display:flex">'+disc(P[k].ic,96)+'</div><div class="h1" style="margin-top:24px">'+r.h+'</div><div class="mu" style="font-size:16px;line-height:24px;margin-top:10px">'+r.s+'</div></div>',cta:{t:r.p[0],fn:r.p[1]},sec:r.q?{t:r.q[0],fn:r.q[1]}:null}}
};
const compose=(k,s,r)=>{const c=P[k],n=c.steps.length-1,i=c.steps.indexOf(s);
 const prog=(s==='intro'||s==='done')?'':'<div role="progressbar" aria-label="Progress" aria-valuemin="0" aria-valuemax="'+n+'" aria-valuenow="'+i+'" style="height:3px;margin:0 24px;border-radius:2px;background:var(--chip)"><div style="height:3px;border-radius:2px;background:var(--br);width:'+Math.round(i/n*100)+'%;transition:width .3s"></div></div>';
 const top=s==='done'?'<div style="height:56px"></div>':bar('');
 const btn=r.cta?'<button class="btn" id="pfgo" '+(r.cta.dis?'disabled ':'')+'onclick="'+r.cta.fn+'" style="white-space:nowrap">'+r.cta.t+'</button>':'';
 const sec=r.sec?'<button class="btn sec2" style="margin-top:8px;white-space:nowrap" onclick="'+r.sec.fn+'">'+r.sec.t+'</button>':'';
 return top+prog+r.b+'<div style="height:'+(r.sec?190:120)+'px"></div><div class="cta">'+btn+sec+'</div>'};
const page=(k,s)=>compose(k,s,(G[s]||P[k].pg[s])(k));

/* ---------- 12-month deposit ---------- */
P.dep={ic:'lock',steps:['intro','amount','terms','ask','review','done'],d0:()=>({a:100000}),
 h:'Get your interest<br>today',s:'Lock money for 12 months. We pay the interest first and keep your money safe until it unlocks.',
 vis:()=>ring('lock')+big('+8,000 RWF')+cap('paid to you today when you lock 100,000 RWF (sample rate 8.0%)'),
 ben:[['bolt','Interest comes first','8.0% a year, paid into your account the same day.'],['lock','Locked, so it can grow','Your money stays put until it unlocks, so it is harder to spend by mistake.'],['coin','No fees','Free to open. Nothing to pay later.']],
 facts:[['Locked for','12 months'],['Rate (sample)','8.0% a year'],['Cost','Free']],
 fine:'Rates are sample data for this prototype. No real money moves.',cta:'Open a deposit',
 th:()=>'Start earning today<br>with a 12-month deposit',
 docs:()=>[['Deposit terms','Your principal stays locked for 12 months. You can’t take it out early.'],['Product description','We pay 8.0% interest upfront (sample rate) and hold your principal.'],['Privacy policy','We use your details only to run this deposit and follow banking rules.']],
 key:'It is free to open. Your principal stays locked for 12 months. This is a prototype and no real money moves.',
 pg:{amount:()=>{const d=F('dep').d,i=Math.round(d.a*.08),low=d.a>S.bank;
  return {b:'<div class="pad" style="padding-top:12px">'+hd('How much do you<br>want to lock?','You get the interest today.')+grp([50000,100000,250000,500000].map(a=>opt(d.a===a,"pfSet('dep','a',"+a+")",fmt(a)+' RWF','+'+fmt(Math.round(a*.08))+' RWF today')).join(''))+note(low?'That is more than your bank balance of '+fmt(S.bank)+' RWF. Pick a smaller amount.':'From itunda Bank. Balance after: '+fmt(S.bank-d.a+i)+' RWF.',low)+'</div>',cta:{t:'Next',fn:"pfNext('dep')",dis:low}}}},
 rev:()=>{const a=F('dep').d.a,i=Math.round(a*.08),low=a>S.bank;
  return {h:'Lock '+fmt(a)+' RWF<br>for 12 months?',rows:[['Locked amount',fmt(a)+' RWF'],['Interest paid today','+'+fmt(i)+' RWF'],['Unlocks','12 months from today'],['Paid from','itunda Bank'],['Bank balance after',fmt(S.bank-a+i)+' RWF']],note:'You can’t take the principal out before it unlocks.',err:low?'That is more than your bank balance of '+fmt(S.bank)+' RWF. Go back and pick a smaller amount.':'',cta:'Lock '+fmt(a)+' RWF'}},
 dn:()=>{const D=S.dep||{a:0,i:0};return {h:'Your deposit<br>is open',s:fmt(D.i)+' RWF interest is already in your account. Your '+fmt(D.a)+' RWF unlocks 12 months from today.',p:['See my deposit',"pfEnd('dep')"]}}};

/* ---------- SACCO shares ---------- */
P.sacco={ic:'bank',steps:['intro','shares','terms','ask','review','done'],d0:()=>({n:1}),
 h:'Own a part of<br>your cooperative',s:'Buy shares in your SACCO. When it makes a surplus, you get a dividend.',
 vis:()=>ring('bank')+big('5,000 RWF')+cap('for one share, with about 300 RWF a year in dividend (sample)'),
 ben:[['bank','Own part of your SACCO','Each share is a small stake in your cooperative.'],['coin','Earn a dividend','A share of the surplus is paid to you each year, when there is one.'],['cal','Take it out at year end','Withdraw your shares when the year closes.']],
 facts:[['Share price','5,000 RWF'],['Dividend (sample)','6% a year'],['Withdrawals','At year end']],
 fine:'Dividend and terms are sample data for this prototype. No real money moves.',cta:'Buy my first share',
 th:()=>'Become an owner<br>with SACCO shares',
 docs:()=>[['Share terms','Each share is 5,000 RWF. You can withdraw your shares at year end.'],['Dividend policy','A dividend is paid only when the SACCO makes a surplus. 6% is a sample rate.'],['Privacy policy','We use your details only to record your shares and follow banking rules.']],
 key:'It is free to join. You can withdraw at year end. This is a prototype and no real money moves.',
 pg:{shares:()=>{const n=F('sacco').d.n,cost=n*5000,low=cost>S.bank;
  return {b:'<div class="pad" style="padding-top:12px">'+hd('How many shares<br>do you want?','Each share is 5,000 RWF.')+grp([1,2,5,10].map(k=>opt(n===k,"pfSet('sacco','n',"+k+")",k+(k>1?' shares':' share'),fmt(k*5000)+' RWF')).join(''))+note(low?'That is more than your bank balance of '+fmt(S.bank)+' RWF. Pick fewer shares.':'From itunda Bank. About '+fmt(Math.round(cost*.06))+' RWF a year in dividend (sample). Balance after: '+fmt(S.bank-cost)+' RWF.',low)+'</div>',cta:{t:'Next',fn:"pfNext('sacco')",dis:low}}}},
 rev:()=>{const n=F('sacco').d.n,cost=n*5000,low=cost>S.bank;
  return {h:'Buy '+n+(n>1?' shares':' share')+'<br>for '+fmt(cost)+' RWF?',rows:[['Shares',String(n)],['Price for each','5,000 RWF'],['Total',fmt(cost)+' RWF'],['Dividend (sample)','6% a year'],['Paid from','itunda Bank'],['Bank balance after',fmt(S.bank-cost)+' RWF']],note:'You can withdraw your shares at year end.',err:low?'That is more than your bank balance of '+fmt(S.bank)+' RWF. Go back and pick fewer shares.':'',cta:'Buy '+n+(n>1?' shares':' share')}},
 dn:()=>{const n=+S.sh||0;return {h:'You now own<br>'+n+(n===1?' share':' shares'),s:'Your dividend is paid when the SACCO makes a surplus. You can withdraw at year end.',p:['See my shares',"pfEnd('sacco')"]}}};

/* ---------- Youth account ---------- */
P.yth={ic:'child',steps:['intro','name','age','limit','terms','ask','review','done'],d0:()=>({nm:'',age:'',l:3000,lt:0}),
 h:'A first bank account<br>for your child',s:'Your child learns to spend and save. You stay in charge of every limit.',
 vis:()=>ring('child')+big('3,000 RWF')+cap('weekly spending limit, set by you'),
 ben:[['lock','You set the limit','Choose how much can be spent each week. Change it any time.'],['plus','You add the money','Send money from your bank balance in seconds. Nothing moves without you.'],['verify','Extra requests need your OK','Your child can ask for more. You approve or decline each request.']],
 facts:[['For','Children under 18'],['In charge','You (parent)'],['Cost','Free']],
 fine:'Sample account for this prototype. No real money moves.',cta:'Open a youth account',
 th:()=>'Open a first account<br>for '+(e(F('yth').d.nm.trim())||'your child'),
 docs:()=>{const n=e(F('yth').d.nm.trim())||'your child';return [['Youth account terms','You open and manage the account. '+n+' can spend within the limit you set.'],['Parent consent','You confirm you are the parent or legal guardian of '+n+'.'],['Privacy policy','We keep '+n+'’s details private and use them only to run this account.']]},
 key:'It is free. You stay in charge of the limit. This is a prototype and no real money moves.',
 pg:{
  name:()=>{const d=F('yth').d;return {b:'<div class="pad" style="padding-top:12px">'+hd('What’s your child’s<br>first name?','This is the name on the account.')+'<input id="pfnm" value="'+e(d.nm)+'" maxlength="20" autocomplete="off" aria-label="Child’s first name" placeholder="First name" oninput="pfName(this.value)" onkeydown="if(event.key===\'Enter\')document.getElementById(\'pfgo\').click()"></div>',cta:{t:'Next',fn:"pfNext('yth')",dis:d.nm.trim().length<2}}},
  age:()=>{const d=F('yth').d,n=e(d.nm.trim());return {b:'<div class="pad" style="padding-top:12px">'+hd('How old is '+n+'?','We use this to suggest a spending limit.')+grp(['7–9','10–12','13–15','16–17'].map(a=>opt(d.age===a,"pfSet('yth','age','"+a+"')",a+' years','')).join(''))+'</div>',cta:{t:'Next',fn:"pfNext('yth')",dis:!d.age}}},
  limit:()=>{const d=F('yth').d;return {b:'<div class="pad" style="padding-top:12px">'+hd('Set a weekly<br>spending limit','You can change it any time.')+grp([1000,3000,5000].map(v=>opt(d.l===v,"pfSet('yth','l',"+v+")",fmt(v)+' RWF',SUG[d.age]===v?'Suggested':'')).join(''))+note(e(d.nm.trim())+' can spend up to this much each week. Anything extra needs your OK.')+'</div>',cta:{t:'Next',fn:"pfNext('yth')"}}}},
 rev:()=>{const d=F('yth').d,n=e(d.nm.trim());return {h:'Open an account<br>for '+n+'?',rows:[['Child',n],['Age group',d.age+' years'],['In charge','You (parent)'],['Weekly spending limit',fmt(d.l)+' RWF'],['Cost','Free']],note:'You can change the limit any time.',err:'',cta:'Open account for '+n}},
 dn:()=>{const Y=S.yth||{n:''},n=e(Y.n);return {h:n+'’s account<br>is ready',s:'Add money to get started. You can change the limit any time.',p:['Send first allowance',"pfEnd('yth',1)"],q:['Maybe later',"pfEnd('yth')"]}}};

/* ---------- Ikimina ---------- */
P.ikim={ic:'users',steps:['intro','terms','ask','done'],d0:()=>({}),
 h:'Save together,<br>take turns',s:'Everyone in the group puts in the same amount each round. Each round, one member takes the whole pot.',
 vis:()=>'<div style="display:flex;justify-content:center;gap:6px">'+Array.from({length:8},(_,i)=>'<span style="width:30px;height:30px;border-radius:50%;display:grid;place-items:center;font-size:13px;font-weight:800;background:'+(i===4?'var(--br)':'var(--bg)')+';color:'+(i===4?'var(--on)':'var(--tintfg)')+'">'+(i+1)+'</span>').join('')+'</div>'+big('80,000 RWF')+cap('pot each round, from 8 people paying 10,000 RWF. Each number is a round. You take the pot in round 5.'),
 ben:[['users','Everyone pays, everyone gets a turn','Each member takes the pot once. You see the order before you join.'],['bell','Remind members in one tap','See who has not paid and send a reminder.'],['verify','Clear for everyone','Dues and the payout order are always in view.']],
 facts:[['Group','Umurenge Savers, 8 members'],['Each round','10,000 RWF, due Friday'],['Your turn','Round 5 of 8']],
 fine:'Sample group for this prototype. No real money moves.',cta:'Join Umurenge Savers',
 th:()=>'Start saving together<br>with an ikimina',
 docs:()=>[['Group rules','Everyone pays 10,000 RWF each round. One member takes the whole pot each round.'],['Payout order','Members take turns in a set order. You receive the pot in round 5 of 8.'],['Privacy policy','Group members see your name and whether you have paid.']],
 key:'It is free to join. You pay 10,000 RWF each round, by Friday. This is a prototype and no real money moves.',
 pg:{},rev:null,
 dn:()=>({h:'You joined<br>Umurenge Savers',s:'Your turn is round 5 of 8. Pay 10,000 RWF each round, by Friday.',p:['See the group',"pfEnd('ikim')"]})};

/* ---------- 26-Week Savings (light: nothing is locked) ---------- */
P.w26={ic:'cal',steps:['intro','review','done'],d0:()=>({}),
 h:'Save a little more<br>every week',s:'Start with 500 RWF. Add 500 RWF more each week. After 26 weeks you have saved 175,500 RWF.',
 vis:()=>'<div style="display:flex;justify-content:center;align-items:flex-end;gap:3px;height:64px" aria-hidden="true">'+Array.from({length:26},(_,i)=>'<span style="width:6px;border-radius:3px;height:'+Math.round((i+1)/26*64)+'px;background:'+(i===0?'var(--br)':'var(--bg)')+'"></span>').join('')+'</div>'+big('175,500 RWF')+cap('saved after 26 weeks, from 500 RWF in week 1 to 13,000 RWF in week 26'),
 ben:[['up','Small steps, big total','Week 1 is 500 RWF. Week 26 is 13,000 RWF.'],['coin','A bonus every 4th week','We add a bonus to your savings every fourth week.'],['cal','Go at your own pace','Save once a week from your bank balance. Start over any time.']],
 facts:[['Week 1','500 RWF'],['Week 26','13,000 RWF'],['Cost','Free']],
 fine:'Sample savings for this prototype. No real money moves.',cta:'Start saving',
 th:()=>'',docs:()=>[],key:'',pg:{},
 rev:()=>{const low=500>S.bank;return {h:'Save 500 RWF<br>for week 1?',rows:[['Week 1','500 RWF'],['Total after 26 weeks','175,500 RWF'],['Paid from','itunda Bank'],['Bank balance after',fmt(S.bank-500)+' RWF']],note:'Save once a week. Every 4th week we add a bonus.',err:low?'That is more than your bank balance of '+fmt(S.bank)+' RWF.':'',cta:'Save 500 RWF'}},
 dn:()=>({h:'Week 1<br>is saved',s:'Next week is 1,000 RWF. Come back each week to keep going.',p:['See my 26 weeks',"pfEnd('w26')"]})};

/* ---------- what happens at the end of each flow ---------- */
const fin=(k,fn)=>{const f=F(k);f.done=1;f.i=P[k].steps.length-1;fn()};
const FIN={
 dep:()=>fin('dep',()=>{S.da=F('dep').d.a;depDo()}),
 sacco:()=>fin('sacco',()=>buySh(F('sacco').d.n)),
 yth:()=>fin('yth',()=>{const d=F('yth').d;S.yn=d.nm.trim();S.ya=d.age;S.yth={n:d.nm.trim(),bal:0,l:d.l};render('push')}),
 ikim:()=>fin('ikim',()=>{S.ikJ=1;render('push');setTimeout(confetti,200)}),
 w26:()=>fin('w26',()=>{S.pfD.w26=1;save26()})
};

/* ---------- handlers ---------- */
window.pfNext=k=>{const c=P[k],f=F(k),nx=c.steps[f.i+1];if(!nx)return;if(nx==='done'){FIN[k]();return}f.i++;render('push');if(nx==='name')setTimeout(()=>{const x=document.getElementById('pfnm');if(x)x.focus()},330)};
window.pfPrev=k=>{const f=F(k);if(f.i>0){f.i--;render('pop')}};
window.pfSet=(k,x,v)=>{const f=F(k);f.d[x]=v;if(k==='yth'&&x==='age'&&!f.d.lt)f.d.l=SUG[v]||3000;if(k==='yth'&&x==='l')f.d.lt=1;render('fade-none')};
window.pfCk=(k,i)=>{const f=F(k);f.ck[i]=f.ck[i]?0:1;render('fade-none')};
window.pfCkAll=k=>{const f=F(k),v=f.ck.every(Boolean)?0:1;f.ck=f.ck.map(()=>v);render('fade-none')};
window.pfName=v=>{const f=F('yth');f.d.nm=String(v).replace(/[<>&"]/g,'').slice(0,20);const b=document.getElementById('pfgo');if(b)b.disabled=f.d.nm.trim().length<2};
window.pfEnd=(k,send)=>{const f=F(k);f.done=0;f.ck=[0,0,0];render('fade-none');if(send){S.ysd=S.ysd||2000;setTimeout(()=>{if(typeof ythSendReview==='function')ythSendReview()},260)}};

/* ---------- hook the five screens; fr and rw keep the old pages ---------- */
Object.keys(P).forEach(k=>{const o=screens[k];if(typeof o!=='function')return;
 screens[k]=function(){if(S.lang!=='en')return o.apply(this,arguments);const f=S.pf[k];
  if(f&&f.done)return page(k,'done');
  if(!started(k))return page(k,P[k].steps[F(k).i]);
  return o.apply(this,arguments)}});
const _bk=window.back;
window.back=function(){const k=S.stack&&S.stack[S.stack.length-1];
 if(S.lang==='en'&&P[k]){const f=S.pf[k];
  if(f&&f.done){f.done=0;f.ck=[0,0,0];render('fade-none');return}
  if(!started(k)&&f&&f.i>0){f.i--;render('pop');return}}
 return _bk.apply(this,arguments)};
if(!document.getElementById('pf846')){const st=document.createElement('style');st.id='pf846';
 st.textContent='@keyframes pfpop{0%{transform:scale(.6);opacity:0}70%{transform:scale(1.08);opacity:1}100%{transform:scale(1);opacity:1}}.pfpop{animation:pfpop .5s cubic-bezier(.2,.8,.2,1)}@media(prefers-reduced-motion:reduce){.pfpop{animation:none}}.pfb:focus-visible{outline:2px solid var(--br);outline-offset:2px}#pfnm{width:100%;height:56px;margin-top:24px;padding:0 16px;border:0;border-radius:16px;background:var(--chip);color:var(--tx);font:inherit;font-size:18px;font-weight:700;box-sizing:border-box;outline:none}#pfnm:focus-visible{box-shadow:inset 0 0 0 2px var(--br)}';
 document.head.appendChild(st)}
})()}catch(err){console.error('v846',err)}
</script>
<script id="v839-title">/* v839: the tab title is set once here, last, so it always matches the file name. An old script used to force "v766 toss home" 800 ms after load. */(function(){var T="itunda, clickable prototype v933";function f(){try{document.title=T}catch(e){}}f();setTimeout(f,900);setTimeout(f,2500)})()</script>
<script>document.title='itunda, clickable prototype v846'</script><style id="v848">/* v848: Home (Bank tab), Toss style. A total at the top, bigger amounts with a quiet currency, light-purple pills (like Toss's blue Send pill) instead of grey, a smaller invite banner. */
.t848{padding:12px 24px 8px}
.t848 .l{font-size:15px;line-height:22px;font-weight:600;color:var(--mu)}
.t848 .n{font-size:34px;line-height:44px;font-weight:800;letter-spacing:-1px;color:var(--tx);margin-top:2px}
.t848 .n span{font-size:17px;font-weight:700;color:var(--mu);letter-spacing:0;margin-left:4px}
#phone#phone#phone #sc.h9 .hc .hr .ha{font-size:22px!important;line-height:30px!important;font-weight:800!important;letter-spacing:-.5px}
#phone#phone#phone #sc.h9 .hc .hr .ha .cu{font-size:14px!important;font-weight:600!important;color:var(--mu)!important;margin-left:3px}
#phone#phone#phone #sc.h9 .hc .hr .hp,#phone#phone#phone #sc.h9 .hc .hr .hp.pr{height:36px!important;min-width:64px;padding:0 16px!important;border:0!important;border-radius:18px!important;background:var(--tint)!important;color:var(--tintfg)!important;font-size:14px!important;font-weight:700!important}
#phone#phone#phone #sc.h9 .hc.nud .ni{width:40px;height:40px;border-radius:20px}
#phone#phone#phone #sc.h9 .hc.nud .nt b{font-size:16px;line-height:22px}
#phone#phone#phone #sc.h9 .hc.nud .nt small{font-size:13px;line-height:18px}
#phone#phone#phone #sc.h9 .hc.nud .nb{padding:14px 8px 14px 20px}
</style>
<script id="v848s">
try{(function(){
if(typeof screens==='undefined'||!screens.home||typeof S==='undefined'||typeof fmt!=='function')return;
/* rw and fr need native review */
const L=()=>S.lang==='fr'?'Mon argent':S.lang==='rw'?'Amafaranga yanjye':'My money';
const _h=screens.home;
screens.home=function(){const h=String(_h.apply(this,arguments));
 try{if(h.indexOf('t848')>=0)return h;
  const i=h.indexOf('<div class="hc');if(i<0)return h;
  const tot=(+S.bank||0)+(+S.pay||0);
  return h}catch(e){return h}};
if(typeof render==='function')render('fade-none');
document.title=document.title.replace(/v\d+/,'v848');
})()}catch(e){console.error('v848',e)}
</script>
<style id="v849">/* v849: itunda themes in Toss style, with the group account's palette. Same layout and type as before; neutrals are now purple-tinted greys (not blue greys) in light and dark, so the app, the group account and the purple accent look like one product. */
:root{--bg:#fff;--tx:#191F28;--mu:#6B7684;--tt:#6B7684;--ln:#E5E8EB;--chip:#F2F4F6;--page:#F2F4F6}
@media (prefers-color-scheme:dark){:root:not([data-theme=light]){--bg:#17171C;--tx:#F9FAFB;--mu:#9EA4AE;--tt:#9EA4AE;--ln:#3A3A44;--chip:#2C2C35;--page:#101013}}
:root[data-theme=dark]{--bg:#17171C;--tx:#F9FAFB;--mu:#9EA4AE;--tt:#9EA4AE;--ln:#3A3A44;--chip:#2C2C35;--page:#101013}
@media (prefers-color-scheme:dark){:root:not([data-theme=light]) #phone#phone{--hc775:#17171C;--tile775:#333D4B;--pg775:#101013}}
:root[data-theme=dark] #phone#phone{--hc775:#17171C;--tile775:#333D4B;--pg775:#101013}
</style><style id="v850">/* v850: Send, Who screen, Toss style: one white page like the amount screen (no grey page with a white box), the number field as a soft filled field, and the contact list as plain rows. */
#phone#phone #sc:has(#rcv){background:var(--bg)!important}
#phone#phone #sc:has(#rcv) .bar{background:var(--bg)!important}
#phone#phone #sc:has(#rcv) .field{background:var(--chip)!important;border:0!important;border-radius:16px;box-shadow:none!important;padding:12px 18px!important;margin:8px 24px 0!important}
#phone#phone #sc:has(#rcv) #rcv{font-size:20px!important;font-weight:700!important}
#phone#phone #sc:has(#rcv) .row{padding-left:24px!important;padding-right:24px!important}
#phone#phone #sc:has(#rcv) .field{margin-top:16px!important}
#phone#phone #sc:has(#rcv) .sec{background:none!important;box-shadow:none!important;border-radius:0!important;margin-left:0!important;margin-right:0!important;padding-left:0!important;padding-right:0!important}
</style><style id="v851">/* v851: Toss buttons are flat. The itunda lavender stays, but the gloss gradient, top highlight and coloured glow under the main buttons are removed. */
#phone#phone .btn:not(.sec2):not(:disabled){background-image:none!important;box-shadow:none!important}
#phone#phone #view:has(.keys)>.cta{padding:8px 16px 4px!important;background:var(--bg)!important;border:0!important}
#phone#phone #view:has(.keys)>.cta .btn{border-radius:16px!important;height:54px!important}
</style><style id="v853">/* v853: cards follow the group account home: solid cards, 24px corners, no border or shadow, and icon tiles with the soft itunda gradient. */
#phone#phone #sc .hc .hi{background:linear-gradient(145deg,var(--tint),color-mix(in srgb,var(--tint) 75%,var(--lk)))!important;border-radius:14px!important}
</style><style id="v854">/* v854: Settings, Toss style. One white page, no boxed cards, small grey section labels, plain rows without divider lines. */
#phone#phone #sc:has(.stc){background:var(--bg)!important}
#phone#phone #sc:has(.stc) .bar{background:var(--bg)!important}
#phone#phone #sc:has(.stc) .prof{background:none!important;box-shadow:none!important;border:0!important;margin:0!important;padding:8px 24px 20px!important}
#phone#phone #sc:has(.stc) .stc{background:none!important;box-shadow:none!important;border:0!important;border-radius:0!important;margin:0!important;padding:0 0 8px!important}
#phone#phone #sc:has(.stc) .stc .agt{padding:20px 24px 6px!important;margin:0!important;font-size:13px!important;line-height:18px!important;font-weight:700!important;color:var(--mu)!important}
#phone#phone #sc:has(.stc) .stc .ar{padding-left:24px!important;padding-right:24px!important;border:0!important;background-image:none!important}
#phone#phone #sc:has(.stc) .stc .ar::after,#phone#phone #sc:has(.stc) .stc .ar::before{background:none!important;border:0!important}
</style><style id="v855">/* v855: Pay tab, itunda colours. The blue tip bubble and the blue tap button and rings become itunda lavender; the tap card ring is purple; the navy dark of the Pay page matches the purple-tinted dark of the rest of the app. */
#phone#phone .pctip{background:var(--br)!important;color:var(--on)!important}
#phone#phone .pctip::after,#phone#phone .pctip::before{border-top-color:var(--br)!important}
#phone#phone .rg.r3{background:var(--br)!important;color:var(--on)!important}
#phone#phone .rg.r1,#phone#phone .rg.r2{background:color-mix(in srgb,var(--br) 16%,transparent)!important}
#phone#phone .tpf{background:linear-gradient(#17171C,#17171C) padding-box,linear-gradient(135deg,#8F89FF,#E0A8FF) border-box!important}
</style><style id="toss-login-2">
/* v861 Toss-style pass 2 for login & sign-up.
   Solid brand button with white text, grey disabled state, quiet underline fields, left-aligned PIN screens, check-only consent rows. */
#view:has(#phv) .cta .btn,#view:has(.nm94) .cta .btn,#view:has(.dots6) .cta .btn,#view:has(.g3) .cta .btn,#phone #layer .sheet.v6pg:has(#tcgo) #tcgo{
  background:var(--lk)!important;color:#fff!important;height:56px!important;border-radius:16px!important;font-size:17px!important;font-weight:700!important;letter-spacing:-.01em;box-shadow:none!important;opacity:1!important;transition:background .15s,transform .12s}
#view:has(#phv) .cta .btn:active:not(:disabled),#view:has(.nm94) .cta .btn:active:not(:disabled),#view:has(.g3) .cta .btn:active,#phone #layer .sheet #tcgo:active:not(:disabled){transform:scale(.98)}
#phone #view:has(#phv) > .cta .btn:disabled,#phone #view:has(.nm94) > .cta .btn:disabled,#view:has(#phv) .cta .btn:disabled,#view:has(.nm94) .cta .btn:disabled,#view:has(.dots6) .cta .btn:disabled,#phone #layer .sheet.v6pg:has(#tcgo) #tcgo:disabled{background:var(--chip)!important;color:var(--tt)!important;cursor:default}
:root[data-theme=dark] #view:has(#phv) .cta .btn:not(:disabled),:root[data-theme=dark] #view:has(.nm94) .cta .btn:not(:disabled),:root[data-theme=dark] #view:has(.g3) .cta .btn,:root[data-theme=dark] #phone #layer .sheet #tcgo:not(:disabled){background:var(--br)!important;color:var(--on)!important}
/* fields: no focus box, underline takes the brand colour */
#sc .nm94:focus,#sc .nm94:focus-visible{outline:0!important;box-shadow:none!important;border-bottom-color:var(--lk)!important}
#sc .nm94::placeholder{color:var(--tt);font-weight:600}
#sc:has(#phv) .field.phf{border-bottom-color:var(--lk)!important}
#sc:has(#phv) #phv{font-weight:700!important}
/* keypad: medium weight, bigger touch targets */
#sc:has(#phv) .keys button,#sc:has(.dots6) .keys button{font-weight:500!important;font-size:26px!important}
/* PIN and login: everything on the left edge, same as the titles */
#sc:has(.dots6) #p176{text-align:left!important;padding:12px 24px 0;font-size:14px;font-weight:500!important;color:var(--tt)}
#sc:has(.dots6) .dots6 i{width:16px;height:16px}
#sc:has(.dots6) .lk94 button{color:var(--tt);font-weight:600;text-decoration:underline;text-underline-offset:3px}
#sc:has(.dots6) .lk94 i{display:none}
#sc:has(.dots6) .lk94{gap:18px}
/* done screen: bigger title */
#sc:has(.g3) .h1{font-size:28px;line-height:1.38;letter-spacing:-.02em;font-weight:800}
/* consent: Toss bottom sheet. Hugs its content at the bottom, check-only rows, grey until ticked */
#phone #layer .sheet.v6pg:has(#tcgo){box-shadow:0 0 0 120vmax rgba(0,0,0,.45)!important;animation:tossUp .28s cubic-bezier(.2,.8,.2,1) both!important;top:auto!important;bottom:0!important;height:auto!important;max-height:86%;border-radius:24px 24px 0 0!important;padding:28px 24px 28px!important}
#phone #layer .sheet.v6pg:has(#tcgo) .h1{font-size:24px!important;line-height:1.35!important;letter-spacing:-.02em;font-weight:800}
#phone #layer .sheet.v6pg:has(#tcgo) #tr_all{background:var(--chip)!important;border-radius:16px!important;padding:16px!important}
#phone #layer .sheet.v6pg:has(#tcgo) #tr_all .cb{width:28px;height:28px;border-radius:50%}
#phone #layer .sheet.v6pg:has(#tcgo) .row:not(#tr_all) .cb{border:0!important;background:none!important;width:28px;height:28px;position:relative;color:var(--ln)}
#phone #layer .sheet.v6pg:has(#tcgo) .row:not(#tr_all) .cb:not(.on)::after{content:"";width:12px;height:7px;border-left:2.5px solid #C9CDD4;border-bottom:2.5px solid #C9CDD4;transform:rotate(-45deg) translate(1px,-1px)}
#phone #layer .sheet.v6pg:has(#tcgo) .row:not(#tr_all) .cb.on svg{stroke:var(--lk)!important;width:22px;height:22px}
#phone #layer .sheet.v6pg:has(#tcgo) .row:not(#tr_all) .cb.on{color:var(--lk)}
#phone #layer .sheet.v6pg:has(#tcgo) .row:not(#tr_all){padding:10px 0!important}
#phone #layer .sheet.v6pg:has(#tcgo) .row:not(#tr_all) div[style*="font-weight:600"]{font-weight:500!important;font-size:16px!important}
#phone #layer .sheet.v6pg:has(#tcgo) #tcgo{margin-top:8px}
#phone #layer .sheet.v6pg:has(#tcgo) .v6h{display:none!important}
#phone #layer .sheet.v6pg:has(#tcgo)::before{content:"";display:block;width:36px;height:4px;border-radius:2px;background:var(--ln);margin:-14px auto 18px}
@keyframes tossUp{from{transform:translateY(40px);opacity:0}to{transform:none;opacity:1}}
#phone #layer .sheet.v6pg:has(#tcgo) .v6b{padding-left:0!important;padding-right:0!important}
#phone #layer .sheet.v6pg:has(#tcgo) #tcgo{margin:8px 0 0!important;width:100%!important}
#phone #layer .sheet.v6pg:has(#tcgo) .v6cta{padding-left:0!important;padding-right:0!important;padding-bottom:0!important}
/* v862: errors are red and say so on the field, header strip is transparent, PIN dots use the stronger brand colour */
#phone #sc #phe[style*="--er"],#phone #sc #pe[style*="--er"]{color:var(--er)!important;font-weight:500}
#phone #view:has(#phe[style*="--er"]) .field.phf{border-bottom-color:var(--er)!important}
#phone #sc:has(#phv) .ahead{background:transparent!important}
#phone #sc:has(#phv) .ahead .chip{background:var(--chip);border-radius:999px;padding:8px 14px;font-weight:600}
#phone #sc:has(.dots6) .dots6 i.on{background:var(--lk)!important}
#phone #sc:has(.dots6) .dots6 i{transition:background .12s,transform .12s}
#phone #sc:has(.dots6) .dots6 i.on{transform:scale(1.08)}
#phone #sc:has(#phv) #phe,#phone #sc:has(#phv) .pad{max-width:none}
/* v863: wrong PIN flashes the dots red, login title fits one line, keyboard focus ring, reduced motion */
#phone #sc:has(.dots6) .dots6.shk i.on{background:var(--er)!important}
#phone #sc:has(.av94) .h1{max-width:none!important;font-size:26px}
#phone #sc:has(.av94) .av94{margin-bottom:16px!important}
#phone #sc:has(.dots6) .keys button:focus-visible,#phone #sc:has(#phv) .keys button:focus-visible{outline:2px solid var(--lk);outline-offset:-4px}
@media (prefers-reduced-motion:reduce){#phone #layer .sheet.v6pg:has(#tcgo){animation:none!important}#phone #sc:has(.dots6) .dots6 i{transition:none}}
/* v864: floating label on the name field */
#phone #sc .nl94{font-size:13px;font-weight:600;color:var(--tt);height:18px;margin:0 0 2px;opacity:0;transform:translateY(4px);transition:opacity .15s,transform .15s}
#phone #sc .nl94.on{opacity:1;transform:none}
#phone #sc .nl94,#phone #sc .nl94.on{color:var(--lk)!important}
/* v865: earlier answer stays visible under the new question (Toss progressive reveal) */
#phone #sc .pv94{margin:22px 0 0;padding:0 0 12px;border-bottom:1px solid var(--ln)}
#phone #sc .pv94 small{display:block;font-size:13px;font-weight:600;color:var(--tt);margin-bottom:4px}
#phone #sc .pv94 span{font-size:20px;font-weight:600;color:var(--mu);letter-spacing:-.01em}
/* v866: success screen, left-aligned like the questions, smaller check, white tick on solid brand */
#phone #sc:has(.g3)>div:first-child{align-items:flex-start!important;text-align:left!important;padding:clamp(48px,14vh,160px) 24px 0!important}
#phone #sc:has(.g3) .g3{width:88px;height:88px;display:block}
#phone #sc:has(.g3) .g3 svg,#phone #sc:has(.g3) .g3 img{width:100%!important;height:100%!important}
#phone #sc:has(.g3) .g3{margin-left:-6px}
#phone #sc:has(.g3) .g3 circle{fill:var(--lk)!important}
#phone #sc:has(.g3) .g3 path{stroke:#fff!important}
:root[data-theme=dark] #phone #sc:has(.g3) .g3 circle{fill:var(--br)!important}
#phone #sc:has(.g3) .h1{margin-top:24px!important}
#phone #sc:has(.g3) .mu{font-size:17px!important;margin-top:10px!important}
#phone #sc:has(.g3) .fine{margin-top:20px!important;color:var(--tt)}
/* v867: prototype shortcuts become small quiet pills so the real screen reads clean */
#phone #sc:has(#phv) a.sm{display:inline-flex!important;align-items:center;background:var(--chip);color:var(--tt)!important;font-size:13px!important;font-weight:600!important;text-decoration:none!important;padding:7px 12px;border-radius:999px;margin-top:16px!important}
#phone #sc:has(#phv) .ahead a.sm{margin-top:0!important}
#phone #sc:has(#phv) a.sm:active{background:var(--ln)}
/* v868: step indicator becomes one thin full-width bar (Toss). The label stays for screen readers through aria-label */
#phone #sc .v176{display:block!important;padding:4px 24px 0!important;margin:0!important}
#phone #sc .v176 .sg{display:flex!important;gap:3px;width:100%}
#phone #sc .v176 .sg i{flex:1 1 0;width:auto!important;height:3px!important;border-radius:2px;background:var(--ln)}
#phone #sc .v176 .sg i.on{background:var(--lk)!important}
#phone #sc .v176>span:not(.sg){position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
/* v869: loading state on the button is a spinner, not the word "Checking…" */
#phone #view:has(#phv)>.cta .btn.ld94:disabled,#phone #view:has(#phv) .cta .btn.ld94:disabled{background:var(--lk)!important;color:#fff!important;opacity:1!important}
:root[data-theme=dark] #phone #view:has(#phv) .cta .btn.ld94:disabled{background:var(--br)!important;color:var(--on)!important}
.btn.ld94 .sp94{display:inline-block;width:22px;height:22px;border:3px solid currentColor;border-right-color:transparent;border-radius:50%;animation:sp94 .7s linear infinite;vertical-align:middle;opacity:.9}
.btn.ld94 .sr94{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
@keyframes sp94{to{transform:rotate(360deg)}}
@media (prefers-reduced-motion:reduce){.btn.ld94 .sp94{animation-duration:1.6s}}
/* v870: dark mode fixes for the consent sheet */
:root[data-theme=dark] #phone #layer .sheet.v6pg:has(#tcgo) #tcgo:not(:disabled){background:var(--br)!important;color:var(--on)!important}
:root[data-theme=dark] #phone #layer .sheet.v6pg:has(#tcgo) #tcgo:disabled{background:var(--chip)!important;color:var(--tt)!important}
#phone #layer .sheet.v6pg:has(#tcgo) .v6cta,#phone #layer .sheet.v6pg:has(#tcgo) .v6b{background:transparent!important}
#phone #layer .sheet.v6pg:has(#tcgo) .v6cta::before,#phone #layer .sheet.v6pg:has(#tcgo) .v6cta::after{display:none!important}
/* v871: one title size across steps, scaled to the screen height so small phones keep the same rhythm */
#phone #sc:has(#phv) .h1,#phone #sc:has(.nm94) .h1,#phone #sc:has(.dots6) .h1{font-size:clamp(24px,3.4dvh,28px)!important;line-height:1.36!important}
#phone #sc:has(.av94) .h1{font-size:clamp(24px,3.1dvh,26px)!important}
</style>
<script id="toss-login-2-js">
(function(){try{
var ph=document.getElementById('phone')||document.body;
function wire(){var i=document.querySelector('#sc input.nm94');if(!i||i.dataset.fl)return;i.dataset.fl=1;
var l=document.createElement('div');l.className='nl94';l.setAttribute('aria-hidden','true');l.textContent=i.getAttribute('aria-label')||i.placeholder||'';
i.parentNode.insertBefore(l,i);
var u=function(){l.classList.toggle('on',!!i.value)};
i.addEventListener('input',u);i.addEventListener('focus',u);i.addEventListener('blur',u);u()}
function ld(){var b=document.getElementById('obnext');if(!b||b.classList.contains('ld94'))return;if(b.textContent.trim()!=='Checking\u2026')return;
b.classList.add('ld94');b.setAttribute('aria-busy','true');b.innerHTML='<span class="sp94" aria-hidden="true"></span><span class="sr94">Checking</span>'}
function rev(){var i=document.querySelector('#sc input.nm94');if(!i||document.querySelector('#sc .pv94'))return;var o=(typeof S!=='undefined')&&S.ob;if(!o||!o.ph)return;
var p=o.ph,f=[p.slice(0,3),p.slice(3,6),p.slice(6,9)].filter(Boolean).join(' ');
var lab=(typeof t==='function'&&t('ta')&&t('ta')!=='ta')?t('ta'):'Phone number';
var d=document.createElement('div');d.className='pv94';d.innerHTML='<small></small><span></span>';d.firstChild.textContent=lab;d.lastChild.textContent='+250 '+f;
i.parentNode.appendChild(d)}
new MutationObserver(function(){wire();rev();ld()}).observe(ph,{childList:true,subtree:true});wire();rev();
}catch(e){console.warn('toss-login-2',e)}})();
</script>
<style id="v879toss">
/* v879: Toss-style pass 8. Bank: row icons were shrunk to dots by a rule that hit nested svgs; Deposit / Send become Toss-like tinted + solid pair. */
#phone#phone .b705 .b7i svg svg[width="36"]{width:36px;height:36px}
#phone#phone .b705 .b7i svg svg[width="80"]{width:80px;height:80px}
#phone#phone .b705 .b7i svg svg[width="30"]{width:30px;height:30px}
#phone#phone .b705 .b7bt{gap:8px}
#phone#phone .b705 .b7bt button{height:52px;border-radius:14px;border:0;font-size:16px;font-weight:700;letter-spacing:-.3px;background:var(--tint);color:var(--tintfg)}
#phone#phone .b705 .b7bt button:last-child{background:var(--cta,#6258F5);color:var(--ctafg,#fff)}
#phone#phone .b705 .b7bt button:active{transform:scale(.98)}
#phone#phone .b705 .b7bt button:last-child:active{background:color-mix(in srgb,var(--cta,#6258F5) 88%,#000)}
#phone#phone .b705 .b7r{min-height:60px}
#phone#phone .b705 .b7r .t{font-size:17px;font-weight:600;letter-spacing:-.3px}
#phone#phone .b705 .b7v b{font-weight:500;color:var(--mu)}
/* v879b: Loan, Find tab. Two numbers in one soft card, smaller hero art, quieter segmented tabs, lighter rows. Pockets: tinted add pills, violet progress. */
#phone#phone .screen:has([onclick="lhStart()"]) [role=tablist]{padding:3px!important}
#phone#phone .screen:has([onclick="lhStart()"]) [role=tab]{min-width:96px!important;height:38px!important;font-size:15px!important;letter-spacing:-.3px}
#phone#phone .screen:has([onclick="lhStart()"]) [role=tab][aria-selected=true]{box-shadow:none!important}
#phone#phone .screen:has([onclick="lhStart()"]) .h1{font-size:26px;line-height:35px}
#phone#phone .screen:has([onclick="lhStart()"]) .pad+div[style*="gap:20px"]{margin:24px 20px 0;padding:18px 4px!important;gap:0!important;background:var(--chip);border-radius:20px}
#phone#phone .screen:has([onclick="lhStart()"]) div[style*="gap:20px"]>div{border-left:0!important;padding:0 16px!important;flex:1!important}
#phone#phone .screen:has([onclick="lhStart()"]) div[style*="gap:20px"]>div+div{border-left:1px solid var(--ln)!important}
#phone#phone .screen:has([onclick="lhStart()"]) div[style*="gap:20px"] .sm{font-size:13px;line-height:18px!important;min-height:36px}
#phone#phone .screen:has([onclick="lhStart()"]) div[style*="gap:20px"] div[style*="font-size:24px"]{font-size:22px!important;font-weight:700!important;letter-spacing:-.6px;white-space:nowrap;margin-top:6px!important;color:var(--tx)}
#phone#phone .screen:has([onclick="lhStart()"]) div[style*="padding:32px 0 28px"]{padding:20px 0 16px!important}
#phone#phone .screen:has([onclick="lhStart()"]) div[style*="padding:32px 0 28px"]>svg{width:96px;height:96px}
#phone#phone .screen:has([onclick="lhStart()"]) div[style*="height:14px"]{height:12px!important;margin-top:20px!important}
#phone#phone .screen:has([onclick="lhStart()"]) div[style*="min-height:74px"]{min-height:64px!important;gap:14px!important}
#phone#phone .screen:has([onclick="lhStart()"]) div[style*="min-height:74px"]>span:nth-child(2){font-size:17px!important;font-weight:600!important}
#phone#phone .pkchips .chip{background:var(--tint);color:var(--tintfg);border:0;border-radius:12px;font-weight:700;height:40px}
#phone#phone .pkchips .chip:active{background:color-mix(in srgb,var(--tintfg) 18%,var(--bg))}
#phone#phone .pkbar i{background:var(--cta,#6258F5)}
#phone#phone .pkrow:active{background:color-mix(in srgb,var(--tx) 5%,transparent);border-radius:16px}
#phone#phone .pkpn{font-size:15px;color:var(--mu);font-weight:500}
#phone#phone .pkpb{font-size:19px;font-weight:700;letter-spacing:-.5px}
/* v879c: 31-day savings: picked amount chip is solid violet with white text (was dark with violet text, low contrast). Explore: neutral grey canvas instead of lavender, softer search field, lighter group titles. */
#phone#phone .screen:has([onclick^="s31Pick"]) .chip{font-weight:700!important;background:var(--chip)!important;color:var(--tx)!important}
#phone#phone .screen:has([onclick^="s31Pick"]) .chip[aria-pressed=true]{background:var(--cta,#6258F5)!important;color:var(--ctafg,#fff)!important}
#phone#phone .screen:has([onclick^="s31Pick"]) .chip:active{transform:scale(.96)}
#phone#phone .screen:has(#sq){background:var(--tbg)!important}
#phone#phone .screen:has(#sq) .asr{border-radius:16px;height:48px}
#phone#phone .screen:has(#sq) .asr input{font-size:16px;font-weight:500;letter-spacing:-.3px}
#phone#phone .screen:has(#sq) .sech{font-size:18px;letter-spacing:-.4px}
/* v879d: Shop shortcut row (Daily draw / Deals / My orders / Rewards / Wishlist): labels no longer touch, quieter weight, evenly spaced. */
#phone#phone .sh879{display:flex!important;justify-content:space-between;gap:4px;padding:16px 12px 4px!important;overflow:hidden}
#phone#phone .sh879>button{flex:1 1 0!important;min-width:0!important;width:auto!important;padding:0 2px!important;font-size:12px!important;font-weight:600!important;letter-spacing:-.3px;color:var(--mu)!important;white-space:nowrap;text-overflow:ellipsis;overflow:hidden}
#phone#phone .sh879>button:active{transform:scale(.95)}
/* v879e: Pay hub. Nested icon graphics were shrunk to dots by a parent "svg" size rule, so inner svgs keep the size they declare. "Find stores" is a flat violet button (no gradient), header title uses the text colour. */
#phone#phone :is(.pm704 .pi,.z7sq,.z7mi,.z7e1,.mrow703) svg svg[width="80"]{width:80px;height:80px}
#phone#phone .z7go{background:var(--cta,#6258F5)!important;background-image:none!important;color:var(--ctafg,#fff)!important;border-radius:14px;height:44px;font-weight:700;letter-spacing:-.3px}
#phone#phone .z7go:active{background:color-mix(in srgb,var(--cta,#6258F5) 88%,#000)!important}
#phone#phone .z7e2{font-size:24px;font-weight:800;letter-spacing:-.8px}
#phone#phone .z7rt{font-weight:600;letter-spacing:-.3px}
#phone#phone .z7am{font-weight:500}
/* v879h: Bank. The "Start a savings goal" banner becomes a compact tinted card (was a large grey tile), and the savings-row icons that were shrunk by the parent svg rule (26-week savings etc.) get their size back. */
#phone#phone .b705 svg svg[width="80"]{width:80px;height:80px}
#phone#phone#phone .b705 .b7p{display:flex;align-items:center;gap:14px;margin:12px 20px;padding:16px;border-radius:20px;background:var(--tint)}
#phone#phone#phone .b705 .b7p .pi{width:56px;height:56px;border-radius:16px;background:var(--bg);display:flex;align-items:center;justify-content:center;flex:none}
#phone#phone#phone .b705 .b7p .pi>svg{width:36px;height:36px}
#phone#phone#phone .b705 .b7p b{font-size:17px;font-weight:700;letter-spacing:-.4px}
#phone#phone#phone .b705 .b7p .sb{font-size:14px;line-height:20px;color:var(--mu)}
#phone#phone#phone .b705 .b7p .v193h{color:var(--tintfg);font-weight:700;font-size:14px}
#phone#phone .b705 .b7p:active{transform:scale(.99)}
#phone#phone#phone#phone .b705 .b7i svg svg[width="36"]{width:36px!important;height:36px!important}
#phone#phone#phone#phone .b705 .b7i svg svg[width="64"]{width:64px!important;height:64px!important}
#phone#phone#phone#phone .b705 .b7i svg svg[width="80"]{width:80px!important;height:80px!important}
/* v879i: Amount (send). The source line is centred text, not a grey strip behind the words; the keypad digits are medium weight; the chips sit tighter under the number. */
#phone#phone#phone .screen:has(.keys) #msg{display:block;background:none!important;text-align:center;font-size:14px;color:var(--mu);font-weight:500;padding:0 24px;margin-top:10px}
#phone#phone#phone .screen:has(.keys) .keys button{font-size:26px!important;font-weight:500!important;letter-spacing:-.5px;color:var(--tx)!important}
#phone#phone#phone .screen:has(.keys) .keys button:active{background:color-mix(in srgb,var(--tx) 6%,transparent);border-radius:16px}
#phone#phone#phone .screen:has(.keys) .v420amt{font-size:48px;font-weight:700;letter-spacing:-1.8px}
#phone#phone#phone .screen:has(.keys) .v420amt span+span{font-weight:600;color:var(--mu)}
/* v879j: Sent (done). The success check is smaller and shares the 24px left edge with the amount and the detail card, like a Toss result page. */
#phone#phone#phone .screen:has(.g3 .check)>div:first-child{align-items:flex-start!important;padding-left:24px!important;padding-right:24px!important}
#phone#phone#phone .screen:has(.g3 .check) .g3{margin:0!important}
#phone#phone#phone .screen:has(.g3 .check) .check{width:72px!important;height:72px!important;border-radius:36px!important}
#phone#phone#phone .screen:has(.g3 .check) .check svg{width:40px!important;height:40px!important}
#phone#phone#phone .screen:has(.g3 .check)>div:first-child .h1{margin-top:20px!important;font-size:32px!important;line-height:40px!important;letter-spacing:-1px}
#phone#phone#phone .screen:has(.g3 .check)>div:first-child .mu{font-size:17px!important;margin-top:6px!important}
#phone#phone#phone .screen:has(.g3 .check)>div:nth-child(2){margin:28px 24px 0!important;padding:0!important;background:none!important;border-radius:0}
#phone#phone#phone .screen:has(.g3 .check)>div:nth-child(2)>div{height:56px!important;font-size:16px!important}
#phone#phone#phone .screen:has(.g3 .check)>div:nth-child(2)>div b{font-weight:600;letter-spacing:-.2px}
/* v879k: Activity. Neutral grey canvas, white search pill, violet selected filter, one-line names so amounts stay on the same line, money in is brand violet. */
#phone#phone#phone .screen:has(#aq){background:var(--tbg)!important}
#phone#phone#phone .screen:has(#aq) .asr{border-radius:16px;height:48px}
#phone#phone#phone .screen:has(#aq) .cch{height:36px!important;min-height:36px;padding:0 16px;font-size:14px!important;font-weight:600!important;border-radius:18px;background:var(--bg)!important;color:var(--mu)!important;border:0}
#phone#phone#phone .screen:has(#aq) .cch.on,#phone#phone#phone .screen:has(#aq) .cch[aria-pressed=true]{background:var(--cta,#6258F5)!important;color:var(--ctafg,#fff)!important}
#phone#phone#phone .screen:has(#aq) .row .t{font-size:16px;line-height:22px;font-weight:600;letter-spacing:-.3px;white-space:normal;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden}
#phone#phone#phone .screen:has(#aq) .row>div:nth-child(2){min-width:0;flex:1}
#phone#phone#phone .screen:has(#aq) .row .s{font-size:13px;color:var(--mu)}
#phone#phone#phone .screen:has(#aq) .row .r{font-size:16px;font-weight:700;letter-spacing:-.3px;white-space:nowrap}
#phone#phone#phone .screen:has(#aq) .row .r.in879{color:var(--tintfg)}
/* v879f: Settings. Toss lists: medium-weight 17px titles, grey value on the right, 14px section labels, a grey gap between groups, soft press. */
#phone#phone .screen:has(.prof) .stc .ar .t{font-size:17px;font-weight:500;letter-spacing:-.3px}
#phone#phone .screen:has(.prof) .stc .ar .s{font-size:13px;color:var(--mu);font-weight:400;margin-top:2px}
#phone#phone .screen:has(.prof) .stc .ar>span[style*="font-size:15px"]{color:var(--mu)!important;font-weight:500!important}
#phone#phone#phone#phone .screen:has(.prof) .stc .agt{font-size:14px!important;font-weight:600!important;color:var(--mu)!important;letter-spacing:-.2px!important;padding-top:12px}
#phone#phone .screen:has(.prof) .prof b{font-size:21px;font-weight:700;letter-spacing:-.6px}
#phone#phone .screen:has(.prof) .prof .s{font-size:14px;color:var(--mu)}
#phone#phone .screen:has(.prof) .stc .ar:active{background:color-mix(in srgb,var(--tx) 5%,transparent);border-radius:14px}
</style>
<script id="v879js">
(function(){try{
var ph=document.getElementById('phone')||document.body;
function tag(){var bs=ph.querySelectorAll('.screen button');for(var i=0;i<bs.length;i++){var b=bs[i];if(b.parentElement.classList.contains('sh879'))continue;
if(b.textContent.trim()==='Daily draw'){var p=b.parentElement;if(p.querySelectorAll(':scope>button').length>=4)p.classList.add('sh879')}}}
new MutationObserver(tag).observe(ph,{childList:true,subtree:true});tag();
}catch(e){console.warn('v879',e)}})();
</script>
<script id="v879lockup">
/* v879g: logo + wordmark share one line. The logo is centred on the cap height of the text beside it, measured from the real font (so it holds with Plus Jakarta Sans, the fallback font and any text size), instead of relying on fixed pixel nudges. */
(function(){try{
var ph=document.getElementById('phone')||document.body,cv=document.createElement('canvas').getContext('2d'),busy=0;
function fix(svg){
  var par=svg.parentElement;if(!par)return;
  var t=null,k=svg.nextElementSibling;while(k){if(k.tagName!=='SVG'&&k.textContent.trim()){t=k;break}k=k.nextElementSibling}
  if(!t)return;
  var r0=svg.getBoundingClientRect();if(!r0.width)return;
  var cs=getComputedStyle(t);cv.font=cs.fontWeight+' '+cs.fontSize+' '+cs.fontFamily;
  var cap=cv.measureText('H').actualBoundingBoxAscent;if(!cap)return;
  var pr=document.createElement('i');pr.style.cssText='display:inline-block;width:0;height:0;vertical-align:baseline;pointer-events:none';
  t.insertBefore(pr,t.firstChild);var base=pr.getBoundingClientRect().bottom;t.removeChild(pr);
  var bb;try{bb=svg.getBBox()}catch(e){return}
  var m=svg.getScreenCTM();if(!m||!bb.height)return;
  var ly=m.d*(bb.y+bb.height/2)+m.f;           /* centre of the logo ink, in screen px */
  var want=base-cap/2;                         /* centre of the capitals */
  var d=want-ly;if(Math.abs(d)<0.3)return;
  var old=parseFloat(svg.dataset.dy||'0')||0,n=Math.max(-8,Math.min(8,old+d));
  svg.dataset.dy=n;svg.style.transform='translateY('+n.toFixed(2)+'px)';
}
function run(){if(busy)return;busy=1;requestAnimationFrame(function(){busy=0;
  ph.querySelectorAll('svg[aria-label="itunda"]').forEach(fix);setTimeout(function(){ph.querySelectorAll('svg[aria-label="itunda"]').forEach(fix)},450)})}
new MutationObserver(run).observe(ph,{childList:true,subtree:true});
if(document.fonts){document.fonts.ready.then(run);document.fonts.addEventListener&&document.fonts.addEventListener('loadingdone',run)}
addEventListener('resize',run);run();
}catch(e){console.warn('v879lockup',e)}})();
</script>
<script id="v879in">
(function(){try{var ph=document.getElementById('phone')||document.body;
function t(){ph.querySelectorAll('.screen .row .r').forEach(function(r){var s=r.textContent.trim().charAt(0);r.classList.toggle('in879',s==='+')})}
new MutationObserver(t).observe(ph,{childList:true,subtree:true});t()}catch(e){console.warn('v879in',e)}})();
</script>
<style id="v880toss">
/* v880: Toss-style pass 9. Credit score and Notifications. */
/* Credit score: Toss shows one big number on a calm canvas. Gauge is brand violet, the verdict is a small green pill, factors are plain rows with thin bars, the tip is a quiet tinted card. */
#phone#phone .screen:has([aria-label^="Score"]){background:var(--bg)}
#phone#phone .screen:has([aria-label^="Score"]) svg[aria-label^="Score"]{width:240px;max-width:80%}
#phone#phone .screen:has([aria-label^="Score"]) svg[aria-label^="Score"] path{stroke-width:12}
#phone#phone .screen:has([aria-label^="Score"]) svg[aria-label^="Score"] path+path{stroke:var(--cta,#6258F5)}
#phone#phone .screen:has([aria-label^="Score"]) .big{font-size:56px;line-height:60px;font-weight:800;letter-spacing:-2px;margin-top:-58px!important;font-variant-numeric:tabular-nums}
#phone#phone .screen:has([aria-label^="Score"]) .big+div{display:inline-block;margin-top:10px!important;padding:5px 12px;border-radius:999px;background:color-mix(in srgb,var(--ok) 12%,var(--bg));font-size:14px;font-weight:700;letter-spacing:-.2px}
#phone#phone .screen:has([aria-label^="Score"]) .big+div+.sm{font-size:13px;color:var(--mu);margin-top:10px!important}
#phone#phone .screen:has([aria-label^="Score"]) .sec{padding-top:28px}
#phone#phone .screen:has([aria-label^="Score"]) .sech{font-size:19px;font-weight:700;letter-spacing:-.5px;margin-bottom:6px}
#phone#phone .screen:has([aria-label^="Score"]) .sec>div[style*="padding:10px 0"]{padding:14px 0!important}
#phone#phone .screen:has([aria-label^="Score"]) .sec>div[style*="padding:10px 0"]>div:first-child{font-size:16px!important;font-weight:600!important;letter-spacing:-.3px}
#phone#phone .screen:has([aria-label^="Score"]) .sec>div[style*="padding:10px 0"]>div:first-child .mu{font-weight:700;color:var(--tx)}
#phone#phone .screen:has([aria-label^="Score"]) div[style*="height:8px"]{height:6px!important;margin-top:10px!important;background:var(--chip)!important}
#phone#phone .screen:has([aria-label^="Score"]) div[style*="height:8px"]>div{height:6px!important;background:var(--cta,#6258F5)!important}
#phone#phone .screen:has([aria-label^="Score"]) div[style*="background:var(--tint);border-radius:20px"]{border-radius:16px!important;padding:16px 18px!important}
#phone#phone .screen:has([aria-label^="Score"]) div[style*="background:var(--tint);border-radius:20px"] .sm{font-size:14px;font-weight:700}
#phone#phone .screen:has([aria-label^="Score"]) div[style*="background:var(--tint);border-radius:20px"] div:last-child{font-size:15px!important;line-height:22px!important;letter-spacing:-.2px}
/* Notifications: same list rhythm as Settings. 17px medium titles, 13px grey help text, 64px rows, soft press. */
#phone#phone .screen:has(.nt880) .pad.fine{font-size:15px;line-height:22px;color:var(--mu);padding:12px 24px 8px!important}
#phone#phone .screen:has(.nt880) .row{min-height:64px;padding:12px 24px!important;gap:16px;border:0!important}
#phone#phone .screen:has(.nt880) .row .t{font-size:17px;font-weight:500;letter-spacing:-.3px}
#phone#phone .screen:has(.nt880) .row .s{font-size:13px;line-height:18px;color:var(--mu);margin-top:2px}
#phone#phone .screen:has(.nt880) .row:active{background:color-mix(in srgb,var(--tx) 5%,transparent)}
</style>
<script id="v880js">
/* v880: Credit score count-up. The number runs from 300 to the real score and the gauge fills in, once each time the screen opens. Skipped when the person asks for reduced motion. */
(function(){try{
var ph=document.getElementById('phone')||document.body,rm=matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches;
function run(){var sv=ph.querySelector('.screen svg[aria-label^="Score"]');if(!sv||sv.dataset.c880)return;sv.dataset.c880='1';
var big=sv.parentElement&&sv.parentElement.querySelector('.big');var m=/Score\s+(\d+)/.exec(sv.getAttribute('aria-label')||'');if(!big||!m)return;
var to=+m[1],ps=sv.querySelectorAll('path'),fg=ps[1],full=fg&&fg.getAttribute('stroke-dasharray');
if(rm)return;
if(fg&&full){fg.style.strokeDasharray='0 300';void fg.getBoundingClientRect();fg.style.transition='stroke-dasharray .9s cubic-bezier(.22,1,.36,1)';fg.style.strokeDasharray=full}
var t0=performance.now(),from=300;(function f(n){var k=Math.min(1,(n-t0)/900),e=1-Math.pow(1-k,3);big.textContent=Math.round(from+(to-from)*e);if(k<1)requestAnimationFrame(f)})(t0)}
new MutationObserver(run).observe(ph,{childList:true,subtree:true});run();
}catch(e){console.warn('v880',e)}})();
</script>
<style id="v881toss">
/* v881: Toss-style pass 10. Card page and Manage cards. */
/* Card: section titles 19px bold, action tiles are rounded squares, controls are plain 56px rows, the limit bar is thicker and violet, the picked limit is solid violet with white text, recent payments are 64px rows. */
#phone#phone .screen:has(#cv) .cdh{font-size:19px;font-weight:700;letter-spacing:-.5px}
#phone#phone .screen:has(#cv) #cv{border-radius:22px!important}
#phone#phone .screen:has(#cv) #cv:active{transform:scale(.985)}
#phone#phone .screen:has(#cv) #cst{font-weight:700!important;font-size:12px!important;padding:5px 10px!important;border-radius:999px!important}
#phone#phone .screen:has(#cv) .ppa{font-size:14px!important;font-weight:600;letter-spacing:-.2px;gap:8px}
#phone#phone .screen:has(#cv) .ppa i{width:56px;height:56px;border-radius:20px;background:var(--chip)}
#phone#phone .screen:has(#cv) .ppa:active i{background:color-mix(in srgb,var(--tx) 10%,var(--bg))}
#phone#phone .screen:has(#cv) .ban95{border-radius:16px;font-size:14px;line-height:21px}
#phone#phone .screen:has(#cv) .cc95 .r95>div:first-child>div:first-child{font-size:17px!important;font-weight:500!important;letter-spacing:-.3px}
#phone#phone .screen:has(#cv) .cdbar{height:8px;border-radius:4px;background:var(--chip)}
#phone#phone .screen:has(#cv) .cdbar i{border-radius:4px;background:var(--cta,#6258F5)}
#phone#phone .screen:has(#cv) .cdch{gap:8px;margin-top:18px}
#phone#phone .screen:has(#cv) .cdch button{height:44px;border-radius:14px;font-size:15px;font-weight:600;letter-spacing:-.2px;background:var(--chip);color:var(--tx)}
#phone#phone .screen:has(#cv) .cdch button.on{background:var(--cta,#6258F5);color:var(--ctafg,#fff)}
#phone#phone .screen:has(#cv) .cdch button:active{transform:scale(.96)}
#phone#phone .screen:has(#cv) .bdr{min-height:64px}
#phone#phone .screen:has(#cv) .bdr .t{font-size:16px;font-weight:600;letter-spacing:-.3px}
#phone#phone .screen:has(#cv) .bdr .s{font-size:13px;color:var(--mu)}
#phone#phone .screen:has(#cv) .bdr .pkv b{font-size:16px;font-weight:700;letter-spacing:-.3px}
#phone#phone .screen:has(#cv) .bdr:active{background:color-mix(in srgb,var(--tx) 5%,transparent);border-radius:14px}
/* Manage cards: one list, 64px rows, small card chips, quiet tinted Remove, and Add a card as the same tinted button Toss uses for secondary actions. */
#phone#phone .mcl .mcr{min-height:64px;padding:8px 0;gap:16px}
#phone#phone .mcl .mci{width:48px;height:32px;border-radius:8px}
#phone#phone .mcl .mcm b{font-size:17px;font-weight:600;letter-spacing:-.3px}
#phone#phone .mcl .mcm span{font-size:13px}
#phone#phone .mcl .mcx{min-height:36px;padding:0 14px;border-radius:12px;background:var(--tint);color:var(--tintfg);font-size:14px;font-weight:700}
#phone#phone .mcl .mcx:active{background:color-mix(in srgb,var(--tintfg) 18%,var(--bg))}
#phone#phone .mcl .acb{min-height:52px;margin-top:16px;border-radius:14px;background:var(--tint);color:var(--tintfg);font-size:16px;font-weight:700;letter-spacing:-.3px}
#phone#phone .mcl .acb:active{transform:scale(.98);background:color-mix(in srgb,var(--tintfg) 18%,var(--bg))}
</style>
<style id="v882toss">
/* v882: Toss-style pass 11. Invest: one big value, quiet stat tiles, round ticker marks, 68px stock rows with a bold price on the right, plain 19px section titles, thin allocation bar. */
#phone#phone .screen:has([onclick^="invTab"]) .big{font-size:36px;line-height:44px;font-weight:800;letter-spacing:-1.2px;font-variant-numeric:tabular-nums}
#phone#phone .screen:has([onclick^="invTab"]) .big+.sm{font-size:15px;font-weight:600!important;letter-spacing:-.2px;margin-top:6px!important}
#phone#phone .screen:has([onclick^="invTab"]) div[style*="flex:1;min-width:0;background:var(--chip);border-radius:16px"]{border-radius:16px!important;padding:14px!important;background:var(--chip)!important}
#phone#phone .screen:has([onclick^="invTab"]) div[style*="flex:1;min-width:0;background:var(--chip);border-radius:16px"] .sm{font-size:13px;color:var(--mu)}

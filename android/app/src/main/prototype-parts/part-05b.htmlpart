<style id="v905toss">
/* v905: Toss-style pass 32. The tab bar marks the current tab with a solid icon, like Toss (outline when idle, filled when selected), with a small spring when it switches. Icon details cut out in the page colour. */
#phone nav.tabs button svg{transition:transform .22s cubic-bezier(.34,1.56,.64,1)}
#phone nav.tabs button.on svg{transform:scale(1.06)}
#phone nav.tabs button.on:nth-child(1) svg{fill:currentColor}
#phone nav.tabs button.on:nth-child(1) svg path:nth-child(2){stroke:var(--bg,#fff)}
#phone nav.tabs button.on:nth-child(2) svg rect{fill:currentColor}
#phone nav.tabs button.on:nth-child(3) svg circle{fill:currentColor}
#phone nav.tabs button.on:nth-child(3) svg path{stroke:var(--bg,#fff);fill:var(--bg,#fff)}
#phone nav.tabs button.on:nth-child(4) svg>path:first-child{fill:currentColor}
#phone nav.tabs button.on:nth-child(5) svg circle,#phone nav.tabs button.on:nth-child(5) svg path{fill:currentColor}
@media (prefers-reduced-motion:reduce){#phone nav.tabs button svg{transition:none}#phone nav.tabs button.on svg{transform:none}}
</style>
<script>document.title=document.title.replace(/v\d+/,'v905');</script>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/toss/tossface/dist/tossface.css">
<style id="v906toss">
/* v906: Toss-style pass 33. Tossface glyphs for emoji (old sprites stay as the offline fallback), itunda original faces, line/solid tab icons from itundaicons, Toss press feedback, tabular numbers. */
html.tf .ef:not(.io){background:none!important;text-indent:0!important;overflow:visible!important;color:inherit!important;-webkit-text-fill-color:currentColor!important;font-family:Tossface,"Apple Color Emoji","Noto Color Emoji",sans-serif!important;font-size:1em!important;width:auto!important;height:auto!important;line-height:1.15!important;vertical-align:baseline!important;margin:0!important}
.ef.io{background-size:contain!important}
#phone nav.tabs button svg{transition:transform .22s cubic-bezier(.34,1.56,.64,1)}
#phone nav.tabs button.on svg{transform:scale(1.08)}
#phone nav.tabs button:active svg{transform:scale(.88)}
#phone nav.tabs{backdrop-filter:saturate(1.6) blur(14px);-webkit-backdrop-filter:saturate(1.6) blur(14px);box-shadow:0 -1px 0 var(--ln)}
#phone .btn,#phone .chip,#phone .row,#phone .gi,#phone .ib,#phone .cch{transition:transform .14s cubic-bezier(.2,.8,.2,1),background-color .14s}
#phone .btn:active:not(:disabled),#phone .chip:active,#phone .gi:active,#phone .cch:active{transform:scale(.96)}
#phone .row:active{transform:scale(.985);background:color-mix(in srgb,var(--chip) 60%,transparent);border-radius:16px}
#phone .big,#phone .row .t,#phone .row .r,#phone .sech,#phone .keys button{font-variant-numeric:tabular-nums}
@media (prefers-reduced-motion:reduce){#phone .btn,#phone .chip,#phone .row,#phone .gi,#phone nav.tabs button svg{transition:none;transform:none!important}}
</style>

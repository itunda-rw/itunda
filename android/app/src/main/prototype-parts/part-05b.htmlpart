const BELL='<path d="M6.3 17.4v-6.1a5.7 5.7 0 0 1 11.4 0v6.1l1.5 1.7H4.8z"/><path d="M10 21.4a2.2 2.2 0 0 0 4 0"/>';
let busy=0;
function fix(){if(busy)return;busy=1;try{
 ph.querySelectorAll('#sc.h9 .top').forEach(t=>{
  const sv=t.querySelector('button[aria-label="Scan to pay"] svg');if(sv&&!sv.dataset.h784){sv.dataset.h784='1';sv.setAttribute('stroke-width','2');sv.innerHTML=SCAN}
  const bl=t.querySelector('button[aria-label="Notifications"] svg');if(bl&&!bl.dataset.h784){bl.dataset.h784='1';bl.setAttribute('stroke-width','2');bl.innerHTML=BELL}
 })}catch(e){}busy=0}
new MutationObserver(fix).observe(ph,{childList:true,subtree:true});fix();

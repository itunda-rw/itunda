#phone#phone .screen:has([onclick="goalDel()"]) .h1{font-size:26px;line-height:34px;letter-spacing:-.8px}
#phone#phone .screen:has([onclick="goalDel()"]) .h1+.mu{font-size:15px;line-height:22px;letter-spacing:-.2px}
#phone#phone .screen:has([onclick="goalDel()"]) button.chip[onclick="goalDel()"]{height:44px;padding:0 18px;border-radius:14px;background:var(--tint);color:var(--tintfg);font-size:15px;font-weight:700;letter-spacing:-.2px}
#phone#phone .screen:has([onclick="goalDel()"]) button.chip[onclick="goalDel()"]:active{transform:scale(.97);background:color-mix(in srgb,var(--tintfg) 18%,var(--bg))}
#phone#phone .screen:has([onclick="loanPay()"]) div[style*="margin:24px 24px 0;padding:4px 20px;border-radius:20px;background:var(--chip)"]{margin:28px 0 0!important;padding:4px 24px!important;border-radius:0!important;background:transparent!important;border:0!important}
#phone#phone .screen:has([onclick="loanPay()"]) div[style*="margin:24px 24px 0;padding:4px 20px;border-radius:20px;background:var(--chip)"]>div{min-height:56px;font-size:16px;letter-spacing:-.3px;border-color:transparent!important}
#phone#phone .screen:has([onclick="loanPay()"]) div[style*="margin:24px 24px 0;padding:4px 20px;border-radius:20px;background:var(--chip)"] b{font-weight:700}
#phone#phone .screen:has([onclick="loanPay()"]) .pad.sm{font-size:13px;letter-spacing:-.1px}
</style>
<style id="v887toss">
/* v887: Toss-style pass 16. Pockets list and detail. Big grey-labelled total, 72px rows with 17px names and bold balances, thick violet goal bar, quiet filter pill, 64px history rows with soft press, tinted Fill and solid Take out. */
#phone#phone .screen:has(.pkTot) .pkTot{font-size:40px;line-height:48px;font-weight:800;letter-spacing:-1.4px;font-variant-numeric:tabular-nums;margin-top:4px}

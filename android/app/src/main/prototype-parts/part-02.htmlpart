const links=mine?(x.st?lk(T('Reopen listing','Fungura icyashyizweho','Rouvrir l’annonce'),`pReopen(${x.id})`):lk(T('Edit listing','Hindura icyashyizweho','Modifier l’annonce'),`pEdit(${x.id})`))+lk(T('Share','Sangiza','Partager'),`pShare(${x.id})`):lk(cm?'✓ '+T('In compare','Muri guhuza','Comparé'):'⇄ '+T('Compare','Gereranya','Comparer'),`pCmpT(${x.id})`)+lk(T('Ask a question','Baza ikibazo','Poser une question'),`pAsk(${x.id})`)+lk(T('Share','Sangiza','Partager'),`pShare(${x.id})`)+lk(T('Report','Tanga raporo','Signaler'),`pReport(${x.id})`,'var(--er)');
const simL=mine?[]:H.items.filter(y=>y.id!==x.id&&!y.st&&!S.pHide[y.id]&&y.who!=='You'&&y.c===x.c).sort((a,b)=>Math.abs(a.n-x.n)-Math.abs(b.n-x.n)).slice(0,3);
const sim=simL.length?sec(T('Similar homes','Inzu zisa','Biens similaires'))+simL.map(y=>`<div class="hdc" role="button" tabindex="0" onclick="hdOpen('property',${y.id})" style="margin:0 -24px"><div class="th">${gl(y.g,44)}</div><div style="flex:1;min-width:0"><div class="t">${esc(y.ti)}</div><div class="s">${esc(sub(y))}</div><div class="pr">${price(y)}</div></div></div>`).join(''):'';
const cta=mine?`<div class="cta" style="display:flex;gap:10px"><button class="btn sec2" style="flex:0 0 auto;width:auto;padding:0 20px;color:var(--er)" onclick="prDel(${x.id})">${T('Delete','Siba','Supprimer')}</button><button class="btn" ${x.st?'disabled':''} onclick="prTaken(${x.id})">${x.st?taken(x):rent?T('Mark as rented','Emeza ko yakodeshejwe','Marquer comme loué'):T('Mark as sold','Emeza ko yagurishijwe','Marquer comme vendu')}</button></div>`
:`<div class="cta" style="display:flex;gap:10px"><button class="btn sec2" style="flex:0 0 auto;width:auto;padding:0 20px" onclick="pAsk(${x.id})">${T('Message','Ohereza ubutumwa','Message')}</button><button class="btn" ${x.st?'disabled':''} onclick="prView(${x.id})">${v?T('Reschedule · ','Hindura · ','Reprogrammer · ')+dl(day(v.d))+' '+TM[v.t]:T('Book a viewing','Gena igihe cyo gusura','Réserver une visite')}</button></div>`;
return `${bar(H.t)}<div style="padding:12px 24px 0"><div class="pim" style="aspect-ratio:auto;height:230px;border-radius:28px;position:relative">${gl(x.g,112)}</div></div><div class="pad" style="padding-top:20px"><div style="display:flex;justify-content:space-between;align-items:flex-start;gap:8px"><div style="font-size:22px;font-weight:800;letter-spacing:-.4px;line-height:29px">${esc(x.ti)}</div>${hdHeart('property',x.id)}</div><div class="sm mu" style="margin-top:6px">${esc(x.loc)} · ${CL()[x.c]} · ${KD()[x.k||'house']}</div><div style="display:flex;gap:6px;margin-top:10px;flex-wrap:wrap">${tags(x)}</div><div style="font-size:24px;font-weight:800;margin-top:14px">${price(x)}</div><div style="display:flex;gap:10px;margin-top:14px">${x.beds?box(x.beds,T('beds','ibyumba','chambres')):''}${x.baths?box(x.baths,T('baths','ubwiherero','sdb')):''}${x.m2?box(x.m2,'m²'):''}</div>${v&&!mine?`<div style="margin-top:14px;padding:12px 14px;border-radius:16px;background:var(--tint);font-weight:700">📅 ${dl(day(v.d))}, ${TM[v.t]} · ${S.pIv[x.id]?T('Confirmed','Byemejwe','Confirmée'):T('Waiting for agent','Utegereje umuhuza','En attente')}</div>`:''}${cost}<div style="font-size:15px;line-height:23px;margin-top:16px">${esc(x.d)}</div>${am}${det}${nb}${own}${agent}<div style="margin-top:8px">${links}</div>${sim}<div style="height:96px"></div></div>${cta}`};
})();
</script>
<script>
/* v99: Community is a full flow: categories, area filter, search, sort, post detail with threaded replies and best answer, polls, event RSVP, save, share, report, mute, edit/delete, richer composer. rw/fr strings need native review */
(function(){
const T=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e;
const esc=s=>String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/"/g,'&quot;');
const sh=h=>{$('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" style="max-height:86%;overflow-y:auto">'+h+'</div>'};
const H1='class="h1" style="font-size:22px;line-height:30px"';
const W='style="padding:8px 0 0;flex-wrap:wrap;overflow:visible"';
const me=()=>S.name||'Amina Uwase';
const cb=(on,fn,l)=>`<button class="${on?'on':''}" aria-pressed="${!!on}" onclick="${fn}">${l}</button>`;
const lk=(t,fn,c)=>`<button style="border:0;background:none;font:inherit;font-size:14px;font-weight:700;color:${c||'var(--mu)'};padding:10px 0;min-height:44px;margin-right:16px" onclick="event.stopPropagation();${fn}">${t}</button>`;
const tg=(t,c)=>`<span style="padding:3px 9px;border-radius:10px;background:var(--chip);font-size:12px;font-weight:700;color:${c||'var(--mu)'}">${t}</span>`;
const conf=(t,m,ok,fn,keep)=>sh(`<div ${H1}>${t}</div><div class="mu" style="font-size:15px;margin:8px 0 20px">${m}</div><button class="btn sec2" style="color:var(--er)" onclick="closeSheet();${fn}">${ok}</button><button class="btn" style="margin-top:10px" onclick="closeSheet()">${keep}</button>`);
const AREAS=['Remera','Kimironko','Kacyiru','Nyamirambo','Kicukiro','Gikondo','Nyabugogo'];
const PC=['Ask','Tips','Events','Safety','Lost'];
const CAT=()=>({All:T('All','Byose','Tout'),Ask:T('Ask','Baza','Questions'),Tips:T('Tips','Inama','Conseils'),Events:T('Events','Ibirori','Événements'),Safety:T('Safety','Umutekano','Sécurité'),Lost:T('Lost & found','Ibyabuze','Objets perdus'),Saved:T('Saved','Ibibitswe','Enregistrés'),Following:T('Following','Ubakurikira','Abonnements'),Mine:T('Mine','Ibyanjye','Mes posts')});
const WHEN=['Today 17:00','Tomorrow 10:00','Sat 08:00','Sun 15:00'];
const RP0={1:[['Jean P.','Try the plumber near Remera market, he came the same day for me.'],['Sandrine K.','I can send you his number.']],2:[['Aline N.','Yes, I switched last week and save 15 minutes.']],3:[['Eric M.','See you there.']],4:[['Claire U.','Thanks for reporting. Mine is dark too.']],5:[['Eric M.','Yes, shared pickup would save money.'],['Aline N.','Maybe, if it is under 2,000 a month.']],6:[['Grace T.','My neighbour teaches French. I can ask her.']]};
if(!S.cmI2){S.cmI2=1;S.cm={cat:'All',area:'',sort:0,q:'',mute:{},hide:{}};
const ex={1:{cat:'Ask',area:'Remera',a:60},2:{cat:'Tips',area:'Kimironko',a:1440,v:1},3:{cat:'Events',area:'Remera',a:2880,pin:1,v:1,ev:{w:'Sat 08:00',wh:'Cell office, Remera',n:46,me:0}}};
S.posts.forEach(p=>Object.assign(p,ex[p.id]||{cat:'Ask',area:'',a:0}));
S.posts.push({id:4,who:'Claire U.',t:'3 h',a:180,x:'The street light on KG 11 Ave is out since Monday. I reported it to the sector office. Please walk in groups after dark.',l:18,c:1,me:false,cat:'Safety',area:'Kacyiru'},
{id:5,who:'Patrick H.',t:'5 h',a:300,x:'Should our street start a shared weekly trash pickup?',l:9,c:2,me:false,cat:'Ask',area:'Kimironko',poll:{o:[{l:'Yes',v:14},{l:'No',v:3},{l:'Only if it is cheap',v:6}],my:-1}},
{id:6,who:'Grace T.',t:'Yesterday',a:1600,x:'Looking for a French tutor for my daughter, twice a week after school.',l:4,c:1,me:false,cat:'Ask',area:'Kicukiro'},
{id:7,who:'Sandra B.',t:'Yesterday',a:1700,x:'Kids football this Sunday at the Kicukiro field. All ages welcome, bring water.',l:21,c:0,me:false,cat:'Events',area:'Kicukiro',v:1,ev:{w:'Sun 15:00',wh:'Kicukiro field',n:18,me:0}},
{id:8,who:'Jean B.',t:'2 d ago',a:2900,x:'Found a set of keys with a blue tag near Nyabugogo taxi park. Message me to describe them.',l:7,c:0,me:false,cat:'Lost',area:'Nyabugogo'})}
const reps=p=>p.rr||(p.rr=(Array.isArray(p.rp)?p.rp:RP0[p.id]||[]).map(r=>({n:r[0],x:r[1],l:0,me:0})));
const mine=p=>!!p.mine;
const pct=(o,i)=>{const s=o.reduce((a,b)=>a+b.v,0)||1;return Math.round(o[i].v*100/s)};
const refresh=()=>{if($('#cml')){$('#cml').innerHTML=rowsC();if($('#cmtl'))$('#cmtl').innerHTML=tools()}else render('fade-none')};
/* ---- card ---- */
const pollH=p=>p.poll?`<div style="margin-top:12px" onclick="event.stopPropagation()">${p.poll.o.map((o,i)=>{const v=p.poll.my>=0;return `<button onclick="event.stopPropagation();cmVote(${p.id},${i})" aria-pressed="${p.poll.my===i}" style="position:relative;display:flex;justify-content:space-between;width:100%;min-height:44px;align-items:center;margin-bottom:6px;padding:0 14px;border:0;border-radius:12px;background:var(--chip);font:inherit;color:inherit;font-weight:${p.poll.my===i?800:600};overflow:hidden;text-align:left">${v?`<i style="position:absolute;left:0;top:0;bottom:0;width:${pct(p.poll.o,i)}%;background:var(--tint)"></i>`:''}<span style="position:relative">${esc(o.l)}</span>${v?`<span style="position:relative">${pct(p.poll.o,i)}%</span>`:''}</button>`}).join('')}<div class="sm mu">${p.poll.o.reduce((a,b)=>a+b.v,0)} ${T('votes','amajwi','votes')}</div></div>`:'';
const evH=p=>p.ev?`<div style="margin-top:12px;padding:12px 14px;border-radius:16px;background:var(--tint)"><div style="display:flex;align-items:center;gap:12px"><div style="flex:1"><b style="${p.ev.x?'text-decoration:line-through':''}">📅 ${esc(p.ev.w)}</b><div class="sm" style="margin-top:2px">${esc(p.ev.wh||'')} · ${p.ev.n} ${T('going','baraza','y vont')}</div></div>${p.ev.x?'':`<button class="cch ${p.ev.me?'on':''}" style="height:40px" aria-pressed="${!!p.ev.me}" onclick="event.stopPropagation();cmGo(${p.id})">${p.ev.me?'✓ '+T('Going','Nzaza','J’y vais'):T('I’m going','Nzaza','J’y vais')}</button>`}</div>${p.ev.x?'':`<button class="cch ${p.ev.rm?'on':''}" style="height:40px;margin-top:10px" aria-pressed="${!!p.ev.rm}" onclick="event.stopPropagation();cmRemind(${p.id})">🔔 ${p.ev.rm?T('Reminder on','Wibutswa','Rappel activé'):T('Remind me','Nyibutsa','Me rappeler')}</button>`}</div>`:'';
const card=(p,full)=>{const n=reps(p).length;return `<div class="post" ${full?'':`role="button" tabindex="0" onclick="cmOpen(${p.id})"`} style="${full?'':'cursor:pointer'}"><div class="who"><div class="ico" style="width:36px;height:36px;border-radius:18px">${gl('community',24)}</div><div style="flex:1;min-width:0"><button style="border:0;background:none;font:inherit;color:inherit;padding:0;min-height:24px;text-align:left" onclick="event.stopPropagation();cmWho(${p.id})">${esc(p.who)}</button>${p.v?` <span style="color:var(--ok)" aria-label="${T('Verified','Byemejwe','Vérifié')}">✓</span>`:''}<div class="sm mu" style="font-weight:500">${p.area?esc(p.area)+' · ':''}${esc(p.t)}</div></div><button class="ib" aria-label="${T('More','Ibindi','Plus')}" onclick="event.stopPropagation();cmMenu(${p.id})" style="width:44px;height:44px;font-size:20px">⋯</button></div><div style="display:flex;gap:6px;margin-top:10px;flex-wrap:wrap">${p.pin?tg('📌 '+T('Pinned','Cyakosowe','Épinglé'),'var(--tintfg)'):''}${tg(CAT()[p.cat]||CAT().Ask)}${p.rs?tg('✓ '+T('Resolved','Byakemutse','Résolu'),'var(--ok)'):''}${p.poll&&p.poll.cl?tg(T('Poll closed','Itora ryarangiye','Sondage clos')):''}${p.ev&&p.ev.x?tg(T('Cancelled','Cyahagaritswe','Annulé'),'var(--er)'):''}</div><p style="${full?'':'display:-webkit-box;-webkit-line-clamp:4;-webkit-box-orient:vertical;overflow:hidden'}">${esc(p.x)}</p>${pollH(p)}${evH(p)}<div class="act"><button aria-label="${T('Like','Ndabikunze','J’aime')}" onclick="event.stopPropagation();cmLike(${p.id})">${heart(p.me)}<span>${p.l}</span></button><button aria-label="${T('Replies','Ibisubizo','Réponses')}">${ic('chat',18)}${n}</button><button aria-label="${T('Save','Bika','Enregistrer')}" aria-pressed="${!!p.sv}" onclick="event.stopPropagation();cmSave(${p.id})" style="font-size:20px">${p.sv?'★':'☆'}</button><button onclick="event.stopPropagation();cmShare(${p.id})" style="font-size:14px;font-weight:700">${T('Share','Sangiza','Partager')}</button></div></div>`};
/* ---- feed ---- */
function rowsC(){const c=S.cm,q=c.q.trim().toLowerCase();
const l=S.posts.filter(p=>!c.hide[p.id]&&!c.mute[p.who]&&(c.cat==='All'||p.cat===c.cat||(c.cat==='Saved'&&p.sv)||(c.cat==='Following'&&S.cm.fol&&S.cm.fol[p.who])||(c.cat==='Mine'&&mine(p)))&&(!c.area||p.area===c.area)&&(!q||(p.x+' '+p.who+' '+(p.area||'')).toLowerCase().includes(q)));
l.sort((a,b)=>c.sort?(b.l+reps(b).length*2)-(a.l+reps(a).length*2):((b.pin?1:0)-(a.pin?1:0))||(a.a||0)-(b.a||0));
return l.length?l.map(p=>card(p)).join(''):`<div class="pad mu" style="padding-top:30px;text-align:center;line-height:22px">${c.cat==='Saved'?T('Tap ☆ on a post to save it here.','Kanda ☆ ku nyandiko ngo uyibike hano.','Touchez ☆ sur un post pour l’enregistrer.'):c.cat==='Mine'?T('You have not posted yet.','Nta cyo urashyiraho.','Vous n’avez rien publié.'):T('Nothing here yet. Be the first to post.','Nta kintu kiraba. Ba uwa mbere.','Rien ici. Soyez le premier.')}</div>`}
const nMute=()=>Object.keys(S.cm.mute).length;
const OL='style="border:2px solid var(--ln);background:none"';
const chips=()=>Object.keys(CAT()).map(k=>`<button class="cch ${S.cm.cat===k?'on':''}" onclick="cmCat('${k}')">${CAT()[k]}</button>`).join('');
const achips=()=>['',...AREAS].map((a,i)=>`<button class="cch ${S.cm.area===a?'on':''}" ${S.cm.area===a?'':OL} onclick="cmArea(${i})">${a||T('All areas','Uduce twose','Tous quartiers')}</button>`).join('');
const tools=()=>`<button class="cch" ${OL} onclick="cmSort()">⇅ ${S.cm.sort?T('Popular','Bikunzwe','Populaires'):T('Latest','Bishya','Récents')}</button>`+(nMute()?`<button class="cch" ${OL} onclick="cmMuted()">🔇 ${T('Muted','Bicecekeshejwe','Masqués')} · ${nMute()}</button>`:'');
screens.community=()=>`${bar(T('Community','Umuryango','Communauté'))}<div style="display:flex;gap:10px;padding:6px 24px 0"><input id="cmq" type="search" aria-label="${T('Search posts','Shakisha','Rechercher')}" placeholder="${T('Search posts','Shakisha','Rechercher')}" value="${esc(S.cm.q)}" oninput="S.cm.q=this.value;$('#cml').innerHTML=rowsC2()" style="flex:1;min-width:0;height:44px;border-radius:22px;border:0;background:var(--chip);color:var(--tx);font:inherit;font-size:15px;padding:0 16px"></div><div class="pad" style="padding-top:10px"><button class="btn sec2" style="height:48px;text-align:left;padding:0 18px;font-weight:600;color:var(--mu)" onclick="postSheet()">${S.cqDraft&&S.cqDraft.t?T('Continue your draft…','Komeza ibyo watangiye…','Reprendre votre brouillon…'):T('Ask your neighbours something…','Baza abaturanyi…','Demandez à vos voisins…')}</button></div><div class="chips" style="padding-top:10px" id="cmch">${chips()}</div><div class="chips" style="padding-top:8px" id="cmar">${achips()}</div><div class="chips" style="padding-top:8px" id="cmtl">${tools()}</div><div style="padding-top:8px" id="cml">${rowsC()}</div><div class="pad fine" style="padding-top:18px">${T('Posts are sample data.','Ibyatanzwe ni ibigerageza.','Les posts sont des données d’exemple.')}</div>`;
window.rowsC2=rowsC;
window.cmCat=k=>{S.cm.cat=k;$('#cmch').innerHTML=chips();$('#cml').innerHTML=rowsC()};
window.cmArea=i=>{S.cm.area=['',...AREAS][i];$('#cmar').innerHTML=achips();$('#cml').innerHTML=rowsC()};
window.cmSort=()=>{S.cm.sort=S.cm.sort?0:1;refresh()};
window.cmLike=id=>{const p=S.posts.find(x=>x.id===id);p.me=!p.me;p.l+=p.me?1:-1;refresh()};
window.cmSave=id=>{const p=S.posts.find(x=>x.id===id);p.sv=!p.sv;refresh();toast(p.sv?T('Saved','Byabitswe','Enregistré'):T('Removed from saved','Byakuwe mu bibitswe','Retiré des enregistrés'))};
window.cmShare=id=>{const l='itunda.rw/c/'+id;try{navigator.clipboard.writeText(l)}catch(e){}toast(T('Link copied: ','Ihuza ryakopowe: ','Lien copié : ')+l)};
window.cmVote=(id,i)=>{const p=S.posts.find(x=>x.id===id),q=p.poll;if(q.cl){toast(T('This poll is closed','Itora ryarangiye','Ce sondage est clos'));return}if(q.my>=0)q.o[q.my].v--;if(q.my===i)q.my=-1;else{q.o[i].v++;q.my=i}refresh()};
window.cmGo=id=>{const e=S.posts.find(x=>x.id===id).ev;e.me=e.me?0:1;e.n+=e.me?1:-1;refresh();if(e.me)toast(T('See you there','Tuzahabonana','À bientôt'))};
/* ---- post detail ---- */
window.cmOpen=id=>{S.cmP=id;S.stack=['community','cmPost'];render('push')};
screens.cmPost=()=>{const p=S.posts.find(x=>x.id===S.cmP);if(!p)return `${bar(T('Community','Umuryango','Communauté'))}`;
const r=reps(p),q=mine(p)&&p.cat==='Ask';
const rl=r.map((x,i)=>({x,i})).sort((a,b)=>(b.x.best?1:0)-(a.x.best?1:0));
return `${bar(T('Post','Nyandiko','Post'))}<div style="padding-top:4px">${card(p,1)}</div><div class="pad"><div style="font-size:17px;font-weight:800;margin:6px 0 2px">${T('Replies','Ibisubizo','Réponses')} · ${r.length}</div>${r.length?rl.map(({x,i})=>`<div style="padding:12px 0;border-bottom:0"><div style="display:flex;align-items:center;gap:8px"><button style="border:0;background:none;padding:0;min-height:24px;font-size:14px;font-weight:700;color:inherit" onclick="cmWhoN('${esc(x.n)}')">${esc(x.n)}</button>${x.best?tg('✓ '+T('Best answer','Igisubizo cyiza','Meilleure réponse'),'var(--ok)'):''}</div><div style="font-size:15px;line-height:22px;margin-top:2px">${esc(x.x)}</div><div style="display:flex;gap:4px;margin-top:2px"><button class="cch" style="height:40px;border:0;background:none;padding:0 12px 0 0" aria-pressed="${!!x.me}" onclick="cmLikeR(${p.id},${i})">${x.me?'♥':'♡'} ${x.l||''}</button>${x.mine?'':lk(T('Reply','Subiza','Répondre'),`cmAt('${esc(x.n)}')`)}${q&&!x.mine?lk(x.best?T('Unmark','Kuraho','Retirer'):T('Mark best','Hitamo nk’igisubizo cyiza','Meilleure réponse'),`cmBest(${p.id},${i})`,'var(--lk)'):''}${x.mine?lk(T('Delete','Siba','Supprimer'),`cmDelR(${p.id},${i})`,'var(--er)'):''}</div></div>`).join(''):`<div class="mu" style="padding:18px 0">${T('No replies yet. Be the first to answer.','Nta bisubizo. Ba uwa mbere.','Pas encore de réponse. Soyez le premier.')}</div>`}<div style="height:96px"></div></div><div class="cta" style="display:flex;gap:10px"><input id="cmr" class="in" aria-label="${T('Write a reply','Andika igisubizo','Écrire une réponse')}" maxlength="240" style="font-size:16px;height:48px;border:0;background:var(--chip);border-radius:14px;padding:0 14px;flex:1;min-width:0" placeholder="${T('Write a reply','Andika igisubizo','Écrire une réponse')}" onkeydown="if(event.key==='Enter')cmSend(${p.id})"><button class="btn" style="width:auto;padding:0 20px;height:48px;font-size:16px;border-radius:14px" onclick="cmSend(${p.id})">${T('Send','Ohereza','Envoyer')}</button></div>`};
window.cmSend=id=>{const i=$('#cmr'),v=i?i.value.trim():'';if(!v){toast(T('Write something first','Banza wandike','Écrivez d’abord'));return}reps(S.posts.find(x=>x.id===id)).push({n:me(),x:v,l:0,me:0,mine:1});render('fade-none')};
window.cmLikeR=(id,i)=>{const x=reps(S.posts.find(p=>p.id===id))[i];x.me=x.me?0:1;x.l+=x.me?1:-1;render('fade-none')};
window.cmBest=(id,i)=>{const r=reps(S.posts.find(p=>p.id===id)),on=!r[i].best;r.forEach(x=>x.best=0);r[i].best=on?1:0;render('fade-none')};
window.cmDelR=(id,i)=>{reps(S.posts.find(p=>p.id===id)).splice(i,1);render('fade-none');toast(T('Reply deleted','Igisubizo cyasibwe','Réponse supprimée'))};
/* ---- menu, report, mute, delete ---- */
const row=(t,fn,c)=>`<div class="ar tap" role="button" tabindex="0" style="padding:16px 0;min-height:56px" onclick="${fn}"><div class="t" style="flex:1;color:${c||'inherit'}">${t}</div></div>`;
window.cmMenu=id=>{const p=S.posts.find(x=>x.id===id);sh(`<div ${H1}>${esc(p.who)}</div><div style="padding-top:6px">${row(p.sv?T('Remove from saved','Kura mu bibitswe','Retirer des enregistrés'):T('Save post','Bika nyandiko','Enregistrer'),`closeSheet();cmSave(${id})`)}${row(T('Share','Sangiza','Partager'),`closeSheet();cmShare(${id})`)}${mine(p)?row(T('Edit post','Hindura nyandiko','Modifier'),`cmEdit(${id})`)+(['Lost','Safety','Ask'].includes(p.cat)?row(p.rs?T('Mark as open again','Subiza ku gifunguye','Rouvrir'):p.cat==='Lost'?T('Mark as found','Byabonetse','Marquer retrouvé'):T('Mark as resolved','Byakemutse','Marquer résolu'),`closeSheet();cmRes(${id})`):'')+(p.poll?row(p.poll.cl?T('Reopen poll','Fungura itora','Rouvrir le sondage'):T('Close poll','Funga itora','Clore le sondage'),`closeSheet();cmClose(${id})`):'')+(p.ev&&!p.ev.x?row(T('Cancel event','Hagarika igikorwa','Annuler l’événement'),`closeSheet();cmCancel(${id})`,'var(--er)'):'')+row(T('Delete post','Siba nyandiko','Supprimer'),`cmDel(${id})`,'var(--er)'):row(T('Mute ','Bicecekesha ','Masquer ')+esc(p.who),`cmMute(${id})`)+row(T('Report','Tanga raporo','Signaler'),`cmReport(${id})`,'var(--er)')}</div>`)};
window.cmReport=id=>{const R=[T('Spam or scam','Ubutumwa bw’uburiganya','Spam ou arnaque'),T('Rude or harmful','Bubi cyangwa bwangiza','Impoli ou nuisible'),T('Wrong information','Amakuru atari yo','Information erronée'),T('Something else','Ikindi','Autre chose')];
sh(`<div ${H1}>${T('Report this post','Tanga raporo kuri iyi nyandiko','Signaler ce post')}</div><div style="padding-top:6px">${R.map(r=>row(r,`cmRepGo(${id})`)).join('')}</div>`)};
window.cmRepGo=id=>{S.cm.hide[id]=1;closeSheet();if(S.stack[S.stack.length-1]==='cmPost')back();else refresh();toast(T('Thanks. We will review it.','Murakoze. Turabisuzuma.','Merci. Nous allons l’examiner.'))};
window.cmMute=id=>{const p=S.posts.find(x=>x.id===id);S.cm.mute[p.who]=1;closeSheet();if(S.stack[S.stack.length-1]==='cmPost')back();else refresh();toast(p.who+T(' muted',' yacecekeshejwe',' masqué'))};
window.cmMuted=()=>sh(`<div ${H1}>${T('Muted neighbours','Abaturanyi bacecekeshejwe','Voisins masqués')}</div><div style="padding-top:6px">${Object.keys(S.cm.mute).map((n,i)=>`<div style="display:flex;align-items:center;justify-content:space-between;padding:12px 0;border-bottom:0"><b>${esc(n)}</b><button class="cch" onclick="cmUnmute(${i})">${T('Unmute','Subiza','Réafficher')}</button></div>`).join('')}</div><button class="btn sec2" style="margin-top:14px" onclick="closeSheet()">${T('Close','Funga','Fermer')}</button>`);
window.cmUnmute=i=>{delete S.cm.mute[Object.keys(S.cm.mute)[i]];closeSheet();refresh()};
window.cmDel=id=>conf(T('Delete this post?','Gusiba iyi nyandiko?','Supprimer ce post ?'),T('Replies will be removed too. This cannot be undone.','N’ibisubizo bizavanwaho. Ntibisubirwaho.','Les réponses seront aussi supprimées. Action irréversible.'),T('Delete','Siba','Supprimer'),`cmDelGo(${id})`,T('Keep post','Reka nyandiko','Garder le post'));
window.cmDelGo=id=>{S.posts.splice(S.posts.findIndex(p=>p.id===id),1);if(S.stack[S.stack.length-1]==='cmPost')back();else refresh();toast(T('Post deleted','Nyandiko yasibwe','Post supprimé'))};
/* ---- composer / edit ---- */
window.postSheet=()=>{const d=S.cqDraft||{};S.cq={id:0,c:'',fc:S.cm.cat&&PC.includes(S.cm.cat)?S.cm.cat:'Ask',a:d.t?(d.a||''):(S.cm.area||''),t:d.t||'',pl:0,o:['','',''],w:'Sat 08:00',wh:'',st:0};qD()};
window.cmEdit=id=>{const p=S.posts.find(x=>x.id===id);S.cq={id,c:p.cat,a:p.area||'',t:p.x,pl:0,o:['','',''],w:'',wh:''};qD()};
function rd(){const F=S.cq,g=i=>$('#'+i);if(g('cqt'))F.t=g('cqt').value;if(g('cqw'))F.wh=g('cqw').value;[0,1,2].forEach(i=>{if(g('cqo'+i))F.o[i]=g('cqo'+i).value});return F}
const okQ=F=>F.t.trim().length>=5&&(!F.pl||F.o.filter(s=>s.trim()).length>=2);
/* v117: one action per page. The post composer is now a short step-by-step flow (topic, write, who sees it, then when/where for events or an optional poll). Tap a choice to move on; one main button per page. rw/fr strings need native review */
const stepsOf=F=>F.id?['t','a']:['t','c','a',...(F.c==='Events'?['w','wh']:F.c==='Ask'?['pl',...(F.pl?['po']:[])]:[]),'rv'];
const QS=()=>({c:T('What is this about?','Bijyanye n’iki?','De quoi s’agit-il ?'),t:T('What do you want to say?','Ushaka kuvuga iki?','Que voulez-vous dire ?'),a:T('Who should see it?','Ni nde ukwiye kubibona?','Qui doit le voir ?'),w:T('When is it?','Ni ryari?','C’est quand ?'),wh:T('Where will it be?','Bizabera he?','Où cela se passe-t-il ?'),pl:T('Add a poll?','Ushaka gushyiraho itora?','Ajouter un sondage ?'),po:T('What are the choices?','Amahitamo ni ayahe?','Quels sont les choix ?'),rv:T('Ready to post?','Witeguye gushyiraho?','Prêt à publier ?')});
function qD(){const F=S.cq,sp=stepsOf(F);F.st=Math.min(F.st||0,sp.length-1);const st=F.st,k=sp[st],last=st===sp.length-1,ed=!!F.id;
const opt=(key,v,l,sg)=>row(`<span><span style="font-weight:${F[key]===v?800:600};color:${F[key]===v?'var(--lk)':'inherit'}">${l}${F[key]===v?' ✓':''}</span>${sg?`<span class="sm" style="margin-left:8px;color:var(--lk);font-weight:700">${T('Suggested','Byatanzwe','Suggéré')}</span>`:''}</span>`,`cqPick('${key}','${v}')`);
const IN='width:100%;border:0;border-radius:16px;background:var(--chip);padding:14px;font:inherit;color:var(--tx);outline:0';
let b='',btn=last;
if(k==='c'){const sg=F.sg||'';b=[...PC].sort((x,y)=>(y===sg)-(x===sg)).map(y=>opt('c',y,CAT()[y],y===sg)).join('')}
else if(k==='t'){btn=1;b=`<textarea id="cqt" maxlength="280" aria-label="${QS().t}" oninput="cqChk()" placeholder="${T('Ask your neighbours something…','Baza abaturanyi…','Demandez à vos voisins…')}" style="${IN};height:150px;font-size:17px;resize:none">${esc(F.t)}</textarea><div style="display:flex;gap:12px;margin-top:8px"><div class="sm mu" id="cqh" style="flex:1"></div><div class="sm mu" id="cqn" style="white-space:nowrap">${F.t.length}/280</div></div>`}
else if(k==='a')b=[['',T('Everyone','Bose','Tous')],...AREAS.map(a=>[a,a])].map(([v,l])=>opt('a',v,l)).join('');
else if(k==='w')b=WHEN.map(w=>opt('w',w,w)).join('');
else if(k==='wh'){btn=1;b=`<input class="in" id="cqw" maxlength="40" value="${esc(F.wh)}" aria-label="${QS().wh}" placeholder="${T('Cell office','Ku biro by’akagari','Bureau de cellule')}" style="font-size:17px;height:52px">`}
else if(k==='pl'){btn=0;b=row(T('No thanks','Oya, urakoze','Non merci'),'cqPoll(0)')+row('📊 '+T('Add a poll','Shyiraho itora','Ajouter un sondage'),'cqPoll(1)')}
else if(k==='rv'){btn=1;const ar=F.a||'',pq=(F.pl&&F.c!=='Events')?F.o.map(s=>s.trim()).filter(Boolean):[];b=`<div style="border:1px solid var(--ln);border-radius:16px;padding:16px"><div style="display:flex;gap:6px;flex-wrap:wrap">${tg(CAT()[F.c])}${tg(esc(ar||T('Everyone','Bose','Tous')))}</div><div style="margin:12px 0 0;font-size:16px;line-height:24px;white-space:pre-wrap;word-break:break-word">${esc(F.t.trim())}</div>${pq.length?`<div style="margin-top:12px">${pq.map(o=>`<div style="padding:10px 12px;border-radius:12px;background:var(--chip);margin-top:6px;font-size:15px">${esc(o)}</div>`).join('')}</div>`:''}${F.c==='Events'?`<div class="sm mu" style="margin-top:12px;font-weight:700">${esc(F.w)}${F.wh.trim()?' · '+esc(F.wh.trim()):''}</div>`:''}</div><div class="sm mu" style="margin-top:12px">${ar?T('Neighbours in '+esc(ar)+' will see this.','Abaturanyi bo muri '+esc(ar)+' bazabibona.','Les voisins de '+esc(ar)+' verront ceci.'):T('Everyone in Community will see this.','Abantu bose muri Umuryango bazabibona.','Toute la Communauté verra ceci.')}</div>`}
else if(k==='po'){btn=1;b=[0,1,2].map(i=>`<input class="in" id="cqo${i}" maxlength="30" oninput="cqChk()" value="${esc(F.o[i])}" aria-label="${T('Option','Amahitamo','Option')} ${i+1}" placeholder="${T('Option','Amahitamo','Option')} ${i+1}${i>1?' ('+T('optional','si ngombwa','facultatif')+')':''}" style="font-size:16px;height:48px;margin-top:${i?8:0}px">`).join('')}
sh(`<div data-cqpg style="display:flex;align-items:center;gap:8px"><button class="ib" aria-label="${T('Back','Subira inyuma','Retour')}" onclick="cqBack()" style="width:44px;height:44px;font-size:26px">‹</button><div style="flex:1;height:4px;border-radius:2px;background:var(--chip)"><i style="display:block;height:100%;width:${(st+1)*100/sp.length}%;border-radius:2px;background:var(--br)"></i></div></div><div class="h1" style="font-size:26px;line-height:34px;margin:16px 0 14px">${QS()[k]}</div><div style="min-height:${k==='t'?190:260}px">${b}</div>${btn?`<button class="btn" id="cqgo" style="margin-top:12px" disabled onclick="cqNext()">${last?(ed?T('Save changes','Bika impinduka','Enregistrer'):T('Post','Shyiraho','Publier')):T('Next','Komeza','Suivant')}</button>`:''}`);
if(k==='t'){const t=$('#cqt');if(t){t.focus();t.setSelectionRange(t.value.length,t.value.length)}}cqChk()}
window.cqPick=(k,v)=>{const F=rd();F[k]=v;if(k==='c'){F.pl=0;F.ct=1}const sp=stepsOf(F);if(F.st<sp.length-1)F.st++;qD()};
window.cqPoll=n=>{const F=rd();F.pl=n;F.st++;qD()};
window.cqNext=()=>{const F=rd(),sp=stepsOf(F);if(!okQ(F))return;if(sp[F.st]==='t'&&!F.id){F.sg=cqGuess(F.t,F.fc);if(!F.ct)F.c=F.sg}if(F.st>=sp.length-1)cqGo();else{F.st++;qD()}};
window.cqBack=()=>{const F=rd();if(F.st>0){F.st--;qD()}else closeSheet()};
window.cqChk=()=>{const F=rd(),ok=okQ(F),b=$('#cqgo'),h=$('#cqh'),n=$('#cqn'),len=F.t.trim().length;if(b)b.disabled=!ok;
if(h)h.textContent=len<5?T('Write at least 5 characters to continue.','Andika nibura inyuguti 5 kugira ngo ukomeze.','Écrivez au moins 5 caractères pour continuer.'):T('Tip: say where and when. Neighbours reply faster.','Inama: vuga aho n’igihe. Abaturanyi basubiza vuba.','Astuce : précisez où et quand. Les voisins répondent plus vite.');
if(n)n.textContent=(len?T('Draft saved','Ibyabitswe','Brouillon enregistré')+' · ':'')+F.t.length+'/280';
if(!F.id){if(F.t.trim())S.cqDraft={t:F.t,a:F.a};else delete S.cqDraft}};
window.cqGuess=(t,d)=>{const x=(t||'').toLowerCase();return /\b(lost|missing|found (a|my|your|some)|lost and found)\b/.test(x)?'Lost':/\b(unsafe|theft|thief|robber|stolen|street ?light|accident|danger|fire|police|flood)\b/.test(x)?'Safety':/\b(umuganda|meeting|gathering|workshop|celebration|party|event|join us)\b/.test(x)?'Events':/\?|\b(anyone|anybody|who knows|where can|how do|recommend|looking for)\b/.test(x)?'Ask':/\b(tip|tips|advice|reminder|route|faster|cheaper|discount)\b/.test(x)?'Tips':(d||'Ask')};
window.cqS=(k,v)=>{rd();S.cq[k]=v;qD()};
window.cqPl=()=>{rd();S.cq.pl=S.cq.pl?0:1;qD()};
window.cqGo=()=>{const F=rd();if(!okQ(F))return;
if(F.id){const p=S.posts.find(x=>x.id===F.id);Object.assign(p,{x:F.t.trim(),cat:F.c,area:F.a});closeSheet();render('fade-none');toast(T('Post updated','Nyandiko yahinduwe','Post mis à jour'));return}
const p={id:Date.now()%100000,who:me(),t:T('Just now','Ubu nyine','À l’instant'),a:0,x:F.t.trim(),l:0,c:0,me:false,mine:1,cat:F.c,area:F.a};
if(F.pl&&F.c!=='Events')p.poll={o:F.o.map(s=>s.trim()).filter(Boolean).map(l=>({l,v:0})),my:-1};
if(F.c==='Events')p.ev={w:F.w,wh:F.wh.trim(),n:1,me:1};
delete S.cqDraft;S.posts.unshift(p);S.cm.cat='Mine';S.cm.q='';closeSheet();render('fade-none');toast(T('Posted','Byashyizweho','Publié'))};

/* v115: Community round 2: neighbour profile (follow, message, mute), Following filter, mark resolved/found, close/reopen poll, event reminder + cancel, reply to a reply (@name). rw/fr strings need native review */
const here=n=>S.posts.filter(p=>p.who===n);
const ref=()=>{if(S.stack[S.stack.length-1]==='cmPost')render('fade-none');else refresh()};
window.cmWho=id=>cmWhoN(S.posts.find(x=>x.id===id).who);
window.cmWhoN=n=>{const ps=here(n),f=(S.cm.fol=S.cm.fol||{})[n],you=n===me(),a=(ps.find(p=>p.area)||{}).area;
sh(`<div style="display:flex;align-items:center;gap:14px">${gl('community',52)}<div><div ${H1}>${esc(n)}${ps.some(p=>p.v)?` <span style="color:var(--ok)" aria-label="${T('Verified','Byemejwe','Vérifié')}">✓</span>`:''}</div><div class="sm mu">${a?esc(a)+' · ':''}${ps.length} ${T('posts','nyandiko','posts')}</div></div></div><div style="padding-top:16px">${you?`<div class="mu" style="padding:8px 0 4px">${T('This is you.','Ni wowe.','C’est vous.')}</div>`:`<button class="btn" onclick="cmMsg('${esc(n)}')">${T('Message','Ohereza ubutumwa','Écrire')}</button><button class="btn sec2" style="margin-top:10px" aria-pressed="${!!f}" onclick="cmFol('${esc(n)}')">${f?'✓ '+T('Following','Urakurikira','Abonné'):T('Follow','Kurikira','Suivre')}</button><button class="btn sec2" style="margin-top:10px;color:var(--er)" onclick="cmMuteN('${esc(n)}')">${T('Mute','Cecekesha','Masquer')}</button>`}</div>`)};
window.cmFol=n=>{const F=S.cm.fol=S.cm.fol||{};F[n]=F[n]?0:1;closeSheet();ref();toast(F[n]?T('Following ','Ukurikiye ','Vous suivez ')+n:T('Unfollowed ','Wavuye gukurikira ','Désabonné de ')+n)};
window.cmMsg=n=>{const id='cm'+n.replace(/\W/g,''),a=(here(n).find(p=>p.area)||{}).area;hdThread(id,n,'Community'+(a?' · '+a:''),[['me','Hi '+n+', I saw your post in Community.']]);closeSheet();S.tab='messages';openChat(id)};
window.cmMuteN=n=>{S.cm.mute[n]=1;closeSheet();if(S.stack[S.stack.length-1]==='cmPost')back();else refresh();toast(n+T(' muted',' yacecekeshejwe',' masqué'))};
window.cmRes=id=>{const p=S.posts.find(x=>x.id===id);p.rs=p.rs?0:1;ref();toast(p.rs?T('Marked as done. Thanks for updating.','Byashyizweho nk’ibyarangiye. Murakoze.','Marqué comme terminé. Merci.'):T('Post is open again','Nyandiko irafunguye','Post rouvert'))};
window.cmClose=id=>{const q=S.posts.find(x=>x.id===id).poll;q.cl=q.cl?0:1;ref();toast(q.cl?T('Poll closed','Itora ryarangiye','Sondage clos'):T('Poll reopened','Itora ryongeye gufungurwa','Sondage rouvert'))};
window.cmCancel=id=>conf(T('Cancel this event?','Guhagarika iki gikorwa?','Annuler cet événement ?'),T('Everyone who said they are going will be told.','Abavuze ko bazaza bose bazamenyeshwa.','Les participants seront prévenus.'),T('Cancel event','Hagarika','Annuler l’événement'),`cmCancelGo(${id})`,T('Keep event','Komeza','Garder'));
window.cmCancelGo=id=>{S.posts.find(x=>x.id===id).ev.x=1;ref();toast(T('Event cancelled','Igikorwa cyahagaritswe','Événement annulé'))};
window.cmRemind=id=>{const e=S.posts.find(x=>x.id===id).ev;e.rm=e.rm?0:1;ref();toast(e.rm?T('We will remind you 1 hour before','Tuzakwibutsa isaha 1 mbere','Rappel 1 h avant'):T('Reminder off','Wibutswa byavuyeho','Rappel désactivé'))};
window.cmAt=n=>{const i=$('#cmr');if(i){i.value='@'+n+' ';i.focus()}};
window.postGo=window.cqGo;
})();
</script>
<script>
/* v100: Bank round 2: saved payees (send, favourite, edit, delete), scheduled and repeating transfers (send now, skip, pause, cancel), monthly budget with spending by category, report a problem with case tracking. rw/fr strings need native review */
(function(){
const T=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e;
const esc=s=>String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/"/g,'&quot;');
const sh=h=>{$('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" style="max-height:86%;overflow-y:auto">'+h+'</div>'};
const H1='class="h1" style="font-size:22px;line-height:30px"';
const W='style="padding:8px 0 0;flex-wrap:wrap;overflow:visible"';
const cb=(on,fn,l)=>`<button class="${on?'on':''}" aria-pressed="${!!on}" onclick="${fn}">${l}</button>`;
const conf=(t,m,ok,fn,keep)=>sh(`<div ${H1}>${t}</div><div class="mu" style="font-size:15px;margin:8px 0 20px">${m}</div><button class="btn sec2" style="color:var(--er)" onclick="closeSheet();${fn}">${ok}</button><button class="btn" style="margin-top:10px" onclick="closeSheet()">${keep}</button>`);
const kv=(a,b)=>`<div style="display:flex;justify-content:space-between;gap:10px;padding:9px 0;font-size:15px;border-top:0"><span class="mu">${a}</span><b style="text-align:right">${b}</b></div>`;
const fee=a=>a>100000?500:100;
const BK=()=>window.BANKS||['Bank of Kigali','I&M Bank','Equity Bank','Access Bank'];
const dstr=d=>new Date(d).toLocaleDateString('en-GB',{weekday:'short',day:'numeric',month:'short'});
const rnd=n=>String(Math.floor(Math.random()*Math.pow(10,n))).padStart(n,'0');
const num=s=>Number(String(s).replace(/,/g,''));
const pay=id=>S.bp.find(p=>p.id===id);
const pn=p=>p.k||p.n;
if(!S.b2){S.b2=1;S.bid=10;S.bp=[{id:1,n:'Diane M.',k:'Landlord',bank:'Bank of Kigali',acc:'0123456789',fav:1},{id:2,n:'Kigali Tutors',k:'',bank:'Equity Bank',acc:'0456123789',fav:0}];S.bsc=[];S.bbg={lim:0,al:1};S.bcs=[]}
window.bkGo=n=>{S.stack.push(n);render('push')};
const ttl=s=>`<div style="font-size:17px;font-weight:800;margin:22px 0 4px">${s}</div>`;
/* ---- bank screen entry rows ---- */
const sp=()=>{const o={};let t=0;S.act.forEach(a=>{if(a[3]<0){const g=a[0],c=g==='send'?'Transfers':g==='bus'?'Transport':(g==='bill'||g==='receipt')?'Bills':(g==='phone'||g==='airtime')?'Airtime':'Other';o[c]=(o[c]||0)-a[3];t-=a[3]}});return[t,o]};
const _b=screens.bank;
screens.bank=()=>{const h=_b(),sc=S.bsc.filter(s=>!s.done).length,[t]=sp(),L=S.bbg.lim;
return h.replace(/(class="sech">(?:Control|Igenzura|Contrôle)<\/div>)/,m=>m+row('bank',T('Payees','Abakwakira','Bénéficiaires'),S.bp.length+T(' saved',' babitswe',' enregistrés'),'',"bkGo('bkpay')")+row('receipt',T('Scheduled transfers','Kohereza byateganyijwe','Virements programmés'),sc?sc+T(' active',' bikora',' actifs'):T('Set up repeating payments','Tegura kwishyura buri gihe','Programmez des paiements'),'',"bkGo('bksch')")+row('trend',T('Budget','Ingengo y’imari','Budget'),L?Math.round(t*100/L)+'% '+T('used','yakoreshejwe','utilisé'):T('Track your spending','Kurikirana ibyo ukoresha','Suivez vos dépenses'),'',"bkGo('bkbud')")+row('shield',T('Report a problem','Tanga ikibazo','Signaler un problème'),S.bcs.length?S.bcs.length+T(' cases',' ibibazo',' dossiers'):T('Dispute a payment','Kujuririra ubwishyu','Contester un paiement'),'',"bkGo('bkcase')"))};
/* ---- payees ---- */
const prow=p=>`<div class="row tap" role="button" tabindex="0" onclick="bpOpen(${p.id})"><div class="ico">${gl('community',30)}</div><div style="flex:1;min-width:0"><div class="t">${esc(pn(p))}</div><div class="s">${esc(p.n)} · ${esc(p.bank)} ••${p.acc.slice(-4)}</div></div><div class="r" style="color:var(--lk)">${p.fav?'★':''}</div></div>`;
screens.bkpay=()=>{const l=S.bp.slice().sort((a,b)=>(b.fav?1:0)-(a.fav?1:0));return `${bar(T('Payees','Abakwakira','Bénéficiaires'))}<div class="pad" style="padding-top:12px"><button class="btn" onclick="bpEdit(0)">+ ${T('Add a payee','Ongeraho ukwakira','Ajouter un bénéficiaire')}</button>${l.length?'':`<div class="mu" style="padding-top:24px;text-align:center;line-height:22px">${T('Save people you pay often. Sending takes two taps.','Bika abo wishyura kenshi. Kohereza bifata gukanda kabiri.','Enregistrez vos bénéficiaires habituels. Envoyer prend deux touches.')}</div>`}${l.map(prow).join('')}</div>`};
window.bpOpen=id=>{const p=pay(id);sh(`<div ${H1}>${esc(pn(p))}</div><div style="margin-top:8px">${kv(T('Name','Izina','Nom'),esc(p.n))}${kv(T('Bank','Banki','Banque'),esc(p.bank))}${kv(T('Account','Konti','Compte'),'••'+p.acc.slice(-4))}</div><div class="row2" style="margin-top:16px"><button class="btn sec2" onclick="closeSheet();bsNew(${id})">${T('Schedule','Teganya','Programmer')}</button><button class="btn sec2" onclick="bpFav(${id})">${p.fav?'★ ':'☆ '}${T('Favourite','Ukunzwe','Favori')}</button></div><div class="row2" style="margin-top:10px"><button class="btn sec2" onclick="bpEdit(${id})">${T('Edit','Hindura','Modifier')}</button><button class="btn sec2" style="color:var(--er)" onclick="bpDel(${id})">${T('Delete','Siba','Supprimer')}</button></div><div class="bpbar"><button class="btn" onclick="bpSend(${id})">${T('Send money','Ohereza amafaranga','Envoyer de l’argent')}</button></div>`)};
window.bpSend=id=>{const p=pay(id);S.bx={bank:p.bank,acc:p.acc,amt:0};closeSheet();S.stack.push('bktx');render('push')};
window.bpFav=id=>{const p=pay(id);p.fav=p.fav?0:1;closeSheet();render('fade-none')};
window.bpDel=id=>{const p=pay(id);conf(T('Delete this payee?','Gusiba ukwakira?','Supprimer ce bénéficiaire ?'),esc(p.n)+' '+T('and their scheduled transfers will be removed.','n’ibyo wateganyije bizavanwaho.','et ses virements programmés seront supprimés.'),T('Delete','Siba','Supprimer'),`bpDelGo(${id})`,T('Keep payee','Reka ukwakira','Garder'))};
window.bpDelGo=id=>{S.bp=S.bp.filter(p=>p.id!==id);S.bsc=S.bsc.filter(s=>s.pid!==id);render('fade-none');toast(T('Payee deleted','Ukwakira yasibwe','Bénéficiaire supprimé'))};
window.bpEdit=id=>{const p=id?pay(id):{n:'',k:'',bank:BK()[0],acc:''};S.bpq={id,n:p.n,k:p.k||'',bank:p.bank,acc:p.acc,st:0};bpw.draw()};
const pr=()=>{const F=S.bpq,g=i=>$('#'+i);if(g('bpn'))F.n=g('bpn').value;if(g('bpk'))F.k=g('bpk').value;if(g('bpa')){F.acc=g('bpa').value.replace(/\D/g,'').slice(0,10);g('bpa').value=F.acc}return F};
/* v120: Bank payee is now step-by-step (name, bank, account number, optional nickname), one question per page, using the shared engine. */
const bpRd=()=>{const F=pr(),h=$('#bph');if(h)h.textContent=F.acc.length+'/10';return F};
const bpw=WZ.mk({id:'bp',rd:()=>bpRd(),steps:()=>['n','b','a','k'],final:()=>T('Save','Bika','Enregistrer'),go:()=>bpGo(),
ok:(F,k)=>k==='n'?!!F.n.trim():k==='a'?F.acc.length===10:true,opt:(F,k)=>k==='k'&&!F.k.trim(),
page:(k,F)=>{const Q={n:T('Who are you paying?','Wishyura nde?','Qui payez-vous ?'),b:T('Which bank?','Banki ihe?','Quelle banque ?'),a:T('What is the account number?','Nimero ya konti ni iyihe?','Quel est le numéro de compte ?'),k:T('Add a nickname?','Wongeraho izina ry’impimbano?','Ajouter un surnom ?')},q=Q[k];let body='',o={q};
if(k==='n'){o.min=110;body=`<input class="in" id="bpn" value="${esc(F.n)}" maxlength="40" oninput="WZ.r.bp.chk()" onkeydown="WZ.key(event,'bp')" aria-label="${q}" placeholder="${T('Full name','Amazina yose','Nom complet')}" style="font-size:20px;height:56px">`}
else if(k==='b'){o.btn=0;o.sum=esc(F.n);body=BK().map(b=>WZ.opt(F.bank===b,`WZ.r.bp.pick('bank',${WZ.q(b)})`,esc(b))).join('')}
else if(k==='a'){o.min=130;o.sum=esc(F.n)+' · '+esc(F.bank);body=`<input class="in" id="bpa" value="${esc(F.acc)}" inputmode="numeric" maxlength="10" oninput="WZ.r.bp.chk()" onkeydown="WZ.key(event,'bp')" aria-label="${q}" placeholder="0000000000" ${WZ.amt}><div class="sm mu" id="bph" style="margin-top:8px">${F.acc.length}/10</div>`}
else{o.min=130;o.sum=esc(F.n)+' · '+esc(F.bank)+' ••'+esc(F.acc.slice(-4));body=`<input class="in" id="bpk" value="${esc(F.k)}" maxlength="20" oninput="WZ.r.bp.chk()" onkeydown="WZ.key(event,'bp')" aria-label="${q}" placeholder="${T('Landlord','Nyir’inzu','Propriétaire')}" style="font-size:20px;height:56px">`}
o.body=body;return o}});
window.bpGo=()=>{const F=pr();if(!F.n.trim()||F.acc.length!==10)return;
if(S.bp.some(p=>p.id!==F.id&&p.bank===F.bank&&p.acc===F.acc)){toast(T('This payee is already saved','Uyu mwakira yabitswe','Déjà enregistré'));return}
if(F.id)Object.assign(pay(F.id),{n:F.n.trim(),k:F.k.trim(),bank:F.bank,acc:F.acc});else S.bp.push({id:++S.bid,n:F.n.trim(),k:F.k.trim(),bank:F.bank,acc:F.acc,fav:0});
closeSheet();render('fade-none');toast(T('Payee saved','Ukwakira yabitswe','Bénéficiaire enregistré'))};
/* ---- scheduled transfers ---- */
const FR=()=>({once:T('One time','Rimwe','Une fois'),week:T('Weekly','Buri cyumweru','Chaque semaine'),month:T('Monthly','Buri kwezi','Chaque mois')});
const STD=()=>[[1,T('Tomorrow','Ejo','Demain')],[7,T('In 7 days','Nyuma y’iminsi 7','Dans 7 jours')],[30,T('In 30 days','Nyuma y’iminsi 30','Dans 30 jours')]];
const adv=s=>{const d=new Date(s.next);if(s.fr==='week')d.setDate(d.getDate()+7);else if(s.fr==='month')d.setMonth(d.getMonth()+1);else{s.done=1;return}s.next=d.getTime()};
screens.bksch=()=>{const l=S.bsc.filter(s=>!s.done).sort((a,b)=>a.next-b.next);return `${bar(T('Scheduled transfers','Kohereza byateganyijwe','Virements programmés'))}<div class="pad" style="padding-top:12px"><button class="btn" onclick="bsNew(0)">+ ${T('New scheduled transfer','Guteganya kohereza','Nouveau virement')}</button>${l.length?'':`<div class="mu" style="padding-top:24px;text-align:center;line-height:22px">${T('Rent, school fees or a monthly gift. Set it once, we remind you each time.','Ubukode, amafaranga y’ishuri cyangwa impano. Tegura rimwe, tukwibutsa buri gihe.','Loyer, frais scolaires ou cadeau mensuel. Programmez une fois, nous vous le rappelons.')}</div>`}${l.map(s=>{const p=pay(s.pid);return `<div style="padding:16px 0;border-bottom:0"><div style="display:flex;justify-content:space-between;gap:8px"><b>${esc(pn(p))}</b><b>${fmt(s.amt)} RWF</b></div><div class="sm mu" style="margin-top:2px">${FR()[s.fr]} · ${s.p?T('Paused','Byahagaritswe','En pause'):T('Next ','Ikurikira ','Prochain ')+dstr(s.next)}${s.n?' · '+s.n+T(' sent',' byoherejwe',' envoyés'):''}</div><div class="chips" style="padding:10px 0 0"><button class="cch on" onclick="bsRun(${s.id})">${T('Send now','Ohereza ubu','Envoyer')}</button><button class="cch" onclick="bsSkip(${s.id})">${T('Skip next','Simbuka','Passer')}</button><button class="cch" onclick="bsPause(${s.id})">${s.p?T('Resume','Subukura','Reprendre'):T('Pause','Hagarika','Pause')}</button><button class="cch" style="color:var(--er)" onclick="bsDel(${s.id})">${T('Cancel','Hagarika','Annuler')}</button></div></div>`}).join('')}</div>`};
window.bsNew=pid=>{if(!S.bp.length){toast(T('Add a payee first','Banza wongere ukwakira','Ajoutez d’abord un bénéficiaire'));return}S.bsq={pid:pid||S.bp[0].id,amt:50000,ca:'50,000',fr:'month',d:7,st:0,pre:pid?1:0};bsw.draw()};
const sr=()=>{const F=S.bsq,a=$('#bsa');if(a){F.ca=a.value.replace(/\D/g,'').replace(/\B(?=(\d{3})+(?!\d))/g,',');a.value=F.ca}return F};
const sAmt=F=>F.ca?num(F.ca):F.amt;
/* v121: Scheduled transfer is step-by-step (to, amount, repeat, first date). The payee step is skipped when you start from a payee. */
const bsw=WZ.mk({id:'bs',rd:()=>sr(),steps:F=>[...(F.pre?[]:['to']),'amt','fr','d'],final:()=>T('Schedule','Teganya','Programmer'),go:()=>bsGo(),
ok:(F,k)=>k==='amt'?num(F.ca)>0:true,
page:(k,F)=>{const Q={to:T('Send to whom?','Wohereza nde?','À qui envoyer ?'),amt:T('How much each time?','Angahe buri gihe?','Quel montant à chaque fois ?'),fr:T('How often?','Kangahe?','À quelle fréquence ?'),d:T('When is the first transfer?','Kohereza kwa mbere ni ryari?','Quand a lieu le premier virement ?')},q=Q[k],nm=esc(pn(pay(F.pid)));let body='',o={q};
if(k==='to'){o.btn=0;body=S.bp.map(p=>WZ.opt(F.pid===p.id,`WZ.r.bs.pick('pid',${p.id})`,esc(pn(p)))).join('')}
else if(k==='amt'){o.min=170;o.sum=nm;body=`<input class="in" id="bsa" value="${esc(F.ca)}" inputmode="numeric" oninput="WZ.r.bs.chk()" onkeydown="WZ.key(event,'bs')" aria-label="${q}" placeholder="50,000" ${WZ.amt}><div class="sm mu" style="margin-top:8px">RWF</div>${WZ.quick('bsa',[10000,50000,100000],'bs')}`}
else if(k==='fr'){o.btn=0;o.sum=nm+' · '+fmt(sAmt(F))+' RWF';body=Object.entries(FR()).map(([x,v])=>WZ.opt(F.fr===x,`WZ.r.bs.pick('fr','${x}')`,v)).join('')}
else{o.min=240;o.sum=nm+' · '+fmt(sAmt(F))+' RWF · '+FR()[F.fr];body=STD().map(([d,l])=>WZ.opt(F.d===d,`WZ.r.bs.set('d',${d})`,l+' · '+dstr(Date.now()+d*864e5))).join('')+`<div class="sm mu" style="margin-top:12px;line-height:19px">${T('Fee ','Amafaranga y’inyongera ','Frais ')}${fmt(fee(sAmt(F)))} RWF. ${T('We remind you before each transfer. Nothing is sent without your tap.','Turakwibutsa mbere ya buri kohereza. Nta cyoherezwa utabyemeje.','Nous vous rappelons avant chaque virement. Rien n’est envoyé sans votre accord.')}</div>`}
o.body=body;return o}});
window.bsGo=()=>{const F=sr(),a=sAmt(F);if(!a){toast(T('Enter an amount','Andika amafaranga','Saisissez un montant'));return}S.bsc.push({id:++S.bid,pid:F.pid,amt:a,fr:F.fr,next:Date.now()+F.d*864e5,p:0,n:0});closeSheet();if(S.stack[S.stack.length-1]!=='bksch'){S.stack.push('bksch');render('push')}else render('fade-none');toast(T('Scheduled','Byateganyijwe','Programmé'))};
window.bsRun=id=>{const s=S.bsc.find(x=>x.id===id),p=pay(s.pid),f=fee(s.amt);
if(s.amt+f>S.bank){toast(T('Not enough balance','Amafaranga ntahagije','Solde insuffisant'));return}
if(s.amt+(S.lim.used||0)>S.lim.day){toast(T('Above your daily limit','Hejuru y’imbibi bya buri munsi','Au-dessus de votre plafond'));return}
S.bank-=s.amt+f;S.lim.used=(S.lim.used||0)+s.amt;addAct('send','To '+p.n+' · '+p.bank,'Sent',-s.amt,'Sent');addAct('send','Transfer fee','Paid',-f,'Paid');s.n++;adv(s);render('fade-none');toast(fmt(s.amt)+' RWF '+T('sent to ','byoherejwe kuri ','envoyés à ')+pn(p))};
window.bsSkip=id=>{adv(S.bsc.find(x=>x.id===id));render('fade-none');toast(T('Skipped','Byasimbutse','Passé'))};
window.bsPause=id=>{const s=S.bsc.find(x=>x.id===id);s.p=s.p?0:1;render('fade-none')};
window.bsDel=id=>conf(T('Cancel this transfer?','Guhagarika uku kohereza?','Annuler ce virement ?'),T('It will not run again.','Ntikongera gukora.','Il ne sera plus exécuté.'),T('Cancel transfer','Hagarika kohereza','Annuler le virement'),`bsDelGo(${id})`,T('Keep it','Kureka gukomeze','Garder'));
window.bsDelGo=id=>{S.bsc=S.bsc.filter(s=>s.id!==id);render('fade-none');toast(T('Cancelled','Byahagaritswe','Annulé'))};
/* ---- budget ---- */
const CN=()=>({Transfers:T('Transfers','Kohereza','Virements'),Bills:T('Bills','Fagitire','Factures'),Transport:T('Transport','Ingendo','Transport'),Airtime:T('Airtime','Airtime','Crédit téléphone'),Other:T('Other','Ibindi','Autre')});
screens.bkbud=()=>{const [t,o]=sp(),B=S.bbg,pc=B.lim?Math.round(t*100/B.lim):0,hot=B.lim&&pc>=80,cats=Object.entries(o).sort((a,b)=>b[1]-a[1]);
return `${bar(T('Budget','Ingengo y’imari','Budget'))}<div class="pad" style="padding-top:16px"><div class="sm mu">${T('Spent in your activity','Ibyakoreshejwe','Dépensé dans votre activité')}</div><div class="big" style="margin-top:4px">${fmt(t)} RWF</div>${B.lim?`<div style="height:10px;border-radius:5px;background:var(--chip);margin-top:14px;overflow:hidden" role="img" aria-label="${pc}%"><div style="height:100%;width:${Math.min(100,pc)}%;background:${pc>=100?'var(--er)':hot?'#F5A524':'var(--lk)'}"></div></div><div class="sm" style="margin-top:8px;font-weight:700;color:${pc>=100?'var(--er)':hot?'var(--mu)':'var(--ok)'}">${pc>=100?T('Over budget by ','Warengeje ingengo ya ','Dépassé de ')+fmt(t-B.lim)+' RWF':fmt(B.lim-t)+' RWF '+T('left of ','busigaye kuri ','restants sur ')+fmt(B.lim)+' RWF'}</div>`:`<div class="sm mu" style="margin-top:8px">${T('Set a monthly budget to see how much is left.','Shyiraho ingengo y’ukwezi urebe icyasigaye.','Fixez un budget mensuel pour voir ce qu’il reste.')}</div>`}${ttl(T('Monthly budget','Ingengo y’ukwezi','Budget mensuel'))}<div class="req" style="margin-top:6px">${[0,100000,300000,500000,1000000].map(a=>`<button class="${B.lim===a?'on':''}" onclick="bbSet(${a})">${a?fmt(a):T('None','Nta yo','Aucun')}</button>`).join('')}</div><div style="margin-top:12px"><button role="switch" aria-checked="${!!B.al}" onclick="bbAl()" style="display:flex;width:100%;align-items:center;justify-content:space-between;border:0;background:none;font:inherit;color:inherit;padding:12px 0;min-height:48px;text-align:left"><span style="font-weight:700;padding-right:12px">${T('Alert me at 80% of my budget','Menyesha nigeze kuri 80%','M’alerter à 80 % du budget')}</span><span aria-hidden="true" style="width:46px;height:28px;border-radius:14px;background:${B.al?'var(--lk)':'var(--chip)'};position:relative;flex:none"><i style="position:absolute;top:3px;left:${B.al?21:3}px;width:22px;height:22px;border-radius:11px;background:#fff;box-shadow:none"></i></span></button></div>${ttl(T('By category','Ukurikije ibyiciro','Par catégorie'))}${cats.length?cats.map(([k,v])=>`<div style="padding:10px 0"><div style="display:flex;justify-content:space-between;font-size:15px"><span>${CN()[k]}</span><b>${fmt(v)} RWF</b></div><div style="height:6px;border-radius:3px;background:var(--chip);margin-top:6px;overflow:hidden"><div style="height:100%;width:${Math.round(v*100/t)}%;background:var(--lk)"></div></div></div>`).join(''):`<div class="mu" style="padding:12px 0">${T('No spending yet.','Nta byakoreshejwe.','Aucune dépense.')}</div>`}<div class="sm mu" style="margin-top:8px;line-height:19px">${T('Based on the activity in this prototype.','Bishingiye ku bikorwa biri muri prototype.','Basé sur l’activité de ce prototype.')}</div></div>`};
window.bbSet=a=>{S.bbg.lim=a;render('fade-none');const t=sp()[0];if(a&&S.bbg.al&&t*100/a>=80)toast(T('You are already near this budget','Wegereje iyi ngengo','Vous approchez déjà de ce budget'))};
window.bbAl=()=>{S.bbg.al=S.bbg.al?0:1;render('fade-none')};
/* ---- report a problem ---- */
const RS=()=>[T('I did not make this payment','Si njye wakoze ubu bwishyu','Je n’ai pas fait ce paiement'),T('Charged twice','Narishyuye kabiri','Débité deux fois'),T('Wrong amount','Amafaranga atari yo','Montant erroné'),T('Service not received','Nta serivisi nabonye','Service non reçu'),T('Something else','Ikindi','Autre chose')];
const ST=()=>[T('Received','Byakiriwe','Reçu'),T('In review','Birasuzumwa','En cours d’examen'),T('Resolved','Byakemutse','Résolu')];
screens.bkcase=()=>`${bar(T('Report a problem','Tanga ikibazo','Signaler un problème'))}<div class="pad" style="padding-top:12px"><button class="btn" onclick="bcNew()">+ ${T('Dispute a payment','Kujuririra ubwishyu','Contester un paiement')}</button>${S.bcs.length?'':`<div class="mu" style="padding-top:24px;text-align:center;line-height:22px">${T('Charged twice or a payment you do not recognise? Tell us and track the case here.','Wishyuwe kabiri cyangwa ubwishyu utazi? Tubwire ukurikirane hano.','Débité deux fois ou paiement inconnu ? Dites-le-nous et suivez le dossier ici.')}</div>`}${S.bcs.map((c,i)=>`<div class="row tap" role="button" tabindex="0" onclick="bcOpen(${i})"><div style="flex:1;min-width:0"><div class="t">${esc(c.tx)}</div><div class="s">${c.id} · ${fmt(Math.abs(c.amt))} RWF</div></div><div class="r" style="color:${c.st?'var(--ok)':'var(--mu)'}">${ST()[c.st]}</div></div>`).join('')}</div>`;
window.bcNew=()=>{S.bcq={i:-1,r:-1,n:'',st:0};bcw.draw()};
const br=()=>{const F=S.bcq,n=$('#bcn');if(n)F.n=n.value;return F};
/* v121: Dispute a payment is step-by-step (which payment, what went wrong, optional details). Freeze-card help shows on the last page when the card may have been used. */
const bcw=WZ.mk({id:'bc',rd:()=>br(),steps:()=>['i','r','n'],final:()=>T('Send application','Ohereza','Envoyer'),go:()=>bcGo(),
ok:(F,k)=>k==='i'?F.i>=0:k==='r'?F.r>=0:true,opt:(F,k)=>k==='n'&&!F.n.trim(),
page:(k,F)=>{const Q={i:T('Which payment?','Ni ubuhe bwishyu?','Quel paiement ?'),r:T('What went wrong?','Ni iki cyabaye?','Que s’est-il passé ?'),n:T('Anything to add?','Hari icyo wongeraho?','Autre chose à ajouter ?')},q=Q[k];let body='',o={q};
if(k==='i'){o.btn=0;body=S.act.slice(0,8).map((a,i)=>WZ.opt(F.i===i,`WZ.r.bc.pick('i',${i})`,`${esc(a[1])}<div class="sm mu" style="font-weight:500;margin-top:2px">${esc(a[2])} · ${a[3]>0?'+':'−'}${fmt(Math.abs(a[3]))} RWF</div>`)).join('')}
else if(k==='r'){o.btn=0;o.sum=esc(S.act[F.i][1]);body=RS().map((r,i)=>WZ.opt(F.r===i,`WZ.r.bc.pick('r',${i})`,r)).join('')}
else{o.min=190;o.sum=esc(S.act[F.i][1])+' · '+RS()[F.r];body=`<textarea id="bcn" maxlength="200" aria-label="${q}" oninput="WZ.r.bc.chk()" placeholder="${T('Details (optional)','Ibisobanuro (si ngombwa)','Détails (facultatif)')}" ${WZ.txt}>${esc(F.n)}</textarea>${F.r===0&&S.card&&!S.card.frozen?`<div style="margin-top:12px;padding:12px 14px;border-radius:16px;background:var(--tint)"><b>${T('Think your card was used?','Utekereza ko ikarita yakoreshejwe?','Votre carte a-t-elle été utilisée ?')}</b><div><button class="cch on" style="height:40px;margin-top:8px" onclick="bcFreeze()">${T('Freeze card now','Hagarika ikarita ubu','Geler la carte')}</button></div></div>`:''}`}
o.body=body;return o}});
window.bcFreeze=()=>{S.card.frozen=true;toast(T('Card frozen','Ikarita yahagaritswe','Carte gelée'));if($('#bcgo'))bcw.draw()};
window.bcGo=()=>{const F=br();if(F.i<0||F.r<0)return;const a=S.act[F.i],c={id:'CS-'+rnd(5),tx:a[1],amt:a[3],r:F.r,n:F.n.trim(),st:0,when:new Date().toLocaleDateString('en-GB',{day:'numeric',month:'short'})};S.bcs.unshift(c);closeSheet();if(S.stack[S.stack.length-1]!=='bkcase'){S.stack.push('bkcase');render('push')}else render('fade-none');toast(T('Case opened: ','Ikibazo cyafunguwe: ','Dossier ouvert : ')+c.id);
setTimeout(()=>{if(S.bcs.includes(c)&&!c.st){c.st=1;toast(T('Case ','Ikibazo ','Dossier ')+c.id+T(' is in review',' kirasuzumwa',' en cours d’examen'));if(S.stack[S.stack.length-1]==='bkcase')render('fade-none')}},5000)};
window.bcOpen=i=>{const c=S.bcs[i];sh(`<div ${H1}>${esc(c.tx)}</div><div class="sm mu" style="margin-top:4px">${c.id} · ${c.when}</div><div style="margin:10px 0">${kv(T('Amount','Amafaranga','Montant'),fmt(Math.abs(c.amt))+' RWF')}${kv(T('Reason','Impamvu','Motif'),RS()[c.r])}${c.n?kv(T('Your note','Icyo wanditse','Votre note'),esc(c.n)):''}</div>${ttl(T('Status','Uko bimeze','Statut'))}${ST().map((s,k)=>`<div style="display:flex;align-items:center;gap:12px;padding:8px 0;font-weight:${k===c.st?800:600};color:${k<=c.st?'var(--tx)':'var(--tt)'}"><span aria-hidden="true" style="width:14px;height:14px;border-radius:7px;background:${k<=c.st?'var(--lk)':'var(--chip)'}"></span>${s}</div>`).join('')}<div class="sm mu" style="margin:6px 0 14px;line-height:19px">${T('We reply within 3 working days.','Dusubiza mu minsi 3 y’akazi.','Réponse sous 3 jours ouvrés.')}</div><button class="btn sec2" style="color:var(--er)" onclick="bcWd(${i})">${T('Withdraw case','Kuraho ikibazo','Retirer le dossier')}</button><button class="btn" style="margin-top:10px" onclick="closeSheet()">${T('Close','Funga','Fermer')}</button>`)};
window.bcWd=i=>conf(T('Withdraw this case?','Gukuraho iki kibazo?','Retirer ce dossier ?'),T('We will stop reviewing it.','Tuzahagarika kugisuzuma.','Nous cesserons de l’examiner.'),T('Withdraw','Kuraho','Retirer'),`bcWdGo(${i})`,T('Keep case','Reka gikomeze','Garder'));
window.bcWdGo=i=>{S.bcs.splice(i,1);render('fade-none');toast(T('Case withdrawn','Ikibazo cyakuweho','Dossier retiré'))};
})();
</script>
<style id="auth94">
.car{display:inline-block;width:2px;height:28px;background:var(--lk);vertical-align:-4px;margin-left:2px}
.phf{border-bottom-color:var(--lk)}
.phd{color:var(--tt);opacity:.35}#phone:has(#obnext) .dhint{display:none}
@keyframes blk{50%{opacity:0}}@keyframes shk{20%,60%{transform:translateX(-8px)}40%,80%{transform:translateX(8px)}}
@media (prefers-reduced-motion:no-preference){.car{animation:blk 1s steps(1) infinite}.shk{animation:shk .35s}}
.av94{width:56px;height:56px;border-radius:28px;background:var(--tint);color:var(--tintfg);font-size:22px;font-weight:800;display:flex;align-items:center;justify-content:center;margin:0 auto 16px}
.lk94{display:flex;justify-content:center;align-items:center;gap:14px;padding-top:14px;font-size:14px;font-weight:700;color:var(--mu)}
.lk94 button{border:0;background:none;font:inherit;color:inherit;padding:6px 2px}.lk94 i{width:3px;height:3px;border-radius:2px;background:var(--tt)}
.keys button.kb94{color:var(--tintfg)}
.in.nm94{font-size:24px;height:60px;border-bottom-color:var(--lk)}
</style>
<script>
(function(){
const FP='<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 11v3a6 6 0 0 1-1 3M8 11a4 4 0 0 1 8 0v1a10 10 0 0 1-1.5 5M5 11a7 7 0 0 1 14 0v2M9 17.5c.4 1.2.8 2.2 1.2 3M12 3a8 8 0 0 1 8 8"/></svg>';
const CK='<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#17171C" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L19 7"/></svg>';
const DEL='<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6H9l-5 6 5 6h11zM12 10l4 4M16 10l-4 4"/></svg>';
Object.assign(L.en,{o_phone_h:"What's your phone number?",o_phone_s:"We’ll find your account, or help you create one.",o_ph_err:"Rwandan mobile numbers start with 7, for example 788 123 456.",o_name_h:"What's your name?",o_name_s:"Use the name on your national ID.",o_full:"Full name",o_agree:"Agree and continue",o_pin2_h:"Enter it once more",o_wb:"Welcome back, {n}",o_login_s:"Enter your PIN to sign in",o_wrong:"That PIN isn’t right. {n} tries left.",o_wrong1:"That PIN isn’t right. 1 try left.",o_lock:"Too many tries. Try again in a few seconds.",o_forgot:"Forgot PIN?",o_other:"Use a different number",o_bio:"Use fingerprint",o_done_h:"Welcome, {n}",o_done_s:"Your account is ready.",o_start:"Get started"});
Object.assign(L.rw,{o_phone_s:"Turakwinjiza cyangwa tugufungurire konti.",o_ph_err:"Numero za telefoni mu Rwanda zitangira kuri 7",o_name_s:"Ni gukanda gake gusa kugira ngo ufungure konti.",o_full:"Amazina yose",o_agree:"Emeza ukomeze",o_pin2_h:"Ongera uyandike",o_wb:"Murakaza neza, {n}",o_login_s:"Shyiramo PIN yawe kugira ngo winjire",o_wrong:"PIN siyo. Usigaranye kugerageza {n}",o_wrong1:"PIN siyo. Usigaranye kugerageza 1",o_lock:"Wagerageje kenshi. Ongera nyuma y'akanya gato.",o_forgot:"Wibagiwe PIN?",o_other:"Koresha indi numero",o_bio:"Koresha igikumwe",o_done_h:"Murakaza neza, {n}",o_done_s:"Konti yawe irahari.",o_start:"Tangira"});
Object.assign(L.fr,{o_phone_s:"Nous vous connectons ou créons votre compte.",o_ph_err:"Les numéros mobiles rwandais commencent par 7",o_name_s:"Quelques touches suffisent pour créer votre compte.",o_full:"Nom complet",o_agree:"Accepter et continuer",o_pin2_h:"Saisissez-le encore une fois",o_wb:"Content de vous revoir, {n}",o_login_s:"Saisissez votre code PIN pour vous connecter",o_wrong:"PIN incorrect. {n} essais restants",o_wrong1:"PIN incorrect. 1 essai restant",o_lock:"Trop d'essais. Réessayez dans quelques secondes.",o_forgot:"PIN oublié ?",o_other:"Utiliser un autre numéro",o_bio:"Utiliser l'empreinte",o_done_h:"Bienvenue, {n}",o_done_s:"Votre compte est prêt.",o_start:"Commencer"});
OB9.splice(0,OB9.length,'obPhone','obName','obPin','obPin2','obDone');
const ACCTS={'788123456':{ph:'788123456',name:'Amina Uwase',pin:'123456'}};
const fm=p=>[p.slice(0,3),p.slice(3,6),p.slice(6,9)].filter(Boolean).join(' ');
const phOk=p=>p.length===9&&p[0]==='7';
const phHtml=p=>`<span style="color:var(--mu)">+250</span> ${p?fm(p):'<span class="phd">788 123 456</span>'}${p.length<9?'<span class="car"></span>':''}`;
const keys=bio=>`<div class="keys">${['1','2','3','4','5','6','7','8','9','bio','0','del'].map(k=>k==='bio'?(bio?`<button class="kb94" onclick="obBio()" aria-label="${t('o_bio')}">${FP}</button>`:'<button disabled aria-hidden="true"></button>'):`<button onclick="obKey('${k}')" aria-label="${k==='del'?t('o_del'):k}">${k==='del'?DEL:k}</button>`).join('')}</div>`;
const dots=v=>`<div class="dots6" id="pd">${[0,1,2,3,4,5].map(i=>`<i class="${i<v.length?'on':''}"></i>`).join('')}</div>`;
const first=n=>(n||'').trim().split(/\s+/)[0]||'';
const pe=(msg,err)=>{const e=$('#pe');if(e){e.textContent=msg;e.style.color=err?'var(--er)':'var(--mu)'}};
const pinUpd=v=>{const d=$('#pd');if(d)[...d.children].forEach((e,i)=>e.classList.toggle('on',i<v.length))};
const shake=()=>{const d=$('#pd');if(d){d.classList.remove('shk');void d.offsetWidth;d.classList.add('shk')}try{navigator.vibrate&&navigator.vibrate([30,40,30])}catch(e){}};

screens.obPhone=()=>{const o=S.ob,bad=o.ph&&o.ph[0]!=='7';return `<div class="ahead"><a href="#" class="sm" style="color:var(--tt);font-weight:600" onclick="obSkip();return false">Skip (prototype)</a><button class="chip" onclick="langSheet()" aria-label="Language">${t('o_lang')}</button></div><div class="pad" style="padding-top:24px"><div class="h1">${t('o_phone_h')}</div></div><div class="field phf"><div id="phv" style="font-size:28px;font-weight:800;min-height:38px">${phHtml(o.ph)}</div></div><div class="pad" style="padding-top:10px"><div id="phe" style="font-size:14px;min-height:20px;color:${bad?'var(--er)':'var(--mu)'}">${bad?t('o_ph_err'):t('o_phone_s')}</div><a href="#" class="sm" style="color:var(--lk);font-weight:700;display:inline-block;margin-top:6px" onclick="phDemo();return false">Prototype: fill a returning number</a></div>${keys(false)}<div class="cta"><button id="obnext" class="btn" ${phOk(o.ph)?'':'disabled'} onclick="obPhoneNext()">${t('nx')}</button></div>`};

screens.obName=()=>`${obbar()}<div class="pad" style="padding-top:16px"><div class="h1">${t('o_name_h')}</div><div class="mu" style="font-size:16px;margin-top:8px">${t('o_name_s')}</div></div><div class="pad" style="padding-top:20px"><input class="in nm94" id="fn" autocomplete="name" autocapitalize="words" aria-label="${t('o_full')}" placeholder="${t('o_full')}" value="${(S.ob.name||'').replace(/"/g,'&quot;')}" oninput="obF('name',this.value)" onkeydown="if(event.key==='Enter')obNameNext()"></div><div class="cta"><button id="obnext" class="btn" ${(S.ob.name||'').trim().length>1?'':'disabled'} onclick="obNameNext()">${t('nx')}</button></div>`;

screens.obLogin=()=>{const o=S.ob,a=o.acct||{name:'Amina Uwase'};return `${obbar()}<div class="pad" style="padding-top:8px;text-align:center"><div class="av94" aria-hidden="true">${first(a.name).charAt(0).toUpperCase()}</div><div class="h1">${t('o_wb').replace('{n}',first(a.name))}</div><div id="pe" style="font-size:15px;margin-top:8px;min-height:22px;color:${o.err?'var(--er)':'var(--mu)'}">${o.err||t('o_login_s')}</div></div>${dots(o.lp||'')}<div class="lk94"><button onclick="soon()">${t('o_forgot')}</button><i></i><button onclick="obOther()">${t('o_other')}</button></div>${keys(true)}`};

screens.obPin=()=>`${obbar()}<div class="pad" style="padding-top:16px;text-align:center"><div class="h1">${t('o_pin_h')}</div><div class="mu" style="font-size:16px;margin-top:8px">${t('o_pin_s')}</div></div>${dots(S.ob.pin)}${keys(false)}`;

screens.obPin2=()=>`${obbar()}<div class="pad" style="padding-top:16px;text-align:center"><div class="h1">${t('o_pin2_h')}</div><div id="pe" style="color:var(--er);font-size:14px;margin-top:8px;min-height:20px">${S.ob.err||''}</div></div>${dots(S.ob.pin2)}${keys(false)}`;

screens.obDone=()=>`<div style="display:flex;flex-direction:column;align-items:center;text-align:center;padding:clamp(28px,12vh,190px) 32px 0"><div class="g3">${gl('success3d',132)}</div><div class="h1" style="margin-top:26px">${t('o_done_h').replace('{n}',first(S.name))}</div><div class="mu" style="font-size:16px;margin-top:10px">${t('o_done_s')}</div><div class="fine" style="margin-top:14px">Prototype: no real account was created.</div></div><div class="cta" style="border:0"><button class="btn" onclick="obStart()">${t('o_start')}</button></div>`;

window.phDemo=()=>{S.ob.ph='788123456';render('fade-none')};
window.obGo=s=>{const o=S.ob;S.obStep=s;if(s==='obPin'){o.pin='';o.pin2='';o.err=''}if(s==='obLogin'){o.lp='';o.err='';o.fails=0;o.lock=false}render('push')};
window.obBack=()=>{const m={obName:'obPhone',obLogin:'obPhone',obPin:'obName',obPin2:'obPin'};S.obStep=m[S.obStep]||'obPhone';render('pop')};
window.obOther=()=>{S.ob.ph='';S.ob.acct=null;S.obStep='obPhone';render('pop')};
window.obF=(k,v)=>{S.ob[k]=v;S.ob.first=(S.ob.name||'').trim();const b=$('#obnext');if(b)b.disabled=!((S.ob.name||'').trim().length>1)};
window.obPhoneNext=()=>{const o=S.ob;if(!phOk(o.ph))return;const b=$('#obnext');b.disabled=true;b.textContent='Checking…';setTimeout(()=>{const a=ACCTS[o.ph];if(a){o.acct=a;obGo('obLogin')}else obGo('obName')},650)};
window.obNameNext=()=>{if((S.ob.name||'').trim().length>1)termsSheet()};

const tcUpd=()=>{const o=S.ob,all=o.t&&o.p&&o.c;[['t',o.t],['p',o.p],['c',o.c],['all',all]].forEach(([k,v])=>{const e=$('#cb_'+k);if(e){e.classList.toggle('on',!!v);e.innerHTML=v?CK:''}const r=$('#tr_'+k);if(r)r.setAttribute('aria-checked',!!v)});const g=$('#tcgo');if(g)g.disabled=!all};
window.tcTog=k=>{S.ob[k]=!S.ob[k];tcUpd()};
window.tcAll=()=>{const v=!(S.ob.t&&S.ob.p&&S.ob.c);S.ob.t=S.ob.p=S.ob.c=v;tcUpd()};
window.tcGo=()=>{closeSheet();obGo('obPin')};
window.termsSheet=()=>{const row=(k,l)=>`<div class="row tap" id="tr_${k}" role="checkbox" aria-checked="false" tabindex="0" style="padding:12px 0" onclick="tcTog('${k}')"><div class="cb" id="cb_${k}"></div><div style="flex:1;font-size:15px;font-weight:600">${l}</div><button class="ib" aria-label="View" style="width:32px;height:32px" onclick="event.stopPropagation();soon()"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--tt)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></button></div>`;
$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" role="dialog" aria-modal="true" aria-label="${t('o_terms_h')}" style="padding-bottom:calc(28px + env(safe-area-inset-bottom,0px))"><div class="h1" style="font-size:22px;line-height:30px">${t('o_terms_h')}</div><div class="mu" style="font-size:14px;margin:6px 0 16px">${t('o_terms_s')}</div><div class="row tap" id="tr_all" role="checkbox" aria-checked="false" tabindex="0" style="background:var(--chip);border-radius:16px;padding:14px 16px" onclick="tcAll()"><div class="cb" id="cb_all"></div><div style="font-size:16px;font-weight:800">${t('o_all')}</div></div><div style="padding:6px 0 14px">${row('t',t('s_terms'))}${row('p',t('s_priv'))}${row('c',t('s_credit'))}</div><button class="btn" id="tcgo" disabled onclick="tcGo()">${t('o_agree')}</button></div>`;tcUpd()};

window.obKey=d=>{try{navigator.vibrate&&navigator.vibrate(6)}catch(e){}const o=S.ob,st=S.obStep;
if(st==='obPhone'){if(d==='del')o.ph=o.ph.slice(0,-1);else if(o.ph.length<9&&!(o.ph===''&&d==='0'))o.ph+=d;const v=$('#phv');if(v)v.innerHTML=phHtml(o.ph);const bad=o.ph&&o.ph[0]!=='7',e=$('#phe');if(e){e.textContent=bad?t('o_ph_err'):t('o_phone_s');e.style.color=bad?'var(--er)':'var(--mu)'}const b=$('#obnext');if(b)b.disabled=!phOk(o.ph);return}
if(o.lock)return;const k=st==='obPin'?'pin':st==='obPin2'?'pin2':'lp';if(d!=='del'&&(o[k]||'').length>=6)return;
if(o.err){o.err='';pe(st==='obLogin'?t('o_login_s'):'',false)}
o[k]=d==='del'?(o[k]||'').slice(0,-1):(o[k]||'')+d;pinUpd(o[k]);if(o[k].length<6)return;
if(st==='obPin'){setTimeout(()=>obGo('obPin2'),180)}
else if(st==='obPin2'){if(o.pin2===o.pin)setTimeout(obCreate,240);else{o.err=t('o_mis');pe(o.err,true);shake();setTimeout(()=>{o.pin2='';pinUpd('')},350)}}
else if(st==='obLogin'){const a=o.acct||{pin:'123456'};if(o.lp===a.pin)setTimeout(loginOk,200);else{o.fails=(o.fails||0)+1;const left=3-o.fails;shake();if(left<=0){o.lock=true;o.err=t('o_lock');pe(o.err,true);setTimeout(()=>{o.lp='';pinUpd('')},350);setTimeout(()=>{o.lock=false;o.fails=0;o.err='';pe(t('o_login_s'),false)},3000)}else{o.err=left===1?t('o_wrong1'):t('o_wrong').replace('{n}',left);pe(o.err,true);setTimeout(()=>{o.lp='';pinUpd('')},350)}}}
if(typeof upd9==='function')upd9()};
window.obBio=()=>{const o=S.ob;if(o.lock)return;o.lp='123456';pinUpd(o.lp);setTimeout(loginOk,450)};
window.loginOk=()=>{const a=S.ob.acct||{name:'Amina Uwase',pin:'123456'};S.cur=a;S.name=a.name;S.apin=a.pin;S.auth=true;S.obStep=null;S.ob.lp='';render('fade')};
window.obCreate=()=>{const o=S.ob,name=(o.name||'').trim();S.name=name;S.apin=o.pin;const a={ph:o.ph,name,pin:o.pin};ACCTS[o.ph]=a;S.cur=a;S.obStep='obDone';render('push')};
window.logOut=()=>{const a=S.cur||{name:S.name||'Amina Uwase',pin:S.apin||'123456'};S.auth=false;S.stack=[];S.obStep='obLogin';S.ob={ph:'',first:'',last:'',name:'',t:false,p:false,c:false,m:false,pin:'',pin2:'',err:'',lp:'',fails:0,lock:false,acct:a};render('fade')};

{const _r=render;render=function(){_r.apply(this,arguments);if(!S.auth&&S.obStep==='obName'){const i=$('#fn');if(i)setTimeout(()=>i.focus({preventScroll:true}),60)}}}
document.addEventListener('keydown',e=>{if(S.auth||document.querySelector('#layer .sheet'))return;if(/INPUT|TEXTAREA/.test((document.activeElement||{}).tagName))return;if(!['obPhone','obPin','obPin2','obLogin'].includes(S.obStep))return;if(/^\d$/.test(e.key))window.obKey(e.key);else if(e.key==='Backspace')window.obKey('del');else if(e.key==='Enter'&&S.obStep==='obPhone'){const b=$('#obnext');if(b&&!b.disabled)b.click()}});
if(!S.auth)render('fade-none');
})();
</script>
<style id="bank95">
.cc95{margin:0 24px;padding:0 18px;border-radius:20px;background:var(--chip)}
.cc95 .r95{display:flex;align-items:center;gap:12px;padding:13px 0}.cc95 .r95+.r95{border-top:0}
.doc95{background:#fff;color:#191F28;border-radius:16px;padding:20px;border:1px solid var(--ln);margin-top:16px;font-size:14px;line-height:22px}
.doc95 hr{border:0;border-top:1px solid #E5E8EB;margin:12px 0}
.screen .ppa i{background:var(--chip)}.ban95{margin:18px 24px 0;padding:16px;border-radius:20px;background:var(--tint);color:var(--tintfg);font-size:15px;line-height:22px}
</style>
<script>
(function(){
const T=(e,r,f)=>({en:e,rw:r||e,fr:f||e}[S.lang]||e);
const esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const sh=(body,label)=>{$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" role="dialog" aria-modal="true" aria-label="${esc(label||'')}" style="padding-bottom:calc(28px + env(safe-area-inset-bottom,0px));max-height:90%;overflow:auto">${body}</div>`};
const H=(x)=>`<div class="h1" style="font-size:22px;line-height:30px">${x}</div>`;
const SUB=x=>`<div class="mu" style="font-size:14px;line-height:20px;margin:6px 0 16px">${x}</div>`;
S.cc=S.cc||{online:true,intl:false,tap:true,atm:true,lim:500000,virt:null,repl:null,br:'Kigali City Tower'};
const BR=['Kigali City Tower','Nyabugogo','Huye'];
const rnd=n=>String(Math.floor(Math.random()*Math.pow(10,n))).padStart(n,'0');
const copy=v=>{try{navigator.clipboard.writeText(v).catch(()=>{})}catch(e){}};
const sw=(on,fn,l)=>`<div class="sw ${on?'on':''}" role="switch" aria-checked="${!!on}" aria-label="${esc(l)}" tabindex="0" onclick="${fn}"><i></i></div>`;
const btn=(l,fn,c)=>`<button class="btn ${c||''}" style="margin-top:10px" onclick="${fn}">${l}</button>`;
const dstr=d=>d.toLocaleDateString(({en:'en-GB',fr:'fr-FR',rw:'en-GB'})[S.lang]||'en-GB',{day:'numeric',month:'long',year:'numeric'});

/* ---------- PIN pad inside a sheet (updates in place) ---------- */
let PP=null;
function pinPad(c){PP={c,buf:'',fails:0,busy:false};const L=c.len||6;
 const AR='<svg data-t26="1" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 12H4.5M10.5 5.5L4 12l6.5 6.5"/></svg>';
 sh(`<div class="bar"><button class="ib" aria-label="${T('Back','Subira inyuma','Retour')}" onclick="closeSheet()">${ic('back',24)}</button></div><div style="padding:12px 24px 0"><div style="font-size:22px;line-height:30px;font-weight:700">${esc(c.title)}</div>${c.sub?`<div class="mu" style="font-size:15px;line-height:20px;margin-top:1px">${esc(c.sub)}</div>`:''}<div id="ppd" data-pg="1" role="status" style="display:flex;gap:14px;margin:40px 0 0;min-height:30px;align-items:center">${Array.from({length:L},(_,i)=>`<span style="width:16px;height:16px;border-radius:8px;background:var(--ln)"></span>`).join('')}</div><div id="ppe" role="alert" style="min-height:20px;margin-top:12px;font-size:14px;line-height:20px;font-weight:500;color:var(--er)"></div></div><button class="btn" id="czgo" disabled onclick="gkGo()">${T('Continue','Komeza','Continuer')}</button><div class="keys tkpsh">${['1','2','3','4','5','6','7','8','9','','0','b'].map(k=>k===''?'<span></span>':`<button class="czk" aria-label="${k==='b'?T('Delete','Siba','Effacer'):k}" onclick="gkKey('${k}')">${k==='b'?AR:k}</button>`).join('')}</div>`,c.title)}
const ppDots=()=>{const d=$('#ppd');if(d)[...d.children].forEach((e,i)=>e.style.background=i<PP.buf.length?'var(--lk)':'var(--ln)');const g=$('#czgo');if(g&&PP)g.disabled=PP.buf.length<(PP.c.len||6)};
window.gkKey=k=>{if(!PP||PP.busy||!$('#ppd'))return;const c=PP.c,L=c.len||6;try{navigator.vibrate&&navigator.vibrate(6)}catch(e){}
 if(k==='b')PP.buf=PP.buf.slice(0,-1);else if(PP.buf.length<L)PP.buf+=k;$('#ppe').textContent='';ppDots();
};
window.gkGo=()=>{if(!PP||PP.busy||!$('#ppd'))return;const c=PP.c,L=c.len||6;if(PP.buf.length<L)return;PP.busy=true;
 setTimeout(()=>{const v=PP.buf,r=c.check?c.check(v):null;
  if(r){PP.fails++;PP.buf='';const d=$('#ppd');if(d){d.classList.remove('shk');void d.offsetWidth;d.classList.add('shk')}try{navigator.vibrate&&navigator.vibrate([30,40,30])}catch(e){}
   if(c.maxFails&&PP.fails>=c.maxFails){closeSheet();toast(T('Too many wrong tries. Try again later.','Wagerageje kenshi nabi. Ongera nyuma.','Trop d’essais incorrects. Réessayez plus tard.'));return}
   const e=$('#ppe');if(e)e.textContent=r;setTimeout(()=>{ppDots();PP&&(PP.busy=false)},300);return}
  PP.busy=false;c.ok(v)},180)};
document.addEventListener('keydown',e=>{if(!$('#layer .sheet [data-pg]'))return;if(/^\d$/.test(e.key))gkKey(e.key);else if(e.key==='Backspace')gkKey('b')});
const gate=(ok,sub)=>pinPad({title:T('Enter your PIN','Andika PIN yawe','Saisissez votre PIN'),sub:sub||T('To keep your card safe, we need to check it’s you.','Kugira ngo ikarita yawe irindwe, tugomba kumenya ko ari wowe.','Pour protéger votre carte, nous devons vérifier votre identité.'),len:6,maxFails:3,check:v=>v===(S.apin||'123456')?null:T('Wrong PIN. Try again.','PIN siyo. Ongera ugerageze.','PIN incorrect. Réessayez.'),ok});

/* ---------- card ---------- */
const pan=v=>v?S.cc.virt:{pan:'5412 7750 3318 '+S.card.last,exp:'10/29',cvv:'482'};
let tm=0;
window.ccShow=v=>gate(()=>{const x=v?S.cc.virt:{pan:'5412 7750 3318 '+S.card.last,exp:'10/29',cvv:'482'};
 const r=(l,val,raw)=>`<div class="r95"><div style="flex:1"><div class="sm mu">${l}</div><b style="font-size:18px;letter-spacing:.5px">${val}</b></div><button class="chip" onclick="ccCopy('${raw||val}')">${T('Copy','Koporora','Copier')}</button></div>`;
 sh(`<div id="ccd">${H(v?T('Online card','Ikarita yo kuri interineti','Carte en ligne'):T('Card details','Amakuru y’ikarita','Détails de la carte'))}${SUB(T('Hides automatically in 30 seconds.','Ihisha ubwayo nyuma y’amasegonda 30.','Se masque automatiquement dans 30 secondes.'))}<div class="cc95" style="margin:0">${r(T('Card number','Nimero y’ikarita','Numéro de carte'),x.pan,x.pan.replace(/ /g,''))}${r(T('Expiry','Itariki irangiriraho','Expiration'),x.exp)}${r('CVV',x.cvv)}</div>${btn(T('Done','Byarangiye','Terminé'),'closeSheet()','sec2')}</div>`,'Card details');
 clearTimeout(tm);tm=setTimeout(()=>{if($('#ccd'))closeSheet()},30000)});
window.ccCopy=v=>{copy(v);toast(T('Copied','Byakoporowe','Copié'))};
window.ccFreeze=()=>{S.card.frozen=!S.card.frozen;render('fade-none');toast(S.card.frozen?T('Card frozen','Ikarita yahagaritswe','Carte gelée'):T('Card unfrozen','Ikarita yongeye gukora','Carte dégelée'))};
window.ccTg=k=>{S.cc[k]=!S.cc[k];render('fade-none')};
window.ccLim=v=>{S.cc.lim=v;render('fade-none');toast(T('Daily limit set to ','Imbibi ya buri munsi ni ','Plafond quotidien : ')+fmt(v)+' RWF')};
window.ccPin=()=>gate(()=>pinPad({title:T('Choose a card PIN','Hitamo PIN y’ikarita','Choisissez un PIN de carte'),sub:T('4 digits, used at ATMs and shops.','Imibare 4, ikoreshwa kuri ATM no mu maduka.','4 chiffres, pour les DAB et les magasins.'),len:4,check:v=>(/^(\d)\1+$/.test(v)||v==='1234'||v==='4321')?T('Too easy to guess. Try another.','Biroroshye kuvumbura. Gerageza ikindi.','Trop facile à deviner. Essayez un autre.'):null,ok:a=>pinPad({title:T('Confirm card PIN','Emeza PIN y’ikarita','Confirmez le PIN de carte'),len:4,check:b=>b===a?null:T('PINs did not match.','PIN ntizihuye.','Les PIN ne correspondent pas.'),ok:()=>{closeSheet();toast(T('Card PIN changed','PIN y’ikarita yahindutse','PIN de carte modifié'))}})}));
window.ccVirtNew=()=>gate(()=>{S.cc.virt={pan:'5412 7750 9046 '+rnd(4),exp:'10/27',cvv:rnd(3)};closeSheet();render('fade-none');toast(T('Online card created','Ikarita yo kuri interineti yakozwe','Carte en ligne créée'))});
window.ccVirtDel=()=>{sh(`${H(T('Delete online card?','Gusiba ikarita yo kuri interineti?','Supprimer la carte en ligne ?'))}${SUB(T('Shops using this number will stop working. You can create a new one any time.','Amaduka akoresha iyi nimero azareka gukora. Ushobora gukora indi igihe icyo ari cyo cyose.','Les commerçants utilisant ce numéro ne fonctionneront plus. Vous pouvez en créer une nouvelle.'))}${btn(T('Delete','Siba','Supprimer'),'ccVirtDel2()')}${btn(T('Keep it','Yibike','Garder'),'closeSheet()','sec2')}`)};
window.ccVirtDel2=()=>{S.cc.virt=null;closeSheet();render('fade-none');toast(T('Online card deleted','Ikarita yasibwe','Carte supprimée'))};
window.ccBr=b=>{S.cc.br=b;ccLost()};
window.ccLost=()=>{sh(`<div style="margin-bottom:10px">${gl('warning3d',60)}</div>${H(T('Block this card?','Guhagarika ikarita?','Bloquer cette carte ?'))}${SUB(T('We block it now so nobody can use it. Your online card keeps working. Collect a free replacement at:','Turayihagarika none kugira ngo hatagira uyikoresha. Ikarita yo kuri interineti irakomeza gukora. Fata ikarita nshya ku buntu kuri:','Nous la bloquons maintenant. Votre carte en ligne continue de fonctionner. Retirez une carte de remplacement gratuite à :'))}<div class="req" style="flex-wrap:wrap">${BR.map(b=>`<button class="${S.cc.br===b?'on':''}" onclick="ccBr('${b}')">${b}</button>`).join('')}</div>${btn(T('Block and order new card','Hagarika utumize indi','Bloquer et commander'),'ccLostGo()')}${btn(T('Cancel','Reka','Annuler'),'closeSheet()','sec2')}`)};
window.ccLostGo=()=>gate(()=>{const d=new Date();d.setDate(d.getDate()+3);S.card.frozen=true;S.cc.repl={b:S.cc.br,last:rnd(4),eta:d.getTime()};closeSheet();render('fade-none');toast(T('Card blocked','Ikarita yahagaritswe','Carte bloquée'))});
window.ccGot=()=>{S.card={last:S.cc.repl.last,frozen:false};S.cc.repl=null;render('fade-none');toast(T('New card activated','Ikarita nshya yatangiye gukora','Nouvelle carte activée'))};
window.ccClose=()=>{sh(`${H(T('Close this card?','Gufunga ikarita?','Fermer cette carte ?'))}${SUB(T('You can order a new card whenever you like.','Ushobora gutumiza indi igihe icyo ari cyo cyose.','Vous pouvez commander une nouvelle carte à tout moment.'))}${btn(T('Close card','Funga ikarita','Fermer la carte'),'ccCloseGo()')}${btn(T('Keep card','Komeza ikarita','Garder la carte'),'closeSheet()','sec2')}`)};
window.ccCloseGo=()=>gate(()=>{S.card=null;S.cc.virt=null;S.cc.repl=null;closeSheet();S.stack[S.stack.length-1]='nocard';render('fade');toast(T('Card closed','Ikarita yafunzwe','Carte fermée'))});

screens.card=()=>{const c=S.card,cc=S.cc,rp=cc.repl,fz=c.frozen;
 const act=(i,l,fn,dis)=>`<button class="ppa" ${dis?'disabled style="opacity:.4"':''} onclick="${fn}"><i>${ic(i,22)}</i>${l}</button>`;
 const tg=(k,l,s)=>`<div class="r95"><div style="flex:1"><div style="font-size:16px;font-weight:700">${l}</div><div class="sm mu">${s}</div></div>${sw(cc[k],`ccTg('${k}')`,l)}</div>`;
 const lims=[100000,250000,500000,1000000];
 return `${bar(t('c_title'))}${cardVis(c,false)}${rp?`<div class="ban95"><b>${T('Card blocked','Ikarita yahagaritswe','Carte bloquée')}</b><br>${T('Your new card will be ready at ','Ikarita yawe nshya izaba iri kuri ','Votre nouvelle carte sera prête à ')}${esc(rp.b)} · ${dstr(new Date(rp.eta))}.</div><div class="pad" style="padding-top:12px">${btn(T('I collected my new card','Mfashe ikarita yanjye nshya','J’ai retiré ma nouvelle carte'),'ccGot()')}</div>`:`<div class="pad" style="display:flex;gap:8px;padding-top:18px">${act('lock',T('Show details','Erekana','Afficher'),'ccShow(0)')}${act('shield',fz?T('Unfreeze','Kuvanaho','Dégeler'):T('Freeze','Hagarika','Geler'),'ccFreeze()')}${act('gear',T('Card PIN','PIN y’ikarita','PIN carte'),'ccPin()')}</div>`}
 <div class="pad" style="padding-top:22px;padding-bottom:8px"><div style="font-size:18px;font-weight:800">${T('Controls','Igenzura','Contrôles')}</div></div><div class="cc95">${tg('online',T('Online payments','Kwishyura kuri interineti','Paiements en ligne'),T('Shops and apps','Amaduka na porogaramu','Boutiques et applications'))}${tg('intl',T('International use','Gukoresha mu mahanga','Utilisation à l’étranger'),T('Pay and withdraw abroad','Kwishyura no gukuramo hanze','Payer et retirer à l’étranger'))}${tg('tap',T('Contactless','Gukoza ikarita','Sans contact'),T('Tap to pay in shops','Kwishyura ukoza','Payer en approchant'))}${tg('atm',T('ATM withdrawals','Gukuramo kuri ATM','Retraits DAB'),T('Cash from machines','Amafaranga kuri mashini','Espèces aux distributeurs'))}</div>
 <div class="pad" style="padding-top:22px"><div style="font-size:18px;font-weight:800">${T('Daily spending limit','Imbibi y’amafaranga ya buri munsi','Plafond de dépense quotidien')}</div><div class="sm mu" style="margin-top:4px">${T('0 of ','0 kuri ','0 sur ')}${fmt(cc.lim)} RWF ${T('used today','yakoreshejwe uyu munsi','utilisés aujourd’hui')}</div><div class="req" style="margin-top:12px;flex-wrap:wrap">${lims.map(v=>`<button class="${cc.lim===v?'on':''}" onclick="ccLim(${v})">${fmt(v)}</button>`).join('')}</div></div>
 <div class="pad" style="padding-top:22px;padding-bottom:8px"><div style="font-size:18px;font-weight:800">${T('Online card','Ikarita yo kuri interineti','Carte en ligne')}</div></div>${cc.virt?`<div class="cc95"><div class="r95"><div style="flex:1"><div style="font-size:16px;font-weight:700">•••• ${cc.virt.pan.slice(-4)}</div><div class="sm mu">${T('Separate number for online shopping','Nimero yihariye yo kugura kuri interineti','Numéro séparé pour les achats en ligne')}</div></div><button class="chip" onclick="ccShow(1)">${T('Show','Erekana','Afficher')}</button><button class="chip" aria-label="${T('Delete','Siba','Supprimer')}" onclick="ccVirtDel()">${ic('plus',16).replace('<svg','<svg style="transform:rotate(45deg)"')}</button></div></div>`:row('card',T('Create an online card','Kora ikarita yo kuri interineti','Créer une carte en ligne'),T('A separate number for online shopping. Delete it any time.','Nimero yihariye yo kugura kuri interineti. Ushobora kuyisiba igihe cyose.','Un numéro séparé pour les achats en ligne. Supprimable à tout moment.'),'','ccVirtNew()')}
 <div class="pad" style="padding-top:22px">${row('warning3d',T('Report lost or stolen','Menyesha ko yabuze cyangwa yibwe','Signaler perdue ou volée'),'','','ccLost()')}${row('receipt',T('Close card','Funga ikarita','Fermer la carte'),'','','ccClose()')}</div><div class="pad fine" style="padding-top:18px">${t('c_disc')}</div>`};

/* ---------- documents ---------- */
const NAME=()=>esc(S.name||'Amina Uwase'),ACCN='0214-3058-1980';
const intr=()=>18400+(S.dep?S.dep.i:0);
const DOCS={
 letter:()=>[T('Account confirmation letter','Ibaruwa yemeza konti','Lettre de confirmation de compte'),`${T('To whom it may concern,','Ku bireba bose,','À qui de droit,')}<br>${T('This confirms that','Ibi byemeza ko','Nous confirmons que')} <b>${NAME()}</b> ${T('holds an itunda Bank account, number','afite konti ya itunda Bank, nimero','détient un compte itunda Bank, numéro')} <b>${ACCN}</b>${T(', opened on 12 March 2024. The account is active and in good standing.',', yafunguwe ku itariki ya 12 Werurwe 2024. Konti irakora kandi imeze neza.',', ouvert le 12 mars 2024. Le compte est actif et en règle.')}`],
 balance:()=>[T('Proof of balance','Icyemezo cy’amafaranga ariho','Attestation de solde'),`${T('This confirms that the account of','Ibi byemeza ko konti ya','Nous confirmons que le compte de')} <b>${NAME()}</b> (${ACCN}) ${T('had an available balance of','yari ifite amafaranga ari','présentait un solde disponible de')} <b>${fmt(S.bank)} RWF</b> ${T('on','ku itariki ya','le')} ${dstr(new Date())}.`],
 interest:()=>[T('Interest certificate','Icyemezo cy’inyungu','Certificat d’intérêts'),`${T('This confirms that','Ibi byemeza ko','Nous confirmons que')} <b>${NAME()}</b> (${ACCN}) ${T('earned','yungutse','a perçu')} <b>${fmt(intr())} RWF</b> ${T('in interest from 1 January 2026 to','mu nyungu kuva ku wa 1 Mutarama 2026 kugeza ku','en intérêts du 1er janvier 2026 au')} ${dstr(new Date())}.`]};
window.bkDoc=k=>{const [ti,body]=DOCS[k](),ref='IT-DOC-'+rnd(6);S.dref=ref;
 sh(`${H(ti)}<div class="doc95"><div style="display:flex;justify-content:space-between;align-items:center"><b style="font-size:15px">itunda Bank</b><span style="font-size:12px;color:#6B7684">${ref}</span></div><div style="font-size:12px;color:#6B7684">${dstr(new Date())}</div><hr><div>${body}</div><hr><div style="font-size:12px;color:#6B7684">${T('Generated electronically. Sample document for this prototype.','Byakozwe mu buryo bw’ikoranabuhanga. Inyandiko y’icyitegererezo ya prototype.','Généré électroniquement. Document d’exemple pour ce prototype.')}</div></div>${btn(T('Share','Sangiza','Partager'),`bkDocShare('${k}')`)}${btn(T('Done','Byarangiye','Terminé'),'closeSheet()','sec2')}`,ti)};
window.bkDocShare=k=>{const [ti,body]=DOCS[k](),txt=ti+' · '+S.dref+'\n'+body.replace(/<br>/g,'\n').replace(/<[^>]+>/g,'');
 if(navigator.share){navigator.share({title:ti,text:txt}).catch(()=>{})}else{copy(txt);toast(T('Copied to share','Byakoporowe ngo bisangizwe','Copié pour partager'))}};
window.bkDocs=()=>{S.stack.push('bkdocs');render('push')};
screens.bkdocs=()=>`${bar(T('Documents & letters','Inyandiko n’amabaruwa','Documents et lettres'))}<div class="pad" style="padding-top:16px"><div class="mu" style="font-size:15px;line-height:22px">${T('Proof of your account, ready in seconds. Use it for rent, visas, school or employers.','Icyemezo cya konti yawe, kiboneka mu masegonda. Gikoreshe ku nzu, viza, ishuri cyangwa abakoresha.','La preuve de votre compte, en quelques secondes. Pour un loyer, un visa, l’école ou un employeur.')}</div></div><div class="pad" style="padding-top:8px">${row('receipt',DOCS.letter()[0],T('Confirms you hold an account','Yemeza ko ufite konti','Confirme que vous avez un compte'),'','bkDoc(\'letter\')')}${row('coin',DOCS.balance()[0],T('Your balance today','Amafaranga ufite uyu munsi','Votre solde aujourd’hui'),'','bkDoc(\'balance\')')}${row('trend',DOCS.interest()[0],T('Interest earned this year','Inyungu watunze uyu mwaka','Intérêts perçus cette année'),'','bkDoc(\'interest\')')}${row('bill',T('Statement','Raporo','Relevé'),T('Pick a period, CSV or PDF','Hitamo igihe, CSV cyangwa PDF','Choisissez une période, CSV ou PDF'),'','bkStmt()')}</div>`;
/* v382: Proof of balance */
const PB_P=[['visa','Visa application','Gusaba viza','Demande de visa'],['rent','Rent','Inzu','Loyer'],['school','School fees','Amafaranga y’ishuri','Frais de scolarité'],['work','Employer or bank','Umukoresha cyangwa banki','Employeur ou banque'],['other','Other','Ikindi','Autre']];
const pbMinOf=b=>{const st=b>=1e6?1e5:b>=1e5?1e4:b>=1e4?1e3:b>=1e3?100:0;return st?Math.floor(b/st)*st:0};
const pbTime=d=>d.toLocaleTimeString([], {hour:'2-digit',minute:'2-digit',hour12:false});
const pbData=()=>{const P=S.pb,now=P.ts,pu=PB_P.find(x=>x[0]===P.purpose)||PB_P[4],mn=pbMinOf(S.bank),min=P.mode==='min'&&mn>0,amt=min?mn:S.bank;
 const acc=P.mask?ACCN.replace(/^(\d{4})-\d{4}-(\d{4})$/,'$1-••••-$2'):ACCN;
 return {ti:T('Proof of balance','Icyemezo cy’amafaranga ariho','Attestation de solde'),now,pu:T(pu[1],pu[2],pu[3]),min,amt,acc,ref:P.ref,
  till:new Date(now.getTime()+30*864e5)}};
const pbLines=d=>{const when=dstr(d.now)+' '+T('at','saa','à')+' '+pbTime(d.now);
 return {body:`${T('This confirms that the account of','Ibi byemeza ko konti ya','Nous confirmons que le compte de')} <b>${NAME()}</b> (${d.acc}) ${d.min?T('had an available balance of at least','yari ifite nibura amafaranga ari','présentait un solde disponible d’au moins'):T('had an available balance of','yari ifite amafaranga ari','présentait un solde disponible de')} <b>${fmt(d.amt)} RWF</b> ${T('on','ku itariki ya','le')} ${when}.`,
  purpose:T('Issued at the request of the account holder for: ','Yatanzwe ku busabe bwa nyiri konti kuri: ','Délivré à la demande du titulaire du compte pour : ')+d.pu+'.',
  valid:T('Valid for 30 days, until ','Irakora iminsi 30, kugeza ku ','Valable 30 jours, jusqu’au ')+dstr(d.till)+'.',
  verify:T('Verify this document at itunda.rw/verify with reference ','Emeza iyi nyandiko kuri itunda.rw/verify ukoresheje nimero ','Vérifiez ce document sur itunda.rw/verify avec la référence ')+d.ref+'.'}};
const pbDocHTML=d=>{const L=pbLines(d),G='font-size:12px;color:#6B7684';
 return `<div style="display:flex;justify-content:space-between;align-items:center"><b style="font-size:15px">itunda Bank</b><span style="${G}">${d.ref}</span></div><div style="${G}">${dstr(d.now)} · ${pbTime(d.now)}</div><hr><div style="font-size:16px;font-weight:800;letter-spacing:.2px">${d.ti.toUpperCase()}</div><div style="margin-top:8px">${L.body}</div><div style="margin:12px 0;padding:12px 14px;border-radius:12px;background:#F2F4F6"><div style="${G}">${d.min?T('Available balance, at least','Amafaranga ariho, nibura','Solde disponible, au moins'):T('Available balance','Amafaranga ariho','Solde disponible')}</div><div style="font-size:24px;font-weight:800">${fmt(d.amt)} RWF</div></div><div>${esc(L.purpose)}</div><div style="margin-top:6px">${L.valid}</div><hr><div style="${G}">${L.verify}</div><div style="${G};margin-top:6px">${T('Generated electronically. Sample document for this prototype.','Byakozwe mu buryo bw’ikoranabuhanga. Inyandiko y’icyitegererezo ya prototype.','Généré électroniquement. Document d’exemple pour ce prototype.')}</div>`};
const pbText=d=>{const L=pbLines(d);return (d.ti+' · '+d.ref+'\n'+itundaStrip(L.body)+'\n'+L.purpose+'\n'+L.valid+'\n'+L.verify)};
const itundaStrip=h=>h.replace(/<br>/g,'\n').replace(/<[^>]+>/g,'');
const pbChips=()=>{const P=S.pb,mn=pbMinOf(S.bank);
 const pc=PB_P.map(x=>`<button data-p="${x[0]}" class="${P.purpose===x[0]?'on':''}" aria-pressed="${P.purpose===x[0]}" onclick="pbSet('purpose','${x[0]}')">${T(x[1],x[2],x[3])}</button>`).join('');
 const am=`<button data-m="exact" class="${P.mode==='exact'?'on':''}" aria-pressed="${P.mode==='exact'}" onclick="pbSet('mode','exact')">${T('Exact balance','Amafaranga yose','Solde exact')}</button><button data-m="min" ${mn?'':'disabled'} class="${P.mode==='min'?'on':''}" aria-pressed="${P.mode==='min'}" onclick="pbSet('mode','min')">${mn?T('At least '+fmt(mn)+' RWF','Nibura '+fmt(mn)+' RWF','Au moins '+fmt(mn)+' RWF'):T('At least…','Nibura…','Au moins…')}</button>`;
 return {pc,am}};
window.pbOpen=()=>{S.pb={purpose:'visa',mode:'exact',mask:false,ts:new Date(),ref:'IT-DOC-'+rnd(6)};const c=pbChips(),d=pbData();
 const lab=t=>`<div class="lab" style="margin:16px 0 8px;font-size:14px;font-weight:700">${t}</div>`;
 sh(`${H(d.ti)}${SUB(T('Choose what to show. The letter updates as you choose.','Hitamo ibyo kwerekana. Ibaruwa ihinduka uko uhitamo.','Choisissez ce qui apparaît. La lettre se met à jour.'))}${lab(T('What is it for?','Bigenewe iki?','Pour quel usage ?'))}<div class="req" id="pbp" style="flex-wrap:wrap">${c.pc}</div>${lab(T('Amount to show','Amafaranga yo kwerekana','Montant à afficher'))}<div class="req" id="pbm" style="flex-wrap:wrap">${c.am}</div><div class="sm mu" id="pbh" style="margin-top:8px;line-height:18px">${T('“At least” keeps your exact balance private.','“Nibura” ihisha amafaranga yawe nyayo.','« Au moins » garde votre solde exact privé.')}</div>
 <div id="pbsw" style="display:flex;align-items:center;gap:12px;margin-top:14px"><div style="flex:1;min-width:0"><div style="font-size:15px;font-weight:700">${T('Hide part of account number','Hisha igice cya nimero ya konti','Masquer une partie du numéro de compte')}</div><div class="sm mu" id="pbacc">${d.acc}</div></div>${sw(false,'pbSet(\'mask\',!S.pb.mask)',T('Hide part of account number','Hisha igice cya nimero ya konti','Masquer une partie du numéro de compte'))}</div>
 <div class="doc95" id="pbdoc">${pbDocHTML(d)}</div>${btn(T('Share','Sangiza','Partager'),'pbShare()')}${btn(T('Done','Byarangiye','Terminé'),'closeSheet()','sec2')}`,d.ti)};
window.pbSet=(k,v)=>{if(!S.pb)return;S.pb[k]=v;const c=pbChips(),d=pbData();const pp=$('#pbp'),pm=$('#pbm'),dc=$('#pbdoc'),ac=$('#pbacc');
 if(pp)pp.innerHTML=c.pc;if(pm)pm.innerHTML=c.am;if(dc)dc.innerHTML=pbDocHTML(d);if(ac)ac.textContent=d.acc;
 if(k==='mask'){const sb=document.querySelector('#pbsw [role=switch]');if(sb){sb.classList.toggle('on',!!v);sb.setAttribute('aria-checked',!!v)}}};
window.pbShare=()=>{const d=pbData(),txt=pbText(d);S.dhist=S.dhist||[];if(!S.dhist.some(x=>x.ref===d.ref))S.dhist.unshift({ti:d.ti,pu:d.pu,ref:d.ref,ts:d.now.getTime(),till:d.till.getTime(),html:pbDocHTML(d),txt});S.dhist=S.dhist.slice(0,8);
 if(S.stack[S.stack.length-1]==='bkdocs'){const y=$('#sc')?$('#sc').scrollTop:0;render('fade-none');if($('#sc'))$('#sc').scrollTop=y}
 if(navigator.share){navigator.share({title:d.ti,text:txt}).catch(()=>{})}else{copy(txt);toast(T('Copied to share','Byakoporowe ngo bisangizwe','Copié pour partager'))}};
const _bk=window.bkDoc;window.bkDoc=k=>k==='balance'?pbOpen():_bk(k);
window.bkHist=i=>{const d=(S.dhist||[])[i];if(!d)return;const old=Date.now()>d.till;
 sh(`${H(d.ti)}${old?`<div class="sm" style="color:#D98A00;font-weight:700;margin-top:6px">${T('Expired on ','Yarangiye ku ','Expiré le ')+dstr(new Date(d.till))}</div>`:''}<div class="doc95">${d.html}</div>${btn(T('Share','Sangiza','Partager'),`bkHistShare(${i})`)}${btn(T('Done','Byarangiye','Terminé'),'closeSheet()','sec2')}`,d.ti)};
window.bkHistShare=i=>{const d=(S.dhist||[])[i];if(!d)return;if(navigator.share){navigator.share({title:d.ti,text:d.txt}).catch(()=>{})}else{copy(d.txt);toast(T('Copied to share','Byakoporowe ngo bisangizwe','Copié pour partager'))}};
const _bd=screens.bkdocs;screens.bkdocs=()=>{let h=_bd();const H2=S.dhist||[];if(!H2.length)return h;
 return h+`<div class="pad" style="padding-top:22px;padding-bottom:4px"><div style="font-size:18px;font-weight:800">${T('Recently issued','Ibyatanzwe vuba','Émis récemment')}</div></div><div class="pad" style="padding-top:4px">${H2.map((d,i)=>row('receipt',d.ti+' · '+esc(d.pu),dstr(new Date(d.ts))+' · '+d.ref+(Date.now()>d.till?' · '+T('Expired','Yarangiye','Expiré'):''),'',`bkHist(${i})`)).join('')}</div>`};
const _b=screens.bank;screens.bank=()=>_b().replace('<div class="sec"><div class="sech">Recommended for you</div>',m=>`<div class="sec"><div class="sech">${T('Cards & documents','Amakarita n’inyandiko','Cartes et documents')}</div>${row('card',T('Card','Ikarita','Carte'),S.card?'•••• '+S.card.last+(S.card.frozen?' · '+t('c_frz'):''):T('Get your itunda card','Fata ikarita yawe ya itunda','Obtenez votre carte itunda'),'','openCard()')}${row('receipt',T('Documents & letters','Inyandiko n’amabaruwa','Documents et lettres'),T('Account letter, proof of balance','Ibaruwa ya konti, icyemezo cy’amafaranga','Lettre de compte, attestation de solde'),'','bkDocs()')}</div>`+m);
window.gkGate=gate;
})();
</script>
<style id="pay96">
.bl96{margin:0 24px;padding:16px 0}
.bars96{display:flex;align-items:flex-end;gap:8px;height:96px;margin-top:14px}.bars96 div{flex:1;border-radius:6px 6px 2px 2px;background:var(--tint);min-height:4px}.bars96 div.on{background:var(--br)}
.cd96{font-size:40px;font-weight:800;letter-spacing:6px;text-align:center;background:var(--chip);border-radius:20px;padding:18px 0;margin:14px 0 6px}
</style>
<script>
(function(){
const T=(e,r,f)=>({en:e,rw:r||e,fr:f||e}[S.lang]||e);
const esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const sh=(body,label)=>{$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" role="dialog" aria-modal="true" aria-label="${esc(label||'')}" style="padding-bottom:calc(28px + env(safe-area-inset-bottom,0px));max-height:90%;overflow:auto">${body}</div>`};
const H=x=>`<div class="h1" style="font-size:22px;line-height:30px">${x}</div>`;
const SUB=x=>`<div class="mu" style="font-size:14px;line-height:20px;margin:6px 0 16px">${x}</div>`;
const btn=(l,fn,c,dis)=>`<button class="btn ${c||''}" style="margin-top:10px" ${dis?'disabled':''} onclick="${fn}">${l}</button>`;
const rnd=n=>String(Math.floor(Math.random()*Math.pow(10,n))).padStart(n,'0');
const rowx=(a,b,first)=>`<div style="display:flex;justify-content:space-between;gap:16px;min-height:46px;align-items:center;font-size:15px;${first?'':'border-top:0'}"><span class="mu">${a}</span><b style="text-align:right">${b}</b></div>`;
const copy=v=>{try{navigator.clipboard.writeText(v).catch(()=>{})}catch(e){}};
const sw=(on,fn,l)=>`<div class="sw ${on?'on':''}" role="switch" aria-checked="${!!on}" aria-label="${esc(l)}" tabindex="0" onclick="${fn}"><i></i></div>`;
const dstr=(d,o)=>d.toLocaleDateString(({en:'en-GB',fr:'fr-FR',rw:'en-GB'})[S.lang]||'en-GB',o||{day:'numeric',month:'short'});
const tm=()=>new Date().toLocaleTimeString('en-GB',{hour:'2-digit',minute:'2-digit'});

/* ================= Cash at an agent ================= */
S.ag=S.ag||{mode:'out',amt:20000,code:null,exp:0};
const feeOf=(m,a)=>m==='out'?Math.max(100,Math.round(a*.01)):0;
const AG_MIN=1000,AG_MAX=500000;
const agOk=()=>{const A=S.ag,fee=feeOf(A.mode,A.amt);return A.amt>=AG_MIN&&A.amt<=AG_MAX&&!(A.mode==='out'&&A.amt+fee>S.pay)};
const agErr=()=>{const A=S.ag,fee=feeOf(A.mode,A.amt);return A.amt>AG_MAX||(A.amt>0&&A.amt<AG_MIN)||(A.mode==='out'&&A.amt>0&&A.amt+fee>S.pay)};
const agMsg=()=>{const A=S.ag,out=A.mode==='out',fee=feeOf(A.mode,A.amt);
 return A.amt>AG_MAX?T('The most for one code is '+fmt(AG_MAX)+' RWF.','Ntarenza '+fmt(AG_MAX)+' RWF kuri kode imwe.','Maximum '+fmt(AG_MAX)+' RWF par code.')
 :A.amt>0&&A.amt<AG_MIN?T('The least is '+fmt(AG_MIN)+' RWF.','Ntoya ni '+fmt(AG_MIN)+' RWF.','Minimum '+fmt(AG_MIN)+' RWF.')
 :out&&A.amt>0&&A.amt+fee>S.pay?T('Not enough in itunda Pay. You have '+fmt(S.pay)+' RWF.','Nta mafaranga ahagije muri itunda Pay. Ufite '+fmt(S.pay)+' RWF.','Solde insuffisant sur itunda Pay. Vous avez '+fmt(S.pay)+' RWF.')
 :out?T('Fee: 1%, at least 100 RWF.','Ikiguzi: 1%, nibura 100 RWF.','Frais : 1 %, minimum 100 RWF.'):T('Deposits are free.','Kubitsa ni ubuntu.','Les dépôts sont gratuits.')};
const agBtn=()=>agOk()?T('Get code for ','Fata kode ya ','Code pour ')+fmt(S.ag.amt)+' RWF':T('Enter an amount','Andika amafaranga','Saisissez un montant');
const agRow=(a,id,v)=>`<div style="display:flex;justify-content:space-between;gap:16px;min-height:44px;align-items:center;font-size:15px"><span class="mu">${a}</span><b id="${id}" style="text-align:right">${v}</b></div>`;
const agVals=()=>{const A=S.ag,out=A.mode==='out',ok=A.amt>0,fee=feeOf(A.mode,A.amt),tot=A.amt+fee;return {r:fmt(A.amt)+' RWF',f:ok&&fee?fmt(fee)+' RWF':T('Free','Ubuntu','Gratuit'),t:fmt(out?tot:A.amt)+' RWF',b:fmt(Math.max(0,out?S.pay-(ok?tot:0):S.pay+(ok?A.amt:0)))+' RWF'}};
screens.agent96=()=>{const A=S.ag,out=A.mode==='out',v=agVals();
 return `${bar(T('Cash at an agent','Amafaranga ku mukozi','Espèces chez un agent'))}<div class="pad" style="padding-top:12px">
<div class="req lim4" role="radiogroup">${[['out',T('Withdraw','Gukuramo','Retirer')],['in',T('Deposit','Kubitsa','Déposer')]].map(([k,l])=>`<button role="radio" aria-checked="${A.mode===k}" class="${A.mode===k?'on':''}" onclick="agMode('${k}')">${l}</button>`).join('')}</div>
<div class="sm mu" style="margin-top:22px">${T('Amount','Amafaranga','Montant')}</div>
<div style="display:flex;align-items:baseline;gap:8px;margin-top:6px"><input id="agA" inputmode="numeric" autocomplete="off" aria-label="${T('Amount in RWF','Amafaranga muri RWF','Montant en RWF')}" value="${A.amt?fmt(A.amt):''}" placeholder="0" oninput="agI(this)" style="flex:1;min-width:0;border:0;outline:0;background:none;font:inherit;font-size:40px;font-weight:800;letter-spacing:-1px;color:var(--tx);padding:0"><b style="font-size:20px;color:var(--tt)">RWF</b></div>
<div id="agM" class="sm" aria-live="polite" style="margin-top:6px;min-height:20px;color:${agErr()?'var(--er)':'var(--tt)'}">${agMsg()}</div>
<div class="req lim4" id="agC" style="margin-top:14px">${[10000,20000,50000,100000].map(x=>`<button data-v="${x}" class="${A.amt===x?'on':''}" onclick="agQ(${x})">${fmt(x)}</button>`).join('')}</div>
<div style="margin-top:22px;border-top:1px solid var(--ln);padding-top:4px">${agRow(T('itunda Pay balance','Amafaranga ya itunda Pay','Solde itunda Pay'),'agP',fmt(S.pay)+' RWF')}${agRow(out?T('You receive in cash','Uhabwa mu ntoki','Vous recevez en espèces'):T('You hand over','Utanga','Vous remettez'),'agR',v.r)}${agRow(T('Fee','Ikiguzi','Frais'),'agF',v.f)}${agRow(out?T('Taken from itunda Pay','Bikurwa kuri itunda Pay','Prélevé sur itunda Pay'):T('Added to itunda Pay','Byongerwa kuri itunda Pay','Ajouté à itunda Pay'),'agT',v.t)}${agRow(T('Pay balance after','Amafaranga nyuma','Solde après'),'agB',v.b)}</div>
<div style="margin-top:22px;font-size:15px;font-weight:800">${T('How it works','Uko bikora','Comment ça marche')}</div>
<div class="sm mu" style="margin-top:8px;line-height:22px">1. ${T('Get a one-time code (good for 10 minutes).','Fata kode imwe (imara iminota 10).','Obtenez un code à usage unique (valable 10 minutes).')}<br>2. ${T('Show it to any itunda agent.','Yereke umukozi wese wa itunda.','Montrez-le à un agent itunda.')}<br>3. ${out?T('The agent hands you the cash.','Umukozi aguha amafaranga.','L’agent vous remet les espèces.'):T('Hand the cash to the agent.','Tanga amafaranga ku mukozi.','Remettez les espèces à l’agent.')}</div>
<div class="fine" style="margin-top:14px">${T('Sample agent. No real cash moves.','Umukozi w’icyitegererezo. Nta mafaranga nyayo.','Agent d’exemple. Aucun argent réel.')}</div></div>
<div style="height:110px"></div><div class="cta"><button class="btn" id="agG" onclick="agCode()" ${agOk()?'':'disabled'}>${agBtn()}</button></div>`};
const agSync=()=>{const A=S.ag,m=$('#agM'),g=$('#agG'),v=agVals();
 if(m){m.textContent=agMsg();m.style.color=agErr()?'var(--er)':'var(--tt)'}
 if(g){g.disabled=!agOk();g.textContent=agBtn()}
 [['agR','r'],['agF','f'],['agT','t'],['agB','b']].forEach(([id,k])=>{const e=document.getElementById(id);if(e)e.textContent=v[k]});
 document.querySelectorAll('#agC button').forEach(b=>b.classList.toggle('on',b.dataset.v==String(A.amt)))};
window.agI=el=>{const n=Math.min(parseInt(el.value.replace(/\D/g,''),10)||0,99999999);S.ag.amt=n;el.value=n?fmt(n):'';agSync()};
window.agQ=n=>{S.ag.amt=n;const i=$('#agA');if(i)i.value=fmt(n);agSync()};
window.agMode=k=>{S.ag.mode=k;render('fade-none')};
window.agOpen=()=>{S.ag.code=null;S.stack.push('agent96');render('push')};
function agDraw(){closeSheet();if(S.stack[S.stack.length-1]!=='agent96')S.stack.push('agent96');render('fade-none')}
window.agDraw=agDraw;
window.agCode=()=>{if(!agOk())return;const go=()=>{S.ag.code=rnd(6);S.ag.exp=Date.now()+600000;agShow()};S.ag.mode==='out'?gkGate(go,T('Withdrawals need your PIN.','Gukuramo bisaba PIN yawe.','Les retraits nécessitent votre PIN.')):go()};
let iv=0;
function agShow(){const A=S.ag,out=A.mode==='out';
 sh(`${H(T('Show this code to the agent','Erekana iyi kode ku mukozi','Montrez ce code à l’agent'))}${SUB(out?T('The agent gives you ','Umukozi aguha ','L’agent vous remet ')+fmt(A.amt)+T(' RWF in cash after checking the code.',' mu ntoki amaze kugenzura kode.',' RWF en espèces après vérification du code.'):T('Hand ','Tanga ','Remettez ')+fmt(A.amt)+T(' RWF in cash to the agent, who confirms with this code.',' mu ntoki ku mukozi, uzemeza akoresheje iyi kode.',' RWF en espèces à l’agent, qui confirme avec ce code.'))}<div id="agc" class="cd96" aria-label="Code">${A.code.slice(0,3)} ${A.code.slice(3)}</div><div id="agt" class="sm mu" style="text-align:center" role="timer"></div>
 ${btn(T('Agent confirmed (prototype)','Umukozi yemeje (prototype)','Agent confirmé (prototype)'),'agDone()')}${btn(T('Cancel code','Hagarika kode','Annuler le code'),'agCancel()','sec2')}`,'Agent code');
 clearInterval(iv);const tick=()=>{const t=$('#agt');if(!t||!$('#agc')){clearInterval(iv);return}const s=Math.max(0,Math.round((S.ag.exp-Date.now())/1000));if(!s){clearInterval(iv);$('#agc').style.opacity='.3';t.textContent=T('Code expired','Kode yararangiye','Code expiré');return}t.textContent=T('Expires in ','Irarangira mu ','Expire dans ')+Math.floor(s/60)+':'+String(s%60).padStart(2,'0')};tick();iv=setInterval(tick,1000)}
window.agCancel=()=>{clearInterval(iv);S.ag.code=null;closeSheet();toast(T('Code cancelled','Kode yahagaritswe','Code annulé'))};
window.agDone=()=>{const A=S.ag,out=A.mode==='out',fee=feeOf(A.mode,A.amt),tot=A.amt+fee;
 if(!A.code||Date.now()>A.exp){closeSheet();toast(T('Code expired. Get a new one.','Kode yararangiye. Fata indi.','Code expiré. Obtenez-en un autre.'));return}
 if(out&&tot>S.pay){closeSheet();toast(T('Not enough in itunda Pay','Nta mafaranga ahagije','Solde insuffisant'));return}
 clearInterval(iv);const ref='AG'+rnd(7);
 if(out){S.pay-=tot;addAct('cash',T('Cash out · Agent','Gukuramo · Umukozi','Retrait · Agent'),'Paid',-tot,'Paid')}else{S.pay+=A.amt;addAct('plus',T('Cash in · Agent','Kubitsa · Umukozi','Dépôt · Agent'),'Received',A.amt,'Received')}
 A.code=null;
 sh(`<div style="display:flex;flex-direction:column;align-items:center;text-align:center"><div class="g3">${gl('success3d',84)}</div><div class="h1" style="margin-top:14px">${fmt(A.amt)} RWF</div><div class="mu" style="font-size:15px;margin-top:4px">${out?T('Cash collected','Amafaranga yafashwe','Espèces retirées'):T('Cash deposited','Amafaranga yabitswe','Espèces déposées')}</div></div><div style="border-top:1px solid var(--ln);margin-top:18px;padding-top:4px">${rowx(T('Agent','Umukozi','Agent'),'Kigali Cash Point · Nyabugogo',1)}${rowx(T('Time','Isaha','Heure'),tm())}${rowx(T('Reference','Nimero ya transaction','Référence'),ref)}${rowx(T('New balance','Amafaranga mashya','Nouveau solde'),fmt(S.pay)+' RWF')}</div>${btn(T('Done','Byarangiye','Terminé'),'closeSheet();back()')}`,'Receipt')};

/* ================= Accept payments (merchant) ================= */
const base7=[42000,38500,55000,61200,47800,70500];
S.mc=S.mc||{on:false,name:'',till:'',sales:[]};
window.mcOn=()=>{const n=($('#mcn')||{}).value;const name=(n||'').trim()||((S.name||'Amina Uwase').split(' ')[0]+'’s Shop');S.mc={on:true,name,till:rnd(6),sales:[]};render('fade-none');toast(T('You can now accept payments','Ushobora kwakira ubwishyu','Vous pouvez maintenant accepter des paiements'))};
window.mcOff=()=>{sh(`${H(T('Turn off payments?','Guhagarika kwakira ubwishyu?','Désactiver les paiements ?'))}${SUB(T('Customers will no longer be able to pay your till. Your sales history is kept.','Abakiriya ntibazongera kwishyura ku kazi kawe. Amateka y’ibyagurishijwe arabikwa.','Les clients ne pourront plus payer votre caisse. Votre historique est conservé.'))}${btn(T('Turn off','Hagarika','Désactiver'),'mcOff2()')}${btn(T('Keep on','Komeza','Garder'),'closeSheet()','sec2')}`)};
window.mcOff2=()=>{S.mc.on=false;closeSheet();render('fade-none')};
window.mcCopy=()=>{copy(S.mc.till);toast(T('Till number copied','Nimero yakoporowe','Numéro copié'))};
window.mcSim=()=>{const who=['Amina K.','Eric M.','Grace U.','Jean Paul','Divine N.'][Math.floor(Math.random()*5)],a=[1500,3200,5000,8500,12000][Math.floor(Math.random()*5)];
 S.mc.sales.unshift({n:who,a,t:tm()});S.pay+=a;addAct('up',T('Sale · ','Igurisha · ','Vente · ')+who,'Received',a,'Received');render('fade-none');toast(fmt(a)+' RWF '+T('from ','kuva kuri ','de ')+who)};
screens.biz96=()=>{const M=S.mc;
 if(!M.on)return `${bar(T('Accept payments','Kwakira ubwishyu','Accepter des paiements'))}<div class="pad" style="padding-top:28px"><div class="h1">${T('Get paid in seconds','Ishyurwe mu masegonda','Soyez payé en quelques secondes')}</div><div class="mu" style="font-size:15px;margin-top:10px;line-height:22px">${T('For shops, stalls and services. Customers scan your code or enter your till number, and the money lands in itunda Pay.','Ku maduka, ku bicuruzwa no kuri serivisi. Abakiriya bakoresha kode yawe cyangwa nimero yawe, amafaranga akajya muri itunda Pay.','Pour boutiques, étals et services. Les clients scannent votre code ou saisissent votre numéro de caisse, et l’argent arrive sur itunda Pay.')}</div><div class="lab">${T('Business name','Izina ry’ubucuruzi','Nom de l’entreprise')}</div><input class="in" id="mcn" maxlength="30" placeholder="${esc((S.name||'Amina Uwase').split(' ')[0])}’s Shop" aria-label="${T('Business name','Izina ry’ubucuruzi','Nom de l’entreprise')}"></div><div class="pad fine" style="padding-top:14px">${T('No fees while this is a prototype.','Nta kiguzi muri prototype.','Aucuns frais dans ce prototype.')}</div><div class="cta"><button class="btn" onclick="mcOn()">${T('Turn on','Tangira','Activer')}</button></div>`;
 const tot=M.sales.reduce((a,s)=>a+s.a,0),days=[...base7,tot],mx=Math.max(...days,1),d0=new Date();
 const lab=i=>{const d=new Date(d0);d.setDate(d.getDate()-(7-i));return d.toLocaleDateString('en-GB',{weekday:'narrow'})};
 return `${bar(esc(M.name))}<div class="pad" style="padding-top:16px;display:flex;align-items:center;gap:16px"><div style="width:96px;height:96px;border-radius:20px;background:var(--chip);display:flex;align-items:center;justify-content:center">${gl('qr3d',76)}</div><div style="flex:1"><div class="sm mu">${T('Till number','Nimero y’ubucuruzi','Numéro de caisse')}</div><div style="font-size:26px;font-weight:800;letter-spacing:2px">${M.till.slice(0,3)} ${M.till.slice(3)}</div><button class="chip" style="margin-top:6px;height:32px" onclick="mcCopy()">${T('Copy','Koporora','Copier')}</button></div></div>
 <div class="pad" style="padding-top:22px"><div class="sm mu">${T('Sales today','Ibyagurishijwe uyu munsi','Ventes du jour')}</div><div class="big" style="margin-top:4px">${fmt(tot)} RWF</div><div class="sm mu" style="margin-top:2px">${M.sales.length} ${T(M.sales.length===1?'payment':'payments',M.sales.length===1?'ubwishyu':'ubwishyu','paiement'+(M.sales.length===1?'':'s'))}</div><div class="bars96" aria-hidden="true">${days.map((v,i)=>`<div class="${i===7?'on':''}" style="height:${Math.max(4,Math.round(v/mx*100))}%"></div>`).join('')}</div><div style="display:flex;gap:8px;margin-top:6px;font-size:12px;color:var(--tt)">${days.map((v,i)=>`<span style="flex:1;text-align:center">${lab(i)}</span>`).join('')}</div></div>
 <div class="pad row2" style="padding-top:20px"><button class="btn" onclick="reqSheet()">${T('Request payment','Saba ubwishyu','Demander un paiement')}</button><button class="btn sec2" onclick="mcSim()">${T('Test a sale','Gerageza igurisha','Tester une vente')}</button></div>
 <div class="sec"><div class="sech">${T('Recent sales','Ibyagurishijwe vuba','Ventes récentes')}</div>${M.sales.length?M.sales.map(s=>`<div class="row" style="cursor:default"><div class="ico" style="background:var(--tint);color:var(--tintfg);font-weight:800;font-size:16px">${esc(s.n[0])}</div><div style="flex:1"><div class="t">${esc(s.n)}</div><div class="s">${s.t}</div></div><b style="color:var(--ok)">+${fmt(s.a)} RWF</b></div>`).join(''):`<div class="mu" style="padding:12px 0;font-size:14px">${T('No sales yet. Tap “Test a sale” to see how it looks.','Nta cyaragurishijwe. Kanda “Gerageza igurisha”.','Aucune vente. Touchez « Tester une vente ».')}</div>`}</div>
 <div class="pad" style="padding-top:8px;padding-bottom:30px"><button class="sm" style="border:0;background:none;color:var(--mu);font-weight:700;padding:8px 0" onclick="mcOff()">${T('Turn off payments','Hagarika kwakira ubwishyu','Désactiver les paiements')}</button></div>`};
window.mcOpen=()=>{S.stack.push('biz96');render('push')};

/* ================= Bill reminders ================= */
const bills=()=>{if(!S.b96){S.b96base=Date.now();S.b96=[{p:'REG electricity',a:18500,d:3,r:true},{p:'WASAC water',a:6200,d:9,r:true},{p:'School fees',a:120000,d:21,r:false}]}return S.b96};
const dueTxt=b=>{const d=new Date(S.b96base+b.d*864e5),n=Math.max(0,Math.ceil((d-Date.now())/864e5));return (n===0?T('Due today','Bigomba uyu munsi','Échéance aujourd’hui'):n===1?T('Due tomorrow','Bigomba ejo','Échéance demain'):T('Due in ','Bigomba mu ','Échéance dans ')+n+T(' days',' minsi',' jours'))+' · '+dstr(d)};
window.b96Pay=i=>{const b=bills()[i];S.bl={p:b.p,num:(S.sm&&S.sm[b.p])||'',amt:b.a};S.b96i=i;S.stack.push('bill');render('push')};
window.b96Tg=i=>{const b=bills()[i];b.r=!b.r;render('fade-none');toast(b.r?T('We’ll remind you 2 days before','Tuzakwibutsa hasigaye iminsi 2','Nous vous rappellerons 2 jours avant'):T('Reminder off','Kwibutsa byahagaritswe','Rappel désactivé'))};
window.b96Del=i=>{const b=bills()[i];if(!b)return;sh(`${H(T('Remove this bill?','Kuramo iyi fagitire?','Retirer cette facture ?'))}${SUB(esc(b.p)+' · '+fmt(b.a)+' RWF. '+T('We’ll stop reminding you.','Tuzareka kukwibutsa.','Nous n’enverrons plus de rappels.'))}${btn(T('Remove','Kuramo','Retirer'),'b96DelGo('+i+')')}${btn(T('Keep it','Yibike','Garder'),'closeSheet()','sec2')}`)};
window.b96DelGo=i=>{bills().splice(i,1);closeSheet();render('fade-none');toast(T('Bill removed','Fagitire yakuweho','Facture retirée'))};
window.b96Add=()=>{const have=bills().map(b=>b.p);sh(`${H(T('Add a bill','Ongeraho fagitire','Ajouter une facture'))}${SUB(T('Pick who you pay. We’ll remind you before it’s due.','Hitamo uwo wishyura. Tuzakwibutsa mbere y’itariki.','Choisissez à qui vous payez. Nous vous rappellerons avant l’échéance.'))}<div class="req" style="flex-wrap:wrap">${Object.keys(BP).filter(k=>!have.includes(k)).map(k=>`<button onclick="b96AddGo('${k}')">${k}</button>`).join('')||`<span class="mu">${T('All billers added','Byose byongeweho','Tous ajoutés')}</span>`}</div>${btn(T('Cancel','Reka','Annuler'),'closeSheet()','sec2')}`)};
const b96AddSheet=()=>{const n=S.b96n,P=BP[n.k];sh(`${H(esc(n.k))}${SUB(T('How much, and when is it due?','Angahe, kandi bigomba ryari?','Combien, et pour quand ?'))}<div class="agt" style="padding:6px 0 8px">${T('Amount','Amafaranga','Montant')}</div><div class="req lim4" role="group">${P.a.map(a=>`<button class="${n.a===a?'on':''}" onclick="b96N('a',${a})">${fmt(a)}</button>`).join('')}</div><div class="agt" style="padding:16px 0 8px">${T('Due in','Bigomba mu','Échéance dans')}</div><div class="req lim4" role="group">${[[3,T('3 days','Iminsi 3','3 jours')],[7,T('1 week','Icyumweru 1','1 semaine')],[14,T('2 weeks','Ibyumweru 2','2 semaines')],[30,T('1 month','Ukwezi 1','1 mois')]].map(x=>`<button class="${n.d===x[0]?'on':''}" onclick="b96N('d',${x[0]})">${x[1]}</button>`).join('')}</div><div style="height:16px"></div>${btn(T('Add bill','Ongeraho','Ajouter'),'b96AddOk()')}${btn(T('Cancel','Reka','Annuler'),'closeSheet()','sec2')}`)};
window.b96AddGo=k=>{S.b96n={k,a:BP[k].a[1],d:14};b96AddSheet()};
window.b96N=(f,v)=>{S.b96n[f]=v;b96AddSheet()};
window.b96AddOk=()=>{const n=S.b96n;if(!n)return;bills().push({p:n.k,a:n.a,d:n.d,r:true});S.b96n=null;closeSheet();render('fade-none');toast(T('Bill added','Fagitire yongeweho','Facture ajoutée'))};
const _bd=screens.billdone;screens.billdone=()=>{if(S.b96i!=null){const b=bills()[S.b96i];if(b&&S.bl&&b.p===S.bl.p){b.paid=true;b.d+=30}S.b96i=null}return _bd()};
screens.bills96=()=>{const L=bills(),due=L.filter(b=>!b.paid).sort((x,y)=>x.d-y.d),pd=L.filter(b=>b.paid),soon=due.filter(b=>b.d<=7),later=due.filter(b=>b.d>7),tot=soon.reduce((n,b)=>n+b.a,0);
 const row=b=>{const i=L.indexOf(b),urgent=b.d<=3&&!b.paid;return `<div class="bl96"><div style="display:flex;justify-content:space-between;gap:12px;align-items:flex-start"><div style="min-width:0"><div style="font-size:17px;font-weight:800">${esc(b.p)}</div><div class="sm ${urgent?'':'mu'}" style="margin-top:2px;${urgent?'color:var(--er);font-weight:700':''}">${b.paid?T('Paid · next ','Byishyuwe · ikurikira ','Payé · prochain ')+dstr(new Date(S.b96base+b.d*864e5)):dueTxt(b)}</div></div><b style="font-size:17px;white-space:nowrap">${fmt(b.a)} RWF</b></div><div style="display:flex;align-items:center;gap:12px;margin-top:12px"><div style="flex:1;display:flex;align-items:center;gap:10px;font-size:14px;color:var(--mu)">${sw(b.r,`b96Tg(${i})`,T('Remind me','Nyibutsa','Me rappeler'))}${T('Remind me','Nyibutsa','Me rappeler')}</div><button class="chip" aria-label="${T('Remove','Kuramo','Retirer')}" onclick="b96Del(${i})">${ic('plus',16).replace('<svg','<svg style="transform:rotate(45deg)"')}</button>${b.paid?'':`<button class="chip" style="background:var(--br);color:var(--on)" onclick="b96Pay(${i})">${T('Pay','Ishyura','Payer')}</button>`}</div></div>`};
 const hd=t=>`<div class="pad" style="padding-top:22px;padding-bottom:0"><div style="font-size:16px;font-weight:800">${t}</div></div>`;
 const n=soon.length;
 return `${bar(T('Upcoming bills','Fagitire zitegereje','Factures à venir'))}<div class="pad" style="padding-top:12px"><div class="sm mu">${T('Due in the next 7 days','Bigomba mu minsi 7','À payer dans les 7 jours')}</div><div class="big" style="margin-top:4px">${fmt(tot)} RWF</div><div class="sm mu" style="margin-top:2px">${n?n+' '+T(n===1?'bill':'bills','fagitire',n===1?'facture':'factures'):T('Nothing due this week','Nta kigomba iki cyumweru','Rien à payer cette semaine')}</div></div>${soon.length?hd(T('This week','Iki cyumweru','Cette semaine'))+soon.map(row).join(''):''}${later.length?hd(T('Later','Nyuma','Plus tard'))+later.map(row).join(''):''}${!due.length&&!pd.length?`<div class="pad mu" style="padding-top:20px">${T('No bills yet. Add one and we’ll remind you before it’s due.','Nta fagitire. Ongeraho imwe tuzakwibutsa.','Aucune facture. Ajoutez-en une, nous vous rappellerons.')}</div>`:''}${pd.length?hd(T('Paid','Byishyuwe','Payé'))+pd.map(row).join(''):''}<div style="height:100px"></div><div class="cta">${btn(T('Add a bill','Ongeraho fagitire','Ajouter une facture'),'b96Add()')}</div>`};
window.b96Open=()=>{S.stack.push('bills96');render('push')};

/* ================= Pay tab entries ================= */
const dueN=()=>bills().filter(b=>!b.paid&&b.d<=7).length;
const _p=screens.pay;screens.pay=()=>_p().replace('<div class="sech">More</div>',m=>m+row('bill',T('Upcoming bills','Fagitire zitegereje','Factures à venir'),T('Reminders and one-tap pay','Kwibutsa no kwishyura vuba','Rappels et paiement rapide'),dueN()?dueN()+' '+T('due soon','zegereje','à venir'):'','b96Open()')+row('cash',T('Cash at an agent','Amafaranga ku mukozi','Espèces chez un agent'),T('Withdraw or deposit with a code','Gukuramo cyangwa kubitsa ukoresheje kode','Retirer ou déposer avec un code'),'','agOpen()')+row('bag',T('Accept payments','Kwakira ubwishyu','Accepter des paiements'),S.mc.on?esc(S.mc.name)+' · '+S.mc.till:T('For your shop or stall','Ku iduka ryawe','Pour votre boutique'),'','mcOpen()'));
})();
</script>
<style id="eats97">
.ban97{margin:14px 24px 0;padding:14px 16px;border-radius:20px;background:var(--tint);color:var(--tintfg);font-size:14px;line-height:20px}
.map97{margin:16px 24px 0;border-radius:20px;overflow:hidden;background:var(--chip)}
.map97 svg{display:block;width:100%;height:auto}
.map97 .cap{display:flex;align-items:center;gap:8px;padding:10px 14px;font-size:14px;font-weight:700;background:var(--bg);border-top:0}
.gc97{margin:16px 24px 0;padding:14px 16px;border-radius:20px;background:var(--chip)}
.gc97 .ln{display:flex;justify-content:space-between;gap:12px;font-size:15px;padding:5px 0}
/* v101: touch targets, contrast, keyboard access */
#phone .tabs button{color:var(--mu)}#phone .tabs button.on{color:var(--tx)}
#phone .sech a,#phone .hct a,#phone .eye{position:relative}
#phone .sech a::after,#phone .hct a::after,#phone .eye::after{content:"";position:absolute;inset:-14px -10px}
#phone .sech a,#phone .hct a{color:var(--lk);font-weight:700}
#phone .req button{min-height:44px}
#phone .mi .plus,#phone div[style*="gap:20px"][style*="font-size:16px"]>button{position:relative}
#phone .mi .plus::after{content:"";position:absolute;inset:-5px}
#phone div[style*="gap:20px"][style*="font-size:16px"]>button::after{content:"";position:absolute;inset:-8px -6px}
#phone .xl button{position:relative}#phone .xl button::after{content:"";position:absolute;inset:-8px -6px}
</style>
<script>
(function(){
const T=(e,r,f)=>({en:e,rw:r||e,fr:f||e}[S.lang]||e);
const esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const sh=(body,label)=>{$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" role="dialog" aria-modal="true" aria-label="${esc(label||'')}" style="padding-bottom:calc(28px + env(safe-area-inset-bottom,0px));max-height:90%;overflow:auto">${body}</div>`};
const H=x=>`<div class="h1" style="font-size:22px;line-height:30px">${x}</div>`;
const SUB=x=>`<div class="mu" style="font-size:14px;line-height:20px;margin:6px 0 16px">${x}</div>`;
const btn=(l,fn,c,dis,id)=>`<button ${id?`id="${id}"`:''} class="btn ${c||''}" style="margin-top:10px" ${dis?'disabled':''} onclick="${fn}">${l}</button>`;
const rnd=n=>String(Math.floor(Math.random()*Math.pow(10,n))).padStart(n,'0');
const copy=v=>{try{navigator.clipboard.writeText(v).catch(()=>{})}catch(e){}};
const PPL=['Amina K.','Eric M.','Grace U.','Jean Paul','Divine N.'];
S.epm=S.epm||'pay';S.egrp=S.egrp||null;
const eTot=()=>{const sub=eSub(),disc=S.epromo==='EATS20'?Math.min(2000,Math.round(sub*.2)):0,fee=S.pickup?0:(S.epromo==='FREEDEL'?0:eFee()),tip=S.pickup?0:(S.etip||0);return sub-disc+fee+tip};
const feeNow=()=>S.pickup?0:(S.epromo==='FREEDEL'?0:eFee());
const refresh=()=>{const top=S.stack[S.stack.length-1];if(top!=='erest'&&top!=='echeck')return;if(/INPUT|TEXTAREA/.test((document.activeElement||{}).tagName))return;const y=$('#sc')?$('#sc').scrollTop:0;render('fade-none');if($('#sc'))$('#sc').scrollTop=y};

/* ================= Payment method ================= */
const CAP=100000;
const cant=(m,t)=>m==='cash'?t>CAP:t>(m==='bank'?S.bank:S.pay);
const pmName=m=>m==='bank'?'itunda Bank':m==='cash'?(S.pickup?T('Cash at pickup','Amafaranga ku gufata','Espèces au retrait'):T('Cash on delivery','Kwishyura ugezwaho','Paiement à la livraison')):'itunda Pay';
window.epmOpen=()=>{const t=eTot(),o=(m,sub)=>{const dis=cant(m,t);return `<div class="row tap" style="padding:12px 0;${dis?'opacity:.45':''}" ${dis?'':`onclick="epmSet('${m}')"`}><div class="cb ${S.epm===m?'on':''}" style="border-radius:13px">${S.epm===m?'<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#17171C" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L19 7"/></svg>':''}</div><div style="flex:1"><div style="font-size:16px;font-weight:700">${pmName(m)}</div><div class="sm mu">${dis?(m==='cash'?T('Cash orders are limited to '+fmt(CAP)+' RWF','Amafaranga ntarenze '+fmt(CAP)+' RWF','Commandes en espèces limitées à '+fmt(CAP)+' RWF'):T('Not enough balance','Amafaranga ntahagije','Solde insuffisant')):sub}</div></div></div>`};
 sh(`${H(T('Pay with','Kwishyura','Payer avec'))}<div style="padding-top:8px">${o('pay',fmt(S.pay)+' RWF')}${o('bank',fmt(S.bank)+' RWF')}${o('cash',S.pickup?T('Pay when you collect your order','Ishyura ufashe ibyo watumije','Payez au retrait de votre commande'):T('Pay your rider when the food arrives','Ishyura umutwara ibiryo bigeze','Payez le livreur à l’arrivée'))}</div>${btn(T('Done','Byarangiye','Terminé'),'closeSheet()','sec2')}`,'Pay with')};
window.epmSet=m=>{S.epm=m;closeSheet();refresh()};

/* ================= Group order ================= */
const grp=()=>S.egrp&&S.egrp.r===S.er?S.egrp:null;
const memSub=m=>Object.entries(m.items).reduce((a,[k,q])=>a+q*REST[S.er].items[k][2],0);
const hostSub=g=>Math.max(0,eSub()-g.members.reduce((a,m)=>a+memSub(m),0));
const joinedN=g=>g.members.filter(m=>m.joined).length;
const nItems=m=>Object.values(m.items).reduce((a,b)=>a+b,0);
const itemsW=n=>n+' '+(n===1?T('item','ikintu','article'):T('items','ibintu','articles'));
const peopleW=n=>n+' '+(n===1?T('person','umuntu','personne'):T('people','abantu','personnes'));
const itemNames=m=>Object.entries(m.items).map(([k,q])=>(q>1?q+'× ':'')+REST[S.er].items[k][0]).join(' · ');
const waitingNames=g=>g.members.filter(m=>!m.joined).map(m=>m.n);
const GT=()=>T('Group order','Itegeko rihuriweho','Commande groupée');
const grpBlock=()=>{const g=grp();const ico=`<span style="width:40px;height:40px;border-radius:20px;background:${g?'var(--bg)':'var(--tint)'};color:var(--tintfg);display:flex;align-items:center;justify-content:center;flex-shrink:0">${ic('users',22)}</span>`;
 if(!g)return `<div class="pad" style="padding-top:14px"><button class="tap" style="width:100%;display:flex;align-items:center;gap:12px;border:0;border-radius:18px;background:var(--chip);padding:12px 14px;font:inherit;color:inherit;text-align:left" onclick="egStart()">${ico}<span style="flex:1"><b style="font-size:15px;display:block">${GT()}</b><span class="sm mu">${T('Order together and split the bill','Mutumize hamwe musangire fagitire','Commandez ensemble et partagez l’addition')}</span></span>${ic('chev',16,'var(--tt)')}</button></div>`;
 const w=waitingNames(g),tot=eSub();
 const sub=w.length?T('Waiting for '+w.join(', '),'Dutegereje '+w.join(', '),'En attente de '+w.join(', ')):T('Everyone has joined','Bose barinjiye','Tout le monde a rejoint')+(tot?' · '+fmt(tot)+' RWF':'');
 return `<div class="pad" style="padding-top:14px"><button class="tap" style="width:100%;display:flex;align-items:center;gap:12px;border:0;border-radius:18px;background:var(--tint);color:var(--tintfg);padding:12px 14px;font:inherit;text-align:left" onclick="egManage()">${ico}<span style="flex:1;min-width:0"><b style="font-size:15px;display:block">${GT()} · ${peopleW(joinedN(g)+1)}</b><span class="sm" style="opacity:.85;display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${esc(sub)}</span></span>${ic('chev',16,'currentColor')}</button></div>`};
const egLbl=()=>{const n=S.egsel.length;return n?T('Invite '+n,'Tumira '+n,'Inviter '+n):S.egadd?T('Invite','Tumira','Inviter'):T('Start and share link','Tangira usangize link','Démarrer et partager le lien')};
window.egStart=add=>{S.egsel=[];const g=grp();S.egadd=!!(add&&g);const had=S.egadd?g.members.map(m=>m.n):[],list=PPL.filter(n=>!had.includes(n));
 sh(`${H(S.egadd?T('Invite more friends','Tumira izindi nshuti','Inviter d’autres amis'):T('Order together','Mutumize hamwe','Commandez ensemble'))}${SUB(T('Invite friends. Everyone adds their own items to one order, and you can split the bill.','Tumira inshuti. Buri wese yongeramo ibye mu itegeko rimwe, kandi mushobora gusangira fagitire.','Invitez des amis. Chacun ajoute ses articles à une seule commande, et vous pouvez partager l’addition.'))}<div class="req" id="egch" style="flex-wrap:wrap">${list.map(n=>`<button data-n="${n}" aria-pressed="false" onclick="egSel(this)">${n}</button>`).join('')}</div>${S.egadd?'':`<div class="sm mu" style="margin-top:10px;line-height:18px">${T('Not on the list? Start now and share the link.','Utari ku rutonde? Tangira ubundi usangize link.','Pas dans la liste ? Démarrez et partagez le lien.')}</div>`}${btn(egLbl(),'egGo()','',S.egadd,'egg')}${btn(T('Cancel','Reka','Annuler'),'closeSheet()','sec2')}`,'Group order')};
window.egSel=el=>{el.classList.toggle('on');el.setAttribute('aria-pressed',el.classList.contains('on'));S.egsel=[...document.querySelectorAll('#egch .on')].map(e=>e.dataset.n);const b=$('#egg');if(b){b.disabled=!!S.egadd&&!S.egsel.length;b.textContent=egLbl()}};
window.egGo=()=>{const names=S.egsel.slice();let g=grp();
 if(S.egadd&&g){if(!names.length)return;names.forEach(n=>{if(!g.members.some(m=>m.n===n))g.members.push({n,items:{},joined:false})})}
 else g=S.egrp={r:S.er,code:rnd(4),mode:'all',members:names.map(n=>({n,items:{},joined:false}))};
 S.egadd=false;closeSheet();refresh();egManage();if(names.length)toast(T('Invites sent','Ubutumire bwoherejwe','Invitations envoyées'));
 names.forEach((n,i)=>setTimeout(()=>egJoin(n,g),1800+i*2300))};
function egJoin(n,g){if(!g||S.egrp!==g||g.r!==S.er)return;const m=g.members.find(x=>x.n===n);if(!m||m.joined)return;m.joined=true;const r=REST[S.er],N=r.items.length;let a=Math.floor(Math.random()*N),names=[];
 const picks=[a];if(Math.random()>.45)picks.push((a+1+Math.floor(Math.random()*(N-1)))%N);
 picks.forEach(k=>{m.items[k]=(m.items[k]||0)+1;S.ecart[k]=(S.ecart[k]||0)+1;names.push(r.items[k][0])});refresh();if($('#layer .sheet[data-eg]'))egManage();toast(n+' '+T('added ','yongeyemo ','a ajouté ')+names.join(', '))}
window.egManage=()=>{const g=grp();if(!g){closeSheet();return}const w=waitingNames(g),tot=eSub(),link='itunda.rw/g/'+g.code;
 const av=n=>`<span aria-hidden="true" style="width:36px;height:36px;border-radius:18px;background:var(--tint);color:var(--tintfg);display:flex;align-items:center;justify-content:center;font-weight:800;font-size:14px;flex-shrink:0">${esc(String(n).trim().charAt(0)||'?')}</span>`;
 const row=(first,a,name,sub,amt,act)=>`<div style="display:flex;align-items:center;gap:10px;min-height:60px;padding:8px 0;${first?'':'border-top:1px solid var(--ln)'}">${a}<span style="flex:1;min-width:0"><b style="font-size:15px;display:block">${name}</b><span class="sm mu" style="display:block;line-height:18px">${sub}</span></span><b style="font-size:15px;white-space:nowrap">${amt}</b>${act||''}</div>`;
 const hostN=Object.values(S.ecart).reduce((a,b)=>a+b,0)-g.members.reduce((a,m)=>a+nItems(m),0);
 const rows=row(true,av(T('You','Wowe','Vous')),T('You (host)','Wowe (nyir’itegeko)','Vous (hôte)'),hostN>0?itemsW(hostN):T('No items yet','Nta kintu','Aucun article'),fmt(hostSub(g))+' RWF')
 +g.members.map((m,i)=>row(false,av(m.n),esc(m.n),m.joined?(nItems(m)?esc(itemNames(m)):T('Joined · no items yet','Yinjiye · nta kintu','A rejoint · aucun article')):`${T('Waiting to join…','Ategerejwe…','En attente…')} <button style="background:none;border:0;color:var(--lk);font-weight:700;font-size:13px;padding:0 0 0 4px" onclick="egRemind(${i})">${T('Remind','Mwibutse','Relancer')}</button>`,m.joined?fmt(memSub(m))+' RWF':'',`<button class="tap" aria-label="${T('Remove ','Kuraho ','Retirer ')+esc(m.n)}" style="width:40px;height:40px;border:0;border-radius:20px;background:none;color:var(--mu);font-size:18px;flex-shrink:0" onclick="egRemove(${i})">✕</button>`)).join('');
 const more=PPL.some(n=>!g.members.some(m=>m.n===n));
 sh(`${H(GT())}${SUB(T('Share the link so friends can add their items.','Sangiza link kugira ngo inshuti zongeremo ibyazo.','Partagez le lien pour que vos amis ajoutent leurs articles.'))}
 <div style="display:flex;align-items:center;gap:10px;background:var(--chip);border-radius:16px;padding:6px 6px 6px 16px"><span style="flex:1;min-width:0;font-weight:700;font-size:15px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${link}</span><button id="egcp" class="btn" style="width:auto;height:40px;padding:0 18px;font-size:14px;border-radius:12px" onclick="egCopy()">${T('Copy','Koporora','Copier')}</button></div>
 <div style="padding:2px 16px;border-radius:16px;background:var(--chip);margin-top:12px">${rows}</div>
 <div style="display:flex;justify-content:space-between;align-items:center;padding:14px 4px 0;font-size:15px"><span class="mu">${T('Group total','Igiteranyo cyose','Total du groupe')}${w.length?` · <span style="color:#D98A00;font-weight:700">${T(w.length+' waiting',w.length+' bategerejwe',w.length+' en attente')}</span>`:''}</span><b>${fmt(tot)} RWF</b></div>
 ${more?`<div style="text-align:center"><button style="background:none;border:0;color:var(--lk);font-weight:700;font-size:14px;padding:12px 8px 0" onclick="egStart(true)">+ ${T('Invite more friends','Tumira izindi nshuti','Inviter d’autres amis')}</button></div>`:''}
 ${btn(T('Go to checkout','Ujya kwishyura','Passer au paiement'),'egCheckout()','',!tot)}${btn(T('End group order','Soza itegeko','Terminer la commande groupée'),'egEndAsk()','sec2')}`,'Group order');
 const s=$('#layer .sheet');if(s)s.dataset.eg='1'};
window.egCheckout=()=>{closeSheet();if(S.stack[S.stack.length-1]!=='echeck'){S.stack.push('echeck');render('push')}};
window.egCopy=()=>{const g=grp();copy('itunda.rw/g/'+(g?g.code:''));const b=$('#egcp');if(b){b.textContent=T('Copied ✓','Byakoporowe ✓','Copié ✓');clearTimeout(window._egct);window._egct=setTimeout(()=>{const x=$('#egcp');if(x)x.textContent=T('Copy','Koporora','Copier')},1600)}else toast(T('Link copied','Link yakoporowe','Lien copié'))};
window.egRemind=i=>{const g=grp(),m=g&&g.members[i];if(m)toast(T('Reminder sent to '+m.n,'Twibukije '+m.n,'Rappel envoyé à '+m.n))};
window.egRemove=i=>{const g=grp(),m=g&&g.members[i];if(!m)return;Object.entries(m.items).forEach(([k,q])=>{S.ecart[k]=Math.max(0,(S.ecart[k]||0)-q)});g.members.splice(i,1);refresh();egManage();toast(T(m.n+' removed',m.n+' yakuweho',m.n+' retiré'))};
window.egEndAsk=()=>{const g=grp();if(!g)return;const n=g.members.reduce((a,m)=>a+nItems(m),0);if(!n){egEnd();return}
 sh(`${H(T('End group order?','Gusoza itegeko?','Terminer la commande groupée ?'))}${SUB(T('The '+itemsW(n)+' your friends added will be removed from the cart.','Ibintu '+n+' inshuti zawe zongeyemo bizakurwa mu igare.',itemsW(n)+' ajoutés par vos amis seront retirés du panier.'))}${btn(T('End group order','Soza itegeko','Terminer'),'egEnd()')}${btn(T('Keep it','Kigumane','Le garder'),'egManage()','sec2')}`,'End group order')};
window.egEnd=()=>{const g=grp();if(g){g.members.forEach(m=>Object.entries(m.items).forEach(([k,q])=>{S.ecart[k]=Math.max(0,(S.ecart[k]||0)-q)}))}S.egrp=null;closeSheet();refresh();toast(T('Group order ended','Itegeko ryarangiye','Commande groupée terminée'))};
window.egMode=m=>{const g=grp();if(g){g.mode=m;refresh()}};
const _or=screens.erest;screens.erest=()=>{let h=_or();const A='<div style="display:flex;gap:20px;font-size:16px;font-weight:800;padding-top:22px';const i=h.indexOf(A);return i>0?h.slice(0,i)+grpBlock()+h.slice(i):h};
const _oe=window.openERest;window.openERest=i=>{if(S.egrp&&S.egrp.r!==i)S.egrp=null;_oe(i)};

/* ================= Checkout: payment + group split ================= */
const ANCH='<div class="pad" style="padding-top:14px"><div style="border-top:0;padding-top:6px">';
const PAYROW=/<div style="margin-top:14px;display:flex;justify-content:space-between;font-size:14px"><span class="mu">[^<]*<\/span><b>[^<]*<\/b><\/div>/;
const _ec=screens.echeck;screens.echeck=()=>{let h=_ec();const m=S.epm||'pay',r=REST[S.er],t=eTot(),short=eSub()<r.min,bad=cant(m,t),g=grp();
 if(g&&eSub()>0){const mem=g.members.filter(x=>x.joined),w=waitingNames(g),N=mem.length+1,fee=feeNow(),sp=g.mode==='split',sh1=sp&&fee?Math.round(fee/N):0,owed=sp?mem.reduce((a,x)=>a+memSub(x)+sh1,0):0;
  const ln=(nm,sub,amt)=>`<div class="ln"><span>${nm}${sub?`<span class="sm mu" style="display:block">${sub}</span>`:''}</span><b>${fmt(amt)} RWF</b></div>`;
  const wn=w.join(', '),wt=w.length?T(wn+(w.length===1?' has':' have')+' not joined yet. Their items are not in this order.',wn+' ntibarinjira. Ibyabo ntibiri muri iri tegeko.',wn+(w.length===1?' n’a pas encore rejoint':' n’ont pas encore rejoint')+'. Leurs articles ne sont pas dans cette commande.'):'';
  const note=sp&&mem.length?`<div class="sm mu" style="margin-top:8px;line-height:18px">${T('You pay now. Each friend gets a request for their items'+(sh1?' and a share of delivery':'')+': '+fmt(owed)+' RWF in total.','Wishyura none. Buri nshuti ahabwa ubusabe bw’ibyayo'+(sh1?' n’igice cyo kugezwaho':'')+': '+fmt(owed)+' RWF yose hamwe.','Vous payez maintenant. Chaque ami reçoit une demande pour ses articles'+(sh1?' et une part de la livraison':'')+' : '+fmt(owed)+' RWF au total.')}</div>`:'';
  const card=`<div class="gc97"><div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px"><span style="font-size:15px;font-weight:800">${GT()} · ${peopleW(N)}</span><button style="background:none;border:0;color:var(--lk);font-weight:700;font-size:14px;padding:4px 0" onclick="egManage()">${T('Manage','Gucunga','Gérer')}</button></div>${ln(T('You','Wowe','Vous'),'',hostSub(g)+(sp?sh1:0))}${mem.map(x=>ln(esc(x.n),itemsW(nItems(x)),memSub(x)+sh1)).join('')}${wt?`<div class="sm" style="color:#D98A00;font-weight:700;margin-top:6px;line-height:18px">⚠ ${wt}</div>`:''}<div class="req" style="margin-top:10px;flex-wrap:wrap"><button class="${g.mode==='all'?'on':''}" onclick="egMode('all')">${T('I pay for everyone','Ndishyurira bose','Je paie pour tous')}</button><button class="${g.mode==='split'?'on':''}" onclick="egMode('split')">${T('Split the bill','Dusangire','Partager')}</button></div>${note}</div>`;
  h=h.replace(ANCH,x=>card+x)}
 h=h.replace(PAYROW,`<div class="tap" role="button" tabindex="0" onclick="epmOpen()" style="margin-top:14px;display:flex;justify-content:space-between;align-items:center;font-size:14px;cursor:pointer"><span class="mu">${T('Pay with','Kwishyura','Payer avec')}</span><b style="display:flex;align-items:center;gap:4px">${pmName(m)}${m==='cash'?'':' · '+fmt(m==='bank'?S.bank:S.pay)+' RWF'}${ic('chev',14,'var(--tt)')}</b></div>${bad?`<div style="color:var(--er);font-size:14px;margin-top:10px">${m==='cash'?T('Cash orders are limited to '+fmt(CAP)+' RWF. Choose another way to pay.','Amafaranga ntarenze '+fmt(CAP)+' RWF.','Les commandes en espèces sont limitées à '+fmt(CAP)+' RWF.'):T('Not enough balance. Choose another way to pay.','Amafaranga ntahagije. Hitamo ubundi buryo.','Solde insuffisant. Choisissez un autre moyen.')}</div>`:''}`);
 h=h.replace(/<div style="color:var\(--er\);font-size:14px;margin-top:10px">(?:Not enough balance|Solde insuffisant|Amafaranga ntahagije)[^<]*<\/div>/,'');
 h=h.replace(/<button class="btn"[^>]*onclick="ePay\(\)">[^<]*<\/button>/,`<button class="btn" ${bad||short?'disabled':''} onclick="ePay()">${short?T('Add '+fmt(r.min-eSub())+' RWF to order','Ongeraho '+fmt(r.min-eSub())+' RWF','Ajoutez '+fmt(r.min-eSub())+' RWF'):m==='cash'?T('Place order','Tumiza','Commander')+' · '+fmt(t)+' RWF':T('Pay','Ishyura','Payer')+' '+fmt(t)+' RWF'}</button>`);
 return h};
const _ep=window.ePay;window.ePay=()=>{_ep();const m=S.epm||'pay';if(m==='pay')return;const l=$('#layer .sheet');if(!l)return;const h1=l.querySelector('.h1'),mu=l.querySelector('.mu'),b=l.querySelector('.btn'),t=eTot(),r=REST[S.er];
 if(m==='cash'){h1.textContent=T('Place your order','Tumiza itegeko','Passer la commande');mu.textContent=T('Pay '+fmt(t)+' RWF in cash '+(S.pickup?'when you collect it.':'to your rider.'),'Payez '+fmt(t)+' RWF en espèces '+(S.pickup?'au retrait.':'au livreur.'),'Ishyura '+fmt(t)+' RWF mu ntoki '+(S.pickup?'ufashe ibyo watumije.':'umutwara.'));b.textContent=T('Place order','Tumiza','Commander')}
 else{mu.textContent=T('Pay','Ishyura','Payer')+' '+fmt(t)+' RWF · '+r.n+' · itunda Bank'}};
const _ed=window.eDone;window.eDone=()=>{const m=S.epm||'pay',t=eTot(),g=grp(),r=REST[S.er];
 if(cant(m,t)){closeSheet();toast(T('Not enough balance','Amafaranga ntahagije','Solde insuffisant'));return}
 const mem=g?g.members.filter(x=>x.joined):[],N=mem.length+1,fee=feeNow(),shares=g&&g.mode==='split'?mem.map(x=>({n:x.n,amt:memSub(x)+Math.round(fee/N)})).filter(x=>x.amt>0):[];
 const n0=S.orders.length;if(m==='bank'){S.bank-=t;S.pay+=t}else if(m==='cash'){S.pay+=t}
 _ed();
 if(S.orders.length>n0){const o=S.orders[0];o.pm=m;if(shares.length){shares.forEach(s=>S.rqs.push({id:Date.now()+Math.floor(Math.random()*1e4),n:s.n,amt:s.amt,l:T('Group order · ','Itegeko rihuriweho · ','Commande groupée · ')+r.n,paid:false}));setTimeout(()=>toast(shares.length+' '+T('requests sent to friends','ubusabe bwoherejwe','demandes envoyées')),400)}S.egrp=null}
 else{if(m==='bank'){S.bank+=t;S.pay-=t}else if(m==='cash'){S.pay-=t}}};
const _cg=window.eCancelGo;window.eCancelGo=()=>{const o=S.orders.find(x=>x.k==='Eats order'),pm=o&&o.pm;_cg();if(!o)return;if(pm==='cash'){S.pay-=o.t}else if(pm==='bank'){S.pay-=o.t;S.bank+=o.t}};
const _cn=window.eCancel;window.eCancel=()=>{_cn();const o=S.orders.find(x=>x.k==='Eats order'),pm=o&&o.pm,mu=$('#layer .mu');if(!mu||!o)return;if(pm==='cash')mu.textContent=T('You have not paid yet, so nothing is charged.','Ntacyo wishyuye, nta kiguzi kizakurwaho.','Vous n’avez pas encore payé, rien n’est débité.');else if(pm==='bank')mu.textContent=T('You will get '+fmt(o.t)+' RWF back in itunda Bank.','Uzasubizwa '+fmt(o.t)+' RWF muri itunda Bank.','Vous récupérez '+fmt(o.t)+' RWF sur itunda Bank.')};
const mineE=()=>S.orders.filter(o=>o.k==='Eats order'&&o.items);
const _rc=window.eRcpt;window.eRcpt=n=>{_rc(n);const o=mineE()[n],l=$('#layer');if(!o||!l)return;const pm=o.pm||'pay',lab=pm==='bank'?'itunda Bank':pm==='cash'?(o.pickup?T('Cash at pickup','Amafaranga ku gufata','Espèces au retrait'):T('Cash on delivery','Kwishyura ugezwaho','Paiement à la livraison')):'itunda Pay';l.innerHTML=l.innerHTML.replace(/(Paid with|Payé avec|Wishyuye na)(<\/span><b[^>]*>)itunda Pay/,'$1$2'+lab)};

/* ================= Live tracking map ================= */
const RT='M52 42 C118 42 104 124 178 118 S292 96 292 134';
const mapSvg=k=>`<svg viewBox="0 0 342 176" role="img" aria-label="${T('Delivery map','Ikarita yo kugezwaho','Carte de livraison')}"><rect width="342" height="176" fill="var(--chip)"/><path d="M-10 78 C60 60 120 96 200 70 S320 40 360 60" stroke="#BFEAD7" stroke-width="22" fill="none" opacity=".55"/><g stroke="var(--bg)" stroke-width="9" stroke-linecap="round" fill="none"><path d="M0 20H342M0 150H342M30 0V176M118 0V176M226 0V176M318 0V176"/></g><path d="${RT}" fill="none" stroke="var(--br)" stroke-width="4" stroke-dasharray="2 8" stroke-linecap="round"/>
<circle cx="52" cy="42" r="12" fill="#17171C"/><path d="M47 40h10l-1 8h-8zM48 40l1-4h8l1 4" fill="none" stroke="#fff" stroke-width="1.8" stroke-linejoin="round"/>${k===1?'<circle cx="52" cy="42" r="12" fill="none" stroke="var(--br)" stroke-width="3"><animate attributeName="r" values="12;26" dur="1.4s" repeatCount="indefinite"/><animate attributeName="opacity" values=".8;0" dur="1.4s" repeatCount="indefinite"/></circle>':''}
<circle cx="292" cy="134" r="12" fill="var(--br)"/><path d="M286 134l6-6 6 6v6h-12z" fill="none" stroke="#17171C" stroke-width="2" stroke-linejoin="round"/>
${k===2?`<g><circle r="10" fill="#17171C" stroke="#fff" stroke-width="3"/><circle r="3.5" fill="#FFCC4D"/><animateMotion dur="5s" fill="freeze" path="${RT}"/></g>`:k>=3?'<circle cx="292" cy="134" r="10" fill="#17171C" stroke="#fff" stroke-width="3"/><circle cx="292" cy="134" r="3.5" fill="#FFCC4D"/>':'<circle cx="52" cy="42" r="0"/>'}${k<2?'<circle cx="52" cy="42" r="0"/>':''}</svg>`;
const mapCap=k=>[T('Restaurant confirmed your order','Resitora yemeje itegeko','Le restaurant a confirmé'),T('Your food is being prepared','Ibiryo byawe birategurwa','Votre repas est en préparation'),T('Jean Claude is on the way','Jean Claude ari mu nzira','Jean Claude est en route'),T('Arrived at your door','Yageze iwawe','Arrivé chez vous')][Math.min(3,k)];
const mapBlock=()=>`<div class="map97" id="map97" data-k="${S.trk}">${mapInner(S.trk)}</div>`;
const mapInner=k=>`${mapSvg(k)}<div class="cap" role="status"><span style="width:8px;height:8px;border-radius:4px;background:${k>=3?'var(--ok)':'var(--br)'}"></span>${mapCap(k)}</div>`;
const _et=screens.etrack;screens.etrack=()=>{let h=_et();const o=S.orders.find(x=>x.k==='Eats order');
 if(!S.pickup&&!S.ecancel){const i=h.indexOf('<div class="pad" style="padding-top:18px" id="tls">');if(i>0)h=h.slice(0,i)+mapBlock()+h.slice(i)}
 if(o&&o.pm==='cash'&&!S.ecancel){const j=h.indexOf('<div class="pad" id="etx"');const b=`<div class="ban97"><b>${T('Pay in cash','Ishyura mu ntoki','Paiement en espèces')}</b><br>${T('Have '+fmt(o.t)+' RWF ready for your '+(S.pickup?'pickup.':'rider.'),'Préparez '+fmt(o.t)+' RWF pour '+(S.pickup?'le retrait.':'le livreur.'),'Tegura '+fmt(o.t)+' RWF '+(S.pickup?'yo gufata.':'y’umutwara.'))}</div>`;if(j>0)h=h.slice(0,j)+b+h.slice(j)}
 return h};
setInterval(()=>{const m=$('#map97');if(!m)return;if(S.ecancel){m.style.display='none';return}const k=S.trk;if(m.dataset.k!==String(k)){m.dataset.k=k;m.innerHTML=mapInner(k)}},400);
})();
</script>
<script>
/* v101: make text links reachable by keyboard */
(function(){const ph=document.getElementById('phone');if(!ph)return;
const fix=()=>ph.querySelectorAll('.sech a[onclick]:not([role]),.hct a[onclick]:not([role])').forEach(a=>{a.setAttribute('role','button');a.tabIndex=0});
const addr=()=>{const b=ph.querySelector('.cch[onclick="eAddr()"]');if(!b||b.dataset.mv)return;
const t=[...ph.querySelectorAll('div')].find(e=>e.children.length===2&&/KG|Kigali|Kimironko/.test(e.innerText)&&!e.contains(b)&&e.parentElement&&e.parentElement.children.length===2&&e.parentElement.style.display!=='none'&&e.parentElement.querySelector('svg'));
if(!t)return;const w=b.parentElement;b.dataset.mv=1;t.parentElement.style.flexWrap='wrap';b.style.margin='2px 0 0 56px';b.style.height='32px';b.style.fontSize='13px';t.parentElement.appendChild(b);w.remove()};
const canc=()=>{if(typeof S==='undefined'||!S.ecancel)return;const e=ph.querySelector('#eta');if(!e)return;
const m={en:'Order cancelled',fr:'Commande annulée',rw:'Itegeko ryahagaritswe'}[S.lang]||'Order cancelled';
if(e.textContent!==m)e.textContent=m;['#tls','#rider'].forEach(s=>{const x=ph.querySelector(s);if(x&&x.style.display!=='none')x.style.display='none'})};
const run=()=>{fix();addr();canc()};
new MutationObserver(run).observe(ph,{childList:true,subtree:true});run()})();
</script>
<style id="v102">
/* v102: Pay round 2 */
#phone .px-av{width:44px;height:44px;border-radius:14px;background:var(--tint);color:var(--tintfg);display:flex;align-items:center;justify-content:center;font-size:18px;font-weight:800;flex:0 0 44px}
#phone .px-row{display:flex;align-items:center;gap:14px;padding:10px 0;min-height:64px;cursor:pointer}
#phone .px-row .t{font-size:16px;font-weight:700}
#phone .px-row .s{font-size:13px;color:var(--mu);margin-top:2px;line-height:18px}
#phone .px-r{margin-left:auto;text-align:right;font-size:15px;font-weight:800;flex:0 0 auto}
#phone .px-r small{display:block;font-size:12px;font-weight:700;margin-top:2px}
#phone .px-day{font-size:13px;font-weight:700;color:var(--mu);padding:18px 0 2px}
#phone .px-star{width:44px;height:44px;border:0;background:none;font-size:22px;color:var(--lk);display:flex;align-items:center;justify-content:center;flex:0 0 44px}
#phone .px-card{margin:0 24px;padding:4px 18px;border-radius:20px;background:var(--chip)}
#phone .px-kv{display:flex;justify-content:space-between;gap:16px;min-height:50px;align-items:center;font-size:15px}
#phone .px-kv+.px-kv{border-top:0}
#phone .px-kv b{text-align:right;min-width:0;overflow-wrap:anywhere}
#phone .px-bar{height:8px;border-radius:4px;background:var(--chip);overflow:hidden}
#phone .px-bar i{display:block;height:100%;border-radius:4px;background:var(--br)}
#phone .px-tl{display:flex;gap:12px;align-items:flex-start;padding:8px 0;font-size:15px}
#phone .px-tl i{width:22px;height:22px;border-radius:11px;background:var(--chip);color:var(--mu);display:flex;align-items:center;justify-content:center;font-style:normal;font-size:12px;font-weight:800;flex:0 0 22px;margin-top:1px}
#phone .px-tl.done i{background:var(--ok);color:#fff}#phone .px-tl.on i{background:var(--br);color:var(--on)}#phone .px-tl.bad i{background:#D92D20;color:#fff}
#phone .px-tl.off{color:var(--mu)}
#phone .px-st{display:inline-block;font-size:12px;font-weight:800;padding:2px 8px;border-radius:10px;background:var(--chip);color:var(--mu)}
#phone .px-st.ok{background:var(--tint);color:var(--tintfg)}#phone .px-st.er{color:var(--er)}
#phone .px-s{border:0;background:var(--chip);color:var(--tx);font:inherit;font-size:15px;font-weight:700;min-height:44px;border-radius:16px;padding:0 18px}
#phone .px-in{width:100%;height:48px;border:0;border-radius:14px;background:var(--chip);padding:0 14px;font:inherit;font-size:16px;color:var(--tx);outline:0}
#phone .px-in:focus-visible{outline:2px solid var(--lk)}
</style>
<script>
/* v102: Pay round 2. Payment history with search + filters, receipts with refund requests and case tracking, saved merchants, tip + note on payments, Pay limits (per payment and per day). Also fixes Pay again on the hub. rw/fr strings need native review */
(function(){
if(window.__pay102)return;window.__pay102=1;
const L=(e,r,f)=>({en:e,rw:r||e,fr:f||e}[S.lang]||e);
const esc=s=>String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/"/g,'&quot;');
const DAY=864e5;
const dayKey=()=>new Date().toDateString();
const rnd=n=>String(Math.floor(Math.random()*Math.pow(10,n))).padStart(n,'0');
const bal=()=>S.psrc==='bank'?S.bank:S.pay;
const srcN=()=>S.psrc==='bank'?'itunda Bank':'itunda Pay';
const sh=h=>{$('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" role="dialog" aria-modal="true" style="max-height:90%;overflow-y:auto">'+h+'</div>'};
const H1='class="h1" style="font-size:22px;line-height:30px"';
const top=()=>S.stack[S.stack.length-1];

/* ---------- state ---------- */
const X=S.px=S.px||{};
if(!X.init){
 Object.assign(X,{init:1,fav:{},rc:[],note:'',tip:0,cur:'',lim:{one:500000,day:2000000},used:0,ud:dayKey(),id:1,q:'',f:'all',rid:null});
 const now=Date.now(),seed=[['Kigali Bakery','Till 123456',3500,2,9],['Simba Supermarket','Till 731902',18200,5,17],['Nyamirambo Coffee House','Till 204518',2800,6,8],['Kigali Bakery','Till 123456',4200,12,10]];
 seed.forEach(([n,sub,v,d,h],i)=>{const t=new Date(now-d*DAY);t.setHours(h,12+i*7,0,0);X.rc.push({rid:'S'+(i+1),n,sub,v,tip:0,note:'',src:'itunda Pay',sk:'pay',ref:'TX'+String(40210000+i*7313),ms:t.getTime(),st:'paid',seed:1})});
}
const used=()=>{if(X.ud!==dayKey()){X.ud=dayKey();X.used=0}return X.used};
const mkey=m=>m.n+'|'+m.sub;
const tipOf=v=>S.pm&&S.pm.fixed?0:Math.round(v*X.tip/100);
const limErr=t=>t>X.lim.one?1:(used()+t>X.lim.day?2:0);
const limMsg=e=>e===1?L('Over your per-payment limit of ','Birenze ikigero cya buri bwishyu cya ','Au-dessus de votre plafond par paiement de ')+fmt(X.lim.one)+' RWF'
 :L('Over your daily limit. Left today: ','Birenze ikigero cya none. Hasigaye: ','Plafond du jour dépassé. Reste : ')+fmt(Math.max(0,X.lim.day-used()))+' RWF';
const rcOf=id=>X.rc.find(r=>r.rid===id);
const net=r=>r.v+r.tip-(r.st==='refunded'?r.ra:0);
const tm=ms=>new Date(ms).toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'});
const dlab=ms=>{const a=new Date(ms),b=new Date();a.setHours(0,0,0,0);b.setHours(0,0,0,0);const d=Math.round((b-a)/DAY);return d===0?L('Today','Uyu munsi','Aujourd’hui'):d===1?L('Yesterday','Ejo','Hier'):new Date(ms).toLocaleDateString('en-GB',{weekday:'short',day:'numeric',month:'short'})};
const dfull=ms=>new Date(ms).toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric'})+' · '+tm(ms);
const kv=(a,b)=>`<div class="px-kv"><span class="mu">${a}</span><b>${b}</b></div>`;
const stLab=r=>({paid:'',refreq:L('Refund requested','Gusubizwa byasabwe','Remboursement demandé'),refunded:L('Refunded','Byasubijwe','Remboursé'),declined:L('Refund declined','Gusubizwa byanzwe','Remboursement refusé')})[r.st]||'';
const merchants=()=>{const seen={},out=[];X.rc.slice().sort((a,b)=>b.ms-a.ms).forEach(r=>{const k=mkey(r);if(!seen[k]){seen[k]=1;out.push({n:r.n,sub:r.sub,last:r.v,fixed:r.fixed})}});return out};
const favs=()=>Object.values(X.fav);

/* ---------- navigation ---------- */
window.pxGo=n=>{S.stack.push(n);render('push')};
window.pxOpen=id=>{X.rid=id;closeSheet();S.stack.push('payrcd');render('push')};
/* Pay again on the hub: ppMerch only replaced the top of the stack, so from the hub (empty stack) nothing opened */
const _pm=window.ppMerch;
window.ppMerch=k=>{const had=S.stack.length;if(!had)S.stack.push('paysc');_pm(k)};
window.pxPay=key=>{const m=merchants().find(x=>mkey(x)===key)||favs().find(x=>mkey(x)===key);if(!m)return;
 X.cur=key;X.note='';X.tip=0;S.pm={n:m.n,sub:m.sub,amt:m.last&&!m.fixed?String(m.last):'',g:'bag'};
 if(top()==='payamt'){render('fade-none')}else{S.stack.push('payamt');render('push')}};
window.pxFavTog=key=>{const m=merchants().find(x=>mkey(x)===key)||X.fav[key]||(S.pm&&S.pm.n&&mkey(S.pm)===key?{n:S.pm.n,sub:S.pm.sub,last:Number(S.pm.amt)||0}:null);if(!m)return;
 if(X.fav[key]){delete X.fav[key];toast(L('Removed from saved merchants','Byakuwe mu bacuruzi babitswe','Retiré des commerçants enregistrés'))}
 else{X.fav[key]={n:m.n,sub:m.sub,last:m.last};toast(L('Saved merchant','Umucuruzi yabitswe','Commerçant enregistré'))}
 render('fade-none')};

/* ---------- amount screen: tip, note, save, limits ---------- */
const chk=()=>{const m=document.getElementById('ppm'),b=document.getElementById('ppb');if(!m||!b||top()!=='payamt')return;
 const v=Number(S.pm.amt||0),T=v+tipOf(v),e=T>bal()?3:limErr(T);m.onclick=null;m.removeAttribute('role');m.removeAttribute('tabindex');
 if(e&&v){m.textContent=e===3?t('insuff').replace('%s',fmt(bal())):limMsg(e);m.style.color='var(--er)';m.className='';b.disabled=true;
  if(e<3){m.onclick=window.pxLim;m.setAttribute('role','button');m.tabIndex=0;m.style.cursor='pointer';m.style.textDecoration='underline'}}
 else if(v&&tipOf(v)){m.textContent=L('Total with tip ','Yose hamwe n’inyongera ','Total avec pourboire ')+fmt(T)+' RWF · '+srcN()}};
const _pk=window.ppKey;window.ppKey=k=>{_pk(k);chk()};
const _pa=screens.payamt;
screens.payamt=()=>{const m=S.pm,k=mkey(m);if(X.cur!==k){X.cur=k;X.note='';X.tip=0}
 let h=_pa();
 const fv=!!X.fav[k];
 const chips=m.fixed?'':`<div style="padding:16px 24px 0;display:flex;flex-direction:column;gap:10px;align-items:center">
 <div class="req" role="group" aria-label="${L('Tip','Inyongera','Pourboire')}" style="justify-content:center;align-items:center"><span class="sm mu" style="margin-right:2px">${L('Tip','Inyongera','Pourboire')}</span>${[0,5,10].map(p=>`<button class="${X.tip===p?'on':''}" aria-pressed="${X.tip===p}" onclick="pxTip(${p})">${p?p+'%':L('None','Nta na kimwe','Aucun')}</button>`).join('')}</div>
 <div class="req" style="justify-content:center"><button onclick="pxNote()">✎ ${X.note?esc(X.note.length>16?X.note.slice(0,15)+'…':X.note):L('Add a note','Ongeraho ubutumwa','Ajouter une note')}</button><button class="${fv?'on':''}" aria-pressed="${fv}" onclick="pxFavTog('${esc(k).replace(/'/g,"\\'")}')">${fv?'★ '+L('Saved','Yabitswe','Enregistré'):'☆ '+L('Save merchant','Bika umucuruzi','Enregistrer')}</button></div></div>`;
 setTimeout(chk,0);
 return h.replace('<div class="keys"',()=>chips+'<div class="keys"')};
window.pxTip=p=>{X.tip=p;render('fade-none')};
window.pxNote=()=>{sh(`<div ${H1}>${L('Add a note','Ongeraho ubutumwa','Ajouter une note')}</div><div style="margin-top:14px"><input class="px-in" id="pxn" maxlength="40" value="${esc(X.note)}" aria-label="${L('Note','Ubutumwa','Note')}" placeholder="${L('For example: table 4','Urugero: ameza 4','Par exemple : table 4')}" onkeydown="if(event.key==='Enter')pxNoteSave()"></div><div class="fine" style="padding-top:8px">${L('The merchant sees this note with your payment.','Umucuruzi abona ubu butumwa hamwe n’ubwishyu.','Le commerçant voit cette note avec votre paiement.')}</div><button class="btn" style="margin-top:16px" onclick="pxNoteSave()">${L('Save','Bika','Enregistrer')}</button>`);setTimeout(()=>{const i=document.getElementById('pxn');if(i)i.focus()},50)};
window.pxNoteSave=()=>{const i=document.getElementById('pxn');X.note=i?i.value.trim().slice(0,40):X.note;closeSheet();render('fade-none')};

/* ---------- confirm + pay (tip, note, limits) ---------- */
window.ppConfirm=()=>{const m=S.pm,v=Number(m.amt||0);if(!v)return;const tip=tipOf(v),T=v+tip,e=T>bal()?3:limErr(T);
 const rows=[[L('To','Kuri','À'),esc(m.n)],[L('From','Kuva kuri','De'),srcN()]];
 if(X.note&&!m.fixed)rows.push([L('Note','Ubutumwa','Note'),esc(X.note)]);
 if(tip){rows.push([L('Amount','Amafaranga','Montant'),fmt(v)+' RWF']);rows.push([L('Tip','Inyongera','Pourboire'),fmt(tip)+' RWF'])}
 rows.push([L('Fee','Amafaranga y’inyongera','Frais'),'0 RWF']);
 sh(`<div style="margin-bottom:12px">${gl('verified3d',60)}</div><div ${H1}>${L('Confirm it’s you','Emeza ko ari wowe','Confirmez que c’est vous')}</div><div class="big" style="font-size:34px;letter-spacing:-1px;margin-top:12px">${fmt(T)} RWF</div><div style="margin:16px 0 18px">${rows.map(([a,b])=>`<div class="px-kv" style="border-top:0"><span class="mu">${a}</span><b>${b}</b></div>`).join('')}</div>${e?`<div role="alert" style="color:var(--er);font-size:14px;margin-bottom:10px">${e===3?t('insuff').replace('%s',fmt(bal())):limMsg(e)}${e<3?` <a role="button" tabindex="0" style="color:var(--lk);font-weight:700;text-decoration:underline" onclick="pxLim()">${L('Change limits','Hindura ibikwemererwa','Modifier les plafonds')}</a>`:''}</div>`:''}<button class="btn" ${e?'disabled':''} onclick="ppDo()">${L('Confirm','Emeza','Confirmer')}</button><button class="btn sec2" style="margin-top:8px;background:none;height:48px;font-size:16px" onclick="closeSheet()">${L('Cancel','Hagarika','Annuler')}</button>`)};
/* v157: tip, note and save-merchant moved from the amount page into the confirm step as one optional row. rw/fr strings need native review */
const _pc=window.ppConfirm;
window.ppConfirm=()=>{_pc();const m=S.pm,ly=document.getElementById('layer');if(!m||m.fixed||!ly)return;const h=ly.innerHTML,j=h.indexOf('onclick="ppDo()"');if(j<0)return;const b=h.lastIndexOf('<button',j),k=mkey(m),fv=!!X.fav[k];
 const bt=(on,fn,l)=>`<button class="${on?'on':''}" aria-pressed="${!!on}" onclick="${fn}">${l}</button>`;
 const row=`<div style="margin:0 0 14px"><div class="req" role="group" aria-label="${L('Tip','Inyongera','Pourboire')}" style="justify-content:center;align-items:center"><span class="sm mu" style="margin-right:2px">${L('Tip','Inyongera','Pourboire')}</span>${[0,5,10].map(p=>bt(X.tip===p,'pxTipC('+p+')',p?p+'%':L('None','Nta na kimwe','Aucun'))).join('')}</div><div class="req" style="justify-content:center;margin-top:8px"><button onclick="pxNoteC()">✎ ${X.note?esc(X.note.length>16?X.note.slice(0,15)+'…':X.note):L('Add a note','Ongeraho ubutumwa','Ajouter une note')}</button>${bt(fv,"pxFavC('"+esc(k).replace(/'/g,"\\'")+"')",fv?'★ '+L('Saved','Yabitswe','Enregistré'):'☆ '+L('Save merchant','Bika umucuruzi','Enregistrer'))}</div></div>`;
 ly.innerHTML=h.slice(0,b)+row+h.slice(b)};
window.pxTipC=p=>{X.tip=p;ppConfirm()};
window.pxNoteC=()=>{X.fc=1;pxNote()};
window.pxFavC=k=>{pxFavTog(k);ppConfirm()};
{const _ns=window.pxNoteSave;window.pxNoteSave=()=>{_ns();if(X.fc){X.fc=0;ppConfirm()}}}

window.ppDo=()=>{const m=S.pm,v=Number(m.amt||0),tip=tipOf(v),T=v+tip;if(!v||T>bal()||limErr(T))return;
 if(S.psrc==='bank')S.bank-=T;else S.pay-=T;X.used=used()+T;
 addAct('bag',m.n,'Paid',-T,'Paid');
 const rid='P'+(X.id++),ref='TX'+rnd(8),now=Date.now(),note=m.fixed?'':X.note;
 X.rc.unshift({rid,n:m.n,sub:m.sub,v,tip,note,src:srcN(),sk:S.psrc,ref,ms:now,st:'paid',fixed:!!m.fixed});
 S.ppd={n:m.n,sub:m.sub,v:T,src:srcN(),ref,tm:tm(now),rid,tip,base:v,note};
 S.pm={n:'',sub:'',amt:'',g:'bag'};S.tl='';X.note='';X.tip=0;X.cur='';closeSheet();S.stack=['paydone'];render('push')};

/* ---------- done screen: save merchant + receipt ---------- */
const _pd=screens.paydone;
screens.paydone=()=>{let h=_pd();const D=S.ppd;if(!D||!D.rid)return h;const r=rcOf(D.rid);if(!r)return h;const k=mkey(r),fv=!!X.fav[k];
 const sum=(D.tip?L('Includes a tip of ','Harimo inyongera ya ','Pourboire inclus : ')+fmt(D.tip)+' RWF. ':'')+(D.note?L('Note: ','Ubutumwa: ','Note : ')+esc(D.note):'');
 const blk=`<div class="pad" style="padding-top:16px"><div class="req" style="justify-content:center">${r.fixed?'':`<button class="${fv?'on':''}" aria-pressed="${fv}" onclick="pxFavTog('${esc(k).replace(/'/g,"\\'")}')">${fv?'★ '+L('Saved','Yabitswe','Enregistré'):'☆ '+L('Save merchant','Bika umucuruzi','Enregistrer')}</button>`}<button onclick="pxOpen('${r.rid}')">${L('Receipt details','Amakuru ya fagitire','Détails du reçu')}</button></div>${sum?`<div class="fine" style="text-align:center;padding-top:10px">${sum}</div>`:''}</div>`;
 return h.replace('<div class="pad fine"',()=>blk+'<div class="pad fine"')};

/* ---------- payment history ---------- */
const listHtml=()=>{const q=X.q.trim().toLowerCase(),f=X.f;
 const l=X.rc.slice().sort((a,b)=>b.ms-a.ms).filter(r=>(f==='all'||(f==='ref'?r.st!=='paid':r.st==='paid'))&&(!q||(r.n+' '+r.sub+' '+r.ref+' '+r.note).toLowerCase().includes(q)));
 if(!l.length)return `<div class="mu" style="padding:40px 0;text-align:center;line-height:22px">${q?L('No payments match your search.','Nta bwishyu bubonetse.','Aucun paiement trouvé.'):f==='ref'?L('No refund requests yet. Open a payment to ask for a refund.','Nta busabe bwo gusubizwa. Fungura ubwishyu usabe gusubizwa.','Aucune demande de remboursement. Ouvrez un paiement pour en demander un.'):L('No payments yet.','Nta bwishyu burabaho.','Aucun paiement.')}</div>`;
 let last='',o='';l.forEach(r=>{const d=dlab(r.ms);if(d!==last){o+=`<div class="px-day">${d}</div>`;last=d}
  const sl=stLab(r);
  o+=`<div class="px-row" role="button" tabindex="0" onclick="pxOpen('${r.rid}')" aria-label="${esc(r.n)} ${fmt(r.v+r.tip)} RWF"><div class="px-av" aria-hidden="true">${esc(r.n)[0]||'?'}</div><div style="min-width:0"><div class="t">${esc(r.n)}</div><div class="s">${tm(r.ms)} · ${esc(r.src)}${sl?` · <span style="color:${r.st==='declined'?'var(--er)':'var(--lk)'}">${sl}</span>`:''}</div></div><div class="px-r">−${fmt(r.v+r.tip)}${r.st==='refunded'?`<small style="color:var(--ok)">+${fmt(r.ra)}</small>`:''}</div></div>`});
 return o};
screens.payrc=()=>{const now=new Date(),mo=X.rc.filter(r=>{const d=new Date(r.ms);return d.getMonth()===now.getMonth()&&d.getFullYear()===now.getFullYear()}).reduce((a,r)=>a+net(r),0);
 const F=[['all',L('All','Byose','Tout')],['paid',L('Paid','Byishyuwe','Payés')],['ref',L('Refunds','Gusubizwa','Remboursements')]];
 return `<div class="bar"><button class="ib" aria-label="${L('Back','Subira inyuma','Retour')}" onclick="back()">${ic('back',24)}</button><b>${L('Payment history','Amateka y’ubwishyu','Historique des paiements')}</b></div>
<div class="pad" style="padding-top:8px"><div class="sm mu" style="font-weight:700">${L('Spent this month','Wakoresheje uku kwezi','Dépensé ce mois-ci')}</div><div class="big" style="font-size:34px;margin-top:2px">${fmt(mo)} RWF</div>
<input class="px-in" style="margin-top:16px" type="search" id="pxq" value="${esc(X.q)}" oninput="pxQ(this.value)" placeholder="${L('Search merchant, note or reference','Shakisha umucuruzi, ubutumwa cyangwa nimero','Rechercher un commerçant, une note ou une référence')}" aria-label="${L('Search payments','Shakisha ubwishyu','Rechercher des paiements')}">
<div class="req" role="group" style="margin-top:12px">${F.map(([k,n])=>`<button class="${X.f===k?'on':''}" aria-pressed="${X.f===k}" onclick="pxF('${k}')">${n}</button>`).join('')}</div>
<div id="pxl" aria-live="polite">${listHtml()}</div></div>`};
window.pxQ=v=>{X.q=v;const e=document.getElementById('pxl');if(e)e.innerHTML=listHtml()};
window.pxF=f=>{X.f=f;const y=$('#sc')?$('#sc').scrollTop:0;render('fade-none');if($('#sc'))$('#sc').scrollTop=y};

/* ---------- receipt detail + refund ---------- */
const canRefund=r=>r.st==='paid'&&!r.fixed&&(Date.now()-r.ms)<=30*DAY;
const REASONS=()=>[['wrong',L('Wrong amount charged','Hishyuwe amafaranga atari yo','Mauvais montant débité')],['twice',L('Charged twice','Hishyuwe kabiri','Débité deux fois')],['none',L('Item or service not received','Ntabwo nabonye ibyo nishyuriye','Article ou service non reçu')],['mind',L('Changed my mind','Nahinduye icyemezo','J’ai changé d’avis')]];
const reasonOf=k=>(REASONS().find(x=>x[0]===k)||[0,''])[1];
screens.payrcd=()=>{const r=rcOf(X.rid);if(!r)return `<div class="bar"><button class="ib" aria-label="Back" onclick="back()">${ic('back',24)}</button><b></b></div>`;
 const k=mkey(r),fv=!!X.fav[k],c=r.case,sl=stLab(r);
 let cs='';
 if(c){const steps=[L('Request sent','Gusaba byoherejwe','Demande envoyée'),L('Merchant is reviewing','Umucuruzi arimo kubisuzuma','Le commerçant examine'),r.st==='refunded'?L('Refunded to '+r.src,'Byasubijwe kuri '+r.src,'Remboursé sur '+r.src):r.st==='declined'?L('Declined','Byanzwe','Refusé'):L('Decision','Icyemezo','Décision')];
  cs=`<div class="agt" style="padding:26px 24px 8px">${L('Refund','Gusubizwa','Remboursement')} · ${c.id}</div><div class="pad">${steps.map((s,i)=>{const cl=i<c.step?'done':i===c.step&&c.step<2?'on':i===2&&c.step>=2?(r.st==='declined'?'bad':'done'):'off';return `<div class="px-tl ${cl}"><i aria-hidden="true">${cl==='done'?'✓':cl==='bad'?'×':i+1}</i><div>${s}</div></div>`}).join('')}
  <div class="sm mu" style="padding:8px 0 0;line-height:20px">${L('Reason','Impamvu','Motif')}: ${esc(reasonOf(c.reason))} · ${fmt(c.ra)} RWF${r.st==='declined'?'<br>'+L('This reason is not covered by the merchant’s refund policy.','Iyi mpamvu ntiri mu mategeko y’umucuruzi yo gusubiza.','Ce motif n’est pas couvert par la politique de remboursement du commerçant.'):''}</div>
  ${c.step<2?`<button class="px-s" style="margin-top:14px" onclick="pxAdv('${r.rid}')">${L('Check status','Reba aho bigeze','Vérifier le statut')}</button><div class="fine" style="padding-top:8px">${L('Prototype: each tap moves the case forward, like time passing.','Icyitegererezo: buri gukanda gutuma ikibazo gitera imbere.','Prototype : chaque appui fait avancer le dossier.')}</div>`:''}</div>`}
 const cta=r.fixed?`<div class="cta"><button class="btn" onclick="pxPay('${esc(k).replace(/'/g,"\\'")}')">${L('Buy again','Ongera ugure','Racheter')}</button></div>`
  :`<div class="cta" style="display:flex;gap:12px">${canRefund(r)?`<button class="btn sec2" onclick="pxRef('${r.rid}')">${L('Request refund','Saba gusubizwa','Demander un remboursement')}</button>`:''}<button class="btn" onclick="pxPay('${esc(k).replace(/'/g,"\\'")}')">${L('Pay again','Ishyura ukundi','Payer à nouveau')}</button></div>`;
 return `<div class="bar"><button class="ib" aria-label="${L('Back','Subira inyuma','Retour')}" onclick="back()">${ic('back',24)}</button><b>${L('Receipt','Fagitire','Reçu')}</b></div>
<div style="display:flex;flex-direction:column;align-items:center;padding:12px 24px 24px;text-align:center"><div class="px-av" style="width:64px;height:64px;flex:none;border-radius:20px;font-size:26px" aria-hidden="true">${esc(r.n)[0]||'?'}</div><div style="font-size:18px;font-weight:800;margin-top:12px">${esc(r.n)}</div><div class="big" style="font-size:36px;margin-top:6px">${fmt(r.v+r.tip)} RWF</div>${sl?`<div style="margin-top:8px"><span class="px-st ${r.st==='refunded'?'ok':r.st==='declined'?'er':''}">${sl}</span></div>`:''}</div>
<div class="px-card">${kv(L('Merchant','Umucuruzi','Commerçant'),esc(r.sub))}${kv(L('Date','Itariki','Date'),dfull(r.ms))}${kv(L('Paid from','Yishyuwe kuri','Payé depuis'),esc(r.src))}${r.tip?kv(L('Amount','Amafaranga','Montant'),fmt(r.v)+' RWF')+kv(L('Tip','Inyongera','Pourboire'),fmt(r.tip)+' RWF'):''}${r.note?kv(L('Note','Ubutumwa','Note'),esc(r.note)):''}<div class="px-kv" role="button" tabindex="0" onclick="pxCopy('${r.ref}')" style="cursor:pointer"><span class="mu">${L('Reference','Nimero ya transaction','Référence')}</span><b>${r.ref} ⧉</b></div></div>
${cs}
<div class="pad" style="padding-top:18px"><div class="req"><button onclick="toast('${L('Receipt shared','Fagitire yasangijwe','Reçu partagé')}')">${L('Share receipt','Sangiza fagitire','Partager le reçu')}</button>${r.fixed?'':`<button class="${fv?'on':''}" aria-pressed="${fv}" onclick="pxFavTog('${esc(k).replace(/'/g,"\\'")}')">${fv?'★ '+L('Saved','Yabitswe','Enregistré'):'☆ '+L('Save merchant','Bika umucuruzi','Enregistrer')}</button>`}</div>${r.fixed?`<div class="fine" style="padding-top:12px">${L('Airtime purchases cannot be refunded.','Airtime iguzwe ntisubizwa.','Les achats de crédit ne sont pas remboursables.')}</div>`:r.st==='paid'&&!canRefund(r)?`<div class="fine" style="padding-top:12px">${L('Refunds can be requested for 30 days after a payment.','Gusubizwa bisabirwa mu minsi 30 nyuma y’ubwishyu.','Les remboursements se demandent dans les 30 jours.')}</div>`:''}<div class="fine" style="padding-top:12px">${L('Sample payment. No real money moved.','Icyitegererezo. Nta mafaranga yimuwe.','Paiement d’exemple. Aucun argent réel.')}</div></div>${cta}`};
window.pxCopy=ref=>{try{navigator.clipboard.writeText(ref)}catch(_){}toast(L('Reference copied','Nimero yakopowe','Référence copiée'))};
window.pxRef=id=>{const r=rcOf(id);if(!r)return;X.rf={id,reason:'',half:0};pxRefSheet()};
const pxRefSheet=()=>{const r=rcOf(X.rf.id),F=X.rf,full=r.v+r.tip,amt=F.half?Math.round(full/2):full;
 sh(`<div ${H1}>${L('Request a refund','Saba gusubizwa','Demander un remboursement')}</div><div class="mu" style="font-size:14px;margin:6px 0 4px">${esc(r.n)} · ${fmt(full)} RWF</div>
<div class="agt" style="padding:16px 0 8px">${L('What went wrong?','Ni iki kitagenze neza?','Que s’est-il passé ?')}</div><div class="req" role="group">${REASONS().map(([k,n])=>`<button class="${F.reason===k?'on':''}" aria-pressed="${F.reason===k}" onclick="pxRR('${k}')">${n}</button>`).join('')}</div>
<div class="agt" style="padding:16px 0 8px">${L('How much?','Angahe?','Combien ?')}</div><div class="req" role="group">${[[0,L('Full ','Yose ','Tout ')+fmt(full)],[1,L('Half ','Kimwe cya kabiri ','Moitié ')+fmt(Math.round(full/2))]].map(([h,n])=>`<button class="${F.half===h?'on':''}" aria-pressed="${F.half===h}" onclick="pxRH(${h})">${n}</button>`).join('')}</div>
<div class="fine" style="padding-top:12px">${L('Refunds go back to '+r.src+'. The merchant has to approve the request.','Amafaranga asubizwa kuri '+r.src+'. Umucuruzi agomba kubyemera.','Le remboursement revient sur '+r.src+'. Le commerçant doit approuver.')}</div>
<button class="btn" style="margin-top:16px" ${F.reason?'':'disabled'} onclick="pxRefGo()">${L('Send request','Ohereza gusaba','Envoyer la demande')}${F.reason?' · '+fmt(amt)+' RWF':''}</button><button class="btn sec2" style="margin-top:8px;background:none;height:48px;font-size:16px" onclick="closeSheet()">${L('Cancel','Hagarika','Annuler')}</button>`)};
window.pxRR=k=>{X.rf.reason=k;pxRefSheet()};window.pxRH=h=>{X.rf.half=h;pxRefSheet()};
window.pxRefGo=()=>{const F=X.rf,r=rcOf(F.id);if(!r||!F.reason)return;const full=r.v+r.tip;
 r.st='refreq';r.case={id:'RF'+rnd(6),reason:F.reason,ra:F.half?Math.round(full/2):full,step:0,ms:Date.now()};closeSheet();toast(L('Refund request sent','Gusaba gusubizwa byoherejwe','Demande envoyée'));render('fade-none')};
window.pxAdv=id=>{const r=rcOf(id);if(!r||!r.case)return;const c=r.case;if(c.step>=2)return;c.step++;
 if(c.step===2){if(c.reason==='mind'){r.st='declined';toast(L('Refund declined','Gusubizwa byanzwe','Remboursement refusé'))}
  else{r.st='refunded';r.ra=c.ra;if(r.sk==='bank')S.bank+=c.ra;else S.pay+=c.ra;addAct('bag',L('Refund · ','Gusubizwa · ','Remboursement · ')+r.n,'Received',c.ra,'Received');toast(L('Refunded '+fmt(c.ra)+' RWF to '+r.src,'Byasubijwe '+fmt(c.ra)+' RWF kuri '+r.src,fmt(c.ra)+' RWF remboursés sur '+r.src))}}
 const y=$('#sc')?$('#sc').scrollTop:0;render('fade-none');if($('#sc'))$('#sc').scrollTop=y};

/* ---------- saved merchants ---------- */
screens.payfav=()=>{const fk=favs(),fkeys=fk.map(mkey),rec=merchants().filter(m=>!fkeys.includes(mkey(m)));
 const row=(m,on)=>{const k=mkey(m),kk=esc(k).replace(/'/g,"\\'");return `<div class="px-row" role="button" tabindex="0" onclick="pxPay('${kk}')" aria-label="${L('Pay ','Ishyura ','Payer ')}${esc(m.n)}"><div class="px-av" aria-hidden="true">${esc(m.n)[0]||'?'}</div><div style="min-width:0;flex:1"><div class="t">${esc(m.n)}</div><div class="s">${esc(m.sub)}${m.last&&!m.fixed?' · '+L('Last ','Iheruka ','Dernier ')+fmt(m.last)+' RWF':''}</div></div><button class="px-star" aria-pressed="${on}" aria-label="${on?L('Remove from saved','Kura mu byabitswe','Retirer des enregistrés'):L('Save merchant','Bika umucuruzi','Enregistrer')}" onclick="event.stopPropagation();pxFavTog('${kk}')">${on?'★':'☆'}</button></div>`};
 return `<div class="bar"><button class="ib" aria-label="${L('Back','Subira inyuma','Retour')}" onclick="back()">${ic('back',24)}</button><b>${L('Saved merchants','Abacuruzi babitswe','Commerçants enregistrés')}</b></div>
<div class="pad" style="padding-top:8px"><div class="px-day" style="padding-top:8px">${L('Saved','Babitswe','Enregistrés')}</div>${fk.length?fk.map(m=>row(m,true)).join(''):`<div class="mu" style="padding:12px 0 8px;line-height:22px">${L('Tap ☆ on a merchant to keep it here. Paying again takes two taps.','Kanda ☆ ku mucuruzi umubike hano. Kwishyura ukundi bifata gukanda kabiri.','Touchez ☆ pour garder un commerçant ici. Repayer prend deux appuis.')}</div>`}
${rec.length?`<div class="px-day">${L('Recent','Vuba aha','Récents')}</div>${rec.map(m=>row(m,false)).join('')}`:''}</div>`};

/* ---------- limits ---------- */
const PL_MIN=10000,PL_ONE_MAX=2000000,PL_DAY_MAX=5000000;
const plD=()=>S.plmd;
const plLeft=()=>Math.max(0,X.lim.day-used());
const plValid=()=>{const d=plD();return d.one>=PL_MIN&&d.one<=PL_ONE_MAX&&d.day>=PL_MIN&&d.day<=PL_DAY_MAX&&d.one<=d.day};
const plDirty=()=>plD().one!==X.lim.one||plD().day!==X.lim.day;
const plOk=()=>plValid()&&plDirty();
const plBad=k=>{const d=plD(),v=d[k];return k==='one'?(v>PL_ONE_MAX||(v>0&&v<PL_MIN)||(v>d.day&&d.day>=PL_MIN)):(v>PL_DAY_MAX||(v>0&&v<PL_MIN))};
const plMsg=k=>{const d=plD(),v=d[k];
 if(k==='one')return v>PL_ONE_MAX?L('The most per payment is '+fmt(PL_ONE_MAX)+' RWF.','Ntarenza '+fmt(PL_ONE_MAX)+' RWF kuri buri bwishyu.','Maximum '+fmt(PL_ONE_MAX)+' RWF par paiement.')
  :v>0&&v<PL_MIN?L('The least is '+fmt(PL_MIN)+' RWF.','Ntoya ni '+fmt(PL_MIN)+' RWF.','Minimum '+fmt(PL_MIN)+' RWF.')
  :v>d.day&&d.day>=PL_MIN?L('A payment can’t be more than your daily limit.','Ubwishyu ntibushobora kurenza imbibi bya buri munsi.','Un paiement ne peut pas dépasser votre plafond quotidien.')
  :'';
 return v>PL_DAY_MAX?L('The most per day is '+fmt(PL_DAY_MAX)+' RWF.','Ntarenza '+fmt(PL_DAY_MAX)+' RWF ku munsi.','Maximum '+fmt(PL_DAY_MAX)+' RWF par jour.')
  :v>0&&v<PL_MIN?L('The least is '+fmt(PL_MIN)+' RWF.','Ntoya ni '+fmt(PL_MIN)+' RWF.','Minimum '+fmt(PL_MIN)+' RWF.')
  :v>=PL_MIN&&v<used()?L('You have already paid '+fmt(used())+' RWF today, so new payments wait until tomorrow.','Wamaze kwishyura '+fmt(used())+' RWF uyu munsi, ibindi bizategereza ejo.','Vous avez déjà payé '+fmt(used())+' RWF aujourd’hui : les nouveaux paiements attendront demain.')
  :''};
const plShow=k=>plBad(k)||(k==='day'&&plD().day>=PL_MIN&&plD().day<used());
const plBtn=()=>!plValid()?L('Check your limits','Genzura imbibi','Vérifiez vos plafonds'):!plDirty()?L('No changes','Nta cyahindutse','Aucun changement'):L('Save limits','Bika imbibi','Enregistrer');
const plField=(k,label,id)=>`<div style="font-size:16px;font-weight:800;margin-top:32px">${label}</div><div style="display:flex;align-items:center;gap:8px;margin-top:10px;height:56px;padding:0 16px;border-radius:16px;background:var(--chip)"><input id="${id}" inputmode="numeric" autocomplete="off" aria-label="${label} (RWF)" value="${plD()[k]?fmt(plD()[k]):''}" placeholder="0" oninput="plI('${k}',this)" style="flex:1;min-width:0;border:0;outline:0;background:none;font:inherit;font-size:22px;font-weight:800;letter-spacing:-.4px;color:var(--tx);padding:0"><span class="sm mu">RWF</span></div><div id="${id}M" class="sm" aria-live="polite" style="margin-top:8px;color:${plBad(k)?'var(--er)':'var(--tt)'}">${plShow(k)?plMsg(k):''}</div>`;
screens.paylim96=()=>{const u=used(),p=Math.min(100,Math.round(u/Math.max(X.lim.day,1)*100));
 return `${bar(L('Pay limits','Ibikwemererwa kwishyurwa','Plafonds de paiement'))}<div class="pad" style="padding-top:12px">
<div style="display:flex;justify-content:space-between;align-items:baseline"><span class="sm mu">${L('Paid today','Wishyuye uyu munsi','Payé aujourd’hui')}</span><span class="sm"><b>${fmt(u)}</b> <span class="mu">${L('of','kuri','sur')} ${fmt(X.lim.day)} RWF</span></span></div>
<div role="progressbar" aria-valuemin="0" aria-valuemax="${X.lim.day}" aria-valuenow="${u}" style="height:6px;border-radius:3px;background:var(--chip);margin-top:10px;overflow:hidden"><i style="display:block;height:6px;width:${p}%;border-radius:3px;background:${p>=90?'var(--er)':'var(--br)'}"></i></div>
<div class="sm mu" style="margin-top:8px">${L('Left today','Hasigaye uyu munsi','Reste aujourd’hui')}: <b style="color:var(--tx)">${fmt(plLeft())} RWF</b></div>
${plField('one',L('Per payment','Kuri buri bwishyu','Par paiement'),'plO')}${plField('day',L('Per day','Ku munsi','Par jour'),'plY')}
<div class="fine" style="margin-top:28px">${L('Per payment: 10,000 to 2,000,000 RWF. Per day: up to 5,000,000 RWF.','Kuri buri bwishyu: 10,000 kugeza 2,000,000 RWF. Ku munsi: kugeza 5,000,000 RWF.','Par paiement : 10 000 à 2 000 000 RWF. Par jour : jusqu’à 5 000 000 RWF.')}<br>${L('Applies to every payment from itunda Pay or itunda Bank. Lower limits protect you if your phone is lost.','Bikoreshwa ku bwishyu bwose bwa itunda Pay cyangwa itunda Bank. Ibikwemererwa bito bikurinda niba telefoni yawe yatakaye.','S’applique à tous les paiements depuis itunda Pay ou itunda Bank. Des plafonds bas vous protègent si votre téléphone est perdu.')}</div></div>
<div style="height:110px"></div><div class="cta"><button class="btn" id="plG" onclick="plSave()" ${plOk()?'':'disabled'}>${plBtn()}</button></div>`};
const plSync=()=>{[['one','plO'],['day','plY']].forEach(([k,id])=>{const m=document.getElementById(id+'M');if(m){m.textContent=plShow(k)?plMsg(k):'';m.style.color=plBad(k)?'var(--er)':'var(--tt)'}document.querySelectorAll('#'+id+'C button').forEach(b=>b.classList.toggle('on',b.dataset.v==String(plD()[k])))});const g=document.getElementById('plG');if(g){g.disabled=!plOk();g.textContent=plBtn()}};
window.plI=(k,el)=>{const n=Math.min(parseInt(el.value.replace(/\D/g,''),10)||0,99999999);plD()[k]=n;el.value=n?fmt(n):'';plSync()};
window.plQ=(k,n)=>{plD()[k]=n;const i=document.getElementById(k==='one'?'plO':'plY');if(i)i.value=fmt(n);plSync()};
window.plSave=()=>{if(!plOk())return;X.lim.one=plD().one;X.lim.day=plD().day;back();toast(L('Limits saved','Imbibi byabitswe','Plafonds enregistrés'))};
window.pxLim=()=>{closeSheet();S.plmd={one:X.lim.one,day:X.lim.day};S.stack.push('paylim96');render('push')};

/* ---------- Pay hub rows ---------- */
const _hub=screens.pay;
screens.pay=()=>{const h=_hub(),n=X.rc.length,ref=X.rc.filter(r=>r.st==='refreq').length;
 const rows=row('bill',L('Payment history','Amateka y’ubwishyu','Historique des paiements'),ref?ref+' '+L('refund in progress','gusubizwa birimo gukorwa','remboursement en cours'):L('Receipts, search and refunds','Fagitire, gushakisha no gusubizwa','Reçus, recherche et remboursements'),String(n),"pxGo('payrc')")
 +row('star',L('Saved merchants','Abacuruzi babitswe','Commerçants enregistrés'),favs().length?favs().length+' '+L('saved','babitswe','enregistrés'):L('Pay your regulars in two taps','Ishyura abo usanzwe wishyura mu gukanda kabiri','Payez vos habitués en deux appuis'),'',"pxGo('payfav')")
 +row('shield',L('Pay limits','Ibikwemererwa kwishyurwa','Plafonds de paiement'),fmt(X.lim.one)+' '+L('per payment','kuri buri bwishyu','par paiement')+' · '+fmt(X.lim.day)+' '+L('a day','ku munsi','par jour'),'','pxLim()');
 return h.replace('<div class="sech">More</div>',m=>m+rows)};
document.title=document.title.replace('v101','v102');
})();
</script>
<style id="v103">
/* v103: Invest round 2 */
#phone .iv-card{margin:0 24px;padding:14px 18px;border-radius:20px;background:var(--chip)}
#phone .iv-tint{margin:14px 24px 0;padding:12px 14px;border-radius:14px;background:var(--tint);color:var(--tintfg);font-weight:700;font-size:14px;line-height:20px}
#phone .iv-in{width:100%;height:48px;border:0;border-radius:14px;background:var(--chip);padding:0 14px;font:inherit;font-size:16px;font-weight:700;color:var(--tx);outline:0}
#phone .iv-in:focus-visible{outline:2px solid var(--lk)}
#phone .iv-pill{display:inline-block;font-size:12px;font-weight:800;padding:2px 8px;border-radius:10px;background:var(--chip);color:var(--mu)}
#phone .iv-pill.ok{background:var(--tint);color:var(--tintfg)}#phone .iv-pill.er{color:var(--er)}
#phone .iv-cap{font-size:13px;font-weight:700;color:var(--mu);padding:16px 0 8px}
</style>
<script>
/* v103: Invest round 2. Price alerts (above / below, checked live), auto-invest plans (monthly, run now, skip, pause, edit, delete), sector mix and a concentration note. rw/fr strings need native review */
(function(){
if(window.__inv103)return;window.__inv103=1;
const L=(e,r,f)=>({en:e,rw:r||e,fr:f||e}[S.lang]||e);
const esc=s=>String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/"/g,'&quot;');
const fm=n=>fmt(Math.round(n));
const I=S.inv=S.inv||{};
I.al=I.al||[];I.ap=I.ap||[];I.alid=I.alid||1;I.apid=I.apid||1;
S.hold=S.hold||{};
const SEC={BK:'Banking',MTNR:'Telecoms',BRL:'Beverages',IMR:'Banking',CMR:'Construction',KCB:'Banking',KSL:'Energy'};
const stk=tk=>STK.find(x=>x[0]===tk);
const px=tk=>stk(tk)?stk(tk)[2]:0;
const fee=v=>Math.max(100,Math.round(v*.004));
const top=()=>S.stack[S.stack.length-1];
const sh=h=>{$('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" role="dialog" aria-modal="true" style="max-height:90%;overflow-y:auto">'+h+'</div>'};
const H1='class="h1" style="font-size:22px;line-height:30px"';
const rr=()=>{const sc=$('#sc'),y=sc?sc.scrollTop:0;render('fade-none');const n=$('#sc');if(n)n.scrollTop=y};
const tm=ms=>new Date(ms).toLocaleTimeString('en-GB',{hour:'2-digit',minute:'2-digit'});
const dd=ms=>new Date(ms).toLocaleDateString('en-GB',{day:'numeric',month:'short'});
const barH=t=>`<div class="bar"><button class="ib" aria-label="${L('Back','Subira inyuma','Retour')}" onclick="back()">${ic('back',24)}</button><b>${t}</b></div>`;
const badge=tk=>`<div class="tk">${esc(tk)}</div>`;
const CAP='font-size:13px;font-weight:700;color:var(--mu)';
window.ivGo=n=>{S.stack.push(n);render('push')};

/* ================= price alerts ================= */
const alDist=a=>{const p=px(a.tk);return p?Math.abs(a.px-p)/p*100:0};
const alTxt=a=>(a.dir==='above'?L('rises to ','izamutse kugera kuri ','atteint '):L('falls to ','izamanuka kugera kuri ','tombe à '))+fmt(a.px);
function alCheck(){let hit=null;I.al.forEach(a=>{if(!a.on||a.hit||!stk(a.tk))return;const p=px(a.tk);if(a.dir==='above'?p>=a.px:p<=a.px){a.hit=Date.now();a.hp=p;hit=hit||a}});
 if(hit){toast(L('Price alert: ','Ibyibutsa igiciro: ','Alerte de prix : ')+hit.tk+' '+L('at ','kuri ','à ')+fmt(hit.hp));if(top()==='invAl')rr()}}
if(!window.__alT)window.__alT=setInterval(()=>{if(!document.hidden&&S.auth)alCheck()},2500);
screens.invAl=()=>{const act=I.al.filter(a=>!a.hit),hit=I.al.filter(a=>a.hit);
 const row=a=>`<div class="stk" role="button" tabindex="0" onclick="ivAlOpen(${a.id})" aria-label="${esc(a.tk)} ${alTxt(a)}">${badge(a.tk)}<div style="flex:1;min-width:0"><div style="font-weight:700;font-size:16px">${esc(stk(a.tk)?stk(a.tk)[1]:a.tk)}</div><div class="sm mu">${a.hit?L('Reached ','Byageze kuri ','Atteint ')+fmt(a.hp)+' · '+dd(a.hit)+', '+tm(a.hit):L('Tell me when it ','Mbimenyeshe igihe ','Prévenez-moi quand ')+alTxt(a)}</div></div><div style="text-align:right"><div style="font-weight:800">${fmt(px(a.tk))}</div><div class="sm mu">${a.hit?'':a.on?alDist(a).toFixed(1)+'% '+L('away','hasigaye','restant'):L('Paused','Bihagaze','En pause')}</div></div></div>`;
 return `${barH(L('Price alerts','Ibyibutsa igiciro','Alertes de prix'))}<div class="pad" style="padding-top:12px"><button class="btn" onclick="ivAlNew('')">+ ${L('New alert','Icyibutsa gishya','Nouvelle alerte')}</button></div>
${!I.al.length?`<div class="pad mu" style="padding-top:28px;text-align:center;line-height:22px">${L('Pick a price and we tell you when a stock reaches it. Prices here are sample data and move every few seconds.','Hitamo igiciro tukubwire igihe umugabane ukigezeho. Ibiciro hano ni ingero kandi bihinduka buri masegonda make.','Choisissez un prix et nous vous prévenons quand une action l’atteint. Les cours sont des exemples et bougent toutes les quelques secondes.')}</div>`:''}
${act.length?`<div class="agt">${L('Active','Bikora','Actives')}</div>${act.map(row).join('')}`:''}${hit.length?`<div class="agt">${L('Reached','Byagezweho','Atteintes')}</div>${hit.map(row).join('')}`:''}`};
window.ivAlNew=tk=>{I.an={tk:tk||I.an&&I.an.tk||STK[0][0],dir:'above',px:''};alSheet()};
function alSheet(){const N=I.an,p=px(N.tk),v=Number(N.px||0),bad=v&&(N.dir==='above'?v<=p:v>=p),
 q=(N.dir==='above'?[2,5,10]:[-2,-5,-10]).map(x=>[x,Math.round(p*(1+x/100))]);
 sh(`<div ${H1}>${L('New price alert','Icyibutsa gishya cy’igiciro','Nouvelle alerte de prix')}</div>
<div class="iv-cap">${L('Stock','Umugabane','Action')}</div><div class="req" role="group">${STK.map(s=>`<button class="${N.tk===s[0]?'on':''}" aria-pressed="${N.tk===s[0]}" onclick="ivAlTk('${s[0]}')">${s[0]}</button>`).join('')}</div>
<div class="sm mu" style="margin-top:8px">${L('Now ','Ubu ','Maintenant ')}<b>${fmt(p)} RWF</b></div>
<div class="iv-cap">${L('Alert me when it','Mbimenyeshe igihe','Prévenez-moi quand')}</div><div class="req" role="group">${[['above',L('Rises to','Izamutse kugera kuri','Monte à')],['below',L('Falls to','Izamanuka kugera kuri','Baisse à')]].map(([k,l])=>`<button class="${N.dir===k?'on':''}" aria-pressed="${N.dir===k}" onclick="ivAlDir('${k}')">${l}</button>`).join('')}</div>
<div style="margin-top:12px"><input class="iv-in" id="ivap" inputmode="numeric" value="${N.px}" oninput="ivAlPx(this.value)" aria-label="${L('Target price','Igiciro ushaka','Prix cible')}" placeholder="${L('Target price (RWF)','Igiciro ushaka (RWF)','Prix cible (RWF)')}"></div>
<div class="req" style="margin-top:10px">${q.map(([x,y])=>`<button onclick="ivAlQ(${y})">${x>0?'+':'−'}${Math.abs(x)}% · ${fmt(y)}</button>`).join('')}</div>
<div id="ivam" role="alert" style="color:var(--er);font-size:14px;margin-top:10px;min-height:20px">${bad?(N.dir==='above'?L('Pick a price above ','Hitamo igiciro kiri hejuru ya ','Choisissez un prix au-dessus de ')+fmt(p):L('Pick a price below ','Hitamo igiciro kiri munsi ya ','Choisissez un prix en dessous de ')+fmt(p)):''}</div>
<button class="btn" id="ivab" style="margin-top:6px" ${v&&!bad?'':'disabled'} onclick="ivAlSave()">${L('Set alert','Shyiraho icyibutsa','Créer l’alerte')}</button>`)}
window.ivAlTk=t=>{I.an.tk=t;I.an.px='';alSheet()};
window.ivAlDir=d=>{I.an.dir=d;I.an.px='';alSheet()};
window.ivAlQ=n=>{I.an.px=String(n);alSheet()};
window.ivAlPx=v=>{I.an.px=String(v).replace(/\D/g,'').slice(0,7);const N=I.an,p=px(N.tk),n=Number(N.px||0),bad=n&&(N.dir==='above'?n<=p:n>=p),m=document.getElementById('ivam'),b=document.getElementById('ivab');
 if(m)m.textContent=bad?(N.dir==='above'?L('Pick a price above ','Hitamo igiciro kiri hejuru ya ','Choisissez un prix au-dessus de ')+fmt(p):L('Pick a price below ','Hitamo igiciro kiri munsi ya ','Choisissez un prix en dessous de ')+fmt(p)):'';if(b)b.disabled=!(n&&!bad)};
window.ivAlSave=()=>{const N=I.an,n=Number(N.px||0),p=px(N.tk);if(!n||(N.dir==='above'?n<=p:n>=p))return;I.al.unshift({id:I.alid++,tk:N.tk,dir:N.dir,px:n,on:true,hit:0});closeSheet();toast(L('Alert set for ','Icyibutsa cyashyizweho kuri ','Alerte créée pour ')+N.tk);if(top()==='invAl')rr();else if(top()==='stock')rr()};
window.ivAlOpen=id=>{const a=I.al.find(x=>x.id===id);if(!a)return;
 sh(`<div ${H1}>${esc(a.tk)} · ${alTxt(a)}</div><div class="mu" style="font-size:14px;margin:6px 0 18px">${L('Now ','Ubu ','Maintenant ')}${fmt(px(a.tk))} RWF${a.hit?' · '+L('reached ','byageze ','atteint ')+dd(a.hit):''}</div>
${a.hit?`<button class="btn" onclick="ivAlRe(${id})">${L('Set it again','Subiramo','Réactiver')}</button>`:`<button class="btn" onclick="ivAlTog(${id})">${a.on?L('Pause alert','Hagarika icyibutsa','Mettre en pause'):L('Resume alert','Subukiranya icyibutsa','Reprendre')}</button>`}
<button class="btn sec2" style="margin-top:10px" onclick="closeSheet();openStock('${a.tk}')">${L('Open stock','Fungura umugabane','Ouvrir l’action')}</button>
<button class="btn sec2" style="margin-top:10px;color:var(--er)" onclick="ivAlDel(${id})">${L('Delete alert','Siba icyibutsa','Supprimer l’alerte')}</button>`)};
window.ivAlTog=id=>{const a=I.al.find(x=>x.id===id);if(a)a.on=!a.on;closeSheet();rr()};
window.ivAlRe=id=>{const a=I.al.find(x=>x.id===id),p=a?px(a.tk):0;if(!a)return;if(a.dir==='above'?a.px<=p:a.px>=p){toast(L('Target already reached. Delete it and set a new price.','Igiciro cyamaze kugerwaho. Siba ushyireho igishya.','Cible déjà atteinte. Supprimez et fixez un nouveau prix.'));return}a.hit=0;a.on=true;closeSheet();rr()};
window.ivAlDel=id=>{I.al=I.al.filter(x=>x.id!==id);closeSheet();rr();toast(L('Alert deleted','Icyibutsa cyasibwe','Alerte supprimée'))};

/* stock detail: alert row before the buy / sell bar */
const _st=screens.stock;
screens.stock=()=>{let h=_st();const tk=I.sk;if(!tk||!stk(tk))return h;const n=I.al.filter(a=>a.tk===tk&&!a.hit&&a.on).length;
 const r=`<div class="pad" style="padding-top:14px"><div class="stk" role="button" tabindex="0" onclick="ivAlNew('${tk}')" style="background:var(--chip);border-radius:20px;padding:12px 16px;cursor:pointer"><div style="flex:1"><div style="font-weight:800;font-size:16px">${L('Price alert','Icyibutsa cy’igiciro','Alerte de prix')}</div><div class="sm mu">${n?n+' '+L('active for '+tk,'bikora kuri '+tk,'actives pour '+tk):L('Get told when '+tk+' hits your price','Menyeshwa igihe '+tk+' igeze ku giciro cyawe','Soyez prévenu quand '+tk+' atteint votre prix')}</div></div><span style="color:var(--lk);font-weight:800">+</span></div></div>`;
 const i=h.indexOf('<div class="cta"');return i<0?h+r:h.slice(0,i)+r+h.slice(i)};

/* ================= auto-invest ================= */
const nextDate=day=>{const n=new Date(),c=new Date(n.getFullYear(),n.getMonth(),day,9,0,0);if(c<=n)c.setMonth(c.getMonth()+1);return c.getTime()};
const addMo=ms=>{const d=new Date(ms);d.setMonth(d.getMonth()+1);return d.getTime()};
const sharesFor=(tk,amt)=>{const p=px(tk);let q=Math.floor(amt/p);while(q>0&&q*p+fee(q*p)>amt)q--;return Math.max(0,q)};
function apRun(a,auto){const p=px(a.tk),q=sharesFor(a.tk,a.amt);
 if(q<1){a.last={ok:0,why:'small',ts:Date.now()};return 'small'}
 const v=q*p,cost=v+fee(v);if(cost>S.bank){a.last={ok:0,why:'funds',ts:Date.now()};return 'funds'}
 S.bank-=cost;addAct('trend',L('Auto-invest · ','Gushora byikora · ','Investissement auto · ')+q+' '+a.tk,'Paid',-cost,'Paid');
 const h=S.hold[a.tk]||{q:0,avg:p};h.avg=Math.round((h.avg*h.q+cost)/(h.q+q));h.q+=q;S.hold[a.tk]=h;
 I.hist=I.hist||[];I.hist.unshift({k:'buy',tk:a.tk,q,p,a:cost,ts:Date.now()});
 a.runs=(a.runs||0)+1;a.total=(a.total||0)+cost;a.last={ok:1,q,cost,ts:Date.now()};a.next=addMo(a.next>Date.now()?a.next:nextDate(a.day));return 'ok'}
if(!window.__apT)window.__apT=setInterval(()=>{if(document.hidden||!S.auth)return;let ran=0;I.ap.forEach(a=>{if(a.on&&a.next<=Date.now()&&apRun(a,1)==='ok')ran++});if(ran){toast(L('Auto-invest ran for '+ran+' plan'+(ran>1?'s':''),'Gushora byikora byakozwe','Investissement auto exécuté'));if(top()==='invAp')rr()}},4000);
const apStat=a=>!a.on?['er',L('Paused','Bihagaze','En pause')]:a.last&&!a.last.ok?['er',a.last.why==='funds'?L('Not enough balance','Amafaranga ntahagije','Solde insuffisant'):L('Amount too small','Amafaranga ni make','Montant trop faible')]:['ok',L('Next ','Itaha ','Prochain ')+dd(a.next)];
screens.invAp=()=>{const act=I.ap.filter(a=>a.on),mo=act.reduce((s,a)=>s+a.amt,0);
 const row=a=>{const[c,t]=apStat(a);return `<div class="stk" role="button" tabindex="0" onclick="ivApOpen(${a.id})" aria-label="${esc(a.tk)} ${fmt(a.amt)} RWF">${badge(a.tk)}<div style="flex:1;min-width:0"><div style="font-weight:700;font-size:16px">${fmt(a.amt)} RWF · ${L('monthly','buri kwezi','mensuel')}</div><div class="sm mu">${esc(stk(a.tk)?stk(a.tk)[1]:a.tk)} · ${L('day ','umunsi wa ','jour ')}${a.day}</div></div><span class="iv-pill ${c}">${t}</span></div>`};
 return `${barH(L('Auto-invest','Gushora byikora','Investissement auto'))}<div class="pad" style="padding-top:12px"><div class="sm mu" style="font-weight:700">${L('Planned each month','Giteganyijwe buri kwezi','Prévu chaque mois')}</div><div class="big" style="font-size:34px;margin-top:2px">${fm(mo)} RWF</div><div class="sm mu" style="margin-top:4px">${L('Paid from itunda Bank · ','Bivanwa kuri itunda Bank · ','Depuis itunda Bank · ')}${fm(S.bank)} RWF</div><button class="btn" style="margin-top:16px" onclick="ivApEdit(0)">+ ${L('New plan','Gahunda nshya','Nouveau plan')}</button></div>
${!I.ap.length?`<div class="pad mu" style="padding-top:28px;text-align:center;line-height:22px">${L('Invest a fixed amount every month. We buy whole shares at the price on the day and keep the rest in your balance.','Shora amafaranga angana buri kwezi. Tugura imigabane yuzuye ku giciro cyo kuri uwo munsi, asigaye akaguma kuri konti.','Investissez un montant fixe chaque mois. Nous achetons des actions entières au cours du jour et le reste reste sur votre solde.')}</div>`:`<div class="agt">${L('Your plans','Gahunda zawe','Vos plans')}</div>${I.ap.map(row).join('')}`}
<div class="pad fine" style="padding-top:16px">${L('Prototype: dates are not real, so use Run now to see a plan work. Sample prices, not investment advice.','Icyitegererezo: amatariki si ukuri, koresha Kora ubu urebe uko gahunda ikora. Ibiciro by’ingero, si inama y’ishoramari.','Prototype : les dates ne sont pas réelles, utilisez Exécuter maintenant. Cours d’exemple, pas un conseil en investissement.')}</div>`};
window.ivApEdit=id=>{const a=I.ap.find(x=>x.id===id);I.ae=a?{id,tk:a.tk,amt:String(a.amt),day:a.day}:{id:0,tk:STK[0][0],amt:'10000',day:5};apSheet()};
function apSheet(){const E=I.ae,v=Number(E.amt||0),q=sharesFor(E.tk,v),p=px(E.tk),bad=!v||q<1;
 sh(`<div ${H1}>${E.id?L('Edit plan','Hindura gahunda','Modifier le plan'):L('New auto-invest plan','Gahunda nshya yo gushora','Nouveau plan d’investissement')}</div>
<div class="iv-cap">${L('Stock','Umugabane','Action')}</div><div class="req" role="group">${STK.map(s=>`<button class="${E.tk===s[0]?'on':''}" aria-pressed="${E.tk===s[0]}" onclick="ivApTk('${s[0]}')">${s[0]}</button>`).join('')}</div>
<div class="iv-cap">${L('Every month (RWF)','Buri kwezi (RWF)','Chaque mois (RWF)')}</div><input class="iv-in" id="ivapa" inputmode="numeric" value="${E.amt?fmt(E.amt):''}" oninput="ivApAmt(this.value)" aria-label="${L('Monthly amount','Amafaranga y’ukwezi','Montant mensuel')}">
<div class="req" style="margin-top:10px">${[5000,10000,20000,50000].map(n=>`<button class="${v===n?'on':''}" aria-pressed="${v===n}" onclick="ivApQ(${n})">${fmt(n)}</button>`).join('')}</div>
<div class="iv-cap">${L('On day','Ku munsi wa','Le jour')}</div><div class="req" role="group">${[1,5,15,25].map(d=>`<button class="${E.day===d?'on':''}" aria-pressed="${E.day===d}" onclick="ivApDay(${d})">${d}</button>`).join('')}</div>
<div id="ivapm" style="margin-top:14px;font-size:14px;line-height:20px;${bad&&v?'color:var(--er)':'color:var(--mu)'}">${bad?(v?L('Too small for one share of '+E.tk+' ('+fmt(p)+' RWF plus fee).','Ni make ku mugabane umwe wa '+E.tk+' ('+fmt(p)+' RWF n’amafaranga y’inyongera).','Trop faible pour une action '+E.tk+' ('+fmt(p)+' RWF plus frais).'):''):L('About ','Hafi ','Environ ')+q+' '+L('shares at today’s price. First run ','imigabane ku giciro cy’uyu munsi. Itangira ','actions au cours actuel. Premier achat le ')+dd(nextDate(E.day))+'.'}</div>
<button class="btn" id="ivapb" style="margin-top:14px" ${bad?'disabled':''} onclick="ivApSave()">${E.id?L('Save changes','Bika impinduka','Enregistrer'):L('Start plan','Tangira gahunda','Démarrer le plan')}</button>`)}
window.ivApTk=t=>{I.ae.tk=t;apSheet()};window.ivApDay=d=>{I.ae.day=d;apSheet()};window.ivApQ=n=>{I.ae.amt=String(n);apSheet()};
window.ivApAmt=v=>{I.ae.amt=String(v).replace(/\D/g,'').slice(0,8);const E=I.ae,n=Number(E.amt||0),q=sharesFor(E.tk,n),b=document.getElementById('ivapb'),m=document.getElementById('ivapm');if(b)b.disabled=!n||q<1;
 if(m){m.style.color=n&&q<1?'var(--er)':'var(--mu)';m.textContent=!n?'':q<1?L('Too small for one share of '+E.tk+' ('+fmt(px(E.tk))+' RWF plus fee).','Ni make ku mugabane umwe wa '+E.tk+'.','Trop faible pour une action '+E.tk+'.'):L('About ','Hafi ','Environ ')+q+' '+L('shares at today’s price. First run ','imigabane ku giciro cy’uyu munsi. Itangira ','actions au cours actuel. Premier achat le ')+dd(nextDate(E.day))+'.'}};
window.ivApSave=()=>{const E=I.ae,v=Number(E.amt||0);if(!v||sharesFor(E.tk,v)<1)return;
 if(E.id){const a=I.ap.find(x=>x.id===E.id);if(a){a.tk=E.tk;a.amt=v;if(a.day!==E.day){a.day=E.day;a.next=nextDate(E.day)}a.last=null}}
 else I.ap.unshift({id:I.apid++,tk:E.tk,amt:v,day:E.day,on:true,next:nextDate(E.day),runs:0,total:0,last:null});
 closeSheet();toast(E.id?L('Plan updated','Gahunda yavuguruwe','Plan mis à jour'):L('Plan started','Gahunda yatangiye','Plan démarré'));if(top()!=='invAp'){S.stack.push('invAp');render('push')}else rr()};
window.ivApOpen=id=>{const a=I.ap.find(x=>x.id===id);if(!a)return;const q=sharesFor(a.tk,a.amt);
 sh(`<div ${H1}>${esc(a.tk)} · ${fmt(a.amt)} RWF</div><div class="mu" style="font-size:14px;margin:6px 0 4px;line-height:20px">${L('Every month on day ','Buri kwezi ku munsi wa ','Chaque mois le jour ')}${a.day} · ${L('next ','itaha ','prochain ')}${dd(a.next)}<br>${L('About ','Hafi ','Environ ')}${q} ${L('shares at today’s price','imigabane ku giciro cy’uyu munsi','actions au cours actuel')}</div>
<div style="padding:2px 0 12px">${[[L('Runs so far','Inshuro zakozwe','Exécutions'),a.runs||0],[L('Invested so far','Byashowe kugeza ubu','Déjà investi'),fm(a.total||0)+' RWF'],[L('Last run','Iheruka','Dernière'),a.last?(a.last.ok?a.last.q+' '+L('shares · ','imigabane · ','actions · ')+dd(a.last.ts):L('Failed · ','Ntibyakozwe · ','Échec · ')+dd(a.last.ts)):'—']].map(([x,y],i)=>`<div style="display:flex;justify-content:space-between;gap:12px;min-height:44px;align-items:center;font-size:15px;border-top:0"><span class="mu">${x}</span><b>${y}</b></div>`).join('')}</div>
<button class="btn" onclick="ivApRun(${id})">${L('Run now (demo)','Kora ubu (demo)','Exécuter maintenant (démo)')}</button>
<div class="row2" style="margin-top:10px"><button class="btn sec2" onclick="ivApEdit(${id})">${L('Edit','Hindura','Modifier')}</button><button class="btn sec2" onclick="ivApSkip(${id})">${L('Skip a month','Simbuka ukwezi','Passer un mois')}</button></div>
<div class="row2" style="margin-top:10px"><button class="btn sec2" onclick="ivApTog(${id})">${a.on?L('Pause','Hagarika','Pause'):L('Resume','Komeza','Reprendre')}</button><button class="btn sec2" style="color:var(--er)" onclick="ivApAsk(${id})">${L('Delete','Siba','Supprimer')}</button></div>`)};
window.ivApRun=id=>{const a=I.ap.find(x=>x.id===id);if(!a)return;const r=apRun(a);closeSheet();
 toast(r==='ok'?L('Bought '+a.last.q+' '+a.tk+' for '+fm(a.last.cost)+' RWF','Waguze '+a.last.q+' '+a.tk+' kuri '+fm(a.last.cost)+' RWF','Acheté '+a.last.q+' '+a.tk+' pour '+fm(a.last.cost)+' RWF'):r==='funds'?L('Not enough balance in itunda Bank','Amafaranga kuri itunda Bank ntahagije','Solde itunda Bank insuffisant'):L('Amount too small for one share','Amafaranga ni make ku mugabane umwe','Montant trop faible pour une action'));rr()};
window.ivApSkip=id=>{const a=I.ap.find(x=>x.id===id);if(!a)return;a.next=addMo(a.next);closeSheet();rr();toast(L('Skipped. Next run ','Byasimbuwe. Itaha ','Passé. Prochain achat le ')+dd(a.next))};
window.ivApTog=id=>{const a=I.ap.find(x=>x.id===id);if(!a)return;a.on=!a.on;if(a.on&&a.next<=Date.now())a.next=nextDate(a.day);closeSheet();rr()};
window.ivApAsk=id=>sh(`<div ${H1}>${L('Delete this plan?','Gusiba iyi gahunda?','Supprimer ce plan ?')}</div><div class="mu" style="font-size:15px;margin:8px 0 20px">${L('Shares you already bought stay in your portfolio.','Imigabane wamaze kugura iguma muri portfolio yawe.','Les actions déjà achetées restent dans votre portefeuille.')}</div><button class="btn sec2" style="color:var(--er)" onclick="ivApDel(${id})">${L('Delete plan','Siba gahunda','Supprimer le plan')}</button><button class="btn" style="margin-top:10px" onclick="closeSheet()">${L('Keep it','Yigumane','Garder')}</button>`);
window.ivApDel=id=>{I.ap=I.ap.filter(x=>x.id!==id);closeSheet();rr();toast(L('Plan deleted','Gahunda yasibwe','Plan supprimé'))};

/* ================= portfolio: entries, sector mix, concentration ================= */
const _iv=screens.invest;
screens.invest=()=>{let h=_iv();if(I.tab!=='port')return h;
 const hs=Object.keys(S.hold).filter(k=>stk(k)),vals=hs.map(k=>[k,S.hold[k].q*px(k)]),tot=vals.reduce((a,b)=>a+b[1],0);
 const nA=I.al.filter(a=>a.on&&!a.hit).length,nH=I.al.filter(a=>a.hit).length,nP=I.ap.filter(a=>a.on).length,mo=I.ap.filter(a=>a.on).reduce((s,a)=>s+a.amt,0);
 let o=`<div class="pad" style="padding-top:18px">${row('bell',L('Price alerts','Ibyibutsa igiciro','Alertes de prix'),nH?nH+' '+L('reached','byageze','atteintes'):L('Know when a stock hits your price','Menya igihe umugabane ugeze ku giciro cyawe','Sachez quand une action atteint votre prix'),nA?String(nA):'',"ivGo('invAl')")}${row('cyc',L('Auto-invest','Gushora byikora','Investissement auto'),nP?fm(mo)+' RWF '+L('each month','buri kwezi','par mois'):L('Invest a fixed amount every month','Shora amafaranga angana buri kwezi','Investissez un montant fixe chaque mois'),nP?String(nP):'',"ivGo('invAp')")}</div>`;
 if(tot>0){const sec={};vals.forEach(([k,v])=>{const s=SEC[k]||'Other';sec[s]=(sec[s]||0)+v});const ent=Object.entries(sec).sort((a,b)=>b[1]-a[1]),PAL=['#6960F9','#2E6BF0','#0A8F5B','#F5A623','#E5484D','#9B59B6'];
  o+=`<div class="agt">${L('Sector mix','Uko ibyiciro bingana','Répartition par secteur')}</div><div class="pad" style="padding-top:4px"><div class="nwb">${ent.map(([n,v],i)=>`<span style="width:${Math.max(2,v/tot*100)}%;background:${PAL[i%PAL.length]}"></span>`).join('')}</div><div style="padding-top:8px">${ent.map(([n,v],i)=>`<div class="nwl"><span><i style="background:${PAL[i%PAL.length]}"></i>${esc(n)}</span><b>${Math.round(v/tot*100)}%</b></div>`).join('')}</div></div>`;
  const big=vals.slice().sort((a,b)=>b[1]-a[1])[0],sp=big[1]/tot*100;
  if(vals.length>=1&&sp>60)o+=`<div class="iv-tint" role="note">${L(big[0]+' is '+Math.round(sp)+'% of your stocks. Spreading across more companies and sectors lowers the risk of one bad month.',big[0]+' ni '+Math.round(sp)+'% by’imigabane yawe. Kugabanya mu bigo n’ibyiciro bitandukanye bigabanya ibyago.',big[0]+' représente '+Math.round(sp)+' % de vos actions. Répartir sur plus d’entreprises et de secteurs réduit le risque.')}</div>`}
 const mk='<div class="pad fine" style="padding-top:22px;padding-bottom:12px">',i=h.lastIndexOf(mk);return i<0?h+o:h.slice(0,i)+o+h.slice(i)};
document.title=document.title.replace('v102','v103');
})();
</script>
<style id="v104">
/* v104: Messages round 2 */
#phone .mm-chips{display:flex;gap:8px;padding:10px 24px 0;overflow-x:auto;scrollbar-width:none}
#phone .mm-row{display:flex;align-items:center;gap:14px;padding:12px 24px;cursor:pointer;user-select:none;-webkit-user-select:none;touch-action:pan-y}
#phone .mm-row:active{background:var(--chip)}
#phone .mm-more{position:relative;width:32px;height:32px;border:0;background:none;color:var(--mu);border-radius:16px;display:flex;align-items:center;justify-content:center;font-size:20px;font-weight:800;line-height:1;flex:0 0 32px}
#phone .mm-more::after{content:"";position:absolute;inset:-6px}
#phone .mm-bd{min-width:20px;height:20px;border-radius:10px;background:var(--br);color:var(--on);font-size:12px;font-weight:800;display:flex;align-items:center;justify-content:center;padding:0 6px}
#phone .mm-day{text-align:center;font-size:12px;font-weight:700;color:var(--mu);padding:14px 0 4px}
#phone .mm-b{position:relative;max-width:78%;padding:10px 14px;font-size:15px;line-height:21px;overflow-wrap:anywhere;cursor:pointer;text-align:left;border:0;font-family:inherit;color:var(--tx)}
#phone .mm-b.me{background:var(--br);color:var(--on);border-radius:18px 18px 4px 18px}
#phone .mm-b.th{background:var(--chip);border-radius:18px 18px 18px 4px}
#phone .mm-b.dl{background:none;border:1px dashed var(--ln);color:var(--mu);font-style:italic}
#phone .mm-q{border-left:3px solid currentColor;opacity:.75;padding:0 0 0 8px;margin:0 0 6px;font-size:13px;line-height:18px;display:block}
#phone .mm-q b{display:block;font-size:12px}
#phone .mm-t{font-size:11px;color:var(--tt);padding:2px 4px 0}
#phone .mm-rx{display:inline-flex;margin-top:-8px;margin-inline:10px;background:var(--bg);border:1px solid var(--ln);border-radius:12px;padding:2px 6px;position:relative}
#phone .mm-rp{flex:1 0 100%;display:flex;align-items:center;gap:8px;background:var(--chip);border-radius:14px;padding:6px 6px 6px 12px;font-size:13px;color:var(--mu)}
#phone .mm-rp span{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
#phone .mm-act{display:flex;align-items:center;width:100%;text-align:left;border:0;border-top:0;background:none;font:inherit;font-size:16px;font-weight:700;min-height:52px;padding:0;color:var(--tx)}
#phone .mm-rxb{width:52px;height:52px;border:0;border-radius:26px;background:var(--chip);display:flex;align-items:center;justify-content:center}
#phone .mm-rxb.on{background:var(--tint);outline:2px solid var(--lk)}
</style>
<script>
/* v104: Messages round 2. Inbox with pin, mute, archive, mark unread, delete, unread + archived filters, long-press or ⋯ options. Chat with day separators, times, reactions, replies with quote, copy, delete for me, typing + auto-replies, Seen. rw/fr strings need native review */
(function(){
if(window.__msg104)return;window.__msg104=1;
const L=(e,r,f)=>({en:e,rw:r||e,fr:f||e}[S.lang]||e);
const esc=s=>String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/"/g,'&quot;');
const sh=h=>{$('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" role="dialog" aria-modal="true" style="max-height:90%;overflow-y:auto">'+h+'</div>'};
const H1='class="h1" style="font-size:22px;line-height:30px"';
const top=()=>S.stack[S.stack.length-1];
const M=S.mm=S.mm||{pin:{},mute:{},arch:{},f:'all',rp:null,typ:null,dr:''};
const T0=Date.now(),OFF={amina:2,ikimina:60,bakery:240,support:1560};
const msgs=id=>S.msgs[id]||(S.msgs[id]=[]);
function stamp(){THREADS.forEach(t=>{const ms=msgs(t.id),off=OFF[t.id]!=null?OFF[t.id]:0;ms.forEach((x,i)=>{if(!x.ts)x.ts=T0-(off+(ms.length-1-i)*3)*60000})})}
const unr=t=>S.read[t.id]?0:(t.u||0);
const tm=ms=>new Date(ms).toLocaleTimeString('en-GB',{hour:'2-digit',minute:'2-digit'});
const dlab=ms=>{const a=new Date(ms),b=new Date();a.setHours(0,0,0,0);b.setHours(0,0,0,0);const d=Math.round((b-a)/864e5);return d===0?L('Today','Uyu munsi','Aujourd’hui'):d===1?L('Yesterday','Ejo','Hier'):new Date(ms).toLocaleDateString('en-GB',{weekday:'long',day:'numeric',month:'short'})};
const RX=[['heartred',L('Love','Nkunda','J’adore')],['celebrate',L('Celebrate','Ishimira','Bravo')],['verify',L('Done','Byarangiye','Fait')],['gift',L('Thanks','Murakoze','Merci')]];
const rxIcon=k=>gl(k,k==='gift'?22:24);
const mutedIc=s=>`<svg width="${s}" height="${s}" viewBox="0 0 24 24" fill="none" stroke="var(--tt)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="${P.bell}"/><path d="M4 4l16 16"/></svg>`;
const tt=x=>x.del?L('Message deleted','Ubutumwa bwasibwe','Message supprimé'):x[0]==='me'||x[0]==='them'?x[1]:x[0]==='money'?fmt(x[1])+' RWF':x[0]==='gift'?L('Gift voucher','Inyemezabuguzi y’impano','Bon cadeau'):L('Split a bill','Gabana fagitire','Partager une facture');
const prv=t=>{const ms=msgs(t.id),x=ms[ms.length-1];if(M.typ===t.id)return L('typing…','arimo yandika…','écrit…');if(!x)return L('No messages yet','Nta butumwa burabaho','Aucun message');const s=x.del?tt(x):prev(ms);return(x[0]==='me'&&!x.del&&(x[0]==='me')?L('You: ','Wowe: ','Vous : '):'')+s};
function bump(id){const i=THREADS.findIndex(t=>t.id===id);if(i>0){const t=THREADS.splice(i,1)[0];THREADS.unshift(t)}const t=THREADS.find(x=>x.id===id);if(t)t.t=L('Now','Ubu','Maintenant')}

/* ---------------- inbox ---------------- */
const list=()=>{const q=(S.mq||'').trim().toLowerCase();let a=THREADS.filter(t=>!!M.arch[t.id]===(M.f==='arch'));if(M.f==='unr')a=a.filter(t=>unr(t));if(q)a=a.filter(t=>t.n.toLowerCase().includes(q));return a.map((t,i)=>[t,i]).sort((x,y)=>(M.pin[y[0].id]?1:0)-(M.pin[x[0].id]?1:0)||x[1]-y[1]).map(x=>x[0])};
screens.messages=()=>{stamp();const l=list(),nU=THREADS.filter(t=>!M.arch[t.id]&&unr(t)).length,nA=THREADS.filter(t=>M.arch[t.id]).length;
 const F=[['all',L('All','Byose','Tout')],['unr',L('Unread','Ibitarasomwa','Non lus')+(nU?' · '+nU:'')],['arch',L('Archived','Ibibitswe','Archivés')+(nA?' · '+nA:'')]];
 const row=t=>{const u=unr(t),id=t.id;return `<div class="mm-row" role="button" tabindex="0" aria-label="${esc(t.n)}${u?', '+u+' '+L('unread','bitarasomwa','non lus'):''}" onclick="cvOpen('${id}')" onpointerdown="cvDown('${id}')" onpointerup="cvUp()" onpointerleave="cvUp()" onpointercancel="cvUp()" oncontextmenu="event.preventDefault();cvSheet('${id}')"><div class="ico" style="width:52px;height:52px;border-radius:26px;flex:0 0 52px">${gl(t.g,34)}</div><div style="flex:1;min-width:0"><div style="display:flex;justify-content:space-between;align-items:center;gap:6px"><b style="font-size:16px;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;${u?'':'font-weight:700'}">${esc(t.n)}</b><span style="display:flex;align-items:center;gap:6px;flex:0 0 auto">${M.mute[id]?mutedIc(15):''}${M.pin[id]?gl('pin',16):''}<span class="sm mu">${esc(t.t)}</span></span></div><div style="display:flex;justify-content:space-between;align-items:center;gap:8px;margin-top:3px"><span class="sm ${u?'':'mu'}" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;${u?'font-weight:700;color:var(--tx)':''}">${esc(prv(t))}</span><span style="display:flex;align-items:center;gap:4px;flex:0 0 auto">${u?`<span class="mm-bd" style="${M.mute[id]?'background:var(--chip);color:var(--mu)':''}">${u}</span>`:''}</span></div></div></div>`};
 const empty=M.f==='unr'?L('You are all caught up.','Nta butumwa bitarasomwa.','Vous êtes à jour.'):M.f==='arch'?L('Archived conversations show up here.','Ibiganiro bibitswe bizagaragara hano.','Les conversations archivées apparaissent ici.'):S.mq?L('No conversation matches.','Nta kiganiro cyabonetse.','Aucune conversation.'):L('No conversations yet. Tap the pencil to start one.','Nta biganiro biraba. Kanda ikaramu utangire.','Aucune conversation. Touchez le crayon pour commencer.');
 return `<div class="ahead"><b style="font-size:24px;letter-spacing:-.5px">${L('Messages','Ubutumwa','Messages')}</b><div style="display:flex;gap:2px"><button class="ib" aria-label="Search" onclick="soon()">${ic('search',24)}</button><button class="ib" aria-label="New message" onclick="soon()">${ic('pencil',24)}</button></div></div>
${S.mq!==null?`<label class="asr">${ic('search',20)}<input id="mq" placeholder="${L('Search messages','Shakisha ubutumwa','Rechercher')}" value="${esc(S.mq)}" oninput="mSearch(this.value)" aria-label="${L('Search messages','Shakisha ubutumwa','Rechercher')}"></label>`:''}
<div class="mm-chips" role="group" aria-label="${L('Filter','Muyunguruzi','Filtre')}">${F.map(([k,n])=>`<button class="cch ${M.f===k?'on':''}" aria-pressed="${M.f===k}" onclick="cvF('${k}')">${n}</button>`).join('')}</div>
<div style="padding-top:8px">${l.length?l.map(row).join(''):`<div class="mu" style="padding:48px 32px;text-align:center;line-height:22px">${empty}</div>`}</div>
<div class="pad fine" style="padding-top:20px">${L('Press and hold a chat to pin, mute or archive it.','Fata igihe ku kiganiro ukibike hejuru, ucecekeshe cyangwa ubike.','Maintenez appuyé sur une conversation pour l’épingler, la couper ou l’archiver.')}</div>`};
window.cvF=f=>{M.f=f;render('fade-none')};
let lpT=0;window.cvDown=id=>{clearTimeout(lpT);lpT=setTimeout(()=>{window.__lp=1;cvSheet(id)},520)};window.cvUp=()=>clearTimeout(lpT);
window.cvOpen=id=>{if(window.__lp){window.__lp=0;return}openChat(id)};
const refresh=()=>{if(S.stack.length||S.tab==='messages')render('fade-none')};
window.cvSheet=id=>{window.__lp=0;const t=THREADS.find(x=>x.id===id);if(!t)return;const u=unr(t),A=(fn,l,c)=>`<button class="mm-act" ${c?`style="color:${c}"`:''} onclick="${fn}('${id}')">${l}</button>`;
 sh(`<div ${H1}>${esc(t.n)}</div><div style="margin-top:12px">${A('cvPin',M.pin[id]?L('Unpin','Kuramo hejuru','Désépingler'):L('Pin to top','Shyira hejuru','Épingler en haut'))}${A('cvMute',M.mute[id]?L('Unmute','Kuraho guceceka','Réactiver le son'):L('Mute notifications','Ceceka ibimenyeshwa','Couper les notifications'))}${A('cvUnread',u?L('Mark as read','Shyiraho ko wasomye','Marquer comme lu'):L('Mark as unread','Shyiraho ko utasomye','Marquer comme non lu'))}${A('cvArch',M.arch[id]?L('Move to inbox','Subiza mu butumwa','Remettre dans la boîte'):L('Archive','Bika','Archiver'))}${A('cvAsk',L('Delete conversation','Siba ikiganiro','Supprimer la conversation'),'var(--er)')}</div>`)};
const leaveChat=()=>{if(top()==='chat'){S.stack=[];S.tab='messages'}};
window.cvPin=id=>{M.pin[id]=!M.pin[id];closeSheet();refresh();toast(M.pin[id]?L('Pinned','Byashyizwe hejuru','Épinglée'):L('Unpinned','Byakuwe hejuru','Désépinglée'))};
window.cvMute=id=>{M.mute[id]=!M.mute[id];closeSheet();refresh();toast(M.mute[id]?L('Muted','Byacecekeshejwe','En sourdine'):L('Unmuted','Byavuguruye','Son réactivé'))};
window.cvUnread=id=>{const t=THREADS.find(x=>x.id===id);if(!t)return;if(unr(t))S.read[id]=1;else{S.read[id]=0;t.u=Math.max(1,t.u||0)}closeSheet();refresh()};
window.cvArch=id=>{M.arch[id]=!M.arch[id];closeSheet();if(M.arch[id])leaveChat();render('fade-none');toast(M.arch[id]?L('Archived','Byabitswe','Archivée'):L('Moved to inbox','Byasubijwe mu butumwa','Remise dans la boîte'))};
window.cvAsk=id=>{const t=THREADS.find(x=>x.id===id);if(!t)return;sh(`<div ${H1}>${L('Delete this conversation?','Gusiba iki kiganiro?','Supprimer cette conversation ?')}</div><div class="mu" style="font-size:15px;margin:8px 0 20px">${esc(t.n)} · ${L('Messages are removed from this phone.','Ubutumwa buzasibwa kuri telefoni.','Les messages sont supprimés de ce téléphone.')}</div><button class="btn sec2" style="color:var(--er)" onclick="cvDel('${id}')">${L('Delete','Siba','Supprimer')}</button><button class="btn" style="margin-top:10px" onclick="closeSheet()">${L('Keep it','Yigumane','Garder')}</button>`)};
window.cvDel=id=>{const i=THREADS.findIndex(t=>t.id===id);if(i>=0)THREADS.splice(i,1);delete S.msgs[id];delete M.pin[id];delete M.mute[id];delete M.arch[id];closeSheet();leaveChat();render('fade-none');toast(L('Conversation deleted','Ikiganiro cyasibwe','Conversation supprimée'))};

/* ---------------- chat ---------------- */
const qtxt=x=>String(tt(x)).slice(0,60);
const cbub=(x,i,last,seen)=>{const me=x[0]!=='them',k=x[0],text=k==='me'||k==='them';
 let inner;
 if(x.del)inner=`<div class="mm-b dl" style="cursor:default">${tt(x)}</div>`;
 else if(text)inner=`<button class="mm-b ${me?'me':'th'}" aria-label="${L('Message options','Amahitamo y’ubutumwa','Options du message')}" onclick="cvMsg(${i})">${x.rq?`<span class="mm-q"><b>${esc(x.rw)}</b>${esc(x.rq)}</span>`:''}${esc(x[1])}</button>`;
 else inner=`<div onclick="if(!event.target.closest('button'))cvMsg(${i})" style="cursor:pointer;max-width:100%">${bubble(x,i)}</div>`;
 const rx=x.rx&&!x.del?`<span class="mm-rx" aria-label="${L('Reaction','Igisubizo','Réaction')}">${rxIcon(x.rx)}</span>`:'';
 const st=me&&last?`<div class="mm-t">${tm(x.ts)} · ${seen?L('Seen','Byasomwe','Vu'):L('Delivered','Byagejejwe','Distribué')}</div>`:`<div class="mm-t">${tm(x.ts)}</div>`;
 return `<div style="display:flex;flex-direction:column;align-items:${me?'flex-end':'flex-start'};padding:4px 0">${inner}${rx}${st}</div>`};
screens.chat=()=>{const t=thr();if(!t)return `${bar('')}`;stamp();const ms=msgs(t.id);
 let lastMe=-1;ms.forEach((x,i)=>{if(x[0]!=='them'&&!x.del)lastMe=i});const seen=lastMe>=0&&ms.slice(lastMe+1).some(x=>x[0]==='them');
 let d='',body='';ms.forEach((x,i)=>{const l=dlab(x.ts);if(l!==d){body+=`<div class="mm-day">${l}</div>`;d=l}body+=cbub(x,i,i===lastMe,seen)});
 const rp=M.rp!=null?ms[M.rp]:null;
 return `<div class="bar"><button class="ib" aria-label="${L('Back','Subira inyuma','Retour')}" onclick="back()">${ic('back',24)}</button><b>${esc(t.n)}</b><span style="flex:1"></span><button class="ib" aria-label="${L('Conversation options','Amahitamo y’ikiganiro','Options de la conversation')}" onclick="cvSheet('${t.id}')" style="font-size:22px;font-weight:800">⋯</button></div>
<div class="pad sm mu" id="mmsub" role="status" style="padding-top:2px;padding-left:68px;margin-top:0">${M.typ===t.id?L('typing…','arimo yandika…','écrit…'):esc(t.sub)}${M.mute[t.id]&&M.typ!==t.id?' · '+L('Muted','Byacecekeshejwe','Sourdine'):''}</div>
<div class="pad" style="padding-top:8px">${ms.length?body:`<div class="mu" style="padding-top:30px;text-align:center">${L('No messages yet. Say hello.','Nta butumwa burabaho. Muramutse.','Aucun message. Dites bonjour.')}</div>`}</div>
<div class="cta" style="display:flex;flex-wrap:wrap;gap:8px;align-items:center;padding:10px 12px 14px">${rp&&!rp.del?`<span class="mm-rp"><span><b>${L('Replying to ','Usubiza ','Réponse à ')}${rp[0]==='them'?esc(t.n):L('yourself','wowe ubwawe','vous-même')}</b> · ${esc(qtxt(rp))}</span><button class="ib" aria-label="${L('Cancel reply','Hagarika gusubiza','Annuler la réponse')}" style="width:36px;height:36px;flex:0 0 36px" onclick="cvRpX()">${ic('plus',18).replace('<svg','<svg style="transform:rotate(45deg)"')}</button></span>`:''}<button class="ib" aria-label="${L('Send money, a gift or split a bill','Ohereza amafaranga, impano cyangwa ugabane fagitire','Envoyer de l’argent, un cadeau ou partager une facture')}" onclick="chatMenu()" style="background:var(--chip);border-radius:22px;flex-shrink:0">${ic('plus',22)}</button><input id="msg" value="${esc(M.dr||'')}" oninput="cvDr(this.value)" placeholder="${L('Message','Ubutumwa','Message')}" aria-label="${L('Message','Ubutumwa','Message')}" onkeydown="if(event.key==='Enter')chatSend()" style="flex:1;min-width:0;height:44px;border:0;border-radius:22px;background:var(--chip);padding:0 16px;font:inherit;font-size:15px;color:var(--tx);outline:0"><button class="ib" aria-label="${L('Send message','Ohereza ubutumwa','Envoyer')}" onclick="chatSend()" style="background:var(--br);border-radius:22px;flex-shrink:0">${ic('send',20,'#17171C')}</button></div>`};
window.cvDr=v=>{M.dr=v};
window.cvRpX=()=>{M.rp=null;render('fade-none')};
const _oc=window.openChat;window.openChat=id=>{M.rp=null;M.dr='';_oc(id)};
window.cvMsg=i=>{const t=thr(),x=msgs(t.id)[i];if(!x)return;const text=x[0]==='me'||x[0]==='them';
 sh(`<div class="req" role="group" aria-label="${L('React','Subiza','Réagir')}" style="justify-content:space-between;flex-wrap:nowrap">${RX.map(([k,n])=>`<button class="mm-rxb ${x.rx===k?'on':''}" aria-pressed="${x.rx===k}" aria-label="${n}" onclick="cvRx(${i},'${k}')">${rxIcon(k)}</button>`).join('')}</div><div style="margin-top:14px">${text&&!x.del?`<button class="mm-act" onclick="cvReply(${i})">${L('Reply','Subiza','Répondre')}</button><button class="mm-act" onclick="cvCopy(${i})">${L('Copy','Kopora','Copier')}</button>`:''}${text&&!x.del&&x[0]==='me'?`<button class="mm-act" style="color:var(--er)" onclick="cvMDel(${i})">${L('Delete for me','Siba kuri jye','Supprimer pour moi')}</button>`:''}</div>`)};
window.cvRx=(i,k)=>{const x=msgs(thr().id)[i];if(!x)return;x.rx=x.rx===k?null:k;closeSheet();render('fade-none')};
window.cvReply=i=>{M.rp=i;closeSheet();render('fade-none');const n=$('#msg');if(n)n.focus()};
window.cvCopy=i=>{const x=msgs(thr().id)[i];try{navigator.clipboard.writeText(String(x[1]))}catch(_){}closeSheet();toast(L('Copied','Byakopowe','Copié'))};
window.cvMDel=i=>{const ms=msgs(thr().id),x=ms[i];if(!x)return;x.del=1;if(M.rp===i)M.rp=null;closeSheet();render('fade-none')};

/* ---------------- send + auto reply ---------------- */
window.chatSend=function(){const i=$('#msg'),v=((i&&i.value)||'').trim();if(!v)return;const id=S.chat,ms=msgs(id),x=['me',v.slice(0,500)];x.ts=Date.now();
 if(M.rp!=null&&ms[M.rp]&&!ms[M.rp].del){const q=ms[M.rp];x.rq=qtxt(q);x.rw=q[0]==='them'?thr().n:L('You','Wowe','Vous')}
 ms.push(x);M.rp=null;M.dr='';bump(id);S.read[id]=1;render('fade-none');chatEnd();const n=$('#msg');if(n&&n.focus)n.focus();autoReply(id)};
const BOT={amina:[['Thanks, see you soon','Murakoze, tuzabonana vuba','Merci, à bientôt'],['Sounds good','Nibyiza','Ça marche'],['Perfect, thank you','Byiza, murakoze','Parfait, merci']],bakery:[['Thanks, we got your message. Your order is on its way.','Murakoze, twabonye ubutumwa bwawe. Itegeko ryawe riri mu nzira.','Merci, message reçu. Votre commande est en route.']],support:[['Thanks for writing. An agent will reply within 24 hours.','Murakoze kutwandikira. Umukozi azagusubiza mu masaha 24.','Merci de nous écrire. Un agent répondra sous 24 h.']],ikimina:[]};
const GEN=[['Thanks!','Murakoze!','Merci !'],['Okay, got it','Sawa, nabyumvise','D’accord, compris'],['Talk soon','Tuvugane vuba','À bientôt']];
function autoReply(id){const pool=BOT[id]!==undefined?BOT[id]:GEN;if(!pool.length)return;const t=THREADS.find(x=>x.id===id);if(!t)return;
 M.typ=id;const e=document.getElementById('mmsub');if(e&&top()==='chat'&&S.chat===id)e.textContent=L('typing…','arimo yandika…','écrit…');
 setTimeout(()=>{M.typ=null;if(!THREADS.find(x=>x.id===id))return;const r=pool[Math.floor(Math.random()*pool.length)],x=['them',L(r[0],r[1],r[2])];x.ts=Date.now();msgs(id).push(x);bump(id);
  if(top()==='chat'&&S.chat===id){S.read[id]=1;render('fade-none');chatEnd()}
  else{if(!M.mute[id]){const was=unr(t);S.read[id]=0;t.u=(was?t.u:0)+1;toast(L('New message from ','Ubutumwa bushya bwa ','Nouveau message de ')+t.n)}if(!S.stack.length&&S.tab==='messages')render('fade-none')}},1400+Math.random()*800)}
document.title=document.title.replace('v103','v104');
})();
</script>
<style id="v105">
/* v105: Shop round 2 */
#phone .sh5-b{min-height:44px;padding:0 16px}
#phone .sh5-sum{display:flex;align-items:center;gap:6px;border:0;background:none;padding:6px 0;min-height:44px;font:inherit;font-size:14px;color:var(--tx)}
#phone .sh5-st{width:48px;height:48px;border:0;border-radius:24px;background:var(--chip);font-size:26px;line-height:1}
#phone .sh5-ta{width:100%;border:1px solid var(--ln);border-radius:14px;background:var(--bg);color:var(--tx);font:inherit;font-size:15px;padding:12px;resize:none}
#phone .sh5-ad{display:flex;align-items:center;justify-content:space-between;gap:12px;width:100%;text-align:left;border:1px solid var(--ln);border-radius:16px;background:none;padding:12px 14px;min-height:56px;font:inherit;color:var(--tx)}
#phone .sh5-ad>span:first-child{display:flex;flex-direction:column;min-width:0}
#phone .sh5-in{width:100%;height:48px;border:1px solid var(--ln);border-radius:14px;background:var(--bg);color:var(--tx);font:inherit;font-size:16px;padding:0 12px;margin-top:8px}
</style>
<script>
/* v105: Shop round 2. Product ratings + reviews (write, edit, delete, helpful), filters (price, in stock, on sale) with live count, saved delivery addresses in the cart, order actions (cancel with refund, return with reason, review delivered items). rw strings need native review */
(function(){
if(window.__shop105)return;window.__shop105=1;
const L=(e,r,f)=>({en:e,rw:r||e,fr:f||e}[S.lang]||e);
const esc=s=>String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/"/g,'&quot;');
const sh=h=>{$('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" role="dialog" aria-modal="true" style="max-height:90%;overflow-y:auto">'+h+'</div>'};
const H1='class="h1" style="font-size:22px;line-height:30px"';
const q$=s=>document.querySelector(s);
const mine=()=>S.orders.filter(o=>o.k==='Shop order'&&o.items);
const stage=o=>Math.min(3,Math.floor((Date.now()-o.ts)/12000));
const rr=()=>{const e=q$('#sc'),y=e?e.scrollTop:0;render('fade-none');const n=q$('#sc');if(n)n.scrollTop=y};
Object.assign(S,{shF:S.shF||{p:0,st:0,sl:0},shRv:S.shRv||{},shAd:S.shAd||[['Home','KG 11 Ave, Kimironko'],['Work','KN 4 Rd, Nyarugenge']],shAi:S.shAi||0});

/* ---------------- reviews ---------------- */
const stars=n=>`<span role="img" aria-label="${n} ${L('out of 5','kuri 5','sur 5')}" style="color:var(--lk);letter-spacing:1px">${'\u2605'.repeat(n)+'\u2606'.repeat(5-n)}</span>`;
const POOL=[['Aline U.',5,'Exactly as pictured. Arrived in two days.','2 days ago'],['Eric M.',4,'Good quality for the price.','1 week ago'],['Claire M.',5,'Third time buying from this seller.','2 weeks ago'],['Jean P.',3,'Fine, but the packaging was torn.','3 weeks ago'],['Divine K.',4,'Fast delivery, would order again.','1 month ago'],['Patrick N.',5,'Great gift, my sister loved it.','1 month ago']];
const rvs=i=>S.shRv[i]||(S.shRv[i]=[0,2,4].map((o,j)=>{const r=POOL[(i+o)%6];return{n:r[0],r:r[1],t:r[2],w:r[3],h:(i*3+j*2)%7}}));
const avg=i=>{const a=rvs(i);return a.length?a.reduce((s,x)=>s+x.r,0)/a.length:0};
const rev=(r,i,j)=>`<div style="padding:14px 0;border-bottom:0"><div style="display:flex;justify-content:space-between;align-items:center"><b>${esc(r.n)}${r.u?' · '+L('You','Wowe','Vous'):''}</b><span class="sm mu">${esc(r.w)}</span></div><div style="margin:2px 0">${stars(r.r)}</div>${r.t?`<div style="font-size:15px;line-height:22px;overflow-wrap:anywhere">${esc(r.t)}</div>`:''}<div style="display:flex;gap:8px;margin-top:8px">${r.u?`<button class="cch sh5-b" onclick="shRvDel(${i})">${L('Delete','Siba','Supprimer')}</button>`:`<button class="cch sh5-b ${r.hm?'on':''}" aria-pressed="${!!r.hm}" onclick="shHelp(${i},${j})">${L('Helpful','Birafasha','Utile')} · ${r.h}</button>`}</div></div>`;
const _pr=screens.product;
screens.product=()=>{let h=_pr();const i=S.pi,x=PRODS[i],a=rvs(i),av=avg(i);
 const sum=a.length?`<button class="sh5-sum" onclick="shGo()" aria-label="${av.toFixed(1)} ${L('out of 5','kuri 5','sur 5')}, ${a.length} ${L('reviews','isuzuma','avis')}">${stars(Math.round(av))} <b>${av.toFixed(1)}</b> <span class="mu">(${a.length})</span></button>`:`<button class="sh5-sum mu" onclick="shGo()">${L('No reviews yet','Nta suzuma ririraboneka','Pas encore d’avis')}</button>`;
 h=h.replace(x.n+'</div>',()=>x.n+'</div>'+sum);
 const m=a.find(r=>r.u);
 const blk=`<div class="pad" id="shrv" style="padding-top:28px"><div style="display:flex;justify-content:space-between;align-items:center"><span style="font-size:18px;font-weight:800">${L('Reviews','Isuzuma','Avis')}</span><button class="cch on sh5-b" onclick="shRvOpen(${i})">${m?L('Edit yours','Hindura iryawe','Modifier le mien'):L('Write a review','Andika isuzuma','Écrire un avis')}</button></div>${a.length?a.map((r,j)=>rev(r,i,j)).join(''):`<div class="mu" style="padding:16px 0">${L('No reviews yet. Be the first.','Nta suzuma ririraboneka. Banza wowe.','Pas encore d’avis. Soyez le premier.')}</div>`}</div>`;
 let k=h.indexOf('<div class="pad" style="padding-top:24px;font-size:18px;font-weight:800">');if(k<0)k=h.indexOf('<div style="height:110px"></div>');if(k<0)k=h.indexOf('<div class="cta"');
 return k<0?h+blk:h.slice(0,k)+blk+h.slice(k)};
window.shGo=()=>{const e=q$('#shrv');if(e)e.scrollIntoView({behavior:'smooth',block:'start'})};
let draft='',rt=0,ri=0;
const rvSheet=()=>sh(`<div ${H1}>${esc(PRODS[ri].n)}</div><div role="group" aria-label="${L('Your rating','Amanota yawe','Votre note')}" style="display:flex;gap:4px;margin:12px 0">${[1,2,3,4,5].map(n=>`<button class="sh5-st" aria-pressed="${rt===n}" aria-label="${n}" onclick="shRt(${n})" style="color:${n<=rt?'var(--lk)':'var(--tt)'}">${n<=rt?'\u2605':'\u2606'}</button>`).join('')}</div><textarea id="shrt" maxlength="300" rows="3" class="sh5-ta" aria-label="${L('Your review','Isuzuma ryawe','Votre avis')}" placeholder="${L('What did you like or dislike? (optional)','Wakunze iki cyangwa utakunze? (si ngombwa)','Qu’avez-vous aimé ou non ? (facultatif)')}" oninput="shDr(this.value)">${esc(draft)}</textarea><div class="sm mu" style="margin:6px 0 12px;min-height:18px">${rt?'':L('Pick a star rating to post.','Hitamo inyenyeri kugira ngo utangaze.','Choisissez une note pour publier.')}</div><button class="btn" ${rt?'':'disabled'} onclick="shRvPost()">${L('Post review','Tangaza isuzuma','Publier l’avis')}</button>`);
window.shRvOpen=i=>{ri=i;const m=rvs(i).find(r=>r.u);rt=m?m.r:0;draft=m?m.t:'';rvSheet()};
window.shRt=n=>{rt=n;rvSheet()};window.shDr=v=>{draft=v};
window.shRvPost=()=>{if(!rt)return;const a=rvs(ri),m=a.find(r=>r.u),t=draft.trim().slice(0,300);if(m){m.r=rt;m.t=t;m.w=L('Edited just now','Byahinduwe ubu','Modifié à l’instant')}else a.unshift({n:L('You','Wowe','Vous'),r:rt,t,w:L('Just now','Ubu','À l’instant'),h:0,u:1});closeSheet();rr();toast(L('Review posted','Isuzuma ryatangajwe','Avis publié'))};
window.shRvDel=i=>{S.shRv[i]=rvs(i).filter(r=>!r.u);rr();toast(L('Review deleted','Isuzuma ryasibwe','Avis supprimé'))};
window.shHelp=(i,j)=>{const r=rvs(i)[j];if(!r)return;r.hm=!r.hm;r.h+=r.hm?1:-1;rr()};

/* ---------------- filters ---------------- */
const okF=(x,f)=>(!f.p||(f.p===1?x.p<10000:f.p===2?x.p>=10000&&x.p<=20000:x.p>20000))&&(!f.st||x.s>0)&&(!f.sl||x.o>0);
const PR=()=>[[0,L('Any price','Igiciro cyose','Tout prix')],[1,L('Under 10,000','Munsi ya 10,000','Moins de 10 000')],[2,L('10,000 to 20,000','10,000 kugeza 20,000','10 000 à 20 000')],[3,L('Over 20,000','Hejuru ya 20,000','Plus de 20 000')]];
const nF=()=>(S.shF.p?1:0)+(S.shF.st?1:0)+(S.shF.sl?1:0);
const fRow=()=>{const f=S.shF,n=nF(),x=(k,l)=>`<button class="cch on sh5-b" onclick="shFlX('${k}')" aria-label="${L('Remove filter','Kuraho','Retirer le filtre')}: ${l}">${l} \u2715</button>`;
 return `<div class="chips" id="shfl" style="padding-top:10px"><button class="cch sh5-b ${n?'on':''}" onclick="shFl()">${L('Filters','Muyunguruzi','Filtres')}${n?' · '+n:''}</button>${f.p?x('p',PR()[f.p][1]):''}${f.st?x('st',L('In stock','Ibihari','En stock')):''}${f.sl?x('sl',L('On sale','Biri ku giciro gito','En promo')):''}</div>`};
const _s5=screens.shop;
screens.shop=()=>{const h=_s5();if(S.shopTab==='eats')return h;const m='<div class="chips" id="shsort"';return h.includes(m)?h.replace(m,()=>fRow()+m):h};
window.shFl=()=>{const f=S.shF,cnt=PRODS.filter(x=>okF(x,f)).length;
 sh(`<div ${H1}>${L('Filters','Muyunguruzi','Filtres')}</div><div style="font-weight:800;margin:16px 0 8px">${L('Price (RWF)','Igiciro (RWF)','Prix (RWF)')}</div><div role="radiogroup" style="display:flex;flex-wrap:wrap;gap:8px">${PR().map(([k,l])=>`<button class="cch sh5-b ${f.p===k?'on':''}" role="radio" aria-checked="${f.p===k}" onclick="shFlSet('p',${k})">${l}</button>`).join('')}</div><div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:16px">${[['st',L('In stock only','Ibihari gusa','En stock seulement')],['sl',L('On sale only','Biri ku giciro gito gusa','En promo seulement')]].map(([k,l])=>`<button class="cch sh5-b ${f[k]?'on':''}" aria-pressed="${!!f[k]}" onclick="shFlSet('${k}',${f[k]?0:1})">${l}</button>`).join('')}</div><div style="display:flex;gap:10px;margin-top:24px"><button class="btn" style="flex:1;background:var(--chip);color:inherit" onclick="shFlReset()">${L('Reset','Subiza uko byari bimeze','Réinitialiser')}</button><button class="btn" style="flex:1" onclick="shFlGo()">${L('Show','Erekana','Voir')} ${cnt}</button></div>`)};
window.shFlSet=(k,v)=>{S.shF[k]=v;shFl()};
window.shFlReset=()=>{S.shF={p:0,st:0,sl:0};shFl()};
window.shFlGo=()=>{closeSheet();render('fade-none')};
window.shFlX=k=>{S.shF[k]=0;render('fade-none')};
window.shClearF=()=>{S.shF={p:0,st:0,sl:0};render('fade-none')};
const _c=window.shClear;if(_c)window.shClear=()=>{S.shF={p:0,st:0,sl:0};_c()};
const applyF=()=>{const g=q$('#pgrid');if(!g||S.shopTab==='eats')return;const f=S.shF;let v=0,t=0;
 g.querySelectorAll('.pc').forEach(c=>{t++;const m=/openProd\((\d+)\)/.exec(c.getAttribute('onclick')||''),ok=!m||okF(PRODS[+m[1]],f);if(c.style.display!==(ok?'':'none'))c.style.display=ok?'':'none';if(ok)v++});
 let n=g.querySelector('#shnone');
 if(t&&!v){if(!n){n=document.createElement('div');n.id='shnone';n.style.cssText='grid-column:1/-1;text-align:center;padding:36px 12px';n.innerHTML=`<div style="font-size:17px;font-weight:800">${L('Nothing matches these filters','Nta cyabonetse n’ayo muyunguruzi','Aucun résultat avec ces filtres')}</div><div class="sm mu" style="margin:6px 0 16px">${L('Try a wider price range or remove a filter.','Gerageza igiciro kigari cyangwa ukureho muyunguruzi.','Essayez une fourchette plus large ou retirez un filtre.')}</div><button class="cch on sh5-b" onclick="shClearF()">${L('Reset filters','Subiza muyunguruzi','Réinitialiser les filtres')}</button>`;g.appendChild(n)}}else if(n)n.remove()};
new MutationObserver(applyF).observe($('#phone'),{childList:true,subtree:true});

/* ---------------- delivery address ---------------- */
const _sc=screens.scart;
screens.scart=()=>{const h=_sc();if(S.sdel==='pick')return h;const a=S.shAd[S.shAi]||S.shAd[0],m='<div class="pad" role="radiogroup"',i=h.indexOf(m);if(i<0)return h;
 const row=`<div class="pad" style="padding-top:16px"><button class="sh5-ad" onclick="shAddr()" aria-label="${L('Deliver to','Kugezwa kuri','Livrer à')} ${esc(a[0])}, ${esc(a[1])}. ${L('Change','Hindura','Modifier')}"><span><b>${L('Deliver to','Kugezwa kuri','Livrer à')} · ${esc(a[0])}</b><span class="sm mu">${esc(a[1])}</span></span><span style="color:var(--lk);font-weight:700">${L('Change','Hindura','Modifier')}</span></button></div>`;
 return h.slice(0,i)+row+h.slice(i)};
window.shAddr=()=>sh(`<div ${H1}>${L('Deliver to','Kugezwa kuri','Livrer à')}</div><div role="radiogroup" style="margin-top:12px">${S.shAd.map(([k,a],j)=>`<button class="sh5-ad" role="radio" aria-checked="${S.shAi===j}" style="margin-bottom:8px;border:2px solid ${S.shAi===j?'var(--lk)':'var(--ln)'}" onclick="shAPick(${j})"><span><b>${esc(k)}</b><span class="sm mu">${esc(a)}</span></span></button>`).join('')}</div><button class="btn" style="margin-top:8px;background:var(--chip);color:inherit" onclick="shANew()">${L('Add a new address','Ongeraho aderesi nshya','Ajouter une adresse')}</button>`);
window.shAPick=j=>{S.shAi=j;closeSheet();render('fade-none')};
/* v120: Shop new address is now step-by-step (street and area, then an optional name). */
const sar=()=>{const F=S.shaq,a=q$('#shaa'),n=q$('#shan');if(a)F.a=a.value;if(n)F.n=n.value;return F};
const shw=WZ.mk({id:'sa',rd:()=>sar(),steps:()=>['a','n'],final:()=>L('Save and use','Bika kandi ukoreshe','Enregistrer et utiliser'),go:()=>shASave(),
ok:(F,k)=>k==='a'?F.a.trim().length>=4:true,opt:(F,k)=>k==='n'&&!F.n.trim(),
page:(k,F)=>{let o={},body='';
if(k==='a'){o.q=L('Where should we deliver?','Tugezeyo he?','Où livrer ?');o.min=110;body=`<input class="in" id="shaa" value="${esc(F.a)}" maxlength="60" oninput="WZ.r.sa.chk()" onkeydown="WZ.key(event,'sa')" aria-label="${o.q}" placeholder="${L('Street and area','Umuhanda n’agace','Rue et quartier')}" style="font-size:20px;height:56px"><div class="sm mu" style="margin-top:8px">${L('At least 4 characters','Nibura inyuguti 4','Au moins 4 caractères')}</div>`}
else{o.q=L('Give it a name?','Uyihe izina?','Lui donner un nom ?');o.min=110;o.sum=esc(F.a);body=`<input class="in" id="shan" value="${esc(F.n)}" maxlength="20" oninput="WZ.r.sa.chk()" onkeydown="WZ.key(event,'sa')" aria-label="${o.q}" placeholder="${L('Name, for example Mum','Izina, urugero Mama','Nom, par exemple Maman')}" style="font-size:20px;height:56px">`}
o.body=body;return o}});
window.shANew=()=>{S.shaq={a:'',n:'',st:0};shw.draw()};
window.shASave=()=>{const F=sar(),a=F.a.trim(),k=F.n.trim()||L('Other','Ahandi','Autre');if(a.length<4)return;S.shAd.push([k,a]);S.shAi=S.shAd.length-1;closeSheet();render('fade-none');toast(L('Address saved','Aderesi yabitswe','Adresse enregistrée'))};
const _sd=window.shopDone;
window.shopDone=()=>{const n=S.orders.length,pick=S.sdel==='pick',a=S.shAd[S.shAi]||S.shAd[0];_sd();if(S.orders.length>n&&S.orders[0].k==='Shop order'&&!pick)S.orders[0].addr=a[0]+', '+a[1]};

/* ---------------- order actions ---------------- */
const _mo=screens.myorders,MARK='<div style="padding:14px 16px;border-radius:20px;background:var(--chip);margin-bottom:12px">';
screens.myorders=()=>{const h=_mo(),parts=h.split(MARK),os=mine();
 os.forEach((o,n)=>{let p=parts[n+1];if(p==null)return;
  const lab=o.x==='cancel'?L('Cancelled, refunded','Byahagaritswe, amafaranga yasubijwe','Annulée, remboursée'):o.x==='return'?L('Returned, refunded ','Byasubijwe, byishyuwe ','Retournée, remboursée ')+fmt(o.rf)+' RWF':null;
  p=p.replace(/(color:var\(--lk\);font-size:14px">)([^<]*)(<\/div>)/,(m,a,b,c)=>a+(lab||b)+c+(o.addr&&!o.x?`<div class="sm mu" style="margin-top:2px">${L('Deliver to','Kugezwa kuri','Livrer à')} ${esc(o.addr)}</div>`:''));
  if(o.x)p=p.replace(/<button class="cch on" onclick="trackO\(\d+\)">[^<]*<\/button>/,'');
  p=p.replace(/(onclick="reorder\(\d+\)">[^<]*<\/button>)/,(m,a)=>a+`<button class="cch sh5-b" onclick="shMore(${n})">${L('More','Ibindi','Plus')}</button>`);
  parts[n+1]=p});
 return parts.join(MARK)};
window.shMore=n=>{const o=mine()[n];if(!o)return;const s=stage(o),A=(fn,l)=>`<button class="mm-act" onclick="${fn}">${l}</button>`;let b='';
 if(!o.x&&s<2)b+=A(`shCancelAsk(${n})`,L('Cancel order','Hagarika itegeko','Annuler la commande'));
 if(!o.x&&s>=3){b+=A(`shRetAsk(${n})`,L('Return items','Subiza ibicuruzwa','Retourner les articles'));b+=o.items.map(x=>A(`shRvOpen(${x.i})`,L('Review: ','Suzuma: ','Avis : ')+esc(PRODS[x.i].n))).join('')}
 if(!b)b=`<div class="mu" style="padding:12px 0;font-size:15px">${o.x?L('This order is closed.','Iri tegeko ryarangiye.','Cette commande est clôturée.'):L('You can cancel until the order is on the way, and return items after delivery.','Wahagarika itegeko mbere y’uko riba mu nzira, ugasubiza ibicuruzwa nyuma yo kubihabwa.','Vous pouvez annuler avant l’expédition et retourner après la livraison.')}</div>`;
 sh(`<div ${H1}>${o.id}</div><div style="margin-top:12px">${b}</div>`)};
window.shCancelAsk=n=>{const o=mine()[n];if(!o)return;sh(`<div ${H1}>${L('Cancel this order?','Guhagarika iri tegeko?','Annuler cette commande ?')}</div><div class="mu" style="font-size:15px;margin:8px 0 20px">${o.id} · ${L('You get','Uzasubizwa','Vous récupérez')} ${fmt(o.t)} RWF ${L('back in itunda Pay right away.','muri itunda Pay ako kanya.','dans itunda Pay immédiatement.')}</div><button class="btn" onclick="shCancel(${n})">${L('Cancel order','Hagarika itegeko','Annuler la commande')}</button><button class="btn" style="margin-top:10px;background:var(--chip);color:inherit" onclick="closeSheet()">${L('Keep order','Komeza itegeko','Garder la commande')}</button>`)};
window.shCancel=n=>{const o=mine()[n];if(!o||o.x)return;if(stage(o)>=2){closeSheet();toast(L('Too late, the order is already on the way.','Byatinze, itegeko riri mu nzira.','Trop tard, la commande est en route.'));rr();return}
 o.x='cancel';S.pay+=o.t;o.items.forEach(x=>{PRODS[x.i].s+=x.q});closeSheet();rr();toast(L('Order cancelled. Refund sent to itunda Pay.','Itegeko ryahagaritswe. Amafaranga yasubijwe muri itunda Pay.','Commande annulée. Remboursement envoyé sur itunda Pay.'))};
const RS=()=>[L('Wrong item','Ikintu kitari cyo','Mauvais article'),L('Damaged or broken','Cyangiritse cyangwa cyacitse','Endommagé ou cassé'),L('Not as described','Ntabwo ari uko cyasobanuwe','Non conforme à la description'),L('Changed my mind','Nahinduye ibitekerezo','J’ai changé d’avis')];
window.shRetAsk=n=>sh(`<div ${H1}>${L('Why are you returning it?','Kubera iki ubisubiza?','Pourquoi le retourner ?')}</div><div style="margin-top:12px">${RS().map((l,k)=>`<button class="mm-act" onclick="shRet(${n},${k})">${l}</button>`).join('')}</div><div class="sm mu" style="margin-top:12px;line-height:18px">${L('Wrong, damaged or misdescribed items are refunded in full. If you changed your mind, delivery is not refunded.','Ibitari byo, ibyangiritse cyangwa ibitajyanye n’ibisobanuro bisubizwa byose. Niba wahinduye ibitekerezo, amafaranga yo kugezwaho ntasubizwa.','Les articles erronés, abîmés ou non conformes sont remboursés en totalité. Si vous avez changé d’avis, la livraison n’est pas remboursée.')}</div>`);
window.shRet=(n,k)=>{const o=mine()[n];if(!o||o.x||stage(o)<3)return;const fee=o.pick?0:1500;o.rf=k===3?Math.max(0,o.t-fee):o.t;o.x='return';S.pay+=o.rf;closeSheet();rr();toast(L('Return approved. ','Gusubiza byemewe. ','Retour accepté. ')+fmt(o.rf)+' RWF '+L('refunded to itunda Pay.','yasubijwe muri itunda Pay.','remboursés sur itunda Pay.'))};
document.title=document.title.replace('v104','v105');
})();
</script>
<script>
/* v124: touch-area helper + names for icon-only layers */
(function(){
const lang=()=>{try{return S.lang}catch(e){return 'en'}};
const closeL=()=>({rw:'Funga',fr:'Fermer'}[lang()]||'Close');
function fix(){
  const ph=document.getElementById('phone');if(!ph)return;
  ph.querySelectorAll('.sheetbg:not([aria-label])').forEach(e=>e.setAttribute('aria-label',closeL()));
  const free=x=>!x||x==='none'||x==='normal',todo=[];
  /* reads first, writes after, so the page lays out once instead of once per button */
  ph.querySelectorAll('button,a[onclick],[role=button]').forEach(e=>{
    if(e.dataset.h44||e.closest('.keys'))return;
    const r=e.getBoundingClientRect();if(!r.width||!r.height)return;
    let cls='',rel=false;
    if(!(r.width>=44&&r.height>=44)){
      const a=getComputedStyle(e,'::after').content,b=getComputedStyle(e,'::before').content;
      cls=free(a)?'hit44a':free(b)?'hit44b':'';
      rel=!!cls&&getComputedStyle(e).position==='static';
    }
    todo.push([e,cls,rel]);
  });
  todo.forEach(([e,cls,rel])=>{e.dataset.h44='1';if(cls)e.classList.add(cls);if(rel)e.style.position='relative'});
}
let q=0;const sched=()=>{if(q)return;q=setTimeout(()=>{q=0;fix()},600)};
new MutationObserver(sched).observe(document.getElementById('phone'),{childList:true,subtree:true});
sched();
})();
</script>
<script>
/* v139: shorter English hint in the Map search bar */
(function(){const _mv=screens.mapview;
screens.mapview=()=>_mv().replace(/(<span style="flex:1" onclick="mpGo\('mapsearch'\)">)Search places, bus stops, addresses(<\/span>)/,'$1Search places or stops$2');
})();
document.title=document.title.replace('v138','v139');
</script>
<script>
/* v140: balances roll up from 0 once per appearance; amount field ticks on each digit */
(function(){
const rm=matchMedia('(prefers-reduced-motion:reduce)').matches,ph=document.getElementById('phone');
const ease=t=>1-Math.pow(1-t,4);
function roll(el){
  if(rm||el.dataset.roll)return;
  const t=el.textContent,m=t.match(/^\d[\d,]*$/);if(!m)return;
  const end=+t.replace(/,/g,'');if(!end||end<10)return;
  odo(el,end,{from:0,dur:820,delay:120});
}
function tick(el){if(rm)return;el.classList.remove('v140tick');void el.offsetWidth;el.classList.add('v140tick')}
let last=new WeakMap();
const scan=()=>{
  ph.querySelectorAll('#bal,.bv').forEach(roll);
  const a=ph.querySelector('#amt');
  if(a){const v=a.textContent;if(last.has(a)&&last.get(a)!==v)tick(a);last.set(a,v)}
};
let q=0;new MutationObserver(()=>{if(q)return;q=requestAnimationFrame(()=>{q=0;scan()})}).observe(ph,{childList:true,subtree:true,characterData:true});
scan();
})();
document.title=document.title.replace('v139','v140');
</script>
<script>
/* v141: Send recipient shows one list (Recent strip hidden when it only repeats Contacts); light haptic tap on supported phones */
(function(){
const ph=document.getElementById('phone');
function simplify(){
  const rec=[...ph.querySelectorAll('.tap[onclick^="pickGo("]')];
  if(!rec.length)return;
  const sec=rec[0].closest('.sec');if(!sec||sec.dataset.v141)return;
  const nums=s=>(s.match(/'([^']*)'/)||[])[1];
  const have=new Set([...ph.querySelectorAll('.row[onclick^="pick("]')].map(e=>nums(e.getAttribute('onclick'))));
  if(have.size&&rec.every(e=>have.has(nums(e.getAttribute('onclick'))))){sec.dataset.v141='1';sec.classList.add('v141hide')}
}
let q=0;new MutationObserver(()=>{if(q)return;q=requestAnimationFrame(()=>{q=0;simplify()})}).observe(ph,{childList:true,subtree:true});
simplify();
if(navigator.vibrate&&!matchMedia('(prefers-reduced-motion:reduce)').matches)
  ph.addEventListener('pointerdown',e=>{if(e.pointerType==='touch'&&e.target.closest('button,.tap,.keys'))navigator.vibrate(6)},{passive:true});
})();
document.title=document.title.replace('v140','v141');
</script>
<script>
/* v142: hide repeated rows on one screen; drag a sheet down to close it */
(function(){
const ph=document.getElementById('phone'),rm=matchMedia('(prefers-reduced-motion:reduce)').matches;
function dedupe(){
  const sc=ph.querySelector('#view .screen');if(!sc)return;
  const seen=new Set();
  sc.querySelectorAll('.row.tap[onclick]').forEach(r=>{
    if(r.classList.contains('v141hide'))return;
    const t=r.querySelector('.t'),k=r.getAttribute('onclick')+'|'+(t?t.textContent.trim():'');
    if(!t)return;
    if(seen.has(k))r.classList.add('v141hide');else seen.add(k)});
}
let q=0;new MutationObserver(()=>{if(q)return;q=requestAnimationFrame(()=>{q=0;dedupe()})}).observe(ph,{childList:true,subtree:true});
dedupe();
let d=null;
ph.addEventListener('pointerdown',e=>{
  const s=e.target.closest('.sheet');if(!s||e.target.closest('input,textarea,select'))return;
  if(s.scrollTop>0)return;
  d={s,y:e.clientY,t:e.timeStamp,dy:0,on:false,id:e.pointerId};
});
ph.addEventListener('pointermove',e=>{
  if(!d||e.pointerId!==d.id)return;
  const dy=e.clientY-d.y;
  if(!d.on){if(dy>8){d.on=true;d.s.classList.remove('v142r');d.s.classList.add('v142d');try{d.s.setPointerCapture(e.pointerId)}catch(_){}}else if(dy<-8){d=null;return}else return}
  d.dy=Math.max(0,dy);d.s.style.transform='translateY('+d.dy+'px)';
  const bg=ph.querySelector('.sheetbg');if(bg)bg.style.opacity=Math.max(.15,1-d.dy/360);
});
function end(e){
  if(!d||e.pointerId!==d.id)return;const {s,dy,t,on}=d;d=null;if(!on)return;
  s.classList.remove('v142d');
  const v=dy/Math.max(1,e.timeStamp-t);
  if(dy>110||v>.6){
    if(rm){closeSheet();return}
    s.classList.add('v142r');s.style.transform='translateY(110%)';
    const bg=ph.querySelector('.sheetbg');if(bg)bg.style.opacity=0;
    setTimeout(()=>{if(s.isConnected)closeSheet()},200);
  }else{
    s.classList.add('v142r');s.style.transform='';
    const bg=ph.querySelector('.sheetbg');if(bg)bg.style.opacity='';
  }
  s.addEventListener('click',ev=>{ev.stopPropagation();ev.preventDefault()},{capture:true,once:true});
}
ph.addEventListener('pointerup',end);ph.addEventListener('pointercancel',end);
})();
document.title=document.title.replace('v141','v142');
</script>
<script>
/* v143 */
(function(){
const ph=document.getElementById('phone');
const lg=()=>{try{return S.lang}catch(e){return 'en'}};
const T=(en,rw,fr)=>({rw,fr}[lg()]||en);
const openS={};
function fold(){return; /* v181: no folds */
  const sc=ph.querySelector('#view .screen');
  if(!sc||!sc.querySelector(':scope>.ahead button[onclick="openSettings()"]'))return;
  sc.querySelectorAll(':scope>.agt').forEach(hd=>{
    if(hd.dataset.v143)return;
    const items=[];let n=hd.nextElementSibling;
    while(n&&!n.classList.contains('agt')&&!n.classList.contains('fine')){items.push(n);n=n.nextElementSibling}
    const rows=items.filter(e=>e.classList.contains('ar'));
    if(rows.length<3){hd.dataset.v143='0';return}
    const key=hd.textContent.trim(),vals=rows.map(r=>{const s=r.querySelector(':scope>span');return s?s.textContent.trim():''});
    const allZero=vals.every(v=>v===''||v==='0'),sum=allZero?'':vals[vals.length-1];
    hd.dataset.v143='1';hd.setAttribute('role','button');hd.tabIndex=0;
    const sp=document.createElement('span');sp.className='v143s';sp.textContent=sum;
    const c=document.createElement('i');c.className='v143c';
    hd.append(sp,c);
    const b=document.createElement('div'),i=document.createElement('div');b.className='v143b';
    items.forEach(e=>i.appendChild(e));b.appendChild(i);hd.after(b);
    const set=on=>{hd.setAttribute('aria-expanded',on);b.classList.toggle('on',on);openS[key]=on};
    set(!!openS[key]);
    hd.addEventListener('click',()=>set(!b.classList.contains('on')));
    hd.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();set(!b.classList.contains('on'))}});
  });
}
function msg(){
  const sc=ph.querySelector('#view .screen');if(!sc)return;
  const hd=sc.querySelector(':scope>.ahead'),chips=sc.querySelector(':scope>.mm-chips');
  if(!hd||!chips||hd.dataset.v143)return;
  const btn=hd.querySelector('button.ib[onclick="soon()"]');if(!btn)return;
  hd.dataset.v143='1';
  const w=document.createElement('div'),inn=document.createElement('div');w.className='v143q';
  inn.innerHTML='<input type="search" autocomplete="off" aria-label="'+T('Search messages','Shakisha ubutumwa','Rechercher')+'" placeholder="'+T('Search messages','Shakisha ubutumwa','Rechercher')+'">';
  w.appendChild(inn);hd.after(w);w.classList.add('on');btn.style.display='none';
  const inp=inn.firstChild,none=document.createElement('div');none.className='v143n';none.hidden=true;
  none.textContent=T('No matches','Nta bibonetse','Aucun résultat');sc.querySelector('.mm-row')?.parentElement.after(none);
  const filt=()=>{const v=inp.value.trim().toLowerCase();let k=0;
    sc.querySelectorAll('.mm-row').forEach(r=>{const m=!v||r.textContent.toLowerCase().includes(v);r.style.display=m?'':'none';if(m)k++});
    none.hidden=k>0};
  inp.addEventListener('input',filt);
  btn.setAttribute('onclick','');btn.removeAttribute('onclick');
  btn.addEventListener('click',e=>{e.stopPropagation();const on=!w.classList.contains('on');w.classList.toggle('on',on);
    if(on)setTimeout(()=>inp.focus({preventScroll:true}),120);else{inp.value='';filt();inp.blur()}});
}
let q=0;new MutationObserver(()=>{if(q)return;q=requestAnimationFrame(()=>{q=0;fold();msg()})}).observe(ph,{childList:true,subtree:true});
fold();msg();
})();
document.title=document.title.replace('v142','v143');
</script>
<script>
/* v144 */
(function(){
const ph=document.getElementById('phone');
const lg=()=>{try{return S.lang}catch(e){return 'en'}};
const MORE=()=>({rw:'Ibindi',fr:'Plus'}[lg()]||'More');
function shop(){
  const a=ph.querySelector('#shfl'),b=ph.querySelector('#shsort');
  if(!a||!b||a.parentElement.classList.contains('v144row'))return;
  if(a.nextElementSibling!==b)return;
  const w=document.createElement('div');w.className='v144row';a.before(w);w.append(a,b);
}
function more(){return; /* v181: no folds */
  ph.querySelectorAll('.xc.xg').forEach(g=>{
    if(g.dataset.v144)return;
    const rows=[...g.querySelectorAll(':scope>.ar')];
    if(rows.length<=6){g.dataset.v144='0';return}
    g.dataset.v144='1';
    const extra=rows.slice(5);extra.forEach(r=>r.classList.add('v141hide'));
    const m=document.createElement('div');m.className='v144m';m.setAttribute('role','button');m.tabIndex=0;m.setAttribute('aria-expanded','false');
    m.innerHTML='<span>'+MORE()+' ('+extra.length+')</span><i></i>';
    const tg=()=>{const on=m.getAttribute('aria-expanded')!=='true';m.setAttribute('aria-expanded',on);
      extra.forEach((r,i)=>{r.classList.toggle('v141hide',!on);r.classList.remove('v144x');if(on){void r.offsetWidth;r.style.animationDelay=(i*30)+'ms';r.classList.add('v144x')}})};
    m.addEventListener('click',tg);m.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();tg()}});
    g.appendChild(m);
  });
}
let q=0;new MutationObserver(()=>{if(q)return;q=requestAnimationFrame(()=>{q=0;shop();more()})}).observe(ph,{childList:true,subtree:true});

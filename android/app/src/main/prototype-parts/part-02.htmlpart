<script>
/* v186: Digital certificate. Fix: "Renew for 12 months" in Manage renewed straight away, while Revoke asked first; it now shows the same "Renew for 12 months?" confirmation with the new expiry date. PIN pages: "Step 1 of 2" (create) and "Step 2 of 2" (confirm), a live "2 of 4 digits" count, and signing says which document you are signing. English only; fr/rw copy untouched. */
(function(){
const mk=t=>{const d=document.createElement('div');d.className='sm mu';d.style.cssText='font-weight:700;margin-bottom:4px;letter-spacing:.2px';d.textContent=t;return d};
const enhance=()=>{return;const sh=0,dots=0;if(!dots)return;
 const F=S.czf||{},n=(F.buf||'').length,q=sh.querySelector('.h1'),al=sh.querySelector('[role="alert"]');
 if(!sh.dataset.v186){sh.dataset.v186='1';
  const lab=F.step==='pin1'?'Step 1 of 2':F.step==='pin2'?'Step 2 of 2':'Signing';
  if(q){q.before(mk(lab));q.style.marginTop='4px'}
  if(F.step==='sign'){const su=q&&q.nextElementSibling;if(su&&F.doc!=null&&su.textContent.trim())su.textContent='You are signing: '+su.textContent.trim()+'. Enter your 4-digit PIN.'}}
 if(al&&!F.err){al.textContent=n+' of 4 digits';al.style.color='var(--mu)';al.style.fontWeight='600'}};
const L=document.getElementById('layer');if(L)new MutationObserver(()=>requestAnimationFrame(()=>{try{enhance()}catch(e){}})).observe(L,{childList:true,subtree:true});
document.title='itunda, clickable prototype v186';
})();
/* v187: Get a loan. Locked amounts now say why: tapping a greyed amount shows "500,000 RWF opens at a score of 700. Yours is 672." and a line under the amounts lists what unlocks at which score (they were silently disabled before). The review sheet shows the full terms (amount, monthly instalment, total with interest, first payment date, that the money arrives in itunda Bank now) and its button names the amount instead of just "Confirm". Your loan: real dates instead of "The 15th of each month" (next due, final payment), total interest, and a payment schedule with Paid / Next / Upcoming. Fix: "Pay 17,867 RWF" took the money straight away while "Repay in full" asked first; it now asks first too, says which instalment it is and what is left, and flags the last one. English only; fr/rw copy untouched. */
(function(){
const fd=d=>d.toLocaleDateString('en-GB',{day:'numeric',month:'long',year:'numeric'});
const fs=d=>d.toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric'});
const d15=(base,k)=>{const d=new Date(base);d.setDate(15);d.setMonth(d.getMonth()+k);return d};
const limOf=f=>{const a=S.lp.a;return Math.max(Math.min(...a),Math.floor(Math.max(...a)*f/1000)*1000)};
const need=x=>[[0,.25],[600,.5],[700,1]].find(([,f])=>limOf(f)>=x);
const lockSvg='<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="margin-right:6px;vertical-align:-1px"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>';
const st=document.createElement('style');st.id='v187';
st.textContent='.req button.lkd{opacity:.5}.sched{display:flex;align-items:center;gap:10px;min-height:48px;border-top:0;font-size:15px}.sched .d{flex:1}.sched .a{color:var(--mu);font-size:14px}.sched .s{min-width:76px;text-align:right;font-weight:700;font-size:13px}';
document.head.appendChild(st);

const _l=screens.loan;
screens.loan=()=>{let h=_l();if(S.lang!=='en')return h;
 if(S.loan){const L=S.loan,t0=L.t0||Date.now(),left=L.m-L.paid;
  const due=fd(d15(t0,L.paid+1)),fin=fd(d15(t0,L.m)),intr=L.mo*L.m-L.a;
  h=h.replace(/<b>15 of each month<\/b><\/div>/,'<b>'+due+'</b></div>'+lrow('Final payment',fin,1)+lrow('Total interest',fmt(intr)+' RWF',1));
  const rows=Array.from({length:L.m},(_,i)=>{const p=i<L.paid,nx=i===L.paid;
   return '<div class="sched"><span class="d" style="'+(nx?'font-weight:700':'')+'">'+fs(d15(t0,i+1))+'</span><span class="a">'+fmt(L.mo)+' RWF</span><span class="s" style="color:'+(p?'var(--ok)':nx?'var(--lk)':'var(--tt)')+'">'+(p?'Paid':nx?'Next':'Upcoming')+'</span></div>'}).join('');
  const sec='<div class="pad" style="padding-top:28px;padding-bottom:96px"><div style="font-size:18px;font-weight:800;margin-bottom:8px">Payment schedule</div>'+rows+'</div>';
  const i=h.lastIndexOf('<div class="cta">');return i<0?h+sec:h.slice(0,i)+sec+h.slice(i)}
 const lk=[];
 h=h.replace(/<button disabled(?:="")? class="" onclick="S\.la=(\d+);render\('fade-none'\)">([^<]*)<\/button>/g,(m,n,tx)=>{n=+n;lk.push(n);const nd=need(n)[0];
  return '<button class="lkd" aria-disabled="true" onclick="toast(\''+fmt(n)+' RWF opens at a score of '+nd+'. Yours is '+score()+'.\')">'+lockSvg+tx+'</button>'});
 if(lk.length){const parts=lk.map((n,i)=>fmt(n)+' RWF opens at '+(i?'':'a score of ')+need(n)[0]);
  h=h.replace(/Higher amounts unlock as your score improves\.\s*/,'').replace(/<div class="lab"[^>]*>Repay over<\/div>/,m=>'<div class="sm mu" style="margin-top:14px;line-height:19px">Locked: '+parts.join(', ')+'. Yours is '+score()+'.</div>'+m)}
 return h};

const _a=loanAsk;
loanAsk=function(){_a.apply(this,arguments);if(S.lang!=='en')return;
 const sh=document.querySelector('#layer .sheet');if(!sh)return;const q=sh.querySelector('.h1'),su=q&&q.nextElementSibling,b=sh.querySelector('button.btn');if(!q||!su||!b)return;
 const c=lcalc(S.la,S.lm),row=(a,v)=>'<div style="display:flex;justify-content:space-between;gap:12px;min-height:38px;align-items:center;font-size:15px;border-top:0"><span class="mu">'+a+'</span><b style="text-align:right">'+v+'</b></div>';
 q.textContent='Review your loan';
 su.style.margin='10px 0 12px';
 su.innerHTML=row('You borrow',fmt(S.la)+' RWF')+row('Each month',fmt(c.mo)+' RWF for '+S.lm+' months')+row('Total to repay',fmt(c.tot)+' RWF')+row('Of which interest',fmt(c.tot-S.la)+' RWF')+row('First payment',fd(d15(Date.now(),1)))+'<div class="sm mu" style="padding-top:10px;border-top:0">The money is added to itunda Bank right away.</div>';
 su.classList.remove('mu');su.style.fontSize='15px';su.style.marginBottom='20px';
 b.textContent='Borrow '+fmt(S.la)+' RWF'};

const _d=loanDo;
loanDo=function(){_d.apply(this,arguments);if(S.loan&&!S.loan.t0)S.loan.t0=Date.now()};

const _p=loanPay;
loanPay=function(ok){const L=S.loan;
 if(ok||!L||S.lang!=='en'||L.mo>S.bank)return _p.apply(this,arguments);
 const last=L.paid+1>=L.m,after=L.mo*(L.m-L.paid-1),due=fd(d15(L.t0||Date.now(),L.paid+1));
 $('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div style="margin-bottom:12px">'+gl('verified3d',60)+'</div><div class="h1" style="font-size:22px;line-height:30px">'+(last?'Pay your last instalment?':'Pay this month\u2019s instalment?')+'</div><div class="mu" style="font-size:15px;margin:8px 0 24px">'+fmt(L.mo)+' RWF will leave itunda Bank. This is instalment '+(L.paid+1)+' of '+L.m+', due '+due+'. '+(last?'Your loan will be closed.':fmt(after)+' RWF will be left to repay.')+'</div><button class="btn" onclick="closeSheet();loanPay(1)">Pay '+fmt(L.mo)+' RWF</button></div>';
 if(typeof focusSheet==='function')focusSheet()};
document.title='itunda, clickable prototype v187';
})();
/* v188: Buy airtime + Bank "coming up". Airtime: a live "7 of 10 digits" line under the number, and if the number belongs to the other network (078/079 = MTN, 072/073 = Airtel) it says so with a one-tap "Switch to Airtel". Fix: "Buy 1,000 RWF" took the money the moment you tapped it while loans, bills and Repay in full ask first; it now shows a review (network, number, amount, balance after) and its button names the amount. Recent purchases can be tapped to buy again for the same number. Bank: the loan instalment under "Coming up" said "15th of each month"; it now shows the real date. English only; fr/rw copy untouched. */
(function(){
const fs=d=>d.toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric'});
const mk=s=>s.replace(/^(\d{3})(\d{3})(\d+)$/,'$1 $2 $3');
const netOf=p=>/^07[89]/.test(p)?'MTN':/^07[23]/.test(p)?'Airtel':null;
const stat=()=>{const A=S.air,n=A.ph.length;if(!n)return '';
 if(n<10)return '<span class="mu">'+n+' of 10 digits</span>';
 const nt=netOf(A.ph);
 if(nt&&nt!==A.op)return '<span style="color:var(--er)">This looks like an '+nt+' number.</span> <button type="button" onclick="airSet(\'op\',\''+nt+'\')" style="border:0;background:none;padding:6px 0;font-weight:700;color:var(--lk);font-size:13px">Switch to '+nt+'</button>';
 return '<span style="color:var(--ok);font-weight:600">Looks good'+(nt?' · '+nt:'')+'</span>'};
const _s=screens.airtime;
screens.airtime=()=>{let h=_s();if(S.lang!=='en'||S.air.done)return h;
 h=h.replace(/(<input id="airph"[^>]*>)/,'$1<div id="airst" class="sm" role="status" style="margin-top:8px;min-height:20px">'+stat()+'</div>');
 let i=0;
 h=h.replace(/<div style="display:flex;justify-content:space-between;padding:10px 0;font-size:15px"><span>/g,()=>'<div class="tap" role="button" tabindex="0" onclick="airReuse('+(i++)+')" style="display:flex;justify-content:space-between;min-height:44px;align-items:center;font-size:15px;cursor:pointer"><span>');
 h=h.replace(/Recent<\/div>/,'Recent</div><div class="sm mu" style="margin-top:2px">Tap one to buy for the same number again</div>');
 return h};
window.airReuse=i=>{const x=S.air.hist[i];if(!x)return;S.air.op=x[0];S.air.ph=x[1];render('fade-none')};
const _p=window.airPh;
window.airPh=function(v){_p.apply(this,arguments);if(S.lang!=='en')return;const e=document.getElementById('airst');if(e)e.innerHTML=stat()};
const _y=window.airPay;
window.airPay=function(ok){const A=S.air;
 if(ok||S.lang!=='en'||A.ph.length<9||A.amt>S.pay)return _y.apply(this,arguments);
 const nt=netOf(A.ph),warn=nt&&nt!==A.op,row=(a,v)=>'<div style="display:flex;justify-content:space-between;gap:12px;min-height:40px;align-items:center;font-size:15px;border-top:0"><span class="mu">'+a+'</span><b style="text-align:right">'+v+'</b></div>';
 $('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="h1" style="font-size:22px;line-height:30px;margin-top:4px">Review airtime</div><div style="margin:12px 0 '+(warn?'8px':'22px')+'">'+row('Network',A.op)+row('Phone number',mk(A.ph))+row('Amount',fmt(A.amt)+' RWF')+row('Paid from','itunda Pay')+row('Balance after',fmt(S.pay-A.amt)+' RWF')+'</div>'+(warn?'<div class="sm" style="color:var(--er);margin-bottom:16px;line-height:19px">This number looks like an '+nt+' number, but you picked '+A.op+'. Airtime sent to the wrong network may not arrive.</div>':'')+'<button class="btn" onclick="closeSheet();airPay(1)">Buy '+fmt(A.amt)+' RWF</button></div>';
 if(typeof focusSheet==='function')focusSheet()};
const fix=()=>{if(S.lang!=='en'||!S.loan)return;const ph=document.getElementById('phone');if(!ph)return;const w=document.createTreeWalker(ph,NodeFilter.SHOW_TEXT);let n;while(n=w.nextNode()){if(n.nodeValue.trim()==='15th of each month'){const L=S.loan,d=new Date(L.t0||Date.now());d.setDate(15);d.setMonth(d.getMonth()+L.paid+1);n.nodeValue='Due '+fs(d)}}};
let q=0;new MutationObserver(()=>{if(q)return;q=requestAnimationFrame(()=>{q=0;try{fix()}catch(e){}})}).observe(document.getElementById('phone'),{childList:true,subtree:true});
document.title='itunda, clickable prototype v188';
})();
/* v189: 12-month deposit. Fix: the unlock date was typed in as "15 Oct 2027" everywhere (screen, confirm sheet, Bank card), so it was never 12 months from the day you lock; it is now the day you lock plus 12 months. The confirm sheet shows the terms (locked until, interest paid now, principal back) and its button names the amount ("Lock 100,000 RWF" instead of "Lock it"). The screen gets a "Your principal back" row. Once locked: a progress bar with days left, and a plain line that the principal stays locked until the date. English only; fr/rw copy untouched. */
(function(){
const fs=d=>d.toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric'});
const unl=t0=>{const d=new Date(t0);d.setFullYear(d.getFullYear()+1);return d};
const cur=()=>unl(S.dep&&S.dep.t0||Date.now());
const OLD='15 Oct 2027';
const _s=screens.dep;
screens.dep=()=>{let h=_s();if(S.lang!=='en')return h;h=h.split(OLD).join(fs(cur()));
 if(S.dep){const D=S.dep,t0=D.t0||Date.now(),end=unl(t0).getTime(),days=Math.max(0,Math.ceil((end-Date.now())/864e5)),pc=Math.min(100,Math.max(0,Math.round((Date.now()-t0)/(end-t0)*100)));
  h=h.replace(/(Interest already paid: [^<]*<\/div>)/,'$1<div style="height:8px;border-radius:4px;background:var(--chip);margin-top:18px"><div style="height:8px;border-radius:4px;background:var(--br);width:'+pc+'%"></div></div><div class="sm mu" style="margin-top:8px">'+days+' day'+(days===1?'':'s')+' left</div>');
  h=h.replace('Sample deposit for this prototype.','The principal stays locked until the unlock date. Sample deposit for this prototype.')}
 else h=h.replace(/(<span>Unlocks<\/span><b>[^<]*<\/b><\/div>)/,'$1'+lrow('Your principal back',fmt(S.da)+' RWF',1));
 return h};
const _a=depAsk;
depAsk=function(){_a.apply(this,arguments);if(S.lang!=='en')return;
 const sh=document.querySelector('#layer .sheet');if(!sh)return;const q=sh.querySelector('.h1'),su=q&&q.nextElementSibling,go=sh.querySelector('button.btn:not(.sec2)');if(!q||!su||!go)return;
 const i=Math.round(S.da*.08),row=(a,v)=>'<div style="display:flex;justify-content:space-between;gap:12px;min-height:38px;align-items:center;font-size:15px;border-top:0"><span class="mu">'+a+'</span><b style="text-align:right">'+v+'</b></div>';
 su.classList.remove('mu');su.style.margin='10px 0 12px';
 su.innerHTML=row('Locked until',fs(unl(Date.now())))+row('Interest paid now','+'+fmt(i)+' RWF')+row('Principal back on unlock',fmt(S.da)+' RWF')+'<div class="sm mu" style="padding-top:10px;border-top:0">You can\u2019t take the principal out before then.</div>';
 go.textContent='Lock '+fmt(S.da)+' RWF';go.style.whiteSpace='nowrap';const r2=go.parentElement;if(r2){r2.style.gridTemplateColumns='1fr 1.8fr';r2.style.display='grid'}};
const _d=depDo;
depDo=function(){_d.apply(this,arguments);if(S.dep&&!S.dep.t0)S.dep.t0=Date.now()};
const _b=screens.bank;
screens.bank=()=>{const h=_b();return S.lang==='en'&&S.dep?h.split(OLD).join(fs(cur())):h};
document.title='itunda, clickable prototype v189';
})();
/* v190: Foreign currency. Amount shortcuts (20K, 50K, 100K, 250K) instead of tapping + fifteen times; a review sheet before converting (you pay, you get, rate, fee, bank balance after) with a button that names the amount; wallets show their currency ("34.60 USD") and, when they hold money, a "Convert back to RWF" button with its own review. Fix: a conversion never appeared in Activity; it now does, in both directions (neither counts as a payment for your credit score). English only for the new copy; fr/rw keep the old screen. */
(function(){
const R=typeof FX!=='undefined'?Object.fromEntries(FX.map(f=>[f[0],f[2]])):{USD:1445,EUR:1680,GBP:1960};
const codes=Object.keys(R);
const row=(a,v)=>'<div style="display:flex;justify-content:space-between;gap:12px;min-height:40px;align-items:center;font-size:15px;border-top:0"><span class="mu">'+a+'</span><b style="text-align:right">'+v+'</b></div>';
const sheet=(title,rows,btn,fn)=>{$('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="h1" style="font-size:22px;line-height:30px;margin-top:4px">'+title+'</div><div style="margin:12px 0 20px">'+rows+'</div><div class="row2" style="display:grid;grid-template-columns:1fr 1.8fr"><button class="btn sec2" onclick="closeSheet()">Cancel</button><button class="btn" style="white-space:nowrap" onclick="'+fn+'">'+btn+'</button></div></div>';if(typeof focusSheet==='function')focusSheet()};
const _s=screens.fx;
screens.fx=()=>{let h=_s();if(S.lang!=='en')return h;const x=S.fx;
 const chips=[20000,50000,100000,250000].map(n=>'<button class="'+(x.a===n?'on':'')+'" onclick="fxAmt('+n+')">'+n/1000+'K</button>').join('');
 h=h.replace(/(<div style="text-align:center;padding:14px 0 0;font-size:20px">\u2193<\/div>)/,'<div class="req" style="padding:12px 24px 0">'+chips+'</div>$1');
 if(x.a<=S.bank)h=h.replace(/(No fee<\/div>)/,'$1<div class="sm mu" style="padding:6px 24px 0">itunda Bank after: '+fmt(S.bank-x.a)+' RWF</div>');
 h=h.replace(/(<span>[^<]*?(USD|EUR|GBP) wallet<\/span><b>)([\d.,]+)(<\/b><\/div>)/g,(m,a,c,v,z)=>a+v+' '+c+z+(x.w[c]>0?'<div style="padding:0 24px 12px"><button type="button" onclick="fxBack(\''+c+'\')" style="border:0;background:var(--tint);color:var(--tintfg);font-weight:700;font-size:13px;min-height:44px;padding:0 16px;border-radius:22px">Convert back to RWF</button></div>':''));
 return h};
window.fxAmt=n=>{S.fx.a=n;render('fade-none')};
const _g=window.fxGo;
window.fxGo=function(ok){const x=S.fx,c=codes[x.c],a=x.a;
 if(!ok&&S.lang==='en'&&a<=S.bank){sheet('Convert to '+c+'?',row('You pay',fmt(a)+' RWF')+row('You get',(a/R[c]).toFixed(2)+' '+c)+row('Rate','1 '+c+' = '+fmt(R[c])+' RWF')+row('Fee','None')+row('itunda Bank after',fmt(S.bank-a)+' RWF'),'Convert '+fmt(a)+' RWF','closeSheet();fxGo(1)');return}
 const r=_g.apply(this,arguments);if(a<=S.bank+a)addAct('cyc','Converted to '+c,'Converted',-a,'Moved');return r};
window.fxBack=function(c,ok){const w=S.fx.w[c];if(!(w>0))return;const rwf=Math.round(w*R[c]);
 if(!ok){sheet('Convert '+w.toFixed(2)+' '+c+' to RWF?',row('You convert',w.toFixed(2)+' '+c)+row('You get',fmt(rwf)+' RWF')+row('Rate','1 '+c+' = '+fmt(R[c])+' RWF')+row('Fee','None')+row('Goes to','itunda Bank'),'Convert to RWF',"closeSheet();fxBack('"+c+"',1)");return}
 S.fx.w[c]=0;S.bank+=rwf;addAct('cyc',c+' converted to RWF','Converted',rwf,'Moved');render('fade-none');toast(fmt(rwf)+' RWF added to itunda Bank')};
document.title='itunda, clickable prototype v190';
})();
/* v191: Ikimina. The pot said "80,000 RWF" even before you had paid, and "due Friday" / "on the 1st" were fixed words. It now shows what has been collected ("70,000 of 80,000 RWF", 7 of 8 paid, with a bar) and fills up to 8 of 8 when you contribute; the due day and payout day are real dates (next Friday, next 1st), also on the Bank "Coming up" row. Fix: "Contribute 10,000 RWF" took the money at once; it now asks first (group, amount, payout date, balance after) and the button names the amount. After you have paid, the page says when the pot is paid out. English only; fr/rw copy untouched. */
(function(){
const dFri=()=>{const d=new Date();d.setDate(d.getDate()+(5-d.getDay()+7)%7);return d};
const fri=()=>{const d=dFri();return d.toDateString()===new Date().toDateString()?'today':d.toLocaleDateString('en-GB',{weekday:'short',day:'numeric',month:'short'})};
const first=()=>{const n=new Date();return new Date(n.getFullYear(),n.getMonth()+1,1).toLocaleDateString('en-GB',{day:'numeric',month:'short'})};
const row=(a,v)=>'<div style="display:flex;justify-content:space-between;gap:12px;min-height:40px;align-items:center;font-size:15px;border-top:0"><span class="mu">'+a+'</span><b style="text-align:right">'+v+'</b></div>';
const _s=screens.ikim;
screens.ikim=()=>{let h=_s();if(S.lang!=='en')return h;const paid=S.ik?8:7,col=paid*10000;
 h=h.replace('<div class="big" style="margin-top:4px">80,000 RWF</div>','<div class="big" style="margin-top:4px">'+fmt(col)+' RWF</div>');
 h=h.replace('Pot this round \u00b7 10,000 RWF each \u00b7 due Friday','of 80,000 RWF \u00b7 10,000 RWF each \u00b7 due '+fri()+'</div><div style="height:8px;border-radius:4px;background:var(--chip);margin-top:14px"><div style="height:8px;border-radius:4px;background:var(--br);width:'+paid/8*100+'%;transition:width .4s"></div></div><div class="sm mu" style="margin-top:8px">'+paid+' of 8 members paid');
 h=h.replace('Eric M. on the 1st','Eric M. on '+first());
 if(S.ik)h=h.replace('Sample group for this prototype.','You\u2019re all set. The pot goes to Eric M. on '+first()+'. Sample group for this prototype.');
 return h};
const _p=ikPay;
ikPay=function(ok){if(ok||S.lang!=='en'||S.ik||S.bank<10000)return _p.apply(this,arguments);
 $('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="h1" style="font-size:22px;line-height:30px;margin-top:4px">Contribute to Umurenge Savers?</div><div style="margin:12px 0 20px">'+row('Contribution','10,000 RWF')+row('Due',fri())+row('This round goes to','Eric M. on '+first())+row('Paid from','itunda Bank')+row('Balance after',fmt(S.bank-10000)+' RWF')+'</div><div class="row2" style="display:grid;grid-template-columns:1fr 1.8fr"><button class="btn sec2" onclick="closeSheet()">Cancel</button><button class="btn" style="white-space:nowrap" onclick="closeSheet();ikPay(1)">Contribute 10,000 RWF</button></div></div>';
 if(typeof focusSheet==='function')focusSheet()};
const fix=()=>{if(S.lang!=='en')return;const ph=document.getElementById('phone');if(!ph)return;const w=document.createTreeWalker(ph,NodeFilter.SHOW_TEXT);let n;while(n=w.nextNode()){if(n.nodeValue.trim()==='Due Friday')n.nodeValue='Due '+fri()}};
let q=0;new MutationObserver(()=>{if(q)return;q=requestAnimationFrame(()=>{q=0;try{fix()}catch(e){}})}).observe(document.getElementById('phone'),{childList:true,subtree:true});
document.title='itunda, clickable prototype v191';
})();
</script>
<style id="v192">
/* v192: every search field looks like the Messages one: 44px, chip fill, 14px corners, 16px text, no icon */
#phone input[type=search]:not(.hs13),#phone .asr,#phone .msr,#phone .mps,#phone .px-in#pxq{box-sizing:border-box!important;height:44px!important;min-height:44px!important;border:0!important;border-radius:14px!important;background:var(--chip)!important;color:var(--tx)!important;font-size:16px!important;box-shadow:none!important}
#phone input[type=search]:not(.hs13){padding:0 14px!important;outline:none;-webkit-appearance:none;appearance:none}
#phone input[type=search]:not(.hs13)::-webkit-search-cancel-button{-webkit-appearance:none}
#phone .asr,#phone .msr,#phone .mps{padding:0 14px!important;gap:0!important;display:flex;align-items:center}
#phone .asr>svg,#phone .msr>svg,#phone .mps>svg{display:none!important}
#phone .asr input{font-size:16px!important}
#phone .xp .xs{background:var(--chip)!important}
/* same size: full width with 16px sides, 4px above and 8px below, like Messages */
#phone input[type=search]:not(.hs13){margin:4px 0 8px!important}
#phone .asr{margin:4px 16px 8px!important}
#phone .asr input{height:100%!important;margin:0!important}
#phone div:has(>input[type=search]:not(.hs13)):not(.v143q *){padding:0 16px!important;align-items:center}
#phone .v143q div:has(>input[type=search]:not(.hs13)):not(.v143q>div){padding:0!important}
#phone .msr,#phone .mps{margin:4px 16px 8px!important}
#phone div:has(>#emq){padding:0!important;margin:0 -8px!important}
/* Shop and Eats search pill */
#phone .top>div[style*="border-radius:14px"][style*="var(--chip)"]{height:44px!important}
#phone .top>div[style*="var(--chip)"]>svg{display:none!important}
#phone .top>div[style*="var(--chip)"],#phone .top>div[style*="var(--chip)"] input{font-size:16px!important}
/* Shop and Eats: search gets its own full-width row under the back and cart buttons */
#phone .top:has(>div[style*="var(--chip)"]){flex-wrap:wrap!important;justify-content:space-between!important;padding:12px 8px 0 8px!important}
#phone .top>div[style*="var(--chip)"]{order:3;flex:0 0 calc(100% - 16px)!important;margin:4px 8px 8px!important;box-sizing:border-box;padding:0 14px!important}
/* Bank: the Eats offer is a promo card, not a ledger row */
#phone .bdnew .pkg{display:none}
#phone .bdnew{padding:16px 16px 0}
#phone .bdnew .bdr{background:var(--tint);border-radius:16px;padding:14px 16px;gap:12px;align-items:center}
#phone .bdnew .bdr .ico{width:44px;height:44px;border-radius:22px;background:var(--bg,#fff);flex:none}
#phone .bdnew .bdr .t{text-wrap:balance;white-space:normal!important;overflow:visible!important;text-overflow:clip!important;font-size:16px;line-height:21px;font-weight:800}
#phone .bdnew .bdr .s{font-size:14px;margin-top:2px;color:var(--lk);font-weight:600}
#phone .bdnew .bdr:active{background:var(--chip)}
</style>
<style id="v193">
/* v193: tap targets, part 2. Chips, small tabs and icon buttons keep their look but get an invisible hit area of about 44px (set by the script below; areas stop short of neighbours). Explore: "Microloan" and "Down payment" were squeezed to "Micro…" next to long titles; in English the title now wraps and the label keeps its full width (fr/rw already show the hint under the title). */
#phone .v193h::after{content:"";position:absolute;inset:calc(var(--hy,0px)*-1) calc(var(--hx,0px)*-1)}
html:lang(en) #phone .xc .ar .t{flex:1 1 0;min-width:0;white-space:normal}
html:lang(en) #phone .xc .ar .s{flex:0 0 auto;margin-left:12px;white-space:nowrap}
</style>
<script>
/* v193 script: marks every visible control under 44px (not already given a hit area) with .v193h and sets how far its hit area extends. Runs after each render. */
(function(){
const SEL='button,a,[onclick],[role=button],.tap,.cch,.chip,.ocp,.go,.pkf,.ib,.sw,.qm,.mm-more';
function fix(){
 const ph=document.getElementById('phone');if(!ph)return;
 ph.querySelectorAll(SEL).forEach(el=>{
  if(el.dataset.h44||el.closest('.tabs'))return;
  const r=el.getBoundingClientRect();if(!r.width||!r.height)return;
  el.dataset.h44='1';
  if(r.height>=44&&r.width>=44)return;
  const cs=getComputedStyle(el);
  if(cs.pointerEvents==='none'||cs.display==='inline')return;
  if(getComputedStyle(el,'::after').content!=='none')return;
  if(cs.position==='static')el.style.position='relative';
  const hy=Math.min(12,Math.max(0,(44-r.height)/2)),hx=Math.min(4,Math.max(0,(44-r.width)/2));
  el.style.setProperty('--hy',hy+'px');el.style.setProperty('--hx',hx+'px');el.classList.add('v193h');
 });
}
/* A tight wrapper that clips (a row that scrolls sideways, a tab strip) also clips the hit area of its children, cutting a chip's 44px back to the wrapper's height. Wrappers get only the padding they are missing above and below, and take it back with negative margin: nothing moves, the hit area fits. */
function pad(){
 const ph=document.getElementById('phone');if(!ph)return;
 ph.querySelectorAll('.hit44a,.hit44b,.v193h').forEach(el=>{
  const er=el.getBoundingClientRect();if(!er.height||er.height>=44)return;
  const e=Math.min(12,(44-er.height)/2);
  let s=el.parentElement;
  while(s&&s!==ph){
   const cs=getComputedStyle(s);
   if(cs.overflowX!=='visible'||cs.overflowY!=='visible'){
    const sr=s.getBoundingClientRect();
    if(sr.height>120||s.dataset.h44s)break;
    s.dataset.h44s='1';
    const dT=Math.max(0,Math.ceil(e-(er.top-sr.top-parseFloat(cs.borderTopWidth)))),
          dB=Math.max(0,Math.ceil(e-(sr.bottom-parseFloat(cs.borderBottomWidth)-er.bottom)));
    if(dT||dB){
     s.style.boxSizing='border-box';
     s.style.height=(sr.height+dT+dB)+'px';
     s.style.paddingTop=(parseFloat(cs.paddingTop)+dT)+'px';
     s.style.paddingBottom=(parseFloat(cs.paddingBottom)+dB)+'px';
     s.style.marginTop=(parseFloat(cs.marginTop)-dT)+'px';
     s.style.marginBottom=(parseFloat(cs.marginBottom)-dB)+'px';
    }
    break;
   }
   s=s.parentElement;
  }
 });
}
let q=0;new MutationObserver(()=>{if(q)return;q=setTimeout(()=>{q=0;try{fix();pad()}catch(e){}},600)}).observe(document.getElementById('phone'),{childList:true,subtree:true});
try{fix();pad()}catch(e){}
document.title='itunda, clickable prototype v193';
})();
</script>
<style id="v194">
/* v194: Maps. Place: Depart and Arrive sit on one row and Share, Call and Follow on the next, so all five are visible (Call and Follow were off-screen in a sideways-scrolling row). Directions: the four travel modes share the width, so bike no longer runs off the edge. Search: each recent place has an icon that fits it (cafe, clinic, market, bus, address) instead of the same house for all. Place photos: the first was a house for a cafe, now a coffee cup, and the photos are named for screen readers. */
#phone .acts:has(>button:nth-child(5)):not(:has(>button:nth-child(6))){display:grid;grid-template-columns:repeat(6,1fr);gap:8px;overflow:visible}
#phone .acts:has(>button:nth-child(5)):not(:has(>button:nth-child(6)))>button{grid-column:span 2;flex:none;width:auto;min-width:0;padding:0 8px;white-space:nowrap}
#phone .acts:has(>button:nth-child(5)):not(:has(>button:nth-child(6)))>button:nth-child(-n+2){grid-column:span 3}
#phone .modes{overflow:visible;gap:4px}
#phone .modes>*{flex:1 1 0;min-width:0;padding-left:6px;padding-right:6px;justify-content:center}
</style>
<script>
(function(){
const ICON=[[/coffee|cafe|bakery|kitchen/i,'\u2615'],[/dental|clinic|hospital|pharmacy|health/i,'\ud83c\udfe5'],[/market|shop|mall|store/i,'\ud83d\uded2'],[/bus|stop|station/i,'\ud83d\ude8c'],[/\d/,'\ud83d\udccd']];
function fix(){
 const ph=document.getElementById('phone');if(!ph)return;
 ph.querySelectorAll('.pl').forEach(r=>{
  if(r.dataset.v194||!r.querySelector('button[aria-label=Remove]'))return;
  r.dataset.v194='1';
  const i=r.querySelector('i'),b=r.querySelector('b');if(!i||!b)return;
  const m=ICON.find(x=>x[0].test(b.textContent));if(!m)return;
  i.innerHTML='<span aria-hidden="true" style="font-size:20px;line-height:1">'+m[1]+'</span>';
 });
 const ph2=ph.querySelectorAll('.mcs>div[aria-label="Expand map"]');
 ph2.forEach((d,k)=>{if(d.dataset.v194)return;d.dataset.v194='1';if(d.textContent.trim()==='\ud83c\udfe0')d.textContent='\u2615';d.setAttribute('aria-label','Photo '+(k+1)+' of '+ph2.length)});
}
let q=0;new MutationObserver(()=>{if(q)return;q=requestAnimationFrame(()=>{q=0;try{fix()}catch(e){}})}).observe(document.getElementById('phone'),{childList:true,subtree:true});
try{fix()}catch(e){}
document.title='itunda, clickable prototype v194';
})();
</script>
<style id="v195">
/* v195: Maps. The category chips on the map (All, Cafe, Food, Bus stops, Hospital, Pharmacy, ATM) were squeezed into a 24px sliver, so only the edge of "All" showed and the filters could not be used. The Money screen's .mvc rule (a 3px line) was also applying to the map's chip row; the row now spans the screen and scrolls sideways again. */
#phone .mcs.mvc{width:auto;height:auto;background:none;border-radius:0;padding:1px 12px;gap:8px}
</style>
<script>document.title='itunda, clickable prototype v195';</script>
<style id="v196">
/* v196: Maps. Place map: "Office Suites" ran off the right edge, "Bus stop" sat under its blue dot, and a blue dot cut through the cafe's name; the three labels are moved clear. French and Kinyarwanda: the map category chips, "Bus stop", the Directions route cards ("Best", "305 + 1 transfer", "Route 311", "Stop 1") and the "Photo 1 of 3" labels were still English. New fr/rw strings need native review. */
</style>
<script>
(function(){
const FR={'\u2615 Cafe':'\u2615 Caf\u00e9','\ud83c\udf7d\ufe0f Food':'\ud83c\udf7d\ufe0f Restos','\ud83d\ude8c Bus stops':'\ud83d\ude8c Arr\u00eats de bus','\ud83c\udfe5 Hospital':'\ud83c\udfe5 H\u00f4pital','\ud83d\udc8a Pharmacy':'\ud83d\udc8a Pharmacie','\ud83c\udfe7 ATM':'\ud83c\udfe7 Distributeur','Bus stop \u00b7 305, 311':'Arr\u00eat de bus \u00b7 305, 311','Cafe, Dessert \u00b7 Avis 495':'Caf\u00e9, Desserts \u00b7 Avis 495','\ud83d\ude8c Best':'\ud83d\ude8c Meilleur','305 + 1 transfer':'305 + 1 correspondance','Route 311':'Ligne 311'};
const RW={'\u2615 Cafe':'\u2615 Caf\u00e9','\ud83c\udf7d\ufe0f Food':'\ud83c\udf7d\ufe0f Ibiryo','\ud83d\ude8c Bus stops':'\ud83d\ude8c Aho bisi zihagarara','\ud83c\udfe5 Hospital':'\ud83c\udfe5 Ibitaro','\ud83d\udc8a Pharmacy':'\ud83d\udc8a Farumasi','Bus stop \u00b7 305, 311':'Aho bisi zihagarara \u00b7 305, 311','\ud83d\ude8c Best':'\ud83d\ude8c Nziza','305 + 1 transfer':'305 + guhindura 1','Route 311':'Inzira 311'};
const STOP={fr:'Arr\u00eat ',rw:'Ahagarara '};
const PH={fr:(k,n)=>'Photo '+k+' sur '+n,rw:(k,n)=>'Ifoto '+k+' kuri '+n};
function fix(){
 const ph=document.getElementById('phone');if(!ph)return;
 const lang=(typeof S!=='undefined'&&S.lang)||'en';
 const svg=ph.querySelector('svg[aria-label="Map of the cafe area"]');
 if(svg&&!svg.dataset.v196){svg.dataset.v196='1';
  svg.querySelectorAll('text').forEach(t=>{const s=t.textContent.trim();
   if(s==='Office Suites')t.setAttribute('x','250');
   else if(s==='Bus stop')t.setAttribute('x','142');
   else if(s==='Nyamirambo Coffee House')t.setAttribute('y','128')})}
 if(lang!=='fr'&&lang!=='rw')return;
 const D=lang==='fr'?FR:RW;
 const w=document.createTreeWalker(ph,NodeFilter.SHOW_TEXT);let n;
 while(n=w.nextNode()){const v=n.nodeValue.trim();if(!v)continue;
  if(D[v]){n.nodeValue=n.nodeValue.replace(v,D[v]);continue}
  const m=/^Stop (\d+)$/.exec(v);if(m)n.nodeValue=n.nodeValue.replace(v,STOP[lang]+m[1]);
  else{const m2=/^Stop (\d{5})$/.exec(v);if(m2)n.nodeValue=n.nodeValue.replace(v,STOP[lang]+m2[1])}}
 const ps=ph.querySelectorAll('.mcs>div[aria-label^="Photo "]');
 ps.forEach((d,k)=>d.setAttribute('aria-label',PH[lang](k+1,ps.length)));
}
let q=0;new MutationObserver(()=>{if(q)return;q=requestAnimationFrame(()=>{q=0;try{fix()}catch(e){}})}).observe(document.getElementById('phone'),{childList:true,subtree:true});
try{fix()}catch(e){}
document.title='itunda, clickable prototype v196';
})();
</script>
<style id="v197">
/* v197: Maps. The "Press and hold the map to drop a pin" hint is a toast that outlived the map: it appeared over the search bar, the Place page and the Directions start field (hiding "Your location"). It now disappears when you leave the map, and on the map it sits below the filter chips instead of on top of them. Map pins show their names (respecting the Place names layer switch), but only the ones that fit: at most 5 at the default zoom, none that collide with neighbourhood names, the buttons, the scale bar, the sheet or the chips, and when zoomed far out the pins become plain dots. Place map: the cafe pin was cut off under the header; it now sits in clear map space and its name has a halo so it reads over roads and blocks. */
#phone .toast.mphint{top:122px;bottom:auto;left:16px;right:16px;padding:10px 16px;border-radius:14px;font-size:13px;text-align:center;pointer-events:none}
</style>
<script>
(function(){
const HINTS=['Press and hold the map to drop a pin','Fata igihe ku ikarita ushyireho ikimenyetso','Appuyez longuement sur la carte pour placer un rep\u00e8re'];
function fix(){
 const ph=document.getElementById('phone');if(!ph)return;
 const top=(typeof S!=='undefined'&&S.stack&&S.stack[S.stack.length-1])||'';
 ph.querySelectorAll('.toast').forEach(t=>{
  if(HINTS.indexOf(t.textContent.trim())<0)return;
  if(top!=='mapview'){t.remove();return}
  t.classList.add('mphint');t.style.top='122px';t.style.bottom='auto'});
 const svg=ph.querySelector('svg[aria-label="Map of the cafe area"]');
 if(svg&&!svg.dataset.v197){svg.dataset.v197='1';
  const g=Array.from(svg.querySelectorAll('g')).find(x=>x.getAttribute('transform')==='translate(150 104)');
  if(g)g.setAttribute('transform','translate(138 152)');
  Array.from(svg.querySelectorAll('text')).forEach(t=>{
   if(t.textContent.trim()==='Nyamirambo Coffee House'){
    t.setAttribute('x','152');t.setAttribute('y','148');t.setAttribute('font-size','11');
    t.setAttribute('stroke','var(--chip)');t.setAttribute('stroke-width','3.5');
    t.setAttribute('stroke-linejoin','round');t.setAttribute('paint-order','stroke')}})}
}
let q=0;new MutationObserver(()=>{if(q)return;q=requestAnimationFrame(()=>{q=0;try{fix()}catch(e){}})}).observe(document.getElementById('phone'),{childList:true,subtree:true});
try{fix()}catch(e){}
/* pin names: the pin layer is rebuilt on every pan/zoom frame, so labels are added synchronously (microtask, before paint) to avoid flicker */
function pinLabels(){
 const ph=document.getElementById('phone');if(!ph)return;
 const m=(typeof S!=='undefined'&&S.mp)||{},z=m.z||1,off=m.nolab;
 ph.querySelectorAll('g[onclick^="mpPin("]:not([data-lb])').forEach(g=>{
  g.dataset.lb='1';
  const tx=g.querySelectorAll('text');
  if(tx.length>1){ /* the map's own name (drawn when zoomed in): selected pin keeps it, others join the declutter pass */
   const id=((g.getAttribute('onclick')||'').match(/mpPin\('([^']+)'/)||[])[1];
   if(id!==m.sel)Array.from(tx).slice(1).forEach(x=>{x.dataset.nl='1'});
   if(z>=0.75)return}
  if(z<0.75){ /* zoomed far out: plain dots, no icons or names */
   const cs=g.querySelectorAll('circle');
   g.querySelectorAll('text').forEach(x=>{x.style.display='none'});
   if(cs[0])cs[0].setAttribute('cy','-7');
   if(cs[1]){cs[1].setAttribute('r','7');cs[1].setAttribute('cy','-7');cs[1].setAttribute('stroke-width','2')}
   return}
  if(off)return;
  let n=(g.getAttribute('aria-label')||'').trim();if(!n)return;
  if(n.length>18)n=n.slice(0,17)+'\u2026';
  const t=document.createElementNS('http://www.w3.org/2000/svg','text');
  t.setAttribute('y','14');t.setAttribute('font-size','11');t.setAttribute('font-weight','800');
  t.setAttribute('text-anchor','middle');t.setAttribute('fill','var(--tx)');
  t.setAttribute('stroke','var(--chip)');t.setAttribute('stroke-width','3.5');
  t.setAttribute('stroke-linejoin','round');t.setAttribute('paint-order','stroke');
  t.setAttribute('pointer-events','none');t.setAttribute('aria-hidden','true');
  t.textContent=n;g.appendChild(t)});
 /* declutter: a name is shown only if it fits. Budget by zoom (5 nearest the centre at the default zoom, all when zoomed in);
    names yield to the neighbourhood names, the map buttons, the scale bar, the bottom sheet and the chip row. */
 const L=Array.from(ph.querySelectorAll('g[onclick^="mpPin("] text[aria-hidden],g[onclick^="mpPin("] text[data-nl]'));
 if(!L.length)return;
 L.forEach(t=>{t.style.display=''});
 const budget=z<1.2?5:99;
 const pr=ph.getBoundingClientRect(),surf=ph.querySelector('.fmsurf'),sr=surf?surf.getBoundingClientRect():pr;
 const cx=sr.left+sr.width/2,cy=sr.top+sr.height*.4;
 let minY=0,maxY=pr.bottom;
 const chips=ph.querySelector('.fmap .mcs');if(chips)minY=chips.getBoundingClientRect().bottom+4;
 const fmb=ph.querySelector('.fmb');
 const obs=[];
 if(fmb){
  fmb.querySelectorAll('*').forEach(e=>{const r=e.getBoundingClientRect();
   if(!r.width||!r.height)return;
   if(r.bottom>=pr.bottom-2&&r.height>100&&r.width>300){if(r.top<maxY)maxY=r.top}
   else if(e.tagName==='BUTTON'||e.id==='fmsc')obs.push(r)})}
 ph.querySelectorAll('#fmov > text').forEach(t=>{const r=t.getBoundingClientRect();if(r.width)obs.push(r)});
 let shown=0;const seen=[];
 L.map(t=>{const r=t.getBoundingClientRect(),g=t.parentNode.getBoundingClientRect();
   return [t,r,Math.hypot(g.left+g.width/2-cx,g.top+g.height/2-cy)]}).sort((a,b)=>a[2]-b[2]).forEach(([t,r])=>{
  const hit=shown>=budget||r.top<minY||r.bottom>maxY-2||r.left<4||r.right>pr.right-4||
   obs.some(o=>r.left<o.right+2&&r.right>o.left-2&&r.top<o.bottom+1&&r.bottom>o.top-1)||
   seen.some(o=>r.left<o.right+3&&r.right>o.left-3&&r.top<o.bottom+2&&r.bottom>o.top-2);
  t.style.display=hit?'none':'';if(!hit){seen.push(r);shown++}})}
new MutationObserver(()=>{try{pinLabels()}catch(e){}}).observe(document.getElementById('phone'),{childList:true,subtree:true});
try{pinLabels()}catch(e){}
document.title='itunda, clickable prototype v197';
})();
</script>
<script>
/* v198: SACCO shares. The old Buy 1 / Buy 5 buttons opened a one-line \"Confirm your purchase\" sheet; the review is now a full one (shares, price, you pay, balance after, dividend, when it can be withdrawn) and its button names the shares. New: \"How many shares?\" with 1, 2, 5 and 10 to pick from, a live line under them (cost, dividend per year, balance after), and a plain reason when the bank balance is too low (the buttons were just greyed out). \"Withdrawals: At year end\" is now a real date. After buying, the page says what you own and when it unlocks. English only; fr/rw copy untouched. */
(function(){
const R=(a,v)=>'<div style="display:flex;justify-content:space-between;gap:12px;min-height:40px;align-items:center;font-size:15px;border-top:0"><span class="mu">'+a+'</span><b style="text-align:right">'+v+'</b></div>';
const yEnd=()=>{const n=new Date(),y=new Date(n.getFullYear(),11,31);return y.toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric'})};
const PR=5000,OPTS=[1,2,5,10];
const sh=n=>n+' share'+(n>1?'s':'');
const _s=screens.sacco,_b=buySh;
S.shn=1;
screens.sacco=()=>{if(S.lang!=='en')return _s();
 const v=S.sh*PR,n=S.shn||1,cost=n*PR,low=S.bank<cost,after=S.bank-cost,div=Math.round(cost*.06);
 const chips=OPTS.map(k=>'<button class="chip'+(k===n?' on':'')+'" aria-pressed="'+(k===n)+'" onclick="shPick('+k+')" style="min-width:56px;height:44px;border-radius:22px;border:0;font-size:16px;font-weight:800;background:'+(k===n?'var(--tx)':'var(--chip)')+';color:'+(k===n?'var(--bg)':'var(--tx)')+'">'+k+'</button>').join('');
 const line=low?'<span style="color:var(--er)">'+sh(n)+' costs '+fmt(cost)+' RWF. Your bank balance is '+fmt(S.bank)+' RWF. Pick fewer shares or add money first.</span>':'<b style="color:var(--tx)">'+fmt(cost)+' RWF</b> from itunda Bank · adds about '+fmt(div)+' RWF a year in dividend · balance after '+fmt(after)+' RWF';
 return bar('SACCO shares')+'<div class="pad" style="padding-top:28px"><div class="sm mu">Your shares</div><div class="big" style="margin-top:4px">'+S.sh+' <span style="font-size:20px;letter-spacing:0">('+fmt(v)+' RWF)</span></div>'+
 '<div class="sm" style="margin-top:8px;font-weight:700;color:var(--ok)">Estimated dividend: '+fmt(Math.round(v*.06))+' RWF a year</div>'+
 (S.sh?'<div class="sm mu" style="margin-top:6px">Your shares unlock on '+yEnd()+'.</div>':'')+
 '<div class="mu" style="font-size:15px;margin-top:16px;line-height:22px">Own a part of your cooperative. Each share is 5,000 RWF and earns a dividend when the SACCO makes a surplus.</div></div>'+
 '<div class="pad" style="padding-top:28px"><div style="font-size:16px;font-weight:800">How many shares?</div><div style="display:flex;gap:10px;margin-top:12px" role="group" aria-label="Number of shares">'+chips+'</div><div class="sm mu" style="margin-top:14px;line-height:20px" aria-live="polite">'+line+'</div></div>'+
 '<div style="margin:24px 24px 0;padding:4px 20px;border-radius:20px;background:var(--chip)">'+
 '<div style="display:flex;justify-content:space-between;height:52px;align-items:center;font-size:15px"><span class="mu">Share price</span><b>5,000 RWF</b></div>'+
 '<div style="display:flex;justify-content:space-between;height:52px;align-items:center;font-size:15px;border-top:0"><span class="mu">Dividend (sample)</span><b>6% a year</b></div>'+
 '<div style="display:flex;justify-content:space-between;height:52px;align-items:center;font-size:15px;border-top:0"><span class="mu">Withdrawals</span><b>'+yEnd()+'</b></div></div>'+
 '<div class="pad fine" style="padding-top:20px">Sample dividend and terms for this prototype.</div>'+
 '<div class="cta"><button class="btn" style="height:52px;font-size:16px;border-radius:16px;white-space:nowrap" '+(low?'disabled':'')+' onclick="shReview()">Buy '+sh(n)+' ('+fmt(cost)+' RWF)</button></div>'};
window.shPick=k=>{S.shn=k;render('fade-none')};
window.shReview=()=>{const n=S.shn||1,cost=n*PR;if(S.bank<cost)return;
 $('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="h1" style="font-size:22px;line-height:30px;margin-top:4px">Buy '+sh(n)+'?</div><div style="margin:12px 0 20px">'+R('Shares',n+' × 5,000 RWF')+R('You pay',fmt(cost)+' RWF')+R('Paid from','itunda Bank')+R('Balance after',fmt(S.bank-cost)+' RWF')+R('Dividend (sample)','About '+fmt(Math.round(cost*.06))+' RWF a year')+R('Can be withdrawn',yEnd())+'</div><div class="row2" style="display:grid;grid-template-columns:1fr 1.8fr"><button class="btn sec2" onclick="closeSheet()">Cancel</button><button class="btn" style="white-space:nowrap" onclick="closeSheet();shBuy('+n+')">Buy '+sh(n)+'</button></div></div>';
 if(typeof focusSheet==='function')focusSheet()};
window.shBuy=n=>{if(S.bank<n*PR)return;_b(n,1);S.shn=1;render('fade-none');toast('You now own '+sh(S.sh))};
document.title='itunda, clickable prototype v198';
})();
</script>
<script>
/* v199: Cash out. Fix: "Cash out" never took the money (your Pay balance stayed the same, nothing showed in Activity) and had no review; it now asks first (amount, where it goes, fee, when it arrives, Pay balance after), takes the money, adds a "Cash out" row to Activity, and the done sheet says what your Pay balance is now. New: your itunda Pay balance on the page, 5,000 / 10,000 / 20,000 / 50,000 shortcuts instead of tapping + up to 49 times, a "Send to" label over the two mobile money numbers, the per-cash-out limit, a plain message when the amount is more than your balance, and a button that names the amount ("Cash out 5,000 RWF"). English only; fr/rw copy untouched. */
(function(){
const R=(a,v)=>'<div style="display:flex;justify-content:space-between;gap:12px;min-height:40px;align-items:center;font-size:15px;border-top:0"><span class="mu">'+a+'</span><b style="text-align:right">'+v+'</b></div>';
const TO=['MTN MoMo \u2022\u20220788','Airtel Money \u2022\u20220732'],AM=[5000,10000,20000,50000],MAX=50000;
const cs=()=>S.sv2.cashout=S.sv2.cashout||{a:5000,tm:0,o:0};
const _s=screens.svc;
screens.svc=()=>{let h=_s();if(S.lang!=='en'||S.svk!=='cashout')return h;
 const s=cs(),bad=s.a>S.pay;
 const sc='<div style="padding:14px 24px 0"><div style="display:flex;gap:10px;flex-wrap:wrap" role="group" aria-label="Amount shortcuts">'+AM.map(v=>'<button class="chip" aria-pressed="'+(v===s.a)+'" onclick="coPick('+v+')" style="min-width:64px;height:44px;border-radius:22px;border:0;padding:0 14px;font-size:15px;font-weight:800;background:'+(v===s.a?'var(--tx)':'var(--chip)')+';color:'+(v===s.a?'var(--bg)':'var(--tx)')+'">'+fmt(v)+'</button>').join('')+'</div>'+
 '<div class="sm" style="margin-top:12px;line-height:20px" aria-live="polite">'+(bad?'<span style="color:var(--er)">This is more than your itunda Pay balance of '+fmt(S.pay)+' RWF. Pick a smaller amount.</span>':'<span class="mu">itunda Pay balance: <b style="color:var(--tx)">'+fmt(S.pay)+' RWF</b> \u00b7 left after: '+fmt(S.pay-s.a)+' RWF</span>')+'</div></div>'+
 '<div style="font-size:16px;font-weight:800;padding:22px 24px 0">Send to</div>';
 h=h.replace('<div class="chp" style="padding:14px 24px 0">',sc+'<div class="chp" style="padding:10px 24px 0">');
 h=h.replace('<div style="height:100px"></div>','<div class="pad sm mu" style="padding-top:14px">Limit: '+fmt(MAX)+' RWF for each cash out.</div><div style="height:100px"></div>');
 h=h.replace('onclick="svcGo()">Cash out</button>',(bad?'disabled ':'')+'onclick="svcGo()" style="white-space:nowrap">Cash out '+fmt(s.a)+' RWF</button>');
 return h};
window.coPick=v=>{cs().a=v;render('fade-none')};
const _g=window.svcGo;
window.svcGo=function(ok){if(S.lang!=='en'||S.svk!=='cashout')return _g.apply(this,arguments);
 const s=cs(),a=s.a,to=TO[s.o]||TO[0];
 if(a>S.pay)return;
 if(ok===1){S.pay-=a;addAct('coin','Cash out \u00b7 '+to,'Sent',-a,'Sent');render('fade-none');
  $('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="g3" style="font-size:56px;line-height:1;margin-bottom:10px">\u2705</div><div class="h1" style="font-size:22px;line-height:30px">Cash out requested</div><div class="mu" style="font-size:15px;margin:8px 0 8px;line-height:22px">'+fmt(a)+' RWF is on its way to '+to+'. It should arrive within a minute.</div><div style="font-weight:800;margin-bottom:24px">itunda Pay balance now '+fmt(S.pay)+' RWF</div><button class="btn" onclick="closeSheet()">OK</button></div>';
  if(typeof focusSheet==='function')focusSheet();return}
 $('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="h1" style="font-size:22px;line-height:30px;margin-top:4px">Cash out '+fmt(a)+' RWF?</div><div style="margin:12px 0 20px">'+R('Amount',fmt(a)+' RWF')+R('Send to',to)+R('Fee','Free')+R('Arrives','Within a minute')+R('Paid from','itunda Pay')+R('Pay balance after',fmt(S.pay-a)+' RWF')+'</div><div class="row2" style="display:grid;grid-template-columns:1fr 1.8fr"><button class="btn sec2" onclick="closeSheet()">Cancel</button><button class="btn" style="white-space:nowrap" onclick="svcGo(1)">Cash out '+fmt(a)+' RWF</button></div></div>';
 if(typeof focusSheet==='function')focusSheet()};
document.title='itunda, clickable prototype v199';
})();
</script>
<script>
/* v200: Auto top-up. Before: the page said "Refill when balance is below" without saying which balance, "Refill amount: Same as the threshold" and "Linked MoMo account" (which one?), and "Turn on auto top-up" only showed a message: reopen the page and it was off again, with no way to turn it off. Now: three plain questions in order ("Refill when itunda Pay is below", "Add this much", "Take it from") with taps instead of +/- and the real MTN and Airtel numbers; one sentence that updates as you choose ("When your itunda Pay balance drops below 10,000 RWF, we add 20,000 RWF from MTN MoMo \u2022\u20220788"); a review before it turns on; it stays on when you come back, shows its status, and can be changed ("Save changes") or turned off (with a confirmation). English only; fr/rw copy untouched. */
(function(){
const R=(a,v)=>'<div style="display:flex;justify-content:space-between;gap:12px;min-height:40px;align-items:center;font-size:15px;border-top:0"><span class="mu">'+a+'</span><b style="text-align:right">'+v+'</b></div>';
const TH=[5000,10000,20000,50000],AMT=[10000,20000,50000],SRC=['MTN MoMo \u2022\u20220788','Airtel Money \u2022\u20220732'];
S.atu=S.atu||{on:false,th:10000,amt:20000,o:0};
const D=()=>S.atuD=S.atuD||Object.assign({},S.atu);
const sent=d=>'When your itunda Pay balance drops below '+fmt(d.th)+' RWF, we add '+fmt(d.amt)+' RWF from '+SRC[d.o]+'.';
const chips=(arr,cur,fn)=>'<div style="display:flex;gap:10px;flex-wrap:wrap;padding:10px 24px 0" role="group">'+arr.map(v=>'<button class="chip" aria-pressed="'+(v===cur)+'" onclick="'+fn+'('+v+')" style="min-width:64px;height:44px;border-radius:22px;border:0;padding:0 14px;font-size:15px;font-weight:800;background:'+(v===cur?'var(--tx)':'var(--chip)')+';color:'+(v===cur?'var(--bg)':'var(--tx)')+'">'+fmt(v)+'</button>').join('')+'</div>';
const lab=(t,s)=>'<div style="padding:22px 24px 0"><div style="font-size:16px;font-weight:800">'+t+'</div>'+(s?'<div class="sm mu" style="margin-top:4px">'+s+'</div>':'')+'</div>';
const _s=screens.svc,_o=window.openSvc;
window.openSvc=function(k){if(k==='atu')S.atuD=Object.assign({},S.atu);return _o.apply(this,arguments)};
screens.svc=()=>{if(S.lang!=='en'||S.svk!=='atu')return _s();
 const d=D(),a=S.atu,dirty=d.th!==a.th||d.amt!==a.amt||d.o!==a.o;
 const status=a.on?'<div style="margin:18px 24px 0;padding:14px 16px;border-radius:16px;background:var(--tint);color:var(--tintfg);font-size:14px;line-height:20px"><b>Auto top-up is on.</b> '+sent(a)+'</div>':'';
 const src=SRC.map((n,i)=>'<div class="row tap" role="radio" aria-checked="'+(d.o===i)+'" tabindex="0" onclick="atuPick(\'o\','+i+')" style="padding:12px 24px;'+(d.o===i?'background:var(--tint)':'')+'"><div style="width:22px;height:22px;border-radius:11px;border:2px solid '+(d.o===i?'var(--lk)':'var(--ln)')+';display:flex;align-items:center;justify-content:center">'+(d.o===i?'<div style="width:10px;height:10px;border-radius:5px;background:var(--lk)"></div>':'')+'</div><div class="t">'+n+'</div></div>').join('');
 const cta=a.on?'<div class="cta"><div style="display:grid;grid-template-columns:1fr 1.6fr;gap:12px"><button class="btn sec2" onclick="atuOff()">Turn off</button><button class="btn" '+(dirty?'':'disabled')+' onclick="atuReview()">Save changes</button></div></div>':'<div class="cta"><button class="btn" onclick="atuReview()">Turn on auto top-up</button></div>';
 return bar('Auto top-up')+'<div style="padding:22px 24px 0"><div style="width:72px;height:72px;border-radius:36px;background:var(--tint);display:flex;align-items:center;justify-content:center;font-size:36px">\ud83d\udd01</div><div class="h1" style="margin-top:16px">Auto top-up</div><div class="mu" style="font-size:15px;line-height:22px;margin-top:8px">Never run out of itunda Pay money. Your balance now: <b style="color:var(--tx)">'+fmt(S.pay)+' RWF</b>.</div></div>'+status+
 lab('Refill when itunda Pay is below')+chips(TH,d.th,'atuTh')+
 lab('Add this much')+chips(AMT,d.amt,'atuAmt')+
 lab('Take it from')+'<div role="radiogroup" style="padding-top:6px">'+src+'</div>'+
 '<div style="margin:22px 24px 0;padding:14px 16px;border-radius:16px;background:var(--chip);font-size:15px;line-height:22px" aria-live="polite">'+sent(d)+' No fee.</div><div class="pad fine" style="padding-top:14px">Sample terms for this prototype.</div><div style="height:100px"></div>'+cta};
window.atuPick=(f,v)=>{D()[f]=v;render('fade-none')};
window.atuTh=v=>atuPick('th',v);window.atuAmt=v=>atuPick('amt',v);
window.atuReview=()=>{const d=D(),on=S.atu.on;
 $('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="h1" style="font-size:22px;line-height:30px;margin-top:4px">'+(on?'Save changes?':'Turn on auto top-up?')+'</div><div style="margin:12px 0 20px">'+R('Refill when below',fmt(d.th)+' RWF')+R('Add',fmt(d.amt)+' RWF')+R('Take it from',SRC[d.o])+R('Refills','itunda Pay')+R('Fee','Free')+'</div><div class="row2" style="display:grid;grid-template-columns:1fr 1.8fr"><button class="btn sec2" onclick="closeSheet()">Cancel</button><button class="btn" style="white-space:nowrap" onclick="atuSave()">'+(on?'Save changes':'Turn on')+'</button></div></div>';
 if(typeof focusSheet==='function')focusSheet()};
window.atuSave=()=>{const was=S.atu.on;S.atu=Object.assign({},D(),{on:true});S.atuD=Object.assign({},S.atu);closeSheet();render('fade-none');toast(was?'Changes saved':'Auto top-up is on')};
window.atuOff=()=>{$('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="h1" style="font-size:22px;line-height:30px;margin-top:4px">Turn off auto top-up?</div><div class="mu" style="font-size:15px;margin:8px 0 24px;line-height:22px">We will stop adding money when your itunda Pay balance is low. Your saved choices are kept for next time.</div><div class="row2" style="display:grid;grid-template-columns:1fr 1.8fr"><button class="btn sec2" onclick="closeSheet()">Keep it on</button><button class="btn" style="white-space:nowrap" onclick="atuOffGo()">Turn off</button></div></div>';
 if(typeof focusSheet==='function')focusSheet()};
window.atuOffGo=()=>{S.atu.on=false;S.atuD=Object.assign({},S.atu);closeSheet();render('fade-none');toast('Auto top-up is off')};
document.title='itunda, clickable prototype v200';
})();
</script>
<script>
/* v201: Harvest advance, VUP microloan and Student loan. Before: tap + up to 28 times to reach an amount, no total to repay, "Needs: Cooperative ID" and "Level: Undergraduate 11%, postgraduate 12%" were just text (nothing asked for the ID and the rate never changed), "Apply" sent at once, and after sending you could apply again. Now: amount shortcuts; "Repay over" label; interest and total to repay under the monthly payment; Student loan asks "Undergraduate 11%" or "Postgraduate 12%" and the payment follows; Harvest advance asks for your cooperative ID (Apply stays off, with a line saying why, until it is filled in); a review before sending (amount, months, payment, total, rate, what happens next) with a button that names the amount; after sending the page shows "Application sent" with the reference and the next step, and the button stays off. English only; fr/rw copy untouched. */
(function(){
const K={harvest:{t:[4,6,8],r:12,sc:[200000,500000,1000000,2000000],nx:'Your cooperative confirms your membership, then we release the funds.',what:'advance'},
 vup:{t:[6,12,18],r:2,sc:[50000,150000,300000,500000],nx:'Your sector office will contact you to confirm eligibility.',what:'microloan'},
 student:{t:[12,24,36],r:11,sc:[500000,1000000,2000000,3000000],nx:'Upload your admission letter in the next step.',what:'student loan'}};
const R=(a,v)=>'<div style="display:flex;justify-content:space-between;gap:12px;min-height:40px;align-items:center;font-size:15px;border-top:0"><span class="mu">'+a+'</span><b style="text-align:right">'+v+'</b></div>';
const esc=x=>String(x).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const short=v=>v>=1e6?v/1e6+'M':v/1e3+'K';
const st=k=>S.sv2[k]=S.sv2[k]||{a:0,tm:0,o:0};
S.apps=S.apps||{};
const rate=(k,s)=>k==='student'?(s.lv?12:11):K[k].r;
const calc=(k,s)=>{const n=K[k].t[s.tm||0],i=rate(k,s)/1200,P=s.a,mo=i?P*i/(1-Math.pow(1+i,-n)):P/n;return{n,mo:Math.round(mo),tot:Math.round(mo*n),int:Math.round(mo*n-P),r:rate(k,s)}};
const lab=t=>'<div style="font-size:16px;font-weight:800;padding:22px 24px 0">'+t+'</div>';
const chipB=(on,fn,txt,al)=>'<button class="chip" aria-pressed="'+on+'" '+(al?'aria-label="'+al+'" ':'')+'onclick="'+fn+'" style="min-width:64px;height:44px;border-radius:22px;border:0;padding:0 14px;font-size:15px;font-weight:800;background:'+(on?'var(--tx)':'var(--chip)')+';color:'+(on?'var(--bg)':'var(--tx)')+'">'+txt+'</button>';
const cidOk=s=>(s.cid||'').trim().length>=4;
const _s=screens.svc;
screens.svc=()=>{const k=S.svk;let h=_s();if(S.lang!=='en'||!K[k])return h;
 const s=st(k),c=K[k],q=calc(k,s),app=S.apps[k],need=k==='harvest'&&!cidOk(s);
 let blk='<div style="padding:14px 24px 0"><div style="display:flex;gap:10px;flex-wrap:wrap" role="group" aria-label="Amount shortcuts">'+c.sc.map(v=>chipB(v===s.a,'svcSet(\'a\','+(v-s.a)+')',short(v),fmt(v)+' RWF')).join('')+'</div></div>';
 if(k==='student')blk+=lab('Your level')+'<div style="display:flex;gap:10px;flex-wrap:wrap;padding:10px 24px 0" role="group">'+chipB(!s.lv,'apLv(0)','Undergraduate 11%')+chipB(!!s.lv,'apLv(1)','Postgraduate 12%')+'</div>';
 if(k==='harvest')blk+=lab('Your cooperative ID')+'<div style="padding:10px 24px 0"><input id="apCid" value="'+esc(s.cid||'')+'" oninput="apCid(this.value)" autocomplete="off" aria-describedby="apH" placeholder="Type the ID on your membership card" style="width:100%;height:48px;border:0;border-radius:14px;background:var(--chip);color:var(--tx);padding:0 16px;font:inherit;font-size:16px"><div id="apH" class="sm mu" style="margin-top:8px">'+(need?(s.cid?'Keep typing, at least 4 characters.':'Your cooperative gives you this ID.'):'Looks good.')+'</div></div>';
 blk+=lab('Repay over');
 h=h.replace('<div class="chp" style="padding:14px 24px 0">',blk+'<div class="chp" style="padding:10px 24px 0">');
 h=h.replace(/Monthly payment<\/span><b>[^<]*<\/b><\/div>/,(k==='student'?'Monthly payment (after you graduate)':'Monthly payment')+'</span><b>'+fmt(q.mo)+' RWF</b></div><div style="margin:8px 24px 0;display:flex;justify-content:space-between;font-size:15px"><span class="mu">Interest ('+q.r+'% a year)</span><b>'+fmt(q.int)+' RWF</b></div><div style="margin:8px 24px 0;display:flex;justify-content:space-between;font-size:15px"><span class="mu">Total to repay</span><b>'+fmt(q.tot)+' RWF</b></div>');
 if(k==='student')h=h.replace(/<div style="display:flex;justify-content:space-between;gap:16px;padding:14px 24px;border-top:0;font-size:15px"><span class="mu">Level<\/span>.*?<\/div>/,'');
 if(app)h=h.replace('<div style="margin-top:18px">','<div style="margin:18px 24px 0;padding:14px 16px;border-radius:16px;background:var(--tint);color:var(--tintfg);font-size:14px;line-height:20px"><b>Application sent.</b> Reference '+app.ref+' \u00b7 '+fmt(app.a)+' RWF. '+c.nx+'</div><div style="margin-top:18px">');
 const btn=app?'<button class="btn" disabled style="white-space:nowrap">Application sent</button>':'<button class="btn" id="apGo" '+(need?'disabled ':'')+'onclick="svcGo()" style="white-space:nowrap">Apply for '+fmt(s.a)+' RWF</button>'+(k==='harvest'?'<div id="apW" class="sm mu" style="text-align:center;margin-top:8px">'+(need?'Enter your cooperative ID to apply.':'')+'</div>':'');
 h=h.replace(/<button class="btn" onclick="svcGo\(\)">[^<]*<\/button>/,btn);
 return h};
window.apLv=v=>{st('student').lv=v;render('fade-none')};
window.apCid=v=>{const s=st('harvest');s.cid=v;const ok=cidOk(s),b=document.getElementById('apGo'),w=document.getElementById('apW'),hh=document.getElementById('apH');
 if(b)b.disabled=!ok;if(w)w.textContent=ok?'':'Enter your cooperative ID to apply.';if(hh)hh.textContent=ok?'Looks good.':(v?'Keep typing, at least 4 characters.':'Your cooperative gives you this ID.')};
const _g=window.svcGo;
window.svcGo=function(ok){const k=S.svk;if(S.lang!=='en'||!K[k])return _g.apply(this,arguments);
 const s=st(k),c=K[k],q=calc(k,s);if(S.apps[k])return;if(k==='harvest'&&!cidOk(s))return;
 if(ok===1){const ref='ITN-'+String(Date.now()).slice(-6);S.apps[k]={ref,a:s.a};closeSheet();render('fade-none');
  $('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="g3" style="font-size:56px;line-height:1;margin-bottom:10px">\ud83d\udce8</div><div class="h1" style="font-size:22px;line-height:30px">Application sent</div><div class="mu" style="font-size:15px;margin:8px 0 8px;line-height:22px">'+c.nx+'</div><div style="font-weight:800;margin-bottom:24px">Reference '+ref+'</div><button class="btn" onclick="closeSheet()">OK</button></div>';
  if(typeof focusSheet==='function')focusSheet();return}
 $('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="h1" style="font-size:22px;line-height:30px;margin-top:4px">Apply for '+fmt(s.a)+' RWF?</div><div style="margin:12px 0 20px">'+R('Amount',fmt(s.a)+' RWF')+(k==='student'?R('Level',s.lv?'Postgraduate':'Undergraduate'):'')+(k==='harvest'?R('Cooperative ID',esc((s.cid||'').trim())):'')+R('Repay over',q.n+' months')+R('Monthly payment',fmt(q.mo)+' RWF')+R('Interest',fmt(q.int)+' RWF ('+q.r+'% a year)')+R('Total to repay',fmt(q.tot)+' RWF')+R('Next',c.nx)+'</div><div class="row2" style="display:grid;grid-template-columns:1fr 1.8fr"><button class="btn sec2" onclick="closeSheet()">Cancel</button><button class="btn" style="white-space:nowrap" onclick="svcGo(1)">Send application</button></div></div>';
 if(typeof focusSheet==='function')focusSheet()};
document.title='itunda, clickable prototype v201';
})();
</script>
<script>
/* v202: Youth account and Group account. Before: you could only pick a child's name from three presets (Keza, Ineza, Kevin) and a group could only be called "Family", "Church" or "Cooperative"; "Send 2,000" and "Add 5,000" took the money the moment you tapped them; the weekly limit had no sentence saying what it does. Now: Youth account asks for your child's first name (typed) and an age group, with a line saying what is missing until you do, a review before opening, amount shortcuts (2,000 / 5,000 / 10,000) under "How much to send?", a review before sending (to, amount, bank balance after, their balance after) and a button that names the amount and the child ("Send 5,000 RWF to Keza"), and a sentence under the weekly limit ("Keza can spend up to 3,000 RWF a week. A change applies straight away."). Group account: pick a type, give the group a name (or keep the suggested one), review before creating, "How much to add?" with 5,000 / 10,000 / 20,000, a review before adding, and a button that names the amount. A plain reason when the bank balance is too low. English only; fr/rw copy untouched. */
(function(){
const R=(a,v)=>'<div style="display:flex;justify-content:space-between;gap:12px;min-height:40px;align-items:center;font-size:15px;border-top:0"><span class="mu">'+a+'</span><b style="text-align:right">'+v+'</b></div>';
const esc=x=>String(x).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const chipB=(on,fn,txt)=>'<button class="chip" aria-pressed="'+on+'" onclick="'+fn+'" style="min-width:64px;height:44px;border-radius:22px;border:0;padding:0 16px;font-size:15px;font-weight:800;background:'+(on?'var(--tx)':'var(--chip)')+';color:'+(on?'var(--bg)':'var(--tx)')+'">'+txt+'</button>';
const chips=(a,cur,fn,lab)=>'<div style="display:flex;gap:10px;flex-wrap:wrap;padding-top:10px" role="group">'+a.map(v=>chipB(v===cur,fn+'('+JSON.stringify(v).replace(/"/g,"'")+')',lab?lab(v):fmt(v))).join('')+'</div>';
const lab=t=>'<div style="font-size:16px;font-weight:800;padding-top:22px">'+t+'</div>';
const inp=(id,v,ph,fn)=>'<input id="'+id+'" value="'+esc(v)+'" oninput="'+fn+'(this.value)" autocomplete="off" placeholder="'+ph+'" style="width:100%;height:48px;margin-top:10px;border:0;border-radius:14px;background:var(--chip);color:var(--tx);padding:0 16px;font:inherit;font-size:16px">';
const sheet=(h,body,no,yes,go)=>{$('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="h1" style="font-size:22px;line-height:30px;margin-top:4px">'+h+'</div><div style="margin:12px 0 20px">'+body+'</div><div class="row2" style="display:grid;grid-template-columns:1fr 1.8fr"><button class="btn sec2" onclick="closeSheet()">'+no+'</button><button class="btn" style="white-space:nowrap" onclick="'+go+'">'+yes+'</button></div></div>';if(typeof focusSheet==='function')focusSheet()};
const need=(id,t)=>'<div id="'+id+'" class="sm mu" style="text-align:center;margin-top:8px">'+t+'</div>';
const AGES=['Under 10','10 to 13','14 to 17'];
S.ya=S.ya||'';S.ysd=S.ysd||2000;S.gnm=S.gnm||'';S.gad=S.gad||5000;
/* ---------- Youth ---------- */
const nm=()=>S.ynTouched?(S.yn||'').trim():'';
const yOk=()=>nm().length>=2&&!!S.ya;
const yMsg=()=>nm().length<2?"Type your child's first name to continue.":(!S.ya?'Pick an age group to continue.':'');
const _y=screens.yth;
screens.yth=()=>{if(S.lang!=='en')return _y();const Y=S.yth;
 if(!Y){const ok=yOk();
  return bar('Youth account')+'<div class="pad" style="padding-top:28px"><div class="h1">A first account for your child</div><div class="mu" style="font-size:15px;margin-top:8px;line-height:22px">For under-18s. You stay in charge: you add money and set the spending limit.</div>'+lab("Your child's first name")+inp('yNm',nm(),'Type their first name','ythName')+lab('Age group')+chips(AGES,S.ya,'ythAge',x=>x)+'</div><div class="pad fine" style="padding-top:20px">Sample account for this prototype.</div><div style="height:100px"></div><div class="cta"><button class="btn" id="yGo" '+(ok?'':'disabled ')+'onclick="ythReview()" style="white-space:nowrap">'+(nm().length>=2?'Open account for '+esc(nm()):'Open account')+'</button>'+need('yW',yMsg())+'</div>'}
 const n=S.ysd,low=S.bank<n,after=S.bank-n;
 return bar(esc(Y.n)+"'s account")+'<div class="pad" style="padding-top:28px"><div class="sm mu">Balance</div><div class="big" style="margin-top:4px">'+fmt(Y.bal)+' RWF</div><div class="sm mu" style="margin-top:6px">Parent-supervised \u00b7 weekly limit '+fmt(Y.l)+' RWF</div></div>'+
 '<div class="pad">'+lab('How much to send?')+chips([2000,5000,10000],n,'ythAmt')+'<div class="sm mu" style="margin-top:14px;line-height:20px" aria-live="polite">'+(low?'<span style="color:var(--er)">'+fmt(n)+' RWF is more than your bank balance of '+fmt(S.bank)+' RWF. Pick a smaller amount.</span>':'From itunda Bank \u00b7 balance after '+fmt(after)+' RWF')+'</div><button class="btn" style="width:100%;margin-top:16px;white-space:nowrap" '+(low?'disabled ':'')+'onclick="ythSendReview()">Send '+fmt(n)+' RWF to '+esc(Y.n)+'</button></div>'+
 '<div class="pad">'+lab('Weekly spending limit')+chips([1000,3000,5000],Y.l,'ythLim')+'<div class="sm mu" style="margin-top:14px;line-height:20px">'+esc(Y.n)+' can spend up to '+fmt(Y.l)+' RWF a week. A change applies straight away.</div></div><div class="pad fine" style="padding-top:20px">Sample data for this prototype.</div>'};
window.ythName=v=>{S.yn=v;S.ynTouched=1;const ok=yOk(),b=document.getElementById('yGo'),w=document.getElementById('yW');if(b){b.disabled=!ok;b.textContent=nm().length>=2?'Open account for '+nm():'Open account'}if(w)w.textContent=yMsg()};
window.ythAge=v=>{S.ya=v;render('fade-none');const i=document.getElementById('yNm');if(i){i.focus();const l=i.value.length;i.setSelectionRange(l,l)}};
window.ythAmt=v=>{S.ysd=v;render('fade-none')};
window.ythLim=v=>{S.yth.l=v;render('fade-none')};
window.ythReview=()=>{if(!yOk())return;sheet('Open an account for '+esc(nm())+'?',R('Child',esc(nm()))+R('Age group',S.ya)+R('In charge','You (parent)')+R('Weekly spending limit','3,000 RWF, you can change it')+R('Cost','Free'),'Cancel','Open account','ythGo()')};
window.ythGo=()=>{closeSheet();S.yth={n:nm(),bal:0,l:3000};render('fade-none');toast('Account opened for '+nm())};
window.ythSendReview=()=>{const n=S.ysd,Y=S.yth;if(S.bank<n)return;sheet('Send '+fmt(n)+' RWF to '+esc(Y.n)+'?',R('To',esc(Y.n)+"'s account")+R('Amount',fmt(n)+' RWF')+R('From','itunda Bank')+R('Bank balance after',fmt(S.bank-n)+' RWF')+R(esc(Y.n)+"'s balance after",fmt(Y.bal+n)+' RWF'),'Cancel','Send '+fmt(n)+' RWF','ythDo()')};
window.ythDo=()=>{const n=S.ysd;closeSheet();ythSend(n)};
/* ---------- Group ---------- */
const gDef=()=>S.gn+' savings',gName=()=>(S.gnm||'').trim()||gDef();
const _g=screens.grp;
screens.grp=()=>{if(S.lang!=='en')return _g();const G=S.grp;
 if(!G)return bar('Group accounts')+'<div class="pad" style="padding-top:28px"><div class="h1">Save together</div><div class="mu" style="font-size:15px;margin-top:8px;line-height:22px">A shared account for family, church or a cooperative. Everyone can add money.</div>'+lab('Group type')+chips(['Family','Church','Cooperative'],S.gn,'grpType',x=>x)+lab('Group name (optional)')+inp('gNm',S.gnm,esc(gDef()),'grpNm')+'<div id="gH" class="sm mu" style="margin-top:8px">Leave it empty to call it \u201c'+esc(gDef())+'\u201d.</div></div><div class="pad fine" style="padding-top:20px">Sample group for this prototype.</div><div style="height:100px"></div><div class="cta"><button class="btn" id="gGo" onclick="grpReview()" style="white-space:nowrap">Create '+esc(gName())+'</button></div>';
 const n=S.gad,low=S.bank<n;
 return bar(esc(G.n))+'<div class="pad" style="padding-top:28px"><div class="sm mu">Group balance</div><div class="big" style="margin-top:4px">'+fmt(G.bal)+' RWF</div></div><div class="sec" style="padding-top:20px"><div class="sech">Members</div>'+G.mem.map(([m,v])=>'<div class="row" style="cursor:default;padding:8px 0"><div class="ico" style="width:36px;height:36px;font-size:14px;font-weight:800">'+esc(m.split(/\s+/).map(w=>w[0]).join('').slice(0,2))+'</div><div class="t" style="font-size:15px">'+esc(m)+'</div><div class="r">'+fmt(v)+' RWF</div></div>').join('')+'</div>'+
 '<div class="pad">'+lab('How much to add?')+chips([5000,10000,20000],n,'grpAmt')+'<div class="sm mu" style="margin-top:14px;line-height:20px" aria-live="polite">'+(low?'<span style="color:var(--er)">'+fmt(n)+' RWF is more than your bank balance of '+fmt(S.bank)+' RWF. Pick a smaller amount.</span>':'From itunda Bank \u00b7 balance after '+fmt(S.bank-n)+' RWF')+'</div><button class="btn" style="width:100%;margin-top:16px;white-space:nowrap" '+(low?'disabled ':'')+'onclick="grpAddReview()">Add '+fmt(n)+' RWF</button></div><div class="pad fine" style="padding-top:20px">Withdrawals need approval from two members. Sample data.</div>'};
window.grpNm=v=>{S.gnm=v;const b=document.getElementById('gGo');if(b)b.textContent='Create '+gName()};
const _gt=window.grpType;window.grpType=function(x){S.gn=x;render('fade-none')};
window.grpAmt=v=>{S.gad=v;render('fade-none')};
window.grpReview=()=>sheet('Create '+esc(gName())+'?',R('Name',esc(gName()))+R('Type',S.gn)+R('Members','You, Eric M., Amina K. (sample)')+R('Who can add money','Everyone')+R('Withdrawals','Two members approve')+R('Cost','Free'),'Cancel','Create group','grpGo()');
window.grpGo=()=>{const n=gName();closeSheet();S.grp={n,bal:0,mem:[['You',0],['Eric M.',0],['Amina K.',0]]};render('fade-none');toast('Group account created')};
window.grpAddReview=()=>{const n=S.gad,G=S.grp;if(S.bank<n)return;sheet('Add '+fmt(n)+' RWF to '+esc(G.n)+'?',R('To',esc(G.n))+R('Amount',fmt(n)+' RWF')+R('From','itunda Bank')+R('Bank balance after',fmt(S.bank-n)+' RWF')+R('Group balance after',fmt(G.bal+n)+' RWF')+R('Your total in the group',fmt(G.mem[0][1]+n)+' RWF'),'Cancel','Add '+fmt(n)+' RWF','grpDo()')};
window.grpDo=()=>{const n=S.gad,G=S.grp;closeSheet();S.bank-=n;G.bal+=n;G.mem[0][1]+=n;addAct('users',G.n,'Paid',-n,'Paid');render('fade-none');toast('Added '+fmt(n)+' RWF')};
document.title='itunda, clickable prototype v202';
})();
</script>
<script>
/* v203: Subscriptions. Before: the dates ("3 Nov", "1 Nov", "Every Mon") were typed in and never moved, nothing said which charge comes next or how much is due soon, tapping a row did nothing (only the switch worked, with no way to see details or cancel), and there was no empty state. Now: real next-charge dates worked out from today, the list sorted by next charge, a line at the top ("Next charge: Gym Kigali, 25,000 RWF, in 14 days"), active and paused subscriptions under their own headings, tap a row for its details (price, billing, next charge, paid from) with Pause / Resume and Cancel, a confirmation before cancelling that says you will not be charged again, and an empty state. English only; fr/rw copy untouched. */
(function(){
const R=(a,v)=>'<div style="display:flex;justify-content:space-between;gap:12px;min-height:40px;align-items:center;font-size:15px;border-top:0"><span class="mu">'+a+'</span><b style="text-align:right">'+v+'</b></div>';
const esc=x=>String(x).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const DAY={'Canal+ Rwanda':3,'MTN data bundle':'Mon','Gym Kigali':1,'Music streaming':9};
const day0=()=>{const d=new Date();d.setHours(0,0,0,0);return d};
const nextOf=s=>{const t=day0(),d=DAY[s[1]];if(d==null)return null;
 if(d==='Mon'){const x=new Date(t);x.setDate(x.getDate()+(1-t.getDay()+7)%7);return x}
 let x=new Date(t.getFullYear(),t.getMonth(),d);if(x<t)x=new Date(t.getFullYear(),t.getMonth()+1,d);return x};
const fd=d=>d.toLocaleDateString('en-GB',{day:'numeric',month:'short'});
const inDays=d=>{const n=Math.round((d-day0())/864e5);return n===0?'today':n===1?'tomorrow':'in '+n+' days'};
const when=s=>{const d=nextOf(s);return d?fd(d):s[4]};
const per=s=>s[3]==='Weekly'?'week':'month';
const _s=screens.subs;
screens.subs=()=>{if(S.lang!=='en')return _s();
 const L=S.subs.map((s,i)=>({s,i,d:nextOf(s)})),on=L.filter(x=>x.s[5]).sort((a,b)=>(a.d||1e15)-(b.d||1e15)),off=L.filter(x=>!x.s[5]);
 const mo=on.reduce((a,x)=>a+x.s[2]*(x.s[3]==='Weekly'?4:1),0);
 const row=x=>{const s=x.s;return '<div class="row tap" onclick="subOpen('+x.i+')" style="padding:12px 24px"><div class="ico">'+s[0]+'</div><div style="flex:1;min-width:0"><div class="t" style="opacity:'+(s[5]?1:.5)+'">'+esc(s[1])+'</div><div class="s">'+fmt(s[2])+' RWF \u00b7 '+s[3]+' \u00b7 '+(s[5]?'Next '+when(s):'Paused')+'</div></div><div class="sw '+(s[5]?'on':'')+'" role="switch" aria-checked="'+!!s[5]+'" aria-label="'+esc(s[1])+(s[5]?', on':', paused')+'" tabindex="0" onclick="event.stopPropagation();subTg('+x.i+')"><i></i></div></div>'};
 const hd=t=>'<div style="padding:22px 24px 0;font-size:16px;font-weight:800">'+t+'</div>';
 const nx=on[0]&&on[0].d?'<div class="sm" style="margin-top:8px;line-height:20px"><span class="mu">Next charge:</span> <b>'+esc(on[0].s[1])+'</b>, '+fmt(on[0].s[2])+' RWF, '+inDays(on[0].d)+'</div>':'';
 if(!S.subs.length)return bar('Subscriptions')+'<div class="pad" style="padding-top:28px"><div class="h1">No subscriptions</div><div class="mu" style="font-size:15px;margin-top:8px;line-height:22px">When you set up a regular payment, it shows here with its next charge date. You can pause or cancel it any time.</div></div>';
 return bar('Subscriptions')+'<div style="padding:20px 24px 4px"><div class="sm mu">Monthly total</div><div class="big" style="font-size:34px">'+fmt(mo)+' RWF</div>'+nx+'<div class="sm mu" style="margin-top:6px">Weekly charges are counted as 4 a month.</div></div>'+
 (on.length?hd('Active')+on.map(row).join(''):'')+(off.length?hd('Paused, not charged')+off.map(row).join(''):'')+
 '<div class="pad fine" style="padding-top:16px">Tap a subscription to see details, pause or cancel. Sample data.</div>'};
const sheet=(h,body,no,yes,go,danger)=>{$('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="h1" style="font-size:22px;line-height:30px;margin-top:4px">'+h+'</div>'+body+'<div class="row2" style="display:grid;grid-template-columns:1fr 1.4fr;gap:12px">'+no+yes+'</div></div>';if(typeof focusSheet==='function')focusSheet()};
window.subOpen=i=>{const s=S.subs[i];if(!s)return;
 $('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div style="display:flex;align-items:center;gap:12px"><div class="ico">'+s[0]+'</div><div class="h1" style="font-size:22px;line-height:30px">'+esc(s[1])+'</div></div><div style="margin:14px 0 18px">'+R('Price',fmt(s[2])+' RWF a '+per(s))+R('Billing',s[3])+R('Next charge',s[5]?when(s):'Paused, not charged')+R('Paid from','itunda Pay')+'</div><div class="row2" style="display:grid;grid-template-columns:1fr 1fr;gap:12px"><button class="btn sec2" onclick="closeSheet();subTg('+i+')">'+(s[5]?'Pause':'Resume')+'</button><button class="btn sec2" style="color:var(--er)" onclick="subAsk('+i+')">Cancel it</button></div><button class="btn" style="margin-top:12px;width:100%" onclick="closeSheet()">Done</button></div>';
 if(typeof focusSheet==='function')focusSheet()};
window.subAsk=i=>{const s=S.subs[i];if(!s)return;
 $('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="h1" style="font-size:22px;line-height:30px;margin-top:4px">Cancel '+esc(s[1])+'?</div><div class="mu" style="font-size:15px;margin:8px 0 24px;line-height:22px">You will not be charged again. To get it back, you set it up again with the provider.</div><div class="row2" style="display:grid;grid-template-columns:1fr 1.4fr;gap:12px"><button class="btn sec2" onclick="closeSheet()">Keep it</button><button class="btn" style="white-space:nowrap" onclick="subDel('+i+')">Cancel subscription</button></div></div>';
 if(typeof focusSheet==='function')focusSheet()};
window.subDel=i=>{const s=S.subs[i];if(!s)return;const n=s[1];S.subs.splice(i,1);closeSheet();render('fade-none');toast(n+' cancelled')};
document.title='itunda, clickable prototype v203';
})();
</script>
<script>
/* v204: Moto-Taxi ownership. Before: "Start saving for a motorbike" said "Savings goal created" but no goal was created (the Savings goal page and the Home card were unchanged), there was no way to say how fast you would save, the page showed "Monthly payment" without saying it starts only after the down payment is saved, and the price took up to 15 taps of +. Now: price shortcuts (1.5M, 2M, 2.5M, 3M); the page is in two parts, "First: save your down payment" (30%, "Save it in" 6 / 12 / 18 months, "about 50,000 RWF a month") and "Then: repay the loan" (months, loan amount, monthly payment, total); a review before it starts; the button really creates the savings goal "Motorbike down payment" (it shows on Home and the Savings goal page) and the page then says how much you have saved with "Open my savings goal"; if you already have a different savings goal, the page says so and links to it instead of replacing it. English only; fr/rw copy untouched. */
(function(){
const R=(a,v)=>'<div style="display:flex;justify-content:space-between;gap:12px;min-height:40px;align-items:center;font-size:15px;border-top:0"><span class="mu">'+a+'</span><b style="text-align:right">'+v+'</b></div>';
const T=[24,36,48],SC=[1500000,2000000,2500000,3000000],MS=[6,12,18],RATE=14,DOWN=.3;
const short=v=>v>=1e6?v/1e6+'M':v/1e3+'K';
S.moMs=S.moMs||12;
const st=()=>S.sv2.moto=S.sv2.moto||{a:2000000,tm:0,o:0};
const chipB=(on,fn,txt,al)=>'<button class="chip" aria-pressed="'+on+'" '+(al?'aria-label="'+al+'" ':'')+'onclick="'+fn+'" style="min-width:64px;height:44px;border-radius:22px;border:0;padding:0 16px;font-size:15px;font-weight:800;background:'+(on?'var(--tx)':'var(--chip)')+';color:'+(on?'var(--bg)':'var(--tx)')+'">'+txt+'</button>';
const lab=t=>'<div style="font-size:16px;font-weight:800;padding:22px 24px 0">'+t+'</div>';
const rw=(a,v,top)=>'<div style="margin:'+(top||8)+'px 24px 0;display:flex;justify-content:space-between;font-size:15px"><span class="mu">'+a+'</span><b>'+v+'</b></div>';
const calc=()=>{const s=st(),dn=Math.round(s.a*DOWN),loan=s.a-dn,n=T[s.tm||0],i=RATE/1200,mo=Math.round(loan*i/(1-Math.pow(1+i,-n)));return{s,dn,loan,n,mo,tot:mo*n,sv:Math.round(dn/S.moMs/1000)*1000||Math.round(dn/S.moMs)}};
const mine=()=>S.goal&&S.goal.moto;
const other=()=>S.goal&&!S.goal.moto;
const _s=screens.svc;
screens.svc=()=>{let h=_s();if(S.lang!=='en'||S.svk!=='moto')return h;
 const q=calc(),s=q.s;
 const sc='<div style="padding:14px 24px 0"><div style="display:flex;gap:10px;flex-wrap:wrap" role="group" aria-label="Price shortcuts">'+SC.map(v=>chipB(v===s.a,'svcSet(\'a\','+(v-s.a)+')',short(v),fmt(v)+' RWF')).join('')+'</div></div>';
 const save=lab('First: save your down payment')+rw('Down payment (30%)',fmt(q.dn)+' RWF',14)+'<div style="padding:12px 24px 0"><div class="sm mu" style="margin-bottom:8px">Save it in</div><div style="display:flex;gap:10px;flex-wrap:wrap" role="group">'+MS.map(v=>chipB(v===S.moMs,'moMs('+v+')',v+' months')).join('')+'</div></div>'+rw('About each month',fmt(q.sv)+' RWF',12)+lab('Then: repay the loan over');
 h=h.replace('<div class="chp" style="padding:14px 24px 0">',sc+save+'<div class="chp" style="padding:10px 24px 0">');
 h=h.replace(/Monthly payment<\/span><b>[^<]*<\/b><\/div>/,'Monthly loan payment</span><b>'+fmt(q.mo)+' RWF</b></div>');
 h=h.replace(/<div style="margin:8px 24px 0;display:flex;justify-content:space-between;font-size:15px"><span class="mu">Down payment to save<\/span><b>[^<]*<\/b><\/div>/,rw('Loan amount (70%)',fmt(q.loan)+' RWF')+rw('Total to repay',fmt(q.tot)+' RWF')+'<div class="pad sm mu" style="padding-top:8px;line-height:20px">The loan opens when your down payment is saved.</div>');
 h=h.replace(/<div style="display:flex;justify-content:space-between;gap:16px;padding:14px 24px;border-top:0;font-size:15px"><span class="mu">Down payment<\/span>.*?<\/div>/,'');
 let card='',btn;
 if(mine()){const g=S.goal;card='<div style="margin:18px 24px 0;padding:14px 16px;border-radius:16px;background:var(--tint);color:var(--tintfg);font-size:14px;line-height:20px"><b>You are saving for a motorbike.</b> '+fmt(g.s)+' of '+fmt(g.t)+' RWF saved.</div>';btn='<button class="btn" style="white-space:nowrap" onclick="openGoal()">Open my savings goal</button>'}
 else if(other()){card='<div style="margin:18px 24px 0;padding:14px 16px;border-radius:16px;background:var(--chip);font-size:14px;line-height:20px">You already have a savings goal: <b>'+String(S.goal.n).replace(/[<>&]/g,'')+'</b>. Finish it or delete it, then come back to start your motorbike goal.</div>';btn='<button class="btn" style="white-space:nowrap" onclick="openGoal()">Open my savings goal</button>'}
 else btn='<button class="btn" style="white-space:nowrap" onclick="svcGo()">Start saving '+fmt(q.dn)+' RWF</button>';
 if(card)h=h.replace('<div style="margin-top:18px">',card+'<div style="margin-top:18px">');
 h=h.replace(/<button class="btn" onclick="svcGo\(\)">[^<]*<\/button>/,btn);
 return h};
window.moMs=v=>{S.moMs=v;render('fade-none')};
const _g=window.svcGo;
window.svcGo=function(ok){if(S.lang!=='en'||S.svk!=='moto')return _g.apply(this,arguments);
 if(S.goal)return;const q=calc();
 if(ok===1){S.goal={n:'Motorbike down payment',t:q.dn,m:S.moMs,s:0,moto:true};closeSheet();render('fade-none');toast('Savings goal created');return}
 $('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="h1" style="font-size:22px;line-height:30px;margin-top:4px">Start saving for a motorbike?</div><div style="margin:12px 0 20px">'+R('Motorbike price',fmt(q.s.a)+' RWF')+R('Down payment (30%)',fmt(q.dn)+' RWF')+R('Save it in',S.moMs+' months')+R('About each month',fmt(q.sv)+' RWF')+R('Then the loan',fmt(q.loan)+' RWF over '+q.n+' months')+R('Loan payment',fmt(q.mo)+' RWF a month')+R('Rate',RATE+'% a year')+'</div><div class="mu sm" style="margin:-8px 0 16px;line-height:20px">This creates a savings goal called \u201cMotorbike down payment\u201d. It shows on Home.</div><div class="row2" style="display:grid;grid-template-columns:1fr 1.8fr"><button class="btn sec2" onclick="closeSheet()">Cancel</button><button class="btn" style="white-space:nowrap" onclick="svcGo(1)">Create my goal</button></div></div>';
 if(typeof focusSheet==='function')focusSheet()};
document.title='itunda, clickable prototype v204';
})();
</script>
<script>
/* v344: Intercity bus, calmer. Before: radio buttons with a tinted card on the chosen city, then three more rows of chips (day, time, seats), and tickets as tinted cards. Now: the page is four plain rows (Where to?, Which day?, Which bus?, Seats) with the choice on the right; tapping one opens a check list (a plain check, no radio, no card); the day list covers a week; each bus shows when it arrives; tickets are plain rows with a text Cancel link. Also: the booking state moved to S.bus, because the bill screen reuses S.bk as a number and could break the bus page. Fare, review, payment, Activity and cancel are unchanged. */
/* v205: Intercity bus. Before: "Book seat" showed a ticket message at once: no day, no departure time, no number of seats, no payment (your balance never changed), nothing in Activity, no ticket to find later, and the page's "Cancel: free up to 2 h before" could not be used. Now: four plain questions in order ("Where to?", "Which day?", "Which bus?", "How many seats?") with taps; a live line with the total and your itunda Pay balance after; a plain reason when something is missing or the balance is too low; a review (route, day, time, seats, total, balance after, cancel rule); the fare is taken from itunda Pay and a row is added to Activity; the ticket code is shown and kept under "Your tickets" on the page, where you can cancel it (refund to itunda Pay, shown in Activity) until 2 hours before departure. English only; fr/rw copy untouched. */
(function(){
const R=(a,v)=>'<div style="display:flex;justify-content:space-between;gap:12px;min-height:40px;align-items:center;font-size:15px;border-top:0"><span class="mu">'+a+'</span><b style="text-align:right">'+v+'</b></div>';
const DEST=[['Huye',3500,'about 2 h'],['Musanze',3000,'about 2 h'],['Rubavu',4000,'about 3 h 30'],['Rusizi',7500,'about 5 h']];
const p2=n=>String(n).padStart(2,'0');
const day=i=>{const d=new Date();d.setHours(0,0,0,0);d.setDate(d.getDate()+i);return d};
const dl=i=>i===0?'Today':i===1?'Tomorrow':day(i).toLocaleDateString('en-GB',{weekday:'short',day:'numeric',month:'short'});
const dfull=i=>day(i).toLocaleDateString('en-GB',{weekday:'short',day:'numeric',month:'short'});
const slots=i=>{if(i>0)return['06:00','08:00','10:00','14:00','16:30','18:00'];
 const n=new Date(),m=n.getHours()*60+n.getMinutes()+30,s=Math.max(Math.ceil(m/30)*30,5*60+30),out=[];
 for(let t=s;t<=22*60+30&&out.length<6;t+=30)out.push(p2(Math.floor(t/60))+':'+p2(t%60));return out};
S.bus=S.bus||{to:0,day:0,time:'',seats:1};S.tix=S.tix||[];
const when=(dayI,time)=>{const d=day(dayI);const[h,m]=time.split(':');d.setHours(+h,+m,0,0);return d};
const DUR=[120,120,210,300];
const arr=(t,m)=>{const[h,mi]=t.split(':'),x=(+h*60+ +mi+m)%1440;return p2(Math.floor(x/60))+':'+p2(x%60)};
const CKS='<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>',CHV='<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--tt)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>';
/* check-list row: plain check on the right of the chosen one, no radio, no tinted card */
const ck=(sel,fn,t,s,r)=>'<div class="row tap" role="radio" aria-checked="'+sel+'" tabindex="0" onclick="'+fn+'" style="padding:14px 24px"><div style="flex:1;min-width:0"><div class="t" style="font-weight:'+(sel?800:600)+'">'+t+'</div>'+(s?'<div class="s">'+s+'</div>':'')+'</div>'+(r?'<span class="mu" style="font-weight:700;white-space:nowrap">'+r+'</span>':'')+'<span style="color:var(--lk);width:24px;height:24px;display:flex;flex:none">'+(sel?CKS:'')+'</span></div>';
const vr=(f,t,v,empty)=>'<div class="row tap" role="button" tabindex="0" onclick="bkOpen(\''+f+'\')" style="padding:14px 24px"><div class="t" style="flex:1">'+t+'</div><b style="color:'+(empty?'var(--tt)':'var(--lk)')+';font-size:16px">'+v+'</b>'+CHV+'</div>';
const head=t=>'<div class="agt">'+t+'</div>';
const _s=screens.svc;
screens.svc=()=>{if(S.svk!=='bus')return _s();
 const b=S.bus,d=DEST[b.to],sl=slots(b.day),total=d[1]*b.seats,low=S.pay<total;
 if(b.time&&sl.indexOf(b.time)<0)b.time='';
 const miss=!b.time?(sl.length?'Pick a bus time to continue.':'No more buses today. Pick another day.'):'';
 const tix=S.tix.length?head('Your tickets')+S.tix.map((t,i)=>{const can=when(t.day,t.time)-new Date()>2*36e5;return '<div class="row" style="padding:12px 24px;align-items:flex-start"><div style="flex:1;min-width:0"><div class="t">Nyabugogo to '+t.to+'</div><div class="s">'+dfull(t.day)+' at '+t.time+' \u00b7 '+t.seats+' seat'+(t.seats>1?'s':'')+' \u00b7 '+fmt(t.total)+' RWF</div>'+(can?'<button onclick="bkCancelAsk('+i+')" style="border:0;background:none;padding:8px 0 0;color:var(--lk);font-weight:800;font-size:14px">Cancel ticket</button>':'<div class="s" style="margin-top:4px">Free cancel closed, less than 2 hours to go.</div>')+'</div><b>'+t.code+'</b></div>'}).join(''):'';
 return bar('Intercity bus')+'<div style="padding:22px 24px 0"><div class="h1">Intercity bus</div><div class="mu" style="font-size:15px;line-height:22px;margin-top:8px">Leaves Nyabugogo, KN 3 Rd. 1 bag included.</div></div>'+tix+
 '<div style="padding-top:18px">'+vr('to','Where to?',d[0])+vr('day','Which day?',dl(b.day))+vr('time','Which bus?',b.time||'Choose',!b.time)+vr('seats','Seats',b.seats)+'</div>'+
 '<div class="pad sm" style="padding-top:16px;line-height:20px" aria-live="polite">'+(low?'<span style="color:var(--er)">'+fmt(total)+' RWF is more than your itunda Pay balance of '+fmt(S.pay)+' RWF. Pick fewer seats.</span>':'<b>'+fmt(total)+' RWF</b> <span class="mu">from itunda Pay \u00b7 balance after '+fmt(S.pay-total)+' RWF \u00b7 free to cancel up to 2 hours before</span>')+'</div><div class="pad fine" style="padding-top:12px">Times and travel times are samples for this prototype.</div><div style="height:100px"></div>'+
 '<div class="cta"><button class="btn" style="white-space:nowrap" '+(miss||low?'disabled ':'')+'onclick="bkReview()">Book '+b.seats+' seat'+(b.seats>1?'s':'')+' \u00b7 '+fmt(total)+' RWF</button>'+(miss?'<div class="sm mu" style="text-align:center;margin-top:8px">'+miss+'</div>':'')+'</div>'};
window.bkOpen=f=>{const b=S.bus,T={to:'Where to?',day:'Which day?',time:'Which bus?',seats:'How many seats?'}[f];let rows='';
 if(f==='to')rows=DEST.map((x,i)=>ck(b.to===i,'bkSet(\'to\','+i+')',x[0],x[2],fmt(x[1])+' RWF')).join('');
 else if(f==='day')rows=[0,1,2,3,4,5,6].map(i=>ck(b.day===i,'bkSet(\'day\','+i+')',dl(i),i<2?dfull(i):'')).join('');
 else if(f==='time'){const sl=slots(b.day),m=DUR[b.to];rows=sl.length?sl.map(t=>ck(b.time===t,'bkSet(\'time\',\''+t+'\')',t,'Arrives about '+arr(t,m))).join(''):'<div class="mu" style="padding:8px 24px;font-size:15px">No more buses today. Pick another day.</div>'}
 else rows=[1,2,3,4].map(n=>ck(b.seats===n,'bkSet(\'seats\','+n+')',n+(n>1?' seats':' seat'),'',fmt(DEST[b.to][1]*n)+' RWF')).join('');
 $('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="h1" style="font-size:22px;line-height:30px;margin:4px 0 8px">'+T+'</div><div style="margin:0 -24px;max-height:56vh;overflow-y:auto">'+rows+'</div></div>';if(typeof focusSheet==='function')focusSheet()};
window.bkSet=(f,v)=>{const b=S.bus;b[f]=v;if(f==='day')b.time='';closeSheet();render('fade-none')};
const sheet=(h,body,no,yes,go)=>{$('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="h1" style="font-size:22px;line-height:30px;margin-top:4px">'+h+'</div><div style="margin:12px 0 20px">'+body+'</div><div class="row2" style="display:grid;grid-template-columns:1fr 1.8fr"><button class="btn sec2" onclick="closeSheet()">'+no+'</button><button class="btn" style="white-space:nowrap" onclick="'+go+'">'+yes+'</button></div></div>';if(typeof focusSheet==='function')focusSheet()};
window.bkReview=()=>{const b=S.bus,d=DEST[b.to],total=d[1]*b.seats;if(!b.time||S.pay<total)return;
 sheet('Book '+b.seats+' seat'+(b.seats>1?'s':'')+' to '+d[0]+'?',R('Route','Nyabugogo to '+d[0])+R('Day',dfull(b.day))+R('Leaves',b.time)+R('Seats',b.seats+' \u00d7 '+fmt(d[1])+' RWF')+R('Total',fmt(total)+' RWF')+R('Paid from','itunda Pay')+R('Balance after',fmt(S.pay-total)+' RWF')+R('Cancel','Free up to 2 h before'),'Cancel','Pay '+fmt(total)+' RWF','bkGo()')};
window.bkGo=()=>{const b=S.bus,d=DEST[b.to],total=d[1]*b.seats;if(!b.time||S.pay<total)return;
 const code='NB-'+String(Date.now()).slice(-5);S.pay-=total;S.tix.push({code,to:d[0],day:b.day,time:b.time,seats:b.seats,total});
 addAct('bus','Intercity bus \u00b7 '+d[0],'Paid',-total,'Paid');const tm=b.time;b.time='';render('fade-none');
 $('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="g3" style="font-size:56px;line-height:1;margin-bottom:10px">\ud83c\udfab</div><div class="h1" style="font-size:22px;line-height:30px">Seat booked</div><div class="mu" style="font-size:15px;margin:8px 0 8px;line-height:22px">Nyabugogo to '+d[0]+', '+dfull(b.day)+' at '+tm+'. Show this code at Nyabugogo.</div><div style="font-weight:800;font-size:20px;margin-bottom:6px">'+code+'</div><div class="sm mu" style="margin-bottom:24px">itunda Pay balance now '+fmt(S.pay)+' RWF. Your ticket stays on this page.</div><button class="btn" onclick="closeSheet()">OK</button></div>';
 if(typeof focusSheet==='function')focusSheet()};
window.bkCancelAsk=i=>{const t=S.tix[i];if(!t)return;sheet('Cancel your ticket to '+t.to+'?',R('Ticket',t.code)+R('Leaves',dfull(t.day)+' at '+t.time)+R('You get back',fmt(t.total)+' RWF in itunda Pay')+R('Fee','Free'),'Keep it','Cancel ticket','bkCancel('+i+')')};
window.bkCancel=i=>{const t=S.tix[i];if(!t)return;S.tix.splice(i,1);S.pay+=t.total;addAct('bus','Intercity bus refund \u00b7 '+t.to,'Received',t.total,'Received');closeSheet();render('fade-none');toast('Ticket cancelled, '+fmt(t.total)+' RWF refunded')};
document.title='itunda, clickable prototype v205';
})();
</script>
<script>
/* v206: Bike rental. Before: "Unlock" showed a code and that was all: no payment, no ride on the page, nothing to end, nothing in Activity, and the price ("20 RWF / min") was never added up. Now: pick Bike or E-scooter (price per minute, and what 15 minutes cost), a short "How it works" in three numbered steps, a plain reason if itunda Pay is too low; a review before unlocking (price per minute, where, paid from, charged when you lock); after unlocking the page shows "Ride in progress" with a live timer and the fare so far, and "End ride"; ending asks first (time, fare, balance after), takes the fare from itunda Pay, adds it to Activity and shows a receipt; the last rides are listed under "Recent rides". A small "Skip 10 minutes" link lets you see the fare grow in this prototype. English only; fr/rw copy untouched. */
(function(){
const R=(a,v)=>'<div style="display:flex;justify-content:space-between;gap:12px;min-height:40px;align-items:center;font-size:15px;border-top:0"><span class="mu">'+a+'</span><b style="text-align:right">'+v+'</b></div>';
const V=[['Bike',20,'\ud83d\udeb2'],['E-scooter',50,'\ud83d\udef4']];
S.busr=S.busr||null;S.bush=S.bush||[];S.busv=S.busv||0;
const A=n=>(/^[aeiou]/i.test(n)?'an ':'a ')+n.toLowerCase();
const lab=t=>'<div style="font-size:16px;font-weight:800;padding:22px 24px 0">'+t+'</div>';
const el=()=>{const r=S.bkr;if(!r)return 0;return Date.now()-r.t0+(r.skip||0)*6e4};
const mins=()=>Math.max(1,Math.ceil(el()/6e4));
const fare=()=>Math.min(S.pay,mins()*V[S.bkr.v][1]);
const clock=()=>{const s=Math.floor(el()/1000),m=Math.floor(s/60),x=s%60;return m+':'+String(x).padStart(2,'0')};
const _s=screens.svc;
screens.svc=()=>{if(S.lang!=='en'||S.svk!=='bike')return _s();
 if(S.bkr){const r=S.bkr,v=V[r.v];
  return bar('Bike rental')+'<div style="margin:22px 24px 0;padding:20px;border-radius:20px;background:var(--tint);text-align:center"><div style="font-size:40px">'+v[2]+'</div><div class="sm" style="color:var(--tintfg);margin-top:6px">Ride in progress \u00b7 '+v[0]+'</div><div id="bkT" class="big" style="margin-top:8px" aria-live="off">'+clock()+'</div><div id="bkF" class="sm" style="margin-top:8px;color:var(--tintfg)">'+fmt(fare())+' RWF so far at '+v[1]+' RWF a minute</div></div>'+
  '<div class="pad sm mu" style="padding-top:14px;line-height:20px">Unlock code <b style="color:var(--tx)">'+r.code+'</b>. Lock the '+v[0].toLowerCase()+' when you are done, then tap End ride. The fare comes from itunda Pay.</div><div class="pad" style="padding-top:6px"><button class="sm" style="background:none;border:0;color:var(--lk);font-weight:700;padding:8px 0" onclick="bkrSkip()">Skip 10 minutes (prototype only)</button></div><div style="height:100px"></div><div class="cta"><button class="btn" onclick="bkrEndAsk()">End ride</button></div>'}
 const v=V[S.bkv],low=S.pay<v[1]*15;
 const rows=V.map((x,i)=>'<div class="row tap" role="radio" aria-checked="'+(S.bkv===i)+'" tabindex="0" onclick="bkrPick('+i+')" style="padding:12px 24px;'+(S.bkv===i?'background:var(--tint)':'')+'"><div class="ico" style="font-size:22px">'+x[2]+'</div><div style="flex:1"><div class="t">'+x[0]+'</div><div class="s">15 minutes cost '+fmt(x[1]*15)+' RWF</div></div><b>'+x[1]+' RWF / min</b></div>').join('');
 const hist=S.bkh.length?lab('Recent rides')+S.bkh.slice(0,3).map(h=>'<div style="display:flex;justify-content:space-between;gap:12px;padding:12px 24px;border-top:0;font-size:15px"><span>'+h.v+' \u00b7 '+h.m+' min</span><b>'+fmt(h.f)+' RWF</b></div>').join(''):'';
 const step=(n,t)=>'<div style="display:flex;gap:12px;align-items:flex-start;padding:6px 24px 0"><div style="width:24px;height:24px;border-radius:12px;background:var(--chip);display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:800;flex:none">'+n+'</div><div style="font-size:15px;line-height:24px">'+t+'</div></div>';
 return bar('Bike rental')+'<div style="padding:22px 24px 0"><div class="h1">Rent by the minute</div><div class="mu" style="font-size:15px;line-height:22px;margin-top:8px">Nearest: Kimironko Market, 120 m. You pay from itunda Pay: <b style="color:var(--tx)">'+fmt(S.pay)+' RWF</b>.</div></div>'+
 lab('Which one?')+'<div role="radiogroup" style="padding-top:6px">'+rows+'</div>'+
 lab('How it works')+step(1,'Scan the QR code on the handlebar.')+step(2,'Enter the unlock code on the lock.')+step(3,'Lock it when you are done. The ride ends and you pay for the minutes used.')+
 '<div class="pad sm" style="padding-top:18px;line-height:20px" aria-live="polite">'+(low?'<span style="color:var(--er)">Keep at least '+fmt(v[1]*15)+' RWF (15 minutes) in itunda Pay to rent '+A(v[0])+'. You have '+fmt(S.pay)+' RWF.</span>':'<span class="mu">Charged when you lock it, '+v[1]+' RWF a minute.</span>')+'</div>'+hist+'<div class="pad fine" style="padding-top:14px">Sample prices and places for this prototype.</div><div style="height:100px"></div>'+
 '<div class="cta"><button class="btn" '+(low?'disabled ':'')+'style="white-space:nowrap" onclick="bkrAsk()">Unlock '+A(v[0])+'</button></div>'};
window.bkrPick=i=>{S.bkv=i;render('fade-none')};
const sheet=(h,body,no,yes,go)=>{$('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="h1" style="font-size:22px;line-height:30px;margin-top:4px">'+h+'</div><div style="margin:12px 0 20px">'+body+'</div><div class="row2" style="display:grid;grid-template-columns:1fr 1.8fr"><button class="btn sec2" onclick="closeSheet()">'+no+'</button><button class="btn" style="white-space:nowrap" onclick="'+go+'">'+yes+'</button></div></div>';if(typeof focusSheet==='function')focusSheet()};
window.bkrAsk=()=>{const v=V[S.bkv];if(S.pay<v[1]*15)return;sheet('Unlock '+A(v[0])+'?',R('Price',v[1]+' RWF a minute')+R('Where','Kimironko Market, 120 m')+R('Paid from','itunda Pay')+R('Charged','When you lock it'),'Cancel','Unlock','bkrGo()')};
window.bkrGo=()=>{const v=V[S.bkv],code=String(1000+Math.floor(Math.random()*9000));S.bkr={v:S.bkv,t0:Date.now(),skip:0,code};render('fade-none');
 $('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="g3" style="font-size:56px;line-height:1;margin-bottom:10px">\ud83d\udd13</div><div class="h1" style="font-size:22px;line-height:30px">Unlock code '+code+'</div><div class="mu" style="font-size:15px;margin:8px 0 24px;line-height:22px">Enter it on the lock. Your ride ends when you lock the '+v[0].toLowerCase()+'.</div><button class="btn" onclick="closeSheet()">OK</button></div>';
 if(typeof focusSheet==='function')focusSheet()};
window.bkrSkip=()=>{if(S.bkr){S.bkr.skip=(S.bkr.skip||0)+10;render('fade-none')}};
window.bkrEndAsk=()=>{const r=S.bkr;if(!r)return;const v=V[r.v],f=fare();sheet('End your ride?',R('Time',mins()+' min')+R('Price',v[1]+' RWF a minute')+R('Fare',fmt(f)+' RWF')+R('Paid from','itunda Pay')+R('Balance after',fmt(S.pay-f)+' RWF'),'Keep riding','Pay '+fmt(f)+' RWF','bkrEnd()')};
window.bkrEnd=()=>{const r=S.bkr;if(!r)return;const v=V[r.v],m=mins(),f=fare();S.pay-=f;S.bkh.unshift({v:v[0],m,f});S.bkr=null;
 addAct('bus','Bike rental \u00b7 '+v[0]+', '+m+' min','Paid',-f,'Paid');render('fade-none');
 $('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="g3" style="font-size:56px;line-height:1;margin-bottom:10px">\u2705</div><div class="h1" style="font-size:22px;line-height:30px">Ride ended</div><div class="mu" style="font-size:15px;margin:8px 0 8px;line-height:22px">'+v[0]+', '+m+' min. '+fmt(f)+' RWF paid from itunda Pay.</div><div style="font-weight:800;margin-bottom:24px">itunda Pay balance now '+fmt(S.pay)+' RWF</div><button class="btn" onclick="closeSheet()">OK</button></div>';
 if(typeof focusSheet==='function')focusSheet()};
setInterval(()=>{if(!S.bkr)return;const t=document.getElementById('bkT'),f=document.getElementById('bkF');if(!t||!f)return;t.textContent=clock();f.textContent=fmt(fare())+' RWF so far at '+V[S.bkr.v][1]+' RWF a minute'},1000);
document.title='itunda, clickable prototype v206';
})();
</script>
<script>
/* v207: Family. Before: "Invite a family member" said "Invite sent" without asking who: no name, no phone number, no child or guardian choice, no limit for a child, and nothing to look at afterwards. Now: "Who are you linking?" (a child, or a guardian) with one plain line saying what each can see; their name and phone number as typed fields with a live count ("7 of 10 digits"), a message if the number does not start with 07 or was already invited; for a child, the weekly spending limit (1,000 / 3,000 / 5,000 RWF); a button that names the person ("Send invite to Aline") and a line saying what is missing while it is off; a review before sending; and "Your family" on the page with each invite and Cancel invite (with a confirmation). English only; fr/rw copy untouched. */
(function(){
const R=(a,v)=>'<div style="display:flex;justify-content:space-between;gap:12px;min-height:40px;align-items:center;font-size:15px;border-top:0"><span class="mu">'+a+'</span><b style="text-align:right">'+v+'</b></div>';
const esc=x=>String(x).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
S.fam=S.fam||[];S.fm=S.fm||{role:'child',n:'',ph:'',lim:3000};
const dg=v=>String(v||'').replace(/\D/g,'').slice(0,10);
const nm=()=>(S.fm.n||'').trim();
const dup=()=>S.fam.some(x=>x.ph===dg(S.fm.ph));
const phMsg=()=>{const d=dg(S.fm.ph);if(!d)return{t:'Type their phone number, for example 078 123 4567.',ok:0};if(d.length<10)return{t:d.length+' of 10 digits',ok:0};if(d.slice(0,2)!=='07')return{t:'Rwandan mobile numbers start with 07.',ok:0,er:1};if(dup())return{t:'You already invited this number.',ok:0,er:1};return{t:'Looks good.',ok:1}};
const miss=()=>nm().length<2?'Type their name to continue.':(!phMsg().ok?'Fix their phone number to continue.':'');
const fmtP=d=>d.replace(/^(\d{3})(\d{0,3})(\d{0,4}).*/,(m,a,b,c)=>[a,b,c].filter(Boolean).join(' '));
const lab=t=>'<div style="font-size:16px;font-weight:800;padding:22px 24px 0">'+t+'</div>';
const chipB=(on,fn,txt)=>'<button class="chip" aria-pressed="'+on+'" onclick="'+fn+'" style="min-width:64px;height:44px;border-radius:22px;border:0;padding:0 16px;font-size:15px;font-weight:800;background:'+(on?'var(--tx)':'var(--chip)')+';color:'+(on?'var(--bg)':'var(--tx)')+'">'+txt+'</button>';
const inp=(id,v,ph,fn,mode)=>'<input id="'+id+'" value="'+esc(v)+'" oninput="'+fn+'(this.value)" autocomplete="off" '+(mode?'inputmode="'+mode+'" ':'')+'placeholder="'+ph+'" aria-describedby="'+id+'H" style="width:100%;height:48px;margin-top:10px;border:0;border-radius:14px;background:var(--chip);color:var(--tx);padding:0 16px;font:inherit;font-size:16px">';
const _s=screens.svc;
screens.svc=()=>{if(S.lang!=='en'||S.svk!=='family')return _s();
 const f=S.fm,ch=f.role==='child',pm=phMsg(),m=miss();
 const roles=[['child','A child','You are their guardian. You see their spending and set their weekly limit.'],['guardian','A guardian','They can see your spending, read-only.']].map(r=>'<div class="row tap" role="radio" aria-checked="'+(f.role===r[0])+'" tabindex="0" onclick="famRole(\''+r[0]+'\')" style="padding:12px 24px;'+(f.role===r[0]?'background:var(--tint)':'')+'"><div style="width:22px;height:22px;border-radius:11px;border:2px solid '+(f.role===r[0]?'var(--lk)':'var(--ln)')+';display:flex;align-items:center;justify-content:center;flex:none">'+(f.role===r[0]?'<div style="width:10px;height:10px;border-radius:5px;background:var(--lk)"></div>':'')+'</div><div style="flex:1"><div class="t">'+r[1]+'</div><div class="s">'+r[2]+'</div></div></div>').join('');
 const list=S.fam.length?lab('Your family')+S.fam.map((x,i)=>'<div class="row" style="cursor:default;padding:12px 24px"><div class="ico" style="font-size:14px;font-weight:800">'+esc(x.n.split(/\s+/).map(w=>w[0]).join('').slice(0,2).toUpperCase())+'</div><div style="flex:1;min-width:0"><div class="t">'+esc(x.n)+'</div><div class="s">'+(x.role==='child'?'Child \u00b7 limit '+fmt(x.lim)+' RWF a week':'Guardian')+' \u00b7 '+fmtP(x.ph)+'<br>Invite sent, waiting for them</div></div><button class="sm" style="background:none;border:0;color:var(--er);font-weight:700;padding:8px 0 8px 8px" onclick="famAsk('+i+')">Cancel</button></div>').join(''):'';
 return bar('Family')+'<div style="padding:22px 24px 0"><div class="h1">Link your family</div><div class="mu" style="font-size:15px;line-height:22px;margin-top:8px">Link a guardian or a child. Guardians see spending, read-only.</div></div>'+list+
 lab('Who are you linking?')+'<div role="radiogroup" style="padding-top:6px">'+roles+'</div>'+
 '<div style="padding:0 24px">'+lab('Their name').replace('padding:22px 24px 0','padding:22px 0 0')+inp('fN',f.n,'Their first name','famName')+lab('Their phone number').replace('padding:22px 24px 0','padding:22px 0 0')+inp('fP',f.ph,'078 123 4567','famPh','tel')+'<div id="fPH" class="sm" style="margin-top:8px;color:'+(pm.er?'var(--er)':pm.ok?'var(--ok)':'var(--mu)')+'" aria-live="polite">'+pm.t+'</div></div>'+
 (ch?lab('Weekly spending limit')+'<div style="display:flex;gap:10px;flex-wrap:wrap;padding:10px 24px 0" role="group">'+[1000,3000,5000].map(v=>chipB(f.lim===v,'famLim('+v+')',fmt(v)+' RWF')).join('')+'</div><div class="pad sm mu" style="padding-top:8px">You can change it later.</div>':'')+
 '<div class="pad fine" style="padding-top:18px">They see a request the next time they open itunda. Sample data.</div><div style="height:100px"></div><div class="cta"><button class="btn" id="fGo" style="white-space:nowrap" '+(m?'disabled ':'')+'onclick="famReview()">'+(nm().length>=2?'Send invite to '+esc(nm()):'Send invite')+'</button><div id="fW" class="sm mu" style="text-align:center;margin-top:8px">'+m+'</div></div>'};
window.famRole=r=>{S.fm.role=r;render('fade-none')};
window.famLim=v=>{S.fm.lim=v;render('fade-none')};
const upd=()=>{const pm=phMsg(),m=miss(),b=document.getElementById('fGo'),w=document.getElementById('fW'),h=document.getElementById('fPH');
 if(b){b.disabled=!!m;b.textContent=nm().length>=2?'Send invite to '+nm():'Send invite'}if(w)w.textContent=m;
 if(h){h.textContent=pm.t;h.style.color=pm.er?'var(--er)':pm.ok?'var(--ok)':'var(--mu)'}};
window.famName=v=>{S.fm.n=v;upd()};
window.famPh=v=>{S.fm.ph=v;upd()};
const sheet=(h,body,note,no,yes,go)=>{$('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="h1" style="font-size:22px;line-height:30px;margin-top:4px">'+h+'</div><div style="margin:12px 0 '+(note?'12':'20')+'px">'+body+'</div>'+(note?'<div class="mu sm" style="margin-bottom:16px;line-height:20px">'+note+'</div>':'')+'<div class="row2" style="display:grid;grid-template-columns:1fr 1.8fr"><button class="btn sec2" onclick="closeSheet()">'+no+'</button><button class="btn" style="white-space:nowrap" onclick="'+go+'">'+yes+'</button></div></div>';if(typeof focusSheet==='function')focusSheet()};
window.famReview=()=>{if(miss())return;const f=S.fm,ch=f.role==='child';
 sheet('Send an invite to '+esc(nm())+'?',R('Linking',ch?'A child':'A guardian')+R('Name',esc(nm()))+R('Phone',fmtP(dg(f.ph)))+(ch?R('Weekly limit',fmt(f.lim)+' RWF'):'')+R(ch?'You can see':'They can see',ch?'Their spending, read-only':'Your spending, read-only'),'They get a request the next time they open itunda. You can cancel it until they accept.','Cancel','Send invite','famGo()')};
window.famGo=()=>{if(miss())return;const f=S.fm,n=nm();S.fam.push({n,ph:dg(f.ph),role:f.role,lim:f.lim});S.fm={role:f.role,n:'',ph:'',lim:f.lim};closeSheet();render('fade-none');toast('Invite sent to '+n)};
window.famAsk=i=>{const x=S.fam[i];if(!x)return;sheet('Cancel the invite to '+esc(x.n)+'?',R('Phone',fmtP(x.ph))+R('Linking',x.role==='child'?'A child':'A guardian'),'','Keep it','Cancel invite','famDel('+i+')')};
window.famDel=i=>{const x=S.fam[i];if(!x)return;S.fam.splice(i,1);closeSheet();render('fade-none');toast('Invite to '+x.n+' cancelled')};
document.title='itunda, clickable prototype v207';
})();
</script>
<script>
/* v208: 31-day savings. Before: "Start saving" only said the feature was not ready, the page showed a made-up "12-day streak" that never changed, and you could not pick an amount, so nothing was saved and the bonus could not be earned. Now: "How much each day?" with 200 / 500 / 1,000 / 2,000 RWF to tap and a live line (31 days x amount = total, and your itunda Bank balance, or a plain reason when it is too low); the four bonus steps (7, 14, 21, 31 days) listed under it; a review before the first save with the terms and a button that names the amount ("Save 500 RWF now"). After starting, the page shows your real streak ("Day 3 of 31"), what you have saved, the bonus you have now and how many days to the next step, and either "Save 500 RWF for today" or "Today is done". Each save takes the money from itunda Bank and adds a row to Activity. Day 31 offers "Collect" with the bonus added; you can stop any time and take your savings back (no bonus). Two small prototype-only buttons let you jump to tomorrow, or skip a day to see the streak restart. English only; fr/rw copy untouched. */
(function(){
const R=(a,v)=>'<div style="display:flex;justify-content:space-between;gap:12px;min-height:40px;align-items:center;font-size:15px;border-top:0"><span class="mu">'+a+'</span><b style="text-align:right">'+v+'</b></div>';
const TI=[[7,2],[14,4],[21,6],[31,10]],AM=[200,500,1000,2000];
const fresh=p=>({on:0,a:p||500,n:0,t:0,d:0,pick:p||500});
const st=()=>S.dsv31=S.dsv31||fresh();
const rate=n=>{let r=0;TI.forEach(([d,p])=>{if(n>=d)r=p});return r};
const nextT=n=>TI.find(([d])=>n<d);
const tiers=n=>'<div style="margin-top:8px">'+TI.map(([d,p])=>'<div style="display:flex;justify-content:space-between;min-height:44px;align-items:center;font-size:15px;border-top:0"><span class="'+(n>=d?'':'mu')+'" style="display:flex;align-items:center;gap:8px">'+(n>=d?ic('check',16,'var(--lk)'):'')+'Day '+d+'</span><b>'+p+'% bonus</b></div>').join('')+'</div>';
const dots=n=>'<div style="display:flex;flex-wrap:wrap;gap:8px" role="img" aria-label="'+n+' of 31 days saved">'+Array.from({length:31},(_,i)=>'<div style="width:18px;height:18px;border-radius:9px;background:'+(i<n?'var(--br)':'var(--chip)')+'"></div>').join('')+'</div>';
const chip=(v,on,fn)=>'<button class="chip" aria-pressed="'+on+'" onclick="'+fn+'('+v+')" style="min-width:64px;height:44px;border-radius:22px;border:0;padding:0 14px;font-size:15px;font-weight:800;background:'+(on?'var(--tx)':'var(--chip)')+';color:'+(on?'var(--bg)':'var(--tx)')+'">'+fmt(v)+'</button>';
const sheet=(h,body,note,no,yes,go)=>{$('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="h1" style="font-size:22px;line-height:30px;margin-top:4px">'+h+'</div><div style="margin:12px 0 '+(note?'12':'20')+'px">'+body+'</div>'+(note?'<div class="mu sm" style="margin-bottom:16px;line-height:20px">'+note+'</div>':'')+'<div class="row2" style="display:grid;grid-template-columns:1fr 1.8fr"><button class="btn sec2" onclick="closeSheet()">'+no+'</button><button class="btn" style="white-space:nowrap" onclick="'+go+'">'+yes+'</button></div></div>';if(typeof focusSheet==='function')focusSheet()};
const _o=screens.save31;
screens.save31=()=>{if(S.lang!=='en')return _o();
 const s=st(),H=bar('31-day savings');
 if(!s.on){
  const a=s.pick,bad=a>S.bank;
  return H+'<div class="pad" style="padding-top:24px"><div class="h1">Save a little every day for 31 days</div><div class="mu" style="font-size:16px;margin-top:12px;line-height:24px">Pick an amount you can save each day. The longer your streak, the higher your bonus, up to 10%.</div></div>'+
  '<div style="font-size:16px;font-weight:800;padding:28px 24px 0">How much each day?</div><div style="padding:12px 24px 0"><div style="display:flex;gap:10px;flex-wrap:wrap" role="group" aria-label="Daily amount">'+AM.map(v=>chip(v,v===a,'s31Pick')).join('')+'</div>'+
  '<div class="sm" style="margin-top:12px;line-height:20px" aria-live="polite">'+(bad?'<span style="color:var(--er)">This is more than your itunda Bank balance of '+fmt(S.bank)+' RWF. Pick a smaller amount.</span>':'<span class="mu">31 days \u00d7 '+fmt(a)+' = <b style="color:var(--tx)">'+fmt(a*31)+' RWF</b> \u00b7 itunda Bank balance '+fmt(S.bank)+' RWF</span>')+'</div></div>'+
  '<div style="font-size:16px;font-weight:800;padding:28px 24px 0">Your bonus grows with your streak</div><div class="pad">'+tiers(0)+'</div>'+
  '<div class="pad fine" style="padding-top:14px;line-height:18px">Save once a day. If you miss a day, your streak starts again at day 1. What you saved stays yours. Rates are sample data. itunda Bank is not a licensed bank.</div><div style="height:100px"></div>'+
  '<div class="cta"><button class="btn" style="white-space:nowrap" '+(bad?'disabled ':'')+'onclick="s31Ask()">Save '+fmt(a)+' RWF to start</button></div>';
 }
 const n=s.n,a=s.a,r=rate(n),nx=nextT(n);
 if(n>=31){
  const b=Math.round(s.t*r/100);
  return H+'<div class="pad" style="padding-top:24px"><div class="h1">You made it: 31 days in a row</div><div class="mu" style="font-size:16px;margin-top:12px;line-height:24px">You saved '+fmt(s.t)+' RWF and earned a '+r+'% bonus of '+fmt(b)+' RWF.</div></div><div class="pad" style="padding-top:28px">'+dots(31)+'</div><div class="pad" style="padding-top:20px">'+R('Your savings',fmt(s.t)+' RWF')+R('Bonus ('+r+'%)','+'+fmt(b)+' RWF')+R('You get',fmt(s.t+b)+' RWF')+'</div><div style="height:100px"></div><div class="cta"><button class="btn" style="white-space:nowrap" onclick="s31CollectAsk()">Collect '+fmt(s.t+b)+' RWF</button></div>';
 }
 const bad=a>S.bank;
 return H+'<div class="pad" style="padding-top:24px"><div class="sm mu" style="font-weight:700">Your streak</div><div class="h1" style="margin-top:4px">'+(n?'Day '+n+' of 31':'Start again today')+'</div><div class="mu" style="font-size:16px;margin-top:10px;line-height:24px">'+(n?'Saved so far <b style="color:var(--tx)">'+fmt(s.t)+' RWF</b> \u00b7 bonus now '+r+'%':'You missed a day, so your streak restarted. You still have <b style="color:var(--tx)">'+fmt(s.t)+' RWF</b> saved.')+'</div></div>'+
 '<div class="pad" style="padding-top:24px">'+dots(n)+'<div class="sm mu" style="margin-top:12px;line-height:20px">'+(nx?'Next bonus: '+nx[1]+'% at day '+nx[0]+' \u00b7 '+(nx[0]-n)+' day'+(nx[0]-n===1?'':'s')+' to go':'')+'</div></div>'+
 '<div class="pad" style="padding-top:20px"><div style="padding:16px 18px;border-radius:20px;background:var(--chip);font-size:15px;line-height:22px;font-weight:700" aria-live="polite">'+(s.d?'Today is done. Come back tomorrow to keep your streak going.':bad?'<span style="color:var(--er)">Your itunda Bank balance is '+fmt(S.bank)+' RWF, which is less than '+fmt(a)+' RWF.</span>':'Today: save '+fmt(a)+' RWF to '+(n?'reach day '+(n+1):'begin day 1')+'.')+'</div></div>'+
 '<div style="font-size:16px;font-weight:800;padding:28px 24px 0">Bonus by streak</div><div class="pad">'+tiers(n)+'</div>'+
 '<div class="pad" style="padding-top:20px"><button onclick="s31StopAsk()" style="border:0;background:none;padding:0;min-height:44px;color:var(--lk);font-weight:700;font-size:15px">Stop and take back '+fmt(s.t)+' RWF</button><div class="fine" style="margin-top:2px">You will not get the bonus if you stop before day 31.</div></div>'+
 '<div class="pad" style="padding-top:12px"><div class="fine" style="margin-bottom:4px">Prototype only</div>'+(s.d?'<button class="chip" onclick="s31Day(1)" style="height:44px;border-radius:22px;border:0;padding:0 16px;font-size:14px;font-weight:700;background:var(--chip);color:var(--tx)">Go to tomorrow</button>':'<button class="chip" onclick="s31Day(0)" style="height:44px;border-radius:22px;border:0;padding:0 16px;font-size:14px;font-weight:700;background:var(--chip);color:var(--tx)">Skip today and restart the streak</button>')+'</div><div style="height:100px"></div>'+
 '<div class="cta"><button class="btn" style="white-space:nowrap" '+(s.d||bad?'disabled ':'')+'onclick="s31Ask()">'+(s.d?'Saved today':'Save '+fmt(a)+' RWF for today')+'</button></div>';
};
window.s31Pick=v=>{st().pick=v;render('fade-none')};
window.s31Ask=()=>{const s=st(),a=s.on?s.a:s.pick;if(a>S.bank||(s.on&&s.d))return;
 if(!s.on)return sheet('Start your 31-day streak?',R('Each day',fmt(a)+' RWF')+R('First save','Today')+R('Total after 31 days',fmt(a*31)+' RWF')+R('Paid from','itunda Bank')+R('Bank balance after',fmt(S.bank-a)+' RWF'),'Save once a day. If you miss a day, your streak starts again at day 1.','Cancel','Save '+fmt(a)+' RWF now','s31Go()');
 sheet('Save '+fmt(a)+' RWF for day '+(s.n+1)+'?',R('Streak after',(s.n+1)+' of 31 days')+R('Saved after',fmt(s.t+a)+' RWF')+R('Paid from','itunda Bank')+R('Bank balance after',fmt(S.bank-a)+' RWF'),'','Cancel','Save '+fmt(a)+' RWF','s31Go()')};
window.s31Go=()=>{const s=st(),a=s.on?s.a:s.pick;if(a>S.bank||(s.on&&s.d))return;
 s.a=a;s.on=1;s.n++;s.t+=a;s.d=1;S.bank-=a;addAct('coin','31-day savings \u00b7 Day '+s.n,'Saved',-a,'Sent');closeSheet();render('fade-none');
 toast(s.n===31?'Day 31 done. Your bonus is ready.':'Day '+s.n+' saved. See you tomorrow.');if(s.n===31)setTimeout(confetti,200)};
window.s31Day=k=>{const s=st();if(k){s.d=0}else{s.n=0;s.d=0}render('fade-none');toast(k?'It is a new day.':'Streak restarted at day 1.')};
window.s31StopAsk=()=>{const s=st();sheet('Stop and take back '+fmt(s.t)+' RWF?',R('Your savings',fmt(s.t)+' RWF')+R('Bonus','None before day 31')+R('Goes to','itunda Bank')+R('Bank balance after',fmt(S.bank+s.t)+' RWF'),'You can start a new 31-day streak any time.','Keep saving','Take back '+fmt(s.t)+' RWF','s31Stop()')};
window.s31Stop=()=>{const s=st(),t=s.t;S.bank+=t;addAct('up','31-day savings \u00b7 Taken back','Received',t,'Received');S.dsv31=fresh(s.a);closeSheet();render('fade-none');toast(fmt(t)+' RWF is back in itunda Bank')};
window.s31CollectAsk=()=>{const s=st(),b=Math.round(s.t*rate(s.n)/100);sheet('Collect '+fmt(s.t+b)+' RWF?',R('Your savings',fmt(s.t)+' RWF')+R('Bonus ('+rate(s.n)+'%)','+'+fmt(b)+' RWF')+R('Goes to','itunda Bank')+R('Bank balance after',fmt(S.bank+s.t+b)+' RWF'),'','Not now','Collect '+fmt(s.t+b)+' RWF','s31Collect()')};
window.s31Collect=()=>{const s=st(),b=Math.round(s.t*rate(s.n)/100),g=s.t+b;S.bank+=g;addAct('up','31-day savings \u00b7 Paid out','Received',g,'Received');S.dsv31=fresh(s.a);closeSheet();render('fade-none');toast(fmt(g)+' RWF added to itunda Bank');setTimeout(confetti,200)};
document.title='itunda, clickable prototype v208';
})();
</script>
<script>
/* v210: Fix: Settings showed "Send limits NaN RWF" and no daily-limit chip was selected, because the Bank transfer limit is stored as S.lim.day and Settings read S.lim.d (and S.lim.a, the PIN threshold, did not exist). Both names now point at the same value, so changing the limit in Settings also changes what Bank transfers allow, and the PIN threshold starts at 50,000 RWF. (v209 also rewired Support, Help, Verification and the link statistics; those were already wired, so that part is removed again.) */
(function(){
if(S.lim){if(!Object.getOwnPropertyDescriptor(S.lim,'d'))Object.defineProperty(S.lim,'d',{get(){return this.day},set(v){this.day=v},enumerable:false,configurable:true});if(S.lim.a===undefined)S.lim.a=50000}
document.title='itunda, clickable prototype v210';
})();
</script>
<script>
/* v211: Fix: on the Bank page, Payees, Scheduled transfers, Budget and Report a problem (and any other row that opens a Bank sub-page) did nothing since v205. The intercity bus booking added a second function named bkGo, which replaced the Bank page's bkGo(page) that opens those sub-pages. bkGo now opens the Bank page when it is given a page name and books the bus when it is not, so both work. */
(function(){
const bus=window.bkGo;
window.bkGo=function(n){if(typeof n==='string'){S.stack.push(n);render('push');return}return typeof bus==='function'?bus.apply(this,arguments):undefined};
if(typeof bkGo!=='undefined'&&bkGo!==window.bkGo){try{bkGo=window.bkGo}catch(e){}}
document.title='itunda, clickable prototype v211';
})();
</script>
<script>/* v212: Fix: the Security page stored the passkey switch in S.pk, the same place your pockets are kept. Turning the passkey on or off replaced every pocket (and its balance) with 0 or 1, and the Pockets page then failed to open. The passkey now has its own flag (S.pkey). */document.title='itunda, clickable prototype v212';</script><script>/* v213: Fix: Pay > Buy airtime showed "Buy NaN RWF" with no network or amount chosen, because the airtime sheet kept its choices in S.at, the same place the Auto-transfer list is kept. The airtime sheet now has its own state (S.atm), starting at MTN and 1,000 RWF. */document.title='itunda, clickable prototype v213';</script><script>/* v214: Fix: the shop product quantity and the property listing form both used S.pq, so opening a product while a listing was half filled (or the other way round) mixed them up. The listing form now has its own state (S.pqf). */document.title='itunda, clickable prototype v214';</script><script>
/* v215: Auto-transfer. Before: "New auto-transfer" added the same fixed row every time (Interest jar, 2,000 RWF, every Monday) without asking anything, rows could only be paused (no way to remove or see details), and nothing explained when the first transfer happens. Now: a page with three plain questions in order ("Where should it go?" with your pockets, "How much each time?" with 1,000 / 5,000 / 10,000 / 20,000 RWF to tap, "How often?" every day, week or month), one sentence that updates as you choose ("Every week, we move 5,000 RWF from itunda Pay to Emergency fund. First transfer: tomorrow."), a review before it is set up, and a button that names what it does. Each row shows where the money goes and when the next transfer is, opens a sheet to pause, resume or delete it (with a confirmation), and an empty state replaces the blank page when none are left. English only; fr/rw copy untouched. */
(function(){
const R=(a,v)=>'<div style="display:flex;justify-content:space-between;gap:12px;min-height:40px;align-items:center;font-size:15px;border-top:0"><span class="mu">'+a+'</span><b style="text-align:right">'+v+'</b></div>';
const AM=[1000,5000,10000,20000],FR=['day','week','month'];
const nw=()=>S.atn=S.atn||{p:'jar',a:5000,f:'week'};
const pk=()=>(Array.isArray(S.pk)?S.pk:[]);
const pn=id=>{const p=pk().find(x=>x.id===id);return p?p.n:'Interest jar'};
const tm=()=>{const d=new Date();d.setDate(d.getDate()+1);return d};
const WD=['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
const ord=n=>n+(n%10===1&&n!==11?'st':n%10===2&&n!==12?'nd':n%10===3&&n!==13?'rd':'th');
const freq=f=>f==='day'?'Every day':f==='week'?'Every '+WD[tm().getDay()]:'Monthly on the '+ord(tm().getDate());
const sentence=n=>(n.f==='day'?'Every day':n.f==='week'?'Every week':'Every month')+', we move '+fmt(n.a)+' RWF from itunda Pay to '+pn(n.p)+'. First transfer: tomorrow.';
const chip=(l,on,fn)=>'<button class="chip" aria-pressed="'+on+'" onclick="'+fn+'" style="min-width:64px;height:44px;border-radius:22px;border:0;padding:0 16px;font-size:15px;font-weight:800;background:'+(on?'var(--tx)':'var(--chip)')+';color:'+(on?'var(--bg)':'var(--tx)')+'">'+l+'</button>';
const sheet=(h,body,note,no,yes,go)=>{$('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="h1" style="font-size:22px;line-height:30px;margin-top:4px">'+h+'</div><div style="margin:12px 0 '+(note?'12':'20')+'px">'+body+'</div>'+(note?'<div class="mu sm" style="margin-bottom:16px;line-height:20px">'+note+'</div>':'')+'<div class="row2" style="display:grid;grid-template-columns:1fr 1.8fr"><button class="btn sec2" onclick="closeSheet()">'+no+'</button><button class="btn" style="white-space:nowrap" onclick="'+go+'">'+yes+'</button></div></div>';if(typeof focusSheet==='function')focusSheet()};
const _a=screens.autot;
screens.autot=()=>{if(S.lang!=='en')return _a();
 const H=bar('Auto-transfer'),L=S.at;
 const rows=L.map((a,i)=>'<div class="row" role="button" tabindex="0" onclick="atOpen('+i+')" style="padding:12px 24px"><div class="ico">'+a[0]+'</div><div style="flex:1;min-width:0"><div class="t" style="opacity:'+(a[4]?1:.5)+'">'+a[1]+'</div><div class="s">'+a[3]+' RWF \u00b7 '+a[2]+(a[4]?'':' \u00b7 Paused')+'</div></div><div class="sw '+(a[4]?'on':'')+'" role="switch" aria-checked="'+!!a[4]+'" aria-label="'+a[1]+'" tabindex="0" onclick="event.stopPropagation();atTg('+i+')"><i></i></div></div>').join('');
 return H+'<div class="pad fine" style="padding-top:16px;line-height:18px">Money moves on its own from your itunda Pay balance. If the balance is too low on the day, we skip that transfer and try again next time.</div>'+(L.length?rows:'<div class="pad" style="padding-top:40px;text-align:center"><div class="h1" style="font-size:20px;line-height:28px">No auto-transfers yet</div><div class="mu" style="font-size:15px;margin-top:8px;line-height:22px">Pick a pocket, an amount and how often. We move the money for you.</div></div>')+'<div style="height:100px"></div><div class="cta"><button class="btn" onclick="atNew()">New auto-transfer</button></div>'};
screens.atnew=()=>{const n=nw(),P=pk(),bad=n.a>S.pay;
 return bar('New auto-transfer')+'<div class="pad" style="padding-top:20px"><div class="h1">Save automatically</div></div>'+
 '<div style="font-size:16px;font-weight:800;padding:24px 24px 0">Where should it go?</div><div style="padding:12px 24px 0;display:flex;gap:10px;flex-wrap:wrap" role="group" aria-label="Where it goes">'+P.map(p=>chip(p.n,p.id===n.p,"atP('"+p.id+"')")).join('')+'</div>'+
 '<div style="font-size:16px;font-weight:800;padding:24px 24px 0">How much each time?</div><div style="padding:12px 24px 0;display:flex;gap:10px;flex-wrap:wrap" role="group" aria-label="Amount">'+AM.map(v=>chip(fmt(v),v===n.a,'atA('+v+')')).join('')+'</div>'+
 '<div style="font-size:16px;font-weight:800;padding:24px 24px 0">How often?</div><div style="padding:12px 24px 0;display:flex;gap:10px;flex-wrap:wrap" role="group" aria-label="How often">'+FR.map(f=>chip(f==='day'?'Every day':f==='week'?'Every week':'Every month',f===n.f,"atF('"+f+"')")).join('')+'</div>'+
 '<div style="margin:24px 24px 0;padding:16px 18px;border-radius:20px;background:var(--chip);font-size:15px;line-height:22px;font-weight:700" aria-live="polite">'+sentence(n)+'</div>'+
 (bad?'<div class="sm" style="padding:12px 24px 0;color:var(--er);line-height:20px">Your itunda Pay balance is '+fmt(S.pay)+' RWF today, so the first transfer would be skipped. You can still set it up.</div>':'')+
 '<div style="height:100px"></div><div class="cta"><button class="btn" style="white-space:nowrap" onclick="atAsk()">Set up auto-transfer</button></div>'};
window.atNew=()=>{if(S.lang!=='en'||!Array.isArray(S.pk)){S.at.push(['🪙','Interest jar','Every Monday','2,000',1]);toast('Auto-transfer added');render('fade-none');return}
 S.atn={p:'jar',a:5000,f:'week'};S.stack.push('atnew');render('push')};
window.atP=id=>{nw().p=id;render('fade-none')};window.atA=v=>{nw().a=v;render('fade-none')};window.atF=f=>{nw().f=f;render('fade-none')};
window.atAsk=()=>{const n=nw();sheet('Set up this auto-transfer?',R('Money goes to',pn(n.p))+R('Each time',fmt(n.a)+' RWF')+R('How often',freq(n.f))+R('First transfer','Tomorrow')+R('Taken from','itunda Pay'),'You can pause or delete it any time from this page.','Cancel','Set up '+fmt(n.a)+' RWF '+(n.f==='day'?'daily':n.f==='week'?'weekly':'monthly'),'atGo()')};
window.atGo=()=>{const n=nw();S.at.push([n.p==='jar'?'🪙':'🎯',pn(n.p),freq(n.f),fmt(n.a),1]);closeSheet();S.stack.pop();render('pop');toast('Auto-transfer set up. First one is tomorrow.')};
window.atOpen=i=>{const a=S.at[i];if(!a)return;
 $('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="h1" style="font-size:22px;line-height:30px;margin-top:4px">'+a[1]+'</div><div style="margin:12px 0 20px">'+R('Each time',a[3]+' RWF')+R('How often',a[2])+R('Status',a[4]?'On':'Paused')+R('Taken from','itunda Pay')+'</div><div class="row2" style="display:grid;grid-template-columns:1fr 1fr"><button class="btn sec2" onclick="atTg('+i+');closeSheet()">'+(a[4]?'Pause':'Resume')+'</button><button class="btn sec2" style="color:var(--er)" onclick="atDelAsk('+i+')">Delete</button></div></div>';if(typeof focusSheet==='function')focusSheet()};
window.atDelAsk=i=>{const a=S.at[i];if(!a)return;sheet('Delete this auto-transfer?',R('Money goes to',a[1])+R('Each time',a[3]+' RWF')+R('How often',a[2]),'Money already moved stays where it is. Nothing else changes.','Keep it','Delete','atDel('+i+')')};
window.atDel=i=>{const a=S.at[i];if(!a)return;S.at.splice(i,1);closeSheet();render('fade-none');toast('Auto-transfer to '+a[1]+' deleted')};
document.title='itunda, clickable prototype v215';
})();
</script>
<style>/* v216: contrast. Red text (errors, "Due in", "Remove", discount %, "left") was 3.1 to 4.4 : 1 and is now 4.5 : 1 or more in both themes (a lighter red in dark mode; red badges keep their own fixed red so white text on them stays readable). Green "Open" and "Seats" were 3.1 : 1 on white and are now a deeper green in light mode. White bus numbers on the route green were 3.5 : 1; the route green is deeper. */
@media (prefers-color-scheme:dark){:root:not([data-theme=light]){--er:#FF6B5E}}:root[data-theme=dark]{--er:#FF6B5E}
#phone [style*="color:#2BA84A"],#phone .lv{color:#0B7A4B!important}
@media (prefers-color-scheme:dark){:root:not([data-theme=light]) #phone [style*="color:#2BA84A"],:root:not([data-theme=light]) #phone .lv{color:#2BA84A!important}}
:root[data-theme=dark] #phone [style*="color:#2BA84A"],:root[data-theme=dark] #phone .lv{color:#2BA84A!important}
</style><script>document.title='itunda, clickable prototype v216';/* v217: Auto-transfer in French and Kinyarwanda. v215 switched its new flow off for anything but English: in fr/rw "New auto-transfer" still added the same fixed row (Interest jar, 2,000 RWF, every Monday) without asking, rows could not be opened, paused or deleted from a sheet, and the page text was half English. The whole flow now works in all three languages: the list and its empty state, the three questions (where, how much, how often) with the sentence that updates as you choose, the low-balance note, the review sheet, the row sheet (pause, resume, delete) and the delete confirmation. Choosing a pocket, amount or frequency no longer sends the page back to the top (it did in every language), and the chips are a little tighter so the four amounts always share one row. Pocket names and frequencies in the list follow the language (Interest jar, Emergency fund, School fees; "Every Friday", "1st of each month"). English wording is unchanged. fr is new copy; rw is new copy and, like v166, needs native review, especially the weekday forms (buri wa gatanu), "tuzimura ... dukuye kuri" and "Kohereza bwa mbere". */
(function(){
const t3=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e,nb=s=>S.lang==='fr'?s.replace(/ ([?:!])/g,'\u00a0$1'):s;
const R=(a,v)=>'<div style="display:flex;justify-content:space-between;gap:12px;min-height:40px;align-items:center;font-size:15px;border-top:0"><span class="mu">'+a+'</span><b style="text-align:right">'+v+'</b></div>';
const AM=[1000,5000,10000,20000],FR=['day','week','month'];
const nw=()=>S.atn=S.atn||{p:'jar',a:5000,f:'week'};
const pk=()=>(Array.isArray(S.pk)?S.pk:[]);
const PN={'Interest jar':['Agasanduku k’inyungu','Tirelire à intérêts'],'Emergency fund':['Amafaranga y’ihutirwa','Fonds d’urgence'],'School fees':['Amafaranga y’ishuri','Frais de scolarité'],'School fees goal':['Intego y’amafaranga y’ishuri','Objectif frais de scolarité'],'Rent':['Ubukode','Loyer']};
const nl=n=>{const x=PN[n];return x?t3(n,x[0],x[1]):n};
const pn=id=>{const p=pk().find(x=>x.id===id);return p?p.n:'Interest jar'};
const pnl=id=>nl(pn(id));
const tm=()=>{const d=new Date();d.setDate(d.getDate()+1);return d};
const WD=['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
const WF=['dimanche','lundi','mardi','mercredi','jeudi','vendredi','samedi'],WR=['cyumweru','wa mbere','wa kabiri','wa gatatu','wa kane','wa gatanu','wa gatandatu'];
const ord=n=>n+(n%10===1&&n!==11?'st':n%10===2&&n!==12?'nd':n%10===3&&n!==13?'rd':'th');
const freq=f=>f==='day'?'Every day':f==='week'?'Every '+WD[tm().getDay()]:'Monthly on the '+ord(tm().getDate());
const freqL=s=>{if(S.lang==='en'||typeof s!=='string')return s;let m;
 if(s==='Every day')return t3(s,'Buri munsi','Tous les jours');
 if(m=s.match(/^Every (Sunday|Monday|Tuesday|Wednesday|Thursday|Friday|Saturday)$/)){const i=WD.indexOf(m[1]);return t3(s,'Buri '+WR[i],'Chaque '+WF[i])}
 if(m=s.match(/^Monthly on the (\d+)(?:st|nd|rd|th)$/))return t3(s,'Buri kwezi, ku itariki '+m[1],'Chaque mois, le '+(m[1]==='1'?'1er':m[1]));
 if(m=s.match(/^(\d+)(?:st|nd|rd|th) of each month$/))return t3(s,'Ku itariki '+m[1]+' buri kwezi','Le '+(m[1]==='1'?'1er':m[1])+' de chaque mois');
 return s};
const fq=f=>{const k=FR.indexOf(f);return t3(['Every day','Every week','Every month'][k],['Buri munsi','Buri cyumweru','Buri kwezi'][k],['Tous les jours','Chaque semaine','Chaque mois'][k])};
const sentence=n=>{const x=fmt(n.a),p=pnl(n.p),a=fq(n.f);return nb(t3(a+', we move '+x+' RWF from itunda Pay to '+p+'. First transfer: tomorrow.',a+', tuzimura '+x+' RWF dukuye kuri itunda Pay tujya muri '+p+'. Kohereza bwa mbere: ejo.',a+', nous déplaçons '+x+' RWF depuis itunda Pay vers '+p+'. Premier virement : demain.'))};
const chip=(l,on,fn)=>'<button class="chip" aria-pressed="'+on+'" onclick="'+fn+'" style="min-width:60px;height:44px;border-radius:22px;border:0;padding:0 14px;font-size:15px;font-weight:800;background:'+(on?'var(--tx)':'var(--chip)')+';color:'+(on?'var(--bg)':'var(--tx)')+'">'+l+'</button>';
const sheet=(h,body,note,no,yes,go)=>{$('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="h1" style="font-size:22px;line-height:30px;margin-top:4px">'+h+'</div><div style="margin:12px 0 '+(note?'12':'20')+'px">'+body+'</div>'+(note?'<div class="mu sm" style="margin-bottom:16px;line-height:20px">'+note+'</div>':'')+'<div class="row2" style="display:grid;grid-template-columns:1fr 1.8fr"><button class="btn sec2" onclick="closeSheet()">'+no+'</button><button class="btn" style="white-space:nowrap" onclick="'+go+'">'+yes+'</button></div></div>';if(typeof focusSheet==='function')focusSheet()};
const T=()=>t3('Auto-transfer','Kohereza byikora','Virement automatique'),TN=()=>t3('New auto-transfer','Kohereza byikora bishya','Nouveau virement automatique');
const CANCEL=()=>t3('Cancel','Reka','Annuler');
screens.autot=()=>{
 const H=bar(T()),L=S.at;
 const rows=L.map((a,i)=>'<div class="row" role="button" tabindex="0" onclick="atOpen('+i+')" style="padding:12px 24px"><div class="ico">'+a[0]+'</div><div style="flex:1;min-width:0"><div class="t" style="opacity:'+(a[4]?1:.5)+'">'+nl(a[1])+'</div><div class="s">'+a[3]+' RWF \u00b7 '+freqL(a[2])+(a[4]?'':' \u00b7 '+t3('Paused','Byahagaritswe','En pause'))+'</div></div><div class="sw '+(a[4]?'on':'')+'" role="switch" aria-checked="'+!!a[4]+'" aria-label="'+nl(a[1])+'" tabindex="0" onclick="event.stopPropagation();atTg('+i+')"><i></i></div></div>').join('');
 return H+'<div class="pad fine" style="padding-top:16px;line-height:18px">'+t3('Money moves on its own from your itunda Pay balance. If the balance is too low on the day, we skip that transfer and try again next time.','Amafaranga ava ku mafaranga yawe ya itunda Pay yikoresha. Iyo asigaye ari make uwo munsi, ntitwohereza tukongera kugerageza ubutaha.','L’argent part tout seul de votre solde itunda Pay. Si le solde est trop bas ce jour-là, nous sautons ce virement et réessayons la fois suivante.')+'</div>'+(L.length?rows:'<div class="pad" style="padding-top:40px;text-align:center"><div class="h1" style="font-size:20px;line-height:28px">'+t3('No auto-transfers yet','Nta kohereza byikora kurimo','Aucun virement automatique')+'</div><div class="mu" style="font-size:15px;margin-top:8px;line-height:22px">'+t3('Pick a pocket, an amount and how often. We move the money for you.','Hitamo agasanduku, umubare n’inshuro. Tuzohereza amafaranga ku bwawe.','Choisissez une cagnotte, un montant et une fréquence. Nous déplaçons l’argent pour vous.')+'</div></div>')+'<div style="height:100px"></div><div class="cta"><button class="btn" onclick="atNew()">'+TN()+'</button></div>'};
screens.atnew=()=>{const n=nw(),P=pk(),bad=n.a>S.pay,H2='font-size:16px;font-weight:800;padding:24px 24px 0';
 return bar(t3('New auto-transfer','Kohereza byikora bishya','Nouveau virement'))+'<div class="pad" style="padding-top:20px"><div class="h1">'+t3('Save automatically','Bika byikora','Épargne automatique')+'</div></div>'+
 '<div style="'+H2+'">'+nb(t3('Where should it go?','Amafaranga ajye he?','Où doit aller l’argent ?'))+'</div><div style="padding:12px 24px 0;display:flex;gap:8px;flex-wrap:wrap" role="group" aria-label="'+t3('Where it goes','Aho ajya','Destination')+'">'+P.map(p=>chip(nl(p.n),p.id===n.p,"atP('"+p.id+"')")).join('')+'</div>'+
 '<div style="'+H2+'">'+nb(t3('How much each time?','Angahe buri gihe?','Combien à chaque fois ?'))+'</div><div style="padding:12px 24px 0;display:grid;grid-template-columns:repeat(4,1fr);gap:8px" role="group" aria-label="'+t3('Amount','Umubare','Montant')+'">'+AM.map(v=>chip(fmt(v),v===n.a,'atA('+v+')').replace('min-width:60px','min-width:0').replace('padding:0 14px','padding:0')).join('')+'</div>'+
 '<div style="'+H2+'">'+nb(t3('How often?','Kangahe?','À quelle fréquence ?'))+'</div><div style="padding:12px 24px 0;display:flex;gap:8px;flex-wrap:wrap" role="group" aria-label="'+t3('How often','Inshuro','Fréquence')+'">'+FR.map(f=>chip(fq(f),f===n.f,"atF('"+f+"')")).join('')+'</div>'+
 '<div style="margin:24px 24px 0;padding:16px 18px;border-radius:20px;background:var(--chip);font-size:15px;line-height:22px;font-weight:700" aria-live="polite">'+sentence(n)+'</div>'+
 (bad?'<div class="sm" style="padding:12px 24px 0;color:var(--er);line-height:20px">'+t3('Your itunda Pay balance is '+fmt(S.pay)+' RWF today, so the first transfer would be skipped. You can still set it up.','Amafaranga yawe kuri itunda Pay ni '+fmt(S.pay)+' RWF uyu munsi, bityo kohereza bwa mbere ntibyakorwa. Ushobora kubitegura nubwo bimeze bityo.','Votre solde itunda Pay est de '+fmt(S.pay)+' RWF aujourd’hui : le premier virement serait ignoré. Vous pouvez quand même le programmer.')+'</div>':'')+
 '<div style="height:100px"></div><div class="cta"><button class="btn" style="white-space:nowrap" onclick="atAsk()">'+t3('Set up auto-transfer','Tegura kohereza byikora','Programmer le virement')+'</button></div>'};
window.atNew=()=>{if(!Array.isArray(S.pk)){S.at.push(['🪙','Interest jar','Every Monday','2,000',1]);toast(t3('Auto-transfer added','Kohereza byikora byongewe','Virement automatique ajouté'));render('fade-none');return}
 S.atn={p:'jar',a:5000,f:'week'};S.stack.push('atnew');render('push')};
const keep=fn=>{const sc=document.querySelector('#phone .screen'),y=sc?sc.scrollTop:0;fn();const s2=document.querySelector('#phone .screen');if(s2)s2.scrollTop=y};
window.atP=id=>{nw().p=id;keep(()=>render('fade-none'))};window.atA=v=>{nw().a=v;keep(()=>render('fade-none'))};window.atF=f=>{nw().f=f;keep(()=>render('fade-none'))};
window.atAsk=()=>{const n=nw(),x=fmt(n.a);sheet(nb(t3('Set up this auto-transfer?','Utegure uku kohereza byikora?','Programmer ce virement automatique ?')),
 R(t3('Money goes to','Amafaranga ajya','Destination'),pnl(n.p))+R(t3('Each time','Buri gihe','À chaque fois'),x+' RWF')+R(t3('How often','Inshuro','Fréquence'),freqL(freq(n.f)))+R(t3('First transfer','Kohereza bwa mbere','Premier virement'),t3('Tomorrow','Ejo','Demain'))+R(t3('Taken from','Ava kuri','Prélevé sur'),'itunda Pay'),
 t3('You can pause or delete it any time from this page.','Ushobora kuwuhagarika cyangwa kuwusiba igihe icyo ari cyo cyose kuri uru rupapuro.','Vous pouvez le suspendre ou le supprimer à tout moment depuis cette page.'),CANCEL(),
 t3('Set up '+x+' RWF '+(n.f==='day'?'daily':n.f==='week'?'weekly':'monthly'),'Tegura '+x+' RWF','Programmer '+x+' RWF'),'atGo()')};
window.atGo=()=>{const n=nw();S.at.push([n.p==='jar'?'🪙':'🎯',pn(n.p),freq(n.f),fmt(n.a),1]);closeSheet();S.stack.pop();render('pop');toast(t3('Auto-transfer set up. First one is tomorrow.','Kohereza byikora byateguwe. Icya mbere ni ejo.','Virement automatique programmé. Le premier a lieu demain.'))};
window.atOpen=i=>{const a=S.at[i];if(!a)return;
 $('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="h1" style="font-size:22px;line-height:30px;margin-top:4px">'+nl(a[1])+'</div><div style="margin:12px 0 20px">'+R(t3('Each time','Buri gihe','À chaque fois'),a[3]+' RWF')+R(t3('How often','Inshuro','Fréquence'),freqL(a[2]))+R(t3('Status','Imimerere','Statut'),a[4]?t3('On','Birakora','Activé'):t3('Paused','Byahagaritswe','En pause'))+R(t3('Taken from','Ava kuri','Prélevé sur'),'itunda Pay')+'</div><div class="row2" style="display:grid;grid-template-columns:1fr 1fr"><button class="btn sec2" onclick="atTg('+i+');closeSheet()">'+(a[4]?t3('Pause','Hagarika','Suspendre'):t3('Resume','Komeza','Reprendre'))+'</button><button class="btn sec2" style="color:var(--er)" onclick="atDelAsk('+i+')">'+t3('Delete','Siba','Supprimer')+'</button></div></div>';if(typeof focusSheet==='function')focusSheet()};
window.atDelAsk=i=>{const a=S.at[i];if(!a)return;sheet(nb(t3('Delete this auto-transfer?','Usibe uku kohereza byikora?','Supprimer ce virement automatique ?')),R(t3('Money goes to','Amafaranga ajya','Destination'),nl(a[1]))+R(t3('Each time','Buri gihe','À chaque fois'),a[3]+' RWF')+R(t3('How often','Inshuro','Fréquence'),freqL(a[2])),t3('Money already moved stays where it is. Nothing else changes.','Amafaranga yamaze koherezwa aguma aho ari. Nta kindi gihinduka.','L’argent déjà transféré reste où il est. Rien d’autre ne change.'),t3('Keep it','Yigumane','Le garder'),t3('Delete','Siba','Supprimer'),'atDel('+i+')')};
window.atDel=i=>{const a=S.at[i];if(!a)return;S.at.splice(i,1);closeSheet();render('fade-none');toast(t3('Auto-transfer to '+a[1]+' deleted','Kohereza byikora kuri '+nl(a[1])+' kwasibwe','Virement automatique vers '+nl(a[1])+' supprimé'))};
document.title='itunda, clickable prototype v217';
})();
</script><script>
/* v218: 31-day savings in French and Kinyarwanda. v208 rebuilt this page, but only for English: in fr/rw the old page came back (English text, a fixed 500 RWF a day, a "0.0%" bonus, no choice of amount, no review, and the new bonus steps, stop and collect were out of reach). The whole v208 flow now works in all three languages with the same behaviour: "How much each day?" with 200 / 500 / 1,000 / 2,000 RWF and a live line (31 days x amount = total, or a plain reason when your itunda Bank balance is too low); the four bonus steps (7, 14, 21, 31 days); the review before the first save; "Day 3 of 31" with what you saved and the bonus you have now; stop and take back; collect after day 31; and every toast. Activity rows for it (for example "31-day savings · Day 3", "Saved") now follow the language too. Tapping an amount no longer sends the page back to the top. English wording is unchanged. fr is new copy; rw is new copy and, like v166 and v217, needs native review, especially "iminsi ukurikiranya" (streak), "igihembo" (bonus) and "Zigama" (save). */
(function(){
const t3=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e,nb=s=>S.lang==='fr'?s.replace(/ ([?:!%])/g,'\u00a0$1'):s;
const R=(a,v)=>'<div style="display:flex;justify-content:space-between;gap:12px;min-height:40px;align-items:center;font-size:15px;border-top:0"><span class="mu">'+a+'</span><b style="text-align:right">'+v+'</b></div>';
const TI=[[7,2],[14,4],[21,6],[31,10]],AM=[200,500,1000,2000];
const fresh=p=>({on:0,a:p||500,n:0,t:0,d:0,pick:p||500});
const st=()=>S.dsv31=S.dsv31||fresh();
const rate=n=>{let r=0;TI.forEach(([d,p])=>{if(n>=d)r=p});return r};
const nextT=n=>TI.find(([d])=>n<d);
const keep=fn=>{const sc=document.querySelector('#phone .screen'),y=sc?sc.scrollTop:0;fn();const s2=document.querySelector('#phone .screen');if(s2)s2.scrollTop=y};
const tiers=n=>'<div style="margin-top:8px">'+TI.map(([d,p])=>'<div style="display:flex;justify-content:space-between;min-height:44px;align-items:center;font-size:15px;border-top:0"><span class="'+(n>=d?'':'mu')+'" style="display:flex;align-items:center;gap:8px">'+(n>=d?ic('check',16,'var(--lk)'):'')+t3('Day '+d,'Umunsi wa '+d,'Jour '+d)+'</span><b>'+nb(t3(p+'% bonus','Igihembo cya '+p+'%','Bonus de '+p+' %'))+'</b></div>').join('')+'</div>';
const dots=n=>'<div style="display:flex;flex-wrap:wrap;gap:8px" role="img" aria-label="'+t3(n+' of 31 days saved',n+' kuri 31 zazigamwe',n+' jours sur 31 épargnés')+'">'+Array.from({length:31},(_,i)=>'<div style="width:18px;height:18px;border-radius:9px;background:'+(i<n?'var(--br)':'var(--chip)')+'"></div>').join('')+'</div>';
const chip=(v,on,fn)=>'<button class="chip" aria-pressed="'+on+'" onclick="'+fn+'('+v+')" style="min-width:64px;height:44px;border-radius:22px;border:0;padding:0 14px;font-size:15px;font-weight:800;background:'+(on?'var(--tx)':'var(--chip)')+';color:'+(on?'var(--bg)':'var(--tx)')+'">'+fmt(v)+'</button>';
const sheet=(h,body,note,no,yes,go)=>{$('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="h1" style="font-size:22px;line-height:30px;margin-top:4px">'+nb(h)+'</div><div style="margin:12px 0 '+(note?'12':'20')+'px">'+body+'</div>'+(note?'<div class="mu sm" style="margin-bottom:16px;line-height:20px">'+nb(note)+'</div>':'')+'<div class="row2" style="display:grid;grid-template-columns:1fr 1.8fr"><button class="btn sec2" onclick="closeSheet()">'+no+'</button><button class="btn" style="white-space:nowrap" onclick="'+go+'">'+yes+'</button></div></div>';if(typeof focusSheet==='function')focusSheet()};
const CANCEL=()=>t3('Cancel','Reka','Annuler');
const BANK='itunda Bank';
const H2='font-size:16px;font-weight:800;padding:28px 24px 0';
const T=()=>t3('31-day savings','Kuzigama iminsi 31','Épargne sur 31 jours');
const L={
 paid:()=>t3('Paid from','Ava kuri','Prélevé sur'),
 goes:()=>t3('Goes to','Ajya kuri','Destination'),
 after:()=>t3('Bank balance after','Asigaye kuri Bank','Solde Bank après'),
 yours:()=>t3('Your savings','Ibyo wazigamye','Votre épargne')
};
const save=a=>t3('Save '+fmt(a)+' RWF','Zigama '+fmt(a)+' RWF','Épargner '+fmt(a)+' RWF');
screens.save31=()=>{
 const s=st(),H=bar(T());
 if(!s.on){
  const a=s.pick,bad=a>S.bank;
  return H+'<div class="pad" style="padding-top:24px"><div class="h1">'+nb(t3('Save a little every day for 31 days','Zigama gake buri munsi mu minsi 31','Épargnez un peu chaque jour pendant 31 jours'))+'</div><div class="mu" style="font-size:16px;margin-top:12px;line-height:24px">'+nb(t3('Pick an amount you can save each day. The longer your streak, the higher your bonus, up to 10%.','Hitamo amafaranga ushobora kuzigama buri munsi. Uko iminsi ukurikiranya iba myinshi, ni ko igihembo cyiyongera, kugeza kuri 10%.','Choisissez un montant que vous pouvez épargner chaque jour. Plus votre série est longue, plus votre bonus est élevé, jusqu’à 10 %.'))+'</div></div>'+
  '<div style="'+H2+'">'+nb(t3('How much each day?','Ni angahe buri munsi?','Combien chaque jour ?'))+'</div><div style="padding:12px 24px 0"><div style="display:flex;gap:10px;flex-wrap:wrap" role="group" aria-label="'+t3('Daily amount','Amafaranga ya buri munsi','Montant par jour')+'">'+AM.map(v=>chip(v,v===a,'s31Pick')).join('')+'</div>'+
  '<div class="sm" style="margin-top:12px;line-height:20px" aria-live="polite">'+(bad?'<span style="color:var(--er)">'+t3('This is more than your itunda Bank balance of '+fmt(S.bank)+' RWF. Pick a smaller amount.','Ni menshi kurusha amafaranga ufite kuri itunda Bank angana na '+fmt(S.bank)+' RWF. Hitamo make kurushaho.','C’est plus que le solde de votre itunda Bank, qui est de '+fmt(S.bank)+' RWF. Choisissez un montant plus petit.')+'</span>':'<span class="mu">'+t3('31 days \u00d7 '+fmt(a)+' = <b style="color:var(--tx)">'+fmt(a*31)+' RWF</b> \u00b7 itunda Bank balance '+fmt(S.bank)+' RWF','Iminsi 31 \u00d7 '+fmt(a)+' = <b style="color:var(--tx)">'+fmt(a*31)+' RWF</b> \u00b7 amafaranga kuri itunda Bank '+fmt(S.bank)+' RWF','31 jours \u00d7 '+fmt(a)+' = <b style="color:var(--tx)">'+fmt(a*31)+' RWF</b> \u00b7 solde itunda Bank '+fmt(S.bank)+' RWF')+'</span>')+'</div></div>'+
  '<div style="'+H2+'">'+t3('Your bonus grows with your streak','Igihembo cyawe kiyongera uko iminsi ukurikiranya yiyongera','Votre bonus grandit avec votre série')+'</div><div class="pad">'+tiers(0)+'</div>'+
  '<div class="pad fine" style="padding-top:14px;line-height:18px">'+nb(t3('Save once a day. If you miss a day, your streak starts again at day 1. What you saved stays yours. Rates are sample data. itunda Bank is not a licensed bank.','Zigama rimwe ku munsi. Nusiba umunsi, uzongera gutangira ku munsi wa 1. Ibyo wazigamye bikomeza kuba ibyawe. Ibipimo ni ibyo kugerageza. itunda Bank si banki ifite uruhushya.','Épargnez une fois par jour. Si vous manquez un jour, votre série repart au jour 1. Ce que vous avez épargné reste à vous. Les taux sont des données d’exemple. itunda Bank n’est pas une banque agréée.'))+'</div><div style="height:100px"></div>'+
  '<div class="cta"><button class="btn" style="white-space:nowrap" '+(bad?'disabled ':'')+'onclick="s31Ask()">'+t3('Save '+fmt(a)+' RWF to start','Zigama '+fmt(a)+' RWF utangire','Commencer avec '+fmt(a)+' RWF')+'</button></div>';
 }
 const n=s.n,a=s.a,r=rate(n),nx=nextT(n);
 if(n>=31){
  const b=Math.round(s.t*r/100);
  return H+'<div class="pad" style="padding-top:24px"><div class="h1">'+nb(t3('You made it: 31 days in a row','Wabikoze: iminsi 31 ikurikiranye','Bravo : 31 jours d’affilée'))+'</div><div class="mu" style="font-size:16px;margin-top:12px;line-height:24px">'+nb(t3('You saved '+fmt(s.t)+' RWF and earned a '+r+'% bonus of '+fmt(b)+' RWF.','Wazigamye '+fmt(s.t)+' RWF kandi wabonye igihembo cya '+r+'% cya '+fmt(b)+' RWF.','Vous avez épargné '+fmt(s.t)+' RWF et gagné un bonus de '+r+' % : '+fmt(b)+' RWF.'))+'</div></div><div class="pad" style="padding-top:28px">'+dots(31)+'</div><div class="pad" style="padding-top:20px">'+R(L.yours(),fmt(s.t)+' RWF')+R(nb(t3('Bonus ('+r+'%)','Igihembo ('+r+'%)','Bonus ('+r+' %)')),'+'+fmt(b)+' RWF')+R(t3('You get','Uhawe','Vous recevez'),fmt(s.t+b)+' RWF')+'</div><div style="height:100px"></div><div class="cta"><button class="btn" style="white-space:nowrap" onclick="s31CollectAsk()">'+t3('Collect '+fmt(s.t+b)+' RWF','Akira '+fmt(s.t+b)+' RWF','Récupérer '+fmt(s.t+b)+' RWF')+'</button></div>';
 }
 const bad=a>S.bank,k=nx?nx[0]-n:0;
 return H+'<div class="pad" style="padding-top:24px"><div class="sm mu" style="font-weight:700">'+t3('Your streak','Iminsi ukurikiranya','Votre série')+'</div><div class="h1" style="margin-top:4px">'+(n?t3('Day '+n+' of 31','Umunsi wa '+n+' kuri 31','Jour '+n+' sur 31'):t3('Start again today','Ongera utangire uyu munsi','Recommencez aujourd’hui'))+'</div><div class="mu" style="font-size:16px;margin-top:10px;line-height:24px">'+(n?nb(t3('Saved so far <b style="color:var(--tx)">'+fmt(s.t)+' RWF</b> \u00b7 bonus now '+r+'%','Wamaze kuzigama <b style="color:var(--tx)">'+fmt(s.t)+' RWF</b> \u00b7 igihembo ubu ni '+r+'%','Épargné jusqu’ici <b style="color:var(--tx)">'+fmt(s.t)+' RWF</b> \u00b7 bonus actuel '+r+' %')):nb(t3('You missed a day, so your streak restarted. You still have <b style="color:var(--tx)">'+fmt(s.t)+' RWF</b> saved.','Wasibye umunsi, bityo iminsi ukurikiranya yongeye gutangira. Ugifite <b style="color:var(--tx)">'+fmt(s.t)+' RWF</b> wazigamye.','Vous avez manqué un jour : votre série repart de zéro. Vous gardez <b style="color:var(--tx)">'+fmt(s.t)+' RWF</b> d’épargne.')))+'</div></div>'+
 '<div class="pad" style="padding-top:24px">'+dots(n)+'<div class="sm mu" style="margin-top:12px;line-height:20px">'+(nx?nb(t3('Next bonus: '+nx[1]+'% at day '+nx[0]+' \u00b7 '+k+' day'+(k===1?'':'s')+' to go','Igihembo gikurikira: '+nx[1]+'% ku munsi wa '+nx[0]+' \u00b7 '+(k===1?'hasigaye umunsi 1':'hasigaye iminsi '+k),'Prochain bonus : '+nx[1]+' % au jour '+nx[0]+' \u00b7 encore '+k+' jour'+(k===1?'':'s'))):'')+'</div></div>'+
 '<div class="pad" style="padding-top:20px"><div style="padding:16px 18px;border-radius:20px;background:var(--chip);font-size:15px;line-height:22px;font-weight:700" aria-live="polite">'+(s.d?nb(t3('Today is done. Come back tomorrow to keep your streak going.','Uyu munsi urarangiye. Garuka ejo ukomeze.','C’est fait pour aujourd’hui. Revenez demain pour continuer votre série.')):bad?'<span style="color:var(--er)">'+nb(t3('Your itunda Bank balance is '+fmt(S.bank)+' RWF, which is less than '+fmt(a)+' RWF.','Amafaranga ufite kuri itunda Bank ni '+fmt(S.bank)+' RWF, make kurusha '+fmt(a)+' RWF.','Le solde de votre itunda Bank est de '+fmt(S.bank)+' RWF, soit moins que '+fmt(a)+' RWF.'))+'</span>':nb(t3('Today: save '+fmt(a)+' RWF to '+(n?'reach day '+(n+1):'begin day 1')+'.','Uyu munsi: zigama '+fmt(a)+' RWF '+(n?'ugere ku munsi wa '+(n+1):'utangire umunsi wa 1')+'.','Aujourd’hui : épargnez '+fmt(a)+' RWF '+(n?'pour atteindre le jour '+(n+1):'pour commencer le jour 1')+'.')))+'</div></div>'+
 '<div style="'+H2+'">'+t3('Bonus by streak','Igihembo ku minsi ukurikiranya','Bonus selon la série')+'</div><div class="pad">'+tiers(n)+'</div>'+
 '<div class="pad" style="padding-top:20px"><button onclick="s31StopAsk()" style="border:0;background:none;padding:0;min-height:44px;color:var(--lk);font-weight:700;font-size:15px;text-align:left">'+t3('Stop and take back '+fmt(s.t)+' RWF','Hagarika usubirane '+fmt(s.t)+' RWF','Arrêter et récupérer '+fmt(s.t)+' RWF')+'</button><div class="fine" style="margin-top:2px">'+t3('You will not get the bonus if you stop before day 31.','Utazabona igihembo nuhagarara mbere y’umunsi wa 31.','Vous n’aurez pas le bonus si vous arrêtez avant le jour 31.')+'</div></div>'+
 '<div class="pad" style="padding-top:12px"><div class="fine" style="margin-bottom:4px">'+t3('Prototype only','Prototype gusa','Prototype uniquement')+'</div>'+(s.d?'<button class="chip" onclick="s31Day(1)" style="height:44px;border-radius:22px;border:0;padding:0 16px;font-size:14px;font-weight:700;background:var(--chip);color:var(--tx)">'+t3('Go to tomorrow','Jya ku munsi w’ejo','Passer à demain')+'</button>':'<button class="chip" onclick="s31Day(0)" style="height:44px;border-radius:22px;border:0;padding:0 16px;font-size:14px;font-weight:700;background:var(--chip);color:var(--tx)">'+t3('Skip today and restart the streak','Simbuka uyu munsi wongere utangire','Sauter aujourd’hui et repartir de zéro')+'</button>')+'</div><div style="height:100px"></div>'+
 '<div class="cta"><button class="btn" style="white-space:nowrap" '+(s.d||bad?'disabled ':'')+'onclick="s31Ask()">'+(s.d?t3('Saved today','Byazigamwe uyu munsi','Épargné aujourd’hui'):t3('Save '+fmt(a)+' RWF for today','Zigama '+fmt(a)+' RWF uyu munsi','Épargner '+fmt(a)+' RWF aujourd’hui'))+'</button></div>';
};
window.s31Pick=v=>{st().pick=v;keep(()=>render('fade-none'))};
window.s31Ask=()=>{const s=st(),a=s.on?s.a:s.pick;if(a>S.bank||(s.on&&s.d))return;
 if(!s.on)return sheet(t3('Start your 31-day streak?','Utangire iminsi 31 ukurikiranya?','Commencer votre série de 31 jours ?'),R(t3('Each day','Buri munsi','Chaque jour'),fmt(a)+' RWF')+R(t3('First save','Kuzigama bwa mbere','Premier versement'),t3('Today','Uyu munsi','Aujourd’hui'))+R(t3('Total after 31 days','Yose nyuma y’iminsi 31','Total après 31 jours'),fmt(a*31)+' RWF')+R(L.paid(),BANK)+R(L.after(),fmt(S.bank-a)+' RWF'),t3('Save once a day. If you miss a day, your streak starts again at day 1.','Zigama rimwe ku munsi. Nusiba umunsi, uzongera gutangira ku munsi wa 1.','Épargnez une fois par jour. Si vous manquez un jour, votre série repart au jour 1.'),CANCEL(),t3('Save '+fmt(a)+' RWF now','Zigama '+fmt(a)+' RWF ubu','Épargner '+fmt(a)+' RWF'),'s31Go()');
 sheet(t3('Save '+fmt(a)+' RWF for day '+(s.n+1)+'?','Zigama '+fmt(a)+' RWF ku munsi wa '+(s.n+1)+'?','Épargner '+fmt(a)+' RWF pour le jour '+(s.n+1)+' ?'),R(t3('Streak after','Iminsi ukurikiranya nyuma','Série après'),t3((s.n+1)+' of 31 days',(s.n+1)+' kuri 31',(s.n+1)+' jours sur 31'))+R(t3('Saved after','Ibyazigamwe nyuma','Épargne après'),fmt(s.t+a)+' RWF')+R(L.paid(),BANK)+R(L.after(),fmt(S.bank-a)+' RWF'),'',CANCEL(),save(a),'s31Go()')};
window.s31Go=()=>{const s=st(),a=s.on?s.a:s.pick;if(a>S.bank||(s.on&&s.d))return;
 s.a=a;s.on=1;s.n++;s.t+=a;s.d=1;S.bank-=a;addAct('coin','31-day savings \u00b7 Day '+s.n,'Saved',-a,'Sent');closeSheet();render('fade-none');
 toast(s.n===31?t3('Day 31 done. Your bonus is ready.','Umunsi wa 31 urarangiye. Igihembo cyawe kiruzuye.','Jour 31 terminé. Votre bonus est prêt.'):t3('Day '+s.n+' saved. See you tomorrow.','Umunsi wa '+s.n+' wazigamwe. Tuzabonana ejo.','Jour '+s.n+' enregistré. À demain.'));if(s.n===31)setTimeout(confetti,200)};
window.s31Day=k=>{const s=st();if(k){s.d=0}else{s.n=0;s.d=0}render('fade-none');toast(k?t3('It is a new day.','Ni undi munsi mushya.','C’est un nouveau jour.'):t3('Streak restarted at day 1.','Iminsi ukurikiranya yongeye gutangira ku munsi wa 1.','Série redémarrée au jour 1.'))};
window.s31StopAsk=()=>{const s=st();sheet(t3('Stop and take back '+fmt(s.t)+' RWF?','Uhagarike usubirane '+fmt(s.t)+' RWF?','Arrêter et récupérer '+fmt(s.t)+' RWF ?'),R(L.yours(),fmt(s.t)+' RWF')+R(t3('Bonus','Igihembo','Bonus'),t3('None before day 31','Nta na kimwe mbere y’umunsi wa 31','Aucun avant le jour 31'))+R(L.goes(),BANK)+R(L.after(),fmt(S.bank+s.t)+' RWF'),t3('You can start a new 31-day streak any time.','Ushobora gutangira indi minsi 31 igihe icyo ari cyo cyose.','Vous pouvez commencer une nouvelle série de 31 jours à tout moment.'),t3('Keep saving','Komeza kuzigama','Continuer'),t3('Take back '+fmt(s.t)+' RWF','Subirana '+fmt(s.t)+' RWF','Récupérer '+fmt(s.t)+' RWF'),'s31Stop()')};
window.s31Stop=()=>{const s=st(),t=s.t;S.bank+=t;addAct('up','31-day savings \u00b7 Taken back','Received',t,'Received');S.dsv31=fresh(s.a);closeSheet();render('fade-none');toast(t3(fmt(t)+' RWF is back in itunda Bank',fmt(t)+' RWF yagarutse kuri itunda Bank',fmt(t)+' RWF sont de retour dans itunda Bank'))};
window.s31CollectAsk=()=>{const s=st(),b=Math.round(s.t*rate(s.n)/100);sheet(t3('Collect '+fmt(s.t+b)+' RWF?','Wakire '+fmt(s.t+b)+' RWF?','Récupérer '+fmt(s.t+b)+' RWF ?'),R(L.yours(),fmt(s.t)+' RWF')+R(nb(t3('Bonus ('+rate(s.n)+'%)','Igihembo ('+rate(s.n)+'%)','Bonus ('+rate(s.n)+' %)')),'+'+fmt(b)+' RWF')+R(L.goes(),BANK)+R(L.after(),fmt(S.bank+s.t+b)+' RWF'),'',t3('Not now','Ntibyakorwe ubu','Pas maintenant'),t3('Collect '+fmt(s.t+b)+' RWF','Akira '+fmt(s.t+b)+' RWF','Récupérer '+fmt(s.t+b)+' RWF'),'s31Collect()')};
window.s31Collect=()=>{const s=st(),b=Math.round(s.t*rate(s.n)/100),g=s.t+b;S.bank+=g;addAct('up','31-day savings \u00b7 Paid out','Received',g,'Received');S.dsv31=fresh(s.a);closeSheet();render('fade-none');toast(t3(fmt(g)+' RWF added to itunda Bank',fmt(g)+' RWF yongewe kuri itunda Bank',fmt(g)+' RWF ajoutés à itunda Bank'));setTimeout(confetti,200)};
/* Activity rows keep their English text in the store; the four screens that list them already pass through tr26, so the 31-day wording is translated there. */
const _tr=window.tr26;
window.tr26=h=>{if(S.lang==='rw'||S.lang==='fr'){const rw=S.lang==='rw';
 h=h.replace(/31-day savings \u00b7 (Day (\d+)|Taken back|Paid out)/g,(a,x,n)=>(rw?'Kuzigama iminsi 31':'Épargne sur 31 jours')+' \u00b7 '+(n?(rw?'Umunsi wa '+n:'Jour '+n):x==='Taken back'?(rw?'Byasubijwe':'Récupéré'):(rw?'Byishyuwe':'Versé')))
  .replace(/>Saved \u00b7 Just now</g,rw?'>Byabitswe \u00b7 Ubu nyine<':'>Épargné \u00b7 À l\'instant<')}
 return typeof _tr==='function'?_tr(h):h};
document.title='itunda, clickable prototype v218';
})();
</script>
<script>
/* v219: Family in French and Kinyarwanda. v207 rebuilt "Link your family" for English only, so in fr/rw the old page came back: English text, no name or phone number to type, no choice between a child and a guardian, no weekly limit, no review and no list of invites. The whole v207 flow now works in all three languages with the same rules: "Who are you linking?" with one line on what each can see; their name and phone number as typed fields with a live count ("7 of 10 digits") and messages for a number that does not start with 07 or was already invited; the weekly limit for a child (1,000 / 3,000 / 5,000 RWF); a button that names the person ("Inviter Aline", "Tumira Aline") and a line saying what is missing while it is off; the review before sending; "Your family" with each invite; and Cancel invite with a confirmation. English is untouched (it still runs v207's own code). fr is new copy; rw is new copy and, like v166, v217 and v218, needs native review, especially "umurera" (guardian), "ntarengwa" (limit) and "ubutumire" (invitation). */
(function(){
const t3=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e,nb=s=>S.lang==='fr'?s.replace(/ ([?:!%])/g,'\u00a0$1'):s;
const R=(a,v)=>'<div style="display:flex;justify-content:space-between;gap:12px;min-height:40px;align-items:center;font-size:15px;border-top:0"><span class="mu">'+a+'</span><b style="text-align:right">'+v+'</b></div>';
const esc=x=>String(x).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
S.fam=S.fam||[];S.fm=S.fm||{role:'child',n:'',ph:'',lim:3000};
const dg=v=>String(v||'').replace(/\D/g,'').slice(0,10);
const nm=()=>(S.fm.n||'').trim();
const dup=()=>S.fam.some(x=>x.ph===dg(S.fm.ph));
const phMsg=()=>{const d=dg(S.fm.ph);
 if(!d)return{t:t3('','Andika numero ya telefone ye, urugero 078 123 4567.','Saisissez son numéro, par exemple 078 123 4567.'),ok:0};
 if(d.length<10)return{t:t3('',d.length+' kuri 10',d.length+' chiffres sur 10'),ok:0};
 if(d.slice(0,2)!=='07')return{t:t3('','Numero za telefone z’u Rwanda zitangira kuri 07.','Les numéros mobiles rwandais commencent par 07.'),ok:0,er:1};
 if(dup())return{t:t3('','Waramaze gutumira iyi numero.','Vous avez déjà invité ce numéro.'),ok:0,er:1};
 return{t:t3('','Ni byiza.','C’est bon.'),ok:1}};
const miss=()=>nm().length<2?t3('','Andika izina rye kugira ngo ukomeze.','Saisissez son prénom pour continuer.'):(!phMsg().ok?t3('','Kosora numero ye kugira ngo ukomeze.','Corrigez son numéro pour continuer.'):'');
const fmtP=d=>d.replace(/^(\d{3})(\d{0,3})(\d{0,4}).*/,(m,a,b,c)=>[a,b,c].filter(Boolean).join(' '));
const lab=(t,pad)=>'<div style="font-size:16px;font-weight:800;padding:'+(pad||'22px 24px 0')+'">'+nb(t)+'</div>';
const chipB=(on,fn,txt)=>'<button class="chip" aria-pressed="'+on+'" onclick="'+fn+'" style="min-width:64px;height:44px;border-radius:22px;border:0;padding:0 16px;font-size:15px;font-weight:800;background:'+(on?'var(--tx)':'var(--chip)')+';color:'+(on?'var(--bg)':'var(--tx)')+'">'+txt+'</button>';
const inp=(id,v,ph,fn,mode)=>'<input id="'+id+'" value="'+esc(v)+'" oninput="'+fn+'(this.value)" autocomplete="off" '+(mode?'inputmode="'+mode+'" ':'')+'placeholder="'+ph+'" aria-describedby="'+id+'H" style="width:100%;height:48px;margin-top:10px;border:0;border-radius:14px;background:var(--chip);color:var(--tx);padding:0 16px;font:inherit;font-size:16px">';
const sheet=(h,body,note,no,yes,go)=>{$('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="h1" style="font-size:22px;line-height:30px;margin-top:4px">'+nb(h)+'</div><div style="margin:12px 0 '+(note?'12':'20')+'px">'+body+'</div>'+(note?'<div class="mu sm" style="margin-bottom:16px;line-height:20px">'+nb(note)+'</div>':'')+'<div class="row2" style="display:grid;grid-template-columns:1fr 1.8fr"><button class="btn sec2" onclick="closeSheet()">'+no+'</button><button class="btn" style="white-space:nowrap" onclick="'+go+'">'+yes+'</button></div></div>';if(typeof focusSheet==='function')focusSheet()};
const CANCEL=()=>t3('Cancel','Reka','Annuler');
const KIND=r=>r==='child'?t3('A child','Umwana','Un enfant'):t3('A guardian','Umurera','Un tuteur');
const sendTxt=()=>nm().length>=2?t3('','Tumira '+nm(),'Inviter '+nm()):t3('','Ohereza ubutumire','Envoyer l’invitation');
const _s=screens.svc;
screens.svc=()=>{if(S.lang==='en'||S.svk!=='family')return _s();
 const f=S.fm,ch=f.role==='child',pm=phMsg(),m=miss();
 const roles=[['child',KIND('child'),t3('','Uri umurera we. Ubona ibyo akoresha kandi ugena amafaranga ntarengwa y’icyumweru.','Vous êtes son tuteur. Vous voyez ses dépenses et fixez sa limite hebdomadaire.')],['guardian',KIND('guardian'),t3('','Ashobora kubona ibyo ukoresha, ntashobora kubihindura.','La personne invitée peut voir vos dépenses, en lecture seule.')]].map(r=>'<div class="row tap" role="radio" aria-checked="'+(f.role===r[0])+'" tabindex="0" onclick="famRole(\''+r[0]+'\')" style="padding:12px 24px;'+(f.role===r[0]?'background:var(--tint)':'')+'"><div style="width:22px;height:22px;border-radius:11px;border:2px solid '+(f.role===r[0]?'var(--lk)':'var(--ln)')+';display:flex;align-items:center;justify-content:center;flex:none">'+(f.role===r[0]?'<div style="width:10px;height:10px;border-radius:5px;background:var(--lk)"></div>':'')+'</div><div style="flex:1"><div class="t">'+r[1]+'</div><div class="s">'+nb(r[2])+'</div></div></div>').join('');
 const list=S.fam.length?lab(t3('','Umuryango wawe','Votre famille'))+S.fam.map((x,i)=>'<div class="row" style="cursor:default;padding:12px 24px"><div class="ico" style="font-size:14px;font-weight:800">'+esc(x.n.split(/\s+/).map(w=>w[0]).join('').slice(0,2).toUpperCase())+'</div><div style="flex:1;min-width:0"><div class="t">'+esc(x.n)+'</div><div class="s">'+(x.role==='child'?t3('','Umwana \u00b7 ntarengwa '+fmt(x.lim)+' RWF mu cyumweru','Enfant \u00b7 limite '+fmt(x.lim)+' RWF par semaine'):t3('','Umurera','Tuteur'))+' \u00b7 '+fmtP(x.ph)+'<br>'+t3('','Ubutumire bwoherejwe, butegereje igisubizo','Invitation envoyée, en attente')+'</div></div><button class="sm" style="background:none;border:0;color:var(--er);font-weight:700;padding:8px 0 8px 8px" onclick="famAsk('+i+')">'+CANCEL()+'</button></div>').join(''):'';
 return bar(t3('','Umuryango','Famille'))+'<div style="padding:22px 24px 0"><div class="h1">'+t3('','Huza umuryango wawe','Reliez votre famille')+'</div><div class="mu" style="font-size:15px;line-height:22px;margin-top:8px">'+t3('','Huza umurera cyangwa umwana. Abarera babona ibyakoreshejwe, badashobora kubihindura.','Reliez un tuteur ou un enfant. Les tuteurs voient les dépenses, en lecture seule.')+'</div></div>'+list+
 lab(t3('','Uhuza nde?','Qui reliez-vous ?'))+'<div role="radiogroup" style="padding-top:6px">'+roles+'</div>'+
 '<div style="padding:0 24px">'+lab(t3('','Izina rye','Son prénom'),'22px 0 0')+inp('fN',f.n,t3('','Izina rye rya mbere','Son prénom'),'famName')+lab(t3('','Numero ya telefone ye','Son numéro de téléphone'),'22px 0 0')+inp('fP',f.ph,'078 123 4567','famPh','tel')+'<div id="fPH" class="sm" style="margin-top:8px;color:'+(pm.er?'var(--er)':pm.ok?'var(--ok)':'var(--mu)')+'" aria-live="polite">'+nb(pm.t)+'</div></div>'+
 (ch?lab(t3('','Amafaranga ntarengwa y’icyumweru','Limite de dépenses par semaine'))+'<div style="display:flex;gap:10px;flex-wrap:wrap;padding:10px 24px 0" role="group">'+[1000,3000,5000].map(v=>chipB(f.lim===v,'famLim('+v+')',fmt(v)+' RWF')).join('')+'</div><div class="pad sm mu" style="padding-top:8px">'+t3('','Uzabihindura nyuma.','Vous pourrez la modifier plus tard.')+'</div>':'')+
 '<div class="pad fine" style="padding-top:18px">'+t3('','Azabona ubusabe ubutaha afunguye itunda. Amakuru yo kugerageza.','La personne invitée voit une demande à sa prochaine ouverture d’itunda. Données d’exemple.')+'</div><div style="height:100px"></div><div class="cta"><button class="btn" id="fGo" style="white-space:nowrap" '+(m?'disabled ':'')+'onclick="famReview()">'+sendTxt()+'</button><div id="fW" class="sm mu" style="text-align:center;margin-top:8px">'+m+'</div></div>'};
const upd=()=>{const pm=phMsg(),m=miss(),b=document.getElementById('fGo'),w=document.getElementById('fW'),h=document.getElementById('fPH');
 if(b){b.disabled=!!m;b.textContent=sendTxt()}if(w)w.textContent=m;
 if(h){h.textContent=pm.t;h.style.color=pm.er?'var(--er)':pm.ok?'var(--ok)':'var(--mu)'}};
const wrap=(name,fn)=>{const o=window[name];window[name]=function(){return S.lang==='en'&&typeof o==='function'?o.apply(this,arguments):fn.apply(this,arguments)}};
wrap('famName',v=>{S.fm.n=v;upd()});
wrap('famPh',v=>{S.fm.ph=v;upd()});
wrap('famReview',()=>{if(miss())return;const f=S.fm,ch=f.role==='child';
 sheet(t3('','Wohereze ubutumire kuri '+esc(nm())+'?','Envoyer une invitation à '+esc(nm())+' ?'),R(t3('','Uhuza','Vous reliez'),KIND(f.role))+R(t3('','Izina','Prénom'),esc(nm()))+R(t3('','Telefone','Téléphone'),fmtP(dg(f.ph)))+(ch?R(t3('','Ntarengwa y’icyumweru','Limite hebdomadaire'),fmt(f.lim)+' RWF'):'')+R(ch?t3('','Ubona','Vous pouvez voir'):t3('','Ashobora kubona','Peut voir'),ch?t3('','Ibyo akoresha, ntashobora kubihindura','Ses dépenses, en lecture seule'):t3('','Ibyo ukoresha, ntashobora kubihindura','Vos dépenses, en lecture seule')),t3('','Azabona ubusabe ubutaha afunguye itunda. Ushobora kubuhagarika kugeza igihe azabwemera.','La personne invitée reçoit une demande à sa prochaine ouverture d’itunda. Vous pouvez l’annuler tant qu’elle n’a pas accepté.'),CANCEL(),t3('','Ohereza','Envoyer'),'famGo()')});
wrap('famGo',()=>{if(miss())return;const f=S.fm,n=nm();S.fam.push({n,ph:dg(f.ph),role:f.role,lim:f.lim});S.fm={role:f.role,n:'',ph:'',lim:f.lim};closeSheet();render('fade-none');toast(t3('','Ubutumire bwoherejwe kuri '+n,'Invitation envoyée à '+n))});
wrap('famAsk',i=>{const x=S.fam[i];if(!x)return;sheet(t3('','Uhagarike ubutumire bwa '+esc(x.n)+'?','Annuler l’invitation à '+esc(x.n)+' ?'),R(t3('','Telefone','Téléphone'),fmtP(x.ph))+R(t3('','Uhuza','Vous reliez'),KIND(x.role)),'',t3('','Bugumane','La garder'),t3('','Hagarika','Annuler'),'famDel('+i+')')});
wrap('famDel',i=>{const x=S.fam[i];if(!x)return;S.fam.splice(i,1);closeSheet();render('fade-none');toast(t3('','Ubutumire bwa '+x.n+' bwahagaritswe','Invitation à '+x.n+' annulée'))});
document.title='itunda, clickable prototype v219';
})();
</script>
<script>
/* v223: Home is quieter. The Money manager card (v220 to v222) and the \"Free delivery on your first order / View\" banner are both removed from Home, so Home goes from balances straight to spending, the bill and pockets. The Money manager page itself is still in the file but has no way in from Home for now; the offer is still found in itunda Eats and in the Bank screen. */
/* v222: Home row for the Money manager, Toss style. The row used to look like any other line in the list (plain grey text and a thin arrow), so it was easy to miss and looked like part of the spending row under it. It is now its own soft purple card at the top of the first card: a round white icon, a small purple label (\"Money manager\"), today's suggestion as a bold headline that can use two lines (long French and Kinyarwanda headlines no longer get cut), and a purple arrow. Whole card is one tap target (44 px icon, 16 px padding) and works in light and dark. Same behaviour as v221: it follows the first suggestion still visible and disappears when none is left. No new text. */
/* v221: Money manager, "Not now" and a Back that stays in the manager. Each suggestion now has a quiet "Not now" (fr "Pas maintenant", rw "Si ubu") that hides it for this visit: the next suggestion shows, the Money manager row on Home follows (it shows the first suggestion still visible, and goes away when none is left), and when every suggestion is hidden the page says "All clear" with one link, "Show hidden suggestions (2)", to bring them back. Hidden suggestions are not remembered after a reload (sample data). Also fixed: "Pay 18,500 RWF" used to throw the Money manager out of the Back path (Back went to Home); it now goes back to the manager like Fill pocket does. rw "Si ubu" and "Inama zahishwe" (hidden suggestions) are new copy and need native review, like v166 and v217 to v220. Not in this version: typing or speaking a request, and remembering what you hide. */
/* v220: Money manager. A new page that looks at your own numbers (itunda Pay balance, the bill due on Friday, your monthly auto-transfers, your pockets and your spending) and shows ONE next step at a time: a plain headline, two sentences with the numbers, why you are seeing it, and one button that opens the screen that already does the job (Pay the bill, Add money, Fill a pocket), where you still confirm as usual. "Show another suggestion" moves to the next one. It only suggests: nothing moves from this page. Four suggestions in this version: pay the electricity bill before Friday (only while the bill is still on Home and Pay can cover it), keep enough in Pay for the 1st (only when monthly auto-transfers are more than the Pay balance), how many weeks until a pocket with a goal is full (with and without 1,000 RWF more a week), and the emergency fund measured in days of spending. Home has a "Money manager" row at the top of the first card that shows today's first suggestion. English, French and Kinyarwanda; fr is new copy and rw is new copy that, like v166 and v217 to v219, needs native review, especially "Umujyanama" (manager) and "Inama" (suggestion). Not in this version: typing or speaking a request ("fill school fees"), and learning from what you skip. */
(function(){
const t3=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e,nb=s=>S.lang==='fr'?s.replace(/ ([?:!%])/g,'\u00a0$1'):s;
if(!document.getElementById('mgcss')){const st=document.createElement('style');st.id='mgcss';st.textContent='.mgc{display:flex;align-items:center;gap:14px;margin:8px 8px 6px;padding:16px 18px;border-radius:20px;background:var(--tint);cursor:pointer}.mgi{flex:none;width:44px;height:44px;border-radius:22px;background:var(--bg);display:flex;align-items:center;justify-content:center}.mgt{flex:1;min-width:0}.mgl{font-size:13px;font-weight:700;color:var(--tintfg);line-height:18px}.mgh{font-size:17px;font-weight:800;letter-spacing:-.3px;line-height:24px;margin-top:2px;color:var(--tx)}';document.head.appendChild(st)}
const home0=screens.home;
const NM={'School fees':['Amafaranga y’ishuri','Frais de scolarité'],'Emergency fund':['Amafaranga y’ihutirwa','Fonds d’urgence'],'Interest jar':['Agasanduku k’inyungu','Tirelire à intérêts']};
const pnm=n=>{const x=NM[n];return x?t3(n,x[0],x[1]):n};
const num=s=>parseInt(String(s).replace(/\D/g,''),10)||0;
const pocket=id=>(Array.isArray(S.pk)?S.pk:[]).find(p=>p&&p.id===id);
const cands=all=>{const C=[],pay=S.pay,h=home0();
 // 1. bill due, Pay can cover it
 if(h.indexOf("openBill('REG electricity',18500)")>-1&&pay>=18500)C.push({k:'bill',
  h:t3('Pay your electricity bill before Friday','Ishyura fagitire y’amashanyarazi mbere ya Gatanu','Payez votre facture d’électricité avant vendredi'),
  b:t3('REG electricity is due Friday: 18,500 RWF. Your itunda Pay balance is '+fmt(pay)+' RWF, so you can pay it now.','REG electricity igomba kwishyurwa kuwa Gatanu: 18,500 RWF. Amafaranga ufite kuri itunda Pay ni '+fmt(pay)+' RWF, bityo ushobora kuyishyura ubu.','REG electricity est à payer vendredi : 18,500 RWF. Votre solde itunda Pay est de '+fmt(pay)+' RWF : vous pouvez payer maintenant.'),
  w:t3('Bill due date and your itunda Pay balance','Itariki fagitire igomba kwishyurirwaho n’amafaranga ufite kuri itunda Pay','Échéance de la facture et solde itunda Pay'),
  btn:t3('Pay 18,500 RWF','Ishyura 18,500 RWF','Payer 18,500 RWF'),go:()=>{openBill('REG electricity',18500);S.stack=['mgr','bill']}});
 // 2. monthly auto-transfers more than the Pay balance
 const mo=(Array.isArray(S.at)?S.at:[]).filter(a=>a&&a[4]&&/^1st of each month/.test(a[2])).reduce((s,a)=>s+num(a[3]),0);
 if(mo>pay)C.push({k:'rent',
  h:t3('Keep enough in Pay for the 1st','Bika amafaranga ahagije kuri Pay ku itariki ya 1','Gardez assez sur Pay pour le 1er'),
  b:t3('Your monthly auto-transfers ('+fmt(mo)+' RWF) leave itunda Pay on the 1st. Your balance is '+fmt(pay)+' RWF, which is '+fmt(mo-pay)+' RWF short.','Kohereza byikora bya buri kwezi ('+fmt(mo)+' RWF) bivana kuri itunda Pay ku itariki ya 1. Ufite '+fmt(pay)+' RWF, abura '+fmt(mo-pay)+' RWF.','Vos virements automatiques mensuels ('+fmt(mo)+' RWF) partent d’itunda Pay le 1er. Votre solde est de '+fmt(pay)+' RWF : il manque '+fmt(mo-pay)+' RWF.'),
  w:t3('Your auto-transfers and itunda Pay balance','Kohereza byawe byikora n’amafaranga ufite kuri itunda Pay','Vos virements automatiques et votre solde itunda Pay'),
  btn:t3('Add money','Ongeramo amafaranga','Ajouter de l’argent'),go:()=>tab('pay')});
 // 3. a pocket with a goal
 const g=(Array.isArray(S.pk)?S.pk:[]).find(p=>p&&p.t&&p.t>(p.b||0));
 if(g){const b=g.b||0,p=Math.round(b/g.t*100),p2=Math.round(Math.min(g.t,b+5000)/g.t*100),N=pnm(g.n);
  const ar=(Array.isArray(S.at)?S.at:[]).find(a=>a&&a[4]&&String(a[1]).indexOf(g.n)===0&&/^Every/.test(a[2])),wk=ar?num(ar[3]):0;
  const w1=wk?Math.ceil((g.t-b)/wk):0,w2=wk?Math.ceil((g.t-b)/(wk+1000)):0;
  C.push({k:'goal',
  h:t3(N+' is '+p+'% full',N+': '+p+'% yuzuye',N+' : '+p+' % atteint'),
  b:wk?t3('At '+fmt(wk)+' RWF a week it will be full in '+w1+' weeks. Adding 1,000 RWF a week makes it '+w2+'.','Ku '+fmt(wk)+' RWF mu cyumweru izuzura mu byumweru '+w1+'. Wongeyeho 1,000 RWF mu cyumweru byaba '+w2+'.','À '+fmt(wk)+' RWF par semaine, l’objectif sera atteint en '+w1+' semaines. Avec 1,000 RWF de plus par semaine : '+w2+' semaines.'):t3('Adding 5,000 RWF now takes it to '+p2+'%.','Kongeraho 5,000 RWF ubu bigeza kuri '+p2+'%.','Ajouter 5,000 RWF maintenant porte l’objectif à '+p2+' %.'),
  w:t3('Your pocket goal and auto-transfers','Intego y’agasanduku kawe n’ibyo wateguye byikora','Votre objectif et vos virements automatiques'),
  btn:t3('Fill pocket','Uzuza agasanduku','Alimenter la tirelire'),go:()=>{openPocket(g.id);openMv('in')}})}
 // 4. emergency fund in days of spending
 const e=pocket('emg');
 if(e&&e.b){const d=Math.max(1,Math.round(e.b/(312000/30)));
  C.push({k:'emg',
  h:t3('Build your emergency fund','Kubaka amafaranga y’ihutirwa','Constituez votre fonds d’urgence'),
  b:t3('Your emergency fund of '+fmt(e.b)+' RWF covers about '+d+' days of spending. A common goal is 30 days.','Amafaranga y’ihutirwa ya '+fmt(e.b)+' RWF ahagije ku minsi nka '+d+' y’ibyo ukoresha. Intego isanzwe ni iminsi 30.','Votre fonds d’urgence de '+fmt(e.b)+' RWF couvre environ '+d+' jours de dépenses. Un objectif courant est de 30 jours.'),
  w:t3('Your emergency fund and spending this period (sample data)','Amafaranga y’ihutirwa ufite n’ibyo wakoresheje muri iki gihe (amakuru yo kugerageza)','Votre fonds d’urgence et vos dépenses de la période (données d’exemple)'),
  btn:t3('Fill pocket','Uzuza agasanduku','Alimenter la tirelire'),go:()=>{openPocket('emg');openMv('in')}})}
 return all?C:C.filter(c=>(S.mgx||[]).indexOf(c.k)<0)};
const T=()=>t3('Money manager','Umujyanama w’amafaranga','Gestionnaire d’argent');
const keep=fn=>{const sc=document.querySelector('#phone .screen'),y=sc?sc.scrollTop:0;fn();const s2=document.querySelector('#phone .screen');if(s2)s2.scrollTop=y};
screens.mgr=()=>{const C=cands(),n=C.length,H=bar(T());
 if(!n){const hid=cands(true).length-n;return H+'<div class="pad" style="padding-top:24px"><div class="h1">'+t3('All clear','Byose bimeze neza','Tout est en ordre')+'</div><div class="mu" style="font-size:16px;margin-top:12px;line-height:24px">'+t3('Nothing needs you right now. We will tell you when something does.','Nta kintu gikeneye ko ugikora ubu. Tuzakubwira igihe kizaba gikenewe.','Rien ne demande votre attention pour le moment. Nous vous le dirons quand ce sera le cas.')+'</div></div>'+(hid>0?'<div class="pad" style="padding-top:12px"><button onclick="mgrShow()" style="border:0;background:none;padding:0;min-height:44px;color:var(--lk);font-weight:700;font-size:15px;text-align:left">'+nb(t3('Show hidden suggestions ('+hid+')','Erekana inama zahishwe ('+hid+')','Afficher les suggestions masquées ('+hid+')'))+'</button></div>':'')};
 const i=Math.min(S.mgi||0,n-1),c=C[i];
 return H+'<div class="pad" style="padding-top:24px"><div class="sm mu" style="font-weight:700">'+(n>1?t3('Suggestion '+(i+1)+' of '+n,'Inama '+(i+1)+' kuri '+n,'Suggestion '+(i+1)+' sur '+n):t3('Suggestion','Inama','Suggestion'))+'</div><div class="h1" style="margin-top:6px">'+nb(c.h)+'</div><div class="mu" style="font-size:16px;margin-top:12px;line-height:24px">'+nb(c.b)+'</div></div>'+
 '<div class="pad" style="padding-top:20px"><div style="padding:14px 18px;border-radius:20px;background:var(--chip);font-size:14px;line-height:20px"><b>'+nb(t3('Why you see this','Impamvu ubibona','Pourquoi vous voyez ceci'))+'</b><div class="mu" style="margin-top:2px">'+nb(c.w)+'</div></div></div>'+
 (n>1?'<div class="pad" style="padding-top:8px"><button onclick="mgrNext()" style="border:0;background:none;padding:0;min-height:44px;color:var(--lk);font-weight:700;font-size:15px;text-align:left">'+t3('Show another suggestion','Erekana indi nama','Voir une autre suggestion')+'</button></div>':'')+
 '<div class="pad" style="padding-top:'+(n>1?'0':'8px')+'"><button onclick="mgrHide()" style="border:0;background:none;padding:0;min-height:44px;color:var(--mu);font-weight:700;font-size:15px;text-align:left">'+t3('Not now','Si ubu','Pas maintenant')+'</button></div>'+
 '<div class="pad fine" style="padding-top:8px;line-height:18px">'+nb(t3('We only suggest. Nothing moves until you confirm. Sample data.','Dutanga inama gusa. Nta mafaranga yimuka utarabyemeza. Amakuru yo kugerageza.','Nous ne faisons que suggérer. Rien ne bouge tant que vous n’avez pas confirmé. Données d’exemple.'))+'</div><div style="height:100px"></div>'+
 '<div class="cta"><button class="btn" style="white-space:nowrap" onclick="mgrGo()">'+c.btn+'</button></div>'};
window.mgrOpen=()=>{S.mgi=0;S.stack.push('mgr');render('push')};
window.mgrNext=()=>{const n=cands().length;S.mgi=((S.mgi||0)+1)%Math.max(n,1);keep(()=>render('fade-none'))};
window.mgrHide=()=>{const C=cands(),c=C[Math.min(S.mgi||0,C.length-1)];if(!c)return;S.mgx=(S.mgx||[]).concat(c.k);const n=cands().length;S.mgi=n?Math.min(S.mgi||0,n-1):0;keep(()=>render('fade-none'))};
window.mgrShow=()=>{S.mgx=[];S.mgi=0;keep(()=>render('fade-none'))};
window.mgrGo=()=>{const C=cands(),c=C[Math.min(S.mgi||0,C.length-1)];if(c)c.go()};
screens.home=function(){const h=home0.apply(this,arguments);if(typeof h!=='string')return h;
 return h.replace(/<div class="hc hpm">[\s\S]*?<\/button><div class="tap"[\s\S]*?<\/div><div class="sm"[^>]*>[^<]*<\/div><\/div><\/div>/,'');
 const C=cands();if(!C.length)return h;
 const a='<div class="hr tap" role="button" tabindex="0" onclick="openSpend()">',i=h.indexOf(a);if(i<0)return h;
const row='<div class="mgc tap" role="button" tabindex="0" onclick="mgrOpen()"><div class="mgi"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--tintfg)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9L12 3Z"/><path d="M19 16l.7 1.8L21.5 18.5l-1.8.7L19 21l-.7-1.8-1.8-.7 1.8-.7L19 16Z"/></svg></div><div class="mgt"><div class="mgl">'+T()+'</div><div class="mgh">'+nb(C[0].h)+'</div></div><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--tintfg)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg></div>';
 return h.slice(0,i)+row+h.slice(i)};

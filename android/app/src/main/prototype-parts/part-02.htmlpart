<script>
/* v185: Verify your identity. Fix: Back on the selfie step did nothing (and your ID number was lost); it now returns to the ID page with the number still filled in. New: "Step 1 of 2" / "Step 2 of 2", a live count under the ID field ("6 of 16 digits", "Looks good. Tap Continue."), and a line under the off Continue button that says what is missing. English only; fr/rw copy untouched. */
(function(){
const mk=t=>{const d=document.createElement('div');d.className='sm mu';d.style.cssText='font-weight:700;margin-bottom:4px;letter-spacing:.2px';d.textContent=t;return d};
const hint=()=>{const F=S.vff,n=F.num.length;
 if(F.t===0)return n===0?'16 digits, as printed on your ID.':n<16?n+' of 16 digits':'Looks good. Tap Continue.';
 return n===0?'7 to 9 letters or digits, as printed in your passport.':n<7?n+' of 7 to 9. Keep typing.':'Looks good. Tap Continue.'};
const dis=()=>S.vff.t===0?'Enter all 16 digits to continue.':'Enter 7 to 9 letters or digits to continue.';
const sync=()=>{const sh=document.querySelector('#layer .sheet'),b=sh&&sh.querySelector('#vfnext');if(!b)return;
 const h=sh.querySelector('#vfhint');if(h)h.textContent=hint();
 let d=b.nextElementSibling;d=d&&d.classList.contains('dhint')?d:null;
 if(b.disabled&&!d){d=document.createElement('div');d.className='dhint sm mu';d.setAttribute('role','note');d.style.cssText='text-align:center;padding:8px 8px 0;font-size:13px;line-height:18px';b.after(d)}
 if(d){if(b.disabled)d.textContent=dis();else d.remove()}};
const enhance=()=>{if(S.lang!=='en')return;const sh=document.querySelector('#layer .sheet');if(!sh||sh.dataset.v185)return;
 const q=sh.querySelector('.h1');if(!q)return;
 if(sh.querySelector('#vfin')){sh.dataset.v185='1';q.before(mk('Step 1 of 2'));
  const f=sh.querySelector('#vfin').nextElementSibling;if(f){f.id='vfhint'}sync()}
 else if(/Take a selfie/.test(q.textContent)){sh.dataset.v185='1';q.before(mk('Step 2 of 2'))}};
const o=window.vfIn;window.vfIn=function(){const r=o.apply(this,arguments);try{sync()}catch(e){}return r};
const L=document.getElementById('layer');if(L)new MutationObserver(()=>requestAnimationFrame(()=>{try{enhance()}catch(e){}})).observe(L,{childList:true,subtree:true});
document.title='itunda, clickable prototype v185';
})();

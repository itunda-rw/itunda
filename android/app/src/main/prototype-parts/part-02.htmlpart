/* v224: Clean-up pass. (1) Explore (about 70 services in one run) now has a clear heading on every group, in English, French and Kinyarwanda ("Everyday", "Send & pay", "Borrow" and so on), and the two long groups (Accounts & cards, Borrow) show their first 4 and a "Show 6 more" line, so the page reads as nine short lists. Searching still shows every match. (2) Small secondary text goes from 13 px to 14 px on Home, Pay, Explore and Messages (account names, due dates, row captions, message previews, button labels). (3) Small links and icon buttons (See all, Support, Settings, hide balances, the dots on a message) now have a 44 px touch area without moving anything. rw headings are new copy and need native review, like v166 and v217 to v222. On Explore each service now shows its short caption under its name instead of squeezed to the right, so names like \"Open account\" no longer wrap. Not in this version: the other tabs' inner screens (shop, pockets, loans) were not re-spaced. */
(function(){
const t3=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e;
const H={'Places & trips':['Places & trips','Ahantu n’ingendo','Lieux et trajets'],'Everyday':['Everyday','Buri munsi','Au quotidien'],'Your neighbourhood':['Your neighbourhood','Mu gace utuyemo','Votre quartier'],'Money tools':['Money tools','Ibikoresho by’amafaranga','Outils d’argent'],'Accounts & cards':['Accounts & cards','Konti n’amakarita','Comptes et cartes'],'Send & pay':['Send & pay','Ohereza & wishyure','Envoyer et payer'],'Save & grow':['Save & grow','Zigama & ukure','Épargner et faire fructifier'],'Borrow':['Borrow','Gufata inguzanyo','Emprunter'],'Transport':['Transport','Ingendo','Transport'],'Support':['Support','Ubufasha','Aide']};
const st=document.createElement('style');st.id='v224css';st.textContent=
'.xgh{padding:20px 12px 6px;font-size:18px;font-weight:800;letter-spacing:-.3px;line-height:26px;color:var(--tx)}'+
'.xg .ar.xhide{display:none}'+
'.xg .ar:not(.xhide){display:grid;grid-template-columns:44px 1fr;column-gap:14px;align-items:center;padding-top:10px;padding-bottom:10px}.xg .ar .g{grid-row:1/3;grid-column:1}.xg .ar .t{grid-column:2;grid-row:1;align-self:end;line-height:22px}.xg .ar .s{grid-column:2;grid-row:2;align-self:start;justify-self:start;text-align:left;margin:0!important;padding:0!important;color:var(--mu)}.xg .ar .t{margin:0!important;padding:0!important}.xg .ar:not(.xhide){row-gap:0}'+
'.xmore{display:flex;align-items:center;width:100%;min-height:48px;padding:0 12px;border:0;background:none;color:var(--lk);font-weight:700;font-size:15px;text-align:left}'+
'.sm,.row .s,.xg .ar .s,.hm .sm{font-size:14px;line-height:20px}.hr .hp{font-size:14px;max-width:132px}.pkpn{font-size:14px;line-height:20px}'+
'.sech a,.xl button,.xl{position:relative}.sech a::after,.xl button::after{content:"";position:absolute;inset:-14px -10px}'+
'.pad .hide,button[aria-label="Hide balances"],button[aria-label="Show balances"]{position:relative}button[aria-label="Hide balances"]::after,button[aria-label="Show balances"]::after{content:"";position:absolute;inset:-12px}';
document.head.appendChild(st);
const more=(n)=>t3('Show '+n+' more','Erekana '+n+' zindi','Voir '+n+' de plus'),less=()=>t3('Show less','Erekana bike','Voir moins');
let busy=false;
function tidy(){if(busy)return;busy=true;try{
 document.querySelectorAll('#phone .xp .xg:not([data-v224])').forEach((g,gi)=>{
  g.setAttribute('data-v224','1');
  const k=g.getAttribute('aria-label')||'',h=H[k];
  if(h){const d=document.createElement('div');d.className='xgh';d.textContent=t3(h[0],h[1],h[2]);g.insertBefore(d,g.firstChild)}
  const rows=[...g.children].filter(c=>c.classList&&c.classList.contains('ar'));
  if(false){const n=rows.length-4,open=(S.xpo||{})[k];
   rows.slice(4).forEach(r=>{if(!open)r.classList.add('xhide')});
   const b=document.createElement('button');b.className='xmore';b.setAttribute('aria-expanded',open?'true':'false');b.textContent=open?less():more(n);
   b.onclick=()=>{const o=!((S.xpo||{})[k]);S.xpo=Object.assign({},S.xpo,{[k]:o});rows.slice(4).forEach(r=>r.classList.toggle('xhide',!o));b.textContent=o?less():more(n);b.setAttribute('aria-expanded',o?'true':'false')};
   g.appendChild(b)}
 });
}finally{busy=false}}
new MutationObserver(tidy).observe(document.getElementById('phone'),{childList:true,subtree:true});tidy();
document.title='itunda, clickable prototype v224';
})();

/* v225b: Pay tab, Manage list. The last section on Pay had nine rows in a row. It now shows the first four (Payment history, Saved merchants, Pay limits, Upcoming bills) and a \"Show 5 more\" line that opens the rest and turns into \"Show less\". Same wording and same pattern as Explore (v224), so no new copy. Also on Pay: \"Recent activity\" rows no longer wrap (\"Received · Yesterday\" and \"Kigali Bus Services\" each fit on one line) because the arrow, which did nothing extra there, is gone from those rows. */
/* v225: You tab, shorter. The tab had 17 rows under five headings, and most of them were "0". Partner earnings, My favorites and My listings are now three closed sections: tap the heading (it has an arrow) to open it, tap again to close it. The profile, Verification, Settings, Language and Help stay in view, so the page is about nine lines long instead of twenty-two. The profile line (phone number) is 14 px. Open or closed is remembered while the app is open. Nothing is removed: every row is still one tap after opening the section. English, French and Kinyarwanda use the headings that were already there, so there is no new copy. */
(function(){
const st=document.createElement('style');st.id='v225css';st.textContent=
'.yacc{display:flex;align-items:center;justify-content:space-between;min-height:56px;font-size:17px!important;font-weight:700!important;color:var(--tx)!important;cursor:pointer;user-select:none}'+
'.yacc svg{flex:none;transition:transform .2s ease}.yacc[aria-expanded="true"] svg{transform:rotate(90deg)}'+
'.yhid{display:none!important}'+
'.v174 .row>div:nth-child(2){flex:1 1 auto;min-width:0}.v174 .row .r{flex:none;white-space:nowrap}.v174 .row .r:has(+*){margin-left:0}.noch .row .t{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.noch .r svg{display:none}'+
'.ar[onclick="openProfile()"] .s{font-size:14px!important;line-height:20px}';
document.head.appendChild(st);
let busy=false;
function tidy(){if(busy)return;busy=true;try{
 const t3=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e;
 document.querySelectorAll('#phone .screen').forEach(sc=>{
  if(sc.querySelector('.ppg')){const ab=[...sc.querySelectorAll('.v174')].slice(-2,-1)[0];if(ab)ab.classList.add('noch')}
  if(!sc.getAttribute('data-v225b')&&sc.querySelector('.ppg')){const bl=[...sc.querySelectorAll('.v174')].pop(),rows=bl?[...bl.querySelectorAll('.sec > .row')]:[];
   if(false){sc.setAttribute('data-v225b','1');const k='paymanage',n=rows.length-4,open=(S.xpo||{})[k];
    const more=()=>t3('Show '+n+' more','Erekana '+n+' zindi','Voir '+n+' de plus'),less=()=>t3('Show less','Erekana bike','Voir moins');
    rows.slice(4).forEach(r=>r.classList.toggle('yhid',!open));
    const b=document.createElement('button');b.className='xmore';b.style.padding='0';b.setAttribute('aria-expanded',open?'true':'false');b.textContent=open?less():more();
    b.onclick=()=>{const o=!((S.xpo||{})[k]);S.xpo=Object.assign({},S.xpo,{[k]:o});rows.slice(4).forEach(r=>r.classList.toggle('yhid',!o));b.textContent=o?less():more();b.setAttribute('aria-expanded',o?'true':'false')};
    rows[0].parentNode.appendChild(b)}}
  if(sc.getAttribute('data-v225')||!sc.querySelector('.ar[onclick="openProfile()"]'))return;
  const heads=[...sc.querySelectorAll(':scope > .agt')];if(heads.length<99)return;
  sc.setAttribute('data-v225','1');
  // the last heading (Settings) stays open; the ones before it fold, except none other
  heads.slice(0,-1).forEach((h,i)=>{
   const body=[];let n=h.nextElementSibling;while(n&&!n.classList.contains('agt')&&!n.classList.contains('fine')){body.push(n);n=n.nextElementSibling}
   const key=i,open=!!(S.yo||{})[key];
   h.classList.add('yacc');h.setAttribute('role','button');h.setAttribute('tabindex','0');h.setAttribute('aria-expanded',open?'true':'false');
   const txt=h.textContent;h.textContent='';const sp=document.createElement('span');sp.textContent=txt;h.appendChild(sp);
   h.insertAdjacentHTML('beforeend','<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--tt)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>');
   body.forEach(e=>e.classList.toggle('yhid',!open));
   const tg=()=>{const o=h.getAttribute('aria-expanded')!=='true';S.yo=Object.assign({},S.yo,{[key]:o});h.setAttribute('aria-expanded',o?'true':'false');body.forEach(e=>e.classList.toggle('yhid',!o))};
   h.onclick=tg;h.onkeydown=e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();tg()}};
  });
 });
}finally{busy=false}}
new MutationObserver(tidy).observe(document.getElementById('phone'),{childList:true,subtree:true});tidy();
document.title='itunda, clickable prototype v225';
})();

/* v227: Folding taken out. v224 to v226 hid content behind arrows and \"Show more\" lines (Explore groups, You sections, Pay Manage, Bank sections). That moves clutter out of sight and does not simplify, so every list is open again, as in v223. Kept: Explore group headings and two-line rows, 14 px secondary text, 13 px small print, the Pay Recent activity fix, the quieter Home. */
/* v226: Bank screen, shorter. The Bank page was about 4,000 px of open sections under the balance (Control, Cards & documents, Recommended for you, Save & grow, Borrow, Insights). Balance, the four actions, "Everything you have" and "Coming up" stay in view; the six sections below are now closed rows with an arrow (tap to open, tap again to close), like You (v225). The page is about one and a half screens instead of five. Open or closed is remembered while the app is open. Small print ("sample data" notes) goes from 12 to 13 px across the app. No new copy: headings are the ones already there in English, French and Kinyarwanda. */
(function(){
const st=document.createElement('style');st.id='v226css';st.textContent='.fine{font-size:13px!important;line-height:19px!important}.bacc{display:flex;align-items:center;justify-content:space-between;min-height:56px;cursor:pointer;user-select:none;padding-top:0!important;padding-bottom:0!important;font-size:17px!important;font-weight:700!important;color:var(--tx)!important}.bacc svg{flex:none;transition:transform .2s ease}.bacc[aria-expanded="true"] svg{transform:rotate(90deg)}.bhid{display:none!important}.v174.bsec{padding-top:0!important;padding-bottom:0!important}';
document.head.appendChild(st);
let busy=false;
function tidy(){if(busy)return;busy=true;try{
 document.querySelectorAll('#phone .screen').forEach(sc=>{
  if(sc.getAttribute('data-v226')||!sc.querySelector('.bka'))return;
  const blocks=[...sc.querySelectorAll(':scope > .v174')];if(blocks.length<99)return;
  sc.setAttribute('data-v226','1');
  blocks.forEach((bl,i)=>{
   const h=bl.querySelector(':scope > .v174h');if(!h)return;
   const body=[...bl.children].filter(c=>c!==h);if(!body.length)return;
   bl.classList.add('bsec');
   const open=!!(S.bo||{})[i];
   h.classList.add('bacc');h.setAttribute('role','button');h.setAttribute('tabindex','0');h.setAttribute('aria-expanded',open?'true':'false');
   const txt=h.textContent;h.textContent='';const sp=document.createElement('span');sp.textContent=txt;h.appendChild(sp);
   h.insertAdjacentHTML('beforeend','<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--tt)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>');
   body.forEach(e=>e.classList.toggle('bhid',!open));
   const tg=()=>{const o=h.getAttribute('aria-expanded')!=='true';S.bo=Object.assign({},S.bo,{[i]:o});h.setAttribute('aria-expanded',o?'true':'false');body.forEach(e=>e.classList.toggle('bhid',!o))};
   h.onclick=tg;h.onkeydown=e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();tg()}};
  });
 });
}finally{busy=false}}
new MutationObserver(tidy).observe(document.getElementById('phone'),{childList:true,subtree:true});tidy();
document.title='itunda, clickable prototype v227';
})();
/* v228: Readable colours. Light mode: the grey used for tab labels, small print and hints (#8B95A1) was about 2.9:1 on white, below the 4.5:1 that small text needs, and the green and red used for status text were close to the limit (green 4.1:1). They are darkened a little (grey #69727F about 4.9:1, green #087A4D about 6.8:1). Dark mode: the red (3.1:1) and green (4.3:1) status text on the dark background are lightened (red #FF7B6E, green #35C48B) so \"Failed\", \"Paid\" and similar lines are easy to read. Only colour values change: no layout, copy or behaviour. Buttons and badges keep their fills. */
(function(){
const st=document.createElement('style');st.id='v228css';st.textContent=
':root{--tt:#69727F;--ok:#087A4D}'+
'@media (prefers-color-scheme:dark){:root{--tt:#8F96A2;--ok:#35C48B;--er:#FF7B6E}}'+
':root[data-theme=light]{--tt:#69727F;--ok:#087A4D;--er:#C4281B}'+
':root[data-theme=dark]{--tt:#8F96A2;--ok:#35C48B;--er:#FF7B6E}';
document.head.appendChild(st);
document.title='itunda, clickable prototype v228';
})();
/* v229: Clean-up and redesign pass. Bigger, calmer type and more room, everywhere, with no folding. (1) Type: titles 30 px, section headings 20 px, row titles 17 px, row detail and hints 15 px, buttons 18 px, tab names 13 px, chips 15 px. (2) Space: rows 14 px tall padding, sections 40 px apart, buttons 58 px high, tap targets at least 48 px, list rows divided by a thin line. (3) No folding: the last few screens that still hid content behind arrows (Savings and Pockets detail sections) now show everything open, as headings. (4) Calm: text stays left aligned and long words wrap instead of being cut. No copy, flow or data changes. */
(function(){
const st=document.createElement('style');st.id='v229css';st.textContent=
'.h1{font-size:30px!important;line-height:38px!important;letter-spacing:-.6px}'+
'.sec{padding-top:40px!important}.sech{font-size:20px!important;margin-bottom:12px!important}.sech a{font-size:15px!important}'+
'.row{padding:14px 0!important;gap:16px!important;min-height:64px}'+
'.row .t{font-size:17px!important;line-height:24px}.row .s{font-size:15px!important;line-height:21px!important;margin-top:3px!important}.row .r{font-size:15px!important}'+
'.row+.row{border-top:0}'+
'.gi{font-size:13px!important;gap:10px!important}.g5 .gi{font-size:12px!important}.grid{gap:24px 0!important}'+
'.btn{height:58px!important;font-size:18px!important;border-radius:18px!important}.row2 .btn{height:54px!important;font-size:17px!important}'+
'.cta{padding:14px 24px 28px!important}'+
'.tabs button{font-size:13px!important;gap:5px!important}'+
'.chip,.cch{height:40px!important;font-size:15px!important;padding:0 18px!important}'+
'.chips{gap:10px!important}.ib{width:48px!important;height:48px!important}'+
'.bar b{font-size:20px!important}.pgrid{gap:24px 16px!important}'+
'.mis{font-size:13px!important;padding:16px 8px!important}.mis b{font-size:14px!important}'+
'.fine{font-size:14px!important;line-height:20px!important}'+
'.toast{font-size:15px!important;padding:16px 20px!important}'+
'.sheet{padding:32px 24px 32px!important}'+
'#phone .screen{overflow-wrap:anywhere;line-height:1.4}'+
'#phone details>summary{pointer-events:none;cursor:default;font-size:18px!important;font-weight:800!important}#phone details>summary svg{display:none!important}#phone details>summary::-webkit-details-marker{display:none}';
document.head.appendChild(st);
let busy=false;
function open(){if(busy)return;busy=true;try{document.querySelectorAll('#phone details:not([open])').forEach(d=>d.setAttribute('open',''));document.querySelectorAll('#phone details>summary').forEach(m=>{m.setAttribute('tabindex','-1');m.removeAttribute('aria-expanded')})}finally{busy=false}}
new MutationObserver(open).observe(document.getElementById('phone'),{childList:true,subtree:true});open();
document.title='itunda, clickable prototype v229';
})();
/* v232: Bank screen, the \"Everything you have in itunda\" summary (total, colour bar, itunda Bank / itunda Pay / Pockets amounts) is removed. The balance, the four actions and \"Coming up\" now follow each other with normal spacing. Everything else is as in v231. */
/* v231: Less primary colour, real icons kept. Colour noise here means overusing the purple, not the icons, so the colourful icons and illustrations (they look like real things and help people recognise them) are back as they were in v229. What changes: purple is now kept for the one main button on a screen and for the selected state. Small purple tinted buttons (Send on Home, amount shortcuts) are neutral grey buttons; \"See all\" and section links are bold grey instead of purple; action labels (Scan, Send, Request money, Add) are black. Lines between list rows are gone and arrows are lighter, so space does the separating. Pay > Manage rows show their title and, where there is one, the count or limit (the grey second line repeated the title); all rows remain. Long names in \"Pay or send again\" stay on two lines (never broken mid-word). More air above and below each group. No copy, flow or data changes. */
(function(){
const st=document.createElement('style');st.id='v231css';st.textContent=
'.row+.row{border-top:0!important}.row .r svg{opacity:.45}'+
'.v174{padding-top:12px!important}.v174h{margin-bottom:6px}'+
'.sec{padding-top:44px!important}.row{padding:16px 0!important}'+
'.pman .row .s{display:none!important}.pman .row{min-height:60px;padding:12px 0!important}'+
'.noch .row .s{white-space:nowrap}.noch .row>div:nth-child(2){min-width:0;flex:1 1 auto}'+
'.gi .ico{width:64px!important;height:64px!important;border-radius:24px!important}'+
'.chip[style*="--tint"]{background:var(--chip)!important;color:var(--tx)!important}'+
'.sech a,.sech [onclick]{color:var(--mu)!important;font-weight:700!important}'+
'.pad>div:first-child:not(.row){color:var(--mu)!important}.gi,.gi *{color:var(--tx)!important}';
document.head.appendChild(st);
let busy=false;
function tidy(){if(busy)return;busy=true;try{
 document.querySelectorAll('#phone .screen').forEach(sc=>{
  if(!sc.querySelector('.ppg'))return;
  const all=[...sc.querySelectorAll('.v174')],bl=all.pop();if(bl&&!bl.classList.contains('pman'))bl.classList.add('pman');const ag=all[all.length-2];if(ag&&!ag.getAttribute('data-v230')){ag.setAttribute('data-v230','1');ag.querySelectorAll('*').forEach(e=>{if(!e.children.length&&e.textContent.trim().length>3&&!e.closest('svg')&&!e.closest('.v174h')&&e.textContent.trim()!=='A'){e.style.cssText+=';display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;max-width:96px;font-size:12px;overflow:hidden;overflow-wrap:normal;word-break:normal;text-align:center'}})}});
}finally{busy=false}}
new MutationObserver(tidy).observe(document.getElementById('phone'),{childList:true,subtree:true});tidy();
document.title='itunda, clickable prototype v232';
})();
/* v233: Home, the \"My credit score\" card under Recent activity is removed, so Home ends with Recent activity. The credit score is still in Explore (Credit score) and under Bank. */
(function(){
let busy=false;
function drop(){if(busy)return;busy=true;try{document.querySelectorAll('#phone .screen > .hc').forEach(c=>{if(c.querySelector('[onclick="openScore()"]'))c.remove()})}finally{busy=false}}
new MutationObserver(drop).observe(document.getElementById('phone'),{childList:true,subtree:true});drop();
document.title='itunda, clickable prototype v233';
})();
/* v234: Margin, spacing and type, one system. Side margin 24 px everywhere. Home: more room under the top bar, rows 76 px tall with 16 px between icon and text, balances 24 px, row titles 18 px, helper lines 14 px, buttons 44 px high with 15 px text; card headings (Pockets, Recent activity) 20 px with grey \"See all\"; pocket names 14 px grey above the amount (were 13 px); the Bills / Card / Savings line is 16 px with space above it; every card has 16 px above and below. You: group headings (Partner earnings, My favorites ...) are 20 px black headings with 40 px above instead of small grey labels; rows are 60 px tall. No copy, flow or data changes. */
(function(){
const st=document.createElement('style');st.id='v234css';st.textContent=
'.top{padding:24px 24px 8px!important}'+
'.hc{padding:16px 0!important}'+
'.hc .hr{padding:16px 24px!important;gap:12px!important;min-height:76px}'+
'.hc .ha{font-size:24px!important;line-height:32px!important;white-space:nowrap}.hc .ha .cu{font-size:14px!important}.hc .hi{flex:none}.hc .hm{min-width:0;flex:1 1 auto}.hc .ha2{font-size:18px!important;line-height:26px!important}'+
'.hc .hm .sm{font-size:14px!important;line-height:21px!important}'+
'.hc .pkpn{font-size:14px!important;font-weight:600!important;color:var(--mu)!important;margin-bottom:2px}'+
'.hc .hp{height:44px!important;min-width:60px;padding:0 14px!important;white-space:nowrap;flex:none;font-size:15px!important;border-radius:22px!important}'+
'.hct{padding:12px 24px 4px!important;font-size:20px!important;font-weight:800!important}.hct a{font-size:15px!important;color:var(--mu)!important;font-weight:700!important}'+
'.hc .hf{padding:16px 24px 8px 14px!important;font-size:16px!important}.hc .hf button{font-size:16px!important;font-weight:700!important}'+
'.agt{font-size:20px!important;font-weight:800!important;color:var(--tx)!important;margin-top:40px!important;padding-bottom:4px}'+
'.ar{min-height:60px;padding-top:12px!important;padding-bottom:12px!important}'+
'.ar .t{font-size:17px!important}.ar .s{font-size:15px!important}';
document.head.appendChild(st);
document.title='itunda, clickable prototype v234';
})();
/* v237: Shop sort, in the app's own style. v236 used the phone's plain drop-down list, which does not match the rest of itunda. Tapping \"Recommended ▾\" now opens the same bottom sheet used elsewhere in the app: a \"Sort\" heading and four large rows (Recommended, Price: low to high, Price: high to low, Biggest deals), a tick on the current one, and one tap picks and closes. Same words as before. */
/* v236: Shop, one kind of control instead of six look-alike chips. The page had four sort chips, \"Saved\" and \"My orders\" (all the same pill) followed by the category chips. Now: one line with the sort as a plain bold choice (\"Recommended\" with a small arrow; tap to pick Price low to high, Price high to low or Biggest deals), and two icon buttons on the right, a heart for Saved (with the count, red when on) and a box for My orders (with the count). The only pills left are the categories (All, Food, Fashion, Electronics, Home), so they read as one set. English, French and Kinyarwanda use the words that were already there. */
/* v235: Pay colour fix and Bank/Explore spacing. (1) Fix: since v231 the Pay balance (120,500 RWF) and \"My payment code\" were shown in grey by mistake; they are black again. (2) Pay: the top balance block has more room under the title, the four actions (Scan, Send, Request money, Add) are black 14 px labels and the small \"itunda Pay Money\" label is grey, so the page has one accent colour. (3) Bank: amount and arrow on the right stay on one line, so \"Ikimina · Umurenge Savers\" gets the width left over; action labels (Send, Move, Deposit, Statement) have side room. (4) Explore: the header (name, Support, Settings, search, four shortcuts) has 24 px side margins and more air between the parts. No copy, flow or data changes. */
(function(){
const st=document.createElement('style');st.id='v235css';st.textContent=
'.pad>div:first-child:not(.row),.pad>.row *{color:inherit!important}'+
'.ppa{color:var(--tx)!important;font-size:14px!important}.pad .sm[style*="--tintfg"]{color:var(--mu)!important}'+
'.pad>div:first-child:not(.row) .mu,.pad>div:first-child:not(.row) .s{color:var(--mu)!important}'+
'.g4 .gi{font-size:13px!important;padding:0 2px}.g4{padding-left:12px;padding-right:12px}'+
'.row .r{white-space:nowrap;flex:none;font-size:14px!important}'+
'.row>div:nth-child(2){min-width:0;flex:1 1 auto}';
document.head.appendChild(st);
document.title='itunda, clickable prototype v237';
})();
/* v238: Whole-app scan. All 123 screens were opened and checked by a script for text that is too small, text that is cut off and controls that are hard to hit. Result: tap areas were already 44 px (v-earlier hit areas), nothing runs off the edge except rows that are meant to scroll sideways (chip rows), but about 40 pieces of text were 11 or 12 px: chat times, \"Send / Move / Deposit / Statement\" under the Bank buttons, names under Pay\u2019s recent people, \"13.9K using\" in Mini apps, \"1 km\" on the map, the \"?\" help marks. Everything under 13 px (except tiny badges and the tab bar) is now 13 px, on every screen, including ones added later. No copy, flow or data changes. */
(function(){
const st=document.createElement('style');st.id='v238css';st.textContent='.g4{padding-left:0!important;padding-right:0!important}.g4 .gi{white-space:nowrap;font-weight:600!important}.bka{padding-left:12px!important;padding-right:12px!important}.bka button{white-space:nowrap;font-weight:600!important;letter-spacing:-.2px;padding-left:0!important;padding-right:0!important}';document.head.appendChild(st);
let t=0;
const DONE=new WeakSet();
function floor(){t=0;const c=[],root=document.querySelector('#phone .screen');if(!root)return;
 /* walk text nodes only (far fewer than all elements), read styles first, write after */
 document.querySelectorAll('#phone .screen').forEach(sc=>{const tw=document.createTreeWalker(sc,NodeFilter.SHOW_TEXT);let n;
  while(n=tw.nextNode()){const e=n.parentElement;if(!e||DONE.has(e))continue;DONE.add(e);if(!n.nodeValue.trim()||e.closest('svg,.tabs,input,select'))continue;
   const f=parseFloat(getComputedStyle(e).fontSize);if(f&&f<13)c.push(e)}});
 c.filter(e=>{const r=e.getBoundingClientRect();return!(r.width<22&&r.height<22&&/^\d{1,2}$/.test(e.textContent.trim()))}).forEach(e=>{e.style.fontSize='13px'})}
new MutationObserver(()=>{if(!t)t=requestAnimationFrame(floor)}).observe(document.getElementById('phone'),{childList:true,subtree:true});floor();
document.title='itunda, clickable prototype v238';
})();
/* v239: Second scan, fixes. (1) Send > amount: the four shortcuts (+5,000, +10,000, +50,000, Max) sit on one line instead of leaving \"Max\" alone on a second line. (2) Settings: the group headings inside the grey cards (Authentication & Security, Transfer & Payment) no longer have a big empty gap above them. (3) Bank, Coming up: row titles are 16 px with a little less gap (the Ikimina row still needs three lines; a shorter label would fix it). No copy, flow or data changes. */
(function(){
const st=document.createElement('style');st.id='v239css';st.textContent=
'.chip[onclick^="key("]{padding:0 12px!important;font-size:15px!important;white-space:nowrap;flex:none!important}'+
'*:has(>.chip[onclick^="key("]){flex-wrap:nowrap!important;gap:8px!important;justify-content:center}'+
'.agt:first-child{margin-top:12px!important}'+
'.v174 .row{gap:12px!important}.v174 .row .t{font-size:16px!important}';
document.head.appendChild(st);
document.title='itunda, clickable prototype v239';
})();
/* v240: Third scan. (1) Messages: \"All / Unread · 1 / Archived\" are plain text tabs with an underline on the current one (like Shop / Eats and Portfolio / Market), not pills; the \"...\" on each conversation is lighter so the list reads as names and messages first. (2) One purple button per screen: where a screen showed a purple tinted button next to the main button (Invest: \"Treasury bills\" beside \"Browse stocks\"; Mini apps: \"See deals\"), the tinted one is now a neutral grey button. No copy, flow or data changes. */
(function(){
const st=document.createElement('style');st.id='v240css';st.textContent=
'.mm-chips.mtabs{gap:24px!important}.mtabs .cch{background:none!important;border-radius:0!important;padding:0 2px!important;height:44px!important;font-size:17px!important;font-weight:700!important;color:var(--tt)!important;white-space:nowrap;flex:none}'+
'.mtabs .cch.on{color:var(--tx)!important}.mtabs .cch.on::after{top:auto!important;bottom:2px!important;left:0!important;right:0!important;width:auto!important;height:3px!important;border-radius:2px}'+
'.mm-more{opacity:.4}'+
'.btn.sec2,button[style*="background:var(--tint)"]:not(.cch):not(.on){background:var(--chip)!important;color:var(--tx)!important}';
document.head.appendChild(st);
let f=0;function tabs(){f=0;document.querySelectorAll('#phone .screen').forEach(sc=>{if(sc.querySelector('.mm-more')){const c=sc.querySelector('.mm-chips');if(c)c.classList.add('mtabs')}})}
new MutationObserver(()=>{if(!f)f=requestAnimationFrame(tabs)}).observe(document.getElementById('phone'),{childList:true,subtree:true});tabs();
document.title='itunda, clickable prototype v245';
})();
/* v246: Transit. The page was four stacked blocks with three full-width buttons. Now: balance first (with how many rides it covers), Operator and Fare as two plain rows that open a picker, ride history, and ONE button pinned at the bottom: "Tap 300 RWF", which turns into "Top up to ride" when the balance is too low (it used to be a greyed-out button). Top up opens a sheet (amounts, source balance, one button). Fare notes are folded under "About fares". rw/fr copy for the new lines needs native review. */
(function(){
const T=(e,r,f)=>({en:e,rw:r,fr:f}[S.lang]||e);
const BTN='height:52px;font-size:16px;border-radius:16px';
const row=(lab,val,go)=>`<button class="pkrow" style="width:100%;border:0;background:none;text-align:left" onclick="${go}"><div style="flex:1;min-width:0"><div class="sm mu">${lab}</div><div style="font-size:17px;font-weight:700;margin-top:2px">${val}</div></div><span class="pkch">${ic('chev',16,'var(--tt)')}</span></button>`;
const sheet=(title,body)=>{$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" role="dialog" aria-modal="true" aria-label="${title}"><div class="h1" style="font-size:22px;line-height:30px;margin-bottom:8px">${title}</div>${body}</div>`};
screens.transit=()=>{
 const low=S.tb<S.fare,n=Math.floor(S.tb/S.fare),rides=S.rides.slice(0,10);
 const sub=low
  ?`<div class="sm" style="margin-top:8px;color:var(--er);font-weight:700">${T('Not enough for a '+S.fare+' RWF ride','Ntihagije urugendo rwa '+S.fare+' RWF','Insuffisant pour un trajet de '+S.fare+' RWF')}</div>`
  :`<div class="sm mu" style="margin-top:8px">${T('About '+n+' ride'+(n>1?'s':'')+' at '+S.fare+' RWF','Ingendo ~'+n+' kuri '+S.fare+' RWF','Environ '+n+' trajet'+(n>1?'s':'')+' à '+S.fare+' RWF')}</div>`;
 return `${bar(t('tr_title'))}<div class="pad" style="padding-top:16px;display:flex;align-items:center;gap:16px"><div style="flex:1;min-width:0"><div class="sm mu">${t('tr_bal')}</div><div class="big" style="margin-top:4px">${fmt(S.tb)} RWF</div>${sub}</div><div>${gl('transit',64)}</div></div>
<div class="pad" style="padding-top:14px"><button class="btn sec2" style="width:auto;height:44px;padding:0 20px;font-size:15px;border-radius:14px" onclick="trTop()">${t('tr_top')}</button></div>
<div class="bdband"></div>
<div style="padding-top:8px">${row(T('Operator','Uwukwiyemera','Opérateur'),S.op,"trPick('op')")}${row(T('Fare','Amafaranga y’urugendo','Tarif'),S.fare+' RWF',"trPick('fare')")}</div>
<div class="bdband" style="margin-top:8px"></div>
<div class="pad" style="padding-top:20px;font-size:18px;font-weight:800">${t('tr_hist')}</div>
${rides.length?rides.map(r=>`<div class="ar" style="cursor:default"><div class="g">${gl('busstop',30)}</div><div style="flex:1"><div class="t" style="font-size:15px">${r[0]}</div></div><b>−${r[1]} RWF</b></div>`).join(''):`<div class="pad mu" style="font-size:15px;line-height:22px;padding-top:6px">${t('tr_none')}</div>`}
<details style="margin:0 24px"><summary style="padding:22px 0 10px;font-weight:700;font-size:15px;color:var(--tt);cursor:pointer">${T('About fares','Ibyerekeye ibiciro','À propos des tarifs')}</summary><div class="fine" style="line-height:17px;padding-bottom:12px">${t('tr_tapd')}<br><br>${t('tr_disc').replace(/&/g,'&amp;')}</div></details>
<div class="cta"><button class="btn" style="${BTN}" onclick="${low?'trTop()':'transitTap()'}">${low?T('Top up to ride','Ongeramo amafaranga','Recharger pour voyager'):t('tr_tap').replace('%s',S.fare)}</button></div>`};
window.trTop=()=>{
 const bad=S.topAmt>S.pay;
 sheet(t('tr_top'),`<div class="sm mu">${T('From itunda Pay · ','Kuri itunda Pay · ','Depuis itunda Pay · ')}${fmt(S.pay)} RWF</div><div class="req" style="margin-top:16px">${[1000,2000,5000,10000].map(a=>`<button class="${S.topAmt===a?'on':''}" onclick="trAmt(${a})">${fmt(a)}</button>`).join('')}</div>${bad?`<div style="color:var(--er);font-size:14px;margin-top:12px">${t('insuff').replace('%s',fmt(S.pay))}</div>`:''}<button class="btn" style="${BTN};margin-top:20px" ${bad?'disabled':''} onclick="trTopGo()">${t('tr_top')} ${fmt(S.topAmt)} RWF</button>`)};
window.trAmt=a=>{S.topAmt=a;trTop()};
window.trTopGo=()=>{if(S.topAmt>S.pay)return;closeSheet();transitTop()};
window.trPick=k=>{
 const opts=k==='op'?['Kigali Bus Services','Royal Express'].map(o=>[o,o]):[200,300,400,500].map(f=>[f,f+' RWF']);
 const cur=k==='op'?S.op:S.fare,set=k==='op'?"S.op='%v'":"S.fare=%v";
 sheet(k==='op'?T('Operator','Uwukwiyemera','Opérateur'):T('Fare','Amafaranga y’urugendo','Tarif'),opts.map(([v,l])=>`<button class="pkopt ${cur===v?'on':''}" onclick="${set.replace('%v',v)};closeSheet();render('fade-none')">${l}${cur===v?CK48:''}</button>`).join(''))};
document.title=document.title.replace('v245','v246');
})();
/* v247: Whole-app UI/UX pass (from rendering all 123 screens in a browser). (1) Pages that only had one "+ New …" button at the TOP of an otherwise empty page (price alerts, auto-invest, payees, scheduled transfers, report a problem, saved places, upcoming bills) now keep that button pinned at the bottom, like Bank and Invest. (2) Hard lines are gone: dividers between rows in receipts, totals and cards are invisible (spacing does the work), community posts are separated by a soft grey band, and the home account block and menu rows have no rules. (3) Messages: the black underline under "All / Unread / Archived" sat 14px left of the word (a leftover half-width shift); it now sits exactly under it. (4) Directions: the long "Avoid stairs when traveling with a stroller or wheelchair" banner is one short line, with less padding, so the map gets more room. No flow or data changes. */
(function(){
const st=document.createElement('style');st.id='v247css';st.textContent=
'.mtabs .cch{position:relative!important}.mtabs .cch.on::after{transform:none!important}'+
'div[style*="border-top:0"]:not(.cta):not(.sheet),div[style*="border-bottom:0"]:not(.cta):not(.sheet){border-top-color:transparent!important;border-bottom-color:transparent!important}'+
'.post{border-bottom:8px solid color-mix(in srgb,var(--tx) 2.5%,var(--bg))!important}'+
'.mi,.hc{border-top-color:transparent!important;border-bottom-color:transparent!important}'+
'.fi{border-color:color-mix(in srgb,var(--tx) 5%,transparent)!important}'+
'[onclick="mpNs()"]{padding:8px 14px!important;margin-top:6px!important;min-height:0!important}';
document.head.appendChild(st);
['invAl','invAp','bkpay','bksch','bkcase','mpsaved','bills96'].forEach(n=>{const f=screens[n];if(!f)return;
 screens[n]=()=>{const h=f();if(h.indexOf('class="cta"')>=0)return h;
  const d=document.createElement('div');d.innerHTML=h;
  const b=[...d.querySelectorAll('button.btn')].find(x=>!x.closest('.sheet')&&!x.disabled||false)||[...d.querySelectorAll('button.btn')][0];
  if(!b)return h;
  const par=b.parentElement;b.remove();
  if(par&&par!==d&&!par.children.length&&!par.textContent.trim())par.remove();
  b.style.cssText+=';height:52px;font-size:16px;border-radius:16px;margin:0;width:100%';
  const c=document.createElement('div');c.className='cta';c.appendChild(b);d.appendChild(c);return d.innerHTML}});
{const _r=screens.route;screens.route=()=>_r()
 .replace('Avoid stairs when traveling with a stroller or wheelchair','Avoid stairs')
 .replace('Irinde ingazi ufite akagare k’umwana cyangwa intebe y’abafite ubumuga','Irinde ingazi')
 .replace('Éviter les escaliers (poussette ou fauteuil roulant)','Éviter les escaliers')}
document.title=document.title.replace('v246','v247');
})();
</script>
<script>
/* v248: UI/UX audit pass. Checked all 123 screens in English, French and Kinyarwanda at 390 and 360 px, light and dark, plus 156 taps across the seven main tabs (no script errors, no dead taps). Fixes: (1) Home: the two Recent activity rows were flush to the screen edge while every other Home row sits on the 24 px grid; they now align. (2) Rows with a value on the right (Bank "Coming up", Ikimina, loans and others) no longer squeeze the name into three lines; the value stays on one line and the name wraps to at most two. (3) Settings, Devices, Text size and Pay settings drop the grey rounded cards for flat groups separated by space, matching Bank details; no extra lines or bands were added. (4) Disabled main buttons (Next, Send, Create goal) were a washed-out 35% tint with unreadable text; they now keep a plain grey fill with readable text. (5) The delete key on every number pad had no accessible name; it now reads "Delete" (Siba, Supprimer). (6) Maps contrast: route timeline labels pick white or dark text per bar colour, the green \"Open\" label is darker, and in dark mode text on lavender buttons turns dark (it was 2.9:1) and the red and green route status text is lighter. (7) Pockets: the progress bar was a fixed 140 px, now fills the row. Not changed: Settings still lists Notifications twice (a row and a section), left for a product decision. */
(function(){
const st=document.createElement('style');st.id='v248css';st.textContent=
/* 1 Home alignment */
'#sc .hc>.row{padding-left:24px!important;padding-right:24px!important}'+
/* 2 rows with a right-hand value */
'.row .r{white-space:nowrap;flex-shrink:0}.row>div:nth-child(2){min-width:0}'+
'.row>div:nth-child(2) .t{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}'+
/* 3 flat settings groups */
'.stc{margin:0;background:none;border-radius:0;padding:4px 0 0}'+
'.stc .agt{padding:32px 24px 4px}.stc:first-of-type .agt{padding-top:24px}'+
/* 4 disabled buttons */
'.btn:disabled{opacity:1;background:var(--chip);color:var(--mu);cursor:not-allowed}'+
/* 6 "Open" status green */
'[style*="#2BA84A" i]{color:#067A4C!important}'+
'@media (prefers-color-scheme:dark){:root:not([data-theme=light]) [style*="#2BA84A" i]{color:#3DD17A!important}}'+
':root[data-theme=dark] [style*="#2BA84A" i]{color:#3DD17A!important}'+
/* 7 pockets bar */
'.pkrow>div:nth-child(2){flex:1}.pkrow .pkbar{width:100%!important;max-width:none}';
document.head.appendChild(st);
/* 5 keypad delete key name */
const L={rw:'Siba',fr:'Supprimer'};
const lum=c=>{const a=c.match(/[\d.]+/g).map(Number);const f=x=>{x/=255;return x<=.03928?x/12.92:Math.pow((x+.055)/1.055,2.4)};return .2126*f(a[0])+.7152*f(a[1])+.0722*f(a[2])};
const isDark=()=>{const t=document.documentElement.dataset.theme;return t==='dark'||(t!=='light'&&matchMedia('(prefers-color-scheme: dark)').matches)};
const DK={'rgb(217, 45, 32)':'#FF7A6E','rgb(59, 125, 32)':'#7FD45A'};
function dark(v){if(!isDark())return;
 v.querySelectorAll('*').forEach(e=>{const cs=getComputedStyle(e);
  if(cs.backgroundColor==='rgb(143, 137, 255)'){e.style.color='#17171C';e.querySelectorAll('*').forEach(c=>{if(getComputedStyle(c).color==='rgb(255, 255, 255)')c.style.color='#17171C'})}
  else if(DK[cs.color]&&[...e.childNodes].some(n=>n.nodeType==3&&n.textContent.trim()))e.style.color=DK[cs.color]})}
const cr=(a,b)=>(Math.max(a,b)+.05)/(Math.min(a,b)+.05);
function lab(){const v=document.getElementById('view');if(!v)return;dark(v);
 v.querySelectorAll('.seg>div[style*="background"]').forEach(d=>{const bg=getComputedStyle(d).backgroundColor;if(!/^rgb/.test(bg)||!d.textContent.trim())return;const l=lum(bg),want=cr(l,1)>=cr(l,lum('rgb(18,18,22)'))?'#fff':'#17171C';if(d.style.color!==want)d.style.color=want});
 v.querySelectorAll('.keys button:not([aria-label])').forEach(b=>{if(!b.textContent.trim())b.setAttribute('aria-label',L[S.lang]||'Delete')})}
const v=document.getElementById('view');if(v){new MutationObserver(lab).observe(v,{childList:true,subtree:true});lab()}
document.title=document.title.replace(/v\d+/,'v248');
})();
</script>
<script>
/* v249: Follow-up to v248. (1) Rows with an amount on the right hide their small arrow (the whole row is still tappable) and give the name all the leftover width, so "Ikimina · Umurenge Savers" wraps in two lines instead of being cut off. (2) The green Open / live badge (.lv) goes from 3.1:1 to 5.4:1 on white in light mode; dark mode keeps the bright green. */
(function(){
const st=document.createElement('style');st.id='v249css';st.textContent=
'.row>div:nth-child(2){flex:1}.row>div:nth-child(2) .t{-webkit-line-clamp:2}'+
'.lv{color:#067A4C!important;border-color:#067A4C!important}'+
'@media (prefers-color-scheme:dark){:root:not([data-theme=light]) .lv{color:#3DD17A!important;border-color:#3DD17A!important}}'+
':root[data-theme=dark] .lv{color:#3DD17A!important;border-color:#3DD17A!important}';
document.head.appendChild(st);
function fixr(){document.querySelectorAll('#view .row>.r').forEach(r=>{if(r.textContent.trim()&&r.querySelector('svg')&&!r.dataset.f){r.dataset.f=1;r.querySelector('svg').style.display='none'}})}
const v=document.getElementById('view');if(v){new MutationObserver(fixr).observe(v,{childList:true,subtree:true});fixr()}
document.title=document.title.replace(/v\d+/,'v249');
})();
</script>
<script>
/* v250: Receipt and detail summaries go flat. The grey rounded boxes on Sent, Bill paid, Order placed, Sacco and the bank transfer details lose their fill and corners and keep a single thin line above, so they read as part of the page like Bank details. Input boxes (amount, FX, points, limits) and highlighted callouts keep their boxes. */
(function(){
const st=document.createElement('style');st.id='v250css';st.textContent=
'[style*="border-radius:20px"][style*="background:var(--chip)"][style*="padding:4px 20px"],[style*="border-radius:20px"][style*="background:var(--chip)"][style*="padding:2px 18px"]{background:none!important;border-radius:0!important;padding-left:0!important;padding-right:0!important;border-top:0}';
document.head.appendChild(st);
document.title=document.title.replace(/v\d+/,'v250');
})();
</script>
<script>
/* v251: The REG electricity bill listed on Home ("Due Fri, 23 Oct · 18,500 RWF") opened Pay bills with an empty meter field, so the person had to type 11 digits for a bill the app already knew. The prototype already remembers a meter per provider after the first payment, so a sample REG meter is now saved from the start. Tapping Pay on Home lands on a ready-to-continue form, and Bill paid shows the meter number. Other providers still start empty. */
(function(){
try{S.sm=Object.assign({'REG electricity':'48210937661'},S.sm||{})}catch(e){}
document.title=document.title.replace(/v\d+/,'v251');
})();
</script>
<script>
/* v252: Home shortcut strip (Bills, Card, Savings, All). It is a row of links, not tabs, so it needs no selected state; the extra empty space under it is trimmed so "Spent this period" sits closer, and the line above it is kept. */
(function(){
const st=document.createElement('style');st.id='v252css';st.textContent='.hc .hf{padding-bottom:0!important;padding-top:12px!important}.hf+.hc,.hc:has(.hf)+.hc{margin-top:0}';
document.head.appendChild(st);
document.title=document.title.replace(/v\d+/,'v252');
})();
</script>
<script>
/* v253: Eats list. (1) The "Yes" button in the delivery address banner was squeezed to a clipped "Y"; it now keeps its full width. (2) Category names such as "Brochette" broke mid-word ("Brochet/te"); the category buttons now widen to fit their name and the row scrolls sideways as before. Found by walking the real order flow: restaurant, add item and cart work, and the cart's order button stays off below the 2,000 RWF minimum as designed. */
(function(){
const st=document.createElement('style');st.id='v253css';st.textContent='.bub button{white-space:nowrap;flex-shrink:0;min-width:56px;padding-left:16px;padding-right:16px}.bub span{min-width:0}.ecat{white-space:nowrap;width:auto!important;min-width:72px;padding-left:6px;padding-right:6px;word-break:keep-all}';
document.head.appendChild(st);
document.title=document.title.replace(/v\d+/,'v253');
})();
</script>
<script>
/* v254: fixes found by auditing the whole prototype in a real browser (flows, dark mode, fr/rw, keyboard).
   1 dark mode: dark-brown icon strokes (bank, Eats, Marketplace, Jobs) were 1.75:1 on dark chips
   2 text under 12px (discount badges, chat times, route times) raised to 12px
   3 names on home / bank rows no longer cut with an ellipsis, they wrap to two lines
   4 "+ Add" on Send looked tappable but did nothing: it now takes you to the number field
   5 send confirmation shows the recipient's number under the name, so a wrong contact is easy to spot */
(function(){
const css=`
:root[data-theme=dark] #phone svg [fill="#664500"]{fill:#F2C879}
:root[data-theme=dark] #phone svg [stroke="#664500"]{stroke:#F2C879}
@media (prefers-color-scheme:dark){
 :root:not([data-theme=light]) #phone svg [fill="#664500"]{fill:#F2C879}
 :root:not([data-theme=light]) #phone svg [stroke="#664500"]{stroke:#F2C879}
}
.dbadge,.ti .tm,#phone .mm-t{font-size:12px}
#phone .row .t{white-space:normal;overflow-wrap:anywhere;-webkit-line-clamp:unset;overflow:visible;max-height:none}
#phone .hc .row .t{overflow:hidden;text-overflow:clip;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical}
#phone .sech a[role=button]{min-height:44px;display:inline-flex;align-items:center;margin:-12px 0;cursor:pointer}
@keyframes cf{from{transform:translate(0,0) rotate(0);opacity:1}45%{opacity:1}to{transform:translate(var(--x),calc(var(--y)*.3)) rotate(var(--r));opacity:0}}
#phone .v254who{font-size:13px;font-weight:600;color:var(--tt);margin-top:2px;font-variant-numeric:tabular-nums}
`;
const st=document.createElement('style');st.id='v254css';st.textContent=css;document.head.appendChild(st);
const ph=document.getElementById('phone'),ly=document.getElementById('layer');
const lang=(en,rw,fr)=>{try{return S.lang==='rw'?rw:S.lang==='fr'?fr:en}catch(e){return en}};
function addPick(){
 const f=document.getElementById('rcv');
 if(f){f.focus();try{f.scrollIntoView({block:'center'})}catch(e){}}
 try{toast(lang('Type their number, then tap Next.','Andika nimero yabo, hanyuma ukande Komeza.','Saisissez son numéro, puis touchez Suivant.'))}catch(e){}
}
function fix(){
 const cta=ph.querySelector('.cta');
 if(cta&&!cta.querySelector('.v254act')&&S.auth&&['sent','paydone','billdone'].includes(S.stack[S.stack.length-1])){
  const b=document.createElement('button');b.className='v254act';b.type='button';
  b.textContent=lang('View in activity','Reba mu mateka','Voir dans l’activité');
  b.style.cssText='display:block;width:100%;height:44px;margin-top:8px;border:0;background:none;font-weight:700;font-size:15px;color:var(--lk)';
  b.onclick=()=>{S.stack.push('activity');render('push')};
  cta.appendChild(b);
 }
 ph.querySelectorAll('.cch:not([aria-pressed]),.ecat:not([aria-pressed]),.req button:not([aria-pressed])').forEach(e=>{const g=e.parentElement;if(g&&[...g.children].some(c=>c!==e&&c.classList.contains('on'))||e.classList.contains('on'))e.setAttribute('aria-pressed',e.classList.contains('on')?'true':'false')});
 ph.querySelectorAll('.sech a:not([onclick]):not([role])').forEach(a=>{
  if(!(S.auth&&S.stack[S.stack.length-1]==='recipient'))return;
  a.setAttribute('role','button');a.tabIndex=0;a.setAttribute('aria-label',lang('Add a number','Ongeraho nimero','Ajouter un numéro'));
  a.addEventListener('click',addPick);
  a.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();addPick()}});
 });
 ly.querySelectorAll('.sheet[aria-label="Confirm"]:not([data-v254])').forEach(sh=>{
  sh.dataset.v254='1';
  try{
   const num=String(S.to||'').trim(),name=nm9(S.to);
   if(!/\d{6,}/.test(num.replace(/\s/g,''))||String(name).trim()===num)return;
   const el=[...sh.querySelectorAll('.mu')].find(e=>e.textContent.includes(name));
   if(el&&!el.querySelector('.v254who')){const d=document.createElement('div');d.className='v254who';d.textContent=num;el.appendChild(d)}
  }catch(e){}
 });
}
let q=0;const sched=()=>{if(q)return;q=requestAnimationFrame(()=>{q=0;fix()})};
new MutationObserver(sched).observe(ph,{childList:true,subtree:true});
new MutationObserver(sched).observe(ly,{childList:true,subtree:true});
fix();
document.title=document.title.replace(/v\d+/,'v254');
})();
</script>
<script>
/* v255: Whole-prototype UI/UX audit (123 screens, light and dark, 390 px). Found and fixed: (1) 14 screens lost their 24 px side margin, so text, amounts and switches touched the screen edge (Notifications, Passkeys, Transfer settings, Subscriptions, Devices, Rides, Points, Coupons, Daily challenge, Card cashback, Partner links, Connect friends, Purchase history, Auto-transfer). Cause: the v229/v231 rule .row{padding:Npx 0!important} cancelled the inline 24 px side padding that these rows rely on. (2) On the same screens the on/off switches were stretched into wide pills by the .row>div:nth-child(2){flex:1} rule; they are 48x28 again. (3) Theme: unselected options showed a faint check mark that looked like a selected state; only the chosen option shows a check now. (4) Amount chips in four-column grids (New auto-transfer) broke numbers across two lines (1,00 / 0); they stay on one line. */
(function(){
const st=document.createElement('style');st.id='v255css';st.textContent=
'.row[style*="px 24px"]{padding-left:24px!important;padding-right:24px!important}'+
'.row>.sw{flex:0 0 48px!important;width:48px!important;min-width:48px!important}'+
'.ar svg[stroke="var(--ln)"]{visibility:hidden}'+
'[style*="repeat(4,1fr)"]>.chip{padding:0 6px!important;justify-content:center;white-space:nowrap;min-width:0}';
document.head.appendChild(st);
document.title=document.title.replace(/v\d+/,'v255');
})();
</script>
<script>
/* v256: Second audit pass on v255. (1) Product: the "Buy now · 6,500" button broke onto two lines; the two bottom buttons now keep their labels on one line (Add to cart 40 %, Buy now 60 %). (2) Empty screens: Scheduled transfers and Report a problem showed only a loose sentence. They now follow the same empty-state layout as My orders and Saved places: a short heading saying what is empty, one line of explanation, and the action stays in the bottom bar. */
(function(){
const st=document.createElement('style');st.id='v256css';st.textContent=
'.cta[style*="display:flex"]>.btn{white-space:nowrap;min-width:0;padding-left:10px;padding-right:10px}'+
'.cta[style*="display:flex"]>.btn:first-child:not(:last-child){flex:2 1 0!important}'+
'.cta[style*="display:flex"]>.btn:last-child:not(:first-child){flex:3 1 0!important}'+
'.es256{text-align:center;padding:72px 16px 0}.es256 b{display:block;font-size:18px;font-weight:800}.es256 div{margin-top:8px;font-size:15px;line-height:22px}';
document.head.appendChild(st);
const EMPTY={bksch:'No scheduled transfers yet',bkcase:'No open cases'};
const _r=render;
render=function(){const o=_r.apply(this,arguments);try{
 const k=S.stack&&S.stack[S.stack.length-1];const h=EMPTY[k];
 if(h){const d=document.querySelector('#phone .screen .pad>.mu:not([data-es])');
  if(d&&!d.closest('.es256')){const t=d.textContent.trim();d.parentElement.innerHTML='<div class="es256"><b>'+h+'</b><div class="mu" data-es="1">'+t+'</div></div>'}}
}catch(e){}return o};
document.title=document.title.replace(/v\d+/,'v256');
})();
</script>
<script>
/* v257: Third audit pass (123 screens x light/dark at 390 px, plus 360 px for small Android phones, plus keyboard and screen-reader checks). Found and fixed: (1) At 360 px the Bank header (Back, Card, Statement, Manage) was 11 px wider than the screen, so Manage touched the screen edge; the header buttons now tighten below 380 px and always fit. (2) The bottom bar had no navigation role, no marker for the current tab, and the Messages tab was announced as "1Messages"; it is now a labelled navigation, the open tab is marked, and Messages reads "Messages, 1 unread". (3) Added a higher-contrast mode for people who ask their phone for it: secondary text and dividers get darker. */
(function(){
const st=document.createElement('style');st.id='v257css';st.textContent=
'@media (max-width:380px){#phone .bdt{padding-left:8px;padding-right:8px}#phone .bdt .bb{padding:0 4px;gap:3px;font-size:14px}}'+
'@media (prefers-contrast:more){:root:not([data-theme=dark]){--mu:#4E5968;--tt:#6B7684;--ln:#B0B8C1}}'+
'@media (prefers-contrast:more) and (prefers-color-scheme:dark){:root:not([data-theme=light]){--mu:#C3C9D2;--tt:#AEB5C0;--ln:#4E5968}}'+
':root[data-theme=dark]{--lnx:1}';
document.head.appendChild(st);
const ph=document.getElementById('phone');
function nav(){
 const t=ph.querySelector('.tabs');if(!t)return;
 if(t.getAttribute('role')!=='navigation'){t.setAttribute('role','navigation');t.setAttribute('aria-label','Main')}
 t.querySelectorAll('button').forEach(b=>{
  if(b.classList.contains('on'))b.setAttribute('aria-current','page');else b.removeAttribute('aria-current');
  const badge=[...b.querySelectorAll('*')].find(e=>!e.children.length&&/^\d+\+?$/.test(e.textContent.trim()));
  if(badge){
   const n=badge.textContent.trim();
   const name=b.textContent.replace(n,'').trim();
   const want=name+', '+n+' unread';
   if(b.getAttribute('aria-label')!==want)b.setAttribute('aria-label',want);
  }
 });
}
let q=0;const sched=()=>{if(q)return;q=requestAnimationFrame(()=>{q=0;nav()})};
new MutationObserver(sched).observe(ph,{childList:true,subtree:true,attributes:true,attributeFilter:['class']});
nav();
document.title=document.title.replace(/v\d+/,'v257');
})();
</script>
<script>
/* v258: Fourth pass, a click-through of the whole app (about 900 real taps at 390 and 360 px, light and dark) after v257. Found and fixed: Cash at an agent (Pay and You tabs) threw "agDraw is not defined" when you changed Withdraw/Deposit or the amount, because the screen's buttons call a function that was hidden inside its own block; it is now reachable, so those buttons work. Also checked and found clean: 467 extra taps across all 123 screens (no errors), every small button already has a 44 px touch area, and one overflow flagged on Messages was only the slide-in animation, not a layout fault. */
document.title=document.title.replace(/v\d+/,'v258');
</script>
<script>
/* v259: Language pass. Switching to Français or Kinyarwanda left about 100 phrases in English across Score, Notifications, Invest, Pockets, Eats, Cards and Subscriptions. This adds the missing French and Kinyarwanda for the ones that are real app text (menu, settings, score, savings, notifications); place names, sample people and business names stay as they are. The Kinyarwanda lines are my first draft and should be read by a native speaker before release. */
(function(){
const D={"Debit card for your itunda Bank account": ["Carte de débit liée à votre compte itunda Bank", "Ikarita ya debit ihujwe na konti yawe ya itunda Bank"], "Order placed": ["Commande passée", "Itumiza ryakozwe"], "Prototype: fill a returning number": ["Prototype : remplir un numéro connu", "Prototype: shyiramo nimero yamenyekanye"], "Skip (prototype)": [null, "Simbuka (prototype)"], "Prototype: no real account was created.": [null, "Prototype: nta konti nyayo yafunguwe."], "Menu and prices are sample data.": [null, "Menu n'ibiciro ni ibyitegererezo."], "Paid with itunda Pay": [null, "Byishyuwe na itunda Pay"], "Your delivery": [null, "Iyoherezwa ryawe"], "Order tracking and the rider are simulated for this prototype.": [null, "Gukurikirana itumiza n'uwarijyanye ni igerageza muri iyi prototype."], "What shapes your score": [null, "Ibigena amanota yawe"], "Payment history": [null, "Amateka y'ubwishyu"], "Mobile money activity": [null, "Ibyakozwe kuri mobile money"], "Savings habits": [null, "Uko wizigama"], "Account age": [null, "Igihe konti imaze"], "Interest received": [null, "Inyungu wabonye"], "Paid to you now": ["Versé maintenant", "Wishyurwa ubu"], "Get your interest today": [null, "Fata inyungu yawe uyu munsi"], "Your shares": [null, "Imigabane yawe"], "Share price": [null, "Igiciro cy'umugabane"], "Dividend (sample)": [null, "Inyungu y'umugabane (urugero)"], "Save together": [null, "Zigame hamwe"], "A first account for your child": ["Un premier compte pour votre enfant", "Konti ya mbere y'umwana wawe"], "Total in pockets": ["Total dans les pochettes", "Yose hamwe mu mifuka"], "To Interest jar": ["Vers la tirelire Intérêts", "Ujya mu kibindi cy'inyungu"], "How much to fill?": [null, "Ushyiramo angahe?"], "Try itunda Eats": ["Essayez itunda Eats", "Gerageza itunda Eats"], "Money in, money out, bills": ["Argent reçu, argent envoyé, factures", "Amafaranga yinjiye, yasohotse, fagitire"], "Deals and cashback": ["Offres et cashback", "Ibyatanzwe n'amafaranga asubizwa"], "Replies and neighbourhood posts": ["Réponses et publications du quartier", "Ibisubizo n'ibyatangajwe mu gace utuyemo"], "Map updates": ["Mises à jour de la carte", "Amakuru mashya ya karita"], "Bus delays and saved places": ["Retards de bus et lieux enregistrés", "Gutinda kwa bisi n'ahantu wabitse"], "Choose what itunda can notify you about.": [null, "Hitamo ibyo itunda ishobora kukumenyesha."], "MTN data bundle": ["Forfait data MTN", "Ipaki ya data ya MTN"], "Music streaming": ["Streaming musical", "Umuziki wo kuri murandasi"], "Payments": ["Paiements", "Ubwishyu"], "Good": ["Bon", "Byiza"], "Range 300 to 850": ["De 300 à 850", "Kuva kuri 300 kugeza kuri 850"]};
const W=[[/(🇺🇸 USD|🇪🇺 EUR|🇬🇧 GBP) wallet/,['$1'.length?'Portefeuille ':'', 'Igikapu cya ']]];
const ph=document.getElementById('phone'),ly=document.getElementById('layer');
function tr(root){
 const l=(typeof S!=='undefined'&&S.lang)||'en';if(l==='en')return;const i=l==='fr'?0:1;
 const w=document.createTreeWalker(root,NodeFilter.SHOW_TEXT);let n;
 while(n=w.nextNode()){
  const raw=n.nodeValue,t=raw.trim();if(t.length<4)continue;
  const d=D[t];if(d&&d[i]){n.nodeValue=raw.replace(t,d[i]);continue}
  if(/ · (Monthly|Weekly|Yearly) · Next /.test(t)){n.nodeValue=raw.replace('Monthly',i?'Buri kwezi':'Mensuel').replace('Weekly',i?'Buri cyumweru':'Hebdo').replace('Yearly',i?'Buri mwaka':'Annuel').replace('Next ',i?'Ikurikira ':'Prochain ');continue}
  const m=t.match(/^(🇺🇸 USD|🇪🇺 EUR|🇬🇧 GBP) wallet$/);
  if(m)n.nodeValue=raw.replace(t,(i?'Igikapu cya ':'Portefeuille ')+m[1].replace(/^\S+ /,''));
 }
}
let q=0;const run=()=>{if(q)return;q=requestAnimationFrame(()=>{q=0;try{tr(ph);if(ly)tr(ly)}catch(e){}})};
[ph,ly].forEach(e=>e&&new MutationObserver(run).observe(e,{childList:true,subtree:true}));
run();
document.title=document.title.replace(/v\d+/,'v259');
})();
</script>
<style id="v260css">
.sheet .bpbar{margin:20px -24px -28px;padding:12px 24px 24px;border-top:0;background:var(--bg)}
.sheet .bpbar .btn{height:52px;font-size:16px;border-radius:16px}
</style>
<script>
/* v260: Saved recipient sheet (Landlord, Diane M.): "Send money" now sits in a bottom bar, the same way Fill and Send sit in the Bank detail screen. The bar has a divider line, 52 px button height and 16 px corners, and stays at the bottom of the sheet; Schedule, Favourite, Edit and Delete stay above it. */
document.title=document.title.replace(/v\d+/,'v260');
</script>
<style id="v261css">
/* v261: soft look, no hairlines. Dividers are gone (spacing does the separating) and outlined pills, boxes and fields use the soft grey fill instead of a stroke. */
#phone .acts button,#phone .pbtn,#phone .bds,#phone .rbox,#phone .abox,#phone .sh5-ad,#phone .sh5-in,#phone .sh5-ta,#phone .mm-rx,#phone .ti .tm,#layer .sh5-ad,#layer .sh5-in,#layer .sh5-ta{border:0!important;background:var(--chip)!important}
#phone .mm-rx{background:var(--chip)!important}
@media (max-width:430px){#phone{border:0}}
</style>
<script>document.title=document.title.replace(/v\d+/,'v261');</script>
<script>
/* v262: Softer section bands. The wide grey bands between sections (Pay, Bank, Transit, Contacts and other screens) were 10 px thick and fairly dark. They are now 8 px and about half as dark, in light and dark themes. */
document.title=document.title.replace(/v\d+/,'v262');
</script>
<style id="v263css">
/* Place: restore the two coloured action buttons (v261 had flattened them, which left "Arrive" as white text on light grey) */
#phone .acts button.p{background:var(--tint)!important;color:var(--tintfg)!important}
#phone .acts button.q{background:var(--lk)!important;color:#fff!important}
/* Directions: bottom bar keeps the travel time readable, mode tabs keep "1h34m" on one line */
#phone .cta[style*="align-items:center"]>span[style*="flex-direction:column"]{flex:1 0 auto;min-width:104px}
#phone .cta[style*="align-items:center"]>span .sm{font-size:12px}
#phone .cta[style*="align-items:center"]>.btn[onclick^="mpStart"]{padding:0 14px!important;flex:0 1 auto;min-width:0;white-space:nowrap}
#phone .cta[style*="align-items:center"]>.btn[onclick="mpStart(false)"]{padding:0 18px!important}
#phone .modes button{white-space:nowrap;gap:4px;padding-left:6px;padding-right:6px;min-width:0}
@media (max-width:380px){#phone .cta[style*="align-items:center"]{padding-left:16px;padding-right:16px;gap:8px}#phone .cta[style*="align-items:center"]>span[style*="flex-direction:column"]{min-width:96px}#phone .cta[style*="align-items:center"]>.btn[onclick^="mpStart"]{padding:0 12px!important;flex:0 0 auto}}
/* Search: recent places show the name on one line with the date underneath, instead of a wrapped name beside a date */
#phone .pl:has(>button.ib){display:grid;grid-template-columns:44px minmax(0,1fr) 32px;grid-template-areas:"i b x" "i s x";column-gap:12px;row-gap:1px;align-items:center}
#phone .pl:has(>button.ib)>i{grid-area:i}
#phone .pl:has(>button.ib)>b{grid-area:b;font-size:16px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;align-self:end}
#phone .pl:has(>button.ib)>span{grid-area:s;font-size:13px;color:var(--mu);align-self:start}
#phone .pl:has(>button.ib)>button.ib{grid-area:x}
</style>
<script>
/* v263: Maps pass. (1) Place: my v261 "no outlines" rule had also removed the colour from the two main buttons, so "Arrive" was white text on light grey; Depart and Arrive have their colours back, and read "From here" and "Directions" in English because "Depart / Arrive" did not say what they do. (2) Directions: the bottom bar squeezed "35 min / 2:41 pm arrival" to 42 px under the Preview button; the travel time now has its own space and the buttons are narrower. The walking tab no longer breaks "1h34m" over two lines. (3) Search: recent places keep the place name on one line with the date under it, so names no longer wrap. */
(function(){
const ph=document.getElementById('phone');
function lab(){
 try{if(S.lang!=='en')return}catch(e){return}
 ph.querySelectorAll('.acts button[onclick="mpDepart()"]').forEach(b=>{if(b.textContent.trim()==='Depart')b.textContent='From here'});
 ph.querySelectorAll('.acts button[onclick="mpArrive()"]').forEach(b=>{if(b.textContent.trim()==='Arrive')b.textContent='Directions'});
}
let q=0;const sc=()=>{if(q)return;q=requestAnimationFrame(()=>{q=0;lab()})};
new MutationObserver(sc).observe(ph,{childList:true,subtree:true});lab();
document.title=document.title.replace(/v\d+/,'v263');
})();
</script>
<script>
/* v265: itunda Pay detail, reworked with ideas from the Toss Pay Money screens. (1) Move and Top up sit right under the balance, the way Toss puts Move and Top up there. (2) "Top-up account" in the top bar picks which account Top up uses first (itunda Bank, MTN MoMo, Airtel Money, balances are sample data). (3) Top up and Move are one amount screen: who it is from or to at the top (tap to change), "How much to top up?" turns into "10,000 RWF to top up?" as you type, quick chips, Confirm bar above the keypad. (4) The ledger has a month picker and a "Payments only" switch, lines read "time | from → to", and day headings carry the weekday. (5) Top up and Move change the real balances and show on both the Pay and the Bank ledgers; the Pay tab's Add button now opens Top up. The search and the money in / out filter of v264 are replaced by the month picker and the switch. */
(function(){
const T3=(a,b,c)=>({rw:b,fr:c}[S.lang]||a);
const esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const PAYID='0788-1205-1980';
S.tu=S.tu||{src:'bank',dst:'bank',mtn:85000,airtel:20000};
S.pmo=0;S.pOnly=false;
/* older Pay sample lines, added once at the end of the list so the newest lines stay on top */
if(!S.pd265){S.pd265=1;const ago=(d,h,m)=>{const x=new Date();x.setDate(x.getDate()-d);x.setHours(h,m,0,0);return x.getTime()};
[['food','Kigali Bakery','Paid',-4500,'Paid',ago(6,8,12)],['up','Top up','Received',50000,'Received',ago(7,18,40),'pay','MTN MoMo → Pay'],['bag','itunda Shop','Paid',-18000,'Paid',ago(9,14,5)],['bus','Kigali Bus Services','Paid',-300,'Paid',ago(10,7,50)],['food','Heaven Restaurant','Paid',-12500,'Paid',ago(12,19,25)]].forEach(([g,t,k,a,kk,ts,...r])=>S.act.push([g,t,k+' · '+tm48(ts),a,kk,ts,...r]))}
/* v403: lines that only had a day word ("Paid · Tuesday") get a real time, so every ledger line reads "time" under its name like the Toss list */
S.act.forEach(x=>{if(x&&!x[5]&&typeof x[2]==='string'){const w=(x[2].split(' · ')[1]||'').trim(),d=new Date();if(w==='Yesterday')d.setDate(d.getDate()-1);else{const k=['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'].indexOf(w);if(k<0)return;let n=(d.getDay()-k+7)%7;d.setDate(d.getDate()-(n||7))}d.setHours(x[3]>0?18:8,x[3]>0?20:5,0,0);x[5]=d.getTime()}});
/* which ledger a line belongs to: lines tagged 'pay' or 'bank' (index 6), else the old rule */
const side=x=>x[6]||(BKX(x)?'pay':'bank');
window.ledger50=function(){let bal=S.bank;return S.act.filter(x=>side(x)==='bank').map(x=>{const r={x,bal};bal-=x[3];return r})};
const payLedger=()=>{let bal=S.pay;return S.act.filter(x=>side(x)==='pay').map(x=>{const r={x,bal};bal-=x[3];return r})};
/* accounts */
const SRC=()=>[{k:'bank',n:'itunda Bank',s:'••1980',b:S.bank},{k:'mtn',n:'MTN MoMo',s:'078 ••• 1980',b:S.tu.mtn},{k:'airtel',n:'Airtel Money',s:'073 ••• 1980',b:S.tu.airtel}];
const src=k=>SRC().find(x=>x.k===k)||SRC()[0];
const sico=(k,z)=>k==='bank'?`<span class="pkico" style="width:${z}px;height:${z}px;border-radius:${z/2}px">${gl('bank',Math.round(z*.6))}</span>`:`<span style="width:${z}px;height:${z}px;border-radius:${z/2}px;background:${k==='mtn'?'#FFCB05':'#E4002B'};color:${k==='mtn'?'#111':'#fff'};display:flex;align-items:center;justify-content:center;font-weight:800;font-size:${Math.round(z*.42)}px;flex-shrink:0">${k==='mtn'?'M':'A'}</span>`;
/* dates */
const loc=()=>S.lang==='fr'?'fr-FR':'en-GB';
const isMonth=(x,off)=>{const n=new Date(),m=new Date(n.getFullYear(),n.getMonth()-off,1),d=x[5]?new Date(x[5]):n;return d.getMonth()===m.getMonth()&&d.getFullYear()===m.getFullYear()};
const monthName=(off,y)=>{const n=new Date(),m=new Date(n.getFullYear(),n.getMonth()-off,1);return m.toLocaleDateString(loc(),y?{month:'long',year:'numeric'}:{month:'long'})};
const dayLbl=x=>{if(!x[5])return when50(x);const s=new Date(x[5]).toLocaleDateString(loc(),{weekday:'short',day:'numeric',month:'short'});return day48(x[5])==='Today'?T3('Today','Uyu munsi','Aujourd’hui')+' · '+s:s};
const subOf=x=>{const tm=x[5]?tm48(x[5]):x[2].split(' · ')[0];return x[7]?tm+' | '+x[7]:tm};
const isPay=x=>x[3]<0&&!x[7];
const spentMonth=()=>payLedger().reduce((a,{x})=>isPay(x)&&isMonth(x,0)?a-x[3]:a,0);
function pdList(){const rows=payLedger().filter(({x})=>isMonth(x,S.pmo)&&(!S.pOnly||isPay(x)));
if(!rows.length)return `<div class="pkempty">${S.pOnly?T3('No payments this month.','Nta kwishyura muri uku kwezi.','Aucun paiement ce mois-ci.'):T3('No activity this month.','Nta cyakozwe muri uku kwezi.','Aucune activité ce mois-ci.')}</div>`;
const g=[];rows.forEach(r=>{const d=dayLbl(r.x),l=g[g.length-1];if(l&&l[0]===d)l[1].push(r);else g.push([d,[r]])});
return g.map(([d,rs])=>`<div class="pkg">${d}</div>${rs.map(({x,bal})=>{const inn=x[3]>0;return `<div class="bdr ${inn?'pin':''}" role="button" tabindex="0" onclick="actOpen(${S.act.indexOf(x)})"><div class="ico">${gx(x[0],26)}</div><div style="min-width:0"><div class="t">${esc(x[1]==='Top up'?T3('Top up','Ongeramo','Recharge'):x[1])}</div><div class="s">${esc(subOf(x))}</div></div><div class="pkv"><b>${String(signed(x[3])).replace(/\s*RWF$/,'')}</b></div></div>`}).join('')}`).join('')}
window.openPayDetail=()=>{S.pmo=0;S.pOnly=false;S.stack.push('payd');render('push')};
screens.payd=()=>`<div class="bdt"><button class="ib" aria-label="Back" onclick="back()">${ic('back',24)}</button><button class="bb bq" aria-label="${T3('Code','Kode','Code')}" onclick="ppCode()">${ic('qr',22)}</button><button class="bb" onclick="pdTuSet()">${T3('Top-up account','Konti yo kongeramo','Compte de recharge')}</button></div><div class="pdl1">itunda Pay</div><div class="bdb">${fmt(S.pay)}<small>RWF</small></div><div class="pad row2 pdbt"><button class="btn sec2" onclick="openMove()">${T3('Move','Imura','Déplacer')}</button><button class="btn" onclick="openTopUp()">${T3('Top up','Ongeramo','Recharger')}</button></div><div class="bdband"></div><div class="bdf"><button class="pkf" onclick="pdMonth()" aria-haspopup="dialog">${monthName(S.pmo)}${ic('chev',16)}</button><button role="switch" aria-checked="${S.pOnly}" onclick="S.pOnly=!S.pOnly;render('fade-none')" style="display:flex;align-items:center;gap:10px;border:0;background:none;color:var(--mu);font-size:15px;font-weight:600;padding:0">${T3('Payments only','Kwishyura gusa','Paiements seulement')}<i style="display:block;width:50px;height:30px;border-radius:15px;background:${S.pOnly?'var(--br)':'var(--chip)'};position:relative;transition:background .2s"><b style="position:absolute;top:3px;left:${S.pOnly?23:3}px;width:24px;height:24px;border-radius:12px;background:#fff;transition:left .2s"></b></i></button></div><div id="pdl">${pdList()}</div>`;
window.pdMonth=()=>{$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" role="dialog" aria-modal="true" aria-label="${T3('Month','Ukwezi','Mois')}"><div class="h1" style="font-size:22px;line-height:30px;margin-bottom:8px">${T3('Month','Ukwezi','Mois')}</div>${[0,1,2].map(n=>`<button class="pkopt ${S.pmo===n?'on':''}" onclick="S.pmo=${n};closeSheet();render('fade-none')">${monthName(n,1)}${S.pmo===n?CK48:''}</button>`).join('')}</div>`};
window.pdCopy=()=>{try{navigator.clipboard.writeText(PAYID).catch(()=>{})}catch(e){}toast(T3('Pay number copied','Nimero ya Pay yakoporowe','Numéro Pay copié'))};
/* top-up account screen */
window.pdTuSet=()=>{S.stack.push('putset');render('push')};
screens.putset=()=>`${bar(T3('Top-up account','Konti yo kongeramo','Compte de recharge'))}<div class="pad" style="padding-top:20px"><div class="h1" style="font-size:26px;line-height:34px">${T3('Which account should top up?','Ni iyihe konti yo kongeramo?','Quel compte doit recharger ?')}</div><div class="mu" style="font-size:15px;line-height:22px;margin-top:10px">${T3('Top up starts from this account. You can change it each time.','Kongeramo bitangirira kuri iyi konti. Ushobora kuyihindura buri gihe.','La recharge part de ce compte. Vous pouvez le changer à chaque fois.')}</div></div><div style="padding-top:14px">${SRC().map(a=>`<div class="tap" role="button" tabindex="0" onclick="S.tu.src='${a.k}';render('fade-none')" style="display:flex;align-items:center;gap:14px;padding:12px 24px;cursor:pointer">${sico(a.k,52)}<div style="flex:1;min-width:0"><div style="font-size:17px;font-weight:700">${a.n} ${a.s}</div><div class="sm mu" style="margin-top:2px">${fmt(a.b)} RWF</div></div><span style="color:var(--lk);display:flex;width:24px">${S.tu.src===a.k?CK48:''}</span></div>`).join('')}<div class="tap" role="button" tabindex="0" onclick="toast('${T3('Linking more accounts is not in this prototype yet.','Kongeraho konti ntibiraboneka muri iyi prototype.','Lier d’autres comptes n’est pas encore dans ce prototype.')}')" style="display:flex;align-items:center;gap:14px;padding:12px 24px;cursor:pointer"><span class="pkico" style="width:52px;height:52px;border-radius:26px;background:var(--chip);color:var(--lk)">${ic('plus',22)}</span><b style="font-size:17px">${T3('Add account','Ongeraho konti','Ajouter un compte')}</b></div></div><div class="sec" style="padding-top:26px"><div class="sech">${T3('Account','Konti','Compte')}</div>${row('wallet',T3('Pay number','Nimero ya Pay','Numéro Pay'),PAYID,'','pdCopy()')}${row('user',T3('Account name','Izina rya konti','Nom du compte'),esc(S.name||'You'))}${row('shield',T3('Daily limit','Urugero rwa buri munsi','Limite quotidienne'),'1,000,000 RWF')}</div><div class="pad fine" style="padding-top:18px">${T3('Balances and limits are sample data for this prototype.','Amafaranga n’imbibi ni ibitegererezo.','Soldes et limites : données d’exemple pour ce prototype.')}</div>`;
/* Top up / Move: one amount screen */
window.openTopUp=()=>{S.pu={mode:'top',k:S.tu.src,amt:''};S.stack.push('puamt');render('push')};
window.openMove=()=>{S.pu={mode:'move',k:S.tu.dst,amt:''};S.stack.push('puamt');render('push')};
const DLIM=1000000,dayK=()=>new Date().toDateString();
const usedToday=()=>S.tu.usedD===dayK()?(S.tu.used||0):0;
const limLeft=()=>Math.max(0,DLIM-usedToday());
const puMax=()=>S.pu.mode==='top'?Math.min(src(S.pu.k).b,limLeft()):S.pay;
const lastTop=()=>{const a=(S.act||[]).find(x=>x&&x[0]==='up'&&x[3]>0);return a?a[3]:0};
function puWhy(v){const p=S.pu,o=src(p.k);
 if(p.mode==='top'){if(v>o.b)return T3('Not enough in '+o.n+'. You have '+fmt(o.b)+' RWF.','Nta mafaranga ahagije kuri '+o.n+'. Ufite RWF '+fmt(o.b)+'.','Pas assez sur '+o.n+'. Vous avez '+fmt(o.b)+' RWF.');
  return T3('Daily limit is '+fmt(DLIM)+' RWF. You can add '+fmt(limLeft())+' RWF more today.','Imbibi bya buri munsi ni RWF '+fmt(DLIM)+'. Uyu munsi ushobora kongeramo RWF '+fmt(limLeft())+'.','La limite quotidienne est de '+fmt(DLIM)+' RWF. Vous pouvez encore ajouter '+fmt(limLeft())+' RWF aujourd’hui.')}
 return T3('Not enough in itunda Pay. You have '+fmt(S.pay)+' RWF.','Nta mafaranga ahagije kuri itunda Pay. Ufite RWF '+fmt(S.pay)+'.','Pas assez sur itunda Pay. Vous avez '+fmt(S.pay)+' RWF.')}
function puBody(){const p=S.pu,v=Number(p.amt||0),bad=v>puMax(),top=p.mode==='top',o=src(p.k),mx=puMax();
const ph=top?T3('How much to top up?','Ni angahe wongeramo?','Combien recharger ?'):T3('How much to move?','Ni angahe wimura?','Combien déplacer ?');
const q=v?`<b>${fmt(v)}</b> RWF`:`<span class="pph">${ph}</span>`;
const wd=v>=1e6?(Math.round(v/1e4)/100)+' '+T3('million','miliyoni',v>=2e6?'millions':'million')+' RWF':v>=1e3?(Math.round(v/10)/100)+' '+T3('thousand','ibihumbi','mille')+' RWF':'';
const lt=lastTop(),amts=[20000,50000,100000];
const CS='';
const chips=(bad?'':amts.map(n=>`<button class="chip" style="${CS}" onclick="puKey('add:${n}')">+${fmt(n)}</button>`).join('')+(top&&lt&&!amts.includes(lt)?`<button class="chip" style="${CS}" onclick="puKey('set:${lt}')">${T3('Last','Ubushize','Dernier')} ${fmt(lt)}</button>`:''))+`<button class="chip" style="${CS}${mx>0?'':';opacity:.45'}" ${mx>0?'':'disabled'} onclick="puKey('max')">${T3('All','Byose','Tout')}${mx>0?' · '+fmt(mx):''}</button>`;
const dest=top?S.pay+v:o.b+v,destN=top?'itunda Pay':o.n;
let note='',extra='';
if(bad){note=puWhy(v);if(top&&v>o.b){const alt=SRC().find(x=>x.k!==p.k&&x.b>=v);if(alt)extra=`<button class="chip" style="margin-top:8px;height:40px;padding:0 16px;font-size:14px" onclick="puSet('${alt.k}')">${T3('Use ','Koresha ','Utiliser ')}${alt.n} · ${fmt(alt.b)} RWF</button>`}}
else if(v)note=T3('%n after: %s RWF','%n izaba: RWF %s','%n après : %s RWF').replace('%n',destN).replace('%s',fmt(dest))+' · '+T3('Free, instant','Ni ubuntu, ako kanya','Gratuit, instantané');
else if(top)note=T3('Daily limit left: '+fmt(limLeft())+' RWF','Asigaye uyu munsi: RWF '+fmt(limLeft()),'Limite restante aujourd’hui : '+fmt(limLeft())+' RWF');
return `<div class="pua">${q}</div><div class="puw">${wd}</div><div class="pun${bad?' er':''}" aria-live="polite">${note}</div>${extra}<div class="puc">${chips}</div>`}
const puGoLbl=()=>T3('Confirm','Emeza','Confirmer');
const payIco=z=>`<span style="width:${z}px;height:${z}px;border-radius:${z/2}px;background:var(--tint);color:var(--tintfg);display:flex;align-items:center;justify-content:center;font-weight:800;font-size:${Math.round(z*.42)}px;flex-shrink:0">P</span>`;
screens.puamt=()=>{const p=S.pu,top=p.mode==='top',a=src(p.k),v=Number(p.amt||0),bad=v>puMax();
const row=(who,label,sub,pick)=>`<div class="pur${pick?' tap':''}" ${pick?'role="button" tabindex="0" onclick="puPick()"':''}><div class="put"><span class="pul">${label}</span><span class="pun1">${who}</span>${pick?ic('chev',16,'var(--tt)').replace('<svg','<svg style="transform:rotate(90deg);flex:none;margin-left:2px"'):''}</div><div class="pus">${sub}</div></div>`;
const A=T3('Available ','Ushobora gukoresha ','Disponible '),B=T3('Balance ','Asigaye ','Solde ');
const sb=(l,n)=>`${l}<span>${fmt(n)} RWF</span>`;
const frm=top?row(a.n,T3('From','Biva kuri','Depuis'),sb(A,a.b),1):row('itunda Pay',T3('From','Biva kuri','Depuis'),sb(A,S.pay),0);
const to=top?row('itunda Pay',T3('To','Ujya kuri','Vers'),sb(B,S.pay),0):row(a.n,T3('To','Ujya kuri','Vers'),sb(B,a.b),1);
const ttl=top?T3('Top up','Ongeramo','Recharge'):T3('Move','Imura','Déplacer');
return `<div class="bar puh"><button class="ib" aria-label="Back" onclick="back()">${ic('back',24)}</button><b>${ttl}</b></div><div class="purs">${frm}<button class="pusw" aria-label="${T3('Swap direction','Hindura icyerekezo','Inverser')}" onclick="puSwap()"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 4v16M4 8l4-4 4 4M16 20V4M12 16l4 4 4-4"/></svg></button>${to}</div><div id="pub">${puBody()}</div><div class="keys puk">${['1','2','3','4','5','6','7','8','9','00','0','⌫'].map(k=>`<button onclick="puKey('${k}')" aria-label="${k==='⌫'?'Delete':k}">${k==='⌫'?'<svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 12H4.5M10.5 5.5L4 12l6.5 6.5"/></svg>':k}</button>`).join('')}</div><div class="cta pucta"><button id="pgo" class="btn" ${v&&!bad?'':'disabled'} onclick="puAsk()">${puGoLbl()}</button></div>`};
window.puSwap=()=>{const p=S.pu,top=p.mode==='top';p.mode=top?'move':'top';p.k=top?S.tu.dst:S.tu.src;p.amt='';render('fade-none')};
window.puKey=k=>{const p=S.pu;k=String(k);if(k.startsWith('add:'))p.amt=String(Math.min(Number(p.amt||0)+Number(k.slice(4)),999999999));else if(k.startsWith('set:'))p.amt=k.slice(4);else if(k==='max')p.amt=String(puMax());else if(k==='⌫')p.amt=p.amt.slice(0,-1);else if(k==='00'){if(p.amt&&p.amt.length<8)p.amt+='00'}else if(p.amt.length<9)p.amt=(p.amt+k).replace(/^0+/,'');
const v=Number(p.amt||0),b=$('#pub');if(b)b.innerHTML=puBody();const g=$('#pgo');if(g){g.disabled=!(v&&v<=puMax());g.textContent=puGoLbl()}};
/* v390: quieter top-up / move amount screen */
{
const T=(a,b,c)=>T3(a,b,c);
window.puBody=function(){const p=S.pu,v=Number(p.amt||0),bad=v>puMax(),top=p.mode==='top',o=src(p.k);
const verb=top?T('Top up','Ongeramo','Recharger'):T('Move','Imura','Déplacer');
const ph=top?T('<b>How much</b> to top up?','<b>Ni angahe</b> wongeramo?','<b>Combien</b> recharger ?'):T('<b>How much</b> to move?','<b>Ni angahe</b> wimura?','<b>Combien</b> déplacer ?');
const q=v?`<i>${verb}</i> ${fmt(v)} RWF<i>${S.lang==='fr'?' ?':'?'}</i>`:`<i>${ph}</i>`;
let note='',extra='';
if(bad){note=puWhy(v);if(top&&v>o.b){const alt=SRC().find(x=>x.k!==p.k&&x.b>=v);if(alt)extra=`<button class="chip" style="margin-top:10px" onclick="puSet('${alt.k}')">${T('Use ','Koresha ','Utiliser ')}${alt.n} · ${fmt(alt.b)} RWF</button>`}}
const mx=puMax();
const chips=bad?'':(!v?(mx>0?`<button class="chip" onclick="puKey('max')">${T('All','Byose','Tout')} ${fmt(mx)}</button>`:''):[10000,50000,100000].map(n=>`<button class="chip" ${v+n>mx?'disabled':''} onclick="puKey('add:${n}')">+${fmt(n)}</button>`).join(''));
return `<div class="pua" style="${v>=1e7?'font-size:22px':''}">${q}</div><div class="pun${bad?' er':''}" aria-live="polite">${note}</div>${extra}<div class="puc">${chips}</div>`};
window.puKey=k=>{const p=S.pu;k=String(k);if(k.startsWith('add:'))p.amt=String(Math.min(Number(p.amt||0)+Number(k.slice(4)),999999999));else if(k==='max')p.amt=String(puMax());else if(k==='clear')p.amt='';else if(k==='⌫')p.amt=p.amt.slice(0,-1);else if(p.amt.length<9)p.amt=(p.amt+k).replace(/^0+/,'');
const v=Number(p.amt||0),b=$('#pub');if(b)b.innerHTML=window.puBody();const g=$('#pgo');if(g){g.disabled=!(v&&v<=puMax());g.textContent=puGoLbl()}};
screens.puamt=()=>{const p=S.pu,top=p.mode==='top',a=src(p.k),v=Number(p.amt||0),bad=v>puMax();
const A=T('Available ','Ushobora gukoresha ','Disponible '),B=T('Balance ','Asigaye ','Solde ');
const lab=top?T('From','Biva kuri','Depuis'):T('To','Ujya kuri','Vers');
const sub=a.s;
const chev=ic('chev',16,'var(--tt)').replace('<svg','<svg style="transform:rotate(90deg);flex:none"');
return `<div class="bar puh"><button class="ib" aria-label="Back" onclick="back()"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 12H4.5M10.5 5.5L4 12l6.5 6.5"/></svg></button></div><div class="pus1"><div class="pusr tap" role="button" tabindex="0" aria-label="${lab}" onclick="puPick()">${sico(p.k,44)}<div class="t"><i>${lab}</i><b>${a.n}</b>${chev}</div></div><div class="pusb">${sub}</div></div><div id="pub">${window.puBody()}</div><div class="keys puk">${['1','2','3','4','5','6','7','8','9','','0','⌫'].map(k=>k===''?'<span></span>':`<button onclick="puKey('${k}')" aria-label="${k==='⌫'?'Delete':k}">${k==='⌫'?'<svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 12H4.5M10.5 5.5L4 12l6.5 6.5"/></svg>':k}</button>`).join('')}</div><div class="cta pucta"><button id="pgo" class="btn" ${v&&!bad?'':'disabled'} onclick="puAsk()">${puGoLbl()}</button></div>`};
}
window.puPick=()=>{const p=S.pu,top=p.mode==='top';$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" role="dialog" aria-modal="true"><div class="h1" style="font-size:22px;line-height:30px;margin-bottom:8px">${top?T3('Top up from','Ongeramo biva kuri','Recharger depuis'):T3('Move to','Imura ujya kuri','Déplacer vers')}</div>${SRC().map(a=>`<div class="tap" role="button" tabindex="0" onclick="puSet('${a.k}')" style="display:flex;align-items:center;gap:14px;padding:10px 0;cursor:pointer">${sico(a.k,44)}<div style="flex:1;min-width:0"><div style="font-size:17px;font-weight:700">${a.n}</div><div class="sm mu">${a.s} · ${fmt(a.b)} RWF</div></div><span style="color:var(--lk);display:flex;width:24px">${p.k===a.k?CK48:''}</span></div>`).join('')}</div>`};
window.puSet=k=>{S.pu.k=k;if(S.pu.mode==='top')S.tu.src=k;else S.tu.dst=k;closeSheet();render('fade-none')};
window.puAsk=()=>{const p=S.pu,v=Number(p.amt||0),a=src(p.k),top=p.mode==='top';if(!v||v>puMax())return;
const ln=(l,x)=>`<div style="display:flex;justify-content:space-between;gap:12px;padding:11px 0;font-size:15px"><span class="mu">${l}</span><b style="text-align:right">${x}</b></div>`;
const after=top?S.pay+v:a.b+v;
$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" role="dialog" aria-modal="true"><div class="h1" style="font-size:22px;line-height:30px">${top?T3('Top up '+fmt(v)+' RWF?','Kongeramo RWF '+fmt(v)+'?','Recharger '+fmt(v)+' RWF ?'):T3('Move '+fmt(v)+' RWF?','Kwimura RWF '+fmt(v)+'?','Déplacer '+fmt(v)+' RWF ?')}</div><div style="margin:14px 0 18px;padding:2px 16px;border-radius:16px;background:var(--chip)">${ln(T3('From','Biva kuri','Depuis'),top?a.n+' '+a.s:'itunda Pay')}${ln(T3('To','Ujya kuri','Vers'),top?'itunda Pay':a.n+' '+a.s)}${ln(T3('Fee','Ikiguzi','Frais'),T3('Free','Ni ubuntu','Gratuit'))}${ln(T3('Arrives','Bigera','Arrivée'),T3('Instantly','Ako kanya','Instantanément'))}${ln((top?'itunda Pay':a.n)+' '+T3('after','izaba','après'),fmt(after)+' RWF')}</div><button class="btn" onclick="puDo()">${T3('Confirm','Emeza','Confirmer')}</button><button class="btn sec2" style="margin-top:10px" onclick="closeSheet()">${T3('Cancel','Reka','Annuler')}</button></div>`;if(typeof focusSheet==='function')focusSheet()};
window.puDo=()=>{const p=S.pu,v=Number(p.amt||0),a=src(p.k),top=p.mode==='top';if(!v||v>puMax())return;const ts=Date.now();
if(top){S.tu.used=usedToday()+v;S.tu.usedD=dayK();if(p.k==='bank'){S.bank-=v;S.act.unshift(['cyc','To itunda Pay','Paid · Just now',-v,'Paid',ts,'bank','Bank → Pay'])}else S.tu[p.k]-=v;S.pay+=v;S.act.unshift(['up',T3('Top up','Ongeramo','Recharge'),'Received · Just now',v,'Received',ts,'pay',(a.k==='bank'?'Bank':a.n)+' → Pay'])}
else{S.pay-=v;if(p.k==='bank'){S.bank+=v;S.act.unshift(['cyc','From itunda Pay','Received · Just now',v,'Received',ts,'bank','Pay → Bank'])}else S.tu[p.k]+=v;S.act.unshift(['cyc',T3('Move','Imura','Déplacement'),'Paid · Just now',-v,'Paid',ts,'pay','Pay → '+(a.k==='bank'?'Bank':a.n)])}
closeSheet();back();toast(top?T3(`Topped up ${fmt(v)} RWF · Pay balance ${fmt(S.pay)} RWF`,`Wongeyemo RWF ${fmt(v)} · Asigaye kuri Pay: RWF ${fmt(S.pay)}`,`${fmt(v)} RWF rechargés · Solde Pay ${fmt(S.pay)} RWF`):T3(`Moved ${fmt(v)} RWF`,`Wimuye RWF ${fmt(v)}`,`${fmt(v)} RWF déplacés`))};
/* entry points: Pay tab balance card (and its Add button), Home Pay row, My assets row */
const _p=screens.pay;
screens.pay=()=>{let h=_p();const o='<div style="padding:0 8px"><div class="sm" style="font-weight:700;color:var(--tintfg)">';
if(h.includes(o))h=h.replace(o,`<div class="tap" role="button" tabindex="0" onclick="${S.psrc==='bank'?'openBankDetail()':'openPayDetail()'}" style="padding:0 8px;cursor:pointer;position:relative"><span style="position:absolute;right:10px;top:2px;display:flex">${ic('chev',16,'var(--tintfg)')}</span><div class="sm" style="font-weight:700;color:var(--tintfg)">`);
return h.replace(/sheetAdd\(\)/g,'openTopUp()')};
const _h=screens.home;
screens.home=()=>_h().replace(/(<div class="hr tap" role="button" tabindex="0" )onclick="tab\('pay'\)"(><div class="hi">)/,'$1onclick="openPayDetail()"$2');
const _a=screens.assets;
if(_a)screens.assets=()=>_a().replace(/(<div[^>]*onclick=")tab\('pay'\)("[^>]*>(?:(?!<\/div>\s*<\/div>)[\s\S])*?itunda Pay)/,'$1openPayDetail()$2');
/* the sheet of a line: Pay lines say Pay, transfers show their route */
const _ao=window.actOpen;
window.actOpen=function(i){_ao.apply(this,arguments);const x=S.act[i],y=$('#layer');if(!x||!y||!y.innerHTML)return;
if(x[7])y.innerHTML=y.innerHTML.replace(/<span class="mu">(?:To|From|Kuri|Biva kuri|Vers|De)<\/span><b[^>]*>itunda Bank<\/b>/,`<span class="mu">${T3('Route','Inzira','Trajet')}</span><b style="text-align:right">${esc(x[7])}</b>`);
else if(side(x)==='pay')y.innerHTML=y.innerHTML.replace(/itunda Bank<\/b>/,'itunda Pay</b>')};
document.title=document.title.replace(/v\d+/,'v265');
})();
</script>
<style id="v266css">
/* v266: pages instead of bottom sheets. Only a decision that must interrupt (confirm, cancel, authorise) stays a sheet. */
#phone .sheet.v6pg{inset:0;max-height:none!important;height:auto;border-radius:0;padding:0!important;overflow-y:auto;overflow-x:hidden;z-index:22;touch-action:auto!important;display:flex;flex-direction:column;animation:pgin .3s cubic-bezier(.2,.8,.2,1)}
#phone .sheet.v6pg.v6na{animation:none}
#phone .sheet.v6pg::before{display:none}
@keyframes pgin{from{transform:translateX(100%)}to{transform:none}}
.v6h{position:sticky;top:0;z-index:3;background:var(--bg);display:flex;align-items:center;padding:16px 12px 6px;flex:none}
.v6b{flex:1;padding:6px 24px 24px;min-height:0}
.v6b>.h1:first-child,.v6b>.g3+.h1{font-size:26px!important;line-height:34px!important;letter-spacing:-.4px}
.v6cta{position:sticky!important;left:auto;right:auto;bottom:0;margin-top:auto;flex:none;padding:12px 24px calc(24px + env(safe-area-inset-bottom,0px))}
.v6cta .bpbar{margin:0!important;padding:0!important;border:0!important}
.v6cta .btn+.btn,.v6cta .btn+.row2{margin-top:10px}
.sheet.v6res .v6b{display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding-bottom:48px}
.sheet.v6res .v6b .h1{font-size:26px!important;line-height:34px!important}
</style>
<script>
/* v266: modals audit. Every sheet in the app goes through #layer, so one converter handles them all. Stays a sheet: confirmations and authorisations ("Confirm it's you", "…?" decisions with one or two buttons, the Confirm checkout sheet). Becomes a page: everything else (lists, pickers, forms, receipts, settings, PIN steps). A page has a back arrow, the title large, content that scrolls, and its buttons docked at the bottom. A sheet with only a picture, a message and one button becomes a centred result page. */
(function(){
const ph=document.getElementById('phone'),L=document.getElementById('layer');
function classify(sh){
 if(sh.classList.contains('bs464'))return 'modal';
 const h=((sh.querySelector('.h1')||{}).textContent||'').trim(),lab=sh.getAttribute('aria-label')||'';
 const form=sh.querySelector('input,textarea,select,.req,.chip,.pkauto,.pkopt,[data-pg],[data-cpin],[data-czpin],.keys,.row.tap,.bdr,.cb,.stk,.pkrow,.ar,[role=button],[onclick]:not(button)');
 const btns=sh.querySelectorAll('button').length;
 if(lab==='Confirm'||/^(confirm|confirmez|emeza)/i.test(h))return 'modal';
 if(!form&&btns<=2&&/\s?\?$/.test(h))return 'modal';
 if(!form&&btns===1&&sh.querySelector('.g3')&&sh.textContent.length<260)return 'result';
 return 'page';
}
const DOCK=e=>e.nodeType===1&&(e.matches('button.btn,.row2,.bpbar,.cta'));
function toPage(sh,res){
 sh.classList.add('v6pg');if(res)sh.classList.add('v6res');
 [...sh.children].forEach(k=>{if(k.getAttribute('aria-hidden')==='true'&&/height:4px/.test(k.getAttribute('style')||''))k.remove()});
 const rest=[...sh.children];let i=rest.length;const dock=[];
 while(i>0&&DOCK(rest[i-1])){dock.unshift(rest[i-1]);i--}
 const body=document.createElement('div');body.className='v6b';rest.slice(0,i).forEach(k=>body.appendChild(k));
 const fb=rest.length&&rest[0].querySelector?rest[0].querySelector('button.ib'):null,own=fb&&(/‹/.test(fb.textContent)||/back/i.test((fb.getAttribute('onclick')||'')+(fb.getAttribute('aria-label')||'')));
 if(!res&&!own){const h=document.createElement('div');h.className='v6h';h.innerHTML='<button class="ib" aria-label="Back" onclick="closeSheet()">'+ic('back',24)+'</button>';sh.appendChild(h)}
 sh.appendChild(body);
 if(dock.length){const c=document.createElement('div');c.className='cta v6cta';dock.forEach(d=>c.appendChild(d));sh.appendChild(c)}
}
let lastTitle='',lastScroll=0;
const obs=new MutationObserver(recs=>{
 const sh=L.querySelector('.sheet:not([data-pgd])');if(!sh)return;
 sh.dataset.pgd='1';
 const kind=classify(sh);if(kind==='modal')return;
 const wasPage=recs.some(r=>[...r.removedNodes].some(n=>n.nodeType===1&&(n.classList.contains('v6pg')||(n.querySelector&&n.querySelector('.sheet.v6pg')))));
 obs.disconnect();
 toPage(sh,kind==='result');
 const bg=L.querySelector('.sheetbg');if(bg)bg.remove();
 const title=((sh.querySelector('.h1')||{}).textContent||'').trim();
 if(wasPage){sh.classList.add('v6na');if(title===lastTitle)sh.scrollTop=lastScroll}else lastScroll=0;
 lastTitle=title;
 sh.addEventListener('scroll',()=>{lastScroll=sh.scrollTop},{passive:true});
 obs.observe(L,{childList:true,subtree:true});
});
obs.observe(L,{childList:true,subtree:true});
/* a page is not dragged down like a sheet */
ph.addEventListener('pointerdown',e=>{if(e.target.closest&&e.target.closest('.sheet.v6pg')&&!e.target.closest('.fmsurf'))e.stopImmediatePropagation()},true);
document.title=document.title.replace(/v\d+/,'v266');
})();
</script>
<style id="v267css">
/* v267: Send flow, quieter. No step bar, no "Step n of 3", no disabled-button hint, no duplicate amount lines. */
#view:has([data-send]) .v176,#view:has([data-send]) .dhint{display:none!important}
.screen:has([data-send]) #msg[style*="var(--mu)"]{display:none}
</style>
<script>
/* v267: what changed on Send. Step 1 (who): back arrow only (no "Send" title), no Phone number / Friends tabs (both showed the same contacts), no field label or helper text until there is something to say, no "Contacts + Add" heading. Step 2 (amount): the recipient is a name · number line instead of "To account …", the amount-in-words shows once (the green "5 thousand" line is gone), "Balance after" only appears when there is a problem, three quick chips (+5,000 +10,000 Max). Step 3 (check): no "Step 3 of 3", no amount-in-words again, no Fee row when the fee is 0, no "Go back" button (tap outside the sheet, or drag it down, to close). */
(function(){
const esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const phone=p=>{const d=String(p||'').replace(/\D/g,'');return d.length===10?d.replace(/(\d{4})(\d{3})(\d{3})/,'$1 $2 $3'):String(p||'')};
const names={};
const MARK='<i data-send hidden></i>';
const _r=screens.recipient;
screens.recipient=()=>{S.rtab='a';let h=_r();
 h.replace(/<div class="t">([^<]*)<\/div><div class="s">([\d ]+)<\/div>/g,(m,n,p)=>{names[p.replace(/\D/g,'')]=n;return m});
 h=h.replace('<b>Send</b>','')
  .replace(/<div class="pad" style="padding-top:24px;display:flex;gap:20px[^"]*">(?:<span class="tap" role="tab"[\s\S]*?<\/span>){2}<\/div>/,'')
  .replace(/<div class="sm mu">[^<]*<\/div>(<div style="display:flex;align-items:center;justify-content:space-between;margin-top:4px;min-height:32px">)/,'$1')
  .replace(/placeholder="[^"]*"/,'placeholder="'+esc(t('ta'))+'" aria-label="'+esc(t('rl'))+'"')
  .replace(/(<div id="rch"[^>]*>)[^<]*(<\/div>)/,'$1$2')
  .replace(/<div class="sech">[^<]*<a>[^<]*<\/a><\/div>/,'');
 return h+MARK};
const _ri=window.rcIn;
window.rcIn=function(el){const r=_ri.apply(this,arguments);const e=document.getElementById('rch');if(e&&!el.value.trim())e.textContent='';return r};
const _a=screens.amount;
screens.amount=()=>{let h=_a();
 const d=String(S.to||'').replace(/\D/g,''),nm=names[d],who=(nm?esc(nm)+' · ':'')+esc(phone(S.to));
 h=h.replace('<b>Send</b>','')
  .replace(/<div id="w9"[^>]*>[^<]*<\/div>/,'')
  .replace(/<button[^>]*key\('add:50000'\)[^>]*>[^<]*<\/button>/,'')
  .replace(/(<div class="h1">[^<]*<\/div><div class="mu" style="font-size:14px;margin-top:8px">)[^<]*(<\/div>)/,'$1'+who+'$2');
 return h+MARK};
/* the check sheet */
const ly=document.getElementById('layer');
new MutationObserver(()=>{const sh=ly.querySelector('.sheet[aria-label="Confirm"]:not([data-v267])');if(!sh||!sh.querySelector('button[onclick="finish()"]'))return;
 sh.dataset.v267='1';
 const f=sh.querySelector(':scope>.fine');if(f)f.remove();
 const big=sh.querySelector('.big'),w=big&&big.nextElementSibling;if(w&&/RWF/.test(w.textContent)&&!w.classList.contains('mu')&&!w.querySelector('svg'))w.remove();
 const fee=[...sh.querySelectorAll(':scope>div')].find(e=>/margin:20px 0 18px/.test(e.getAttribute('style')||''));
 if(fee){const bs=[...fee.querySelectorAll('b')];if(bs.length&&bs.every(b=>/^0(\s|$)/.test(b.textContent.trim()))){fee.remove();const bal=[...sh.querySelectorAll(':scope>.mu')].find(e=>/margin:-6px 0 18px/.test(e.getAttribute('style')||''));if(bal)bal.style.margin='14px 0 18px'}}
 if(!S.flagged){const gb=sh.querySelector('button.sec2[onclick="closeSheet()"]');if(gb)gb.remove()}
}).observe(ly,{childList:true,subtree:true});
document.title=document.title.replace(/v\d+/,'v267');
})();
</script>
<style id="v268css">
.v8pill{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:12px 18px;border-radius:24px;background:rgba(255,255,255,.2);color:#fff;font-weight:700;font-size:15px;border:0}
.v8pill.out{border:1.5px solid rgba(255,255,255,.75);background:rgba(0,0,0,.45);padding:14px 26px;font-size:16px}
.v8chip{padding:9px 14px;border-radius:18px;background:rgba(255,255,255,.14);color:#fff;font-weight:600;font-size:13px;border:0;white-space:nowrap}
.v8cats{display:flex;gap:8px;overflow-x:auto;padding:14px 24px 0;scrollbar-width:none}.v8cats::-webkit-scrollbar{display:none}
.v8cat{flex:none;padding:10px 16px;border-radius:20px;background:var(--chip);color:var(--tx);font-weight:700;font-size:14px;border:0}
.v8cat.on{background:var(--tint);color:var(--tintfg)}
</style>
<script>
/* v268: ideas from the KakaoPay screens. (1) Scan screen: flash and close on top, headline above the frame, "Type in" and "From photos" under it, "My code" at the bottom, sample codes as small chips; it works for shops and for people. (2) Receive money ("My code"): a code with your picture in the middle, "Set an amount" to put an amount in the code, Save image, Copy link. (3) Send, who: a scan button beside Next, and a star on a contact to keep them at the top. (4) Split a bill in a chat: one page with bill type chips, the amount, and what each person pays, instead of a sheet with three fixed amounts. The sample codes are not real QR codes. */
(function(){
const T3=(a,b,c)=>({rw:b,fr:c}[S.lang]||a);
const esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const svg=(d,z,extra)=>`<svg width="${z||24}" height="${z||24}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" ${extra||''}>${d}</svg>`;
const X=svg('<path d="M6 6l12 12M18 6L6 18"/>'),FLASH=svg('<path d="M13 2L5 14h6l-1 8 8-12h-6z"/>'),SHARE=svg('<path d="M12 3v12M8 7l4-4 4 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7"/>'),PEN=svg('<path d="M4 20l4-1 11-11a2.1 2.1 0 00-3-3L5 16z"/>',18),IMG=svg('<rect x="3" y="4" width="18" height="16" rx="3"/><circle cx="9" cy="10" r="1.6"/><path d="M4 18l5-5 4 4 3-3 4 4"/>',20),STAR=f=>svg('<path d="M12 3.5l2.6 5.4 5.9.8-4.3 4.1 1 5.9L12 16.9l-5.2 2.8 1-5.9L3.5 9.7l5.9-.8z"/>',24,f?'fill="#F5B400" stroke="#F5B400"':'');
const keysHtml=fn=>`<div class="keys" style="position:absolute;left:0;right:0;bottom:104px">${['1','2','3','4','5','6','7','8','9','00','0','⌫'].map(k=>`<button onclick="${fn}('${k}')" aria-label="${k==='⌫'?'Delete':k}">${k==='⌫'?svg('<path d="M20 6H9l-5 6 5 6h11zM12 10l4 4M16 10l-4 4"/>',26):k}</button>`).join('')}</div>`;
/* ---------- scan ---------- */
const _ps=screens.paysc,_g=window.ppGo;
window.ppGo=n=>{if(n==='paysc')S.scanFor='pay';_g(n)};
window.sendScan=()=>{S.scanFor='send';S.stack.push('paysc');render('push')};
screens.paysc=()=>{const o=_ps(),fr=(o.match(/<div class="fr">[\s\S]*?<div class="ln"><\/div><\/div>/)||[''])[0],
 shops=[...o.matchAll(/ppMerch\('(\d+)'\)[\s\S]*?<span style="flex:1">([^<]*)<\/span>/g)].map(m=>[m[1],m[2]]);
 const send=S.scanFor==='send';
 return `<div class="ppv"><div style="position:absolute;top:0;left:0;right:0;display:flex;align-items:center;justify-content:space-between;padding:12px 8px;z-index:2"><button class="ib" aria-label="${T3('Flash','Itara','Flash')}" onclick="scFlash(this)" style="color:#fff;opacity:.6">${FLASH}</button><button class="ib" aria-label="${T3('Close','Funga','Fermer')}" onclick="back()" style="color:#fff">${X}</button></div>
<div style="position:absolute;left:0;right:0;top:84px;text-align:center;padding:0 24px"><div style="font-size:21px;font-weight:800">${send?T3('Scan a code to send','Sikana kode kugira wohereze','Scannez un code pour envoyer'):T3('Scan a QR code','Sikana kode ya QR','Scannez un code QR')}</div><div style="font-size:14px;opacity:.8;margin-top:6px">${T3('Shops and friends both work.','Abacuruzi n’inshuti byose bikora.','Commerçants et amis fonctionnent.')}</div></div>
${fr}
<div style="position:absolute;left:0;right:0;top:calc(34% + 150px);display:flex;gap:10px;justify-content:center"><button class="v8pill" onclick="scType()">${svg('<path d="M4 20l4-1 11-11a2.1 2.1 0 00-3-3L5 16z"/>',20)}${T3('Type in','Andika','Saisir')}</button><button class="v8pill" onclick="toast('${T3('The photo picker is not in this prototype.','Guhitamo ifoto ntibirimo muri iyi prototype.','Le sélecteur de photos n’est pas dans ce prototype.')}')">${IMG}${T3('From photos','Mu mafoto','Depuis les photos')}</button></div>
<div style="position:absolute;left:0;right:0;bottom:104px;padding:0 20px"><div style="font-size:12px;font-weight:700;opacity:.65;margin-bottom:8px">${T3('Try a sample code (prototype)','Gerageza kode y’icyitegererezo','Essayez un code d’exemple')}</div><div style="display:flex;flex-wrap:wrap;gap:8px"><button class="v8chip" onclick="scPerson('0788 000 214')">Amina K.</button>${shops.map(([k,n])=>`<button class="v8chip" onclick="ppMerch('${k}')">${esc(n)}</button>`).join('')}</div></div>
<div style="position:absolute;left:0;right:0;bottom:28px;text-align:center"><button class="v8pill out" onclick="S.stack.push('rcode');render('push')">${gx('qr',24)}${T3('My code','Kode yanjye','Mon code')}</button></div></div>`};
window.scFlash=b=>{b.style.opacity=b.style.opacity==='1'?'.6':'1'};
window.scType=()=>{if(S.scanFor==='send'){back()}else{S.stack[S.stack.length-1]='paytill';render('fade-none')}};
window.scPerson=p=>{S.to=p;S.flagged=false;S.stack[S.stack.length-1]='amount';render('push')};
/* ---------- receive money ---------- */
S.rc=S.rc||{amt:'',tmp:''};
function qr(seed,z){const N=25,c=8;let s=seed;const rnd=()=>{s=(s*1664525+1013904223)>>>0;return s/4294967296},g=[];
 for(let y=0;y<N;y++){g[y]=[];for(let x=0;x<N;x++)g[y][x]=rnd()<.5}
 const fin=(ox,oy)=>{for(let i=-1;i<8;i++)for(let j=-1;j<8;j++){const x=ox+i,y=oy+j;if(x>=0&&y>=0&&x<N&&y<N)g[y][x]=false}for(let y=0;y<7;y++)for(let x=0;x<7;x++)g[oy+y][ox+x]=x===0||y===0||x===6||y===6||(x>=2&&x<=4&&y>=2&&y<=4)};
 fin(0,0);fin(N-7,0);fin(0,N-7);
 for(let y=0;y<N;y++)for(let x=0;x<N;x++)if(Math.abs(x-12)<=4&&Math.abs(y-12)<=4)g[y][x]=false;
 let d='';for(let y=0;y<N;y++)for(let x=0;x<N;x++)if(g[y][x])d+=`M${x*c} ${y*c}h${c}v${c}h-${c}z`;
 const ini=esc((S.name||'You').trim()[0]||'Y').toUpperCase();
 return `<svg viewBox="0 0 ${N*c} ${N*c}" width="${z}" height="${z}" role="img" aria-label="${T3('Your receive code (sample)','Kode yawe yo kwakira (icyitegererezo)','Votre code de réception (exemple)')}"><rect width="${N*c}" height="${N*c}" fill="#fff"/><path d="${d}" fill="#111"/><circle cx="100" cy="100" r="30" fill="#fff"/><circle cx="100" cy="100" r="25" fill="#7472F4"/><text x="100" y="108" text-anchor="middle" font-size="24" font-weight="800" fill="#fff" font-family="sans-serif">${ini}</text></svg>`}
screens.rcode=()=>{const a=Number(S.rc.amt||0);
 return `<div class="bar"><button class="ib" aria-label="Back" onclick="back()">${ic('back',24)}</button><span style="flex:1"></span><button class="ib" aria-label="${T3('Share','Sangiza','Partager')}" onclick="toast('${T3('Shared (prototype)','Byasangijwe (prototype)','Partagé (prototype)')}')">${SHARE}</button></div>
<div class="pad" style="padding-top:12px"><div class="h1">${T3('Receive money','Akira amafaranga','Recevoir de l’argent')}</div><div class="mu" style="font-size:15px;margin-top:8px">${T3('Show this code to the other person.','Erekana iyi kode ku wundi muntu.','Montrez ce code à l’autre personne.')}</div></div>
<div style="margin:22px 24px 0;padding:22px 16px 18px;border-radius:28px;background:var(--chip);text-align:center"><div style="display:inline-block;padding:10px;border-radius:18px;background:#fff;line-height:0">${qr(a+104729,210)}</div>
<div style="margin-top:14px;font-size:17px;font-weight:800">${esc(S.name||'You')}</div><div class="sm mu" style="margin-top:2px">itunda Pay · 0788-1205-1980</div>
<button class="tap" onclick="S.rc.tmp=S.rc.amt;S.stack.push('rcamt');render('push')" style="margin-top:14px;border:0;background:none;color:${a?'var(--tx)':'var(--tt)'};font:inherit;font-size:${a?24:17}px;font-weight:800;display:inline-flex;align-items:center;gap:8px">${a?fmt(a)+' RWF':T3('Set an amount','Shyiraho amafaranga','Définir un montant')}${PEN}</button></div>
<div class="pad row2" style="padding-top:16px"><button class="btn sec2" onclick="toast('${T3('Image saved (prototype)','Ifoto yabitswe (prototype)','Image enregistrée (prototype)')}')">${T3('Save image','Bika ifoto','Enregistrer l’image')}</button><button class="btn sec2" onclick="rcCopy()">${T3('Copy link','Kopera link','Copier le lien')}</button></div>
<div class="pad fine" style="padding-top:12px">${T3('Sample code, not a real one.','Kode y’icyitegererezo, si iyukuri.','Code d’exemple, pas un vrai.')}</div>`};
window.rcCopy=()=>{try{navigator.clipboard.writeText('https://itunda.rw/pay/0788-1205-1980'+(S.rc.amt?'?amount='+S.rc.amt:'')).catch(()=>{})}catch(e){}toast(T3('Link copied','Link yakoporowe','Lien copié'))};
const rcBody=()=>{const v=Number(S.rc.tmp||0);return `<div style="font-size:30px;line-height:40px;letter-spacing:-.4px"><b>${v?fmt(v)+' RWF':T3('How much','Ni angahe','Combien')}</b> <span class="mu">${T3('to receive?','ushaka kwakira?','à recevoir ?')}</span></div><div style="margin-top:16px;display:flex;gap:8px;flex-wrap:wrap">${[1000,5000,10000].map(n=>`<button class="chip" onclick="rcKey('add:${n}')">+${fmt(n)}</button>`).join('')}</div>`};
screens.rcamt=()=>`${bar('')}<div id="rcb" style="padding:20px 24px 0">${rcBody()}</div>${keysHtml('rcKey')}<div class="cta"><button class="btn" onclick="S.rc.amt=S.rc.tmp;back()">${S.rc.tmp&&Number(S.rc.tmp)?T3('Set amount','Shyiraho','Valider'):T3('No amount','Nta mafaranga','Sans montant')}</button></div>`;
window.rcKey=k=>{const r=S.rc;k=String(k);if(k.startsWith('add:'))r.tmp=String(Math.min(Number(r.tmp||0)+Number(k.slice(4)),99999999));else if(k==='⌫')r.tmp=(r.tmp||'').slice(0,-1);else if((r.tmp||'').length<8)r.tmp=((r.tmp||'')+k).replace(/^0+/,'');const b=$('#rcb');if(b)b.innerHTML=rcBody();const c=document.querySelector('.cta .btn');if(c)c.textContent=Number(r.tmp||0)?T3('Set amount','Shyiraho','Valider'):T3('No amount','Nta mafaranga','Sans montant')};
/* ---------- send: who ---------- */
S.fav=S.fav||{};
window.favT=d=>{S.fav[d]=!S.fav[d];render('fade-none')};
const _r=screens.recipient;
screens.recipient=()=>{let h=_r();const rows=[];
 h=h.replace(/<div class="row tap" onclick="pick\('([\d ]+)',(\d)\)"[^>]*>[\s\S]*?<div class="s">[\d ]+<\/div><\/div><\/div>/g,(m,num)=>{const d=num.replace(/\D/g,''),f=!!S.fav[d];
  rows.push([f,m.replace(/<\/div>$/,`<button class="ib" aria-label="${T3('Favourite','Ukunda','Favori')}" aria-pressed="${f}" onclick="event.stopPropagation();favT('${d}')" style="margin-left:auto;color:${f?'#F5B400':'var(--tt)'}">${STAR(f)}</button></div>`)]);return '\u0001ROW\u0001'});
 const sorted=[...rows.filter(r=>r[0]),...rows.filter(r=>!r[0])];let i=0;h=h.replace(/\u0001ROW\u0001/g,()=>sorted[i++][1]);
 return h.replace(/<div class="cta">(<button class="btn"[^>]*>[^<]*<\/button>)<\/div>/,(m,b)=>`<div class="cta" style="display:flex;gap:12px"><button class="btn sec2" aria-label="${T3('Scan a code','Sikana kode','Scanner un code')}" onclick="sendScan()" style="width:68px!important;min-width:68px;flex:0 0 68px!important;padding:0!important;display:flex;align-items:center;justify-content:center">${ic('qr',24)}</button>${b.replace('class="btn"','class="btn" style="flex:1 1 auto!important;width:auto!important"')}</div>`)};
/* ---------- split a bill in a chat ---------- */
const CATS=()=>[['Meal',T3('Meal','Ifunguro','Repas')],['Coffee',T3('Coffee','Ikawa','Café')],['Snack',T3('Snack','Agafunguro','Snack')],['Drinks',T3('Drinks','Ibinyobwa','Boissons')],['Transport',T3('Transport','Ingendo','Transport')]];
window.splitSheet=()=>{closeSheet();S.sp={amt:'',cat:''};S.stack.push('split');render('push')};
const who=()=>{try{return thr().n}catch(e){return T3('Friend','Inshuti','Ami')}};
const shares=v=>{const o=Math.round(v/2);return [v-o,o]};
function spRows(){const v=Number(S.sp.amt||0),[me,ot]=shares(v),av=n=>`<div style="width:44px;height:44px;border-radius:22px;background:var(--tint);color:var(--tintfg);display:flex;align-items:center;justify-content:center;font-weight:800;font-size:17px;flex:none">${esc(n)[0]}</div>`;
 return [[T3('You','Wowe','Vous'),me],[who(),ot]].map(([n,a])=>`<div style="display:flex;align-items:center;gap:14px;padding:10px 24px">${av(n)}<div style="flex:1;font-size:17px;font-weight:700">${esc(n)}</div><b style="font-size:17px">${fmt(a)} RWF</b></div>`).join('')}
screens.split=()=>{const v=Number(S.sp.amt||0);
 return `${bar('')}<div class="pad" style="padding-top:0"><div class="h1">${T3('Split a bill','Gabana fagitire','Partager une addition')}</div></div>
<div class="v8cats">${CATS().map(([k,n])=>`<button class="v8cat ${S.sp.cat===k?'on':''}" onclick="S.sp.cat=S.sp.cat==='${k}'?'':'${k}';render('fade-none')">${n}</button>`).join('')}</div>
<div style="margin:16px 24px 0;padding:16px 18px;border-radius:20px;background:var(--chip)"><div class="sm mu">${T3('How much was the bill?','Fagitire yari angahe?','Combien était l’addition ?')}</div><div id="spa" style="font-size:34px;font-weight:800;letter-spacing:-1px;margin-top:2px">${fmt(v)} RWF</div></div>
<div class="sec" style="padding-top:16px"><div class="sech">${T3('Each pays','Buri wese yishyura','Chacun paie')}</div></div><div id="spr">${spRows()}</div>
${keysHtml('spKey')}<div class="cta"><button id="spb" class="btn" ${v?'':'disabled'} onclick="spGo()">${T3('Send split request','Ohereza ubusabe bwo kugabana','Envoyer la demande')}</button></div>`};
window.spKey=k=>{const p=S.sp;k=String(k);if(k==='⌫')p.amt=p.amt.slice(0,-1);else if(p.amt.length<8)p.amt=(p.amt+k).replace(/^0+/,'');const v=Number(p.amt||0);$('#spa').textContent=fmt(v)+' RWF';$('#spr').innerHTML=spRows();$('#spb').disabled=!v};
window.spGo=()=>{const p=S.sp,v=Number(p.amt||0);if(!v)return;S.msgs[S.chat].push(['split',v,false,p.cat||'']);back();setTimeout(()=>{if(typeof chatEnd==='function')chatEnd()},60)};
if(screens.chat){const _c=screens.chat;screens.chat=()=>{let h=_c();const sp=((S.msgs||{})[S.chat]||[]).filter(m=>m[0]==='split');let k=0;return h.replace(/>Split a bill<\/div>/g,()=>{const m=sp[k++];return '>'+(m&&m[3]?esc(m[3])+' · '+T3('split','kugabana','partage'):'Split a bill')+'</div>'})}}
document.title=document.title.replace(/v\d+/,'v269');
})();
</script>
<script id="v270">
/* v270: no "Step N of M" wording in the flows. Pages lead straight on; the thin progress bars stay, screen-reader labels stay. Trip directions ("Step 1/5" on the nav screen) are left as they are. */
(function(){
const RX=/^\s*(?:Step|\u00c9tape|Etape|Intambwe)\s*\d+\s*(?:of|sur|kuri)\s*\d+\s*(?:[\u00b7\u2022:\-\u2013\u2014]\s*)?/i;
function clean(){
  const ph=document.getElementById('phone');if(!ph)return;
  const w=document.createTreeWalker(ph,NodeFilter.SHOW_TEXT);const hit=[];let n;
  while(n=w.nextNode()){if(RX.test(n.nodeValue))hit.push(n)}
  hit.forEach(n=>{
    const el=n.parentElement;if(!el||el.closest('#nav,.navs,[data-nav]')||/\d\/\d/.test(n.nodeValue.slice(0,20)))return;
    let v=n.nodeValue.replace(RX,'');
    if(v)v=v.charAt(0).toUpperCase()+v.slice(1);
    n.nodeValue=v;
    if(!v.trim()&&!el.querySelector('svg,.sg,input,button,i')){
      el.style.display='none';
      const pr=el.parentElement;
      if(pr&&pr!==ph&&!pr.textContent.trim()&&!pr.querySelector('svg,.sg,input,button,i,img'))pr.style.display='none';
    }
  });
}
let q=0;const sched=()=>{if(q)return;q=requestAnimationFrame(()=>{q=0;clean()})};
new MutationObserver(sched).observe(document.getElementById('phone'),{childList:true,subtree:true});
sched();
document.title=document.title.replace(/v\d+/,'v270');
})();
</script>
<style id="v271css">
.s31h{margin:14px 24px 0;border-radius:28px;background:var(--tint);position:relative;overflow:hidden;height:300px}
.s31h svg{display:block;width:100%;height:100%}
.s31tip{position:absolute;left:14px;top:14px;max-width:128px;padding:8px 12px;border-radius:14px;background:var(--bg);font-size:13px;line-height:18px;font-weight:700}
.s31hl{position:absolute;right:6px;top:6px;border:0;background:none;color:var(--lk);font-weight:800;font-size:13px;padding:12px 10px}
.s31bn{transform-box:fill-box;transform-origin:50% 0;animation:s31sw 3.4s ease-in-out infinite alternate}
@keyframes s31sw{from{transform:rotate(-3deg)}to{transform:rotate(3deg)}}
@media (prefers-reduced-motion:reduce){.s31bn{animation:none}}
.s31d{border-top:0}
.s31d summary{list-style:none;display:flex;justify-content:space-between;align-items:center;min-height:56px;font-size:17px;font-weight:700;cursor:pointer}
.s31d summary::-webkit-details-marker{display:none}
.s31d summary::after{content:"";width:8px;height:8px;border-right:2px solid var(--tt);border-bottom:2px solid var(--tt);transform:rotate(45deg);margin-right:4px;transition:transform .2s}
.s31d[open] summary::after{transform:rotate(-135deg)}
.s31d .b{padding:0 0 14px;font-size:14px;line-height:22px;color:var(--mu)}
</style>
<script id="v271">
/* v271: 31-day savings, ideas from the Toss savings screens. The page now sells the benefit first (a coffee bean hangs from a rope and comes down toward a cup as your streak grows, with the four bonus steps along the side), says in two plain points how it works, and keeps the details in folded sections. "Next" opens a short page that says how it will be set up (bonus, period, amount, where it is paid from) and asks whether you want a reminder after day 31. "Start saving" opens one sheet with only the agreement you need, then a "Streak started" page, then your bean coming down for day 1. No "Step N" wording anywhere. English, French and Kinyarwanda; the Kinyarwanda is new copy and needs native review. */
(function(){
const t3=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e;
const nb=s=>S.lang==='fr'?s.replace(/ ([?:!%])/g,'\u00a0$1'):s;
const TI=[[7,2],[14,4],[21,6],[31,10]],AM=[200,500,1000,2000];
const st=()=>S.dsv31=S.dsv31||{on:0,a:500,n:0,t:0,d:0,pick:500};
const keep=fn=>{const sc=document.querySelector('#phone .screen'),y=sc?sc.scrollTop:0;fn();const s2=document.querySelector('#phone .screen');if(s2)s2.scrollTop=y};
const T=()=>t3('31-day savings','Kuzigama iminsi 31','Épargne sur 31 jours');
const gI=(k,z)=>{try{return gl(k,z)}catch(e){return ''}};
const chip=(v,on)=>'<button class="chip" aria-pressed="'+on+'" onclick="s31Pick('+v+')" style="min-width:64px;height:44px;border-radius:22px;border:0;padding:0 14px;font-size:15px;font-weight:800;background:'+(on?'var(--tx)':'var(--chip)')+';color:'+(on?'var(--bg)':'var(--tx)')+'">'+fmt(v)+'</button>';
const R=(a,v)=>'<div style="display:flex;justify-content:space-between;gap:12px;min-height:44px;align-items:center;font-size:15px"><span class="mu">'+a+'</span><b style="text-align:right">'+v+'</b></div>';
const Y0=64,Y1=186,by=n=>Math.round(Y0+Math.min(n,31)/31*(Y1-Y0));
function hero(n,tip,hist){
  const s=st(),from=by(s.pp==null?n:s.pp),to=by(n),fr=Math.min(n,31)/31;s.pp=n;
  const lbl=d=>t3('Day '+d,'Umunsi '+d,'Jour '+d);
  const rail=TI.map(([d,p])=>{const y=by(d),on=n>=d;return '<circle cx="296" cy="'+y+'" r="6" style="fill:'+(on?'var(--br)':'var(--bg)')+';stroke:'+(on?'var(--br)':'var(--ln)')+';stroke-width:2"/><text x="284" y="'+(y+4)+'" text-anchor="end" font-size="11" font-weight="700" style="fill:var(--mu)">'+lbl(d)+' \u00b7 '+p+'%</text>'}).join('');
  requestAnimationFrame(()=>requestAnimationFrame(()=>{const g=document.getElementById('s31b'),c=document.getElementById('s31f');if(g)g.style.transform='translateY('+to+'px)';if(c)c.style.transform='translateY('+Math.round((1-fr)*46)+'px)'}));
  const svg='<svg viewBox="0 0 342 300" role="img" aria-label="'+t3('A coffee bean on a rope above a cup, day '+n+' of 31','Ikawa ku mugozi hejuru y’igikombe, umunsi wa '+n+' kuri 31','Un grain de café suspendu au-dessus d’une tasse, jour '+n+' sur 31')+'"><defs><clipPath id="s31c"><path d="M125 236h92v10a46 46 0 0 1-46 40a46 46 0 0 1-46-40z"/></clipPath></defs>'
   +'<line x1="296" y1="'+Y0+'" x2="296" y2="'+Y1+'" style="stroke:var(--ln);stroke-width:2"/>'+rail
   +'<g clip-path="url(#s31c)"><rect x="120" y="236" width="102" height="50" style="fill:#F4F1FF"/><rect id="s31f" x="120" y="240" width="102" height="46" fill="#8B5E3C" style="transform:translateY('+Math.round((1-Math.min(n,31)/31)*46)+'px);transition:transform 1.1s cubic-bezier(.2,.8,.2,1)"/></g>'
   +'<path d="M125 236h92v10a46 46 0 0 1-46 40a46 46 0 0 1-46-40z" fill="none" stroke="#B9B1E8" stroke-width="3"/><path d="M217 248h8a12 12 0 0 1 0 24h-12" fill="none" stroke="#B9B1E8" stroke-width="3"/><rect x="108" y="228" width="126" height="8" rx="4" fill="#C9C2F2"/>'
   +'<g id="s31b" style="transform:translateY('+from+'px);transition:transform 1.1s cubic-bezier(.2,.8,.2,1)"><rect x="168.5" y="-420" width="5" height="396" fill="#C9A66B"/><g class="s31bn"><ellipse cx="171" cy="0" rx="21" ry="27" fill="#6F4E37"/><path d="M171-24c-9 10 9 14 0 24c-9 10 9 14 0 24" fill="none" stroke="#D2B48C" stroke-width="3" stroke-linecap="round"/></g></g></svg>';
  return '<div class="s31h">'+svg+(tip?'<div class="s31tip">'+nb(tip)+'</div>':'')+(hist?'<button class="s31hl" onclick="go(\'activity\')">'+t3('Savings history','Amateka yo kuzigama','Historique d’épargne')+'</button>':'')+'</div>';
}
const num=(g,t,sub,last)=>'<div style="display:flex;gap:14px"><div style="display:flex;flex-direction:column;align-items:center"><div style="width:36px;height:36px;display:flex;align-items:center;justify-content:center">'+gI(g,34)+'</div>'+(last?'':'<div style="width:2px;flex:1;min-height:18px;background:var(--ln);margin:6px 0"></div>')+'</div><div style="padding-bottom:'+(last?0:16)+'px"><div style="font-size:17px;font-weight:800;line-height:24px">'+nb(t)+'</div><div class="mu" style="font-size:14px;line-height:20px;margin-top:2px">'+nb(sub)+'</div></div></div>';
const det=(h,b)=>'<details class="s31d"><summary>'+h+'</summary><div class="b">'+nb(b)+'</div></details>';
const H2='font-size:16px;font-weight:800;padding:28px 24px 0';
function intro(){
  const s=st(),a=s.pick,bad=a>S.bank;
  return bar(T())
  +'<div class="pad" style="padding-top:18px"><div class="sm mu" style="font-weight:700">'+T()+'</div><div class="h1" style="margin-top:6px">'+nb(t3('Save a little each day, earn up to 10%','Zigama gake buri munsi, ubone kugeza kuri 10%','Épargnez un peu chaque jour, gagnez jusqu’à 10 %'))+'</div><div class="mu" style="font-size:15px;margin-top:8px;line-height:22px">'+nb(t3('Your bonus grows at day 7, 14, 21 and 31.','Igihembo cyawe kiyongera ku munsi wa 7, 14, 21 na 31.','Votre bonus augmente aux jours 7, 14, 21 et 31.'))+'</div></div>'
  +hero(0,t3('Reach the cup for the full 10% bonus','Gera ku gikombe ubone igihembo cyuzuye cya 10%','Atteignez la tasse pour le bonus complet de 10 %'),0)
  +'<div class="pad" style="padding-top:28px">'+num('money',t3('Save a little each day','Zigama gake buri munsi','Épargnez un peu chaque jour'),t3('Pick 200 to 2,000 RWF a day.','Hitamo hagati ya 200 na 2,000 RWF ku munsi.','Choisissez entre 200 et 2,000 RWF par jour.'),0)+num('flame',t3('Keep your streak going','Komeza iminsi ukurikiranya','Gardez votre série'),t3('Day 31 gets the full 10% bonus.','Umunsi wa 31 uguha igihembo cyuzuye cya 10%.','Le jour 31 donne le bonus complet de 10 %.'),1)+'</div>'
  +'<div style="'+H2+'">'+nb(t3('How much each day?','Ni angahe buri munsi?','Combien chaque jour ?'))+'</div><div style="padding:12px 24px 0"><div style="display:flex;gap:10px;flex-wrap:wrap" role="group" aria-label="'+t3('Daily amount','Amafaranga ya buri munsi','Montant par jour')+'">'+AM.map(v=>chip(v,v===a)).join('')+'</div><div class="sm" style="margin-top:12px;line-height:20px" aria-live="polite">'+(bad?'<span style="color:var(--er)">'+nb(t3('This is more than your itunda Bank balance of '+fmt(S.bank)+' RWF. Pick a smaller amount.','Ni menshi kurusha amafaranga ufite kuri itunda Bank angana na '+fmt(S.bank)+' RWF. Hitamo make kurushaho.','C’est plus que le solde de votre itunda Bank, qui est de '+fmt(S.bank)+' RWF. Choisissez un montant plus petit.'))+'</span>':'<span class="mu">'+t3('31 days \u00d7 '+fmt(a)+' = <b style="color:var(--tx)">'+fmt(a*31)+' RWF</b> \u00b7 itunda Bank balance '+fmt(S.bank)+' RWF','Iminsi 31 \u00d7 '+fmt(a)+' = <b style="color:var(--tx)">'+fmt(a*31)+' RWF</b> \u00b7 amafaranga kuri itunda Bank '+fmt(S.bank)+' RWF','31 jours \u00d7 '+fmt(a)+' = <b style="color:var(--tx)">'+fmt(a*31)+' RWF</b> \u00b7 solde itunda Bank '+fmt(S.bank)+' RWF')+'</span>')+'</div></div>'
  +'<div style="'+H2+'">'+t3('Good to know','Ibyiza kumenya','Bon à savoir')+'</div><div class="pad" style="padding-top:8px">'+num('history',t3('Missed a day?','Wasibye umunsi?','Un jour manqué ?'),t3('Your streak restarts, and what you saved stays yours.','Iminsi ukurikiranya yongera gutangira, ariko ibyo wazigamye ni ibyawe.','Votre série repart de zéro, et votre épargne reste à vous.'),0)+num('cashout',t3('Need it back?','Ukeneye kubisubirana?','Besoin de récupérer ?'),t3('Stop any time and take back what you saved.','Hagarika igihe cyose usubirane ibyo wazigamye.','Arrêtez quand vous voulez et reprenez votre épargne.'),1)+'</div>'
  +'<div class="pad" style="padding-top:20px">'
  +det(t3('Savings info','Amakuru ku kuzigama','Infos sur l’épargne'),t3('Save once a day from itunda Bank. You choose 200, 500, 1,000 or 2,000 RWF a day.','Zigama rimwe ku munsi uvanye kuri itunda Bank. Wihitiramo 200, 500, 1,000 cyangwa 2,000 RWF ku munsi.','Épargnez une fois par jour depuis itunda Bank. Vous choisissez 200, 500, 1,000 ou 2,000 RWF par jour.'))
  +det(t3('Bonus rates','Ibihembo','Taux de bonus'),t3('Day 7: 2%. Day 14: 4%. Day 21: 6%. Day 31: 10%. Rates are sample data.','Umunsi wa 7: 2%. Umunsi wa 14: 4%. Umunsi wa 21: 6%. Umunsi wa 31: 10%. Ibipimo ni ingero.','Jour 7 : 2 %. Jour 14 : 4 %. Jour 21 : 6 %. Jour 31 : 10 %. Taux d’exemple.'))
  +det(t3('Stopping early','Guhagarara hakiri kare','Arrêt anticipé'),t3('You can stop any time and take back what you saved. The bonus is paid only after day 31.','Ushobora guhagarara igihe cyose ugasubirana ibyo wazigamye. Igihembo gitangwa nyuma y’umunsi wa 31 gusa.','Vous pouvez arrêter à tout moment et reprendre votre épargne. Le bonus n’est versé qu’après le jour 31.'))
  +det(t3('Terms','Amabwiriza','Conditions'),t3('itunda Bank is not a licensed bank. Sample terms for this prototype.','itunda Bank si banki ifite uruhushya. Amabwiriza ni ingero muri iyi prototype.','itunda Bank n’est pas une banque agréée. Conditions d’exemple pour ce prototype.'))
  +'</div><div style="height:110px"></div><div class="cta"><button class="btn" '+(bad?'disabled ':'')+'onclick="s31Sum()">'+t3('Next','Komeza','Suivant')+'</button></div>';
}
const prev=screens.save31;
screens.save31=()=>{
  const s=st();if(!s.on)return intro();
  const h=prev(),i=h.indexOf('<div class="pad" style="padding-top:24px">'),n=s.n;
  const blk=hero(n,n>=31?t3('Your cup is full. Collect your bonus.','Igikombe cyawe cyuzuye. Akira igihembo cyawe.','Votre tasse est pleine. Récupérez votre bonus.'):t3('Reach the cup for the full 10% bonus','Gera ku gikombe ubone igihembo cyuzuye cya 10%','Atteignez la tasse pour le bonus complet de 10 %'),1)
   +(s.rem&&n<31?'<div class="pad sm mu" style="padding-top:12px">'+nb(t3('We will remind you after day 31.','Tuzakwibutsa nyuma y’umunsi wa 31.','Nous vous le rappellerons après le jour 31.'))+'</div>':'');
  return i>0?h.slice(0,i)+blk+h.slice(i):h+blk;
};
window.s31Sum=()=>{const s=st();if(s.pick>S.bank)return;s.q=undefined;go('s31sum')};
window.s31Q=v=>{st().q=v;keep(()=>render('fade-none'))};
screens.s31sum=()=>{
  const s=st(),a=s.pick,q=s.q;
  const ask=q===undefined;
  return bar('')
  +'<div class="pad" style="padding-top:12px"><div style="height:64px;display:flex;align-items:center">'+gI('coffee',56)+'</div><div class="h1" style="margin-top:14px">'+nb(t3('We’ll set it up like this','Dore uko tuzabitegura','Voici comment nous la mettons en place'))+'</div></div>'
  +'<div class="pad" style="padding-top:20px">'+R(t3('Bonus','Igihembo','Bonus'),nb(t3('Up to 10%','Kugeza kuri 10%','Jusqu’à 10 %')))+R(t3('Period','Igihe','Durée'),t3('31 days','Iminsi 31','31 jours'))+R(t3('Each day','Buri munsi','Chaque jour'),fmt(a)+' RWF')+R(t3('Paid from','Ava kuri','Prélevé sur'),'itunda Bank')+'</div>'
  +'<div style="height:1px;background:var(--ln);margin:14px 24px 0"></div>'
  +(ask?'<div class="pad" style="padding-top:28px"><div class="h1" style="font-size:22px;line-height:30px">'+nb(t3('Want a reminder to start another round after day 31?','Ushaka kwibutswa gutangira indi nyuma y’umunsi wa 31?','Un rappel pour recommencer après le jour 31 ?'))+'</div><div class="mu" style="font-size:15px;margin-top:8px;line-height:22px">'+t3('Nothing is saved for you without your say. You can change this any time.','Nta cyo tuzigama udahari. Ushobora kubihindura igihe cyose.','Rien n’est épargné sans votre accord. Vous pouvez changer cela à tout moment.')+'</div></div><div style="height:110px"></div><div class="cta"><div class="row2" style="display:grid;grid-template-columns:1fr 1fr"><button class="btn sec2" onclick="s31Q(0)">'+t3('No thanks','Oya, urakoze','Non merci')+'</button><button class="btn" onclick="s31Q(1)">'+t3('Remind me','Nyibutsa','Me rappeler')+'</button></div></div>'
   :'<div class="pad" style="padding-top:14px">'+R(t3('Reminder after day 31','Kwibutswa nyuma y’umunsi wa 31','Rappel après le jour 31'),q?t3('On','Birakora','Activé'):t3('Off','Ntibikora','Désactivé'))+'<a style="color:var(--lk);font-weight:700;font-size:14px" onclick="s31Q(undefined)">'+t3('Change','Hindura','Modifier')+'</a></div><div style="height:110px"></div><div class="cta"><button class="btn" onclick="s31Agree()">'+t3('Start saving','Tangira kuzigama','Commencer à épargner')+'</button></div>');
};
window.s31Agree=()=>{
  const s=st(),a=s.pick;if(a>S.bank)return;
  $('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="h1" style="font-size:22px;line-height:30px;margin-top:4px">'+nb(t3('Only the agreement you need','Amasezerano ukeneye gusa','Seulement l’accord nécessaire'))+'</div>'
  +'<div style="display:flex;gap:10px;align-items:center;margin-top:16px;font-weight:800;font-size:16px">'+ic('check',20,'var(--lk)')+'<span><span style="color:var(--lk)">'+t3('Required','Birakenewe','Obligatoire')+'</span> '+t3('31-day savings terms','Amabwiriza yo kuzigama iminsi 31','Conditions de l’épargne sur 31 jours')+'</span></div>'
  +'<div class="mu" style="font-size:14px;line-height:22px;margin:6px 0 0 30px">'+t3('Savings terms \u00b7 Bonus rules \u00b7 Stopping and taking back','Amabwiriza yo kuzigama \u00b7 Ibihembo \u00b7 Guhagarara no gusubirana','Conditions \u00b7 Règles du bonus \u00b7 Arrêt et récupération')+'</div>'
  +'<div style="margin-top:8px">'+R(t3('First save, today','Kuzigama bwa mbere, uyu munsi','Premier versement, aujourd’hui'),fmt(a)+' RWF')+'</div>'
  +'<div class="mu sm" style="margin:6px 0 18px;line-height:20px">'+nb(t3('If you do not fully understand something, it can be harder to sort out a dispute later. Sample terms for this prototype.','Nudasobanukirwa neza, gukemura ikibazo nyuma bishobora kugorana. Amabwiriza ni ingero muri iyi prototype.','Si vous ne comprenez pas bien un point, il peut être plus difficile de régler un litige plus tard. Conditions d’exemple pour ce prototype.'))+'</div>'
  +'<div class="row2" style="display:grid;grid-template-columns:1fr 1.8fr"><button class="btn sec2" onclick="closeSheet()">'+t3('Not now','Si ubu','Pas maintenant')+'</button><button class="btn" style="white-space:nowrap" onclick="s31Begin()">'+t3('Agree and save','Emera uzigame','Accepter et épargner')+'</button></div></div>';
  if(typeof focusSheet==='function')focusSheet();
};
window.s31Begin=()=>{
  const s=st(),a=s.pick;if(a>S.bank||s.on)return;const rem=s.q===1?1:0;
  window.s31Go();s.rem=rem;
  document.querySelectorAll('#phone .toast').forEach(x=>x.remove());
  S.stack.pop();S.stack.push('s31ok');render('fade');
};
screens.s31ok=()=>bar('')
  +'<div style="display:flex;flex-direction:column;align-items:center;text-align:center;padding:96px 28px 0"><div style="width:84px;height:84px;border-radius:42px;background:var(--lk);display:flex;align-items:center;justify-content:center">'+ic('check',44,'#fff')+'</div><div class="h1" style="margin-top:28px">'+nb(t3('Streak started. Aiming for 10%!','Watangiye! Intego ni 10%!','Série lancée. Cap sur 10 % !'))+'</div><div class="mu" style="font-size:16px;margin-top:12px;line-height:24px">'+nb(t3('Your first day is saved. Tap Next to see your bean.','Umunsi wa mbere wabitswe. Kanda Komeza urebe ikawa yawe.','Votre premier jour est enregistré. Touchez Suivant pour voir votre grain.'))+'</div></div><div class="cta"><button class="btn" onclick="s31Done()">'+t3('Next','Komeza','Suivant')+'</button></div>';
window.s31Done=()=>{S.stack.pop();render('fade')};
document.title=document.title.replace(/v\d+/,'v272');
})();
</script>
<script>
/* v272: Statement is a full screen. Period and format chips on top, Download in a fixed bottom bar (Toss style). */
(()=>{
const L=(e,r,f)=>({en:e,rw:r||e,fr:f||e}[S.lang]||e);
S.bs=S.bs||{per:'This month',fm:'CSV'};
const per=[['This month','Uku kwezi','Ce mois-ci'],['Last 3 months','Amezi 3 ashize','3 derniers mois'],['This year','Uyu mwaka','Cette année']];
const chip=(a,cur,fn)=>`<div class="req" role="radiogroup" style="margin-top:12px">${a.map(x=>`<button role="radio" aria-checked="${cur===x[0]}" class="${cur===x[0]?'on':''}" onclick="${fn}('${x[0]}')">${L(...x)}</button>`).join('')}</div>`;
const lab=t=>`<div style="font-size:15px;font-weight:800;margin-top:28px">${t}</div>`;
screens.bkstmt=()=>{const B=S.bs;
return `${bar(L('Statement','Raporo','Relevé'))}<div class="pad" style="padding-top:12px"><div class="h1">${L('Choose a period and format.','Hitamo igihe n’ubwoko.','Choisissez la période et le format.')}</div>${lab(L('Period','Igihe','Période'))}${chip(per,B.per,'bkSP')}${lab(L('Format','Ubwoko','Format'))}${chip([['CSV'],['PDF']],B.fm,'bkSF')}<div class="fine" style="margin-top:24px">${L('Sample data for this prototype.','Amakuru y’icyitegererezo.','Données d’exemple pour ce prototype.')}</div></div><div style="height:110px"></div><div class="cta"><button class="btn" onclick="bkStmtGo()">${L('Download','Manura','Télécharger')}</button></div>`};
window.bkStmt=()=>{S.stack.push('bkstmt');render('push')};
window.bkSP=p=>{S.bs.per=p;render('fade-none')};
window.bkSF=f=>{S.bs.fm=f;render('fade-none')};
const old=window.bkStmtGo;
window.bkStmtGo=()=>{
 if(S.bs.fm==='PDF'){toast(L('PDF export is not in this prototype. Try CSV.','PDF ntiri muri prototype. Gerageza CSV.','Export PDF indisponible. Essayez CSV.'));return}
 const q=v=>'"'+String(v).replace(/"/g,'""')+'"',rows=[['Description','Detail','Amount (RWF)','Type'],...S.act.map(x=>[x[1],x[2],x[3],x[4]||''])];
 const csv=rows.map(r=>r.map(q).join(',')).join('\n');
 try{const b=new Blob(['\ufeff'+csv],{type:'text/csv'}),a=document.createElement('a');a.href=URL.createObjectURL(b);a.download='itunda-statement.csv';document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(a.href),2000);toast(L('Statement downloaded','Raporo yamanuwe','Relevé téléchargé'));back()}catch(e){toast(L('Download is blocked here','Gukuramo bibujijwe hano','Téléchargement bloqué'))}
};
})();
</script>
<script>
/* v273: Deposit is a full screen. Big amount field, quick-add chips, source rows, balance preview, Deposit in a fixed bottom bar. */
(()=>{
const L=(e,r,f)=>({en:e,rw:r||e,fr:f||e}[S.lang]||e);
const MIN=1000,MAX=2000000;
S.bd=S.bd||{src:'MTN MoMo',amt:20000};
const srcs=[['MTN MoMo','#FFCC00'],['Airtel Money','#E40000']];
const lab=t=>`<div style="font-size:15px;font-weight:800;margin-top:28px">${t}</div>`;
const msg=a=>a>MAX?L('The most you can deposit at once is '+fmt(MAX)+' RWF.','Ntushobora gubika ibirenze '+fmt(MAX)+' RWF icyarimwe.','Maximum '+fmt(MAX)+' RWF par dépôt.')
 :a>0&&a<MIN?L('The least you can deposit is '+fmt(MIN)+' RWF.','Ntoya ni '+fmt(MIN)+' RWF.','Minimum '+fmt(MIN)+' RWF.')
 :L('Free and instant.','Ni ubuntu kandi bihita.','Gratuit et instantané.');
const ok=a=>a>=MIN&&a<=MAX;
const btn=a=>ok(a)?L('Deposit ','Bika ','Déposer ')+fmt(a)+' RWF':L('Enter an amount','Andika amafaranga','Saisissez un montant');
screens.bkdep=()=>{const D=S.bd;
return `${bar(L('Deposit to itunda Bank','Bika kuri itunda Bank','Déposer sur itunda Bank'))}<div class="pad" style="padding-top:12px">
<div class="sm mu">${L('Amount','Amafaranga','Montant')}</div>
<div style="display:flex;align-items:baseline;gap:8px;margin-top:6px"><input id="bkdA" inputmode="numeric" autocomplete="off" aria-label="${L('Amount in RWF','Amafaranga muri RWF','Montant en RWF')}" value="${D.amt?fmt(D.amt):''}" placeholder="0" oninput="bkDI(this)" style="flex:1;min-width:0;border:0;outline:0;background:none;font:inherit;font-size:40px;font-weight:800;letter-spacing:-1px;color:var(--tx);padding:0"><b style="font-size:20px;color:var(--tt)">RWF</b></div>
<div id="bkdM" class="sm" aria-live="polite" style="margin-top:6px;min-height:20px;color:${D.amt>MAX||(D.amt>0&&D.amt<MIN)?'var(--er)':'var(--tt)'}">${msg(D.amt)}</div>
<div class="req" style="margin-top:14px">${[10000,20000,50000,100000].map(x=>`<button onclick="bkDQ(${x})">+${fmt(x)}</button>`).join('')}</div>
${lab(L('From','Uvuye','Depuis'))}
<div style="margin-top:6px">${srcs.map(([n,c])=>`<div class="row tap" role="radio" aria-checked="${D.src===n}" tabindex="0" onclick="bkDS('${n}')" style="padding-left:0;padding-right:0"><span style="width:40px;height:40px;border-radius:20px;background:${c};flex-shrink:0"></span><div style="flex:1;margin-left:14px"><div class="t" style="font-size:16px">${n}</div></div><div class="ck ${D.src===n?'on':''}">${ic('check',18,D.src===n?'#17171C':'var(--tt)')}</div></div>`).join('')}</div>
<div style="margin-top:18px;padding:14px 16px;border-radius:16px;background:var(--chip);display:flex;justify-content:space-between;font-size:15px"><span class="mu">${L('Bank balance after','Amafaranga nyuma','Solde après')}</span><b id="bkdB">${fmt(S.bank+(ok(D.amt)?D.amt:0))} RWF</b></div>
<div class="fine" style="margin-top:14px">${L('Sample deposit. No real money moves.','Icyitegererezo. Nta mafaranga yimuwe.','Dépôt d’exemple. Aucun argent réel.')}</div></div>
<div style="height:110px"></div><div class="cta"><button class="btn" id="bkdG" onclick="bkDepGo()" ${ok(D.amt)?'':'disabled'}>${btn(D.amt)}</button></div>`};
const sync=()=>{const D=S.bd,m=document.getElementById('bkdM'),g=document.getElementById('bkdG'),b=document.getElementById('bkdB');
 if(m){m.textContent=msg(D.amt);m.style.color=D.amt>MAX||(D.amt>0&&D.amt<MIN)?'var(--er)':'var(--tt)'}
 if(g){g.disabled=!ok(D.amt);g.textContent=btn(D.amt)}
 if(b)b.textContent=fmt(S.bank+(ok(D.amt)?D.amt:0))+' RWF'};
window.bkDI=el=>{const n=Math.min(parseInt(el.value.replace(/\D/g,''),10)||0,99999999);S.bd.amt=n;el.value=n?fmt(n):'';sync()};
window.bkDQ=n=>{S.bd.amt=Math.min((S.bd.amt||0)+n,99999999);const i=document.getElementById('bkdA');if(i)i.value=fmt(S.bd.amt);sync()};
window.bkDS=s=>{S.bd.src=s;render('fade-none');const i=document.getElementById('bkdA');if(i&&S.bd.amt)i.blur()};
window.bkDep=()=>{S.stack.push('bkdep');render('push')};
window.bkDepGo=()=>{const D=S.bd;if(!ok(D.amt))return;S.bank+=D.amt;addAct('up','Deposit · '+D.src,'Received',D.amt,'Received');back();toast(L('Deposited ','Byabikijwe ','Déposé ')+fmt(D.amt)+' RWF')};
})();
</script>
<script>
/* v274: Move money is a full screen. From/To card with swap, big amount field, quick chips incl. "All", balances after, Move in a fixed bottom bar. */
(()=>{
const L=(e,r,f)=>({en:e,rw:r||e,fr:f||e}[S.lang]||e);
S.bm=S.bm||{dir:'out',amt:5000};
const names=d=>d==='out'?['itunda Bank','itunda Pay']:['itunda Pay','itunda Bank'];
const avail=()=>S.bm.dir==='out'?S.bank:S.pay;
const ok=()=>S.bm.amt>0&&S.bm.amt<=avail();
const msg=()=>S.bm.amt>avail()?t('insuff').replace('%s',fmt(avail())):L('Available','Bihari','Disponible')+' · '+fmt(avail())+' RWF';
const btn=()=>ok()?L('Move ','Imura ','Transférer ')+fmt(S.bm.amt)+' RWF':L('Enter an amount','Andika amafaranga','Saisissez un montant');
const after=()=>{const M=S.bm,v=ok()?M.amt:0,b=S.bank+(M.dir==='out'?-v:v),p=S.pay+(M.dir==='out'?v:-v);return [['itunda Bank',b],['itunda Pay',p]]};
const rows=()=>after().map(([n,v])=>`<div style="display:flex;justify-content:space-between;font-size:15px;padding:6px 0"><span class="mu">${n}</span><b>${fmt(v)} RWF</b></div>`).join('');
screens.bkmove=()=>{const M=S.bm,[a,b]=names(M.dir);
return `${bar(L('Move money','Imura amafaranga','Transférer'))}<div class="pad" style="padding-top:12px">
<div style="display:flex;align-items:center;gap:10px"><div style="flex:1;padding:14px 16px;border-radius:16px;background:var(--chip)"><div class="sm mu">${L('From','Uvuye','De')}</div><b style="font-size:16px">${a}</b></div>
<button class="ib" aria-label="${L('Swap direction','Guhindura icyerekezo','Inverser')}" onclick="bkMS()" style="background:var(--chip);border-radius:22px;flex-shrink:0">${ic('cyc',22)}</button>
<div style="flex:1;padding:14px 16px;border-radius:16px;background:var(--chip)"><div class="sm mu">${L('To','Ujya','Vers')}</div><b style="font-size:16px">${b}</b></div></div>
<div class="sm mu" style="margin-top:28px">${L('Amount','Amafaranga','Montant')}</div>
<div style="display:flex;align-items:baseline;gap:8px;margin-top:6px"><input id="bkmA" inputmode="numeric" autocomplete="off" aria-label="${L('Amount in RWF','Amafaranga muri RWF','Montant en RWF')}" value="${M.amt?fmt(M.amt):''}" placeholder="0" oninput="bkMI(this)" style="flex:1;min-width:0;border:0;outline:0;background:none;font:inherit;font-size:40px;font-weight:800;letter-spacing:-1px;color:var(--tx);padding:0"><b style="font-size:20px;color:var(--tt)">RWF</b></div>
<div id="bkmM" class="sm" aria-live="polite" style="margin-top:6px;min-height:20px;color:${M.amt>avail()?'var(--er)':'var(--tt)'}">${msg()}</div>
<div class="req" style="margin-top:14px">${[1000,5000,20000,50000].map(x=>`<button onclick="bkMQ(${x})">+${fmt(x)}</button>`).join('')}<button onclick="bkMAll()">${L('All','Byose','Tout')}</button></div>
<div style="margin-top:24px;padding:10px 16px;border-radius:16px;background:var(--chip)"><div class="sm mu" style="padding-top:4px">${L('Balances after','Amafaranga nyuma','Soldes après')}</div><div id="bkmB">${rows()}</div></div>
<div class="fine" style="margin-top:14px">${L('Free and instant. Your own money, between your own accounts.','Ni ubuntu kandi bihita. Amafaranga yawe, hagati ya konti zawe.','Gratuit et instantané, entre vos propres comptes.')}</div></div>
<div style="height:110px"></div><div class="cta"><button class="btn" id="bkmG" onclick="bkMoveGo()" ${ok()?'':'disabled'}>${btn()}</button></div>`};
const sync=()=>{const m=document.getElementById('bkmM'),g=document.getElementById('bkmG'),b=document.getElementById('bkmB');
 if(m){m.textContent=msg();m.style.color=S.bm.amt>avail()?'var(--er)':'var(--tt)'}
 if(g){g.disabled=!ok();g.textContent=btn()}
 if(b)b.innerHTML=rows()};
window.bkMI=el=>{const n=Math.min(parseInt(el.value.replace(/\D/g,''),10)||0,99999999);S.bm.amt=n;el.value=n?fmt(n):'';sync()};
window.bkMQ=n=>{S.bm.amt=Math.min((S.bm.amt||0)+n,99999999);const i=document.getElementById('bkmA');if(i)i.value=fmt(S.bm.amt);sync()};
window.bkMAll=()=>{S.bm.amt=avail();const i=document.getElementById('bkmA');if(i)i.value=S.bm.amt?fmt(S.bm.amt):'';sync()};
window.bkMS=()=>{S.bm.dir=S.bm.dir==='out'?'in':'out';render('fade-none')};
window.bkMove=()=>{S.stack.push('bkmove');render('push')};
window.bkMoveGo=()=>{const M=S.bm,v=M.amt;if(!ok())return;
 if(M.dir==='out'){S.bank-=v;S.pay+=v;addAct('cyc','Moved to itunda Pay','Transfer',-v,'Paid')}else{S.pay-=v;S.bank+=v;addAct('up','Moved to itunda Bank','Transfer',v,'Received')}
 back();toast(fmt(v)+' RWF '+L('moved','yimuwe','transférés'))};
})();
</script>
<script>
/* v275: Request money is a full screen. Big amount field, quick chips, optional note, live code card, Copy and Share in a fixed bottom bar. */
(()=>{
const L=(e,r,f)=>({en:e,rw:r||e,fr:f||e}[S.lang]||e);
const MIN=100,MAX=5000000;
S.rqAmt=S.rqAmt||5000;S.rqNote=S.rqNote||'';
const esc=s=>String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/"/g,'&quot;');
const ok=()=>S.rqAmt>=MIN&&S.rqAmt<=MAX;
const msg=()=>S.rqAmt>MAX?L('The most you can request is '+fmt(MAX)+' RWF.','Ntushobora gusaba ibirenze '+fmt(MAX)+' RWF.','Maximum '+fmt(MAX)+' RWF par demande.')
 :S.rqAmt>0&&S.rqAmt<MIN?L('The least you can request is '+fmt(MIN)+' RWF.','Ntoya ni '+fmt(MIN)+' RWF.','Minimum '+fmt(MIN)+' RWF.')
 :L('Whoever pays the code sends you this amount.','Uwishyura iyi code aguha aya mafaranga.','Qui paie ce code vous envoie ce montant.');
const text=()=>'Please pay me '+fmt(S.rqAmt)+' RWF on itunda. Code: '+reqCode()+(S.rqNote?' · '+S.rqNote:'');
const card=()=>ok()?`<div class="sm mu">${L('Request code','Code y’ubusabe','Code de demande')}</div><div style="font-size:24px;font-weight:800;letter-spacing:1px;margin-top:4px">${reqCode()}</div><div class="sm mu" style="margin-top:4px">${fmt(S.rqAmt)} RWF · ${L('valid 24 hours · sample code','ifite agaciro amasaha 24 · code y’icyitegererezo','valable 24 h · code d’exemple')}</div>`
 :`<div class="sm mu">${L('Request code','Code y’ubusabe','Code de demande')}</div><div style="font-size:24px;font-weight:800;margin-top:4px;color:var(--tt)">—</div><div class="sm mu" style="margin-top:4px">${L('Enter an amount to get a code','Andika amafaranga ubone code','Saisissez un montant pour obtenir un code')}</div>`;
screens.bkreq=()=>`${bar(t('rq'))}<div class="pad" style="padding-top:12px">
<div class="sm mu">${L('Amount','Amafaranga','Montant')}</div>
<div style="display:flex;align-items:baseline;gap:8px;margin-top:6px"><input id="rqA" inputmode="numeric" autocomplete="off" aria-label="${L('Amount in RWF','Amafaranga muri RWF','Montant en RWF')}" value="${S.rqAmt?fmt(S.rqAmt):''}" placeholder="0" oninput="rqI(this)" style="flex:1;min-width:0;border:0;outline:0;background:none;font:inherit;font-size:40px;font-weight:800;letter-spacing:-1px;color:var(--tx);padding:0"><b style="font-size:20px;color:var(--tt)">RWF</b></div>
<div id="rqM" class="sm" aria-live="polite" style="margin-top:6px;min-height:20px;color:${S.rqAmt>MAX||(S.rqAmt>0&&S.rqAmt<MIN)?'var(--er)':'var(--tt)'}">${msg()}</div>
<div class="req" style="margin-top:14px">${[2000,5000,10000,25000].map(x=>`<button onclick="rqQ(${x})">+${fmt(x)}</button>`).join('')}<button onclick="rqC()">${L('Clear','Siba','Effacer')}</button></div>
<div style="font-size:15px;font-weight:800;margin-top:28px">${L('Note (optional)','Icyitonderwa (si ngombwa)','Note (facultatif)')}</div>
<input id="rqN" class="in" maxlength="40" autocomplete="off" aria-label="${L('Note','Icyitonderwa','Note')}" placeholder="${L('For example, lunch','Urugero: ifunguro rya sasita','Par exemple, déjeuner')}" value="${esc(S.rqNote)}" oninput="S.rqNote=this.value.trim()" style="height:44px;font-size:16px;margin-top:6px">
<div id="rqK" style="margin-top:24px;background:var(--chip);border-radius:18px;padding:16px 18px">${card()}</div></div>
<div style="height:110px"></div><div class="cta" style="display:flex;gap:10px"><button class="btn sec2" id="rqCp" onclick="rqCopy()" ${ok()?'':'disabled'}>${L('Copy','Kopora','Copier')}</button><button class="btn" id="rqSh" onclick="rqShare()" ${ok()?'':'disabled'}>${L('Share request','Sangiza ubusabe','Partager la demande')}</button></div>`;
const sync=()=>{const m=document.getElementById('rqM'),k=document.getElementById('rqK');
 if(m){m.textContent=msg();m.style.color=S.rqAmt>MAX||(S.rqAmt>0&&S.rqAmt<MIN)?'var(--er)':'var(--tt)'}
 if(k)k.innerHTML=card();
 ['rqCp','rqSh'].forEach(i=>{const b=document.getElementById(i);if(b)b.disabled=!ok()})};
window.rqI=el=>{const n=Math.min(parseInt(el.value.replace(/\D/g,''),10)||0,99999999);S.rqAmt=n;el.value=n?fmt(n):'';sync()};
window.rqQ=n=>{S.rqAmt=Math.min((S.rqAmt||0)+n,99999999);const i=document.getElementById('rqA');if(i)i.value=fmt(S.rqAmt);sync()};
window.rqC=()=>{S.rqAmt=0;const i=document.getElementById('rqA');if(i){i.value='';i.focus()}sync()};
window.rqCopy=()=>{if(!ok())return;try{navigator.clipboard.writeText(text())}catch(e){}toast(L('Request copied','Ubusabe bwakopowe','Demande copiée'))};
window.rqShare=()=>{if(!ok())return;if(navigator.share){navigator.share({text:text()}).catch(()=>{})}else rqCopy()};
window.reqSheet=()=>{S.stack.push('bkreq');render('push')};
})();
</script>
<script>
/* v276: Buy airtime. One full screen for the mini app and Pay. Network auto-detected from the number, "My number" and recent numbers, big amount field, balance after, Buy in a fixed bottom bar. */
(()=>{
const L=(e,r,f)=>({en:e,rw:r||e,fr:f||e}[S.lang]||e);
const MIN=100,MAX=100000,MINE='0788000214';
S.air=S.air||{op:'MTN',ph:'',amt:1000,done:null,hist:[]};
const prev=screens.airtime;
const grp=p=>p.replace(/(\d{3})(\d{0,3})(\d{0,4})/,(m,a,b,c)=>[a,b,c].filter(Boolean).join(' '));
const dotc={MTN:'#FFCC00',Airtel:'#E40000'};
const okPh=()=>/^07\d{8}$/.test(S.air.ph);
const okAmt=()=>S.air.amt>=MIN&&S.air.amt<=MAX&&S.air.amt<=S.pay;
const ok=()=>okPh()&&okAmt();
const aMsg=()=>S.air.amt>MAX?L('The most you can buy at once is '+fmt(MAX)+' RWF.','Ntushobora kugura ibirenze '+fmt(MAX)+' RWF icyarimwe.','Maximum '+fmt(MAX)+' RWF par achat.')
 :S.air.amt>0&&S.air.amt<MIN?L('The least you can buy is '+fmt(MIN)+' RWF.','Ntoya ni '+fmt(MIN)+' RWF.','Minimum '+fmt(MIN)+' RWF.')
 :S.air.amt>S.pay?L('Not enough balance','Amafaranga ntahagije','Solde insuffisant')+' — RWF '+fmt(S.pay)
 :L('Airtime arrives in seconds.','Airtime ihita ihagera.','Le crédit arrive en quelques secondes.');
const aBad=()=>S.air.amt>MAX||(S.air.amt>0&&S.air.amt<MIN)||S.air.amt>S.pay;
const pMsg=()=>S.air.ph.length>=10&&!okPh()?L('Enter a number that starts with 07.','Andika nimero itangirira kuri 07.','Saisissez un numéro qui commence par 07.'):S.air.ph.length>0&&S.air.ph.length<10?(10-S.air.ph.length)+' '+L('more digits','imibare isigaye','chiffres restants'):'';
const btn=()=>ok()?L('Buy ','Gura ','Acheter ')+fmt(S.air.amt)+' RWF':!okPh()?L('Enter a phone number','Andika nimero ya telefoni','Saisissez un numéro'):L('Enter an amount','Andika amafaranga','Saisissez un montant');
const recents=()=>{const seen=[MINE],o=[];S.air.hist.forEach(h=>{if(!seen.includes(h[1])){seen.push(h[1]);o.push(h[1])}});return o.slice(0,3)};
const after=()=>fmt(S.pay-(ok()?S.air.amt:0))+' RWF';
screens.airtime=()=>{const A=S.air;if(A.done)return prev();
const rc=recents();
return `${bar(L('Buy airtime','Gura airtime','Acheter du crédit'))}<div class="pad" style="padding-top:12px">
<div class="sm mu">${L('Phone number','Nimero ya telefoni','Numéro de téléphone')}</div>
<input id="airph" class="in" inputmode="numeric" autocomplete="off" aria-label="${L('Phone number','Nimero ya telefoni','Numéro de téléphone')}" value="${grp(A.ph)}" placeholder="078 000 0000" oninput="airPh(this.value)" style="font-size:28px;font-weight:800;letter-spacing:-.5px;margin-top:4px">
<div id="airpm" class="sm" aria-live="polite" style="margin-top:6px;min-height:20px;color:var(--tt)">${pMsg()}</div>
<div class="req" style="margin-top:10px"><button onclick="airUse('${MINE}')">${L('My number','Nimero yanjye','Mon numéro')}</button>${rc.map(n=>`<button onclick="airUse('${n}')">${grp(n)}</button>`).join('')}</div>
<div style="font-size:15px;font-weight:800;margin-top:28px">${L('Network','Umuyoboro','Réseau')}</div>
<div class="req" id="airnet" role="radiogroup" style="margin-top:10px">${['MTN','Airtel'].map(o=>`<button role="radio" aria-checked="${A.op===o}" class="${A.op===o?'on':''}" data-o="${o}" onclick="airSet('op','${o}')" style="display:flex;align-items:center;gap:8px"><span style="width:12px;height:12px;border-radius:6px;background:${dotc[o]}"></span>${o}</button>`).join('')}</div>
<div class="sm mu" style="margin-top:28px">${L('Amount','Amafaranga','Montant')}</div>
<div style="display:flex;align-items:baseline;gap:8px;margin-top:6px"><input id="airA" inputmode="numeric" autocomplete="off" aria-label="${L('Amount in RWF','Amafaranga muri RWF','Montant en RWF')}" value="${A.amt?fmt(A.amt):''}" placeholder="0" oninput="airAI(this)" style="flex:1;min-width:0;border:0;outline:0;background:none;font:inherit;font-size:40px;font-weight:800;letter-spacing:-1px;color:var(--tx);padding:0"><b style="font-size:20px;color:var(--tt)">RWF</b></div>
<div id="airM" class="sm" aria-live="polite" style="margin-top:6px;min-height:20px;color:${aBad()?'var(--er)':'var(--tt)'}">${aMsg()}</div>
<div class="req" style="margin-top:14px">${[500,1000,2000,5000].map(x=>`<button onclick="airQ(${x})">+${fmt(x)}</button>`).join('')}<button onclick="airC()">${L('Clear','Siba','Effacer')}</button></div>
<div style="margin-top:24px;padding:14px 16px;border-radius:16px;background:var(--chip)"><div style="display:flex;justify-content:space-between;font-size:15px"><span class="mu">${L('Pay with','Ishyura na','Payer avec')}</span><b>itunda Pay</b></div><div style="display:flex;justify-content:space-between;font-size:15px;margin-top:8px"><span class="mu">${L('Balance after','Amafaranga nyuma','Solde après')}</span><b id="airB">${after()}</b></div></div></div>
<div style="height:110px"></div><div class="cta"><button id="airgo" class="btn" ${ok()?'':'disabled'} onclick="airPay()">${btn()}</button></div>`};
const sync=()=>{const m=document.getElementById('airM'),p=document.getElementById('airpm'),g=document.getElementById('airgo'),b=document.getElementById('airB');
 if(m){m.textContent=aMsg();m.style.color=aBad()?'var(--er)':'var(--tt)'}
 if(p)p.textContent=pMsg();
 if(g){g.disabled=!ok();g.textContent=btn()}
 if(b)b.textContent=after();
 document.querySelectorAll('#airnet button').forEach(x=>{const on=x.dataset.o===S.air.op;x.classList.toggle('on',on);x.setAttribute('aria-checked',on)})};
const detect=()=>{const p=S.air.ph.slice(0,3);if(p==='078'||p==='079')S.air.op='MTN';else if(p==='072'||p==='073')S.air.op='Airtel'};
window.airPh=v=>{S.air.ph=v.replace(/\D/g,'').slice(0,10);const i=document.getElementById('airph');if(i)i.value=grp(S.air.ph);detect();sync()};
window.airUse=n=>{S.air.ph=n;detect();render('fade-none')};
window.airSet=(k,v)=>{S.air[k]=v;sync()};
window.airAI=el=>{const n=Math.min(parseInt(el.value.replace(/\D/g,''),10)||0,99999999);S.air.amt=n;el.value=n?fmt(n):'';sync()};
window.airQ=n=>{S.air.amt=Math.min((S.air.amt||0)+n,99999999);const i=document.getElementById('airA');if(i)i.value=fmt(S.air.amt);sync()};
window.airC=()=>{S.air.amt=0;const i=document.getElementById('airA');if(i){i.value='';i.focus()}sync()};
const netOf=p=>/^07[89]/.test(p)?'MTN':/^07[23]/.test(p)?'Airtel':null;
window.airPay=go=>{const A=S.air;if(!ok())return;
 if(!go){const nt=netOf(A.ph),warn=nt&&nt!==A.op,row=(a,v)=>'<div style="display:flex;justify-content:space-between;gap:12px;min-height:40px;align-items:center;font-size:15px"><span class="mu">'+a+'</span><b style="text-align:right">'+v+'</b></div>';
  $('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="h1" style="font-size:22px;line-height:30px;margin-top:4px">'+L('Review airtime','Suzuma airtime','Vérifier le crédit')+'</div><div style="margin:12px 0 '+(warn?'8px':'22px')+'">'+row(L('Network','Umuyoboro','Réseau'),A.op)+row(L('Phone number','Nimero ya telefoni','Numéro de téléphone'),grp(A.ph))+row(L('Amount','Amafaranga','Montant'),fmt(A.amt)+' RWF')+row(L('Pay with','Ishyura na','Payer avec'),'itunda Pay')+row(L('Balance after','Amafaranga nyuma','Solde après'),fmt(S.pay-A.amt)+' RWF')+'</div>'+(warn?'<div class="sm" style="color:var(--er);margin-bottom:16px;line-height:19px">'+L('This number looks like an '+nt+' number, but you picked '+A.op+'. Airtime sent to the wrong network may not arrive.','Iyi nimero isa n’iya '+nt+', ariko wahisemo '+A.op+'. Airtime yoherejwe ku muyoboro utari wo ntishobora kugerayo.','Ce numéro semble être un numéro '+nt+', mais vous avez choisi '+A.op+'. Le crédit envoyé au mauvais réseau peut ne pas arriver.')+'</div>':'')+'<button class="btn" onclick="closeSheet();airPay(1)">'+L('Buy ','Gura ','Acheter ')+fmt(A.amt)+' RWF</button></div>';
  if(typeof focusSheet==='function')focusSheet();return}
 S.pay-=A.amt;A.hist.unshift([A.op,A.ph,A.amt]);A.done=[A.op,A.ph,A.amt];addAct('phone','Airtime · '+A.op,'Paid',-A.amt,'Paid');render('fade-none')};
window.ppAir=()=>{if(typeof closeSheet==='function')closeSheet();S.air.done=null;go('airtime')};
})();
</script>
<script>
/* v277: Pay bills on one screen. Biller chips that wrap (no side scroll), account number with live check, big amount field, balance after, Pay in a fixed bottom bar, localized confirm sheet and receipt. */
(()=>{
const L=(e,r,f)=>({en:e,rw:r||e,fr:f||e}[S.lang]||e);
const MIN=100;
const esc=s=>String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/"/g,'&quot;');
const nm={'REG electricity':['Electricity','Umuriro','Électricité'],'WASAC water':['Water','Amazi','Eau'],'RRA taxes':['Taxes','Imisoro','Impôts'],'School fees':['School fees','Amafaranga y’ishuri','Frais scolaires'],'Irembo':['Irembo','Irembo','Irembo']};
const name=k=>nm[k]?L(...nm[k]):k;
const lb={'Meter number':['Meter number',0,'Numéro de compteur'],'Water meter number':['Water meter number',0,'Numéro de compteur d’eau'],'Phone number':['Phone number','Nimero ya telefoni','Numéro de téléphone'],'Tax ID (TIN)':['Tax ID (TIN)',0,'N° d’identification fiscale (TIN)'],'Student ID':['Student ID',0,'Numéro d’étudiant'],'Application number':['Application number',0,'Numéro de dossier']};
const lab=l=>lb[l]?L(lb[l][0],lb[l][1],lb[l][2]):l;
const hn={'REG electricity':['Find it on your meter or your last token receipt.',0,'Il figure sur votre compteur ou votre dernier reçu.'],'WASAC water':['Find it on your water meter or your last bill.',0,'Il figure sur votre compteur d’eau ou votre dernière facture.'],'RRA taxes':['It is on your RRA certificate.',0,'Il figure sur votre certificat RRA.'],'School fees':['It is on your school card.',0,'Il figure sur votre carte scolaire.'],'Irembo':['You get it when you submit your application.',0,'Vous le recevez lors du dépôt de votre dossier.']};
const hint=k=>hn[k]?L(hn[k][0],hn[k][1],hn[k][2]):'';
const isPh=P=>P.l==='Phone number';
const ok=()=>{const B=S.bl,P=BP[B.p];return B.num.length===P.n&&B.amt>=MIN&&B.amt<=S.bank};
const numMsg=()=>{const B=S.bl,P=BP[B.p],n=B.num.length;
 if(n===P.n)return S.sm&&S.sm[B.p]===B.num?L('Saved from your last payment','Byabitswe uhereye kwishyura','Enregistré depuis votre dernier paiement'):'';
 return n?(P.n-n)+' '+L('more digits','imibare isigaye','chiffres restants')+(isPh(P)?' '+L('(without the 0)','(nta 0)','(sans le 0)'):''):hint(B.p)};
const amMsg=()=>{const B=S.bl;return B.amt>S.bank?t('insuff').replace('%s',fmt(S.bank)):B.amt>0&&B.amt<MIN?L('The least you can pay is '+fmt(MIN)+' RWF.','Ntoya ni '+fmt(MIN)+' RWF.','Minimum '+fmt(MIN)+' RWF.'):L('From itunda Bank','Biva kuri itunda Bank','Depuis itunda Bank')+' · '+fmt(S.bank)+' RWF '+L('available','bihari','disponibles')};
const amBad=()=>S.bl.amt>S.bank||(S.bl.amt>0&&S.bl.amt<MIN);
const btn=()=>{const B=S.bl,P=BP[B.p];return ok()?L('Pay ','Ishyura ','Payer ')+fmt(B.amt)+' RWF':B.num.length!==P.n?L('Enter the '+lab(P.l).toLowerCase(),'Andika '+lab(P.l).toLowerCase(),'Saisissez : '+lab(P.l).toLowerCase()):L('Enter an amount','Andika amafaranga','Saisissez un montant')};
const after=()=>fmt(S.bank-(ok()?S.bl.amt:0))+' RWF';
screens.bill=()=>{const B=S.bl,P=BP[B.p],keys=Object.keys(BP).filter(k=>!/airtime/.test(k)||k===B.p);
requestAnimationFrame(()=>{const b=document.querySelector('#blk .on');if(b)b.scrollIntoView({inline:'center',block:'nearest'})});
return `${bar(L('Pay bills','Ishyura fagitire','Payer des factures'))}<div class="pad" style="padding-top:12px">
<div class="sm mu">${L('Pay to','Ishyura kuri','Payer à')}</div>
<style>#blk::-webkit-scrollbar{display:none}</style><div class="req" id="blk" role="radiogroup" style="margin:10px -24px 0;padding:0 24px;flex-wrap:nowrap;overflow-x:auto;scrollbar-width:none">${keys.map(k=>`<button role="radio" aria-checked="${B.p===k}" class="${B.p===k?'on':''}" onclick="blSet('${k}')" style="flex:0 0 auto;white-space:nowrap">${esc(name(k))}</button>`).join('')}</div>
<div id="blL" style="font-size:15px;font-weight:800;margin-top:28px">${lab(P.l)}</div>
<input id="bnum" class="in" inputmode="numeric" autocomplete="off" aria-label="${lab(P.l)}" value="${B.num}" oninput="blN(this.value)" placeholder="${isPh(P)?'7'+'X'.repeat(P.n-1):'0'.repeat(P.n)}" style="font-size:28px;font-weight:800;letter-spacing:.5px;margin-top:4px">
<div id="blNM" class="sm" aria-live="polite" style="margin-top:6px;min-height:20px;color:var(--tt)">${numMsg()}</div>
<div class="sm mu" style="margin-top:28px">${L('Amount','Amafaranga','Montant')}</div>
<div style="display:flex;align-items:baseline;gap:8px;margin-top:6px"><input id="blA" inputmode="numeric" autocomplete="off" aria-label="${L('Amount in RWF','Amafaranga muri RWF','Montant en RWF')}" value="${B.amt?fmt(B.amt):''}" placeholder="0" oninput="blAI(this)" style="flex:1;min-width:0;border:0;outline:0;background:none;font:inherit;font-size:40px;font-weight:800;letter-spacing:-1px;color:var(--tx);padding:0"><b style="font-size:20px;color:var(--tt)">RWF</b></div>
<div id="blAM" class="sm" aria-live="polite" style="margin-top:6px;min-height:20px;color:${amBad()?'var(--er)':'var(--tt)'}">${amMsg()}</div>
<div class="req" id="blCh" style="margin-top:14px">${P.a.map(a=>`<button data-v="${a}" class="${B.amt===a?'on':''}" onclick="blQ(${a})">${fmt(a)}</button>`).join('')}</div>
<div style="margin-top:24px;padding:14px 16px;border-radius:16px;background:var(--chip);display:flex;justify-content:space-between;font-size:15px"><span class="mu">${L('Bank balance after','Amafaranga nyuma','Solde après')}</span><b id="blB">${after()}</b></div>
<div class="fine" style="margin-top:14px">${L('Providers and numbers are sample data. No real payment is made.','Abatanga serivisi n’inimero ni ibyitegererezo. Nta bwishyu nyabwo bukorwa.','Fournisseurs et numéros d’exemple. Aucun paiement réel.')}</div></div>
<div style="height:110px"></div><div class="cta"><button id="bgo" class="btn" ${ok()?'':'disabled'} onclick="billPay()">${btn()}</button></div>`};
const sync=()=>{const B=S.bl,m=document.getElementById('blAM'),n=document.getElementById('blNM'),g=document.getElementById('bgo'),b=document.getElementById('blB');
 if(m){m.textContent=amMsg();m.style.color=amBad()?'var(--er)':'var(--tt)'}
 if(n)n.textContent=numMsg();
 if(g){g.disabled=!ok();g.textContent=btn()}
 if(b)b.textContent=after();
 document.querySelectorAll('#blCh button').forEach(x=>x.classList.toggle('on',x.dataset.v==String(B.amt)))};
window.blSet=k=>{const P=BP[k];S.bl={p:k,num:(S.sm&&S.sm[k])||'',amt:P.a[1]};render('fade-none')};
window.blN=v=>{const B=S.bl,P=BP[B.p];let d=v.replace(/\D/g,'');if(isPh(P)){if(d.startsWith('250'))d=d.slice(3);if(d.startsWith('0'))d=d.slice(1)}B.num=d.slice(0,P.n);const i=document.getElementById('bnum');if(i&&i.value!==B.num)i.value=B.num;sync()};
window.blAI=el=>{const n=Math.min(parseInt(el.value.replace(/\D/g,''),10)||0,99999999);S.bl.amt=n;el.value=n?fmt(n):'';sync()};
window.blQ=n=>{S.bl.amt=n;const i=document.getElementById('blA');if(i)i.value=fmt(n);sync()};
/* confirm sheet in three languages */
window.billPay=()=>{const B=S.bl,P=BP[B.p];if(!ok())return;
 const row=(a,v)=>`<div style="display:flex;justify-content:space-between;gap:12px;min-height:40px;align-items:center;font-size:15px"><span class="mu">${a}</span><b style="text-align:right">${v}</b></div>`;
 $('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" role="dialog" aria-modal="true"><div class="h1" style="font-size:22px;line-height:30px;margin-top:4px">${L('Review payment','Suzuma ubwishyu','Vérifier le paiement')}</div><div style="margin:12px 0 22px">${row(L('Pay to','Ishyura kuri','Payer à'),esc(name(B.p)))}${row(lab(P.l),B.num)}${row(L('Amount','Amafaranga','Montant'),fmt(B.amt)+' RWF')}${row(L('Pay with','Ishyura na','Payer avec'),'itunda Bank')}${row(L('Balance after','Amafaranga nyuma','Solde après'),fmt(S.bank-B.amt)+' RWF')}</div><button class="btn" onclick="billDone()">${L('Pay ','Ishyura ','Payer ')+fmt(B.amt)+' RWF'}</button></div>`;
 if(typeof focusSheet==='function')focusSheet()};
/* receipt in three languages */
const _bd=screens.billdone;
screens.billdone=()=>{let h=_bd();if(S.lang==='en')return h;
 const R=[['Paid to ',L('Paid to ','Byishyuwe kuri ','Payé à ')],['Balance now',L('Balance now','Asigaye ubu','Solde actuel')],['Token (sample)',L('Token (sample)','Token (icyitegererezo)','Jeton (exemple)')],['>Done<','>'+L('Done','Byarangiye','Terminé')+'<']];
 R.forEach(([a,b])=>{h=h.split(a).join(b)});
 const P=BP[S.bl.p];if(P)h=h.split('>'+P.l+'<').join('>'+lab(P.l)+'<');return h};
})();
</script>
<script>
/* v278: Receive money on one screen. Code card with a live amount, optional amount field and chips on the same page, Copy link and Share in a fixed bottom bar. The Pay "Receive" tile opens the same screen. */
(()=>{
const L=(e,r,f)=>({en:e,rw:r||e,fr:f||e}[S.lang]||e);
const MIN=100,MAX=5000000,NUM='0788-1205-1980';
S.rc=S.rc||{amt:'',tmp:''};S.rc.raw=S.rc.raw!==undefined?S.rc.raw:(S.rc.amt?String(S.rc.amt):'');
const esc=s=>String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/"/g,'&quot;');
const prev=screens.rcode;
const qrSvg=()=>{const m=prev().match(/<svg viewBox="0 0 200 200"[\s\S]*?<\/svg>/);return m?m[0]:''};
const raw=()=>Number(S.rc.raw||0);
const valid=()=>!raw()||(raw()>=MIN&&raw()<=MAX);
const msg=()=>raw()>MAX?L('The most you can ask for is '+fmt(MAX)+' RWF.','Ntushobora gusaba ibirenze '+fmt(MAX)+' RWF.','Maximum '+fmt(MAX)+' RWF par code.')
 :raw()&&raw()<MIN?L('The least you can ask for is '+fmt(MIN)+' RWF.','Ntoya ni '+fmt(MIN)+' RWF.','Minimum '+fmt(MIN)+' RWF.')
 :raw()?L('The code now asks for '+fmt(raw())+' RWF.','Kode isaba '+fmt(raw())+' RWF.','Le code demande '+fmt(raw())+' RWF.')
 :L('Leave empty and the sender chooses the amount.','Reka ubusa, uwishyura ahitamo amafaranga.','Laissez vide : l’expéditeur choisit le montant.');
const link=()=>'https://itunda.rw/pay/'+NUM+(S.rc.amt?'?amount='+S.rc.amt:'');
const cap=()=>S.rc.amt?fmt(S.rc.amt)+' RWF':L('Any amount','Umubare wose','Montant libre');
screens.rcode=()=>{
 return `${bar(L('Receive money','Akira amafaranga','Recevoir de l’argent'))}<div class="pad" style="padding-top:12px"><div class="mu" style="font-size:15px">${L('Show this code to the other person.','Erekana iyi kode ku wundi muntu.','Montrez ce code à l’autre personne.')}</div></div>
<div style="margin:18px 24px 0;padding:22px 16px 18px;border-radius:28px;background:var(--chip);text-align:center"><div id="rcQ" style="display:inline-block;padding:10px;border-radius:18px;background:#fff;line-height:0">${qrSvg()}</div>
<div style="margin-top:14px;font-size:17px;font-weight:800">${esc(S.name||'You')}</div><div class="sm mu" style="margin-top:2px">itunda Pay · ${NUM}</div>
<div id="rcC" style="margin-top:10px;font-size:24px;font-weight:800;letter-spacing:-.4px">${cap()}</div>
<button class="tap" onclick="toast('${L('Image saved (prototype)','Ifoto yabitswe (prototype)','Image enregistrée (prototype)')}')" style="margin-top:10px;border:0;background:none;color:var(--tt);font:inherit;font-size:15px;font-weight:700;min-height:44px">${L('Save image','Bika ifoto','Enregistrer l’image')}</button></div>
<div class="pad" style="padding-top:24px"><div style="font-size:15px;font-weight:800">${L('Set an amount (optional)','Shyiraho amafaranga (si ngombwa)','Définir un montant (facultatif)')}</div>
<div style="display:flex;align-items:baseline;gap:8px;margin-top:6px"><input id="rcA" inputmode="numeric" autocomplete="off" aria-label="${L('Amount in RWF','Amafaranga muri RWF','Montant en RWF')}" value="${raw()?fmt(raw()):''}" placeholder="0" oninput="rcI(this)" style="flex:1;min-width:0;border:0;outline:0;background:none;font:inherit;font-size:32px;font-weight:800;letter-spacing:-.8px;color:var(--tx);padding:0"><b style="font-size:18px;color:var(--tt)">RWF</b></div>
<div id="rcM" class="sm" aria-live="polite" style="margin-top:6px;min-height:20px;color:${valid()?'var(--tt)':'var(--er)'}">${msg()}</div>
<div class="req" style="margin-top:12px">${[1000,5000,10000].map(x=>`<button onclick="rcQ(${x})">+${fmt(x)}</button>`).join('')}<button onclick="rcC()">${L('Clear','Siba','Effacer')}</button></div>
<div class="fine" style="margin-top:16px">${L('Sample code, not a real one.','Kode y’icyitegererezo, si iyukuri.','Code d’exemple, pas un vrai.')}</div></div>
<div style="height:110px"></div><div class="cta" style="display:flex;gap:10px"><button class="btn sec2" id="rcCp" onclick="rcCopy()" ${valid()?'':'disabled'}>${L('Copy link','Kopera link','Copier le lien')}</button><button class="btn" id="rcSh" onclick="rcShare()" ${valid()?'':'disabled'}>${L('Share code','Sangiza kode','Partager le code')}</button></div>`};
const sync=()=>{S.rc.amt=valid()&&raw()?String(raw()):'';
 const q=document.getElementById('rcQ'),c=document.getElementById('rcC'),m=document.getElementById('rcM');
 if(q)q.innerHTML=qrSvg();if(c)c.textContent=cap();
 if(m){m.textContent=msg();m.style.color=valid()?'var(--tt)':'var(--er)'}
 ['rcCp','rcSh'].forEach(i=>{const b=document.getElementById(i);if(b)b.disabled=!valid()})};
window.rcI=el=>{const n=Math.min(parseInt(el.value.replace(/\D/g,''),10)||0,99999999);S.rc.raw=n?String(n):'';el.value=n?fmt(n):'';sync()};
window.rcQ=n=>{S.rc.raw=String(Math.min(raw()+n,99999999));const i=document.getElementById('rcA');if(i)i.value=fmt(raw());sync()};
window.rcC=()=>{S.rc.raw='';const i=document.getElementById('rcA');if(i){i.value='';i.focus()}sync()};
window.rcCopy=()=>{if(!valid())return;try{navigator.clipboard.writeText(link()).catch(()=>{})}catch(e){}toast(L('Link copied','Link yakoporowe','Lien copié'))};
window.rcShare=()=>{if(!valid())return;const tx=L('Pay me on itunda','Nyishyure kuri itunda','Payez-moi sur itunda')+(S.rc.amt?' · '+fmt(S.rc.amt)+' RWF':'');if(navigator.share){navigator.share({text:tx,url:link()}).catch(()=>{})}else rcCopy()};
window.ppRecv=()=>{if(typeof closeSheet==='function')closeSheet();S.stack.push('rcode');render('push')};
})();
</script>
<script>
/* v280: Split a bill (Pay) on one screen. Bill amount field, category row, pick who to split with, live shares, Request in a fixed bottom bar. */
(()=>{
const L=(e,r,f)=>({en:e,rw:r||e,fr:f||e}[S.lang]||e);
const MIN=200,MAX=5000000;
const PEOPLE=['Amina K.','Eric M.','Grace U.','Jean Paul','Divine N.'];
const esc=s=>String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/"/g,'&quot;');
const CATS=[['Meal','Ifunguro','Repas'],['Coffee','Ikawa','Café'],['Snack','Agafunguro','Snack'],['Drinks','Ibinyobwa','Boissons'],['Transport','Ingendo','Transport']];
S.sb=S.sb||{amt:30000,cat:'',sel:['Amina K.','Eric M.']};
const B=()=>S.sb;
const okAmt=()=>B().amt>=MIN&&B().amt<=MAX;
const k=()=>B().sel.length;
const ok=()=>okAmt()&&k()>0;
const each=()=>okAmt()&&k()?Math.ceil(B().amt/(k()+1)):0;
const mine=()=>okAmt()&&k()?Math.max(B().amt-each()*k(),0):0;
const catName=c=>{const x=CATS.find(y=>y[0]===c);return x?L(x[0],x[1],x[2]):''};
const msg=()=>B().amt>MAX?L('The most you can split is '+fmt(MAX)+' RWF.','Ntushobora gugabana ibirenze '+fmt(MAX)+' RWF.','Maximum '+fmt(MAX)+' RWF.')
 :B().amt>0&&B().amt<MIN?L('The least you can split is '+fmt(MIN)+' RWF.','Ntoya ni '+fmt(MIN)+' RWF.','Minimum '+fmt(MIN)+' RWF.')
 :L('Everyone you pick pays an equal share.','Buri wese uhisemo yishyura ungana.','Chaque personne choisie paie une part égale.');
const bad=()=>B().amt>MAX||(B().amt>0&&B().amt<MIN);
const btn=()=>ok()?L('Request ','Saba ','Demander ')+fmt(each())+' RWF '+L('each','buri umwe','chacun'):!okAmt()?L('Enter the bill amount','Andika fagitire','Saisissez le montant'):L('Pick who to split with','Hitamo abo mugabana','Choisissez avec qui partager');
const sum=()=>`<div style="display:flex;justify-content:space-between;font-size:15px;padding:6px 0"><span class="mu">${L('Each person pays','Buri muntu yishyura','Chaque personne paie')}</span><b>${fmt(each())} RWF</b></div><div style="display:flex;justify-content:space-between;font-size:15px;padding:6px 0"><span class="mu">${L('You pay','Wishyura','Vous payez')}</span><b>${fmt(mine())} RWF</b></div>`;
const prow=n=>{const on=B().sel.includes(n);return `<div class="row tap" role="checkbox" aria-checked="${on}" tabindex="0" onclick="sbT('${n}')" style="padding-left:0;padding-right:0"><span style="width:44px;height:44px;border-radius:22px;background:var(--tint);color:var(--tintfg);display:flex;align-items:center;justify-content:center;font-weight:800;font-size:17px;flex:none">${esc(n)[0]}</span><div style="flex:1;margin-left:14px"><div class="t" style="font-size:16px">${esc(n)}</div></div><div class="ck ${on?'on':''}">${ic('check',18,on?'#17171C':'var(--tt)')}</div></div>`};
screens.splitpay=()=>`${bar(L('Split a bill','Gabana fagitire','Partager une addition'))}<div class="pad" style="padding-top:12px">
<div class="sm mu">${L('How much was the bill?','Fagitire yari angahe?','Combien était l’addition ?')}</div>
<div style="display:flex;align-items:baseline;gap:8px;margin-top:6px"><input id="sbA" inputmode="numeric" autocomplete="off" aria-label="${L('Bill amount in RWF','Amafaranga ya fagitire muri RWF','Montant en RWF')}" value="${B().amt?fmt(B().amt):''}" placeholder="0" oninput="sbI(this)" style="flex:1;min-width:0;border:0;outline:0;background:none;font:inherit;font-size:40px;font-weight:800;letter-spacing:-1px;color:var(--tx);padding:0"><b style="font-size:20px;color:var(--tt)">RWF</b></div>
<div id="sbM" class="sm" aria-live="polite" style="margin-top:6px;min-height:20px;color:${bad()?'var(--er)':'var(--tt)'}">${msg()}</div>
<div class="req" style="margin-top:14px">${[10000,30000,60000].map(x=>`<button onclick="sbQ(${x})">+${fmt(x)}</button>`).join('')}<button onclick="sbC()">${L('Clear','Siba','Effacer')}</button></div>
<style>#sbK::-webkit-scrollbar{display:none}</style><div class="req" id="sbK" style="margin:14px -24px 0;padding:0 24px;flex-wrap:nowrap;overflow-x:auto;scrollbar-width:none">${CATS.map(c=>`<button class="${B().cat===c[0]?'on':''}" onclick="sbCat('${c[0]}')" style="flex:0 0 auto;white-space:nowrap">${L(c[0],c[1],c[2])}</button>`).join('')}</div>
<div style="font-size:15px;font-weight:800;margin-top:28px">${L('Split with','Gabana na','Partager avec')}</div>
<div id="sbP" style="margin-top:4px">${PEOPLE.map(prow).join('')}</div>
<div id="sbS" style="margin-top:14px;padding:10px 16px;border-radius:16px;background:var(--chip)">${sum()}</div>
<div class="fine" style="margin-top:14px">${L('Sample contacts. No real requests are sent.','Abantu b’icyitegererezo. Nta busabe bwoherejwe.','Contacts d’exemple. Aucune demande réelle.')}</div></div>
<div style="height:110px"></div><div class="cta"><button class="btn" id="sbG" onclick="sbGo()" ${ok()?'':'disabled'}>${btn()}</button></div>`;
const sync=()=>{const m=document.getElementById('sbM'),s=document.getElementById('sbS'),g=document.getElementById('sbG');
 if(m){m.textContent=msg();m.style.color=bad()?'var(--er)':'var(--tt)'}
 if(s)s.innerHTML=sum();if(g){g.disabled=!ok();g.textContent=btn()}};
window.sbI=el=>{const n=Math.min(parseInt(el.value.replace(/\D/g,''),10)||0,99999999);B().amt=n;el.value=n?fmt(n):'';sync()};
window.sbQ=n=>{B().amt=Math.min((B().amt||0)+n,99999999);const i=document.getElementById('sbA');if(i)i.value=fmt(B().amt);sync()};
window.sbC=()=>{B().amt=0;const i=document.getElementById('sbA');if(i){i.value='';i.focus()}sync()};
window.sbCat=c=>{B().cat=B().cat===c?'':c;document.querySelectorAll('#sbK button').forEach((b,i)=>b.classList.toggle('on',CATS[i][0]===B().cat))};
window.sbT=n=>{const s=B().sel,i=s.indexOf(n);if(i>=0)s.splice(i,1);else s.push(n);const p=document.getElementById('sbP');if(p)p.innerHTML=PEOPLE.map(prow).join('');sync()};
window.sbGo=()=>{if(!ok())return;const e=each(),l=L('Split bill','Gabana fagitire','Addition partagée')+(B().cat?' · '+catName(B().cat):'');
 B().sel.forEach(n=>S.rqs.push({id:Date.now()+Math.floor(Math.random()*1e4),n,amt:e,l,paid:false}));
 const c=k();back();toast(c+' '+L(c===1?'request sent':'requests sent','ubusabe bwoherejwe','demande(s) envoyée(s)'))};
window.ppSplit=()=>{if(typeof closeSheet==='function')closeSheet();S.stack.push('splitpay');render('push')};
})();
</script>
<script>
/* v281: Receipts. (1) Activity detail is a full Receipt page: name, signed amount, status, detail card, tap-to-copy reference, Copy details and Share receipt in a fixed bottom bar, Report a problem link. (2) The merchant receipt's Share receipt now really shares. */
(()=>{
const L=(e,r,f)=>({en:e,rw:r||e,fr:f||e}[S.lang]||e);
const esc=s=>String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/"/g,'&quot;');
const strip=h=>String(h).replace(/<[^>]*>/g,'').replace(/&amp;/g,'&').replace(/&lt;/g,'<').replace(/&gt;/g,'>').replace(/&quot;/g,'"').trim();
const _ao=window.actOpen;
window.actOpen=function(i){const x=S.act[i];if(!x)return;
 _ao.call(this,i);const y=$('#layer');const h=y?y.innerHTML:'';if(y)y.innerHTML='';
 const rows=[...h.matchAll(/<span class="mu">([\s\S]*?)<\/span><b[^>]*>([\s\S]*?)<\/b>/g)].map(m=>[strip(m[1]),strip(m[2])]);
 S.ra={i,rows};S.stack.push('actrec');render('push')};
const text=()=>{const A=S.ra,x=S.act[A.i];return x[1]+' · '+signed(x[3])+A.rows.slice(1).map(r=>' · '+r[1]).join('')};
screens.actrec=()=>{const A=S.ra,x=A&&S.act[A.i];if(!x)return `${bar(L('Receipt','Fagitire','Reçu'))}`;
 const inn=x[3]>0,rows=A.rows,st=rows[0]?rows[0][1]:L('Completed','Byarangiye','Terminé'),det=rows.slice(1),last=det.length-1;
 const kv=(a,b,c)=>`<div class="px-kv" ${c?`role="button" tabindex="0" onclick="${c}" style="cursor:pointer"`:''}><span class="mu">${esc(a)}</span><b style="text-align:right">${esc(b)}${c?' ⧉':''}</b></div>`;
 return `${bar(L('Receipt','Fagitire','Reçu'))}<div style="display:flex;flex-direction:column;align-items:center;padding:12px 24px 24px;text-align:center"><div class="ico" style="width:64px;height:64px;border-radius:32px">${gx(x[0],34)}</div><div style="font-size:18px;font-weight:800;margin-top:12px">${esc(x[1])}</div><div class="big" style="font-size:36px;margin-top:6px;color:${inn?'var(--ok)':'var(--tx)'}">${signed(x[3])}</div><div style="margin-top:8px"><span class="px-st ok">${esc(st)}</span></div></div>
<div class="px-card">${det.map((r,j)=>kv(r[0],r[1],j===last?'rcpCopyRef()':'')).join('')}</div>
<div class="pad" style="padding-top:14px"><button class="tap" onclick="reportSheet()" style="border:0;background:none;color:var(--tt);font:inherit;font-size:15px;font-weight:700;min-height:44px;padding:0">${L('Report a problem','Menyesha ikibazo','Signaler un problème')}</button><div class="fine" style="padding-top:8px">${L('Sample data for this prototype.','Amakuru y’icyitegererezo.','Données d’exemple pour ce prototype.')}</div></div>
<div style="height:110px"></div><div class="cta" style="display:flex;gap:10px"><button class="btn sec2" onclick="rcpCopy()">${L('Copy details','Kopora amakuru','Copier les détails')}</button><button class="btn" onclick="rcpShare()">${L('Share receipt','Sangiza fagitire','Partager le reçu')}</button></div>`};
window.rcpCopyRef=()=>{const A=S.ra;if(!A||!A.rows.length)return;try{navigator.clipboard.writeText(A.rows[A.rows.length-1][1]).catch(()=>{})}catch(e){}toast(L('Reference copied','Nimero yakopowe','Référence copiée'))};
window.rcpCopy=()=>{try{navigator.clipboard.writeText(text()).catch(()=>{})}catch(e){}toast(L('Details copied','Amakuru yakopowe','Détails copiés'))};
window.rcpShare=()=>{if(navigator.share){navigator.share({text:text()}).catch(()=>{})}else{rcpCopy()}};
/* merchant receipt: real share */
const _pr=screens.payrcd;
screens.payrcd=()=>{const h=_pr();return h.replace(/onclick="toast\('[^']*'\)">(Share receipt|Sangiza fagitire|Partager le reçu)</,'onclick="pxShareRc()">$1<')};
window.pxShareRc=()=>{const q=s=>document.querySelector('#phone '+s),nm=q('.px-av')&&q('.px-av').nextElementSibling,am=q('.big');
 const kv=[...document.querySelectorAll('#phone .px-kv')].map(e=>e.textContent.replace(/\s*⧉\s*$/,'').replace(/\s+/g,' ').trim());
 const tx=[nm&&nm.textContent.trim(),am&&am.textContent.trim()].concat(kv).filter(Boolean).join(' · ');
 if(navigator.share){navigator.share({text:tx}).catch(()=>{})}else{try{navigator.clipboard.writeText(tx).catch(()=>{})}catch(e){}toast(L('Receipt copied','Fagitire yakopowe','Reçu copié'))}};
})();
</script>
<script>
/* v282: Open an account. Explore's "Open account" (and the My assets screen) open a chooser of what you can open, each with a one-line benefit and its status, instead of just landing on the Bank overview. */
(()=>{
const L=(e,r,f)=>({en:e,rw:r||e,fr:f||e}[S.lang]||e);
const stk=()=>typeof stkVal==='function'?stkVal():0;
const pk=()=>S.pk?S.pk.length:0;
const tag=on=>on?`<span class="px-st ok">${L('Active','Irakora','Actif')}</span>`:'';
const go=n=>`S.stack.push('${n}');render('push')`;
screens.openacc=()=>{
 const R=(i,t,s,on,fn)=>row(i,t,s,tag(on),fn);
 return `${bar(L('Open an account','Fungura konti','Ouvrir un compte'))}<div class="pad" style="padding-top:12px"><div class="mu" style="font-size:15px;line-height:22px">${L('Pick what you want to set up. You can open more than one.','Hitamo icyo ushaka gutangiza. Ushobora gufungura byinshi.','Choisissez ce que vous voulez ouvrir. Vous pouvez en ouvrir plusieurs.')}</div></div>
<div class="sec"><div class="sech">${L('Save','Kuzigama','Épargner')}</div>
${R('coin',L('Savings goal','Intego yo kuzigama','Objectif d’épargne'),L('Save toward something, with a target','Zigama ugamije intego','Épargnez pour un objectif'),!!S.goal,'openGoal()')}
${R('coin',L('Interest jar','Interest jar','Tirelire à intérêts'),'4.0% '+L('annual, withdraw any time','ku mwaka, ukuramo igihe cyose','par an, retrait à tout moment'),(S.jar||0)>0,go('jar'))}
${R('lock',L('12-month deposit','Ubwizigame bw’amezi 12','Dépôt 12 mois'),L('Lock money and earn more','Funga amafaranga winjize byinshi','Bloquez et gagnez plus'),!!S.dep,go('dep'))}
${R('wallet','Pockets',L('Separate money for trips, phone or anything','Gabanya amafaranga ku ngendo, telefoni cyangwa ikindi','Séparez l’argent : voyages, téléphone…'),pk()>0,'openPockets()')}</div>
<div class="sec"><div class="sech">${L('Invest','Gushora','Investir')}</div>
${R('trend','Rwanda Stock Exchange',L('Start with a sample portfolio','Tangira na portfolio y’icyitegererezo','Commencez avec un portefeuille d’exemple'),stk()>0,'openInvest()')}</div>
<div class="sec"><div class="sech">${L('Pay','Kwishyura','Payer')}</div>
${R('card','itunda card',L('Spend limits and one-tap freeze','Imbibi n’uburyo bwo guhagarika vuba','Plafonds et gel en un geste'),!!S.card,'openCard()')}</div>
<div class="pad fine" style="padding-top:18px">${L('Sample data for this prototype.','Amakuru y’icyitegererezo.','Données d’exemple pour ce prototype.')}</div>`};
window.openAcc=()=>{S.stack.push('openacc');render('push')};
/* entry points: Explore rows */
try{ASEC.forEach(g=>g[1].forEach(e=>{if(e[1]==='Open account')e[3]='openAcc()'}))}catch(e){}
try{ASHORT.forEach(e=>{if(e[0]==='Open account')e[2]='openAcc()'})}catch(e){}
/* entry point: My assets */
const _as=screens.assets;
screens.assets=()=>{const h=_as(),m='<div class="pad fine" style="padding-top:18px">';const i=h.lastIndexOf(m);if(i<0)return h;
 return h.slice(0,i)+`<div class="sec">${row('plus',L('Open an account','Fungura konti','Ouvrir un compte'),L('Savings, deposit, investments, card','Kuzigama, ubwizigame, imari, ikarita','Épargne, dépôt, investissements, carte'),'','openAcc()')}</div>`+h.slice(i)};
})();
</script>
<script>
/* v283: Daily transfer limit (Bank, Limits & alerts) on one screen. Used / left today with a progress bar, limit field with chips, alerts switch, Save limit in a fixed bottom bar. Nothing changes until you save. */
(()=>{
const L=(e,r,f)=>({en:e,rw:r||e,fr:f||e}[S.lang]||e);
const MIN=10000,UMAX=1000000,VMAX=5000000;
const isV=()=>S.vf&&S.vf.st==='verified';
const needV=()=>!isV()&&D().day>UMAX&&D().day<=VMAX;
S.lim=S.lim||{day:1000000,al:true};S.lim.used=S.lim.used||0;
const D=()=>S.lmd;
const valid=()=>D().day>=MIN&&D().day<=VMAX;
const dirty=()=>D().day!==S.lim.day||!!D().al!==!!S.lim.al;
const ok=()=>valid()&&dirty();
const left=()=>Math.max(0,S.lim.day-S.lim.used);
const pct=()=>Math.min(100,Math.round(S.lim.used/Math.max(S.lim.day,1)*100));
const msg=()=>D().day>VMAX?L('The highest daily limit is '+fmt(VMAX)+' RWF.','Imbibi ntarengwa ni '+fmt(VMAX)+' RWF.','Le plafond maximum est de '+fmt(VMAX)+' RWF.')
 :needV()?L('Limits above 1,000,000 RWF need a verified identity.','Imipaka irenga 1,000,000 RWF isaba indangamuntu yemejwe.','Les plafonds au-delà de 1 000 000 RWF exigent une identité vérifiée.')
 :D().day>0&&D().day<MIN?L('The lowest daily limit is '+fmt(MIN)+' RWF.','Imbibi ntoya ni '+fmt(MIN)+' RWF.','Le plafond minimum est de '+fmt(MIN)+' RWF.')
 :valid()&&D().day<S.lim.used?L('You have already sent '+fmt(S.lim.used)+' RWF today, so new transfers wait until tomorrow.','Wamaze kohereza '+fmt(S.lim.used)+' RWF uyu munsi, ibindi bizategereza ejo.','Vous avez déjà envoyé '+fmt(S.lim.used)+' RWF aujourd’hui : les nouveaux envois attendront demain.')
 :L('Between '+fmt(MIN)+' and '+fmt(isV()?VMAX:UMAX)+' RWF.','Hagati ya '+fmt(MIN)+' na '+fmt(isV()?VMAX:UMAX)+' RWF.','Entre '+fmt(MIN)+' et '+fmt(isV()?VMAX:UMAX)+' RWF.');
const bad=()=>D().day>VMAX||(D().day>0&&D().day<MIN);
const btn=()=>needV()?L('Verify to raise limit','Emeza kugira ngo wongere imipaka','Vérifier pour relever'):!valid()?L('Enter a limit','Andika imbibi','Saisissez un plafond'):!dirty()?L('No changes','Nta cyahindutse','Aucun changement'):L('Save limit','Bika imbibi','Enregistrer');
screens.bklimits=()=>`${bar(L('Limits & alerts','Imbibi n’imenyesha','Plafonds et alertes'))}<div class="pad" style="padding-top:12px">
<div style="padding:16px 18px;border-radius:20px;background:var(--chip)"><div class="sm mu">${L('Sent today','Wohereje uyu munsi','Envoyé aujourd’hui')}</div>
<div style="display:flex;justify-content:space-between;align-items:baseline;margin-top:4px"><b style="font-size:26px;letter-spacing:-.5px">${fmt(S.lim.used)} RWF</b><span class="sm mu">${L('of','kuri','sur')} ${fmt(S.lim.day)}</span></div>
<div role="progressbar" aria-valuemin="0" aria-valuemax="${S.lim.day}" aria-valuenow="${S.lim.used}" style="height:8px;border-radius:4px;background:var(--bg);margin-top:12px;overflow:hidden"><i style="display:block;height:8px;width:${pct()}%;border-radius:4px;background:${pct()>=90?'var(--er)':'var(--br)'}"></i></div>
<div class="sm mu" style="margin-top:10px">${L('Left today','Hasigaye uyu munsi','Reste aujourd’hui')}: <b style="color:var(--tx)">${fmt(left())} RWF</b></div></div>
<div class="sm mu" style="margin-top:28px">${L('Daily transfer limit','Imbibi bya buri munsi','Plafond quotidien')}</div>
<div style="display:flex;align-items:baseline;gap:8px;margin-top:6px"><input id="lmA" inputmode="numeric" autocomplete="off" aria-label="${L('Daily limit in RWF','Imbibi muri RWF','Plafond en RWF')}" value="${D().day?fmt(D().day):''}" placeholder="0" oninput="lmI(this)" style="flex:1;min-width:0;border:0;outline:0;background:none;font:inherit;font-size:40px;font-weight:800;letter-spacing:-1px;color:var(--tx);padding:0"><b style="font-size:20px;color:var(--tt)">RWF</b></div>
<div id="lmM" class="sm" aria-live="polite" style="margin-top:6px;min-height:20px;color:${bad()?'var(--er)':'var(--tt)'}">${msg()}</div>
<div class="req lim4" id="lmC" style="margin-top:14px">${[200000,500000,1000000,2000000].map(x=>`<button data-v="${x}" class="${D().day===x?'on':''}" onclick="lmQ(${x})">${fmt(x)}</button>`).join('')}</div>
<div class="row tap" role="switch" aria-checked="${!!D().al}" tabindex="0" id="lmS" style="margin-top:22px;padding-left:0;padding-right:0" onclick="lmT()"><div style="flex:1"><div class="t" style="font-size:16px">${L('Alerts for large transfers','Imenyesha ry’ihererekanya rinini','Alertes gros virements')}</div><div class="s">${L('Notify me above 100,000 RWF','Menyesha hejuru ya 100,000 RWF','Prévenir au-dessus de 100 000 RWF')}</div></div><div class="ck ${D().al?'on':''}" id="lmK">${ic('check',18,D().al?'#17171C':'var(--tt)')}</div></div></div>
<div style="height:110px"></div><div class="cta"><button class="btn" id="lmG" onclick="lmSave()" ${ok()?'':'disabled'}>${btn()}</button></div>`;
const sync=()=>{const m=document.getElementById('lmM'),g=document.getElementById('lmG'),k=document.getElementById('lmK'),s=document.getElementById('lmS');
 if(m){m.textContent=msg();m.style.color=bad()?'var(--er)':'var(--tt)'}
 if(g){g.disabled=!ok();g.textContent=btn()}
 if(k){k.classList.toggle('on',!!D().al);k.innerHTML=ic('check',18,D().al?'#17171C':'var(--tt)')}
 if(s)s.setAttribute('aria-checked',!!D().al);
 document.querySelectorAll('#lmC button').forEach(b=>b.classList.toggle('on',b.dataset.v==String(D().day)))};
window.lmI=el=>{const n=Math.min(parseInt(el.value.replace(/\D/g,''),10)||0,99999999);D().day=n;el.value=n?fmt(n):'';sync()};
window.lmQ=n=>{D().day=n;const i=document.getElementById('lmA');if(i)i.value=fmt(n);sync()};
window.lmT=()=>{D().al=!D().al;sync()};
window.lmSave=()=>{if(!ok())return;if(needV()){openSvc('verify');return}S.lim.day=D().day;S.lim.al=!!D().al;back();toast(L('Limit saved','Imbibi yabitswe','Plafond enregistré'))};
window.bkLim=()=>{S.lmd={day:S.lim.day,al:!!S.lim.al};S.stack.push('bklimits');render('push')};
})();

/* v284: Daily limits agree everywhere. One value (S.lim.day) now drives Bank > Limits & alerts, Settings > Send limits, Send settings and Profile (before: four separate numbers, Profile always said 2,000,000). Up to 1,000,000 RWF a day until you are verified, up to 5,000,000 after (same rule as Settings and Verify); on the limit screen a higher number turns the button into "Verify to raise limit". "Sent today" now resets each day and also counts money sent to friends, which is now checked against the limit (before only bank transfers were). The amount screen shows what is left today and opens the limit on tap. rw copy needs native review. */
(()=>{
const L=(e,r,f)=>({en:e,rw:r||e,fr:f||e}[S.lang]||e);
const dk=()=>new Date().toDateString();
{const X=S.lim;let u=X.used||0,d=dk();Object.defineProperty(X,'used',{get(){if(d!==dk()){d=dk();u=0}return u},set(v){d=dk();u=v},enumerable:true,configurable:true})}
const left=()=>Math.max(0,S.lim.day-S.lim.used);
{const f=window.finish;let t=0;window.finish=function(){const now=Date.now();if(now-t>4000){const v=Number(S.amt)||0;if(v>left()){closeSheet();toast(L('Over your daily limit. Left today: '+fmt(left())+' RWF.','Birenze imbibi bya none. Hasigaye: '+fmt(left())+' RWF.','Au-dessus de votre plafond. Reste aujourd’hui : '+fmt(left())+' RWF.'));return}S.lim.used+=v;t=now}return f.apply(this,arguments)}}
{const _a=screens.amount,k='<div id="msg"';screens.amount=()=>{const h=_a();return h.includes(k)?h.replace(k,`<div class="sm mu tap" role="button" tabindex="0" onclick="bkLim()" style="margin-top:8px;cursor:pointer">${L('Daily limit left','Hasigaye uyu munsi','Plafond restant')}: <b style="color:var(--tx)">${fmt(left())} RWF</b></div>`+k):h}}
})();
/* v285: Limit chips stay on one line. Bank > Limits & alerts (200,000 / 500,000 / 1,000,000 / 2,000,000) and Pay limits (per payment, per day) now show four equal chips in a single row instead of wrapping; 5,000,000 is no longer a chip on the Bank screen (type it once verified). */
/* v286: Upcoming bills. Top shows what is due in the next 7 days (amount and count). Bills are sorted by due date and grouped This week / Later / Paid, as flat rows (no grey cards). Removing a bill asks first. Adding a bill lets you pick the amount and when it is due (it was always 14 days, default amount). Add a bill is a fixed bottom button. rw copy needs native review. */
/* v287: Cash at an agent is a full screen (it was a pop-up sheet). Withdraw / Deposit switch, big amount field with a live message (fee 1%, at least 100 RWF; 1,000 to 500,000 RWF per code; not enough in Pay), four amount chips on one line, Pay balance, flat summary (you receive / fee / taken from Pay / balance after) that updates as you type, three short steps, and "Get code for 20,000 RWF" in a fixed bottom bar. An expired code no longer throws you back to the form; Done on the receipt returns to where you came from. rw copy needs native review. */
/* v288: Pay limits is a full screen (it was a pop-up sheet with two chip rows). "Paid today" with a bar and what is left, then Per payment and Per day, each a big field with a live message (10,000 minimum; up to 2,000,000 per payment and 5,000,000 a day; a payment can't be more than the daily limit; a daily limit below what you already paid says new payments wait until tomorrow) and four chips on one line. Nothing changes until you tap Save limits in the fixed bottom bar. The Pay hub row now says "500,000 per payment · 2,000,000 a day" instead of one unlabeled number. "Change limits" on the payment confirm opens the same screen. rw copy needs native review. */
/* v289: Pay limits, quieter. Per payment and Per day were two identical blocks (big field, helper line, chips) under a grey card. Now each is one line (name on the left, the amount you can type on the right) with the four chips under it; the helper line shows only when something is wrong (or when the daily limit is below what you already paid), and the ranges moved into the small print. The "Paid today" card is a flat line with a slim bar. */
/* v290: Pay limits has no chips. Per payment and Per day are each a label with one amount field (type the number); the message under it shows only when something is wrong. */
/* v291: New savings goal, step 1. Phone, Trip, Emergency fund and School fees now sit on one line (they wrapped onto two). The chips share the row; in Kinyarwanda and French, where the names are longer, the row scrolls sideways instead of wrapping. */

/* v292 Manage pocket */
{const t3=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e,CH=[50000,100000,250000,500000],MAXG=99999999;
const num=v=>Number(String(v||'').replace(/\D/g,''))||0;
const pk=()=>pkGet(S.pkId);
const mgErr=()=>{const G=S.mg,p=pk(),n=(G.n||'').trim();if(!n)return t3('Enter a name','Andika izina','Saisissez un nom');
if(S.pk.some(x=>x.id!==p.id&&x.n.toLowerCase()===n.toLowerCase()))return t3('You already have a pocket with that name','Usanzwe ufite agasanduku gafite iryo zina','Vous avez déjà une poche portant ce nom');return ''};
const mgDirty=()=>{const G=S.mg,p=pk();return (G.n||'').trim()!==p.n||(G.t||0)!==(p.t||0)};
const mgNote=()=>{const G=S.mg,p=pk(),b=pkBal(p),t=G.t||0;if(!t)return {h:'',w:0};const w=Math.min(100,Math.round(b/t*100));
return {h:b>=t?t3('Your balance has already reached this goal','Amafaranga ufite yamaze kugera kuri iyi ntego','Votre solde a déjà atteint cet objectif'):fmt(b)+' / '+fmt(t)+' RWF · '+w+'%',w}};
function mgUpd(){const G=S.mg,e=mgErr(),n=mgNote(),sv=$('#mgs');if(!sv)return;
$('#mge').textContent=(S.mgTouched&&e)?e:'';$('#pkn').setAttribute('aria-invalid',(S.mgTouched&&e)?'true':'false');
$('#mgn').textContent=n.h;$('#mgbar').style.width=n.w+'%';$('#mgbw').style.display=G.t?'block':'none';
document.querySelectorAll('#mgc button').forEach(b=>{const v=Number(b.dataset.v),on=v===(G.t||0);b.classList.toggle('on',on);b.setAttribute('aria-pressed',on?'true':'false')});
sv.disabled=!!e||!mgDirty()}
window.mgName=v=>{S.mg.n=v;S.mgTouched=true;mgUpd()};
window.mgGoal=v=>{const a=Math.min(MAXG,num(v));S.mg.t=a;const i=$('#mgt');i.value=a?fmt(a):'';mgUpd()};
window.mgChip=v=>{S.mg.t=v;$('#mgt').value=v?fmt(v):'';mgUpd()};
window.pkManage=function(){const p=pk();if(!p)return;
if(p.id==='jar'){$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" role="dialog" aria-modal="true" aria-label="${t3('Manage','Gucunga','Gérer')}"><div class="h1" style="font-size:22px;line-height:30px">${t3('Interest jar','Agasanduku k’inyungu','Tirelire à intérêts')}</div><div class="mu" style="font-size:15px;margin:8px 0 24px;line-height:22px">${t3("Put money aside and take it out any time. This pocket is always here, so it can't be renamed or deleted.",'Bika amafaranga kandi uyakuremo igihe cyose. Aka gasanduku guhoraho, ntigashobora guhindurirwa izina cyangwa gusibwa.','Mettez de l’argent de côté et retirez-le à tout moment. Cette poche est toujours là, elle ne peut pas être renommée ni supprimée.')}</div><button class="btn sec2" onclick="closeSheet()">${t3('Close','Funga','Fermer')}</button></div>`;return}
S.mg={n:p.n,t:p.t||0};S.mgTouched=false;mgDraw()};
window.mgDraw=function(){const p=pk(),b=pkBal(p),G=S.mg,n=mgNote();
$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet mgp" role="dialog" aria-modal="true" aria-label="${t3('Manage pocket','Gucunga agasanduku','Gérer la poche')}" style="max-height:92%;overflow-y:auto"><div class="h1" style="font-size:22px;line-height:30px">${t3('Manage pocket','Gucunga agasanduku','Gérer la poche')}</div>
<div class="mgsum">${pkIco(p,48)}<div style="min-width:0"><b>${esc48(p.n)}</b><span>${fmt(b)} RWF</span></div></div>
<label class="lab" for="pkn">${t3('Name','Izina','Nom')}</label><input class="in" id="pkn" maxlength="20" value="${esc48(G.n)}" autocomplete="off" aria-describedby="mge" aria-invalid="false" oninput="mgName(this.value)" onkeydown="if(event.key==='Enter'&&!$('#mgs').disabled)pkRename()"><div class="mge" id="mge" role="alert"></div>
<label class="lab" for="mgt" style="margin-top:12px">${t3('Savings goal (optional)','Intego yo kubika (si ngombwa)','Objectif d’épargne (facultatif)')}</label><div class="mgf"><input class="in" id="mgt" inputmode="numeric" placeholder="${t3('No goal','Nta ntego','Aucun objectif')}" value="${G.t?fmt(G.t):''}" oninput="mgGoal(this.value)" onkeydown="if(event.key==='Enter'&&!$('#mgs').disabled)pkRename()"><i>RWF</i></div>
<div class="pkauto" id="mgc" role="group" aria-label="${t3('Quick goals','Intego zihuse','Objectifs rapides')}"><button data-v="0" aria-pressed="${!G.t}" class="${G.t?'':'on'}" onclick="mgChip(0)">${t3('None','Nta ntego','Aucun')}</button>${CH.map(v=>`<button data-v="${v}" aria-pressed="${G.t===v}" class="${G.t===v?'on':''}" aria-label="${fmt(v)} RWF" onclick="mgChip(${v})">${v/1000}K</button>`).join('')}</div>
<div class="mgb" id="mgbw" style="display:${G.t?'block':'none'}"><i id="mgbar" style="width:${n.w}%"></i></div><div class="mgn" id="mgn">${n.h}</div>
<button class="btn" id="mgs" style="margin-top:20px" ${mgDirty()&&!mgErr()?'':'disabled'} onclick="pkRename()">${t3('Save changes','Bika impinduka','Enregistrer')}</button>
${b?`<div class="mgk">${t3('To delete this pocket, first take out the '+fmt(b)+' RWF.','Kugira ngo usibe aka gasanduku, banza ukuremo RWF '+fmt(b)+'.','Pour supprimer cette poche, retirez d’abord les '+fmt(b)+' RWF.')} <button onclick="closeSheet();openMv('out')">${t3('Take out','Kuramo','Retirer')}</button></div>`:`<button class="mgd" onclick="pkDelAsk()">${t3('Delete pocket','Siba agasanduku','Supprimer la poche')}</button>`}</div>`};
window.pkRename=function(){const p=pk(),G=S.mg;if(!p||!G)return;S.mgTouched=true;const e=mgErr();if(e){mgUpd();return}
p.n=G.n.trim().slice(0,20);if(G.t)p.t=G.t;else delete p.t;closeSheet();render('fade-none');toast(t3('Changes saved','Impinduka zabitswe','Modifications enregistrées'))};
window.pkDelAsk=function(){const p=pk();if(!p||p.id==='jar'||pkBal(p))return;
$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" role="dialog" aria-modal="true" aria-label="${t3('Delete pocket','Siba agasanduku','Supprimer la poche')}"><div class="h1" style="font-size:22px;line-height:30px">${t3('Delete','Gusiba','Supprimer')} ${esc48(p.n)}?</div><div class="mu" style="font-size:15px;line-height:22px;margin:8px 0 24px">${t3("This pocket and its history will be removed. This can't be undone.",'Aka gasanduku n’amateka yako bizasibwa. Ntibishobora gusubizwaho.','Cette poche et son historique seront supprimés. Cette action est irréversible.')}</div><div class="row2"><button class="btn sec2" onclick="pkManage()">${t3('Cancel','Hagarika','Annuler')}</button><button class="btn mgdel" onclick="pkDelete()">${t3('Delete','Siba','Supprimer')}</button></div></div>`};
window.pkDelete=function(){const p=pk();if(!p||p.id==='jar'||pkBal(p))return;S.pk=S.pk.filter(x=>x.id!==p.id);closeSheet();S.stack.pop();render('pop');toast(t3('Pocket deleted','Agasanduku gasibwe','Poche supprimée'))};
}
/* v292: Manage pocket. Before: a pop-up with a name field and five goal chips, a Delete button beside Save that was greyed out with a small line when the pocket had money, and no check before deleting. Now: the pocket's icon, name and balance at the top; a Name field with the error shown under it as you type (empty, or a name you already use); a Savings goal field where you type any amount (RWF, thousands separators) or tap 50,000 / 100,000 / 250,000 / 500,000 / None, with a slim bar and "120,000 / 300,000 RWF · 40%" under it; one full-width "Save changes" that stays off until something changed and is valid (Enter saves too). Delete is a quiet red line at the bottom; it asks "Delete School fees?" with Cancel / Delete before anything is removed. A pocket that still has money shows "To delete this pocket, first take out the X RWF" with a Take out link that opens the take-out screen. The Interest jar sheet is unchanged apart from language. English, French and Kinyarwanda; fr is new copy and rw is new copy that needs native review, especially "Siba agasanduku" and "Bika impinduka". */

/* v293 itunda card */
{const t3=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e,LIMS=[[100000,'100K'],[250000,'250K'],[500000,'500K'],[1000000,'1M']];
const sw3=(on,fn,l)=>`<div class="sw ${on?'on':''}" role="switch" aria-checked="${!!on}" aria-label="${esc48(l)}" tabindex="0" onclick="${fn}"><i></i></div>`;
const dt3=d=>d.toLocaleDateString(({en:'en-GB',fr:'fr-FR',rw:'en-GB'})[S.lang]||'en-GB',{day:'numeric',month:'long',year:'numeric'});
const cdPays=()=>S.act.filter(x=>x[3]<0&&x[5]&&!['send','cyc','up'].includes(x[0]));
const cdUsed=()=>{const d=new Date().toDateString();return cdPays().reduce((a,x)=>new Date(x[5]).toDateString()===d?a-x[3]:a,0)};
const cdRecent=()=>{const l=cdPays().slice(0,3),dl=ms=>new Date(ms).toLocaleDateString(({en:'en-GB',fr:'fr-FR',rw:'en-GB'})[S.lang]||'en-GB',{day:'numeric',month:'short'});
return `<div class="pad" style="padding-top:26px;padding-bottom:4px"><div class="cdh">${t3('Recent card payments','Ibyishyuwe vuba n’ikarita','Paiements récents par carte')}</div></div><div class="pad" style="padding-top:4px;padding-bottom:0">${l.length?l.map(x=>`<div class="bdr" role="button" tabindex="0" onclick="actOpen(${S.act.indexOf(x)})" style="padding-left:0;padding-right:0"><div class="ico">${gx(x[0],26)}</div><div style="min-width:0"><div class="t">${esc48(x[1])}</div><div class="s">${dl(x[5])}</div></div><div class="pkv"><b>${fmt(-x[3])} RWF</b></div></div>`).join(''):`<div class="mu" style="font-size:15px;line-height:22px;padding:8px 0">${t3('No card payments yet. They will show here.','Nta kwishyura n’ikarita kurakorwa. Bizagaragara hano.','Aucun paiement par carte. Ils apparaîtront ici.')}</div>`}</div>`};
screens.card=()=>{const c=S.card,cc=S.cc,rp=cc.repl,fz=c.frozen,f=FIN[S.finish]||FIN.Indigo,nm=S.name||'Amina Uwase';
const act=(i,l,fn)=>`<button class="ppa" onclick="${fn}"><i>${ic(i,22)}</i>${l}</button>`;
const tg=(k,l,sub)=>`<div class="r95"><div style="flex:1"><div style="font-size:16px;font-weight:700">${l}</div><div class="sm mu">${sub}</div></div>${sw3(cc[k],`ccTg('${k}')`,l)}</div>`;
const face=`<div id="cv" class="cv cdf ${fz?'frozen':''}" role="button" tabindex="0" aria-label="${t3('Show card details','Erekana amakuru y’ikarita','Afficher les détails de la carte')}" onclick="ccShow(0)" onkeydown="if(event.key==='Enter')ccShow(0)" style="margin:24px 24px 0;height:200px;border-radius:28px;background:${f.bg};color:${f.fg};padding:22px;position:relative;box-shadow:none"><div style="display:flex;justify-content:space-between;align-items:flex-start">${knot(44,f.fg)}<span id="cst" style="font-size:13px;font-weight:800;background:rgba(127,127,127,.22);padding:6px 12px;border-radius:14px">${fz?t('c_frz'):t('c_act')}</span></div><div style="position:absolute;left:22px;right:22px;bottom:20px"><div style="display:flex;justify-content:space-between;align-items:baseline;gap:12px;opacity:.85"><span style="min-width:0;font-size:12px;font-weight:800;letter-spacing:1.2px;text-transform:uppercase;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${esc48(nm)}</span><span style="flex:none;font-size:13px;font-weight:700;white-space:nowrap">10/29</span></div><div style="font-size:18px;font-weight:800;letter-spacing:1px;margin-top:6px;white-space:nowrap">•••• •••• •••• ${c.last}</div></div><div class="lk">${gl('lock',64)}</div></div><div class="cdcap">${t3('Spends from your itunda balance. Tap the card for its details.','Ikoresha amafaranga ya itunda yawe. Kanda ku ikarita urebe amakuru yayo.','Dépense depuis votre solde itunda. Touchez la carte pour ses détails.')}</div>`;
const banner=rp?`<div class="ban95"><b>${t3('Card blocked','Ikarita yahagaritswe','Carte bloquée')}</b><br>${t3('Your new card will be ready at ','Ikarita yawe nshya izaba iri kuri ','Votre nouvelle carte sera prête à ')}${esc48(rp.b)} · ${dt3(new Date(rp.eta))}.</div><div class="pad" style="padding-top:12px"><button class="btn" style="margin-top:10px" onclick="ccGot()">${t3('I collected my new card','Mfashe ikarita yanjye nshya','J’ai retiré ma nouvelle carte')}</button></div>`
:`${fz?`<div class="ban95"><b>${t3('Card frozen','Ikarita yahagaritswe by’agateganyo','Carte gelée')}</b><br>${t3('Payments, ATM and online are paused. Unfreeze when you are ready.','Kwishyura, ATM no kuri interineti byarahagaze. Yongere uyikoreshe igihe wiyumvira.','Paiements, DAB et achats en ligne sont suspendus. Dégelez quand vous voulez.')}<br><button class="chip" style="margin-top:10px;background:var(--bg);color:var(--er)" onclick="ccLost()">${t3('Lost or stolen?','Yabuze cyangwa yibwe?','Perdue ou volée ?')}</button></div>`:''}<div class="pad" style="display:flex;gap:8px;padding-top:18px">${act('lock',t3('Details','Amakuru','Détails'),'ccShow(0)')}${act('shield',fz?t3('Unfreeze','Kuvanaho','Dégeler'):t3('Freeze','Hagarika','Geler'),'ccFreeze()')}${act('gear','PIN','ccPin()')}</div>`;
const used=cdUsed(),pc=Math.min(100,Math.round(used/cc.lim*100));
return `${bar(t('c_title'))}${face}${banner}
<div class="pad" style="padding-top:22px;padding-bottom:8px"><div class="cdh">${t3('Controls','Igenzura','Contrôles')}</div></div><div class="cc95 ${fz||rp?'cdoff':''}">${tg('online',t3('Online payments','Kwishyura kuri interineti','Paiements en ligne'),t3('Shops and apps','Amaduka na porogaramu','Boutiques et applications'))}${tg('intl',t3('International use','Gukoresha mu mahanga','Utilisation à l’étranger'),t3('Pay and withdraw abroad','Kwishyura no gukuramo hanze','Payer et retirer à l’étranger'))}${tg('tap',t3('Contactless','Gukoza ikarita','Sans contact'),t3('Tap to pay in shops','Kwishyura ukoza','Payer en approchant'))}${tg('atm',t3('ATM withdrawals','Gukuramo kuri ATM','Retraits DAB'),t3('Cash from machines','Amafaranga kuri mashini','Espèces aux distributeurs'))}</div>
<div class="pad" style="padding-top:26px"><div class="cdh">${t3('Daily spending limit','Imbibi y’amafaranga ya buri munsi','Plafond de dépense quotidien')}</div><div class="sm mu" style="margin-top:4px">${fmt(used)} ${t3('of','kuri','sur')} ${fmt(cc.lim)} RWF ${t3('used today','yakoreshejwe uyu munsi','utilisés aujourd’hui')}</div><div class="cdbar" role="progressbar" aria-valuenow="${pc}" aria-valuemin="0" aria-valuemax="100"><i style="width:${pc}%;${pc>=80?'background:var(--er)':''}"></i></div><div class="cdch" role="group">${LIMS.map(([v,l])=>`<button class="${cc.lim===v?'on':''}" aria-pressed="${cc.lim===v}" aria-label="${fmt(v)} RWF" onclick="ccLim(${v})">${l}</button>`).join('')}</div></div>
${cdRecent()}<div class="pad" style="padding-top:26px;padding-bottom:8px"><div class="cdh">${t3('Online card','Ikarita yo kuri interineti','Carte en ligne')}</div></div><div class="pad" style="padding-top:0;padding-bottom:0">${cc.virt?`<div class="cc95" style="margin:0"><div class="r95"><div style="flex:1"><div style="font-size:16px;font-weight:700">•••• ${cc.virt.pan.slice(-4)}</div><div class="sm mu">${t3('Separate number for online shopping','Nimero yihariye yo kugura kuri interineti','Numéro séparé pour les achats en ligne')}</div></div><button class="chip" onclick="ccShow(1)">${t3('Show','Erekana','Afficher')}</button><button class="chip" aria-label="${t3('Delete','Siba','Supprimer')}" onclick="ccVirtDel()">${ic('plus',16).replace('<svg','<svg style="transform:rotate(45deg)"')}</button></div></div>`:row('card',t3('Create an online card','Kora ikarita yo kuri interineti','Créer une carte en ligne'),t3('A separate number for online shopping. Delete it any time.','Nimero yihariye yo kugura kuri interineti. Ushobora kuyisiba igihe cyose.','Un numéro séparé pour les achats en ligne. Supprimable à tout moment.'),'','ccVirtNew()')}</div>
<div class="pad" style="padding-top:26px;padding-bottom:0"><div class="cdh">${t3('Need help?','Ukeneye ubufasha?','Besoin d’aide ?')}</div></div><div class="pad" style="padding-top:6px">${row('warning3d',t3('Report lost or stolen','Menyesha ko yabuze cyangwa yibwe','Signaler perdue ou volée'),'','','ccLost()')}${row('receipt',t3('Close card','Funga ikarita','Fermer la carte'),'','','ccClose()')}</div><div class="pad fine" style="padding-top:14px;padding-bottom:28px">${t('c_disc')}</div>`};
}
/* v293: itunda card. Before: a plain card (itunda card, last four digits, "Bank"), three actions where "Show details" wrapped onto two lines, the four daily-limit chips wrapped onto a second row, the "Create an online card" row ran into the screen edge, and a frozen card looked the same as an active one apart from a small label. Now: the card shows your name, •••• •••• •••• 4417 and the expiry, with the status (Active / Frozen) at the top right, and tapping it opens the details (PIN first, as before); a line under it says it spends from your itunda balance. Actions are Details, Freeze and PIN on one line each. A frozen card shows a banner ("Payments, ATM and online are paused") and its controls are dimmed until you unfreeze; a blocked card keeps its "collect your new card" banner and also dims the controls. The daily limit has a slim bar under "0 of 500,000 RWF used today" and the four chips (100K, 250K, 500K, 1M) share one line. The online card row is padded like the rest, and Report lost or stolen / Close card sit under a "Need help?" heading. English, French and Kinyarwanda; fr is new copy and rw is new copy that needs native review, especially "Ikarita yahagaritswe by’agateganyo" and "Yongere uyikoreshe igihe wiyumvira". */

/* v294 Manage account */
{const t3=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e;
window.bkManage=()=>{S.stack.push('bkmanage');render('push')};
window.bkMgShare=()=>toast(t3('Details shared (sample)','Amakuru yasangijwe (icyitegererezo)','Détails partagés (exemple)'));
window.bkMgCard=()=>{S.stack.push(S.card?'card':'nocard');render('push')};
window.bkMgSch=()=>{S.stack.push('bksch');render('push')};
window.bkMgAuto=()=>{S.stack.push('autot');render('push')};
screens.bkmanage=()=>{const nm=S.name||'Amina Uwase',ir=S.pk.reduce((a,p)=>a+(p.ir||0),0),ns=(S.bsc||[]).filter(x=>!x.done).length,dl=S.lim&&S.lim.day?S.lim.day:0;
const sec=(h,rows)=>`<div class="sec"><div class="sech">${h}</div>${rows.join('')}</div>`;
return `${bar(t3('Manage account','Gucunga konti','Gérer le compte'))}
<div style="margin:16px 24px 0;padding:18px;border-radius:20px;background:var(--chip)"><div class="sm mu">itunda Bank</div><div style="font-size:20px;font-weight:800;margin-top:4px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${esc48(nm)}</div><div style="font-size:16px;font-weight:700;letter-spacing:1px;margin-top:2px;color:var(--mu)">${ACC50}</div><div style="display:flex;gap:8px;margin-top:14px"><button class="chip tap" style="background:var(--bg)" onclick="bkCopy()">${t3('Copy number','Koporora nimero','Copier le numéro')}</button><button class="chip tap" style="background:var(--bg)" onclick="bkMgShare()">${t3('Share','Sangiza','Partager')}</button></div></div>
${sec(t3('Account','Konti','Compte'),[row('bank',t3('Account details','Amakuru ya konti','Détails du compte'),t3('Holder, number, bank, branch','Nyir’konti, nimero, banki, ishami','Titulaire, numéro, banque, agence'),'','bkAcct()'),row('bolt',t3('Interest','Inyungu','Intérêts'),t3('4.0% a year (sample)','4.0% ku mwaka (icyitegererezo)','4,0 % par an (exemple)'),'<b style="font-size:15px;margin-right:6px">'+fmt(ir)+' RWF</b>','intSheet()')])}
${sec(t3('Money','Amafaranga','Argent'),[row('lock',t3('Limits & alerts','Imbibi n’imenyesha','Plafonds et alertes'),dl?t3('Daily limit ','Imbibi ya buri munsi ','Plafond ')+fmt(dl)+' RWF':'','','bkLim()'),row('cal',t3('Scheduled transfers','Kohereza byateganyijwe','Virements programmés'),ns?ns+' '+t3('scheduled','byateganyijwe','programmé'+(ns>1?'s':'')):t3('Rent, fees, monthly gifts','Ubukode, ishuri, impano','Loyer, frais, cadeaux'),'','bkMgSch()'),row('coin',t3('Auto-transfer','Kohereza byikora','Virement automatique'),t3('Move money on its own','Imura amafaranga byikora','Déplacer l’argent automatiquement'),'','bkMgAuto()')])}
${sec(t3('Documents','Inyandiko','Documents'),[row('bill',t3('Statement','Raporo','Relevé'),t3('Pick a period, CSV or PDF','Hitamo igihe, CSV cyangwa PDF','Choisissez une période, CSV ou PDF'),'','bkStmt()'),row('receipt',t3('Documents & letters','Inyandiko n’amabaruwa','Documents et lettres'),t3('Account letter, proof of balance','Ibaruwa ya konti, icyemezo cy’amafaranga','Lettre de compte, attestation de solde'),'','bkDocs()')])}
${sec(t3('Card','Ikarita','Carte'),[row('card',t3('Card','Ikarita','Carte'),S.card?'•••• '+S.card.last+(S.card.frozen?' · '+t('c_frz'):''):t3('Get your itunda card','Fata ikarita yawe ya itunda','Obtenez votre carte itunda'),'','bkMgCard()')])}
<div class="pad fine" style="padding-top:14px;padding-bottom:28px">${t3('Sample data for this prototype.','Amakuru y’icyitegererezo.','Données d’exemple pour ce prototype.')}</div>`};
}
/* v294: Manage account. Before: a small pop-up with three lines (account number, account name showing "You", interest) and two buttons of different heights (Close, Copy number); nothing in it could be managed. Now Manage opens a page: your name and account number with Copy number and Share; then Account (Account details, Interest with what you have earned), Money (Limits & alerts with your daily transfer limit, Scheduled transfers with how many are set, Auto-transfer), Documents (Statement, Documents & letters) and Card (last four digits, or Get your itunda card). Each row opens the screen that already does the job. The account name now matches the rest of the app (Amina Uwase) instead of "You". English, French and Kinyarwanda; fr is new copy and rw is new copy that needs native review, especially "Gucunga konti" and "Kohereza byikora". */

/* v295 Foreign currency */
{const t3=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e,CODES=['USD','EUR','GBP'],FLAG={USD:'🇺🇸',EUR:'🇪🇺',GBP:'🇬🇧'},RATE={USD:1445,EUR:1680,GBP:1960},MINB=5000,QB=[20000,50000,100000,250000];
const fx=()=>{const x=S.fx;if(!x.d)x.d='buy';if(x.s==null)x.s=0;if(!x.w)x.w={USD:0,EUR:0,GBP:0};return x};
const cur=()=>CODES[fx().c]||'USD',d2=n=>(Math.floor(n*100+1e-6)/100).toFixed(2);
const buy=()=>fx().d==='buy';
const calc=()=>{const x=fx(),c=cur(),r=RATE[c],w=x.w[c]||0;let err='',ok=false,pay,get;
if(buy()){pay=x.a;get=x.a/r;if(!x.a)err='';else if(x.a<MINB)err=t3('Minimum is '+fmt(MINB)+' RWF','Nibura ni RWF '+fmt(MINB),'Minimum : '+fmt(MINB)+' RWF');else if(x.a>S.bank)err=t3('Not enough balance. You have '+fmt(S.bank)+' RWF.','Nta mafaranga ahagije. Ufite RWF '+fmt(S.bank)+'.','Solde insuffisant. Vous avez '+fmt(S.bank)+' RWF.');else ok=true}
else{pay=x.s;get=Math.round(x.s*r);if(!x.s)err='';else if(x.s<1)err=t3('Minimum is 1.00 '+c,'Nibura ni '+c+' 1.00','Minimum : 1,00 '+c);else if(x.s>w+1e-9)err=t3('Not enough in your '+c+' wallet. You have '+d2(w)+' '+c+'.','Nta mafaranga ahagije muri '+c+'. Ufite '+d2(w)+' '+c+'.','Solde insuffisant. Vous avez '+d2(w)+' '+c+'.');else ok=true}
return {c,r,w,err,ok,pay,get}};
const quick=()=>buy()?QB.map(n=>[n,n/1000+'K',fx().a===n]):[[.25,'25%'],[.5,'50%'],[1,t3('All','Byose','Tout')]].map(([p,l])=>[p,l,Math.abs(fx().s-Math.floor((fx().w[cur()]||0)*p*100)/100)<.005&&fx().s>0]);
const lbl=k=>buy()?(k.ok?t3('Convert '+fmt(k.pay)+' RWF to '+k.c,'Hindura RWF '+fmt(k.pay)+' mu '+k.c,'Convertir '+fmt(k.pay)+' RWF en '+k.c):t3('Convert to '+k.c,'Hindura mu '+k.c,'Convertir en '+k.c)):(k.ok?t3('Convert '+d2(k.pay)+' '+k.c+' to RWF','Hindura '+k.c+' '+d2(k.pay)+' mu RWF','Convertir '+d2(k.pay)+' '+k.c+' en RWF'):t3('Convert to RWF','Hindura mu RWF','Convertir en RWF'));
function fxUpd(){const k=calc(),x=fx(),g=$('#fxg'),e=$('#fxe'),n=$('#fxn'),b=$('#fxb');if(!g)return;
g.innerHTML=(buy()?(k.pay?d2(k.get)+' '+k.c:'0.00 '+k.c):(k.pay?fmt(k.get)+' RWF':'0 RWF'));
e.textContent=k.err;$('#fxi').setAttribute('aria-invalid',k.err?'true':'false');
n.textContent=buy()?(k.ok?t3('itunda Bank after: '+fmt(S.bank-k.pay)+' RWF','itunda Bank nyuma: RWF '+fmt(S.bank-k.pay),'itunda Bank après : '+fmt(S.bank-k.pay)+' RWF'):''):(k.ok?t3('itunda Bank after: '+fmt(S.bank+k.get)+' RWF','itunda Bank nyuma: RWF '+fmt(S.bank+k.get),'itunda Bank après : '+fmt(S.bank+k.get)+' RWF'):'');
b.disabled=!k.ok;b.textContent=lbl(k);
document.querySelectorAll('#fxq button').forEach((el,i)=>{const on=quick()[i][2];el.classList.toggle('on',on);el.setAttribute('aria-pressed',on?'true':'false')})}
window.fxIn=v=>{const x=fx();if(buy()){x.a=Math.min(999999999,Number(String(v).replace(/\D/g,''))||0);const i=$('#fxi');i.value=x.a?fmt(x.a):''}else{let q=String(v).replace(/[^\d.]/g,'');const p=q.split('.');q=p[0]+(p.length>1?'.'+p[1].slice(0,2):'');x.s=Number(q)||0;if(q!==String(v))$('#fxi').value=q}fxUpd()};
window.fxQ=i=>{const x=fx(),v=quick()[i][0];if(buy()){x.a=v}else{x.s=Math.floor((x.w[cur()]||0)*v*100)/100}fxDraw()};
window.fxCur=i=>{fx().c=i;fx().s=0;fxDraw()};
window.fxDir=d=>{const x=fx();x.d=d;x.s=0;fxDraw()};
window.fxWal=i=>{const x=fx();x.c=i;x.d=(x.w[CODES[i]]||0)>0?'sell':'buy';x.s=0;fxDraw();const sc=$('#phone .screen');if(sc)sc.scrollTop=0};
function fxDraw(){render('fade-none')}
screens.fx=()=>{const x=fx(),k=calc(),c=k.c,b=buy();
const flagc=CODES.map((cc,i)=>`<button class="${x.c===i?'on':''}" aria-pressed="${x.c===i}" onclick="fxCur(${i})">${FLAG[cc]} ${cc}</button>`).join('');
const seg=`<div class="cdch" style="margin:16px 24px 0" role="group"><button class="${b?'on':''}" aria-pressed="${b}" onclick="fxDir('buy')">${t3('Buy '+c,'Gura '+c,'Acheter '+c)}</button><button class="${b?'':'on'}" aria-pressed="${!b}" onclick="fxDir('sell')">${t3('Sell '+c,'Gurisha '+c,'Vendre '+c)}</button></div>`;
const av=b?t3('Available: '+fmt(S.bank)+' RWF','Ahari: RWF '+fmt(S.bank),'Disponible : '+fmt(S.bank)+' RWF'):t3('In your wallet: '+d2(k.w)+' '+c,'Muri wallet: '+d2(k.w)+' '+c,'Dans votre portefeuille : '+d2(k.w)+' '+c);
const q=quick();
const wal=CODES.map((cc,i)=>{const w=x.w[cc]||0;return `<button class="fxw" onclick="fxWal(${i})"><span class="fxf">${FLAG[cc]}</span><span class="nm"><b>${cc}</b><span>${w>0?t3('Tap to sell','Kanda ugurishe','Touchez pour vendre'):t3('Tap to buy','Kanda ugure','Touchez pour acheter')}</span></span><span class="am"><b>${d2(w)} ${cc}</b><span>≈ ${fmt(Math.round(w*RATE[cc]))} RWF</span></span></button>`}).join('');
return `${bar(t3('Foreign currency','Amafaranga y’amahanga','Devises'))}<div class="fxc" role="group" aria-label="${t3('Currency','Ifaranga','Devise')}">${flagc}</div>${seg}
<div class="fxa"><label class="sm mu" for="fxi">${b?t3('You pay','Wishyura','Vous payez'):t3('You sell','Ugurisha','Vous vendez')}</label><div class="fxr"><input class="in" id="fxi" inputmode="${b?'numeric':'decimal'}" autocomplete="off" placeholder="0" value="${b?(x.a?fmt(x.a):''):(x.s?String(x.s):'')}" oninput="fxIn(this.value)" aria-describedby="fxe" aria-invalid="${!!k.err}"><b>${b?'RWF':c}</b></div><div class="sm mu" style="margin-top:2px">${av}</div></div>
<div class="cdch" id="fxq" style="margin:10px 24px 0" role="group" aria-label="${t3('Quick amounts','Umubare uhuse','Montants rapides')}">${q.map(([v,l,on],i)=>`<button class="${on?'on':''}" aria-pressed="${on}" onclick="fxQ(${i})">${l}</button>`).join('')}</div><div class="fxe" id="fxe" role="alert">${k.err}</div>
<div class="fxg"><div class="sm">${t3('You get','Uhabwa','Vous recevez')}</div><b id="fxg">${b?(k.pay?d2(k.get)+' '+c:'0.00 '+c):(k.pay?fmt(k.get)+' RWF':'0 RWF')}</b></div>
<div class="sm mu" style="padding:12px 24px 0">1 ${c} = ${fmt(k.r)} RWF · ${t3('No fee','Nta kiguzi','Sans frais')} · ${t3('Sample rate, updated just now','Igiciro cy’icyitegererezo, kigezweho','Taux d’exemple, à l’instant')}</div><div class="sm mu" id="fxn" style="padding:4px 24px 0">${k.ok?(b?t3('itunda Bank after: '+fmt(S.bank-k.pay)+' RWF','itunda Bank nyuma: RWF '+fmt(S.bank-k.pay),'itunda Bank après : '+fmt(S.bank-k.pay)+' RWF'):t3('itunda Bank after: '+fmt(S.bank+k.get)+' RWF','itunda Bank nyuma: RWF '+fmt(S.bank+k.get),'itunda Bank après : '+fmt(S.bank+k.get)+' RWF')):''}</div>
<div style="padding:22px 24px 4px;font-size:18px;font-weight:800">${t3('Your wallets','Ama wallet yawe','Vos portefeuilles')}</div>${wal}<div style="height:110px"></div>
<div class="cta"><button class="btn" id="fxb" ${k.ok?'':'disabled'} onclick="fxAsk()">${lbl(k)}</button></div>`};
const rw=(a,v)=>`<div style="display:flex;justify-content:space-between;gap:12px;min-height:40px;align-items:center;font-size:15px"><span class="mu">${a}</span><b style="text-align:right">${v}</b></div>`;
window.fxAsk=()=>{const k=calc();if(!k.ok)return;const c=k.c,b=buy();
const rows=b?rw(t3('You pay','Wishyura','Vous payez'),fmt(k.pay)+' RWF')+rw(t3('You get','Uhabwa','Vous recevez'),d2(k.get)+' '+c)+rw(t3('Rate','Igiciro','Taux'),'1 '+c+' = '+fmt(k.r)+' RWF')+rw(t3('Fee','Kiguzi','Frais'),t3('None','Nta kiguzi','Aucun'))+rw(t3('itunda Bank after','itunda Bank nyuma','itunda Bank après'),fmt(S.bank-k.pay)+' RWF')
:rw(t3('You sell','Ugurisha','Vous vendez'),d2(k.pay)+' '+c)+rw(t3('You get','Uhabwa','Vous recevez'),fmt(k.get)+' RWF')+rw(t3('Rate','Igiciro','Taux'),'1 '+c+' = '+fmt(k.r)+' RWF')+rw(t3('Fee','Kiguzi','Frais'),t3('None','Nta kiguzi','Aucun'))+rw(t3('Goes to','Bijya muri','Versé sur'),'itunda Bank');
$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" role="dialog" aria-modal="true" aria-label="${t3('Review','Suzuma','Vérifier')}"><div class="h1" style="font-size:22px;line-height:30px;margin-top:4px">${b?t3('Convert to '+c+'?','Guhindura mu '+c+'?','Convertir en '+c+' ?'):t3('Sell '+d2(k.pay)+' '+c+'?','Gurisha '+d2(k.pay)+' '+c+'?','Vendre '+d2(k.pay)+' '+c+' ?')}</div><div style="margin:12px 0 20px">${rows}</div><div class="row2" style="display:grid;grid-template-columns:1fr 1.8fr"><button class="btn sec2" onclick="closeSheet()">${t3('Cancel','Reka','Annuler')}</button><button class="btn" style="white-space:nowrap" onclick="fxDo()">${b?t3('Convert','Hindura','Convertir'):t3('Sell','Gurisha','Vendre')}</button></div></div>`;if(typeof focusSheet==='function')focusSheet()};
window.fxDo=()=>{const k=calc();if(!k.ok){closeSheet();return}const x=fx(),c=k.c,b=buy();let tt,bd;
if(b){S.bank-=k.pay;x.w[c]=(x.w[c]||0)+k.pay/k.r;addAct('cyc','Converted to '+c,'Converted',-k.pay,'Moved');tt=t3('Converted to '+c,'Byahinduwe mu '+c,'Converti en '+c);bd=t3(fmt(k.pay)+' RWF became '+d2(k.get)+' '+c+'. It is in your '+c+' wallet.','RWF '+fmt(k.pay)+' yabaye '+d2(k.get)+' '+c+'. Iri muri wallet yawe ya '+c+'.',fmt(k.pay)+' RWF sont devenus '+d2(k.get)+' '+c+'. Ils sont dans votre portefeuille '+c+'.');x.a=50000}
else{x.w[c]=Math.max(0,(x.w[c]||0)-k.pay);if(x.w[c]<.005)x.w[c]=0;S.bank+=k.get;addAct('cyc',c+' converted to RWF','Converted',k.get,'Moved');tt=t3(c+' converted to RWF',c+' yahindutse RWF',c+' converti en RWF');bd=t3(d2(k.pay)+' '+c+' became '+fmt(k.get)+' RWF in itunda Bank.',d2(k.pay)+' '+c+' yabaye RWF '+fmt(k.get)+' muri itunda Bank.',d2(k.pay)+' '+c+' sont devenus '+fmt(k.get)+' RWF sur itunda Bank.');x.s=0;x.d=(x.w[c]||0)>0?'sell':'buy'}
$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" role="dialog" aria-modal="true" aria-label="${esc48(tt)}"><div style="font-size:56px;line-height:1;margin-bottom:10px">💱</div><div class="h1" style="font-size:22px;line-height:30px">${esc48(tt)}</div><div class="mu" style="font-size:15px;margin:8px 0 24px;line-height:22px">${esc48(bd)}</div><button class="btn" onclick="closeSheet();render('fade-none')">OK</button></div>`;if(typeof focusSheet==='function')focusSheet();render('fade-none')};
}
/* v295: Foreign currency. Before: pick USD / EUR / GBP, change the amount with − and + (10,000 a tap) or four shortcut chips, one big "Convert" button; selling back was a small button that only appeared inside a wallet row and moved the whole balance; wallets were plain lines; the new copy (review sheet, shortcuts) was English only. Now: one screen with Buy and Sell tabs for the chosen currency. You type the amount (thousands separators for RWF, two decimals for a currency) or tap 20K / 50K / 100K / 250K (or 25% / 50% / All when selling); the line under the field shows what you have available, mistakes show in red under the amount (minimum, not enough balance), and "You get" updates as you type. The button names the amount ("Convert 50,000 RWF to USD") and opens a review sheet (you pay, you get, rate, fee, balance after); a result sheet confirms it. Selling can be part of a wallet, not only all of it. "Your wallets" shows each balance with its RWF value, and tapping one opens it ready to sell (or to buy when it is empty). Both directions still appear in Activity. English, French and Kinyarwanda; fr is new copy and rw is new copy that needs native review, especially "Gurisha", "Wishyura" and "Amafaranga y’amahanga". */
/* v296 Spending */
{const t3=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e;
const esc48=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const CAT={Food:['restaurant','#6960F9',['Ibyokurya','Alimentation'],'Food'],Shopping:['bag','#E8590C',['Guhaha','Achats'],'Shopping'],Transport:['transit','#0A8F5B',['Ingendo','Transport'],'Transport'],Bills:['bill','#C28A00',['Fagitire','Factures'],'Bills'],Other:['wallet','#8B95A1',['Ibindi','Autres'],'Other']};
const DATA=[
{Food:[128000,[['Simba Supermarket',34500,'Oct 17'],['Inka Kitchen',18200,'Oct 15'],['Eats delivery',12800,'Oct 12']]],Shopping:[61000,[['Kimironko Market',27000,'Oct 16'],['Shop order',21000,'Oct 9']]],Transport:[54000,[['Moto rides',31000,'Oct 18'],['Bus top-up',12000,'Oct 11']]],Bills:[43000,[['MTN airtime & data',15000,'Oct 14'],['Canal+',12000,'Oct 5']]],Other:[26000,[['Pharmacy',14500,'Oct 13'],['Salon',8000,'Oct 6']]]},
{Food:[141000,[['Simba Supermarket',41000,'Sep 26'],['Inka Kitchen',22400,'Sep 19'],['Eats delivery',15600,'Sep 11']]],Shopping:[48000,[['Kimironko Market',24000,'Sep 21'],['Shop order',14000,'Sep 8']]],Transport:[52000,[['Moto rides',30000,'Sep 24'],['Bus top-up',12000,'Sep 10']]],Bills:[43000,[['MTN airtime & data',15000,'Sep 14'],['Canal+',12000,'Sep 5']]],Other:[19000,[['Pharmacy',11000,'Sep 17'],['Salon',6000,'Sep 4']]]}];
const nm=k=>S.lang==='rw'?CAT[k][2][0]:S.lang==='fr'?CAT[k][2][1]:CAT[k][3];
const ord=m=>Object.keys(DATA[m]).sort((a,b)=>DATA[m][b][0]-DATA[m][a][0]);
const tot=m=>Object.values(DATA[m]).reduce((a,x)=>a+x[0],0);
window.spMon=i=>{S.spm=i;S.spx=null;render('fade-none')};
window.spOpen=k=>{S.spx=S.spx===k?null:k;render('fade-none')};
window.spBud=()=>{S.stack.push('bkbud');render('push')};
screens.spend=()=>{const m=S.spm===1?1:0,o=1-m,d=DATA[m],T=tot(m),P=tot(o),df=T-P,pct=Math.round(Math.abs(df)*100/P),ks=ord(m),top=ks[0],tp=Math.round(d[top][0]*100/T);
const days=m===0?Math.max(1,new Date().getDate()):30,avg=Math.round(T/days),B=S.bbg&&S.bbg.lim?S.bbg.lim:0;
const mon=[t3('This month','Uku kwezi','Ce mois-ci'),t3('Last month','Ukwezi gushize','Mois dernier')];
const delta=m===0?`<div class="sm" style="margin-top:6px;font-weight:700;color:${df>0?'var(--er)':'var(--ok)'}">${df>0?'▲ ':'▼ '}${fmt(Math.abs(df))} RWF (${pct}%) ${t3(df>0?'more than last month':'less than last month',df>0?'kurusha ukwezi gushize':'kuri munsi y’ukwezi gushize',df>0?'de plus que le mois dernier':'de moins que le mois dernier')}</div>`:'';
const stack=`<div role="img" aria-label="${ks.map(k=>nm(k)+' '+Math.round(d[k][0]*100/T)+'%').join(', ')}" style="display:flex;gap:3px;height:14px;margin-top:18px">${ks.map(k=>`<div style="flex:${d[k][0]};background:${CAT[k][1]};border-radius:4px;min-width:6px"></div>`).join('')}</div>`;
const budget=m===0?(B?`<div style="margin:20px 24px 0;padding:16px 18px;border-radius:18px;background:var(--chip)"><div style="display:flex;justify-content:space-between;gap:12px;font-size:15px"><b>${t3('Monthly budget','Ingengo y’ukwezi','Budget mensuel')}</b><span class="mu">${fmt(T)} / ${fmt(B)} RWF</span></div><div style="height:8px;border-radius:4px;background:var(--bg);margin-top:10px;overflow:hidden"><div style="height:100%;width:${Math.min(100,Math.round(T*100/B))}%;background:${T>B?'var(--er)':'var(--lk)'}"></div></div><div class="sm" style="margin-top:8px;font-weight:700;color:${T>B?'var(--er)':'var(--mu)'}">${T>B?t3('Over by ','Warengeje ','Dépassé de ')+fmt(T-B)+' RWF':fmt(B-T)+' RWF '+t3('left','busigaye','restants')}</div></div>`:`<button class="row tap" onclick="spBud()" style="margin:20px 24px 0;width:calc(100% - 48px);padding:16px 18px;border:0;border-radius:18px;background:var(--tint);color:var(--tintfg);font:inherit;text-align:left;min-height:56px"><span style="flex:1;font-weight:800">${t3('Set a monthly budget','Shyiraho ingengo y’ukwezi','Fixer un budget mensuel')}</span>${ic('chev',16,'var(--tintfg)')}</button>`):'';
const rows=ks.map(k=>{const v=d[k][0],dv=m===0?v-DATA[o][k][0]:0;
return `<button class="row tap" onclick="spCat('${k}')" style="width:100%;border:0;background:none;font:inherit;color:inherit;text-align:left;padding:12px 0;min-height:68px"><div class="ico" style="box-shadow:inset 0 0 0 2px ${CAT[k][1]}">${gl(CAT[k][0],30)}</div><div style="flex:1;min-width:0"><div style="display:flex;justify-content:space-between;gap:12px"><div class="t">${nm(k)}</div><b style="white-space:nowrap">${fmt(v)} RWF</b></div><div style="display:flex;justify-content:space-between;gap:8px;margin-top:4px" class="sm"><span class="mu">${Math.round(v*100/T)}% ${t('y_ps')}</span>${dv?`<span style="font-weight:700;color:${dv>0?'var(--er)':'var(--ok)'}">${dv>0?'▲':'▼'} ${fmt(Math.abs(dv))}</span>`:''}</div></div>${ic('chev',16,'var(--tt)')}</button>`}).join('');
return `${bar(t('y_sp'))}<div class="seg" role="tablist">${mon.map((l,i)=>`<button role="tab" aria-selected="${m===i}" class="${m===i?'on':''}" onclick="spMon(${i})">${l}</button>`).join('')}</div>
<div class="pad" style="padding-top:22px"><div class="sm mu">${m===0?t3('Spent this month','Wakoresheje uku kwezi','Dépensé ce mois-ci'):t3('Spent last month','Wakoresheje ukwezi gushize','Dépensé le mois dernier')}</div><div class="big">${fmt(T)} RWF</div>${delta}<div class="sm mu" style="margin-top:6px">${t3('About '+fmt(avg)+' RWF a day','Hafi ya RWF '+fmt(avg)+' ku munsi','Environ '+fmt(avg)+' RWF par jour')}</div>${stack}</div>
${budget}
<div class="sec" style="padding-top:26px"><div class="sech">${t3('By category','Ukurikije ibyiciro','Par catégorie')}</div>${rows}</div>
<div class="pad fine" style="padding-top:12px;padding-bottom:28px">${t('y_sd')}</div>`};
window.spCat=k=>{S.spk=k;S.stack.push('spcat');render('push')};
screens.spcat=()=>{const m=S.spm===1?1:0,o=1-m,k=DATA[m][S.spk]?S.spk:'Food',d=DATA[m][k],v=d[0],T=tot(m),dv=m===0?v-DATA[o][k][0]:0,rest=v-d[1].reduce((a,x)=>a+x[1],0);
const R=(n,sub,a,mu)=>`<div style="display:flex;justify-content:space-between;align-items:center;gap:12px;padding:12px 0;min-height:56px"><span style="min-width:0"><span style="display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;${mu?'color:var(--mu)':''}">${n}</span>${sub?`<span class="sm mu">${sub}</span>`:''}</span><b style="white-space:nowrap">${fmt(a)} RWF</b></div>`;
return `${bar(nm(k))}<div class="pad" style="padding-top:22px"><div class="sm mu">${m===0?t3('This month','Uku kwezi','Ce mois-ci'):t3('Last month','Ukwezi gushize','Mois dernier')}</div><div class="big">${fmt(v)} RWF</div><div class="sm mu" style="margin-top:6px">${Math.round(v*100/T)}% ${t('y_ps')}</div>${dv?`<div class="sm" style="margin-top:4px;font-weight:700;color:${dv>0?'var(--er)':'var(--ok)'}">${dv>0?'▲ ':'▼ '}${fmt(Math.abs(dv))} RWF ${t3(dv>0?'more than last month':'less than last month',dv>0?'kurusha ukwezi gushize':'kuri munsi y’ukwezi gushize',dv>0?'de plus que le mois dernier':'de moins que le mois dernier')}</div>`:''}</div>
<div class="sec" style="padding-top:26px"><div class="sech">${t3('Payments','Ibyishyuwe','Paiements')}</div>${d[1].map(([n,a,dt])=>R(esc48(n),dt,a)).join('')}${rest>0?R(t3('Smaller payments','Ibyishyuwe bito','Petits paiements'),'',rest,1):''}</div>
<div class="pad fine" style="padding-top:12px;padding-bottom:28px">${t('y_sd')}</div>`};
}
/* v296: Spending. Before: two tabs and a list of five bars; nothing to tap; the screen shared the state key S.sp with Split expenses, so opening Spending after Split could break it. Now: this/last month, total with the change in RWF and %, one stacked bar of all categories, spend per day and biggest category, the monthly budget (or a link to set one), and each category with its change vs last month that opens to show its biggest payments. Own state (S.spm). English, French and Kinyarwanda; fr/rw new copy needs native review. Sample data. */
/* v297 Points */
{const t3=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e,MIN=1000;
const fm=n=>fmt(Math.round(n)),esc48=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])),hd=t=>`<div class="mh" style="padding-bottom:0"><button class="ib" aria-label="Back" onclick="back()">${ic('back',24)}</button><b style="flex:1;font-size:19px;margin-left:6px">${esc48(t)}</b></div>`,addPh=(e,t,x)=>{S.ph=S.ph||[];S.ph.unshift([e,t,x,'Just now'])};
const lay2=h=>{$('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet">'+h+'</div>'};
const dg=v=>String(v||'').replace(/\D/g,'').slice(0,9);
const st=()=>{if(S.rd3==null)S.rd3=Math.min(MIN,S.pts)>=MIN?MIN:0;return S.rd3};
const chk=()=>{const a=st();let err='';if(S.pts<MIN)err=t3('You need at least 1,000 points to redeem.','Ukeneye nibura amanota 1,000 kugira ngo uyahindure.','Il faut au moins 1 000 points pour échanger.');else if(!a)err='';else if(a<MIN)err=t3('Minimum is 1,000 points','Nibura ni amanota 1,000','Minimum : 1 000 points');else if(a>S.pts)err=t3('You have '+fm(S.pts)+' points','Ufite amanota '+fm(S.pts),'Vous avez '+fm(S.pts)+' points');return {a,err,ok:a>=MIN&&a<=S.pts}};
const lbl=k=>k.ok?t3('Redeem '+fm(k.a)+' points','Hindura amanota '+fm(k.a),'Échanger '+fm(k.a)+' points'):t3('Redeem to Pay money','Hindura mu Pay money','Échanger vers Pay money');
window.ptsUpd=()=>{const k=chk(),e=$('#ptE'),g=$('#ptG'),b=$('#ptB'),i=$('#ptI');if(!e)return;e.textContent=k.err;g.textContent=k.ok?t3('You get '+fm(k.a)+' RWF in Pay money','Wakira RWF '+fm(k.a)+' muri Pay money','Vous recevez '+fm(k.a)+' RWF dans Pay money'):'';b.textContent=lbl(k);b.disabled=!k.ok;if(i)i.setAttribute('aria-invalid',k.err?'true':'false')};
window.ptsType=el=>{const v=dg(el.value);S.rd3=v?Number(v):0;el.value=v?fmt(v):'';ptsUpd();document.querySelectorAll('#ptQ button').forEach(b=>b.classList.toggle('on',Number(b.dataset.v)===S.rd3))};
window.ptsQ=n=>{S.rd3=Math.min(n,S.pts);const i=$('#ptI');if(i)i.value=fmt(S.rd3);ptsUpd();document.querySelectorAll('#ptQ button').forEach(b=>b.classList.toggle('on',Number(b.dataset.v)===S.rd3))};
window.ptsMore=()=>{S.pta=!S.pta;render('fade-none')};
window.ptsGo=k=>{S.stack.push(k);render('push')};
window.ptsReview=()=>{const k=chk();if(!k.ok)return;const R=(a,b)=>`<div style="display:flex;justify-content:space-between;gap:12px;min-height:40px;align-items:center;font-size:15px"><span class="mu">${a}</span><b style="text-align:right">${b}</b></div>`;
lay2(`<div class="h1" style="font-size:22px;line-height:30px">${t3('Redeem '+fm(k.a)+' points?','Guhindura amanota '+fm(k.a)+'?','Échanger '+fm(k.a)+' points ?')}</div><div style="margin:14px 0 18px">${R(t3('You redeem','Uhindura','Vous échangez'),fm(k.a)+' '+t3('points','amanota','points'))}${R(t3('You get','Wakira','Vous recevez'),fm(k.a)+' RWF')}${R(t3('Points after','Amanota asigaye','Points restants'),fm(S.pts-k.a))}${R(t3('Pay money after','Pay money nyuma','Pay money après'),fm(S.pay+k.a)+' RWF')}</div><button class="btn" onclick="ptsRedeem()">${t3('Redeem','Hindura','Échanger')}</button><button class="btn sec2" style="margin-top:10px" onclick="closeSheet()">${t3('Cancel','Hagarika','Annuler')}</button>`)};
window.ptsRedeem=()=>{const k=chk();if(!k.ok){closeSheet();return}const a=k.a;S.pts-=a;S.pay+=a;addPh('💸',t3('Redeemed to Pay money','Byahinduwe mu Pay money','Échangé vers Pay money'),'-'+fm(a));S.rd3=S.pts>=MIN?MIN:0;
lay2(`<div class="g3" style="font-size:56px;line-height:1;margin-bottom:10px">✅</div><div class="h1" style="font-size:22px;line-height:30px">${t3('Redeemed','Byahinduwe','Échangé')}</div><div class="mu" style="font-size:15px;margin:8px 0 24px;line-height:22px">${t3(fm(a)+' points added to your Pay money. New balance '+fm(S.pay)+' RWF.','Amanota '+fm(a)+' yongewe muri Pay money. Asigaye ni RWF '+fm(S.pay)+'.',fm(a)+' points ajoutés à votre Pay money. Nouveau solde : '+fm(S.pay)+' RWF.')}</div><button class="btn" onclick="closeSheet()">OK</button>`);render('fade-none')};
const row=(e,t,s,r,on)=>`<button class="row tap" onclick="${on}" style="width:100%;border:0;background:none;font:inherit;color:inherit;text-align:left;padding:12px 24px;min-height:60px"><div class="ico" style="font-size:20px">${e}</div><div style="flex:1;min-width:0"><div class="t">${t}</div><div class="s">${s}</div></div>${r?`<span class="sm" style="font-weight:700;color:var(--ok);white-space:nowrap">${r}</span>`:''}${ic('chev',16,'var(--tt)')}</button>`;
screens.pts=()=>{const k=chk(),a=st(),dc=S.dc||{claimed:{}},left=[0,1,2].filter(i=>!dc.claimed[i]).length,nc=S.cp.filter(c=>!c[5]).length,of=S.of||{},qs=[1000,2000,5000].filter(n=>n<S.pts),all=S.pts>=MIN?S.pts:0;
const ph=S.ph||[],shown=S.pta?ph:ph.slice(0,4);
return `${hd(t3('Points','Amanota','Points'))}<div style="padding:22px 24px 0"><div class="sm mu">${t3('Your points','Amanota yawe','Vos points')}</div><div class="big">${fm(S.pts)}</div><div class="mu" style="font-size:14px;margin-top:4px">${t3('Worth '+fm(S.pts)+' RWF · 1 point = 1 RWF in Pay money','Afite agaciro ka RWF '+fm(S.pts)+' · ukwezi 1 = RWF 1 muri Pay money','Vaut '+fm(S.pts)+' RWF · 1 point = 1 RWF dans Pay money')}</div></div>
<div style="margin:22px 24px 0;padding:16px;border-radius:20px;background:var(--chip)"><label for="ptI" class="sm mu">${t3('Points to redeem','Amanota yo guhindura','Points à échanger')}</label><input id="ptI" inputmode="numeric" autocomplete="off" value="${a?fmt(a):''}" placeholder="0" oninput="ptsType(this)" ${S.pts<MIN?'disabled':''} style="display:block;width:100%;box-sizing:border-box;margin-top:6px;border:0;border-bottom:2px solid var(--ln);background:none;color:var(--tx);font:inherit;font-size:26px;font-weight:800;padding:6px 0;outline:0;border-radius:0"><div id="ptE" class="sm" role="alert" style="min-height:20px;margin-top:6px;color:var(--er);font-weight:700">${k.err}</div><div id="ptG" class="sm" style="min-height:20px;font-weight:700">${k.ok?t3('You get '+fm(k.a)+' RWF in Pay money','Wakira RWF '+fm(k.a)+' muri Pay money','Vous recevez '+fm(k.a)+' RWF dans Pay money'):''}</div>${S.pts>=MIN?`<div id="ptQ" class="req" style="margin-top:10px;flex-wrap:wrap">${qs.map(n=>`<button data-v="${n}" class="${a===n?'on':''}" onclick="ptsQ(${n})">${fmt(n)}</button>`).join('')}<button data-v="${all}" class="${a===all?'on':''}" onclick="ptsQ(${all})">${t3('All','Byose','Tout')}</button></div>`:''}</div>
<div class="agt">${t3('Ways to earn','Uko wabona amanota','Gagner des points')}</div>
${row('🔥',t3('Daily challenge','Ikibazo cya buri munsi','Défi du jour'),left?t3(left+' of 3 tasks left · +100 bonus',left+' kuri 3 isigaye · +100',left+' tâches sur 3 restantes · +100 bonus'):t3('Done for today','Byarangiye uyu munsi','Terminé pour aujourd’hui'),'',"ptsGo('challenge')")}
${row('🥐','Kigali Bakery',t3('5% back when you pay with QR','5% asubizwa wishyuye na QR','5 % remboursés en payant par QR'),of.bakery?t3('On','Birakora','Activé'):'',"ofOpen('bakery')")}
${row('🚌',t3('Kigali bus fares','Amatike ya bisi ya Kigali','Trajets de bus Kigali'),t3('1 point per 100 RWF of fare','Ukwezi 1 kuri RWF 100','1 point par 100 RWF de trajet'),of.bus?t3('On','Birakora','Activé'):'',"ofOpen('bus')")}
${row('💳',t3('Card cashback','Cashback y’ikarita','Cashback carte'),t3('1% back on every card purchase','1% kuri buri kugura n’ikarita','1 % de cashback sur chaque achat'),'',"ptsGo('cashback')")}
${row('🎟️',t3('Your coupons','Kuponi zawe','Vos coupons'),nc?t3(nc+' ready to use',nc+' ziteguye',nc+' prêt'+(nc>1?'s':'')+' à utiliser'):t3('None right now','Nta kuponi ubu','Aucun pour l’instant'),'',"ptsGo('coupons')")}
<div class="agt">${t3('Recent activity','Ibyakozwe vuba','Activité récente')}</div>${shown.length?shown.map(x=>`<div class="row" style="padding:11px 24px;min-height:56px"><div class="ico" style="font-size:20px">${x[0]}</div><div style="flex:1;min-width:0"><div class="t" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${esc48(x[1])}</div><div class="s">${esc48(x[3])}</div></div><b style="white-space:nowrap;color:${String(x[2]).startsWith('-')?'inherit':'var(--ok)'}">${esc48(String(x[2]).replace('-','−'))}</b></div>`).join(''):`<div class="pad mu" style="padding-top:8px;font-size:15px">${t3('No points activity yet.','Nta bikorwa by’amanota.','Pas encore d’activité.')}</div>`}${ph.length>4?`<div class="pad" style="padding-top:6px"><button class="chip" onclick="ptsMore()" aria-expanded="${!!S.pta}">${S.pta?t3('Show less','Erekana bike','Voir moins'):t3('See all ('+ph.length+')','Reba byose ('+ph.length+')','Tout voir ('+ph.length+')')}</button></div>`:''}
<div style="height:100px"></div><div class="cta"><button id="ptB" class="btn" ${k.ok?'':'disabled'} onclick="ptsReview()">${lbl(k)}</button></div>`};
}
/* v297: Points. Before: the amount could only move in 1,000 steps with − and +, redeeming happened at once with no review, nothing said what you would get, the only other things on the page were three lines of history, and it was English only. Now: your points with what they are worth; a field where you type any amount (1,000 minimum) with shortcuts 1,000 / 2,000 / 5,000 / All, errors in red under it and a line saying what you get; a button that names the amount, a review sheet (points after, Pay money after) and a result; "Ways to earn" linking to Daily challenge (tasks left), the two offers (on/off), Card cashback and Coupons; recent activity with + in green, first four with See all. Own state (S.rd3). English, French and Kinyarwanda; fr/rw new copy needs native review. */
/* v343: Auto top-up, calmer. Before: a balance bar card, a tinted status card, a text field with chips under each amount, radio buttons with a tinted card on the chosen account, and a summary card at the bottom. Now: the sentence at the top says what will happen; Refill when below / Add this much / Monthly limit are plain rows with the value on the right, and tapping one opens a check list (Other amount lets you type); Take it from is a check list with a plain check on the right of the chosen account, no radio and no card; the SMS switch, recent refills and the review sheet are unchanged. */
/* v298 Auto top-up */
{const t3=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e;
const fm=n=>fmt(Math.round(n)),esc48=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const TH=[5000,10000,20000,50000],AM=[10000,20000,50000],CAPS=[100000,300000,500000,0],LO=1000,HI=200000,AMIN=5000;
const SRCN=['MTN MoMo ••0788','Airtel Money ••0732','itunda Bank'];
S.atuSB=S.atuSB||[85000,40000];S.atuH=S.atuH||[];
const base=o=>Object.assign({on:false,th:10000,amt:20000,o:0,cap:300000,sms:true,used:0},o||{});
S.atu=base(S.atu);
const D=()=>S.atuD=S.atuD?base(S.atuD):base(S.atu);
const SB=()=>[S.atuSB[0],S.atuSB[1],S.bank||0];
const sent=d=>t3('When your itunda Pay balance drops below '+fm(d.th)+' RWF, we add '+fm(d.amt)+' RWF from '+SRCN[d.o]+'.'+(d.cap?' Up to '+fm(d.cap)+' RWF a month.':''),'Iyo itunda Pay iri munsi ya RWF '+fm(d.th)+', twongeraho RWF '+fm(d.amt)+' dukuye kuri '+SRCN[d.o]+'.'+(d.cap?' Kugeza kuri RWF '+fm(d.cap)+' ku kwezi.':''),'Quand votre solde itunda Pay passe sous '+fm(d.th)+' RWF, nous ajoutons '+fm(d.amt)+' RWF depuis '+SRCN[d.o]+'.'+(d.cap?' Jusqu’à '+fm(d.cap)+' RWF par mois.':''));
const chk=d=>{const e={};
if(!d.th)e.th='';else if(d.th<LO)e.th=t3('Minimum is '+fm(LO)+' RWF','Nibura ni RWF '+fm(LO),'Minimum : '+fm(LO)+' RWF');else if(d.th>HI)e.th=t3('Maximum is '+fm(HI)+' RWF','Ntarenza RWF '+fm(HI),'Maximum : '+fm(HI)+' RWF');
if(!d.amt)e.amt='';else if(d.amt<AMIN)e.amt=t3('Minimum is '+fm(AMIN)+' RWF','Nibura ni RWF '+fm(AMIN),'Minimum : '+fm(AMIN)+' RWF');else if(d.amt>HI)e.amt=t3('Maximum is '+fm(HI)+' RWF','Ntarenza RWF '+fm(HI),'Maximum : '+fm(HI)+' RWF');
if(d.cap&&d.amt&&d.cap<d.amt)e.cap=t3('The monthly limit must cover at least one refill ('+fm(d.amt)+' RWF)','Imbibi y’ukwezi igomba kwishyura nibura rimwe (RWF '+fm(d.amt)+')','Le plafond mensuel doit couvrir au moins une recharge ('+fm(d.amt)+' RWF)');
e.ok=d.th>=LO&&d.th<=HI&&d.amt>=AMIN&&d.amt<=HI&&!e.cap;
e.warn=e.ok&&SB()[d.o]<d.amt?t3(SRCN[d.o]+' has '+fm(SB()[d.o])+' RWF, less than one refill. We would skip it until it has enough.',SRCN[d.o]+' ifite RWF '+fm(SB()[d.o])+', munsi y’iyo twongeraho. Ntitwakongera kugeza ibonye ihagije.',SRCN[d.o]+' contient '+fm(SB()[d.o])+' RWF, moins qu’une recharge. Elle serait ignorée tant que le solde est insuffisant.'):'';
return e};
const CKS='<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>',CHV='<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--tt)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>';
const PRE={th:TH,amt:AM,cap:CAPS},g48=id=>document.getElementById(id);
const lbl=(f,v)=>f==='cap'&&!v?t3('No limit','Nta mbibi','Sans plafond'):fm(v)+' RWF';
const TT=f=>f==='th'?t3('Refill when below','Uzuza iri munsi ya','Recharger sous'):f==='amt'?t3('Add this much','Ongeraho aya mafaranga','Montant ajouté'):t3('Monthly limit','Imbibi y’ukwezi','Plafond mensuel');
/* a check-list row: label on the left, a plain check on the right when chosen. No radio, no card, no tint. */
const ckRow=(sel,fn,t,s,role)=>`<div class="row tap" role="${role||'checkbox'}" aria-checked="${sel}" tabindex="0" onclick="${fn}" style="padding:14px 24px"><div style="flex:1;min-width:0"><div class="t" style="font-weight:${sel?800:600}">${t}</div>${s?`<div class="s">${s}</div>`:''}</div><span style="color:var(--lk);width:24px;height:24px;display:flex;flex:none">${sel?CKS:''}</span></div>`;
const valRow=(f,v)=>`<div class="row tap" role="button" tabindex="0" onclick="atuOpen('${f}')" style="padding:14px 24px"><div class="t" style="flex:1">${TT(f)}</div><b style="color:var(--lk);font-size:16px">${lbl(f,v)}</b>${CHV}</div>`;
const R=(a,v)=>`<div style="display:flex;justify-content:space-between;gap:12px;min-height:40px;align-items:center;font-size:15px"><span class="mu">${a}</span><b style="text-align:right">${v}</b></div>`;
const lay2=h=>{$('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet">'+h+'</div>';if(typeof focusSheet==='function')focusSheet()};
const cta=(d,k)=>{const a=S.atu,dirty=d.th!==a.th||d.amt!==a.amt||d.o!==a.o||d.cap!==a.cap||d.sms!==a.sms;return a.on?`<div class="cta"><div style="display:grid;grid-template-columns:1fr 1.6fr;gap:12px"><button class="btn sec2" onclick="atuOff()">${t3('Turn off','Zimya','Désactiver')}</button><button id="atuB" class="btn" ${dirty&&k.ok?'':'disabled'} onclick="atuReview()">${t3('Save changes','Bika impinduka','Enregistrer')}</button></div></div>`:`<div class="cta"><button id="atuB" class="btn" ${k.ok?'':'disabled'} onclick="atuReview()">${t3('Turn on auto top-up','Tangiza kuzuza byikora','Activer la recharge automatique')}</button></div>`};
window.atuOpen=f=>{const d=D(),cu=f!=='cap'&&!PRE[f].includes(d[f]);
lay2(`<div class="h1" style="font-size:22px;line-height:30px;margin:4px 0 8px">${TT(f)}</div><div style="margin:0 -24px">${PRE[f].map(v=>ckRow(d[f]===v,`atuPick('${f}',${v})`,lbl(f,v))).join('')}${f==='cap'?'':ckRow(cu,`atuOther('${f}')`,t3('Other amount','Andi mafaranga','Autre montant'),cu?fm(d[f])+' RWF':'')}</div>`)};
window.atuPick=(f,v)=>{D()[f]=v;closeSheet();render('fade-none')};
window.atuOther=f=>{const d=D(),v=PRE[f].includes(d[f])?0:d[f];
lay2(`<div class="h1" style="font-size:22px;line-height:30px;margin:4px 0 8px">${TT(f)}</div><div style="display:flex;align-items:baseline;gap:8px;border-bottom:2px solid var(--ln);margin-top:12px"><input id="atuOI" inputmode="numeric" autocomplete="off" placeholder="0" value="${v?fmt(v):''}" oninput="atuOT('${f}',this)" style="flex:1;min-width:0;border:0;background:none;color:var(--tx);font:inherit;font-size:24px;font-weight:800;padding:6px 0;outline:0;border-radius:0"><span class="mu" style="font-weight:700">RWF</span></div><div id="atuOE" role="alert" class="sm" style="min-height:20px;margin:6px 0 16px;color:var(--er);font-weight:700"></div><button id="atuOB" class="btn" ${v?'':'disabled'} onclick="atuOD('${f}')">${t3('Done','Byarangiye','Terminé')}</button>`);
setTimeout(()=>{const i=g48('atuOI');if(i)i.focus()},60)};
window.atuOT=(f,el)=>{const v=el.value.replace(/\D/g,'').slice(0,7),n=v?Number(v):0,mn=f==='th'?LO:AMIN;el.value=v?fmt(v):'';
const e=!n?'':n<mn?t3('Minimum is '+fm(mn)+' RWF','Nibura ni RWF '+fm(mn),'Minimum : '+fm(mn)+' RWF'):n>HI?t3('Maximum is '+fm(HI)+' RWF','Ntarenza RWF '+fm(HI),'Maximum : '+fm(HI)+' RWF'):'';
g48('atuOE').textContent=e;g48('atuOB').disabled=!n||!!e};
window.atuOD=f=>{const n=Number(g48('atuOI').value.replace(/\D/g,''));D()[f]=n;closeSheet();render('fade-none')};
window.atuSrc=i=>{D().o=i;render('fade-none')};
window.atuSms=()=>{const d=D();d.sms=!d.sms;render('fade-none')};
const screenAtu=()=>{const d=D(),a=S.atu,k=chk(d);
const src=SRCN.map((n,i)=>ckRow(d.o===i,`atuSrc(${i})`,n,t3('Balance ','Asigaye ','Solde ')+fm(SB()[i])+' RWF','radio')).join('');
const hist=a.on?`<div class="agt">${t3('Recent refills','Ibyuzuzwa vuba','Recharges récentes')}</div>${S.atuH.length?S.atuH.slice(0,4).map(x=>`<div class="row" style="padding:11px 24px;min-height:56px"><div style="flex:1;min-width:0"><div class="t">${esc48(x[0])}</div><div class="s">${esc48(x[2])}</div></div><b style="color:var(--ok);white-space:nowrap">+${fm(x[1])} RWF</b></div>`).join(''):`<div class="pad mu" style="padding-top:6px;font-size:15px">${t3('No refills yet.','Nta cyuzuzwa.','Aucune recharge pour l’instant.')}</div>`}<div class="pad" style="padding-top:8px"><button onclick="atuTry()" style="border:0;background:none;padding:8px 0;color:var(--lk);font-weight:800;font-size:15px">${t3('Try a refill (sample)','Gerageza kuzuza (icyitegererezo)','Essayer une recharge (exemple)')}</button></div>`:'';
const sub=k.ok?sent(d):t3('Choose how much and when.','Hitamo angahe n’igihe.','Choisissez le montant et le moment.');
const use=a.on&&a.cap?`<div class="sm mu" style="padding:6px 24px 0">${t3('Used this month: ','Byakoreshejwe uku kwezi: ','Utilisé ce mois-ci : ')}${fm(a.used)} / ${fm(a.cap)} RWF</div>`:'';
return bar(t3('Auto top-up','Kuzuza byikora','Recharge automatique'))+`<div style="padding:22px 24px 0">${a.on?`<div class="sm" style="color:var(--ok);font-weight:800;margin-bottom:6px">${t3('On','Birakora','Activée')}</div>`:''}<div class="h1">${t3('Auto top-up','Kuzuza byikora','Recharge automatique')}</div><div class="mu" style="font-size:15px;line-height:22px;margin-top:8px">${sub}</div></div>
<div style="padding-top:18px">${valRow('th',d.th)}${valRow('amt',d.amt)}${valRow('cap',d.cap)}</div>${k.cap?`<div class="sm" role="alert" style="padding:2px 24px 0;color:var(--er);font-weight:700;line-height:19px">${k.cap}</div>`:''}${use}
<div class="agt">${t3('Take it from','Yakurwe kuri','Prélever depuis')}</div><div role="radiogroup">${src}</div>${k.warn?`<div class="sm mu" role="status" style="padding:4px 24px 0;line-height:19px">${k.warn}</div>`:''}
<div class="row" style="padding:14px 24px;margin-top:8px"><div style="flex:1"><div class="t">${t3('Text me after each refill','Mbwira kuri SMS nyuma ya buri nzuza','M’envoyer un SMS après chaque recharge')}</div></div><div class="sw ${d.sms?'on':''}" role="switch" aria-checked="${!!d.sms}" aria-label="SMS" tabindex="0" onclick="atuSms()"><i></i></div></div>${hist}
<div class="pad fine" style="padding-top:14px">${t3('Free. Sample terms for this prototype.','Ubuntu. Amabwiriza y’icyitegererezo.','Gratuit. Conditions d’exemple pour ce prototype.')}</div><div style="height:100px"></div>${cta(d,k)}`};
window.atuTry=()=>{const a=S.atu;if(!a.on)return;
if(SB()[a.o]<a.amt){toast(t3('Skipped: '+SRCN[a.o]+' has too little','Byasimbutse: '+SRCN[a.o]+' ifite make','Ignoré : '+SRCN[a.o]+' a trop peu'));return}
if(a.cap&&a.used+a.amt>a.cap){toast(t3('Monthly limit reached','Imbibi y’ukwezi yagezweho','Plafond mensuel atteint'));return}
if(a.o===2)S.bank-=a.amt;else S.atuSB[a.o]-=a.amt;S.pay+=a.amt;a.used+=a.amt;S.atuH.unshift([t3('From ','Biturutse kuri ','Depuis ')+SRCN[a.o],a.amt,t3('Just now','Ubu nyine','À l’instant')]);
if(Array.isArray(S.act))S.act.unshift(['wallet','Auto top-up · '+SRCN[a.o],'Received · Just now',a.amt,'Received']);
toast('+'+fm(a.amt)+' RWF '+t3('added to itunda Pay','yongewe muri itunda Pay','ajoutés à itunda Pay')+(a.sms?t3(' · SMS sent',' · SMS yoherejwe',' · SMS envoyé'):''));render('fade-none')};
window.atuReview=()=>{const d=D(),k=chk(d),on=S.atu.on;if(!k.ok)return;
lay2(`<div class="h1" style="font-size:22px;line-height:30px;margin-top:4px">${on?t3('Save changes?','Kubika impinduka?','Enregistrer les modifications ?'):t3('Turn on auto top-up?','Gutangiza kuzuza byikora?','Activer la recharge automatique ?')}</div><div style="margin:12px 0 20px">${R(t3('Refill when below','Uzuza iri munsi ya','Recharger sous'),fm(d.th)+' RWF')}${R(t3('Add','Ongeraho','Ajouter'),fm(d.amt)+' RWF')}${R(t3('Take it from','Yakurwe kuri','Prélever depuis'),SRCN[d.o])}${R(t3('Monthly limit','Imbibi y’ukwezi','Plafond mensuel'),d.cap?fm(d.cap)+' RWF':t3('No limit','Nta mbibi','Sans plafond'))}${R('SMS',d.sms?t3('Yes','Yego','Oui'):t3('No','Oya','Non'))}${R(t3('Fee','Ikiguzi','Frais'),t3('Free','Ubuntu','Gratuit'))}</div>${k.warn?`<div class="sm mu" style="margin:-8px 0 16px;line-height:19px">${k.warn}</div>`:''}<div style="display:grid;grid-template-columns:1fr 1.8fr;gap:12px"><button class="btn sec2" onclick="closeSheet()">${t3('Cancel','Hagarika','Annuler')}</button><button class="btn" style="white-space:nowrap" onclick="atuSave()">${on?t3('Save changes','Bika impinduka','Enregistrer'):t3('Turn on','Tangiza','Activer')}</button></div>`)};
window.atuSave=()=>{const was=S.atu.on,u=S.atu.used||0;S.atu=Object.assign({},D(),{on:true,used:u});S.atuD=Object.assign({},S.atu);closeSheet();render('fade-none');toast(was?t3('Changes saved','Impinduka zabitswe','Modifications enregistrées'):t3('Auto top-up is on','Kuzuza byikora birakora','Recharge automatique activée'))};
window.atuOff=()=>lay2(`<div class="h1" style="font-size:22px;line-height:30px;margin-top:4px">${t3('Turn off auto top-up?','Kuzimya kuzuza byikora?','Désactiver la recharge automatique ?')}</div><div class="mu" style="font-size:15px;margin:8px 0 24px;line-height:22px">${t3('We will stop adding money when your itunda Pay balance is low. Your saved choices are kept for next time.','Tuzahagarika kongeraho amafaranga itunda Pay ibaye nke. Amahitamo yawe azabikwa.','Nous cesserons d’ajouter de l’argent quand votre solde itunda Pay est bas. Vos choix sont conservés.')}</div><div style="display:grid;grid-template-columns:1fr 1.8fr;gap:12px"><button class="btn sec2" onclick="closeSheet()">${t3('Keep it on','Reka bikore','Garder activée')}</button><button class="btn" style="white-space:nowrap" onclick="atuOffGo()">${t3('Turn off','Zimya','Désactiver')}</button></div>`);
window.atuOffGo=()=>{S.atu.on=false;S.atuD=Object.assign({},S.atu);closeSheet();render('fade-none');toast(t3('Auto top-up is off','Kuzuza byikora byazimye','Recharge automatique désactivée'))};
const _p=screens.svc;screens.svc=()=>S.svk==='atu'?screenAtu():_p();
}
/* v298: Auto top-up. Before: English only; refill level and amount were four fixed chips; two sources; no limit, no way to see how a refill would work, and no record of refills. Now: English, French and Kinyarwanda (fr/rw new copy needs native review); a balance bar with your refill level marked on it; you type the refill level and the amount (shortcuts stay), with errors under each field; a third source, itunda Bank, and the balance of each source (a note if one is too low for a refill); a monthly limit (100,000 / 300,000 / 500,000 / none) with how much is used; a switch for an SMS after each refill; a live sentence; a review that lists all of it; when on, Recent refills and "Try a refill (sample)", which adds money to itunda Pay and Activity. */
/* v299 Moto-Taxi ownership */
{const t3=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e;
const fm=n=>fmt(Math.round(n)),esc48=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const SC=[1500000,2000000,2500000,3000000],DP=[30,40,50],MS=[6,12,18],TM=[24,36,48],INC=[5000,8000,12000,15000],RATE=14,PMIN=1000000,PMAX=5000000,DAYS=26;
const short=v=>v>=1e6?(v/1e6)+'M':(v/1e3)+'K';
const old=S.sv2&&S.sv2.moto?S.sv2.moto:null;
S.mo=S.mo||{a:old&&old.a?old.a:2000000,dp:30,ms:S.moMs||12,n:24,inc:8000};
const M=()=>S.mo;
const mine=()=>S.goal&&S.goal.moto,other=()=>S.goal&&!S.goal.moto;
const calc=p=>{const dn=Math.round(p.a*p.dp/100),loan=p.a-dn,i=RATE/1200,mo=Math.round(loan*i/(1-Math.pow(1+i,-p.n))),sv=Math.round(dn/p.ms/1000)*1000||Math.round(dn/p.ms);return{dn,loan,mo,tot:mo*p.n,int:mo*p.n-loan,sv}};
const planOf=()=>{const g=S.goal;if(g&&g.plan)return g.plan;return{a:Math.round(g.t/.3),dp:30,ms:g.m||12,n:24,inc:M().inc}};
const okP=()=>M().a>=PMIN&&M().a<=PMAX;
const perr=()=>{const a=M().a;return !a?'':a<PMIN?t3('Minimum is '+fm(PMIN)+' RWF','Nibura ni RWF '+fm(PMIN),'Minimum : '+fm(PMIN)+' RWF'):a>PMAX?t3('Maximum is '+fm(PMAX)+' RWF','Ntarenza RWF '+fm(PMAX),'Maximum : '+fm(PMAX)+' RWF'):''};
const chip=(on,fn,l,al)=>`<button class="chip" aria-pressed="${on}" ${al?`aria-label="${al}" `:''}onclick="${fn}" style="min-width:64px;height:44px;border-radius:22px;border:0;padding:0 16px;font-size:15px;font-weight:800;background:${on?'var(--tx)':'var(--chip)'};color:${on?'var(--bg)':'var(--tx)'}">${l}</button>`;
const grp=(h,l)=>`<div style="display:flex;gap:10px;flex-wrap:wrap;padding:10px 24px 0" role="group" ${l?`aria-label="${l}"`:''}>${h}</div>`;
const lab=(t,s)=>`<div style="padding:24px 24px 0"><div style="font-size:16px;font-weight:800">${t}</div>${s?`<div class="sm mu" style="margin-top:4px;line-height:19px">${s}</div>`:''}</div>`;
const rw=(a,v,b)=>`<div style="margin:8px 24px 0;display:flex;justify-content:space-between;gap:12px;font-size:15px"><span class="mu">${a}</span><b style="text-align:right;${b?'color:var(--tintfg)':''}">${v}</b></div>`;
const R=(a,v)=>`<div style="display:flex;justify-content:space-between;gap:12px;min-height:40px;align-items:center;font-size:15px"><span class="mu">${a}</span><b style="text-align:right">${v}</b></div>`;
const lay2=h=>{$('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet">'+h+'</div>';if(typeof focusSheet==='function')focusSheet()};
const mon=(a,b,c)=>t3(a,b,c);
const dyn=()=>{const p=M(),q=calc(p),ok=okP(),mi=p.inc*DAYS,s1=mi?Math.round(q.sv*100/mi):0,s2=mi?Math.round(q.mo*100/mi):0;
const tag=s=>s<=30?[t3('Comfortable','Birashoboka','Confortable'),'var(--ok)']:s<=45?[t3('Tight','Biragoye','Serré'),'var(--mu)']:[t3('High','Biri hejuru','Élevé'),'var(--er)'];
const t1=tag(s1),t2=tag(s2);
return `${grp(SC.map(v=>chip(p.a===v,`moSet('a',${v})`,short(v),fm(v)+' RWF')).join(''),t3('Price shortcuts','Ibiciro byihuse','Raccourcis de prix'))}
${lab(t3('First: save your down payment','Banza: bika amafaranga y’ibanze','D’abord : épargnez l’apport'))}
<div style="padding:12px 24px 0"><div class="sm mu" style="margin-bottom:8px">${t3('Down payment','Amafaranga y’ibanze','Apport')}</div><div style="display:flex;gap:10px;flex-wrap:wrap" role="group">${DP.map(v=>chip(p.dp===v,`moSet('dp',${v})`,v+'%')).join('')}</div></div>
<div style="padding:14px 24px 0"><div class="sm mu" style="margin-bottom:8px">${t3('Save it in','Uyabike mu','Épargner en')}</div><div style="display:flex;gap:10px;flex-wrap:wrap" role="group">${MS.map(v=>chip(p.ms===v,`moSet('ms',${v})`,v+' '+t3('months','mezi','mois'))).join('')}</div></div>
${ok?rw(t3('Down payment to save','Ayo ukwiye kubika','Apport à épargner'),fm(q.dn)+' RWF',1)+rw(t3('About each month','Nka buri kwezi','Environ par mois'),fm(q.sv)+' RWF'):''}
${lab(t3('Then: repay the loan over','Hanyuma: ishyura inguzanyo mu','Ensuite : remboursez le prêt sur'))}
${grp(TM.map(v=>chip(p.n===v,`moSet('n',${v})`,v+' '+t3('months','mezi','mois'))).join(''))}
${ok?rw(t3('Loan amount','Inguzanyo','Montant du prêt'),fm(q.loan)+' RWF ('+(100-p.dp)+'%)')+rw(t3('Monthly loan payment','Ishyura buri kwezi','Mensualité du prêt'),fm(q.mo)+' RWF',1)+rw(t3('Interest in total','Inyungu yose','Intérêts au total'),fm(q.int)+' RWF')+rw(t3('Total to repay','Ugomba kwishyura yose','Total à rembourser'),fm(q.tot)+' RWF')+rw(t3('Rate','Inyungu','Taux'),RATE+t3('% a year','% ku mwaka',' % par an'))+`<div class="pad sm mu" style="padding-top:8px;line-height:20px">${t3('The loan opens when your down payment is saved.','Inguzanyo ifungurwa umaze kubika amafaranga y’ibanze.','Le prêt s’ouvre quand votre apport est épargné.')}</div>`:''}
${ok?`${lab(t3('Can you afford it?','Birashoboka?','Est-ce abordable ?'),t3('Tap what you expect to earn each day. This is your own estimate, not a promise.','Kanda ibyo utekereza kwinjiza buri munsi. Ni uko ubitekereza, ntibivuze ko bizaba.','Touchez ce que vous comptez gagner par jour. C’est votre estimation, pas une promesse.'))}
${grp(INC.map(v=>chip(p.inc===v,`moSet('inc',${v})`,fm(v))).join(''),t3('Daily earnings','Ibyo winjiza ku munsi','Gains par jour'))}
<div style="margin:14px 24px 0;padding:14px 16px;border-radius:16px;background:var(--chip);font-size:15px;line-height:22px" aria-live="polite"><div style="display:flex;justify-content:space-between;gap:12px"><span>${t3('Saving ','Kubika ','Épargne ')}${fm(q.sv)} RWF</span><b style="color:${t1[1]}">${s1}% · ${t1[0]}</b></div><div style="display:flex;justify-content:space-between;gap:12px;margin-top:4px"><span>${t3('Loan payment ','Kwishyura ','Mensualité ')}${fm(q.mo)} RWF</span><b style="color:${t2[1]}">${s2}% · ${t2[0]}</b></div><div class="sm mu" style="margin-top:8px">${t3('Share of about '+fm(mi)+' RWF a month ('+DAYS+' working days).','Ku nsimbi nka '+fm(mi)+' ku kwezi (iminsi '+DAYS+' y’akazi).','Part d’environ '+fm(mi)+' RWF par mois ('+DAYS+' jours de travail).')}</div></div>`:''}`};
window.moUpd=()=>{const d=document.getElementById('moD'),e=document.getElementById('moPE'),b=document.getElementById('moB');if(!d)return;d.innerHTML=dyn();e.textContent=perr();document.getElementById('moP').setAttribute('aria-invalid',perr()?'true':'false');if(b){b.disabled=!okP();b.textContent=t3('Start saving '+fm(calc(M()).dn)+' RWF','Tangira kubika RWF '+fm(calc(M()).dn),'Commencer à épargner '+fm(calc(M()).dn)+' RWF')}};
window.moType=el=>{const v=el.value.replace(/\D/g,'').slice(0,8);M().a=v?Number(v):0;el.value=v?fmt(v):'';moUpd()};
window.moSet=(f,v)=>{M()[f]=v;S.moMs=M().ms;if(f==='a'){const i=document.getElementById('moP');if(i)i.value=fmt(v)}moUpd()};
window.moOpenGoal=()=>{S.stack.push('goal');render('push')};
window.moAdd=n=>{const g=S.goal;if(!g||g.s>=g.t)return;const a=Math.min(n,g.t-g.s);if(S.bank<a){toast(t3('Not enough balance. You have '+fm(S.bank)+' RWF.','Nta mafaranga ahagije. Ufite RWF '+fm(S.bank)+'.','Solde insuffisant. Vous avez '+fm(S.bank)+' RWF.'));return}S.bank-=a;g.s+=a;render('fade-none');toast(t3('Saved '+fm(a)+' RWF','Wabitse RWF '+fm(a),fm(a)+' RWF épargnés'));if(g.s>=g.t&&typeof confetti==='function')setTimeout(confetti,200)};
window.moReview=()=>{if(!okP()||S.goal)return;const p=M(),q=calc(p);
lay2(`<div class="h1" style="font-size:22px;line-height:30px;margin-top:4px">${t3('Start saving for a motorbike?','Gutangira kubika moto?','Épargner pour une moto ?')}</div><div style="margin:12px 0 20px">${R(t3('Motorbike price','Igiciro cya moto','Prix de la moto'),fm(p.a)+' RWF')}${R(t3('Down payment ('+p.dp+'%)','Amafaranga y’ibanze ('+p.dp+'%)','Apport ('+p.dp+' %)'),fm(q.dn)+' RWF')}${R(t3('Save it in','Uyabike mu','Épargner en'),p.ms+' '+t3('months','mezi','mois'))}${R(t3('About each month','Nka buri kwezi','Environ par mois'),fm(q.sv)+' RWF')}${R(t3('Then the loan','Hanyuma inguzanyo','Puis le prêt'),fm(q.loan)+' RWF / '+p.n+' '+t3('months','mezi','mois'))}${R(t3('Loan payment','Kwishyura','Mensualité'),fm(q.mo)+' RWF')}${R(t3('Rate','Inyungu','Taux'),RATE+t3('% a year','% ku mwaka',' % par an'))}</div><div class="mu sm" style="margin:-8px 0 16px;line-height:20px">${t3('This creates a savings goal called “Motorbike down payment”. It shows on Home.','Ibi bikora intego yo kubika yitwa “Motorbike down payment”. Igaragara kuri Home.','Cela crée un objectif d’épargne « Motorbike down payment ». Il apparaît sur l’accueil.')}</div><div style="display:grid;grid-template-columns:1fr 1.8fr;gap:12px"><button class="btn sec2" onclick="closeSheet()">${t3('Cancel','Hagarika','Annuler')}</button><button class="btn" style="white-space:nowrap" onclick="moStart()">${t3('Create my goal','Kora intego yanjye','Créer mon objectif')}</button></div>`)};
window.moStart=()=>{if(S.goal||!okP()){closeSheet();return}const p=Object.assign({},M()),q=calc(p);S.goal={n:'Motorbike down payment',t:q.dn,m:p.ms,s:0,moto:true,plan:p};S.moLoan=null;closeSheet();render('fade-none');toast(t3('Savings goal created','Intego yo kubika yashyizweho','Objectif d’épargne créé'))};
window.moApplyReview=()=>{const g=S.goal;if(!g||!g.moto||g.s<g.t||S.moLoan)return;const p=planOf(),q=calc(p);
lay2(`<div class="h1" style="font-size:22px;line-height:30px;margin-top:4px">${t3('Apply for your loan?','Gusaba inguzanyo yawe?','Demander votre prêt ?')}</div><div style="margin:12px 0 20px">${R(t3('Motorbike price','Igiciro cya moto','Prix de la moto'),fm(p.a)+' RWF')}${R(t3('Down payment saved','Ayo wabitse','Apport épargné'),fm(q.dn)+' RWF')}${R(t3('Loan amount','Inguzanyo','Montant du prêt'),fm(q.loan)+' RWF')}${R(t3('Repay over','Kwishyura mu','Remboursement sur'),p.n+' '+t3('months','mezi','mois'))}${R(t3('Monthly payment','Kwishyura buri kwezi','Mensualité'),fm(q.mo)+' RWF')}${R(t3('Rate','Inyungu','Taux'),RATE+t3('% a year','% ku mwaka',' % par an'))}</div><div class="mu sm" style="margin:-8px 0 16px;line-height:20px">${t3('Sample for this prototype. No real loan is made.','Icyitegererezo cy’iyi porogaramu. Nta nguzanyo nyayo itangwa.','Exemple pour ce prototype. Aucun vrai prêt n’est accordé.')}</div><div style="display:grid;grid-template-columns:1fr 1.8fr;gap:12px"><button class="btn sec2" onclick="closeSheet()">${t3('Cancel','Hagarika','Annuler')}</button><button class="btn" style="white-space:nowrap" onclick="moApply()">${t3('Send application','Ohereza ubusabe','Envoyer la demande')}</button></div>`)};
window.moApply=()=>{const p=planOf(),q=calc(p);S.moLoan={loan:q.loan,mo:q.mo,n:p.n};closeSheet();render('fade-none');toast(t3('Application sent (sample)','Ubusabe bwoherejwe (icyitegererezo)','Demande envoyée (exemple)'))};
const screenMoto=()=>{const g=S.goal,isM=mine(),done=isM&&g.s>=g.t,L=S.moLoan,step=!isM?1:L?3:done?2:1;
const steps=[t3('Save','Bika','Épargner'),t3('Apply','Saba','Demander'),t3('Repay','Ishyura','Rembourser')].map((s,i)=>`<div style="flex:1;text-align:center;min-width:0"><div style="width:28px;height:28px;border-radius:14px;margin:0 auto;display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:800;background:${i+1<=step?'var(--lk)':'var(--chip)'};color:${i+1<=step?'#fff':'var(--mu)'}" ${i+1===step?'aria-current="step"':''}>${i+1}</div><div class="sm" style="margin-top:4px;font-weight:${i+1===step?800:500};color:${i+1===step?'var(--tx)':'var(--mu)'}">${s}</div></div>`).join('');
let top='',body='',btn;
if(isM){const p=planOf(),q=calc(p),pc=Math.min(100,Math.round(g.s/g.t*100));
 top=`<div style="margin:18px 24px 0;padding:16px;border-radius:18px;background:var(--tint);color:var(--tintfg)"><div style="font-weight:800">${L?t3('Loan application sent','Ubusabe bw’inguzanyo bwoherejwe','Demande de prêt envoyée'):done?t3('Down payment saved 🎉','Amafaranga y’ibanze yabitswe 🎉','Apport épargné 🎉'):t3('You are saving for a motorbike','Urimo kubika moto','Vous épargnez pour une moto')}</div><div style="height:8px;border-radius:4px;background:var(--bg);margin-top:10px;overflow:hidden" role="progressbar" aria-valuenow="${pc}" aria-valuemin="0" aria-valuemax="100"><div style="height:100%;width:${pc}%;background:var(--lk)"></div></div><div class="sm" style="margin-top:8px;line-height:19px">${fm(g.s)} / ${fm(g.t)} RWF · ${pc}%${L?'<br>'+t3('Loan of '+fm(L.loan)+' RWF over '+L.n+' months, '+fm(L.mo)+' RWF a month. We reply within 1 business day (sample).','Inguzanyo ya RWF '+fm(L.loan)+' mu mezi '+L.n+', RWF '+fm(L.mo)+' ku kwezi. Tuzasubiza mu munsi 1 w’akazi (icyitegererezo).','Prêt de '+fm(L.loan)+' RWF sur '+L.n+' mois, '+fm(L.mo)+' RWF par mois. Réponse sous 1 jour ouvré (exemple).'):''}</div>${isM&&!done?`<div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:12px">${[10000,50000].map(a=>`<button class="chip" style="background:var(--bg);color:var(--tx)" onclick="moAdd(${a})">${t3('Save ','Bika ','Épargner ')}${fm(a)}</button>`).join('')}</div>`:''}</div>`;
 body=`${lab(t3('Your plan','Gahunda yawe','Votre plan'))}${rw(t3('Motorbike price','Igiciro cya moto','Prix de la moto'),fm(p.a)+' RWF')}${rw(t3('Down payment ('+p.dp+'%)','Amafaranga y’ibanze ('+p.dp+'%)','Apport ('+p.dp+' %)'),fm(q.dn)+' RWF')}${rw(t3('Save it in','Uyabike mu','Épargner en'),p.ms+' '+t3('months','mezi','mois'))}${rw(t3('Loan','Inguzanyo','Prêt'),fm(q.loan)+' RWF / '+p.n+' '+t3('months','mezi','mois'))}${rw(t3('Monthly loan payment','Ishyura buri kwezi','Mensualité du prêt'),fm(q.mo)+' RWF',1)}${rw(t3('Total to repay','Ugomba kwishyura yose','Total à rembourser'),fm(q.tot)+' RWF')}`;
 btn=L?`<button class="btn" style="white-space:nowrap" onclick="moOpenGoal()">${t3('Open my savings goal','Fungura intego yanjye','Ouvrir mon objectif')}</button>`:done?`<button class="btn" style="white-space:nowrap" onclick="moApplyReview()">${t3('Apply for your loan','Saba inguzanyo yawe','Demander votre prêt')}</button>`:`<button class="btn" style="white-space:nowrap" onclick="moOpenGoal()">${t3('Open my savings goal','Fungura intego yanjye','Ouvrir mon objectif')}</button>`}
else{if(other())top=`<div style="margin:18px 24px 0;padding:14px 16px;border-radius:16px;background:var(--chip);font-size:14px;line-height:20px">${t3('You already have a savings goal: ','Usanzwe ufite intego yo kubika: ','Vous avez déjà un objectif d’épargne : ')}<b>${esc48(g.n)}</b>. ${t3('Finish it or delete it, then come back to start your motorbike goal.','Yirangize cyangwa uyisibe, hanyuma ugaruke.','Terminez-le ou supprimez-le, puis revenez.')}</div>`;
 body=`${lab(t3('Motorbike price','Igiciro cya moto','Prix de la moto'))}<div style="padding:8px 24px 0"><div style="display:flex;align-items:baseline;gap:8px;border-bottom:2px solid var(--ln)"><input id="moP" inputmode="numeric" autocomplete="off" placeholder="0" value="${M().a?fmt(M().a):''}" oninput="moType(this)" aria-describedby="moPE" style="flex:1;min-width:0;border:0;background:none;color:var(--tx);font:inherit;font-size:24px;font-weight:800;padding:6px 0;outline:0;border-radius:0"><span class="mu" style="font-weight:700">RWF</span></div><div id="moPE" role="alert" class="sm" style="min-height:20px;margin-top:6px;color:var(--er);font-weight:700">${perr()}</div></div><div id="moD">${dyn()}</div>`;
 btn=other()?`<button class="btn" style="white-space:nowrap" onclick="moOpenGoal()">${t3('Open my savings goal','Fungura intego yanjye','Ouvrir mon objectif')}</button>`:`<button id="moB" class="btn" style="white-space:nowrap" ${okP()?'':'disabled'} onclick="moReview()">${t3('Start saving '+fm(calc(M()).dn)+' RWF','Tangira kubika RWF '+fm(calc(M()).dn),'Commencer à épargner '+fm(calc(M()).dn)+' RWF')}</button>`}
const need=`${lab(t3('Before the loan opens','Mbere y’uko inguzanyo ifungurwa','Avant l’ouverture du prêt'))}<div style="padding:8px 24px 0;font-size:15px;line-height:24px"><div>✓ ${t3('Valid driving licence','Uruhushya rwo gutwara rukora','Permis de conduire valide')}</div><div>✓ ${t3('Moto-taxi permit','Uruhushya rwa moto-taxi','Permis moto-taxi')}</div></div>`;
return bar(t3('Moto-Taxi ownership','Kugira moto-taxi yawe','Devenir propriétaire de moto-taxi'))+`<div style="padding:22px 24px 0"><div style="width:72px;height:72px;border-radius:36px;background:var(--tint);display:flex;align-items:center;justify-content:center;font-size:36px">🏍️</div><div class="h1" style="margin-top:16px">${t3('Moto-Taxi ownership','Kugira moto-taxi yawe','Devenir propriétaire de moto-taxi')}</div><div class="mu" style="font-size:15px;line-height:22px;margin-top:8px">${t3('Save the down payment, then turn the rest into a loan.','Bika amafaranga y’ibanze, hanyuma isigaye ibe inguzanyo.','Épargnez l’apport, puis transformez le reste en prêt.')}</div></div><div style="display:flex;gap:8px;padding:18px 24px 0" role="list">${steps}</div>${top}${body}${need}<div class="pad fine" style="padding-top:14px">${t3('Sample terms for this prototype. No real loan is made.','Amabwiriza y’icyitegererezo. Nta nguzanyo nyayo itangwa.','Conditions d’exemple pour ce prototype. Aucun vrai prêt n’est accordé.')}</div><div style="height:100px"></div><div class="cta">${btn}</div>`};
const _p=screens.svc;screens.svc=()=>S.svk==='moto'?screenMoto():_p();
}
/* v299: Moto-Taxi ownership. Before: English only; the price could only be tapped (shortcuts) with no typing; the 30% down payment was fixed; once the goal was created the page only said how much was saved and the loan never opened. Now: English, French and Kinyarwanda (fr/rw new copy needs native review); a three-step strip (Save, Apply, Repay); the price is a field (1,000,000 to 5,000,000 RWF, error under it) with shortcuts; down payment 30 / 40 / 50% (a bigger one gives a smaller loan); save in 6 / 12 / 18 months; repay over 24 / 36 / 48 months with loan amount, monthly payment, interest in total and total to repay; "Can you afford it?" where you tap what you expect to earn a day and see saving and loan payment as a share of a month (Comfortable up to 30%, Tight up to 45%, High above); a review before the goal is created, and the plan is stored with it. After that the page shows progress with "Save 10,000" and "Save 50,000" (taken from itunda Bank) and the plan; when the down payment is full, "Apply for your loan" opens a review and sends a sample application with its status on the page. */
/* v300 Maps place card: one row */
{const st=document.createElement('style');st.id='v300';
st.textContent='#phone .acts.mp5{display:flex!important;flex-wrap:nowrap!important;gap:6px!important;overflow:visible!important}#phone .acts.mp5>button{flex:1 1 auto!important;grid-column:auto!important;width:auto!important;min-width:0!important;padding:0 6px!important;font-size:13px!important;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}#phone .acts.mp5>button.p,#phone .acts.mp5>button.q{flex-grow:1.25!important}#phone .acts.mp5.mp5s>button{font-size:12px!important;padding:0 4px!important}@media (max-width:380px){#phone .acts.mp5{gap:4px!important}#phone .acts.mp5.mp5s>button{font-size:11px!important;padding:0 2px!important}}';
document.head.appendChild(st);
const _m=screens.mapview;
screens.mapview=()=>{const h=_m();const sm=S.lang!=='en';let r=h.replace(/<div class="acts(" style="padding:14px 0 0">[\s\S]*?)<\/div><div class="acts" style="padding:8px 0 0">([\s\S]*?)<\/div>/,'<div class="acts mp5'+(sm?' mp5s':'')+'$1$2</div>');if(S.lang==='fr')r=r.replace(/(☆ |★ )Enregistrer/,'$1Garder');return r};
}
/* v300: Maps place card (French and Kinyarwanda use 12 px, and French says "Garder" for Save, so all five fit at 360 px). Before: Depart, Arrive and Details were on one row and Save and Share on a second row under them. Now all five sit on one line (Depart and Arrive a little wider, the rest share the space, text 13 px), in English, French and Kinyarwanda, also for a dropped pin (four buttons, no Details). */
/* v301 VUP Financial Services */
{const t3=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e;
const fm=n=>fmt(Math.round(n)),esc48=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const AMIN=50000,AMAX=500000,SCS=[50000,150000,300000,500000],TMS=[6,12,18],RATE=2;
const short=v=>v>=1e6?v/1e6+'M':v/1e3+'K';
const PUR=[['farm',['Farming','Ubuhinzi','Agriculture']],['live',['Livestock','Ubworozi','Élevage']],['shop',['Small shop','Iduka rito','Petit commerce']],['tools',['Tools & equipment','Ibikoresho','Outils et matériel']],['other',['Other','Ibindi','Autre']]];
const pname=k=>{const p=PUR.find(x=>x[0]===k);return p?t3(...p[1]):''};
S.vup=S.vup||{hh:null,sec:'',pur:'',a:150000,n:12};
const V=()=>S.vup;
<script>
/* v184: Book a viewing. "Pick a day" and "Pick a time" labels, all three days visible (no sideways scroll), a line that says what you chose and that the agent gets it as a message, and a button that names the slot it will request. English only; fr/rw copy untouched. */
(function(){
const lab=t=>{const d=document.createElement('div');d.style.cssText='font-size:15px;font-weight:800;margin-top:16px';d.textContent=t;return d};
const fix=()=>{if(S.lang!=='en')return;const sh=document.querySelector('#layer .sheet');if(!sh)return;
 const ch=sh.querySelectorAll('.chp');if(ch.length<2||sh.dataset.v184)return;sh.dataset.v184='1';
 const sel=[...sh.querySelectorAll('.chp button.on')].map(b=>b.textContent.trim());
 ch[0].before(lab('Pick a day'));ch[0].style.cssText+=';padding-top:8px;flex-wrap:wrap;overflow:visible';
 ch[1].before(lab('Pick a time'));ch[1].style.paddingTop='8px';
 const go=sh.querySelector('button.btn');if(!go)return;
 let who='the agent';try{const x=HD.property.items.find(i=>i.id===S.prf.id);if(x&&x.who)who=x.who}catch(e){}
 const when=sel.length>1?sel[0]+' at '+sel[1]:'';
 const n=document.createElement('div');n.className='sm mu';n.style.cssText='margin-top:18px;line-height:20px';
 n.innerHTML=when?'<b style="color:var(--tx)">'+when+'</b> · we send '+who+' a message with this time.':'';
 go.before(n);go.style.marginTop='12px';if(when)go.textContent='Request '+when};
const wrap=k=>{const o=window[k];if(typeof o!=='function')return;window[k]=function(){const r=o.apply(this,arguments);try{fix()}catch(e){}return r}};
['prView','prVSet'].forEach(wrap);

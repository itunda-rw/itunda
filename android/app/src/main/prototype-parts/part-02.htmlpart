(function(){
const lab=t=>'<div style="font-size:15px;font-weight:800;margin-bottom:10px">'+t+'</div>';
const opt=' <span class="mu" style="font-weight:600">(optional)</span>';
window.ecx=h=>{if(S.lang!=='en')return h;
 h=h.replace('<div style="font-size:17px;font-weight:800">','<div class="sm mu" style="font-weight:700;margin-bottom:4px">Your order</div><div style="font-size:17px;font-weight:800">');
 h=h.replace(/(<div class="pad" style="padding-top:\d+px">)(<div class="req"><button class="(?:on)?" onclick="setPickup\()/,'$1'+lab('Delivery or pickup')+'$2');
 ['Request for the rider','Tip your rider','Note for the restaurant'].forEach(t=>{h=h.replace(t+'</div>',t+opt+'</div>')});
 h=h.replace('<div style="display:flex;gap:8px"><input id="epm"',lab('Promo code'+opt)+'<div style="display:flex;gap:8px"><input id="epm"');
 return h};

<script>
/* v149: amount screen shows who you are paying, not just a number */
{const _a=screens.amount;screens.amount=()=>{let h=_a();
h=h.replace(/(flex-wrap:)wrap(">)<button class="chip hit44a"/,'$1nowrap$2<button class="chip hit44a"').replace(/<div id="qa"[^>]*>[\s\S]*?<\/div>/,'').replace('padding:32px 24px 0;text-align:center','padding:12px 24px 0;text-align:center');
const n=nm9(S.to);if(n!==S.to)h=h.replace(/To account ([0-9 +]+)/,(m,num)=>'To <b style="color:var(--tx)">'+n+'</b> · '+num);
return h}}

/* v153: round-up is mentioned once, in the balance line, instead of an extra row and button */
{const _c=confirm_;confirm_=function(){const r=_c.apply(this,arguments);try{
const v=Number(S.amt),x=S.ru&&v%100?100-v%100:0,sh=document.querySelector('#layer .sheet');
if(!x||!sh||S.bank-v<x)return r;
const N={en:'incl. '+fmt(x)+' RWF round-up to savings',rw:'harimo '+fmt(x)+' RWF yo kuzigama',fr:'dont '+fmt(x)+' RWF d’arrondi épargne'}[S.lang]||'';
const b=[...sh.querySelectorAll('.mu')].find(e=>e.textContent.trim()===balAfter(v));if(b)b.textContent=balAfter(v+x)+' · '+N
}catch(e){}return r}}

/* v150: Pay tab header follows the "Pay with" choice, with a toast so the switch is acknowledged */
{const _p=screens.pay;screens.pay=()=>{let h=_p();if(S.psrc==='bank'){h=h.replace(/>itunda Pay Money<\/div><div class="big" style="margin-top:4px">[^<]*</,'>itunda Bank</div><div class="big" style="margin-top:4px">'+fmt(S.bank)+' RWF<')}return h}}
{const _s=window.ppSrc;window.ppSrc=function(k){const ch=k!==S.psrc;const r=_s.apply(this,arguments);if(ch)toast(k==='bank'?'Paying with itunda Bank':'Paying with itunda Pay');return r}}


/* v152: Explore in Kinyarwanda/French: hint under the title instead of a truncated right-hand fragment, and the leftover English strings translated */
{const TR={rw:{'Search':'Shakisha','Places · Routes':'Ahantu · Inzira','itunda Account, other banks, RSE brokerage':'Konti ya itunda, izindi banki, kugura imigabane ya RSE','12-month deposit':'Ubwizigame bw’amezi 12','Youth account':'Konti y’urubyiruko','Capped starter account, ages 7-18':'Konti y’intangiriro ifite igipimo, imyaka 7-18','Harvest advance':'Inguzanyo y’isarura','VUP Financial Services':'Serivisi z’imari za VUP','BRD higher-education loan: 11% undergraduate, 12% postgraduate':'Inguzanyo ya BRD y’amashuri makuru: 11% kuri kaminuza, 12% ku cyiciro cya gatatu','Moto-Taxi Ownership':'Kwigondera moto ya taxi','Save a 30% down payment, then convert to a loan':'Bika 30% y’ibanze, uhindure inguzanyo'},
fr:{'Search':'Rechercher','Places · Routes':'Lieux · Itinéraires','itunda Account, other banks, RSE brokerage':'Compte itunda, autres banques, courtage RSE','12-month deposit':'Dépôt à 12 mois','Youth account':'Compte jeunes','Capped starter account, ages 7-18':'Compte d’initiation plafonné, 7 à 18 ans','Harvest advance':'Avance sur récolte','VUP Financial Services':'Services financiers VUP','BRD higher-education loan: 11% undergraduate, 12% postgraduate':'Prêt BRD études supérieures : 11 % licence, 12 % master','Moto-Taxi Ownership':'Devenir propriétaire de moto-taxi','Save a 30% down payment, then convert to a loan':'Épargnez 30 % d’apport, puis convertissez en prêt'}};
const CSS='<style>.ar:has(>.g+.t+.s){display:grid;grid-template-columns:auto 1fr;column-gap:14px;align-items:center}.ar:has(>.g+.t+.s)>.g{grid-row:1/3}.ar:has(>.g+.t+.s)>.t{grid-column:2;min-width:0}.ar:has(>.g+.t+.s)>.t{line-height:22px}.ar:has(>.g+.t+.s)>.s{grid-column:2;margin:0;text-align:left;white-space:normal;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;line-height:18px}</style>';
const loc=h=>{const m=TR[S.lang];if(!m)return h;let o=h.replace(/>([^<>]+)</g,(x,t)=>{const k=t.trim();return m[k]?'>'+m[k]+'<':x});o=o.replace(/(placeholder|aria-label)="Search"/g,(x,a)=>a+'="'+m['Search']+'"');return CSS+o};
{const _e=screens.explore;screens.explore=()=>loc(_e())}
}

/* v153: one action per page. Eats cart keeps the essentials; optional details fold into one row */
{const _e=screens.echeck;let xo=false;
window.eXo=()=>{xo=!xo;const y=$('#sc')?$('#sc').scrollTop:0;render('fade-none');const c=$('#sc');if(c)c.scrollTop=y};
screens.echeck=()=>{const h=_e();{const P=h.split(/(?=<div class="pad")/),i=P.findIndex(p=>p.includes('aria-label="Add one"'));if(i>1){const it=P.splice(i,1)[0].replace('padding-top:20px','padding-top:12px');P.splice(1,0,it);P[2]=P[2].replace('padding-top:12px','padding-top:20px')}return window.ecx?window.ecx(P.join('')):P.join('')}const parts=h.split(/(?=<div class="pad")/);
const key=['Request for the rider','Delivery time','Tip your rider','Note for the restaurant','id="epm"'];
const opt=[],keep=[];parts.forEach(p=>(key.some(k=>p.includes(k))?opt:keep).push(p));
const ii=keep.findIndex(p=>p.includes('aria-label="Add one"'));if(!opt.length||ii<0)return h;
const sum=[];opt.forEach(p=>{if(p.includes('id="epm"'))return;
if(p.includes('Note for the restaurant')){const m=p.match(/id="enote"[^>]*value="([^"]+)"/);if(m)sum.push('Note');return}
const m=p.match(/<button class="(?:cch )?on"[^>]*>([^<]+)<\/button>/);if(!m)return;const t=m[1].trim();
if(p.includes('Tip your rider')){if(t!=='No tip')sum.push('Tip '+t)}else sum.push(t)});
const del=opt.some(p=>p.includes('Request for the rider'));
const row='<div class="pad" style="padding-top:12px"><div class="tap" role="button" tabindex="0" aria-expanded="'+xo+'" onclick="eXo()" style="display:flex;justify-content:space-between;align-items:center;gap:12px;min-height:56px;border-top:0;'+(xo?'':'border-bottom:0;')+'cursor:pointer"><span style="font-size:15px;font-weight:800;white-space:nowrap">'+(del?'Delivery details':'Order details')+'</span><span class="mu sm" style="min-width:0;flex:1;text-align:right;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">'+sum.join(' · ')+'</span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="'+(xo?'M6 15l6-6 6 6':'M6 9l6 6 6-6')+'"/></svg></div></div>';
return [...keep.slice(0,ii+1),row,...(xo?opt:[]),...keep.slice(ii+1)].join('')}}

/* v153: Bills split into two pages: which bill and number, then how much */
{const _o=openBill;window.openBill=function(p,a){const r=_o.apply(this,arguments);S.bl.pre=!!a;return r}}
if(window.b96Pay){const _b=window.b96Pay;window.b96Pay=function(i){const r=_b.apply(this,arguments);S.bl.pre=true;return r}}
{const _b=screens.bill;screens.bill=()=>{let h=_b();
h=h.replace(/<div class="lab">Amount<\/div>[\s\S]*?(<div class="fine")/,'$1');
return h.replace(/<button id="bgo"[^>]*>[^<]*<\/button>/,'<button id="bgo" class="btn" '+(S.bl.num.length===BP[S.bl.p].n?'':'disabled')+' onclick="billNext()">Next</button>')}}
window.billNext=()=>{const B=S.bl;if(!B.pre)B.amt=0;S.stack.push('billamt');render('push')};
const BKH=()=>({fr:'Saisissez un montant dans la limite de votre solde.',rw:'Andika amafaranga ari mu gipimo cy’ayo ufite.'}[S.lang]||'Enter an amount within your balance.');
const bkMsg=()=>{const v=S.bl.amt,bad=v>S.bank;return bad?t('insuff').replace('%s',fmt(S.bank)):'From itunda Bank · '+fmt(S.bank)+' RWF available'};
function bkUpd(){const B=S.bl,v=B.amt,bad=v>S.bank,a=$('#bamt'),g=$('#bgo2'),m=$('#bmsg');
if(a)a.textContent=fmt(v);document.querySelectorAll('#phone .cta .dhint').forEach(h=>h.remove());if(g){g.disabled=!(v>0&&!bad);g.textContent=v>0?'Pay '+fmt(v)+' RWF':'Enter an amount';if(g.disabled){const d=document.createElement('div');d.className='dhint sm mu';d.setAttribute('role','note');d.style.cssText='text-align:center;padding:8px 8px 0;font-size:13px;line-height:18px';d.textContent=BKH();g.after(d)}}
if(m){m.textContent=bkMsg();m.style.color=bad?'var(--er)':''}document.querySelectorAll('#phone .req button').forEach(b=>b.classList.toggle('on',v>0&&b.dataset.v==String(v)))}
window.bk=k=>{const B=S.bl;let s=String(B.amt||'');if(B.pre&&k!=='max'&&!String(k).startsWith('set:'))s='';
if(k==='del')s=s.slice(0,-1);else if(/^\d$/.test(k))s=(s+k).replace(/^0+/,'').slice(0,9);else if(k==='max')s=String(S.bank);else if(String(k).startsWith('set:'))s=k.slice(4);
B.amt=Number(s)||0;B.pre=false;bkUpd()};
screens.billamt=()=>{const B=S.bl,P=BP[B.p],v=B.amt,bad=v>S.bank;
const del='<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6H9l-5 6 5 6h11zM12 10l4 4M16 10l-4 4"/></svg>';
const pad=['1','2','3','4','5','6','7','8','9','','0','del'].map(k=>k===''?'<button disabled aria-hidden="true"></button>':'<button onclick="bk(\''+k+'\')" aria-label="'+(k==='del'?'Delete':k)+'">'+(k==='del'?del:k)+'</button>').join('');
return bar('Pay bills')+'<div class="pad" style="padding-top:20px"><div class="h1">How much?</div><div class="mu" style="font-size:14px;margin-top:8px">'+B.p+' · '+B.num+'</div></div><div style="padding:12px 24px 0;text-align:center"><div style="font-size:56px;font-weight:800;letter-spacing:-2px"><span id="bamt">'+fmt(v)+'</span> <span style="font-size:20px;letter-spacing:0">RWF</span></div><div id="bmsg" class="mu" style="margin-top:10px;font-size:14px;'+(bad?'color:var(--er)':'')+'">'+bkMsg()+'</div><div class="req" style="justify-content:center;margin-top:14px">'+P.a.map(a=>'<button data-v="'+a+'" class="'+(v===a?'on':'')+'" onclick="bk(\'set:'+a+'\')">'+fmt(a)+'</button>').join('')+'</div></div><div class="keys">'+pad+'</div><div class="cta"><button id="bgo2" class="btn" '+(v>0&&!bad?'':'disabled')+' onclick="billPay()">'+(v>0?'Pay '+fmt(v)+' RWF':'Enter an amount')+'</button>'+(v>0&&!bad?'':'<div class="dhint sm mu" role="note" style="text-align:center;padding:8px 8px 0;font-size:13px;line-height:18px">'+BKH()+'</div>')+'</div>'};

{const _n=window.billNum;window.billNum=function(){const r=_n.apply(this,arguments);const B=S.bl,P=BP[B.p],c=[...document.querySelectorAll('#phone .sm.mu')].find(e=>/\/\d+ digits/.test(e.textContent));if(c)c.textContent=c.textContent.replace(/^\d+\/\d+/,B.num.length+'/'+P.n);return r}}
document.title=document.title.replace('v148','v149').replace('v149','v150').replace('v150','v151').replace('v151','v152').replace('v152','v153');
/* v154: one action per page. Pay amount keeps only amount, keypad and the pay button; tip, note and save-merchant chips no longer sit on it */
{const _p=screens.payamt;screens.payamt=()=>_p().replace(/<div style="padding:16px 24px 0;display:flex;flex-direction:column;gap:10px;align-items:center">[\s\S]*?(?=<div class="keys")/,'')}
document.title=document.title.replace('v153','v154');
/* v155: one action per page. Property detail for buyers keeps photo, price, key facts, move-in cost and the two buttons; details, amenities, nearby, agent, links and similar homes fold into one row. rw/fr strings need native review */
{const _h=screens.hoodItem,t3=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e;
screens.hoodItem=()=>{const h=_h();if(1)return h;if(S.hd!=='property'||h.indexOf('pAgent(')<0)return h;
const m='<div style="font-size:15px;line-height:23px;margin-top:16px">',a=h.indexOf(m),z=h.lastIndexOf('<div style="height:96px"></div>');
if(a<0||z<a)return h;const e=h.indexOf('</div>',a)+6;
return h.slice(0,e)+'<details style="margin-top:16px;border-top:0"><summary style="list-style:none;min-height:52px;display:flex;align-items:center;justify-content:space-between;font-weight:800;cursor:pointer">'+t3('More about this home','Ibindi ku nzu','Plus sur ce bien')+'<span aria-hidden="true">▾</span></summary>'+h.slice(e,z)+'</details>'+h.slice(z)}}
document.title=document.title.replace('v154','v155');
/* v156: one action per page. Community feed keeps the post prompt, categories and posts; search, area and sort fold into one row that stays open while a filter is on. rw/fr strings need native review */
{const _c=screens.community,t3=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e;
screens.community=()=>{const h=_c();if(1)return h;const s1=h.indexOf('<div style="display:flex;gap:10px;padding:6px 24px 0"><input id="cmq"'),s2=h.indexOf('<div class="pad" style="padding-top:10px"><button class="btn sec2"'),f1=h.indexOf('<div class="chips" style="padding-top:8px" id="cmar">'),f2=h.indexOf('<div style="padding-top:8px" id="cml">');
if(s1<0||s2<s1||f1<s2||f2<f1)return h;const on=S.cm&&(S.cm.q||S.cm.area||S.cm.sort);
return h.slice(0,s1)+h.slice(s2,f1)+'<details'+(on?' open':'')+' style="margin:10px 24px 0;border-top:0"><summary style="list-style:none;min-height:48px;display:flex;align-items:center;justify-content:space-between;font-weight:800;cursor:pointer">'+t3('Search and filters','Shakisha no gushungura','Recherche et filtres')+'<span aria-hidden="true">▾</span></summary><div style="margin:0 -24px">'+h.slice(s1,s2)+h.slice(f1,f2)+'</div></details>'+h.slice(f2)}}
document.title=document.title.replace('v155','v156');
document.title=document.title.replace('v156','v157');
/* v158: one action per page. Bank home keeps balance, the four actions, total and Coming up; every other section folds into its own row. */
{const _b=screens.bank;screens.bank=()=>{const h=_b(),d=document.createElement('div');d.innerHTML=h;const k=[...d.children];
if(k.length<14||!k[5].querySelector('.sech'))return h;
const G=[[5,6,7],[8],[9],[10],[11],[12]];let o=k.slice(0,5).map(e=>e.outerHTML).join('');
G.forEach(g=>{const f=k[g[0]].cloneNode(true),hd=f.querySelector('.sech'),ti=hd?hd.textContent:'';if(hd)hd.remove();
o+='<details style="margin:0 24px;border-top:0"><summary style="list-style:none;min-height:52px;display:flex;align-items:center;justify-content:space-between;font-weight:800;cursor:pointer">'+ti+'<span aria-hidden="true">▾</span></summary><div style="margin:0 -24px">'+f.outerHTML+g.slice(1).map(i=>k[i].outerHTML).join('')+'</div></details>'});
return o+k.slice(13).map(e=>e.outerHTML).join('')}}
document.title=document.title.replace('v157','v158');
/* v159: one action per page. Pay home keeps balance, the four actions, payment code and Ways to pay; Pay with, Pay again, Send again, Recent activity and More fold into rows. Loan keeps amount, term, instalment and total; rate, interest and final payment fold into one row. rw/fr strings need native review */
{const t3=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e,sm='<summary style="list-style:none;min-height:52px;display:flex;align-items:center;justify-content:space-between;font-weight:800;cursor:pointer">',dt='<details style="margin:0 24px;border-top:0">',ar='<span aria-hidden="true">▾</span></summary>';
const _p=screens.pay;screens.pay=()=>{const h=_p(),d=document.createElement('div');d.innerHTML=h;const k=[...d.children];
if(k.length<14||!k[8].querySelector('.sech'))return h;
const G=[[3,4,1],[8,9,0],[10,11,0],[12,0,0],[13,0,0]];let o=k.slice(0,3).map(e=>e.outerHTML).join('')+k[5].outerHTML+k[6].outerHTML+k[7].outerHTML;
G.forEach(([a,b,agt])=>{const f=k[a].cloneNode(true);let ti='';
 if(agt){ti=f.textContent;f.remove()}else{const hd=f.querySelector('.sech');if(hd&&hd.firstChild&&hd.firstChild.nodeType===3){ti=hd.firstChild.textContent;hd.firstChild.remove()}}
 o+=dt+sm+ti+ar+'<div style="margin:0 -24px">'+(agt?'':f.outerHTML)+(b?k[b].outerHTML:'')+'</div></details>'});
return o+k.slice(14).map(e=>e.outerHTML).join('')};
const _l=screens.loan;screens.loan=()=>{const h=_l(),d=document.createElement('div');d.innerHTML=h;const k=[...d.children];
if(k.length!==6||!k[3]||k[3].children.length<5)return h;const r=[...k[3].children],m=r.slice(2).map(e=>e.outerHTML).join('');r.slice(2).forEach(e=>e.remove());
k[3].insertAdjacentHTML('beforeend','<details style="border-top:0">'+sm+t3('Rate and interest','Inyungu n’amafaranga','Taux et intérêts')+ar+m+'</details>');
return k.map(e=>e.outerHTML).join('')}}
document.title=document.title.replace('v158','v159');
/* v160: one action per page. Property list keeps the Rent/Sale chips, the safety note and the results; search, sort, filter, compare, viewings and bedrooms fold into one row that stays open while a filter is on. rw/fr strings need native review */
{const _h=screens.hood,t3=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e;
screens.hood=()=>{const h=_h();if(S.hd!=='property')return h;const d=document.createElement('div');d.innerHTML=h;const k=[...d.children];
if(k.length<9||k[2].id!=='prtl'||k[3].id!=='prch'||k[4].id!=='prbd')return h;
const q=k[1].querySelector('input'),on=!!(q&&q.getAttribute('value'))||[...k[4].querySelectorAll('.on')].some(e=>!/^(Any|Byose|Tout)/.test(e.textContent.trim()));
return k[0].outerHTML+k[3].outerHTML+'<details'+(on?' open':'')+' style="margin:10px 24px 0;border-top:0"><summary style="list-style:none;min-height:48px;display:flex;align-items:center;justify-content:space-between;font-weight:800;cursor:pointer">'+t3('Search and filters','Shakisha no gushungura','Recherche et filtres')+'<span aria-hidden="true">▾</span></summary><div style="margin:0 -24px">'+k[1].outerHTML+k[2].outerHTML+k[4].outerHTML+'</div></details>'+k.slice(5).map(e=>e.outerHTML).join('')}}
document.title=document.title.replace('v159','v160');
/* v161: one action per page. New savings goal asks one question per step (what, how much, by when) with Next, and Back steps back through them. rw/fr strings need native review */
{const t3=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e,_g=screens.goal,_bk=window.back,_gm=window.goalMake;
const Q=[['What are you saving for?','Urimo kuzigamira iki?','Pour quoi épargnez-vous ?'],['How much?','Angahe?','Combien ?'],['By when?','Ni ryari?','Pour quand ?']];
screens.goal=()=>{const h=_g();if(S.goal)return h;const d=document.createElement('div');d.innerHTML=h;const k=[...d.children];
if(k.length!==4||k[2].children.length<7||!k[1].querySelector('.h1'))return h;
const st=Math.min(2,S.gst|0),c=[...k[2].children],h1=k[1].querySelector('.h1'),b=k[3].querySelector('button');
h1.textContent=t3(...Q[st]);k[2].innerHTML=[[0,1],[2,3],[4,5,6]][st].map(i=>c[i].outerHTML).join('');
if(st<2&&b){b.textContent=t3('Next','Komeza','Suivant');b.setAttribute('onclick',"S.gst=(S.gst|0)+1;render('fade-none')")}
return k.map(e=>e.outerHTML).join('')};
window.back=()=>{if(S.stack[S.stack.length-1]==='goal'&&!S.goal&&(S.gst|0)>0){S.gst--;render('fade-none');return}S.gst=0;_bk()};
window.goalMake=()=>{S.gst=0;_gm()}}
document.title=document.title.replace('v160','v161');
document.title=document.title.replace('v161','v162');
document.title=document.title.replace('v162','v163');
/* v164: one action per page. Transit keeps the balance and Tap to pay; Top up opens only when the balance is too low, and Ride history and the fare notes fold. rw/fr strings need native review */
{const t3=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e,sm='<summary style="list-style:none;min-height:52px;display:flex;align-items:center;justify-content:space-between;font-weight:800;cursor:pointer">',ar='<span aria-hidden="true">▾</span></summary>';
const _t=screens.transit;screens.transit=()=>{const h=_t(),d=document.createElement('div');d.innerHTML=h;const k=[...d.children];
if(k.length!==9||k[5].children.length<4)return h;const low=k[5].children[3].hasAttribute('disabled'),note=k[5].children[2].outerHTML;k[5].children[2].remove();
const fd=(ti,body,op)=>'<details'+(op?' open':'')+' style="margin:0 24px;border-top:0">'+sm+ti+ar+'<div style="margin:0 -24px">'+body+'</div></details>';
return k[0].outerHTML+k[1].outerHTML+k[4].outerHTML+k[5].outerHTML+fd(k[2].textContent,k[3].outerHTML,low)+fd(k[6].textContent,k[7].outerHTML)+fd(t3('About fares','Ibyerekeye ibiciro','À propos des tarifs'),note+k[8].outerHTML)}}
document.title=document.title.replace('v163','v164');
/* v165: Group order card on the restaurant menu sat inside an already padded column and got double side padding (49px from the edge instead of 25px). Drop the inner .pad so it lines up with the tabs and menu below. */
{const _e=screens.erest;screens.erest=()=>_e().replace(/<div class="pad" style="padding-top:14px">(<button class="tap"[^>]*onclick="eg(?:Start|Manage)\(\)")/,'<div style="padding-top:14px">$1')}
document.title=document.title.replace('v164','v165');
/* v166: French and Kinyarwanda coverage for static screens that were still English (Rewards, Settings, Loans, Score, Order tracking, Mini). Exact-match text swap after each render; names, sample posts and merchant data stay as is. rw covers only strings that are safe to ship and still needs native review; anything missing falls back to English. */
{const D={fr:{"up to 500 RWF": "jusqu’à 500 RWF", "See schedule": "Voir le calendrier", "Deal of the Day": "Offre du jour", "Sale Calendar": "Calendrier des soldes", "Popular sales happening now": "Soldes populaires en ce moment", "Small daily saves that add up": "Petites économies quotidiennes qui s’accumulent", "Practice Investing": "S’exercer à investir", "Find out if you’d make money in stocks": "Découvrez si vous gagneriez en bourse", "Airtime Top-up": "Recharge de crédit", "Buy MTN or Airtel airtime in seconds": "Achetez du crédit MTN ou Airtel en quelques secondes", "Bus Times": "Horaires des bus", "Live Kigali bus arrivals": "Arrivées des bus de Kigali en direct", "Discount codes & coupons": "Codes promo et coupons", "Safe Savings": "Épargne sûre", "See deals": "Voir les offres", "Only at this price, only today": "À ce prix, aujourd’hui seulement", "Your points": "Vos points", "Your coupons": "Vos coupons", "Recent cashback": "Cashback récent", "Earned this month": "Gagné ce mois-ci", "Rewards earned": "Récompenses gagnées", "Invite a friend": "Inviter un ami", "Earn more": "Gagner plus", "Daily check-in": "Pointage quotidien", "Spin the wheel": "Tourner la roue", "Daily challenge": "Défi du jour", "Offers for you": "Offres pour vous", "Welcome reward": "Récompense de bienvenue", "Sign out": "Se déconnecter", "Change PIN": "Changer le code PIN", "Enter your current PIN": "Saisissez votre code PIN actuel", "Text size": "Taille du texte", "This phone": "Ce téléphone", "Use a passkey on this phone": "Utiliser une clé d’accès sur ce téléphone", "Sign in without your PIN": "Se connecter sans code PIN", "Daily sending limit": "Plafond d’envoi quotidien", "Confirm with PIN": "Confirmer avec le code PIN", "Warn on new numbers": "Avertir pour les nouveaux numéros", "Ask for your PIN before every transfer": "Demander votre code PIN avant chaque transfert", "Send an SMS when money arrives": "Envoyer un SMS à la réception d’argent", "Extra check before sending to someon
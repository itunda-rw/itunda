<script>
/* v182: step-by-step forms (Sell, Post a job, List a property, Add payee, Schedule transfer, Dispute a payment). Each page now says which step you are on ("Step 2 of 7"), what to type under the question, and, when Next is off, exactly what is missing. English only; fr/rw copy untouched. */
(function(){
const HT={
mx:{t:['Use a short title buyers can search for.','Type what you are selling to continue.'],p:['Type the price in RWF. Buyers see it first.','Enter a price above 0 to continue.'],c:['Pick the one that fits best.'],cd:['Be honest. Buyers see this on your listing.'],a:['Buyers see this area, not your exact address.'],n:['You can change this later.'],d:['Optional. Size, colour, or why you are selling.']},
jw:{t:['Use the job name people would search for.','Type the job title to continue.'],p:['Type the pay in RWF, then pick how often it is paid.','Enter the pay to continue.'],c:['Pick the type of work.'],l:['Pick where the work happens.'],s:['Pick when the worker should start.'],r:['Optional. Add up to 3 things an applicant must have.'],d:['Optional. Hours, tasks, or what you offer.']},
pw:{c:['Pick one.'],k:['Pick the one that fits best.'],l:['Applicants see this area, not your exact address.'],p:['Type the amount in RWF.','Enter an amount above 0 to continue.'],dp:['Type the deposit in RWF.'],rm:['Pick the number of rooms.'],m:['Optional. Size in square metres.'],am:['Optional. Tap everything that applies.'],t:['A short title, like "2-bedroom in Kimironko".','Name your listing to continue.'],d:['Optional. Anything a renter or buyer should know.']},
bp:{n:['This is the name you will see in your payee list.','Type who you are paying to continue.'],b:['Pick the bank where they have their account.'],a:['Type the 10-digit account number.','Enter all 10 digits to continue.'],k:['Optional. A short name helps you find them faster.']},

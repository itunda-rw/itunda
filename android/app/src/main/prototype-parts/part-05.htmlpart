 y=\"10.5\" width=\"15\" height=\"10\" rx=\"3.5\"/><path d=\"M8 10.5V8a4 4 0 0 1 8 0v2.5\"/>", "plant": "<path d=\"M12 20v-8\"/><path d=\"M12 12C12 8 9 6 5 6c0 4 2.5 6 7 6zM12 14c0-3.5 2.5-5.5 7-5.5 0 3.5-2.5 5.5-7 5.5z\"/>", "bike": "<circle cx=\"6\" cy=\"16\" r=\"3.5\"/><circle cx=\"18\" cy=\"16\" r=\"3.5\"/><path d=\"M6 16l3.5-7h5.5l3 7M9.5 9 12 16M14.5 9 13 6h2.5\"/>", "child": "<circle cx=\"12\" cy=\"9\" r=\"4\"/><path d=\"M5.5 20c.8-2.5 3.2-4 6.5-4s5.700 1.500 6.500 4\"/>", "up": "<path d=\"M12 19V5M6 11l6-6 6 6\"/>", "plus": "<path d=\"M12 5v14M5 12h14\"/>", "minus": "<path d=\"M5 12h14\"/>", "gear": "<path d=\"M10 4.77L10.6 2.6L13.4 2.6L14 4.77A7.5 7.5 0 0 1 15.69 5.47L15.69 5.47L17.65 4.36L19.64 6.35L18.53 8.31A7.5 7.5 0 0 1 19.23 10L19.23 10L21.4 10.6L21.4 13.4L19.23 14A7.5 7.5 0 0 1 18.53 15.69L18.53 15.69L19.64 17.65L17.65 19.64L15.69 18.53A7.5 7.5 0 0 1 14 19.23L14 19.23L13.4 21.4L10.6 21.4L10 19.23A7.5 7.5 0 0 1 8.31 18.53L8.31 18.53L6.35 19.64L4.36 17.65L5.47 15.69A7.5 7.5 0 0 1 4.77 14L4.77 14L2.6 13.4L2.6 10.6L4.77 10A7.5 7.5 0 0 1 5.47 8.31L5.47 8.31L4.36 6.35L6.35 4.36L8.31 5.47A7.5 7.5 0 0 1 10 4.77Z\"/><circle cx=\"12\" cy=\"12\" r=\"2.900\"/>", "heart": "<path d=\"M12 20S4 15 4 9.2A4.2 4.2 0 0 1 12 7.5 4.2 4.2 0 0 1 20 9.2C20 15 12 20 12 20z\"/>", "compass": "<circle cx=\"12\" cy=\"12\" r=\"8.5\"/><path d=\"M15.5 8.5 13.5 13.5 8.5 15.5l2-5z\"/>", "msg": "<path d=\"M5 4.5h14a2.5 2.5 0 0 1 2.5 2.5v8a2.5 2.5 0 0 1-2.5 2.5h-6l-4.5 3.5V17.5H5A2.5 2.5 0 0 1 2.5 15V7A2.5 2.5 0 0 1 5 4.5z\"/>", "pencil": "<path d=\"M4 20l1-4.5L16.5 4a2.1 2.1 0 0 1 3 0l.5.5a2.1 2.1 0 0 1 0 3L8.5 19z\"/><path d=\"M14.5 6l3.5 3.5\"/>", "help": "<circle cx=\"12\" cy=\"12\" r=\"8.5\"/><path d=\"M9.5 9.5a2.6 2.6 0 0 1 5 .8c0 1.7-2.500 2-2.500 3.700M12 17h.01\"/>", "check": "<path d=\"M5 12.8l4.5 4.5L19 7.5\"/>", "mbus": "<rect x=\"4\" y=\"4.5\" width=\"16\" height=\"12.5\" rx=\"3.5\"/><path d=\"M4 11h16M8 20v-3M16 20v-3M8 14h.01M16 14h.01\"/>", "mcar": "<path d=\"M5 16.5V12l1.800-5a2 2 0 0 1 1.900-1.300h6.600A2 2 0 0 1 17.200 7L19 12v4.500a1 1 0 0 1-1 1h-1.500a1 1 0 0 1-1-1V15h-7v1.500a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1z\"/><path d=\"M5.500 11.500h13M8 13.500h.01M16 13.500h.01\"/>", "mwalk": "<circle cx=\"13\" cy=\"4.5\" r=\"2\"/><path d=\"M11 21l1.500-6-2.500-3 1-4.500 3.500 1.500 2 3M8 11l-1 3.500M12.500 15l2.500 6\"/>", "mbike": "<circle cx=\"6\" cy=\"16\" r=\"3.5\"/><circle cx=\"18\" cy=\"16\" r=\"3.5\"/><path d=\"M6 16l3.5-7h5.5l3 7M9.5 9 12 16M14.5 9 13 6h2.5\"/>", "pin": "<path d=\"M12 21s-7-6-7-11.500a7 7 0 0 1 14 0C19 15 12 21 12 21z\"/><circle cx=\"12\" cy=\"9.500\" r=\"2.500\"/>"};var inv={};
function build(){if(typeof P==='undefined')return;for(var k in P)if(L[k]&&P[k])inv[P[k]]=k}
var XD={"M5 12.5l4.5 4.5L19 7.5": "<path d=\"M5 12.8l4.5 4.5L19 7.5\"/>", "M5 12l5 5L19 7": "<path d=\"M5 12.8l4.5 4.5L19 7.5\"/>", "M5 12l5 5 9-10": "<path d=\"M5 12.8l4.5 4.5L19 7.5\"/>", "M20 12H4.5M10.5 5.5L4 12l6.5 6.5": "<path d=\"M19 12H5M11 6l-6 6 6 6\"/>", "M20 12H4M10 6l-6 6 6 6": "<path d=\"M19 12H5M11 6l-6 6 6 6\"/>", "M9 5l7 7-7 7": "<path d=\"M9.5 6l6 6-6 6\"/>", "M9 6l6 6-6 6": "<path d=\"M9.5 6l6 6-6 6\"/>", "M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z": "<path d=\"M12 20S4 15 4 9.2A4.2 4.2 0 0 1 12 7.5 4.2 4.2 0 0 1 20 9.2C20 15 12 20 12 20z\"/>", "M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9z": "<path d=\"M12 3.8l2.5 5.2 5.6.8-4.1 4 1 5.6-5-2.7-5 2.7 1-5.6-4.1-4 5.6-.8z\"/>", "M3 11.5L21 3l-8.5 18-2-7.5z": "<path d=\"M20.4 3.6 4 9.4a1.1 1.1 0 0 0 0 2.1l6.2 2.4 2.4 6.2a1.1 1.1 0 0 0 2.1 0z\"/><path d=\"M10.2 13.9 20.4 3.6\"/>"},XS={"circle:cx=11,cy=11,r=6.5|path:d=M16 16l4 4": "<circle cx=\"10.5\" cy=\"10.5\" r=\"6.5\"/><path d=\"M15.5 15.5 20 20\"/>", "rect:x=5,y=11,width=14,height=9,rx=2|path:d=M8 11V8a4 4 0 0 1 8 0v3": "<rect x=\"4.5\" y=\"10.5\" width=\"15\" height=\"10\" rx=\"3.5\"/><path d=\"M8 10.5V8a4 4 0 0 1 8 0v2.5\"/>", "path:d=M6 3h12v18l-3-2-3 2-3-2-3 2z|path:d=M9 8h6M9 12h6": "<path d=\"M6 3.5h12a1.5 1.5 0 0 1 1.5 1.5v15.5l-2.6-1.6-2.4 1.6-2.5-1.6-2.5 1.6-2.4-1.6-2.6 1.6V5A1.5 1.5 0 0 1 6 3.5z\"/><path d=\"M8.5 9h7M8.5 13h4.5\"/>", "path:d=M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z|circle:cx=12,cy=10,r=2.5": "<path d=\"M12 21s-7-6-7-11.500a7 7 0 0 1 14 0C19 15 12 21 12 21z\"/><circle cx=\"12\" cy=\"9.500\" r=\"2.500\"/>"};
function sg(s){return [].map.call(s.children,function(e){return e.tagName.toLowerCase()+':'+[].map.call(e.attributes,function(a){return a.name+'='+a.value}).join(',')}).join('|')}
function fix(s){if(s.dataset.nl||s.getAttribute('viewBox')!=='0 0 24 24')return;var ps=s.querySelectorAll('path'),n=null;if(ps.length===1&&s.children.length===1){var d=ps[0].getAttribute('d'),k=inv[d];n=k?L[k]:XD[d]}if(!n)n=XS[sg(s)];if(!n)return;s.dataset.nl=1;s.innerHTML=n;if(s.getAttribute('stroke-width')==='2')s.setAttribute('stroke-width','2.25')}
function scan(r){if(r.nodeType!==1)return;if(r.matches&&r.matches('svg[viewBox="0 0 24 24"]'))fix(r);r.querySelectorAll&&r.querySelectorAll('svg[viewBox="0 0 24 24"]').forEach(fix)}
build();var q=[],t=0;new MutationObserver(function(ms){ms.forEach(function(m){m.addedNodes.forEach(function(n){q.push(n)})});if(!t){t=1;requestAnimationFrame(function(){setTimeout(function(){t=0;var l=q;q=[];l.forEach(scan)},40)})}}).observe(document.documentElement,{childList:true,subtree:true});
setTimeout(function(){scan(document.body)},200);
}catch(e){console.warn('itundalines',e)}})();</script>
<style id="v712css">
.p712 .h{padding:20px 20px 0}.p712 .h1b{font-size:26px;line-height:34px;font-weight:800;letter-spacing:-.8px}
.p712 .cap{font-size:14px;line-height:20px;color:var(--tt)}
.p712 .big{font-size:34px;line-height:44px;font-weight:800;letter-spacing:-1px;margin-top:2px}
.p712 .card{margin:16px 16px 0;border-radius:24px;background:var(--chip);padding:6px 0}
.p712 .r{display:flex;align-items:center;gap:14px;padding:0 20px;min-height:64px;cursor:pointer;transition:background .15s}
.p712 .r:active{background:rgba(127,127,140,.12)}
.p712 .ic{width:44px;height:44px;border-radius:15px;display:flex;align-items:center;justify-content:center;flex:none;font-weight:800;color:#fff;font-size:15px}
.p712 .t{font-size:17px;line-height:24px;font-weight:600;letter-spacing:-.3px;min-width:0;flex:1}
.p712 .t small{display:block;font-size:13px;line-height:18px;font-weight:400;color:var(--tt)}
.p712 .v{font-size:17px;font-weight:600;color:var(--lk)}.p712 .v.z{color:var(--tt);font-weight:500}
.p712 .ch{display:flex;gap:8px;padding:20px 16px 8px;overflow-x:auto}
.p712 .ch button{border:0;border-radius:999px;background:var(--chip);color:var(--tx);font:inherit;font-size:15px;font-weight:600;padding:10px 18px;white-space:nowrap;cursor:pointer}
.p712 .ch button.on{background:var(--tx);color:var(--bg)}
.p712 .sh{font-size:20px;line-height:28px;font-weight:700;letter-spacing:-.5px;padding:28px 20px 4px}
.p712 .pill{border:0;border-radius:14px;background:rgba(90,81,236,.16);color:var(--lk);font:inherit;font-weight:700;font-size:15px;padding:10px 18px;cursor:pointer;flex:none}
.p712 .pill.d{background:var(--chip);color:var(--tt)}
.p712 .go{display:block;margin:20px auto 0;border:0;border-radius:16px;background:var(--lk);color:#fff;font:inherit;font-weight:700;font-size:17px;padding:16px 26px;cursor:pointer}
.p712 .emp{text-align:center;padding:96px 24px 0}.p712 .emp b{display:block;font-size:20px;line-height:28px;margin-top:22px}
.p712 .in{display:block;width:calc(100% - 40px);margin:10px 20px 0;border:0;border-radius:16px;background:var(--chip);color:var(--tx);font:inherit;font-size:17px;padding:18px;outline:0}
.p712 .in:focus-visible{box-shadow:0 0 0 2px var(--lk)}
.p712 ul{margin:28px 0 0;padding:0 20px 0 40px;color:var(--tt);font-size:15px;line-height:26px}
.p712 .ad{margin:16px 16px 0;border-radius:24px;background:var(--chip);padding:22px 20px}
.p712 .ad .big{font-size:24px;line-height:32px}
.p712 .grp{margin:12px 16px 0;border-radius:24px;background:var(--chip);padding:4px 0}
.p712 .grp .r{min-height:60px;padding:8px 20px}
.p712 .bt{position:sticky;bottom:0;padding:12px 16px calc(12px + env(safe-area-inset-bottom,0px));background:var(--bg)}
.p712 .bt button{width:100%;height:56px;border:0;border-radius:18px;background:var(--lk);color:#fff;font:inherit;font-size:17px;font-weight:700;cursor:pointer}
.p712 .bt button:disabled{opacity:.4;cursor:default}
</style>
<script id="v712js">
(()=>{
const st=()=>S.p712||(S.p712={f:'all',co:[],q:'',code:'',lk:{mtn:1,bus:1,sim:1,inz:1}});
const BK=(t,x='')=>`<div class="bar"><button class="ib" aria-label="Back" onclick="back()">${ic('back',24)}</button><b>${t}</b>${x}</div>`;
const chev='<svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" style="color:var(--tt);flex:none"><path d="M6 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>';
const tile=(c,s)=>`<span class="ic" style="background:${c}">${s}</span>`;
const L0=[['own','itunda Points',()=>S.mpts||0,'#5A51EC','P','pmypts',1,0],['own','Pay Money',()=>S.pay,'#3B6FF6','W','pay',0,0],['own','Shop points',()=>0,'#14B8A6','S','',0,0],
['mtn','MTN MoMo Rewards',()=>78,'#F5B301','M','',1,1],['bus','Kigali Bus Points',()=>28,'#E6397D','B','',1,1],['sim','Simba Points',()=>62,'#F04452','Si','',1,1],['inz','Inzozi Market',()=>0,'#2DB873','I','',0,1]];
const CN=[['air','Airtel Rewards','#F04452','A'],['bor','Bourbon Coffee Club','#8B5CF6','Bo'],['hev','Heaven Rewards','#F2994A','H'],['saw','Sawa Citi Points','#14B8A6','Sa'],['yeg','Yego Points','#5B8CFF','Y']];
const hub=()=>{const s=st(),on=L0.filter(x=>x[0]==='own'||s.lk[x[0]]),tot=on.reduce((a,x)=>a+x[2](),0);
const vis=on.filter(x=>s.f==='all'||(s.f==='recv'&&x[6])||(s.f==='auto'&&x[7]));
const rows=vis.map(x=>`<div class="r" onclick="${x[5]?`ppGo('${x[5]}')`:`toast('${x[1]} is a sample in this prototype')`}">${tile(x[3],x[4])}<div class="t">${x[1]}</div><span class="v ${x[2]()?'':'z'}">${fmt(x[2]())}</span>${chev}</div>`).join('');
const cn=CN.filter(x=>!s.lk[x[0]]);
return `<div class="p712">${BK('Points')}<div class="card" style="margin-top:8px"><div class="r" style="min-height:76px" onclick="ppGo('pcfind')"><span class="ic" style="background:var(--lk)">%</span><div class="t"><small>itunda Points</small><span style="color:var(--lk)">See extra earning and discounts</span></div>${chev}</div></div>
<div class="h"><div class="cap">${on.length} points connected</div><div class="big">${fmt(tot)} RWF</div></div>
<div class="ch">${[['all','All '+on.length],['recv','Ready to claim '+on.filter(x=>x[6]).length],['auto','Auto-earn in store '+on.filter(x=>x[7]).length]].map(([k,n])=>`<button class="${s.f===k?'on':''}" onclick="S.p712.f='${k}';render('fade-none')">${n}</button>`).join('')}</div>
<div>${rows||'<div class="cap" style="padding:28px 20px">Nothing here yet.</div>'}</div>
<div class="sh">Points you can connect <span style="color:var(--lk)">${cn.length}</span></div><div class="cap" style="padding:0 20px">Join a programme and connect it right here.</div>
<div style="margin-top:8px">${cn.map(x=>`<div class="r" onclick="p712c('${x[0]}','${x[1]}')">${tile(x[2],x[3])}<div class="t">${x[1]}</div>${chev}</div>`).join('')||'<div class="cap" style="padding:12px 20px">All connected.</div>'}</div>
<div class="r" style="margin-top:20px" onclick="toast('Thanks, feedback noted (sample)')"><span class="ic" style="background:var(--chip);color:var(--tx)">…</span><div class="t"><small>Something to improve?</small>Send feedback</div></div><div style="height:32px"></div></div>`};
window.p712c=(k,n)=>{st().lk[k]=1;toast(n+' connected');render('fade-none')};
const my=()=>`<div class="p712">${BK('My points','<span style="margin-left:auto"></span>')}
<div class="h" style="display:flex;align-items:center;justify-content:space-between"><div><div class="cap">My points</div><div class="big">${fmt(S.mpts||0)} RWF</div></div><button class="pill d" onclick="openSvc&&toast('Cash out starts at 1,000 points')">Cash out</button></div>
<div class="ad"><div class="big">Up to 5% back on every purchase</div><div class="cap" style="margin-top:6px">With the itunda card</div><button class="go" style="margin:16px 0 0;width:100%" onclick="openCard()">See benefits</button></div>
<div class="sh">Browse here, get 1 RWF</div><div class="r" onclick="p712b()">${tile('#F2994A','K')}<div class="t">Kigali Bakery, fresh bread box<small>1,990 RWF · AD</small></div>${chev}</div>
<div class="sh">Swap points for vouchers</div>${[[500,'Bourbon Coffee','Latte voucher','#8B5CF6','Bo'],[300,'Simba Market','Snack voucher','#F04452','Si']].map(x=>`<div class="r" onclick="p712x(${x[0]},'${x[1]}')">${tile(x[3],x[4])}<div class="t"><b>${fmt(x[0])} RWF</b><small>${x[1]} | ${x[2]}</small></div>${chev}</div>`).join('')}<div style="height:32px"></div></div>`;
window.p712b=()=>{S.mpts=(S.mpts||0)+1;toast('+1 RWF point earned (sample)');render('fade-none')};
window.p712x=(p,n)=>{if((S.mpts||0)<p){toast('You need '+fmt(p)+' points, you have '+fmt(S.mpts||0));return}S.mpts-=p;st().co.push({n:n+' voucher',d:'Valid 30 days',id:'v'+Date.now()});toast('Swapped for a voucher. See Coupons');render('fade-none')};
const box=()=>{const c=st().co;return `<div class="p712">${BK('Coupons',`<span style="margin-left:auto;display:flex"><button class="ib" aria-label="Find coupons" onclick="ppGo('pcfind')">${ic('search',24)}</button><button class="ib" aria-label="Add coupon code" onclick="ppGo('pcreg')">${ic('plus',24)}</button></span>`)}
<div class="ch"><button class="on">Received ${c.length}</button><button onclick="toast('Prime perks are not in this prototype')">Prime perks</button></div>
${c.length?c.map(x=>`<div class="card" style="margin-top:10px"><div class="r" style="min-height:76px">${tile('#5B8CFF','%')}<div class="t">${x.n}<small>${x.d}</small></div><button class="pill" onclick="toast('Shown at checkout automatically (sample)')">Use</button></div></div>`).join(''):`<div class="emp"><svg width="72" height="72" viewBox="0 0 72 72" aria-hidden="true"><rect x="14" y="10" width="40" height="46" rx="8" fill="#2A2C36" transform="rotate(-10 34 33)"/><rect x="22" y="22" width="40" height="40" rx="8" fill="#2E5BDB" opacity=".7"/></svg><b>No coupons yet</b><div class="cap" style="margin-top:6px;font-size:16px">Shall we find some you can get right now?</div><button class="go" onclick="ppGo('pcfind')">Find new coupons</button></div>`}</div>`};
const OFF=[['Kigali Bakery','5% back when you pay with QR','#F2994A','Ki'],['Bourbon Coffee','500 RWF off your 3rd order','#8B5CF6','Bo'],['Simba Market','3.5% back after 3 purchases','#F04452','Si'],['Heaven Restaurant','1,000 RWF off dinner','#14B8A6','He']];
const find=()=>{const s=st(),q=s.q.toLowerCase(),got=n=>s.co.some(x=>x.n===n);return `<div class="p712">${BK('Find coupons')}<input class="in" id="p712q" placeholder="Search coupons" aria-label="Search coupons" value="${s.q.replace(/"/g,'')}" oninput="S.p712.q=this.value;p712f()"><div class="ch"><button class="on">Online</button><button onclick="toast('Offline coupons are a sample')">In store</button><button onclick="toast('Sample')">Food</button></div><div id="p712l">${list(q,got)}</div></div>`};
const list=(q,got)=>{const a=OFF.filter(x=>!q||(x[0]+x[1]).toLowerCase().includes(q));return a.length?a.map(x=>`<div class="r" style="min-height:76px">${tile(x[2],x[3])}<div class="t">${x[1]}<small>${x[0]}</small></div><button class="pill ${got(x[0])?'d':''}" onclick="p712g('${x[0]}','${x[1]}')">${got(x[0])?'Got it':'Get'}</button></div>`).join(''):'<div class="cap" style="padding:32px 20px">No coupons match that search.</div>'};
window.p712f=()=>{const s=st();document.getElementById('p712l').innerHTML=list(s.q.toLowerCase(),n=>s.co.some(x=>x.n===n))};
window.p712g=(n,d)=>{const s=st();if(s.co.some(x=>x.n===n))return;s.co.push({n,d});toast('Added to Coupons');p712f()};
const reg=()=>{const s=st();return `<div class="p712">${BK('Add coupon')}<div class="h"><div class="cap" style="color:var(--lk);font-weight:600">Coupon code</div></div><input class="in" id="p712c" placeholder="Enter your coupon code" autocapitalize="characters" value="${s.code}" oninput="S.p712.code=this.value;document.getElementById('p712b').disabled=!this.value.trim()"><ul><li>Registered coupons appear in Coupons.</li><li>Point coupons are credited as soon as you enter the code.</li><li>A coupon can only be registered once.</li><li>Registered coupons cannot be cancelled.</li><li>They cannot be refunded as cash and expire on their date.</li></ul><div class="bt"><button id="p712b" ${s.code.trim()?'':'disabled'} onclick="p712r()">Add</button></div></div>`};
window.p712r=()=>{const s=st(),c=s.code.trim().toUpperCase();if(s.used&&s.used[c]){toast('That code is already registered');return}if(c==='WELCOME500'){(s.used=s.used||{})[c]=1;S.pay+=500;toast('500 RWF added to itunda Pay');}else if(c==='COFFEE'){(s.used=s.used||{})[c]=1;s.co.push({n:'Free coffee',d:'Valid 14 days'});toast('Coupon added')}else{toast('We could not find that code. Try WELCOME500 (sample)');return}s.code='';back()};
const set=()=>{const R=(a,b,f,v='')=>`<div class="r" onclick="${f}"><div class="t">${a}${b?`<small>${b}</small>`:''}</div>${v?`<span class="cap">${v}</span>`:''}${chev}</div>`;
return `<div class="p712">${BK('Pay settings')}<div class="grp">${R('Pay by QR','Step-up verification, limit','openSettings()')}${R('Auto-pay','Bills and subscriptions',"toast('Open Auto top-up from Services')")}${R('Family pay','Share with someone you trust',"toast('Sample')")}</div>
<div class="grp">${R('Payment methods','itunda Pay, itunda Bank, card',"S.stack=[];tab('pay')")}</div><div class="grp">${R('Verification','Skip biometrics, step-up',"openSettings()")}</div><div class="grp">${R('Receipt details','',"toast('Sample')")}${R('Mobile money','MTN MoMo, Airtel Money',"toast('Sample')")}</div></div>`};
const _b=screens.benefits;Object.assign(screens,{ppoints:hub,pmypts:my,pcoupons:box,pcfind:find,pcreg:reg,pset:set});
const wire=()=>{document.querySelectorAll('#phone .z7rw').forEach(r=>{const t=r.textContent;const f=/Coupons received|Discount and cashback/i.test(t)?"ppGo('pcoupons')":/Points · Pay Money|Point missions/i.test(t)?"ppGo('ppoints')":'';if(f&&r.getAttribute('onclick')!==f)r.setAttribute('onclick',f)});
document.querySelectorAll('#phone .top').forEach(t=>{const g=t.querySelector('button[aria-label="Settings"]');if(g&&t.querySelector('.tp704bar')&&g.getAttribute('onclick')!=="ppGo('pset')")g.setAttribute('onclick',"ppGo('pset')")})};
new MutationObserver(wire).observe(document.getElementById('phone')||document.body,{childList:true,subtree:true});wire();
})();
</script>
<style id="v713">
/* v713 Pay code: one screen, three tabs (Scan / My code / Tap), payment-method carousel under the code */
.pcd{position:absolute;inset:0;background:#17171C;color:#fff;display:flex;flex-direction:column;overflow:hidden;z-index:3}
.pcd .pch{display:flex;align-items:center;justify-content:space-between;padding:8px 8px 0}
.pcd .ib{color:#fff!important;background:none!important;width:44px!important;height:44px!important;border-radius:0!important}
.pcd .tabs2{display:flex;border-bottom:1px solid #2E3744;margin-top:6px}
.pcd .tabs2 button{flex:1;min-height:48px;background:none;border:0;border-bottom:3px solid transparent;color:#8D97A6;font:inherit;font-size:16px;font-weight:500}
.pcd .tabs2 button[aria-selected=true]{color:#fff;font-weight:800;border-bottom-color:#fff}
.pcd .bd{flex:1;min-height:0;display:flex;flex-direction:column;position:relative}
.pcd .cam{position:absolute;inset:0;background:#2A303B}
.pcd .cam:after{content:"";position:absolute;left:0;right:0;bottom:0;height:42%;background:#17171C}
.pcd .scn{position:relative;flex:1;display:flex;flex-direction:column;align-items:center;padding-top:34px}
.pcd .scn h2{margin:0;font-size:20px;font-weight:500;text-align:center;padding:0 24px}
.pcd .sub{font-size:14px;color:#C5CCD6;margin-top:8px;min-height:20px;text-align:center;padding:0 24px}
.pcd .fr{position:relative;width:262px;height:262px;margin-top:26px;background:rgba(255,255,255,.14)}
.pcd .fr i{position:absolute;width:34px;height:34px;border:5px solid #8F89FF}
.pcd .fr.ok i{border-color:#2DD08B}.pcd .fr.bad i{border-color:#FF6B5E;animation:pcs .35s}
.pcd .fr:before,.pcd .fr:after{content:"";position:absolute;left:50%;top:50%;background:#8F89FF;transform:translate(-50%,-50%)}
.pcd .fr:before{width:28px;height:2px}.pcd .fr:after{width:2px;height:28px}
@keyframes pcs{0%,100%{transform:none}25%{transform:translateX(-8px)}75%{transform:translateX(8px)}}
.pcd .pills{display:flex;gap:8px;margin-top:22px}
.pcd .pill{min-height:44px;padding:0 13px;border-radius:22px;border:0;background:#333D4B;color:#fff;font:inherit;font-size:15px;font-weight:600;display:inline-flex;align-items:center;gap:8px}
.pcd .pill[aria-pressed=true]{background:#8F89FF;color:#17171C}
.pcd .chips{position:absolute;left:0;right:0;bottom:16px;padding:0 16px;display:flex;gap:8px;overflow-x:auto;scrollbar-width:none}
.pcd .chips::-webkit-scrollbar{display:none}
.pcd .chips button{flex:0 0 auto;min-height:44px;padding:0 16px;border-radius:22px;border:0;background:#333D4B;color:#fff;font:inherit;font-size:14px;font-weight:600}
.pcd .chl{position:absolute;left:20px;bottom:68px;font-size:12px;color:#8D97A6;font-weight:600}
.pcd .cardbox{margin:20px 20px 0;border-radius:28px;background:#fff;color:#191F28;padding:22px 18px 18px;text-align:center}
.pcd .cardbox .q{display:inline-block;padding:8px;border-radius:16px;background:#fff;line-height:0;border:1px solid #E5E8EB}
.pcd .tm{margin-top:12px;font-size:14px;color:#6B7684}.pcd .tm b{color:#191F28;font-variant-numeric:tabular-nums}
.pcd .src{margin-top:14px;display:flex;align-items:center;justify-content:center;gap:8px;font-size:16px;font-weight:800}
.pcd .src small{display:block;font-size:13px;font-weight:500;color:#6B7684}
.pcd .lnk{background:none;border:0;color:#B3AEFF;font:inherit;font-size:14px;font-weight:600;min-height:44px}
.pcd .tapw{flex:1;display:flex;align-items:center;justify-content:center;position:relative;min-height:0}
.pcd .tapw .rg{position:absolute;border-radius:50%;background:#1B2B66}
.pcd .tapw .r1{width:290px;height:290px;opacity:.55;animation:pcp 2.6s ease-in-out infinite}
.pcd .tapw .r2{width:200px;height:200px;opacity:.8;animation:pcp 2.6s .3s ease-in-out infinite}
.pcd .tapw .r3{width:104px;height:104px;border-radius:34px;background:#1F4BCC;display:flex;align-items:center;justify-content:center;opacity:1}
@keyframes pcp{0%,100%{transform:scale(.94)}50%{transform:scale(1.04)}}
@media(prefers-reduced-motion:reduce){.pcd .tapw .rg,.pcd .fr.bad i{animation:none}}
.pcd .tapt{position:absolute;bottom:6px;left:0;right:0;text-align:center;font-size:14px;color:#C5CCD6;padding:0 24px}
.pcd .pcar{position:relative;height:212px;flex:0 0 212px}
.pcd .pctip{position:absolute;top:0;left:50%;transform:translateX(-50%);background:#2F80FF;color:#fff;font-size:14px;font-weight:700;padding:9px 16px;border-radius:18px;white-space:nowrap;max-width:92%;overflow:hidden;text-overflow:ellipsis}
.pcd .pcrl{position:absolute;left:0;right:0;bottom:12px;height:150px;display:flex;align-items:flex-end;gap:14px;overflow-x:auto;scroll-snap-type:x mandatory;padding:0 calc(50% - 56px);scrollbar-width:none}
.pcd .pcrl::-webkit-scrollbar{display:none}
.pcd .pcmc{flex:0 0 auto;scroll-snap-align:center;border:0;border-radius:14px;width:82px;height:120px;color:#191F28;font:inherit;font-size:13px;font-weight:800;line-height:18px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;text-align:center;padding:6px}
.pcd .pcmc[aria-pressed=true]{width:112px;height:150px;font-size:15px}
.pcd .pcmc.pay{background:#13D663}.pcd .pcmc.bank{background:#7472F4;color:#fff}.pcd .pcmc.cardm{background:#1B1F2A;color:#fff;border:1px solid #3A4352}.pcd .pcmc.add{background:#333D4B;color:#fff;font-size:34px;font-weight:400}
.pcd .pcmc .bal{font-size:11px;font-weight:600;opacity:.8}
.pcd .pcmc:focus-visible,.pcd .pill:focus-visible,.pcd .tabs2 button:focus-visible,.pcd .chips button:focus-visible{outline:3px solid #B3AEFF;outline-offset:2px}
</style>
<script>
/* v713: Pay code. Before: the QR icon on Pay opened a bare camera screen; "My code" (for paying) did not exist, only "Receive money", and there was no way to pick what pays or to tap-to-pay. Now it is one screen with three tabs like the Naver Pay / Samsung Pay screens you sent: Scan (camera frame, flash, till number, photos, sample codes), My code (a QR that renews every 60 s with a countdown, and what pays: itunda Pay or itunda Bank), and Tap (ring animation, hold the phone to a terminal). Under My code and Tap there is a card carousel to pick the payment method (it sets the same "pay from" as the rest of Pay) with a one-line benefit bubble. Sending money still uses the old scanner. Sample data only; rw and fr copy is new and needs native review. */
{
const T3=window.T3,E=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
if(S.pcT===undefined)S.pcT=0;
const qr=(seed,z)=>{const N=25,c=8;let s=seed;const rnd=()=>{s=(s*1664525+1013904223)>>>0;return s/4294967296},g=[];
 for(let y=0;y<N;y++){g[y]=[];for(let x=0;x<N;x++)g[y][x]=rnd()<.5}
 const fin=(ox,oy)=>{for(let i=-1;i<8;i++)for(let j=-1;j<8;j++){const x=ox+i,y=oy+j;if(x>=0&&y>=0&&x<N&&y<N)g[y][x]=false}for(let y=0;y<7;y++)for(let x=0;x<7;x++)g[oy+y][ox+x]=x===0||y===0||x===6||y===6||(x>=2&&x<=4&&y>=2&&y<=4)};
 fin(0,0);fin(N-7,0);fin(0,N-7);
 for(let y=0;y<N;y++)for(let x=0;x<N;x++)if(Math.abs(x-12)<=4&&Math.abs(y-12)<=4)g[y][x]=false;
 let d='';for(let y=0;y<N;y++)for(let x=0;x<N;x++)if(g[y][x])d+=`M${x*c} ${y*c}h${c}v${c}h-${c}z`;
 return `<svg viewBox="0 0 ${N*c} ${N*c}" width="${z}" height="${z}" role="img" aria-label="${T3('Your payment code (sample)','Kode yawe yo kwishyura (icyitegererezo)','Votre code de paiement (exemple)')}"><rect width="${N*c}" height="${N*c}" fill="#fff"/><path d="${d}" fill="#111"/><circle cx="100" cy="100" r="30" fill="#fff"/><circle cx="100" cy="100" r="25" fill="#7472F4"/><text x="100" y="109" text-anchor="middle" font-size="26" font-weight="800" fill="#fff" font-family="sans-serif">i</text></svg>`};

const svg=(p,z=22)=>`<svg width="${z}" height="${z}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${p}</svg>`;
const BOLT=svg('<path d="M13 2L4 14h7l-1 8 9-12h-7z"/>'),IMG=svg('<rect x="3" y="4" width="18" height="16" rx="3"/><circle cx="9" cy="10" r="1.8"/><path d="M4 18l5-5 4 4 3-3 4 4"/>'),PEN=svg('<path d="M4 20l4-1 11-11a2.1 2.1 0 00-3-3L5 16z"/>'),CHV=svg('<path d="M6 9l6 6 6-6"/>',18);
const GEAR='<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M10 4.77L10.6 2.6L13.4 2.6L14 4.77A7.5 7.5 0 0 1 15.69 5.47L15.69 5.47L17.65 4.36L19.64 6.35L18.53 8.31A7.5 7.5 0 0 1 19.23 10L19.23 10L21.4 10.6L21.4 13.4L19.23 14A7.5 7.5 0 0 1 18.53 15.69L18.53 15.69L19.64 17.65L17.65 19.64L15.69 18.53A7.5 7.5 0 0 1 14 19.23L14 19.23L13.4 21.4L10.6 21.4L10 19.23A7.5 7.5 0 0 1 8.31 18.53L8.31 18.53L6.35 19.64L4.36 17.65L5.47 15.69A7.5 7.5 0 0 1 4.77 14L4.77 14L2.6 13.4L2.6 10.6L4.77 10A7.5 7.5 0 0 1 5.47 8.31L5.47 8.31L4.36 6.35L6.35 4.36L8.31 5.47A7.5 7.5 0 0 1 10 4.77Z"/></svg>';
const bal=()=>S.psrc==='bank'?S.bank:S.pay,srcN=()=>S.psrc==='bank'?'itunda Bank':'itunda Pay Money';
const TL={'123456':'Kigali Bakery','204518':'Nyamirambo Coffee House','731902':'Simba Supermarket'};
const tabs=[T3('Scan','Sikana','Scanner'),T3('My code','Kode yanjye','Mon code'),T3('Tap','Gukoza','Sans contact')];
const tipT=()=>S.psrc==='bank'?T3('Pay straight from your bank account','Ishyura ukoresheje konti ya banki','Payez depuis votre compte bancaire'):T3('Earn 3% back with itunda Pay Money','Ubone 3% ukoresheje itunda Pay Money','Gagnez 3 % avec itunda Pay Money');
const carH=()=>`<div class="pcar"><div class="pctip" role="status">${tipT()}</div><div class="pcrl" id="pcrail" role="group" aria-label="${T3('Pay with','Ishyura ukoresheje','Payer avec')}">
<button class="pcmc pay" aria-pressed="${S.psrc!=='bank'}" onclick="pcSrc('pay')"><b>itunda<br>Pay Money</b><span class="bal">${fmt(S.pay)}</span></button>
<button class="pcmc bank" aria-pressed="${S.psrc==='bank'}" onclick="pcSrc('bank')"><b>itunda<br>Bank</b><span class="bal">${fmt(S.bank)}</span></button>
<button class="pcmc cardm" aria-pressed="false" onclick="openCard()"><b>${S.card?'itunda card<br>··'+S.card.last:T3('Get the<br>itunda card','Fata ikarita<br>itunda','Obtenir la<br>carte itunda')}</b></button>
<button class="pcmc add" aria-label="${T3('Add money','Ongeramo amafaranga','Ajouter de l’argent')}" onclick="sheetAdd()">+</button></div></div>`;
const qrSeed=()=>Math.floor(Date.now()/60000)*7919+(S.psrc==='bank'?13:0);
const codeCard=()=>`<div class="cardbox"><div class="q" id="pcdq">${qr(qrSeed(),216)}</div>
<div class="tm" id="pcdt" role="timer">${T3('Renews in','Kongera mu','Renouvelé dans')} <b>0:${String(60-Math.floor(Date.now()/1000)%60).padStart(2,'0')}</b></div>
<div class="src" ><span><small>${T3('Pays from','Yishyura ikoresheje','Payé depuis')}</small>${srcN()} · ${fmt(bal())} RWF</span></div></div>
<div style="display:flex;justify-content:center;gap:4px;flex-wrap:wrap"><button class="lnk" onclick="ppGo('rcode')">${T3('Receive money instead','Akira amafaranga','Recevoir de l’argent')}</button><button class="lnk" onclick="pcMerch('123456')">${T3('Prototype: a shop scans this','Prototype: umucuruzi arayisikana','Prototype : un commerçant scanne')}</button></div>`;
const scan=()=>`<div class="cam"></div><div class="scn"><h2 id="pcst">${T3('Scan a QR code to pay','Sikana kode ya QR wishyure','Scannez un code QR pour payer')}</h2><div class="sub" id="pcsh" role="status" aria-live="polite">${T3('Shops and friends both work.','Abacuruzi n’inshuti byose bikora.','Commerçants et amis fonctionnent.')}</div>
<div class="fr" id="pcfr">${['top:0;left:0;border-right:0;border-bottom:0;border-radius:18px 0 0 0','top:0;right:0;border-left:0;border-bottom:0;border-radius:0 18px 0 0','bottom:0;left:0;border-right:0;border-top:0;border-radius:0 0 0 18px','bottom:0;right:0;border-left:0;border-top:0;border-radius:0 0 18px 0'].map(s=>`<i style="${s}"></i>`).join('')}</div>
<div class="pills"><button class="pill" aria-pressed="${!!S.scFl}" onclick="pcFlash(this)">${BOLT}${T3('Flash','Itara','Flash')}</button><button class="pill" onclick="S.stack[S.stack.length-1]='paytill';render('fade-none')">${PEN}${T3('Till number','Nimero','N° de caisse')}</button><button class="pill" onclick="pcBad()">${IMG}${T3('Photos','Amafoto','Photos')}</button></div></div>
<div class="chl">${T3('Try a sample code (prototype)','Gerageza kode y’icyitegererezo','Essayez un code d’exemple')}</div>
<div class="chips"><button onclick="pcHit(()=>scPerson('0788 000 214'))">Amina K.</button>${Object.entries(TL).map(([k,n])=>`<button onclick="pcHit(()=>pcMerch('${k}'))">${E(n)}</button>`).join('')}<button onclick="pcBad()">${T3('Unreadable code','Kode itasomeka','Code illisible')}</button></div>`;
const tap=()=>`<div class="tapw"><div class="rg r1"></div><div class="rg r2"></div><div class="rg r3"><svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M7 7a7 7 0 010 10M11 4.5a11 11 0 010 15M15 2a15 15 0 010 20"/></svg></div></div>
<div style="padding:0 24px 8px;display:flex;justify-content:space-between;align-items:flex-end"><div><div style="font-size:14px;color:#C5CCD6">${srcN()}</div><div style="font-size:22px;font-weight:800">${fmt(bal())} RWF</div></div><button class="lnk" onclick="pcMerch('204518')">${T3('Prototype: tap a terminal','Prototype: koza ku cyuma','Prototype : approcher un terminal')}</button></div>
<div style="padding:0 24px 8px;font-size:14px;color:#C5CCD6">${T3('Hold the back of your phone near the payment terminal.','Shyira inyuma ya telefoni hafi y’icyuma cyo kwishyura.','Approchez l’arrière du téléphone du terminal.')}</div>`;
screens.pcode=()=>{const t=S.pcT;return `<div class="pcd"><div class="pch"><button class="ib" aria-label="${T3('Back','Subira inyuma','Retour')}" onclick="back()">${ic('back',24)}</button><button class="ib" aria-label="${T3('Pay settings','Igenamiterere ryo kwishyura','Réglages de paiement')}" onclick="ppGo('pset')">${GEAR}</button></div>
<div class="tabs2" role="tablist">${tabs.map((n,i)=>`<button role="tab" aria-selected="${t===i}" onclick="pcTab(${i})">${n}</button>`).join('')}</div>
<div class="bd" role="tabpanel">${t===0?scan():t===1?`<div style="flex:1;overflow-y:auto">${codeCard()}</div>${carH()}`:`${tap()}${carH()}`}</div></div>`};
window.pcTab=i=>{S.pcT=i;render('fade-none')};
window.pcSrc=k=>{S.psrc=k;render('fade-none');const r=document.getElementById('pcrail');if(r){const b=r.querySelector('[aria-pressed=true]');b&&b.scrollIntoView({inline:'center',block:'nearest'})}};
window.pcSheet=()=>{const el=document.querySelector('.pcd .src');el&&el.scrollIntoView&&0;pcTab(S.pcT)};
window.pcFlash=b=>{const on=b.getAttribute('aria-pressed')!=='true';S.scFl=on;b.setAttribute('aria-pressed',on);const c=document.querySelector('.pcd .cam');if(c)c.style.background=on?'#4A5160':'#2A303B'};
window.pcMerch=k=>{S.scanFor='pay';S.pm={n:TL[k],sub:T3('Till','Nimero','Caisse')+' '+k,amt:'',g:'bag'};S.stack[S.stack.length-1]='payamt';render('push')};
window.pcHit=fn=>{const f=document.getElementById('pcfr');if(!f||f.dataset.b)return;f.dataset.b=1;f.className='fr ok';document.getElementById('pcst').textContent=T3('Code found','Kode yabonetse','Code détecté');document.getElementById('pcsh').textContent='';try{navigator.vibrate&&navigator.vibrate(15)}catch(e){}setTimeout(()=>{if(S.stack[S.stack.length-1]==='pcode')fn()},550)};
window.pcBad=()=>{const f=document.getElementById('pcfr');if(!f||f.dataset.b)return;f.dataset.b=1;f.className='fr bad';const t=document.getElementById('pcst'),h=document.getElementById('pcsh'),o=t.textContent,oh=h.textContent;t.textContent=T3('Can’t read this code','Kode ntisomwa','Code illisible');h.textContent=T3('This is not an itunda or shop code. Try again, or type the till number.','Iyi si kode ya itunda cyangwa y’umucuruzi. Ongera ugerageze, cyangwa wandike nimero.','Ce n’est pas un code itunda ou commerçant. Réessayez ou saisissez le numéro.');setTimeout(()=>{if(!document.getElementById('pcfr'))return;f.className='fr';delete f.dataset.b;t.textContent=o;h.textContent=oh},2200)};
/* the code renews every 60 s: update the countdown, redraw the QR at 0 */
setInterval(()=>{const t=document.getElementById('pcdt'),q=document.getElementById('pcdq');if(!t||!q)return;const s=60-Math.floor(Date.now()/1000)%60;t.querySelector('b').textContent='0:'+String(s).padStart(2,'0');if(s===60||q.dataset.k!==String(qrSeed())){q.innerHTML=qr(qrSeed(),216);q.dataset.k=qrSeed()}},1000);
const _g=window.ppGo;window.ppGo=n=>{if(n==='paysc'&&S.scanFor!=='send'){S.scanFor='pay';S.pcT=0;S.stack.push('pcode');render('push');return}_g(n)};
document.querySelectorAll('title').forEach(t=>t.textContent=t.textContent.replace('v712','v713'));
}
</script>
<script>
/* v714: Pay code, closer to the Naver Pay screens. (1) Tap tab: a "Top up" link beside the balance, like the "충전" link on the Samsung Pay tab. (2) My code with a 0 balance: instead of a QR that cannot pay, an empty state with "Add money" and a one-tap switch to the other source, like the "add a card" state. Sample data only; rw and fr copy needs native review. */
{
const T=window.T3,_pc=screens.pcode;
screens.pcode=()=>{let h=_pc();const bal=S.psrc==='bank'?S.bank:S.pay,other=S.psrc==='bank'?'pay':'bank',oN=other==='bank'?'itunda Bank':'itunda Pay Money';
 if(S.pcT===2)h=h.replace(/(<div style="font-size:22px;font-weight:800">[^<]*<\/div>)/,'$1<button class="lnk" style="padding:0;min-height:44px" onclick="sheetAdd()">'+T('Top up','Ongeramo','Recharger')+'</button>');
 if(S.pcT===1&&bal<=0)h=h.replace(/<div class="cardbox">[\s\S]*?<\/span><\/div><\/div>/,'<div class="cardbox" style="padding:28px 18px 22px"><div style="font-size:20px;font-weight:800;line-height:28px">'+T('Add money to pay','Ongeramo amafaranga wishyure','Ajoutez de l’argent pour payer')+'</div><div style="font-size:14px;color:#6B7684;margin-top:6px">'+T('This source has no balance yet.','Nta mafaranga ahari.','Cette source n’a pas encore de solde.')+'</div><button class="btn" style="margin-top:20px" onclick="sheetAdd()">'+T('Add money','Ongeramo amafaranga','Ajouter de l’argent')+'</button><button class="btn sec2" style="margin-top:10px" onclick="pcSrc(\''+other+'\')">'+T('Pay with ','Ishyura ukoresheje ','Payer avec ')+oN+'</button></div>');
 return h};
document.querySelectorAll('title').forEach(t=>t.textContent=t.textContent.replace('v713','v714'));
}
</script>
<script>
/* v715: Top up is now a full screen, like the Toss Pay Money top-up screens you sent. Before: a small sheet with two mobile-money buttons that only worked from MTN or Airtel. Now: pick the source (itunda Bank, MTN MoMo, Airtel Money, each with its balance, tap the name to switch), see the amount as a big number, add it with +1,000 / +5,000 / +10,000 chips or type it on the keypad, then Confirm. The money really moves in the prototype: the source goes down, itunda Pay goes up, and a too-large amount is blocked with a message. Every "Add money" and "Top up" button on Pay opens it. Sample balances; rw and fr copy needs native review. */
{
const T=window.T3;
S.tpSrc=S.tpSrc||'bank';S.tpAmt=S.tpAmt||'';S.tpBal=S.tpBal||{momo:85000,airtel:12000};
const SRC=()=>[{k:'bank',n:'itunda Bank',sub:T('Your itunda account','Konti yawe ya itunda','Votre compte itunda'),b:S.bank},{k:'momo',n:'MTN MoMo',sub:'0788 000 214',b:S.tpBal.momo},{k:'airtel',n:'Airtel Money',sub:'0733 000 214',b:S.tpBal.airtel}];
const cur=()=>SRC().find(x=>x.k===S.tpSrc)||SRC()[0];
screens.ptop=()=>{const a=+S.tpAmt||0,s=cur(),bad=a>s.b,ks=['1','2','3','4','5','6','7','8','9','','0','⌫'];
 return `${bar(T('Top up itunda Pay','Ongeramo muri itunda Pay','Recharger itunda Pay'))}<div class="pad" style="padding-top:8px"><button onclick="tpSheet()" style="display:flex;align-items:center;gap:6px;border:0;background:none;color:var(--tx);font:inherit;font-size:20px;font-weight:800;min-height:44px;padding:0">${s.n}<span aria-hidden="true" style="font-size:14px;color:var(--tt)">▾</span></button><div class="mu" style="font-size:14px">${s.sub} · ${T('Balance','Asigaye','Solde')} ${fmt(s.b)} RWF</div>
<div style="margin-top:28px;font-size:34px;font-weight:800;letter-spacing:-.6px;color:${a?'var(--tx)':'var(--tt)'}" role="status" aria-live="polite">${fmt(a)} <span style="font-size:20px;color:var(--mu)">RWF</span></div>
<div class="mu" style="font-size:14px;min-height:22px;margin-top:2px;color:${bad?'var(--er)':'var(--mu)'}">${bad?T('That is more than your balance in '+s.n+'.','Ni byinshi kuruta asigaye muri '+s.n+'.','C’est plus que votre solde '+s.n+'.'):a?'':T('How much would you like to add?','Ni angahe ushaka kongeramo?','Combien souhaitez-vous ajouter ?')}</div>
<div class="req" style="margin-top:14px">${[1000,5000,10000].map(v=>`<button onclick="tpAdd(${v})">+${fmt(v)}</button>`).join('')}</div></div>
<div class="pad" style="padding-top:20px"><button class="btn" ${!a||bad?'disabled':''} onclick="tpGo()">${a?T('Add ','Ongeramo ','Ajouter ')+fmt(a)+' RWF':T('Confirm','Emeza','Confirmer')}</button></div>
<div style="display:grid;grid-template-columns:repeat(3,1fr);padding:8px 24px 0">${ks.map(k=>k?`<button aria-label="${k==='⌫'?T('Delete last digit','Siba umubare wanyuma','Supprimer le dernier chiffre'):k}" onclick="tpKey('${k}')" style="height:56px;border:0;background:none;color:var(--tx);font:inherit;font-size:26px;font-weight:500">${k}</button>`:'<span></span>').join('')}</div>`};
window.tpKey=k=>{let v=S.tpAmt;if(k==='⌫')v=v.slice(0,-1);else if(v.length<8&&!(v===''&&k==='0'))v+=k;S.tpAmt=v;render('fade-none')};
window.tpAdd=n=>{S.tpAmt=String(Math.min(99999999,(+S.tpAmt||0)+n));render('fade-none')};
window.tpSheet=()=>{$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="h1" style="font-size:22px;line-height:30px;margin-bottom:8px">${T('Top up from','Ongeramo uvuye','Recharger depuis')}</div>${SRC().map(x=>`<div class="row tap" style="padding:14px 0" onclick="S.tpSrc='${x.k}';closeSheet();render('fade-none')"><div><b style="font-size:17px">${x.n}</b><div class="sm mu">${fmt(x.b)} RWF</div></div><div class="r" style="color:var(--lk)">${S.tpSrc===x.k?'✓':''}</div></div>`).join('')}</div>`};
window.tpGo=()=>{const a=+S.tpAmt||0,s=cur();if(!a||a>s.b)return;if(s.k==='bank')S.bank-=a;else S.tpBal[s.k]-=a;S.pay+=a;S.tpAmt='';S.stack.pop();render('pop');toast(T('Added ','Hongeweho ','Ajouté ')+fmt(a)+' RWF → itunda Pay')};
window.sheetAdd=()=>{S.tpAmt='';S.stack.push('ptop');render('push')};
document.querySelectorAll('title').forEach(t=>t.textContent=t.textContent.replace('v714','v715'));
}
</script>
<script>
/* v716: Pay home gets a "This month" benefits card and a Coupon box, from the Toss Pay home and coupon screens you sent. The card shows cashback received, points and Pay Money, and coupons held; it opens the Coupon box. The box has an empty state with "Find a coupon" and a "+" to add one by code. Add by code: Register stays off until you type; WELCOME500 pays 500 RWF into itunda Pay at once, BAKERY10 adds a 10% Kigali Bakery coupon, a repeated code is refused, an unknown code gets a clear message. Sample data only; rw and fr copy needs native review. */
{
const T=window.T3;S.cpn=S.cpn||[];S.cpIn='';S.cpUsed=S.cpUsed||{};
const CODES={WELCOME500:{pay:500,n:'Welcome gift'},BAKERY10:{n:'Kigali Bakery',d:'10% off your next QR payment'}};
const _p=screens.pay;
screens.pay=()=>{let h=_p();const card=`<div class="sec" style="padding-bottom:0"><div class="sech">${T('This month','Uku kwezi','Ce mois-ci')}</div>${row('gift',T('Cashback received','Amafaranga wagaruriwe','Cashback reçu'),T('Paid back on QR and card','Yagaruwe kuri QR n’ikarita','Remboursé sur QR et carte'),'1,200 RWF')}${row('star',T('Points · Pay Money','Amanota · Pay Money','Points · Pay Money'),'','6,400')}${row('tag',T('Coupon box','Amakuponi','Coupons'),S.cpn.length?S.cpn.length+' '+T('ready to use','yiteguye','prêts'):T('No coupons yet','Nta kuponi','Aucun coupon'),'','openCoupons()')}</div>`;
 const re=/<div class="sec"[^>]*><div class="sech">More<\/div>/;return re.test(h)?h.replace(re,m=>card+m):h+card};
window.openCoupons=()=>{S.stack.push('coupons');render('push')};
screens.coupons=()=>`${bar(T('Coupon box','Amakuponi','Coupons'))}<div class="pad" style="padding-top:8px;display:flex;justify-content:space-between;align-items:center"><div style="font-size:15px;font-weight:700">${T('Received','Yakiriwe','Reçus')} ${S.cpn.length}</div><button class="ib" aria-label="${T('Add a coupon by code','Ongeraho kuponi ukoresheje kode','Ajouter un coupon par code')}" onclick="S.cpIn='';S.stack.push('cpnadd');render('push')">${ic('plus',24)}</button></div>${S.cpn.length?`<div class="sec">${S.cpn.map(c=>row('tag',c.n,c.d)).join('')}</div>`:`<div style="display:flex;flex-direction:column;align-items:center;padding-top:clamp(40px,14vh,160px);text-align:center"><div class="g3">${gl('voucher',96)}</div><div class="h1" style="font-size:20px;line-height:28px;margin-top:20px">${T('You have no coupons','Nta kuponi ufite','Vous n’avez aucun coupon')}</div><div class="mu" style="font-size:15px;margin-top:6px">${T('Have a code? Add it to get started.','Ufite kode? Yongereho utangire.','Un code ? Ajoutez-le pour commencer.')}</div><button class="btn" style="width:auto;padding:0 28px;margin-top:20px" onclick="S.cpIn='';S.stack.push('cpnadd');render('push')">${T('Add a coupon','Ongeraho kuponi','Ajouter un coupon')}</button></div>`}`;
screens.cpnadd=()=>`${bar(T('Add a coupon','Ongeraho kuponi','Ajouter un coupon'))}<div class="pad" style="padding-top:20px"><div class="lab" style="color:var(--lk)">${T('Coupon code','Kode ya kuponi','Code du coupon')}</div><input class="in" id="cpin" autocapitalize="characters" autocomplete="off" placeholder="${T('Enter your coupon code','Andika kode ya kuponi','Saisissez votre code')}" style="font-size:17px;height:52px" oninput="S.cpIn=this.value.trim().toUpperCase();document.getElementById('cpgo').disabled=!S.cpIn;document.getElementById('cper').textContent=''"><div id="cper" role="alert" style="color:var(--er);font-size:14px;min-height:20px;margin-top:8px"></div><ul class="mu" style="font-size:14px;line-height:22px;padding-left:18px;margin-top:16px"><li>${T('Coupons you add show up in your Coupon box.','Amakuponi wongeyeho agaragara mu kabati kawe.','Les coupons ajoutés apparaissent dans votre boîte.')}</li><li>${T('Money coupons are paid in right away.','Amakuponi y’amafaranga yishyurwa ako kanya.','Les coupons en argent sont crédités aussitôt.')}</li><li>${T('A coupon can only be added once, and cannot be cancelled.','Kuponi yongerwaho rimwe gusa.','Un coupon ne peut être ajouté qu’une fois.')}</li><li>${T('Coupons cannot be refunded for cash and expire.','Amakuponi ntasubizwa mu mafaranga kandi ararangira.','Les coupons ne sont pas remboursables et expirent.')}</li></ul></div><div class="cta"><button class="btn" id="cpgo" disabled onclick="cpReg()">${T('Register','Andika','Enregistrer')}</button></div>`;
window.cpReg=()=>{const k=S.cpIn,c=CODES[k],e=document.getElementById('cper');if(!c){e.textContent=T('We can’t find that code. Check it and try again.','Ntitubonye iyo kode. Ongera ugerageze.','Code introuvable. Vérifiez et réessayez.');return}if(S.cpUsed[k]){e.textContent=T('You already added this coupon.','Wamaze kongeraho iyi kuponi.','Vous avez déjà ajouté ce coupon.');return}S.cpUsed[k]=1;if(c.pay){S.pay+=c.pay;toast(T('Added ','Hongeweho ','Ajouté ')+fmt(c.pay)+' RWF → itunda Pay')}else{S.cpn.push(c);toast(T('Coupon added','Kuponi yongeweho','Coupon ajouté'))}S.stack.pop();render('pop')};
document.querySelectorAll('title').forEach(t=>t.textContent=t.textContent.replace('v715','v716'));
}

/* v717: Pay tab, arranged like the Toss Pay home. Before: the Toss-style top (map, earn card, How to pay online, Benefits, Get more benefits, History) was followed by the old Pay screen: a "Pay in store" code card and a "Wallet" card that repeated the payment method and the balance, and the v716 "This month" card (Cashback, Points, Coupon box) was stuck at the very bottom under FAQ, repeating "Benefits received" above. Points, Pay Money and Coupons showed up two or three times. Now one order, top to bottom, as in Toss Pay: header, map, earn card with the payment method, How to pay online, Benefits received (Points · Pay Money, Coupons received with its count, opens the Coupon box), Get more benefits, History, FAQ and Send feedback. The payment code lives behind the QR icon (v713), and the payment method rows open the Pay Money screen. Sample data only. */
{
const _p=screens.pay;
screens.pay=function(){const h=_p.apply(this,arguments);if(typeof h!=='string')return h;
 const d=document.createElement('div');d.innerHTML=h;
 d.querySelectorAll('.pph,.leg704').forEach(e=>e.remove());
 d.querySelectorAll('.sec').forEach(s=>{const c=s.querySelector('.sech');if(c&&/^(This month|Uku kwezi|Ce mois-ci)$/.test(c.textContent.trim()))s.remove()});
 d.querySelectorAll('.mrow703,.pm704').forEach(e=>e.setAttribute('onclick',"ppGo('mpmy')"));
 d.querySelectorAll('.z7rw[onclick*="pcoupons"]').forEach(r=>{const t=r.querySelector('.z7rt');if(t&&/Coupons received|Amakuponi|Coupons reçus/.test(t.textContent)){r.setAttribute('onclick','openCoupons()');if(!r.querySelector('.z7am'))t.insertAdjacentHTML('afterend','<span class="z7am" style="color:var(--tt)">'+(S.cpn||[]).length+'</span>')}});
 return d.innerHTML};
document.querySelectorAll('title').forEach(t=>t.textContent=t.textContent.replace('v716','v717'));
}
</script>
<script>
/* v718: Pay tab, two fixes. (1) v717 meant to remove the "Pay in store" barcode + QR card from the Pay tab, but that card is added to the page after the screen is drawn, so v717's clean-up never saw it and it still pushed everything down. It is now hidden for good (the payment code lives behind the QR icon, v713). (2) The Pay tab never showed the balance. Now a balance card sits right under the map, as on the Toss Pay home: "itunda Pay Money", the amount number-first with a grey RWF, and Send / Add money buttons (Add money opens the v715 top-up screen). Sample data only; rw and fr copy needs native review. */
{
const T=window.T3,_p=screens.pay;
const st=document.createElement('style');st.textContent='.pay347 .pph{display:none!important}.pay347 .bal718{margin:16px 24px 0;padding:18px 20px 20px;border-radius:24px;background:var(--chip)}.bal718 .l{font-size:14px;color:var(--mu);font-weight:600}.bal718 .n{font-size:34px;font-weight:800;letter-spacing:-.6px;margin-top:4px;font-variant-numeric:tabular-nums}.bal718 .n span{font-size:20px;color:var(--mu);font-weight:700}.bal718 .row2{margin-top:16px;padding:0}.bal718 .sec2{background:var(--tint)!important;color:var(--tintfg)!important}';
document.head.appendChild(st);
screens.pay=function(){const h=_p.apply(this,arguments);if(typeof h!=='string'||h.includes('bal718'))return h;
 return h};
document.querySelectorAll('title').forEach(x=>x.textContent=x.textContent.replace('v717','v718'));
}
</script>
<script>
/* v720: the balance card from v718 (itunda Pay Money, amount, Send, Add money) is removed again; the Pay in store card stays hidden. */
/* v719: Pay tab, coupons. Before: the "Coupons received" row on Pay opened an older, separate coupon screen (set up after the page draws, so v717's change never reached it), so the Coupon box from v716 with "Add a coupon" and WELCOME500 / BAKERY10 could not be reached from Pay, and the row showed no count. Now the row opens the v716 Coupon box and shows how many coupons you hold. Also the browser tab title now shows the real version (it was stuck at v713). Sample data only. */
{
const _go=window.ppGo;
window.ppGo=function(n){if(n==='pcoupons'&&typeof openCoupons==='function')return openCoupons();return _go.apply(this,arguments)};
const fix=()=>{document.querySelectorAll('#phone .z7rw').forEach(r=>{const t=r.querySelector('.z7rt');if(!t||!/Coupons received|Amakuponi|Coupons reçus/.test(t.textContent))return;if(r.getAttribute('onclick')!=='openCoupons()')r.setAttribute('onclick','openCoupons()');const n=String((S.cpn||[]).length);let a=r.querySelector('.z7am');if(!a){t.insertAdjacentHTML('afterend','<span class="z7am" style="color:var(--tt)"></span>');a=r.querySelector('.z7am')}if(a.textContent!==n)a.textContent=n})};
const ph=document.getElementById('phone');if(ph){let q=0;new MutationObserver(()=>{if(q)return;q=1;requestAnimationFrame(()=>{q=0;fix()})}).observe(ph,{childList:true,subtree:true});fix()}
document.title='itunda, clickable prototype v720';
document.querySelectorAll('title').forEach(x=>x.textContent='itunda, clickable prototype v720');
}
</script>
<script>
/* v721: Pay Money, using your Toss Pay Money screens (detail with Move and Top up, the top-up amount screen, the Move amount screen). Before: (1) the payment-method rows on the Pay tab opened the Maps "MY" page (v717 pointed them at the wrong screen), so the Pay Money detail with Move, Top up and the ledger could not be reached from Pay. (2) Every "Add money" / "Top up" button opened the v715 screen, which moved the money but left no line in the ledger and ignored the daily limit, so a top-up never showed up as "time | MTN MoMo -> Pay" the way it does in Toss. Now the rows open the Pay Money detail, and Add money / Top up open the full Top up screen (source picker, +10,000 / +50,000 / +100,000 chips, "All" chip, daily limit, a ledger line after Confirm). Move to itunda Bank already worked and also writes a ledger line. Sample data only. */
{
const _go=window.ppGo;
window.ppGo=function(n){if(n==='mpmy'&&typeof openPayDetail==='function')return openPayDetail();return _go.apply(this,arguments)};
window.sheetAdd=function(){if(typeof openTopUp==='function')return openTopUp();return 0};
document.title='itunda, clickable prototype v721';
document.querySelectorAll('title').forEach(x=>x.textContent='itunda, clickable prototype v721');
}
</script>
<style id="v722css">
/* v722: itunda Bank account screen, matched to your Toss Bank account screen. Before: Fill and Send sat under the balance (v438), a "Free delivery" promo could show in the list, and the interest row read "Interest accrued through yesterday" with a bold number. Now: Fill and Send are fixed at the bottom like Toss (the list scrolls behind them), the promo is gone, and the interest row has a small line with the amount so far and a bold status line. */
#phone .bkact{display:none!important}
#phone:has(.bkact) .cta{display:flex!important}
#phone .bdnew{display:none!important}
#phone .screen:has(.bdband){padding-bottom:104px}
#phone .top .hbk{gap:2px!important}
#phone .top .hbk>svg:first-child{width:24px!important;height:24px!important}
#phone .top .hbk>svg:first-child g{stroke:#8E919B!important}
#phone .top .hbk>svg:last-child:not(:first-child){display:block!important;width:16px!important;height:16px!important;stroke:#8E919B!important;margin-left:-2px;position:relative;top:2px}
#phone .top .hbk>b{font-size:17px!important;font-weight:600!important;letter-spacing:-.3px!important;margin:0!important;top:2px!important;color:#C9CBD2!important}
/* v722b: Pay header, logo and "Pay" text a little smaller (logo 36 to 28px, text 26 to 21px) */
#phone .tp704bar{font-size:21px!important;letter-spacing:-.4px!important}
#phone .tp704bar img,#phone .tp704bar svg{width:28px!important;height:28px!important}
/* v722c: Home on phones. (1) The invite banner was 455px tall, over half the screen, so the balances started below the middle. Now it is about 330px and the balance card starts higher. (2) The banner glow stuck out 39px on each side and let the page scroll sideways; the scroll area now clips sideways overflow. */
#phone #sc{overflow-x:hidden!important}
#sc .hero701{padding-bottom:96px}
#sc .hero701 .it{font-size:20px!important;line-height:28px!important;margin-top:22px!important;letter-spacing:-.4px}
#sc .hero701 .ia{font-size:52px!important;line-height:58px!important;margin-top:8px!important;letter-spacing:-1.6px}
#sc .hero701 .ia small{font-size:22px!important;margin-left:4px}
#sc .hero701 .ib2{margin-top:6px!important;padding:13px 12px!important;font-size:16px!important}
@media (max-height:760px){#sc .hero701{padding-bottom:88px}#sc .hero701 .it{font-size:18px!important;line-height:26px!important;margin-top:14px!important}#sc .hero701 .ia{font-size:44px!important;line-height:50px!important}}
@media (max-width:360px){#sc .hero701 .it{font-size:17px!important;line-height:24px!important}#sc .hero701 .ia{font-size:40px!important;line-height:46px!important}#sc .hc .ha{font-size:24px!important}}
</style>
<script>
(function(){
const L=(e,r,f)=>{const l=(typeof S!=='undefined'&&S.lang)||'en';return l==='rw'?r:l==='fr'?f:e};
const _b=screens.bankd;
screens.bankd=function(){
 let h=_b.apply(this,arguments);
 try{
  const ir=S.pk.reduce((a,p)=>a+(p.ir||0),0);
  h=h.replace('Interest accrued through yesterday',L('Interest so far '+fmt(ir)+' RWF','Inyungu zimaze kuboneka RWF '+fmt(ir),'Intérêts cumulés '+fmt(ir)+' RWF'))
     .replace('<div class="pkpb">'+fmt(ir)+' RWF</div>','<div class="pkpb">'+L('Interest is added every day','Inyungu yongerwaho buri munsi','Intérêts versés chaque jour')+'</div>');
 }catch(e){}
 return h;
};
document.title='itunda, clickable prototype v722';
document.querySelectorAll('title').forEach(x=>x.textContent='itunda, clickable prototype v722');
})();
</script>
<style id="v723css">
/* v723: Pay code, closer to the Naver Pay screens. Tap: a framed card with a gradient edge, rings with a live seconds countdown in the middle (like the "49" on Samsung Pay), source and balance bottom left, Top up bottom right; the hint sits under the frame. My code: the two links share one tidy row and the tip bubble now points at the selected card. Scan: the three buttons no longer touch the screen edges and the sample-code label shows. */
.pcd .tp723{flex:1;min-height:0;display:flex;flex-direction:column;align-items:center;padding:14px 20px 0}
.pcd .tpf{width:100%;flex:1;min-height:0;display:flex;flex-direction:column;border:2px solid transparent;border-radius:28px;background:linear-gradient(#17171C,#17171C) padding-box,linear-gradient(135deg,#2DD08B,#2F6BFF) border-box}
.pcd .tpf .tapw{flex:1}
.pcd .tpf .r1{width:244px;height:244px}.pcd .tpf .r2{width:172px;height:172px}.pcd .tpf .r3{width:92px;height:92px;border-radius:30px}
.pcd .tpf .r3 b{font-size:32px;font-weight:800;font-variant-numeric:tabular-nums}
.pcd .tpb{display:flex;align-items:flex-end;justify-content:space-between;gap:12px;padding:0 20px 18px}
.pcd .tpb small{display:block;font-size:13px;color:#C5CCD6}.pcd .tpb strong{font-size:20px;font-weight:800;white-space:nowrap}
.pcd .tph{font-size:14px;color:#C5CCD6;text-align:center;margin-top:12px;padding:0 12px}
.pcd .tp723>.lnk{margin-top:2px}
.pcd .cardbox+div{justify-content:space-between!important;flex-wrap:nowrap!important;padding:2px 14px 0}
.pcd .cardbox+div .lnk{font-size:13px;padding:0 6px}
.pcd .pctip{top:6px;overflow:visible;text-overflow:clip}
.pcd .pctip:after{content:"";position:absolute;left:50%;bottom:-6px;margin-left:-6px;border:6px solid transparent;border-bottom:0;border-top-color:#2F80FF}
.pcd .pills{gap:6px;margin-top:20px}.pcd .pill{padding:0 11px;gap:6px;font-size:14px}
.pcd .chl{z-index:2;color:#AEB7C4}
</style>
<script>
{
const T=window.T3,_pc=screens.pcode;
screens.pcode=function(){const h=_pc.apply(this,arguments);if(typeof h!=='string'||S.pcT!==2)return h;
 const d=document.createElement('div');d.innerHTML=h;const w=d.querySelector('.tapw');if(!w)return h;
 const a=w.nextElementSibling,b=a&&a.nextElementSibling,bk=S.psrc==='bank',n=60-Math.floor(Date.now()/1000)%60;
 const nw=document.createElement('div');nw.className='tp723';
 nw.innerHTML='<div class="tpf"><div class="tapw"><div class="rg r1"></div><div class="rg r2"></div><div class="rg r3"><b id="tp723n" role="timer" aria-label="'+T('Seconds left','Amasegonda asigaye','Secondes restantes')+'">'+n+'</b></div></div><div class="tpb"><div><small>'+(bk?'itunda Bank':'itunda Pay Money')+'</small><strong>'+fmt(bk?S.bank:S.pay)+' RWF</strong></div><button class="lnk" onclick="sheetAdd()">'+T('Top up','Ongeramo','Recharger')+'</button></div></div><div class="tph">'+T('Hold the back of your phone near the payment terminal.','Shyira inyuma ya telefoni hafi y’icyuma cyo kwishyura.','Approchez l’arrière du téléphone du terminal.')+'</div><button class="lnk" onclick="pcMerch(\'204518\')">'+T('Prototype: tap a terminal','Prototype: koza ku cyuma','Prototype : approcher un terminal')+'</button>';
 w.replaceWith(nw);if(a)a.remove();if(b)b.remove();return d.innerHTML};
setInterval(()=>{const e=document.getElementById('tp723n');if(e)e.textContent=60-Math.floor(Date.now()/1000)%60},1000);
document.title=document.title.replace('v722','v723');
document.querySelectorAll('title').forEach(x=>x.textContent=x.textContent.replace('v722','v723'));
}
</script>
<script>
/* v724: Pay code card rail, closer to the Naver Pay screens. Before: the selected card sat at the far left of the rail with nothing beside it, and the + tile was hidden at the far right. Now: the + tile sits on the left like the screenshots, the selected card is always centred with a neighbour on both sides, and swiping the rail switches what pays (Pay Money / Bank) with a light buzz. Tapping the card tile still opens the itunda card. */
{
const _pc=screens.pcode;let busy=0,tm;
const ctr=sm=>{const r=document.getElementById('pcrail');if(!r)return;const b=r.querySelector('[aria-pressed=true]');if(!b)return;busy=1;r.style.scrollBehavior=sm?'smooth':'auto';r.scrollLeft=b.offsetLeft+b.offsetWidth/2-r.clientWidth/2;setTimeout(()=>{busy=0},sm?500:120)};
screens.pcode=function(){let h=_pc.apply(this,arguments);if(typeof h!=='string'||h.indexOf('id="pcrail"')<0)return h;
 const m=h.match(/<button class="pcmc add"[\s\S]*?<\/button>/);
 if(m){h=h.replace(m[0],'').replace(/(<div class="pcrl"[^>]*>)/,'$1'+m[0])}
 requestAnimationFrame(()=>requestAnimationFrame(()=>ctr(false)));return h};
const pick=()=>{const r=document.getElementById('pcrail');if(!r||busy)return;const c=r.scrollLeft+r.clientWidth/2;let best=null,d=1e9;
 r.querySelectorAll('.pcmc.pay,.pcmc.bank').forEach(b=>{const x=Math.abs(b.offsetLeft+b.offsetWidth/2-c);if(x<d){d=x;best=b}});
 const k=best&&(best.classList.contains('bank')?'bank':'pay'),cur=S.psrc==='bank'?'bank':'pay';
 if(best&&k!==cur&&d<best.offsetWidth*.75){try{navigator.vibrate&&navigator.vibrate(10)}catch(e){}pcSrc(k)}};
document.addEventListener('scroll',e=>{if(!e.target||e.target.id!=='pcrail')return;clearTimeout(tm);tm=setTimeout(pick,150)},true);
document.querySelectorAll('title').forEach(t=>t.textContent=t.textContent.replace('v723','v724'));
}
</script>
<style id="glass-home-v725">
/* v725: Home screen glass. Frosted cards over a soft colour field. CSS only, scoped to the Home tab (.h9) plus the shared tab bar. */
:root{--gl-base:#F1F0FF;--gl-a:rgba(143,137,255,.46);--gl-b:rgba(108,214,196,.34);--gl-c:rgba(255,186,150,.34);
--gl-fill:rgba(255,255,255,.62);--gl-fill2:rgba(255,255,255,.36);--gl-tile:rgba(255,255,255,.66);
--gl-edge:rgba(255,255,255,.82);--gl-edge2:rgba(255,255,255,.5);--gl-line:rgba(25,31,40,.07);
--gl-hi:inset 0 1px 0 rgba(255,255,255,.95),inset 0 -1px 0 rgba(255,255,255,.3);
--gl-shadow:0 14px 32px -16px rgba(60,52,170,.34),0 2px 6px rgba(60,52,170,.05);
--gl-blur:blur(24px) saturate(170%)}
@media (prefers-color-scheme:dark){:root:not([data-theme=light]){--gl-base:#101013;--gl-a:rgba(112,102,255,.46);--gl-b:rgba(36,150,142,.30);--gl-c:rgba(190,84,110,.24);
--gl-fill:rgba(34,34,46,.56);--gl-fill2:rgba(24,24,34,.38);--gl-tile:rgba(255,255,255,.09);
--gl-edge:rgba(255,255,255,.17);--gl-edge2:rgba(255,255,255,.10);--gl-line:rgba(255,255,255,.08);
--gl-hi:inset 0 1px 0 rgba(255,255,255,.16),inset 0 -1px 0 rgba(255,255,255,.03);
--gl-shadow:0 18px 36px -16px rgba(0,0,0,.75),0 2px 6px rgba(0,0,0,.3)}}
:root[data-theme=dark]{--gl-base:#101013;--gl-a:rgba(112,102,255,.46);--gl-b:rgba(36,150,142,.30);--gl-c:rgba(190,84,110,.24);
--gl-fill:rgba(34,34,46,.56);--gl-fill2:rgba(24,24,34,.38);--gl-tile:rgba(255,255,255,.09);
--gl-edge:rgba(255,255,255,.17);--gl-edge2:rgba(255,255,255,.10);--gl-line:rgba(255,255,255,.08);
--gl-hi:inset 0 1px 0 rgba(255,255,255,.16),inset 0 -1px 0 rgba(255,255,255,.03);
--gl-shadow:0 18px 36px -16px rgba(0,0,0,.75),0 2px 6px rgba(0,0,0,.3)}

/* colour field: stays put while the cards scroll over it, which is what makes the blur visible */
#phone .screen.h9{background:
radial-gradient(75% 36% at 6% 3%,var(--gl-a),transparent 70%),
radial-gradient(60% 32% at 104% 24%,var(--gl-b),transparent 72%),
radial-gradient(72% 38% at -4% 64%,var(--gl-c),transparent 72%),
radial-gradient(64% 34% at 102% 96%,var(--gl-a),transparent 72%),
var(--gl-base)!important}

/* glass cards */
#phone .screen.h9 .hc,#phone .screen.h9 .sec{margin:10px 12px 0!important;padding-left:0;padding-right:0;border:1px solid var(--gl-edge)!important;border-radius:28px!important;
background:linear-gradient(150deg,var(--gl-fill),var(--gl-fill2))!important;
-webkit-backdrop-filter:var(--gl-blur);backdrop-filter:var(--gl-blur);box-shadow:var(--gl-hi),var(--gl-shadow)!important;overflow:hidden}
#phone .screen.h9 .sec{padding:22px 20px 12px!important}
#phone .screen.h9 .hc{padding:16px 0 8px!important}
/* the balance card is the one thing allowed to glow */
#phone .screen.h9 .top+.hc{background:radial-gradient(110% 90% at 0% 0%,color-mix(in srgb,var(--br) 30%,transparent),transparent 62%),linear-gradient(150deg,var(--gl-fill),var(--gl-fill2))!important}
#phone .screen.h9 .hr{padding-left:20px!important;padding-right:20px!important}
#phone .screen.h9 .hct{padding-left:20px!important;padding-right:20px!important}
#phone .screen.h9 .hc .row{padding-left:20px!important;padding-right:20px!important}
#phone .screen.h9 .hc .row .s{color:var(--mu)!important}
#phone .screen.h9 .hc .hf{padding-left:20px!important;padding-right:20px!important}
#phone .screen.h9 .hc .hf::before{left:20px;right:20px;background:var(--gl-line)}

/* tiles and pills */
#phone .screen.h9 .hi,#phone .screen.h9 .gi .ico{background:var(--gl-tile)!important;border:1px solid var(--gl-edge2);box-shadow:var(--gl-hi)}
#phone .screen.h9 .hp{background:color-mix(in srgb,var(--br) 24%,transparent)!important;border:1px solid color-mix(in srgb,var(--br) 36%,transparent);box-shadow:inset 0 1px 0 rgba(255,255,255,.45)}
#phone .screen.h9 .hp.pr{background:color-mix(in srgb,var(--br) 40%,transparent)!important}
#phone .screen.h9 .hc.hpm{background:linear-gradient(135deg,color-mix(in srgb,var(--br) 42%,transparent),color-mix(in srgb,var(--br) 14%,transparent))!important}

/* header: frosted, sticky, with a hairline once content slides under it */
#phone .screen.h9 .top{padding-bottom:10px!important;background:color-mix(in srgb,var(--gl-base) 52%,transparent)!important;
-webkit-backdrop-filter:blur(18px) saturate(160%);backdrop-filter:blur(18px) saturate(160%);border-bottom:1px solid transparent;transition:border-color .2s,box-shadow .2s}
#phone .screen.h9.sc9 .top{border-bottom-color:var(--gl-edge2);box-shadow:0 10px 24px -18px rgba(40,36,130,.45)!important}
#phone .screen.h9 .hbk{padding:4px 12px 4px 6px;border-radius:999px;background:var(--gl-fill);border:1px solid var(--gl-edge);box-shadow:var(--gl-hi)}
#phone .screen.h9 .top .ib{border-radius:22px;background:var(--gl-fill);border:1px solid var(--gl-edge);box-shadow:var(--gl-hi)}

/* tab bar: same footprint, frosted */
#phone .tabs{background:color-mix(in srgb,var(--bg) 58%,transparent)!important;-webkit-backdrop-filter:blur(24px) saturate(180%)!important;backdrop-filter:blur(24px) saturate(180%)!important;border-top:1px solid var(--gl-edge2)!important}

/* fallbacks: no backdrop-filter, or the person asked for less transparency */
@supports not ((-webkit-backdrop-filter:blur(1px)) or (backdrop-filter:blur(1px))){#phone .screen.h9 .hc,#phone .screen.h9 .sec,#phone .screen.h9 .top,#phone .tabs{background:var(--bg)!important}}
@media (prefers-reduced-transparency:reduce){#phone{--gl-fill:var(--bg);--gl-fill2:var(--bg);--gl-tile:var(--chip);--gl-blur:none}
#phone .screen.h9 .top,#phone .tabs{background:var(--bg)!important;-webkit-backdrop-filter:none!important;backdrop-filter:none!important}}
</style>
<style id="glass-screens-v726">
/* v726: glass beyond Home. Same tokens as v725. */
:root{--gl-card:linear-gradient(150deg,var(--gl-fill),var(--gl-fill2))}

/* colour field on every screen that has no background of its own */
#phone .screen:not([style*=background]){background:
radial-gradient(75% 34% at 6% 2%,var(--gl-a),transparent 70%),
radial-gradient(60% 30% at 104% 30%,var(--gl-b),transparent 72%),
radial-gradient(72% 36% at -4% 72%,var(--gl-c),transparent 72%),
radial-gradient(64% 32% at 102% 98%,var(--gl-a),transparent 72%),
var(--gl-base)!important}

/* sticky headers: frosted */
#phone .screen .bar,#phone .screen .ahead,#phone .screen:not(.h9) .top,#phone .xp .xh{
background:color-mix(in srgb,var(--gl-base) 52%,transparent)!important;
-webkit-backdrop-filter:blur(18px) saturate(160%);backdrop-filter:blur(18px) saturate(160%)}
#phone .screen.sc9 .bar,#phone .screen.sc9 .ahead,#phone .screen.sc9:not(.h9) .top{box-shadow:0 10px 24px -18px rgba(40,36,130,.45),0 1px 0 var(--gl-edge2)!important}

/* cards: Pay sections, Explore groups, pockets, grouped rows */
#phone .screen:not(.h9)>.sec:not(.mini),#phone .xp .xc,#phone .screen:not(.h9) .pkc,#phone .glx,#phone .screen>div:not(.glx):has(>.ar){
margin:10px 12px 0!important;border:1px solid var(--gl-edge)!important;border-radius:28px!important;background:var(--gl-card)!important;
-webkit-backdrop-filter:var(--gl-blur);backdrop-filter:var(--gl-blur);box-shadow:var(--gl-hi),var(--gl-shadow)!important;overflow:hidden}
#phone .screen:not(.h9)>.sec:not(.mini){padding:22px 20px 12px!important}
#phone .xp .xc{padding:18px 8px 10px!important}
#phone .xp .xc::before{display:none!important}
#phone .glx{padding:6px 0}
#phone .glx>.ar,#phone .screen>div:not(.glx)>.ar{padding-left:20px!important;padding-right:20px!important;position:relative}
#phone .glx>.ar+.ar::before,#phone .screen>div:not(.glx)>.ar+.ar::before{content:"";position:absolute;top:0;left:20px;right:20px;height:1px;background:var(--gl-line)}
#phone .screen>.agt{padding-left:28px}

/* icon tiles */
#phone .screen:not(.h9) .ar .g,#phone .screen:not(.h9) .ico:not(.check),#phone .xp .xc .ar .g{background:var(--gl-tile)!important;border:1px solid var(--gl-edge2);box-shadow:var(--gl-hi)}

/* Explore: search field and shortcut row */
#phone .xp .xs,#phone .asr{background:var(--gl-fill)!important;border:1px solid var(--gl-edge);box-shadow:var(--gl-hi);-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px)}
#phone .xp .xpills{margin:12px 12px 4px!important;padding:12px 8px 14px!important;border:1px solid var(--gl-edge);border-radius:24px;background:var(--gl-card);-webkit-backdrop-filter:var(--gl-blur);backdrop-filter:var(--gl-blur);box-shadow:var(--gl-hi),var(--gl-shadow)}

/* secondary buttons and chips */
#phone .btn.sec2{background:var(--gl-fill)!important;border:1px solid var(--gl-edge);box-shadow:var(--gl-hi);-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px)}
#phone .cch{background:var(--gl-fill);border:1px solid var(--gl-edge2);box-shadow:var(--gl-hi)}

/* bottom action bar */
#phone .cta{background:color-mix(in srgb,var(--gl-base) 58%,transparent)!important;-webkit-backdrop-filter:blur(22px) saturate(170%);backdrop-filter:blur(22px) saturate(170%);box-shadow:none!important;border-top:1px solid var(--gl-edge2)!important}
#phone .cta input#msg{background:var(--gl-fill)!important;border:1px solid var(--gl-edge)!important}
#phone .cta .ib[style*="var(--chip)"]{background:var(--gl-fill)!important;border:1px solid var(--gl-edge)}

/* chat bubbles: received ones turn to glass, sent ones keep the brand colour */
#phone .screen [style*="border-radius:18px 18px 18px 4px"]{background:var(--gl-fill)!important;border:1px solid var(--gl-edge);box-shadow:var(--gl-hi);-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px)}
#phone .screen [style*="border-radius:18px 18px 4px 18px"]{box-shadow:inset 0 1px 0 rgba(255,255,255,.4),0 8px 18px -10px color-mix(in srgb,var(--br) 80%,transparent)}

/* sheets, scrim, toast */
#phone .sheetbg{background:rgba(22,20,58,.34)!important;-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px)}
#phone .sheet{background:color-mix(in srgb,var(--bg) 76%,transparent)!important;-webkit-backdrop-filter:blur(30px) saturate(180%);backdrop-filter:blur(30px) saturate(180%);border:1px solid var(--gl-edge);border-bottom:0;box-shadow:var(--gl-hi),0 -18px 40px -20px rgba(30,26,110,.4)}
#phone .toast{background:color-mix(in srgb,var(--tx) 78%,transparent)!important;-webkit-backdrop-filter:blur(16px) saturate(160%);backdrop-filter:blur(16px) saturate(160%);border:1px solid rgba(255,255,255,.18)}

/* fallbacks */
@supports not ((-webkit-backdrop-filter:blur(1px)) or (backdrop-filter:blur(1px))){#phone .sheet,#phone .cta,#phone .screen .bar,#phone .screen .ahead,#phone .screen:not(.h9) .top,#phone .xp .xh{background:var(--bg)!important}#phone .toast{background:var(--tx)!important}}
@media (prefers-reduced-transparency:reduce){#phone .sheet,#phone .cta,#phone .screen .bar,#phone .screen .ahead,#phone .screen:not(.h9) .top,#phone .xp .xh{background:var(--bg)!important;-webkit-backdrop-filter:none!important;backdrop-filter:none!important}#phone .toast{background:var(--tx)!important}#phone .sheetbg{-webkit-backdrop-filter:none;backdrop-filter:none}}
</style>
<script>
/* v726: group the flat row lists on You into glass cards. Moves existing nodes, so every onclick keeps working. */
(function(){var v=document.getElementById('view');if(!v||!window.MutationObserver)return;
function wrap(sc){if(!sc||sc.__gl)return;sc.__gl=1;
if(!sc.querySelector(':scope>.ahead')||!sc.querySelector(':scope>.agt'))return;
var grp=null;Array.prototype.slice.call(sc.children).forEach(function(el){
if(el.classList.contains('ar')){if(!grp){grp=document.createElement('div');grp.className='glx';sc.insertBefore(grp,el)}grp.appendChild(el)}else grp=null})}
function run(){wrap(v.querySelector(':scope>.screen'))}
new MutationObserver(run).observe(v,{childList:true});run()})();
</script>
<style id="glass-controls-v727">
/* v727: glass for controls. Keypad tray, input fields, chips, primary buttons, switches, segmented tabs, list cards, empty states. CSS only, same tokens as v725/v726. */

/* fields: underline inputs become soft glass wells */
#phone .screen .field{padding:12px 16px;border:1px solid var(--gl-edge);border-radius:20px;background:var(--gl-fill);box-shadow:var(--gl-hi);
-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);transition:border-color .2s,box-shadow .2s}
#phone .screen .field:focus-within{border-color:color-mix(in srgb,var(--br) 55%,transparent);box-shadow:var(--gl-hi),0 0 0 4px color-mix(in srgb,var(--br) 18%,transparent)}
#phone .screen .field input{background:transparent}

/* chips and pills */
#phone .screen .chip,#phone .screen .chp{background:var(--gl-fill);border:1px solid var(--gl-edge2);box-shadow:var(--gl-hi);-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px)}
#phone .screen .chip[aria-pressed="true"],#phone .screen .chip.on,#phone .screen .chp.on{background:color-mix(in srgb,var(--br) 26%,transparent);border-color:color-mix(in srgb,var(--br) 42%,transparent)}

/* primary button: brand colour with a light top edge and a coloured lift */
#phone .btn:not(.sec2):not(:disabled){background-image:linear-gradient(180deg,rgba(255,255,255,.22),rgba(255,255,255,0) 55%);
box-shadow:inset 0 1px 0 rgba(255,255,255,.42),0 12px 22px -12px color-mix(in srgb,var(--br) 85%,transparent)}
#phone .btn:disabled{box-shadow:none}

/* switches: glass track, light thumb */
#phone .sw{box-shadow:inset 0 1px 2px rgba(20,20,60,.14),0 0 0 1px var(--gl-edge2)}
#phone .sw i{box-shadow:0 2px 6px rgba(20,20,60,.28),inset 0 1px 0 #fff}

/* segmented tabs */
#phone .screen .seg{margin:10px 12px 0;padding:6px;gap:4px;border:1px solid var(--gl-edge);border-radius:999px;background:var(--gl-fill);box-shadow:var(--gl-hi);
-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px)}
#phone .screen .seg button{flex:1;padding:9px 12px;border:0!important;border-radius:999px}
#phone .screen .seg button.on{background:var(--gl-tile);box-shadow:var(--gl-hi),0 4px 10px -6px rgba(40,36,130,.4)}

/* generic cards and empty states */

<style id="v915toss">
/* v915: Toss-style pass 42. Settings rows get a leading line icon in a soft tile; the profile avatar uses a face. */
#phone .st15{flex:0 0 36px;width:36px;height:36px;border-radius:12px;background:var(--chip,#F2F4F6);color:var(--tx);display:flex;align-items:center;justify-content:center;margin-right:12px}

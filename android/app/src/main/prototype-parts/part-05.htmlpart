/* v700 Explore, Toss "All" tab pass: bigger squircle icons, chevrons, dark active section chip that follows the scroll, hairline under the sticky header, tidier Recent services */
try{(function(){
var css='#phone .xp .xc:not(.xg){padding:20px 0 16px}#phone .xp .xc:not(.xg) .xt{font-size:20px;line-height:28px;font-weight:800;letter-spacing:-.5px;padding:0 24px 8px;color:var(--tx)}#phone .xp .xr{display:flex;gap:4px;padding:0 16px;overflow-x:auto;scrollbar-width:none}#phone .xp .xr .gi{flex:0 0 76px;font-size:13px;line-height:18px;font-weight:600}#phone .xp .xr .ico{width:52px;height:52px;border-radius:18px;background:var(--chip);display:flex;align-items:center;justify-content:center;margin:0 auto 6px}'
+'#phone .xp .xh{padding:18px 24px 6px}#phone .xp .xn{font-size:22px;line-height:30px;letter-spacing:-.5px}#phone .xp .xl button{font-size:14px;font-weight:600}'
+'#phone .xp .xs{margin:6px 20px 0;border-radius:16px;min-height:48px}'
+'#phone .xp .xpills{padding:14px 16px 18px;gap:2px}#phone .xp .xpills button{background:none;gap:8px;padding:4px 0;font-size:13px;line-height:18px;font-weight:600;color:var(--tx)}'
+'#phone .xp .xpills button>svg,#phone .xp .xpills button>img{box-sizing:content-box;width:26px;height:26px;padding:11px;border-radius:18px;background:var(--chip);transition:transform .22s var(--spring)}#phone .xp .xpills button:active>svg,#phone .xp .xpills button:active>img{transform:scale(.92)}'
+'#phone .xp .xgh{font-size:20px;line-height:28px;font-weight:800;letter-spacing:-.5px;padding:20px 24px 8px!important}'
+'#phone .xp .xc .ar{padding:10px 48px 10px 24px;gap:16px;min-height:64px;align-items:center;border-radius:0;position:relative}'
+'#phone .xp .xc .ar .g{width:44px;height:44px;border-radius:16px;flex:none;display:flex;align-items:center;justify-content:center}'
+'#phone .xp .xc .ar .t{font-size:17px;line-height:24px;font-weight:600;letter-spacing:-.3px;flex:1 1 auto}'
+'#phone .xp .xc .ar .s{font-size:14px;line-height:20px;color:var(--tt);font-weight:400}'
+'#phone .xp .xc .ar::after{content:"";position:absolute;right:22px;top:50%;margin-top:-8px;width:16px;height:16px;opacity:.35;background:currentColor;-webkit-mask:url("data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 16 16%27%3E%3Cpath d=%27M6 3l5 5-5 5%27 fill=%27none%27 stroke=%27%23000%27 stroke-width=%271.8%27 stroke-linecap=%27round%27 stroke-linejoin=%27round%27/%3E%3C/svg%3E") center/16px no-repeat;mask:url("data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 16 16%27%3E%3Cpath d=%27M6 3l5 5-5 5%27 fill=%27none%27 stroke=%27%23000%27 stroke-width=%271.8%27 stroke-linecap=%27round%27 stroke-linejoin=%27round%27/%3E%3C/svg%3E") center/16px no-repeat}'
+'#phone .xp .xc .ar:active{background:var(--chip);transform:none}'
+'#phone .xp [aria-label="Sections"]{padding:10px 24px 12px!important;gap:8px!important;transition:box-shadow .2s}#phone .xp [aria-label="Sections"].stuck{box-shadow:0 1px 0 var(--ln)}'
+'#phone .xp [aria-label="Sections"] .chip{background:var(--chip)!important;color:var(--tt)!important;font-weight:600!important;transition:background .2s,color .2s}#phone .xp [aria-label="Sections"] .chip.on{background:var(--tx)!important;color:var(--bg)!important;font-weight:700!important}'
;
var st=document.createElement('style');st.id='v700';st.textContent=css;document.head.appendChild(st);
function wire(){var ab=document.getElementById('abody');if(!ab)return;var nav=ab.querySelector('[aria-label="Sections"]');if(!nav)return;
 if(nav.dataset.v700)return;nav.dataset.v700=1;
 var sc=ab.closest('.screen');if(!sc)return;var gs=[].slice.call(ab.querySelectorAll(':scope > .xg')),cs=[].slice.call(nav.children);
 var tick=function(){var top=sc.getBoundingClientRect().top+nav.offsetHeight+24,k=-1;gs.forEach(function(g,i){if(g.getBoundingClientRect().top<=top)k=i});
  if(sc.scrollTop<40)k=-1;nav.classList.toggle('stuck',sc.scrollTop>nav.offsetTop+4);
  cs.forEach(function(c,i){var on=i===k;if(c.classList.contains('on')!==on){c.classList.toggle('on',on);if(on)nav.scrollTo({left:c.offsetLeft-24,behavior:'smooth'})}})};
 sc.addEventListener('scroll',function(){requestAnimationFrame(tick)},{passive:true});tick()}
new MutationObserver(function(){wire()}).observe(document.getElementById('phone'),{childList:true,subtree:true});wire();
})()}catch(e){console.error('v700',e)}
document.title=document.title.replace(/v\d+/,'v700');
})();
</script>
<style id="ez701">
.hero701{--cv:#F2F4F6;margin:0 0 -1px;padding-bottom:112px;color:#fff;position:relative;
background:
radial-gradient(1.5px 1.5px at 12% 22%,rgba(255,255,255,.8),transparent),radial-gradient(1px 1px at 78% 14%,rgba(255,255,255,.5),transparent),radial-gradient(1.5px 1.5px at 90% 40%,rgba(255,255,255,.35),transparent),radial-gradient(1px 1px at 30% 48%,rgba(255,255,255,.4),transparent),radial-gradient(1px 1px at 62% 30%,rgba(255,255,255,.45),transparent),radial-gradient(1.5px 1.5px at 8% 70%,rgba(255,255,255,.3),transparent),
linear-gradient(180deg,#101013 0%,#0F0E28 30%,#1B1866 56%,#2B25A3 70%,#1A1760 84%,var(--cv) 100%)}
@media (prefers-color-scheme:dark){:root:not([data-theme=light]) .hero701{--cv:#101013}}
:root[data-theme=dark] .hero701{--cv:#101013}
.screen.h9 .hero701+.hc{margin-top:-88px!important;position:relative;z-index:1;box-shadow:inset 0 1px 0 rgba(150,140,255,.38)!important}

.hero701::after{content:"";position:absolute;left:-10%;right:-10%;bottom:-64px;height:300px;pointer-events:none;z-index:2;background:radial-gradient(62% 50% at 50% 55%,rgba(100,90,255,.22) 0%,rgba(80,70,240,.10) 45%,rgba(70,60,230,0) 78%);mix-blend-mode:normal}
@media (prefers-color-scheme:dark){:root:not([data-theme=light]) .hero701::after{mix-blend-mode:screen;background:radial-gradient(62% 50% at 50% 55%,rgba(100,90,255,.62) 0%,rgba(80,70,240,.30) 45%,rgba(70,60,230,0) 78%)}}
:root[data-theme=dark] .hero701::after{mix-blend-mode:screen;background:radial-gradient(62% 50% at 50% 55%,rgba(100,90,255,.62) 0%,rgba(80,70,240,.30) 45%,rgba(70,60,230,0) 78%)}
.hero701 .ib2,.hero701 .it,.hero701 .ia,.hero701 .ixr{position:relative;z-index:3}
.hero701 .top{background:none!important;box-shadow:none!important}
.hero701 .top b,.hero701 .top .ib{color:#fff}
.hero701 .top .ib svg,.hero701 .top .hbk svg{stroke:#fff}
.hero701 .ixr{display:flex;justify-content:flex-end;padding:4px 20px 0;height:0}
.hero701 .ix{width:36px;height:36px;border-radius:18px;border:0;background:rgba(255,255,255,.12);color:#C9CCE0;display:flex;align-items:center;justify-content:center;cursor:pointer}
.hero701 .it{text-align:center;font-size:24px;font-weight:700;line-height:34px;letter-spacing:-.5px;margin-top:38px}
.hero701 .ia{text-align:center;font-size:56px;font-weight:800;letter-spacing:-2px;line-height:64px;margin-top:14px}
.hero701 .ia small{font-size:26px;font-weight:700;margin-left:6px;letter-spacing:-.4px}
.hero701 .ib2{display:block;width:calc(100% - 40px);margin:8px 20px 0;border:0;border-radius:22px;background:#6960F9;color:#fff;font:700 17px/26px inherit;padding:16px 12px;cursor:pointer}
</style>
<script>
{const _h=screens.home;screens.home=()=>{const h=_h();if(S.inv701)return h;
const l={en:['Money you can get','when friends join itunda','Invite friends and collect 10,000 RWF'],rw:['Amafaranga ushobora kubona','inshuti zitangiye gukoresha itunda','Tumira inshuti ubone RWF 10,000'],fr:['Argent à recevoir','quand vos amis rejoignent itunda','Invitez des amis et recevez 10 000 RWF']}[S.lang]||['Money you can get','when friends join itunda','Invite friends and collect 10,000 RWF'];
const i=h.indexOf('<div class="hc');if(i<0)return h;
const body=`<div class="ixr"><button class="ix" aria-label="Dismiss" onclick="S.inv701=1;render('fade-none')">${ic('plus',20).replace('<svg','<svg style="transform:rotate(45deg)"')}</button></div><div class="it">${l[0]}<br>${l[1]}</div><div class="ia">10,000<small>RWF</small></div><button class="ib2" onclick="openSvc('invite')">${l[2]}</button>`;
return `<div class="hero701">${h.slice(0,i)}${body}</div>`+h.slice(i)}}
</script>
<script>
/* v702: Pay tab, "Payment methods" like Toss Pay's 결제수단. Toss Pay keeps the accounts and cards you can pay with in one list, with the one in use ticked and an "Add" row at the end; itunda only had a small drop-down inside the code card. Now: a flat list right under the balance actions and above Ways to pay (no card, no line): itunda Pay and itunda Bank with their balances, a tick on the one that pays in store, a tap switches it (same switch and toast as the drop-down), and "Add payment method" at the end. The sheet and the code card follow the same choice. Sample data, linking is not in this prototype. rw and fr copy is new and needs native review. */
{
const T3=(a,b,c)=>({rw:b,fr:c}[S.lang]||a);
const CK='<span style="color:var(--lk);display:flex;width:24px;flex:none"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></span>';
window.pmAdd=()=>toast(T3('Linking more accounts is not in this prototype yet.','Kongeraho konti ntibiraboneka muri iyi prototype.','Lier d’autres comptes n’est pas encore dans ce prototype.'));
const rowH=(k,ic,n,b)=>`<div class="tap" role="radio" aria-checked="${S.psrc===k}" tabindex="0" onclick="ppSrc('${k}')" style="display:flex;align-items:center;gap:14px;padding:10px 24px;min-height:64px;cursor:pointer"><span class="pkico" style="width:44px;height:44px;border-radius:22px;flex:none">${gl(ic,26)}</span><div style="flex:1;min-width:0"><div style="font-size:17px;font-weight:700">${n}</div><div class="sm mu" style="margin-top:2px">${fmt(b)} RWF</div></div>${S.psrc===k?CK:'<span style="width:24px;flex:none"></span>'}</div>`;
const sect=()=>`<div data-v702 role="radiogroup" aria-label="${T3('Payment methods','Uburyo bwo kwishyura','Moyens de paiement')}" style="padding-top:0"><div class="agt" style="padding-top:0">${T3('Payment methods','Uburyo bwo kwishyura','Moyens de paiement')}</div><div style="padding-top:6px">${rowH('pay','wallet','itunda Pay',S.pay)}${rowH('bank','bank','itunda Bank',S.bank)}<div class="tap" role="button" tabindex="0" onclick="pmAdd()" style="display:flex;align-items:center;gap:14px;padding:10px 24px;min-height:64px;cursor:pointer"><span class="pkico" style="width:44px;height:44px;border-radius:22px;flex:none;background:var(--chip);color:var(--lk)">${ic('plus',22)}</span><b style="font-size:17px">${T3('Add payment method','Ongeraho uburyo bwo kwishyura','Ajouter un moyen de paiement')}</b></div></div></div>`;
const _p=screens.pay;
screens.pay=function(){const h=_p.apply(this,arguments);if(typeof h!=='string'||h.includes('data-v702'))return h;
 const keys=['Ways to pay','Uburyo bwo kwishyura','Moyens de payer'];let i=-1;
 for(const k of keys){const j=h.indexOf('>'+k+'<');if(j>0){i=h.lastIndexOf('<div',j);break}}
 return i>0?h.slice(0,i)+sect()+h.slice(i):h};
}
</script>
<style id="v703css">
.tp703{--mp:#E9EDF2;--rd:#fff;--rd2:#D5DBE3;--pk:#F04452;--pill:#191F28}
@media (prefers-color-scheme:dark){:root:not([data-theme=light]) .tp703{--mp:#16171D;--rd:#23252D;--rd2:#2C2E37;--pill:#000}}
:root[data-theme=dark] .tp703{--mp:#16171D;--rd:#23252D;--rd2:#2C2E37;--pill:#000}
.tp703 .z7mp{position:relative;height:210px;overflow:hidden;background:var(--mp)}
.tp703 .z7mp>svg{position:absolute;inset:0;width:100%;height:100%}
.tp703 .z7mp::after{content:"";position:absolute;left:0;right:0;bottom:0;height:90px;background:linear-gradient(180deg,transparent,var(--bg))}
.tp703 .z7mpill{position:absolute;left:50%;bottom:62px;transform:translateX(-50%);z-index:2;display:flex;align-items:center;gap:10px;border:0;border-radius:24px;background:var(--pill);color:#fff;font-weight:600;font-size:15px;line-height:22px;font-family:inherit;padding:12px 20px;white-space:nowrap;cursor:pointer;box-shadow:0 4px 14px rgba(0,0,0,.18)}
.card703{margin:0 16px 12px;border-radius:28px;background:var(--chip);padding:22px 0 8px;position:relative}
.card703.z7ov{margin-top:-52px;z-index:1;padding:22px 20px 20px}
.card703 .z7ch{font-size:14px;line-height:20px;color:var(--tt);padding:0 24px 8px;font-weight:500}
.card703 .z7rw{display:flex;align-items:center;gap:16px;padding:12px 24px;min-height:64px;cursor:pointer;transition:background .15s}
.card703 .z7rw:active{background:rgba(127,127,140,.12)}
.card703 .z7sq{width:44px;height:44px;border-radius:16px;flex:none;display:flex;align-items:center;justify-content:center;color:#fff}
.card703 .z7rt{font-size:17px;line-height:24px;font-weight:700;letter-spacing:-.3px}
.card703 .z7rs{font-size:13px;line-height:18px;color:var(--tt);margin-top:1px}
.card703 .z7am{margin-left:auto;text-align:right;flex:none}
.card703 .z7am b{font-size:17px;line-height:24px;font-weight:700;display:block}
.card703 .z7am i{font-style:normal;font-size:13px;line-height:18px;color:var(--lk);display:block}
.card703 .z7more{display:block;width:100%;border:0;border-top:1px solid var(--ln);background:none;color:var(--tt);font-weight:600;font-size:15px;line-height:22px;font-family:inherit;padding:16px;margin-top:6px;cursor:pointer}
.earn703{display:flex;align-items:center;justify-content:space-between;gap:12px}
.earn703 .z7e1{display:flex;align-items:center;gap:8px;font-size:15px;color:var(--tt);font-weight:600}
.earn703 .z7e2{font-size:30px;line-height:40px;font-weight:800;letter-spacing:-1px;color:var(--lk);margin-top:6px}
.earn703 .z7go{border:0;border-radius:22px;background:var(--lk);color:#fff;font-weight:700;font-size:17px;line-height:24px;font-family:inherit;padding:16px 26px;cursor:pointer;flex:none}
.earn703 .z7go:active{transform:scale(.96)}
.mrow703{display:flex;align-items:center;gap:14px;margin-top:18px;padding-top:18px;border-top:1px solid var(--ln);cursor:pointer}
.mrow703 .z7mi{width:44px;height:44px;border-radius:14px;border:2px solid var(--lk);display:flex;align-items:center;justify-content:center;flex:none;background:var(--bg);color:var(--lk)}
.mrow703 .z7mn{font-size:17px;line-height:24px;font-weight:600;letter-spacing:-.3px}
.mrow703 .z7mb{font-size:14px;line-height:20px;color:var(--lk);font-weight:600;margin-top:1px}
.onl703{display:flex;align-items:center;gap:16px;padding:18px 24px}
.onl703 .z7vb{margin-left:auto;border:0;border-radius:14px;background:rgba(90,81,236,.16);color:var(--lk);font-weight:700;font-size:15px;line-height:22px;font-family:inherit;padding:10px 18px;cursor:pointer;flex:none}
.link703{display:block;width:100%;text-align:left;border:0;background:none;color:var(--tx);font-weight:500;font-size:17px;line-height:24px;font-family:inherit;padding:18px 24px;cursor:pointer}
.sub703{display:flex;align-items:center;gap:4px;font-size:22px;line-height:30px;font-weight:800;letter-spacing:-.5px;padding:0 24px 12px;cursor:pointer}
.sub703 svg{opacity:.4;margin-top:2px}
</style>
<script>
/* v703: Pay tab, second Toss Pay pass (two Toss Pay screenshots: the earn-rate home and its lower half). Before: the tab was the code card, balance and a flat list; nothing said what paying with itunda earns you. Now, top to bottom like Toss Pay: (1) a map strip with a "N earning stores nearby" pill, then an overlapping card with the earn rate in brand colour, a big "Find stores" button and the payment method in use with its extra-earn line; (2) the code card, balance and Ways to pay as before; (3) "How to pay online" row with a View button; (4) "Benefits received this month" and "Get more benefits" cards of squircle rows; (5) "History" replaces the flat Recent activity: merchant, amount, the earn in brand colour, "See more"; (6) FAQ and Send feedback text rows. Sample data: the 3% rate, 2% extra and store count are invented, linking and FAQ are not in this prototype. rw and fr copy is new and needs native review. */
{
const T3=(a,b,c)=>({rw:b,fr:c}[S.lang]||a);
const mon=()=>{try{return new Date().toLocaleDateString(({rw:'en-GB',fr:'fr-FR'})[S.lang]||'en-US',{month:'long'})}catch(e){return ''}};
const chev='<svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>';
const sq=(bg,n)=>`<span class="z7sq" style="background:${bg}">${ic(n,22)}</span>`;
const mapSvg='<svg viewBox="0 0 390 210" preserveAspectRatio="xMidYMid slice" aria-hidden="true"><g fill="none" stroke="var(--rd)" stroke-linecap="round"><path d="M-10 60L400 20" stroke-width="14"/><path d="M-10 150L400 120" stroke-width="10"/><path d="M90-10L130 220" stroke-width="12"/><path d="M270-10L240 220" stroke-width="9"/></g><g fill="none" stroke="var(--rd2)" stroke-linecap="round" stroke-width="4"><path d="M-10 105L400 80"/><path d="M180-10L195 220"/><path d="M330-10L350 220"/><path d="M-10 190L400 170"/></g><path d="M-10 130C60 120 100 90 160 100S300 40 400 50" fill="none" stroke="#2DB873" stroke-opacity=".35" stroke-width="22"/><g><circle cx="108" cy="70" r="7" fill="var(--pk)"/><circle cx="215" cy="118" r="7" fill="var(--pk)"/><circle cx="305" cy="62" r="7" fill="var(--pk)"/><circle cx="64" cy="150" r="7" fill="var(--pk)"/><circle cx="262" cy="160" r="7" fill="var(--pk)"/><circle cx="170" cy="40" r="7" fill="var(--pk)"/></g><circle cx="190" cy="92" r="16" fill="#5A51EC" fill-opacity=".2"/><circle cx="190" cy="92" r="7" fill="#5A51EC" stroke="#fff" stroke-width="3"/></svg>';
const top=()=>{const nm=S.psrc==='bank'?'itunda Bank':'itunda Pay',ik=S.psrc==='bank'?'bank':'wallet';
return `<div class="tp703" data-v703><div class="z7mp">${mapSvg}<button class="z7mpill" onclick="openMaps()"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3 11.5L21 3l-8.5 18-2-7.5z"/></svg>${T3('128 earning stores nearby','Amaduka 128 yishyura ibihembo hafi','128 magasins avec cashback à proximité')}</button></div>
<div class="card703 z7ov"><div class="earn703"><div><div class="z7e1">${gl('wallet',22)}<span>itunda Pay</span></div><div class="z7e2">${T3('3% back','3% asubizwa','3 % remboursés')}</div></div><button class="z7go" onclick="openMaps()">${T3('Find stores','Shaka amaduka','Trouver')}</button></div>
<div class="mrow703" role="button" tabindex="0" onclick="(document.querySelector('[data-v702]')||document.body).scrollIntoView({behavior:'smooth',block:'start'})"><span class="z7mi">${gl(ik,24)}</span><div style="flex:1;min-width:0"><div class="z7mn">${nm}</div><div class="z7mb">${T3('Get 2% extra back','Ubone 2% y’inyongera','Obtenez 2 % de plus')}</div></div></div></div></div>`};
const earn=a=>Math.max(1,Math.round(Math.abs(a)*.03));
const online=()=>`<div class="card703" data-v703 style="margin-top:16px"><div class="onl703">${sq('#3B6FF6','globe')}<div><div class="z7rt">${T3('Paying online','Kwishyura kuri interineti','Payer en ligne')}</div><div class="z7rs">${T3('Shops and apps that take itunda Pay','Amaduka na porogaramu yakira itunda Pay','Boutiques et apps qui acceptent itunda Pay')}</div></div><button class="z7vb" onclick="tab('explore')">${T3('View','Reba','Voir')}</button></div></div>`;
const benefits=()=>`<div class="card703" data-v703><div class="sub703" style="padding-top:0" onclick="ppGo('benefits')"><span style="font-size:14px;line-height:20px;font-weight:500;color:var(--tt);display:block;width:100%">${T3('Received in '+mon(),'Wabonye muri '+mon(),'Reçu en '+mon())}</span></div>
<div class="sub703" onclick="ppGo('benefits')">${T3('6,400 RWF received','Wabonye RWF 6,400','6 400 RWF reçus')}${chev}</div>
<div class="z7rw" onclick="ppGo('benefits')">${sq('#2DB873','star')}<div class="z7rt">${T3('Points','Amanota','Points')}</div><span class="z7am" style="color:var(--tt)">${T3('Total 6,400 RWF','Yose RWF 6,400','Total 6 400 RWF')}</span></div>
<div class="z7rw" onclick="ppGo('benefits')">${sq('#5A9BF6','gift')}<div class="z7rt">${T3('Coupons received','Kuponi wabonye','Coupons reçus')}</div></div></div>`;
const more=()=>`<div class="card703" data-v703><div class="z7ch">${T3('Get more benefits','Ibindi wakungukira','Plus d’avantages')}</div>
<div class="z7rw" onclick="ppGo('benefits')">${sq('#F04452','gift')}<div class="z7rt">${T3('Discount and cashback coupons','Kuponi z’igabanuka','Coupons de réduction')}</div></div>
<div class="z7rw" onclick="openCard()">${sq('#14B8A6','card')}<div class="z7rt">${T3('Card with up to 5% back','Ikarita igaruza 5%','Carte jusqu’à 5 % de cashback')}</div></div>
<div class="z7rw" onclick="openSvc('invite')">${sq('#8B5CF6','users')}<div class="z7rt">${T3('Invite friends, get 10,000 RWF','Tumira inshuti ubone RWF 10,000','Invitez, recevez 10 000 RWF')}</div></div>
<div class="z7rw" onclick="ppGo('benefits')">${sq('#F5A623','star')}<div class="z7rt">${T3('Point missions','Imikoro y’amanota','Missions de points')}</div></div></div>`;
const hist=()=>{const a=(S.act||[]).filter(x=>x[3]<0).slice(0,2);
return `<div class="card703" data-v703><div class="z7ch">${T3('History','Amateka','Historique')}</div>${a.map(x=>`<div class="z7rw" onclick="openAct()"><span class="z7sq" style="background:var(--bg);color:var(--tx);font-size:18px;font-weight:800">${String(x[1]).charAt(0)}</span><div style="min-width:0"><div class="z7rt">${x[1]}</div><div class="z7rs">${String(x[2]).replace(/^Paid · /,'')}</div></div><span class="z7am"><b>${fmt(Math.abs(x[3]))} RWF</b><i>${T3(fmt(earn(x[3]))+' RWF earned','Wabonye RWF '+fmt(earn(x[3])),fmt(earn(x[3]))+' RWF gagnés')}</i></span></div>`).join('')}<button class="z7more" onclick="openAct()">${T3('See more','Reba byinshi','Voir plus')}</button></div>`};
const foot=()=>`<div data-v703 style="padding:8px 0 28px"><button class="link703" onclick="z7toast(T3('The help centre is not in this prototype yet.','Ubufasha ntibiraboneka muri iyi prototype.','Le centre d’aide n’est pas encore dans ce prototype.'))">${T3('FAQ','Ibibazo bikunze kubazwa','Questions fréquentes')}</button><button class="link703" onclick="z7toast(T3('Feedback is not in this prototype yet.','Gutanga igitekerezo ntibiraboneka muri iyi prototype.','Les avis ne sont pas encore dans ce prototype.'))">${T3('Send feedback','Ohereza igitekerezo','Envoyer un avis')}</button></div>`;
window.T3=T3;window.z7toast=m=>toast(m);
const _p=screens.pay;
screens.pay=function(){const h=_p.apply(this,arguments);if(typeof h!=='string'||h.includes('data-v703'))return h;
 const d=document.createElement('div');d.innerHTML=h;const root=d.querySelector('.pay347')||d;
 const kids=[...root.children],pph=kids[1],rec=kids[kids.length-2];
 if(!pph||!rec)return h;
 const mk=s=>{const t=document.createElement('div');t.innerHTML=s;return [...t.children]};
 mk(top()).forEach(n=>pph.parentNode.insertBefore(n,pph));
 const before=rec;
 [...mk(online()),...mk(benefits()),...mk(more())].forEach(n=>before.parentNode.insertBefore(n,before));
 mk(hist()).forEach(n=>before.parentNode.insertBefore(n,before));
 rec.style.display="none";rec.setAttribute("aria-hidden","true");
 root.appendChild(mk(foot())[0]);
 return d.innerHTML};
document.title=document.title.replace(/v\d+/,'v704');
{const fix=()=>{const c=document.querySelector('#phone .pay347');if(!c)return;const t=c.querySelector('.tp703'),b=c.querySelector('.top');if(t&&b&&b.nextElementSibling!==t)b.after(t)};
const ph=document.getElementById('phone')||document.body;new MutationObserver(fix).observe(ph,{childList:true,subtree:true});fix()}

}
</script>
<style id="v704css">
:root{--tile704:#F2F4F6;--pg704:#F2F4F6;--cd704:#fff}
@media (prefers-color-scheme:dark){:root:not([data-theme=light]){--tile704:#333D4B;--pg704:var(--bg);--cd704:var(--chip)}}
:root[data-theme=dark]{--tile704:#333D4B;--pg704:var(--bg);--cd704:var(--chip)}
#sc:has(.tp703){background:var(--pg704)}
#sc:has(.tp703) .top{background:var(--pg704);box-shadow:none!important}
.tp703 .z7mp::after{background:linear-gradient(180deg,transparent,var(--pg704))!important}
.card703{background:var(--cd704)!important}
.leg704{margin:0 16px 12px;border-radius:24px;background:var(--cd704);padding:20px 0 12px;overflow:hidden}
.pay347 .pph{margin:0 16px 12px!important}
.leg704>.z7ch{padding:0 20px 8px;font-size:14px;color:var(--tt);font-weight:500}
.pm704 .pi{background:var(--cd704)}
.tabs{border-radius:26px 26px 0 0;box-shadow:0 -8px 24px rgba(0,0,0,.05)}
.tp704bar{display:flex;align-items:center;gap:0;font-weight:700;font-size:26px;letter-spacing:-.6px}.tp704bar img{margin-right:-2px}
.top .hbk{gap:0!important}.top .hbk>b{font-size:26px!important;font-weight:700!important;letter-spacing:-.6px!important;margin-left:-2px;margin-right:6px;position:relative;top:3px}.top .hbk>svg:first-child{width:34px;height:34px;overflow:visible}
.tp704bar svg{flex:none}
.top:has(.tp704bar){padding-top:20px!important}
.tp703 .z7mp>svg text{font-family:inherit;font-weight:600;font-size:11px;fill:var(--tt)}
.tp703 .z7e2{font-size:26px;letter-spacing:-1px;white-space:nowrap}
.tp703 .z7go{background:linear-gradient(135deg,#8F89FF,#5A51EC);color:#fff;border-radius:22px;padding:16px 20px;font-size:16px;box-shadow:0 6px 16px rgba(90,81,236,.28)}
.tp703 .mrow703{display:none}
.pm704{display:grid;grid-template-columns:44px 1fr;column-gap:14px;row-gap:14px;align-items:center;position:relative;margin-top:18px;padding-top:20px;border-top:1px solid var(--ln);cursor:pointer}
.pm704:before{content:"";position:absolute;left:21px;top:65px;height:14px;width:2px;background:var(--lk)}
.pm704 .pi{width:44px;height:44px;border-radius:14px;border:2px solid var(--lk);display:flex;align-items:center;justify-content:center;background:var(--bg);color:var(--lk)}
.pm704 .pd{width:44px;height:44px;border-radius:22px;background:var(--tint);display:flex;align-items:center;justify-content:center}
.pm704 .pd b{width:14px;height:14px;border-radius:7px;background:var(--lk)}
.pm704 .pn{font-size:17px;line-height:24px;font-weight:600;letter-spacing:-.3px}
.pm704 .pb{font-size:17px;line-height:24px;font-weight:700;color:var(--lk);letter-spacing:-.3px}
.pm704 .ps2{font-size:14px;line-height:20px;color:var(--tt)}
.card703{border-radius:24px;padding:20px 0 6px}
.card703 .z7ch{padding:0 20px 10px}
.card703 .z7rw{gap:14px;padding:7px 20px;min-height:50px}
.card703 .z7sq{width:32px;height:32px;border-radius:10px;background:var(--tile704)!important}
.card703 .z7rt{font-size:16px;font-weight:600;flex:1;min-width:0}.card703 .z7am{white-space:nowrap;font-size:14px}.card703 .onl703>div:nth-child(2){flex:1;min-width:0}
.card703 .sub703{padding:0 20px 10px;font-size:22px}
.card703 .onl703{padding:14px 20px}
.card703 .onl703 .z7rt{font-size:18px;font-weight:700}.card703 .onl703 .z7vb{padding:9px 14px}
.card703 .z7more{text-align:center;color:var(--tt);margin-top:8px}
.card703 .z7am b{font-size:18px}
.card703 .z7rw .z7rt+.z7rs{margin-top:2px}
.link703{padding:16px 24px}

/* Home details, against the Toss Home screenshot */
#sc .hero701 .ia{font-size:68px!important;letter-spacing:-2px}
#sc .hero701 .ia small{font-size:28px!important;font-weight:600!important;opacity:.92;letter-spacing:-.4px}
#sc .hero701 .ib2{font-weight:700!important;font-size:17px!important;border-radius:20px!important;padding:15px 12px!important;letter-spacing:-.3px}
#sc .hc .hp{border-radius:12px!important;background:rgba(127,127,140,.16)!important;color:var(--tx)!important;height:40px!important;min-width:64px;padding:0 16px!important;font-size:15px!important;font-weight:600!important}
#sc .hc .hp[onclick*="openAct"]{background:rgba(90,81,236,.16)!important;color:var(--lk)!important}
#sc .hc .hr .hi{width:36px!important;height:36px!important;border-radius:12px!important}
#sc .hc .hr .ha{font-size:22px!important;letter-spacing:-.6px}
#sc .hc .hct>span:first-child{color:var(--tx)!important;font-weight:700!important}
#sc .hc .int704{white-space:nowrap;font-style:normal;color:var(--lk)}
#sc .hc .hf .hs button{font-weight:500!important}
#sc .hc .hf i{background:var(--ln)!important}
</style>
<script>
/* v704: Pay tab, third Toss Pay pass (same two screenshots, compared line by line). Before: "Pay" title with a bell, a plain schematic map, "3% back", a one-line payment method, big saturated icon squares and 44px rows. Now: wordmark with QR and settings icons like Toss's header; a labelled map with orange store pins and a transit line; "Earning 3%" with a gradient button; the payment method as Toss draws it (ringed account icon, a connector, then the card-benefit line in brand colour); "How to pay online" with example shops; "Benefits received in <month>"; a fifth benefit row (airtime) so the list matches Toss's five; quiet 32px tiles with coloured glyphs and 50px rows; history rows with an icon, the date and the earn line only on shop payments (not bills); rounded-top tab bar. Sample data. rw and fr copy is new and needs native review. */
{
const T3=window.T3,mon=()=>{try{return new Date().toLocaleDateString(({rw:'en-GB',fr:'fr-FR'})[S.lang]||'en-US',{month:'long'})}catch(e){return ''}};
const chev='<svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>';
const tl=(c,n)=>`<span class="z7sq" style="color:${c}">${ic(n,18)}</span>`;
const logo='<img src="data:image/svg+xml;base64," width="36" height="36" alt="" style="display:block;flex:none">';
const bar=()=>`<div class="tp704bar" data-v704>${logo}<span>${T3('Pay','Pay','Pay')}</span></div><div style="display:flex;gap:4px"><button class="ib" aria-label="QR" onclick="ppGo('paysc')">${ic('qr',24)}</button><button class="ib" aria-label="Settings" onclick="openSettings()"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M10 4.77L10.6 2.6L13.4 2.6L14 4.77A7.5 7.5 0 0 1 15.69 5.47L15.69 5.47L17.65 4.36L19.64 6.35L18.53 8.31A7.5 7.5 0 0 1 19.23 10L19.23 10L21.4 10.6L21.4 13.4L19.23 14A7.5 7.5 0 0 1 18.53 15.69L18.53 15.69L19.64 17.65L17.65 19.64L15.69 18.53A7.5 7.5 0 0 1 14 19.23L14 19.23L13.4 21.4L10.6 21.4L10 19.23A7.5 7.5 0 0 1 8.31 18.53L8.31 18.53L6.35 19.64L4.36 17.65L5.47 15.69A7.5 7.5 0 0 1 4.77 14L4.77 14L2.6 13.4L2.6 10.6L4.77 10A7.5 7.5 0 0 1 5.47 8.31L5.47 8.31L4.36 6.35L6.35 4.36L8.31 5.47A7.5 7.5 0 0 1 10 4.77Z"/></svg></button></div>`;
const pin=(x,y,l)=>`<circle cx="${x}" cy="${y}" r="10" fill="#F2994A"/><circle cx="${x}" cy="${y}" r="3.5" fill="#fff"/><text x="${x}" y="${y+24}" text-anchor="middle">${l}</text>`;
const map='<g fill="none" stroke="var(--rd)" stroke-linecap="round"><path d="M-10 70L400 30" stroke-width="14"/><path d="M-10 160L400 128" stroke-width="10"/><path d="M95-10L135 220" stroke-width="12"/><path d="M285-10L252 220" stroke-width="9"/></g><g fill="none" stroke="var(--rd2)" stroke-linecap="round" stroke-width="4"><path d="M-10 112L400 88"/><path d="M190-10L205 220"/><path d="M340-10L358 220"/><path d="M-10 195L400 176"/></g><path d="M300 -10h100v120l-70 10-40-40z" fill="#2DB873" fill-opacity=".22"/><path d="M-10 40L120 52 160 110 160 220" fill="none" stroke="#E6397D" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/><circle cx="120" cy="52" r="9" fill="var(--bg)" stroke="#E6397D" stroke-width="4"/><text x="120" y="38" text-anchor="middle" style="fill:var(--tx)">Nyabugogo</text>'+pin(228,74,'Heaven')+pin(60,112,'Bourbon')+pin(300,150,'Simba')+pin(168,150,'Sawa Citi')+'<circle cx="215" cy="112" r="16" fill="#5A51EC" fill-opacity=".2"/><circle cx="215" cy="112" r="7" fill="#5A51EC" stroke="#fff" stroke-width="3"/>';
const pm=()=>{const b=S.psrc==='bank';return `<div class="pm704" role="button" tabindex="0" onclick="(document.querySelector('[data-v702]')||document.body).scrollIntoView({behavior:'smooth',block:'start'})"><span class="pi">${gl(b?'bank':'wallet',24)}</span><div class="pn">${b?'itunda Bank 1980':'itunda Pay Money'}</div><span class="pd"><b></b></span><div onclick="event.stopPropagation();openCard()"><div class="pb">${T3('itunda card benefits','Inyungu z’ikarita ya itunda','Avantages carte itunda')}</div><div class="ps2">${T3('Get 2% extra back','Ubone 2% y’inyongera','Obtenez 2 % de plus')}</div></div></div>`};
const noEarn=/bill|airtime|electric|REG|MTN|Airtel|water|top|loan|fee/i;
const row=(c,n,t,f)=>`<div class="z7rw" onclick="${f}">${tl(c,n)}<div class="z7rt">${t}</div></div>`;
const cards={
online:()=>`<div class="onl703">${tl('#5B8CFF','globe')}<div><div class="z7rt">${T3('How to pay online','Uko wishyura kuri interineti','Comment payer en ligne')}</div><div class="z7rs">${T3('Jumia, Yego and more','Jumia, Yego n’ibindi','Jumia, Yego et plus')}</div></div><button class="z7vb" onclick="tab('explore')">${T3('View','Reba','Voir')}</button></div>`,
ben:()=>`<div class="z7ch" style="padding-bottom:2px">${T3('Benefits received in '+mon(),'Ibyo wabonye muri '+mon(),'Avantages reçus en '+mon())}</div><div class="sub703" onclick="ppGo('benefits')">${T3('6,400 RWF received','Wabonye RWF 6,400','6 400 RWF reçus')}${chev}</div>
<div class="z7rw" onclick="ppGo('benefits')">${tl('#2DB873','star')}<div class="z7rt">${T3('Points · Pay Money','Amanota · Pay Money','Points · Pay Money')}</div><span class="z7am" style="color:var(--tt)">${T3('Total 6,400 RWF','Yose RWF 6,400','Total 6 400 RWF')}</span></div>
${row('#5B8CFF','gift',T3('Coupons received','Kuponi wabonye','Coupons reçus'),"ppGo('benefits')")}`,
more:()=>`<div class="z7ch">${T3('Get more benefits','Ibindi wakungukira','Plus d’avantages')}</div>
${row('#F04452','gift',T3('Discount and cashback coupons','Kuponi z’igabanuka','Coupons de réduction'),"ppGo('benefits')")}
${row('#8B5CF6','bolt',T3('Airtime discounts','Igabanuka ry’amaunite','Réductions crédit'),"openBill('MTN airtime')")}
${row('#14B8A6','card',T3('Card with up to 5% back','Ikarita igaruza 5%','Carte jusqu’à 5 % de cashback'),'openCard()')}
${row('#F5A623','users',T3('Invite friends, get 10,000 RWF','Tumira inshuti ubone RWF 10,000','Invitez, recevez 10 000 RWF'),"openSvc('invite')")}
${row('#3B6FF6','star',T3('Point missions','Imikoro y’amanota','Missions de points'),"ppGo('benefits')")}`,
hist:()=>{const a=(S.act||[]).filter(x=>x[3]<0&&x[0]!=='cyc').slice(0,3);const e=x=>noEarn.test(x[1])?0:Math.max(1,Math.round(Math.abs(x[3])*.03));
return `<div class="z7ch">${T3('History','Amateka','Historique')}</div>${a.map(x=>`<div class="z7rw" onclick="openAct()"><span class="z7sq" style="color:var(--tx);font-weight:800;font-size:15px;background:var(--tile704)!important">${P[x[0]]?ic(x[0],18):String(x[1]).charAt(0)}</span><div style="min-width:0"><div class="z7rt">${x[1]}</div><div class="z7rs" style="font-size:14px">${String(x[2]).replace(/^Paid · /,'')}</div></div><span class="z7am"><b>${fmt(Math.abs(x[3]))} RWF</b>${e(x)?`<i>${T3(fmt(e(x))+' RWF earned','Wabonye RWF '+fmt(e(x)),fmt(e(x))+' RWF gagnés')}</i>`:''}</span></div>`).join('')}<button class="z7more" onclick="openAct()">${T3('See more','Reba byinshi','Voir plus')}</button>`}};
const _q=screens.pay;
screens.pay=function(){const h=_q.apply(this,arguments);if(typeof h!=='string'||h.includes('data-v704')||!h.includes('data-v703'))return h;
 const d=document.createElement('div');d.innerHTML=h;
 const top=d.querySelector('.top');if(top){top.innerHTML=bar()}
 const sv=d.querySelector('.z7mp>svg');if(sv)sv.innerHTML=map;
 const pill=d.querySelector('.z7mpill');if(pill)pill.lastChild.textContent=T3('128 earning stores nearby','Amaduka 128 yishyura ibihembo hafi','128 magasins avec cashback à proximité');
 const e2=d.querySelector('.z7e2');if(e2)e2.textContent=T3('Earning 3%','Urimo kubona 3%','3 % en cours');
 const mr=d.querySelector('.mrow703');if(mr)mr.insertAdjacentHTML('afterend',pm());
 const cs=[...d.querySelectorAll('.card703[data-v703]')],k=['online','ben','more','hist'];
 cs.forEach((c,i)=>{if(k[i]){c.innerHTML=cards[k[i]]();c.setAttribute('data-v704','')}});
 const root=d.querySelector('.pay347')||d,kids=[...root.children];
 const tp=kids.find(k=>k.matches('.tp703')),cd=kids.filter(k=>k.matches('.card703[data-v704]')),ft=kids.find(k=>k.hasAttribute('data-v703')&&!k.matches('.card703,.tp703')),hid=kids.filter(k=>k.getAttribute('aria-hidden')==='true'),tb=kids.find(k=>k.matches('.top'));
 if(tp&&cd.length&&ft){const keep=new Set([tp,ft,tb,...cd,...hid]),leg=kids.filter(k=>!keep.has(k));
  const w=document.createElement('div');w.className='leg704';w.setAttribute('data-v704','');
  w.innerHTML='<div class="z7ch">'+T3('Wallet','Ikofi','Portefeuille')+'</div>';leg.forEach(k=>w.appendChild(k));
  [tb,tp,...cd,w,...hid,ft].filter(Boolean).forEach(k=>root.appendChild(k))}
 return d.innerHTML};
{const PAYG='<svg class="pay704" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3.5 8V6.5a3 3 0 0 1 3-3H8M16 3.5h1.5a3 3 0 0 1 3 3V8M20.5 16v1.5a3 3 0 0 1-3 3H16M8 20.5H6.5a3 3 0 0 1-3-3V16"/><text x="12" y="14.6" text-anchor="middle" font-size="7.4" font-weight="800" stroke="none" fill="currentColor" font-family="inherit">Pay</text></svg>';
const L24=logo.replace('width="36" height="36"','width="24" height="24"').replace('alt=""','alt="itunda"');
const hb=()=>{document.querySelectorAll('#phone .top .hbk>b').forEach(b=>{const w=T3('Bank','Banki','Banque');if(b.textContent!==w)b.textContent=w});
 const sc=document.querySelector('#phone #sc');if(!sc)return;
 const pb=sc.querySelector('.top .ib[aria-label="Scan to pay"]');if(pb&&!pb.querySelector('.pay704'))pb.innerHTML=PAYG;
 sc.querySelectorAll('.hc .hr[onclick="openBank()"] .hi').forEach(h=>{if(!h.querySelector('img'))h.innerHTML=L24});
 sc.querySelectorAll('.hc .hr[onclick="openBank()"] .sm').forEach(m=>{if(!m.querySelector('i'))m.insertAdjacentHTML('beforeend','<i class="int704"> '+T3('+interest 3','+inyungu 3','+intérêts 3')+'</i>')});
 sc.querySelectorAll('.hp[onclick*="openAct"]').forEach(b=>{const n=(S.act||[]).length,w=T3(n+' new +',n+' bishya +',n+' nouv. +');if(b.textContent!==w)b.textContent=w});
 sc.querySelectorAll('.hc .hr[onclick="openSpend()"] .sm').forEach(m=>{const w=T3('Spent in '+mon(),'Wakoresheje muri '+mon(),'Dépensé en '+mon());if(m.textContent!==w)m.textContent=w});
 sc.querySelectorAll('.hero701 .ib2').forEach(b=>{const w=T3('Invite friends, get 10,000 RWF','Tumira inshuti ubone RWF 10,000','Invitez, recevez 10 000 RWF');if(b.textContent!==w)b.textContent=w});
 sc.querySelectorAll('.hp.v421q').forEach(b=>{const w=T3('Add','Ongeramo','Ajouter');if(b.textContent!==w)b.textContent=w});
 sc.querySelectorAll('.hf .hs button').forEach(b=>{const w=T3('See all','Reba byose','Tout voir');if(b.textContent!==w)b.textContent=w})};
new MutationObserver(hb).observe(document.getElementById('phone')||document.body,{childList:true,subtree:true,characterData:true});hb()}
{const fx=()=>{const c=document.querySelector('#phone .pay347');if(!c)return;const l=c.querySelector('.leg704'),p=c.querySelector('.pph');if(l&&p&&p.nextElementSibling!==l)l.before(p)};
 new MutationObserver(fx).observe(document.getElementById('phone')||document.body,{childList:true,subtree:true});fx()}
}
</script>
<style id="v705css">
.b705{padding-bottom:24px}
.b705 .b7a{padding:18px 20px 0;cursor:pointer}
.b705 .b7an{display:inline-block;font-size:15px;line-height:22px;color:var(--tt);text-decoration:underline;text-decoration-color:var(--ln);text-underline-offset:4px}
.b705 .b7b{display:flex;justify-content:space-between;align-items:center;font-size:34px;line-height:44px;font-weight:800;letter-spacing:-1px;margin-top:4px}
.b705 .b7b small{font-size:22px;font-weight:700;letter-spacing:-.4px;margin-left:4px}
.b705 .b7b svg{color:var(--tt);flex:none}
.b705 .b7int{display:block;width:100%;text-align:left;border:0;background:none;font:inherit;font-size:14px;line-height:20px;font-weight:600;color:var(--lk);padding:2px 0 0;cursor:pointer}
.b705 .b7l{display:grid;grid-template-columns:54px 1fr auto;column-gap:10px;row-gap:14px;margin-top:20px;font-size:16px;line-height:22px}
.b705 .b7l .d{color:var(--tt);font-size:15px}.b705 .b7l .n{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.b705 .b7l b{font-weight:600;white-space:nowrap}
.b705 .b7bt{display:flex;gap:12px;padding:24px 20px 0}
.b705 .b7bt button{flex:1;height:56px;border:0;border-radius:18px;background:var(--chip);color:var(--tx);font:inherit;font-size:17px;font-weight:700;cursor:pointer;transition:transform .15s}
.b705 .b7bt button:active{transform:scale(.97)}
.b705 .b7bd{height:12px;margin-top:24px;background:var(--chip);opacity:.55}
.b705 .b7r{display:flex;align-items:center;gap:14px;padding:0 20px;min-height:62px;cursor:pointer;transition:background .15s}
.b705 .b7r:active{background:var(--chip)}
.b705 .b7i{width:40px;height:40px;border-radius:14px;background:var(--chip);display:flex;align-items:center;justify-content:center;flex:none}
.b705 .b7tw{flex:1;min-width:0;display:flex;align-items:center;gap:8px}
.b705 .b7r .t{font-size:17px;line-height:24px;font-weight:600;letter-spacing:-.3px}
.b705 .b7n{font-size:12px;line-height:16px;font-weight:700;color:#12B76A;background:rgba(18,183,106,.16);padding:4px 10px;border-radius:12px;flex:none}
.b705 .b7v{margin-left:auto;display:flex;flex-direction:column;align-items:flex-end;flex:none;text-align:right}
.b705 .b7v b{font-size:17px;line-height:24px;font-weight:700;color:var(--lk);letter-spacing:-.3px}
.b705 .b7v small{font-size:13px;line-height:18px;color:var(--tt)}
.b705 .b7r.c .b7v b{color:var(--tt);font-weight:500}
.b705 .b7r>svg{color:var(--tt);flex:none;opacity:.7}
.b705 .b7h{display:flex;justify-content:space-between;align-items:baseline;gap:12px;padding:32px 20px 6px}
.b705 .b7h b{font-size:22px;line-height:30px;font-weight:700;letter-spacing:-.5px}.b705 .b7h span{font-size:14px;color:var(--tt)}
.b705>.sec{padding:28px 0 0}.b705>.sec>.sech{padding:0 20px;font-size:22px;line-height:30px;font-weight:700;letter-spacing:-.5px;margin-bottom:6px}.b705>.sec .row{padding:10px 20px!important;border-radius:0}
.b705>.sec:last-child{padding:36px 20px 24px}
.b705 .b7p{display:flex;gap:16px;align-items:center;padding:28px 20px 0;cursor:pointer}
.b705 .b7p .pi{width:84px;height:84px;border-radius:26px;background:var(--chip);display:flex;align-items:center;justify-content:center;flex:none}
.b705 .b7p b{display:block;font-size:20px;line-height:28px;font-weight:700;letter-spacing:-.4px}
.b705 .b7p .sb{display:block;font-size:15px;line-height:22px;color:var(--tt);margin-top:2px}
.b705 .b7p a{display:inline-flex;align-items:center;gap:2px;margin-top:6px;font-size:15px;font-weight:600;color:var(--lk)}
.b705 .b7f{padding:12px 20px 8px}.b705 .b7f .sb{font-size:14px;line-height:20px;color:var(--tt)}.b705 .b7f b{display:block;font-size:17px;line-height:24px;font-weight:700}
</style>
<script>
/* v705: Bank tab, Toss Bank pass (five Toss Bank screenshots: the account screen and the product list). Before: a balance, four round actions, then six stacked sections of two-line rows (Control, Cards, Recommended, Save & grow, Borrow, Insights) with the same grey caption under every title, about 4,400px tall. Now, like Toss: (1) the account: small underlined number, big balance with a chevron, interest line, the last three ledger lines with dates, two wide buttons (Deposit, Send; Move and Statements become rows); (2) three count rows, Card, Pockets 3, Auto-transfer 2; (3) Coming up kept; (4) one suggestion card (savings goal, or loans once a goal exists); (5) the products as Toss lists them: a heading with a small caption, one line per product, the rate in brand colour on the right with a small unit under it, a green New pill; no grey sub-lines. Same handlers as before (rows keep their English title for the router). Rates are sample data. rw and fr for the new headings and labels need native review; row titles still come from the existing translation pass. */
{
const T=window.T3,sd=f=>{try{return f()}catch(e){return ''}};
const chv='<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>';
const gear='<button class="ib" aria-label="Settings" onclick="openSettings()" style="margin-left:auto"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M10 4.77L10.6 2.6L13.4 2.6L14 4.77A7.5 7.5 0 0 1 15.69 5.47L15.69 5.47L17.65 4.36L19.64 6.35L18.53 8.31A7.5 7.5 0 0 1 19.23 10L19.23 10L21.4 10.6L21.4 13.4L19.23 14A7.5 7.5 0 0 1 18.53 15.69L18.53 15.69L19.64 17.65L17.65 19.64L15.69 18.53A7.5 7.5 0 0 1 14 19.23L14 19.23L13.4 21.4L10.6 21.4L10 19.23A7.5 7.5 0 0 1 8.31 18.53L8.31 18.53L6.35 19.64L4.36 17.65L5.47 15.69A7.5 7.5 0 0 1 4.77 14L4.77 14L2.6 13.4L2.6 10.6L4.77 10A7.5 7.5 0 0 1 5.47 8.31L5.47 8.31L4.36 6.35L6.35 4.36L8.31 5.47A7.5 7.5 0 0 1 10 4.77Z"/></svg></button>';
const C={b:'#3B82F6',g:'#2DB873',p:'#8B5CF6',o:'#F5A623',r:'#F04452',t:'#14B8A6'};
/* R(colour, glyph, title, onclick, {v: right value, s: small line under it, c: count style, n: pill}) */
const R=(c,g,t,on,o={})=>`<div class="b7r tap${o.c?' c':''}" role="button" tabindex="0" data-b705r onclick="${on}"><span class="b7i" style="color:${C[c]}">${window.ICO5?window.ICO5(t)||ic(g,20):ic(g,20)}</span><div class="b7tw"><div class="t">${t}</div>${o.n?`<span class="b7n">${o.n}</span>`:''}</div>${o.v||o.s?`<span class="b7v">${o.v?`<b>${o.v}</b>`:''}${o.s?`<small>${o.s}</small>`:''}</span>`:''}${!o.v||o.c?chv:''}</div>`;
const H=(t,cap)=>`<div class="b7h"><b>${t}</b>${cap?`<span>${cap}</span>`:''}</div>`;
const dt=ms=>{const d=new Date(ms);return d.getDate()+' '+d.toLocaleDateString('en-GB',{month:'short'})};
const sg=n=>(n<0?'−':'+')+fmt(Math.abs(n))+' RWF';
const _b=screens.bank;
screens.bank=function(){const h=_b.apply(this,arguments);
 if(typeof h!=='string'||h.includes('data-b705')||!h.includes('class="bka"'))return h;
 const d=document.createElement('div');d.innerHTML=h;
 const bar=d.querySelector('.bar'),secs=[...d.querySelectorAll(':scope>.sec')];
 if(!bar)return h;
 bar.insertAdjacentHTML('beforeend',gear);
 const up=secs.find(s=>/Coming up|Bigiye|À venir/i.test((s.querySelector('.sech')||{}).textContent||'')),last=secs.find(s=>/Deposit Protection/i.test(s.textContent));
 if(up)up.querySelectorAll('.row[onclick="soon()"]').forEach(r=>r.remove());
 const led=sd(()=>ledger50().slice(0,3).map(r=>r.x))||[];
 const ir=sd(()=>S.pk.reduce((a,p)=>a+(p.ir||0),0));
 const nPk=sd(()=>S.pk.length),au=2+(typeof autoOn==='function'?sd(autoOn)||0:0);
 const sch=sd(()=>{const p=pkGet('sch');return p&&p.t?Math.round(pkBal(p)/p.t*100)+'%':''});
 const rate=T('Sample rates','Ibipimo by’icyitegererezo','Taux d’exemple');
 const acct=`<div class="b7a" role="button" tabindex="0" onclick="openBankDetail()"><span class="b7an">itunda Bank ••1980</span><div class="b7b"><span>${fmt(S.bank)}<small>RWF</small></span>${chv}</div>${ir?`<button class="b7int" onclick="event.stopPropagation();intSheet()">${T('Interest '+fmt(ir)+' RWF so far','Inyungu RWF '+fmt(ir),'Intérêts '+fmt(ir)+' RWF')}</button>`:''}${led.length?`<div class="b7l">${led.map((x,i)=>`<span class="d">${i?'':dt(x[5]||Date.now())}</span><span class="n">${String(x[1]).replace(/&/g,"&amp;").replace(/</g,"&lt;")}</span><b>${sg(x[3])}</b>`).join('')}</div>`:''}</div>`;
 const btn=`<div class="b7bt"><button onclick="bkDep()">${T('Deposit','Bika','Déposer')}</button><button onclick="flow()">${T('Send','Ohereza','Envoyer')}</button></div><div class="b7bd"></div>`;
 const top=`<div class="b7top" style="padding-top:6px">${R('b','card','Card','openCard()')}${R('b','coin','Pockets','openPockets()',{v:nPk||'',c:1})}${R('p','cyc','Auto-transfer','soon()',{v:au,c:1})}</div>`;
 const promo=S.goal?{g:'wallet',t:T('Need a loan?','Ukeneye inguzanyo?','Besoin d’un prêt ?'),s:T('See how much you can borrow','Reba ayo wakwaka','Voyez combien emprunter'),a:T('Check my limit','Reba ingano','Voir ma limite'),on:"b705go('Get a loan')"}:{g:'money',t:T('Start a savings goal','Tangira intego yo kuzigama','Créez un objectif d’épargne'),s:T('A target and a date make saving easier','Intego n’itariki bituma kuzigama koroha','Un objectif et une date facilitent l’épargne'),a:T('Start','Tangira','Commencer'),on:'openGoal()'};
 const pr=`<div class="b7p" role="button" tabindex="0" onclick="${promo.on}"><span class="pi">${gl(promo.g,56)}</span><div><b>${promo.t}</b><span class="sb">${promo.s}</span><a>${promo.a}${chv.replace('width="18" height="18"','width="16" height="16"')}</a></div></div>`;
 const sv=H(T('Savings & deposits','Kubika no kubitsa','Épargne et dépôts'),rate)
  +R('g','coin','Interest jar','soon()',{v:'4.0%',s:S.jar?fmt(S.jar)+' RWF':T('a year','ku mwaka','par an')})
  +R('g','cal','26-week savings','soon()',{v:'5%+',s:T('base rate','igipimo fatizo','taux de base')})
  +R('g','bolt','31-day savings','open31()',{v:T('Up to 10%','Kugeza 10%','Jusqu’à 10 %')})
  +R('g','lock','12-month deposit','soon()',{v:'8.0%',s:S.dep?T('Locked','Byafunzwe','Bloqué'):T('12 months','Amezi 12','12 mois')})
  +R('g','bank','SACCO shares','soon()',{v:'6%',s:T('dividend','inyungu','dividende')})
  +R('g','trend','Investments','soon()')
  +R('o','coin','School fees',"openPocket('sch')",{v:sch||'',c:1})
  +R('o','plus','New savings goal','soon()')
  +R('o','up','Round-up saving','soon()',{v:S.ru?T('On','Bifunguye','Activé'):T('Off','Bifunze','Désactivé'),c:1});
 const tg=H(T('Together','Hamwe','Ensemble'))+R('t','users','Group accounts','openGrp()',(window.GRPO?window.GRPO():{}))+R('t','child','Youth account','soon()')+R('t','users','Ikimina','soon()');
 const ln=H(T('Loans','Inguzanyo','Prêts'),rate)
  +R('r','wallet','Get a loan','soon()',S.loan?{v:T('Active','Irimo','En cours'),c:1}:{})
  +R('r','coin','Harvest advance','soon()')
  +R('r','school','Student loan','soon()',{v:'11–12%',n:T('New','Gishya','Nouveau')})
  +R('r','home','VUP Financial Services','soon()')
  +R('r','bike','Moto-Taxi Ownership','soon()',{n:T('New','Gishya','Nouveau')});
 const sx=H(T('Services','Serivisi','Services'))
  +R('b','cyc','Move to itunda Pay','bkMove()')
  +R('b','send','Send to a bank account','bkx()')
  +R('b','user','Payees','bkGo(\'bkpay\')')
  +R('b','cal','Scheduled transfers','bkGo(\'bksch\')')
  +R('b','bill','Statements','bkStmt()')
  +R('b','trend','Spending','openSpend()')
  +R('b','coin','Budget','bkGo(\'bkbud\')')
  +R('b','shield','Limits & alerts','bkLim()')
  +R('b','bank','Account details','bkAcct()')
  +R('b','wallet','My assets','bkAssets()')
  +R('b','bill','Documents & letters','bkDocs()')
  +R('b','warn','Report a problem','bkGo(\'bkcase\')');
 const gd=H(T('Good to know','Byiza kumenya','Bon à savoir'))
  +R('p','trend','My credit score','soon()',{v:T('View','Reba','Voir')})
  +`<div class="b7f"><div class="sb">${T('Tell us what you think','Tubwire icyo ubitekerezaho','Dites-nous ce que vous en pensez')}</div><b>${T('How do you like the new Bank screen?','Ubona ute iyi Bank nshya?','Que pensez-vous du nouvel écran Bank ?')}</b></div>`;
 return bar.outerHTML+`<div class="b705" data-b705>${acct}${btn}${top}${up?up.outerHTML:''}${pr}${sv}${tg}${ln}${sx}${gd}${last?last.outerHTML:''}</div>`};
window.b705go=n=>{const e=[...document.querySelectorAll('[data-b705r]')].find(r=>{const t=r.querySelector('.t');return t&&t.textContent.trim()===n});if(e)e.click()};
document.title=document.title.replace(/v\d+/,'v705');
}
</script>
<style id="v706css">.top .hbk>svg:last-child:not(:first-child){display:none!important}</style><script>document.title=document.title.replace(/v\d+/,"v707")</script>
<style id="v707css">
.b705 .b7i{background:none!important;width:40px;height:40px;border-radius:0}
.b705 .b7top .b7i{background:var(--chip)!important;border-radius:14px}
.b705 .b7i svg{width:32px;height:32px;display:block}.b705 .b7top .b7i svg{width:26px;height:26px}
</style>
<script>
/* v707: Bank rows get itunda's own colourful icons (flat, rounded, the app's indigo / mint / yellow palette) instead of one-colour line glyphs, like Toss draws a distinct picture per product. One icon per row title. */
{
const I='#7472F4',D='#514FC0',N='#282565',M='#B3D5B9',G='#2DB873',DG='#156631',Y='#FFCF87',O='#F5A623',R='#F04452',P='#F7A8C4',B='#5B8CFF',W='#fff';
const rr=(x,y,w,h,r,f)=>`<rect x="${x}" y="${y}" width="${w}" height="${h}" rx="${r}" fill="${f}"/>`,ci=(x,y,r,f)=>`<circle cx="${x}" cy="${y}" r="${r}" fill="${f}"/>`,pa=(d,f)=>`<path d="${d}" fill="${f}"/>`,st=(d,c,w)=>`<path d="${d}" fill="none" stroke="${c}" stroke-width="${w}" stroke-linecap="round" stroke-linejoin="round"/>`;
const cal=c=>rr(6,8,28,26,7,c)+st('M13 5v6M27 5v6',N,3);
const MAP={
'Card':rr(4,9,32,22,6,D)+rr(4,14,32,5,0,N)+rr(9,24,11,3.5,1.7,Y),
'Pockets':rr(8,10,24,7,3.5,D)+pa('M8 15h24v16a5 5 0 0 1-5 5H13a5 5 0 0 1-5-5z',I)+ci(20,26,4.5,Y),
'Auto-transfer':cal(B)+st('M13 22l5 5 9-10',W,3.4),
'Interest jar':rr(11,5,18,6,3,Y)+rr(7,10,26,26,9,M)+ci(16,21,2.3,DG)+ci(24,29,2.3,DG)+st('M25 20l-9 10',DG,2.8),
'26-week savings':cal(G)+ci(14,22,2,W)+ci(20,22,2,W)+ci(26,22,2,W)+ci(14,28,2,W)+ci(20,28,2,W),
'31-day savings':pa('M20 3c2 7 11 10 11 20a11 11 0 0 1-22 0c0-5 3-8 5-12 2 3 3 4 5 5 1-4 1-8 1-13z',O)+pa('M20 21c3 3 6 5 6 9a6 6 0 0 1-12 0c0-4 3-6 6-9z',Y),
'12-month deposit':st('M13 18v-5a7 7 0 0 1 14 0v5',D,4.5)+rr(7,17,26,19,6,I)+ci(20,26.5,3.2,W),
'SACCO shares':pa('M3 15L20 4l17 11z',D)+rr(7,17,6,14,2,I)+rr(17,17,6,14,2,I)+rr(27,17,6,14,2,I)+rr(4,32,32,5,2.5,N),
'Investments':rr(4,4,32,32,10,G)+st('M10 27l7-8 5 5 8-10',W,3.6)+st('M26 14h6v6',W,3.6),
'School fees':pa('M20 6L3 15l17 9 17-9z',D)+pa('M9 21v7c6 6 16 6 22 0v-7l-11 6z',I)+rr(33,15,3,13,1.5,Y),
'New savings goal':ci(20,20,16,I)+ci(20,20,10.5,W)+ci(20,20,5,R),
'Round-up saving':ci(20,20,16,Y)+ci(20,20,11,O)+st('M14 23l6-6 6 6',W,3.6),
'Group accounts':ci(9,17,4.5,M)+ci(31,17,4.5,M)+pa('M2 32c0-5 3-7 7-7s5 1 6 2l-3 5zM38 32c0-5-3-7-7-7s-5 1-6 2l3 5z',M)+ci(20,14,6,Y)+pa('M9 36c0-7 5-11 11-11s11 4 11 11z',I),
'Youth account':ci(20,14,7,Y)+pa('M7 36c0-8 6-12 13-12s13 4 13 12z',P)+ci(17.5,13.5,1.2,N)+ci(22.5,13.5,1.2,N),
'Ikimina':ci(20,20,16,M)+ci(20,8,4.5,Y)+ci(9.5,26,4.5,Y)+ci(30.5,26,4.5,Y)+ci(20,20,5,G),
'Get a loan':pa('M14 5h12l-3 7h-6z',D)+ci(20,25,12,I)+st('M24 21h-5a2.6 2.6 0 0 0 0 5.2h2a2.6 2.6 0 0 1 0 5.2h-5M20 18.5v2.5M20 31v2.5',W,2.4),
'Harvest advance':pa('M19 35C9 34 4 27 4 17c10 0 15 5 15 12z',G)+pa('M21 31c0-9 5-14 15-14 0 10-5 15-15 14z',M)+ci(12,10,3.5,R)+ci(19,7,3.5,R),
'Student loan':rr(6,5,28,30,6,B)+rr(10,5,3.5,30,0,D)+st('M19 14h10M19 20h8',W,2.8),
'VUP Financial Services':pa('M6 19L20 8l14 11v15a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2z',Y)+rr(16,24,8,12,2,O)+st('M3 20L20 5l17 15',R,4.5),
'Moto-Taxi Ownership':ci(9.5,28,7,I)+ci(30.5,28,7,I)+ci(9.5,28,3,W)+ci(30.5,28,3,W)+st('M10 28l7-12h9l4 12',Y,4)+st('M17 16l-2-5h-5',W,3.4)+rr(21,9,9,4,2,O),
'Move to itunda Pay':ci(20,20,16,I)+st('M11 16h17l-4-4M29 24H12l4 4',W,3.2),
'Send to a bank account':pa('M4 18L36 5 28 35 20 24z',I)+pa('M20 24L36 5 28 35z',D)+st('M20 24L36 5',W,2.4),
'Payees':rr(4,8,32,24,6,B)+ci(14.5,18,4,W)+pa('M7 28c0-4 3-6 7.5-6s7.5 2 7.5 6z',W)+st('M25 17h7M25 23h5',W,2.8),
'Scheduled transfers':ci(20,20,16,B)+st('M20 10v10l7 5',W,3.4),
'Statements':pa('M9 4h22v32l-4-3-3.500 3-3.500-3-3.500 3-3.500-3-4 3z','#E6E8FF')+st('M14 12h12M14 18h12M14 24h7',I,2.8),
'Spending':ci(20,20,16,B)+pa('M20 20V4a16 16 0 0 1 16 16z',O)+pa('M20 20l11.3 11.3A16 16 0 0 1 4 20z',D),
'Budget':rr(4,9,32,26,8,G)+rr(21,18,15,10,5,DG)+ci(27.5,23,2.2,W)+rr(8,5,18,5,2.5,M),
'Limits & alerts':pa('M20 3l15 5.500v10C35 28 29 34 20 37 11 34 5 28 5 18.500v-10z',I)+st('M13 20l5 5 9-10',W,3.4),
'Account details':rr(4,8,32,25,6,M)+ci(14,18,3.8,G)+pa('M7 28c0-4 3-5.500 7-5.500S21 24 21 28z',G)+st('M25 17h7M25 23h5',DG,2.8),
'My assets':pa('M20 4l17 8.500-17 8.500-17-8.500z',I)+st('M3 21l17 8.500L37 21',D,4)+st('M3 28.500L20 37l17-8.500',N,4),
'Documents & letters':pa('M8 3h15l10 10v24H8z',B)+pa('M23 3v10h10z',D)+st('M14 23h13M14 29h9',W,2.8),
'Report a problem':pa('M20 4l17 30H3z',O)+st('M20 15v10',W,3.6)+ci(20,29.5,2.2,W),
'My credit score':ci(20,20,16,M)+st('M9 25a11 11 0 0 1 22 0',G,4.5)+st('M20 25l6-8',N,3.6)+ci(20,25,2.6,N)
};
window.ICO5=t=>MAP[t]?`<svg viewBox="0 0 40 40" aria-hidden="true">${MAP[t]}</svg>`:'';
}
</script>

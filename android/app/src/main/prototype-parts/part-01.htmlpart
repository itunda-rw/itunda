S.hide=false;
const TT9={rw:{Home:`Ahabanza`,Pay:`Kwishyura`,Explore:`Sura`,Messages:`Ubutumwa`,You:`Wowe`},fr:{Home:`Accueil`,Pay:`Payer`,Explore:`Explorer`,Messages:`Messages`,You:`Vous`}};

'Monthly total':['Total mensuel','Yose ya buri kwezi'],'Paused subscriptions are not charged. You can resume them any time.':['Les abonnements en pause ne sont pas facturés. Vous pouvez les reprendre à tout moment.','Ibyahagaritswe ntibishyurwa. Ushobora kubisubukura igihe icyo ari cyo cyose.'],
'Best route ⌄':['Meilleur itinéraire ⌄','Inzira nziza ⌄'],'Arrive':['Arrivée','Ugeze'],'Places':['Lieux','Ahantu'],'Listings are sample data for this prototype.':['Les annonces sont des données d’exemple pour ce prototype.','Ibyatanzwe ni ingero muri iki kigereranyo.'],'Sell something':['Vendre un article','Gurisha ikintu'],
'Insights':['Analyses','Isesengura'],'Interest jar':['Tirelire à intérêts','Agasanduku k’inyungu'],'Deposit Protection Fund (simulation)':['Fonds de protection des dépôts (simulation)','Ikigega cyo kurinda amafaranga abitswa (igerageza)']
};
Object.assign(D,E2);
const idx={fr:0,rw:1};
const run=()=>{const l=S&&S.lang;if(!(l in idx))return;const k=idx[l];
for(const root of [document.getElementById('phone')]){const w=document.createTreeWalker(root,NodeFilter.SHOW_TEXT);let n;while(n=w.nextNode()){const v=n.nodeValue.trim();const m=D[v];if(m&&m[k])n.nodeValue=n.nodeValue.replace(v,m[k])}}};
let q=0;new MutationObserver(()=>{if(q)return;q=requestAnimationFrame(()=>{q=0;run()})}).observe(document.getElementById('phone'),{childList:true,subtree:true});
run();
})();
</script>
<script>
/* v71: screen-reader names for switches, keypad, map expand and info icons; toasts announced; sheets marked as dialogs */
(function(){
const ph=document.getElementById('phone'),ly=document.getElementById('layer');
const lines=e=>(e.innerText||'').split('\n').map(x=>x.trim()).filter(Boolean);
const fix=()=>{
ph.querySelectorAll('.sw:not([aria-label])').forEach(e=>{const r=e.parentElement&&(e.closest('.row,.set,.tr')||e.parentElement);const l=r?lines(r)[0]:'';e.setAttribute('aria-label',l||'Toggle')});
ph.querySelectorAll('button:not([aria-label=""]):not([aria-label]):empty,button:not([aria-label]):not(:empty)').forEach(e=>{if(e.innerText.trim()||e.getAttribute('aria-label'))return;if(e.disabled){e.setAttribute('aria-hidden','true');return}
 const oc=e.getAttribute('onclick')||'';e.setAttribute('aria-label',/pnKey\(''\)|del|back/i.test(oc)?'Delete':'Button')});
ph.querySelectorAll('button[aria-label=""]').forEach(e=>{if(e.disabled){e.setAttribute('aria-hidden','true');e.removeAttribute('aria-label')}else if(!e.innerText.trim())e.setAttribute('aria-label',/pnKey\(''\)/.test(e.getAttribute('onclick')||'')?'Delete':'Button')});
ph.querySelectorAll('[onclick*="mpExp"]:not([aria-label])').forEach(e=>{if(!/[\p{L}\p{N}]/u.test(e.innerText||''))e.setAttribute('aria-label','Expand map')});
ph.querySelectorAll('.qm:not([aria-label])').forEach(e=>{e.setAttribute('aria-label','More info');if(!e.getAttribute('role')){e.setAttribute('role','button');e.tabIndex=0}});
ph.querySelectorAll('.toast:not([role])').forEach(e=>{e.setAttribute('role','status');e.setAttribute('aria-live','polite')});
ly.querySelectorAll('.sheet:not([role])').forEach(e=>{e.setAttribute('role','dialog');e.setAttribute('aria-modal','true');const h=e.querySelector('.h1');if(h)e.setAttribute('aria-label',h.textContent.trim().slice(0,60))});
};
let q=0;const go=()=>{if(q)return;q=setTimeout(()=>{q=0;fix()},600)};
new MutationObserver(go).observe(ph,{childList:true,subtree:true,attributes:true,attributeFilter:['class']});
new MutationObserver(go).observe(ly,{childList:true,subtree:true});
fix();
})();
</script>
<script>
/* v72: disabled primary buttons now say why (en/fr/rw) */
(function(){
const ph=document.getElementById('phone');
const H={
airgo:['Enter a 10-digit number (07…) and an amount within your balance.','Saisissez un numéro à 10 chiffres (07…) et un montant dans votre solde.','Andika nimero y’imibare 10 (07…) n’amafaranga ari mu bushobozi bwawe.'],
bgo:['Enter the full 11-digit number to continue.','Saisissez le numéro complet à 11 chiffres pour continuer.','Andika nimero yose y’imibare 11 kugira ukomeze.'],
psave:['Change something to enable Save.','Modifiez un champ pour activer Enregistrer.','Hindura ikintu kugira ngo ubashe kubika.'],
go:['Enter an amount within your balance.','Saisissez un montant dans votre solde.','Andika amafaranga ari mu bushobozi bwawe.'],
get Next(){const sc=S.auth?S.stack[S.stack.length-1]:S.obStep,M={recipient:['Enter a phone number or tap a contact to continue.','Choisissez un contact ou saisissez un numéro pour continuer.','Hitamo umuntu cyangwa wandike nimero kugira ukomeze.'],obPhone:['Enter your phone number to continue.','Saisissez votre numéro pour continuer.','Andika nimero ya telefoni yawe kugira ukomeze.'],obName:['Enter your name to continue.','Saisissez votre nom pour continuer.','Andika izina ryawe kugira ukomeze.'],obTerms:['Accept the terms to continue.','Acceptez les conditions pour continuer.','Emera amabwiriza kugira ukomeze.'],bill:['Choose a bill and enter the number to continue.','Choisissez une facture et saisissez le numéro.','Hitamo fagitire wandike nimero kugira ukomeze.'],amount:['Enter an amount to continue.','Saisissez un montant pour continuer.','Andika amafaranga kugira ukomeze.'],mv:['Enter an amount to continue.','Saisissez un montant pour continuer.','Andika amafaranga kugira ukomeze.'],paytill:['Enter the full till number to continue.','Saisissez le numéro de caisse complet.','Andika nimero yose ya kaisse kugira ukomeze.']};return document.getElementById('pqp')?['Enter a price to continue.','Saisissez d’abord un prix.','Banza wandike igiciro.']:(window.WZH&&window.WZH())||M[sc]||['Complete this step to continue.','Terminez cette étape pour continuer.','Rangiza iki gikorwa kugira ukomeze.']},
'Take out':['Nothing to take out yet.','Rien à retirer pour l’instant.','Nta mafaranga yo gukuramo ubu.']};
const k={en:0,fr:1,rw:2};
const run=()=>{const i=k[S.lang]||0;
ph.querySelectorAll('.dhint').forEach(h=>{const b=h.previousElementSibling;if(!b||!b.disabled)h.remove()});
ph.querySelectorAll('button[disabled]').forEach(b=>{const key=H[b.id]?b.id:H[(b.innerText||'').trim()]?(b.innerText||'').trim():null;if(!key)return;
 const n=b.nextElementSibling;const txt=H[key][i];
 if(n&&n.classList.contains('dhint')){if(n.textContent!==txt)n.textContent=txt;return}
 const d=document.createElement('div');d.className='dhint sm mu';d.setAttribute('role','note');d.style.cssText='text-align:center;padding:8px 8px 0;font-size:13px;line-height:18px';d.textContent=txt;b.after(d)})};
let q=0;new MutationObserver(()=>{if(q)return;q=requestAnimationFrame(()=>{q=0;run()})}).observe(ph,{childList:true,subtree:true,attributes:true,attributeFilter:['disabled']});
const nm=()=>{if(S.lang==='en')return;const w=document.createTreeWalker(ph,NodeFilter.SHOW_TEXT);let n;while(n=w.nextNode()){const m=/^No match for (".*")\.$/.exec(n.nodeValue.trim());if(m)n.nodeValue=(S.lang==='fr'?'Aucun résultat pour ':'Nta cyabonetse kuri ')+m[1]+'.'}};
new MutationObserver(()=>requestAnimationFrame(nm)).observe(ph,{childList:true,subtree:true});
run();
})();
</script>
<script>
/* v73: full shopping. Search, sort, saved filter, stock limits, quantity + Buy now, related items, promo code, pickup option, order history with tracking + reorder. rw strings need native review */
(function(){
const T=(e,f,r)=>({en:e,fr:f,rw:r}[S.lang]||e);
Object.assign(S,{shopQ:'',shopSort:'rel',pq:1,promo:null,sdel:'std',favOnly:false});
const PROMOS={ITUNDA10:10,KIGALI5:5};
const left=i=>Math.max(0,PRODS[i].s-(S.scart[i]||0));
const fee=()=>S.sdel==='pick'||scTotal()>=8000?0:1500;
const off=()=>S.promo?Math.round(scTotal()*PROMOS[S.promo]/100):0;
const grand=()=>scTotal()-off()+fee();
const q$=s=>document.querySelector(s);
/* ---- grid with search, sort, saved filter, sold-out ---- */
const grid=()=>{let a=PRODS.map((x,i)=>[x,i]).filter(([x,i])=>(S.cat==='All'||x.c===S.cat)&&(!S.shopQ||(x.n+' '+x.m).toLowerCase().includes(S.shopQ))&&(!S.favOnly||S.fav[i]));
const k=S.shopSort;a.sort((p,q)=>k==='lo'?p[0].p-q[0].p:k==='hi'?q[0].p-p[0].p:k==='deal'?(pct(q[0].p,q[0].o)||0)-(pct(p[0].p,p[0].o)||0):0);
if(!a.length)return `<div style="grid-column:1/-1;text-align:center;padding:36px 12px"><div style="font-size:17px;font-weight:800">${T('Nothing matches','Aucun résultat','Nta cyabonetse')}</div><div class="sm mu" style="margin:6px 0 16px">${T('Try another word or clear the filters.','Essayez un autre mot ou effacez les filtres.','Gerageza irindi jambo cyangwa ukureho ayo watoranyije.')}</div><button class="cch on" onclick="shClear()">${T('Clear filters','Effacer les filtres','Kuraho ayo watoranyije')}</button></div>`;
return a.map(([x,i])=>x.s<=0?pcard(x,i).replace(/<div class="ps">[^<]*<\/div>/,'').replace('<div class="pn">','<div class="ps" style="color:var(--er)">'+T('Sold out','Épuisé','Byashize')+'</div><div class="pn">'):pcard(x,i)).join('')};
const sortRow=()=>{const o=[['rel',T('Recommended','Recommandés','Byatoranyijwe')],['lo',T('Price: low to high','Prix croissant','Igiciro: gito ujya hejuru')],['hi',T('Price: high to low','Prix décroissant','Igiciro: hejuru ujya hasi')],['deal',T('Biggest deals','Meilleures offres','Ibyatanzwe cyane')]];
const nf=Object.values(S.fav).filter(Boolean).length,no=S.orders.filter(x=>x.k==='Shop order').length;
return `<div id="shsort" style="display:flex;align-items:center;gap:4px;padding:8px 24px 4px"><button aria-haspopup="dialog" onclick="shSortSheet()" style="flex:1;min-width:0;display:flex;align-items:center;gap:6px;height:48px;border:0;background:none;padding:0;font-size:17px;font-weight:800;text-align:left"><span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${(o.find(x=>x[0]===S.shopSort)||o[0])[1]}</span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--tx)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex:none"><path d="M6 9l6 6 6-6"/></svg></button><button aria-label="${T('Saved','Favoris','Ibyabitswe')} (${nf})" aria-pressed="${S.favOnly}" onclick="shFav()" style="border:0;background:none;display:flex;align-items:center;gap:6px;height:48px;padding:0 10px;font-size:15px;font-weight:700"><svg width="24" height="24" viewBox="0 0 24 24" fill="${S.favOnly?'var(--er)':'none'}" stroke="${S.favOnly?'var(--er)':'var(--tx)'}" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/></svg>${nf?nf:''}</button><button aria-label="${T('My orders','Mes commandes','Ibyo naguze')}" onclick="S.stack=['shop','myorders'];render('push')" style="border:0;background:none;display:flex;align-items:center;gap:6px;height:48px;padding:0 4px 0 10px;font-size:15px;font-weight:700"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--tx)" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true"><path d="M3 7l9-4 9 4v10l-9 4-9-4V7zM3 7l9 4 9-4M12 11v10"/></svg>${no?no:''}</button></div>`};
window.shSortSheet=()=>{const o=[['rel',T('Recommended','Recommandés','Byatoranyijwe')],['lo',T('Price: low to high','Prix croissant','Igiciro: gito ujya hejuru')],['hi',T('Price: high to low','Prix décroissant','Igiciro: hejuru ujya hasi')],['deal',T('Biggest deals','Meilleures offres','Ibyatanzwe cyane')]];
document.getElementById('layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" role="dialog" aria-modal="true" aria-label="${T('Sort','Trier','Tondeka')}"><div style="font-size:20px;font-weight:800;margin-bottom:8px">${T('Sort','Trier','Tondeka')}</div>${o.map(([k,l])=>`<button onclick="shSortPick('${k}')" style="display:flex;align-items:center;justify-content:space-between;width:100%;min-height:60px;border:0;background:none;padding:0;font-size:18px;font-weight:${S.shopSort===k?800:600};text-align:left"><span>${l}</span>${S.shopSort===k?'<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--lk)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>':''}</button>`).join('')}</div>`};
window.shSortPick=k=>{closeSheet();shSort(k)};
window.shSort=k=>{S.shopSort=k;q$('#shsort').outerHTML=sortRow();q$('#pgrid').innerHTML=grid()};
window.shFav=()=>{S.favOnly=!S.favOnly;q$('#shsort').outerHTML=sortRow();q$('#pgrid').innerHTML=grid()};
window.shSearch=v=>{S.shopQ=v.trim().toLowerCase();q$('#pgrid').innerHTML=grid()};
window.shClear=()=>{S.shopQ='';S.shopSort='rel';S.favOnly=false;S.cat='All';render('fade-none')};
window.setCat=c=>{S.cat=c;q$('#cats').innerHTML=chipsHtml();q$('#pgrid').innerHTML=grid()};
const _shop=screens.shop;
screens.shop=()=>{let h=_shop();if(S.shopTab==='eats')return h;
h=h.replace('>Search products<','><input id="shq" aria-label="'+T('Search products','Rechercher des produits','Shakisha ibicuruzwa')+'" placeholder="'+T('Search products','Rechercher des produits','Shakisha ibicuruzwa')+'" value="'+S.shopQ.replace(/"/g,'&quot;')+'" oninput="shSearch(this.value)" style="flex:1;min-width:0;border:0;background:transparent;font:inherit;color:inherit;outline:none"><');
return h.replace('<div class="chips" id="cats"',sortRow()+'<div class="chips" id="cats"')};
new MutationObserver(()=>{const g=q$('#pgrid');if(g&&!g.dataset.v){g.dataset.v=1;g.innerHTML=grid()}}).observe(document.getElementById('phone'),{childList:true,subtree:true});
/* ---- product page: quantity, Buy now, related items ---- */
const _op=window.openProd;window.openProd=i=>{S.pq=1;_op(i)};
window.pqAdj=d=>{S.pq=Math.min(Math.max(1,left(S.pi)),Math.max(1,(S.pq||1)+d));render('fade-none')};
const addN=(i,q)=>{const l=left(i);if(l<=0){toast(T('Out of stock','Épuisé','Byashize'));return 0}const n=Math.min(q,l);S.scart[i]=(S.scart[i]||0)+n;if(n<q)toast(T('Only '+PRODS[i].s+' in stock, added '+n,'Seulement '+PRODS[i].s+' en stock, '+n+' ajouté(s)','Hasigaye '+PRODS[i].s+' gusa, wongeyemo '+n));return n};
window.addCart=(i,q)=>{const n=addN(i,q||Math.max(1,S.pq||1));if(!n)return;S.pq=1;S.stack=['shop'];render('pop');if(!document.querySelector('.toast'))toast(T('Added to cart','Ajouté au panier','Byashyizwe mu gaseke'))};
window.buyNow=i=>{if(!addN(i,Math.max(1,S.pq||1)))return;S.pq=1;S.stack=['shop','scart'];render('push')};
const _pr=screens.product;
screens.product=()=>{const i=S.pi,x=PRODS[i],l=left(i),q=Math.min(S.pq||1,Math.max(1,l));let h=_pr().replace(/<div class="ps"[^>]*>\d+ left in stock<\/div>/,'');const [a]=h.split('<div class="cta">');
const rel=PRODS.map((y,j)=>[y,j]).filter(([y,j])=>j!==i&&y.c===x.c).slice(0,2);
const step=l>0?`<div class="pad" style="padding-top:16px;display:flex;align-items:center;justify-content:space-between"><span class="mu" style="font-size:15px">${T('Quantity','Quantité','Ingano')}</span><div style="display:flex;align-items:center;gap:12px"><button class="ib" style="width:38px;height:38px;border-radius:19px;background:var(--chip)" aria-label="${T('Fewer','Moins','Gabanya')}" ${q<=1?'disabled':''} onclick="pqAdj(-1)">${ic('minus',16)}</button><b style="min-width:18px;text-align:center;font-size:17px">${q}</b><button class="ib" style="width:38px;height:38px;border-radius:19px;background:var(--chip)" aria-label="${T('More','Plus','Ongera')}" ${q>=l?'disabled':''} onclick="pqAdj(1)">${ic('plus',16)}</button></div></div><div class="pad sm mu" style="padding-top:6px">${l<=5?l+' '+T('left in stock','en stock','zisigaye'):T('In stock','En stock','Birahari')}</div>`:`<div class="pad" style="padding-top:16px;color:var(--er);font-weight:800">${x.s<=0?T('Sold out','Épuisé','Byashize'):T('All available units are in your cart','Toutes les unités disponibles sont dans votre panier','Byose bihari biri mu gaseke kawe')}</div>`;
const relH=rel.length?`<div class="pad" style="padding-top:24px;font-size:18px;font-weight:800">${T('You may also like','Vous aimerez aussi','Ushobora no gukunda')}</div><div class="pgrid" style="padding:12px 24px 110px">${rel.map(([y,j])=>pcard(y,j)).join('')}</div>`:'<div style="height:110px"></div>';
const cta=l>0?`<div class="cta" style="display:flex;gap:10px"><button class="btn" style="flex:1;background:var(--chip);color:inherit" onclick="addCart(${i})">${T('Add to cart','Ajouter','Shyira mu gaseke')}</button><button class="btn" style="flex:1" onclick="buyNow(${i})">${T('Buy now','Acheter','Gura nonaha')} · ${fmt(x.p*q)}</button></div>`:`<div class="cta"><button class="btn" disabled>${T('Out of stock','Épuisé','Byashize')}</button></div>`;
return a+step+relH+cta};
/* ---- cart: promo code, pickup option, full summary ---- */
window.scAdj=(i,d)=>{if(d>0&&left(i)<=0){toast(T('Only '+PRODS[i].s+' in stock','Seulement '+PRODS[i].s+' en stock','Hasigaye '+PRODS[i].s+' gusa'));return}S.scart[i]=Math.max(0,(S.scart[i]||0)+d);if(!scCount()){S.promo=null;S.stack=['shop'];render('pop');return}render('fade-none')};
window.sdSet=k=>{S.sdel=k;render('fade-none')};
window.promoGo=()=>{const c=(q$('#prm').value||'').trim().toUpperCase();if(PROMOS[c]){S.promo=c;render('fade-none');toast(T('Code applied','Code appliqué','Kode yemewe'))}else q$('#prerr').textContent=c?T('Code not valid. Try ITUNDA10.','Code invalide. Essayez ITUNDA10.','Kode ntiyemewe. Gerageza ITUNDA10.'):T('Enter a code first.','Saisissez d’abord un code.','Banza wandike kode.')};
window.promoX=()=>{S.promo=null;render('fade-none')};
const rw=(a,b,c)=>`<div style="display:flex;justify-content:space-between;height:36px;align-items:center;font-size:15px"><span class="mu">${a}</span><b${c?` style="color:${c}"`:''}>${b}</b></div>`;
const opt=(k,t,s,p)=>`<div role="radio" aria-checked="${S.sdel===k}" tabindex="0" onclick="sdSet('${k}')" style="display:flex;align-items:center;gap:12px;padding:12px 14px;border-radius:16px;margin-bottom:8px;border:2px solid ${S.sdel===k?'var(--lk)':'var(--ln)'}"><div style="flex:1"><div style="font-weight:800;font-size:15px">${t}</div><div class="sm mu">${s}</div></div><b>${p}</b></div>`;
screens.scart=()=>{const ent=Object.entries(S.scart).filter(([i,q])=>q>0),tot=grand(),bad=tot>S.pay;
const lines=ent.map(([i,q])=>{const x=PRODS[i],no=left(i)<=0;return `<div style="display:flex;align-items:center;gap:12px;padding:10px 0"><div class="pim" style="width:56px;height:56px;border-radius:16px;aspect-ratio:auto;flex-shrink:0">${gl(x.g,34)}</div><div style="flex:1;min-width:0"><div style="font-size:15px;font-weight:700;line-height:20px">${x.n}</div><div class="sm mu">${fmt(x.p)} RWF${no?' · '+T('max in cart','max atteint','byuzuye'):''}</div></div><div style="display:flex;align-items:center;gap:8px"><button class="ib" style="width:34px;height:34px;border-radius:17px;background:var(--chip)" aria-label="${T('Remove one','Retirer un','Gabanya')}" onclick="scAdj(${i},-1)">${ic('minus',16)}</button><b style="min-width:14px;text-align:center">${q}</b><button class="ib" style="width:34px;height:34px;border-radius:17px;background:var(--chip);${no?'opacity:.4':''}" aria-label="${T('Add one','Ajouter un','Ongeraho')}" ${no?'aria-disabled="true"':''} onclick="scAdj(${i},1)">${ic('plus',16)}</button></div></div>`}).join('');
const pr=S.promo?`<div style="display:flex;justify-content:space-between;align-items:center;padding:10px 14px;border-radius:14px;background:var(--chip)"><span style="font-weight:800;font-size:14px">${S.promo} · −${PROMOS[S.promo]}%</span><button class="cch" onclick="promoX()">${T('Remove','Retirer','Kuraho')}</button></div>`:`<div style="display:flex;gap:8px"><input id="prm" aria-label="${T('Promo code','Code promo','Kode y’igabanywa')}" placeholder="${T('Promo code','Code promo','Kode y’igabanywa')}" autocapitalize="characters" style="flex:1;min-width:0;height:44px;border-radius:14px;border:0;background:var(--chip);padding:0 14px;font:inherit;color:inherit"><button class="cch on" onclick="promoGo()">${T('Apply','Appliquer','Emeza')}</button></div><div id="prerr" role="alert" style="color:var(--er);font-size:13px;margin-top:6px"></div>`;
return `${bar(T('Cart','Panier','Agaseke'))}<div class="pad" style="padding-top:12px">${lines}</div><div class="pad" style="padding-top:8px">${pr}</div><div class="pad" role="radiogroup" aria-label="${T('Delivery','Livraison','Kugezwaho')}" style="padding-top:16px">${opt('std',T('Rider delivery','Livraison par coursier','Gutwarwa n’umumotari'),T('1 to 2 days','1 à 2 jours','Iminsi 1 kugeza kuri 2'),scTotal()>=8000?T('Free','Gratuit','Ubuntu'):'1,500 RWF')}${opt('pick',T('Pickup point','Point relais','Aho gufatira'),T('Kimironko, ready tomorrow','Kimironko, prêt demain','Kimironko, ejo biraba biteguye'),T('Free','Gratuit','Ubuntu'))}</div><div class="pad" style="padding-top:8px;border-top:0;margin:0 24px;padding-left:0;padding-right:0">${rw(T('Subtotal','Sous-total','Igiteranyo'),fmt(scTotal())+' RWF')}${S.promo?rw(T('Discount','Remise','Igabanywa'),'−'+fmt(off())+' RWF','var(--ok)'):''}${rw(T('Delivery','Livraison','Kugezwaho'),fee()?fmt(fee())+' RWF':T('Free','Gratuit','Ubuntu'))}<div style="display:flex;justify-content:space-between;align-items:baseline;padding-top:6px"><span style="font-size:18px;font-weight:800">Total</span><span style="font-size:28px;font-weight:800;letter-spacing:-.5px">${fmt(tot)} RWF</span></div><div style="margin:12px 0 0;display:flex;justify-content:space-between;font-size:14px"><span class="mu">${T('Pay from','Payer depuis','Ishyura uvuye kuri')}</span><b>itunda Pay · ${fmt(S.pay)} RWF</b></div>${bad?`<div style="color:var(--er);font-size:14px;margin-top:10px">${T('Not enough balance — you have RWF ','Solde insuffisant — vous avez RWF ','Amafaranga ntahagije — ufite RWF ')}${fmt(S.pay)}</div>`:''}<div style="height:110px"></div></div><div class="cta"><button class="btn" ${bad||!ent.length?'disabled':''} onclick="shopPay()">${T('Pay','Payer','Ishyura')} ${fmt(tot)} RWF</button></div>`};
window.shopPay=()=>{const t=grand();$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div style="margin-bottom:12px">${gl('verified3d',60)}</div><div class="h1" style="font-size:22px;line-height:30px">${T('Confirm it’s you','Confirmez que c’est vous','Emeza ko ari wowe')}</div><div class="mu" style="font-size:15px;margin:8px 0 24px">${T('Pay','Payer','Ishyura')} ${fmt(t)} RWF · itunda Shop${S.promo?' · '+S.promo:''}</div><button class="btn" onclick="shopDone()">${T('Confirm','Confirmer','Emeza')}</button></div>`};
window.shopDone=()=>{const t=grand(),items=Object.entries(S.scart).filter(([i,q])=>q>0).map(([i,q])=>({i:+i,q})),pick=S.sdel==='pick';if(t>S.pay||!items.length){closeSheet();toast(T('Not enough balance','Solde insuffisant','Amafaranga ntahagije'));return}
items.forEach(({i,q})=>{PRODS[i].s=Math.max(0,PRODS[i].s-q)});
S.orders.unshift({k:'Shop order',s:'Processing',t,items,pick,ts:Date.now(),id:'IT-'+(4100+S.orders.length*13+Math.floor(Math.random()*9))});
S.orderTot=t;S.pay-=t;S.oN='itunda Shop';S.oE=pick?T('a day, at your pickup point','un jour, au point relais','umunsi umwe, aho gufatira'):T('1 to 2 days','1 à 2 jours','iminsi 1 kugeza kuri 2');S.scart={};S.promo=null;S.sdel='std';closeSheet();S.stack=['ordered'];render('push')};
const _od=screens.ordered;
screens.ordered=()=>{const h=_od();return S.oN==='itunda Shop'?h.replace(/<div class="cta" style="border:0"><button class="btn" onclick="done\(\)">Done<\/button><\/div>/,`<div class="cta" style="border:0;display:flex;gap:10px"><button class="btn" style="flex:1;background:var(--chip);color:inherit" onclick="S.stack=['shop','myorders'];render('push')">${T('My orders','Mes commandes','Ibyo naguze')}</button><button class="btn" style="flex:1" onclick="done()">${T('Done','Terminé','Byarangiye')}</button></div>`):h};
/* ---- order history, tracking, reorder ---- */
const ST=[['Processing','Traitement','Biri gutegurwa'],['Packed','Préparée','Byapakiwe'],['On the way','En route','Biri mu nzira'],['Delivered','Livrée','Byatanzwe']];
const stage=o=>Math.min(3,Math.floor((Date.now()-o.ts)/12000));
const sName=(o,s)=>o.pick&&s===2?T('Ready for pickup','Prête au retrait','Biteguye gufatwa'):T(...ST[s]);
const mine=()=>S.orders.filter(o=>o.k==='Shop order'&&o.items);
screens.myorders=()=>{const os=mine();os.forEach(o=>{o.s=ST[stage(o)][0]});
return `${bar(T('My orders','Mes commandes','Ibyo naguze'))}<div class="pad" style="padding-top:12px">${os.length?os.map((o,n)=>`<div style="padding:14px 16px;border-radius:20px;background:var(--chip);margin-bottom:12px"><div style="display:flex;justify-content:space-between"><b>${o.id}</b><b>${fmt(o.t)} RWF</b></div><div class="sm mu" style="margin:4px 0 8px">${o.items.map(x=>x.q+' × '+PRODS[x.i].n).join(', ')}</div><div style="font-weight:800;color:var(--lk);font-size:14px">${sName(o,stage(o))}</div><div style="display:flex;gap:8px;margin-top:10px"><button class="cch on" onclick="trackO(${n})">${T('Track','Suivre','Kurikirana')}</button><button class="cch" onclick="reorder(${n})">${T('Reorder','Recommander','Subiramo')}</button></div></div>`).join(''):`<div style="text-align:center;padding:60px 16px"><div style="font-size:18px;font-weight:800">${T('No orders yet','Aucune commande','Nta cyo urategeka')}</div><div class="sm mu" style="margin:6px 0 18px">${T('Your shop orders will show up here.','Vos commandes apparaîtront ici.','Ibyo uzagura bizagaragara hano.')}</div><button class="cch on" onclick="back()">${T('Start shopping','Commencer','Tangira guhaha')}</button></div>`}<div class="fine" style="padding-top:8px">${T('Sample data. Tracking advances every few seconds in this prototype.','Données d’exemple. Le suivi avance toutes les quelques secondes dans ce prototype.','Ni ingero. Gukurikirana bigenda byihuta muri iki kigereranyo.')}</div></div>`};
window.trackO=n=>{const o=mine()[n],s=stage(o);$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="h1" style="font-size:22px;line-height:30px;margin-bottom:12px">${o.id}</div>${ST.map((_,k)=>`<div style="display:flex;align-items:center;gap:12px;height:44px;font-size:16px;${k>s?'color:var(--tt)':'font-weight:800'}"><span aria-hidden="true" style="width:24px;height:24px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:13px;background:${k<=s?'var(--lk)':'var(--chip)'};color:${k<=s?'var(--on)':'inherit'}">${k<=s?'✓':k+1}</span>${sName(o,k)}</div>`).join('')}<button class="btn" style="margin-top:16px" onclick="closeSheet()">OK</button></div>`};
window.reorder=n=>{const o=mine()[n];let added=0;o.items.forEach(x=>{added+=addN(x.i,x.q)});if(added){S.stack=['shop','scart'];render('push')}};
})();
</script>
<style id="v73css">.pgrid{grid-template-columns:repeat(2,minmax(0,1fr))!important}.pgrid .pc{display:block;padding:0;min-width:0;overflow:hidden}.pgrid .pn,.pgrid .pm{overflow-wrap:anywhere}.pgrid .po,.pgrid .pc2{overflow-wrap:anywhere}</style>
<script>
/* v74: full Eats. Working Info + Reviews tabs, bigger menus, restaurant search + saved, tip, promo, kitchen note, switch-restaurant guard, rider call/message, cancel with refund, rating, order history + reorder. rw strings need native review */
(function(){
const T=(e,f,r)=>({en:e,fr:f,rw:r}[S.lang]||e);
Object.assign(S,{etab:'menu',efav:{},eq:'',efavOnly:false,etip:0,enote:'',epromo:null,ecancel:false});
const q$=s=>document.querySelector(s);
const more=[[['Cake slice','Vanilla sponge',2200,'bread'],['Samosa, 4 pieces','Beef or vegetable',1600,'mandazi'],['Hot milk tea','Spiced, large',1000,'juice']],
[['Beef skewer','Grilled with pilipili',2200,'brochette'],['Fish fillet','Tilapia, fried',4500,'brochette'],['Mixed salad','Tomato, cucumber, avocado',1800,'chips'],['Water, 500 ml','',500,'juice']],
[['Beans and rice','Slow-cooked beans',2000,'rice'],['Chicken stew','With vegetables',3500,'rice'],['Mango juice','Fresh',1500,'juice']],
[['Cappuccino','Rwandan arabica',2000,'coffee'],['Iced coffee','',2200,'coffee'],['Banana bread','Slice',1500,'bread']]];
const base=REST.map(r=>r.items.length);
more.forEach((m,i)=>{if(REST[i]&&REST[i].items.length===base[i])REST[i].items.push(...m)});
const INFO=[['KG 11 Ave, Kimironko','06:30 – 20:00','0788 000 101'],['KN 4 Rd, Nyamirambo','10:00 – 22:30','0788 000 102'],['KG 9 Ave, Kacyiru','08:00 – 21:00','0788 000 103'],['KG 15 Ave, Kimironko','07:00 – 19:00','0788 000 104']];
const REVS=[['Aline U.',5,'Fresh and still warm when it arrived.','2 days ago'],['Eric M.',4,'Good portions, a little late on Friday.','1 week ago'],['Claire M.',5,'My weekly order. Always right.','2 weeks ago']];
const PROMOS={EATS20:'20% off items (max 2,000 RWF)',FREEDEL:'Free delivery'};
const disc=()=>S.epromo==='EATS20'?Math.min(2000,Math.round(eSub()*.2)):0;
const dfee=()=>S.epromo==='FREEDEL'?0:eFee();
const tip=()=>S.pickup?0:S.etip;
const etot=()=>eSub()-disc()+dfee()+tip();
/* ---- list: search, saved, orders ---- */
const rc=(r,i)=>`<div class="rcard tap" onclick="openERest(${i})"><div class="rimg" style="background:${r.bg}">${gl(r.g,92)}${r.tag?`<span class="rtag">${r.tag}</span>`:''}<button class="hrt" aria-label="${T('Save','Enregistrer','Bika')} ${r.n}" aria-pressed="${!!S.efav[i]}" onclick="event.stopPropagation();eFav(${i})">${heart(S.efav[i])}</button></div><div style="display:flex;justify-content:space-between;align-items:baseline;margin-top:12px"><b style="font-size:17px;letter-spacing:-.3px">${r.n}</b><span class="sm" style="font-weight:800">★ ${r.r}</span></div><div class="sm mu" style="margin-top:2px">${r.t} min · ${r.d} km · ${r.rc} ${T('reviews','avis','ibitekerezo')}</div><div class="sm" style="margin-top:4px;font-weight:700;color:${r.fee?'var(--mu)':'var(--lk)'}">${r.fee?T('Delivery ','Livraison ','Kugezwaho ')+fmt(r.fee)+' RWF':T('Free delivery','Livraison gratuite','Kugezwaho ni ubuntu')} · Min ${fmt(r.min)} RWF</div></div>`;
const elist=()=>{const q=S.eq,l=eList().filter(([r,i])=>(!q||(r.n+' '+r.cat+' '+r.items.map(x=>x[0]).join(' ')).toLowerCase().includes(q))&&(!S.efavOnly||S.efav[i])&&eFltOk(r,i));
return l.length?l.map(([r,i])=>rc(r,i)).join(''):`<div style="text-align:center;padding:36px 24px"><div style="font-size:17px;font-weight:800">${T('No restaurants match','Aucun restaurant trouvé','Nta resitora ibonetse')}</div><div class="sm mu" style="margin:6px 0 14px">${T('Try another word, category or filter.','Essayez un autre mot, une autre catégorie ou un autre filtre.','Gerageza irindi jambo cyangwa ikindi cyiciro.')}</div><button class="cch on" onclick="eClear()">${T('Clear filters','Effacer les filtres','Kuraho ayo watoranyije')}</button></div>`};
const xrow=()=>{const nf=Object.values(S.efav).filter(Boolean).length,no=S.orders.filter(o=>o.k==='Eats order'&&o.items).length;return `<div class="chips" id="eextra" style="padding-top:14px"><button class="cch ${S.efavOnly?'on':''}" aria-pressed="${S.efavOnly}" onclick="eFavOnly()">♥ ${T('Saved','Favoris','Ibyabitswe')} (${nf})</button><button class="cch" onclick="S.stack=['shop','eorders'];render('push')">📦 ${T('Orders','Commandes','Ibyatumijwe')}${no?' ('+no+')':''}</button></div>`};
window.eFav=i=>{S.efav[i]=!S.efav[i];q$('#elist').innerHTML=elist();q$('#eextra').outerHTML=xrow()};
window.eFavOnly=()=>{S.efavOnly=!S.efavOnly;q$('#elist').innerHTML=elist();q$('#eextra').outerHTML=xrow()};
window.eSearch=v=>{S.eq=v.trim().toLowerCase();q$('#elist').innerHTML=elist()};
window.eClear=()=>{S.eq='';S.efavOnly=false;S.eflt={open:0,top:0,near:0};S.ecat='All';S.esort='fast';render('fade-none')};
window.setECat=c=>{S.ecat=c;q$('#ecats').innerHTML=eCatsHtml();q$('#elist').innerHTML=elist()};
window.setESort=k=>{S.esort=k;q$('#esort').innerHTML=eSortHtml();q$('#elist').innerHTML=elist()};
const _shop=screens.shop;
screens.shop=()=>{let h=_shop();if(S.shopTab!=='eats')return h;
const ph=T('Search restaurants','Rechercher des restaurants','Shakisha resitora');
h=h.replace('>Search restaurants<','><input id="eq" aria-label="'+ph+'" placeholder="'+ph+'" value="'+S.eq.replace(/"/g,'&quot;')+'" oninput="eSearch(this.value)" style="flex:1;min-width:0;border:0;background:transparent;font:inherit;color:inherit;outline:none"><');
return h.replace('<div class="chips" style="padding-top:18px;gap:6px" id="ecats"',xrow()+'<div class="chips" style="padding-top:18px;gap:6px" id="ecats"')};
new MutationObserver(()=>{const g=q$('#elist');if(g&&!g.dataset.v){g.dataset.v=1;g.innerHTML=elist()}}).observe(document.getElementById('phone'),{childList:true,subtree:true});
/* ---- guard: switching restaurant with a full cart ---- */
const _oe=window.openERest;
window.openERest=i=>{if(eCount()>0&&S.er!==i){$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="h1" style="font-size:22px;line-height:30px">${T('Start a new order?','Commencer une nouvelle commande ?','Tangira itegeko rishya?')}</div><div class="mu" style="font-size:15px;margin:8px 0 20px">${T('Your cart from '+REST[S.er].n+' will be cleared.','Votre panier de '+REST[S.er].n+' sera vidé.','Agaseke ka '+REST[S.er].n+' karasibwa.')}</div><button class="btn" onclick="closeSheet();S.ecart={};S.epromo=null;S.etab='menu';window.__oe(${i})">${T('Start new order','Nouvelle commande','Tangira rishya')}</button><button class="btn" style="margin-top:10px;background:var(--chip);color:inherit" onclick="closeSheet();window.__oe(${S.er})">${T('Keep current cart','Garder le panier','Guma ku gaseke')}</button></div>`;return}
S.etab='menu';_oe(i)};window.__oe=_oe;
/* ---- restaurant page: working tabs, saved heart, longer menu ---- */
const tabs=()=>['menu','info','reviews'].map(k=>[k,{menu:T('Menu','Menu','Ibiryo'),info:T('Info','Infos','Amakuru'),reviews:T('Reviews','Avis','Ibitekerezo')}[k]]);
window.eTab=k=>{S.etab=k;render('fade-none')};
const bar5=(n,p)=>`<div style="display:flex;align-items:center;gap:10px;font-size:13px"><span style="width:10px">${n}</span><div style="flex:1;height:8px;border-radius:4px;background:var(--chip)"><div style="width:${p}%;height:8px;border-radius:4px;background:var(--lk)"></div></div><span class="mu" style="width:34px;text-align:right">${p}%</span></div>`;
const _er=screens.erest;
screens.erest=()=>{let h=_er();const r=REST[S.er],I=INFO[S.er]||INFO[0],k=S.etab;
h=h.replace(/<span style="border-bottom[^>]*>Menu<\/span><span[^>]*>Info<\/span><span[^>]*>Reviews<\/span>/,tabs().map(([id,l])=>`<button role="tab" aria-selected="${k===id}" onclick="eTab('${id}')" style="border:0;background:none;font:inherit;font-weight:800;color:${k===id?'var(--tx)':'var(--tt)'};border-bottom:2px solid ${k===id?'var(--tx)':'transparent'};padding:0 0 8px">${l}</button>`).join(''));
h=h.replace(/(aria-label="Back"[\s\S]*?<\/button>)/,`$1<button class="hrt" style="top:14px;right:12px;background:var(--bg);border-radius:22px;width:44px;height:44px" aria-label="${T('Save','Enregistrer','Bika')}" aria-pressed="${!!S.efav[S.er]}" onclick="S.efav[S.er]=!S.efav[S.er];render('fade-none')">${heart(S.efav[S.er])}</button>`);
if(k==='info')return h.replace(/<div style="font-size:18px;font-weight:800;padding-top:18px">Popular<\/div>[\s\S]*?(?=<\/div><div class="pad fine")/,`<div style="padding-top:8px">${[[T('Address','Adresse','Aho biherereye'),I[0]],[T('Opening hours','Horaires','Amasaha yo gukora'),I[1]],[T('Phone','Téléphone','Telefoni'),I[2]],[T('Delivery area','Zone de livraison','Aho bigezwa'),'Up to 5 km'],[T('Pay with','Payer avec','Kwishyura'),'itunda Pay']].map(([a,b])=>`<div style="display:flex;justify-content:space-between;gap:12px;padding:14px 0;border-bottom:0;font-size:15px"><span class="mu">${a}</span><b style="text-align:right">${b}</b></div>`).join('')}</div>`);
if(k==='reviews'){const d=[62,25,8,3,2];return h.replace(/<div style="font-size:18px;font-weight:800;padding-top:18px">Popular<\/div>[\s\S]*?(?=<\/div><div class="pad fine")/,`<div style="display:flex;gap:18px;align-items:center;padding:18px 0"><div style="text-align:center"><div style="font-size:40px;font-weight:800;letter-spacing:-1px">${r.r}</div><div class="sm mu">${r.rc} ${T('reviews','avis','ibitekerezo')}</div></div><div style="flex:1;display:grid;gap:5px">${d.map((p,n)=>bar5(5-n,p)).join('')}</div></div>${REVS.map(v=>`<div style="padding:14px 0;border-top:0"><div style="display:flex;justify-content:space-between"><b>${v[0]}</b><span class="sm mu">${v[3]}</span></div><div style="font-weight:800;font-size:14px;margin:2px 0">${'★'.repeat(v[1])}${'☆'.repeat(5-v[1])}</div><div style="font-size:15px;line-height:21px">${v[2]}</div></div>`).join('')}`)}
const ix=h.split('<div class="mi">');if(ix.length>5){ix[4]+=`<div style="font-size:18px;font-weight:800;padding-top:22px">${T('More to order','Plus de choix','Ibindi wategeka')}</div>`}
return ix.join('<div class="mi">')};
/* ---- cart: kitchen note, tip, promo, full summary ---- */
window.eTip=v=>{S.etip=v;render('fade-none')};
window.eNote=v=>{S.enote=v};
window.ePromo=()=>{const c=(q$('#epm').value||'').trim().toUpperCase();if(PROMOS[c]&&(c!=='FREEDEL'||!S.pickup)){S.epromo=c;render('fade-none');toast(T('Code applied','Code appliqué','Kode yemewe'))}else q$('#eperr').textContent=!c?T('Enter a code first.','Saisissez d’abord un code.','Banza wandike kode.'):c==='FREEDEL'&&S.pickup?T('Free delivery only applies to delivery orders.','La livraison gratuite ne s’applique qu’aux livraisons.','Kugezwaho ku buntu bireba gutwarwa gusa.'):T('Code not valid. Try EATS20.','Code invalide. Essayez EATS20.','Kode ntiyemewe. Gerageza EATS20.')};
window.ePromoX=()=>{S.epromo=null;render('fade-none')};
const _ec=screens.echeck;
const sr=(a,b,c)=>`<div style="display:flex;justify-content:space-between;height:34px;align-items:center;font-size:15px"><span class="mu">${a}</span><b${c?` style="color:${c}"`:''}>${b}</b></div>`;
screens.echeck=()=>{let h=_ec();if(S.epromo==='FREEDEL'&&S.pickup)S.epromo=null;const r=REST[S.er],tot=etot(),bad=tot>S.pay,short=eSub()<r.min;
const tipH=S.pickup?'':`<div class="pad" style="padding-top:16px"><div style="font-size:15px;font-weight:800;margin-bottom:10px">${T('Tip your rider','Pourboire pour le livreur','Tanga inkunga ku mutwara')}</div><div class="req">${[0,500,1000,2000].map(v=>`<button class="${S.etip===v?'on':''}" onclick="eTip(${v})">${v?fmt(v):T('No tip','Aucun','Nta nkunga')}</button>`).join('')}</div></div>`;
const noteH=`<div class="pad" style="padding-top:16px"><div style="font-size:15px;font-weight:800;margin-bottom:8px">${T('Note for the restaurant','Note pour le restaurant','Ubutumwa bugenewe resitora')}</div><input id="enote" maxlength="80" value="${S.enote.replace(/"/g,'&quot;')}" oninput="eNote(this.value)" placeholder="${T('No onions, extra chili…','Sans oignons, piment en plus…','Nta yinzari, pilipili nyinshi…')}" aria-label="${T('Note for the restaurant','Note pour le restaurant','Ubutumwa bugenewe resitora')}" style="width:100%;box-sizing:border-box;height:44px;border-radius:14px;border:0;background:var(--chip);padding:0 14px;font:inherit;color:inherit"></div>`;
const prH=`<div class="pad" style="padding-top:16px">${S.epromo?`<div style="display:flex;justify-content:space-between;align-items:center;padding:10px 14px;border-radius:14px;background:var(--chip)"><span style="font-weight:800;font-size:14px">${S.epromo} · ${PROMOS[S.epromo]}</span><button class="cch" onclick="ePromoX()">${T('Remove','Retirer','Kuraho')}</button></div>`:`<div style="display:flex;gap:8px"><input id="epm" aria-label="${T('Promo code','Code promo','Kode y’igabanywa')}" placeholder="${T('Promo code','Code promo','Kode y’igabanywa')}" autocapitalize="characters" style="flex:1;min-width:0;height:44px;border-radius:14px;border:0;background:var(--chip);padding:0 14px;font:inherit;color:inherit"><button class="cch on" onclick="ePromo()">${T('Apply','Appliquer','Emeza')}</button></div><div id="eperr" role="alert" style="color:var(--er);font-size:13px;margin-top:6px"></div>`}</div>`;
const sum=`<div class="pad" style="padding-top:14px"><div style="border-top:0;padding-top:6px">${sr(T('Items','Articles','Ibintu'),fmt(eSub())+' RWF')}${disc()?sr(T('Discount','Remise','Igabanywa'),'−'+fmt(disc())+' RWF','var(--ok)'):''}${sr(S.pickup?T('Pickup','Retrait','Gufata'):T('Delivery','Livraison','Kugezwaho'),dfee()?fmt(dfee())+' RWF':T('Free','Gratuit','Ubuntu'))}${tip()?sr(T('Rider tip','Pourboire','Inkunga'),fmt(tip())+' RWF'):''}</div><div style="display:flex;justify-content:space-between;align-items:baseline;padding-top:6px"><span style="font-size:18px;font-weight:800">Total</span><span style="font-size:28px;font-weight:800;letter-spacing:-.5px">${fmt(tot)} RWF</span></div><div style="margin-top:14px;display:flex;justify-content:space-between;font-size:14px"><span class="mu">${T('Pay with','Payer avec','Kwishyura')}</span><b>itunda Pay · ${fmt(S.pay)} RWF</b></div>${short?`<div style="color:var(--er);font-size:14px;margin-top:10px">${T('Add RWF '+fmt(r.min-eSub())+' more to reach the minimum order.','Ajoutez RWF '+fmt(r.min-eSub())+' pour atteindre le minimum.','Ongeraho RWF '+fmt(r.min-eSub())+' kugira ngo ugere ku gipimo gito.')}</div>`:''}${bad?`<div style="color:var(--er);font-size:14px;margin-top:10px">${T('Not enough balance — you have RWF ','Solde insuffisant — vous avez RWF ','Amafaranga ntahagije — ufite RWF ')}${fmt(S.pay)}</div>`:''}<div style="height:110px"></div></div><div class="cta"><button class="btn" ${bad||short?'disabled':''} onclick="ePay()">${T('Pay','Payer','Ishyura')} ${fmt(tot)} RWF</button></div>`;
const cut=h.indexOf('<div class="pad" style="padding-top:14px"><div style="display:flex;justify-content:space-between;height:40px');
return (cut>0?h.slice(0,cut):h)+tipH+noteH+prH+sum};
window.ePay=()=>{const t=etot(),r=REST[S.er];$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div style="margin-bottom:12px">${gl('verified3d',60)}</div><div class="h1" style="font-size:22px;line-height:30px">${T('Confirm it’s you','Confirmez que c’est vous','Emeza ko ari wowe')}</div><div class="mu" style="font-size:15px;margin:8px 0 24px">${T('Pay','Payer','Ishyura')} ${fmt(t)} RWF · ${r.n}</div><button class="btn" onclick="eDone()">${T('Confirm','Confirmer','Emeza')}</button></div>`};
let eid=7200;
window.eDone=()=>{const tot=etot();if(tot>S.pay){closeSheet();toast(T('Not enough balance','Solde insuffisant','Amafaranga ntahagije'));return}
const items=Object.entries(S.ecart).filter(([k,q])=>q>0).map(([k,q])=>({k:+k,q}));
S.orders.unshift({k:'Eats order',s:'Order accepted',t:tot,r:S.er,items,pickup:S.pickup,note:S.enote,id:'EA-'+(eid+=7),rate:0});
S.pay-=tot;S.ecart={};S.enote='';S.epromo=null;S.etip=0;S.ecancel=false;S.trk=0;closeSheet();S.stack=['etrack'];render('push');trkStep(1,2600);trkStep(2,6500);trkStep(3,11500)};
const _ts=window.trkStep;window.trkStep=(k,ms)=>_ts(k,ms);
/* ---- tracking: rider call + message, cancel with refund, rate ---- */
const cur=()=>S.orders.find(o=>o.k==='Eats order');
const etx=()=>{const o=cur(),k=S.trk;if(!o)return '';
if(S.ecancel)return `<div class="sm mu" style="padding-top:8px">${T('Order cancelled. Refunded to itunda Pay.','Commande annulée. Remboursée sur itunda Pay.','Itegeko ryasibwe. Amafaranga yasubijwe.')}</div>`;
let b='';if(k===0)b=`<button class="cch" style="color:var(--er)" onclick="eCancel()">${T('Cancel order','Annuler la commande','Siba itegeko')}</button>`;
if(k===2&&!S.pickup)b+=`<button class="cch on" onclick="eRider()">${T('Message rider','Écrire au livreur','Andikira umutwara')}</button>`;
if(k>=3)b+=o.rate?`<span class="sm mu">${T('You rated','Votre note','Wabihaye amanota')} ${'★'.repeat(o.rate)}</span>`:`<button class="cch on" onclick="eRate()">★ ${T('Rate your order','Notez votre commande','Tanga amanota')}</button>`;
if(k>=3)b+=`<button class="cch" onclick="eHelp(0)">${T('Get help','Obtenir de l’aide','Gufashwa')}</button>`;
return b?`<div class="chips" style="padding-top:6px">${b}</div>`:`<div class="sm mu" style="padding-top:6px">${k===1?T('You can cancel only before the restaurant starts preparing.','Annulation possible avant la préparation uniquement.','Gusiba bishoboka mbere yuko batangira gutegura.'):''}</div>`};
const _et=screens.etrack;
screens.etrack=()=>{const h=_et();const c=h.indexOf('<div class="cta"');const blk=`<div class="pad" id="etx" style="padding-top:4px">${etx()}</div>`;return c>0?h.slice(0,c)+blk+h.slice(c):h+blk};
setInterval(()=>{const e=q$('#etx');if(e&&S.stack[S.stack.length-1]==='etrack'&&!q$('#layer .sheet')){const n=etx();if(e.innerHTML!==n)e.innerHTML=n}document.querySelectorAll('#rider button[aria-label="Call rider"]').forEach(b=>{b.setAttribute('onclick','eRider()')})},500);
window.eCancel=()=>{$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="h1" style="font-size:22px;line-height:30px">${T('Cancel this order?','Annuler cette commande ?','Kuraguza itegeko?')}</div><div class="mu" style="font-size:15px;margin:8px 0 20px">${T('You will get '+fmt(cur().t)+' RWF back in itunda Pay.','Vous récupérez '+fmt(cur().t)+' RWF sur itunda Pay.','Uzasubizwa '+fmt(cur().t)+' RWF muri itunda Pay.')}</div><button class="btn" onclick="eCancelGo()">${T('Cancel order','Annuler la commande','Siba itegeko')}</button><button class="btn" style="margin-top:10px;background:var(--chip);color:inherit" onclick="closeSheet()">${T('Keep order','Garder','Reka rikomeze')}</button></div>`};
window.eCancelGo=()=>{const o=cur();S.pay+=o.t;o.s='Cancelled';S.ecancel=true;S.trk=0;closeSheet();toast(T('Order cancelled','Commande annulée','Itegeko ryasibwe'));const e=q$('#eta');if(e)e.textContent=T('Cancelled','Annulée','Ryasibwe');const bt=q$('#edone');if(bt){bt.disabled=false;bt.textContent=T('Done','Terminé','Byarangiye')}};
const _ts2=window.trkStep;window.trkStep=(k,ms)=>{_ts2(k,ms)};
window.eRider=()=>{$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="h1" style="font-size:22px;line-height:30px;margin-bottom:12px">Jean Claude</div><button class="btn" onclick="closeSheet();toast('${T('Calling Jean Claude… (sample)','Appel de Jean Claude… (exemple)','Guhamagara Jean Claude… (urugero)')}')">${T('Call','Appeler','Hamagara')}</button><div class="sm mu" style="margin:16px 0 8px">${T('Quick message','Message rapide','Ubutumwa bwihuse')}</div><div class="chips" style="flex-wrap:wrap">${[[T('I’m at the gate','Je suis au portail','Ndi ku irembo'),0],[T('Please call me','Appelez-moi','Mpamagara'),1],[T('Leave it at the door','Laissez-le à la porte','Usige ku muryango'),2]].map(([l])=>`<button class="cch" onclick="closeSheet();toast('${T('Message sent','Message envoyé','Ubutumwa bwoherejwe')}')">${l}</button>`).join('')}</div></div>`};
let rs=5;
window.eRate=()=>{rs=5;eRateDraw()};
window.eRs=n=>{rs=n;eRateDraw()};
const eRateDraw=()=>{$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="h1" style="font-size:22px;line-height:30px">${T('How was your order?','Comment était votre commande ?','Itegeko ryawe ryagenze rite?')}</div><div style="display:flex;gap:6px;margin:14px 0 20px" role="radiogroup" aria-label="${T('Rating','Note','Amanota')}">${[1,2,3,4,5].map(n=>`<button class="ib" role="radio" aria-checked="${n===rs}" aria-label="${n}" style="font-size:34px;width:48px;height:48px;color:${n<=rs?'#F5A623':'var(--tt)'}" onclick="eRs(${n})">${n<=rs?'★':'☆'}</button>`).join('')}</div><button class="btn" onclick="eRateGo()">${T('Send rating','Envoyer','Ohereza')}</button></div>`};
window.eRateGo=()=>{const o=cur();if(o)o.rate=rs;closeSheet();toast(T('Thanks for your feedback','Merci pour votre avis','Murakoze ku bitekerezo byanyu'))};
/* ---- order history + reorder ---- */
const mine=()=>S.orders.filter(o=>o.k==='Eats order'&&o.items);
screens.eorders=()=>{const os=mine();return `${bar(T('Orders','Commandes','Ibyatumijwe'))}<div class="pad" style="padding-top:12px">${os.length?os.map((o,n)=>`<div style="padding:14px 16px;border-radius:20px;background:var(--chip);margin-bottom:12px"><div style="display:flex;justify-content:space-between"><b>${REST[o.r].n}</b><b>${fmt(o.t)} RWF</b></div><div class="sm mu" style="margin:2px 0">${o.id} · ${o.pickup?T('Pickup','Retrait','Gufata'):T('Delivery','Livraison','Kugezwaho')}${o.sched?' · '+o.sched:''}</div><div class="sm mu" style="margin-bottom:8px">${o.items.map(x=>x.q+' × '+REST[o.r].items[x.k][0]).join(', ')}</div><div style="font-weight:800;font-size:14px;color:${o.s==='Cancelled'?'var(--er)':'var(--lk)'}">${o.s}${o.rate?' · '+'★'.repeat(o.rate):''}${o.issue?' · '+T('Report sent','Signalement envoyé','Raporo yoherejwe'):''}</div><div class="chips" style="padding-top:10px"><button class="cch on" onclick="eReorder(${n})">${T('Reorder','Recommander','Subiramo')}</button><button class="cch" onclick="eRcpt(${n})">${T('Receipt','Reçu','Inyemezabwishyu')}</button>${o.s==='Cancelled'||o.issue?'':`<button class="cch" onclick="eHelp(${n})">${T('Help','Aide','Ubufasha')}</button>`}</div></div>`).join(''):`<div style="text-align:center;padding:60px 16px"><div style="font-size:18px;font-weight:800">${T('No orders yet','Aucune commande','Nta cyo urategeka')}</div><div class="sm mu" style="margin:6px 0 18px">${T('Your food orders will show up here.','Vos commandes de repas apparaîtront ici.','Ibyo uzatumiza bizagaragara hano.')}</div><button class="cch on" onclick="back()">${T('Browse restaurants','Voir les restaurants','Reba resitora')}</button></div>`}<div class="fine" style="padding-top:8px">${T('Sample data for this prototype.','Données d’exemple pour ce prototype.','Ni ingero muri iki kigereranyo.')}</div></div>`};
window.eReorder=n=>{const o=mine()[n];S.er=o.r;S.pickup=o.pickup;S.ecart={};o.items.forEach(x=>{S.ecart[x.k]=x.q});S.etab='menu';S.stack=['shop','erest','echeck'];render('push')};
})();
</script>
<script>
/* v75: Maps — true full-screen map: edge-to-edge, drag / pinch / wheel zoom, recenter, scale bar, larger world */
(function(){
const L=(e,r,f)=>({en:e,rw:r,fr:f}[S.lang]||e);
const M=()=>S.mp;
{const m=M();if(m.cx===undefined){m.cx=250;m.cy=440;m.z=3}m.fx=m.fx||0;m.layer=m.layer||0;m.cat=m.cat||'all'}
const st=document.createElement('style');
st.textContent='.screen:has(.fmap){overflow:hidden;padding-bottom:0}.fmap{position:absolute;inset:0;overflow:hidden;background:var(--chip)}.fmsurf{position:absolute;inset:0;touch-action:none;cursor:grab;user-select:none;-webkit-user-select:none}.fmsurf:active{cursor:grabbing}.fmsurf svg{width:100%;height:100%;display:block}.fmb{position:absolute;inset:0;display:flex;flex-direction:column;justify-content:flex-end;pointer-events:none;z-index:4}.fmb>*{pointer-events:auto}.fcrow{display:flex;justify-content:space-between;align-items:flex-end;padding:0 12px 12px;pointer-events:none}.fcrow>*{pointer-events:auto}.fcol{display:flex;flex-direction:column;gap:10px}.fcol .mb{position:relative;right:auto;top:auto;bottom:auto}.fcol .mb:disabled{opacity:.4}.fsc{background:var(--bg);box-shadow:none;border-radius:14px;padding:6px 12px;font-size:12px;font-weight:700;color:var(--tx);display:flex;flex-direction:column;gap:4px;min-width:60px}.fsc i{display:block;height:5px;border:2px solid var(--tx);border-top:0;margin-top:2px}.fms{background:var(--bg);border-radius:28px 28px 0 0;padding:10px 20px 22px;box-shadow:none;max-height:46%;overflow-y:auto;scrollbar-width:none}.fms.x{max-height:72%}';
document.head.appendChild(st);

/* more places so a bigger map is not empty */
const D=(x,y)=>Math.max(.1,Math.hypot(x-250,y-440)*.0125).toFixed(1)+' km';
[['hosp','hosp','🏥','King Faisal Hospital',360,230,'Hospital','4.5 (1.2k)','Open 24 hours'],
['hosp2','hosp','🏥','Kacyiru Clinic',-40,300,'Clinic','4.1 (64)','Open · closes 18:00'],
['cafe3','cafe','☕','Kimironko Coffee Corner',330,470,'Cafe','4.3 (88)','Open · closes 19:00'],
['cafe4','cafe','☕','Remera Brew',430,260,'Cafe','4.5 (301)','Open · closes 21:00'],
['rest2','food','🍽️','Kimironko Brochette',300,540,'Restaurant','4.3 (150)','Open · closes 22:00'],
['rest3','food','🍽️','Nyamirambo Kitchen',40,430,'Restaurant','4.6 (420)','Open · closes 23:00'],
['rest4','food','🍽️','Skyline Rooftop',140,-60,'Restaurant','4.4 (230)','Open · closes 00:00'],
['bus3','bus','🚌','Remera Taxi Park',460,330,'Bus stop · 305, 322','','Next: 322 in 4 min'],
['bus4','bus','🚌','Gisozi Stop',-110,170,'Bus stop · 102','','Next: 102 in 6 min'],
['bus5','bus','🚌','Kicukiro Centre Stop',330,650,'Bus stop · 311','','Next: 311 in 3 min'],
['pharm2','pharm','💊','Kimironko Pharma',330,410,'Pharmacy','4.0 (52)','Open · closes 20:00'],
['pharm3','pharm','💊','Remera Pharmacy',420,190,'Pharmacy','4.3 (77)','Open · closes 21:00'],
['atm2','atm','🏧','ATM · itunda Kimironko',290,450,'ATM','','24 hours'],
['atm3','atm','🏧','ATM · Remera Mall',470,280,'ATM','','24 hours']
].forEach(([id,c,e,n,x,y,k,r,o])=>{if(!POI.find(p=>p.id===id))POI.push({id,c,e,n,x,y,k,r,d:D(x,y),o})});

const CATS=[['all',L('All','Byose','Tout')],['cafe','☕ '+L('Cafe','Ikawa','Café')],['food','🍽️ '+L('Food','Ibiryo','Repas')],['bus','🚌 '+L('Bus stops','Bisi','Arrêts')],['hosp','🏥 '+L('Hospital','Ibitaro','Hôpital')],['pharm','💊 '+L('Pharmacy','Farumasi','Pharmacie')],['atm','🏧 ATM']];
const LAYERS=[L('Standard','Isanzwe','Standard'),L('Satellite','Isanzure','Satellite'),L('Terrain','Imiterere y’ubutaka','Relief')];
const HOODS=[];
const XS=[-210,-80,90,200,290,400,520,640],YS=[-130,-10,120,250,380,510,640,770,900];
const rv=x=>40+25*Math.sin(x/120);
const hs=(a,b)=>{const t=Math.sin(a*127.1+b*311.7)*43758.5453;return t-Math.floor(t)};
const gcache={};
const hy=(j,x)=>YS[j]-(j%2?6:12)*(x+330)/1100;
const vxf=(i,y)=>XS[i]+(i%2?10:20)*(y+260)/1300;
const hpath=j=>`M-330 ${YS[j]}L770 ${YS[j]-(j%2?6:12)}`;
const vpath=i=>`M${XS[i]} -260L${XS[i]+(i%2?10:20)} 1040`;
const majH=j=>j>=2&&j<=4,majV=i=>i>=2&&i<=4;
const HW='M-330 720C0 640 300 380 420 260S600 40 760 -60';
const HWS=(()=>{const s=[],B=(a,b,c,d,u)=>{const v=1-u;return[v*v*v*a[0]+3*v*v*u*b[0]+3*v*u*u*c[0]+u*u*u*d[0],v*v*v*a[1]+3*v*v*u*b[1]+3*v*u*u*c[1]+u*u*u*d[1]]};
for(let t=0;t<=20;t++){s.push(B([-330,720],[0,640],[300,380],[420,260],t/20));s.push(B([420,260],[540,140],[600,40],[760,-60],t/20))}return s})();
const ipt=(i,j)=>{let x=XS[i],y=YS[j];for(let n=0;n<4;n++){x=vxf(i,y);y=hy(j,x)}return[x,y]};
const hseg=(j,a,b,c,w)=>`<path d="M${a} ${hy(j,a)}L${b} ${hy(j,b)}" stroke="${c}" stroke-width="${w||6}" fill="none" stroke-linecap="round"/>`;
const vseg=(i,a,b,c,w)=>`<path d="M${vxf(i,a)} ${a}L${vxf(i,b)} ${b}" stroke="${c}" stroke-width="${w||6}" fill="none" stroke-linecap="round"/>`;
const route=(v,c)=>{const p=v.map(([i,j])=>ipt(i,j)),d='M'+p.map(a=>a[0].toFixed(1)+' '+a[1].toFixed(1)).join('L');
return `<path d="${d}" fill="none" stroke="#fff" stroke-width="10" stroke-linecap="round" stroke-linejoin="round"/><path d="${d}" fill="none" stroke="${c}" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/>`+p.map(a=>`<circle class="l-b" cx="${a[0].toFixed(1)}" cy="${a[1].toFixed(1)}" r="4" fill="#fff" stroke="${c}" stroke-width="2.5"/>`).join('')};
function ground(layer){if(gcache[layer])return gcache[layer];
let park='',trees='',sd='',bl='',pl='',bn='',x3='',pn='';
for(let i=0;i<XS.length-1;i++)for(let j=0;j<YS.length-1;j++){
const x0=XS[i]+10,x1=XS[i+1]-10,y0=YS[j]+10,y1=YS[j+1]-10,r=hs(i,j),cx=(x0+x1)/2,cy=(y0+y1)/2;
if(Math.abs(cy-rv(cx))<62)continue;
if(((cx-610)/95)**2+((cy-330)/58)**2<1)continue;
if(HWS.some(q=>Math.hypot(q[0]-cx,q[1]-cy)<38))continue;
if(r<.12){park+=`<rect x="${x0}" y="${y0}" width="${x1-x0}" height="${y1-y0}" rx="16" fill="var(--mp-park)" stroke="var(--mp-parkln)" stroke-width="1.4"/>`;
{const PN=['Green Park','City Garden','Memorial Park','Riverside Park'];pn+=`<text class="l-b pk" x="${((x0+x1)/2).toFixed(1)}" y="${((y0+y1)/2+2).toFixed(1)}" font-size="7" text-anchor="middle">${PN[Math.floor(hs(i+4,j)*4)]}</text>`}
for(let t=0;t<11;t++)trees+=`<circle class="l-c" cx="${(x0+10+hs(i+t,j)*(x1-x0-20)).toFixed(1)}" cy="${(y0+10+hs(i,j+t)*(y1-y0-20)).toFixed(1)}" r="${(2+hs(t,i+j)*1.6).toFixed(1)}" fill="var(--mp-tree)"/>`;continue}
if(r<.2){pl+=`<rect x="${x0+4}" y="${y0+4}" width="${x1-x0-8}" height="${y1-y0-8}" rx="8" fill="var(--mp-plaza)"/>`}
const p=5+hs(j,i)*5,nx=1+Math.floor(hs(i*3,j)*3),ny=1+Math.floor(hs(i,j*3)*2),cw=(x1-x0-2*p)/nx,ch=(y1-y0-2*p)/ny;
for(let a=0;a<nx;a++)for(let b=0;b<ny;b++){const g=2+hs(a+i*7,b+j*5)*3,w=cw-g,h=ch-g,bw=w*(.72+.28*hs(a*5+i,b*3+j)),bh=h*(.72+.28*hs(a*3+j,b*5+i)),bx=x0+p+a*cw+g/2+(w-bw)/2,by=y0+p+b*ch+g/2+(h-bh)/2;
{const ht=5+hs(a*7+i,b*3+j+2)*17,ox=-ht*.45,oy=-ht*.75,X0=bx,Y0=by,X1=bx+bw,Y1=by+bh,f=n=>n.toFixed(1);
x3+=`<path d="M${f(X1)} ${f(Y0)}L${f(X1+ox)} ${f(Y0+oy)}L${f(X1+ox)} ${f(Y1+oy)}L${f(X1)} ${f(Y1)}Z" fill="var(--mp-w1)"/><path d="M${f(X0)} ${f(Y1)}L${f(X0+ox)} ${f(Y1+oy)}L${f(X1+ox)} ${f(Y1+oy)}L${f(X1)} ${f(Y1)}Z" fill="var(--mp-w2)"/><rect x="${f(X0+ox)}" y="${f(Y0+oy)}" width="${f(bw)}" height="${f(bh)}" rx="2" fill="var(--mp-roof)" stroke="var(--mp-bl)" stroke-width=".7"/>`}
sd+=`<rect class="l-c" x="${(bx+2.5).toFixed(1)}" y="${(by+3).toFixed(1)}" width="${bw.toFixed(1)}" height="${bh.toFixed(1)}" rx="2" fill="var(--mp-sh)"/>`;
if(a===0&&b===0&&hs(i*2+1,j*2)>.38){const NN=['Market','Bank','School','Church','Clinic','Hotel','Office','Mall','Garage'];bn+=`<text class="l-c bn" x="${(bx+bw/2).toFixed(1)}" y="${(by+bh/2+2).toFixed(1)}" font-size="5.4" text-anchor="middle">${NN[Math.floor(hs(i,j+9)*9)]}</text>`}
bl+=`<rect x="${bx.toFixed(1)}" y="${by.toFixed(1)}" width="${bw.toFixed(1)}" height="${bh.toFixed(1)}" rx="2" fill="var(--mp-bldg)" stroke="var(--mp-bl)" stroke-width=".9"/>`}}
const riv='M-330 70C-150 10 40 80 200 30S560 60,770 20';
const water=`<path d="${riv}" fill="none" stroke="var(--mp-wln)" stroke-width="56" stroke-linecap="round"/><path d="${riv}" fill="none" stroke="var(--mp-water)" stroke-width="49" stroke-linecap="round"/><ellipse cx="610" cy="330" rx="76" ry="38" fill="var(--mp-water)" stroke="var(--mp-wln)" stroke-width="4"/><text class="rnw l-b" x="610" y="333" font-size="8.5" text-anchor="middle">Lake Muhazi</text>`;
let defs=`<path id="mpriv" d="${riv}"/><path id="mphw" d="${HW}"/>`,rn='';
const nmH={1:'KK 15 Rd',2:'KG 9 Ave',3:'KG 11 Ave',4:'KN 3 Rd',5:'KG 17 Ave',6:'KN 7 Rd'},nmV={1:'KK 3 Ave',2:'Boulevard de l\u2019Umuganda',3:'KN 5 Rd',4:'KG 2 Ave',5:'KK 31 Ave',6:'KN 9 Rd'};
YS.forEach((y,j)=>{if(!nmH[j])return;defs+=`<path id="mh${j}" d="${hpath(j)}"/>`;[22,66].forEach(o=>{rn+=`<text class="rn ${majH(j)?'l-b':'l-c'}" font-size="${majH(j)?7.6:6}"><textPath href="#mh${j}" startOffset="${o}%" text-anchor="middle" dy="${majH(j)?2.7:2.2}">${nmH[j]}</textPath></text>`})});
XS.forEach((x,i)=>{if(!nmV[i])return;defs+=`<path id="mv${i}" d="${vpath(i)}"/>`;[30,72].forEach(o=>{rn+=`<text class="rn ${majV(i)?'l-b':'l-c'}" font-size="${majV(i)?7.6:6}"><textPath href="#mv${i}" startOffset="${o}%" text-anchor="middle" dy="${majV(i)?2.7:2.2}">${nmV[i]}</textPath></text>`})});
rn+=`<text class="rn rnh l-b" font-size="8"><textPath href="#mphw" startOffset="38%" text-anchor="middle" dy="2.8">KN 1 Rd \u00b7 Parkway</textPath></text><text class="rnw l-b" font-size="8.5"><textPath href="#mpriv" startOffset="30%" text-anchor="middle" dy="3">Nyabarongo River</textPath></text>`;
let cs='',fs='';
YS.forEach((y,j)=>{if(!majH(j)){cs+=`<path class="rc rl" d="${hpath(j)}"/>`;fs+=`<path class="rf rl" d="${hpath(j)}"/>`}});
XS.forEach((x,i)=>{if(!majV(i)){cs+=`<path class="rc rl" d="${vpath(i)}"/>`;fs+=`<path class="rf rl" d="${vpath(i)}"/>`}});
YS.forEach((y,j)=>{if(majH(j)){cs+=`<path class="rc ra" d="${hpath(j)}"/>`;fs+=`<path class="rf ra" d="${hpath(j)}"/>`}});
XS.forEach((x,i)=>{if(majV(i)){cs+=`<path class="rc ra" d="${vpath(i)}"/>`;fs+=`<path class="rf ra" d="${vpath(i)}"/>`}});
cs+=`<path class="rc rh" d="${HW}"/>`;fs+=`<path class="rf rh" d="${HW}"/>`;
let ex='';
if(layer===1)ex=route([[0,4],[2,4],[2,3],[3,3],[3,2],[4,2],[6,2],[7,2]],'#2BA84A')+route([[4,0],[4,4],[3,4],[3,6],[5,7],[6,7]],'#9B59B6');
if(layer===2)ex=hseg(2,-330,150,'#D92D20')+hseg(2,150,770,'#F5B301')+hseg(3,-330,200,'#F5B301')+hseg(3,200,770,'#2BA84A')+hseg(4,-330,330,'#2BA84A')+hseg(4,330,770,'#D92D20')+vseg(3,-260,500,'#F5B301')+vseg(3,500,1040,'#2BA84A')+vseg(4,-260,420,'#D92D20')+vseg(2,-260,300,'#2BA84A')+vseg(2,300,1040,'#F5B301');
return gcache[layer]=`<defs>${defs}</defs><rect x="-400" y="-300" width="1240" height="1400" fill="var(--mp-land)"/>${water}${park}${pl}${sd}${bl}${trees}${cs}${fs}<g class="x3d">${x3}</g>${bn}${pn}${ex}${rn}`}

{const st2=document.createElement('style');st2.id='map-v465';st2.textContent=`.fmap{--mp-land:#F3F1EB;--mp-water:#A8D2F2;--mp-wln:#8FBFE6;--mp-park:#CFE7C3;--mp-parkln:#B6D8A8;--mp-tree:#A9D199;--mp-plaza:#EBE7DC;--mp-bldg:#E6E1D6;--mp-bl:#D3CDBF;--mp-sh:rgba(120,110,90,.16);--mp-road:#fff;--mp-rcl:#D8D3C6;--mp-rfa:#FFEAB0;--mp-rca:#E3C26E;--mp-rfh:#FFC98A;--mp-rch:#E49B4D;--mp-lbl:#2B2F36;--mp-halo:#fff;--mp-hood:#7A7F88;--mp-rn:#7C7466;--mp-rnw:#4D86B8;background:var(--mp-land)}
@media (prefers-color-scheme:dark){:root:not([data-theme=light]) .fmap{--mp-land:#191F28;--mp-water:#1E3B57;--mp-wln:#2A4D70;--mp-park:#1F3B2B;--mp-parkln:#2A4D39;--mp-tree:#2A5238;--mp-plaza:#252932;--mp-bldg:#292D37;--mp-bl:#363B47;--mp-sh:rgba(0,0,0,.28);--mp-road:#3B404C;--mp-rcl:#181A20;--mp-rfa:#5E4E27;--mp-rca:#2D2512;--mp-rfh:#7A5528;--mp-rch:#34240F;--mp-lbl:#E9ECF2;--mp-halo:#191F28;--mp-hood:#98A0AD;--mp-rn:#98A0AD;--mp-rnw:#7FAEDB}}
:root[data-theme=dark] .fmap{--mp-land:#191F28;--mp-water:#1E3B57;--mp-wln:#2A4D70;--mp-park:#1F3B2B;--mp-parkln:#2A4D39;--mp-tree:#2A5238;--mp-plaza:#252932;--mp-bldg:#292D37;--mp-bl:#363B47;--mp-sh:rgba(0,0,0,.28);--mp-road:#3B404C;--mp-rcl:#181A20;--mp-rfa:#5E4E27;--mp-rca:#2D2512;--mp-rfh:#7A5528;--mp-rch:#34240F;--mp-lbl:#E9ECF2;--mp-halo:#191F28;--mp-hood:#98A0AD;--mp-rn:#98A0AD;--mp-rnw:#7FAEDB}
.fmsurf svg path.rc,.fmsurf svg path.rf{fill:none;stroke-linecap:round;stroke-linejoin:round}
.fmsurf .rl.rc{stroke:var(--mp-rcl);stroke-width:8}.fmsurf .rl.rf{stroke:var(--mp-road);stroke-width:6}
.fmsurf .ra.rc{stroke:var(--mp-rca);stroke-width:12}.fmsurf .ra.rf{stroke:var(--mp-rfa);stroke-width:9.5}
.fmsurf .rh.rc{stroke:var(--mp-rch);stroke-width:16}.fmsurf .rh.rf{stroke:var(--mp-rfh);stroke-width:13}
.fmsurf svg[data-lod=a] .rl.rc{stroke-width:6}.fmsurf svg[data-lod=a] .rl.rf{stroke-width:4}
.fmsurf svg[data-lod=a] .ra.rc{stroke-width:9}.fmsurf svg[data-lod=a] .ra.rf{stroke-width:6.5}
.fmsurf svg[data-lod=a] .rh.rc{stroke-width:12}.fmsurf svg[data-lod=a] .rh.rf{stroke-width:9}
.fmsurf .l-b,.fmsurf .l-c{visibility:hidden}.fmsurf svg[data-lod=b] .l-b,.fmsurf svg[data-lod=c] .l-b,.fmsurf svg[data-lod=c] .l-c{visibility:visible}
.fmsurf .bn{fill:var(--mp-rn);font-weight:700;pointer-events:none}.fmsurf .rn{fill:var(--mp-rn);font-weight:700;letter-spacing:.3px;pointer-events:none}.fmsurf .rnw{fill:var(--mp-rnw);font-style:italic;font-weight:700;letter-spacing:1px;pointer-events:none}
.fmap .fms .hdl{position:relative;touch-action:none}.fmap .fms .hdl::after{content:'';position:absolute;left:-70px;right:-70px;top:-14px;bottom:-24px}
#phone .fmap .mcs.mvc{display:flex!important;position:absolute!important;left:0;right:0;top:70px!important;margin:0!important;height:auto!important;width:auto!important;padding:2px 12px!important;gap:8px;overflow-x:auto;scrollbar-width:none;z-index:5;background:none!important}#phone .fmap .mvc .ocp{flex:none;height:36px;padding:0 14px;border-radius:18px;border:0;background:var(--bg);color:var(--tx);font-weight:700;font-size:14px;box-shadow:0 1px 4px rgba(0,0,0,.18)}#phone .fmap .mvc .ocp.on{background:var(--lk);color:#fff}#phone .toast.mphint{top:118px}`;document.head.appendChild(st2)}

const zc=z=>Math.min(14,Math.max(.12,z));
let tw=0;
const surf=()=>document.querySelector('.fmsurf');
function bounds(){const m=M();m.z=zc(m.z);m.cx=Math.min(3000,Math.max(-3000,m.cx));m.cy=Math.min(3000,Math.max(-3000,m.cy))}
const CC={cafe:'#B5651D',food:'#F0643A',bus:'#2BA84A',hosp:'#E5484D',pharm:'#1FA37A',atm:'#2E6BF0',pin:'#7B61FF'};
function overlay(k,vx,vy,vw,vh){const m=M(),z=m.z,sf=surf(),sr=sf?sf.getBoundingClientRect():{left:0,top:0};
let vis=POI.filter(p=>(m.cat==='all'||p.c===m.cat)&&(p.id!=='drop'||m.sel==='drop'));
let o=(window.mpExtra?window.mpExtra(k):'')+(M().nohood?[]:HOODS).map(([n,x,y])=>`<text transform="translate(${x} ${y}) scale(${k})" font-size="11" font-weight="800" letter-spacing="1.6" text-anchor="middle" fill="var(--mp-hood)" stroke="var(--mp-halo)" stroke-width="3" paint-order="stroke" opacity="${z>2.4?.45:.95}">${n}</text>`).join('');
const rel=e=>{if(!e)return null;const r=e.getBoundingClientRect();return r.width?{l:r.left-sr.left,t:r.top-sr.top,r:r.right-sr.left,b:r.bottom-sr.top}:null};
const ui=[rel(document.querySelector('.fmap .fms')),rel(document.querySelector('.fmap .fcol')),rel(document.getElementById('fmsc'))].filter(Boolean);
const topY=118;
let it=vis.map(p=>({p,x:(p.x-vx)/k,y:(p.y-vy)/k})).filter(a=>a.x>-30&&a.x<vw+30&&a.y>-10&&a.y<vh+50);
const cl=[];
if(z<.85&&!m.sel){const c={};it.forEach(a=>{const q=Math.floor(a.x/66)+','+Math.floor(a.y/66);(c[q]=c[q]||[]).push(a)});it=[];Object.values(c).forEach(g=>g.length>1?cl.push(g):it.push(g[0]))}
cl.forEach(g=>{const wx=g.reduce((s,a)=>s+a.p.x,0)/g.length,wy=g.reduce((s,a)=>s+a.p.y,0)/g.length;
o+=`<g data-cl="${wx.toFixed(1)},${wy.toFixed(1)}" transform="translate(${wx.toFixed(1)} ${wy.toFixed(1)}) scale(${k})" style="cursor:pointer" role="button" aria-label="${g.length} places"><circle r="26" fill="transparent"/><circle r="15" fill="var(--lk)" stroke="#fff" stroke-width="3"/><text y="5" font-size="13" font-weight="800" text-anchor="middle" fill="#fff">${g.length}</text></g>`});
const boxes=it.map(a=>[a.x-13,a.y-26,a.x+13,a.y+2]),labs=[],hit=(b,list)=>list.some(c=>b[0]<c[2]+2&&b[2]>c[0]-2&&b[1]<c[3]+1&&b[3]>c[1]-1);
const ord=it.slice().sort((a,b)=>(b.p.id===m.sel)-(a.p.id===m.sel)||(parseFloat(b.p.r)||0)-(parseFloat(a.p.r)||0));
const lab={};
if(!m.nolab&&z>=.85)ord.forEach(a=>{const s=a.p.id===m.sel;let n=a.p.n;const mx=s?34:20;if(n.length>mx)n=n.slice(0,mx-1)+'\u2026';const w=n.length*(s?7.4:6.3)+4,x0=a.x+(s?24:16),b=[x0,a.y-(s?36:21),x0+w,a.y-(s?20:6)];
if(s){lab[a.p.id]=n;labs.push(b);return}
if(b[1]<topY||b[2]>vw-6||ui.some(u=>b[2]>u.l&&b[0]<u.r&&b[3]>u.t&&b[1]<u.b))return;
if(hit(b,labs)||hit(b,boxes.filter((_,i)=>it[i]!==a)))return;lab[a.p.id]=n;labs.push(b)});
o+=it.slice().sort((a,b)=>(a.p.id===m.sel)-(b.p.id===m.sel)||a.p.y-b.p.y).map(a=>{const p=a.p,s=m.sel===p.id,col=CC[p.c]||'#E8604C',n=lab[p.id];
const tx=n?`<text x="${s?24:16}" y="${s?-24:-9}" font-size="${s?13:11}" font-weight="${s?800:700}" fill="var(--mp-lbl)" stroke="var(--mp-halo)" stroke-width="3.2" stroke-linejoin="round" paint-order="stroke">${n.replace(/&/g,'&amp;').replace(/</g,'&lt;')}</text>`:'';
const mk=s?`<path d="M0 0C-11-13-18-19-18-29a18 18 0 0 1 36 0c0 10-7 16-18 29z" fill="${col}" stroke="#fff" stroke-width="2.5"/><circle cy="-29" r="11.5" fill="#fff"/><text y="-24" font-size="15" text-anchor="middle">${p.e}</text>`
:`<path d="M-5 -5L0 2L5 -5z" fill="${col}"/><circle cy="-13" r="11.5" fill="#fff" stroke="${col}" stroke-width="3"/><text y="-9" font-size="12" text-anchor="middle">${p.e}</text>`;
return `<g data-pin="${p.id}" transform="translate(${p.x} ${p.y}) scale(${k})" style="cursor:pointer" role="button" aria-label="${p.n.replace(/"/g,'')}"><circle cy="-14" r="24" fill="transparent"/>${mk}${tx}</g>`}).join('');
o+=`<g transform="translate(250 440) scale(${k})" pointer-events="none"><circle r="36" fill="#2E6BF0" opacity=".1"/><path d="M0 -5L-17 -40A44 44 0 0 1 17 -40Z" fill="#2E6BF0" opacity=".28"/><circle class="pulse" r="10" fill="#2E6BF0"/><circle r="9" fill="#2E6BF0" stroke="#fff" stroke-width="3"/></g>`;
return o}
function apply(){const s=surf();if(!s)return;const r=s.getBoundingClientRect();if(!r.width)return;bounds();const m=M(),vbw=340/m.z,vbh=vbw*r.height/r.width,k=vbw/r.width;
s.querySelector('svg').setAttribute('viewBox',`${m.cx-vbw/2} ${m.cy-vbh/2} ${vbw} ${vbh}`);
s.querySelector('svg').setAttribute('data-lod',m.z<.8?'a':m.z<1.7?'b':'c');if(window.__sa)window.__sa();const ov=s.querySelector('#fmov');if(ov)ov.innerHTML=overlay(k,m.cx-vbw/2,m.cy-vbh/2,r.width,r.height);
const sc=document.getElementById('fmsc');if(sc){const mpu=12.5,ppm=1/(k*mpu);let n=[20,50,100,200,500,1000,2000,5000].filter(v=>v*ppm<=110).pop()||20;sc.innerHTML=`<span>${n>=1000?n/1000+' km':n+' m'}</span><i style="width:${Math.round(n*ppm)}px"></i>`}
const zi=document.getElementById('fmzi'),zo=document.getElementById('fmzo');if(zi)zi.disabled=m.z>=14;if(zo)zo.disabled=m.z<=.12}
function tween(to,ms=320){const m=M(),f={cx:m.cx,cy:m.cy,z:m.z},t0=performance.now();cancelAnimationFrame(tw);
const step=t=>{const u=Math.min(1,(t-t0)/ms),e=1-Math.pow(1-u,3);m.cx=f.cx+(to.cx-f.cx)*e;m.cy=f.cy+(to.cy-f.cy)*e;m.z=f.z+(to.z-f.z)*e;apply();if(u<1)tw=requestAnimationFrame(step)};tw=requestAnimationFrame(step)}
function zoomAt(px,py,f){const s=surf();if(!s)return;const r=s.getBoundingClientRect(),m=M(),vbw=340/m.z,vbh=vbw*r.height/r.width,fx=(px-r.left)/r.width,fy=(py-r.top)/r.height,wx=m.cx-vbw/2+fx*vbw,wy=m.cy-vbh/2+fy*vbh;
const nz=zc(m.z*f),nw=340/nz,nh=nw*r.height/r.width;m.z=nz;m.cx=wx-fx*nw+nw/2;m.cy=wy-fy*nh+nh/2;apply()}
function fit(){const s=surf();if(!s)return;const m=M();apply();
if(m.sel&&m.fc!==m.sel){m.fc=m.sel;const p=POI.find(x=>x.id===m.sel);if(p){const r=s.getBoundingClientRect(),z=Math.max(m.z,3),vbh=340/z*r.height/r.width;tween({cx:p.x,cy:p.y+vbh*.16,z})}}else if(!m.sel)m.fc=null}

/* gestures */
const pts=new Map();let moved=false,pin=null;
document.addEventListener('pointerdown',e=>{if(!e.target.closest||!e.target.closest('.fmsurf'))return;cancelAnimationFrame(tw);pts.set(e.pointerId,{x:e.clientX,y:e.clientY,sx:e.clientX,sy:e.clientY});moved=false;if(pts.size===2){const [a,b]=[...pts.values()];pin={d:Math.hypot(a.x-b.x,a.y-b.y)||1,mx:(a.x+b.x)/2,my:(a.y+b.y)/2};moved=true}});
document.addEventListener('pointermove',e=>{const p=pts.get(e.pointerId);if(!p)return;const s=surf();if(!s){pts.clear();return}
if(pts.size===1){const dx=e.clientX-p.x,dy=e.clientY-p.y;if(!moved&&Math.hypot(e.clientX-p.sx,e.clientY-p.sy)>6)moved=true;p.x=e.clientX;p.y=e.clientY;if(moved){const r=s.getBoundingClientRect(),m=M(),k=(340/m.z)/r.width;m.cx-=dx*k;m.cy-=dy*k;apply()}}
else if(pts.size===2&&pin){p.x=e.clientX;p.y=e.clientY;const [a,b]=[...pts.values()],d=Math.hypot(a.x-b.x,a.y-b.y)||1,mx=(a.x+b.x)/2,my=(a.y+b.y)/2,r=s.getBoundingClientRect(),m=M(),k=(340/m.z)/r.width;m.cx-=(mx-pin.mx)*k;m.cy-=(my-pin.my)*k;zoomAt(mx,my,d/pin.d);pin={d,mx,my}}});
const up=e=>{pts.delete(e.pointerId);if(pts.size<2)pin=null;if(pts.size===1){const p=[...pts.values()][0];const s=e.target;p.x=p.sx=p.x}};
document.addEventListener('pointerup',up);document.addEventListener('pointercancel',up);
document.addEventListener('click',e=>{if(moved&&e.target.closest&&e.target.closest('.fmsurf')){e.stopPropagation();e.preventDefault();moved=false}},true);
document.addEventListener('wheel',e=>{if(!e.target.closest||!e.target.closest('.fmsurf'))return;e.preventDefault();cancelAnimationFrame(tw);zoomAt(e.clientX,e.clientY,Math.exp(-e.deltaY*.0015))},{passive:false});
window.addEventListener('resize',apply);

/* actions */
window.mpZoom=d=>{const m=M();tween({cx:m.cx,cy:m.cy,z:zc(m.z*(d>0?1.6:1/1.6))},220)};
window.mpLocate=()=>{const m=M(),s=surf(),r=s&&s.getBoundingClientRect(),z=Math.max(m.z,1.4),vbh=r?340/z*r.height/r.width:0;tween({cx:250,cy:440+vbh*.12,z});toast(L('Centered on you','Uri hano','Centré sur vous'))};
window.mpSheet=()=>{const m=M();m.fx=m.fx?0:1;render('fade-none')};
window.mpPin=id=>{const m=M();m.sel=m.sel===id?null:id;render('fade-none')};
window.mpCat=k=>{const m=M();m.cat=k;m.sel=null;render('fade-none')};
window.mpLayer=()=>{const m=M();m.layer=(m.layer+1)%3;toast(LAYERS[m.layer]);render('fade-none')};
window.openMaps=()=>{const m=M();m.sel=null;m.fc=null;S.stack=['mapview'];render('push')};

{const _ms=window.mpSheet,_mp=window.mpPin;
window.mpSheet=()=>{if(Date.now()-(window.__sw||0)<400)return;_ms()};
window.mpPin=id=>{if(Date.now()-(window.__sw||0)<400)return;_mp(id)};
document.addEventListener('click',e=>{const t=e.target.closest&&e.target.closest('[data-pin],[data-cl]');if(!t||!t.closest('.fmsurf'))return;
if(t.dataset.cl){const q=t.dataset.cl.split(',').map(Number),m=M();tween({cx:q[0],cy:q[1],z:zc(Math.max(m.z*1.9,.95))},320);return}
window.mpPin(t.dataset.pin)});
let sw=null;
document.addEventListener('pointerdown',e=>{const h=e.target.closest&&e.target.closest('.fmap .fms .hdl');if(h)sw={y:e.clientY,id:e.pointerId}},true);
document.addEventListener('pointerup',e=>{if(!sw||sw.id!==e.pointerId)return;const dy=e.clientY-sw.y;sw=null;if(Math.abs(dy)<28)return;window.__sw=Date.now();const m=M();
if(m.sel){if(dy>0)_mp(m.sel)}else{const w=dy<0?1:0;if((m.fx?1:0)!==w){m.fx=w;render('fade-none')}}},true);
document.addEventListener('pointercancel',()=>{sw=null},true)}

{const s3=document.createElement('style');s3.id='map-v467';s3.textContent=`.fmap{--mp-roof:#F7F4ED;--mp-w1:#D6D0C3;--mp-w2:#C5BEAF;--mp-pk:#5E8F55}@media (prefers-color-scheme:dark){:root:not([data-theme=light]) .fmap{--mp-roof:#3C4250;--mp-w1:#1F222A;--mp-w2:#17191F;--mp-pk:#6FA676}}:root[data-theme=dark] .fmap{--mp-roof:#3C4250;--mp-w1:#1F222A;--mp-w2:#17191F;--mp-pk:#6FA676}.fmsurf .x3d{display:none}.fmsurf svg[data-3d="1"] .x3d{display:inline}.fmsurf .pk{fill:var(--mp-pk);font-weight:700;pointer-events:none}.fmap .fcol #fm3d{font-size:14px;font-weight:800;color:var(--tx)}.fmap .fcol #fm3d.on{background:var(--lk);color:#fff}`;document.head.appendChild(s3)}
{/* v466: fling inertia, double-tap zoom, search-this-area */
let fl=0,smp=[],down=0,lastTap={t:0,x:0,y:0},zf=0;
const onS=e=>e.target.closest&&e.target.closest('.fmsurf');
document.addEventListener('pointerdown',e=>{if(!onS(e))return;cancelAnimationFrame(fl);down++;smp=[{t:e.timeStamp,x:e.clientX,y:e.clientY}]},true);
document.addEventListener('pointermove',e=>{if(down!==1||!smp.length)return;smp.push({t:e.timeStamp,x:e.clientX,y:e.clientY});if(smp.length>6)smp.shift()},true);
const endF=e=>{if(!down)return;down=Math.max(0,down-1);if(down)return;smp.push({t:e.timeStamp,x:e.clientX,y:e.clientY});const s0=smp;smp=[];const sf=surf();if(!sf||s0.length<2)return;
const s=s0.filter(q=>q.t>=e.timeStamp-110);const a=s[0]||s0[0],b=s0[s0.length-1],dt=b.t-a.t;
if(e.type==='pointerup'&&dt<50&&Math.hypot(b.x-a.x,b.y-a.y)<8&&!(e.target.closest&&e.target.closest('[data-pin],[data-cl]'))){const n=e.timeStamp;
 if(n-lastTap.t<320&&Math.hypot(e.clientX-lastTap.x,e.clientY-lastTap.y)<30){lastTap.t=0;let c=0;cancelAnimationFrame(zf);const st=()=>{zoomAt(e.clientX,e.clientY,Math.pow(2,1/7));if(++c<7)zf=requestAnimationFrame(st)};zf=requestAnimationFrame(st);return}
 lastTap={t:n,x:e.clientX,y:e.clientY};return}
if(e.type!=='pointerup'||dt<=0||dt>140)return;let vx=(b.x-a.x)/dt,vy=(b.y-a.y)/dt;if(Math.hypot(vx,vy)<.2)return;
let t0=performance.now();const step=t=>{const d=Math.min(40,t-t0);t0=t;const m=M(),r=sf.getBoundingClientRect(),k=(340/m.z)/r.width;m.cx-=vx*d*k;m.cy-=vy*d*k;apply();const f=Math.pow(.94,d/16);vx*=f;vy*=f;if(Math.hypot(vx,vy)>.03&&surf()===sf)fl=requestAnimationFrame(step)};fl=requestAnimationFrame(step)};
document.addEventListener('pointerup',endF,true);document.addEventListener('pointercancel',endF,true);
window.mpSearchArea=()=>{const m=M();m.ctr={x:m.cx,y:m.cy};render('fade-none');toast(L('Results for this area','Ibisubizo by\u2019aha hantu','R\u00e9sultats pour cette zone'))};
window.mp3d=()=>{const m=M();m.d3=!m.d3;if(m.d3&&m.z<1.4){const r=surf().getBoundingClientRect();tween({cx:m.cx,cy:m.cy,z:1.8},350)}render('fade-none')};
window.__sa=()=>{const m=M(),f=document.querySelector('.fmap');if(!f)return;
const sv3=f.querySelector('.fmsurf svg');if(sv3)sv3.setAttribute('data-3d',m.d3&&m.z>=1.2?'1':'0');
const fc=f.querySelector('.fcol');if(fc&&!document.getElementById('fm3d')){const t=document.createElement('button');t.id='fm3d';t.className='mb'+(m.d3?' on':'');t.setAttribute('aria-label','3D buildings');t.setAttribute('aria-pressed',m.d3?'true':'false');t.setAttribute('onclick','mp3d()');t.textContent='3D';fc.insertBefore(t,fc.firstChild)}let b=document.getElementById('fmsa');
if(!b){b=document.createElement('button');b.id='fmsa';b.setAttribute('onclick','mpSearchArea()');b.style.cssText='position:absolute;left:50%;top:118px;transform:translateX(-50%);z-index:6;height:38px;padding:0 16px;border:0;border-radius:19px;background:var(--bg);color:var(--lk);font-weight:800;font-size:14px;box-shadow:0 2px 8px rgba(0,0,0,.22);display:none;white-space:nowrap';b.textContent='\u21bb '+L('Search this area','Shakisha hano','Rechercher ici');f.appendChild(b)}
const c=m.ctr||{x:190,y:300};b.style.display=(!m.sel&&Math.hypot(m.cx-c.x,m.cy-c.y)*m.z>70)?'block':'none'};
}

const sv=id=>id==='cafe'?!!M().star:!!(M().sv&&M().sv[id]);
screens.mapview=()=>{const m=M(),vis=POI.filter(p=>(m.cat==='all'||p.c===m.cat)&&(p.id!=='drop'||m.sel==='drop')),sel=POI.find(p=>p.id===m.sel),n=POI.filter(p=>sv(p.id)).length;
const cc=m.ctr||{x:250,y:440};const rows=vis.filter(p=>p.id!=='drop').sort((a,b)=>Math.hypot(a.x-cc.x,a.y-cc.y)-Math.hypot(b.x-cc.x,b.y-cc.y)).slice(0,m.fx?9:3);
const sheet=sel?`<div class="fms"><div class="hdl" onclick="mpPin('${sel.id}')"></div><div style="display:flex;align-items:center;gap:8px"><b style="flex:1;font-size:22px;letter-spacing:-.3px">${sel.n}</b><button class="ib" style="background:var(--chip);border-radius:22px" aria-label="Close" onclick="mpPin('${sel.id}')">${ic('plus',20).replace('<svg','<svg style="transform:rotate(45deg)"')}</button></div><div class="sm mu" style="margin-top:4px">${sel.k}${sel.r?' · ★ '+sel.r:''}</div><div style="margin-top:6px;font-size:15px"><b style="color:#2BA84A">${sel.o}</b> · ${sel.d}</div><div class="acts" style="padding:14px 0 0"><button class="p" onclick="mpDepart('${sel.id}')">${L('Depart','Gutangira','Départ')}</button><button class="q" onclick="mpArriveAt('${sel.id}')">${L('Arrive','Kugerayo','Arrivée')}</button><button onclick="mpOpenPoi('${sel.id}')">${L('Details','Amakuru','Détails')}</button></div></div>`
:`<div class="fms${m.fx?' x':''}"><div class="hdl" onclick="mpSheet()" role="button" aria-label="Expand"></div><b style="font-size:19px">${L('Nearby','Hafi yawe','À proximité')}</b>${rows.map(p=>`<div class="pc tap" onclick="mpPin('${p.id}')"><i>${p.e}</i><div style="flex:1;min-width:0"><b style="font-size:16px">${p.n}</b><div class="sm mu">${p.k}</div></div><span class="sm mu">${p.d}</span></div>`).join('')||`<div class="mu" style="padding:16px 0">${L('Nothing nearby','Nta kintu hafi','Rien à proximité')}</div>`}</div>`;
return `<div class="fmap"><div class="fmsurf"><svg viewBox="0 0 340 740" preserveAspectRatio="xMidYMid slice" role="img" aria-label="Map of Kigali"><g id="fmg">${ground(m.layer)}</g><g id="fmov"></g></svg></div>
<div class="mvs"><button class="ib" aria-label="Back" onclick="back()" style="color:var(--tx)">${ic('back',22)}</button><span style="flex:1" onclick="mpGo('mapsearch')">${L('Search places, bus stops, addresses','Shakisha ahantu, aho bisi zihagarara','Lieux, arrêts, adresses')}</span><button class="ib" aria-label="Search" onclick="mpGo('mapsearch')">${ic('search',20,'var(--tt)')}</button></div>
<div class="mcs mvc" style="padding:0 12px">${CATS.map(([k,l])=>`<button class="ocp ${m.cat===k?'on':''}" onclick="mpCat('${k}')">${l}</button>`).join('')}</div>
<div class="fmb"><div class="fcrow"><div style="display:flex;flex-direction:column;gap:8px;align-items:flex-start"><div id="fmsc" class="fsc"></div>${m.layer?`<div class="fsc" style="flex-direction:row">${LAYERS[m.layer]}</div>`:''}</div><div class="fcol">
<button class="mb" aria-label="Layers: ${LAYERS[m.layer]}" onclick="mpLayer()">${ic('grid',20,m.layer?'var(--lk)':'var(--tx)')}</button>
<button class="mb" aria-label="${L('Saved places','Ahantu wabitse','Lieux enregistrés')}" onclick="mpGo('mpsaved')">${ic('star',20,'#2E6BF0')}${n?`<span style="position:absolute;right:-2px;top:-2px;min-width:18px;height:18px;padding:0 5px;border-radius:9px;background:var(--lk);color:#fff;font-size:11px;font-weight:800;display:flex;align-items:center;justify-content:center">${n}</span>`:''}</button>
<button class="mb" id="fmzi" aria-label="Zoom in" onclick="mpZoom(1)">${ic('plus',20)}</button><button class="mb" id="fmzo" aria-label="Zoom out" onclick="mpZoom(-1)">${ic('minus',20)}</button>
<button class="mb" aria-label="My location" onclick="mpLocate()">${ic('pin',20,'#2E6BF0')}</button></div></div>${sheet}</div></div>`};

/* post-render hook */
const _r=window.render;
window.render=function(){const o=_r.apply(this,arguments);[0,40,120,420].forEach(t=>setTimeout(fit,t));return o};
})();
</script>
<script>
/* v76: Pay — full pay hub: balance card, scan to pay, till number, pay code, bills, airtime, transit, pay-from source, receipts */
(function(){
const esc=s=>String(s).replace(/</g,'&lt;');
const SA=(typeof SA33!=='undefined')?SA33:[['Amina K.','0788 000 214'],['Eric M.','0781 234 567']];
const L=(e,r,f)=>({en:e,rw:r||e,fr:f||e}[S.lang]||e);
if(!S.psrc)S.psrc='pay';
S.pm=S.pm||{n:'',sub:'',amt:'',g:'bag'};S.atm=S.atm||{op:'MTN',amt:1000};
const TILLS={'123456':'Kigali Bakery','204518':'Nyamirambo Coffee House','731902':'Simba Supermarket'};
const SAMPLE=Object.entries(TILLS);
const st=document.createElement('style');
st.textContent='.ppa{display:flex;flex-direction:column;align-items:center;gap:8px;flex:1;border:0;background:none;color:var(--tintfg);font:inherit;font-size:13px;font-weight:700}.ppa i{width:52px;height:52px;border-radius:26px;background:var(--bg);color:var(--tx);display:flex;align-items:center;justify-content:center}.ppg{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;padding:0 24px}.ppg button{border:0;background:var(--chip);border-radius:20px;padding:14px 4px 12px;display:flex;flex-direction:column;align-items:center;gap:8px;font:inherit;font-size:13px;font-weight:700;color:var(--tx)}.ppv{position:absolute;inset:0;background:#0D0D10;color:#fff;overflow:hidden}.ppv .fr{position:absolute;left:50%;top:34%;width:240px;height:240px;margin:-120px 0 0 -120px}.ppv .fr i{position:absolute;width:38px;height:38px;border:4px solid #fff}.ppv .ln{position:absolute;left:8px;right:8px;height:3px;border-radius:2px;background:var(--br);box-shadow:none;animation:ppl 2.2s ease-in-out infinite alternate}@keyframes ppl{from{top:8px}to{top:226px}}.ppm{display:flex;align-items:center;gap:12px;padding:12px 14px;border-radius:16px;background:rgba(255,255,255,.1);border:0;color:#fff;font:inherit;font-size:15px;font-weight:700;width:100%;text-align:left}';
document.head.appendChild(st);
const bal=()=>S.psrc==='bank'?S.bank:S.pay;
const srcN=()=>S.psrc==='bank'?'itunda Bank':'itunda Pay';
const srcChips=()=>`<div class="req" style="margin-top:10px">${[['pay','itunda Pay',S.pay],['bank','itunda Bank',S.bank]].map(([k,n,b])=>`<button class="${S.psrc===k?'on':''}" onclick="ppSrc('${k}')">${n} · ${fmt(b)}</button>`).join('')}</div>`;
window.ppSrc=k=>{S.psrc=k;render('fade-none')};
window.ppGo=n=>{S.stack.push(n);render('push')};

/* ---- hub ---- */
screens.pay=()=>{
const acts=[['qr',L('Scan','Sikana','Scanner'),"ppGo('paysc')"],['send',t('send'),'flow()'],['recv',L('Request','Saba','Demander'),'reqSheet()'],['plus',L('Add','Ongeramo','Ajouter'),'sheetAdd()']];
const tiles=[['qr',L('Scan to pay','Sikana wishyure','Scanner'),"ppGo('paysc')"],['cash',L('Till number','Nimero y’umucuruzi','N° de caisse'),"ppGo('paytill')"],['bill',L('Pay bills','Kwishyura fagitire','Factures'),'openBill()'],['phone',L('Airtime','Airtime','Crédit'),'ppAir()'],['bus',L('Transit','Ingendo','Transport'),'openTransit()'],['up',L('Activity','Ibyakozwe','Activité'),'openAct()']];
const rec=SA.map(([n,p])=>`<button class="tap" onclick="sendAgain('${p}')" aria-label="Send to ${n}" style="flex:0 0 64px;border:0;background:none;display:flex;flex-direction:column;align-items:center;gap:8px;font-size:12px;font-weight:700;color:var(--tx)"><span style="width:56px;height:56px;border-radius:28px;background:var(--tint);color:var(--tintfg);display:flex;align-items:center;justify-content:center;font-size:18px;font-weight:800">${n[0]}</span>${n.split(' ')[0]}</button>`).join('');
return `${topbar('<b style="font-size:22px">Pay</b>')}
<div class="pad" style="padding-top:20px"><div style="background:var(--tint);border-radius:28px;padding:20px 12px 18px"><div style="padding:0 8px"><div class="sm" style="font-weight:700;color:var(--tintfg)">${t('md')}</div><div class="big" style="margin-top:4px">${fmt(S.pay)} RWF</div></div><div style="display:flex;margin-top:18px">${acts.map(([i,l,o])=>`<button class="ppa tap" onclick="${o}"><i>${ic(i,24)}</i>${l}</button>`).join('')}</div></div></div>
<div class="pad" style="padding-top:14px"><div class="tap" onclick="ppCode()" style="display:flex;align-items:center;gap:14px;background:var(--chip);border-radius:24px;padding:14px 16px;cursor:pointer"><div style="width:64px;height:64px;border-radius:16px;background:#fff;display:flex;align-items:center;justify-content:center">${gl('qr3d',52)}</div><div style="flex:1"><div style="font-size:17px;font-weight:800">${L('My payment code','Kode yanjye yo kwishyura','Mon code de paiement')}</div><div class="sm mu" style="margin-top:2px;line-height:19px">${L('Show this code at the till to pay.','Erekana iyi kode ku kazi kwishyura.','Montrez ce code en caisse pour payer.')}</div></div>${ic('chev',16,'var(--tt)')}</div></div>
<div class="agt" style="padding-top:26px">${L('Pay with','Ishyura ukoresheje','Payer avec')}</div><div class="pad" style="padding-top:0;padding-bottom:6px">${srcChips()}</div>
<div class="agt" style="padding-top:20px">${L('Ways to pay','Uburyo bwo kwishyura','Moyens de payer')}</div><div class="ppg">${tiles.map(([i,l,o])=>`<button class="tap" onclick="${o}">${gx(i,34)}${l}</button>`).join('')}</div>
<div class="sec" style="padding-top:26px;padding-bottom:12px"><div class="sech" style="margin:0">${L('Send again','Ohereza ukundi','Renvoyer')}</div></div><div class="chips" style="gap:14px">${rec}</div>
<div class="sec"><div class="sech">${L('Recent activity','Ibyakozwe vuba','Activité récente')}<a onclick="openAct()">${L('See all','Byose','Tout voir')}</a></div>${S.act.slice(0,3).map((x,i)=>row(x[0],x[1],x[2],signed(x[3]),'actOpen('+i+')')).join('')}</div>
<div class="sec"><div class="sech">More</div>${row('star',t('pr'),'','6,400')}${row('gift',t('cr'),'','0')}${row('recv',t('rq'),'','','reqSheet()')}${row('cash',t('cs'))}${row('card','itunda card','Debit card for your itunda Bank account','','openCard()')}</div>`};

/* ---- scan ---- */
screens.paysc=()=>`<div class="ppv"><div style="position:absolute;top:0;left:0;right:0;display:flex;align-items:center;padding:12px 8px;z-index:2"><button class="ib" aria-label="Back" onclick="back()" style="color:#fff">${ic('back',24)}</button><b style="flex:1;text-align:center;font-size:17px;margin-right:40px">${L('Scan to pay','Sikana wishyure','Scanner pour payer')}</b></div>
<div class="fr">${['top:0;left:0;border-right:0;border-bottom:0;border-radius:14px 0 0 0','top:0;right:0;border-left:0;border-bottom:0;border-radius:0 14px 0 0','bottom:0;left:0;border-right:0;border-top:0;border-radius:0 0 0 14px','bottom:0;right:0;border-left:0;border-top:0;border-radius:0 0 14px 0'].map(s=>`<i style="${s}"></i>`).join('')}<div class="ln"></div></div>
<div style="position:absolute;left:0;right:0;top:calc(34% + 150px);text-align:center;font-size:15px;font-weight:600;padding:0 24px;opacity:.9">${L('Point the camera at a merchant QR code','Erekeza kamera kuri QR y’umucuruzi','Pointez la caméra vers le code QR du commerçant')}</div>
<div style="position:absolute;left:20px;right:20px;bottom:28px"><div style="font-size:13px;font-weight:700;opacity:.7;margin-bottom:8px">${L('Try a sample code (prototype)','Gerageza kode y’icyitegererezo','Essayez un code d’exemple')}</div><div style="display:flex;flex-direction:column;gap:8px">${SAMPLE.map(([k,n])=>`<button class="ppm tap" onclick="ppMerch('${k}')">${gx('qr',26)}<span style="flex:1">${n}</span>${ic('chev',16,'#fff')}</button>`).join('')}<button class="ppm tap" onclick="S.stack[S.stack.length-1]='paytill';render('fade-none')">${gx('cash',26)}<span style="flex:1">${L('Enter till number instead','Andika nimero y’umucuruzi','Saisir le numéro de caisse')}</span>${ic('chev',16,'#fff')}</button></div></div></div>`;
window.ppMerch=k=>{S.pm={n:TILLS[k],sub:L('Till','Nimero','Caisse')+' '+k,amt:'',g:'bag'};S.stack[S.stack.length-1]='payamt';render('push')};

/* ---- till number ---- */
S.tl=S.tl||'';
screens.paytill=()=>{const v=S.tl,ok=TILLS[v],bad=v.length===6&&!ok;return `${bar(L('Till number','Nimero y’umucuruzi','Numéro de caisse'))}<div class="pad" style="padding-top:20px"><div class="h1">${L('Enter the merchant’s till number','Andika nimero y’umucuruzi','Saisissez le numéro de caisse')}</div><input class="in" id="tln" inputmode="numeric" maxlength="6" value="${v}" oninput="ppTill(this.value)" placeholder="000000" aria-label="Till number" style="margin-top:20px"><div id="tlm" class="sm ${bad?'':'mu'}" style="margin-top:8px;${bad?'color:var(--er)':''}">${ok?'✓ '+ok:bad?L('No merchant found for this number (sample).','Nta mucuruzi uboneka (icyitegererezo).','Aucun commerçant trouvé (exemple).'):v.length+'/6'}</div><div class="sm mu" style="margin-top:18px">${L('Sample tills','Nimero z’icyitegererezo','Caisses d’exemple')}</div><div class="req" style="margin-top:8px">${SAMPLE.map(([k])=>`<button onclick="ppTill('${k}',1)">${k}</button>`).join('')}</div></div><div class="cta"><button id="tlb" class="btn" ${ok?'':'disabled'} onclick="ppMerch('${v}')">${L('Next','Komeza','Suivant')}</button></div>`};
window.ppTill=(v,full)=>{S.tl=String(v).replace(/\D/g,'').slice(0,6);if(full){render('fade-none');return}const ok=TILLS[S.tl],bad=S.tl.length===6&&!ok,m=document.getElementById('tlm'),b=document.getElementById('tlb');if(m){m.className='sm '+(bad?'':'mu');m.style.color=bad?'var(--er)':'';m.textContent=ok?'✓ '+ok:bad?L('No merchant found for this number (sample).','Nta mucuruzi uboneka (icyitegererezo).','Aucun commerçant trouvé (exemple).'):S.tl.length+'/6'}if(b){b.disabled=!ok;b.setAttribute('onclick',"ppMerch('"+S.tl+"')")}};

/* ---- amount ---- */
const amtMsg=()=>{const v=Number(S.pm.amt||0);return v>bal()?t('insuff').replace('%s',fmt(bal())):L('From ','Uvuye kuri ','Depuis ')+srcN()+' · '+fmt(bal())+' RWF'};
screens.payamt=()=>{const m=S.pm,v=Number(m.amt||0),bad=v>bal();return `${bar('')}<div class="pad" style="padding-top:4px;display:flex;align-items:center;gap:14px"><div style="width:52px;height:52px;border-radius:26px;background:var(--tint);color:var(--tintfg);display:flex;align-items:center;justify-content:center;font-size:20px;font-weight:800">${esc(m.n)[0]||'?'}</div><div><div style="font-size:18px;font-weight:800">${esc(m.n)}</div><div class="sm mu">${esc(m.sub)}</div></div></div>
<div style="padding:28px 24px 0;text-align:center"><div style="font-size:56px;font-weight:800;letter-spacing:-2px;color:${bad?'var(--er)':'var(--tx)'}"><span id="ppa">${v?fmt(v):'0'}</span> <span style="font-size:20px;letter-spacing:0">RWF</span></div><div id="ppm" class="${bad?'':'mu'}" style="margin-top:10px;font-size:14px;color:${bad?'var(--er)':''}">${amtMsg()}</div><div class="req" style="justify-content:center;margin-top:12px">${[['pay','Pay'],['bank','Bank']].map(([k,n])=>`<button class="${S.psrc===k?'on':''}" onclick="ppSrc2('${k}')">itunda ${n}</button>`).join('')}</div></div>
<div class="keys" style="position:absolute;left:0;right:0;bottom:104px">${['1','2','3','4','5','6','7','8','9','00','0','del'].map(k=>`<button onclick="ppKey('${k}')" aria-label="${k==='del'?'Delete':k}">${k==='del'?'⌫':k}</button>`).join('')}</div><div class="cta"><button id="ppb" class="btn" ${v&&!bad?'':'disabled'} onclick="ppConfirm()">${L('Pay','Ishyura','Payer')}</button></div>`};
function ppUpd(){const v=Number(S.pm.amt||0),bad=v>bal(),a=document.getElementById('ppa'),m=document.getElementById('ppm'),b=document.getElementById('ppb');if(a){a.textContent=v?fmt(v):'0';a.parentElement.style.color=bad?'var(--er)':'var(--tx)'}if(m){m.textContent=amtMsg();m.style.color=bad?'var(--er)':'';m.className=bad?'':'mu'}if(b)b.disabled=!(v&&!bad)}
window.ppKey=k=>{let a=S.pm.amt||'';a=k==='del'?a.slice(0,-1):(a+k).replace(/^0+/,'');if(a.length>8)return;S.pm.amt=a;ppUpd()};
window.ppSrc2=k=>{S.psrc=k;render('fade-none')};

/* ---- pay code ---- */
const codeNow=()=>{const n=Math.floor(Date.now()/60000),c=String((n*7919+104729)%100000000).padStart(8,'0');return c.slice(0,4)+' '+c.slice(4)};
window.ppCode=()=>{const draw=()=>{const left=60-new Date().getSeconds();$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" id="pcode" style="text-align:center"><div class="h1" style="font-size:22px;line-height:30px">${L('My payment code','Kode yanjye yo kwishyura','Mon code de paiement')}</div><div style="margin:18px auto 14px;width:220px;height:220px;border-radius:24px;background:#fff;display:flex;align-items:center;justify-content:center">${gl('qr3d',190)}</div><div style="font-size:28px;font-weight:800;letter-spacing:3px">${codeNow()}</div><div style="height:6px;border-radius:3px;background:var(--chip);margin:16px 24px 0"><div style="height:6px;border-radius:3px;background:var(--br);width:${left/60*100}%"></div></div><div class="sm mu" style="margin-top:8px">${L('Refreshes in','Ihinduka mu','Se renouvelle dans')} ${left} s · ${L('Pays from','Yishyura kuri','Débite')} ${srcN()}</div><div class="fine" style="margin-top:10px">${L('Sample code for this prototype, not a real payment code.','Kode y’icyitegererezo, si kode nyayo.','Code d’exemple pour ce prototype.')}</div><button class="btn sec2" style="margin-top:16px" onclick="closeSheet()">${L('Close','Funga','Fermer')}</button></div>`};draw();clearInterval(window.__pcT);window.__pcT=setInterval(()=>{if(!document.getElementById('pcode')){clearInterval(window.__pcT);return}draw()},1000)};

/* ---- airtime ---- */
window.ppAir=()=>{const A=S.atm;$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div style="margin-bottom:10px">${gl('airtime',60)}</div><div class="h1" style="font-size:22px;line-height:30px">${L('Buy airtime','Gura airtime','Acheter du crédit')}</div><div class="mu" style="font-size:14px;margin:6px 0 14px">0788 000 214</div><div class="req">${['MTN','Airtel'].map(o=>`<button class="${A.op===o?'on':''}" onclick="S.atm.op='${o}';ppAir()">${o}</button>`).join('')}</div><div class="req" style="margin:12px 0 4px">${[500,1000,2000,5000].map(a=>`<button class="${A.amt===a?'on':''}" onclick="S.atm.amt=${a};ppAir()">${fmt(a)} RWF</button>`).join('')}</div>${srcChips().replace(/ppSrc\(/g,'ppSrcA(')}<button class="btn" style="margin-top:20px" onclick="ppAirGo()">${L('Buy','Gura','Acheter')} ${fmt(A.amt)} RWF</button></div>`};
window.ppSrcA=k=>{S.psrc=k;ppAir()};
window.ppAirGo=()=>{S.pm={n:S.atm.op+' airtime',sub:'0788 000 214',amt:String(S.atm.amt),g:'bag',fixed:1};ppConfirm()};

/* ---- confirm + pay ---- */
window.ppConfirm=()=>{const m=S.pm,v=Number(m.amt||0);if(!v)return;const bad=v>bal();$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" role="dialog" aria-modal="true" aria-label="Confirm"><div style="margin-bottom:12px">${gl('verified3d',60)}</div><div class="h1" style="font-size:22px;line-height:30px">Confirm it's you</div><div class="big" style="font-size:34px;letter-spacing:-1px;margin-top:12px">${fmt(v)} RWF</div><div style="margin:16px 0 18px">${[[L('To','Kuri','À'),esc(m.n)],[L('From','Kuva kuri','De'),srcN()],[L('Fee','Amafaranga y’inyongera','Frais'),'0 RWF']].map(([a,b],i)=>`<div style="display:flex;justify-content:space-between;height:48px;align-items:center;font-size:15px;border-top:0"><span class="mu">${a}</span><b>${b}</b></div>`).join('')}</div>${bad?`<div style="color:var(--er);font-size:14px;margin-bottom:10px">${t('insuff').replace('%s',fmt(bal()))}</div>`:''}<button class="btn" ${bad?'disabled':''} onclick="ppDo()">${L('Confirm','Emeza','Confirmer')}</button><button class="btn sec2" style="margin-top:8px;background:none;height:48px;font-size:16px" onclick="closeSheet()">${L('Cancel','Hagarika','Annuler')}</button></div>`};
window.ppDo=()=>{const m=S.pm,v=Number(m.amt||0);if(!v||v>bal())return;if(S.psrc==='bank')S.bank-=v;else S.pay-=v;addAct('bag',m.n,'Paid',-v,'Paid');S.ppd={n:m.n,sub:m.sub,v,src:srcN(),ref:'TX'+String(Math.floor(Math.random()*1e8)).padStart(8,'0'),tm:new Date().toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'})};S.pm={n:'',sub:'',amt:'',g:'bag'};S.tl='';closeSheet();S.stack=['paydone'];render('push')};
screens.paydone=()=>{const D=S.ppd;if(!D)return `${bar('')}`;return `<div style="display:flex;flex-direction:column;align-items:center;padding-top:clamp(28px,12vh,190px)"><div class="g3">${gl('success3d',132)}</div><div class="h1" style="margin-top:28px;font-size:34px;line-height:42px">${fmt(D.v)} RWF</div><div class="mu" style="font-size:16px;margin-top:8px">${L('Paid to','Yishyuwe kuri','Payé à')} ${esc(D.n)}</div></div><div style="margin:44px 24px 0;padding:4px 20px;border-radius:20px;background:var(--chip)">${[[L('From','Kuva kuri','De'),D.src],[L('Time','Isaha','Heure'),D.tm],[L('Reference','Nimero ya transaction','Référence'),D.ref]].map(([a,b],i)=>`<div style="display:flex;justify-content:space-between;height:52px;align-items:center;font-size:15px;${i?'border-top:0':''}"><span class="mu">${a}</span><b>${b}</b></div>`).join('')}</div><div class="pad fine" style="padding-top:16px">${L('Sample payment. No real money moved.','Icyitegererezo. Nta mafaranga yimuwe.','Paiement d’exemple. Aucun argent réel.')}</div><div class="cta"><div class="row2"><button class="btn sec2" onclick="toast('${L('Receipt shared','Fagitire yasangijwe','Reçu partagé')}')">${L('Share receipt','Sangiza fagitire','Partager le reçu')}</button><button class="btn" onclick="S.stack=[];render('pop')">${L('Done','Byarangiye','Terminé')}</button></div></div>`};
})();
</script>
<script>
/* v77: Bank — full bank overview: accounts, net-worth bar, move money Bank<->Pay, deposit, statements (CSV), limits, upcoming payments */
(function(){
const L=(e,r,f)=>({en:e,rw:r||e,fr:f||e}[S.lang]||e);
const esc=s=>String(s).replace(/</g,'&lt;');
S.bm=S.bm||{dir:'out',amt:5000};S.bd=S.bd||{src:'MTN MoMo',amt:20000};S.bs=S.bs||{per:'This month',fm:'CSV'};S.lim=S.lim||{day:1000000,al:true};
const pk=()=>typeof pkTotal==='function'?pkTotal():0;
const owed=()=>S.loan?(S.loan.m-S.loan.paid)*S.loan.mo:0;
const st=document.createElement('style');
st.textContent='.bka{display:flex;gap:6px;padding:0 12px}.bka button{flex:1;border:0;background:none;color:var(--tx);font:inherit;font-size:12px;font-weight:700;display:flex;flex-direction:column;align-items:center;gap:8px}.bka i{width:52px;height:52px;border-radius:26px;background:var(--chip);display:flex;align-items:center;justify-content:center}.nwb{display:flex;height:12px;border-radius:6px;overflow:hidden;gap:2px;margin-top:14px}.nwb span{display:block;height:12px}.nwl{display:flex;justify-content:space-between;align-items:center;height:36px;font-size:14px}.nwl i{display:inline-block;width:10px;height:10px;border-radius:5px;margin-right:10px}';
document.head.appendChild(st);

function block(){
const items=[['itunda Bank',S.bank,'var(--br)'],['itunda Pay',S.pay,'var(--lk)'],[L('Pockets','Pockets','Pockets'),pk(),'#2E6BF0'],[L('Locked deposit','Amafaranga afunze','Dépôt bloqué'),S.dep?S.dep.a:0,'#9B59B6'],[L('Savings goal','Intego yo kuzigama','Objectif d’épargne'),S.goal?S.goal.s:0,'#F5B301']].filter(x=>x[1]>0);
const tot=items.reduce((a,x)=>a+x[1],0),o=owed();
const acts=[['send',t('send'),'flow()'],['cyc',L('Move','Imura','Transférer'),'bkMove()'],['plus',L('Deposit','Ubika','Déposer'),'bkDep()'],['receipt',L('Statement','Raporo','Relevé'),'bkStmt()']];
const up=[];
if(S.loan)up.push(['wallet',L('Loan instalment','Ukwezi k’inguzanyo','Mensualité du prêt'),L('15th of each month','Ku itariki 15','Le 15 du mois'),fmt(S.loan.mo)+' RWF','openBankDetail()']);
if(!S.ik)up.push(['users','Umurenge Savers',L('Due Friday','Kuwa Gatanu','Dû vendredi'),'10,000 RWF',"openChat('ikimina')"]);
up.push(['cyc','Auto-transfer',L('Next run this month','Igikurikira muri uku kwezi','Prochain ce mois-ci'),'']);
return `<div class="pad tap" role="button" tabindex="0" onclick="openBankDetail()" style="padding-top:20px;cursor:pointer"><div class="sm mu">itunda Bank · ••1980</div><div style="display:flex;justify-content:space-between;align-items:center;margin-top:4px"><span style="font-size:32px;font-weight:800;letter-spacing:-.6px">${fmt(S.bank)} RWF</span>${ic('chev',18,'var(--tt)')}</div><div style="display:flex;justify-content:space-between;margin-top:10px;font-size:14px"><span class="mu">itunda Pay</span><b>${fmt(S.pay)} RWF</b></div></div>
<div class="bka" style="padding-top:20px">${acts.map(([i,l,o])=>`<button class="tap" onclick="${o}"><i>${gx(i,26)}</i>${l}</button>`).join('')}</div>
<div class="sec" style="padding-bottom:0"><div class="sech">${L('Coming up','Biri imbere','À venir')}</div>${up.map(([i,t1,s,r,on])=>row(i,t1,s,r,on)).join('')}</div>
<div class="sec" style="padding-bottom:0"><div class="sech">${L('Control','Igenzura','Contrôle')}</div>${row('card',L('Card','Ikarita','Carte'),S.card?L('Active','Irakora','Active'):L('Get a debit card','Gufata ikarita','Obtenir une carte'),'','openCard()')}${row('shield',L('Limits & alerts','Imbibi n’imenyesha','Plafonds et alertes'),L('Daily transfer limit','Imbibi bya buri munsi','Plafond quotidien')+' '+fmt(S.lim.day)+' RWF','','bkLim()')}${row('receipt',L('Statements','Raporo','Relevés'),L('Download as CSV','Manura nka CSV','Télécharger en CSV'),'','bkStmt()')}</div>
`}
const _b=screens.bank;
screens.bank=()=>{const h=_b(),a=h.indexOf('itunda Bank account</div>');if(a<0)return h;const s=h.lastIndexOf('<div class="pad',a),e=h.indexOf('<div class="pad" style="padding-top:12px">',a);if(s<0||e<0)return h;return h.slice(0,s)+block()+h.slice(e)};

/* move between own accounts */
const sheet=(g,title,body)=>{$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" role="dialog" aria-modal="true" aria-label="${title}"><div style="margin-bottom:10px">${gl(g,60)}</div><div class="h1" style="font-size:22px;line-height:30px">${title}</div>${body}</div>`};
const chips=(a,cur,fn,f)=>`<div class="req" style="margin-top:12px">${a.map(x=>`<button class="${cur===x?'on':''}" onclick="${fn}(${typeof x==='number'?x:`'${x}'`})">${f?f(x):x}</button>`).join('')}</div>`;
window.bkMove=()=>{const M=S.bm,from=M.dir==='out'?S.bank:S.pay,bad=M.amt>from;sheet('settle',L('Move money','Imura amafaranga','Transférer'),`<div class="mu" style="font-size:14px;margin:6px 0 4px">${M.dir==='out'?'itunda Bank → itunda Pay':'itunda Pay → itunda Bank'}</div><div class="req"><button class="${M.dir==='out'?'on':''}" onclick="S.bm.dir='out';bkMove()">Bank → Pay</button><button class="${M.dir==='in'?'on':''}" onclick="S.bm.dir='in';bkMove()">Pay → Bank</button></div>${chips([1000,5000,20000,50000],M.amt,'bkMA',x=>fmt(x)+' RWF')}<div class="sm ${bad?'':'mu'}" style="margin-top:12px;${bad?'color:var(--er)':''}">${bad?t('insuff').replace('%s',fmt(from)):L('Available','Bihari','Disponible')+' · '+fmt(from)+' RWF'}</div><button class="btn" style="margin-top:18px" ${bad?'disabled':''} onclick="bkMoveGo()">${L('Move','Imura','Transférer')} ${fmt(M.amt)} RWF</button>`)};
window.bkMA=n=>{S.bm.amt=n;bkMove()};
window.bkMoveGo=()=>{const M=S.bm,v=M.amt;if(M.dir==='out'){if(v>S.bank)return;S.bank-=v;S.pay+=v;addAct('cyc','Moved to itunda Pay','Transfer',-v,'Paid')}else{if(v>S.pay)return;S.pay-=v;S.bank+=v;addAct('up','Moved to itunda Bank','Transfer',v,'Received')}closeSheet();render('fade-none');toast(fmt(v)+' RWF '+L('moved','yimuwe','transférés'))};

/* deposit from mobile money into Bank */
window.bkDep=()=>{const D=S.bd;sheet('cashin3d',L('Deposit to itunda Bank','Bika kuri itunda Bank','Déposer sur itunda Bank'),`<div class="mu" style="font-size:14px;margin:6px 0 4px">${L('From mobile money','Uvuye kuri mobile money','Depuis le mobile money')}</div>${chips(['MTN MoMo','Airtel Money'],D.src,'bkDS')}${chips([10000,20000,50000,100000],D.amt,'bkDA',x=>fmt(x)+' RWF')}<button class="btn" style="margin-top:22px" onclick="bkDepGo()">${L('Deposit','Bika','Déposer')} ${fmt(D.amt)} RWF</button><div class="fine" style="margin-top:10px">${L('Sample deposit. No real money moves.','Icyitegererezo. Nta mafaranga yimuwe.','Dépôt d’exemple. Aucun argent réel.')}</div>`)};
window.bkDS=s=>{S.bd.src=s;bkDep()};window.bkDA=n=>{S.bd.amt=n;bkDep()};
window.bkDepGo=()=>{const D=S.bd;S.bank+=D.amt;addAct('up','Deposit · '+D.src,'Received',D.amt,'Received');closeSheet();render('fade-none');toast(L('Deposited ','Byabikijwe ','Déposé ')+fmt(D.amt)+' RWF')};

/* statements: real CSV of activity */
window.bkStmt=()=>{const B=S.bs;sheet('receipt',L('Statement','Raporo','Relevé'),`<div class="mu" style="font-size:14px;margin:6px 0 2px">${L('Choose a period and format.','Hitamo igihe n’ubwoko.','Choisissez la période et le format.')}</div>${chips(['This month','Last 3 months','This year'],B.per,'bkSP')}${chips(['CSV','PDF'],B.fm,'bkSF')}<button class="btn" style="margin-top:22px" onclick="bkStmtGo()">${L('Download','Manura','Télécharger')}</button><div class="fine" style="margin-top:10px">${L('Sample data for this prototype.','Amakuru y’icyitegererezo.','Données d’exemple pour ce prototype.')}</div>`)};
window.bkSP=p=>{S.bs.per=p;bkStmt()};window.bkSF=f=>{S.bs.fm=f;bkStmt()};
window.bkStmtGo=()=>{if(S.bs.fm==='PDF'){closeSheet();toast(L('PDF export is not in this prototype. Try CSV.','PDF ntiri muri prototype. Gerageza CSV.','Export PDF indisponible. Essayez CSV.'));return}
const q=v=>'"'+String(v).replace(/"/g,'""')+'"',rows=[['Description','Detail','Amount (RWF)','Type'],...S.act.map(x=>[x[1],x[2],x[3],x[4]||''])];
const csv=rows.map(r=>r.map(q).join(',')).join('\n');
try{const b=new Blob(['\ufeff'+csv],{type:'text/csv'}),a=document.createElement('a');a.href=URL.createObjectURL(b);a.download='itunda-statement.csv';document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(a.href),2000);toast(L('Statement downloaded','Raporo yamanuwe','Relevé téléchargé'))}catch(e){toast(L('Download is blocked here','Gukuramo bibujijwe hano','Téléchargement bloqué'))}
closeSheet()};

/* limits & alerts */
window.bkLim=()=>{const X=S.lim;sheet('lock',L('Limits & alerts','Imbibi n’imenyesha','Plafonds et alertes'),`<div class="mu" style="font-size:14px;margin:6px 0 2px">${L('Daily transfer limit','Imbibi bya buri munsi','Plafond quotidien')}</div>${chips([200000,500000,1000000,2000000],X.day,'bkLD',x=>fmt(x)+' RWF')}<div class="row tap" style="margin-top:14px" onclick="S.lim.al=!S.lim.al;bkLim()"><div style="flex:1"><div class="t" style="font-size:16px">${L('Alerts for large transfers','Imenyesha ry’ihererekanya rinini','Alertes gros virements')}</div><div class="s">${L('Notify me above 100,000 RWF','Menyesha hejuru ya 100,000 RWF','Prévenir au-dessus de 100 000 RWF')}</div></div><div class="ck ${X.al?'on':''}">${ic('check',18,X.al?'#17171C':'var(--tt)')}</div></div><button class="btn" style="margin-top:18px" onclick="closeSheet();render('fade-none')">${L('Save','Bika','Enregistrer')}</button>`)};
window.bkLD=n=>{S.lim.day=n;bkLim()};
})();
</script>
<script>
/* v78: Bank — send to other banks, account details, My assets, statement on account detail, daily-limit tracking */
(function(){
const L=(e,r,f)=>({en:e,rw:r||e,fr:f||e}[S.lang]||e);
const esc=s=>String(s).replace(/</g,'&lt;');
const ACC='0214-3058-1980',BANKS=['Bank of Kigali','I&M Bank','Equity Bank','Access Bank'];
S.lim=S.lim||{day:1000000,al:true};S.lim.used=S.lim.used||0;
S.bx=S.bx||{bank:'Bank of Kigali',acc:'',amt:0};
const owed=()=>S.loan?(S.loan.m-S.loan.paid)*S.loan.mo:0;
const feeOf=a=>a>100000?500:100;
const holder=a=>a.length===10?'J. MUKAMANA':null;

/* hub: extra rows in Control */
const _b=screens.bank;
screens.bank=()=>{const h=_b();return h.replace(/(class="sech">(?:Control|Igenzura|Contrôle)<\/div>)/,'$1'+row('send',L('Send to a bank account','Ohereza kuri konti ya banki','Envoyer vers un compte bancaire'),'Bank of Kigali · I&amp;M · Equity · Access','','bkx()')+row('bank',L('Account details','Amakuru ya konti','Détails du compte'),'••1980','','bkAcct()')+row('trend',L('My assets','Umutungo wanjye','Mes actifs'),L('Accounts, loans, cards','Konti, inguzanyo, amakarita','Comptes, prêts, cartes'),'','bkAssets()'))};
/* account detail: statement button */
const _d=screens.bankd;
screens.bankd=()=>{const h=_d();return h.replace('<button class="bb" onclick="bkManage()">','<button class="bb" onclick="bkStmt()">'+ic('bill',20)+L('Statement','Raporo','Relevé')+'</button><button class="bb" onclick="bkManage()">')};
/* paydone: allow returning to the bank screen */
const _pd=screens.paydone;
screens.paydone=()=>_pd().replace("S.stack=[];render('pop')","S.stack=S.ppd&&S.ppd.ret?[S.ppd.ret]:[];render('pop')");
/* explore: My assets row */
try{ASEC.forEach(([t,r])=>r.forEach(x=>{if(x[1]==='My assets')x[3]='bkAssets()'}))}catch(e){}

/* ---- account details ---- */
window.bkAcct=()=>{$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" role="dialog" aria-modal="true" aria-label="Account details"><div style="margin-bottom:10px">${gl('wallet',60)}</div><div class="h1" style="font-size:22px;line-height:30px">${L('Account details','Amakuru ya konti','Détails du compte')}</div><div style="margin:16px 0 14px;padding:2px 18px;border-radius:20px;background:var(--chip)">${[[L('Account holder','Nyir’konti','Titulaire'),esc(S.name||'Amina Uwase')],[L('Account number','Nimero ya konti','N° de compte'),ACC],[L('Bank','Banki','Banque'),'itunda Bank'],[L('Branch','Ishami','Agence'),'Kigali (sample)'],[L('Currency','Ifaranga','Devise'),'RWF']].map(([a,b],i)=>`<div style="display:flex;justify-content:space-between;gap:16px;min-height:48px;align-items:center;font-size:15px;${i?'border-top:0':''}"><span class="mu">${a}</span><b style="text-align:right">${b}</b></div>`).join('')}</div><div class="row2"><button class="btn sec2" onclick="bkAcctCopy()">${L('Copy number','Koporora nimero','Copier le numéro')}</button><button class="btn" onclick="closeSheet();toast('${L('Details shared (sample)','Amakuru yasangijwe (icyitegererezo)','Détails partagés (exemple)')}')">${L('Share','Sangiza','Partager')}</button></div><div class="fine" style="margin-top:10px">${L('Sample details for this prototype.','Amakuru y’icyitegererezo.','Détails d’exemple pour ce prototype.')}</div></div>`};
window.bkAcctCopy=()=>{try{navigator.clipboard.writeText(ACC)}catch(e){}toast(L('Account number copied','Nimero yakoporowe','Numéro copié'))};

/* ---- send to another bank ---- */
window.bkx=()=>{S.bx={bank:S.bx.bank,acc:'',amt:0};S.stack.push('bktx');render('push')};
const bxErr=()=>{const X=S.bx,tot=X.amt+feeOf(X.amt);if(!X.amt)return '';if(tot>S.bank)return t('insuff').replace('%s',fmt(S.bank));if(X.amt+S.lim.used>S.lim.day)return L('Above your daily limit of ','Hejuru y’imbibi bya buri munsi ','Au-dessus de votre plafond de ')+fmt(S.lim.day)+' RWF';return ''};
const bxOk=()=>{const X=S.bx;return !!holder(X.acc)&&X.amt>0&&!bxErr()};
screens.bktx=()=>{const X=S.bx,h=holder(X.acc),err=bxErr(),fee=X.amt?feeOf(X.amt):0;return `${bar(L('Send to a bank account','Ohereza kuri konti ya banki','Envoyer vers un compte bancaire'))}<div class="pad" style="padding-top:12px"><div class="lab">${L('Bank','Banki','Banque')}</div><div class="req" style="margin-top:10px">${BANKS.map(b=>`<button class="${X.bank===b?'on':''}" onclick="S.bx.bank='${b}';render('fade-none')">${b.replace('&','&amp;')}</button>`).join('')}</div><div class="lab">${L('Account number','Nimero ya konti','N° de compte')}</div><input class="in" id="bxa" inputmode="numeric" maxlength="10" value="${X.acc}" oninput="bxAcc(this.value)" placeholder="0000000000" aria-label="Account number"><div id="bxn" class="sm ${h?'':'mu'}" style="margin-top:6px;${h?'color:var(--ok);font-weight:700':''}">${h?'✓ '+h+' (sample)':X.acc.length+'/10'}</div><div class="lab">${L('Amount','Amafaranga','Montant')}</div><div class="req" style="margin-top:10px">${[10000,50000,100000,500000].map(a=>`<button class="${X.amt===a?'on':''}" onclick="S.bx.amt=${a};render('fade-none')">${fmt(a)} RWF</button>`).join('')}</div><div id="bxe" class="sm" style="margin-top:12px;color:var(--er)">${err}</div><div style="margin-top:8px;padding:2px 18px;border-radius:20px;background:var(--chip)">${[[L('Fee','Amafaranga y’inyongera','Frais'),X.amt?fmt(fee)+' RWF':'—'],[L('Arrives','Igera','Arrivée'),L('Within minutes','Muminota mike','En quelques minutes')],[L('Daily limit left','Asigaye uyu munsi','Plafond restant'),fmt(Math.max(0,S.lim.day-S.lim.used))+' RWF']].map(([a,b],i)=>`<div style="display:flex;justify-content:space-between;height:48px;align-items:center;font-size:15px;${i?'border-top:0':''}"><span class="mu">${a}</span><b>${b}</b></div>`).join('')}</div>${S.lim.al&&X.amt>=100000?`<div class="sm mu" style="margin-top:10px">${L('You will get a large-transfer alert.','Uzahabwa imenyesha ry’ihererekanya rinini.','Vous recevrez une alerte de gros virement.')}</div>`:''}<div class="fine" style="margin-top:14px">${L('Sample banks and names. No real money moves.','Amabanki n’amazina by’icyitegererezo.','Banques et noms d’exemple.')}</div></div><div class="cta"><button id="bxb" class="btn" ${bxOk()?'':'disabled'} onclick="bkxAsk()">${L('Send','Ohereza','Envoyer')}${X.amt?' '+fmt(X.amt)+' RWF':''}</button></div>`};
window.bxAcc=v=>{S.bx.acc=String(v).replace(/\D/g,'').slice(0,10);const h=holder(S.bx.acc),n=document.getElementById('bxn'),b=document.getElementById('bxb');if(n){n.className='sm '+(h?'':'mu');n.style.cssText=h?'margin-top:6px;color:var(--ok);font-weight:700':'margin-top:6px';n.textContent=h?'✓ '+h+' (sample)':S.bx.acc.length+'/10'}if(b)b.disabled=!bxOk()};
window.bkxAsk=()=>{const X=S.bx,fee=feeOf(X.amt);if(!bxOk())return;$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" role="dialog" aria-modal="true" aria-label="Confirm"><div style="margin-bottom:12px">${gl('verified3d',60)}</div><div class="h1" style="font-size:22px;line-height:30px">Confirm it's you</div><div class="big" style="font-size:34px;letter-spacing:-1px;margin-top:12px">${fmt(X.amt)} RWF</div><div style="margin:16px 0 18px">${[[L('To','Kuri','À'),holder(X.acc)],[L('Bank','Banki','Banque'),esc(X.bank)+' ••'+X.acc.slice(-4)],[L('Fee','Amafaranga y’inyongera','Frais'),fmt(fee)+' RWF'],[L('Total','Yose hamwe','Total'),fmt(X.amt+fee)+' RWF']].map(([a,b])=>`<div style="display:flex;justify-content:space-between;height:48px;align-items:center;font-size:15px;border-top:0"><span class="mu">${a}</span><b>${b}</b></div>`).join('')}</div><button class="btn" onclick="bkxDo()">${L('Confirm','Emeza','Confirmer')}</button><button class="btn sec2" style="margin-top:8px;background:none;height:48px;font-size:16px" onclick="closeSheet()">${L('Cancel','Hagarika','Annuler')}</button></div>`};
window.bkxDo=()=>{const X=S.bx,fee=feeOf(X.amt),tot=X.amt+fee;if(!bxOk())return;S.bank-=tot;S.lim.used+=X.amt;const who=holder(X.acc);addAct('send','To '+who+' · '+X.bank,'Sent',-X.amt,'Sent');addAct('send','Transfer fee','Paid',-fee,'Paid');S.ppd={n:who+' · '+X.bank,sub:'••'+X.acc.slice(-4),v:X.amt,src:'itunda Bank',ref:'TX'+String(Math.floor(Math.random()*1e8)).padStart(8,'0'),tm:new Date().toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'}),ret:'bank'};closeSheet();S.stack=['paydone'];render('push');if(S.lim.al&&X.amt>=100000)setTimeout(()=>toast(L('Large transfer alert sent','Imenyesha ryoherejwe','Alerte envoyée')),600)};

/* ---- my assets ---- */
const go=n=>`S.stack.push('${n}');render('push')`;
window.bkAssets=()=>{S.stack.push('assets');render('push')};
screens.assets=()=>{const pk=typeof pkTotal==='function'?pkTotal():0,stk=typeof stkVal==='function'?stkVal():0,dep=S.dep?S.dep.a:0,goal=S.goal?S.goal.s:0,jar=S.jar||0,o=owed();
const A=S.bank+S.pay+pk+dep+goal+jar+stk;
const R=(i,n,s,v,on)=>row(i,n,s,v==null?'':fmt(v)+' RWF',on);
return `${bar(L('My assets','Umutungo wanjye','Mes actifs'))}<div class="pad" style="padding-top:12px"><div class="sm mu">${L('Net worth in itunda','Umutungo muri itunda','Patrimoine dans itunda')}</div><div class="big" style="margin-top:4px">${fmt(A-o)} RWF</div><div class="sm mu" style="margin-top:6px">${L('Assets','Umutungo','Actifs')} ${fmt(A)} RWF${o?' · '+L('Loans','Inguzanyo','Prêts')+' −'+fmt(o)+' RWF':''}</div></div>
<div class="sec"><div class="sech">${L('Accounts','Konti','Comptes')}</div>${R('bank','itunda Bank','••1980',S.bank,'openBankDetail()')}${R('wallet','itunda Pay',L('Everyday payments','Kwishyura bya buri munsi','Paiements du quotidien'),S.pay,"tab('pay')")}${R('wallet','Pockets',(S.pk?S.pk.length:0)+' pockets',pk,'openPockets()')}${jar?R('coin',L('Interest jar','Interest jar','Tirelire à intérêts'),'4.0% '+L('annual','ku mwaka','par an'),jar,go('jar')):''}${goal?R('coin',S.goal.n,L('Savings goal','Intego yo kuzigama','Objectif d’épargne'),goal,'openGoal()'):''}${dep?R('lock',L('12-month deposit','Ubwizigame bw’amezi 12','Dépôt 12 mois'),L('Locked','Bufunze','Bloqué'),dep,go('dep')):''}</div>
${stk?`<div class="sec"><div class="sech">${L('Investments','Imari yashowe','Investissements')}</div>${R('trend','Rwanda Stock Exchange',L('Sample portfolio','Portfolio y’icyitegererezo','Portefeuille d’exemple'),stk,'openInvest()')}</div>`:''}
<div class="sec"><div class="sech">${L('Cards','Amakarita','Cartes')}</div>${row('card','itunda card',S.card?L('Active','Irakora','Active'):L('Not issued yet','Ntiratangwa','Pas encore émise'),'','openCard()')}</div>
<div class="sec"><div class="sech">${L('Loans','Inguzanyo','Prêts')}</div>${S.loan?R('wallet',L('Your loan','Inguzanyo yawe','Votre prêt'),(S.loan.m-S.loan.paid)+' '+L('instalments left','ibyiciro bisigaye','mensualités restantes'),o,go('loan')):row('wallet',L('No active loans','Nta nguzanyo ufite','Aucun prêt actif'),L('See what you can borrow','Reba ibyo wakwemererwa','Voir ce que vous pouvez emprunter'),'','openScore()')}</div>
<div class="pad fine" style="padding-top:18px">${L('Sample data for this prototype.','Amakuru y’icyitegererezo.','Données d’exemple pour ce prototype.')}</div>`};
})();
</script>
<script>
/* v79: Pay — receive money QR, split a bill with tracked requests, pay-again merchants */
(function(){
const L=(e,r,f)=>({en:e,rw:r||e,fr:f||e}[S.lang]||e);
const esc=s=>String(s).replace(/</g,'&lt;');
const TILLS={'123456':'Kigali Bakery','204518':'Nyamirambo Coffee House','731902':'Simba Supermarket'};
const TILL_OF=Object.fromEntries(Object.entries(TILLS).map(([k,n])=>[n,k]));
const PEOPLE=['Amina K.','Eric M.','Grace U.','Jean Paul','Divine N.'];
S.rqs=S.rqs||[];S.rc=S.rc||{amt:0};S.spl=S.spl||{total:30000,n:3};
const sheet=(g,title,body)=>{$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" role="dialog" aria-modal="true" aria-label="${title}"><div style="margin-bottom:10px">${gl(g,60)}</div><div class="h1" style="font-size:22px;line-height:30px">${title}</div>${body}</div>`};
const chips=(a,cur,fn,f)=>`<div class="req" style="margin-top:12px">${a.map(x=>`<button class="${cur===x?'on':''}" onclick="${fn}(${x})">${f?f(x):x}</button>`).join('')}</div>`;

/* hub additions */
const _p=screens.pay;
screens.pay=()=>{let h=_p();
h=h.replace(/(<div class="ppg">(?:(?!<\/div>)[\s\S])*<\/button>)<\/div>/,'$1'+[['users',L('Split a bill','Gabana fagitire','Partager'),'ppSplit()'],['up',L('Receive','Akira','Recevoir'),'ppRecv()']].map(([i,l,o])=>`<button class="tap" onclick="${o}">${gx(i,34)}${l}</button>`).join('')+'</div>');
const open=S.rqs.filter(r=>!r.paid),done=S.rqs.filter(r=>r.paid).length;
const req=S.rqs.length?`<div class="sec" style="padding-bottom:0"><div class="sech">${L('Requests you sent','Ibyo wasabye','Demandes envoyées')}${open.length?` · ${open.length}`:''}</div>${S.rqs.slice().reverse().slice(0,4).map(r=>row('users',esc(r.n)+(r.paid?'':' '+L('owes you','agufitiye','vous doit')),r.paid?L('Paid · received','Yishyuwe · wabonye','Payé · reçu'):esc(r.l)+' · '+L('tap to mark paid (demo)','kanda ushyireho ko yishyuye (demo)','touchez pour marquer payé (démo)'),fmt(r.amt)+' RWF',r.paid?'':`rqPaid(${r.id})`)).join('')}</div>`:'';
const seen=[];S.act.forEach(x=>{if(x[0]==='bag'&&/^Paid/.test(x[2])&&TILL_OF[x[1]]&&!seen.includes(x[1]))seen.push(x[1])});
Object.values(TILLS).slice(0,2).forEach(n=>{if(!seen.includes(n)&&seen.length<4)seen.push(n)});
const mer=`<div class="sec" style="padding-bottom:12px"><div class="sech" style="margin:0">${L('Pay again','Ishyura ukundi','Payer à nouveau')}</div></div><div class="chips" style="gap:14px">${seen.map(n=>`<button class="tap" onclick="ppMerch('${TILL_OF[n]}')" aria-label="Pay ${n}" style="flex:0 0 72px;border:0;background:none;display:flex;flex-direction:column;align-items:center;gap:8px;font-size:12px;font-weight:700;color:var(--tx)"><span style="width:56px;height:56px;border-radius:18px;background:var(--chip);display:flex;align-items:center;justify-content:center">${gx('bag',30)}</span><span style="text-align:center;line-height:15px">${n}</span></button>`).join('')}</div>`;
const mk='<div class="sec" style="padding-top:26px;padding-bottom:12px"><div class="sech" style="margin:0">';
const i=h.indexOf(mk);
return i<0?h:h.slice(0,i)+req+'<div style="height:6px"></div>'+mer+h.slice(i)};

/* receive */
window.ppRecv=()=>{const a=S.rc.amt,nm=esc(S.name||'Amina Uwase');sheet('qr3d',L('Receive money','Akira amafaranga','Recevoir de l’argent'),`<div class="mu" style="font-size:14px;margin:6px 0 2px">${L('Anyone can scan this to pay you.','Umuntu wese ayisikana arakwishyura.','Tout le monde peut scanner pour vous payer.')}</div>${chips([0,1000,5000,10000],a,'ppRA',x=>x?fmt(x)+' RWF':L('Any amount','Umubare wose','Montant libre'))}<div style="margin:16px auto 10px;width:200px;height:200px;border-radius:24px;background:#fff;display:flex;align-items:center;justify-content:center">${gl('qr3d',172)}</div><div style="text-align:center"><b style="font-size:17px">${nm}</b><div class="sm mu" style="margin-top:2px">itunda.rw/pay/amina${a?'?amt='+a:''}</div></div><div class="row2" style="margin-top:18px"><button class="btn sec2" onclick="ppRCopy()">${L('Copy link','Koporora link','Copier le lien')}</button><button class="btn" onclick="closeSheet();toast('${L('Shared (sample)','Byasangijwe (icyitegererezo)','Partagé (exemple)')}')">${L('Share','Sangiza','Partager')}</button></div><div class="fine" style="margin-top:10px">${L('Sample QR for this prototype.','QR y’icyitegererezo.','QR d’exemple pour ce prototype.')}</div>`)};
window.ppRA=n=>{S.rc.amt=n;ppRecv()};
window.ppRCopy=()=>{try{navigator.clipboard.writeText('itunda.rw/pay/amina')}catch(e){}toast(L('Link copied','Link yakoporowe','Lien copié'))};

/* split */
const share=()=>Math.ceil(S.spl.total/S.spl.n);
window.ppSplit=()=>{const P=S.spl,who=PEOPLE.slice(0,P.n-1);sheet('settle',L('Split a bill','Gabana fagitire','Partager une addition'),`<div class="mu" style="font-size:14px;margin:6px 0 2px">${L('Total bill','Fagitire yose','Total de l’addition')}</div>${chips([10000,30000,60000,100000],P.total,'ppSA',x=>fmt(x)+' RWF')}<div class="mu" style="font-size:14px;margin:16px 0 0">${L('People, including you','Abantu, harimo nawe','Personnes, vous inclus')}</div>${chips([2,3,4,5],P.n,'ppSN')}<div style="margin:16px 0 4px;padding:2px 18px;border-radius:20px;background:var(--chip)"><div style="display:flex;justify-content:space-between;height:48px;align-items:center;font-size:15px"><span class="mu">${L('Each pays','Buri wese yishyura','Chacun paie')}</span><b>${fmt(share())} RWF</b></div><div style="display:flex;justify-content:space-between;min-height:48px;align-items:center;font-size:15px;border-top:0;gap:12px"><span class="mu">${L('Request from','Gusaba kuri','Demander à')}</span><b style="text-align:right">${who.join(', ')}</b></div></div><button class="btn" style="margin-top:16px" onclick="ppSplitGo()">${L('Request','Saba','Demander')} ${fmt(share())} RWF ${L('each','buri umwe','chacun')}</button><div class="fine" style="margin-top:10px">${L('Sample contacts. No real requests are sent.','Abantu b’icyitegererezo. Nta busabe bwoherejwe.','Contacts d’exemple. Aucune demande réelle.')}</div>`)};
window.ppSA=n=>{S.spl.total=n;ppSplit()};window.ppSN=n=>{S.spl.n=n;ppSplit()};
window.ppSplitGo=()=>{const P=S.spl,s=share(),l=L('Split bill','Gabana fagitire','Addition partagée');PEOPLE.slice(0,P.n-1).forEach(n=>S.rqs.push({id:Date.now()+Math.floor(Math.random()*1e4),n,amt:s,l,paid:false}));closeSheet();render('fade-none');toast((P.n-1)+' '+L('requests sent','ubusabe bwoherejwe','demandes envoyées'))};
window.rqPaid=id=>{const r=S.rqs.find(x=>x.id===id);if(!r||r.paid)return;r.paid=true;S.pay+=r.amt;addAct('up','From '+r.n,'Received',r.amt,'Received');render('fade-none');toast(esc(r.n)+' '+L('paid you','yakwishyuye','vous a payé')+' '+fmt(r.amt)+' RWF')};
})();
</script>
<script>
/* v80: full Invest. Portfolio, Market (stocks, Treasury bills and bonds, IPO, watchlist), stock detail with charts, market and limit orders, dividends, activity. rw strings need native review */
(function(){
if(window.__inv80)return;window.__inv80=1;
const L=(e,r,f)=>({en:e,rw:r||e,fr:f||e}[S.lang]||e);
const esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const fm=n=>fmt(Math.round(n));
const sg=n=>(n<0?'−':'+')+fm(Math.abs(n));
const sp=n=>(n<0?'−':'+')+Math.abs(n).toFixed(1)+'%';
const cls=n=>n>=0?'up':'dn';
const lay=h=>{$('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" style="max-height:92%;overflow-y:auto">'+h+'</div>'};
const rr=()=>{const sc=$('#sc'),y=sc?sc.scrollTop:0;render('fade-none');const n=$('#sc');if(n)n.scrollTop=y};
const kv=(a,b,top)=>`<div style="display:flex;justify-content:space-between;gap:12px;min-height:46px;align-items:center;font-size:15px;${top?'border-top:0':''}"><span class="mu">${a}</span><b style="text-align:right">${b}</b></div>`;
const kvs=a=>a.map(([x,y],i)=>kv(x,y,i)).join('');
const dstr=ms=>new Date(ms).toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric'});
const term=d=>d>=1000?(d/365)+' '+L('years','imyaka','ans'):d+' '+L('days','iminsi','jours');
const hash=s=>{let h=2166136261;for(let i=0;i<s.length;i++){h^=s.charCodeAt(i);h=Math.imul(h,16777619)}return h>>>0};
const rng=seed=>{let a=seed>>>0;return()=>{a=(a+0x6D2B79F5)|0;let z=Math.imul(a^(a>>>15),1|a);z=(z+Math.imul(z^(z>>>7),61|z))^z;return((z^(z>>>14))>>>0)/4294967296}};

/* ---------- data ---------- */
const X={
BK:{sec:'Banking',sh:900,eps:30,dv:24,ab:'Retail and corporate bank with branches across Rwanda. Figures are sample data.'},
MTNR:{sec:'Telecoms',sh:2000,eps:12,dv:12,ab:'Mobile network operator with voice, data and mobile money. Figures are sample data.'},
BRL:{sec:'Beverages',sh:303,eps:11,dv:14,ab:'Brewer and bottler of beer and soft drinks sold across the country. Figures are sample data.'},
IMR:{sec:'Banking',sh:1000,eps:5.5,dv:4,ab:'Commercial bank focused on business and retail customers. Figures are sample data.'},
CMR:{sec:'Construction',sh:419,eps:6.5,dv:6,ab:'Cement producer supplying building projects in Rwanda. Figures are sample data.'},
KCB:{sec:'Banking',sh:3200,eps:35,dv:28,ab:'Regional banking group cross-listed on the RSE. Figures are sample data.'},
KSL:{sec:'Energy',sh:200,eps:8,dv:8,ab:'Rooftop solar installer for homes and small businesses. Sample company for the IPO demo.'}};
if(!STK.find(s=>s[0]==='CMR'))STK.push(['CMR','Cimerwa',130,.8]);
if(!STK.find(s=>s[0]==='KCB'))STK.push(['KCB','KCB Group',360,-.3]);
const BONDS=[['tb91','91-day Treasury bill',8.2,91],['tb182','182-day Treasury bill',9.0,182],['tb364','364-day Treasury bill',9.8,364],['tn5','5-year Treasury bond',12.1,1825],['tn10','10-year Treasury bond',13.0,3650]];
const IPOS=[{id:'ksl',tk:'KSL',n:'Kigali Solar Ltd',price:150,min:100,close:(n=>{const d=new Date();d.setDate(d.getDate()+n);return d.getDate()+' '+['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'][d.getMonth()]+' '+d.getFullYear()})(3),list:(n=>{const d=new Date();d.setDate(d.getDate()+n);return d.getDate()+' '+['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'][d.getMonth()]+' '+d.getFullYear()})(10),list0:165}];
const PAL=['#6960F9','#2E6BF0','#0A8F5B','#F5A623','#E5484D','#9B59B6','#14B8A6','#8B95A1'];
const I=S.inv=S.inv||{};
Object.assign(I,{tab:I.tab||'port',mk:I.mk||'stocks',rng:I.rng||'1M',sort:I.sort||'mov',q:I.q||'',watch:I.watch||{},orders:I.orders||[],hist:I.hist||[],bonds:I.bonds||[],ipo:I.ipo||null,div:I.div||0,real:I.real||0,dpaid:I.dpaid||{},open:I.open||{},oid:I.oid||1,bd:I.bd||{id:'tb91',a:100000},ip:I.ip||{n:100}});
STK.forEach(s=>{if(I.open[s[0]]==null)I.open[s[0]]=Math.round(s[2]/(1+s[3]/100))});

/* ---------- helpers ---------- */
const stk=tk=>STK.find(x=>x[0]===tk);
const px=tk=>stk(tk)[2];
const fee=v=>Math.max(100,Math.round(v*.004));
const resSell=tk=>I.orders.filter(o=>o.side==='sell'&&o.tk===tk).reduce((a,o)=>a+o.q,0);
const avail=tk=>(S.hold[tk]?S.hold[tk].q:0)-resSell(tk);
const bondsVal=()=>I.bonds.reduce((a,b)=>a+b.a,0);
const resBuy=()=>I.orders.filter(o=>o.side==='buy').reduce((a,o)=>a+o.res,0);
const dyield=tk=>X[tk]?X[tk].dv/px(tk)*100:0;window.STKX=X;window.STKDY=dyield;
const bInt=(a,r,d)=>Math.round(a*r/100*d/365);

/* ---------- price history ---------- */
const RG={'1D':[24,.005],'1W':[28,.01],'1M':[30,.014],'1Y':[52,.035]};
function series(tk,r){const s=stk(tk),p=s[2],[n,v]=RG[r],g=rng(hash(tk+r));let h=[100];for(let i=1;i<n;i++)h.push(h[i-1]*(1+(g()-.5)*v*2+(r==='1Y'?.002:0)));
const k=p/h[n-1];let a=h.map(x=>x*k);
if(r==='1D'){const o=I.open[tk]||p,d0=o-a[0];a=a.map((x,i)=>x+d0*(1-i/(n-1)))}
a[n-1]=p;return a}
const spark=(tk,w=64,h=28)=>{const a=series(tk,'1M'),mn=Math.min(...a),mx=Math.max(...a),n=a.length,col=a[n-1]>=a[0]?'var(--ok)':'var(--er)';return `<svg width="${w}" height="${h}" viewBox="0 0 ${w} ${h}" aria-hidden="true"><path d="${a.map((v,i)=>(i?'L':'M')+(i/(n-1)*w).toFixed(1)+' '+(h-2-(v-mn)/((mx-mn)||1)*(h-4)).toFixed(1)).join('')}" fill="none" stroke="${col}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>`};
function chart(tk,r){const a=series(tk,r),n=a.length,mn=Math.min(...a),mx=Math.max(...a),pad=(mx-mn)*.12||1,lo=mn-pad,hi=mx+pad,col=a[n-1]>=a[0]?'var(--ok)':'var(--er)';
const d=a.map((v,i)=>(i?'L':'M')+(i/(n-1)*340).toFixed(1)+' '+(170-(v-lo)/(hi-lo)*170).toFixed(1)).join('');
return `<svg id="ich" viewBox="0 0 340 170" width="100%" height="170" preserveAspectRatio="none" role="img" aria-label="${L('Price chart','Igishushanyo cy’igiciro','Graphique du cours')}" onpointerdown="invScrub(event,'${tk}','${r}')" onpointermove="invScrub(event,'${tk}','${r}')" onpointerup="invScrubEnd()" onpointercancel="invScrubEnd()" onpointerleave="invScrubEnd()" style="display:block;touch-action:pan-y"><defs><linearGradient id="ig" x1="0" y1="0" x2="0" y2="1"><stop offset="0" style="stop-color:${col};stop-opacity:.1"/><stop offset="1" style="stop-color:${col};stop-opacity:.1"/></linearGradient></defs><path d="${d}L340 170L0 170Z" fill="url(#ig)"/><path d="${d}" fill="none" stroke="${col}" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round" vector-effect="non-scaling-stroke"/><line id="icl" x1="0" x2="0" y1="0" y2="170" stroke="var(--tx)" stroke-width="1" vector-effect="non-scaling-stroke" opacity="0"/></svg>`}
window.invScrub=(e,tk,r)=>{const a=series(tk,r),n=a.length,b=e.currentTarget.getBoundingClientRect();let i=Math.round((e.clientX-b.left)/(b.width||1)*(n-1));i=Math.max(0,Math.min(n-1,i));I.scrub=1;const x=i/(n-1)*340,l=$('#icl');if(l){l.setAttribute('x1',x);l.setAttribute('x2',x);l.setAttribute('opacity','.5')}const P=$('#ipx'),C=$('#ipc');if(P)P.textContent=fm(a[i])+' RWF';if(C){const d=a[i]-a[0];C.textContent=sg(d)+' RWF ('+sp(a[0]?d/a[0]*100:0)+')';C.className='sm '+cls(d)}};
window.invScrubEnd=()=>{if(!I.scrub)return;I.scrub=0;const l=$('#icl'),P=$('#ipx'),C=$('#ipc');if(l)l.setAttribute('opacity','0');if(P)P.textContent=P.dataset.o;if(C){C.textContent=C.dataset.o;C.className=C.dataset.c}};

/* ---------- rows ---------- */
const stockRow=s=>{const [tk,n,p,c]=s,h=S.hold[tk];return `<div class="stk" onclick="openStock('${tk}')"><div class="tk">${tk}</div><div style="flex:1;min-width:0"><div style="font-weight:700;font-size:16px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${esc(n)}</div><div class="sm mu">${esc(X[tk].sec)} · ${dyield(tk).toFixed(1)}%${h?' · '+h.q+' '+L('held','zifitwe','détenues'):''}</div></div>${spark(tk)}<div style="text-align:right;min-width:68px"><div style="font-weight:800">${fmt(p)}</div><div class="sm ${cls(c)}" style="font-weight:700">${c>=0?'+':''}${c}%</div></div></div>`};
const holdRow=tk=>{const s=stk(tk),h=S.hold[tk],v=h.q*s[2],g=v-h.q*h.avg,gp=h.avg?g/(h.q*h.avg)*100:0;return `<div class="stk" onclick="openStock('${tk}')"><div class="tk">${tk}</div><div style="flex:1;min-width:0"><div style="font-weight:700;font-size:16px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${esc(s[1])}</div><div class="sm mu">${h.q} ${L('shares','imigabane','actions')} · ${L('avg','impuzandengo','moy.')} ${fmt(h.avg)}</div></div><div style="text-align:right"><div style="font-weight:800">${fm(v)} RWF</div><div class="sm ${cls(g)}" style="font-weight:700">${sg(g)} · ${sp(gp)}</div></div></div>`};
const hRow=x=>{const buy=x.k==='buy',tk=x.tk;let b=tk||'',ti='',a=null,sub='';
if(x.k==='buy'){ti=L('Bought ','Waguze ','Achat ')+x.q+' × '+tk;a=-x.a;sub=L('at ','kuri ','à ')+fmt(x.p)}
else if(x.k==='sell'){ti=L('Sold ','Wagurishije ','Vente ')+x.q+' × '+tk;a=x.a;sub=L('at ','kuri ','à ')+fmt(x.p)}
else if(x.k==='div'){ti=L('Dividend · ','Inyungu · ','Dividende · ')+tk;a=x.a}
else if(x.k==='bond'){b='TB';ti=L('Bought ','Waguze ','Achat ')+x.n;a=-x.a}
else if(x.k==='bondpay'){b='TB';ti=L('Matured · ','Byarangiye · ','Échu · ')+x.n;a=x.a}
else if(x.k==='ipo'){b=x.tk;ti=L('IPO application · ','Gusaba IPO · ','Souscription IPO · ')+x.tk;a=-x.a}
else if(x.k==='ipocancel'){b=x.tk;ti=L('IPO application cancelled · ','IPO yahagaritswe · ','Souscription annulée · ')+x.tk;a=x.a}
else if(x.k==='iposhare'){b=x.tk;ti=L('IPO shares received · ','Imigabane ya IPO · ','Actions IPO reçues · ')+x.tk;a=x.a||null;sub=x.q+' '+L('shares','imigabane','actions')}
else if(x.k==='cancel'){ti=L('Order cancelled · ','Itegeko ryahagaritswe · ','Ordre annulé · ')+tk;a=null}
return `<div class="stk" style="cursor:default"><div class="tk">${esc(b)}</div><div style="flex:1;min-width:0"><div style="font-weight:700;font-size:16px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${esc(ti)}</div><div class="sm mu">${day48(x.ts)}, ${tm48(x.ts)}${sub?' · '+esc(sub):''}</div></div>${a==null?'':`<b class="${a>=0?'up':''}">${a>=0?'+':'−'}${fm(Math.abs(a))} RWF</b>`}</div>`};
const hd=t=>`<div class="agt">${t}</div>`;
const disc=()=>L('Prices, holdings, yields and IPOs are sample data for this prototype, not live RSE quotes. Money for buying comes from your itunda Bank balance. itunda is not a licensed broker and this is not investment advice.','Ibiciro, imigabane n’inyungu ni ingero gusa, si ibiciro nyakuri bya RSE. Amafaranga yo kugura aturuka kuri itunda Bank. itunda si umukomisiyoneri wemewe kandi ibi si inama y’ishoramari.','Les cours, positions, rendements et IPO sont des données d’exemple pour ce prototype, pas des cotations RSE en direct. L’argent pour acheter vient de votre solde itunda Bank. itunda n’est pas un courtier agréé et ceci n’est pas un conseil en investissement.');

/* ---------- hub ---------- */
window.invTab=k=>{I.tab=k;render('fade-none');const sc=$('#sc');if(sc)sc.scrollTop=0};
window.invMk=k=>{I.mk=k;rr()};
window.invSort=k=>{I.sort=k;rr()};
window.invSearch=v=>{I.q=v.trim().toLowerCase();const e=$('#ilist');if(e)e.innerHTML=stockList()};
window.invWatch=tk=>{I.watch[tk]=!I.watch[tk];rr();toast(I.watch[tk]?L('Added to watchlist','Byashyizwe ku rutonde','Ajouté à la liste de suivi'):L('Removed from watchlist','Byakuwe ku rutonde','Retiré de la liste de suivi'))};
screens.invest=()=>{const tabs=[['port',L('Portfolio','Portfolio','Portefeuille')],['mkt',L('Market','Isoko','Marché')],['act',L('Activity','Ibyakozwe','Activité')]];
const body=I.tab==='mkt'?mktTab():I.tab==='act'?actTab():portTab();
return `${bar(L('Invest','Gushora imari','Investir'))}<div class="seg" style="gap:20px">${tabs.map(([k,l])=>`<button class="${I.tab===k?'on':''}" onclick="invTab('${k}')">${l}${k==='act'&&I.orders.length?' ('+I.orders.length+')':''}</button>`).join('')}</div>${body}<div class="pad fine" style="padding-top:22px;padding-bottom:12px">${disc()}</div>${I.tab==='port'&&!Object.keys(S.hold).length&&!I.bonds.length&&!I.ipo?`<div class="cta" style="display:flex;gap:12px"><button class="btn sec2" style="height:52px;font-size:16px;border-radius:16px" onclick="invMk('bonds');invTab('mkt')">${L('Treasury bills','Treasury bills','Bons du Trésor')}</button><button class="btn" style="height:52px;font-size:16px;border-radius:16px" onclick="invMk('stocks');invTab('mkt')">${L('Browse stocks','Reba imigabane','Voir les actions')}</button></div>`:''}`};

function portTab(){const hs=Object.keys(S.hold).sort((a,b)=>S.hold[b].q*px(b)-S.hold[a].q*px(a)),sv=stkVal(),bv=bondsVal(),iv=I.ipo&&I.ipo.status==='Applied'?I.ipo.amt:0,total=sv+bv+iv;
const cost=hs.reduce((a,k)=>a+S.hold[k].q*S.hold[k].avg,0),gain=sv-cost,gp=cost?gain/cost*100:0,exp=I.bonds.reduce((a,b)=>a+bInt(b.a,b.r,b.d),0);
const items=[...hs.map(k=>[k,S.hold[k].q*px(k)]),...(bv?[[L('Treasury','Treasury','Trésor'),bv]]:[]),...(iv?[['IPO',iv]]:[])];
const alloc=items.length?`<div class="pad" style="padding-top:18px"><div class="nwb">${items.map(([n,v],i)=>`<span style="width:${Math.max(2,v/total*100)}%;background:${PAL[i%PAL.length]}"></span>`).join('')}</div><div style="padding-top:8px">${items.map(([n,v,],i)=>`<div class="nwl"><span><i style="background:${PAL[i%PAL.length]}"></i>${esc(n)}</span><b>${Math.round(v/total*100)}%</b></div>`).join('')}</div></div>`:'';
const tile=(a,b,c)=>`<div style="flex:1;min-width:0;background:var(--chip);border-radius:16px;padding:12px"><div class="sm mu">${a}</div><b style="font-size:15px" class="${c||''}">${b}</b></div>`;
const empty=!hs.length&&!I.bonds.length&&!I.ipo?`<div class="pad" style="padding-top:26px;text-align:center"><div>${gl('chart',72)}</div><div style="font-size:20px;font-weight:800;margin-top:12px">${L('Start investing','Tangira gushora imari','Commencez à investir')}</div><div class="mu" style="font-size:15px;line-height:22px;margin-top:8px">${L('Buy shares of Rwandan companies, lend to the Government with Treasury bills, or apply for an IPO. You can start with a small amount.','Gura imigabane y’ibigo byo mu Rwanda, uguriza Leta ukoresheje Treasury bills, cyangwa usabe IPO. Ushobora gutangira n’amafaranga make.','Achetez des actions d’entreprises rwandaises, prêtez à l’État avec des bons du Trésor ou souscrivez à une IPO. Vous pouvez commencer avec peu.')}</div></div>`:'';
let out=`<div class="pad" style="padding-top:18px"><div class="sm mu">${L('Invested value','Agaciro k’ishoramari','Valeur investie')}</div><div class="big" style="margin-top:4px">${fm(total)} RWF</div>${hs.length?`<div class="sm ${cls(gain)}" style="font-weight:800;margin-top:4px">${sg(gain)} RWF (${sp(gp)}) ${L('since you bought','kuva waguze','depuis l’achat')}</div>`:exp?`<div class="sm up" style="font-weight:800;margin-top:4px">${L('Interest due at maturity','Inyungu zizatangwa','Intérêts à l’échéance')} +${fm(exp)} RWF</div>`:''}</div>
<div class="pad" style="display:flex;gap:10px;padding-top:16px">${tile(L('Cash','Amafaranga ahari','Disponible'),fm(S.bank)+' RWF')}${tile(L('Dividends','Inyungu','Dividendes'),fm(I.div)+' RWF',I.div?'up':'')}${tile(L('Realized','Byagezweho','Réalisé'),sg(I.real)+' RWF',I.real?cls(I.real):'')}</div>${alloc}${empty}`;
if(I.orders.length)out+=`<div style="padding-top:14px">${row('history',L(I.orders.length+' open orders',I.orders.length+' amategeko ategereje',I.orders.length+' ordres ouverts'),L('Waiting for your price','Ategereje igiciro cyawe','En attente de votre prix'),'',"invTab('act')")}</div>`;
if(hs.length)out+=hd(L('Stocks','Imigabane','Actions'))+hs.map(holdRow).join('');
if(I.bonds.length)out+=hd(L('Treasury bills and bonds','Treasury bills n’impapuro mpeshamwenda','Bons du Trésor'))+I.bonds.map((b,i)=>`<div class="stk" onclick="invBond(${i})"><div class="tk">TB</div><div style="flex:1;min-width:0"><div style="font-weight:700;font-size:16px">${esc(b.n)}</div><div class="sm mu">${L('Matures ','Birangira ','Échéance ')}${dstr(b.mt)}${b.ff||Date.now()>=b.mt?' · '+L('Ready to collect','Biteguye gufatwa','Prêt à encaisser'):''}</div></div><div style="text-align:right"><div style="font-weight:800">${fm(b.a)} RWF</div><div class="sm up" style="font-weight:700">+${fm(bInt(b.a,b.r,b.d))} RWF</div></div></div>`).join('');
if(I.ipo&&I.ipo.status==='Applied'){const o=I.ipo;out+=hd('IPO')+`<div class="stk" onclick="invMk('ipo');invTab('mkt')"><div class="tk">${o.tk}</div><div style="flex:1"><div style="font-weight:700;font-size:16px">${L('Applied for ','Wasabye ','Demande de ')}${o.shares} ${L('shares','imigabane','actions')}</div><div class="sm mu">${L('Waiting for listing','Utegereje gutangira kugurishwa','En attente de cotation')}</div></div><b>${fm(o.amt)} RWF</b></div>`}
return out}

function stockList(){let a=STK.slice();if(I.mk==='watch')a=a.filter(s=>I.watch[s[0]]);const q=I.q;if(q)a=a.filter(s=>(s[0]+' '+s[1]+' '+X[s[0]].sec).toLowerCase().includes(q));
const so=I.sort;a.sort((x,y)=>so==='yld'?dyield(y[0])-dyield(x[0]):so==='name'?x[1].localeCompare(y[1]):Math.abs(y[3])-Math.abs(x[3]));
if(!a.length)return `<div class="pkempty">${I.mk==='watch'&&!q?L('Tap the star on a stock to follow it here.','Kanda inyenyeri ku mugabane kugira ngo uwukurikirane hano.','Touchez l’étoile d’une action pour la suivre ici.'):L('Nothing matches “','Nta cyabonetse kuri “','Aucun résultat pour « ')+esc(q)+L('”.','”.',' ».')}</div>${I.mk==='watch'&&!q?`<div class="pad" style="padding-top:8px"><button class="btn" style="height:52px;font-size:16px;border-radius:16px" onclick="invMk('stocks')">${L('Browse stocks','Reba imigabane','Voir les actions')}</button></div>`:''}`;return a.map(stockRow).join('')}

function mktTab(){const chips=[['stocks',L('Stocks','Imigabane','Actions')],['bonds',L('Bonds','Impapuro','Obligations')],['ipo','IPO'],['watch','★ '+L('Watchlist','Urutonde','Suivi')]];
let out=`<div class="chips" style="padding-top:16px">${chips.map(([k,l])=>`<button class="cch ${I.mk===k?'on':''}" onclick="invMk('${k}')">${l}</button>`).join('')}</div>`;
if(I.mk==='bonds')return out+`<div class="pad mu" style="padding-top:16px;font-size:15px;line-height:22px">${L('Lend to the Government of Rwanda and earn a fixed rate. Your money is locked until the maturity date.','Uguriza Leta y’u Rwanda ukabona inyungu zihamye. Amafaranga yawe afungwa kugeza ku munsi wo kurangira.','Prêtez à l’État rwandais et gagnez un taux fixe. Votre argent est bloqué jusqu’à l’échéance.')}</div><div style="padding-top:8px">${BONDS.map(b=>`<div class="stk" onclick="invBondBuy('${b[0]}')"><div class="tk">${b[3]>=1000?'TN':'TB'}</div><div style="flex:1;min-width:0"><div style="font-weight:700;font-size:16px">${b[1]}</div><div class="sm mu">${term(b[3])} · ${L('min','nibura','min.')} 50,000 RWF</div></div><div style="text-align:right"><div style="font-weight:800;color:var(--ok)">${b[2].toFixed(1)}%</div><div class="sm mu">${L('a year','ku mwaka','par an')}</div></div></div>`).join('')}</div>`;
if(I.mk==='ipo')return out+IPOS.map(ipoCard).join('');
const a=STK.map(s=>s[3]),av=a.reduce((x,y)=>x+y,0)/a.length,u=a.filter(x=>x>0).length,d=a.filter(x=>x<0).length;
const sum=I.mk==='stocks'?`<div class="pad" style="padding-top:16px"><div style="background:var(--chip);border-radius:20px;padding:14px 18px;display:flex;justify-content:space-between;align-items:center"><div><div class="sm mu">${L('Market today (sample)','Isoko uyu munsi (urugero)','Marché aujourd’hui (exemple)')}</div><div style="font-size:22px;font-weight:800;margin-top:2px" class="${cls(av)}">${sp(av)}</div></div><div class="sm mu" style="text-align:right">${u} ${L('up','zazamutse','en hausse')} · ${d} ${L('down','zamanutse','en baisse')}<br>${a.length-u-d} ${L('flat','zidahindutse','stables')}</div></div></div>`:'';
const so=[['mov',L('Top movers','Izihindutse cyane','Plus fortes variations')],['yld',L('Dividend yield','Inyungu','Rendement')],['name',L('Name','Izina','Nom')]];
return out+sum+`<label class="asr">${ic('search',20)}<input id="iqs" placeholder="${L('Search stocks','Shakisha imigabane','Rechercher des actions')}" value="${esc(I.q)}" oninput="invSearch(this.value)" aria-label="${L('Search stocks','Shakisha imigabane','Rechercher des actions')}"></label><div class="chips" style="padding-top:12px">${so.map(([k,l])=>`<button class="cch ${I.sort===k?'on':''}" onclick="invSort('${k}')">${l}</button>`).join('')}</div><div id="ilist" style="padding-top:6px">${stockList()}</div>`}

function ipoCard(o){const A=I.ipo&&I.ipo.id===o.id?I.ipo:null;
let act=`<button class="btn" style="margin-top:16px;height:52px;font-size:16px;border-radius:16px" onclick="invIpo('${o.id}')">${L('Apply for shares','Saba imigabane','Souscrire')}</button>`,st='';
if(A&&A.status==='Applied'){st=`<div style="margin-top:14px;padding:12px 14px;border-radius:14px;background:var(--tint);color:var(--tintfg);font-weight:700;font-size:14px;line-height:20px">${L('You applied for ','Wasabye ','Vous avez demandé ')}${A.shares} ${L('shares. ','imigabane. ',' actions. ')}${fm(A.amt)} RWF ${L('is reserved until listing.','byabikiwe kugeza ku gutangira kugurishwa.','sont réservés jusqu’à la cotation.')}</div>`;
act=`<div class="row2" style="margin-top:12px"><button class="btn sec2" style="height:48px;font-size:15px;border-radius:14px" onclick="invIpoCancel()">${L('Cancel application','Hagarika','Annuler')}</button><button class="btn" style="height:48px;font-size:15px;border-radius:14px" onclick="invIpoList()">${L('Simulate listing (demo)','Gerageza (demo)','Simuler la cotation (démo)')}</button></div>`}
else if(A&&A.status==='Listed'){st=`<div style="margin-top:14px;padding:12px 14px;border-radius:14px;background:var(--tint);color:var(--tintfg);font-weight:700;font-size:14px;line-height:20px">${L('Listed. You received ','Byatangiye. Wabonye ','Cotée. Vous avez reçu ')}${A.got} ${L('shares','imigabane','actions')}${A.refund?' · '+fm(A.refund)+' RWF '+L('refunded','byasubijwe','remboursés'):''}</div>`;act=`<button class="btn sec2" style="margin-top:12px;height:48px;font-size:15px;border-radius:14px" onclick="openStock('${o.tk}')">${L('View ','Reba ','Voir ')}${o.tk}</button>`}
return `<div class="pad" style="padding-top:18px"><div style="background:var(--chip);border-radius:24px;padding:18px"><div style="display:flex;align-items:center;gap:12px"><div class="tk" style="width:44px;height:44px;border-radius:12px;background:var(--bg);display:flex;align-items:center;justify-content:center;font-weight:800;font-size:12px">${o.tk}</div><div><div style="font-size:18px;font-weight:800">${o.n}</div><div class="sm mu">${L('Energy · sample IPO','Ingufu · IPO y’urugero','Énergie · IPO d’exemple')}</div></div></div><div style="margin-top:8px">${kvs([[L('Price per share','Igiciro ku mugabane','Prix par action'),fmt(o.price)+' RWF'],[L('Minimum','Nibura','Minimum'),o.min+' '+L('shares','imigabane','actions')],[L('Subscription closes','Gusaba birangira','Clôture'),o.close],[L('Listing date','Itariki yo gutangira','Date de cotation'),o.list]])}</div>${st}${act}</div></div>`}

function actTab(){const pend=I.orders.map(o=>{const s=stk(o.tk);return `<div class="stk" style="cursor:default"><div class="tk">${o.tk}</div><div style="flex:1;min-width:0"><div style="font-weight:700;font-size:16px">${o.side==='buy'?L('Buy','Gura','Achat'):L('Sell','Gurisha','Vente')} ${o.q} × ${o.tk}</div><div class="sm mu">${L('Limit','Igiciro wihitiyemo','Limite')} ${fmt(o.lim)} · ${L('now','ubu','actuel')} ${fmt(s[2])}${o.res?' · '+fm(o.res)+' RWF '+L('reserved','byabikiwe','réservés'):''}</div></div><button class="cch" onclick="invCancel(${o.id})">${L('Cancel','Hagarika','Annuler')}</button></div>`}).join('');
return (I.orders.length?hd(L('Open orders','Amategeko ategereje','Ordres ouverts'))+pend:'')+hd(L('History','Amateka','Historique'))+(I.hist.length?I.hist.map(hRow).join(''):`<div class="pkempty">${L('No trades yet. Your buys, sells, dividends and Treasury bills show up here.','Nta cyo urakora. Ibyo uzagura, uzagurisha n’inyungu bizagaragara hano.','Aucune opération. Vos achats, ventes, dividendes et bons du Trésor apparaîtront ici.')}</div><div class="pad" style="padding-top:8px"><button class="btn" style="height:52px;font-size:16px;border-radius:16px" onclick="invMk('stocks');invTab('mkt')">${L('Browse stocks','Reba imigabane','Voir les actions')}</button></div>`)}

/* ---------- stock detail ---------- */
window.openStock=tk=>{if(!stk(tk))return;I.sk=tk;I.scrub=0;S.stack.push('stock');render('push')};
window.stkSheet=window.openStock;
window.invRng=r=>{I.rng=r;rr()};
screens.stock=()=>{const tk=I.sk,s=stk(tk);if(!s)return `${bar('')}<div class="pkempty">${L('This stock is not available.','Uyu mugabane ntuboneka.','Cette action n’est pas disponible.')}</div>`;
const [,n,p]=s,h=S.hold[tk],rg=I.rng,a=series(tk,rg),ch=p-a[0],chp=a[0]?ch/a[0]*100:0,av=avail(tk),x=X[tk];
const lab={'1D':L('today','uyu munsi','aujourd’hui'),'1W':L('past week','icyumweru gishize','7 derniers jours'),'1M':L('past month','ukwezi gushize','30 derniers jours'),'1Y':L('past year','umwaka ushize','12 derniers mois')}[rg];
const ax={'1D':L('Open','Gufungura','Ouverture'),'1W':L('1 week ago','icyumweru gishize','il y a 1 sem.'),'1M':L('1 month ago','ukwezi gushize','il y a 1 mois'),'1Y':L('1 year ago','umwaka ushize','il y a 1 an')}[rg];
const yr=series(tk,'1Y'),hi=Math.max(...yr),lo=Math.min(...yr),mc=p*x.sh/1000;
const chText=sg(ch)+' RWF ('+sp(chp)+')';
let pos='';if(h){const v=h.q*p,g=v-h.q*h.avg,gp=h.avg?g/(h.q*h.avg)*100:0;pos=`<div class="pad" style="padding-top:20px"><div style="background:var(--chip);border-radius:24px;padding:16px 18px"><div style="font-size:17px;font-weight:800">${L('Your position','Ibyo ufite','Votre position')}</div><div style="margin-top:4px">${kvs([[L('Shares','Imigabane','Actions'),h.q],[L('Market value','Agaciro ku isoko','Valeur de marché'),fm(v)+' RWF'],[L('Average cost','Igiciro cy’impuzandengo','Coût moyen'),fmt(h.avg)+' RWF'],[L('Total return','Inyungu zose','Rendement total'),`<span class="${cls(g)}">${sg(g)} RWF · ${sp(gp)}</span>`],[L('Dividends a year (est.)','Inyungu ku mwaka (ibigereranyo)','Dividendes/an (est.)'),fm(h.q*x.dv)+' RWF']])}</div><button class="btn sec2" style="height:44px;font-size:15px;border-radius:14px;margin-top:10px" ${I.dpaid[tk]?'disabled':''} onclick="invDiv('${tk}')">${I.dpaid[tk]?L('Sample dividend received','Inyungu y’urugero yabonetse','Dividende d’exemple reçu'):L('Receive sample dividend','Akira inyungu y’urugero','Recevoir un dividende d’exemple')+' · '+fm(h.q*x.dv/2)+' RWF'}</button></div></div>`}
const po=I.orders.filter(o=>o.tk===tk);
const pend=po.length?`<div class="agt">${L('Open orders','Amategeko ategereje','Ordres ouverts')}</div>${po.map(o=>`<div class="stk" style="cursor:default"><div style="flex:1"><div style="font-weight:700">${o.side==='buy'?L('Buy','Gura','Achat'):L('Sell','Gurisha','Vente')} ${o.q} ${L('at','kuri','à')} ${fmt(o.lim)}</div><div class="sm mu">${o.res?fm(o.res)+' RWF '+L('reserved','byabikiwe','réservés'):L('Shares reserved','Imigabane yabitswe','Actions réservées')}</div></div><button class="cch" onclick="invCancel(${o.id})">${L('Cancel','Hagarika','Annuler')}</button></div>`).join('')}`:'';
const st=[[L('Sector','Urwego','Secteur'),esc(x.sec)],[L('Market cap','Agaciro k’ikigo','Capitalisation'),'RWF '+(mc>=100?mc.toFixed(0):mc.toFixed(1))+' bn'],[L('P/E ratio','P/E','P/E'),(p/x.eps).toFixed(1)],[L('Dividend yield','Inyungu','Rendement'),dyield(tk).toFixed(1)+'%'],[L('Dividend per share','Inyungu ku mugabane','Dividende/action'),fmt(x.dv)+' RWF'],[L('Volume today','Ingano uyu munsi','Volume du jour'),fmt(8000+hash(tk+new Date().toDateString())%90000)],[L('52-week high','Hejuru mu byumweru 52','Plus haut 52 sem.'),fm(hi)+' RWF'],[L('52-week low','Hasi mu byumweru 52','Plus bas 52 sem.'),fm(lo)+' RWF']];
return `<div class="bar"><button class="ib" aria-label="Back" onclick="back()">${ic('back',24)}</button><b>${tk}</b><span style="flex:1"></span><button class="ib" aria-label="${L('Watchlist','Urutonde','Liste de suivi')}" aria-pressed="${!!I.watch[tk]}" onclick="invWatch('${tk}')">${ic('star',24,I.watch[tk]?'#F5B301':'var(--tx)')}</button></div>
<div class="pad" style="padding-top:8px"><div class="sm mu">${esc(n)}</div><div id="ipx" class="big" data-o="${fm(p)} RWF" style="margin-top:2px">${fm(p)} RWF</div><div id="ipc" class="sm ${cls(ch)}" data-o="${chText}" data-c="sm ${cls(ch)}" style="font-weight:800;margin-top:2px">${chText}</div><div class="sm mu" style="margin-top:2px">${lab}</div></div>
<div style="padding-top:12px">${chart(tk,rg)}</div><div style="display:flex;justify-content:space-between;padding:4px 24px 0;font-size:12px;color:var(--tt)"><span>${ax}</span><span>${L('Now','Ubu','Maintenant')}</span></div>
<div style="display:flex;gap:8px;padding:12px 24px 0;justify-content:center">${['1D','1W','1M','1Y'].map(r=>`<button class="cch ${rg===r?'on':''}" onclick="invRng('${r}')">${r}</button>`).join('')}</div>${pos}${pend}
<div class="agt">${L('Key stats (sample)','Ibyingenzi (urugero)','Chiffres clés (exemple)')}</div><div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;padding:6px 24px 0">${st.map(([a,b])=>`<div style="background:var(--chip);border-radius:16px;padding:12px 14px"><div class="sm mu">${a}</div><b style="font-size:15px">${b}</b></div>`).join('')}</div>
<div class="agt">${L('About','Ibyerekeye','À propos')}</div><div class="pad" style="font-size:15px;line-height:23px">${esc(x.ab)}</div>
<div class="pad fine" style="padding-top:18px;padding-bottom:110px">${disc()}</div>
<div class="cta" style="display:flex;gap:12px">${av>0?`<button class="btn sec2" style="flex:1;height:52px;font-size:16px;border-radius:16px" onclick="invTrade('${tk}','sell')">${L('Sell','Gurisha','Vendre')}</button>`:''}<button class="btn" style="flex:1;height:52px;font-size:16px;border-radius:16px" onclick="invTrade('${tk}','buy')">${L('Buy','Gura','Acheter')}</button></div>`};

/* ---------- trading ---------- */
function calc(){const T=I.tr,p=px(T.tk),pr=T.type==='limit'?T.lim:p,v=T.q*pr,f=T.q&&pr?fee(v):0,tot=T.side==='buy'?v+f:v-f;let err='';
if(T.type==='limit'&&pr){const lo=Math.round(p*.9),hi=Math.round(p*1.1);if(pr<lo||pr>hi)err=L('Limit price must be within 10% of the market price ('+fmt(lo)+' to '+fmt(hi)+').','Igiciro cyihariye kigomba kuba muri 10% y’igiciro cy’isoko ('+fmt(lo)+' kugeza '+fmt(hi)+').','Le prix limite doit être à 10 % du cours ('+fmt(lo)+' à '+fmt(hi)+').')}
if(!err&&T.q>0){if(T.side==='buy'&&tot>S.bank)err=L('Not enough balance — you have RWF ','Amafaranga ntahagije — ufite RWF ','Solde insuffisant — vous avez RWF ')+fmt(S.bank);if(T.side==='sell'&&T.q>avail(T.tk))err=L('You can sell up to '+avail(T.tk)+' shares.','Ushobora kugurisha agera ku migabane '+avail(T.tk)+'.','Vous pouvez vendre jusqu’à '+avail(T.tk)+' actions.')}
return {p,pr,v,f,tot,err,ok:T.q>0&&pr>0&&!err}}
function sumHtml(){const T=I.tr,c=calc(),buy=T.side==='buy';return `<div style="padding:2px 16px;border-radius:18px;background:var(--chip)">${kvs([[T.type==='limit'?L('Limit price','Igiciro cyihariye','Prix limite'):L('Market price','Igiciro cy’isoko','Cours du marché'),fmt(c.pr)+' RWF'],[L('Amount','Amafaranga','Montant'),fm(c.v)+' RWF'],[L('Fee (0.4%, min 100)','Amafaranga y’inyongera (0.4%, nibura 100)','Frais (0,4 %, min 100)'),fm(c.f)+' RWF'],[buy?L('Total to pay','Yose wishyura','Total à payer'):L('You receive','Uzabona','Vous recevez'),'<span style="font-size:17px">'+fm(c.tot)+' RWF</span>'],[buy?L('Available in itunda Bank','Ahari kuri itunda Bank','Disponible sur itunda Bank'):L('Shares you can sell','Imigabane ushobora kugurisha','Actions vendables'),buy?fm(S.bank)+' RWF':avail(T.tk)]])}</div>${c.err?`<div role="alert" style="color:var(--er);font-size:14px;margin-top:10px;line-height:20px">${c.err}</div>`:''}`}
function updTrade(){const c=calc(),e=$('#trsum'),b=$('#trgo');if(e)e.innerHTML=sumHtml();if(b)b.disabled=!c.ok}
window.invTrade=(tk,side)=>{const s=stk(tk);I.tr={tk,side:side==='sell'&&avail(tk)<=0?'buy':side,q:1,type:'market',lim:s[2]};drawTrade()};
window.invSide=sd=>{if(sd==='sell'&&avail(I.tr.tk)<=0)return;I.tr.side=sd;I.tr.q=Math.max(1,sd==='sell'?Math.min(I.tr.q,avail(I.tr.tk)):I.tr.q);drawTrade()};
window.invType=ty=>{I.tr.type=ty;I.tr.lim=px(I.tr.tk);drawTrade()};
window.invQ=v=>{I.tr.q=Math.min(99999,parseInt(String(v).replace(/\D/g,''),10)||0);updTrade()};
window.invQset=n=>{I.tr.q=parseInt(n,10)||1;drawTrade()};
window.invQadj=d=>{I.tr.q=Math.max(1,Math.min(99999,(I.tr.q||0)+d));drawTrade()};
window.invLim=v=>{I.tr.lim=parseInt(String(v).replace(/\D/g,''),10)||0;updTrade()};
window.invLadj=d=>{I.tr.lim=Math.max(1,(I.tr.lim||px(I.tr.tk))+d);drawTrade()};
function drawTrade(){const T=I.tr,s=stk(T.tk),buy=T.side==='buy',lim=T.type==='limit',av=avail(T.tk);
const quick=buy?[[1,'1'],[5,'5'],[10,'10'],[50,'50']]:[[1,'1'],[Math.max(1,Math.floor(av/2)),L('Half','Kimwe cya kabiri','Moitié')],[av,L('All','Byose','Tout')]];
lay(`<div style="display:flex;align-items:center;gap:12px"><div style="width:44px;height:44px;border-radius:12px;background:var(--chip);display:flex;align-items:center;justify-content:center;font-weight:800;font-size:12px;flex-shrink:0">${T.tk}</div><div style="min-width:0"><div class="h1" style="font-size:20px;line-height:26px">${esc(s[1])}</div><div class="sm mu">${L('Last price','Igiciro cya nyuma','Dernier cours')} ${fmt(s[2])} RWF</div></div></div>
<div class="req" style="margin-top:16px"><button class="${buy?'on':''}" onclick="invSide('buy')">${L('Buy','Gura','Acheter')}</button><button class="${buy?'':'on'}" ${av>0?'':'disabled'} onclick="invSide('sell')">${L('Sell','Gurisha','Vendre')}</button></div>
<div class="req" style="margin-top:10px"><button class="${lim?'':'on'}" onclick="invType('market')">${L('Market','Igiciro cy’isoko','Au marché')}</button><button class="${lim?'on':''}" onclick="invType('limit')">${L('Limit','Igiciro cyihariye','Limite')}</button></div>
<div class="sm mu" style="margin-top:8px;line-height:19px">${lim?(buy?L('Buy only at this price or lower. We reserve the money until it fills.','Gura gusa kuri iki giciro cyangwa munsi yacyo. Amafaranga abikwa kugeza bikozwe.','Achète seulement à ce prix ou moins. L’argent est réservé jusqu’à l’exécution.'):L('Sell only at this price or higher. The shares are reserved until it fills.','Gurisha gusa kuri iki giciro cyangwa hejuru yacyo.','Vend seulement à ce prix ou plus. Les actions sont réservées jusqu’à l’exécution.')):L('Fills right away at the current price.','Bikorwa ako kanya ku giciro cy’ubu.','Exécuté tout de suite au cours actuel.')}</div>
${lim?`<div class="lab" style="margin-top:14px">${L('Limit price (RWF)','Igiciro cyihariye (RWF)','Prix limite (RWF)')}</div><div style="display:flex;align-items:center;gap:10px"><button class="ib" aria-label="−" style="background:var(--chip);border-radius:22px;flex-shrink:0" onclick="invLadj(-1)">${ic('minus',18)}</button><input class="in" id="trl" inputmode="numeric" value="${T.lim}" oninput="invLim(this.value)" style="text-align:center;font-size:22px" aria-label="${L('Limit price','Igiciro cyihariye','Prix limite')}"><button class="ib" aria-label="+" style="background:var(--chip);border-radius:22px;flex-shrink:0" onclick="invLadj(1)">${ic('plus',18)}</button></div>`:''}
<div class="lab" style="margin-top:14px">${L('Shares','Imigabane','Actions')}</div><div style="display:flex;align-items:center;gap:10px"><button class="ib" aria-label="−" style="background:var(--chip);border-radius:22px;flex-shrink:0" onclick="invQadj(-1)">${ic('minus',18)}</button><input class="in" id="trq" inputmode="numeric" value="${T.q||''}" oninput="invQ(this.value)" style="text-align:center;font-size:22px" aria-label="${L('Number of shares','Umubare w’imigabane','Nombre d’actions')}"><button class="ib" aria-label="+" style="background:var(--chip);border-radius:22px;flex-shrink:0" onclick="invQadj(1)">${ic('plus',18)}</button></div>
<div class="req" style="margin:10px 0 0">${quick.map(([n,l])=>`<button class="${T.q===n?'on':''}" onclick="invQset(${n})">${l}</button>`).join('')}</div>
<div id="trsum" style="margin-top:14px">${sumHtml()}</div><button id="trgo" class="btn" style="margin-top:14px" ${calc().ok?'':'disabled'} onclick="invAsk()">${L('Review order','Suzuma itegeko','Vérifier l’ordre')}</button>`)}

window.invAsk=()=>{const T=I.tr,c=calc();if(!c.ok)return;const buy=T.side==='buy',lim=T.type==='limit';
lay(`<div style="margin-bottom:12px">${gl('verified3d',60)}</div><div class="h1" style="font-size:22px;line-height:30px">${L('Confirm it’s you','Emeza ko ari wowe','Confirmez que c’est vous')}</div><div class="mu" style="font-size:15px;margin-top:6px">${buy?L('Buy','Gura','Achat'):L('Sell','Gurisha','Vente')} ${T.q} × ${T.tk}</div><div style="margin:14px 0 18px;padding:2px 16px;border-radius:18px;background:var(--chip)">${kvs([[L('Order type','Ubwoko bw’itegeko','Type d’ordre'),lim?L('Limit','Igiciro cyihariye','Limite'):L('Market','Igiciro cy’isoko','Au marché')],[L('Price','Igiciro','Prix'),fmt(c.pr)+' RWF'],[L('Fee','Amafaranga y’inyongera','Frais'),fm(c.f)+' RWF'],[buy?L('Total to pay','Yose wishyura','Total à payer'):L('You receive','Uzabona','Vous recevez'),fm(c.tot)+' RWF']])}</div><div class="row2"><button class="btn sec2" onclick="drawTradeBack()">${L('Back','Garuka','Retour')}</button><button class="btn" onclick="invGo()">${buy?L('Buy','Gura','Acheter'):L('Sell','Gurisha','Vendre')}</button></div>`)};
window.drawTradeBack=()=>drawTrade();
const resSheet=(title,sub,rows)=>lay(`<div class="g3" style="margin-bottom:12px">${gl('success3d',60)}</div><div class="h1" style="font-size:22px;line-height:30px">${title}</div>${sub?`<div class="mu" style="font-size:15px;margin:8px 0 0;line-height:22px">${sub}</div>`:''}<div style="margin:16px 0 20px;padding:2px 16px;border-radius:18px;background:var(--chip)">${kvs(rows)}</div><button class="btn" onclick="closeSheet()">OK</button>`);
function doBuy(tk,q,p,res){const v=q*p,f=fee(v),cost=v+f;
if(res==null){if(cost>S.bank)return false;S.bank-=cost;addAct('trend','Bought '+q+' '+tk,'Paid',-cost,'Paid')}
else{const back=res-cost;if(back>0){S.bank+=back;addAct('trend','Order refund · '+tk,'Received',back,'Received')}}
const h=S.hold[tk]||{q:0,avg:p};h.avg=Math.round((h.avg*h.q+cost)/(h.q+q));h.q+=q;S.hold[tk]=h;I.hist.unshift({k:'buy',tk,q,p,a:cost,ts:Date.now()});return true}
function doSell(tk,q,p){const h=S.hold[tk];if(!h||h.q<q)return false;const v=q*p,f=fee(v),net=v-f;S.bank+=net;I.real+=net-h.avg*q;h.q-=q;if(h.q<=0)delete S.hold[tk];I.hist.unshift({k:'sell',tk,q,p,a:net,ts:Date.now()});addAct('trend','Sold '+q+' '+tk,'Received',net,'Received');return true}
window.invGo=()=>{const T=I.tr,c=calc();if(!c.ok){drawTrade();return}const p=px(T.tk),buy=T.side==='buy',lim=T.type==='limit',wait=lim&&!(buy?T.lim>=p:T.lim<=p);
if(wait){let res=0;if(buy){res=c.tot;S.bank-=res;addAct('trend','Order reserve · '+T.tk,'Paid',-res,'Paid')}I.orders.push({id:I.oid++,tk:T.tk,side:T.side,q:T.q,lim:T.lim,res,ts:Date.now()});closeSheet();rr();
resSheet(L('Order placed','Itegeko ryashyizwe','Ordre passé'),(buy?L('We buy ','Tuzagura ','Nous achetons '):L('We sell ','Tuzagurisha ','Nous vendons '))+T.q+' × '+T.tk+L(' when the price reaches ',' igiciro nigera kuri ',' quand le cours atteint ')+fmt(T.lim)+' RWF.',[[L('Limit price','Igiciro cyihariye','Prix limite'),fmt(T.lim)+' RWF'],[buy?L('Reserved','Byabitswe','Réservé'):L('Shares reserved','Imigabane yabitswe','Actions réservées'),buy?fm(res)+' RWF':T.q]]);return}
const ok=buy?doBuy(T.tk,T.q,p):doSell(T.tk,T.q,p);closeSheet();if(!ok){toast(L('Order failed','Itegeko ntirakozwe','Échec de l’ordre'));return}
rr();resSheet(buy?L('Bought ','Waguze ','Achat de ')+T.q+' × '+T.tk:L('Sold ','Wagurishije ','Vente de ')+T.q+' × '+T.tk,wait===false&&lim?L('Your limit was already met, so it filled at the market price.','Igiciro cyawe cyari cyageze, bityo byakozwe ku giciro cy’isoko.','Votre limite était atteinte, exécuté au cours du marché.'):'',[[L('Price','Igiciro','Prix'),fmt(p)+' RWF'],[L('Fee','Amafaranga y’inyongera','Frais'),fm(c.f)+' RWF'],[buy?L('Paid','Wishyuye','Payé'):L('Received','Wakiriye','Reçu'),fm(c.tot)+' RWF']]);if(buy)setTimeout(confetti,200)};
window.invCancel=id=>{const i=I.orders.findIndex(o=>o.id===id);if(i<0)return;const o=I.orders[i];I.orders.splice(i,1);if(o.res){S.bank+=o.res;addAct('trend','Order cancelled · '+o.tk,'Received',o.res,'Received')}I.hist.unshift({k:'cancel',tk:o.tk,ts:Date.now()});rr();toast(L('Order cancelled','Itegeko ryahagaritswe','Ordre annulé'))};
window.invDiv=tk=>{const h=S.hold[tk];if(!h||I.dpaid[tk])return;const a=Math.round(h.q*X[tk].dv/2);I.dpaid[tk]=true;S.bank+=a;I.div+=a;I.hist.unshift({k:'div',tk,a,ts:Date.now()});addAct('trend','Dividend · '+tk,'Received',a,'Received');rr();toast('+'+fmt(a)+' RWF '+L('dividend','inyungu','dividende'))};

/* ---------- Treasury bills and bonds ---------- */
window.invBondBuy=id=>{I.bd={id,a:100000};drawBond()};
window.invBA=n=>{I.bd.a=n;drawBond()};
function drawBond(){const B=BONDS.find(b=>b[0]===I.bd.id),a=I.bd.a,int=bInt(a,B[2],B[3]),bad=a>S.bank;
lay(`<div style="margin-bottom:10px">${gl('bank',60)}</div><div class="h1" style="font-size:22px;line-height:30px">${B[1]}</div><div class="mu" style="font-size:14px;margin:6px 0 0">${B[2].toFixed(1)}% ${L('a year · ','ku mwaka · ',' par an · ')}${term(B[3])}</div><div class="req" style="margin-top:14px">${[50000,100000,250000,500000,1000000].map(x=>`<button class="${a===x?'on':''}" onclick="invBA(${x})">${fmt(x)}</button>`).join('')}</div><div style="margin:16px 0 0;padding:2px 16px;border-radius:18px;background:var(--chip)">${kvs([[L('You invest','Ushora','Vous investissez'),fm(a)+' RWF'],[L('Matures on','Birangira ku wa','Échéance le'),dstr(Date.now()+B[3]*864e5)],[L('Interest at maturity','Inyungu zizatangwa','Intérêts à l’échéance'),'<span style="color:var(--ok)">+'+fm(int)+' RWF</span>'],[L('You get back','Uzasubizwa','Vous récupérez'),fm(a+int)+' RWF']])}</div><div class="sm ${bad?'':'mu'}" style="margin-top:12px;${bad?'color:var(--er)':''}">${bad?L('Not enough balance — you have RWF ','Amafaranga ntahagije — ufite RWF ','Solde insuffisant — vous avez RWF ')+fmt(S.bank):L('From itunda Bank · ','Biva kuri itunda Bank · ','Depuis itunda Bank · ')+fm(S.bank)+' RWF'}</div><div class="fine" style="margin-top:8px">${L('Locked until maturity. Taxes are not modeled in this prototype.','Bifunze kugeza birangiye. Imisoro ntibarwa muri iyi prototype.','Bloqué jusqu’à l’échéance. Les taxes ne sont pas modélisées dans ce prototype.')}</div><button class="btn" style="margin-top:16px" ${bad?'disabled':''} onclick="invBondDo()">${L('Invest ','Shora ','Investir ')}${fm(a)} RWF</button>`)}
window.invBondDo=()=>{const B=BONDS.find(b=>b[0]===I.bd.id),a=I.bd.a;if(a>S.bank)return;S.bank-=a;I.bonds.unshift({id:'b'+Date.now(),pid:B[0],n:B[1],a,r:B[2],d:B[3],ts:Date.now(),mt:Date.now()+B[3]*864e5,ff:false});I.hist.unshift({k:'bond',n:B[1],a,ts:Date.now()});addAct('trend',B[1],'Paid',-a,'Paid');closeSheet();I.tab='port';rr();resSheet(L('Invested ','Washoye ','Investi ')+fm(a)+' RWF',B[1],[[L('Rate','Igipimo','Taux'),B[2].toFixed(1)+'%'],[L('Matures on','Birangira ku wa','Échéance le'),dstr(Date.now()+B[3]*864e5)],[L('Interest at maturity','Inyungu zizatangwa','Intérêts à l’échéance'),'+'+fm(bInt(a,B[2],B[3]))+' RWF']])};
window.invBond=i=>{const b=I.bonds[i];if(!b)return;const int=bInt(b.a,b.r,b.d),ready=b.ff||Date.now()>=b.mt;
lay(`<div style="margin-bottom:10px">${gl('bank',60)}</div><div class="h1" style="font-size:22px;line-height:30px">${b.n}</div><div style="margin:14px 0 0;padding:2px 16px;border-radius:18px;background:var(--chip)">${kvs([[L('Invested','Washoye','Investi'),fm(b.a)+' RWF'],[L('Rate','Igipimo','Taux'),b.r.toFixed(1)+'%'],[L('Matures on','Birangira ku wa','Échéance le'),ready?L('Now','Ubu','Maintenant'):dstr(b.mt)],[L('Interest','Inyungu','Intérêts'),'<span style="color:var(--ok)">+'+fm(int)+' RWF</span>']])}</div><button class="btn" style="margin-top:16px" ${ready?'':'disabled'} onclick="invBondCollect('${b.id}')">${ready?L('Collect ','Akira ','Encaisser ')+fm(b.a+int)+' RWF':L('Locked until maturity','Bifunze kugeza birangiye','Bloqué jusqu’à l’échéance')}</button>${ready?'':`<button class="btn sec2" style="margin-top:10px" onclick="invBondFF('${b.id}')">${L('Fast-forward to maturity (demo)','Simbukira ku ndunduro (demo)','Avancer jusqu’à l’échéance (démo)')}</button>`}`)};
window.invBondFF=id=>{const i=I.bonds.findIndex(b=>b.id===id);if(i<0)return;I.bonds[i].ff=true;rr();invBond(i)};
window.invBondCollect=id=>{const i=I.bonds.findIndex(b=>b.id===id);if(i<0)return;const b=I.bonds[i],tot=b.a+bInt(b.a,b.r,b.d);I.bonds.splice(i,1);S.bank+=tot;I.hist.unshift({k:'bondpay',n:b.n,a:tot,ts:Date.now()});addAct('trend','Matured · '+b.n,'Received',tot,'Received');closeSheet();rr();toast('+'+fm(tot)+' RWF');setTimeout(confetti,200)};

/* ---------- IPO ---------- */
window.invIpo=id=>{const o=IPOS.find(x=>x.id===id);I.ip={n:o.min};drawIpo(o)};
window.invIN=n=>{I.ip.n=n;drawIpo(IPOS[0])};
function drawIpo(o){const n=I.ip.n,amt=n*o.price,bad=amt>S.bank;
lay(`<div style="margin-bottom:10px">${gl('chart',60)}</div><div class="h1" style="font-size:22px;line-height:30px">${o.n} · IPO</div><div class="mu" style="font-size:14px;margin:6px 0 0">${fmt(o.price)} RWF ${L('per share','ku mugabane','par action')}</div><div class="req" style="margin-top:14px">${[1,2,5,10].map(m=>`<button class="${n===o.min*m?'on':''}" onclick="invIN(${o.min*m})">${o.min*m}</button>`).join('')}</div><div style="margin:16px 0 0;padding:2px 16px;border-radius:18px;background:var(--chip)">${kvs([[L('Shares','Imigabane','Actions'),n],[L('Amount reserved','Amafaranga abitswe','Montant réservé'),fm(amt)+' RWF'],[L('Subscription closes','Gusaba birangira','Clôture'),o.close],[L('Listing date','Itariki yo gutangira','Date de cotation'),o.list]])}</div><div class="sm ${bad?'':'mu'}" style="margin-top:12px;${bad?'color:var(--er)':''}">${bad?L('Not enough balance — you have RWF ','Amafaranga ntahagije — ufite RWF ','Solde insuffisant — vous avez RWF ')+fmt(S.bank):L('From itunda Bank · ','Biva kuri itunda Bank · ','Depuis itunda Bank · ')+fm(S.bank)+' RWF'}</div><div class="fine" style="margin-top:8px">${L('Demand can exceed supply, so you may receive fewer shares. Unused money is refunded at listing.','Abasaba bashobora kurenga ibihari, bityo ushobora guhabwa imigabane mike. Amafaranga adakoreshejwe asubizwa.','La demande peut dépasser l’offre, vous pouvez recevoir moins d’actions. L’argent non utilisé est remboursé à la cotation.')}</div><button class="btn" style="margin-top:16px" ${bad?'disabled':''} onclick="invIpoDo()">${L('Apply · ','Saba · ','Souscrire · ')}${fm(amt)} RWF</button>`)}
window.invIpoDo=()=>{const o=IPOS[0],n=I.ip.n,amt=n*o.price;if(amt>S.bank||I.ipo)return;S.bank-=amt;I.ipo={id:o.id,tk:o.tk,shares:n,amt,price:o.price,status:'Applied',ts:Date.now()};I.hist.unshift({k:'ipo',tk:o.tk,a:amt,ts:Date.now()});addAct('trend','IPO application · '+o.tk,'Paid',-amt,'Paid');closeSheet();rr();toast(L('Application sent','Gusaba byoherejwe','Demande envoyée'))};
window.invIpoCancel=()=>{const A=I.ipo;if(!A||A.status!=='Applied')return;S.bank+=A.amt;addAct('trend','IPO application cancelled · '+A.tk,'Received',A.amt,'Received');I.hist.unshift({k:'ipocancel',tk:A.tk,a:A.amt,ts:Date.now()});I.ipo=null;rr();toast(L('Application cancelled','Gusaba byahagaritswe','Demande annulée'))};
window.invIpoList=()=>{const A=I.ipo,o=IPOS[0];if(!A||A.status!=='Applied')return;const got=Math.max(1,Math.floor(A.shares*.8)),refund=(A.shares-got)*A.price;
if(!stk(o.tk)){STK.push([o.tk,o.n,o.list0,Math.round((o.list0/o.price-1)*1000)/10]);I.open[o.tk]=o.price}
S.hold[o.tk]={q:got,avg:A.price};if(refund>0){S.bank+=refund;addAct('trend','IPO refund · '+o.tk,'Received',refund,'Received')}
A.status='Listed';A.got=got;A.refund=refund;I.hist.unshift({k:'iposhare',tk:o.tk,q:got,a:refund,ts:Date.now()});rr();toast(L('Listed: you received ','Byatangiye: wabonye ','Cotée : vous avez reçu ')+got+' '+o.tk);setTimeout(confetti,200)};

/* ---------- live prices ---------- */
function check(){const done=[];I.orders.slice().forEach(o=>{const p=px(o.tk);
if(o.side==='buy'&&p<=o.lim){I.orders=I.orders.filter(x=>x!==o);doBuy(o.tk,o.q,p,o.res);done.push([o,p])}
else if(o.side==='sell'&&p>=o.lim&&S.hold[o.tk]&&S.hold[o.tk].q>=o.q){I.orders=I.orders.filter(x=>x!==o);doSell(o.tk,o.q,p);done.push([o,p])}});
if(done.length){const [o,p]=done[0];toast(L('Order filled: ','Itegeko ryakozwe: ','Ordre exécuté : ')+(o.side==='buy'?L('bought ','waguze ','achat '):L('sold ','wagurishije ','vente '))+o.q+' '+o.tk+L(' at ',' kuri ',' à ')+fmt(p))}}
function tick(){STK.forEach(s=>{const o=I.open[s[0]]||s[2],r=(Math.random()-.5)*2;let d=Math.round((r+(o-s[2])/o*6)*s[2]*.008);if(!d&&Math.random()<.5)d=r>0?1:-1;const np=Math.min(Math.round(o*1.1),Math.max(Math.round(o*.9),s[2]+d));s[2]=np;s[3]=Math.round((np/o-1)*1000)/10});
check();const top=S.stack[S.stack.length-1];if(S.auth&&(top==='invest'||top==='stock')&&!document.querySelector('#layer .sheet')){const ae=document.activeElement;if(ae&&/INPUT|TEXTAREA/.test(ae.tagName))return;if(I.scrub)return;rr()}}
if(!window.__invT)window.__invT=setInterval(()=>{if(!document.hidden)tick()},5000);
})();
</script>
<script>
/* v773: new itunda certificate card. A ticket-style pass with notches and a dashed perforation, a woven rosette pattern (like a banknote security print), a foil stripe, a verified seal, the name large, and a stub with the certificate number and a bar mark. Mixes Toss (dark art, big name), Kakao (one clear verified check) and KakaoBank (clean card with a stamp-like seal). */
/* v772: the certificate card now follows the Toss look: dark lens artwork with a glass mark, emblem and one-line caption on top, large white name and date at the bottom; the verify page is dark like Toss. */
/* v771: Digital certificate. Signing now starts with a "Verify your identity with your itunda certificate" page (Toss pattern): the document you are signing, your certificate card with your name and expiry, one Next button, and "Authenticate with a different method" (text message code). Back from the PIN returns here. The certificate card on the screen shows your name first. An expired certificate says so and asks you to renew before signing. */
/* v82: Digital certificate is now a full flow: create signing PIN, issue, sign documents, renew, revoke */
(function(){
const T=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e;
const esc=s=>String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;');
const dt=d=>new Date(d).toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric'});
const hex=n=>Array.from({length:n},()=>'0123456789ABCDEF'[Math.floor(Math.random()*16)]).join('');
const sh=h=>{$('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet">'+h+'</div>'};
const hd=t=>`<div class="mh" style="padding-bottom:0"><button class="ib" aria-label="${T('Back','Subira inyuma','Retour')}" onclick="back()">${ic('back',24)}</button><b style="flex:1;font-size:19px;margin-left:6px">${esc(t)}</b></div>`;
S.cz=S.cz||{st:'none',pin:'',serial:'',from:0,to:0,signed:[],pend:[0,1,2],lock:0};
S.czf=S.czf||{};
document.head.appendChild(Object.assign(document.createElement('style'),{textContent:'.czk:active{background:var(--tint)!important;transform:scale(.94)}@media (prefers-reduced-motion:no-preference){.czk{transition:transform .08s,background .08s}.czsh{animation:czsh .35s}@keyframes czsh{20%,60%{transform:translateX(-8px)}40%,80%{transform:translateX(8px)}}.czfl{animation:czfl 1.4s}@keyframes czfl{0%,60%{background:var(--tint)}}}'}));
document.addEventListener('keydown',e=>{if(!S.czf||!S.czf.step||!document.querySelector('#layer .sheet [data-czpin]'))return;if(/^\d$/.test(e.key))czKey(e.key);else if(e.key==='Backspace')czKey('b')});
const DOCS=()=>[
[T('Loan agreement','Amasezerano y’inguzanyo','Contrat de prêt'),T('From Get a loan','Aturuka kuri Gufata inguzanyo','Depuis Obtenir un prêt')],
[T('Cooperative membership form','Urupapuro rwo kwinjira muri koperative','Formulaire d’adhésion à la coopérative'),T('From Harvest advance','Rituruka kuri Avansi y’isarura','Depuis Avance de récolte')],
[T('Ikimina savings rules','Amategeko y’ikimina','Règles d’épargne de l’ikimina'),T('From Ikimina','Rituruka kuri Ikimina','Depuis Ikimina')]];
const grad='#5B54D6';
const row=(a,b)=>`<div style="display:flex;justify-content:space-between;gap:16px;padding:14px 24px;border-top:0;font-size:15px"><span class="mu">${a}</span><b style="text-align:right">${esc(b)}</b></div>`;
const lab=t=>`<div style="padding:28px 24px 8px;font-size:19px;line-height:26px;font-weight:700;color:var(--tx)">${esc(t)}</div>`;
const smallBtn=(t,fn)=>`<button style="flex:0 0 auto;min-height:44px;padding:0 18px;border-radius:22px;border:0;background:var(--lk);color:var(--on);font:inherit;font-size:15px;font-weight:700" onclick="${fn}">${esc(t)}</button>`;

/* ---------- screen ---------- */
function card(){const c=S.cz,rev=c.st==='revoked',ex=!rev&&c.to&&c.to<Date.now(),nm=(S.name||'Amina Uwase').toUpperCase();
const pill=`<span style="margin-left:auto;flex:0 0 auto;padding:4px 10px;border-radius:12px;background:rgba(255,255,255,.4);font-size:13px;line-height:18px;font-weight:700">${rev?T('Revoked','Yahagaritswe','Révoqué'):ex?T('Expired','Cyarangiye','Expiré'):T('Active','Kirakora','Actif')}</span>`;
return `<div style="display:flex;flex-direction:column;align-items:center;margin:18px 24px 0;${rev||ex?'filter:grayscale(1) brightness(.85)':''}">${vcard(nm,pill)}</div>`}

function signedList(){const c=S.cz;
if(!c.signed.length)return `<div class="mu" style="padding:6px 24px 0;font-size:15px;line-height:22px">${T('Nothing signed yet. Documents you sign are stored here.','Nta cyasinywe. Inyandiko usinye zibikwa hano.','Rien de signé pour l’instant. Les documents signés sont conservés ici.')}</div>`;
return c.signed.map((s,i)=>`<div class="tap${s.ref===c.flash?' czfl':''}" role="button" tabindex="0" style="display:flex;align-items:center;gap:12px;padding:14px 24px;border-top:0;cursor:pointer" onclick="czView(${i})"><div aria-hidden="true" style="width:40px;height:40px;flex:none;border-radius:20px;background:var(--chip);display:flex;align-items:center;justify-content:center"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--lk)" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></div><div style="flex:1;min-width:0"><b style="font-size:15px">${esc(s.n)}</b><div class="sm mu">${dt(s.ts)} · ${esc(s.ref)}</div></div></div>`).join('')}

function czScreen(){const c=S.cz,act=c.st==='active',rev=c.st==='revoked',title=T('Digital certificate','Icyemezo cy’ikoranabuhanga','Certificat numérique');
if(c.st==='none'){
return `${hd('')}<div style="padding:12px 24px 0"><div class="h1">${title}</div><div class="mu" style="font-size:15px;line-height:22px;margin-top:8px">${T('Sign agreements in itunda. A signed copy is stored in your documents.','Sinyira amasezerano muri itunda. Kopi yasinywe ibikwa mu nyandiko zawe.','Signez des accords dans itunda. Une copie signée est conservée dans vos documents.')}</div></div>
<div class="mu" style="padding:20px 24px 0;font-size:15px;line-height:22px">${T('Set a 4-digit PIN and you are ready in seconds.','Shyiraho PIN y’imibare 4, uhite witegura mu masegonda.','Choisissez un PIN à 4 chiffres et c’est prêt en quelques secondes.')}</div>
<div style="margin-top:10px">${row(T('Valid for','Kamara','Valable'),T('12 months','Amezi 12','12 mois'))}${row(T('Accepted by','Cyemerwa na','Accepté par'),T('Banks, SACCOs, employers','Amabanki, SACCO, abakoresha','Banques, SACCO, employeurs'))}${row(T('Cost','Igiciro','Coût'),T('Free','Ku buntu','Gratuit'))}</div><div style="height:100px"></div>
<div class="cta"><button class="btn" onclick="svcGo()">${T('Get my certificate','Fata icyemezo cyanjye','Obtenir mon certificat')}</button></div>`}
let body=card();
if(act){const p=c.pend;
body+=lab(T('Waiting for your signature','Bitegereje umukono wawe','En attente de votre signature'))+(p.length?p.map(i=>`<div style="display:flex;align-items:center;gap:12px;padding:12px 24px;border-top:0"><div style="flex:1;min-width:0"><b style="font-size:15px">${esc(DOCS()[i][0])}</b><div class="sm mu">${esc(DOCS()[i][1])}</div></div>${smallBtn(T('Sign','Sinya','Signer'),`czSign(${i})`)}</div>`).join(''):`<div class="mu" style="padding:0 24px;font-size:15px">${T('You are all caught up.','Byose byarangiye.','Vous êtes à jour.')}</div>`);
}
body+=lab(T('Signed documents','Inyandiko zasinywe','Documents signés'))+signedList();
if(act)body+=lab(T('Manage','Gucunga','Gérer'))+`<div class="tap" role="button" tabindex="0" style="display:flex;justify-content:space-between;align-items:center;padding:16px 24px;border-top:0;font-size:15px;cursor:pointer;min-height:56px" onclick="czRenewAsk()"><b>${T('Renew for 12 months','Vugurura amezi 12','Renouveler pour 12 mois')}</b><span class="mu">${T('Free','Ku buntu','Gratuit')}</span></div><div class="tap" role="button" tabindex="0" style="display:flex;align-items:center;padding:16px 24px;border-top:0;font-size:15px;color:var(--er);cursor:pointer;min-height:56px" onclick="czRevokeAsk()"><b>${T('Revoke certificate','Hagarika icyemezo','Révoquer le certificat')}</b></div>`;
if(rev)body+=`<div class="mu" style="padding:18px 24px 0;font-size:15px;line-height:22px">${T('This certificate can no longer sign. Documents you signed with it stay valid.','Iki cyemezo ntikigishobora gusinya. Inyandiko wasinyishije cyo zirakora.','Ce certificat ne peut plus signer. Les documents déjà signés restent valides.')}</div><div style="height:100px"></div><div class="cta"><button class="btn" onclick="svcGo()">${T('Get a new certificate','Fata icyemezo gishya','Obtenir un nouveau certificat')}</button></div>`;
else body+=`<div style="height:40px"></div>`;
return `${hd(title)}${body}`}

const os=screens.svc;screens.svc=()=>S.svk==='cert'?czScreen():os();
const og=window.svcGo;window.svcGo=()=>{if(S.svk==='cert')return czStart();og()};

/* ---------- PIN sheet ---------- */
document.head.appendChild(Object.assign(document.createElement('style'),{textContent:'.czd{width:16px;height:16px;border-radius:8px;background:var(--ln)}.czd.on{background:var(--lk)}.czd.ok{background:var(--ok)}.czd.bad{background:var(--er)}.czk{touch-action:manipulation;-webkit-user-select:none;user-select:none}@media (prefers-reduced-motion:no-preference){.czd{transition:background .12s}.czd.on{animation:czpop .18s}@keyframes czpop{50%{transform:scale(1.35)}}.czfd{animation:czfd .22s}.czin>*{animation:czfd .22s}@keyframes czfd{from{opacity:0;transform:translateY(4px)}}}'}));
const PH=async p=>{try{const b=await crypto.subtle.digest('SHA-256',new TextEncoder().encode('itunda-sign:'+p));return Array.from(new Uint8Array(b),x=>x.toString(16).padStart(2,'0')).join('')}catch(e){return 'p:'+p}};
const weak=p=>/^(\d)\1{3}$/.test(p)||'0123456789'.includes(p)||'9876543210'.includes(p);
const buzz=p=>{try{navigator.vibrate&&navigator.vibrate(p)}catch(e){}};
const cnt=F=>'';
const wait=ms=>new Promise(r=>setTimeout(r,ms));
const shk=h=>{const x=document.querySelector('#layer .sheet');if(!x)return sh(h);x.innerHTML=h;x.classList.remove('czin');void x.offsetWidth;x.classList.add('czin')};
const PT=()=>{const F=S.czf,st=F.step;return{lb:'',go:st==='pin1'?T('Continue','Komeza','Continuer'):st==='pin2'?T('Confirm','Emeza','Confirmer'):T('Sign','Sinya','Signer'),ti:st==='pin1'?T('Create a signing PIN','Kora PIN yo gusinya','Créez un code PIN de signature'):st==='pin2'?T('Confirm your PIN','Emeza PIN yawe','Confirmez votre PIN'):st==='sms'?T('Enter the code we sent you','Andika kode twaguhaye','Saisissez le code reçu'):T('Enter your PIN to sign','Andika PIN yawe usinye','Saisissez votre PIN pour signer'),su:st==='sign'?(S.lang==='en'?'You are signing: '+DOCS()[F.doc][0]+'. Enter your 4-digit PIN.':DOCS()[F.doc][0]):st==='sms'?T('Sent by SMS to your phone. Demo code: 4821.','Yoherejwe kuri telefone yawe. Kode y’igerageza: 4821.','Envoyé par SMS sur votre téléphone. Code de démo : 4821.'):T('4 digits. You will use it every time you sign.','Imibare 4. Uzayikoresha buri uko usinye.','4 chiffres. Vous l’utiliserez à chaque signature.')}};
function pinDraw(){const F=S.czf;if(document.querySelector('#layer .sheet [data-czpin]'))return pinUpd();
const t=PT(),dots=[0,1,2,3].map(i=>`<span class="czd${i<F.buf.length?' on':''}"></span>`).join('');
const AR='<svg data-t26="1" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 12H4.5M10.5 5.5L4 12l6.5 6.5"/></svg>';
const keys=['1','2','3','4','5','6','7','8','9','','0','b'].map(k=>k===''?'<span></span>':`<button class="czk" aria-label="${k==='b'?T('Delete','Siba','Effacer'):k}" onclick="czKey('${k}')">${k==='b'?AR:k}</button>`).join('');
sh(`<div class="bar"><button class="ib" aria-label="${T('Back','Subira inyuma','Retour')}" onclick="${F.step==='sign'||F.step==='sms'?'czVerify('+F.doc+')':'closeSheet()'}">${ic('back',24)}</button></div><div style="padding:12px 24px 0">${t.lb?`<div id="czlb" class="sm mu" style="font-weight:700;margin-bottom:4px">${t.lb}</div>`:''}<div id="czti" style="font-size:26px;line-height:34px;font-weight:800;letter-spacing:-.5px">${esc(t.ti)}</div><div id="czsu" class="mu" style="font-size:16px;line-height:24px;margin-top:8px">${esc(t.su)}</div><div data-czpin="1" role="status" aria-label="${F.buf.length}/4" style="display:flex;gap:14px;margin:40px 0 0;min-height:30px;align-items:center">${dots}</div><div id="czer" role="alert" class="mu" style="min-height:20px;margin-top:12px;font-size:14px;line-height:20px;font-weight:500;color:${F.err?'var(--er)':'var(--mu)'}">${esc(F.err||cnt(F))}</div></div><button class="btn" id="czgo" disabled onclick="czGo()">${esc(t.go)}</button><div class="keys tkpsh">${keys}</div>`);F.shown=F.step}
function pinUpd(){const F=S.czf,t=PT(),ti=document.getElementById('czti'),su=document.getElementById('czsu'),dd=document.querySelector('#layer [data-czpin]');
if(F.shown!==F.step){F.shown=F.step;[ti,su].forEach(e=>{e.classList.remove('czfd');void e.offsetWidth;e.classList.add('czfd')})}
ti.textContent=t.ti;su.textContent=t.su;const lb=document.getElementById('czlb');if(lb)lb.textContent=t.lb;document.querySelectorAll('#layer .czd').forEach((d,i)=>{d.className='czd'+(i<F.buf.length?' on':'')});
dd.setAttribute('aria-label',F.buf.length+'/4');const er=document.getElementById('czer');er.textContent=F.err||cnt(F);er.style.color=F.err?'var(--er)':'var(--mu)';const go=document.getElementById('czgo');if(go){go.textContent=t.go;go.disabled=F.buf.length<4}}
async function okFlash(){document.querySelectorAll('#layer .czd').forEach(d=>d.classList.add('ok'));buzz(15);await wait(260)}
async function badFlash(){document.querySelectorAll('#layer .czd').forEach(d=>d.classList.add('bad'));const d=document.querySelector('#layer [data-czpin]');if(d){d.classList.remove('czsh');void d.offsetWidth;d.classList.add('czsh')}buzz([40,60,40]);await wait(420)}
window.czKey=k=>{const F=S.czf;if(F.busy)return;if(k==='b'){if(!F.buf)return;F.buf=F.buf.slice(0,-1)}else if(F.buf.length<4)F.buf+=k;else return;buzz(8);F.err='';pinDraw();
};
window.czGo=()=>{const F=S.czf;if(F.busy||F.buf.length<4)return;F.busy=1;czPin().catch(()=>{}).then(()=>{F.busy=0})};
async function czPin(){const F=S.czf,c=S.cz;
if(F.step==='pin1'){if(weak(F.buf)){await badFlash();F.buf='';F.err=T('That PIN is too easy to guess. Choose another.','Iyi PIN yoroshye kuyiketsa. Hitamo indi.','Ce PIN est trop facile à deviner. Choisissez-en un autre.');return pinDraw()}
F.first=F.buf;F.buf='';F.step='pin2';return pinDraw()}
if(F.step==='pin2'){if(F.buf===F.first){c.pin=await PH(F.buf);await okFlash();return czIssue()}await badFlash();F.buf='';F.first='';F.step='pin1';F.err=T('PINs did not match. Start again.','PIN ntizihuye. Ongera utangire.','Les PIN ne correspondent pas. Recommencez.');return pinDraw()}
if(F.step==='sms'){if(F.buf==='4821'){F.fails=0;await okFlash();return czSigned(F.doc)}F.fails=(F.fails||0)+1;await badFlash();F.buf='';if(F.fails>=3){c.lock=Date.now()+30000;closeSheet();return toast(T('Too many wrong tries. Try again in 30 seconds.','Wagerageje kenshi nabi. Ongera mu masegonda 30.','Trop d’essais incorrects. Réessayez dans 30 secondes.'))}F.err=T('Wrong code. ','Kode siyo. ','Code incorrect. ')+(3-F.fails)+T(' tries left.',' ugerageza hasigaye.',' essais restants.');return pinDraw()}
const h=await PH(F.buf);
if(h===c.pin){F.fails=0;await okFlash();return czSigned(F.doc)}
F.fails=(F.fails||0)+1;await badFlash();F.buf='';
if(F.fails>=3){c.lock=Date.now()+30000;closeSheet();return toast(T('Too many wrong tries. Try again in 30 seconds.','Wagerageje kenshi nabi. Ongera mu masegonda 30.','Trop d’essais incorrects. Réessayez dans 30 secondes.'))}
F.err=T('Wrong PIN. ','PIN siyo. ','PIN incorrect. ')+(3-F.fails)+T(' tries left.',' ugerageza hasigaye.',' essais restants.');pinDraw()}

/* ---------- issue ---------- */
function czStart(){S.czf={step:'pin1',buf:'',first:'',err:'',fails:0};pinDraw()}
function czIssue(){const c=S.cz,now=Date.now(),e=new Date(now);e.setFullYear(e.getFullYear()+1);
c.st='active';c.serial='ITN-CERT-'+hex(6);c.from=now;c.to=e.getTime();c.pend=c.signed.length?c.pend:[0,1,2];
shk(`<div class="g3" style="font-size:56px;line-height:1;margin-bottom:10px">✅</div><div class="h1">${T('Certificate issued','Icyemezo cyatanzwe','Certificat émis')}</div><div class="mu">${T('You can now sign agreements from any itunda screen. Valid until ','Ubu ushobora gusinya amasezerano kuri ecran iyo ari yo yose ya itunda. Kirakora kugeza ','Vous pouvez maintenant signer des accords depuis n’importe quel écran itunda. Valable jusqu’au ')}${dt(c.to)}.</div><span class="v948x" hidden></span><button class="btn" onclick="closeSheet()">OK</button>`);
render('fade-none')}

/* ---------- sign ---------- */
window.czSign=i=>{const c=S.cz;if(c.lock>Date.now())return toast(T('Signing is paused for a moment. Try again shortly.','Gusinya byahagaritswe akanya gato. Ongera nyuma.','La signature est suspendue un instant. Réessayez bientôt.'));
if(c.to&&c.to<Date.now())return toast(T('Your certificate has expired. Renew it to sign.','Icyemezo cyawe cyarangiye. Cyivugurure kugira ngo usinye.','Votre certificat a expiré. Renouvelez-le pour signer.'));
czVerify(i)};
window.czNext=i=>{S.czf={step:'sign',buf:'',err:'',fails:0,doc:i};pinDraw()};
window.czSms=i=>{S.czf={step:'sms',buf:'',err:'',fails:0,doc:i};pinDraw()};
document.head.appendChild(Object.assign(document.createElement('style'),{textContent:'#phone#phone .sheet:has([data-czv]),#phone#phone .sheet.v6pg:has([data-czv]){--bg:#17171C;--mo-pgbg:#17171C;--tx:#fff;--mu:#A0A7B4;--ln:#3A3A44;--tint:#2A2850;--tintfg:#B3AEFF;background:#17171C!important;color:#fff!important;-webkit-backdrop-filter:none!important;backdrop-filter:none!important;border:0!important}#phone .sheet:has([data-czv])::before{display:none}#phone .sheet:has([data-czv]){top:0!important;left:0!important;right:0!important;bottom:0!important;height:auto!important;max-height:none!important;border-radius:0!important;padding:0!important;display:flex!important;flex-direction:column}#phone .sheet:has([data-czv]) .v6b{padding:0!important;margin:0!important;flex:1;min-height:0;display:flex!important;flex-direction:column;overflow:auto}#phone #layer:not(.v396out) .sheet:has([data-czv]),#phone .sheet:has([data-czv]) *{animation:none!important;transition:none!important}'}));
const vbar=js=>`<div class="bar"><button class="ib" aria-label="${T('Back','Subira inyuma','Retour')}" onclick="${js}">${ic('back',24)}</button></div>`;
const vh=t=>`<div style="padding:12px 24px 0"><div style="font-size:26px;line-height:34px;font-weight:700">${t}</div>`;
function czArt(u){return `<svg aria-hidden="true" viewBox="0 0 200 250" preserveAspectRatio="xMidYMid slice" style="position:absolute;inset:0;width:100%;height:100%"><defs>
<radialGradient id="${u}bg" cx="50%" cy="46%" r="75%"><stop offset="0" stop-color="#3A35A8"/><stop offset=".45" stop-color="#171552"/><stop offset="1" stop-color="#101013"/></radialGradient>
<linearGradient id="${u}rim" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#B9B4FF" stop-opacity=".95"/><stop offset=".35" stop-color="#6A63F0" stop-opacity=".15"/><stop offset=".7" stop-color="#6A63F0" stop-opacity=".12"/><stop offset="1" stop-color="#B9B4FF" stop-opacity=".9"/></linearGradient>
<radialGradient id="${u}well" cx="50%" cy="50%" r="50%"><stop offset="0" stop-color="#101013"/><stop offset=".7" stop-color="#0B0A2E"/><stop offset="1" stop-color="#2A2790"/></radialGradient>
<linearGradient id="${u}g1" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#CFE0FF"/><stop offset=".35" stop-color="#6E8CFF"/><stop offset=".7" stop-color="#3B2FC9"/><stop offset="1" stop-color="#1B1473"/></linearGradient>
<linearGradient id="${u}g2" x1="1" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#E3D9FF"/><stop offset=".4" stop-color="#8F89FF"/><stop offset="1" stop-color="#2A1D94"/></linearGradient>
<linearGradient id="${u}bl" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#fff"/><stop offset=".5" stop-color="#B6B0FF"/><stop offset="1" stop-color="#5B54D6"/></linearGradient>
<radialGradient id="${u}sh" cx="50%" cy="50%" r="50%"><stop offset="0" stop-color="#8F89FF" stop-opacity=".55"/><stop offset="1" stop-color="#8F89FF" stop-opacity="0"/></radialGradient>
<filter id="${u}bz" x="-20%" y="-20%" width="140%" height="140%"><feGaussianBlur stdDeviation="2.2"/></filter></defs>
<rect width="200" height="250" fill="url(#${u}bg)"/><g transform="translate(100 108) scale(.74) translate(-100 -118)">
<circle cx="100" cy="118" r="112" fill="none" stroke="url(#${u}rim)" stroke-width="5" opacity=".7" filter="url(#${u}bz)"/>
<circle cx="100" cy="118" r="100" fill="none" stroke="url(#${u}rim)" stroke-width="1.4"/>
<circle cx="100" cy="118" r="82" fill="#04041A" stroke="url(#${u}rim)" stroke-width="2.4"/>
<circle cx="100" cy="118" r="74" fill="url(#${u}well)" stroke="#8F89FF" stroke-opacity=".55" stroke-width="1"/>
<ellipse cx="100" cy="168" rx="44" ry="9" fill="url(#${u}sh)"/>
<circle cx="100" cy="118" r="66" fill="url(#${u}sh)"/>
${knot(124,'#8F89FF').replace('<svg ','<svg x="38" y="56" filter="url(#'+u+'bz)" opacity=".9" ')}
${knot(112,'#E6E3FF').replace('<svg ','<svg x="44" y="62" ')}
</g>
</svg>`}
function czEmb(){return knot(30,'#4A43D9').replace('<svg ','<svg style="flex:0 0 auto" ')}
/* v774: glassy, bright certificate card. Aurora colour field, a frosted glass orb with the itunda mark, a frosted name panel, a frosted stub, a moving sheen. Text stays deep indigo on light glass for contrast. */
/* v775: glass version of the itunda mark: soft glow, bright rim, tinted crystal body, inner light, specular line. Same shapes as knot(), so it stays on-brand. */
function gknot(){const u='gk'+Math.random().toString(36).slice(2,8),P='<use href="#kf" mask="url(#gaps)"/><use href="#k1"/><use href="#k2"/><use href="#k3"/>';
return `<svg width="100%" height="100%" viewBox="-40 -44.7 80 80" style="overflow:visible"><defs>
<linearGradient id="${u}b" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#FFFFFF" stop-opacity=".95"/><stop offset=".3" stop-color="#C9E4FF" stop-opacity=".8"/><stop offset=".62" stop-color="#A99BFF" stop-opacity=".78"/><stop offset="1" stop-color="#FF9FD6" stop-opacity=".82"/></linearGradient>
<linearGradient id="${u}r" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#fff"/><stop offset=".5" stop-color="#E4DEFF"/><stop offset="1" stop-color="#fff"/></linearGradient>
<filter id="${u}f" x="-30%" y="-30%" width="160%" height="160%"><feGaussianBlur stdDeviation="3.2"/></filter></defs>
<g fill="none" stroke-linecap="round" stroke-linejoin="round">
<g stroke="#7E6FFF" stroke-width="15" opacity=".45" filter="url(#${u}f)" transform="translate(0 2.5)">${P}</g>
<g stroke="url(#${u}r)" stroke-width="12">${P}</g>
<g stroke="url(#${u}b)" stroke-width="9.6">${P}</g>
<g stroke="#fff" stroke-opacity=".38" stroke-width="4.6" transform="translate(-.6 -.9)">${P}</g>
<g stroke="#fff" stroke-opacity=".95" stroke-width="1.4" transform="translate(-1.9 -2.4)">${P}</g>
</g></svg>`}
function vcard(nm,badge){const c=S.cz,sn=String(c.serial||'ITN-0000');
const mk=czEmb().replace(/#4A43D9/gi,'currentColor').replace('width="30"','width="24"').replace('height="30"','height="24"');
return `<div style="width:100%;box-sizing:border-box;container-type:inline-size;border-radius:24px;background:var(--br);color:var(--on,#17171C);padding:22px;display:flex;flex-direction:column;min-height:200px"><div style="display:flex;align-items:center;gap:8px">${mk}<div style="font-size:15px;line-height:20px;font-weight:700;white-space:nowrap">${T('itunda certificate','Icyemezo cya itunda','Certificat itunda')}</div>${badge||''}</div><div style="flex:1;min-height:28px"></div><div style="font-size:14px;line-height:20px;font-weight:600;opacity:.68">${T('Identity verified','Uwo uri yemejwe','Identité vérifiée')}</div><div style="font-size:clamp(22px,8.4cqw,30px);line-height:1.15;font-weight:800;letter-spacing:-.5px;word-break:break-word;margin-top:4px">${esc(nm)}</div><div style="font-size:13px;line-height:18px;font-weight:600;opacity:.68;margin-top:12px">${T('Valid until ','Gifite agaciro kugeza ','Valide jusqu’au ')}${dt(c.to)} · <span style="font-variant-numeric:tabular-nums">${esc(sn)}</span></div></div>`}
window.czVerify=i=>{const nm=(S.name||'Amina Uwase').toUpperCase();
sh(`${vbar('closeSheet()')}<div data-czv="1" style="flex:1;display:flex;flex-direction:column;min-height:0">${vh(T('Verify your identity with your itunda certificate','Emeza uwo uri ukoresheje icyemezo cyawe cya itunda','Confirmez votre identité avec votre certificat itunda'))}<div class="mu" style="font-size:15px;line-height:22px;margin-top:8px">${T('You are signing: ','Urasinya: ','Vous signez : ')}${esc(DOCS()[i][0])}</div></div>
<div style="flex:1;display:flex;align-items:center;justify-content:center;padding:16px 24px;min-height:0">${vcard(nm)}</div>
<div style="padding:0 24px calc(16px + env(safe-area-inset-bottom,0px))"><button class="btn" onclick="czNext(${i})">${T('Next','Komeza','Suivant')}</button><button style="display:block;margin:10px auto 0;min-height:44px;padding:0 12px;border:0;background:none;color:var(--mu);font:inherit;font-size:15px;text-decoration:none;font-weight:600" onclick="czAlt(${i})">${T('Authenticate with a different method','Emeza ukoresheje ubundi buryo','Utiliser une autre méthode')}</button></div></div>`)};
window.czAlt=i=>{sh(`${vbar('czVerify('+i+')')}<div data-czv="1" style="flex:1;display:flex;flex-direction:column;min-height:0">${vh(T('Choose how to verify','Hitamo uko wemeza','Choisissez comment vérifier'))}</div>
<div class="tap" role="button" tabindex="0" style="display:flex;align-items:center;gap:14px;padding:16px 24px;margin-top:16px;min-height:72px;cursor:pointer" onclick="czSms(${i})"><div aria-hidden="true" style="width:44px;height:44px;border-radius:22px;background:var(--tint);display:flex;align-items:center;justify-content:center;font-size:22px"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--lk)" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d="M5 5.5h14a1 1 0 011 1V16a1 1 0 01-1 1H10l-4 3.5V17H5a1 1 0 01-1-1V6.5a1 1 0 011-1zM8.5 11h.01M12 11h.01M15.5 11h.01"/></svg></div><div style="flex:1;min-width:0"><b style="font-size:16px">${T('Text message code','Kode ya SMS','Code par SMS')}</b><div class="sm mu">${T('We send a 4-digit code to your phone.','Tuzohereza kode y’imibare 4 kuri telefone yawe.','Nous envoyons un code à 4 chiffres sur votre téléphone.')}</div></div></div></div>`)};
function czSigned(i){const c=S.cz,n=DOCS()[i][0],s={n:n,ts:Date.now(),ref:'ITN-SIG-'+hex(5),fp:hex(8),k:i};
c.signed.unshift(s);c.pend=c.pend.filter(x=>x!==i);
c.flash=s.ref;closeSheet();render('fade-none');c.flash='';toast(T('Signed · ','Byasinywe · ','Signé · ')+s.ref)}
window.czView=i=>{const s=S.cz.signed[i];if(!s)return;
sh(`<div class="h1" style="font-size:22px;line-height:30px">${esc(s.n)}</div><div style="margin:14px -24px 22px">${row(T('Signed','Yasinywe','Signé'),dt(s.ts))}${row(T('Reference','Nimero','Référence'),s.ref)}${row(T('Certificate','Icyemezo','Certificat'),S.cz.serial)}${row(T('Fingerprint','Ikimenyetso','Empreinte'),s.fp)}</div><button class="btn" onclick="closeSheet()">OK</button>`)};

/* ---------- renew / revoke ---------- */
window.czRenewAsk=()=>{const e=new Date(S.cz.to);e.setFullYear(e.getFullYear()+1);
sh(`<div class="h1" style="font-size:22px;line-height:30px">${T('Renew for 12 months?','Kuvugurura amezi 12?','Renouveler pour 12 mois ?')}</div><div class="mu" style="font-size:15px;margin:8px 0 24px;line-height:22px">${T('New expiry: ','Itariki nshya: ','Nouvelle expiration : ')}${dt(e)}. ${T('Your PIN and signed documents stay the same.','PIN yawe n’inyandiko zasinywe ntibihinduka.','Votre PIN et vos documents signés restent identiques.')}</div><div class="row2"><button class="btn sec2" onclick="closeSheet()">${T('Cancel','Hagarika','Annuler')}</button><button class="btn" onclick="czRenew()">${T('Renew','Vugurura','Renouveler')}</button></div>`)};
window.czRenew=()=>{const e=new Date(S.cz.to);e.setFullYear(e.getFullYear()+1);S.cz.to=e.getTime();closeSheet();render('fade-none');toast(T('Renewed until ','Cyavuguruwe kugeza ','Renouvelé jusqu’au ')+dt(S.cz.to))};
window.czRevokeAsk=()=>{sh(`<div class="h1" style="font-size:22px;line-height:30px">${T('Revoke your certificate?','Guhagarika icyemezo cyawe?','Révoquer votre certificat ?')}</div><div class="mu" style="font-size:15px;margin:8px 0 24px;line-height:22px">${T('You will not be able to sign until you get a new one. Documents you already signed stay valid.','Ntuzabasha gusinya kugeza ufashe gishya. Inyandiko wasinye zirakora.','Vous ne pourrez plus signer avant d’en obtenir un nouveau. Les documents déjà signés restent valides.')}</div><div class="row2"><button class="btn sec2" onclick="closeSheet()">${T('Cancel','Hagarika','Annuler')}</button><button class="btn" style="background:#D92D20;color:#fff" onclick="czRevoke()">${T('Revoke','Hagarika','Révoquer')}</button></div>`)};
window.czRevoke=()=>{S.cz.st='revoked';S.cz.pin='';closeSheet();render('fade-none');toast(T('Certificate revoked','Icyemezo cyahagaritswe','Certificat révoqué'))};
})();
</script>
<script>
/* v83: Verify your identity is a real flow: ID type + number, selfie, in review, verified */
(function(){
const T=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e;
const esc=s=>String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;');
const dt=d=>new Date(d).toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric'});
const hex=n=>Array.from({length:n},()=>'0123456789ABCDEF'[Math.floor(Math.random()*16)]).join('');
const sh=h=>{$('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet">'+h+'</div>'};
const hd=t=>`<div class="mh" style="padding-bottom:0"><button class="ib" aria-label="${T('Back','Subira inyuma','Retour')}" onclick="back()">${ic('back',24)}</button><b style="flex:1;font-size:19px;margin-left:6px">${esc(t)}</b></div>`;
const row=(a,b)=>`<div style="display:flex;justify-content:space-between;gap:16px;padding:14px 24px;border-top:0;font-size:15px"><span class="mu">${a}</span><b style="text-align:right">${esc(b)}</b></div>`;
const types=()=>[T('National ID','Indangamuntu','Carte d’identité'),T('Passport','Pasiporo','Passeport')];
S.vff=S.vff||{t:0,num:''};
const ok=()=>{const F=S.vff;return F.t===0?/^\d{16}$/.test(F.num):/^[A-Z0-9]{7,9}$/.test(F.num)};

/* ---------- screen for in review / verified ---------- */
function vfScreen(){const v=S.vf,ver=v.st==='verified',title=T('Verify your identity','Emeza indangamuntu yawe','Vérifiez votre identité');
const card=`<div style="margin:22px 24px 0;padding:20px;border-radius:24px;color:#fff;background:${ver?'#076B47':'#4E5968'}"><div style="font-size:40px;line-height:1">${ver?'✅':'⏳'}</div><div style="margin-top:12px;font-size:20px;font-weight:800">${ver?T('You are verified','Wemejwe','Vous êtes vérifié'):T('In review','Biri gusuzumwa','En cours d’examen')}</div><div style="margin-top:6px;font-size:15px;opacity:.9;line-height:22px">${ver?T('Verified on ','Wemejwe ku wa ','Vérifié le ')+dt(v.at):T('We will confirm within 1 business day.','Tuzabyemeza mu munsi 1 w’akazi.','Nous confirmerons sous 1 jour ouvré.')}</div></div>`;
let b=`<div style="margin-top:18px">${row(types()[v.t],'••••'+v.last)}${row(T('Reference','Nimero','Référence'),v.ref)}${row(T('Submitted','Byoherejwe','Envoyé'),dt(v.ts))}</div>`;
if(ver)b+=`<div class="sm mu" style="padding:24px 24px 8px;font-weight:700">${T('Now unlocked','Bifunguwe','Débloqué')}</div>${row(T('Send up to','Ohereza kugeza kuri','Envoyer jusqu’à'),T('5,000,000 RWF a day','5.000.000 RWF ku munsi','5 000 000 RWF par jour'))}${row(T('Loans','Inguzanyo','Prêts'),T('Available','Birahari','Disponible'))}`;
else b+=`<div style="padding:22px 24px 0;display:flex;flex-direction:column;gap:12px"><button class="btn" onclick="vfApprove()">${T('Prototype: approve now','Prototype: emeza ubu','Prototype : approuver')}</button><button class="btn sec2" onclick="vfCancel()">${T('Cancel request','Hagarika gusaba','Annuler la demande')}</button></div>`;
return `${hd(title)}${card}${b}<div style="height:40px"></div>`}
const os=screens.svc;screens.svc=()=>S.svk==='verify'&&S.vf?vfScreen():os();
const og=window.svcGo;window.svcGo=()=>{if(S.svk==='verify'&&!S.vf)return vfStart();og()};

/* ---------- step 1: ID ---------- */
function vfStart(){S.vff={t:0,num:''};drawId()}
function drawId(){const F=S.vff,p=F.t===0;
sh(`<div class="h1" style="font-size:22px;line-height:30px">${T('Your ID','Indangamuntu yawe','Votre pièce d’identité')}</div>
<div class="chp" style="padding:14px 0 0">${types().map((x,i)=>`<button class="${F.t===i?'on':''}" onclick="vfType(${i})">${x}</button>`).join('')}</div>
<input id="vfin" inputmode="${p?'numeric':'text'}" autocomplete="off" autocapitalize="characters" maxlength="${p?19:9}" aria-label="${types()[F.t]}" placeholder="${p?'0000 0000 0000 0000':'PC123456'}" oninput="vfIn(this)" onkeydown="if(event.key==='Enter'&&!$('#vfnext').disabled)vfNext()" style="width:100%;height:56px;margin-top:16px;border-radius:16px;border:1px solid var(--ln);background:var(--bg);color:var(--tx);font:inherit;font-size:20px;font-weight:700;letter-spacing:1px;padding:0 16px">
<div class="sm mu" style="margin:8px 0 22px">${p?T('16 digits, as printed on your ID','Imibare 16, nk’uko iri ku ndangamuntu','16 chiffres, comme imprimés sur votre pièce'):T('7 to 9 letters or digits','Inyuguti cyangwa imibare 7 kugeza 9','7 à 9 lettres ou chiffres')}</div>
<button class="btn" id="vfnext" disabled onclick="vfNext()">${T('Continue','Komeza','Continuer')}</button>`);
const el=$('#vfin');if(el){if(F.num){el.value=p?F.num.replace(/(\d{4})(?=\d)/g,'$1 '):F.num;$('#vfnext').disabled=!ok()}el.focus()}}
window.drawId=drawId;
window.vfType=i=>{S.vff={t:i,num:''};drawId()};
window.vfIn=el=>{const F=S.vff;if(F.t===0){F.num=el.value.replace(/\D/g,'').slice(0,16);el.value=F.num.replace(/(\d{4})(?=\d)/g,'$1 ')}else{F.num=el.value.toUpperCase().replace(/[^A-Z0-9]/g,'').slice(0,9);el.value=F.num}
$('#vfnext').disabled=!ok()};

/* ---------- step 2: selfie ---------- */
window.vfNext=()=>{if(!ok())return;
sh(`<div class="h1" style="font-size:22px;line-height:30px">${T('Take a selfie','Fata ifoto yawe','Prenez un selfie')}</div><div class="mu" style="font-size:15px;margin:8px 0 0;line-height:22px">${T('Look at the camera in good light. We match it to your ID.','Reba kamera ahari urumuri. Tuyigereranya n’indangamuntu yawe.','Regardez la caméra, bien éclairé. Nous la comparons à votre pièce.')}</div><div style="width:150px;height:150px;border-radius:75px;border:3px dashed var(--lk);margin:22px auto;display:flex;align-items:center;justify-content:center;font-size:64px" aria-hidden="true">🙂</div><div class="row2"><button class="btn sec2" onclick="drawId()">${T('Back','Subira inyuma','Retour')}</button><button class="btn" onclick="vfSubmit()">${T('Take selfie','Fata ifoto','Prendre le selfie')}</button></div>`)};
window.vfSubmit=()=>{const F=S.vff;S.vf={st:'pending',t:F.t,last:F.num.slice(-4),ts:Date.now(),ref:'ITN-VF-'+hex(5)};
sh(`<div class="g3" style="font-size:56px;line-height:1;margin-bottom:10px">📨</div><div class="h1" style="font-size:22px;line-height:30px">${T('Verification submitted','Isuzuma ryoherejwe','Vérification envoyée')}</div><div class="mu" style="font-size:15px;margin:8px 0 8px;line-height:22px">${T('We will confirm within 1 business day.','Tuzabyemeza mu munsi 1 w’akazi.','Nous confirmerons sous 1 jour ouvré.')}</div><div style="font-weight:800;margin-bottom:24px">${esc(S.vf.ref)}</div><button class="btn" onclick="closeSheet()">OK</button>`);
render('fade-none')};

/* ---------- review actions ---------- */
window.vfApprove=()=>{S.vf.st='verified';S.vf.at=Date.now();render('fade-none');toast(T('You are verified','Wemejwe','Vous êtes vérifié'))};
window.vfCancel=()=>{S.vf=null;render('fade-none');toast(T('Request cancelled','Gusaba byahagaritswe','Demande annulée'))};
})();
</script>
<script>
/* v84: Marketplace is a full flow: search, sort, saved/mine, conditions, offers, protected buy, sell form, mark sold */
(function(){
const T=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e;
const esc=s=>String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/"/g,'&quot;');
const sh=h=>{$('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet">'+h+'</div>'};
const H=HD.market;
if(!S.mkInit){S.mkInit=1;const cd={1:'like',2:'good',3:'like',4:'good',5:'good'};H.items.forEach(x=>x.cond=cd[x.id]||'good');
H.items.push({id:6,ti:'Gas cooker, 2 burners',sub:'Gisozi · 1 d ago',p:35000,g:'house',c:'Home',who:'Marie K.',cond:'good',d:'Works perfectly. Includes the hose.'},{id:7,ti:'Smart watch',sub:'Kimironko · 2 d ago',p:45000,g:'airtime',c:'Electronics',who:'David S.',cond:'new',d:'Still in the box. Tracks steps and sleep.'},{id:8,ti:'School uniform set, size 10',sub:'Remera · 6 d ago',p:8000,g:'bag',c:'Fashion',who:'Grace T.',cond:'fair',d:'Shirt, skirt and jumper. Washed and ironed.'});
H.cats=['All','Electronics','Home','Fashion','Saved','Mine'];S.mkCat='All';S.mkQ='';S.mkSort=0;S.mkO=[];S.mkf={c:'Electronics',cd:'good',t:'',p:''}}
const CL=()=>({All:T('All','Byose','Tout'),Electronics:T('Electronics','Ibikoresho by’ikoranabuhanga','Électronique'),Home:T('Home','Mu rugo','Maison'),Fashion:T('Fashion','Imyambarire','Mode'),Phones:T('Phones','Telefoni','Téléphones'),Kids:T('Kids','Abana','Enfants'),Sports:T('Sports','Siporo','Sport'),Saved:T('Saved','Ibibitswe','Enregistrés'),Mine:T('Mine','Ibyanjye','Mes annonces')});
const CD=()=>({new:T('New','Gishya','Neuf'),like:T('Like new','Nka gishya','Comme neuf'),good:T('Good','Meza','Bon'),fair:T('Fair','Biremewe','Correct')});
const SORT=()=>[T('Newest','Bishya','Récents'),T('Price ↑','Igiciro ↑','Prix ↑'),T('Price ↓','Igiciro ↓','Prix ↓')];
const item=id=>H.items.find(x=>x.id===id);
const ord=id=>S.mkO.find(o=>o.id===id&&o.st==='held');
const chips=()=>H.cats.map(c=>`<button class="cch ${S.mkCat===c?'on':''}" onclick="mkCat('${c}')">${CL()[c]}</button>`).join('');
function rows(){const q=S.mkQ.trim().toLowerCase(),c=S.mkCat;
let l=H.items.filter(x=>(c==='All'||x.c===c||(c==='Saved'&&S.hdFav['market:'+x.id])||(c==='Mine'&&x.who==='You'))&&(!q||(x.ti+' '+x.sub).toLowerCase().includes(q)));
if(S.mkSort===1)l=l.slice().sort((a,b)=>a.p-b.p);else if(S.mkSort===2)l=l.slice().sort((a,b)=>b.p-a.p);
if(!l.length)return `<div class="pad mu" style="padding-top:30px;text-align:center;line-height:22px">${c==='Saved'?T('Tap the heart on a listing to save it here.','Kanda umutima ku kintu ugibike hano.','Touchez le cœur d’une annonce pour l’enregistrer ici.'):c==='Mine'?T('You have not listed anything yet.','Nta cyo urashyiraho.','Vous n’avez encore rien publié.'):T('No matches. Try another word.','Nta bihuye. Gerageza irindi jambo.','Aucun résultat. Essayez un autre mot.')}</div>`;
return l.map(x=>`<div class="hdc" role="button" tabindex="0" style="${x.st==='sold'?'opacity:.55':''}" onclick="hdOpen('market',${x.id})"><div class="th">${gl(x.g,44)}</div><div style="flex:1;min-width:0"><div class="t">${esc(x.ti)}</div><div class="s">${esc(x.sub)} · ${CD()[x.cond]}</div><div class="pr">${fmt(x.p)} RWF${x.st==='sold'?' · '+T('Sold','Yagurishijwe','Vendu'):x.st==='reserved'?' · '+T('Reserved','Yabitswe','Réservé'):''}</div></div>${hdHeart('market',x.id)}</div>`).join('')}
const ordBox=()=>S.mkO.filter(o=>o.st==='held').map(o=>`<div style="margin:12px 24px 0;padding:14px 16px;border-radius:20px;background:var(--tint)"><b>${esc(item(o.id).ti)}</b><div class="sm mu" style="margin-top:2px">${T('Payment held. Release it when you have the item.','Amafaranga arabitswe. Yarekure ubonye ikintu.','Paiement retenu. Libérez-le quand vous avez l’article.')}</div><div style="display:flex;gap:10px;margin-top:10px"><button class="cch" style="height:44px;background:var(--lk);color:var(--on)" onclick="mkConfirm(${o.id})">${T('Confirm pickup','Emeza ko wabonye','Confirmer le retrait')}</button><button class="cch" style="height:44px" onclick="mkCancel(${o.id})">${T('Cancel and refund','Hagarika usubizwe','Annuler et rembourser')}</button></div></div>`).join('');
const refresh=()=>{if($('#mkl'))$('#mkl').innerHTML=rows();if($('#mkord'))$('#mkord').innerHTML=ordBox()};

const oh=screens.hood;screens.hood=()=>{if(S.hd!=='market')return oh();
return `${bar(H.t)}<div style="display:flex;gap:10px;padding:12px 24px 0"><input id="mkq" type="search" aria-label="${T('Search listings','Shakisha','Rechercher')}" placeholder="${T('Search listings','Shakisha','Rechercher')}" value="${esc(S.mkQ)}" oninput="mkSearch(this.value)" style="flex:1;min-width:0;height:44px;border-radius:22px;border:0;background:var(--chip);color:var(--tx);font:inherit;font-size:15px;padding:0 16px"><button id="mksort" class="cch" style="height:44px;padding:0 14px" aria-label="${T('Sort','Tondeka','Trier')}" onclick="mkSortGo()">${SORT()[S.mkSort]}</button></div><div class="chips" style="padding-top:12px" id="mkch">${chips()}</div><div id="mkord">${ordBox()}</div><div style="padding-top:8px" id="mkl">${rows()}</div><div class="pad fine" style="padding-top:18px">${T('Listings are sample data for this prototype.','Ibyatanzwe ni ibigerageza muri prototype.','Les annonces sont des données d’exemple.')}</div><div class="fab"><button class="btn" onclick="hdPost()">${T('Sell something','Gurisha ikintu','Vendre un article')}</button></div>`};
window.mkSearch=v=>{S.mkQ=v;$('#mkl').innerHTML=rows()};
window.mkSortGo=()=>{S.mkSort=(S.mkSort+1)%3;$('#mksort').textContent=SORT()[S.mkSort];$('#mkl').innerHTML=rows()};
window.mkCat=c=>{S.mkCat=c;$('#mkch').innerHTML=chips();$('#mkl').innerHTML=rows()};
const oht=window.hdTg;window.hdTg=(t,id)=>{oht(t,id);if(t==='market'&&S.mkCat==='Saved'&&$('#mkl'))$('#mkl').innerHTML=rows()};

/* ---------- detail ---------- */
const oi=screens.hoodItem;screens.hoodItem=()=>{if(S.hd!=='market')return oi();
const x=item(S.hdI),mine=x.who==='You',sold=x.st==='sold',held=ord(x.id),res=x.st==='reserved'&&!held;
const chip=t=>`<span style="padding:5px 12px;border-radius:14px;background:var(--chip);font-size:13px;font-weight:700">${t}</span>`;
const cta=mine?`<div class="cta" style="display:flex;gap:10px"><button class="btn sec2" style="flex:0 0 auto;width:auto;padding:0 20px;color:var(--er)" onclick="mkDel(${x.id})">${T('Delete','Siba','Supprimer')}</button><button class="btn" ${sold?'disabled':''} onclick="mkSold(${x.id})">${sold?T('Sold','Yagurishijwe','Vendu'):T('Mark as sold','Emeza ko yagurishijwe','Marquer comme vendu')}</button></div>`
:held?`<div class="cta" style="display:flex;gap:10px"><button class="btn sec2" style="flex:0 0 auto;width:auto;padding:0 20px" onclick="mkCancel(${x.id})">${T('Cancel','Hagarika','Annuler')}</button><button class="btn" onclick="mkConfirm(${x.id})">${T('Confirm pickup','Emeza ko wabonye','Confirmer le retrait')}</button></div>`
:`<div class="cta" style="display:flex;gap:10px"><button class="btn sec2" style="flex:0 0 auto;width:auto;padding:0 20px" onclick="hdChat('market',${x.id})">${T('Message','Ohereza ubutumwa','Message')}</button><button class="btn" ${sold||res?'disabled':''} onclick="mkBuy(${x.id})">${sold?T('Sold','Yagurishijwe','Vendu'):res?T('Reserved','Yabitswe','Réservé'):T('Buy · ','Gura · ','Acheter · ')+fmt(x.p)+' RWF'}</button></div>`;
return `${bar(H.t)}<div style="padding:12px 24px 0"><div class="pim" style="aspect-ratio:auto;height:230px;border-radius:28px;position:relative">${gl(x.g,112)}</div></div><div class="pad" style="padding-top:20px"><div style="display:flex;justify-content:space-between;align-items:flex-start;gap:8px"><div style="font-size:22px;font-weight:800;letter-spacing:-.4px;line-height:29px">${esc(x.ti)}</div>${hdHeart('market',x.id)}</div><div class="sm mu" style="margin-top:6px">${esc(x.sub)}</div><div style="font-size:24px;font-weight:800;margin-top:14px">${fmt(x.p)} RWF</div><div style="display:flex;gap:8px;margin-top:12px">${chip(CD()[x.cond])}${chip(CL()[x.c])}</div><div style="font-size:15px;line-height:23px;margin-top:14px">${esc(x.d)}</div>
${mine||sold||held||res?'':`<button class="btn sec2" style="height:48px;margin-top:16px" onclick="mkOffer(${x.id})">${T('Make an offer','Tanga igiciro','Faire une offre')}</button><div class="sm mu" style="margin-top:12px;line-height:20px">🔒 ${T('Buy with itunda: your money is held until you confirm pickup.','Gura na itunda: amafaranga abikwa kugeza wemeje ko wabonye ikintu.','Achetez avec itunda : votre argent est retenu jusqu’au retrait confirmé.')}</div>`}
<div style="display:flex;align-items:center;gap:12px;margin-top:20px;padding-top:16px;border-top:0">${gl('community',40)}<div><div style="font-weight:800">${esc(x.who)}</div><div class="sm mu">${mine?T('Your listing','Icyo washyize ku isoko','Votre annonce'):T('Seller · itunda user','Umugurisha · umukoresha wa itunda','Vendeur · utilisateur itunda')}</div></div></div></div>${cta}`};

/* ---------- buy (protected) ---------- */
window.mkBuy=id=>{const x=item(id),bad=x.p>S.bank;
sh(`<div class="h1" style="font-size:22px;line-height:30px">${T('Buy with itunda','Gura na itunda','Acheter avec itunda')}</div><div class="mu" style="font-size:15px;margin:8px 0 14px">${esc(x.ti)}</div><div style="display:flex;justify-content:space-between;font-size:16px"><span class="mu">${T('Price','Igiciro','Prix')}</span><b>${fmt(x.p)} RWF</b></div><div style="display:flex;justify-content:space-between;font-size:16px;margin-top:8px"><span class="mu">${T('Your balance','Amafaranga ufite','Votre solde')}</span><b>${fmt(S.bank)} RWF</b></div><div class="sm mu" style="margin:14px 0 22px;line-height:20px">🔒 ${T('We hold your payment. The seller is paid when you confirm pickup.','Duhagarika amafaranga yawe. Umugurisha yishyurwa wemeje ko wabonye ikintu.','Nous retenons votre paiement. Le vendeur est payé quand vous confirmez le retrait.')}</div><button class="btn" ${bad?'disabled':''} onclick="mkPay(${id})">${T('Pay ','Ishyura ','Payer ')}${fmt(x.p)} RWF</button>${bad?`<div style="color:var(--er);font-size:14px;margin-top:10px">${T('Not enough balance.','Amafaranga ntahagije.','Solde insuffisant.')}</div>`:''}`)};
window.mkPay=id=>{const x=item(id);if(x.p>S.bank)return;S.bank-=x.p;x.st='reserved';S.mkO.push({id,p:x.p,st:'held'});
if(typeof addAct==='function')addAct('bag','Marketplace · '+x.ti,'Paid',-x.p,'Paid');
closeSheet();render('fade-none');toast(T('Paid. Held until you confirm pickup.','Byishyuwe. Bibitswe kugeza wemeje.','Payé. Retenu jusqu’au retrait.'))};
window.mkConfirm=id=>{const o=ord(id);if(!o)return;o.st='done';item(id).st='sold';render('fade-none');toast(T('Payment released to the seller','Amafaranga yahawe umugurisha','Paiement versé au vendeur'))};
window.mkCancel=id=>{const o=ord(id);if(!o)return;o.st='refunded';S.bank+=o.p;item(id).st=undefined;
if(typeof addAct==='function')addAct('bag','Marketplace refund · '+item(id).ti,'Received',o.p,'Received');
render('fade-none');toast(T('Refunded to your balance','Wasubijwe amafaranga','Remboursé sur votre solde'))};

/* ---------- offer ---------- */
const amt=()=>Math.round(item(S.mkOff.id).p*(1-S.mkOff.pc/100)/500)*500;
function offDraw(){const x=item(S.mkOff.id);
sh(`<div class="h1" style="font-size:22px;line-height:30px">${T('Make an offer','Tanga igiciro','Faire une offre')}</div><div class="mu" style="font-size:15px;margin:8px 0 0">${esc(x.ti)} · ${fmt(x.p)} RWF</div><div class="chp" style="padding:16px 0 0">${[5,10,15].map(n=>`<button class="${S.mkOff.pc===n?'on':''}" onclick="mkOffPc(${n})">−${n}%</button>`).join('')}</div><div style="font-size:28px;font-weight:800;margin:18px 0 22px">${fmt(amt())} RWF</div><button class="btn" onclick="mkOffSend()">${T('Send offer','Ohereza igiciro','Envoyer l’offre')}</button>`)}
window.mkOffer=id=>{S.mkOff={id,pc:10};offDraw()};
window.mkOffPc=n=>{S.mkOff.pc=n;offDraw()};
window.mkOffSend=()=>{const x=item(S.mkOff.id),th='hdmarket'+x.id,m='Hi, would you accept '+fmt(amt())+' RWF for "'+x.ti+'"?';
hdThread(th,x.who,x.ti,[['me',m]]);if(S.msgs[th].length>1||S.msgs[th][0][1]!==m)S.msgs[th].push(['me',m]);
closeSheet();S.tab='messages';openChat(th);toast(T('Offer sent','Igiciro cyoherejwe','Offre envoyée'))};

/* ---------- sell ---------- */
const GL={Electronics:'airtime',Phones:'airtime',Home:'house',Fashion:'bag',Kids:'gift',Sports:'bolt'};
const ohp=window.hdPost;
function sellDraw(){const F=S.mkf;
sh(`<div class="h1" style="font-size:22px;line-height:30px">${T('Sell something','Gurisha ikintu','Vendre un article')}</div><div class="lab" style="margin-top:6px">${T('Title','Umutwe','Titre')}</div><input class="in" id="mkt" value="${esc(F.t)}" oninput="mkChk()" placeholder="${T('What are you selling?','Uragurisha iki?','Que vendez-vous ?')}" style="font-size:17px;height:46px"><div class="lab">${T('Price (RWF)','Igiciro (RWF)','Prix (RWF)')}</div><input class="in" id="mkp" value="${esc(F.p)}" inputmode="numeric" oninput="mkChk()" placeholder="25,000" style="font-size:17px;height:46px"><div class="lab">${T('Category','Icyiciro','Catégorie')}</div><div class="chp" style="padding:8px 0 0">${(window.MXCATS).map(c=>`<button class="${F.c===c?'on':''}" onclick="mkSet('c','${c}')">${CL()[c]}</button>`).join('')}</div><div class="lab">${T('Condition','Imiterere','État')}</div><div class="chp" style="padding:8px 0 0">${Object.keys(CD()).map(c=>`<button class="${F.cd===c?'on':''}" onclick="mkSet('cd','${c}')">${CD()[c]}</button>`).join('')}</div><button class="btn" id="mkgo" style="margin-top:22px" disabled onclick="mkPostGo()">${T('Post','Shyiraho','Publier')}</button>`);mkChk()}
window.hdPost=()=>{if(S.hd!=='market')return ohp();S.mkf={c:'Electronics',cd:'good',t:'',p:''};sellDraw()};
function mkRead(){const F=S.mkf,t=$('#mkt'),p=$('#mkp');if(t)F.t=t.value;if(p){F.p=p.value.replace(/\D/g,'').replace(/\B(?=(\d{3})+(?!\d))/g,',');p.value=F.p}return F}
window.mkChk=()=>{const F=mkRead();const b=$('#mkgo');if(b)b.disabled=!(F.t.trim()&&Number(F.p.replace(/,/g,''))>0)};
window.mkSet=(k,v)=>{mkRead();S.mkf[k]=v;sellDraw()};
window.mkPostGo=()=>{const F=mkRead(),p=Number(F.p.replace(/,/g,''));if(!F.t.trim()||!p)return;
H.items.unshift({id:Date.now()%100000,ti:F.t.trim(),sub:T('Your listing · Just now','Icyawe · Ubu','Votre annonce · À l’instant'),p,g:GL[F.c],c:F.c,who:'You',cond:F.cd,d:T('Contact the seller to arrange pickup.','Vugana n’umugurisha mwemeranye aho muhurira.','Contactez le vendeur pour organiser le retrait.')});
S.hdMine.market++;S.mkCat='Mine';closeSheet();render('fade-none');toast(T('Posted','Byashyizweho','Publié'))};
window.mkSold=id=>{item(id).st='sold';render('fade-none');toast(T('Marked as sold','Byemejwe ko byagurishijwe','Marqué comme vendu'))};
window.mkDel=id=>{H.items.splice(H.items.indexOf(item(id)),1);S.hdMine.market=Math.max(0,S.hdMine.market-1);back();toast(T('Listing deleted','Icyashyizweho cyasibwe','Annonce supprimée'))};
})();
</script>
<script>
/* v85: Property is a full flow: search, sort, bedroom filter, saved/mine, facts, cost estimate, viewing booking, list a property */
(function(){
const T=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e;
const esc=s=>String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/"/g,'&quot;');
const sh=h=>{$('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet">'+h+'</div>'};
const H=HD.property;
if(!S.prInit){S.prInit=1;
const ex={1:{n:250000,u:'mo',beds:2,baths:1,m2:70,loc:'Kimironko',furn:0},2:{n:60000,u:'mo',beds:1,baths:1,m2:18,loc:'Nyamirambo',furn:1},3:{n:95000000,u:'',beds:3,baths:2,m2:180,loc:'Kacyiru',furn:0}};
H.items.forEach(x=>Object.assign(x,ex[x.id]));
H.items.push({id:4,ti:'Studio near Kigali Heights',loc:'Kacyiru',n:180000,u:'mo',beds:1,baths:1,m2:30,furn:1,g:'house',c:'Rent',who:'Agent Samuel',d:'Furnished studio with fast internet and a security guard.'},
{id:5,ti:'Family house with yard',loc:'Gikondo',n:420000,u:'mo',beds:3,baths:2,m2:140,furn:0,g:'house',c:'Rent',who:'Agent Diane',d:'Large yard, parking for two cars, quiet neighbourhood.'},
{id:6,ti:'2-bedroom flat, city view',loc:'Kiyovu',n:68000000,u:'',beds:2,baths:2,m2:95,furn:0,g:'house',c:'Sale',who:'Agent Samuel',d:'Top floor, lift, covered parking and a balcony.'});
H.cats=['All','Rent','Sale','Saved','Mine'];S.prCat='All';S.prQ='';S.prSort=0;S.prB=0;S.prV=[];S.prf={}}
const CL=()=>({All:T('All','Byose','Tout'),Rent:T('Rent','Gukodesha','Location'),Sale:T('Sale','Kugurisha','Vente'),Saved:T('Saved','Ibibitswe','Enregistrés'),Mine:T('Mine','Ibyanjye','Mes annonces')});
const SORT=()=>[T('Newest','Bishya','Récents'),T('Price ↑','Igiciro ↑','Prix ↑'),T('Price ↓','Igiciro ↓','Prix ↓')];
const BD=()=>[T('Any beds','Ibyumba byose','Toutes ch.'),'1','2','3+'];
const item=id=>H.items.find(x=>x.id===id);
const price=x=>fmt(x.n)+' RWF'+(x.u==='mo'?T(' / month',' ku kwezi',' / mois'):'');
const sub=x=>x.loc+' · '+x.beds+T(' beds',' ibyumba',' ch.');
const view=id=>S.prV.find(v=>v.id===id);
const day=i=>{const d=new Date();d.setDate(d.getDate()+1+i);return d};
const dl=d=>d.toLocaleDateString('en-GB',{weekday:'short',day:'numeric',month:'short'});
const TM=['09:00','11:00','14:00','16:00'];
const chips=()=>H.cats.map(c=>`<button class="cch ${S.prCat===c?'on':''}" onclick="prCat('${c}')">${CL()[c]}</button>`).join('');
const bchips=()=>BD().map((b,i)=>`<button class="cch ${S.prB===i?'on':''}" onclick="prBeds(${i})">${b}</button>`).join('');
function rows(){const q=S.prQ.trim().toLowerCase(),c=S.prCat,b=S.prB;
let l=H.items.filter(x=>(c==='All'||x.c===c||(c==='Saved'&&S.hdFav['property:'+x.id])||(c==='Mine'&&x.who==='You'))&&(!b||(b===3?x.beds>=3:x.beds===b))&&(!q||(x.ti+' '+x.loc).toLowerCase().includes(q)));
if(S.prSort===1)l=l.slice().sort((a,b)=>a.n-b.n);else if(S.prSort===2)l=l.slice().sort((a,b)=>b.n-a.n);
if(!l.length)return `<div class="pad mu" style="padding-top:30px;text-align:center;line-height:22px">${c==='Saved'?T('Tap the heart on a property to save it here.','Kanda umutima ku nzu ngo uyibike hano.','Touchez le cœur d’un bien pour l’enregistrer ici.'):c==='Mine'?T('You have not listed a property yet.','Nta nzu urashyiraho.','Vous n’avez encore rien publié.'):T('No matches. Try another filter.','Nta bihuye. Gerageza irindi hitamo.','Aucun résultat. Essayez un autre filtre.')}</div>`;
return l.map(x=>`<div class="hdc" role="button" tabindex="0" style="${x.st?'opacity:.55':''}" onclick="hdOpen('property',${x.id})"><div class="th">${gl(x.g,44)}</div><div style="flex:1;min-width:0"><div class="t">${esc(x.ti)}</div><div class="s">${esc(sub(x))}</div><div class="pr">${price(x)}${x.st?' · '+(x.c==='Rent'?T('Rented','Yakodeshejwe','Loué'):T('Sold','Yagurishijwe','Vendu')):''}</div></div>${hdHeart('property',x.id)}</div>`).join('')}
const vbox=()=>S.prV.map(v=>{const x=item(v.id);return `<div style="margin:12px 24px 0;padding:14px 16px;border-radius:20px;background:var(--tint)"><b>${T('Viewing','Gusura','Visite')} · ${dl(day(v.d))}, ${TM[v.t]}</b><div class="sm mu" style="margin-top:2px">${esc(x.ti)}</div><button class="cch" style="height:44px;margin-top:10px" onclick="prVCancel(${v.id})">${T('Cancel viewing','Hagarika gusura','Annuler la visite')}</button></div>`}).join('');

const oh=screens.hood;screens.hood=()=>{if(S.hd!=='property')return oh();
return `${bar(H.t)}<div style="display:flex;gap:10px;padding:12px 24px 0"><input id="prq" type="search" aria-label="${T('Search properties','Shakisha imitungo','Rechercher')}" placeholder="${T('Search properties','Shakisha imitungo','Rechercher un bien')}" value="${esc(S.prQ)}" oninput="prSearch(this.value)" style="flex:1;min-width:0;height:44px;border-radius:22px;border:0;background:var(--chip);color:var(--tx);font:inherit;font-size:15px;padding:0 16px"><button id="prsort" class="cch" style="height:44px;padding:0 14px" aria-label="${T('Sort','Tondeka','Trier')}" onclick="prSortGo()">${SORT()[S.prSort]}</button></div><div class="chips" style="padding-top:12px" id="prch">${chips()}</div><div class="chips" style="padding-top:8px" id="prbd">${bchips()}</div><div id="prv">${vbox()}</div><div style="padding-top:8px" id="prl">${rows()}</div><div class="pad fine" style="padding-top:18px">${T('Listings are sample data for this prototype.','Ibyatanzwe ni ibigerageza muri prototype.','Les annonces sont des données d’exemple.')}</div><div class="fab"><button class="btn" onclick="hdPost()">${T('List a property','Shyiraho inzu','Publier un bien')}</button></div>`};
window.prSearch=v=>{S.prQ=v;$('#prl').innerHTML=rows()};
window.prSortGo=()=>{S.prSort=(S.prSort+1)%3;$('#prsort').textContent=SORT()[S.prSort];$('#prl').innerHTML=rows()};
window.prCat=c=>{S.prCat=c;$('#prch').innerHTML=chips();$('#prl').innerHTML=rows()};
window.prBeds=i=>{S.prB=i;$('#prbd').innerHTML=bchips();$('#prl').innerHTML=rows()};
const oht=window.hdTg;window.hdTg=(t,id)=>{oht(t,id);if(t==='property'&&S.prCat==='Saved'&&$('#prl'))$('#prl').innerHTML=rows()};

/* ---------- detail ---------- */
const oi=screens.hoodItem;screens.hoodItem=()=>{if(S.hd!=='property')return oi();
const x=item(S.hdI),mine=x.who==='You',rent=x.c==='Rent',v=view(x.id);
const box=(a,b)=>`<div style="flex:1;padding:12px 8px;border-radius:16px;background:var(--chip);text-align:center"><b style="font-size:18px">${a}</b><div class="sm mu">${b}</div></div>`;
const r=.12/12,P=x.n*.8,mo=Math.round(P*r/(1-Math.pow(1+r,-180)));
const est=rent?`<div style="display:flex;justify-content:space-between;font-size:15px;margin-top:16px"><span class="mu">${T('Move-in cost','Ikiguzi cyo kwimuka','Coût d’emménagement')}</span><b>${fmt(x.n*3)} RWF</b></div><div class="sm mu" style="margin-top:4px;line-height:20px">${T('First month plus a 2-month deposit.','Ukwezi kwa mbere n’ingwate y’amezi 2.','Premier mois plus 2 mois de caution.')}</div>`:`<div style="display:flex;justify-content:space-between;font-size:15px;margin-top:16px"><span class="mu">${T('Est. monthly payment','Igereranya ry’ukwezi','Mensualité estimée')}</span><b>${fmt(mo)} RWF</b></div><div class="sm mu" style="margin-top:4px;line-height:20px">${T('20% down, 15 years at 12%. For illustration only.','20% mbere, imyaka 15 kuri 12%. Ni urugero gusa.','20 % d’apport, 15 ans à 12 %. À titre indicatif.')}</div>`;
const cta=mine?`<div class="cta" style="display:flex;gap:10px"><button class="btn sec2" style="flex:0 0 auto;width:auto;padding:0 20px;color:var(--er)" onclick="prDel(${x.id})">${T('Delete','Siba','Supprimer')}</button><button class="btn" ${x.st?'disabled':''} onclick="prTaken(${x.id})">${x.st?(rent?T('Rented','Yakodeshejwe','Loué'):T('Sold','Yagurishijwe','Vendu')):rent?T('Mark as rented','Emeza ko yakodeshejwe','Marquer comme loué'):T('Mark as sold','Emeza ko yagurishijwe','Marquer comme vendu')}</button></div>`
:`<div class="cta" style="display:flex;gap:10px"><button class="btn sec2" style="flex:0 0 auto;width:auto;padding:0 20px" onclick="hdChat('property',${x.id})">${T('Message','Ohereza ubutumwa','Message')}</button><button class="btn" ${x.st?'disabled':''} onclick="prView(${x.id})">${v?T('Reschedule · ','Hindura · ','Reprogrammer · ')+dl(day(v.d))+' '+TM[v.t]:T('Book a viewing','Gena igihe cyo gusura','Réserver une visite')}</button></div>`;
return `${bar(H.t)}<div style="padding:12px 24px 0"><div class="pim" style="aspect-ratio:auto;height:230px;border-radius:28px;position:relative">${gl(x.g,112)}</div></div><div class="pad" style="padding-top:20px"><div style="display:flex;justify-content:space-between;align-items:flex-start;gap:8px"><div style="font-size:22px;font-weight:800;letter-spacing:-.4px;line-height:29px">${esc(x.ti)}</div>${hdHeart('property',x.id)}</div><div class="sm mu" style="margin-top:6px">${esc(x.loc)} · ${CL()[x.c]}${rent&&x.furn!=null?' · '+(x.furn?T('Furnished','Irimo ibikoresho','Meublé'):T('Unfurnished','Nta bikoresho birimo','Non meublé')):''}</div><div style="font-size:24px;font-weight:800;margin-top:14px">${price(x)}</div><div style="display:flex;gap:10px;margin-top:14px">${box(x.beds,T('beds','ibyumba','chambres'))}${box(x.baths||1,T('baths','ubwiherero','sdb'))}${x.m2?box(x.m2,'m²'):''}</div>${est}<div style="font-size:15px;line-height:23px;margin-top:16px">${esc(x.d)}</div><div style="display:flex;align-items:center;gap:12px;margin-top:20px;padding-top:16px;border-top:0">${gl('community',40)}<div><div style="font-weight:800">${esc(x.who)}</div><div class="sm mu">${mine?T('Your listing','Icyo washyize ku isoko','Votre annonce'):T('Agent · itunda user','Umuhuza · umukoresha wa itunda','Agent · utilisateur itunda')}</div></div></div></div>${cta}`};

/* ---------- viewing ---------- */
function vDraw(){const F=S.prf,x=item(F.id);
sh(`<div class="h1" style="font-size:22px;line-height:30px">${T('Book a viewing','Gena igihe cyo gusura','Réserver une visite')}</div><div class="mu" style="font-size:15px;margin:8px 0 0">${esc(x.ti)}</div><div class="chp" style="padding:16px 0 0">${[0,1,2].map(i=>`<button class="${F.d===i?'on':''}" onclick="prVSet('d',${i})">${dl(day(i))}</button>`).join('')}</div><div class="chp" style="padding:10px 0 0">${TM.map((t,i)=>`<button class="${F.t===i?'on':''}" onclick="prVSet('t',${i})">${t}</button>`).join('')}</div><button class="btn" style="margin-top:22px" onclick="prVGo()">${T('Confirm viewing','Emeza gusura','Confirmer la visite')}</button>`)}
window.prView=id=>{const v=view(id);S.prf={id,d:v?v.d:0,t:v?v.t:1};vDraw()};
window.prVSet=(k,i)=>{S.prf[k]=i;vDraw()};
window.prVGo=()=>{const F=S.prf,x=item(F.id);S.prV=S.prV.filter(v=>v.id!==F.id);S.prV.push({id:F.id,d:F.d,t:F.t});
const th='hdproperty'+x.id,m='Hi, I would like to view "'+x.ti+'" on '+dl(day(F.d))+' at '+TM[F.t]+'.';
hdThread(th,x.who,x.ti,[['me',m]]);if(S.msgs[th].length>1||S.msgs[th][0][1]!==m)S.msgs[th].push(['me',m]);
closeSheet();render('fade-none');toast(T('Viewing requested: ','Gusura byasabwe: ','Visite demandée : ')+dl(day(F.d))+', '+TM[F.t])};
window.prVCancel=id=>{S.prV=S.prV.filter(v=>v.id!==id);if($('#prv'))$('#prv').innerHTML=vbox();toast(T('Viewing cancelled','Gusura byahagaritswe','Visite annulée'))};

/* ---------- list a property ---------- */
const ohp=window.hdPost;
function sDraw(){const F=S.prf;
sh(`<div class="h1" style="font-size:22px;line-height:30px">${T('List a property','Shyiraho inzu','Publier un bien')}</div><div class="lab" style="margin-top:6px">${T('Title','Umutwe','Titre')}</div><input class="in" id="pst" value="${esc(F.t||'')}" oninput="prChk()" placeholder="${T('2-bedroom apartment','Inzu y’ibyumba 2','Appartement 2 chambres')}" style="font-size:17px;height:46px"><div class="lab">${T('Neighbourhood','Umudugudu','Quartier')}</div><input class="in" id="psl" value="${esc(F.l||'')}" oninput="prChk()" placeholder="Kimironko" style="font-size:17px;height:46px"><div class="lab">${T('Price (RWF)','Igiciro (RWF)','Prix (RWF)')}</div><input class="in" id="psp" value="${esc(F.p||'')}" inputmode="numeric" oninput="prChk()" placeholder="250,000" style="font-size:17px;height:46px"><div class="lab">${T('Type','Ubwoko','Type')}</div><div class="chp" style="padding:8px 0 0">${['Rent','Sale'].map(c=>`<button class="${F.c===c?'on':''}" onclick="prSet('c','${c}')">${CL()[c]}</button>`).join('')}</div><div class="lab">${T('Bedrooms','Ibyumba','Chambres')}</div><div class="chp" style="padding:8px 0 0">${[1,2,3,4].map(n=>`<button class="${F.b===n?'on':''}" onclick="prSet('b',${n})">${n===4?'4+':n}</button>`).join('')}</div><button class="btn" id="psgo" style="margin-top:22px" disabled onclick="prPostGo()">${T('Post','Shyiraho','Publier')}</button>`);prChk()}
window.hdPost=()=>{if(S.hd!=='property')return ohp();S.prf={c:'Rent',b:2,t:'',l:'',p:''};sDraw()};
function rd(){const F=S.prf,t=$('#pst'),l=$('#psl'),p=$('#psp');if(t)F.t=t.value;if(l)F.l=l.value;if(p){F.p=p.value.replace(/\D/g,'').replace(/\B(?=(\d{3})+(?!\d))/g,',');p.value=F.p}return F}
window.prChk=()=>{const F=rd(),b=$('#psgo');if(b)b.disabled=!(F.t.trim()&&Number(F.p.replace(/,/g,''))>0)};
window.prSet=(k,v)=>{rd();S.prf[k]=v;sDraw()};
window.prPostGo=()=>{const F=rd(),n=Number(F.p.replace(/,/g,''));if(!F.t.trim()||!n)return;
H.items.unshift({id:Date.now()%100000,ti:F.t.trim(),loc:(F.l||'').trim()||'Kigali',n,u:F.c==='Rent'?'mo':'',beds:F.b,baths:1,m2:0,furn:null,g:'house',c:F.c,who:'You',d:T('Contact the owner to arrange a viewing.','Vugana na nyirayo mwemeranye gusura.','Contactez le propriétaire pour organiser une visite.')});
S.hdMine.property++;S.prCat='Mine';S.prB=0;closeSheet();render('fade-none');toast(T('Posted','Byashyizweho','Publié'))};
window.prTaken=id=>{item(id).st=1;render('fade-none');toast(T('Marked as done','Byemejwe','Marqué comme terminé'))};
window.prDel=id=>{H.items.splice(H.items.indexOf(item(id)),1);S.prV=S.prV.filter(v=>v.id!==id);S.hdMine.property=Math.max(0,S.hdMine.property-1);back();toast(T('Listing deleted','Icyashyizweho cyasibwe','Annonce supprimée'))};
})();
</script>
<script>
/* v86: Jobs is a full flow: search, sort, saved/applied/mine, requirements, apply with a note, status tracking, post a job */
(function(){
const T=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e;
const esc=s=>String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/"/g,'&quot;');
const sh=h=>{$('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet">'+h+'</div>'};
const H=HD.jobs;
if(!S.jbInit){S.jbInit=1;
const ex={1:{n:4000,u:'day',loc:'Kimironko',req:['Friendly with customers','Can start within a week']},2:{n:700,u:'task',loc:'Nyamirambo',req:['Own moto','Valid licence','Smartphone']},3:{n:6000,u:'task',loc:'Remera',req:['Secondary maths level','Patient with students']},4:{n:8000,u:'day',loc:'Kigali Convention area',req:['Can lift light items','Available on the day']}};
H.items.forEach(x=>Object.assign(x,ex[x.id]));
H.items.push({id:5,ti:'Cashier',g:'bag',c:'Part-time',who:'Remera Grocers',n:3500,u:'day',loc:'Remera',d:'Handle payments at the till and check stock at closing. Afternoons.',req:['Good with numbers','Honest and punctual']},
{id:6,ti:'Accounts assistant',g:'chart',c:'Full-time',who:'Kigali Heights Office',n:150000,u:'month',loc:'Kacyiru',d:'Enter invoices, reconcile accounts and support the finance lead. Monday to Friday.',req:['Diploma in accounting','Basic spreadsheet skills']},
{id:7,ti:'Phone repair apprentice',g:'airtime',c:'Part-time',who:'Nyabugogo Tech',n:60000,u:'month',loc:'Nyabugogo',d:'Learn screen and battery repairs from a senior technician. Six months, with a chance to stay on.',req:['Good eyesight and steady hands','Eager to learn']});
H.cats=['All','Part-time','Gig','Full-time','Saved','Applied','Mine'];S.jbCat='All';S.jbQ='';S.jbSort=0;S.jbSt={};S.jbf={}}
const CL=()=>({All:T('All','Byose','Tout'),'Part-time':T('Part-time','Igihe gito','Temps partiel'),Gig:T('Gig','Akazi k’igihe gito','Mission'),'Full-time':T('Full-time','Igihe cyose','Temps plein'),Saved:T('Saved','Ibibitswe','Enregistrés'),Applied:T('Applied','Nasabye','Candidatures'),Mine:T('Mine','Ibyanjye','Mes annonces')});
const UN=()=>({day:T('day','munsi','jour'),task:T('task','gikorwa','mission'),month:T('month','kwezi','mois')});
const SORT=()=>[T('Newest','Bishya','Récents'),T('Pay ↑','Umushahara ↑','Salaire ↑'),T('Pay ↓','Umushahara ↓','Salaire ↓')];
const ST=()=>[T('Applied','Nasabye','Envoyée'),T('Viewed','Byarebwe','Vue'),T('Interview invite','Ubutumire bw’ikiganiro','Invitation à un entretien')];
const item=id=>H.items.find(x=>x.id===id);
const pay=x=>fmt(x.n)+' RWF / '+UN()[x.u];
const stChip=x=>S.hdApplied[x.id]?`<span style="margin-left:8px;padding:3px 10px;border-radius:12px;background:var(--tint);color:var(--tintfg);font-size:12px;font-weight:700">${ST()[S.jbSt[x.id]||0]}</span>`:'';
const chips=()=>window.jbTools()+H.cats.map(c=>`<button class="cch ${S.jbCat===c?'on':''}" onclick="jbCat('${c}')">${CL()[c]}</button>`).join('');
function rows(){const q=S.jbQ.trim().toLowerCase(),c=S.jbCat;
let l=H.items.filter(x=>!(S.jbHide||{})[x.id]&&jbFltOk(x)&&(c==='All'||x.c===c||(c==='Saved'&&S.hdFav['jobs:'+x.id])||(c==='Applied'&&S.hdApplied[x.id])||(c==='Mine'&&x.who==='You'))&&(!q||(x.ti+' '+x.who+' '+x.loc).toLowerCase().includes(q)));
if(S.jbSort===1)l=l.slice().sort((a,b)=>a.n-b.n);else if(S.jbSort===2)l=l.slice().sort((a,b)=>b.n-a.n);
if(!l.length)return `<div class="pad mu" style="padding-top:30px;text-align:center;line-height:22px">${c==='Saved'?T('Tap the heart on a job to save it here.','Kanda umutima ku kazi ngo ugabike hano.','Touchez le cœur d’une offre pour l’enregistrer ici.'):c==='Applied'?T('You have not applied to any job yet.','Nta kazi urasaba.','Vous n’avez encore postulé à aucune offre.'):c==='Mine'?T('You have not posted a job yet.','Nta kazi urashyiraho.','Vous n’avez encore publié aucune offre.'):T('No matches. Try another word.','Nta bihuye. Gerageza irindi jambo.','Aucun résultat. Essayez un autre mot.')}</div>`;
return l.map(x=>`<div class="hdc" role="button" tabindex="0" style="${x.st?'opacity:.55':''}" onclick="hdOpen('jobs',${x.id})"><div class="th">${gl(x.g,44)}</div><div style="flex:1;min-width:0"><div class="t">${esc(x.ti)}</div><div class="s">${esc(x.who)} · ${esc(x.loc)}</div><div class="pr">${pay(x)}${x.st?' · '+T('Filled','Cyamaze kuboneka','Pourvu'):''}${stChip(x)}</div></div>${hdHeart('jobs',x.id)}</div>`).join('')}

const oh=screens.hood;screens.hood=()=>{if(S.hd!=='jobs')return oh();
return `${bar(H.t)}<div style="display:flex;gap:10px;padding:12px 24px 0"><input id="jbq" type="search" aria-label="${T('Search jobs','Shakisha akazi','Rechercher')}" placeholder="${T('Search jobs','Shakisha akazi','Rechercher un emploi')}" value="${esc(S.jbQ)}" oninput="jbSearch(this.value)" style="flex:1;min-width:0;height:44px;border-radius:22px;border:0;background:var(--chip);color:var(--tx);font:inherit;font-size:15px;padding:0 16px"><button id="jbsort" class="cch" style="height:44px;padding:0 14px" aria-label="${T('Sort','Tondeka','Trier')}" onclick="jbSortGo()">${SORT()[S.jbSort]}</button></div><div class="chips" style="padding-top:12px" id="jbch">${chips()}</div><div style="padding-top:8px" id="jbl">${rows()}</div><div class="pad fine" style="padding-top:18px">${T('Listings are sample data for this prototype.','Ibyatanzwe ni ibigerageza muri prototype.','Les annonces sont des données d’exemple.')}</div><div class="fab"><button class="btn" onclick="hdPost()">${T('Post a job','Shyiraho akazi','Publier une offre')}</button></div>`};
window.jbSearch=v=>{S.jbQ=v;$('#jbl').innerHTML=rows()};
window.jbSortGo=()=>{S.jbSort=(S.jbSort+1)%3;$('#jbsort').textContent=SORT()[S.jbSort];$('#jbl').innerHTML=rows()};
window.jbCat=c=>{S.jbCat=c;$('#jbch').innerHTML=chips();$('#jbl').innerHTML=rows()};
const oht=window.hdTg;window.hdTg=(t,id)=>{oht(t,id);if(t==='jobs'&&S.jbCat==='Saved'&&$('#jbl'))$('#jbl').innerHTML=rows()};

/* ---------- detail ---------- */
const oi=screens.hoodItem;screens.hoodItem=()=>{if(S.hd!=='jobs')return oi();
const x=item(S.hdI),mine=x.who==='You',ap=S.hdApplied[x.id],s=S.jbSt[x.id]||0;
const chip=t=>`<span style="padding:5px 12px;border-radius:14px;background:var(--chip);font-size:13px;font-weight:700">${t}</span>`;
const track=ap?`<div style="margin-top:16px;padding:14px 16px;border-radius:20px;background:var(--tint)"><div style="display:flex;gap:6px">${[0,1,2].map(i=>`<div style="flex:1;height:6px;border-radius:3px;background:${i<=s?'var(--lk)':'var(--ln)'}"></div>`).join('')}</div><b style="display:block;margin-top:10px">${ST()[s]}</b><div class="sm mu" style="margin-top:2px;line-height:20px">${s===2?window.jbIvText(x.id):s===1?T('The employer opened your application.','Umukoresha yarebye ubusabe bwawe.','L’employeur a ouvert votre candidature.'):T('Sent. You will be told when it is viewed.','Byoherejwe. Uzabimenyeshwa igihe bizarebwa.','Envoyée. Vous serez prévenu quand elle sera vue.')}</div>${s===2?window.jbIvBtns(x.id):''}</div>`:'';
const cta=mine?`<div class="cta" style="display:flex;gap:10px"><button class="btn sec2" style="flex:0 0 auto;width:auto;padding:0 20px;color:var(--er)" onclick="jbDel(${x.id})">${T('Delete','Siba','Supprimer')}</button><button class="btn" ${x.st?'disabled':''} onclick="jbFill(${x.id})">${x.st?T('Filled','Cyamaze kuboneka','Pourvu'):T('Mark as filled','Emeza ko cyabonetse','Marquer comme pourvu')}</button></div>`
:ap?`<div class="cta" style="display:flex;gap:10px"><button class="btn sec2" style="flex:0 0 auto;width:auto;padding:0 20px" onclick="jbWithdraw(${x.id})">${T('Withdraw','Subiza inyuma','Retirer')}</button><button class="btn" onclick="hdChat('jobs',${x.id})">${T('Message','Ohereza ubutumwa','Message')}</button></div>`
:`<div class="cta" style="display:flex;gap:10px"><button class="btn sec2" style="flex:0 0 auto;width:auto;padding:0 20px" onclick="hdChat('jobs',${x.id})">${T('Message','Ohereza ubutumwa','Message')}</button><button class="btn" ${x.st?'disabled':''} onclick="jbApply(${x.id})">${x.st?T('Filled','Cyamaze kuboneka','Pourvu'):T('Apply','Saba','Postuler')}</button></div>`;
return `${bar(H.t)}<div style="padding:12px 24px 0"><div class="pim" style="aspect-ratio:auto;height:200px;border-radius:28px;position:relative">${gl(x.g,100)}</div></div><div class="pad" style="padding-top:20px"><div style="display:flex;justify-content:space-between;align-items:flex-start;gap:8px"><div style="font-size:22px;font-weight:800;letter-spacing:-.4px;line-height:29px">${esc(x.ti)}</div>${hdHeart('jobs',x.id)}</div><div class="sm mu" style="margin-top:6px">${esc(x.who)} · ${esc(x.loc)}</div><div style="font-size:24px;font-weight:800;margin-top:14px">${pay(x)}</div><div style="display:flex;gap:8px;margin-top:12px">${chip(CL()[x.c])}</div>${track}<div style="font-size:15px;line-height:23px;margin-top:16px">${esc(x.d)}</div>${x.req?`<div class="sm mu" style="margin-top:18px;font-weight:700">${T('What you need','Ibyo ukeneye','Ce qu’il faut')}</div>${x.req.map(r=>`<div style="display:flex;gap:10px;font-size:15px;line-height:22px;margin-top:8px"><span style="color:var(--ok)">✓</span><span>${esc(r)}</span></div>`).join('')}`:''}<div style="display:flex;align-items:center;gap:12px;margin-top:22px;padding-top:16px;border-top:0">${gl('community',40)}<div><div style="font-weight:800">${esc(x.who)}</div><div class="sm mu">${mine?T('Your listing','Icyo washyize ku isoko','Votre annonce'):T('Employer · itunda user','Umukoresha · umukoresha wa itunda','Employeur · utilisateur itunda')}</div></div></div></div>${cta}`};

/* ---------- apply ---------- */
const QK=()=>[T('I can start this week.','Nshobora gutangira muri iki cyumweru.','Je peux commencer cette semaine.'),T('I have done similar work before.','Nigeze gukora akazi nk’aka.','J’ai déjà fait un travail similaire.'),T('I live close by.','Nturiye hafi.','J’habite à proximité.')];
window.jbApply=id=>{const x=item(id);
sh(`<div class="h1" style="font-size:22px;line-height:30px">${T('Apply to ','Saba kuri ','Postuler chez ')}${esc(x.who)}</div><div class="mu" style="font-size:15px;margin:8px 0 0">${esc(x.ti)} · ${pay(x)}</div><div class="chp" style="padding:16px 0 0;flex-wrap:wrap;overflow:visible">${QK().map((q,i)=>`<button onclick="jbAdd(${i})">${esc(q)}</button>`).join('')}</div><textarea id="jbn" aria-label="${T('Note to the employer','Ubutumwa ku mukoresha','Note à l’employeur')}" placeholder="${T('Add a note (optional)','Ongeraho ubutumwa (si ngombwa)','Ajoutez une note (facultatif)')}" style="width:100%;height:96px;margin-top:14px;border:0;border-radius:16px;background:var(--chip);padding:14px;font:inherit;font-size:15px;color:var(--tx);outline:0;resize:none"></textarea><button class="btn" style="margin-top:16px" onclick="jbApplyGo(${id})">${T('Send application','Ohereza ubusabe','Envoyer la candidature')}</button>`)};
window.jbAdd=i=>{const t=$('#jbn'),q=QK()[i];if(t&&!t.value.includes(q))t.value=(t.value?t.value+' ':'')+q};
window.jbApplyGo=id=>{const x=item(id),n=(($('#jbn')||{}).value||'').trim(),th='hdjobs'+id,m='Hello, I would like to apply for "'+x.ti+'".'+(n?' '+n:'');
S.hdApplied[id]=true;S.jbSt[id]=0;hdThread(th,x.who,x.ti,[['me',m]]);if(S.msgs[th].length>1||S.msgs[th][0][1]!==m)S.msgs[th].push(['me',m]);
closeSheet();render('fade-none');toast(T('Application sent to ','Ubusabe bwoherejwe kuri ','Candidature envoyée à ')+x.who);
const adv=(k,msg)=>setTimeout(()=>{if(!S.hdApplied[id]||S.jbSt[id]>=k)return;S.jbSt[id]=k;const top=S.stack[S.stack.length-1];if(top==='hoodItem'&&S.hdI===id&&S.hd==='jobs')render('fade-none');else if(top==='hood'&&S.hd==='jobs'&&$('#jbl'))$('#jbl').innerHTML=rows();toast(msg)},k===1?5000:12000);
adv(1,x.who+T(' viewed your application',' yarebye ubusabe bwawe',' a vu votre candidature'));adv(2,x.who+T(' invited you to an interview',' yagutumiye mu kiganiro',' vous invite à un entretien'))};
window.jbWithdraw=id=>{delete S.hdApplied[id];delete S.jbSt[id];render('fade-none');toast(T('Application withdrawn','Ubusabe bwakuweho','Candidature retirée'))};

/* ---------- post a job ---------- */
const ohp=window.hdPost;
function pDraw(){const F=S.jbf;
sh(`<div class="h1" style="font-size:22px;line-height:30px">${T('Post a job','Shyiraho akazi','Publier une offre')}</div><div class="lab" style="margin-top:6px">${T('Job title','Umutwe w’akazi','Intitulé')}</div><input class="in" id="jpt" value="${esc(F.t||'')}" oninput="jbChk()" placeholder="${T('Shop assistant','Umukozi mu iduka','Vendeur')}" style="font-size:17px;height:46px"><div class="lab">${T('Location','Aho biri','Lieu')}</div><input class="in" id="jpl" value="${esc(F.l||'')}" oninput="jbChk()" placeholder="Kimironko" style="font-size:17px;height:46px"><div class="lab">${T('Pay (RWF)','Umushahara (RWF)','Salaire (RWF)')}</div><input class="in" id="jpp" value="${esc(F.p||'')}" inputmode="numeric" oninput="jbChk()" placeholder="5,000" style="font-size:17px;height:46px"><div class="chp" style="padding:10px 0 0">${Object.entries(UN()).map(([k,v])=>`<button class="${F.u===k?'on':''}" onclick="jbSet('u','${k}')">${T('Per ','Ku ','Par ')}${v}</button>`).join('')}</div><div class="lab">${T('Type','Ubwoko','Type')}</div><div class="chp" style="padding:8px 0 0">${['Part-time','Gig','Full-time'].map(c=>`<button class="${F.c===c?'on':''}" onclick="jbSet('c','${c}')">${CL()[c]}</button>`).join('')}</div><button class="btn" id="jpgo" style="margin-top:22px" disabled onclick="jbPostGo()">${T('Post','Shyiraho','Publier')}</button>`);jbChk()}
window.hdPost=()=>{if(S.hd!=='jobs')return ohp();S.jbf={c:'Part-time',u:'day',t:'',l:'',p:''};pDraw()};
function rd(){const F=S.jbf,t=$('#jpt'),l=$('#jpl'),p=$('#jpp');if(t)F.t=t.value;if(l)F.l=l.value;if(p){F.p=p.value.replace(/\D/g,'').replace(/\B(?=(\d{3})+(?!\d))/g,',');p.value=F.p}return F}
window.jbChk=()=>{const F=rd(),b=$('#jpgo');if(b)b.disabled=!(F.t.trim()&&Number(F.p.replace(/,/g,''))>0)};
window.jbSet=(k,v)=>{rd();S.jbf[k]=v;pDraw()};
window.jbPostGo=()=>{const F=rd(),n=Number(F.p.replace(/,/g,''));if(!F.t.trim()||!n)return;
H.items.unshift({id:Date.now()%100000,ti:F.t.trim(),loc:(F.l||'').trim()||'Kigali',n,u:F.u,c:F.c,g:'briefcase',who:'You',d:T('Message the employer for details.','Andikira umukoresha ubone ibisobanuro.','Contactez l’employeur pour les détails.')});
S.hdMine.jobs++;S.jbCat='Mine';closeSheet();render('fade-none');toast(T('Posted','Byashyizweho','Publié'))};
window.jbFill=id=>{item(id).st=1;render('fade-none');toast(T('Marked as filled','Byemejwe ko cyabonetse','Marqué comme pourvu'))};
window.jbDel=id=>{H.items.splice(H.items.indexOf(item(id)),1);S.hdMine.jobs=Math.max(0,S.hdMine.jobs-1);back();toast(T('Listing deleted','Icyashyizweho cyasibwe','Annonce supprimée'))};
})();
</script>
<script>
/* v87: Settings is a full flow: every row opens a real screen (profile, text size, notifications, devices, transfer limits, payment settings, legal, change PIN) */
(function(){
const T=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e;
const esc=s=>String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/"/g,'&quot;');
const sh=h=>{$('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet">'+h+'</div>'};
const ttl=x=>`${bar('')}<div class="stt">${x}</div>`;
const row=(a,s,r,on)=>`<div class="ar tap" onclick="${on}"><div style="min-width:0;flex:1"><div class="t">${a}</div>${s?`<div class="s">${s}</div>`:''}</div>${r?`<span style="font-size:15px;font-weight:600;color:var(--lk)">${r}</span>`:''}${ic('chev',16,'var(--tt)')}</div>`;
const swx=k=>`<div class="sw ${S.set[k]?'on':''}" id="ss_${k}" role="switch" aria-checked="${!!S.set[k]}" tabindex="0" onclick="event.stopPropagation();tgSet('${k}')"><i></i></div>`;
const trow=(a,s,k)=>`<div class="ar" style="cursor:default"><div style="min-width:0;flex:1"><div class="t">${a}</div>${s?`<div class="s">${s}</div>`:''}</div>${swx(k)}</div>`;
const chp=(arr,cur,fn,lab)=>`<div class="chp" style="padding:12px 24px 0;flex-wrap:wrap;overflow:visible">${arr.map(x=>`<button class="${cur===x?'on':''}" onclick="${fn}(${typeof x==='string'?`'${x}'`:x})">${lab(x)}</button>`).join('')}</div>`;
const note=x=>`<div class="pad fine" style="padding-top:14px;line-height:20px">${x}</div>`;
const L2={en:'English',rw:'Kinyarwanda',fr:'Français'};
if(S.set.tap===undefined)S.set.tap=true;if(S.set.rcpt===undefined)S.set.rcpt=true;
S.ts=S.ts||0;S.lim=S.lim||{d:500000,a:50000};S.src=S.src||'pay';S.lg=S.lg||'cr';
S.dev=S.dev||[{id:1,n:'Pixel 8',loc:'Kigali',w:0},{id:2,n:'Samsung A14',loc:'Huye',w:1},{id:3,n:'iPhone 11',loc:'Musanze',w:2}];
const applyTs=()=>{const v=$('#view');if(v)v.style.zoom=[1,1.08,1.16][S.ts]};
const oc=window.obCreate;window.obCreate=()=>{S.apin=S.ob.pin;oc()};
const go=n=>{S.stack.push(n);render('push')};

/* ---------- hub ---------- */
screens.settings=()=>{const nm=S.name||'Amina Uwase';
return `${bar('')}<div class="prof tap" onclick="go('profile')"><div class="av">${esc(nm[0])}</div><div style="flex:1;min-width:0"><b>${esc(nm)}</b><div class="s">${t('s_myinfo')}</div></div>${ic('chev',18,'var(--tt)')}</div>
<div class="stc" style="margin-top:20px">${row(T('Display & haptics','Imiterere & kunyeganyega','Affichage et vibrations'),'','',"go('display')")}${row(t('s_text'),'',[T('Default','Bisanzwe','Par défaut'),T('Large','Binini','Grand'),T('Largest','Binini cyane','Très grand')][S.ts],"go('textsize')")}${row(t('s_lang'),'',L2[S.lang],'openLang()')}${row(T('Manage contacts','Gucunga abo uziranye','Gérer les contacts'),'','',"go('contacts')")}${row(t('s_notif'),'','',"go('notif')")}</div>
<div class="stc"><div class="agt">${t('s_auth')}</div>${row(T('Security','Umutekano','Sécurité'),'','','openSec()')}${row(t('s_devices'),'Pixel 8'+t('s_thisdev'),String(S.dev.length),"go('devices')")}</div>
<div class="stc"><div class="agt">${t('s_tp')}</div>${row(T('Send limits','Imipaka yo kohereza','Plafonds d’envoi'),'',fmt(S.lim.d)+' RWF',"go('sendset')")}${row(t('s_pay'),'',S.src==='pay'?T('Pay balance','Ikofi ryo kwishyura','Solde Payer'):T('Bank','Banki','Banque'),"go('payset')")}</div>
<div class="stc"><div class="agt">${t('s_notif')}</div>${trow(t('s_money'),'','money')}${trow(t('s_general'),'','general')}${row(t('s_markall'),'','',"S.nread=true;toast('OK')")}</div>
<div class="stc"><div class="agt">${t('s_legal')}</div>${row(t('s_credit'),'','',"S.lg='cr';go('legal')")}${row(t('s_priv'),'','',"S.lg='pv';go('legal')")}${row(t('s_terms'),'','',"S.lg='tm';go('legal')")}</div>
<div class="pad" style="padding-top:24px;padding-bottom:6px"><button class="btn sec2" onclick="logOut()">${t('s_logout')}</button></div><span class="dl" onclick="go('deleteacct')">${T('Delete account','Gusiba konti','Supprimer le compte')}</span><div style="height:24px"></div>`};

/* ---------- text size ---------- */
screens.textsize=()=>`${ttl(t('s_text'))}${chp([0,1,2],S.ts,'tsSet',i=>[T('Default','Bisanzwe','Par défaut'),T('Large','Binini','Grand'),T('Largest','Binini cyane','Très grand')][i])}<div class="stc" style="margin-top:20px;padding:18px 24px"><b>${T('Preview','Ibigaragara','Aperçu')}</b><div style="margin-top:8px;line-height:22px">${T('Send 5,000 RWF to Eric M. today. It arrives within a minute and costs nothing.','Ohereza 5,000 RWF kuri Eric M. uyu munsi. Agerayo mu munota umwe kandi nta kiguzi.','Envoyez 5 000 RWF à Eric M. aujourd’hui. Il arrive en une minute, sans frais.')}</div></div>${note(T('Applies to every screen.','Bikoreshwa kuri ecran zose.','S’applique à tous les écrans.'))}`;
window.tsSet=i=>{S.ts=i;applyTs();render('fade-none')};

/* ---------- devices ---------- */
const WH=w=>[T('Active now','Arakora ubu','Actif maintenant'),T('3 days ago','Hashize iminsi 3','Il y a 3 jours'),T('2 weeks ago','Hashize ibyumweru 2','Il y a 2 semaines')][w];
screens.devices=()=>`${ttl(t('s_devices'))}<div class="stc" style="margin-top:4px">${S.dev.map(d=>`<div class="ar" style="cursor:default"><div style="flex:1;min-width:0"><div class="t">${esc(d.n)}${d.id===1?t('s_thisdev'):''}</div><div class="s">${esc(d.loc)} · ${WH(d.w)}</div></div>${d.id===1?'':`<button class="cch" style="height:40px;color:var(--er)" onclick="devAsk(${d.id})">${t('s_remove')}</button>`}</div>`).join('')}</div>${S.dev.length>1?`<div class="pad" style="padding-top:20px"><button class="btn sec2" onclick="devAll()">${T('Sign out all other devices','Sohora ku bindi bikoresho byose','Déconnecter tous les autres appareils')}</button></div>`:''}${note(T('A removed device must sign in again with your PIN.','Igikoresho cyakuweho kigomba kwinjira ukoresheje PIN yawe.','Un appareil retiré doit se reconnecter avec votre PIN.'))}`;
window.devAsk=id=>{const d=S.dev.find(x=>x.id===id);sh(`<div class="h1" style="font-size:22px;line-height:30px">${T('Remove ','Kuraho ','Retirer ')}${esc(d.n)}?</div><div class="mu" style="font-size:15px;margin:8px 0 24px;line-height:22px">${T('It will be signed out of itunda.','Izasohoka muri itunda.','Il sera déconnecté d’itunda.')}</div><div class="row2"><button class="btn sec2" onclick="closeSheet()">${T('Cancel','Hagarika','Annuler')}</button><button class="btn" style="background:#D92D20;color:#fff" onclick="devGo(${id})">${t('s_remove')}</button></div>`)};
window.devGo=id=>{S.dev=S.dev.filter(x=>x.id!==id);closeSheet();render('fade-none');toast(T('Device removed','Igikoresho cyakuweho','Appareil retiré'))};
window.devAll=()=>{S.dev=S.dev.filter(x=>x.id===1);render('fade-none');toast(T('Signed out other devices','Wasohoye ku bindi bikoresho','Autres appareils déconnectés'))};

/* ---------- send limits ---------- */
const ver=()=>S.vf&&S.vf.st==='verified';
screens.sendset=()=>`${ttl(T('Send limits','Imipaka yo kohereza','Plafonds d’envoi'))}${row(T('Daily limit','Imipaka ya buri munsi','Plafond journalier'),'',fmt(S.lim.day)+' RWF',"bkLim()")}<div class="pad" style="padding:22px 24px 0"><b>${T('Ask for my PIN above','Mbaza PIN iyo irenze','Demander mon PIN au-delà de')}</b></div>${chp([20000,50000,100000],S.lim.a,'limAsk',x=>fmt(x))}${note(ver()?T('You are verified, so every limit is open.','Wemejwe, imipaka yose irakora.','Vous êtes vérifié : tous les plafonds sont ouverts.'):T('Limits above 1,000,000 RWF need a verified identity.','Imipaka irenga 1,000,000 RWF isaba indangamuntu yemejwe.','Les plafonds au-delà de 1 000 000 RWF exigent une identité vérifiée.'))}`;
window.limSet=v=>{if(v>1000000&&!ver()){return sh(`<div class="g3" style="font-size:56px;line-height:1;margin-bottom:10px">🪪</div><div class="h1" style="font-size:22px;line-height:30px">${T('Verify to raise your limit','Emeza kugira ngo wongere imipaka','Vérifiez pour relever votre plafond')}</div><div class="mu" style="font-size:15px;margin:8px 0 24px;line-height:22px">${T('Limits above 1,000,000 RWF need a verified identity.','Imipaka irenga 1,000,000 RWF isaba indangamuntu yemejwe.','Les plafonds au-delà de 1 000 000 RWF exigent une identité vérifiée.')}</div><div class="row2"><button class="btn sec2" onclick="closeSheet()">${T('Not now','Ntabwo ubu','Pas maintenant')}</button><button class="btn" onclick="closeSheet();openSvc('verify')">${T('Verify','Emeza','Vérifier')}</button></div>`)}
S.lim.d=v;render('fade-none');toast(T('Daily limit saved','Imipaka yabitswe','Plafond enregistré'))};
window.limAsk=v=>{S.lim.a=v;render('fade-none');toast(T('Saved','Byabitswe','Enregistré'))};

/* ---------- payment settings ---------- */
screens.payset=()=>`${ttl(t('s_pay'))}<div class="pad" style="padding-top:0"><b>${T('Pay from','Ishyura ukoresheje','Payer depuis')}</b></div>${chp(['pay','bank'],S.src,'srcSet',k=>k==='pay'?T('Pay balance','Ikofi ryo kwishyura','Solde Payer'):T('Bank','Banki','Banque'))}<div class="stc" style="margin-top:22px">${trow(T('Tap to pay','Kwishyura ukoza','Payer sans contact'),T('Pay at shops by tapping your phone','Ishyura mu maduka ukoza telefone','Payez en magasin avec votre téléphone'),'tap')}${trow(T('Payment receipts','Inyemezabwishyu','Reçus de paiement'),T('Get a message after every payment','Bona ubutumwa nyuma ya buri kwishyura','Recevez un message après chaque paiement'),'rcpt')}</div>`;
window.srcSet=k=>{S.src=k;render('fade-none');toast(T('Saved','Byabitswe','Enregistré'))};

/* ---------- legal ---------- */
const LG={cr:['s_credit',['itunda uses your payment history to estimate your credit score.','Your score helps you qualify for loans. It is never sold.','You can ask to see or correct your data at any time.']],pv:['s_priv',['We collect only what we need to run your account.','We never sell your personal data.','You can delete your account and data from Settings.']],tm:['s_terms',['You must be 18 or older, or have a guardian linked.','Keep your PIN private. You are responsible for activity that uses it.','We may pause an account to protect it from fraud.']]};
screens.legal=()=>{const d=LG[S.lg];return `${ttl(t(d[0]))}<div class="pad" style="padding-top:0">${d[1].map(x=>`<div style="display:flex;gap:12px;font-size:16px;line-height:24px;margin-top:14px"><span style="color:var(--lk)">•</span><span>${x}</span></div>`).join('')}</div>${note(T('Summary for this prototype. The full text is not included.','Incamake ya prototype. Inyandiko yuzuye ntirimo.','Résumé pour ce prototype. Le texte complet n’est pas inclus.'))}`};

/* ---------- security: real rows ---------- */
const fix=(h,words,fn)=>words.reduce((a,w)=>a.replace(new RegExp('onclick="soon\\(\\)">(<div style="min-width:0;flex:1"><div class="t">'+w+')'),`onclick="${fn}">$1`),h);
const os=screens.security;screens.security=()=>fix(fix(os(),['Change PIN','Guhindura PIN','Changer le PIN'],'cpStart()'),[t('s_devices')],"go('devices')");

/* ---------- change PIN (6 digits) ---------- */
function cpDraw(){const F=S.cpf,s=F.step;
const ti=s==='cur'?T('Enter your current PIN','Andika PIN yawe y’ubu','Saisissez votre PIN actuel'):s==='new'?T('Choose a new PIN','Hitamo PIN nshya','Choisissez un nouveau PIN'):T('Confirm your new PIN','Emeza PIN nshya','Confirmez votre nouveau PIN');
const dots=[0,1,2,3,4,5].map(i=>`<span style="width:16px;height:16px;border-radius:8px;background:${i<F.buf.length?'var(--lk)':'var(--ln)'}"></span>`).join('');
const AR='<svg data-t26="1" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 12H4.5M10.5 5.5L4 12l6.5 6.5"/></svg>';
const keys=['1','2','3','4','5','6','7','8','9','','0','b'].map(k=>k===''?'<span></span>':`<button class="czk" aria-label="${k==='b'?T('Delete','Siba','Effacer'):k}" onclick="cpKey('${k}')">${k==='b'?AR:k}</button>`).join('');
sh(`<div class="bar"><button class="ib" aria-label="${T('Back','Subira inyuma','Retour')}" onclick="closeSheet()">${ic('back',24)}</button></div><div style="padding:12px 24px 0"><div style="font-size:22px;line-height:30px;font-weight:700">${ti}</div><div class="mu" style="font-size:15px;line-height:20px;margin-top:1px">${T('6 digits. Only you should know it.','Imibare 6. Ni wowe wenyine ugomba kuyizi.','6 chiffres. Vous seul devez le connaître.')}</div><div data-cpin="1" role="status" aria-label="${F.buf.length}/6" style="display:flex;gap:14px;margin:40px 0 0;min-height:30px;align-items:center">${dots}</div><div role="alert" class="mu" style="min-height:20px;margin-top:12px;font-size:14px;line-height:20px;font-weight:500;color:${F.err?'var(--er)':'var(--mu)'}">${esc(F.err||(S.lang==='en'?F.buf.length+' of 6 digits':''))}</div></div><button class="btn" id="czgo" ${F.buf.length<6?'disabled':''} onclick="cpGo()">${s==='conf'?T('Confirm','Emeza','Confirmer'):T('Continue','Komeza','Continuer')}</button><div class="keys tkpsh">${keys}</div>`)}
window.cpStart=()=>{S.cpf={step:'cur',buf:'',first:'',err:'',fails:0};cpDraw()};
window.cpKey=k=>{const F=S.cpf;if(F.busy)return;if(k==='b')F.buf=F.buf.slice(0,-1);else if(F.buf.length<6)F.buf+=k;F.err='';cpDraw()};
window.cpGo=()=>{const F=S.cpf;if(F.busy||F.buf.length<6)return;cpNext()};
function cpNext(){const F=S.cpf;
if(F.step==='cur'){if(S.apin&&F.buf!==S.apin){F.fails++;F.buf='';if(F.fails>=3){closeSheet();return toast(T('Too many wrong tries. Try again later.','Wagerageje kenshi nabi. Ongera nyuma.','Trop d’essais incorrects. Réessayez plus tard.'))}F.err=T('Wrong PIN. ','PIN siyo. ','PIN incorrect. ')+(3-F.fails)+T(' tries left.',' ugerageza hasigaye.',' essais restants.');return cpDraw()}F.buf='';F.step='new';return cpDraw()}
if(F.step==='new'){if(S.apin&&F.buf===S.apin){F.buf='';F.err=T('Choose a different PIN.','Hitamo PIN itandukanye.','Choisissez un PIN différent.');return cpDraw()}F.first=F.buf;F.buf='';F.step='conf';return cpDraw()}
if(F.buf===F.first){S.apin=F.buf;closeSheet();toast(T('PIN changed','PIN yahinduwe','PIN modifié'))}else{F.buf='';F.first='';F.step='new';F.err=T('PINs did not match. Start again.','PIN ntizihuye. Ongera utangire.','Les PIN ne correspondent pas. Recommencez.');cpDraw()}}
document.addEventListener('keydown',e=>{if(!S.cpf||!document.querySelector('#layer .sheet [data-cpin]'))return;if(/^\d$/.test(e.key))cpKey(e.key);else if(e.key==='Backspace')cpKey('b')});
})();
</script>
<script>
/* v88: Marketplace round 2: filters, delivery option, seller profiles + ratings, report/share, edit price, bought history, sell details */
(function(){
const T=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e;
const esc=s=>String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/"/g,'&quot;');
const sh=h=>{$('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet">'+h+'</div>'};
const H=HD.market;
if(!S.mxInit){S.mxInit=1;S.mxf={cond:[],max:0};S.mxd=0;S.mxRate={};S.mxHide={};S.mxs={c:'Electronics',cd:'good',t:'',p:'',d:''};H.cats=['All','Electronics','Phones','Home','Fashion','Kids','Sports','Saved','Bought','Mine']}
const FEE=2000;
const CL=()=>({All:T('All','Byose','Tout'),Electronics:T('Electronics','Ibikoresho by’ikoranabuhanga','Électronique'),Home:T('Home','Mu rugo','Maison'),Fashion:T('Fashion','Imyambarire','Mode'),Phones:T('Phones','Telefoni','Téléphones'),Kids:T('Kids','Abana','Enfants'),Sports:T('Sports','Siporo','Sport'),Saved:T('Saved','Ibibitswe','Enregistrés'),Bought:T('Bought','Ibyaguzwe','Achats'),Mine:T('Mine','Ibyanjye','Mes annonces')});
const CD=()=>({new:T('New','Gishya','Neuf'),like:T('Like new','Nka gishya','Comme neuf'),good:T('Good','Meza','Bon'),fair:T('Fair','Biremewe','Correct')});
const SORT=()=>[T('Newest','Bishya','Récents'),T('Price ↑','Igiciro ↑','Prix ↑'),T('Price ↓','Igiciro ↓','Prix ↓')];
const item=id=>H.items.find(x=>x.id===id);
const ord=id=>S.mkO.find(o=>o.id===id&&o.st==='held');
const hash=s=>[...s].reduce((a,c)=>(a*31+c.charCodeAt(0))%9973,7);
function seller(n){if(n==='You')return{n:'You',r:0,c:S.mxRate.You?S.mxRate.You.length:0,sold:H.items.filter(x=>x.who==='You'&&x.st==='sold').length,y:2026};
const h=hash(n),base=4.3+(h%7)/10,bn=4+h%20,rs=S.mxRate[n]||[],tot=bn+rs.length;
return{n,r:(base*bn+rs.reduce((a,b)=>a+b,0))/tot,c:tot,sold:3+h%20,y:2022+h%3}}
const stars=r=>'★'.repeat(Math.round(r))+'☆'.repeat(5-Math.round(r));
const nF=()=>S.mxf.cond.length+(S.mxf.max?1:0)+(S.mxf.hood?1:0);
const chips=()=>`<button class="cch" style="border:2px solid var(--ln);background:none" onclick="mxFilt()">⚙ ${T('Filter','Hitamo','Filtrer')}${nF()?' · '+nF():''}</button><button class="cch" id="mxsort" style="border:2px solid var(--ln);background:none" aria-label="${T('Sort','Tondeka','Trier')}" onclick="mxSort()">↕ ${SORT()[S.mkSort]}</button>`+H.cats.map(c=>`<button class="cch ${S.mkCat===c?'on':''}" onclick="mxCat('${c}')">${CL()[c]}</button>`).join('');
function rows(){const q=S.mkQ.trim().toLowerCase(),c=S.mkCat,F=S.mxf;
let l=H.items.filter(x=>!S.mxHide[x.id]&&(c==='All'||x.c===c||(c==='Saved'&&S.hdFav['market:'+x.id])||(c==='Mine'&&x.who==='You')||(c==='Bought'&&S.mkO.some(o=>o.id===x.id&&o.st==='done')))&&(!F.cond.length||F.cond.includes(x.cond))&&(!F.max||x.p<=F.max)&&(!F.hood||x.sub.split(' · ')[0]===F.hood)&&(!q||(x.ti+' '+x.sub).toLowerCase().includes(q)));
if(S.mkSort===1)l=l.slice().sort((a,b)=>a.p-b.p);else if(S.mkSort===2)l=l.slice().sort((a,b)=>b.p-a.p);
if(!l.length)return `<div class="pad mu" style="padding-top:30px;text-align:center;line-height:22px">${c==='Saved'?T('Tap the heart on a listing to save it here.','Kanda umutima ku kintu ugibike hano.','Touchez le cœur d’une annonce pour l’enregistrer ici.'):c==='Bought'?T('Things you buy with itunda show up here.','Ibyo uguze na itunda bigaragara hano.','Vos achats avec itunda apparaissent ici.'):c==='Mine'?T('You have not listed anything yet.','Nta cyo urashyiraho.','Vous n’avez encore rien publié.'):T('No matches. Try fewer filters.','Nta bihuye. Gerageza amahitamo make.','Aucun résultat. Essayez moins de filtres.')}</div>`;
return l.map(x=>`<div class="hdc" role="button" tabindex="0" style="${x.st==='sold'?'opacity:.55':''}" onclick="hdOpen('market',${x.id})"><div class="th">${gl(x.g,44)}</div><div style="flex:1;min-width:0"><div class="t">${esc(x.ti)}</div><div class="s">${esc(x.sub)} · ${CD()[x.cond]}</div><div class="pr">${fmt(x.p)} RWF${x.st==='sold'?' · '+T('Sold','Yagurishijwe','Vendu'):x.st==='reserved'?' · '+T('Reserved','Yabitswe','Réservé'):''}</div></div>${hdHeart('market',x.id)}</div>`).join('')}
const ordBox=()=>S.mkO.filter(o=>o.st==='held').map(o=>`<div style="margin:12px 24px 0;padding:14px 16px;border-radius:20px;background:var(--tint)"><b>${esc(item(o.id).ti)}</b><div class="sm mu" style="margin-top:2px">${o.dl?T('Courier on the way. ','Umushoferi ari mu nzira. ','Coursier en route. '):''}${T('Payment held. Release it when you have the item.','Amafaranga arabitswe. Yarekure ubonye ikintu.','Paiement retenu. Libérez-le quand vous avez l’article.')}</div><div style="display:flex;gap:10px;margin-top:10px"><button class="cch" style="height:44px;background:var(--lk);color:var(--on)" onclick="mkConfirm(${o.id})">${T('Confirm pickup','Emeza ko wabonye','Confirmer le retrait')}</button><button class="cch" style="height:44px" onclick="mkCancel(${o.id})">${T('Cancel and refund','Hagarika usubizwe','Annuler et rembourser')}</button></div></div>`).join('');
const oh=screens.hood;screens.hood=()=>{if(S.hd!=='market')return oh();
return `${bar(H.t)}<div style="padding:12px 24px 0"><input id="mxq" type="search" aria-label="${T('Search listings','Shakisha','Rechercher')}" placeholder="${T('Search listings','Shakisha','Rechercher')}" value="${esc(S.mkQ)}" oninput="mxSearch(this.value)" style="width:100%;height:44px;border-radius:22px;border:0;background:var(--chip);color:var(--tx);font:inherit;font-size:15px;padding:0 16px"></div><div class="chips" style="padding-top:12px" id="mxch">${chips()}</div><div id="mxord">${ordBox()}</div><div style="padding-top:8px" id="mxl">${rows()}</div><div class="pad fine" style="padding-top:18px">${T('Listings are sample data for this prototype.','Ibyatanzwe ni ibigerageza muri prototype.','Les annonces sont des données d’exemple.')}</div><div class="fab"><button class="btn" onclick="hdPost()">${T('Sell something','Gurisha ikintu','Vendre un article')}</button></div>`};
const rf=()=>{if($('#mxl'))$('#mxl').innerHTML=rows();if($('#mxch'))$('#mxch').innerHTML=chips()};
window.mxSearch=v=>{S.mkQ=v;$('#mxl').innerHTML=rows()};
window.mxSort=()=>{S.mkSort=(S.mkSort+1)%3;rf()};
window.mxCat=c=>{S.mkCat=c;rf()};
const oht=window.hdTg;window.hdTg=(t,id)=>{oht(t,id);if(t==='market'&&S.mkCat==='Saved')rf()};

/* ---------- filter sheet ---------- */
const fN=()=>H.items.filter(x=>!S.mxHide[x.id]&&(!S.mxf.cond.length||S.mxf.cond.includes(x.cond))&&(!S.mxf.max||x.p<=S.mxf.max)&&(!S.mxf.hood||x.sub.split(' · ')[0]===S.mxf.hood)).length;
function fDraw(){const F=S.mxf;
sh(`<div class="h1" style="font-size:22px;line-height:30px">${T('Filter','Hitamo','Filtrer')}</div><div class="lab" style="margin-top:14px">${T('Condition','Imiterere','État')}</div><div class="chp" style="padding:8px 0 0;flex-wrap:wrap;overflow:visible">${Object.keys(CD()).map(c=>`<button class="${F.cond.includes(c)?'on':''}" aria-pressed="${F.cond.includes(c)}" onclick="mxFc('${c}')">${CD()[c]}</button>`).join('')}</div><div class="lab">${T('Max price','Igiciro ntarengwa','Prix maximum')}</div><div class="chp" style="padding:8px 0 0;flex-wrap:wrap;overflow:visible">${[0,20000,50000,100000].map(m=>`<button class="${F.max===m?'on':''}" onclick="mxFm(${m})">${m?fmt(m):T('Any','Byose','Tous')}</button>`).join('')}</div><div class="lab">${T('Area','Agace','Quartier')}</div><div class="chp" style="padding:8px 0 0;flex-wrap:wrap;overflow:visible">${window.MXAREAS.map(a=>`<button class="${F.hood===a?'on':''}" aria-pressed="${F.hood===a}" onclick="mxFh('${a}')">${a}</button>`).join('')}</div><div class="row2" style="margin-top:22px"><button class="btn sec2" onclick="mxFr()">${T('Reset','Subiramo','Réinitialiser')}</button><button class="btn" onclick="closeSheet();rf2()">${T('Show ','Erekana ','Voir ')}${fN()}</button></div>`)}
window.rf2=rf;window.mxFilt=()=>fDraw();
window.mxFc=c=>{const a=S.mxf.cond,i=a.indexOf(c);i<0?a.push(c):a.splice(i,1);fDraw()};
window.mxFm=m=>{S.mxf.max=m;fDraw()};
window.mxFr=()=>{S.mxf={cond:[],max:0,hood:''};fDraw()};

/* ---------- detail ---------- */
const oi=screens.hoodItem;screens.hoodItem=()=>{if(S.hd!=='market')return oi();
const x=item(S.hdI),mine=x.who==='You',sold=x.st==='sold',held=ord(x.id),res=x.st==='reserved'&&!held,s=seller(x.who);
const chip=t=>`<span style="padding:5px 12px;border-radius:14px;background:var(--chip);font-size:13px;font-weight:700">${t}</span>`;
const cta=mine?`<div class="cta" style="display:flex;gap:10px"><button class="btn sec2" style="flex:0 0 auto;width:auto;padding:0 20px;color:var(--er)" onclick="mkDel(${x.id})">${T('Delete','Siba','Supprimer')}</button><button class="btn" ${sold?'disabled':''} onclick="mkSold(${x.id})">${sold?T('Sold','Yagurishijwe','Vendu'):T('Mark as sold','Emeza ko yagurishijwe','Marquer comme vendu')}</button></div>`
:held?`<div class="cta" style="display:flex;gap:10px"><button class="btn sec2" style="flex:0 0 auto;width:auto;padding:0 20px" onclick="mkCancel(${x.id})">${T('Cancel','Hagarika','Annuler')}</button><button class="btn" onclick="mkConfirm(${x.id})">${T('Confirm pickup','Emeza ko wabonye','Confirmer le retrait')}</button></div>`
:`<div class="cta" style="display:flex;gap:10px"><button class="btn sec2" style="flex:0 0 auto;width:auto;padding:0 20px" onclick="hdChat('market',${x.id})">${T('Message','Ohereza ubutumwa','Message')}</button><button class="btn" ${sold||res?'disabled':''} onclick="mkBuy(${x.id})">${sold?T('Sold','Yagurishijwe','Vendu'):res?T('Reserved','Yabitswe','Réservé'):T('Buy · ','Gura · ','Acheter · ')+fmt(x.p)+' RWF'}</button></div>`;
const link=(t,fn,c)=>`<button style="border:0;background:none;font:inherit;font-size:14px;font-weight:700;color:${c||'var(--lk)'};padding:10px 0;min-height:44px;margin-right:18px" onclick="${fn}">${t}</button>`;
return `${bar(H.t)}<div style="padding:12px 24px 0"><div class="pim" style="aspect-ratio:auto;height:230px;border-radius:28px;position:relative">${gl(x.g,112)}</div></div><div class="pad" style="padding-top:20px"><div style="display:flex;justify-content:space-between;align-items:flex-start;gap:8px"><div style="font-size:22px;font-weight:800;letter-spacing:-.4px;line-height:29px">${esc(x.ti)}</div>${hdHeart('market',x.id)}</div><div class="sm mu" style="margin-top:6px">${esc(x.sub)}</div><div style="font-size:24px;font-weight:800;margin-top:14px">${fmt(x.p)} RWF</div><div style="display:flex;gap:8px;margin-top:12px">${chip(CD()[x.cond])}${chip(CL()[x.c])}</div><div style="font-size:15px;line-height:23px;margin-top:14px">${esc(x.d)}</div>
${mine?`<div class="sm mu" style="margin-top:14px">👁 ${12+x.id%30} ${T('views','abarebye','vues')} · ♥ ${x.id%6} ${T('saves','abayibitse','enregistrements')}</div>${sold?'':link(T('Edit listing','Hindura icyashyizweho','Modifier l’annonce'),`mxEdit(${x.id})`)}`:sold||held||res?'':`<button class="btn sec2" style="height:48px;margin-top:16px" onclick="mkOffer(${x.id})">${T('Make an offer','Tanga igiciro','Faire une offre')}</button><div class="sm mu" style="margin-top:12px;line-height:20px">🔒 ${T('Buy with itunda: your money is held until you confirm pickup.','Gura na itunda: amafaranga abikwa kugeza wemeje ko wabonye ikintu.','Achetez avec itunda : votre argent est retenu jusqu’au retrait confirmé.')}</div>`}
<div class="tap" role="button" tabindex="0" style="display:flex;align-items:center;gap:12px;margin-top:20px;padding-top:16px;border-top:0;cursor:pointer" onclick="mxSeller('${esc(x.who).replace(/'/g,'')}')">${gl('community',40)}<div style="flex:1"><div style="font-weight:800">${esc(x.who)}</div><div class="sm mu">${mine?T('Your listing','Icyo washyize ku isoko','Votre annonce'):`<span style="color:var(--ok)">${stars(s.r)}</span> ${s.r.toFixed(1)} · ${s.c} ${T('reviews','ibitekerezo','avis')}`}</div></div>${ic('chev',16,'var(--tt)')}</div>
${mine?'':`<div style="margin-top:4px">${link(T('Share','Sangiza','Partager'),`mxShare(${x.id})`)}${link(T('Report','Tanga raporo','Signaler'),`mxReport(${x.id})`,'var(--er)')}</div>`}</div>${cta}`};

/* ---------- seller, share, report, edit price ---------- */
window.mxSeller=n=>{if(n==='You')return;const s=seller(n),k=H.items.filter(x=>x.who===n&&!x.st).length;
sh(`<div style="display:flex;align-items:center;gap:14px">${gl('community',52)}<div><div class="h1" style="font-size:22px;line-height:28px">${esc(n)}</div><div style="color:var(--ok)">${stars(s.r)} <span class="mu">${s.r.toFixed(1)} · ${s.c} ${T('reviews','ibitekerezo','avis')}</span></div></div></div><div style="margin:18px -24px 22px">${[[T('Items sold','Ibyagurishijwe','Articles vendus'),s.sold],[T('Active listings','Ibiriho','Annonces actives'),k],[T('On itunda since','Kuri itunda guhera','Sur itunda depuis'),s.y]].map(r=>`<div style="display:flex;justify-content:space-between;padding:14px 24px;border-top:0;font-size:15px"><span class="mu">${r[0]}</span><b>${r[1]}</b></div>`).join('')}</div><button class="btn" onclick="closeSheet()">OK</button>`)};
window.mxShare=id=>{const l='itunda.rw/m/'+id;try{navigator.clipboard.writeText(l)}catch(e){}toast(T('Link copied: ','Ihuza ryakopowe: ','Lien copié : ')+l)};
window.mxReport=id=>{const R=[T('Scam or fake','Uburiganya cyangwa igihimbano','Arnaque ou faux'),T('Not allowed on itunda','Ntiyemewe kuri itunda','Interdit sur itunda'),T('Wrong category','Icyiciro kitari cyo','Mauvaise catégorie'),T('Something else','Ikindi','Autre chose')];
sh(`<div class="h1" style="font-size:22px;line-height:30px;margin-bottom:6px">${T('Report this listing','Tanga raporo kuri iki kintu','Signaler cette annonce')}</div>${R.map(r=>`<div class="ar tap" style="padding:16px 0;min-height:56px" onclick="mxRepGo(${id})"><div class="t" style="flex:1">${r}</div>${ic('chev',16,'var(--tt)')}</div>`).join('')}`)};
window.mxRepGo=id=>{S.mxHide[id]=1;closeSheet();back();toast(T('Thanks. We will review it.','Murakoze. Turabisuzuma.','Merci. Nous allons l’examiner.'))};
window.mxEdit=id=>{const x=item(id);sh(`<div class="h1" style="font-size:22px;line-height:30px">${T('Edit price','Hindura igiciro','Modifier le prix')}</div><div class="lab">${T('Price (RWF)','Igiciro (RWF)','Prix (RWF)')}</div><input class="in" id="mxep" inputmode="numeric" value="${fmt(x.p)}" oninput="this.value=this.value.replace(/\\D/g,'').replace(/\\B(?=(\\d{3})+(?!\\d))/g,',')" style="font-size:17px;height:46px"><button class="btn" style="margin-top:22px" onclick="mxEditGo(${id})">${T('Save','Bika','Enregistrer')}</button>`)};
window.mxEditGo=id=>{const v=Number(($('#mxep').value||'').replace(/,/g,''));if(!v)return toast(T('Add a price','Shyiraho igiciro','Ajoutez un prix'));item(id).p=v;closeSheet();render('fade-none');toast(T('Price updated','Igiciro cyahinduwe','Prix mis à jour'))};

/* ---------- buy with delivery ---------- */
window.mkBuy=id=>{const x=item(id);S.mxd=0;bDraw(id)};
function bDraw(id){const x=item(id),tot=x.p+(S.mxd?FEE:0),bad=tot>S.bank;
sh(`<div class="h1" style="font-size:22px;line-height:30px">${T('Buy with itunda','Gura na itunda','Acheter avec itunda')}</div><div class="mu" style="font-size:15px;margin:8px 0 0">${esc(x.ti)}</div><div class="chp" style="padding:14px 0 0">${[T('Pickup · Free','Kujyana · Ku buntu','Retrait · Gratuit'),T('Courier · ','Umushoferi · ','Coursier · ')+fmt(FEE)+' RWF'].map((l,i)=>`<button class="${S.mxd===i?'on':''}" onclick="mxDl(${id},${i})">${l}</button>`).join('')}</div><div style="margin-top:16px;display:flex;justify-content:space-between;font-size:16px"><span class="mu">${T('Total','Yose hamwe','Total')}</span><b>${fmt(tot)} RWF</b></div><div style="display:flex;justify-content:space-between;font-size:16px;margin-top:8px"><span class="mu">${T('Your balance','Amafaranga ufite','Votre solde')}</span><b>${fmt(S.bank)} RWF</b></div><div class="sm mu" style="margin:14px 0 22px;line-height:20px">🔒 ${T('We hold your payment. The seller is paid when you confirm you have the item.','Duhagarika amafaranga yawe. Umugurisha yishyurwa wemeje ko wabonye ikintu.','Nous retenons votre paiement. Le vendeur est payé quand vous confirmez avoir l’article.')}</div><button class="btn" ${bad?'disabled':''} onclick="mkPay(${id})">${T('Pay ','Ishyura ','Payer ')}${fmt(tot)} RWF</button>${bad?`<div style="color:var(--er);font-size:14px;margin-top:10px">${T('Not enough balance.','Amafaranga ntahagije.','Solde insuffisant.')}</div>`:''}`)}
window.mxDl=(id,i)=>{S.mxd=i;bDraw(id)};
window.mkPay=id=>{const x=item(id),tot=x.p+(S.mxd?FEE:0);if(tot>S.bank)return;S.bank-=tot;x.st='reserved';S.mkO.push({id,p:tot,st:'held',dl:S.mxd});
if(typeof addAct==='function')addAct('bag','Marketplace · '+x.ti,'Paid',-tot,'Paid');
closeSheet();render('fade-none');toast(T('Paid. Held until you confirm.','Byishyuwe. Bibitswe kugeza wemeje.','Payé. Retenu jusqu’à confirmation.'))};

/* ---------- confirm + rate seller ---------- */
window.mkConfirm=id=>{const o=ord(id);if(!o)return;o.st='done';const x=item(id);x.st='sold';render('fade-none');
sh(`<div class="g3" style="font-size:56px;line-height:1;margin-bottom:10px">✅</div><div class="h1" style="font-size:22px;line-height:30px">${T('Payment released','Amafaranga yahawe umugurisha','Paiement versé')}</div><div class="mu" style="font-size:15px;margin:8px 0 14px">${T('How was ','Byari bimeze bite kuri ','Comment était ')}${esc(x.who)}?</div><div style="display:flex;justify-content:center;gap:6px;margin-bottom:18px">${[1,2,3,4,5].map(n=>`<button aria-label="${n}" style="width:52px;height:52px;border:0;background:none;font-size:34px;color:var(--ok)" onclick="mxStar('${esc(x.who).replace(/'/g,'')}',${n})">★</button>`).join('')}</div><button class="btn sec2" onclick="closeSheet()">${T('Skip','Simbuka','Passer')}</button>`)};
window.mxStar=(n,v)=>{(S.mxRate[n]=S.mxRate[n]||[]).push(v);closeSheet();toast(T('Thanks for rating ','Murakoze gutanga amanota kuri ','Merci d’avoir noté ')+n)};

/* ---------- sell with details ---------- */
const GL={Electronics:'airtime',Phones:'airtime',Home:'house',Fashion:'bag',Kids:'gift',Sports:'bolt'};
const ohp=window.hdPost;
function sDraw(){const F=S.mxs;
sh(`<div class="h1" style="font-size:22px;line-height:30px">${T('Sell something','Gurisha ikintu','Vendre un article')}</div><div class="lab" style="margin-top:6px">${T('Title','Umutwe','Titre')}</div><input class="in" id="mxt" value="${esc(F.t)}" oninput="mxChk()" placeholder="${T('What are you selling?','Uragurisha iki?','Que vendez-vous ?')}" style="font-size:17px;height:46px"><div class="lab">${T('Price (RWF)','Igiciro (RWF)','Prix (RWF)')}</div><input class="in" id="mxp" value="${esc(F.p)}" inputmode="numeric" oninput="mxChk()" placeholder="25,000" style="font-size:17px;height:46px"><div class="lab">${T('Category','Icyiciro','Catégorie')}</div><div class="chp" style="padding:8px 0 0">${(window.MXCATS).map(c=>`<button class="${F.c===c?'on':''}" onclick="mxSet('c','${c}')">${CL()[c]}</button>`).join('')}</div><div class="lab">${T('Condition','Imiterere','État')}</div><div class="chp" style="padding:8px 0 0">${Object.keys(CD()).map(c=>`<button class="${F.cd===c?'on':''}" onclick="mxSet('cd','${c}')">${CD()[c]}</button>`).join('')}</div><div class="lab">${T('Details (optional)','Ibisobanuro (si ngombwa)','Détails (facultatif)')}</div><textarea id="mxd" oninput="mxChk()" aria-label="${T('Details','Ibisobanuro','Détails')}" style="width:100%;height:76px;margin-top:6px;border:0;border-radius:16px;background:var(--chip);padding:12px;font:inherit;font-size:15px;color:var(--tx);outline:0;resize:none">${esc(F.d)}</textarea><button class="btn" id="mxgo" style="margin-top:18px" disabled onclick="mxPostGo()">${T('Post','Shyiraho','Publier')}</button>`);mxChk()}
window.hdPost=()=>{if(S.hd!=='market')return ohp();S.mxs={c:'Electronics',cd:'good',t:'',p:'',d:''};sDraw()};
function rd(){const F=S.mxs,t=$('#mxt'),p=$('#mxp'),d=$('#mxd');if(t)F.t=t.value;if(d)F.d=d.value;if(p){F.p=p.value.replace(/\D/g,'').replace(/\B(?=(\d{3})+(?!\d))/g,',');p.value=F.p}return F}
window.mxChk=()=>{const F=rd(),b=$('#mxgo');if(b)b.disabled=!(F.t.trim()&&Number(F.p.replace(/,/g,''))>0)};
window.mxSet=(k,v)=>{rd();S.mxs[k]=v;sDraw()};
window.mxPostGo=()=>{const F=rd(),p=Number(F.p.replace(/,/g,''));if(!F.t.trim()||!p)return;
H.items.unshift({id:Date.now()%100000,ti:F.t.trim(),sub:T('Your listing · Just now','Icyawe · Ubu','Votre annonce · À l’instant'),p,g:GL[F.c],c:F.c,who:'You',cond:F.cd,d:F.d.trim()||T('Contact the seller to arrange pickup.','Vugana n’umugurisha mwemeranye aho muhurira.','Contactez le vendeur pour organiser le retrait.')});
S.hdMine.market++;S.mkCat='Mine';closeSheet();render('fade-none');toast(T('Posted','Byashyizweho','Publié'))};
})();
</script>
<script>
/* v89: Eats round 2: filters (open now, rating, distance), delivery address picker, scheduled delivery, item detail with preferences, receipts, order help. rw strings need native review */
(function(){
const T=(e,f,r)=>({en:e,fr:f,rw:r}[S.lang]||e);
const esc=s=>String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/"/g,'&quot;');
const q$=s=>document.querySelector(s);
const sh=h=>{$('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" style="max-height:82%;overflow-y:auto">'+h+'</div>'};
const H1='class="h1" style="font-size:22px;line-height:30px"';
const INP='style="width:100%;box-sizing:border-box;height:44px;border-radius:14px;border:0;background:var(--chip);padding:0 14px;font:inherit;color:inherit"';
Object.assign(S,{eflt:{open:0,top:0,near:0},eaddrs:[['Home','Kimironko, KG 11 Ave','Kimironko, Kigali'],['Work','Kacyiru, KG 7 Ave','Kacyiru, Kigali']],eai:0,esched:null,eik:0,eiq:1,eipf:[],ehr:-1,ehn:0});
const addr=()=>S.eaddrs[S.eai]||S.eaddrs[0];
const lbl=a=>({Home:T('Home','Maison','Mu rugo'),Work:T('Work','Travail','Ku kazi'),Other:T('Other','Autre','Ahandi')}[a[0]]||a[0]);
const mine=()=>S.orders.filter(o=>o.k==='Eats order'&&o.items);
const cur=()=>S.orders.find(o=>o.k==='Eats order');
/* ---- filters ---- */
const HRS=[[6.5,20],[10,22.5],[8,21],[7,19]];
const isOpen=i=>{const d=new Date(),h=d.getHours()+d.getMinutes()/60,x=HRS[i]||HRS[0];return h>=x[0]&&h<x[1]};
window.eFltOk=(r,i)=>{const f=S.eflt;return !((f.top&&r.r<4.7)||(f.near&&r.d>2)||(f.open&&!isOpen(i)))};
const fltH=()=>`<div class="chips" id="eflt" style="padding-top:14px;gap:6px">${[['open',T('Open now','Ouvert','Irakinguye')],['top','★ 4.7+'],['near',T('Under 2 km','Moins de 2 km','Munsi ya km 2')]].map(([k,l])=>`<button class="cch ${S.eflt[k]?'on':''}" aria-pressed="${!!S.eflt[k]}" onclick="eFlt('${k}')">${l}</button>`).join('')}</div>`;
window.eFlt=k=>{S.eflt[k]=S.eflt[k]?0:1;render('fade-none')};
/* ---- address picker ---- */
window.eAddr=()=>aDraw();
const aDraw=()=>sh(`<div ${H1}>${T('Delivery address','Adresse de livraison','Aho bigezwa')}</div><div role="radiogroup" aria-label="${T('Delivery address','Adresse de livraison','Aho bigezwa')}" style="padding-top:6px">${S.eaddrs.map((a,i)=>`<button role="radio" aria-checked="${S.eai===i}" onclick="eAddrPick(${i})" style="display:flex;width:100%;align-items:center;gap:12px;border:0;background:none;font:inherit;color:inherit;text-align:left;padding:12px 0;border-bottom:0"><span style="flex:1"><b>${esc(lbl(a))}</b><div class="sm mu">${esc(a[1])}</div></span><span aria-hidden="true" style="width:22px;height:22px;border-radius:11px;box-sizing:border-box;border:2px solid ${S.eai===i?'var(--lk)':'var(--tt)'};background:${S.eai===i?'var(--lk)':'none'}"></span></button>`).join('')}</div>${S.eaddrs.length<5?`<div style="margin-top:16px"><input id="eanew" maxlength="40" aria-label="${T('New address','Nouvelle adresse','Aderesi nshya')}" placeholder="${T('Street or landmark, e.g. Remera, KG 5 Ave','Rue ou repère, ex. Remera, KG 5 Ave','Umuhanda cyangwa ahazwi, urugero Remera, KG 5 Ave')}" ${INP}><button class="btn" style="margin-top:10px" onclick="eAddrAdd()">${T('Add and use','Ajouter et utiliser','Ongeraho kandi uyikoreshe')}</button></div>`:''}<button class="btn sec2" style="margin-top:10px" onclick="closeSheet()">${T('Close','Fermer','Funga')}</button><div class="fine" style="padding-top:10px">${T('Sample addresses for this prototype.','Adresses d’exemple pour ce prototype.','Aderesi z’urugero muri iki kigereranyo.')}</div>`);
window.eAddrPick=i=>{S.eai=i;S.addrOk=true;closeSheet();render('fade-none');toast(T('Address updated','Adresse mise à jour','Aderesi yahinduwe'))};
window.eAddrAdd=()=>{const v=(q$('#eanew').value||'').trim();if(!v){toast(T('Enter an address first','Saisissez d’abord une adresse','Banza wandike aderesi'));return}S.eaddrs.push(['Other',v,v.split(',')[0].trim()+', Kigali']);S.eai=S.eaddrs.length-1;S.addrOk=true;closeSheet();render('fade-none');toast(T('Address added','Adresse ajoutée','Aderesi yongeweho'))};
/* ---- schedule ---- */
const slots=()=>{const d=new Date(Date.now()+45*60000);const m=Math.ceil((d.getHours()*60+d.getMinutes())/30)*30,o=[];for(let i=0;i<4;i++){const t=m+i*30;if(t>=1440)break;o.push(String(Math.floor(t/60)).padStart(2,'0')+':'+String(t%60).padStart(2,'0'))}return o};
window.eSched=v=>{S.esched=v;render('fade-none')};
const schedH=()=>`<div class="pad" style="padding-top:16px"><div style="font-size:15px;font-weight:800;margin-bottom:10px">${S.pickup?T('Pickup time','Heure de retrait','Igihe cyo gufata'):T('Delivery time','Heure de livraison','Igihe cyo kugezwaho')}</div><div class="chips" style="padding:0;gap:6px"><button class="cch ${S.esched?'':'on'}" aria-pressed="${!S.esched}" onclick="eSched(null)">${T('As soon as possible','Dès que possible','Vuba bishoboka')}</button>${slots().map(t=>`<button class="cch ${S.esched===t?'on':''}" aria-pressed="${S.esched===t}" onclick="eSched('${t}')">${t}</button>`).join('')}</div>${S.pickup?'':`<div style="padding-top:10px"><button class="cch" onclick="eAddr()">${T('Change address','Changer d’adresse','Hindura aderesi')}</button></div>`}</div>`;
/* ---- screen wrappers ---- */
const _s=screens.shop;
screens.shop=()=>{let h=_s();if(S.shopTab!=='eats')return h;const a=addr();
h=h.replace(/Kimironko, KG 11 Ave/g,a[1]).replace('Kimironko, Kigali',esc(a[2]));
h=h.replace('<div class="pad" style="padding-top:16px;display:flex;align-items:center;gap:6px;font-weight:800;font-size:17px">','<div class="pad tap" role="button" tabindex="0" aria-label="'+T('Change delivery address','Changer l’adresse de livraison','Hindura aderesi')+'" onclick="eAddr()" style="cursor:pointer;padding-top:16px;display:flex;align-items:center;gap:6px;font-weight:800;font-size:17px">');
return h.replace('<div class="chips" style="padding-top:20px" id="esort"',fltH()+'<div class="chips" style="padding-top:20px" id="esort"')};
const _c=screens.echeck;
screens.echeck=()=>{let h=_c();const a=addr(),r=REST[S.er];
h=h.replace(/Kimironko, KG 11 Ave/g,a[1]).replace('<div style="font-size:15px;font-weight:800">Home</div>','<div style="font-size:15px;font-weight:800">'+esc(lbl(a))+'</div>');
const mk='<div class="pad" style="padding-top:20px"><div style="font-size:17px;font-weight:800">'+r.n+'</div>';
return h.includes(mk)?h.replace(mk,schedH()+mk):h};
const _t=screens.etrack;
screens.etrack=()=>{let h=_t();const o=cur(),r=REST[S.er];h=h.replace(/Kimironko, KG 11 Ave/g,(o&&o.addr)||addr()[1]);
if(o&&o.sched)h=h.replace(r.n+' · ',T('Scheduled','Prévue','Giteganyijwe')+' '+o.sched+' · '+r.n+' · ');return h};
const _e=screens.erest;
screens.erest=()=>{let h=_e(),i=-1;return h.replace(/<div class="mi"><div style="flex:1;min-width:0">/g,()=>{i++;return `<div class="mi"><div class="tap" role="button" tabindex="0" onclick="eItem(${i})" style="flex:1;min-width:0;cursor:pointer">`})};
/* ---- item detail ---- */
const PF=()=>[T('No onions','Sans oignons','Nta yinzari'),T('Extra spicy','Plus épicé','Pilipili nyinshi'),T('Less salt','Moins de sel','Umunyu muke'),T('No sugar','Sans sucre','Nta sukari')];
window.eItem=k=>{S.eik=k;S.eiq=Math.max(1,S.ecart[k]?1:1);S.eipf=[];iDraw()};
const iDraw=()=>{const it=REST[S.er].items[S.eik],q=S.eiq;sh(`<div style="display:flex;gap:14px;align-items:center"><div class="ico" style="width:72px;height:72px;border-radius:20px">${gl(it[3],56)}</div><div style="flex:1;min-width:0"><div ${H1}>${esc(it[0])}</div><div style="font-weight:800;margin-top:2px">${fmt(it[2])} RWF</div></div></div>${it[1]?`<div class="mu" style="font-size:15px;line-height:21px;margin-top:12px">${esc(it[1])}</div>`:''}<div style="font-size:15px;font-weight:800;margin:18px 0 10px">${T('Preferences','Préférences','Ibyo ukunda')}</div><div class="chips" style="padding:0;flex-wrap:wrap;gap:6px">${PF().map((l,j)=>`<button class="cch ${S.eipf.includes(j)?'on':''}" aria-pressed="${S.eipf.includes(j)}" onclick="eIp(${j})">${l}</button>`).join('')}</div><div style="display:flex;align-items:center;justify-content:center;gap:18px;margin:20px 0 14px"><button class="ib" aria-label="${T('Remove one','Retirer un','Kuraho kimwe')}" ${q<=1?'disabled':''} style="width:44px;height:44px;border-radius:22px;background:var(--chip);${q<=1?'opacity:.4':''}" onclick="eIq(-1)">${ic('minus',18)}</button><b style="font-size:20px;min-width:24px;text-align:center" aria-live="polite">${q}</b><button class="ib" aria-label="${T('Add one','Ajouter un','Ongeraho kimwe')}" ${q>=9?'disabled':''} style="width:44px;height:44px;border-radius:22px;background:var(--chip);${q>=9?'opacity:.4':''}" onclick="eIq(1)">${ic('plus',18)}</button></div><button class="btn" onclick="eIAdd()">${T('Add to cart','Ajouter au panier','Shyira mu gaseke')} · ${fmt(it[2]*q)} RWF</button>`)};
window.eIq=d=>{S.eiq=Math.min(9,Math.max(1,S.eiq+d));iDraw()};
window.eIp=j=>{const a=S.eipf,n=a.indexOf(j);n<0?a.push(j):a.splice(n,1);iDraw()};
window.eIAdd=()=>{const k=S.eik,it=REST[S.er].items[k];S.ecart[k]=(S.ecart[k]||0)+S.eiq;
if(S.eipf.length){const add=it[0]+': '+S.eipf.map(j=>PF()[j]).join(', ');S.enote=((S.enote?S.enote+'; ':'')+add).slice(0,80)}
closeSheet();const y=$('#sc')?$('#sc').scrollTop:0;render('fade-none');if($('#sc'))$('#sc').scrollTop=y;toast(T('Added to cart','Ajouté au panier','Byashyizwe mu gaseke'))};
/* ---- order snapshot for receipts ---- */
const _d=window.eDone;
window.eDone=()=>{const n0=S.orders.length,sub=eSub(),disc=S.epromo==='EATS20'?Math.min(2000,Math.round(sub*.2)):0,fee=S.pickup?0:(S.epromo==='FREEDEL'?0:eFee()),tip=S.pickup?0:S.etip,sc=S.esched,ad=addr()[1];
_d();if(S.orders.length>n0){const o=S.orders[0];o.snap={sub,disc,fee,tip};o.sched=sc;o.addr=ad;S.esched=null;if(sc)toast(T('Scheduled for ','Prévue pour ','Giteganyirijwe saa ')+sc)}};
/* ---- receipt ---- */
const row=(a,b,c)=>`<div style="display:flex;justify-content:space-between;gap:12px;padding:7px 0;font-size:15px"><span class="mu">${a}</span><b style="text-align:right${c?';color:'+c:''}">${b}</b></div>`;
window.eRcpt=n=>{const o=mine()[n];if(!o)return;const s=o.snap||{sub:o.t,disc:0,fee:0,tip:0},r=REST[o.r];
sh(`<div ${H1}>${T('Receipt','Reçu','Inyemezabwishyu')}</div><div class="sm mu" style="margin:2px 0 10px">${o.id} · ${esc(r.n)}</div>${o.items.map(x=>row(x.q+' × '+esc(r.items[x.k][0]),fmt(x.q*r.items[x.k][2])+' RWF')).join('')}<div style="border-top:0;margin-top:6px;padding-top:6px">${row(T('Items','Articles','Ibintu'),fmt(s.sub)+' RWF')}${s.disc?row(T('Discount','Remise','Igabanywa'),'−'+fmt(s.disc)+' RWF','var(--ok)'):''}${row(o.pickup?T('Pickup','Retrait','Gufata'):T('Delivery','Livraison','Kugezwaho'),s.fee?fmt(s.fee)+' RWF':T('Free','Gratuit','Ubuntu'))}${s.tip?row(T('Rider tip','Pourboire','Inkunga'),fmt(s.tip)+' RWF'):''}</div><div style="display:flex;justify-content:space-between;align-items:baseline;padding:8px 0"><span style="font-size:18px;font-weight:800">Total</span><span style="font-size:24px;font-weight:800">${fmt(o.t)} RWF</span></div>${row(T('Status','Statut','Uko bimeze'),esc(o.s))}${row(T('Paid with','Payé avec','Wishyuye na'),'itunda Pay')}${o.addr&&!o.pickup?row(T('Address','Adresse','Aderesi'),esc(o.addr)):''}${o.sched?row(o.pickup?T('Pickup time','Heure de retrait','Igihe cyo gufata'):T('Delivery time','Heure de livraison','Igihe cyo kugezwaho'),o.sched):''}${o.note?row(T('Note','Note','Ubutumwa'),esc(o.note)):''}<button class="btn" style="margin-top:14px" onclick="closeSheet()">OK</button>`)};
/* ---- help ---- */
const REAS=()=>[T('Missing item','Article manquant','Ikintu cyabuze'),T('Wrong item','Mauvais article','Ikintu kitari cyo'),T('Food was cold','Repas froid','Ibiryo byari bikonje'),T('Order was late','Commande en retard','Itegeko ryatinze'),T('Something else','Autre chose','Ikindi kibazo')];
window.eHelp=n=>{S.ehn=n;S.ehr=-1;hDraw()};
const hDraw=()=>{const o=mine()[S.ehn];if(!o)return;sh(`<div ${H1}>${T('Report a problem','Signaler un problème','Menyesha ikibazo')}</div><div class="sm mu" style="margin:2px 0 12px">${o.id} · ${esc(REST[o.r].n)}</div><div role="radiogroup" aria-label="${T('What went wrong?','Que s’est-il passé ?','Ni iki cyagenze nabi?')}" style="display:grid;gap:8px">${REAS().map((l,j)=>`<button role="radio" aria-checked="${S.ehr===j}" onclick="eHr(${j})" style="text-align:left;border:0;border-radius:16px;padding:0 16px;height:48px;font:inherit;font-weight:700;background:${S.ehr===j?'var(--tint)':'var(--chip)'};color:inherit">${l}</button>`).join('')}</div><button class="btn" style="margin-top:16px" ${S.ehr<0?'disabled':''} onclick="eHSend()">${T('Send report','Envoyer','Ohereza')}</button>${S.ehr<0?`<div class="sm mu" style="margin-top:8px;text-align:center">${T('Choose what went wrong to continue.','Choisissez le problème pour continuer.','Hitamo ikibazo kugira ngo ukomeze.')}</div>`:''}`)};
window.eHr=j=>{S.ehr=j;hDraw()};
window.eHSend=()=>{const o=mine()[S.ehn];if(!o||S.ehr<0)return;o.issue=REAS()[S.ehr];closeSheet();toast(T('Report sent. We reply within 24 hours (sample).','Signalement envoyé. Réponse sous 24 h (exemple).','Raporo yoherejwe. Turasubiza mu masaha 24 (urugero).'))};
})();
</script>
<script>
/* v90: Eats round 3: priced add-ons, menu search inside a restaurant, Order again card on Eats home. rw strings need native review */
(function(){
const T=(e,f,r)=>({en:e,fr:f,rw:r}[S.lang]||e);
const esc=s=>String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/"/g,'&quot;');
const sh=h=>{$('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" style="max-height:82%;overflow-y:auto">'+h+'</div>'};
const H1='class="h1" style="font-size:22px;line-height:30px"';
const INP='style="width:100%;box-sizing:border-box;height:44px;border-radius:14px;border:0;background:var(--chip);padding:0 14px;font:inherit;color:inherit"';
Object.assign(S,{emq:'',eiad:[]});
const mine=()=>S.orders.filter(o=>o.k==='Eats order'&&o.items);
/* add-ons live in each restaurant's item list (5th field), hidden from the menu, so cart, receipt and reorder all just work */
[[['Butter portion',300,'bread'],['Honey',500,'bread']],[['Garlic sauce',400,'chips'],['Extra pilipili',300,'chips']],[['Avocado',500,'rice'],['Extra beans',600,'rice']],[['Extra shot',500,'coffee'],['Honey',300,'coffee']]].forEach((a,i)=>{if(REST[i]&&!REST[i].items.some(x=>x[4]==='addon'))a.forEach(([n,p,g])=>REST[i].items.push([n,'',p,g,'addon']))});
const isAd=(r,j)=>r.items[j][4]==='addon';
const adds=()=>REST[S.er].items.map((x,j)=>j).filter(j=>isAd(REST[S.er],j));
const hit=it=>!S.emq||(it[0]+' '+it[1]).toLowerCase().includes(S.emq);
/* ---- restaurant page: hide add-ons, menu search ---- */
const _e=screens.erest;
screens.erest=()=>{let h=_e();const r=REST[S.er];let shown=0;
h=h.replace(/<div class="mi">(<div class="tap" role="button" tabindex="0" onclick="eItem\((\d+)\)")/g,(m,rest,k)=>{const it=r.items[+k],ok=!isAd(r,+k)&&hit(it);if(ok)shown++;return `<div class="mi" data-k="${k}"${ok?'':' style="display:none"'}>`+rest});
const pop='<div style="font-size:18px;font-weight:800;padding-top:18px">Popular</div>';
if(h.includes(pop))h=h.replace(pop,`<div style="padding-top:16px"><input id="emq" type="search" aria-label="${T('Search the menu','Rechercher dans le menu','Shakisha ku biryo')}" placeholder="${T('Search the menu','Rechercher dans le menu','Shakisha ku biryo')}" value="${esc(S.emq)}" oninput="eMq(this.value)" ${INP}></div><div id="emq0" role="status" class="sm mu" style="padding:14px 0;text-align:center;${shown?'display:none':''}">${T('No dishes match','Aucun plat trouvé','Nta biryo bibonetse')}</div>`+pop);
return h};
window.eMq=v=>{S.emq=v.trim().toLowerCase();let n=0;const r=REST[S.er];document.querySelectorAll('.mi[data-k]').forEach(e=>{const k=+e.dataset.k,ok=!isAd(r,k)&&hit(r.items[k]);e.style.display=ok?'':'none';if(ok)n++});const z=document.getElementById('emq0');if(z)z.style.display=n?'none':''};
const _o=window.openERest;window.openERest=i=>{S.emq='';_o(i)};
/* ---- item sheet with priced add-ons ---- */
const PF=()=>[T('No onions','Sans oignons','Nta yinzari'),T('Extra spicy','Plus épicé','Pilipili nyinshi'),T('Less salt','Moins de sel','Umunyu muke'),T('No sugar','Sans sucre','Nta sukari')];
const unit=()=>{const r=REST[S.er];return r.items[S.eik][2]+S.eiad.reduce((a,j)=>a+r.items[j][2],0)};
window.eItem=k=>{S.eik=k;S.eiq=1;S.eipf=[];S.eiad=[];iDraw()};
const iDraw=()=>{const r=REST[S.er],it=r.items[S.eik],q=S.eiq,ad=adds();sh(`<div style="display:flex;gap:14px;align-items:center"><div class="ico" style="width:72px;height:72px;border-radius:20px">${gl(it[3],56)}</div><div style="flex:1;min-width:0"><div ${H1}>${esc(it[0])}</div><div style="font-weight:800;margin-top:2px">${fmt(it[2])} RWF</div></div></div>${it[1]?`<div class="mu" style="font-size:15px;line-height:21px;margin-top:12px">${esc(it[1])}</div>`:''}${ad.length?`<div style="font-size:15px;font-weight:800;margin:18px 0 4px">${T('Add-ons','Suppléments','Ibyongerwaho')}</div>${ad.map(j=>{const on=S.eiad.includes(j);return `<button role="checkbox" aria-checked="${on}" onclick="eIad(${j})" style="display:flex;width:100%;align-items:center;gap:12px;border:0;background:none;font:inherit;color:inherit;text-align:left;padding:10px 0;border-bottom:0"><span style="flex:1;font-weight:700">${esc(r.items[j][0])}</span><span class="mu">+${fmt(r.items[j][2])} RWF</span><span aria-hidden="true" style="width:22px;height:22px;border-radius:7px;box-sizing:border-box;display:flex;align-items:center;justify-content:center;border:2px solid ${on?'var(--lk)':'var(--tt)'};background:${on?'var(--lk)':'none'};color:var(--on);font-size:14px">${on?'✓':''}</span></button>`}).join('')}`:''}<div style="font-size:15px;font-weight:800;margin:18px 0 10px">${T('Preferences','Préférences','Ibyo ukunda')}</div><div class="chips" style="padding:0;flex-wrap:wrap;gap:6px">${PF().map((l,j)=>`<button class="cch ${S.eipf.includes(j)?'on':''}" aria-pressed="${S.eipf.includes(j)}" onclick="eIp(${j})">${l}</button>`).join('')}</div><div style="display:flex;align-items:center;justify-content:center;gap:18px;margin:20px 0 14px"><button class="ib" aria-label="${T('Remove one','Retirer un','Kuraho kimwe')}" ${q<=1?'disabled':''} style="width:44px;height:44px;border-radius:22px;background:var(--chip);${q<=1?'opacity:.4':''}" onclick="eIq(-1)">${ic('minus',18)}</button><b style="font-size:20px;min-width:24px;text-align:center" aria-live="polite">${q}</b><button class="ib" aria-label="${T('Add one','Ajouter un','Ongeraho kimwe')}" ${q>=9?'disabled':''} style="width:44px;height:44px;border-radius:22px;background:var(--chip);${q>=9?'opacity:.4':''}" onclick="eIq(1)">${ic('plus',18)}</button></div><button class="btn" onclick="eIAdd()">${T('Add to cart','Ajouter au panier','Shyira mu gaseke')} · ${fmt(unit()*q)} RWF</button>`)};
window.eIq=d=>{S.eiq=Math.min(9,Math.max(1,S.eiq+d));iDraw()};
window.eIp=j=>{const a=S.eipf,n=a.indexOf(j);n<0?a.push(j):a.splice(n,1);iDraw()};
window.eIad=j=>{const a=S.eiad,n=a.indexOf(j);n<0?a.push(j):a.splice(n,1);iDraw()};
window.eIAdd=()=>{const k=S.eik,it=REST[S.er].items[k],q=S.eiq;S.ecart[k]=(S.ecart[k]||0)+q;S.eiad.forEach(j=>{S.ecart[j]=(S.ecart[j]||0)+q});
if(S.eipf.length){const add=it[0]+': '+S.eipf.map(j=>PF()[j]).join(', ');S.enote=((S.enote?S.enote+'; ':'')+add).slice(0,80)}
closeSheet();const y=$('#sc')?$('#sc').scrollTop:0;render('fade-none');if($('#sc'))$('#sc').scrollTop=y;toast(T('Added to cart','Ajouté au panier','Byashyizwe mu gaseke'))};
/* ---- Eats home: Order again ---- */
const again=()=>{const o=mine()[0];if(!o)return '';const r=REST[o.r],n=o.items.reduce((a,x)=>a+x.q,0);return `<div class="pad" style="padding-top:14px"><button class="tap" onclick="eReorder(0)" style="width:100%;display:flex;align-items:center;gap:12px;border:0;border-radius:20px;background:var(--chip);padding:12px 16px;font:inherit;color:inherit;text-align:left"><span class="ico">${gl(r.g,34)}</span><span style="flex:1;min-width:0"><b>${T('Order again','Recommander','Subiramo gutumiza')}</b><div class="sm mu">${esc(r.n)} · ${n} ${T('items','articles','ibintu')} · ${fmt(o.t)} RWF</div></span>${ic('chev',16,'var(--tt)')}</button></div>`};
const _s=screens.shop;
screens.shop=()=>{const h=_s();if(S.shopTab!=='eats')return h;const m='<div class="chips" id="eextra"';return h.includes(m)?h.replace(m,again()+m):h};
})();
</script>
<script>
/* v91: Marketplace round 3: Phones, Kids and Sports categories, area filter, richer sell form (area, negotiable, details), edit listing, custom offers, similar items, delete confirm. rw/fr strings need native review */
(function(){
const T=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e;
const esc=s=>String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/"/g,'&quot;');
const sh=h=>{$('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" style="max-height:86%;overflow-y:auto">'+h+'</div>'};
const H=HD.market,item=id=>H.items.find(x=>x.id===id);
const H1='class="h1" style="font-size:22px;line-height:30px"';
const FLD='style="font-size:17px;height:46px"';
const CATS=['Electronics','Phones','Home','Fashion','Kids','Sports'];
const AREAS=['Kimironko','Remera','Kacyiru','Gisozi','Nyamirambo','Kicukiro'];
window.MXCATS=CATS;window.MXAREAS=AREAS;
const CLN=()=>({Electronics:T('Electronics','Ibikoresho by’ikoranabuhanga','Électronique'),Phones:T('Phones','Telefoni','Téléphones'),Home:T('Home','Mu rugo','Maison'),Fashion:T('Fashion','Imyambarire','Mode'),Kids:T('Kids','Abana','Enfants'),Sports:T('Sports','Siporo','Sport')});
const CDN=()=>({new:T('New','Gishya','Neuf'),like:T('Like new','Nka gishya','Comme neuf'),good:T('Good','Meza','Bon'),fair:T('Fair','Biremewe','Correct')});
const GLY={Electronics:'airtime',Phones:'airtime',Home:'house',Fashion:'bag',Kids:'gift',Sports:'bolt'};
if(!S.mx3){S.mx3=1;S.mxOffs={};S.mxo={id:0,pc:10,custom:''};
H.items.push({id:9,ti:'Samsung phone, 64 GB',sub:'Remera · 3 h ago',p:60000,g:'airtime',c:'Phones',who:'Eric N.',cond:'good',neg:1,d:'Screen has no cracks. Charger included.'},
{id:10,ti:'Tablet, 10 inch',sub:'Kacyiru · Yesterday',p:85000,g:'airtime',c:'Phones',who:'Aline M.',cond:'like',d:'Used for a few months. Case included.'},
{id:11,ti:'Baby stroller',sub:'Kimironko · 2 d ago',p:40000,g:'gift',c:'Kids',who:'Sandra B.',cond:'good',neg:1,d:'Folds flat. Wheels are in good shape.'},
{id:12,ti:'Kids bicycle, 16 inch',sub:'Gisozi · 4 d ago',p:25000,g:'gift',c:'Kids',who:'Patrick H.',cond:'fair',d:'New tyres. A few small scratches.'},
{id:13,ti:'Football boots, size 42',sub:'Nyamirambo · 1 d ago',p:15000,g:'bolt',c:'Sports',who:'Jean B.',cond:'like',d:'Worn twice. Studs in perfect shape.'},
{id:14,ti:'Dumbbell set, 20 kg',sub:'Remera · 5 d ago',p:30000,g:'bolt',c:'Sports',who:'Olivier T.',cond:'good',neg:1,d:'Two adjustable dumbbells with plates.'})}
const num=s=>Number(String(s).replace(/,/g,''));
const fmtIn=v=>v.replace(/\D/g,'').replace(/\B(?=(\d{3})+(?!\d))/g,',');
const chipBtn=(on,fn,l)=>`<button class="${on?'on':''}" aria-pressed="${!!on}" onclick="${fn}">${l}</button>`;
const sw=(on,fn,l)=>`<button role="switch" aria-checked="${!!on}" onclick="${fn}" style="display:flex;width:100%;align-items:center;justify-content:space-between;border:0;background:none;font:inherit;color:inherit;padding:14px 0;min-height:48px"><span style="font-weight:700">${l}</span><span aria-hidden="true" style="width:46px;height:28px;border-radius:14px;background:${on?'var(--lk)':'var(--chip)'};position:relative;flex:none"><i style="position:absolute;top:3px;left:${on?21:3}px;width:22px;height:22px;border-radius:11px;background:#fff;box-shadow:none"></i></span></button>`;
const fields=(F,p)=>`<div class="lab" style="margin-top:6px">${T('Title','Umutwe','Titre')}</div><input class="in" id="${p}t" value="${esc(F.t)}" oninput="${p}Chk()" maxlength="60" placeholder="${T('What are you selling?','Uragurisha iki?','Que vendez-vous ?')}" ${FLD}><div class="lab">${T('Price (RWF)','Igiciro (RWF)','Prix (RWF)')}</div><input class="in" id="${p}p" value="${esc(F.p)}" inputmode="numeric" oninput="${p}Chk()" placeholder="25,000" ${FLD}>`;
const details=(F,p)=>`<div class="lab">${T('Details (optional)','Ibisobanuro (si ngombwa)','Détails (facultatif)')}</div><textarea id="${p}d" oninput="${p}Chk()" maxlength="300" aria-label="${T('Details','Ibisobanuro','Détails')}" style="width:100%;box-sizing:border-box;height:76px;margin-top:6px;border:0;border-radius:16px;background:var(--chip);padding:12px;font:inherit;font-size:15px;color:var(--tx);outline:0;resize:none">${esc(F.d)}</textarea>`;
const cond=(F,fn)=>`<div class="lab">${T('Condition','Imiterere','État')}</div><div class="chp" style="padding:8px 0 0">${Object.keys(CDN()).map(c=>chipBtn(F.cd===c,`${fn}('cd','${c}')`,CDN()[c])).join('')}</div>`;
const rd=(F,p)=>{const t=$('#'+p+'t'),pr=$('#'+p+'p'),d=$('#'+p+'d');if(t)F.t=t.value;if(d)F.d=d.value;if(pr){F.p=fmtIn(pr.value);pr.value=F.p}return F};
/* ---- v119: shared step-by-step engine (one question per page, Toss style) ---- */
window.WZ={r:{},q:v=>JSON.stringify(v).replace(/"/g,'&quot;'),
opt:(on,fn,l)=>`<div class="ar tap" role="button" tabindex="0" style="padding:16px 0;min-height:56px" onclick="${fn}"><div class="t" style="flex:1;font-weight:${on?800:600};color:${on?'var(--lk)':'inherit'}">${l}${on?' ✓':''}</div></div>`,
amt:'style="font-size:32px;font-weight:800;height:68px;letter-spacing:-.5px"',
txt:'style="width:100%;border:0;border-radius:16px;background:var(--chip);padding:14px;font:inherit;color:var(--tx);outline:0;height:150px;font-size:16px;resize:none"',
key:(e,id)=>{if(e.key==='Enter'){e.preventDefault();WZ.r[id].next()}},
quick:(inp,list,id)=>`<div class="chp" style="padding:14px 0 0">${list.map(n=>`<button onclick="WZ.add('${inp}',${n},'${id}')">+${String(n).replace(/\B(?=(\d{3})+(?!\d))/g,',')}</button>`).join('')}</div>`,
add:(inp,n,id)=>{const i=$('#'+inp);if(!i)return;const v=(Number(String(i.value).replace(/\D/g,''))||0)+n;i.value=String(v).replace(/\B(?=(\d{3})+(?!\d))/g,',');WZ.r[id].chk();i.focus()},
mk(cfg){const id=cfg.id;
const cur=()=>{const F=cfg.rd(),sp=cfg.steps(F);F.st=Math.max(0,Math.min(F.st||0,sp.length-1));return{F,sp,k:sp[F.st],last:F.st===sp.length-1}};
const api={
draw(){const{F,sp,k}=cur(),p=cfg.page(k,F),st=F.st,btn=p.btn!==0;
sh(`<div style="display:flex;align-items:center;gap:8px"><button class="ib" aria-label="${T('Back','Subira inyuma','Retour')}" onclick="WZ.r.${id}.back()" style="width:44px;height:44px;font-size:26px">‹</button><div role="progressbar" aria-valuemin="1" aria-valuemax="${sp.length}" aria-valuenow="${st+1}" style="flex:1;height:4px;border-radius:2px;background:var(--chip)"><i style="display:block;height:100%;width:${(st+1)*100/sp.length}%;border-radius:2px;background:var(--br);transition:width .25s ease"></i></div></div><div class="h1" style="font-size:26px;line-height:34px;margin:16px 0 ${p.sum?4:14}px">${p.q}</div>${p.sum?`<div class="sm mu" style="margin-bottom:12px;line-height:20px">${p.sum}</div>`:''}<div style="min-height:${p.min||260}px">${p.body}</div>${btn?`<button class="btn" id="${id}go" style="margin-top:12px" disabled onclick="WZ.r.${id}.next()">${T('Next','Komeza','Suivant')}</button>`:''}`);
const i=$('#layer input.in, #layer textarea');if(i){i.focus();if(i.setSelectionRange)i.setSelectionRange(i.value.length,i.value.length)}api.chk()},
chk(){const{F,k,last}=cur(),b=$('#'+id+'go');if(!b)return;b.disabled=!cfg.ok(F,k);b.textContent=last?cfg.final():(cfg.opt&&cfg.opt(F,k)?T('Skip','Simbuka','Passer'):T('Next','Komeza','Suivant'))},
next(){const{F,k,last}=cur();if(!cfg.ok(F,k))return;if(last)cfg.go();else{F.st++;api.draw()}},
back(){const{F}=cur();if(F.st>0){F.st--;api.draw()}else closeSheet()},
pick(key,v){const{F,last}=cur();F[key]=v;if(!last)F.st++;api.draw()},
set(key,v){const{F}=cur();F[key]=v;api.draw()}};
WZ.r[id]=api;(WZ.cfg=WZ.cfg||{})[id]=cfg;return api}};
/* ---- sell (v119: shared engine) ---- */
const _hp=window.hdPost;
const MS=['t','p','c','cd','a','n','d'];
const SQ=()=>({t:T('What are you selling?','Uragurisha iki?','Que vendez-vous ?'),p:T('What is the price?','Igiciro ni angahe?','Quel est le prix ?'),c:T('Which category?','Ni mu cyiciro ikihe?','Quelle catégorie ?'),cd:T('What condition is it in?','Imeze ite?','Dans quel état est-il ?'),a:T('Where can buyers pick it up?','Abaguzi bazawufatira he?','Où l’acheteur peut-il le récupérer ?'),n:T('Can buyers make offers?','Abaguzi bashobora gutanga igiciro?','Les acheteurs peuvent-ils faire une offre ?'),d:T('Anything else to add?','Hari ikindi wongeraho?','Autre chose à ajouter ?')});
const mxw=WZ.mk({id:'mx',rd:()=>rd(S.mx3f,'mx3'),steps:()=>MS,final:()=>T('Post','Shyiraho','Publier'),go:()=>mx3Post(),
ok:(F,k)=>k==='t'?!!F.t.trim():k==='p'?num(F.p)>0:true,opt:(F,k)=>k==='d'&&!F.d.trim(),
page:(k,F)=>{const q=SQ()[k],pk=(key,v,l)=>WZ.opt(F[key]===v,`WZ.r.mx.pick('${key}',${WZ.q(v)})`,l);let body='',o={q};
if(k==='t'){o.min=110;body=`<input class="in" id="mx3t" value="${esc(F.t)}" maxlength="60" oninput="WZ.r.mx.chk()" onkeydown="WZ.key(event,'mx')" aria-label="${q}" placeholder="${T('Blue bicycle, 2 years old','Igare ry’ubururu, imyaka 2','Vélo bleu, 2 ans')}" style="font-size:20px;height:56px">`}
else if(k==='p'){o.min=170;o.sum=esc(F.t);body=`<input class="in" id="mx3p" value="${esc(F.p)}" inputmode="numeric" oninput="WZ.r.mx.chk()" onkeydown="WZ.key(event,'mx')" aria-label="${q}" placeholder="25,000" ${WZ.amt}><div class="sm mu" style="margin-top:8px">RWF</div>${WZ.quick('mx3p',[1000,5000,10000],'mx')}`}
else if(k==='c'){o.btn=0;body=CATS.map(c=>pk('c',c,CLN()[c])).join('')}
else if(k==='cd'){o.btn=0;body=Object.keys(CDN()).map(c=>pk('cd',c,CDN()[c])).join('')}
else if(k==='a'){o.btn=0;body=AREAS.map(a=>pk('a',a,a)).join('')}
else if(k==='n'){o.btn=0;body=pk('n',1,T('Yes, price is negotiable','Yego, igiciro kirashobora kugabanywa','Oui, prix négociable'))+pk('n',0,T('No, fixed price','Oya, igiciro ntigihinduka','Non, prix fixe'))}
else{o.min=190;o.sum=esc(F.t)+' · '+esc(F.p)+' RWF';body=`<textarea id="mx3d" maxlength="300" aria-label="${q}" oninput="WZ.r.mx.chk()" placeholder="${T('Size, colour, why you are selling… (optional)','Ingano, ibara, impamvu uragurisha… (si ngombwa)','Taille, couleur, raison de la vente… (facultatif)')}" ${WZ.txt}>${esc(F.d)}</textarea>`}
o.body=body;return o}});
const sDraw=()=>mxw.draw();
window.hdPost=()=>{if(S.hd!=='market')return _hp();S.mx3f={t:'',p:'',c:'Electronics',cd:'good',a:'Kimironko',n:0,d:'',st:0};sDraw()};
window.mx3Chk=()=>mxw.chk();
window.mx3Post=()=>{const F=rd(S.mx3f,'mx3'),p=num(F.p);if(!F.t.trim()||!p)return;
H.items.unshift({id:Date.now()%100000,ti:F.t.trim(),sub:F.a+' · '+T('Just now','Ubu','À l’instant'),p,g:GLY[F.c],c:F.c,who:'You',cond:F.cd,neg:F.n,d:F.d.trim()||T('Contact the seller to arrange pickup.','Vugana n’umugurisha mwemeranye aho muhurira.','Contactez le vendeur pour organiser le retrait.')});
S.hdMine.market++;S.mkCat='Mine';closeSheet();render('fade-none');toast(T('Posted','Byashyizweho','Publié'))};
/* ---- edit listing ---- */
window.mxEdit=id=>{const x=item(id);S.mx3e={id,t:x.ti,p:fmt(x.p),cd:x.cond,n:x.neg?1:0,d:x.d};eDraw()};
function eDraw(){const F=S.mx3e;sh(`<div ${H1}>${T('Edit listing','Hindura icyashyizweho','Modifier l’annonce')}</div>${fields(F,'mx3e')}${cond(F,'mx3eSet')}${sw(F.n,'mx3eNeg()',T('Price is negotiable','Igiciro kirashobora kugabanywa','Prix négociable'))}${details(F,'mx3e')}<button class="btn" id="mx3ego" style="margin-top:18px" onclick="mx3eGo()">${T('Save','Bika','Enregistrer')}</button><div id="mx3eh" class="sm" style="margin-top:8px;text-align:center;color:var(--er)"></div>`);mx3eChk()}
window.mx3eChk=()=>{const F=rd(S.mx3e,'mx3e'),ok=F.t.trim()&&num(F.p)>0,b=$('#mx3ego'),h=$('#mx3eh');if(b)b.disabled=!ok;if(h)h.textContent=ok?'':T('A title and a price are needed.','Umutwe n’igiciro birakenewe.','Un titre et un prix sont requis.')};
window.mx3eSet=(k,v)=>{rd(S.mx3e,'mx3e');S.mx3e[k]=v;eDraw()};
window.mx3eNeg=()=>{rd(S.mx3e,'mx3e');S.mx3e.n=S.mx3e.n?0:1;eDraw()};
window.mx3eGo=()=>{const F=rd(S.mx3e,'mx3e'),x=item(F.id),p=num(F.p);if(!x||!F.t.trim()||!p)return;x.ti=F.t.trim();x.p=p;x.cond=F.cd;x.neg=F.n;x.d=F.d.trim()||x.d;closeSheet();render('fade-none');toast(T('Listing updated','Icyashyizweho cyahinduwe','Annonce mise à jour'))};
/* ---- delete with confirm ---- */
const _del=window.mkDel;
window.mkDel=id=>{const x=item(id);if(!x)return;sh(`<div ${H1}>${T('Delete this listing?','Gusiba icyashyizweho?','Supprimer cette annonce ?')}</div><div class="mu" style="font-size:15px;margin:8px 0 20px">${esc(x.ti)} ${T('will be removed. This cannot be undone.','kizavanwaho. Ntibisubirwaho.','sera retirée. Action irréversible.')}</div><button class="btn sec2" style="color:var(--er)" onclick="closeSheet();mkDelGo(${id})">${T('Delete','Siba','Supprimer')}</button><button class="btn" style="margin-top:10px" onclick="closeSheet()">${T('Keep listing','Reka gikomeze','Garder l’annonce')}</button>`)};
window.mkDelGo=id=>_del(id);
/* ---- custom offers ---- */
const oAmt=()=>{const x=item(S.mxo.id);return S.mxo.custom?num(S.mxo.custom):Math.round(x.p*(1-S.mxo.pc/100)/500)*500};
const oBad=()=>{const x=item(S.mxo.id),a=oAmt();return !(a>0&&a<x.p)};
const oMsg=()=>oBad()?(oAmt()>0?T('Your offer must be lower than the asking price.','Igiciro watanze kigomba kuba munsi y’icyasabwe.','Votre offre doit être inférieure au prix demandé.'):T('Enter an amount.','Andika umubare.','Saisissez un montant.')):'';
window.mkOffer=id=>{S.mxo={id,pc:10,custom:''};oDraw()};
function oDraw(){const x=item(S.mxo.id);sh(`<div ${H1}>${T('Make an offer','Tanga igiciro','Faire une offre')}</div><div class="mu" style="font-size:15px;margin:8px 0 0">${esc(x.ti)} · ${fmt(x.p)} RWF</div><div class="chp" style="padding:16px 0 0">${[5,10,15].map(n=>chipBtn(!S.mxo.custom&&S.mxo.pc===n,`mkOffPc(${n})`,'−'+n+'%')).join('')}</div><div class="lab" style="margin-top:14px">${T('Or enter your own price','Cyangwa andika igiciro cyawe','Ou saisissez votre prix')}</div><input class="in" id="mxoc" inputmode="numeric" value="${esc(S.mxo.custom)}" oninput="mxoIn()" aria-label="${T('Your offer (RWF)','Igiciro cyawe (RWF)','Votre offre (RWF)')}" placeholder="${fmt(Math.round(x.p*.9/500)*500)}" ${FLD}><div id="mxoa" style="font-size:28px;font-weight:800;margin:16px 0 4px">${fmt(oAmt())} RWF</div><div id="mxow" role="status" class="sm" style="min-height:20px;color:var(--er)">${oMsg()}</div><button class="btn" id="mxogo" style="margin-top:14px" ${oBad()?'disabled':''} onclick="mkOffSend()">${T('Send offer','Ohereza igiciro','Envoyer l’offre')}</button>${x.neg?'':`<div class="sm mu" style="margin-top:10px;text-align:center">${T('The seller has not marked this price as negotiable.','Umugurisha ntiyavuze ko igiciro gishobora kugabanywa.','Le vendeur n’a pas indiqué un prix négociable.')}</div>`}`)}
window.mkOffPc=n=>{S.mxo.pc=n;S.mxo.custom='';oDraw()};
window.mxoIn=()=>{const i=$('#mxoc');S.mxo.custom=fmtIn(i.value);i.value=S.mxo.custom;$('#mxoa').textContent=fmt(oAmt())+' RWF';$('#mxow').textContent=oMsg();$('#mxogo').disabled=oBad()};
window.mkOffSend=()=>{if(oBad())return;const x=item(S.mxo.id),a=oAmt(),th='hdmarket'+x.id,m='Hi, would you accept '+fmt(a)+' RWF for "'+x.ti+'"?';
hdThread(th,x.who,x.ti,[['me',m]]);if(S.msgs[th].length>1||S.msgs[th][0][1]!==m)S.msgs[th].push(['me',m]);S.mxOffs[x.id]=a;
closeSheet();S.tab='messages';openChat(th);toast(T('Offer sent','Igiciro cyoherejwe','Offre envoyée'))};
window.mxFh=a=>{S.mxf.hood=S.mxf.hood===a?'':a;window.mxFilt()};
/* ---- detail: negotiable badge, your offer, similar items ---- */
const sim=x=>{const l=H.items.filter(y=>y.id!==x.id&&!y.st&&!S.mxHide[y.id]&&y.who!=='You'&&y.c===x.c).slice(0,4);if(!l.length)return '';
return `<div class="pad" style="padding-top:8px"><div style="font-size:17px;font-weight:800;margin:6px 0 4px">${T('Similar items','Ibisa','Articles similaires')}</div>${l.map(y=>`<div class="hdc" role="button" tabindex="0" onclick="hdOpen('market',${y.id})"><div class="th">${gl(y.g,44)}</div><div style="flex:1;min-width:0"><div class="t">${esc(y.ti)}</div><div class="s">${esc(y.sub)} · ${CDN()[y.cond]}</div><div class="pr">${fmt(y.p)} RWF</div></div></div>`).join('')}<div style="height:96px"></div></div>`};
const _hi=screens.hoodItem;
screens.hoodItem=()=>{let h=_hi();if(S.hd!=='market')return h;const x=item(S.hdI);if(!x)return h;
h=h.replace(/(<div style="display:flex;gap:8px;margin-top:12px)(">(?:<span[^>]*>[^<]*<\/span>){2})/,(m,a,b)=>a+';flex-wrap:wrap'+b+(x.neg?`<span style="padding:5px 12px;border-radius:14px;background:var(--tint);color:var(--tintfg);font-size:13px;font-weight:700">${T('Negotiable','Kigabanywa','Négociable')}</span>`:''));
const off=S.mxOffs[x.id],lk='<div class="sm mu" style="margin-top:12px;line-height:20px">🔒';
if(off&&x.who!=='You'&&h.includes(lk))h=h.replace(lk,`<div class="sm" style="margin-top:12px;font-weight:700">${T('Your offer','Igiciro cyawe','Votre offre')}: ${fmt(off)} RWF</div>`+lk);
const c=h.indexOf('<div class="cta"');return c>0?h.slice(0,c)+sim(x)+h.slice(c):h+sim(x)};
})();
</script>
<script>
/* v92: Jobs round 2: job profile, filters + alerts, interview confirm/reschedule, applicants for your own jobs, richer post/edit form, employer page, similar jobs, share/report, confirm delete/withdraw. rw/fr strings need native review */
(function(){
const T=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e;
const esc=s=>String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/"/g,'&quot;');
const sh=h=>{$('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" style="max-height:86%;overflow-y:auto">'+h+'</div>'};
const H=HD.jobs,item=id=>H.items.find(x=>x.id===id);
const H1='class="h1" style="font-size:22px;line-height:30px"';
const FLD='style="font-size:17px;height:46px"';
const num=s=>Number(String(s).replace(/,/g,''));
const fmtIn=v=>v.replace(/\D/g,'').replace(/\B(?=(\d{3})+(?!\d))/g,',');
const hash=s=>[...String(s)].reduce((a,c)=>(a*31+c.charCodeAt(0))%9973,7);
const UN=()=>({day:T('day','munsi','jour'),task:T('task','gikorwa','mission'),month:T('month','kwezi','mois')});
const CT=()=>({'Part-time':T('Part-time','Igihe gito','Temps partiel'),Gig:T('Gig','Akazi k’igihe gito','Mission'),'Full-time':T('Full-time','Igihe cyose','Temps plein')});
const START=()=>({asap:T('Start ASAP','Gutangira vuba','Dès que possible'),week:T('This week','Muri iki cyumweru','Cette semaine'),flex:T('Flexible','Birashoboka','Flexible')});
const chipBtn=(on,fn,l)=>`<button class="${on?'on':''}" aria-pressed="${!!on}" onclick="${fn}">${l}</button>`;
const sw=(on,fn,l)=>`<button role="switch" aria-checked="${!!on}" onclick="${fn}" style="display:flex;width:100%;align-items:center;justify-content:space-between;border:0;background:none;font:inherit;color:inherit;padding:14px 0;min-height:48px;text-align:left"><span style="font-weight:700;padding-right:12px">${l}</span><span aria-hidden="true" style="width:46px;height:28px;border-radius:14px;background:${on?'var(--lk)':'var(--chip)'};position:relative;flex:none"><i style="position:absolute;top:3px;left:${on?21:3}px;width:22px;height:22px;border-radius:11px;background:#fff;box-shadow:none"></i></span></button>`;
const link=(t,fn,c)=>`<button style="border:0;background:none;font:inherit;font-size:14px;font-weight:700;color:${c||'var(--lk)'};padding:10px 0;min-height:44px;margin-right:18px" onclick="${fn}">${t}</button>`;
const refresh=()=>{const top=S.stack[S.stack.length-1];if(top==='hoodItem'&&S.hd==='jobs')render('fade-none');else if(top==='hood'&&S.hd==='jobs'&&$('#jbl'))window.jbCat(S.jbCat)};
if(!S.jb2){S.jb2=1;Object.assign(S,{jbp:{skills:[],exp:'',av:'',phone:''},jbAtt:1,jbfl:{area:'',unit:'',hide:0},jbAlert:0,jbHide:{},jbAp:{},jbIv:{}})}
/* ---- job profile ---- */
const SKILLS=()=>[T('Customer service','Gufasha abakiriya','Service client'),T('Cashier','Kwakira amafaranga','Caisse'),T('Driving','Gutwara','Conduite'),T('Cooking','Guteka','Cuisine'),T('Cleaning','Gusukura','Nettoyage'),T('Tutoring','Kwigisha','Soutien scolaire'),T('Phone repair','Gukora telefoni','Réparation téléphone'),T('Computer skills','Ubumenyi bwa mudasobwa','Informatique')];
const EXP=()=>[T('None','Nta na buke','Aucune'),T('Under 1 year','Munsi y’umwaka','Moins d’un an'),T('1 to 3 years','Imyaka 1 kugeza 3','1 à 3 ans'),T('3+ years','Imyaka 3 cyangwa irenga','3 ans et plus')];
const AVL=()=>[T('Now','Ubu','Maintenant'),T('This week','Muri iki cyumweru','Cette semaine'),T('Next month','Ukwezi gutaha','Le mois prochain')];
const profSum=()=>{const p=S.jbp,a=[];if(p.skills.length)a.push(T('Skills: ','Ubumenyi: ','Compétences : ')+p.skills.map(i=>SKILLS()[i]).join(', ')+'.');if(p.exp!=='')a.push(T('Experience: ','Uburambe: ','Expérience : ')+EXP()[p.exp]+'.');if(p.av!=='')a.push(T('Available: ','Nshobora gutangira: ','Disponible : ')+AVL()[p.av]+'.');return a.join(' ')};
window.jbProf=from=>{S.jbFrom=from||0;S.jbpd=JSON.parse(JSON.stringify(S.jbp));S.jbpd.st=0;pfw.draw()};
/* v122: Job profile is step-by-step (skills, experience, availability). Every step is optional, so nothing blocks Save. */
const pfw=WZ.mk({id:'pf',rd:()=>S.jbpd,steps:()=>['s','e','a'],final:()=>T('Save profile','Bika umwirondoro','Enregistrer le profil'),go:()=>jbPSave(),
ok:()=>true,opt:(F,k)=>k==='s'?!F.skills.length:k==='e'?F.exp==='':F.av==='',
page:(k,F)=>{const Q={s:T('What are you good at?','Uzi iki neza?','Quelles sont vos compétences ?'),e:T('How much experience do you have?','Ufite uburambe bungana iki?','Quelle expérience avez-vous ?'),a:T('When can you start?','Watangira ryari?','Quand pouvez-vous commencer ?')},q=Q[k];let o={q},body='';
if(k==='s'){o.min=230;o.sum=T('Pick all that apply. Shared with employers only when you apply.','Hitamo ibikureba byose. Usangizwa abakoresha gusa igihe usabye akazi.','Choisissez tout ce qui s’applique. Partagé avec les employeurs seulement quand vous postulez.');body=`<div class="chp" style="padding:8px 0 0;flex-wrap:wrap;overflow:visible">${SKILLS().map((l,i)=>chipBtn(F.skills.includes(i),`jbPs(${i})`,l)).join('')}</div>`}
else if(k==='e'){o.btn=0;body=EXP().map((l,i)=>WZ.opt(F.exp===i,`WZ.r.pf.pick('exp',${i})`,l)).join('')}
else{o.btn=1;o.min=200;body=AVL().map((l,i)=>WZ.opt(F.av===i,`WZ.r.pf.set('av',${i})`,l)).join('')}
o.body=body;return o}});
const pfDraw=()=>pfw.draw();
window.jbPs=i=>{const a=S.jbpd.skills,n=a.indexOf(i);n<0?a.push(i):a.splice(n,1);pfDraw()};
window.jbPe=i=>{S.jbpd.exp=S.jbpd.exp===i?'':i;pfDraw()};
window.jbPa=i=>{S.jbpd.av=S.jbpd.av===i?'':i;pfDraw()};
window.jbPSave=()=>{S.jbp=S.jbpd;delete S.jbp.st;S.jbAtt=1;const f=S.jbFrom;S.jbFrom=0;closeSheet();toast(T('Profile saved','Umwirondoro wabitswe','Profil enregistré'));if(f)window.jbApply(f);else refresh()};
/* ---- filters + alerts ---- */
window.jbFltOk=x=>{const f=S.jbfl;return !(f.area&&x.loc!==f.area)&&!(f.unit&&x.u!==f.unit)&&!(f.hide&&x.st)};
const nF=()=>(S.jbfl.area?1:0)+(S.jbfl.unit?1:0)+(S.jbfl.hide?1:0);
window.jbTools=()=>`<button class="cch" style="border:2px solid var(--ln);background:none" onclick="jbFilt()">⚙ ${T('Filter','Hitamo','Filtrer')}${nF()?' · '+nF():''}</button><button class="cch" style="border:2px solid var(--ln);background:none" onclick="jbProf()">👤 ${T('Profile','Umwirondoro','Profil')}</button>`;
window.jbFilt=()=>fDraw();
function fDraw(){const F=S.jbfl,areas=[...new Set(H.items.map(x=>x.loc))].slice(0,8),n=H.items.filter(jbFltOk).length;
sh(`<div ${H1}>${T('Filter','Hitamo','Filtrer')}</div><div class="lab" style="margin-top:14px">${T('Area','Agace','Quartier')}</div><div class="chp" style="padding:8px 0 0;flex-wrap:wrap;overflow:visible">${areas.map(a=>chipBtn(F.area===a,`jbFa('${esc(a).replace(/'/g,'')}')`,esc(a))).join('')}</div><div class="lab">${T('Pay type','Uburyo bwo kwishyurwa','Type de paie')}</div><div class="chp" style="padding:8px 0 0;flex-wrap:wrap;overflow:visible">${Object.entries(UN()).map(([k,v])=>chipBtn(F.unit===k,`jbFu('${k}')`,T('Per ','Ku ','Par ')+v)).join('')}</div>${sw(F.hide,'jbFh()',T('Hide filled jobs','Hisha akazi kamaze kuboneka','Masquer les offres pourvues'))}${sw(S.jbAlert,'jbFal()',T('Alert me about new matching jobs','Menyesha ku kazi gashya gahuye','M’alerter pour les nouvelles offres'))}<div class="row2" style="margin-top:14px"><button class="btn sec2" onclick="jbFr()">${T('Reset','Subiramo','Réinitialiser')}</button><button class="btn" onclick="closeSheet();jbCat(S.jbCat)">${T('Show ','Erekana ','Voir ')}${n}</button></div>`)}
window.jbFa=a=>{const A=[...new Set(H.items.map(x=>x.loc))].find(l=>esc(l).replace(/'/g,'')===a)||'';S.jbfl.area=S.jbfl.area===A?'':A;fDraw()};
window.jbFu=k=>{S.jbfl.unit=S.jbfl.unit===k?'':k;fDraw()};
window.jbFh=()=>{S.jbfl.hide=S.jbfl.hide?0:1;fDraw()};
window.jbFal=()=>{S.jbAlert=S.jbAlert?0:1;fDraw();toast(S.jbAlert?T('Alerts on. We will notify you (sample).','Imenyesha zifunguye (urugero).','Alertes activées (exemple).'):T('Alerts off','Imenyesha zafunzwe','Alertes désactivées'))};
window.jbFr=()=>{S.jbfl={area:'',unit:'',hide:0};fDraw()};
/* ---- apply: attach profile ---- */
const _ap=window.jbApply;
window.jbApply=id=>{_ap(id);const b=document.querySelector('#layer .btn');if(!b)return;const has=!!profSum();
b.insertAdjacentHTML('beforebegin',`<div id="jbatt" style="margin-top:8px">${attH(id,has)}</div>`)};
const attH=(id,has)=>has?sw(S.jbAtt,`jbAttT(${id})`,T('Attach my job profile','Ongeraho umwirondoro wanjye','Joindre mon profil emploi'))+`<div class="sm mu" style="margin:-4px 0 4px">${esc(profSum())}</div>`:`<div style="padding:12px 0;display:flex;align-items:center;justify-content:space-between;gap:12px"><span class="sm mu">${T('Add a job profile to stand out.','Ongeraho umwirondoro kugira ngo ugaragare.','Ajoutez un profil pour vous démarquer.')}</span><button class="cch on" onclick="jbProf(${id})">${T('Add','Ongeraho','Ajouter')}</button></div>`;
window.jbAttT=id=>{S.jbAtt=S.jbAtt?0:1;const n=($('#jbn')||{}).value;$('#jbatt').innerHTML=attH(id,true)};
const _ag=window.jbApplyGo;
window.jbApplyGo=id=>{const t=$('#jbn'),s=profSum();if(t&&s&&S.jbAtt&&!t.value.includes(s))t.value=(t.value?t.value.trim()+' ':'')+s;_ag(id)};
/* ---- interview ---- */
const SLOTS=[['Tomorrow, 10:00','Ejo, 10:00','Demain, 10 h 00'],['Thursday, 14:00','Kuwa kane, 14:00','Jeudi, 14 h 00'],['Friday, 09:00','Kuwa gatanu, 09:00','Vendredi, 9 h 00']];
const iv=id=>S.jbIv[id]||(S.jbIv[id]={i:0,ok:0,req:0});
const slotL=i=>T(...SLOTS[i]);
const say=(id,m)=>{const th='hdjobs'+id;if(S.msgs&&S.msgs[th])S.msgs[th].push(['me',m])};
window.jbIvText=id=>{const v=iv(id);return slotL(v.i)+'. '+(v.ok?T('Confirmed.','Byemejwe.','Confirmé.'):v.req?T('Waiting for the employer to confirm.','Utegereje ko umukoresha yemeza.','En attente de l’employeur.'):T('Please confirm you can come.','Nyamuneka emeza ko uzaza.','Merci de confirmer votre venue.'))};
window.jbIvBtns=id=>{const v=iv(id);return v.ok?`<div style="margin-top:10px;font-weight:700;color:var(--ok)">✓ ${T('Interview confirmed','Ikiganiro cyemejwe','Entretien confirmé')}</div>`:v.req?'':`<div class="chips" style="padding:10px 0 0"><button class="cch on" onclick="jbIvOk(${id})">${T('Confirm','Emeza','Confirmer')}</button><button class="cch" onclick="jbIvRe(${id})">${T('Reschedule','Hindura igihe','Reporter')}</button></div>`};
window.jbIvOk=id=>{const v=iv(id);v.ok=1;v.req=0;say(id,'I confirm the interview: '+SLOTS[v.i][0]+'.');refresh();toast(T('Interview confirmed','Ikiganiro cyemejwe','Entretien confirmé'))};
window.jbIvRe=id=>{const v=iv(id);sh(`<div ${H1}>${T('Pick another time','Hitamo ikindi gihe','Choisir un autre horaire')}</div><div style="padding-top:8px">${SLOTS.map((s,i)=>i===v.i?'':`<button onclick="jbIvPick(${id},${i})" style="display:flex;width:100%;align-items:center;border:0;background:none;font:inherit;color:inherit;text-align:left;padding:16px 0;min-height:56px;border-bottom:0;font-weight:700">${T(...s)}</button>`).join('')}</div><button class="btn sec2" style="margin-top:14px" onclick="closeSheet()">${T('Close','Funga','Fermer')}</button>`)};
window.jbIvPick=(id,i)=>{const v=iv(id);v.i=i;v.ok=0;v.req=1;say(id,'Could we meet on '+SLOTS[i][0]+' instead?');closeSheet();refresh();toast(T('Request sent','Ubusabe bwoherejwe','Demande envoyée'));
setTimeout(()=>{const w=S.jbIv[id];if(w&&w.req&&S.hdApplied[id]){w.ok=1;w.req=0;refresh();toast(item(id).who+T(' confirmed the new time',' yemeje igihe gishya',' a confirmé le nouvel horaire'))}},4000)};
/* ---- applicants for your own jobs ---- */
const NAMES=['Aline U.','Eric M.','Claire N.','Patrick H.','Sandra B.','Jean B.','Grace T.'];
const NOTES=()=>[T('I can start this week.','Nshobora gutangira muri iki cyumweru.','Je peux commencer cette semaine.'),T('I have done similar work before.','Nigeze gukora akazi nk’aka.','J’ai déjà fait un travail similaire.'),T('I live close by.','Nturiye hafi.','J’habite à proximité.'),T('Available in the afternoons.','Mboneka nyuma ya saa sita.','Disponible l’après-midi.')];
const appl=id=>{if(!S.jbAp[id]){const n=2+id%3,a=[];for(let i=0;i<n;i++)a.push({n:NAMES[(id+i*2)%NAMES.length],k:(id+i)%4,s:0});S.jbAp[id]=a}return S.jbAp[id]};
const apH=x=>{const a=appl(x.id);return `<div style="font-size:17px;font-weight:800;margin:20px 0 4px">${T('Applicants','Abasabye','Candidats')} · ${a.length}</div>${a.map((p,i)=>`<div style="padding:12px 0;border-bottom:0"><div style="display:flex;justify-content:space-between;gap:8px"><b>${esc(p.n)}</b><span class="sm" style="font-weight:700;color:${p.s===1?'var(--ok)':p.s===2?'var(--er)':'var(--mu)'}">${[T('New','Gishya','Nouveau'),T('Shortlisted','Yatoranyijwe','Présélectionné'),T('Declined','Yanzwe','Refusé')][p.s]}</span></div><div class="sm mu" style="margin-top:2px">${esc(NOTES()[p.k])}</div>${p.s?'':`<div class="chips" style="padding:8px 0 0"><button class="cch on" onclick="jbAs(${x.id},${i},1)">${T('Shortlist','Tora','Présélectionner')}</button><button class="cch" onclick="jbAs(${x.id},${i},2)">${T('Decline','Anga','Refuser')}</button></div>`}</div>`).join('')}<div class="sm mu" style="margin-top:8px">${T('Sample applicants for this prototype.','Abasabye b’urugero muri iki kigereranyo.','Candidats d’exemple pour ce prototype.')}</div>`};
window.jbAs=(id,i,s)=>{appl(id)[i].s=s;render('fade-none');toast(s===1?T('Added to your shortlist','Yongewe ku bo wahisemo','Ajouté à la présélection'):T('Applicant declined','Uwasabye yanzwe','Candidat refusé'))};
/* ---- post / edit ---- */
const _hp=window.hdPost;
window.hdPost=(()=>{const LOCS=()=>[...new Set(['Kimironko','Remera','Kacyiru','Gisozi','Nyamirambo','Kicukiro',...H.items.map(x=>x.loc).filter(Boolean)])];
const JS=['t','p','c','l','s','r','d'];
const JQ=()=>({t:T('What job are you posting?','Ushyizeho akazi ki?','Quel poste proposez-vous ?'),p:T('How much does it pay?','Umushahara ni uwuhe?','Quel est le salaire ?'),c:T('What type of work?','Ni akazi k’ubwoko ki?','Quel type de travail ?'),l:T('Where is the work?','Akazi gakorerwa he?','Où se trouve le travail ?'),s:T('When does it start?','Gatangira ryari?','Quand commence-t-il ?'),r:T('What do you need from applicants?','Ukeneye iki ku basaba?','Que faut-il aux candidats ?'),d:T('Anything else to add?','Hari ikindi wongeraho?','Autre chose à ajouter ?')});
const jw=WZ.mk({id:'jw',rd:()=>rd(),steps:()=>JS,final:()=>T('Post','Shyiraho','Publier'),go:()=>jqGo(),
ok:(F,k)=>k==='t'?!!F.t.trim():k==='p'?num(F.p)>0:true,opt:(F,k)=>k==='r'&&!F.r.some(s=>s.trim()),
page:(k,F)=>{const q=JQ()[k],pk=(key,v,l)=>WZ.opt(F[key]===v,`WZ.r.jw.pick('${key}',${WZ.q(v)})`,l);let body='',o={q};
if(k==='t'){o.min=110;body=`<input class="in" id="jqt" value="${esc(F.t)}" maxlength="50" oninput="WZ.r.jw.chk()" onkeydown="WZ.key(event,'jw')" aria-label="${q}" placeholder="${T('Shop assistant','Umukozi mu iduka','Vendeur')}" style="font-size:20px;height:56px">`}
else if(k==='p'){o.min=230;o.sum=esc(F.t);body=`<input class="in" id="jqp" value="${esc(F.p)}" inputmode="numeric" oninput="WZ.r.jw.chk()" onkeydown="WZ.key(event,'jw')" aria-label="${q}" placeholder="5,000" ${WZ.amt}><div class="sm mu" style="margin-top:8px">RWF</div><div class="chp" style="padding:14px 0 0">${Object.entries(UN()).map(([k,v])=>chipBtn(F.u===k,`WZ.r.jw.set('u','${k}')`,T('Per ','Ku ','Par ')+v)).join('')}</div>${WZ.quick('jqp',[1000,5000,10000],'jw')}`}
else if(k==='c'){o.btn=0;body=Object.entries(CT()).map(([a,v])=>pk('c',a,v)).join('')}
else if(k==='l'){o.btn=0;body=LOCS().map(l=>pk('l',l,esc(l))).join('')}
else if(k==='s'){o.btn=0;body=Object.entries(START()).map(([a,v])=>pk('s',a,v)).join('')}
else if(k==='r'){o.min=200;body=[0,1,2].map(i=>`<input class="in" id="jqr${i}" value="${esc(F.r[i]||'')}" maxlength="50" oninput="WZ.r.jw.chk()" aria-label="${T('Requirement','Icyangombwa','Exigence')} ${i+1}" placeholder="${[T('Own moto','Moto yawe','Moto personnelle'),T('Good with customers','Kwita ku bakiriya','À l’aise avec les clients'),T('Can start within a week','Gutangira mu cyumweru','Peut commencer sous une semaine')][i]}" style="height:48px;margin-top:${i?8:0}px">`).join('')}
else{o.min=190;o.sum=esc(F.t)+' · '+esc(F.p)+' RWF '+(UN()[F.u]?T('per ','ku ','par ')+UN()[F.u]:'');body=`<textarea id="jqd" maxlength="300" aria-label="${q}" oninput="WZ.r.jw.chk()" placeholder="${T('Hours, tasks, what you offer… (optional)','Amasaha, imirimo, ibyo utanga… (si ngombwa)','Horaires, tâches, avantages… (facultatif)')}" ${WZ.txt}>${esc(F.d)}</textarea>`}
o.body=body;return o}});
return()=>{if(S.hd!=='jobs')return _hp();S.jbq2={id:0,t:'',l:'',p:'',u:'day',c:'Part-time',s:'asap',d:'',r:['','',''],st:0};jw.draw()}})();
window.jbEdit=id=>{const x=item(id);S.jbq2={id,t:x.ti,l:x.loc,p:fmt(x.n),u:x.u,c:x.c,s:x.start||'asap',d:x.d,r:[...(x.req||[]),'','',''].slice(0,3)};qDraw()};
function rd(){const F=S.jbq2,g=i=>$('#'+i);if(g('jqt'))F.t=g('jqt').value;if(g('jql'))F.l=g('jql').value;if(g('jqd'))F.d=g('jqd').value;[0,1,2].forEach(i=>{if(g('jqr'+i))F.r[i]=g('jqr'+i).value});if(g('jqp')){F.p=fmtIn(g('jqp').value);g('jqp').value=F.p}return F}
function qDraw(){const F=S.jbq2,ed=!!F.id;sh(`<div ${H1}>${ed?T('Edit job','Hindura akazi','Modifier l’offre'):T('Post a job','Shyiraho akazi','Publier une offre')}</div><div class="lab" style="margin-top:6px">${T('Job title','Umutwe w’akazi','Intitulé')}</div><input class="in" id="jqt" value="${esc(F.t)}" maxlength="50" oninput="jqChk()" placeholder="${T('Shop assistant','Umukozi mu iduka','Vendeur')}" ${FLD}><div class="lab">${T('Location','Aho biri','Lieu')}</div><input class="in" id="jql" value="${esc(F.l)}" maxlength="40" placeholder="Kimironko" ${FLD}><div class="lab">${T('Pay (RWF)','Umushahara (RWF)','Salaire (RWF)')}</div><input class="in" id="jqp" value="${esc(F.p)}" inputmode="numeric" oninput="jqChk()" placeholder="5,000" ${FLD}><div class="chp" style="padding:10px 0 0">${Object.entries(UN()).map(([k,v])=>chipBtn(F.u===k,`jqSet('u','${k}')`,T('Per ','Ku ','Par ')+v)).join('')}</div><div class="lab">${T('Type','Ubwoko','Type')}</div><div class="chp" style="padding:8px 0 0">${Object.entries(CT()).map(([k,v])=>chipBtn(F.c===k,`jqSet('c','${k}')`,v)).join('')}</div><div class="lab">${T('Start','Itangira','Début')}</div><div class="chp" style="padding:8px 0 0">${Object.entries(START()).map(([k,v])=>chipBtn(F.s===k,`jqSet('s','${k}')`,v)).join('')}</div><div class="lab">${T('What you need (optional)','Ibyo ukeneye (si ngombwa)','Ce qu’il faut (facultatif)')}</div>${[0,1,2].map(i=>`<input class="in" id="jqr${i}" value="${esc(F.r[i]||'')}" maxlength="50" aria-label="${T('Requirement','Icyangombwa','Exigence')} ${i+1}" placeholder="${[T('Own moto','Moto yawe','Moto personnelle'),T('Good with customers','Kwita ku bakiriya','À l’aise avec les clients'),T('Can start within a week','Gutangira mu cyumweru','Peut commencer sous une semaine')][i]}" style="height:42px;margin-top:6px">`).join('')}<div class="lab">${T('Details (optional)','Ibisobanuro (si ngombwa)','Détails (facultatif)')}</div><textarea id="jqd" maxlength="300" aria-label="${T('Details','Ibisobanuro','Détails')}" style="width:100%;box-sizing:border-box;height:76px;margin-top:6px;border:0;border-radius:16px;background:var(--chip);padding:12px;font:inherit;font-size:15px;color:var(--tx);outline:0;resize:none">${esc(F.d)}</textarea><button class="btn" id="jqgo" style="margin-top:18px" disabled onclick="jqGo()">${ed?T('Save','Bika','Enregistrer'):T('Post','Shyiraho','Publier')}</button><div id="jqh" class="sm mu" style="margin-top:8px;text-align:center">${T('Add a title and pay to continue.','Shyiraho umutwe n’umushahara kugira ngo ukomeze.','Ajoutez un intitulé et un salaire pour continuer.')}</div>`);jqChk()}
window.jqChk=()=>{const F=rd(),ok=F.t.trim()&&num(F.p)>0,b=$('#jqgo'),h=$('#jqh');if(b)b.disabled=!ok;if(h)h.style.display=ok?'none':''};
window.jqSet=(k,v)=>{rd();S.jbq2[k]=v;qDraw()};
window.jqGo=()=>{const F=rd(),n=num(F.p);if(!F.t.trim()||!n)return;const req=F.r.map(s=>s.trim()).filter(Boolean),d=F.d.trim()||T('Message the employer for details.','Andikira umukoresha ubone ibisobanuro.','Contactez l’employeur pour les détails.');
if(F.id){const x=item(F.id);Object.assign(x,{ti:F.t.trim(),loc:F.l.trim()||'Kigali',n,u:F.u,c:F.c,start:F.s,d,req});closeSheet();render('fade-none');toast(T('Job updated','Akazi kahinduwe','Offre mise à jour'));return}
H.items.unshift({id:Date.now()%100000,ti:F.t.trim(),loc:F.l.trim()||'Kigali',n,u:F.u,c:F.c,g:'briefcase',who:'You',start:F.s,d,req});S.hdMine.jobs++;S.jbCat='Mine';closeSheet();render('fade-none');toast(T('Posted','Byashyizweho','Publié'))};
/* ---- confirm delete / withdraw ---- */
const _jd=window.jbDel,_jw=window.jbWithdraw;
const conf=(t,m,ok,fn,keep)=>sh(`<div ${H1}>${t}</div><div class="mu" style="font-size:15px;margin:8px 0 20px">${m}</div><button class="btn sec2" style="color:var(--er)" onclick="closeSheet();${fn}">${ok}</button><button class="btn" style="margin-top:10px" onclick="closeSheet()">${keep}</button>`);
window.jbDel=id=>{const x=item(id);if(x)conf(T('Delete this job?','Gusiba aka kazi?','Supprimer cette offre ?'),esc(x.ti)+' '+T('will be removed. This cannot be undone.','kizavanwaho. Ntibisubirwaho.','sera retirée. Action irréversible.'),T('Delete','Siba','Supprimer'),`jbDelGo(${id})`,T('Keep job','Reka akazi gakomeze','Garder l’offre'))};
window.jbDelGo=id=>_jd(id);
window.jbWithdraw=id=>{const x=item(id);if(x)conf(T('Withdraw your application?','Gukuraho ubusabe bwawe?','Retirer votre candidature ?'),esc(x.who)+' '+T('will no longer see it.','ntazongera kububona.','ne la verra plus.'),T('Withdraw','Kuraho','Retirer'),`jbWdGo(${id})`,T('Keep application','Reka ubusabe bukomeze','Garder la candidature'))};
window.jbWdGo=id=>_jw(id);
/* ---- share, report, employer ---- */
window.jbShare=id=>{const l='itunda.rw/j/'+id;try{navigator.clipboard.writeText(l)}catch(e){}toast(T('Link copied: ','Ihuza ryakopowe: ','Lien copié : ')+l)};
window.jbReport=id=>{const R=[T('Scam or fake','Uburiganya cyangwa igihimbano','Arnaque ou faux'),T('Asks for money upfront','Asaba amafaranga mbere','Demande de l’argent à l’avance'),T('Not a real job','Si akazi nyakuri','Pas une vraie offre'),T('Something else','Ikindi','Autre chose')];
sh(`<div ${H1}>${T('Report this job','Tanga raporo kuri aka kazi','Signaler cette offre')}</div><div style="padding-top:6px">${R.map(r=>`<div class="ar tap" style="padding:16px 0;min-height:56px" onclick="jbRepGo(${id})"><div class="t" style="flex:1">${r}</div></div>`).join('')}</div>`)};
window.jbRepGo=id=>{S.jbHide[id]=1;closeSheet();back();toast(T('Thanks. We will review it.','Murakoze. Turabisuzuma.','Merci. Nous allons l’examiner.'))};
const stars=r=>'★'.repeat(Math.round(r))+'☆'.repeat(5-Math.round(r));
window.jbEmp=id=>{const x=item(id);if(!x||x.who==='You')return;const h=hash(x.who),r=4+(h%9)/10,l=H.items.filter(y=>y.who===x.who&&!y.st&&!S.jbHide[y.id]);
sh(`<div style="display:flex;align-items:center;gap:14px">${gl('community',52)}<div><div ${H1.replace('30px','28px')}>${esc(x.who)}</div><div style="color:var(--ok)">${stars(r)} <span class="mu">${r.toFixed(1)}</span></div></div></div><div style="margin:16px -24px 8px"><div style="display:flex;justify-content:space-between;padding:14px 24px;border-top:0;font-size:15px"><span class="mu">${T('People hired','Abakozi bahawe akazi','Personnes embauchées')}</span><b>${3+h%20}</b></div></div><div style="font-size:15px;font-weight:800;margin-bottom:4px">${T('Open jobs','Akazi gahari','Offres ouvertes')}</div>${l.map(y=>`<div class="hdc" role="button" tabindex="0" onclick="closeSheet();hdOpen('jobs',${y.id})"><div class="th">${gl(y.g,44)}</div><div style="flex:1;min-width:0"><div class="t">${esc(y.ti)}</div><div class="s">${esc(y.loc)}</div><div class="pr">${fmt(y.n)} RWF / ${UN()[y.u]}</div></div></div>`).join('')}<button class="btn" style="margin-top:14px" onclick="closeSheet()">OK</button>`)};
/* ---- detail wrapper ---- */
const sim=x=>{const l=H.items.filter(y=>y.id!==x.id&&!y.st&&!S.jbHide[y.id]&&y.who!=='You'&&y.c===x.c).slice(0,3);if(!l.length)return '';return `<div style="font-size:17px;font-weight:800;margin:22px 0 4px">${T('Similar jobs','Akazi kasa','Offres similaires')}</div>${l.map(y=>`<div class="hdc" role="button" tabindex="0" onclick="hdOpen('jobs',${y.id})" style="margin:0 -24px"><div class="th">${gl(y.g,44)}</div><div style="flex:1;min-width:0"><div class="t">${esc(y.ti)}</div><div class="s">${esc(y.who)} · ${esc(y.loc)}</div><div class="pr">${fmt(y.n)} RWF / ${UN()[y.u]}</div></div></div>`).join('')}`};
const _hi=screens.hoodItem;
screens.hoodItem=()=>{let h=_hi();if(S.hd!=='jobs')return h;const x=item(S.hdI);if(!x)return h;const mine=x.who==='You';
if(x.start)h=h.replace(/(<div style="display:flex;gap:8px;margin-top:12px)(">(?:<span[^>]*>[^<]*<\/span>){1})/,(m,a,b)=>a+';flex-wrap:wrap'+b+`<span style="padding:5px 12px;border-radius:14px;background:var(--chip);font-size:13px;font-weight:700">${START()[x.start]||''}</span>`);
if(!mine)h=h.replace('<div style="display:flex;align-items:center;gap:12px;margin-top:22px;padding-top:16px;border-top:0">',`<div class="tap" role="button" tabindex="0" aria-label="${T('Employer','Umukoresha','Employeur')}" onclick="jbEmp(${x.id})" style="cursor:pointer;display:flex;align-items:center;gap:12px;margin-top:22px;padding-top:16px;border-top:0">`);
const extra=mine?(x.st?'':link(T('Edit job','Hindura akazi','Modifier l’offre'),`jbEdit(${x.id})`))+apH(x):link(T('Share','Sangiza','Partager'),`jbShare(${x.id})`)+link(T('Report','Tanga raporo','Signaler'),`jbReport(${x.id})`,'var(--er)')+sim(x);
const blk=`<div class="pad" style="padding-top:4px">${extra}<div style="height:96px"></div></div>`;
const c=h.indexOf('<div class="cta"');return c>0?h.slice(0,c)+blk+h.slice(c):h+blk};
})();
</script>
<script>
/* v93: Maps round 2: press-and-hold to drop a pin (name + save + share), layers sheet with labels toggles, Save and Share on every place, line to the selected place, tap empty map to close. rw/fr strings need native review */
(function(){
const L=(e,r,f)=>({en:e,rw:r,fr:f}[S.lang]||e);
const esc=s=>String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/"/g,'&quot;');
const sh=h=>{$('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" style="max-height:84%;overflow-y:auto">'+h+'</div>'};
const H1='class="h1" style="font-size:22px;line-height:30px"';
const M=()=>S.mp;
const HOOD=[['Kimironko',-1.95,30.126],['Remera',-1.957,30.11],['Kacyiru',-1.944,30.0715],['Nyarugenge',-1.9496,30.0588],['Nyabugogo',-1.94,30.044],['Nyamirambo',-1.976,30.045],['Gisozi',-1.925,30.06],['Kicukiro',-1.979,30.0995],['Gikondo',-1.9714,30.0777],['Kanombe',-1.974,30.153]].map(([n,la,lo])=>{const p=ll2xy(la,lo);return[n,p[0],p[1]]});
const near=(x,y)=>HOOD.reduce((b,h)=>{const d=Math.hypot(h[1]-x,h[2]-y);return d<b[1]?[h[0],d]:b},['',1e9])[0];
const ll=(x,y)=>xy2ll(x,y).map(v=>v.toFixed(5));
const dk=(x,y)=>Math.max(.1,Math.hypot(x-250,y-440)*.0125).toFixed(1)+' km';
const saved=id=>id==='cafe'?!!M().star:!!(M().sv&&M().sv[id]);
const sw=(on,fn,l)=>`<button role="switch" aria-checked="${!!on}" onclick="${fn}" style="display:flex;width:100%;align-items:center;justify-content:space-between;border:0;background:none;font:inherit;color:inherit;padding:14px 0;min-height:48px;text-align:left"><span style="font-weight:700;padding-right:12px">${l}</span><span aria-hidden="true" style="width:46px;height:28px;border-radius:14px;background:${on?'var(--lk)':'var(--chip)'};position:relative;flex:none"><i style="position:absolute;top:3px;left:${on?21:3}px;width:22px;height:22px;border-radius:11px;background:#fff;box-shadow:none"></i></span></button>`;
/* ---- overlay extras: line from you to the selected place ---- */
window.mpExtra=k=>{const m=M(),p=m.sel&&POI.find(q=>q.id===m.sel);if(!p)return '';return `<line x1="250" y1="440" x2="${p.x}" y2="${p.y}" stroke="#2E6BF0" stroke-width="${3*k}" stroke-dasharray="${9*k} ${7*k}" stroke-linecap="round" opacity=".75" pointer-events="none"/>`};
/* ---- drop a pin ---- */
window.mpDrop=(x,y)=>{const [la,lo]=ll(x,y),o={id:'drop',c:'drop',e:'📍',n:L('Dropped pin','Ikimenyetso nashyizeho','Repère placé'),x,y,k:la+', '+lo,r:'',d:dk(x,y),o:L('Near ','Hafi ya ','Près de ')+near(x,y)};
const p=POI.find(q=>q.id==='drop');if(p)Object.assign(p,o);else POI.push(o);const m=M();m.sel='drop';try{navigator.vibrate&&navigator.vibrate(15)}catch(e){}render('fade-none')};
const toWorld=(cx,cy)=>{const s=document.querySelector('.fmsurf');if(!s)return null;const r=s.getBoundingClientRect();if(!r.width)return null;const m=M(),vbw=340/m.z,vbh=vbw*r.height/r.width;return{x:Math.round(m.cx-vbw/2+((cx-r.left)/r.width)*vbw),y:Math.round(m.cy-vbh/2+((cy-r.top)/r.height)*vbh)}};
let lp=null,act=0,multi=false;
const clr=()=>{if(lp)clearTimeout(lp.t)};
document.addEventListener('pointerdown',e=>{if(!e.target.closest||!e.target.closest('.fmsurf'))return;act++;if(act>1){multi=true;clr();lp=null;return}
if(e.target.closest('[role="button"]')){lp=null;return}
const sx=e.clientX,sy=e.clientY;lp={sx,sy,fired:0,t:setTimeout(()=>{if(multi||!lp)return;const w=toWorld(sx,sy);if(w){lp.fired=1;mpDrop(w.x,w.y)}},550)}});
document.addEventListener('pointermove',e=>{if(lp&&Math.hypot(e.clientX-lp.sx,e.clientY-lp.sy)>8){clr();lp.moved=1}});
const end=e=>{const l=lp;clr();if(act>0)act--;if(act===0){const wasMulti=multi;multi=false;
if(l&&!l.fired&&!l.moved&&!wasMulti&&e.type==='pointerup'&&M().sel){M().sel=null;render('fade-none')}lp=null}};
document.addEventListener('pointerup',end);document.addEventListener('pointercancel',end);
window.mpDropSave=()=>{const p=POI.find(q=>q.id==='drop');if(!p)return;sh(`<div ${H1}>${L('Name this place','Tanga izina kuri aha hantu','Nommer ce lieu')}</div><div class="sm mu" style="margin:4px 0 12px">${esc(p.k)} · ${esc(p.o)}</div><input class="in" id="mpnm" maxlength="40" value="${esc(L('My place','Ahantu hanjye','Mon lieu'))}" aria-label="${L('Place name','Izina ry’ahantu','Nom du lieu')}" style="font-size:17px;height:46px"><button class="btn" style="margin-top:16px" onclick="mpDropGo()">${L('Save','Bika','Enregistrer')}</button>`)};
window.mpDropGo=()=>{const p=POI.find(q=>q.id==='drop'),n=(($('#mpnm')||{}).value||'').trim();if(!p)return;if(!n){toast(L('Enter a name first','Banza wandike izina','Saisissez d’abord un nom'));return}
const id='pin'+(Date.now()%100000),m=M();POI.push({id,c:'pin',e:'📌',n,x:p.x,y:p.y,k:L('Saved pin','Ikimenyetso cyabitswe','Repère enregistré')+' · '+p.k,r:'',d:p.d,o:p.o});(m.sv=m.sv||{})[id]=true;m.sel=id;closeSheet();render('fade-none');toast(L('Saved','Byabitswe','Enregistré'))};
window.mpShare=id=>{const p=POI.find(q=>q.id===id);if(!p)return;const [la,lo]=ll(p.x,p.y),l='itunda.rw/map/'+la+','+lo;try{navigator.clipboard.writeText(l)}catch(e){}toast(L('Link copied: ','Ihuza ryakopowe: ','Lien copié : ')+l)};
/* ---- layers sheet ---- */
const LAY=()=>[L('Standard','Isanzwe','Standard'),L('Satellite','Isanzure','Satellite'),L('Terrain','Imiterere y’ubutaka','Relief')];
const dot=c=>`<i style="display:inline-block;width:12px;height:12px;border-radius:6px;background:${c};margin-right:6px;vertical-align:-1px"></i>`;
window.mpLayers=()=>lDraw();
function lDraw(){const m=M(),lg='';
sh(`<div ${H1}>${L('Map layers','Ibice by’ikarita','Calques')}</div><div role="radiogroup" aria-label="${L('Map layers','Ibice by’ikarita','Calques')}" style="padding-top:8px">${LAY().map((l,i)=>`<button role="radio" aria-checked="${m.layer===i}" onclick="mpLayerSet(${i})" style="display:flex;width:100%;align-items:center;gap:12px;border:0;background:none;font:inherit;color:inherit;text-align:left;padding:12px 0;min-height:48px;border-bottom:0"><span style="flex:1;font-weight:700">${l}</span><span aria-hidden="true" style="width:22px;height:22px;border-radius:11px;box-sizing:border-box;border:2px solid ${m.layer===i?'var(--lk)':'var(--tt)'};background:${m.layer===i?'var(--lk)':'none'}"></span></button>`).join('')}</div>${lg?`<div class="sm mu" style="padding:10px 0 0">${lg}</div>`:''}${sw(!m.nolab,'mpTog(\'nolab\')',L('Place names','Amazina y’ahantu','Noms des lieux'))}${sw(!m.nohood,'mpTog(\'nohood\')',L('Neighbourhood names','Amazina y’uduce','Noms des quartiers'))}<button class="btn sec2" style="margin-top:8px" onclick="mpDropMid()">📍 ${L('Drop a pin at the map centre','Shyira ikimenyetso hagati y’ikarita','Placer un repère au centre')}</button><button class="btn" style="margin-top:10px" onclick="closeSheet()">${L('Done','Byarangiye','Terminé')}</button><div class="sm mu" style="padding-top:10px;text-align:center">${L('Tip: press and hold the map to drop a pin.','Inama: fata igihe ku ikarita ushyireho ikimenyetso.','Astuce : appuyez longuement sur la carte pour placer un repère.')}</div>`)}
window.mpLayerSet=i=>{M().layer=i;render('fade-none');lDraw()};
window.mpTog=k=>{M()[k]=M()[k]?0:1;render('fade-none');lDraw()};
window.mpDropMid=()=>{closeSheet();const m=M();mpDrop(Math.round(m.cx),Math.round(m.cy))};
/* ---- map screen wrapper ---- */
const _mv=screens.mapview;
screens.mapview=()=>{let h=_mv();const m=M();h=h.replace('onclick="mpLayer()"','onclick="mpLayers()"');
if(m.sel){const id=m.sel;
if(id==='drop'){h=h.replace(/<button onclick="mpOpenPoi\('drop'\)">[^<]*<\/button>/,'')}
h=h.replace(/(<div class="acts" style="padding:14px 0 0">[\s\S]*?<\/div>)/,s=>s+`<div class="acts" style="padding:8px 0 0"><button onclick="${id==='drop'?'mpDropSave()':`mpSave('${id}')`}">${saved(id)?'★ ':'☆ '}${L('Save','Bika','Enregistrer')}</button><button onclick="mpShare('${id}')">${L('Share','Sangiza','Partager')}</button></div>`)}
return h};
const _om=window.openMaps;
window.openMaps=()=>{_om();if(!S.mpHint){S.mpHint=1;setTimeout(()=>toast(L('Press and hold the map to drop a pin','Fata igihe ku ikarita ushyireho ikimenyetso','Appuyez longuement sur la carte pour placer un repère')),700)}};
})();
</script>
<script>
/* v468: real map tiles (OpenStreetMap data via CARTO, Esri imagery, OpenTopoMap), real Kigali coordinates, real routes (OSM routing) */
(function(){
const MU=12.5,RES0=156543.03392804097,W=20037508.342789244,YOU=[-1.9488,30.127];
const [X0,Y0]=[(30.127)*Math.PI/180*6378137,6378137*Math.log(Math.tan(Math.PI/4-1.9488*Math.PI/360))];
const REAL={cafe:[-1.9408,30.0448],cafe2:[-1.9505,30.1195],rest:[-1.947,30.1235],bus:[-1.939,30.044],bus2:[-1.9493,30.1262],pharm:[-1.95,30.06],atm:[-1.948,30.1225],hosp:[-1.9438,30.093],hosp2:[-1.942,30.08],cafe3:[-1.9482,30.1285],cafe4:[-1.956,30.11],rest2:[-1.951,30.1275],rest3:[-1.976,30.046],rest4:[-1.954,30.06],bus3:[-1.9558,30.1112],bus4:[-1.927,30.062],bus5:[-1.979,30.0995],pharm2:[-1.9475,30.128],pharm3:[-1.9575,30.1085],atm2:[-1.949,30.1272],atm3:[-1.955,30.113]};
const hav=(a,b)=>{const r=Math.PI/180,dl=(b[0]-a[0])*r,dn=(b[1]-a[1])*r,h=Math.sin(dl/2)**2+Math.cos(a[0]*r)*Math.cos(b[0]*r)*Math.sin(dn/2)**2;return 12742*Math.asin(Math.sqrt(h))};
POI.forEach(p=>{const c=REAL[p.id];if(!c)return;const q=ll2xy(c[0],c[1]);p.x=q[0];p.y=q[1];p.ll=c;p.d=Math.max(.1,hav(YOU,c)).toFixed(1)+' km'});
const st=document.createElement('style');st.textContent='.fmsurf{overflow:hidden}.fmsurf #fmg{display:none}.fmsurf>svg{position:relative;z-index:1;background:transparent!important}.rma{position:absolute;right:8px;top:112px;z-index:2;font-size:10px;font-weight:600;color:#333;background:rgba(255,255,255,.78);border-radius:6px;padding:1px 6px;pointer-events:none}.rmm{position:relative;overflow:hidden;background:var(--chip);touch-action:none}.rmm svg.rmo{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;z-index:1}.rmm .rmk{position:absolute;z-index:2;pointer-events:none;font-size:14px;transform:translate(-50%,-50%);width:26px;height:26px;border-radius:13px;background:#fff;border:2.5px solid #E8604C;display:flex;align-items:center;justify-content:center}.rmm .rmk.big{width:40px;height:40px;border-radius:20px 20px 20px 4px;transform:translate(-50%,-100%) rotate(0);font-size:20px;background:#E8604C;border-color:#fff}.rmm .rmu{position:absolute;z-index:2;width:18px;height:18px;margin:-9px;border-radius:9px;background:#2E6BF0;border:3px solid #fff;pointer-events:none}.rmm .rma{top:auto;bottom:4px;right:6px}';document.head.appendChild(st);
const TS=[{u:d=>d?'https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png':'https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png',mz:20,at:'\u00a9 OpenStreetMap \u00b7 \u00a9 CARTO'},{u:()=>'https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}',mz:19,at:'Imagery \u00a9 Esri, Maxar'},{u:()=>'https://{s}.tile.opentopomap.org/{z}/{x}/{y}.png',mz:17,at:'\u00a9 OpenStreetMap \u00b7 OpenTopoMap'}];
const dark=()=>{const t=document.documentElement.getAttribute('data-theme');return t==='dark'||(t!=='light'&&matchMedia('(prefers-color-scheme:dark)').matches)};
let lastTL=null;
class TL{constructor(host,lf,reuse){this.lf=lf;if(reuse){this.el=reuse.el;this.lv=reuse.lv;this.key=reuse.key;this.cur=reuse.cur}else{this.el=document.createElement('div');this.el.style.cssText='position:absolute;inset:0;overflow:hidden;z-index:0;pointer-events:none;background:var(--chip)';this.lv={};this.key='';this.cur=-1}host.insertBefore(this.el,host.firstChild)}
set(cx,cy,k,w,h){const L=this.lf(),T=TS[L]||TS[0],dk=L===0&&dark(),key=L+''+dk;if(key!==this.key){this.el.innerHTML='';this.lv={};this.key=key}
const mpp=k*MU,Z=Math.max(0,Math.min(T.mz,Math.round(Math.log2(RES0/mpp)))),XL=X0+(cx-w*k/2-250)*MU,YT=Y0+(440-(cy-h*k/2))*MU,n=2**Z,wm=256*RES0/n;
if(Z!==this.cur){this.cur=Z;clearTimeout(this.ct);this.ct=setTimeout(()=>{for(const z in this.lv)if(+z!==this.cur){this.lv[z].remove();delete this.lv[z]}},700)}
let lay=this.lv[Z];if(!lay){lay=this.lv[Z]=document.createElement('div');lay.style.cssText='position:absolute;inset:0;z-index:'+Z;lay.t={};this.el.appendChild(lay)}
const x0=Math.floor((XL+W)/wm),x1=Math.floor((XL+w*mpp+W)/wm),y0=Math.floor((W-YT)/wm),y1=Math.floor((W-YT+h*mpp)/wm);
for(let tx=x0;tx<=x1;tx++)for(let ty=y0;ty<=y1;ty++){if(ty<0||ty>=n)continue;const ax=((tx%n)+n)%n,id=tx+'/'+ty;if(lay.t[id])continue;const im=new Image();im.draggable=false;im.decoding='async';im.style.cssText='position:absolute;left:0;top:0;max-width:none;transform-origin:0 0;opacity:0;transition:opacity .2s';im.onload=()=>im.style.opacity=1;let tried=0;im.onerror=()=>{if(L===0&&!tried++)im.src=`https://tile.openstreetmap.org/${Z}/${ax}/${ty}.png`;else window.__tileFail=1};const r=devicePixelRatio>1&&L===0?'@2x':'';im.src=T.u(dk).replace('{s}','abcd'[(ax+ty)%4]).replace('{z}',Z).replace('{x}',ax).replace('{y}',ty).replace('{r}',r);im._tx=tx;im._ty=ty;lay.t[id]=im;lay.appendChild(im)}
for(const z in this.lv){const l=this.lv[z],wz=256*RES0/2**z,sz=wz/mpp;for(const id in l.t){const im=l.t[id],px=(-W+im._tx*wz-XL)/mpp,py=(YT-(W-im._ty*wz))/mpp;im.style.width=im.style.height=(sz+.5)+'px';im.style.transform=`translate(${px}px,${py}px)`}}
lastTL=this;return T}}
const attr=(h,T)=>{let a=h.querySelector(':scope>.rma');if(!a){a=document.createElement('div');a.className='rma';h.appendChild(a)}if(a.textContent!==T.at)a.textContent=T.at};
const _sa=window.__sa;window.__sa=function(){if(_sa)_sa.apply(this,arguments);const s=document.querySelector('.fmsurf');if(!s)return;const r=s.getBoundingClientRect();if(!r.width)return;const m=S.mp,k=(340/m.z)/r.width;if(!s._tl)s._tl=new TL(s,()=>S.mp.layer||0,lastTL);attr(s,s._tl.set(m.cx,m.cy,k,r.width,r.height))};
/* ---- real routes ---- */
const RC={};const PF={bus:'car',car:'car',walk:'foot',bike:'bike'};
function getRoute(mode,a,b){const pf=PF[mode],key=pf+a+b;if(key in RC)return Promise.resolve(RC[key]);const u=`https://routing.openstreetmap.de/routed-${pf}/route/v1/driving/${a[1]},${a[0]};${b[1]},${b[0]}?overview=full&geometries=geojson`;return fetch(u,{signal:window.AbortSignal&&AbortSignal.timeout?AbortSignal.timeout(7000):undefined}).then(r=>r.json()).then(j=>RC[key]=j.routes&&j.routes[0]||null).catch(()=>RC[key]=null)}
const num=n=>String(n).replace(/\B(?=(\d{3})+(?!\d))/g,',');
function syncOpt(mode,r){if(!r||r.__d)return false;r.__d=1;const o=window.__OPT&&__OPT[mode];if(!o||!o[0])return false;const km=(r.distance/1000).toFixed(1),min=Math.max(1,Math.round(r.duration/60));if(mode==='car'){o[0][1]=min;o[0][2]=km+' km \u00b7 Free'}else if(mode==='walk'){o[0][1]=min;o[0][2]=km+' km \u00b7 '+num(Math.round(r.distance/.65))+' steps'}else if(mode==='bike'){o[0][1]=min;o[0][2]=km+' km'}else return false;return true}
/* ---- mini maps (place + directions) ---- */
function mini(el){const w=el.clientWidth,h=el.clientHeight;if(!w)return false;el.dataset.on=1;const M=S.mp,dest=POI.find(p=>p.n===PL.n)||POI.find(p=>p.id==='cafe'),isRt=el.dataset.k==='rt',frm=isRt&&M.from&&POI.find(p=>p.n===M.from),A0=frm&&frm.ll||YOU,B0=dest.ll||YOU,A=isRt&&M.sw?B0:A0,B=isRt&&M.sw?A0:B0;
const v={cx:0,cy:0,k:.5};const a=ll2xy(A[0],A[1]),b=ll2xy(B[0],B[1]);
if(isRt){v.cx=(a[0]+b[0])/2;v.cy=(a[1]+b[1])/2;v.k=Math.max(.35,Math.max(Math.abs(a[0]-b[0])/(w-90),Math.abs(a[1]-b[1])/(h-140)))*1.12}else{v.cx=b[0];v.cy=b[1]-12;v.k=.42}
const tl=new TL(el,()=>S.mp.layer||0,null),svg=document.createElementNS('http://www.w3.org/2000/svg','svg');svg.setAttribute('class','rmo');el.appendChild(svg);const mk=[];let line=null;
const add=(cls,html,ll)=>{const d=document.createElement('div');d.className=cls;d.innerHTML=html;d._ll=ll;el.appendChild(d);mk.push(d)};
if(!isRt)POI.forEach(p=>{if(p.ll&&p!==dest&&hav(p.ll,B)<.6)add('rmk',p.e,p.ll)});
add('rmu','',YOU);if(isRt){add('rmk','\ud83d\udccd',A);}add('rmk big',dest.e||'\ud83d\udccd',B);
const col=M.mode==='bus'?'#3B7D20':'#2E6BF0';
const draw=()=>{const W2=el.clientWidth,H2=el.clientHeight,T=tl.set(v.cx,v.cy,v.k,W2,H2);attr(el,T);const P=ll=>{const q=ll2xy(ll[0],ll[1]);return[(q[0]-v.cx)/v.k+W2/2,(q[1]-v.cy)/v.k+H2/2]};mk.forEach(d=>{const q=P(d._ll);d.style.left=q[0]+'px';d.style.top=q[1]+'px'});
const pts=line||[A,B];const d='M'+pts.map(c=>P(c).map(n=>n.toFixed(1)).join(' ')).join('L');if(isRt)svg.innerHTML=`<path d="${d}" fill="none" stroke="#fff" stroke-width="9" stroke-linecap="round" stroke-linejoin="round"/><path d="${d}" fill="none" stroke="${col}" stroke-width="5.5" stroke-linecap="round" stroke-linejoin="round" ${M.mode==='bike'?'stroke-dasharray="1 9"':''} ${line?'':'stroke-dasharray="2 9" opacity=".7"'}/>`};
draw();
if(isRt)getRoute(M.mode,A,B).then(r=>{if(!el.isConnected)return;if(r&&r.geometry){line=r.geometry.coordinates.map(c=>[c[1],c[0]]);const xs=line.map(c=>ll2xy(c[0],c[1])),mn=i=>Math.min(...xs.map(q=>q[i])),mx=i=>Math.max(...xs.map(q=>q[i]));v.cx=(mn(0)+mx(0))/2;v.cy=(mn(1)+mx(1))/2;v.k=Math.max(.3,Math.max((mx(0)-mn(0))/(w-70),(mx(1)-mn(1))/(h-130))*1.08);draw();if(syncOpt(M.mode,r))render('fade-none')}});
/* pan + zoom */
const ps=new Map();let pd=0;el.addEventListener('pointerdown',e=>{if(e.target.closest('button,.mcs'))return;ps.set(e.pointerId,[e.clientX,e.clientY]);try{el.setPointerCapture(e.pointerId)}catch(_){}pd=ps.size===2?Math.hypot(...[...ps.values()].reduce((s,c,i)=>i?[c[0]-s[0],c[1]-s[1]]:c,[0,0])):0});
el.addEventListener('pointermove',e=>{const o=ps.get(e.pointerId);if(!o)return;if(ps.size===1){v.cx-=(e.clientX-o[0])*v.k;v.cy-=(e.clientY-o[1])*v.k;ps.set(e.pointerId,[e.clientX,e.clientY]);draw()}else{ps.set(e.pointerId,[e.clientX,e.clientY]);const c=[...ps.values()],d=Math.hypot(c[0][0]-c[1][0],c[0][1]-c[1][1]);if(pd){v.k=Math.min(4,Math.max(.05,v.k*pd/d));draw()}pd=d}});
const up=e=>{ps.delete(e.pointerId);pd=0};el.addEventListener('pointerup',up);el.addEventListener('pointercancel',up);
el.addEventListener('wheel',e=>{e.preventDefault();v.k=Math.min(4,Math.max(.05,v.k*Math.exp(e.deltaY*.0015)));draw()},{passive:false});
el.addEventListener('dblclick',()=>{v.k=Math.max(.05,v.k/1.6);draw()});return true}
const mount=()=>document.querySelectorAll('.rmm:not([data-on])').forEach(mini);
{const _r=window.render;window.render=render=function(){const o=_r.apply(this,arguments);try{mount()}catch(e){console.error(e)}[0,50,250].forEach(t=>setTimeout(()=>{try{mount()}catch(e){}},t));return o}}
{const _rt=screens.route;screens.route=()=>_rt().replace(/<svg viewBox="0 0 340 330"[\s\S]*?<\/svg>/,'<div class="rmm" data-k="rt" style="height:330px"></div>')}
{const _pl=screens.place;screens.place=()=>_pl().replace(/(<div style="position:relative">)<svg viewBox="0 0 340 \d+"[\s\S]*?<\/svg>/,'$1<div class="rmm" data-k="pl" style="height:300px"></div>')}
})();
/* v470: itunda Place card */
{const L=(e,r,f)=>({en:e,rw:r,fr:f}[S.lang]||e),M=S.mp;if(!M.st)M.st={};if(!M.rsv)M.rsv=[];
const sh=h=>{$('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet">'+h+'</div>'};
const cur=()=>(window.POI||[]).find(p=>p.n===PL.n)||{id:'cafe',n:PL.n},stN=()=>M.st[cur().id]||0;
const KW=[['☕',L('Great coffee','Ikawa nziza','Super café'),312],['💻',L('Good for working','Nziza ku kazi','Idéal pour travailler'),208],['📶','Wi-Fi',164],['🪑',L('Spacious','Hagari','Spacieux'),97]];
const stamps=()=>{const n=stN();return `<div style="display:flex;gap:6px;margin-top:10px">${Array.from({length:8},(_,i)=>`<i style="flex:1;height:30px;border-radius:15px;display:flex;align-items:center;justify-content:center;font-style:normal;font-size:15px;background:${i<n?'var(--lk)':'var(--bg)'};color:#fff">${i<n?'★':''}</i>`).join('')}</div>`};
const card=()=>`<div style="padding:18px 16px 0"><div style="display:flex;gap:8px;flex-wrap:wrap">${KW.map(k=>`<span style="background:var(--chip);border-radius:16px;padding:6px 12px;font-size:13px;font-weight:700">${k[0]} ${k[1]} <b style="color:var(--lk)">${k[2]}</b></span>`).join('')}</div>
<div style="margin-top:16px;border-radius:22px;background:var(--tint);padding:16px"><b style="color:var(--tintfg);font-size:16px">itunda Place</b><div class="sm" style="margin-top:2px;color:var(--tintfg)">${L('Pay, reserve and collect stamps here','Ishyura, bika kandi ukusanye utubuto hano','Payez, réservez et cumulez des tampons')}</div>
<div style="display:flex;gap:8px;margin-top:12px"><button class="btn" style="height:44px;font-size:15px" onclick="plPay()">${L('Pay here','Ishyura hano','Payer ici')}</button><button class="btn sec2" style="height:44px;font-size:15px;background:var(--bg)" onclick="plRsv()">${L('Reserve','Bika','Réserver')}</button></div>
<div style="margin-top:14px;font-size:14px;font-weight:800;display:flex;justify-content:space-between;color:var(--tintfg)"><span>${L('Stamp card','Ikarita y’utubuto','Carte de tampons')}</span><span>${stN()}/8 · ${L('8th drink free','Icya 8 ni ubuntu','8e boisson offerte')}</span></div>${stamps()}
<button class="pbtn" style="margin-top:12px;background:var(--bg)" onclick="plStamp()">★ ${L('Collect a stamp (demo)','Fata akabuto (igerageza)','Ajouter un tampon (démo)')}</button></div>
${M.rsv.length?`<div class="fi" style="padding:14px 8px 0"><b>📅 ${L('Reserved','Byabitswe','Réservé')}: ${M.rsv.map(r=>r.p+' · '+r.t+' · '+r.n).join(', ')}</b></div>`:''}</div>`;
window.plStamp=()=>{const p=cur();M.st[p.id]=Math.min(8,stN()+1);toast(M.st[p.id]>=8?L('Free drink unlocked!','Ikinyobwa cy’ubuntu cyafunguwe!','Boisson offerte débloquée !'):L('Stamp added','Akabuto kongewe','Tampon ajouté'));render('fade-none')};
M.rq=M.rq||{t:'18:00',n:2};
window.plRsv=()=>{const q=M.rq;sh(`<div class="h1" style="font-size:22px;line-height:30px">${L('Reserve a table','Bika ameza','Réserver une table')}</div><div class="mu" style="margin:4px 0 14px">${cur().n}</div><div class="req">${['12:00','14:00','18:00','20:00'].map(t=>`<button class="${q.t===t?'on':''}" onclick="M.rq.t='${t}';plRsv()">${t}</button>`).join('')}</div><div class="req" style="margin:10px 0 20px">${[1,2,4,6].map(n=>`<button class="${q.n===n?'on':''}" onclick="M.rq.n=${n};plRsv()">${n} ${L('people','abantu','pers.')}</button>`).join('')}</div><button class="btn" onclick="plBook()">${L('Confirm reservation','Emeza kubika','Confirmer')}</button>`)};
window.plBook=()=>{M.rsv.unshift({p:cur().n,t:M.rq.t,n:M.rq.n});closeSheet();toast(L('Reserved','Byabitswe','Réservé'));render('fade-none')};
const _pl=screens.place;screens.place=()=>{let h=_pl();const a='<div class="ptabs"',b='<button class="pbtn"';
return h.includes(a)?h.replace(a,card()+a):h.includes(b)?h.replace(b,card()+b):h};}

/* v471: Places and Directions hubs */
{const L=(e,r,f)=>({en:e,rw:r,fr:f}[S.lang]||e),M=S.mp,P=()=>window.POI||[];
const hd=(t,sub)=>`${bar(t)}<div class="pad" style="padding-top:4px"><div class="mu" style="font-size:15px">${sub}</div></div>`;
const sec=t=>`<div class="mt2" style="padding-top:22px">${t}</div>`;
const tile=(e,l,on,b)=>`<button class="tap" onclick="${on}" style="flex:0 0 31%;border:0;background:var(--chip);border-radius:18px;padding:14px 6px;font:inherit;font-weight:700;font-size:13px;color:var(--tx);position:relative"><div style="font-size:24px">${e}</div>${l}${b?`<span style="position:absolute;top:6px;right:8px;min-width:18px;height:18px;border-radius:9px;background:var(--lk);color:#fff;font-size:11px;padding:0 5px;line-height:18px">${b}</span>`:''}</button>`;
const prow=p=>`<div class="pl tap" onclick="mpOpenPoi('${p.id}')"><i style="font-style:normal;font-size:20px">${p.e}</i><div style="flex:1;min-width:0"><b style="display:block;font-size:17px;font-weight:600">${p.n}</b><span>${p.k}${p.r?' · ★ '+p.r:''} · ${p.d}</span></div></div>`;
const svd=p=>p.id==='cafe'?!!M.star:!!(M.sv&&M.sv[p.id]);
window.openPlaces=()=>{S.stack=['placehub'];render('push')};
window.openDirections=()=>{S.stack=['dirhub'];render('push')};
window.plCat=k=>{M.cat=k;M.sel=null;M.fc=null;S.stack=['mapview'];render('push')};
window.dhGo=(id,mode)=>{const p=P().find(x=>x.id===id)||P()[0];PL.n=p.n;M.mode=mode||'bus';M.opt=0;M.exp=false;M.from=null;S.stack.push('route');render('push')};
screens.placehub=()=>{const pop=P().filter(p=>p.r&&p.c!=='bus').sort((a,b)=>parseFloat(b.r)-parseFloat(a.r)).slice(0,4),sv=P().filter(svd),rv=Object.values(M.myrev||{}).reduce((a,x)=>a+x.length,0),stk=Object.entries(M.st||{}).filter(x=>x[1]>0);
return `${hd(L('Places','Ahantu','Lieux'),L('Discover places, pay, reserve and collect stamps','Shakisha ahantu, ishyura, bika ukusanye utubuto','Découvrez, payez, réservez et cumulez des tampons'))}
<div class="mps tap" onclick="mpGo('mapsearch')">${ic('search',20,'var(--tt)')}<span style="flex:1">${L('Search places','Shakisha ahantu','Rechercher un lieu')}</span></div>
${sec(L('Browse','Shakisha','Parcourir'))}<div class="mcs" style="flex-wrap:wrap;gap:10px;padding:0 16px">${[['☕',L('Cafe','Ikawa','Café'),'cafe'],['🍽️',L('Food','Ibiryo','Repas'),'food'],['🏥',L('Hospital','Ibitaro','Hôpital'),'hosp'],['💊',L('Pharmacy','Farumasi','Pharmacie'),'pharm'],['🏧','ATM','atm'],['🚌',L('Bus stops','Bisi','Arrêts'),'bus']].map(c=>tile(c[0],c[1],`plCat('${c[2]}')`)).join('')}</div>
${sec(L('Popular near you','Bikunzwe hafi yawe','Populaires près de vous'))}${pop.map(prow).join('')}
${sec(L('My places','Ahantu hanjye','Mes lieux'))}<div class="mcs" style="gap:10px;padding:0 16px">${tile('⭐',L('Saved','Byabitswe','Favoris'),"mpGo('mpsaved')",sv.length||'')}${tile('📅',L('Reserved','Byabitswe','Réservé'),"plRsvList()",M.rsv.length||'')}${tile('💬',L('Reviews','Ibitekerezo','Avis'),"plReviews()",rv||'')}</div>
${sec(L('Stamp cards','Amakarita y’utubuto','Cartes de tampons'))}${stk.length?stk.map(([id,n])=>{const p=P().find(x=>x.id===id);return p?`<div class="pl tap" onclick="mpOpenPoi('${id}')"><i style="font-style:normal">🎟️</i><b>${p.n}</b><span>${n}/8</span></div>`:''}).join(''):`<div class="pad mu" style="font-size:14px;padding-top:6px">${L('No stamps yet. Pay at a place to start a card.','Nta bututo ufite. Ishyura ahantu utangire ikarita.','Aucun tampon. Payez dans un lieu pour commencer.')}</div>`}
<div class="pad" style="padding-top:20px"><button class="btn" onclick="ppGo('paytill')">${L('Pay at a place','Ishyura ahantu','Payer dans un lieu')}</button></div>
${M.rec&&M.rec.length?sec(L('Recent','Ibyaheruka','Récents'))+M.rec.slice(0,3).map(r=>`<div class="pl"><i>${ic('pin',20,'var(--tt)')}</i><b>${r[0]}</b><span>${r[1]}</span></div>`).join(''):''}<div style="height:30px"></div>`};
window.plRsvList=()=>{const h=M.rsv.length?M.rsv.map(r=>`<div class="row" style="cursor:default"><div class="t">${r.p}</div><div class="r">${r.t} · ${r.n}</div></div>`).join(''):`<div class="mu" style="padding:14px 0">${L('No reservations yet.','Nta cyemezo cyo kubika.','Aucune réservation.')}</div>`;$('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="h1" style="font-size:22px;line-height:30px">'+L('Reservations','Ibyabitswe','Réservations')+'</div>'+h+'</div>'};
screens.dirhub=()=>{const dh=S.dh||(S.dh={}),dd=P().find(p=>p.id===dh.dest),stops=P().filter(p=>p.c==='bus'&&(!dh.line||p.k.includes(dh.line))),modes=[['🚌',L('Bus','Bisi','Bus'),'bus'],['🚗',L('Car','Imodoka','Voiture'),'car'],['🚶',L('Walk','Genda','Marche'),'walk'],['🚲',L('Bike','Igare','Vélo'),'bike']];
return `${hd(L('Directions','Inzira','Itinéraires'),L('Plan trips around Kigali','Teganya ingendo muri Kigali','Planifiez vos trajets à Kigali'))}
<div class="rbox" style="margin-top:12px"><div class="fi" style="padding:10px 4px"><span style="width:12px;height:12px;border-radius:6px;border:3px solid #2BA84A;margin:6px 6px 0 0"></span>${L('My location','Aho ndi','Ma position')} · KG 11 Ave, Kimironko</div><div class="fi" style="padding:6px 4px;align-items:center"><span style="width:12px;height:12px;border-radius:6px;border:3px solid #D92D20;margin:0 6px 0 0;flex:none"></span>${dd?`<b style="flex:1">${dd.n}</b><button class="ib" style="width:32px;height:32px" aria-label="Clear" onclick="dhPick(null)">${ic('plus',18,'var(--tt)').replace('<svg','<svg style="transform:rotate(45deg)"')}</button>`:`<input id="dhq" autocomplete="off" placeholder="${L('Where to?','Ujya he?','Où allez-vous ?')}" oninput="dhQ(this.value)" style="flex:1;min-width:0;border:0;background:none;outline:0;font:inherit;font-size:16px;color:var(--tx);height:36px">`}</div></div><div id="dhres"></div>
<div class="chp" style="padding-top:12px">${[['🏠',L('Home','Mu rugo','Maison'),"mpAddr('Home','KG 7 Ave 22, Kacyiru')"],['💼',L('Work','Akazi','Travail'),"mpAddr('Work','Kigali Heights, KG 7 Ave')"]].map(x=>`<button onclick="${x[2]}">${x[0]} ${x[1]}</button>`).join('')}</div>
${sec(L('Travel mode','Uburyo bwo kugenda','Mode de transport'))}<div class="mcs" style="gap:10px;padding:0 16px">${modes.map(m=>tile(m[0],m[1],`dhGo('${dd?dd.id:'cafe'}','${m[2]}')`)).join('')}</div>
${sec(L('Bus stops near you','Aho bisi zihagarara hafi','Arrêts proches'))}${stops.length?'':`<div class="pad mu" style="font-size:14px;padding-top:6px">${L('No stops for this line nearby.','Nta hantu hafi h’iyi bisi.','Aucun arrêt proche pour cette ligne.')}</div>`}${stops.slice(0,3).map(p=>`<div class="pl tap" onclick="mpOpenPoi('${p.id}')"><i style="font-style:normal">🚌</i><div style="flex:1;min-width:0"><b style="display:block;font-size:17px;font-weight:600">${p.n}</b><span>${p.k} · ${p.o}</span></div></div>`).join('')}
${sec(L('Bus lines','Imirongo ya bisi','Lignes de bus'))}<div class="chp" style="padding-top:0">${['102','305','311','322'].map(n=>`<button class="${dh.line===n?'on':''}" onclick="dhLine('${n}')">🚌 ${n}</button>`).join('')}</div>
${M.rec&&M.rec.length?sec(L('Recent routes','Inzira zaheruka','Itinéraires récents'))+M.rec.slice(0,3).map(r=>{const p=P().find(x=>x.n===r[0]);return `<div class="pl tap" onclick="${p?`dhGo('${p.id}','bus')`:'soon()'}"><i>${ic('pin',20,'var(--tt)')}</i><b>${r[0]}</b><span>${r[1]}</span></div>`}).join(''):''}
${sec(L('Fares and rides','Amafaranga y’ingendo','Tarifs et trajets'))}<div class="pl tap" onclick="openTransit()"><i>${ic('wallet',20,'var(--tt)')}</i><b>${L('Bus fare · Tap&Go','Amafaranga ya bisi · Tap&Go','Tarif bus · Tap&Go')}</b></div><div style="height:30px"></div>`};
window.dhQ=v=>{const q=v.trim().toLowerCase(),el=document.getElementById('dhres');if(!el)return;const r=q?P().filter(p=>p.c!=='drop'&&(p.n+' '+p.k).toLowerCase().includes(q)).slice(0,5):[];el.innerHTML=q?(r.length?r.map(p=>`<div class="pl tap" onclick="dhPick('${p.id}')"><i style="font-style:normal;font-size:20px">${p.e}</i><div style="flex:1;min-width:0"><b style="display:block;font-size:17px;font-weight:600">${p.n}</b><span>${p.k} · ${p.d}</span></div></div>`).join(''):`<div class="pad mu" style="text-align:center;padding-top:16px">${L('No results','Nta bisubizo','Aucun résultat')}</div>`):''};
window.dhPick=id=>{(S.dh=S.dh||{}).dest=id;render('fade-none')};
window.dhLine=n=>{S.dh=S.dh||{};S.dh.line=S.dh.line===n?null:n;render('fade-none')};
window.plPay=()=>{const p=P().find(x=>x.n===PL.n);if(!p||p.id==='cafe')S.tl='204518';ppGo('paytill')};
window.plReviews=()=>{const all=[];Object.entries(M.myrev||{}).forEach(([id,a])=>{const p=P().find(x=>x.id===id);a.forEach(r=>all.push([p?p.n:id,r[0],r[1]]))});$('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="h1" style="font-size:22px;line-height:30px">'+L('My reviews','Ibitekerezo byanjye','Mes avis')+'</div>'+(all.length?all.map(r=>`<div style="padding:12px 0"><b>${r[0]}</b> <span style="color:#F5B301">${'★'.repeat(r[1])}</span><div class="mu" style="margin-top:4px;font-size:14px">${String(r[2]||'').replace(/</g,'&lt;')}</div></div>`).join(''):`<div class="mu" style="padding:14px 0">${L('No reviews yet. Open a place and tap Write a review.','Nta bitekerezo. Fungura ahantu wandike igitekerezo.','Aucun avis. Ouvrez un lieu pour en écrire un.')}</div>`)+'</div>'};}

/* v473: swap start/destination, editable Home and Work, saved routes */
{const L=(e,r,f)=>({en:e,rw:r,fr:f}[S.lang]||e),M=S.mp,P=()=>window.POI||[],cl=v=>String(v||'').replace(/['"<>\\]/g,'').trim().slice(0,60);
M.hw=M.hw||{Home:'KG 7 Ave 22, Kacyiru',Work:'Kigali Heights, KG 7 Ave'};M.sr=M.sr||[];
const esc=x=>x.replace(/[.*+?^${}()|[\]\\]/g,'\\$&');
window.mpSwap=()=>{M.sw=!M.sw;toast(L('Start and destination swapped','Itangiriro n’aho ugana byahinduwe','Départ et arrivée inversés'));render('fade-none')};
window.mpSaveRoute=()=>{const i=M.sr.findIndex(r=>r.n===PL.n&&r.m===M.mode);if(i>=0){M.sr.splice(i,1);toast(L('Route removed','Inzira yakuweho','Itinéraire retiré'))}else{M.sr.unshift({n:PL.n,m:M.mode});toast(L('Route saved','Inzira yabitswe','Itinéraire enregistré'))}render('fade-none')};
window.dhSR=i=>{const r=M.sr[i];if(!r)return;const p=P().find(x=>x.n===r.n);if(p)dhGo(p.id,r.m);else{M.mode=r.m;mpAddr('',r.n)}};
window.dhHW=()=>{$('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="h1" style="font-size:22px;line-height:30px">'+L('Home and Work','Mu rugo n’Akazi','Maison et Travail')+'</div>'+['Home','Work'].map(k=>`<div class="lab">${k==='Home'?L('Home','Mu rugo','Maison'):L('Work','Akazi','Travail')}</div><input class="in" id="hw${k}" value="${M.hw[k]}" maxlength="60" autocomplete="off">`).join('')+`<button class="btn" style="margin-top:20px" onclick="dhHWSave()">${L('Save','Bika','Enregistrer')}</button></div>`};
window.dhHWSave=()=>{['Home','Work'].forEach(k=>{const v=cl((document.getElementById('hw'+k)||{}).value);if(v)M.hw[k]=v});closeSheet();toast(L('Saved','Byabitswe','Enregistré'));render('fade-none')};
const _dh=screens.dirhub;screens.dirhub=()=>{let h=_dh();
h=h.replace("mpAddr('Home','KG 7 Ave 22, Kacyiru')","mpAddr('Home','"+M.hw.Home+"')").replace("mpAddr('Work','Kigali Heights, KG 7 Ave')","mpAddr('Work','"+M.hw.Work+"')").replace(/(💼[^<]*<\/button>)/,'$1<button onclick="dhHW()" aria-label="Edit">✎</button>');
if(M.sr.length){const i=h.lastIndexOf('<div class="mt2"'),blk=`<div class="mt2" style="padding-top:22px">${L('Saved routes','Inzira zabitswe','Itinéraires enregistrés')}</div>`+M.sr.map((r,k)=>`<div class="pl tap" onclick="dhSR(${k})"><i style="font-style:normal">${({bus:'🚌',car:'🚗',walk:'🚶',bike:'🚲'})[r.m]||'📍'}</i><b>${r.n.replace(/</g,'&lt;')}</b></div>`).join('');if(i>0)h=h.slice(0,i)+blk+h.slice(i)}
return h};
const _rt=screens.route;screens.route=()=>{let h=_rt();h=h.replace("onclick=\"toast('Start and destination swapped')\"",'onclick="mpSwap()"');
const sv=M.sr.some(r=>r.n===PL.n&&r.m===M.mode);h=h.replace(/(<button class="ib" aria-label="Swap"[\s\S]*?<\/button>)/,`$1<button class="ib" aria-label="Save route" onclick="mpSaveRoute()" style="color:${sv?'#F5B301':'var(--tt)'}">${sv?'★':'☆'}</button>`);
if(M.sw){const n=esc(PL.n.replace(/&/g,'&amp;'));h=h.replace(new RegExp('(#2BA84A[^>]*></span>)KG 11 Ave, Kimironko'),(m,a)=>a+PL.n).replace(new RegExp('(#D92D20[^>]*></span>)'+n),(m,a)=>a+'KG 11 Ave, Kimironko')}return h};
['dhGo','mpArriveAt'].forEach(f=>{const o=window[f];if(o)window[f]=function(){M.sw=false;return o.apply(this,arguments)}})}

</script>
<script>
/* v98: Property round 2: filters + alerts, property types, amenities, compare, viewings hub with confirmation, mortgage + move-in cost, agent page, ask the agent, richer list/edit form, enquiries for your own listings, similar homes, share/report, confirm delete. rw/fr strings need native review */
(function(){
const T=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e;
const esc=s=>String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/"/g,'&quot;');
const sh=h=>{$('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" style="max-height:86%;overflow-y:auto">'+h+'</div>'};
const H=HD.property,item=id=>H.items.find(x=>x.id===id),view=id=>S.prV.find(v=>v.id===id);
const H1='class="h1" style="font-size:22px;line-height:30px"';
const num=s=>Number(String(s).replace(/,/g,''));
const fmtIn=v=>v.replace(/\D/g,'').replace(/\B(?=(\d{3})+(?!\d))/g,',');
const hash=s=>[...String(s)].reduce((a,c)=>(a*31+c.charCodeAt(0))%9973,7);
const day=i=>{const d=new Date();d.setDate(d.getDate()+1+i);return d};
const dl=d=>d.toLocaleDateString('en-GB',{weekday:'short',day:'numeric',month:'short'});
const TM=['09:00','11:00','14:00','16:00'];
const cb=(on,fn,l)=>`<button class="${on?'on':''}" aria-pressed="${!!on}" onclick="${fn}">${l}</button>`;
const kv=(a,b)=>`<div style="display:flex;justify-content:space-between;gap:10px;padding:8px 0;font-size:15px"><span class="mu">${a}</span><b style="text-align:right">${b}</b></div>`;
const lk=(t,fn,c)=>`<button style="border:0;background:none;font:inherit;font-size:14px;font-weight:700;color:${c||'var(--lk)'};padding:10px 0;min-height:44px;margin-right:18px" onclick="${fn}">${t}</button>`;
const tg=(t,c)=>`<span style="padding:3px 9px;border-radius:10px;background:var(--chip);font-size:12px;font-weight:700;color:${c||'var(--mu)'}">${t}</span>`;
const stars=r=>'★'.repeat(Math.round(r))+'☆'.repeat(5-Math.round(r));
const sec=t=>`<div style="font-size:17px;font-weight:800;margin:22px 0 4px">${t}</div>`;
const conf=(t,m,ok,fn,keep)=>sh(`<div ${H1}>${t}</div><div class="mu" style="font-size:15px;margin:8px 0 20px">${m}</div><button class="btn sec2" style="color:var(--er)" onclick="closeSheet();${fn}">${ok}</button><button class="btn" style="margin-top:10px" onclick="closeSheet()">${keep}</button>`);
/* ---- data ---- */
const NF=()=>({area:'',kind:'',band:0,furn:0,am:[],hide:0});
if(!S.p2){S.p2=1;Object.assign(S,{pf:NF(),pAl:0,pCmp:[],pIv:{},pEq:{},pHide:{},pTip:0,pCa:{dn:20,yr:15,rt:12}});
const ex={1:{k:'apt',am:['water','power','park'],dp:2,ago:2,ok:1},2:{k:'room',am:['water','sec'],dp:1,ago:5,ok:0},3:{k:'house',am:['sec','gar','park','water'],dp:0,ago:1,ok:1},4:{k:'apt',am:['net','sec','lift'],dp:2,ago:3,ok:1},5:{k:'house',am:['gar','park','water'],dp:2,ago:7,ok:0},6:{k:'apt',am:['lift','park','bal','sec'],dp:0,ago:4,ok:1}};
H.items.forEach(x=>Object.assign(x,ex[x.id]||{k:'house',am:[],dp:x.c==='Rent'?2:0,ago:0,ok:0}));
H.items.push({id:7,ti:'Land plot, 600 m²',loc:'Bugesera',n:18000000,u:'',beds:0,baths:0,m2:600,furn:null,g:'house',c:'Sale',who:'Agent Diane',d:'Flat plot with a title deed, five minutes from the tarmac road. Water line nearby.',k:'land',am:['water'],dp:0,ago:2,ok:1},
{id:8,ti:'Shop on a busy road',loc:'Nyabugogo',n:350000,u:'mo',beds:0,baths:1,m2:40,furn:null,g:'bag',c:'Rent',who:'Agent Samuel',d:'Ground floor shop with a glass front and a storage room. Steady foot traffic all day.',k:'shop',am:['power','sec'],dp:3,ago:1,ok:0},
{id:9,ti:'Room in a shared house',loc:'Remera',n:45000,u:'mo',beds:1,baths:1,m2:14,furn:1,g:'house',c:'Rent',who:'Agent Diane',d:'Private room, shared kitchen and bathroom with two other tenants. Wi-Fi included.',k:'room',am:['net','water'],dp:1,ago:3,ok:1},
{id:10,ti:'4-bedroom villa',loc:'Nyarutarama',n:320000000,u:'',beds:4,baths:4,m2:320,furn:0,g:'house',c:'Sale',who:'Agent Samuel',d:'Gated villa with a garden, staff quarters and a generator. Titled plot.',k:'house',am:['gar','park','sec','water','net'],dp:0,ago:6,ok:1})}
const CL=()=>({All:T('All','Byose','Tout'),Rent:T('Rent','Gukodesha','Location'),Sale:T('Sale','Kugurisha','Vente'),Saved:T('Saved','Ibibitswe','Enregistrés'),Mine:T('Mine','Ibyanjye','Mes annonces')});
const KD=()=>({apt:T('Apartment','Inzu y’ibyumba','Appartement'),house:T('House','Inzu','Maison'),room:T('Room','Icyumba','Chambre'),shop:T('Shop','Iduka','Boutique'),land:T('Land','Ubutaka','Terrain')});
const AM=()=>({water:T('Water','Amazi','Eau'),power:T('Power','Amashanyarazi','Électricité'),park:T('Parking','Parikingi','Parking'),sec:T('Security','Umutekano','Sécurité'),net:T('Internet','Interineti','Internet'),gar:T('Garden','Ubusitani','Jardin'),lift:T('Lift','Lifuti','Ascenseur'),bal:T('Balcony','Balikoni','Balcon')});
const BANDS=()=>[T('Any price','Igiciro cyose','Tout prix'),T('Budget','Gito','Petit budget'),T('Mid-range','Hagati','Moyen'),T('Premium','Hejuru','Haut de gamme')];
const SS=()=>[T('Newest','Bishya','Récents'),T('Price ↑','Igiciro ↑','Prix ↑'),T('Price ↓','Igiciro ↓','Prix ↓'),T('Size','Ingano','Surface')];
const SL=()=>[T('Newest first','Bishya mbere','Plus récents'),T('Price: low to high','Igiciro: gito ujya hejuru','Prix croissant'),T('Price: high to low','Igiciro: hejuru ujya hasi','Prix décroissant'),T('Biggest first','Binini mbere','Plus grands d’abord')];
const BD=()=>[T('Any beds','Ibyumba byose','Toutes ch.'),'1','2','3+'];
const price=x=>fmt(x.n)+' RWF'+(x.u==='mo'?T(' / month',' ku kwezi',' / mois'):'');
const sub=x=>x.loc+' · '+KD()[x.k||'house']+(x.beds?' · '+x.beds+T(' beds',' ibyumba',' ch.'):'')+(x.m2?' · '+x.m2+' m²':'');
const taken=x=>x.c==='Rent'?T('Rented','Yakodeshejwe','Loué'):T('Sold','Yagurishijwe','Vendu');
const agoL=x=>x.ago?T(x.ago+' days ago','Hashize iminsi '+x.ago,'Il y a '+x.ago+' j'):T('Today','Uyu munsi','Aujourd’hui');
const tags=x=>(x.st?tg(taken(x)):'')+(x.ok?tg('✓ '+T('Verified','Byemejwe','Vérifié'),'var(--ok)'):'')+((x.ago||0)<=2&&!x.st?tg(T('New','Gishya','Nouveau'),'var(--tintfg)'):'')+(x.furn?tg(T('Furnished','Ibikoresho','Meublé')):'');
/* ---- filter + list ---- */
const fOk=x=>{const f=S.pf;if(S.pHide[x.id]||(f.area&&x.loc!==f.area)||(f.kind&&x.k!==f.kind)||(f.furn&&!x.furn)||(f.hide&&x.st)||f.am.some(a=>!(x.am||[]).includes(a)))return 0;
if(f.band){const t=x.u?[1e5,3e5]:[5e7,15e7];if((x.n<t[0]?1:x.n<t[1]?2:3)!==f.band)return 0}return 1};
const nF=()=>{const f=S.pf;return(f.area?1:0)+(f.kind?1:0)+(f.band?1:0)+(f.furn?1:0)+f.am.length+(f.hide?1:0)};
function rows(){const q=S.prQ.trim().toLowerCase(),c=S.prCat,b=S.prB,s=S.prSort;
const l=H.items.filter(x=>(c==='All'||x.c===c||(c==='Saved'&&S.hdFav['property:'+x.id])||(c==='Mine'&&x.who==='You'))&&(!b||(b===3?x.beds>=3:x.beds===b))&&(!q||(x.ti+' '+x.loc).toLowerCase().includes(q))&&fOk(x));
if(s===1)l.sort((a,b)=>a.n-b.n);else if(s===2)l.sort((a,b)=>b.n-a.n);else if(s===3)l.sort((a,b)=>(b.m2||0)-(a.m2||0));else l.sort((a,b)=>(a.ago||0)-(b.ago||0));
if(!l.length)return `<div class="pad mu" style="padding-top:30px;text-align:center;line-height:22px">${c==='Saved'?T('Tap the heart on a property to save it here.','Kanda umutima ku nzu ngo uyibike hano.','Touchez le cœur d’un bien pour l’enregistrer ici.'):c==='Mine'?T('You have not listed a property yet.','Nta nzu urashyiraho.','Vous n’avez encore rien publié.'):T('No matches. Try another filter.','Nta bihuye. Gerageza irindi hitamo.','Aucun résultat. Essayez un autre filtre.')}${nF()?`<div><button class="cch on" style="margin-top:12px" onclick="pFr();render('fade-none')">${T('Clear filters','Kuraho ibyo wahisemo','Effacer les filtres')}</button></div>`:''}</div>`;
return `<div class="pad sm mu" style="padding-top:4px">${l.length} ${T('results','ibisubizo','résultats')}</div>`+l.map(x=>{const cm=S.pCmp.includes(x.id);return `<div class="hdc" role="button" tabindex="0" style="${x.st?'opacity:.55':''}" onclick="hdOpen('property',${x.id})"><div class="th">${gl(x.g,44)}</div><div style="flex:1;min-width:0"><div class="t">${esc(x.ti)}</div><div class="s">${esc(sub(x))}</div><div class="pr">${price(x)}</div><div style="display:flex;gap:6px;margin-top:6px;flex-wrap:wrap">${tags(x)}</div></div><div style="display:flex;flex-direction:column;align-items:center;gap:4px">${hdHeart('property',x.id)}<button class="cch ${cm?'on':''}" aria-pressed="${cm}" aria-label="${T('Compare','Gereranya','Comparer')}" style="height:32px;padding:0 10px;font-size:13px" onclick="event.stopPropagation();pCmpT(${x.id})">${cm?'✓':'⇄'}</button></div></div>`}).join('')}
const chips=()=>H.cats.map(c=>`<button class="cch ${S.prCat===c?'on':''}" onclick="prCat('${c}')">${CL()[c]}</button>`).join('');
const bchips=()=>BD().map((b,i)=>`<button class="cch ${S.prB===i?'on':''}" onclick="prBeds(${i})">${b}</button>`).join('');
const OL='style="border:2px solid var(--ln);background:none"';
const tools=()=>`<button class="cch" ${OL} onclick="pFilt()">⚙ ${T('Filter','Hitamo','Filtrer')}${nF()?' · '+nF():''}</button><button class="cch" ${OL} onclick="pCmpOpen()">⇄ ${T('Compare','Gereranya','Comparer')}${S.pCmp.length?' · '+S.pCmp.length:''}</button><button class="cch" ${OL} onclick="pVws()">📅 ${T('Viewings','Gusura','Visites')}${S.prV.length?' · '+S.prV.length:''}</button>`;
const tip=()=>S.pTip?'':`<div style="margin:12px 24px 0;padding:14px 16px;border-radius:20px;background:var(--tint)"><b style="color:var(--tintfg)">${T('Stay safe','Irinde uburiganya','Restez prudent')}</b><div class="sm" style="margin-top:2px;line-height:19px">${T('Never pay a deposit before you have seen the home and read the contract.','Ntukishyure ingwate utarasura inzu ngo usome n’amasezerano.','Ne versez jamais de caution avant d’avoir visité et lu le contrat.')}</div><button class="cch" style="height:40px;margin-top:8px" onclick="S.pTip=1;render('fade-none')">${T('Got it','Ndabyumvise','Compris')}</button></div>`;
const oh=screens.hood;
screens.hood=()=>{if(S.hd!=='property')return oh();
return `${bar(H.t)}<div style="display:flex;gap:10px;padding:12px 24px 0"><input id="prq" type="search" aria-label="${T('Search properties','Shakisha imitungo','Rechercher')}" placeholder="${T('Search properties','Shakisha imitungo','Rechercher un bien')}" value="${esc(S.prQ)}" oninput="prSearch(this.value)" style="flex:1;min-width:0;height:44px;border-radius:22px;border:0;background:var(--chip);color:var(--tx);font:inherit;font-size:15px;padding:0 16px"><button id="prsort" class="cch" style="height:44px;padding:0 14px" aria-label="${T('Sort','Tondeka','Trier')}" onclick="pSort()">⇅ ${SS()[S.prSort]}</button></div><div class="chips" style="padding-top:12px" id="prtl">${tools()}</div><div class="chips" style="padding-top:8px" id="prch">${chips()}</div><div class="chips" style="padding-top:8px" id="prbd">${bchips()}</div>${tip()}<div style="padding-top:8px" id="prl">${rows()}</div><div class="pad fine" style="padding-top:18px">${T('Listings are sample data for this prototype.','Ibyatanzwe ni ibigerageza muri prototype.','Les annonces sont des données d’exemple.')}</div><div class="fab"><button class="btn" onclick="hdPost()">${T('List a property','Shyiraho inzu','Publier un bien')}</button></div>`};
window.prSearch=v=>{S.prQ=v;$('#prl').innerHTML=rows()};
window.prCat=c=>{S.prCat=c;$('#prch').innerHTML=chips();$('#prl').innerHTML=rows()};
window.prBeds=i=>{S.prB=i;$('#prbd').innerHTML=bchips();$('#prl').innerHTML=rows()};
const _tg=window.hdTg;window.hdTg=(t,id)=>{_tg(t,id);if(t==='property'&&$('#prl'))$('#prl').innerHTML=rows()};
window.pSort=()=>sh(`<div ${H1}>${T('Sort by','Tondeka ukurikije','Trier par')}</div><div role="radiogroup" style="padding-top:8px">${SL().map((l,i)=>`<button role="radio" aria-checked="${S.prSort===i}" onclick="S.prSort=${i};closeSheet();render('fade-none')" style="display:flex;width:100%;justify-content:space-between;align-items:center;border:0;border-bottom:0;background:none;font:inherit;color:inherit;text-align:left;padding:16px 0;min-height:56px;font-weight:${S.prSort===i?800:600}">${l}<span style="color:var(--lk)">${S.prSort===i?'✓':''}</span></button>`).join('')}</div>`);
/* ---- filter sheet + alerts ---- */
let AR=[];
function fDraw(){const f=S.pf;AR=[...new Set(H.items.map(x=>x.loc))];const n=H.items.filter(fOk).length,W='style="padding:8px 0 0;flex-wrap:wrap;overflow:visible"';
sh(`<div ${H1}>${T('Filter','Hitamo','Filtrer')}</div><div class="lab" style="margin-top:14px">${T('Area','Agace','Quartier')}</div><div class="chp" ${W}>${AR.map((a,i)=>cb(f.area===a,`pFa(${i})`,esc(a))).join('')}</div><div class="lab">${T('Property type','Ubwoko bw’inzu','Type de bien')}</div><div class="chp" ${W}>${Object.entries(KD()).map(([k,v])=>cb(f.kind===k,`pFk('${k}')`,v)).join('')}</div><div class="lab">${T('Price','Igiciro','Prix')}</div><div class="chp" ${W}>${BANDS().map((v,i)=>cb(f.band===i,`pFb(${i})`,v)).join('')}</div><div class="sm mu" style="margin-top:6px;line-height:18px">${T('Rent: under 100k, 100k to 300k, over 300k a month. Sale: under 50M, 50M to 150M, over 150M.','Gukodesha: munsi ya 100k, 100k–300k, hejuru ya 300k ku kwezi. Kugurisha: munsi ya 50M, 50M–150M, hejuru ya 150M.','Location : moins de 100k, 100k à 300k, plus de 300k par mois. Vente : moins de 50M, 50M à 150M, plus de 150M.')}</div><div class="lab">${T('Must have','Ibigomba kuba bihari','Indispensable')}</div><div class="chp" ${W}>${Object.entries(AM()).map(([k,v])=>cb(f.am.includes(k),`pFm('${k}')`,v)).join('')}</div><div class="chp" ${W}>${cb(f.furn,`pFt('furn')`,T('Furnished only','Irimo ibikoresho gusa','Meublé seulement'))}${cb(f.hide,`pFt('hide')`,T('Hide rented / sold','Hisha ibyakodeshejwe / ibyagurishijwe','Masquer loués / vendus'))}${cb(S.pAl,'pFal()','🔔 '+T('Alert me about new matches','Menyesha ku bishya bihuye','Alertes nouveautés'))}</div><div class="row2" style="margin-top:16px"><button class="btn sec2" onclick="pFr();fDraw2()">${T('Reset','Subiza uko byari bimeze','Réinitialiser')}</button><button class="btn" onclick="closeSheet();render('fade-none')">${T('Show ','Erekana ','Voir ')}${n}</button></div>`)}
window.fDraw2=fDraw;window.pFilt=fDraw;
window.pFa=i=>{S.pf.area=S.pf.area===AR[i]?'':AR[i];fDraw()};
window.pFk=k=>{S.pf.kind=S.pf.kind===k?'':k;fDraw()};
window.pFb=i=>{S.pf.band=i;fDraw()};
window.pFm=k=>{const a=S.pf.am,n=a.indexOf(k);n<0?a.push(k):a.splice(n,1);fDraw()};
window.pFt=k=>{S.pf[k]=S.pf[k]?0:1;fDraw()};
window.pFal=()=>{S.pAl=S.pAl?0:1;fDraw();toast(S.pAl?T('Alerts on. We will notify you (sample).','Imenyesha zifunguye (urugero).','Alertes activées (exemple).'):T('Alerts off','Imenyesha zafunzwe','Alertes désactivées'))};
window.pFr=()=>{S.pf=NF()};
/* ---- compare ---- */
window.pCmpT=id=>{const a=S.pCmp,n=a.indexOf(id);if(n<0){if(a.length>=3){toast(T('Compare up to 3 homes','Gereranya inzu 3 gusa','Comparez 3 biens maximum'));return}a.push(id)}else a.splice(n,1);
if($('#prl')){$('#prl').innerHTML=rows();$('#prtl').innerHTML=tools()}else render('fade-none')};
const CR=()=>[[T('Price','Igiciro','Prix'),x=>price(x)],[T('Area','Agace','Quartier'),x=>esc(x.loc)],[T('Type','Ubwoko','Type'),x=>KD()[x.k||'house']],[T('Bedrooms','Ibyumba','Chambres'),x=>x.beds||'–'],[T('Bathrooms','Ubwiherero','Salles de bain'),x=>x.baths||'–'],[T('Size','Ingano','Surface'),x=>x.m2?x.m2+' m²':'–'],[T('Per m²','Kuri m²','Par m²'),x=>x.m2?fmt(Math.round(x.n/x.m2))+' RWF':'–'],[T('Furnished','Ibikoresho','Meublé'),x=>x.furn==null?'–':x.furn?T('Yes','Yego','Oui'):T('No','Oya','Non')],[T('Deposit','Ingwate','Caution'),x=>x.dp?x.dp+T(' months',' amezi',' mois'):'–']];
window.pCmpOpen=()=>{const l=S.pCmp.map(item).filter(Boolean);
if(l.length<2){sh(`<div ${H1}>${T('Compare homes','Gereranya inzu','Comparer des biens')}</div><div class="mu" style="font-size:15px;line-height:22px;margin:8px 0 18px">${T('Tap ⇄ on two or three listings to compare them side by side.','Kanda ⇄ ku nzu ebyiri cyangwa eshatu ubigereranye.','Touchez ⇄ sur deux ou trois annonces pour les comparer.')}</div><button class="btn" onclick="closeSheet()">${T('Got it','Ndabyumvise','Compris')}</button>`);return}
sh(`<div ${H1}>${T('Compare homes','Gereranya inzu','Comparer des biens')}</div><div style="overflow-x:auto;margin:12px -24px 0;padding:0 24px"><table style="border-collapse:collapse;font-size:14px;min-width:100%"><tr><td></td>${l.map(x=>`<th style="text-align:left;padding:8px 10px;min-width:110px;vertical-align:top"><button style="border:0;background:none;font:inherit;font-weight:800;color:var(--lk);text-align:left;padding:0" onclick="closeSheet();hdOpen('property',${x.id})">${esc(x.ti)}</button></th>`).join('')}</tr>${CR().map(([a,f])=>`<tr style="border-top:0"><td class="mu" style="padding:10px 0;white-space:nowrap">${a}</td>${l.map(x=>`<td style="padding:10px;font-weight:700">${f(x)}</td>`).join('')}</tr>`).join('')}</table></div><div class="row2" style="margin-top:16px"><button class="btn sec2" onclick="S.pCmp=[];closeSheet();render('fade-none')">${T('Clear','Siba byose','Effacer')}</button><button class="btn" onclick="closeSheet()">${T('Done','Byarangiye','Terminé')}</button></div>`)};
/* ---- viewings hub ---- */
const _vg=window.prVGo;
window.prVGo=()=>{const id=S.prf.id;_vg();S.pIv[id]=0;setTimeout(()=>{if(view(id)){S.pIv[id]=1;const x=item(id);if(x)toast(x.who+T(' confirmed your viewing',' yemeje gusura kwawe',' a confirmé votre visite'))}},4000)};
window.pVws=()=>{const l=S.prV.filter(v=>item(v.id));sh(`<div ${H1}>${T('Your viewings','Gusura kwawe','Vos visites')}</div>`+(l.length?l.map(v=>{const x=item(v.id),ok=S.pIv[v.id];return `<div style="padding:14px 0;border-bottom:0"><div style="display:flex;justify-content:space-between;gap:8px"><b>${dl(day(v.d))}, ${TM[v.t]}</b><span class="sm" style="font-weight:700;color:${ok?'var(--ok)':'var(--mu)'}">${ok?T('Confirmed','Byemejwe','Confirmée'):T('Waiting for agent','Utegereje umuhuza','En attente')}</span></div><div class="sm mu" style="margin-top:2px">${esc(x.ti)} · ${esc(x.loc)}</div><div class="chips" style="padding:8px 0 0"><button class="cch" onclick="closeSheet();hdOpen('property',${v.id})">${T('Open','Fungura','Ouvrir')}</button><button class="cch" onclick="closeSheet();prView(${v.id})">${T('Reschedule','Hindura igihe','Reporter')}</button><button class="cch" onclick="pVc(${v.id})">${T('Cancel','Hagarika','Annuler')}</button></div></div>`}).join(''):`<div class="mu" style="padding:18px 0;font-size:15px;line-height:22px">${T('No viewings booked. Open a home and tap Book a viewing.','Nta gusura wateguye. Fungura inzu ukande Gena igihe cyo gusura.','Aucune visite. Ouvrez un bien et réservez une visite.')}</div>`)+`<button class="btn sec2" style="margin-top:14px" onclick="closeSheet()">${T('Close','Funga','Fermer')}</button>`)};
window.pVc=id=>{const x=item(id);conf(T('Cancel this viewing?','Guhagarika gusura?','Annuler cette visite ?'),esc(x.ti),T('Cancel viewing','Hagarika gusura','Annuler la visite'),`pVcGo(${id})`,T('Keep viewing','Reka gusura bikomeze','Garder la visite'))};
window.pVcGo=id=>{window.prVCancel(id);if($('#prtl'))$('#prtl').innerHTML=tools();else render('fade-none')};
/* ---- mortgage ---- */
function cDraw(){const x=item(S.pCi),a=S.pCa,P=x.n*(1-a.dn/100),r=a.rt/1200,N=a.yr*12,mo=Math.round(P*r/(1-Math.pow(1+r,-N))),ch=(k,v,u)=>`<div class="chp" style="padding:8px 0 0">${v.map(y=>cb(a[k]===y,`pCs('${k}',${y})`,y+u)).join('')}</div>`;
sh(`<div ${H1}>${T('Mortgage estimate','Igereranya ry’inguzanyo','Estimation du crédit')}</div><div class="sm mu" style="margin-top:4px">${esc(x.ti)} · ${fmt(x.n)} RWF</div><div style="font-size:32px;font-weight:800;margin-top:14px">${fmt(mo)} RWF<span class="sm mu" style="font-weight:600"> ${T('/ month',' ku kwezi',' / mois')}</span></div><div class="lab" style="margin-top:14px">${T('Down payment','Ayo utanga mbere','Apport')}</div>${ch('dn',[10,20,30,40],'%')}<div class="lab">${T('Years','Imyaka','Années')}</div>${ch('yr',[10,15,20],'')}<div class="lab">${T('Interest rate','Inyungu','Taux')}</div>${ch('rt',[10,12,14],'%')}<div style="margin-top:16px">${kv(T('Loan amount','Inguzanyo','Montant du crédit'),fmt(Math.round(P))+' RWF')}${kv(T('Total interest','Inyungu yose','Intérêts totaux'),fmt(Math.round(mo*N-P))+' RWF')}${kv(T('Cash needed upfront','Amafaranga akenewe mbere','Apport à prévoir'),fmt(Math.round(x.n*a.dn/100+x.n*.02))+' RWF')}</div><div class="sm mu" style="line-height:19px">${T('Upfront includes about 2% for registration and notary fees. For illustration only.','Harimo hafi ya 2% y’iyandikisha n’umunotari. Ni urugero gusa.','Inclut environ 2 % de frais d’enregistrement et de notaire. À titre indicatif.')}</div><button class="btn" style="margin-top:16px" onclick="closeSheet()">${T('Done','Byarangiye','Terminé')}</button>`)}
window.pCalc=id=>{S.pCi=id;cDraw()};window.pCs=(k,v)=>{S.pCa[k]=v;cDraw()};
/* ---- agent, ask, share, report ---- */
const Q=()=>[T('Is it still available?','Iracyahari?','Est-il toujours disponible ?'),T('Can I view it tomorrow?','Nshobora kuyisura ejo?','Puis-je visiter demain ?'),T('Is the price negotiable?','Igiciro kirahinduka?','Le prix est-il négociable ?'),T('Are water and electricity included?','Amazi n’amashanyarazi birimo?','Eau et électricité incluses ?')];
window.pAsk=id=>sh(`<div ${H1}>${T('Ask the agent','Baza umuhuza','Poser une question')}</div><div style="padding-top:8px">${Q().map((q,i)=>`<button onclick="pAskGo(${id},${i})" style="display:flex;width:100%;border:0;border-bottom:0;background:none;font:inherit;color:inherit;text-align:left;padding:16px 0;min-height:56px;font-weight:700">${q}</button>`).join('')}</div><button class="btn sec2" style="margin-top:14px" onclick="closeSheet();hdChat('property',${id})">${T('Write my own message','Andika ubutumwa bwanjye','Écrire mon message')}</button>`);
window.pAskGo=(id,i)=>{const x=item(id),th='hdproperty'+id,m=Q()[i];hdThread(th,x.who,x.ti,[['me',m]]);if(S.msgs[th].length>1||S.msgs[th][0][1]!==m)S.msgs[th].push(['me',m]);closeSheet();S.tab='messages';openChat(th)};
window.pAgent=id=>{const x=item(id),h=hash(x.who),r=4+(h%9)/10,l=H.items.filter(y=>y.who===x.who&&!y.st&&!S.pHide[y.id]);
sh(`<div style="display:flex;align-items:center;gap:14px">${gl('community',52)}<div><div ${H1.replace('30px','28px')}>${esc(x.who)}</div><div style="color:var(--ok)">${stars(r)} <span class="mu">${r.toFixed(1)}</span></div></div></div><div style="margin-top:10px">${tg('✓ '+T('Verified agent','Umuhuza wemejwe','Agent vérifié'),'var(--ok)')}</div><div style="margin:8px 0">${kv(T('Replies within','Asubiza mu','Répond sous'),(1+h%5)+T(' hours',' masaha',' h'))}${kv(T('Open listings','Ibyatanzwe bigihari','Annonces ouvertes'),l.length)}</div>${sec(T('Listings','Ibyatanzwe','Annonces'))}${l.map(y=>`<div class="hdc" role="button" tabindex="0" onclick="closeSheet();hdOpen('property',${y.id})" style="margin:0 -24px"><div class="th">${gl(y.g,44)}</div><div style="flex:1;min-width:0"><div class="t">${esc(y.ti)}</div><div class="s">${esc(y.loc)}</div><div class="pr">${price(y)}</div></div></div>`).join('')}<button class="btn" style="margin-top:14px" onclick="closeSheet();pAsk(${id})">${T('Message','Ohereza ubutumwa','Message')}</button>`)};
window.pShare=id=>{const l='itunda.rw/p/'+id;try{navigator.clipboard.writeText(l)}catch(e){}toast(T('Link copied: ','Ihuza ryakopowe: ','Lien copié : ')+l)};
window.pReport=id=>{const R=[T('Scam or fake listing','Uburiganya cyangwa igihimbano','Arnaque ou fausse annonce'),T('Asks for money before a viewing','Asaba amafaranga mbere yo gusura','Demande de l’argent avant la visite'),T('Wrong price or photos','Igiciro cyangwa amafoto atari byo','Prix ou photos erronés'),T('Already rented or sold','Yamaze gukodeshwa cyangwa kugurishwa','Déjà loué ou vendu')];
sh(`<div ${H1}>${T('Report this listing','Tanga raporo kuri iki cyashyizweho','Signaler cette annonce')}</div><div style="padding-top:6px">${R.map(r=>`<div class="ar tap" style="padding:16px 0;min-height:56px" role="button" tabindex="0" onclick="pRepGo(${id})"><div class="t" style="flex:1">${r}</div></div>`).join('')}</div>`)};
window.pRepGo=id=>{S.pHide[id]=1;closeSheet();back();toast(T('Thanks. We will review it.','Murakoze. Turabisuzuma.','Merci. Nous allons l’examiner.'))};
/* ---- own listings: enquiries, reopen, confirm delete ---- */
const NM=['Aline U.','Eric M.','Claire N.','Patrick H.','Sandra B.'];
const EQ=()=>[T('Asks to view this weekend.','Arasaba gusura muri weekend.','Demande une visite ce week-end.'),T('Is the price negotiable?','Igiciro kirahinduka?','Le prix est-il négociable ?'),T('Is it still available?','Iracyahari?','Est-il toujours disponible ?')];
const enq=id=>S.pEq[id]||(S.pEq[id]=[...Array(2+id%2)].map((_,i)=>({n:NM[(id+i*2)%5],k:(id+i)%3,s:0})));
window.pEs=(id,i,s)=>{enq(id)[i].s=s;render('fade-none');toast(s===2?T('Enquiry declined','Ubusabe bwanzwe','Demande refusée'):T('Done','Byakozwe','Fait'))};
window.pReopen=id=>{item(id).st=0;render('fade-none');toast(T('Listing is open again','Icyashyizweho cyongeye gufungurwa','Annonce de nouveau ouverte'))};
const _pd=window.prDel;
window.prDel=id=>{const x=item(id);if(x)conf(T('Delete this listing?','Gusiba icyashyizweho?','Supprimer cette annonce ?'),esc(x.ti)+' '+T('will be removed. This cannot be undone.','kizavanwaho. Ntibisubirwaho.','sera retirée. Action irréversible.'),T('Delete','Siba','Supprimer'),`prDelGo(${id})`,T('Keep listing','Reka gikomeze','Garder l’annonce'))};
window.prDelGo=id=>{S.pCmp=S.pCmp.filter(i=>i!==id);_pd(id)};
/* ---- list / edit form ---- */
const _hp=window.hdPost;
window.hdPost=(()=>{const LOCS=()=>[...new Set(['Kimironko','Remera','Kacyiru','Gisozi','Nyamirambo','Kicukiro',...H.items.map(x=>x.loc).filter(Boolean)])];
const nbF=F=>F.k==='land'||F.k==='shop',PS=F=>['c','k','l','p',...(F.c==='Rent'?['dp']:[]),...(F.k==='land'?[]:['rm']),'m','am','t','d'];
const PQ=F=>({c:T('Rent or sale?','Gukodesha cyangwa kugurisha?','Location ou vente ?'),k:T('What kind of property?','Ni inzu y’ubwoko ki?','Quel type de bien ?'),l:T('Which neighbourhood?','Mu mudugudu uhe?','Quel quartier ?'),p:F.c==='Rent'?T('What is the monthly rent?','Ubukode ku kwezi ni angahe?','Quel est le loyer mensuel ?'):T('What is the price?','Igiciro ni angahe?','Quel est le prix ?'),dp:T('How much deposit?','Ingwate ingana iki?','Quelle caution ?'),rm:T('How many rooms?','Ibyumba ni bingahe?','Combien de pièces ?'),m:T('How big is it?','Ingano yaryo ni iki?','Quelle surface ?'),am:T('What does it have?','Ifite iki?','Qu’offre-t-il ?'),t:T('Name your listing','Tanga umutwe w’icyashyizweho','Donnez un titre à l’annonce'),d:T('Anything else to add?','Hari ikindi wongeraho?','Autre chose à ajouter ?')});
const W='style="padding:8px 0 0;flex-wrap:wrap;overflow:visible"';
const pw=WZ.mk({id:'pw',rd:()=>rd(),steps:PS,final:()=>T('Post','Shyiraho','Publier'),go:()=>pqGo(),
ok:(F,k)=>k==='t'?!!F.t.trim():k==='p'?num(F.p)>0:true,opt:(F,k)=>k==='m'?!F.m:k==='am'?!(F.am.length||F.fu):false,
page:(k,F)=>{const q=PQ(F)[k],rent=F.c==='Rent',pk=(key,v,l)=>WZ.opt(F[key]===v,`WZ.r.pw.pick('${key}',${WZ.q(v)})`,l),cr=(key,list)=>`<div class="chp" ${W}>${list.map(([y,l])=>cb(F[key]===y,`WZ.r.pw.set('${key}',${WZ.q(y)})`,l)).join('')}</div>`;let body='',o={q};
if(k==='c'){o.btn=0;body=pk('c','Rent',CL().Rent)+pk('c','Sale',CL().Sale)}
else if(k==='k'){o.btn=0;body=Object.entries(KD()).map(([a,v])=>pk('k',a,v)).join('')}
else if(k==='l'){o.btn=0;body=LOCS().map(l=>pk('l',l,esc(l))).join('')}
else if(k==='p'){o.min=170;body=`<input class="in" id="pqp" value="${esc(F.p)}" inputmode="numeric" oninput="WZ.r.pw.chk()" onkeydown="WZ.key(event,'pw')" aria-label="${q}" placeholder="${rent?'250,000':'45,000,000'}" ${WZ.amt}><div class="sm mu" style="margin-top:8px">RWF${rent?' '+T('per month','ku kwezi','par mois'):''}</div>${WZ.quick('pqp',rent?[10000,50000,100000]:[1000000,5000000,10000000],'pw')}`}
else if(k==='dp'){o.btn=0;body=[0,1,2,3].map(n=>pk('dp',n,n===0?T('No deposit','Nta ngwate','Aucune caution'):n===1?T('1 month','Ukwezi 1','1 mois'):n+' '+T('months','amezi','mois'))).join('')}
else if(k==='rm'){o.min=200;body=(nbF(F)?'':`<div class="lab" style="margin-top:0">${T('Bedrooms','Ibyumba','Chambres')}</div>${cr('b',[1,2,3,4].map(n=>[n,n===4?'4+':n]))}`)+`<div class="lab">${T('Bathrooms','Ubwiherero','Salles de bain')}</div>${cr('ba',[1,2,3].map(n=>[n,n]))}`}
else if(k==='m'){o.min=110;body=`<input class="in" id="pqm" value="${esc(F.m)}" inputmode="numeric" oninput="WZ.r.pw.chk()" onkeydown="WZ.key(event,'pw')" aria-label="${q}" placeholder="70" ${WZ.amt}><div class="sm mu" style="margin-top:8px">m²</div>`}
else if(k==='am'){o.min=220;body=`<div class="chp" ${W}>${Object.entries(AM()).map(([a,v])=>cb(F.am.includes(a),`pwTog('${a}')`,v)).join('')}${rent&&F.k!=='land'?cb(F.fu,`WZ.r.pw.set('fu',${F.fu?0:1})`,T('Furnished','Ibikoresho','Meublé')):''}</div>`}
else if(k==='t'){const au=KD()[F.k]+(F.l?' · '+F.l:'');if(!F.t.trim()||F.t===F.au){F.t=au;F.au=au}o.min=110;body=`<input class="in" id="pqt" value="${esc(F.t)}" maxlength="50" oninput="WZ.r.pw.chk()" onkeydown="WZ.key(event,'pw')" aria-label="${q}" style="font-size:20px;height:56px">`}
else{o.min=190;o.sum=esc(F.t)+' · '+esc(F.p)+' RWF'+(rent?' '+T('per month','ku kwezi','par mois'):'');body=`<textarea id="pqd" maxlength="300" aria-label="${q}" oninput="WZ.r.pw.chk()" placeholder="${T('Floor, condition, what is nearby… (optional)','Etaje, uko imeze, ibiri hafi… (si ngombwa)','Étage, état, alentours… (facultatif)')}" ${WZ.txt}>${esc(F.d)}</textarea>`}
o.body=body;return o}});
window.pwTog=k=>{const a=rd().am,n=a.indexOf(k);n<0?a.push(k):a.splice(n,1);pw.draw()};
return()=>{if(S.hd!=='property')return _hp();S.pqf={id:0,t:'',l:'',p:'',c:'Rent',k:'apt',b:2,ba:1,m:'',dp:2,fu:0,am:[],d:'',st:0};pw.draw()}})();
window.pEdit=id=>{const x=item(id);S.pqf={id,t:x.ti,l:x.loc,p:fmt(x.n),c:x.c,k:x.k||'house',b:x.beds,ba:x.baths||1,m:x.m2?String(x.m2):'',dp:x.dp||0,fu:x.furn?1:0,am:[...(x.am||[])],d:x.d};qDraw()};
function rd(){const F=S.pqf,g=i=>$('#'+i);if(g('pqt'))F.t=g('pqt').value;if(g('pql'))F.l=g('pql').value;if(g('pqd'))F.d=g('pqd').value;if(g('pqm'))F.m=g('pqm').value.replace(/\D/g,'');if(g('pqp')){F.p=fmtIn(g('pqp').value);g('pqp').value=F.p}return F}
function qDraw(){const F=S.pqf,rent=F.c==='Rent',nb=F.k==='land'||F.k==='shop',FL='style="font-size:17px;height:46px"',W='style="padding:8px 0 0;flex-wrap:wrap;overflow:visible"',
cr=(k,v)=>`<div class="chp" ${W}>${v.map(([y,l])=>cb(F[k]===y,`pqS('${k}',${typeof y==='string'?`'${y}'`:y})`,l)).join('')}</div>`;
sh(`<div ${H1}>${F.id?T('Edit listing','Hindura icyashyizweho','Modifier l’annonce'):T('List a property','Shyiraho inzu','Publier un bien')}</div><div class="lab" style="margin-top:6px">${T('Title','Umutwe','Titre')}</div><input class="in" id="pqt" value="${esc(F.t)}" maxlength="50" oninput="pqChk()" placeholder="${T('2-bedroom apartment','Inzu y’ibyumba 2','Appartement 2 chambres')}" ${FL}><div class="lab">${T('Neighbourhood','Umudugudu','Quartier')}</div><input class="in" id="pql" value="${esc(F.l)}" maxlength="40" placeholder="Kimironko" ${FL}><div class="lab">${T('Listing type','Ubwoko bw’icyashyizweho','Type d’annonce')}</div>${cr('c',[['Rent',CL().Rent],['Sale',CL().Sale]])}<div class="lab">${T('Property type','Ubwoko bw’inzu','Type de bien')}</div>${cr('k',Object.entries(KD()))}<div class="lab">${rent?T('Rent per month (RWF)','Ubukode ku kwezi (RWF)','Loyer mensuel (RWF)'):T('Price (RWF)','Igiciro (RWF)','Prix (RWF)')}</div><input class="in" id="pqp" value="${esc(F.p)}" inputmode="numeric" oninput="pqChk()" placeholder="${rent?'250,000':'45,000,000'}" ${FL}>${rent?`<div class="lab">${T('Deposit (months)','Ingwate (amezi)','Caution (mois)')}</div>${cr('dp',[0,1,2,3].map(n=>[n,n]))}`:''}${nb?'':`<div class="lab">${T('Bedrooms','Ibyumba','Chambres')}</div>${cr('b',[1,2,3,4].map(n=>[n,n===4?'4+':n]))}`}${F.k==='land'?'':`<div class="lab">${T('Bathrooms','Ubwiherero','Salles de bain')}</div>${cr('ba',[1,2,3].map(n=>[n,n]))}`}<div class="lab">${T('Size (m²)','Ingano (m²)','Surface (m²)')}</div><input class="in" id="pqm" value="${esc(F.m)}" inputmode="numeric" placeholder="70" ${FL}>${rent&&F.k!=='land'?`<div class="lab">${T('Furnished','Ibikoresho','Meublé')}</div>${cr('fu',[[1,T('Yes','Yego','Oui')],[0,T('No','Oya','Non')]])}`:''}<div class="lab">${T('Features','Ibirimo','Équipements')}</div><div class="chp" ${W}>${Object.entries(AM()).map(([k,v])=>cb(F.am.includes(k),`pqA('${k}')`,v)).join('')}</div><div class="lab">${T('Description','Ibisobanuro','Description')}</div><textarea class="in" id="pqd" maxlength="300" style="font-size:16px;height:84px;padding-top:10px" placeholder="${T('Floor, condition, what is nearby…','Etaje, uko imeze, ibiri hafi…','Étage, état, alentours…')}">${esc(F.d)}</textarea><div class="sm mu" id="pqh" style="margin-top:10px">${T('Add a title and a price to post.','Shyiraho umutwe n’igiciro kugira ngo ushyireho.','Ajoutez un titre et un prix pour publier.')}</div><button class="btn" id="pqgo" style="margin-top:12px" disabled onclick="pqGo()">${F.id?T('Save changes','Bika impinduka','Enregistrer'):T('Post','Shyiraho','Publier')}</button>`);pqChk()}
window.pqChk=()=>{const F=rd(),ok=F.t.trim()&&num(F.p)>0,b=$('#pqgo'),h=$('#pqh');if(b)b.disabled=!ok;if(h)h.style.display=ok?'none':''};
window.pqS=(k,v)=>{rd();S.pqf[k]=v;qDraw()};
window.pqA=k=>{const a=rd().am,n=a.indexOf(k);n<0?a.push(k):a.splice(n,1);qDraw()};
window.pqGo=()=>{const F=rd(),n=num(F.p);if(!F.t.trim()||!n)return;const rent=F.c==='Rent',nb=F.k==='land'||F.k==='shop',
o={ti:F.t.trim(),loc:F.l.trim()||'Kigali',n,u:rent?'mo':'',beds:nb?0:F.b,baths:F.k==='land'?0:F.ba,m2:Number(F.m)||0,furn:rent&&F.k!=='land'?F.fu:null,c:F.c,k:F.k,am:F.am,dp:rent?F.dp:0,d:F.d.trim()||T('Contact the owner to arrange a viewing.','Vugana na nyirayo mwemeranye gusura.','Contactez le propriétaire pour organiser une visite.')};
if(F.id){Object.assign(item(F.id),o);closeSheet();render('fade-none');toast(T('Listing updated','Icyashyizweho cyahinduwe','Annonce mise à jour'));return}
H.items.unshift(Object.assign({id:Date.now()%100000,g:F.k==='shop'?'bag':'house',who:'You',ago:0,ok:0},o));S.hdMine.property++;S.prCat='Mine';S.prB=0;S.prQ='';S.pf=NF();closeSheet();render('fade-none');toast(T('Posted','Byashyizweho','Publié'))};
/* ---- detail ---- */
const _hi=screens.hoodItem;
screens.hoodItem=()=>{if(S.hd!=='property')return _hi();const x=item(S.hdI);if(!x)return _hi();
const mine=x.who==='You',rent=x.c==='Rent',v=view(x.id),h=hash(x.loc+x.id),cm=S.pCmp.includes(x.id),bal=typeof S.bank==='number'?S.bank:0,tot=x.n*(1+(x.dp||0));
const box=(a,b)=>`<div style="flex:1;padding:12px 8px;border-radius:16px;background:var(--chip);text-align:center"><b style="font-size:18px">${a}</b><div class="sm mu">${b}</div></div>`;
const walk=m=>m+T(' min walk',' min n’amaguru',' min à pied');
const cost=rent?sec(T('Move-in cost','Ikiguzi cyo kwimuka','Coût d’emménagement'))+kv(T('First month','Ukwezi kwa mbere','Premier mois'),fmt(x.n)+' RWF')+kv(T('Deposit','Ingwate','Caution'),x.dp?fmt(x.n*x.dp)+' RWF':T('None','Nta ngwate','Aucune'))+kv(T('Total','Yose hamwe','Total'),fmt(tot)+' RWF')+`<div class="sm" style="color:${bal>=tot?'var(--ok)':'var(--mu)'}">${bal>=tot?'✓ '+T('Your itunda balance covers this.','Amafaranga ufite muri itunda arahagije.','Votre solde itunda couvre ce montant.'):T('Short by ','Hasigaye ','Il manque ')+fmt(tot-bal)+' RWF'}</div>`:sec(T('Buying costs','Ibiguzi byo kugura','Coûts d’achat'))+`<button class="btn sec2" style="height:48px" onclick="pCalc(${x.id})">${T('Mortgage estimate','Igereranya ry’inguzanyo','Estimation du crédit')}</button>`;
const det=sec(T('Details','Ibisobanuro','Détails'))+kv(T('Type','Ubwoko','Type'),KD()[x.k||'house'])+(rent&&x.furn!=null?kv(T('Furnished','Ibikoresho','Meublé'),x.furn?T('Yes','Yego','Oui'):T('No','Oya','Non')):'')+(x.m2?kv(T('Per m²','Kuri m²','Par m²'),fmt(Math.round(x.n/x.m2))+' RWF'):'')+kv(T('Posted','Byashyizweho','Publié'),agoL(x));
const am=(x.am||[]).length?`<div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:14px">${x.am.map(a=>`<span style="padding:6px 12px;border-radius:14px;background:var(--chip);font-size:13px;font-weight:700">${AM()[a]}</span>`).join('')}</div>`:'';
const nb=sec(T('Around ','Hafi ya ','Autour de ')+esc(x.loc))+kv('🚌 '+T('Bus stop','Sitasiyo ya bisi','Arrêt de bus'),walk(2+h%8))+kv('🛒 '+T('Market','Isoko','Marché'),walk(4+h%12))+kv('🏫 '+T('School','Ishuri','École'),walk(5+h%10))+`<div class="sm mu">${T('Sample distances.','Intera z’urugero.','Distances d’exemple.')}</div>`;
const own=mine?sec(T('Your listing','Icyo washyize','Votre annonce'))+kv(T('Views','Abayirebye','Vues'),20+h%80)+kv(T('Saved by','Abayibitse','Enregistré par'),h%9)+sec(T('Enquiries','Ibibazo','Demandes')+' · '+enq(x.id).length)+enq(x.id).map((e,i)=>`<div style="padding:12px 0;border-bottom:0"><div style="display:flex;justify-content:space-between;gap:8px"><b>${e.n}</b><span class="sm" style="font-weight:700;color:${e.s===1?'var(--ok)':e.s===2?'var(--er)':'var(--mu)'}">${[T('New','Gishya','Nouveau'),e.k===0?T('Viewing confirmed','Gusura byemejwe','Visite confirmée'):T('Replied','Yasubijwe','Répondu'),T('Declined','Yanzwe','Refusé')][e.s]}</span></div><div class="sm mu" style="margin-top:2px">${EQ()[e.k]}</div>${e.s?'':`<div class="chips" style="padding:8px 0 0"><button class="cch on" onclick="pEs(${x.id},${i},1)">${e.k===0?T('Confirm','Emeza','Confirmer'):T('Reply','Subiza','Répondre')}</button>${e.k===0?`<button class="cch" onclick="pEs(${x.id},${i},2)">${T('Decline','Anga','Refuser')}</button>`:''}</div>`}</div>`).join(''):'';
const agent=mine?'':`<div class="tap" role="button" tabindex="0" aria-label="${T('Agent','Umuhuza','Agent')}" onclick="pAgent(${x.id})" style="cursor:pointer;display:flex;align-items:center;gap:12px;margin-top:20px;padding-top:16px;border-top:0">${gl('community',40)}<div style="flex:1"><div style="font-weight:800">${esc(x.who)}</div><div class="sm mu">${T('Agent · itunda user','Umuhuza · umukoresha wa itunda','Agent · utilisateur itunda')}</div></div><span class="mu" aria-hidden="true">›</span></div>`;
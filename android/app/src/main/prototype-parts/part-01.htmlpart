'Safe Savings':['Épargne sûre','Kuzigama neza'],'Small daily saves that add up':['De petites économies quotidiennes qui s’accumulent','Utuzigamiro duto twa buri munsi dukura'],
'Delivery':['Livraison','Kugezwaho'],'Pickup':['Retrait','Kwifatira'],'Menu':['Menu','Ibiryo'],'Info':['Infos','Amakuru'],'Reviews':['Avis','Ibitekerezo'],'Popular':['Populaire','Bikunzwe'],

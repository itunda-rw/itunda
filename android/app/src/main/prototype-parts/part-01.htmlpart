{const H={"rw": {"MTN MoMo and Airtel Money are working normally": "MTN MoMo na Airtel Money bikora neza", "Quick actions": "Ibikorwa byihuse", "Scan to pay": "Sikana wishyure", "Pay bills": "Kwishyura fagitire", "Airtime": "Airtime", "Rwanda services": "Serivisi z'u Rwanda", "RRA taxes": "Imisoro ya RRA", "REG electricity": "Amashanyarazi REG", "WASAC water": "Amazi WASAC", "School fees": "Amafaranga y'ishuri", "Spent this period, mostly on food": "Yakoreshejwe muri iki gihe, cyane cyane ku biryo", "Upcoming, due Friday": "Iri imbere, igomba kwishyurwa kuwa gatanu", "18,500 RWF": "RWF 18,500", "Start your first savings goal": "Tangira intego yawe ya mbere yo kubika", "A target and a date make saving easier": "Intego n'itariki bituma kubika koroha", "My credit score": "Amanota yanjye y'inguzanyo", "Free check, alternative data": "Kureba ku buntu, amakuru asimbura", "View": "Reba", "Send again": "Ongera wohereze"}, "fr": {"MTN MoMo and Airtel Money are working normally": "MTN MoMo et Airtel Money fonctionnent normalement", "Quick actions": "Actions rapides", "Scan to pay": "Scanner pour payer", "Pay bills": "Payer les factures", "Airtime": "Crédit téléphonique", "Rwanda services": "Services du Rwanda", "RRA taxes": "Impôts RRA", "REG electricity": "Électricité REG", "WASAC water": "Eau WASAC", "School fees": "Frais de scolarité", "Spent this period, mostly on food": "Dépensé sur la période, surtout en nourriture", "Upcoming, due Friday": "À venir, échéance vendredi", "18,500 RWF": "18,500 RWF", "Start your first savings goal": "Lancez votre premier objectif d'épargne", "A target and a date make saving easier": "Un objectif et une date facilitent l'épargne", "My credit score": "Mon score de crédit", "Free check, alternative data": "Vérification gratuite, données alternatives", "View": "Voir", "Send again": "Envoyer à nouveau"}};const f=screens.home;screens.home=function(){const h=f.apply(this,arguments),m=H[S.lang];return m?h.replace(/>([^<>]+)</g,(a,x)=>{const w=x.trim();return m[w]?'>'+x.replace(w,m[w])+'<':a}):h}}


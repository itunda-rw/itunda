S.goal=null;S.gd={n:'Phone',t:100000,m:6};
const gch=(a,k,f)=>a.map(v=>`<button class="${S.gd[k]===v?'on':''}" onclick="S.gd.${k}=${typeof v==='number'?v:`'${v}'`};render('fade-none')">${f(v)}</button>`).join('');
const perWk=(t,m)=>Math.max(100,Math.round(t/(m*4.345)/100)*100);
screens.goal=()=>{const g=S.goal;if(g){const p=Math.min(100,Math.round(g.s/g.t*100)),done=g.s>=g.t;return `${bar('Savings goal')}<div class="pad" style="padding-top:28px"><div class="h1">${done?'Goal reached: '+g.n:g.n}</div><div class="mu" style="font-size:15px;margin-top:8px">Save about ${fmt(perWk(g.t,g.m))} RWF a week to finish in ${g.m} months.</div></div><div class="pad" style="padding-top:24px"><div class="sm mu">Saved so far</div><div class="big">${fmt(g.s)} RWF</div><div style="height:8px;border-radius:4px;background:var(--chip);margin-top:12px"><div style="height:8px;border-radius:4px;background:var(--br);width:${p}%;transition:width .4s"></div></div><div class="sm mu" style="margin-top:8px">${p}% of ${fmt(g.t)} RWF</div><button class="chip" style="margin-top:20px" onclick="goalDel()">Delete goal</button><div class="fine" style="padding-top:18px">Sample goal for this prototype.</div></div><div class="cta"><button class="btn" ${done?'disabled':''} onclick="goalAdd()">${done?'Completed':'Add 1,000 RWF'}</button></div>`}
const d=S.gd;return `${bar('New savings goal')}<div class="pad" style="padding-top:28px"><div class="h1">What are you saving for?</div></div><div class="pad"><div class="lab">Goal</div><div class="req gchips" style="margin-top:10px">${gch(['Phone','Trip','Emergency fund','School fees'],'n',v=>v)}</div><div class="lab">Target</div><div class="req" style="margin-top:10px">${gch([50000,100000,250000,500000],'t',v=>fmt(v)+' RWF')}</div><div class="lab">Time</div><div class="req" style="margin-top:10px">${gch([3,6,12],'m',v=>v+' months')}</div><div style="background:var(--tint);border-radius:20px;padding:16px 18px;margin-top:28px"><div class="sm" style="font-weight:800;color:var(--tintfg)">Your plan</div><div style="font-size:18px;font-weight:800;margin-top:4px">${fmt(perWk(d.t,d.m))} RWF a week</div></div></div><div class="cta"><button class="btn" onclick="goalMake()">Create goal</button></div>`};
function openGoal(){S.stack.push('goal');render('push')}
function goalMake(){S.goal={n:S.gd.n,t:S.gd.t,m:S.gd.m,s:0};render('fade-none');toast('Goal created')}
function goalAdd(){const g=S.goal;if(S.bank<1000){toast(t('insuff').replace('%s',fmt(S.bank)));return}S.bank-=1000;g.s=Math.min(g.t,g.s+1000);render('fade-none');toast(t('y_sv').replace('%s','1,000'));if(g.s>=g.t)setTimeout(confetti,200)}
function goalDel(){S.goal=null;render('fade-none');toast('Goal deleted')}
const XT={rw:{m:{'Phone':`Telefoni`,'Trip':`Urugendo`,'Emergency fund':`Amafaranga y'impanuka`,'School fees':`Amafaranga y'ishuri`,'Goal':`Intego`,'Target':`Umubare ushaka`,'Time':`Igihe`,'What are you saving for?':`Ubikira iki?`,'New savings goal':`Intego nshya yo kubika`,'Savings goal':`Intego yo kubika`,'Your plan':`Gahunda yawe`,'Create goal':`Shyiraho intego`,'Add 1,000 RWF':`Ongeraho RWF 1,000`,'Completed':`Byarangiye`,'Delete goal':`Siba intego`,'Saved so far':`Ibyo wabitse kugeza ubu`,'Sample goal for this prototype.':`Intego y'ikitegererezo kuri iyi porogaramu.`,'Food':`Ibiribwa`,'Shopping':`Guhaha`,'Transport':`Ubwikorezi`,'Bills':`Fagitire`,'Other':`Ibindi`},p:[[/^(\d+) months$/,(n)=>`amezi ${n}`],[/^([\d,]+) RWF a week$/,(x)=>`RWF ${x} ku cyumweru`],[/^Save about ([\d,]+) RWF a week to finish in (\d+) months\.$/,(x,mo)=>`Bika nka RWF ${x} ku cyumweru kugira ngo urangize mu mezi ${mo}.`],[/^(\d+)% of ([\d,]+) RWF$/,(p,t)=>`${p}% bya RWF ${t}`],[/^Goal reached: (.+)$/,(n,tx)=>`Intego igezweho: ${tx(n)}`]]},fr:{m:{'Phone':`Téléphone`,'Trip':`Voyage`,'Emergency fund':`Fonds d'urgence`,'School fees':`Frais de scolarité`,'Goal':`Objectif`,'Target':`Montant visé`,'Time':`Durée`,'What are you saving for?':`Pour quoi épargnez-vous ?`,'New savings goal':`Nouvel objectif d'épargne`,'Savings goal':`Objectif d'épargne`,'Your plan':`Votre plan`,'Create goal':`Créer l'objectif`,'Add 1,000 RWF':`Ajouter 1,000 RWF`,'Completed':`Terminé`,'Delete goal':`Supprimer l'objectif`,'Saved so far':`Épargné jusqu'ici`,'Sample goal for this prototype.':`Objectif d'exemple pour ce prototype.`,'Food':`Alimentation`,'Shopping':`Achats`,'Transport':`Transport`,'Bills':`Factures`,'Other':`Autres`},p:[[/^(\d+) months$/,(n)=>`${n} mois`],[/^([\d,]+) RWF a week$/,(x)=>`${x} RWF par semaine`],[/^Save about ([\d,]+) RWF a week to finish in (\d+) months\.$/,(x,mo)=>`Épargnez environ ${x} RWF par semaine pour finir en ${mo} mois.`],[/^(\d+)% of ([\d,]+) RWF$/,(p,t)=>`${p}% de ${t} RWF`],[/^Goal reached: (.+)$/,(n,tx)=>`Objectif atteint : ${tx(n)}`]]}};
function xl(h){const X=XT[S.lang];if(!X)return h;const tx=x=>{if(X.m[x])return X.m[x];for(const [r,f] of X.p){const m=x.match(r);if(m)return f(...m.slice(1),tx)}return x};return h.replace(/>([^<>]+)</g,(a,x)=>'>'+tx(x)+'<')}
['goal','spend'].forEach(k=>{const f=screens[k];screens[k]=()=>xl(f())});
function qa(n){S.amt=String((Number(S.amt)||0)+n);key('')}
const SPD=[[['Food',128000,'restaurant'],['Shopping',61000,'bag'],['Transport',54000,'transit'],['Bills',43000,'bill'],['Other',26000,'wallet']],[['Food',141000,'restaurant'],['Shopping',48000,'bag'],['Transport',52000,'transit'],['Bills',43000,'bill'],['Other',19000,'wallet']]];
screens.spend=()=>{const d=SPD[S.sp],tot=d.reduce((a,x)=>a+x[1],0),prev=SPD[1-S.sp].reduce((a,x)=>a+x[1],0),diff=tot-prev,mx=d[0][1];return `${bar(t('y_sp'))}<div class="seg">${[t('y_tm'),t('y_lm')].map((l,i)=>`<button class="${S.sp===i?'on':''}" onclick="S.sp=${i};render('fade-none')">${l}</button>`).join('')}</div><div class="pad" style="padding-top:24px"><div class="sm mu">${t('y_ts')}</div><div class="big">${fmt(tot)} RWF</div>${S.sp===0?`<div class="sm" style="margin-top:6px;font-weight:700;color:${diff>0?'var(--er)':'var(--ok)'}">${t(diff>0?'y_up':'y_dn').replace('%s',fmt(Math.abs(diff)))}</div>`:''}</div><div class="sec">${d.map(([n,v,g])=>`<div class="row" style="cursor:default;align-items:flex-start"><div class="ico">${gl(g,30)}</div><div style="flex:1"><div style="display:flex;justify-content:space-between"><div class="t">${n}</div><b>${fmt(v)} RWF</b></div><div style="height:8px;border-radius:4px;background:var(--chip);margin-top:8px"><div style="height:8px;border-radius:4px;background:var(--br);width:${Math.round(v/mx*100)}%"></div></div><div class="s">${Math.round(v/tot*100)}% ${t('y_ps')}</div></div></div>`).join('')}</div><div class="pad fine" style="padding-top:20px">${t('y_sd')}</div>`};
function openSpend(){S.stack=['spend'];render('push')}
function reqSheet(){S.rqAmt=S.rqAmt||5000;drawReq()}
function reqCode(){return 'ITD-'+String(S.rqAmt/100+4210).padStart(4,'0')+'-90'}
function drawReq(){$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="g3" style="margin-bottom:10px">${gl('receipt',64)}</div><div class="h1" style="font-size:22px;line-height:30px">${t('rq')}</div><div class="mu" style="font-size:14px;margin-top:6px">${t('y_rd')}</div><div class="req" style="margin:16px 0 18px">${[2000,5000,10000,25000].map(a=>`<button class="${S.rqAmt===a?'on':''}" onclick="S.rqAmt=${a};drawReq()">${fmt(a)} RWF</button>`).join('')}</div><div style="background:var(--chip);border-radius:18px;padding:16px 18px;margin-bottom:18px"><div class="sm mu">${t('y_rc')}</div><div style="font-size:24px;font-weight:800;letter-spacing:1px;margin-top:4px">${reqCode()}</div><div class="sm mu" style="margin-top:4px">${fmt(S.rqAmt)} RWF · ${t('y_rv')}</div></div><button class="btn" onclick="reqCopy()">${t('y_rb')}</button></div>`}
function reqCopy(){const m='Please pay me '+fmt(S.rqAmt)+' RWF on itunda. Code: '+reqCode();try{navigator.clipboard.writeText(m)}catch(e){}closeSheet();toast(t('y_rcp'))}

/* v32: Hood (Marketplace, Jobs, Property, Community), Invest, support */
const HD={
market:{t:'Marketplace',g:'market',cats:['All','Electronics','Home','Fashion'],cta:'Chat with seller',post:'Sell something',items:[
 {id:1,ti:'Samsung phone, barely used',sub:'Kimironko · 2 h ago',p:140000,g:'airtime',c:'Electronics',who:'Eric M.',d:'128 GB, comes with charger and case. Pick up in Kimironko.'},
 {id:2,ti:'Wooden dining table, 6 seats',sub:'Remera · Yesterday',p:90000,g:'house',c:'Home',who:'Claire U.',d:'Solid wood, a few small marks. Buyer collects.'},
 {id:3,ti:'Kitenge dress, size M',sub:'Nyamirambo · 3 d ago',p:12000,g:'bag',c:'Fashion',who:'Aline N.',d:'Worn twice. Bright pattern, very comfortable.'},
 {id:4,ti:'Bicycle, 26 inch',sub:'Kacyiru · 4 d ago',p:65000,g:'bike',c:'Home',who:'Patrick H.',d:'Serviced last month. New tyres.'},
 {id:5,ti:'Laptop, 14 inch',sub:'Gisozi · 5 d ago',p:310000,g:'chart',c:'Electronics',who:'Jean B.',d:'8 GB RAM, 256 GB SSD, battery lasts 6 hours.'}]},
jobs:{t:'Jobs',g:'briefcase',cats:['All','Part-time','Gig'],cta:'Apply',post:'Post a job',items:[
 {id:1,ti:'Shop assistant',sub:'Kigali Bakery · Kimironko',p:'RWF 4,000 a day',g:'bag',c:'Part-time',who:'Kigali Bakery',d:'Serve customers and keep the counter tidy. Mornings, 5 days a week.'},
 {id:2,ti:'Delivery rider, own moto',sub:'Nyamirambo Grill · Nyamirambo',p:'RWF 700 per delivery',g:'moto',c:'Gig',who:'Nyamirambo Grill',d:'Flexible hours. You need a moto and a valid licence.'},
 {id:3,ti:'Weekend tutor, maths',sub:'Remera · Saturdays',p:'RWF 6,000 a session',g:'school',c:'Part-time',who:'Claire U.',d:'Help a secondary student prepare for exams. Two hours each Saturday.'},
 {id:4,ti:'Event helper',sub:'Kigali Convention area',p:'RWF 8,000 a day',g:'celebrate',c:'Gig',who:'Eventa Rwanda',d:'Set up chairs and welcome guests. One day only.'}]},
property:{t:'Property',g:'house',cats:['All','Rent','Sale'],cta:'Contact agent',post:'List a property',items:[
 {id:1,ti:'2-bedroom apartment',sub:'Kimironko · 2 beds · 1 bath',p:'RWF 250,000 a month',g:'house',c:'Rent',who:'Agent Diane',d:'Second floor, water and electricity on prepaid meters, close to the bus stop.'},
 {id:2,ti:'Single room with shared yard',sub:'Nyamirambo · Furnished',p:'RWF 60,000 a month',g:'house',c:'Rent',who:'Agent Samuel',d:'Quiet street, shared compound, near the market.'},
 {id:3,ti:'3-bedroom house with garden',sub:'Kacyiru · 3 beds · 2 baths',p:'RWF 95,000,000',g:'house',c:'Sale',who:'Agent Diane',d:'Titled plot, secure gate, walking distance to schools.'}]}};
S.hdFav={};S.hdMine={market:0,jobs:0,property:0};S.hdCat={market:'All',jobs:'All',property:'All'};S.hdApplied={};S.hd='market';S.hdI=null;
S.posts=[{id:1,who:'Claire U.',t:'1 h',x:'Does anyone know a good plumber in Remera? Our tap has been leaking all week.',l:6,c:3,me:false},{id:2,who:'Eric M.',t:'Yesterday',x:'The new bus route from Kimironko to town is much faster in the mornings.',l:14,c:5,me:false},{id:3,who:'Aline N.',t:'2 d ago',x:'Umuganda this Saturday at 8. Bring your own gloves if you have them.',l:22,c:8,me:false}];
const hdFav=t=>Object.keys(S.hdFav).filter(k=>S.hdFav[k]&&k.startsWith(t+':')).length;
const hdMine=t=>S.hdMine[t];
const hdPrice=x=>typeof x.p==='number'?fmt(x.p)+' RWF':x.p;
const hdHeart=(t,id)=>`<button class="hrt" aria-label="Save" aria-pressed="${!!S.hdFav[t+':'+id]}" id="hf_${t}_${id}" onclick="event.stopPropagation();hdTg('${t}',${id})" style="position:static;width:36px;height:36px;flex-shrink:0">${heart(S.hdFav[t+':'+id])}</button>`;
const hdRows=t=>{const c=S.hdCat[t];const l=HD[t].items.filter(x=>c==='All'||x.c===c);return l.length?l.map(x=>`<div class="hdc" onclick="hdOpen('${t}',${x.id})"><div class="th">${gl(x.g,44)}</div><div style="flex:1;min-width:0"><div class="t">${x.ti}</div><div class="s">${x.sub}</div><div class="pr">${hdPrice(x)}</div></div>${hdHeart(t,x.id)}</div>`).join(''):`<div class="pad mu" style="padding-top:30px;text-align:center">Nothing here yet. Be the first to post.</div>`};
const hdChips=t=>HD[t].cats.map(c=>`<button class="cch ${S.hdCat[t]===c?'on':''}" onclick="hdCat('${t}','${c}')">${c}</button>`).join('');
screens.hood=()=>{const t=S.hd,H=HD[t];return `${bar(H.t)}<div class="chips" style="padding-top:12px" id="hdch">${hdChips(t)}</div><div style="padding-top:8px" id="hdl">${hdRows(t)}</div><div class="pad fine" style="padding-top:18px">Listings are sample data for this prototype.</div><div class="fab"><button class="btn" onclick="hdPost()">${H.post}</button></div>`};
screens.hoodItem=()=>{const t=S.hd,H=HD[t],x=H.items.find(i=>i.id===S.hdI);const ap=t==='jobs'&&S.hdApplied[x.id];return `${bar(H.t)}<div style="padding:12px 24px 0"><div class="pim" style="aspect-ratio:auto;height:230px;border-radius:28px;position:relative">${gl(x.g,112)}</div></div><div class="pad" style="padding-top:20px"><div style="display:flex;justify-content:space-between;align-items:flex-start;gap:8px"><div style="font-size:22px;font-weight:800;letter-spacing:-.4px;line-height:29px">${x.ti}</div>${hdHeart(t,x.id)}</div><div class="sm mu" style="margin-top:6px">${x.sub}</div><div style="font-size:24px;font-weight:800;margin-top:14px">${hdPrice(x)}</div><div style="font-size:15px;line-height:23px;margin-top:14px">${x.d}</div><div style="display:flex;align-items:center;gap:12px;margin-top:20px;padding-top:16px;border-top:0">${gl('community',40)}<div><div style="font-weight:800">${x.who}</div><div class="sm mu">${t==='jobs'?'Employer':t==='property'?'Agent':'Seller'} · itunda user</div></div></div></div><div class="cta" style="display:flex;gap:10px"><button class="btn sec2" style="flex:0 0 auto;width:auto;padding:0 20px" onclick="hdChat('${t}',${x.id})">Message</button><button class="btn" ${ap?'disabled':''} onclick="${t==='jobs'?`hdApply(${x.id})`:`hdChat('${t}',${x.id})`}">${ap?'Applied':H.cta}</button></div>`};
screens.community=()=>`${bar('Community')}<div class="pad" style="padding-top:6px"><button class="btn sec2" style="height:48px;text-align:left;padding:0 18px;font-weight:600;color:var(--mu)" onclick="postSheet()">Ask your neighbours something…</button></div><div style="padding-top:8px">${S.posts.map(p=>`<div class="post"><div class="who"><div class="ico" style="width:36px;height:36px;border-radius:18px">${gl('community',24)}</div><div>${p.who}<div class="sm mu" style="font-weight:500">${p.t}</div></div></div><p>${p.x.replace(/</g,'&lt;')}</p><div class="act"><button aria-label="Like" onclick="postLike(${p.id})">${heart(p.me)}<span id="pl${p.id}">${p.l}</span></button><button onclick="toast('Replies are not in this prototype')">${ic('chat',18)}${p.c}</button></div></div>`).join('')}</div><div class="pad fine" style="padding-top:18px">Posts are sample data.</div>`;
function openHood(t){S.hd=t;S.stack=['hood'];render('push')}
function hdOpen(t,id){S.hd=t;S.hdI=id;S.stack=['hood','hoodItem'];render('push')}
function hdCat(t,c){S.hdCat[t]=c;$('#hdch').innerHTML=hdChips(t);$('#hdl').innerHTML=hdRows(t)}
function hdTg(t,id){const k=t+':'+id;S.hdFav[k]=!S.hdFav[k];document.querySelectorAll('#hf_'+t+'_'+id).forEach(e=>{e.innerHTML=heart(S.hdFav[k]);e.setAttribute('aria-pressed',String(!!S.hdFav[k]))});toast(S.hdFav[k]?'Saved to your wishlist':'Removed from your wishlist')}
function hdApply(id){S.hdApplied[id]=true;const x=HD.jobs.items.find(i=>i.id===id);const th='hdjobs'+id;hdThread(th,x.who,x.ti,[['me','Hello, I would like to apply for "'+x.ti+'".']]);render('fade-none');toast('Application sent to '+x.who)}
function hdThread(id,n,sub,m){if(!THREADS.find(t=>t.id===id)){THREADS.unshift({id,n,g:'community',t:'Now',u:0,sub,m:[]});S.msgs[id]=m.map(x=>x.slice())}}
function hdChat(t,id){const x=HD[t].items.find(i=>i.id===id);const th='hd'+t+id;hdThread(th,x.who,x.ti,[['me',t==='property'?'Hello, is "'+x.ti+'" still available?':'Hi, is "'+x.ti+'" still available?']]);S.tab='messages';openChat(th)}
function hdPost(){const t=S.hd,H=HD[t];$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="h1" style="font-size:22px;line-height:30px;margin-bottom:8px">${H.post}</div><div class="lab" style="margin-top:6px">Title</div><input class="in" id="hdt" placeholder="${t==='market'?'What are you selling?':t==='jobs'?'Job title':'Property title'}" style="font-size:17px;height:46px"><div class="lab">${t==='market'?'Price (RWF)':'Pay or price'}</div><input class="in" id="hdp" inputmode="numeric" placeholder="${t==='market'?'25,000':'RWF 5,000 a day'}" style="font-size:17px;height:46px"><button class="btn" style="margin-top:20px" onclick="hdPostGo()">Post</button></div>`}
function hdPostGo(){const t=S.hd,ti=($('#hdt').value||'').trim(),pv=($('#hdp').value||'').trim();if(!ti||!pv){toast('Add a title and a price');return}const H=HD[t];const num=Number(pv.replace(/[^0-9]/g,''));H.items.unshift({id:Date.now()%100000,ti,sub:'Your listing · Just now',p:t==='market'&&num?num:pv,g:H.g,c:H.cats[1],who:'You',d:'Posted from this prototype.'});S.hdMine[t]++;closeSheet();render('fade-none');toast('Posted')}
function postLike(id){const p=S.posts.find(x=>x.id===id);p.me=!p.me;p.l+=p.me?1:-1;render('fade-none')}
function openCommunity(){S.stack=['community'];render('push')}
function postSheet(){$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="h1" style="font-size:22px;line-height:30px;margin-bottom:10px">New post</div><textarea id="pt" placeholder="Ask your neighbours something…" aria-label="Your post" style="width:100%;height:110px;border:0;border-radius:16px;background:var(--chip);padding:14px;font:inherit;font-size:15px;color:var(--tx);outline:0;resize:none"></textarea><button class="btn" style="margin-top:16px" onclick="postGo()">Post</button></div>`}
function postGo(){const x=(($('#pt')||{}).value||'').trim();if(!x){toast('Write something first');return}S.posts.unshift({id:Date.now()%100000,who:S.name||'You',t:'Just now',x,l:0,c:0,me:false});closeSheet();render('fade-none');toast('Posted')}
/* Invest */
const STK=[['BK','Bank of Kigali',420,1.2],['MTNR','MTN Rwanda',215,-0.8],['BRL','Bralirwa',180,0.4],['IMR','I&M Bank Rwanda',92,2.1]];
S.hold={};
const stkVal=()=>Object.entries(S.hold).reduce((a,[k,h])=>a+h.q*STK.find(s=>s[0]===k)[2],0);
screens.invest=()=>{const v=stkVal(),cost=Object.entries(S.hold).reduce((a,[k,h])=>a+h.q*h.avg,0),g=v-cost;return `${bar('Invest')}<div class="pad" style="padding-top:16px"><div class="sm mu">Portfolio value</div><div class="big" style="margin-top:4px">${fmt(v)} RWF</div><div class="sm ${g>=0?'up':'dn'}" style="font-weight:800;margin-top:4px">${g>=0?'+':'−'}${fmt(Math.abs(g))} RWF since you bought</div></div><div class="agt" style="padding-top:28px">Rwanda Stock Exchange</div>${STK.map(([k,n,p,c])=>`<div class="stk" onclick="stkSheet('${k}')"><div class="tk">${k}</div><div style="flex:1;min-width:0"><div style="font-weight:700;font-size:16px">${n}</div><div class="sm mu">${S.hold[k]?S.hold[k].q+' held':'Not held'}</div></div><div style="text-align:right"><div style="font-weight:800">${fmt(p)} RWF</div><div class="sm ${c>=0?'up':'dn'}" style="font-weight:700">${c>=0?'+':''}${c}%</div></div></div>`).join('')}<div class="pad fine" style="padding-top:22px">Prices and holdings are sample data for this prototype, not live RSE quotes. Money for buying comes from your itunda Bank balance.</div>`};
S.sq=1;
function openInvest(){S.stack=['invest'];render('push')}
function stkSheet(k){S.sk=k;S.sq=1;drawStk()}
function drawStk(){const s=STK.find(x=>x[0]===S.sk),h=S.hold[S.sk],cost=s[2]*S.sq,bad=cost>S.bank;$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="h1" style="font-size:22px;line-height:30px">${s[1]}</div><div class="mu" style="font-size:15px;margin-top:4px">${fmt(s[2])} RWF per share</div><div class="req" style="margin:16px 0">${[1,5,10,50].map(q=>`<button class="${S.sq===q?'on':''}" onclick="S.sq=${q};drawStk()">${q} share${q>1?'s':''}</button>`).join('')}</div><button class="btn" ${bad?'disabled':''} onclick="stkBuy()">Buy ${S.sq} for ${fmt(cost)} RWF</button>${bad?`<div style="color:var(--er);font-size:14px;margin-top:10px">Not enough balance — you have RWF ${fmt(S.bank)}</div>`:''}${h?`<button class="btn sec2" style="margin-top:10px" onclick="stkSell()">Sell all ${h.q} (${fmt(h.q*s[2])} RWF)</button>`:''}</div>`}
function stkBuy(){const s=STK.find(x=>x[0]===S.sk),cost=s[2]*S.sq;if(cost>S.bank)return;S.bank-=cost;const h=S.hold[S.sk]||{q:0,avg:s[2]};h.avg=Math.round((h.avg*h.q+cost)/(h.q+S.sq));h.q+=S.sq;S.hold[S.sk]=h;closeSheet();render('fade-none');toast('Bought '+S.sq+' '+S.sk)}
function stkSell(){const s=STK.find(x=>x[0]===S.sk),h=S.hold[S.sk];S.bank+=h.q*s[2];delete S.hold[S.sk];closeSheet();render('fade-none');toast('Sold '+S.sk)}
/* Support */
function supportChat(){S.tab='messages';openChat('support')}
function reportSheet(){const tx=[...S.orders.slice(0,2).map(o=>[o.k,fmt(o.t)+' RWF']),['Sent to Amina K.','25,000 RWF'],['Kigali Bakery','4,800 RWF']];S.rp=0;S.rpl=tx;drawRep()}
function drawRep(){$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="g3" style="margin-bottom:8px">${gl('warning3d',56)}</div><div class="h1" style="font-size:22px;line-height:30px;margin-bottom:6px">Report an issue with a transaction</div>${S.rpl.map(([a,b],i)=>`<div class="row tap" onclick="S.rp=${i};drawRep()"><div class="cb ${S.rp===i?'on':''}">${S.rp===i?'<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#17171C" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L19 7"/></svg>':''}</div><div style="flex:1"><div class="t" style="font-size:15px">${a}</div></div><b>${b}</b></div>`).join('')}<button class="btn" style="margin-top:16px" onclick="reportGo()">Send report</button></div>`}
function reportGo(){const x=S.rpl[S.rp];S.msgs.support.push(['me','I would like to report an issue with: '+x[0]+' ('+x[1]+').'],['them','Thanks, we have your report. Reference IT-'+(30000+Math.floor(Math.random()*9999))+'. We will reply here.']);closeSheet();toast('Report sent. See Messages.')}

const o=document.createElement('div');o.className='screen splash';o.innerHTML=knot(120);$('#view').appendChild(o);

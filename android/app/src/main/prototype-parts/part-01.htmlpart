<mask id="gaps" maskUnits="userSpaceOnUse" x="-45" y="-50" width="90" height="90"><rect x="-45" y="-50" width="90" height="90" fill="#fff"/><g fill="none" stroke="#000" stroke-width="17" stroke-linecap="round" stroke-linejoin="round"><use href="#k1"/><use href="#k2"/><use href="#k3"/></g></mask>

Object.assign(TR9.fr,{'Maps':`Cartes`,'Places & trips':`Lieux et trajets`,'Places':`Lieux`,'Directions':`Itinéraires`,'Everyday':`Au quotidien`,'Your neighbourhood':`Votre quartier`,'Money tools':`Outils financiers`,'Accounts & cards':`Comptes et cartes`,'Send & pay':`Envoyer et payer`,'Save & grow':`Épargner et faire fructifier`,'Borrow':`Emprunter`,'Transport':`Transport`,'Support':`Assistance`,'Shop':`Boutique`,'Eats':`Repas`,'Map':`Carte`,'Marketplace':`Marché`,'Community':`Communauté`,'Jobs':`Emplois`,'Property':`Immobilier`,'Benefits':`Avantages`,'Invest':`Investir`,'Transfer':`Virement`,'Request money':`Demander de l'argent`,'Rides':`Courses`,'Bike rental':`Location de vélo`,'Bus':`Bus`,'Live chat':`Chat en direct`,'Call support':`Appeler l'assistance`,'Announcements':`Annonces`,'Open account':`Ouvrir un compte`,'Card':`Carte`,'Get a loan':`Obtenir un prêt`,'Credit score':`Score de crédit`,'Youth account':`Compte jeunes`,'My payment code':`Mon code de paiement`,'Show this code at the till to pay.':`Montrez ce code en caisse pour payer.`,'More':`Plus`,'Settings':`Paramètres`,'Language':`Langue`,'Help and support':`Aide et assistance`,'My orders':`Mes commandes`,'My favorites':`Mes favoris`,'My listings':`Mes annonces`,'Partner earnings':`Gains partenaires`,'Verification':`Vérification`,'Identity verified':`Identité vérifiée`});
function tr9(){const g=TR9[S.lang],t=TT9[S.lang];if(!g)return;const w=document.createTreeWalker($('#phone'),NodeFilter.SHOW_TEXT);let n;while(n=w.nextNode()){const s=n.nodeValue.trim(),p=n.parentElement;const r=(t&&p&&p.closest('.tabs,.ahead,.top')&&t[s])||g[s];if(r)n.nodeValue=n.nodeValue.replace(s,r)}}
const w9=v=>{if(v<1000)return '';const m=v>=1e6,n=+(m?v/1e6:v/1e3).toFixed(2),L=S.lang;return L==='rw'?(m?'miliyoni ':'ibihumbi ')+n:L==='fr'?n+(m?' million'+(n>=2?'s':''):' mille'):n+(m?' million':' thousand')};
function upd9(){const a=$('#amt');if(!a)return;let w=$('#w9');if(!w){a.parentElement.insertAdjacentHTML('afterend','<div id="w9" class="sm" style="text-align:center;color:var(--lk);font-weight:700;min-height:18px;margin-top:6px"></div>');w=$('#w9')}w.textContent=w9(Number(S.amt||0))}
const S9={en:{to:'Sent to',bal:'Balance now',ref:'Reference',fee:'Fee',sh:'Share receipt',dn:'Done',cp:'Receipt copied',tm:'Time'},rw:{to:'Wohereje kuri',bal:'Asigaye ubu',ref:'Nomero y\'igikorwa',fee:'Amafaranga y\'serivisi',sh:'Sangiza inyemezabwishyu',dn:'Barangije',cp:'Inyemezabwishyu yakoporowe',tm:'Igihe'},fr:{to:'Envoyé à',bal:'Solde actuel',ref:'Référence',fee:'Frais',sh:'Partager le reçu',dn:'Terminé',cp:'Reçu copié',tm:'Heure'}};
const s9=k=>(S9[S.lang]||S9.en)[k];
Object.assign(S9.en,{rc:'To',am:'Amount',wn:'Other itunda users have reported this number',cf:'Confirm',sa:'Send anyway',cn:'Go back'});
Object.assign(S9.rw,{rc:'Kuri',am:'Amafaranga',wn:'Iyi numero yatanzweho raporo n\'abandi bakoresha itunda',cf:'Emeza',sa:'Ohereza nubwo bimeze bityo',cn:'Reka'});
Object.assign(S9.fr,{rc:'À',am:'Montant',wn:'Ce numéro a été signalé par d\'autres utilisateurs itunda',cf:'Confirmer',sa:'Envoyer quand même',cn:'Annuler'});
const nm9=p=>({'0788 000 214':'Amina K.','0781 234 567':'Eric M.'})[p]||p;
function shareRcpt(){const m='Sent '+fmt(S.sentAmt)+' RWF to '+nm9(S.to)+' on itunda. Ref IT-20481-7';try{navigator.clipboard.writeText(m)}catch(e){}toast(s9('cp'))}
const OB9=['obPhone','obNotFound','obName','obTerms','obPin','obPin2','obDone'];
const eye9=off=>`<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/>${off?'<path d="M4 4l16 16"/>':''}</svg>`;
const HB9={en:['Hide balances','Show balances','Balances hidden','Balances shown'],rw:['Hisha amafaranga','Erekana amafaranga','Amafaranga arahishwe','Amafaranga arerekanwa'],fr:['Masquer les soldes','Afficher les soldes','Soldes masqués','Soldes affichés']};
const hb9=i=>(HB9[S.lang]||HB9.en)[i];
function tgHide(){S.hide=false;return;render('fade-none');toast(S.hide?hb9(2):hb9(3))}
function v9(){const ph=$('#phone');let p=$('#prog');if(!p){ph.insertAdjacentHTML('beforeend','<div id="prog"><i></i></div>');p=$('#prog')}
const i=S.auth?-1:OB9.indexOf(S.obStep);p.style.opacity=i>0?1:0;p.firstChild.style.width=((i+1)/OB9.length*100)+'%';
ph.classList.toggle('hid',!!S.hide);upd9();tr9();{const sc=ph.querySelector('.screen');if(sc&&!sc.__s9){sc.__s9=1;sc.addEventListener('scroll',()=>sc.classList.toggle('sc9',sc.scrollTop>4),{passive:true})}if(sc)sc.classList.toggle('h9',!!(S.auth&&!S.stack.length&&S.tab==='home'))}
if(S.auth&&!S.stack.length&&S.tab==='home'){const l=[...ph.querySelectorAll('.sm.mu')].find(e=>e.textContent.trim()==='itunda Bank');if(false)l.insertAdjacentHTML('beforeend',`<button class="eye" aria-label="${S.hide?hb9(1):hb9(0)}" aria-pressed="${!!S.hide}" onclick="event.stopPropagation();tgHide()">${eye9(S.hide)}</button>`);
const pr=ph.querySelector('.row.tap .r span');if(pr)pr.classList.add('bv')}}
{const _r=render;render=function(){_r.apply(this,arguments);v9()}}
['key','obKey'].forEach(n=>{const f=window[n];if(typeof f==='function')window[n]=function(){try{navigator.vibrate&&navigator.vibrate(6)}catch(e){}const r=f.apply(this,arguments);upd9();return r}});
/* v10: bills and airtime, activity feed, add money */
const BP={'REG electricity':{l:'Meter number',n:11,a:[2000,5000,10000,18500],tok:1},'WASAC water':{l:'Water meter number',n:9,a:[2000,5000,10000,20000]},'MTN airtime':{l:'Phone number',n:9,a:[500,1000,2000,5000]},'Airtel airtime':{l:'Phone number',n:9,a:[500,1000,2000,5000]},'RRA taxes':{l:'Tax ID (TIN)',n:9,a:[5000,10000,25000,50000]},'School fees':{l:'Student ID',n:6,a:[20000,50000,100000,120000]},'Irembo':{l:'Application number',n:8,a:[1000,5000,10000,20000]}};
S.bl={p:'REG electricity',num:'',amt:5000};S.act=[['up','Amina K.','Received · Yesterday',25000,'Received'],['bus','Kigali Bus Services','Paid · Tuesday',-300,'Paid']];S.af='All';S.addAmt=10000;S.addSrc='MTN MoMo';
const addAct=(g,t,c,a,k)=>S.act.unshift([g,t,c+' · Just now',a,k]);
const signed=a=>(a<0?'−':'+')+fmt(Math.abs(a))+' RWF';
function openBill(p,a){p=BP[p]?p:Object.keys(BP)[0];const P=BP[p];S.bl={p,num:(S.sm&&S.sm[p])||'',amt:a||P.a[1]};S.stack=['bill'];render('push')}
function billSet(p){p=BP[p]?p:Object.keys(BP)[0];const P=BP[p];S.bl={p,num:(S.sm&&S.sm[p])||'',amt:P.a[1]};render('fade-none')}
function billAmt(a){S.bl.amt=a;const y=$('#sc').scrollTop;render('fade-none');$('#sc').scrollTop=y}
function billNum(v){const B=S.bl,P=BP[B.p];let d=v.replace(/\D/g,'');if(P.l==='Phone number'){if(d.startsWith('250'))d=d.slice(3);if(d.startsWith('0'))d=d.slice(1)}B.num=d.slice(0,P.n);const i=$('#bnum');if(i.value!==B.num)i.value=B.num;billChk()}
function billChk(){const B=S.bl,b=$('#bgo');if(b)b.disabled=!(B.num.length===BP[B.p].n&&B.amt<=S.bank)}
screens.bill=()=>{const B=S.bl,P=BP[B.p],bad=B.amt>S.bank,al=P.a.includes(B.amt)?P.a:[B.amt,...P.a].slice(0,4);return `${bar('Pay bills')}<div class="chips" style="padding-top:16px">${Object.keys(BP).map(k=>`<button class="cch ${B.p===k?'on':''}" onclick="billSet('${k}')">${k}</button>`).join('')}</div><div class="pad"><div class="lab">${P.l}</div><input class="in" id="bnum" inputmode="numeric" aria-label="${P.l}" value="${B.num}" oninput="billNum(this.value)" placeholder="${P.l==='Phone number'?'7'+'X'.repeat(P.n-1):'0'.repeat(P.n)}"><div class="sm mu" style="margin-top:6px">${B.num.length}/${P.n} digits${P.l==='Phone number'?' (without the 0)':''}${S.sm&&S.sm[B.p]&&S.sm[B.p]===B.num?' · saved from your last payment':''}</div><div class="lab">Amount</div><div class="req" style="margin-top:10px">${al.map(a=>`<button class="${B.amt===a?'on':''}" onclick="billAmt(${a})">${fmt(a)} RWF</button>`).join('')}</div><div class="sm ${bad?'':'mu'}" style="margin-top:12px;${bad?'color:var(--er)':''}">${bad?t('insuff').replace('%s',fmt(S.bank)):'From itunda Bank · '+fmt(S.bank)+' RWF available'}</div><div class="fine" style="margin-top:20px">Providers and numbers are sample data. No real payment is made.</div></div><div class="cta"><button id="bgo" class="btn" ${B.num.length===P.n&&!bad?'':'disabled'} onclick="billPay()">Pay ${fmt(B.amt)} RWF</button></div>`};
function billPay(){const B=S.bl;$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div style="margin-bottom:12px">${gl('verified3d',60)}</div><div class="h1" style="font-size:22px;line-height:30px">Confirm it's you</div><div class="mu" style="font-size:15px;margin:8px 0 24px">Pay ${fmt(B.amt)} RWF to ${B.p} · ${B.num}</div><button class="btn" onclick="billDone()">Confirm</button></div>`}
function billDone(){const B=S.bl;S.sm=S.sm||{};S.sm[B.p]=B.num;if(B.p==='REG electricity'&&B.amt>=18500)S.regPaid=true;S.bank-=B.amt;S.bk=B.amt;addAct(/airtime/.test(B.p)?'phone':'bill',B.p,'Paid',-B.amt,'Paid');closeSheet();S.stack=['billdone'];render('push');setTimeout(confetti,260)}
screens.billdone=()=>{const B=S.bl,P=BP[B.p],tk=P.tok?`<div style="display:flex;justify-content:space-between;height:52px;align-items:center;font-size:15px;border-top:0"><span class="mu">Token (sample)</span><b>4821 0937 6612 3358</b></div>`:'';return `<div style="display:flex;flex-direction:column;align-items:center;padding-top:clamp(28px,12vh,190px)"><div class="g3">${gl('success3d',132)}</div><div class="h1" style="margin-top:28px;font-size:34px;line-height:42px">${fmt(B.amt)} RWF</div><div class="mu" style="font-size:16px;margin-top:8px">Paid to ${B.p}</div></div><div style="margin:44px 24px 0;padding:4px 20px;border-radius:20px;background:var(--chip)"><div style="display:flex;justify-content:space-between;height:52px;align-items:center;font-size:15px"><span class="mu">${P.l}</span><b>${B.num}</b></div>${tk}<div style="display:flex;justify-content:space-between;height:52px;align-items:center;font-size:15px;border-top:0"><span class="mu">Balance now</span><b>${fmt(S.bank)} RWF</b></div></div><div class="cta" style="border:0"><button class="btn" onclick="done()">Done</button></div>`};
screens.activity=()=>{const l=S.act.filter(x=>S.af==='All'||x[4]===S.af);return `${bar('Activity')}<div class="chips" style="padding-top:16px">${['All','Sent','Received','Paid'].map(k=>`<button class="cch ${S.af===k?'on':''}" onclick="S.af='${k}';render('fade-none')">${k}</button>`).join('')}</div><div class="sec" style="padding-top:12px">${l.length?l.map(x=>row(x[0],x[1],x[2],signed(x[3]),'actOpen('+S.act.indexOf(x)+')')).join(''):'<div class="mu" style="padding:24px 0;text-align:center">Nothing here yet.</div>'}</div><div class="pad fine" style="padding-top:20px">Sample data for this prototype.</div>`};
function openAct(){S.aq='';S.stack=['activity'];render('push')}
{const _h=screens.home;screens.home=()=>{const h=_h(),s=`<div class="sec"><div class="sech">Recent activity<a onclick="openAct()">See all</a></div>${S.act.slice(0,3).map((x,i)=>row(x[0],x[1],x[2],signed(x[3]),'actOpen('+i+')')).join('')}</div>`,k='<div class="sec"><div class="sech">For you</div>';return h.includes(k)?h.replace(k,s+k):h+s}}
['finish','shopDone','eDone'].forEach(n=>{const f=window[n];window[n]=function(){const r=f.apply(this,arguments);if(n==='finish')addAct('send','Sent to '+nm9(S.to),'Sent',-S.sentAmt,'Sent');else addAct('bag',n==='eDone'?REST[S.er].n:'itunda Shop','Paid',-(S.orders[0]?S.orders[0].t:0),'Paid');return r}});
{const f=orderDone;window.orderDone=function(){const r=f.apply(this,arguments);addAct('food',MENU[S.rest].n,'Paid',-S.orderTot,'Paid');return r}}
function sheetAdd(){drawAdd()}
function drawAdd(){$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div style="margin-bottom:10px">${gl('cashin3d',60)}</div><div class="h1" style="font-size:22px;line-height:30px">${t('am')}</div><div class="mu" style="font-size:14px;margin:6px 0 14px">Move money from mobile money into itunda Pay.</div><div class="req">${['MTN MoMo','Airtel Money'].map(k=>`<button class="${S.addSrc===k?'on':''}" onclick="S.addSrc='${k}';drawAdd()">${k}</button>`).join('')}</div><div class="req" style="margin:12px 0 20px">${[5000,10000,20000,50000].map(a=>`<button class="${S.addAmt===a?'on':''}" onclick="S.addAmt=${a};drawAdd()">${fmt(a)} RWF</button>`).join('')}</div><div class="row2"><button class="btn sec2" onclick="closeSheet()">${t('cn')}</button><button class="btn" onclick="addMoney()">Add ${fmt(S.addAmt)}</button></div></div>`}
function addMoney(){S.pay+=S.addAmt;addAct('up','From '+S.addSrc,'Received',S.addAmt,'Received');closeSheet();render('fade-none');toast('Added '+fmt(S.addAmt)+' RWF to itunda Pay')}
{const _s=soon,M={'Pay bills':'REG electricity','REG electricity':'REG electricity','WASAC water':'WASAC water','Airtime':'MTN airtime','Irembo':'Irembo','RRA taxes':'RRA taxes','School fees':'School fees'};soon=function(){const ev=window.event,c=ev&&ev.target&&ev.target.closest?ev.target.closest('[onclick]'):null;if(c){const e=c.querySelector('.t,.pn')||c.querySelector('span'),n=((e?e.textContent:c.textContent)||'').trim().split('\n')[0];const gi=c.classList.contains('gi');if(M[n]&&(gi||/^(Pay bills|Airtime)$/.test(n))){openBill(M[n]);return}if(n==='REG electricity'&&c.classList.contains('row')){openBill(n,18500);return}if(n==='itunda Pay'&&c.classList.contains('row')){tab('pay');return}}return _s.apply(this,arguments)}}
Object.assign(TR9.rw,{'Recent activity':`Ibyakozwe vuba`,'See all':`Byose`});Object.assign(TR9.fr,{'Recent activity':`Activité récente`,'See all':`Tout voir`});
/* v10b: credit score */
const paidN=()=>S.act.filter(x=>x[4]==='Paid').length,score=()=>672+Math.min(30,5*(paidN()-1));
screens.score=()=>{const sc=score(),f=(sc-300)/550,F=[['Payment history',92+Math.min(6,paidN())],['Mobile money activity',78],['Savings habits',S.goal?72:64],['Account age',40]];return `${bar('Credit score')}<div style="padding:24px 24px 0;text-align:center"><svg viewBox="0 0 200 116" width="260" role="img" aria-label="Score ${sc} of 850"><path d="M20 100A80 80 0 0 1 180 100" fill="none" stroke="var(--chip)" stroke-width="14" stroke-linecap="round"/><path d="M20 100A80 80 0 0 1 180 100" fill="none" stroke="var(--br)" stroke-width="14" stroke-linecap="round" stroke-dasharray="${(251.3*f).toFixed(1)} 300"/></svg><div class="big" style="margin-top:-52px">${sc}</div><div style="font-weight:800;color:var(--ok);margin-top:4px">Good</div><div class="sm mu" style="margin-top:4px">Range 300 to 850</div></div><div class="sec"><div class="sech">What shapes your score</div>${F.map(([n,v])=>`<div style="padding:10px 0"><div style="display:flex;justify-content:space-between;font-size:15px;font-weight:700"><span>${n}</span><span class="mu">${v}%</span></div><div style="height:8px;border-radius:4px;background:var(--chip);margin-top:8px"><div style="height:8px;border-radius:4px;background:var(--br);width:${v}%"></div></div></div>`).join('')}</div><div class="pad" style="padding-top:20px"><div style="background:var(--tint);border-radius:20px;padding:16px 18px"><div class="sm" style="font-weight:800;color:var(--tintfg)">Tip</div><div style="font-size:15px;margin-top:4px;line-height:22px">Paying bills on time through itunda lifts your score. Starting a savings goal helps too.</div></div></div><div class="pad fine" style="padding-top:20px">Free check using alternative data. Sample score for this prototype, not a real credit report.</div>`};
function openScore(){S.stack.push('score');render('push')}
{const _s2=soon;soon=function(){const ev=window.event,c=ev&&ev.target&&ev.target.closest?ev.target.closest('[onclick]'):null;if(c){const e=c.querySelector('.t,.pn')||c.querySelector('span');if(((e?e.textContent:c.textContent)||'').trim().split('\n')[0]==='My credit score'){openScore();return}}return _s2.apply(this,arguments)}}
/* v10c: messages search and new message */
S.mq=null;const CT=[['eric','Eric M.','078 ••• 381'],['jc','Jean Claude','072 ••• 905'],['grace','Grace N.','073 ••• 126']];
{const _m=screens.messages;screens.messages=()=>{let h=_m();if(S.mq===null)return h;const q=S.mq.trim().toLowerCase(),M='<div class="ar tap" style="padding:12px 24px"',ps=h.split(M),keep=ps.slice(1).filter(x=>{const m=x.match(/openChat\('(\w+)'\)/),t=m&&THREADS.find(y=>y.id===m[1]);return t&&t.n.toLowerCase().includes(q)});const i=`<label class="asr">${ic('search',20)}<input id="mq" placeholder="Search messages" value="${S.mq.replace(/"/g,'')}" oninput="mSearch(this.value)" aria-label="Search messages"></label>`;let out=ps[0]+i+keep.map(x=>M+x).join('');if(!keep.length)out+='<div class="pad mu" style="padding-top:28px;font-size:14px">No conversations match.</div>';return out+'</div>'}}
function mSearch(v){S.mq=v;render('fade-none');const i=$('#mq');if(i){i.focus();i.setSelectionRange(v.length,v.length)}}
function newMsg(){$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="h1" style="font-size:22px;line-height:30px;margin-bottom:6px">New message</div>${[['amina','Amina K.','078 ••• 214'],...CT].map(([id,n,ph])=>`<div class="row tap" onclick="startChat('${id}')"><div class="ico">${gl('community',30)}</div><div><div class="t">${n}</div><div class="s">${ph}</div></div></div>`).join('')}</div>`}
function startChat(id){if(!THREADS.find(t=>t.id===id)){const c=CT.find(x=>x[0]===id);THREADS.unshift({id,n:c[1],g:'community',t:'Now',u:0,sub:'itunda · '+c[2],m:[]});S.msgs[id]=[]}closeSheet();S.mq=null;openChat(id)}
{const _s3=soon;soon=function(){const ev=window.event,c=ev&&ev.target&&ev.target.closest?ev.target.closest('[onclick]'):null,l=c&&c.getAttribute('aria-label');if(S.tab==='messages'&&!S.stack.length){if(l==='Search'){S.mq=S.mq===null?'':null;render('fade-none');const i=$('#mq');if(i)i.focus();return}if(l==='New message'){newMsg();return}}return _s3.apply(this,arguments)}}
/* v10d: interest jar and 12-month deposit */
S.jar=0;S.dep=null;S.da=100000;
screens.jar=()=>{const j=S.jar;return `${bar('Interest jar')}<div class="pad" style="padding-top:28px"><div class="sm mu">In your jar</div><div class="big" style="margin-top:4px">${fmt(j)} RWF</div><div class="sm" style="margin-top:8px;font-weight:700;color:var(--ok)">4.0% a year · about ${fmt(Math.round(j*.04/12))} RWF interest a month</div><div class="mu" style="font-size:15px;margin-top:16px;line-height:22px">Put money aside and take it out any time. Interest builds daily.</div></div><div class="pad row2" style="padding-top:28px"><button class="btn" ${S.bank<5000?'disabled':''} onclick="jarMove(1)">Add 5,000</button><button class="btn sec2" ${j<5000?'disabled':''} onclick="jarMove(-1)">Take out 5,000</button></div><div class="pad sm mu" style="padding-top:12px">From itunda Bank · ${fmt(S.bank)} RWF available</div><div class="pad fine" style="padding-top:24px">Rates and balances are sample data for this prototype.</div>`};
function jarMove(d){S.bank-=5000*d;S.jar+=5000*d;addAct('coin','Interest jar',d>0?'Paid':'Received',d>0?-5000:5000,d>0?'Paid':'Received');render('fade-none');toast(d>0?'Added 5,000 RWF to your jar':'Took out 5,000 RWF')}
screens.dep=()=>{const D=S.dep;if(D)return `${bar('12-month deposit')}<div class="pad" style="padding-top:28px"><div class="sm mu">Locked principal</div><div class="big" style="margin-top:4px">${fmt(D.a)} RWF</div><div class="sm" style="margin-top:8px;font-weight:700;color:var(--ok)">Interest already paid: ${fmt(D.i)} RWF</div></div><div style="margin:28px 24px 0;padding:4px 20px;border-radius:20px;background:var(--chip)"><div style="display:flex;justify-content:space-between;height:52px;align-items:center;font-size:15px"><span class="mu">Unlocks on</span><b>15 Oct 2027</b></div><div style="display:flex;justify-content:space-between;height:52px;align-items:center;font-size:15px;border-top:0"><span class="mu">Status</span><b>Locked</b></div></div><div class="pad fine" style="padding-top:20px">Sample deposit for this prototype.</div>`;const a=S.da,i=Math.round(a*.08),bad=a>S.bank;return `${bar('12-month deposit')}<div class="pad" style="padding-top:28px"><div class="h1">Get your interest today</div><div class="mu" style="font-size:15px;margin-top:8px;line-height:22px">Lock money for 12 months. We pay the interest upfront and hold the principal.</div></div><div class="pad" style="padding-top:20px"><div class="req">${[50000,100000,250000,500000].map(x=>`<button class="${S.da===x?'on':''}" onclick="S.da=${x};render('fade-none')">${fmt(x)} RWF</button>`).join('')}</div></div><div style="margin:24px 24px 0;padding:4px 20px;border-radius:20px;background:var(--tint)"><div style="display:flex;justify-content:space-between;height:52px;align-items:center;font-size:15px"><span>Rate (sample)</span><b>8.0%</b></div><div style="display:flex;justify-content:space-between;height:52px;align-items:center;font-size:15px;border-top:0"><span>Paid to you now</span><b style="color:var(--ok)">+${fmt(i)} RWF</b></div><div style="display:flex;justify-content:space-between;height:52px;align-items:center;font-size:15px;border-top:0"><span>Unlocks</span><b>15 Oct 2027</b></div></div><div class="pad sm ${bad?'':'mu'}" style="padding-top:12px;${bad?'color:var(--er)':''}">${bad?t('insuff').replace('%s',fmt(S.bank)):'From itunda Bank · '+fmt(S.bank)+' RWF available'}</div><div class="cta"><button class="btn" ${bad?'disabled':''} onclick="depAsk()">Lock ${fmt(a)} RWF</button></div>`};
function depAsk(){$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div style="margin-bottom:12px">${gl('lock',60)}</div><div class="h1" style="font-size:22px;line-height:30px">Lock ${fmt(S.da)} RWF?</div><div class="mu" style="font-size:15px;margin:8px 0 24px">You can't take the principal out until 15 Oct 2027.</div><div class="row2"><button class="btn sec2" onclick="closeSheet()">Cancel</button><button class="btn" onclick="depDo()">Lock it</button></div></div>`}
function depDo(){const a=S.da,i=Math.round(a*.08);S.bank+=i-a;S.dep={a,i};addAct('lock','12-month deposit','Paid',-a,'Paid');addAct('plus','Deposit interest','Received',i,'Received');closeSheet();render('fade-none');setTimeout(confetti,200)}
{const _s4=soon;soon=function(){const ev=window.event,c=ev&&ev.target&&ev.target.closest?ev.target.closest('[onclick]'):null;if(c&&S.stack[S.stack.length-1]==='bank'){const e=c.querySelector('.t'),n=e?e.textContent.trim():'';if(n==='Interest jar'){S.stack.push('jar');render('push');return}if(n==='12-month deposit'){S.stack.push('dep');render('push');return}}return _s4.apply(this,arguments)}}
/* v10e: live savings labels, round-up, ikimina */
S.ru=true;S.ruT=0;S.ik=false;
{const _b=screens.bank;screens.bank=()=>_b().replace('4.0% annual · RWF 18,400 earned so far','4.0% annual · RWF '+fmt(S.jar)+' saved').replace('RWF 1,240',fmt(S.jar)+' RWF').replace('Interest paid upfront, principal locked',S.dep?'Locked · '+fmt(S.dep.a)+' RWF until 15 Oct 2027':'Interest paid upfront, principal locked').replace('Rounding up to RWF 100</div>','Rounding up to RWF 100'+(S.ruT?' · '+fmt(S.ruT)+' RWF saved':'')+'</div>').replace(/(Round-up saving[\s\S]*?class="r">)On/,'$1'+(S.ru?'On':'Off'))}
{const f=window.finish;window.finish=function(){const v=Number(S.amt),x=S.ru&&v%100?100-v%100:0;if(x&&S.bank-v>=x){S.bank-=x;S.jar+=x;S.ruT+=x;addAct('coin','Round-up to jar','Paid',-x,'Paid')}return f.apply(this,arguments)}}
const IK=['Eric M.','Marie C.','Aline U.','Patrick N.','You','Diane K.','Joseph B.','Claire M.'];
screens.ikim=()=>{const bad=S.bank<10000&&!S.ik;return `${bar('Umurenge Savers')}<div class="pad" style="padding-top:24px"><div class="sm mu">Ikimina group · 8 members</div><div class="big" style="margin-top:4px">80,000 RWF</div><div class="sm mu" style="margin-top:4px">Pot this round · 10,000 RWF each · due Friday</div></div><div style="margin:20px 24px 0;padding:14px 18px;border-radius:20px;background:var(--tint)"><div class="sm" style="font-weight:800;color:var(--tintfg)">Next to receive</div><div style="font-size:18px;font-weight:800;margin-top:2px">Eric M. on the 1st</div><div class="sm mu" style="margin-top:2px">Your turn is round 5 of 8</div></div><div class="sec" style="padding-top:20px"><div class="sech">This round</div>${IK.map((n,i)=>`<div class="row" style="cursor:default;padding:8px 0"><div class="ico" style="width:36px;height:36px">${gl('community',24)}</div><div class="t" style="font-size:15px">${n}</div><div class="r" style="color:${i===4&&!S.ik?'var(--er)':'var(--ok)'}">${i===4&&!S.ik?'Due':'Paid'}</div></div>`).join('')}</div><div class="pad" style="padding-top:12px"><button class="btn sec2" style="height:48px;font-size:16px" onclick="openChat('ikimina')">Open group chat</button></div><div class="pad fine" style="padding-top:16px">Sample group for this prototype.</div><div class="cta"><button class="btn" ${S.ik||bad?'disabled':''} onclick="ikPay()">${S.ik?'Paid for this round':'Contribute 10,000 RWF'}</button></div>`};
function ikPay(){S.bank-=10000;S.ik=true;addAct('users','Umurenge Savers','Paid',-10000,'Paid');render('fade-none');toast('Contribution sent');setTimeout(confetti,200)}
{const _s5=soon;soon=function(){const ev=window.event,c=ev&&ev.target&&ev.target.closest?ev.target.closest('[onclick]'):null;if(c&&S.stack[S.stack.length-1]==='bank'){const e=c.querySelector('.t'),n=e?e.textContent.trim():'';if(n==='Ikimina'||n==='Join an Ikimina circle'){S.stack.push('ikim');render('push');return}if(n==='Round-up saving'){S.ru=!S.ru;render('fade-none');toast('Round-up '+(S.ru?'on':'off'));return}}return _s5.apply(this,arguments)}}
/* v10f: loans */
S.loan=null;S.la=100000;S.lm=6;S.lp={n:'Get a loan',r:.012,a:[50000,100000,250000,500000],t:[3,6,12]};
const lcalc=(a,m)=>{const mo=Math.round(a*(1+S.lp.r*m)/m);return{tot:mo*m,mo}};
const lrow=(a,b,top)=>`<div style="display:flex;justify-content:space-between;height:52px;align-items:center;font-size:15px;${top?'border-top:0':''}"><span class="mu">${a}</span><b>${b}</b></div>`;
screens.loan=()=>{const L=S.loan;if(L){const left=L.m-L.paid,rem=L.mo*left,pc=Math.round(L.paid/L.m*100),bad=S.bank<L.mo;return `${bar('Your loan')}<div class="pad" style="padding-top:28px"><div class="sm mu">Left to repay</div><div class="big" style="margin-top:4px">${fmt(rem)} RWF</div><div style="height:8px;border-radius:4px;background:var(--chip);margin-top:14px"><div style="height:8px;border-radius:4px;background:var(--br);width:${pc}%;transition:width .4s"></div></div><div class="sm mu" style="margin-top:8px">${L.paid} of ${L.m} instalments paid</div></div><div style="margin:24px 24px 0;padding:4px 20px;border-radius:20px;background:var(--chip)">${lrow('Borrowed',fmt(L.a)+' RWF')}${lrow('Monthly instalment',fmt(L.mo)+' RWF',1)}${lrow('Next due','15 of each month',1)}</div><div class="pad sm ${bad?'':'mu'}" style="padding-top:12px;${bad?'color:var(--er)':''}">${bad?t('insuff').replace('%s',fmt(S.bank)):'From itunda Bank · '+fmt(S.bank)+' RWF available'}</div><div class="cta"><button class="btn" ${bad?'disabled':''} onclick="loanPay()">Pay ${fmt(L.mo)} RWF</button></div>`}const c=lcalc(S.la,S.lm);return `${bar(S.lp.n)}<div class="pad" style="padding-top:28px"><div class="h1">How much do you need?</div><div class="mu" style="font-size:15px;margin-top:8px">You can borrow up to ${fmt(Math.max(...S.lp.a))} RWF with your score of ${score()}.</div></div><div class="pad" style="padding-top:20px"><div class="req">${S.lp.a.map(x=>`<button class="${S.la===x?'on':''}" onclick="S.la=${x};render('fade-none')">${fmt(x)} RWF</button>`).join('')}</div><div class="lab">Repay over</div><div class="req" style="margin-top:10px">${S.lp.t.map(x=>`<button class="${S.lm===x?'on':''}" onclick="S.lm=${x};render('fade-none')">${x} months</button>`).join('')}</div></div><div style="margin:24px 24px 0;padding:4px 20px;border-radius:20px;background:var(--tint)">${lrow('Monthly instalment',fmt(c.mo)+' RWF')}${lrow('Total to repay',fmt(c.tot)+' RWF',1)}${lrow('Rate (sample)',+(S.lp.r*100).toFixed(2)+'% a month',1)}</div><div class="pad fine" style="padding-top:16px">Sample terms for this prototype. No real loan is made.</div><div class="cta"><button class="btn" onclick="loanAsk()">Apply for ${fmt(S.la)} RWF</button></div>`};
function loanAsk(){const c=lcalc(S.la,S.lm);$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div style="margin-bottom:12px">${gl('verified3d',60)}</div><div class="h1" style="font-size:22px;line-height:30px">Confirm it's you</div><div class="mu" style="font-size:15px;margin:8px 0 24px">Borrow ${fmt(S.la)} RWF and repay ${fmt(c.mo)} RWF a month for ${S.lm} months.</div><button class="btn" onclick="loanDo()">Confirm</button></div>`}
function loanDo(){const c=lcalc(S.la,S.lm);S.loan={a:S.la,m:S.lm,mo:c.mo,paid:0};S.bank+=S.la;addAct('wallet','Loan paid out','Received',S.la,'Received');closeSheet();render('fade-none');setTimeout(confetti,200);toast(fmt(S.la)+' RWF added to itunda Bank')}
function loanPay(){const L=S.loan;S.bank-=L.mo;L.paid++;addAct('wallet','Loan repayment','Paid',-L.mo,'Paid');if(L.paid>=L.m){S.loan=null;toast('Loan fully repaid. Well done.');setTimeout(confetti,200)}else toast('Paid '+fmt(L.mo)+' RWF');render('fade-none')}
{const _s6=soon;soon=function(){const ev=window.event,c=ev&&ev.target&&ev.target.closest?ev.target.closest('[onclick]'):null;if(c&&S.stack[S.stack.length-1]==='bank'){const e=c.querySelector('.t');const q=e&&LPS[e.textContent.trim()];if(q){S.lp={n:e.textContent.trim(),...q};if(!S.loan){S.la=q.a[1];S.lm=q.t[1]}S.stack.push('loan');render('push');return}}return _s6.apply(this,arguments)}}
{const _b2=screens.bank;screens.bank=()=>{const h=_b2();return S.loan?h.replace('Personal, salary-backed, SME working capital','Active · '+(S.loan.m-S.loan.paid)+' instalments left'):h}}
/* v10g: more loan products, SACCO shares */
const LPS={'Get a loan':{r:.012,a:[50000,100000,250000,500000],t:[3,6,12]},'Student loan':{r:.11/12,a:[200000,500000,1000000,2000000],t:[12,24,36]},'Harvest advance':{r:.01,a:[100000,250000,500000,1000000],t:[3,6,9]},'VUP Financial Services':{r:.005,a:[50000,100000,250000,500000],t:[6,12,24]},'Moto-Taxi Ownership':{r:.012,a:[1200000,1500000,2000000],t:[12,24,36]}};
S.sh=0;
screens.sacco=()=>{const v=S.sh*5000,bad=n=>S.bank<n*5000;return `${bar('SACCO shares')}<div class="pad" style="padding-top:28px"><div class="sm mu">Your shares</div><div class="big" style="margin-top:4px">${S.sh} <span style="font-size:20px;letter-spacing:0">(${fmt(v)} RWF)</span></div><div class="sm" style="margin-top:8px;font-weight:700;color:var(--ok)">Estimated dividend: ${fmt(Math.round(v*.06))} RWF a year</div><div class="mu" style="font-size:15px;margin-top:16px;line-height:22px">Own a part of your cooperative. Each share is 5,000 RWF and earns a dividend when the SACCO makes a surplus.</div></div><div style="margin:24px 24px 0;padding:4px 20px;border-radius:20px;background:var(--chip)">${lrow('Share price','5,000 RWF')}${lrow('Dividend (sample)','6% a year',1)}${lrow('Withdrawals','At year end',1)}</div><div class="pad row2" style="padding-top:24px"><button class="btn" ${bad(1)?'disabled':''} onclick="buySh(1)">Buy 1</button><button class="btn sec2" ${bad(5)?'disabled':''} onclick="buySh(5)">Buy 5</button></div><div class="pad sm mu" style="padding-top:12px">From itunda Bank · ${fmt(S.bank)} RWF available</div><div class="pad fine" style="padding-top:20px">Sample dividend and terms for this prototype.</div>`};
function buySh(n){S.bank-=n*5000;S.sh+=n;addAct('bank','SACCO shares','Paid',-n*5000,'Paid');render('fade-none');toast('Bought '+n+' share'+(n>1?'s':''))}
{const _s7=soon;soon=function(){const ev=window.event,c=ev&&ev.target&&ev.target.closest?ev.target.closest('[onclick]'):null;if(c&&S.stack[S.stack.length-1]==='bank'){const e=c.querySelector('.t'),n=e?e.textContent.trim():'';if(n==='SACCO shares'||n==='Try SACCO shares'){S.stack.push('sacco');render('push');return}}return _s7.apply(this,arguments)}}
/* v10h: group and youth accounts, new goal link */
S.grp=null;S.gn='Family';S.yth=null;S.yn='Keza';
const chipRow=(a,cur,fn)=>`<div class="req" style="margin-top:10px">${a.map(x=>`<button class="${cur===x?'on':''}" onclick="${fn}('${x}')">${x}</button>`).join('')}</div>`;
screens.grp=()=>{const G=S.grp;if(!G)return `${bar('Group accounts')}<div class="pad" style="padding-top:28px"><div class="h1">Save together</div><div class="mu" style="font-size:15px;margin-top:8px;line-height:22px">A shared account for family, church or a cooperative. Everyone can add money.</div><div class="lab">Group type</div>${chipRow(['Family','Church','Cooperative'],S.gn,'grpType')}</div><div class="pad fine" style="padding-top:20px">Sample group for this prototype.</div><div class="cta"><button class="btn" onclick="grpMake()">Create ${S.gn.toLowerCase()} account</button></div>`;const bad=n=>S.bank<n;return `${bar(G.n+' savings')}<div class="pad" style="padding-top:28px"><div class="sm mu">Group balance</div><div class="big" style="margin-top:4px">${fmt(G.bal)} RWF</div></div><div class="sec" style="padding-top:20px"><div class="sech">Members</div>${G.mem.map(([n,v])=>`<div class="row" style="cursor:default;padding:8px 0"><div class="ico" style="width:36px;height:36px">${gl('community',24)}</div><div class="t" style="font-size:15px">${n}</div><div class="r">${fmt(v)} RWF</div></div>`).join('')}</div><div class="pad row2" style="padding-top:20px"><button class="btn" ${bad(5000)?'disabled':''} onclick="grpAdd(5000)">Add 5,000</button><button class="btn sec2" ${bad(10000)?'disabled':''} onclick="grpAdd(10000)">Add 10,000</button></div><div class="pad fine" style="padding-top:20px">Withdrawals need approval from two members. Sample data.</div>`};
function grpType(x){S.gn=x;render('fade-none')}
function grpMake(){S.grp={n:S.gn,bal:0,mem:[['You',0],['Eric M.',0],['Amina K.',0]]};render('fade-none');toast('Group account created')}
function grpAdd(n){S.bank-=n;S.grp.bal+=n;S.grp.mem[0][1]+=n;addAct('users',S.grp.n+' savings','Paid',-n,'Paid');render('fade-none');toast('Added '+fmt(n)+' RWF')}
screens.yth=()=>{const Y=S.yth;if(!Y)return `${bar('Youth account')}<div class="pad" style="padding-top:28px"><div class="h1">A first account for your child</div><div class="mu" style="font-size:15px;margin-top:8px;line-height:22px">For under-18s. You stay in charge: you add money and set the spending limit.</div><div class="lab">Child's name</div>${chipRow(['Keza','Ineza','Kevin'],S.yn,'ythName')}</div><div class="pad fine" style="padding-top:20px">Sample account for this prototype.</div><div class="cta"><button class="btn" onclick="ythMake()">Open account for ${S.yn}</button></div>`;return `${bar(Y.n+"'s account")}<div class="pad" style="padding-top:28px"><div class="sm mu">Balance</div><div class="big" style="margin-top:4px">${fmt(Y.bal)} RWF</div><div class="sm mu" style="margin-top:6px">Parent-supervised · weekly limit ${fmt(Y.l)} RWF</div></div><div class="pad row2" style="padding-top:24px"><button class="btn" ${S.bank<2000?'disabled':''} onclick="ythSend(2000)">Send 2,000</button><button class="btn sec2" ${S.bank<5000?'disabled':''} onclick="ythSend(5000)">Send 5,000</button></div><div class="pad" style="padding-top:28px"><div style="font-size:16px;font-weight:700">Weekly spending limit</div><div class="req" style="margin-top:10px">${[1000,3000,5000].map(x=>`<button class="${Y.l===x?'on':''}" onclick="S.yth.l=${x};render('fade-none')">${fmt(x)} RWF</button>`).join('')}</div></div><div class="pad fine" style="padding-top:20px">Sample data for this prototype.</div>`};
function ythName(x){S.yn=x;render('fade-none')}
function ythMake(){S.yth={n:S.yn,bal:0,l:3000};render('fade-none');toast('Account opened for '+S.yn)}
function ythSend(n){S.bank-=n;S.yth.bal+=n;addAct('child',S.yth.n+"'s account",'Paid',-n,'Paid');render('fade-none');toast('Sent '+fmt(n)+' RWF to '+S.yth.n)}
{const _s8=soon;soon=function(){const ev=window.event,c=ev&&ev.target&&ev.target.closest?ev.target.closest('[onclick]'):null;if(c&&S.stack[S.stack.length-1]==='bank'){const e=c.querySelector('.t'),n=e?e.textContent.trim():'';if(n==='Group accounts'){S.stack.push('grp');render('push');return}if(n==='Youth account'){S.stack.push('yth');render('push');return}if(n==='New savings goal'){openGoal();return}}return _s8.apply(this,arguments)}}
setTimeout(()=>render('fade'),1300);
/* v11: keyboard + screen-reader access */
(()=>{let q=0;const enh=()=>{q=0;const r=document.getElementById('phone')||document;
r.querySelectorAll('[onclick]').forEach(e=>{if(/^(BUTTON|A|INPUT)$/.test(e.tagName))return;if(!e.hasAttribute('tabindex'))e.setAttribute('tabindex','0');if(!e.hasAttribute('role'))e.setAttribute('role','button')});
r.querySelectorAll('.sw').forEach(e=>{e.setAttribute('role','switch');e.setAttribute('tabindex','0');e.setAttribute('aria-checked',String(e.classList.contains('on')))});
r.querySelectorAll('.toast').forEach(e=>{e.setAttribute('role','status');e.setAttribute('aria-live','polite')});try{document.documentElement.lang=({rw:'rw',fr:'fr'})[S.lang]||'en'}catch(_){}};
const sched=()=>{if(!q){q=1;requestAnimationFrame(enh)}};
new MutationObserver(sched).observe(document.getElementById('phone')||document.body,{childList:true,subtree:true,attributes:true,attributeFilter:['class']});
document.addEventListener('keydown',e=>{const el=e.target;
if((e.key==='Enter'||e.key===' ')&&el&&el.matches&&el.matches('[role=switch]')&&!/^(BUTTON|INPUT|A)$/.test(el.tagName)){e.preventDefault();el.click()}});
sched()})();
/* v12: score-based loan limit, low-balance hints */
{const fin=m=>{const d=new Date();d.setDate(15);d.setMonth(d.getMonth()+m);return d.toLocaleDateString('en-GB',{month:'long',year:'numeric'})};const _l=screens.loan;screens.loan=()=>{if(S.loan){const L=S.loan,rem=L.mo*(L.m-L.paid);return _l().replace(/<\/button><\/div>$/,`</button><button class="btn sec2" style="margin-top:10px" ${S.bank<rem?'disabled':''} onclick="loanAll()">Repay in full · ${fmt(rem)} RWF</button></div>`)}const a=S.lp.a,f=score()>=700?1:score()>=600?.5:.25,lim=Math.max(Math.min(...a),Math.floor(Math.max(...a)*f/1000)*1000);if(S.la>lim)S.la=Math.max(...a.filter(x=>x<=lim));return _l().replace('Sample terms for this prototype.',(lim<Math.max(...a)?'Higher amounts unlock as your score improves. ':'')+'Sample terms for this prototype.').replace(/up to .*? RWF with your score/,'up to '+fmt(lim)+' RWF with your score').replace(/<button class="(on)?" onclick="S\.la=(\d+);/g,(m,o,n)=>+n>lim?m.replace('<button','<button disabled'):m).replace(/Rate \(sample\)<\/span><b>[^<]*<\/b><\/div>/,x=>x+lrow('Total interest',fmt(lcalc(S.la,S.lm).tot-S.la)+' RWF',1)+lrow('Final payment',fin(S.lm),1))}}
{const hint=(h,n)=>S.bank<n?h+`<div class="pad sm" style="padding-top:12px;color:var(--er)">${t('insuff').replace('%s',fmt(S.bank))}</div>`:h;const _g=screens.grp;screens.grp=()=>S.grp?hint(_g(),5000):_g();const _y=screens.yth;screens.yth=()=>S.yth?hint(_y(),2000):_y()}
/* v13: SACCO confirm sheet, focus on sheet open */
const focusSheet=()=>setTimeout(()=>{const b=document.querySelector('#layer .sheet .btn:not(.sec2)')||document.querySelector('#layer .sheet .btn');if(b)b.focus()},320);
{const _b=buySh;buySh=function(n,ok){if(ok)return _b(n);const v=n*5000;$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div style="margin-bottom:12px">${gl('verified3d',60)}</div><div class="h1" style="font-size:22px;line-height:30px">Confirm your purchase</div><div class="mu" style="font-size:15px;margin:8px 0 24px">Buy ${n} SACCO share${n>1?'s':''} for ${fmt(v)} RWF from itunda Bank.</div><button class="btn" onclick="closeSheet();buySh(${n},1)">Confirm</button></div>`;focusSheet()}}
{const _a=loanAsk;loanAsk=function(){_a.apply(this,arguments);focusSheet()}}
/* v15: repay loan in full */
{const _d=depAsk;depAsk=function(){_d.apply(this,arguments);focusSheet()}}
function loanAll(ok){const L=S.loan;if(!L)return;const rem=L.mo*(L.m-L.paid);if(S.bank<rem)return;if(!ok){$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div style="margin-bottom:12px">${gl('verified3d',60)}</div><div class="h1" style="font-size:22px;line-height:30px">Repay your loan in full?</div><div class="mu" style="font-size:15px;margin:8px 0 24px">${fmt(rem)} RWF will leave itunda Bank, and your loan will be closed.</div><button class="btn" onclick="closeSheet();loanAll(1)">Repay ${fmt(rem)} RWF</button></div>`;focusSheet();return}S.bank-=rem;addAct('wallet','Loan repaid in full','Paid',-rem,'Paid');S.loan=null;render('fade-none');toast('Loan fully repaid. Well done.');setTimeout(confetti,200)}

function actRef(x){let h=0;const k=x[1]+x[2]+x[3];for(let i=0;i<k.length;i++)h=(h*31+k.charCodeAt(i))>>>0;return 'IT-'+String(h%90000+10000)+'-'+(h%9+1)}
function actOpen(i){const x=S.act[i];if(!x)return;const inn=x[3]>0,[kind,when]=x[2].split(' · '),ln='border-top:0',r=(a,b,t)=>`<div style="display:flex;justify-content:space-between;gap:16px;min-height:48px;align-items:center;font-size:15px;${t?ln:''}"><span class="mu">${a}</span><b style="text-align:right">${b}</b></div>`;
$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div style="display:flex;flex-direction:column;align-items:center;text-align:center"><div class="ico" style="width:56px;height:56px;border-radius:28px">${gx(x[0],30)}</div><div class="mu" style="font-size:15px;margin-top:12px">${x[1].replace(/</g,'&lt;')}</div><div class="h1" style="margin-top:4px;color:${inn?'var(--ok)':'var(--tx)'}">${signed(x[3])}</div></div><div style="margin:20px 0 4px;padding:0 16px;border-radius:20px;background:var(--chip)">${r('Status','Completed')}${r('Type',kind,1)}${r('When',when||'Earlier',1)}${r(inn?'To':'From','itunda Bank',1)}${r('Reference',actRef(x),1)}</div><div class="fine" style="margin:8px 0 16px">Sample data for this prototype.</div><div class="row2"><button class="btn sec2" onclick="closeSheet()">Close</button><button class="btn" onclick="actCopy(${i})">Copy details</button></div></div>`}
function actCopy(i){const x=S.act[i];try{navigator.clipboard.writeText(x[1]+' · '+signed(x[3])+' · '+x[2]+' · Ref '+actRef(x)).catch(()=>{})}catch(e){}closeSheet();toast('Details copied')}


/* v27: search in Activity */
S.aq='';
{const _a=screens.activity;screens.activity=()=>{const q=(S.aq||'').trim().toLowerCase();let h=_a();
const lab=`<label class="asr">${ic('search',20)}<input id="aq" placeholder="${S.lang==='rw'?'Shakisha ibyakozwe':S.lang==='fr'?'Rechercher dans l\'activité':'Search activity'}" value="${(S.aq||'').replace(/"/g,'')}" oninput="aSearch(this.value)" aria-label="${S.lang==='rw'?'Shakisha ibyakozwe':S.lang==='fr'?'Rechercher dans l\'activité':'Search activity'}"></label>`;
const M='<div class="row tap"';let ps=h.split(M);
if(q&&ps.length>1){const keep=ps.slice(1).filter(x=>{const m=x.match(/actOpen\((\d+)\)/),a=m&&S.act[+m[1]];return a&&(a[1]+' '+a[2]+' '+Math.abs(a[3])+' '+fmt(Math.abs(a[3]))).toLowerCase().includes(q)});
const tail=ps[ps.length-1].match(/<\/div>(<div class="pad fine".*)$/);
h=ps[0]+(keep.length?keep.map(x=>M+x.replace(/<\/div>(<div class="pad fine".*)$/,'</div>')).join(''):'')+(keep.length?'':'')}
if(q&&ps.length>1&&!h.includes('actOpen(')){h=h.replace(/(<div class="sec"[^>]*>)/,`$1<div class="mu" style="padding:24px 0;text-align:center">${S.lang==='rw'?'Nta kintu kibonetse.':S.lang==='fr'?'Aucun résultat.':'No matches.'}</div>`)}
if(q&&!/class="pad fine"/.test(h))h+='<div class="pad fine" style="padding-top:20px">'+(S.lang==='rw'?'Amakuru y\'ikitegererezo kuri iyi porogaramu.':S.lang==='fr'?'Données d\'exemple pour ce prototype.':'Sample data for this prototype.')+'</div>';return h.replace(/(<div class="chips")/,lab+'$1')}}
function aSearch(v){S.aq=v;render('fade-none');const i=$('#aq');if(i){i.focus();i.setSelectionRange(v.length,v.length)}}
/* v26: Kinyarwanda and French for bills, receipts and activity */
{const M={"rw": {"Pay bills": "Kwishyura fagitire", "Amount": "Amafaranga", "Meter number": "Numero ya kaunta", "Water meter number": "Numero ya kaunta y'amazi", "Phone number": "Numero ya telefoni", "Tax ID (TIN)": "TIN y'umusoro", "Student ID": "Numero y'umunyeshuri", "Application number": "Numero y'ubusabe", "Providers and numbers are sample data. No real payment is made.": "Ibigo n'imibare ni ibitegererezo. Nta kwishyura nyakuri kuba.", "Confirm it's you": "Emeza ko ari wowe", "Confirm": "Emeza", "Balance now": "Amafaranga asigaye", "Token (sample)": "Token (icyitegererezo)", "Done": "Byarangiye", "Status": "Imiterere", "Completed": "Byarangiye", "Type": "Ubwoko", "When": "Igihe", "To": "Kuri", "From": "Biva kuri", "Reference": "Kode y'igikorwa", "Close": "Funga", "Copy details": "Kopera amakuru", "Sample data for this prototype.": "Amakuru y'ikitegererezo kuri iyi porogaramu.", "Activity": "Ibyakozwe", "Recent activity": "Ibyakozwe vuba", "See all": "Reba byose", "Nothing here yet.": "Nta kintu kiraza.", "All": "Byose", "Sent": "Yoherejwe", "Received": "Yakiriwe", "Paid": "Yishyuwe", "Paid this week": "Yishyuwe iki cyumweru", "Just now": "Ubu nyine", "Yesterday": "Ejo hashize", "Tuesday": "Kuwa kabiri", "Earlier": "Mbere"}, "fr": {"Pay bills": "Payer les factures", "Amount": "Montant", "Meter number": "Numéro de compteur", "Water meter number": "Numéro de compteur d'eau", "Phone number": "Numéro de téléphone", "Tax ID (TIN)": "Numéro fiscal (TIN)", "Student ID": "Numéro d'élève", "Application number": "Numéro de demande", "Providers and numbers are sample data. No real payment is made.": "Les fournisseurs et numéros sont des données d'exemple. Aucun paiement réel n'est effectué.", "Confirm it's you": "Confirmez que c'est vous", "Confirm": "Confirmer", "Balance now": "Solde actuel", "Token (sample)": "Jeton (exemple)", "Done": "Terminé", "Status": "Statut", "Completed": "Terminé", "Type": "Type", "When": "Quand", "To": "Vers", "From": "De", "Reference": "Référence", "Close": "Fermer", "Copy details": "Copier les détails", "Sample data for this prototype.": "Données d'exemple pour ce prototype.", "Activity": "Activité", "Recent activity": "Activité récente", "See all": "Tout voir", "Nothing here yet.": "Rien pour le moment.", "All": "Tout", "Sent": "Envoyé", "Received": "Reçu", "Paid": "Payé", "Paid this week": "Payé cette semaine", "Just now": "À l'instant", "Yesterday": "Hier", "Tuesday": "Mardi", "Earlier": "Plus tôt"}},R={"rw": [["Pay ([\\d,]+) RWF to ", "Ishyura RWF $1 kuri "], ["Pay ([\\d,]+) RWF", "Ishyura RWF $1"], ["(\\d+/\\d+) digits", "$1 imibare"], [" · saved from your last payment", " · yabitswe ukwishyura kwa nyuma"], ["From itunda Bank · ([\\d,]+) RWF available", "Biva kuri itunda Bank · RWF $1 ahari"], ["^Paid to ", "Wishyuriye "]], "fr": [["Pay ([\\d,]+) RWF to ", "Payer $1 RWF à "], ["Pay ([\\d,]+) RWF", "Payer $1 RWF"], ["(\\d+/\\d+) digits", "$1 chiffres"], [" · saved from your last payment", " · enregistré depuis votre dernier paiement"], ["From itunda Bank · ([\\d,]+) RWF available", "Depuis itunda Bank · $1 RWF disponibles"], ["^Paid to ", "Payé à "]]};
const trT=x=>{const l=S.lang;if(l!=='rw'&&l!=='fr')return x;const m=M[l];const w=x.trim();if(m[w])return x.replace(w,m[w]);let o=x;R[l].forEach(([a,b])=>{o=o.replace(new RegExp(a),b)});o=o.replace(/^(Paid|Received|Sent) · (.+)$/,(_,k,r)=>(m[k]||k)+' · '+r.split(' · ').map(z=>m[z]||z).join(' · '));return o};
window.tr26=h=>(S.lang==='rw'||S.lang==='fr')?h.replace(/>([^<>]+)</g,(a,x)=>'>'+trT(x)+'<'):h;
['bill','billdone','activity','home'].forEach(k=>{const f=screens[k];screens[k]=function(){return tr26(f.apply(this,arguments))}});
const ao=actOpen;actOpen=function(){ao.apply(this,arguments);const y=$('#layer');if(y&&y.innerHTML)y.innerHTML=tr26(y.innerHTML)};
const bp=billPay;billPay=function(){bp.apply(this,arguments);const y=$('#layer');y.innerHTML=tr26(y.innerHTML)};
const ac=actCopy;actCopy=function(){ac.apply(this,arguments);if(S.lang!=='en')toast(S.lang==='rw'?'Amakuru yakopewe':'Détails copiés')}}


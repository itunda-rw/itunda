ap:"Kanda %s RWF",tr_hist:"Amateka y'urugendo",tr_none:"Nta rugendo wakoze na rumwe — igihe uzakanda kwishyura urugendo, bizagaragara hano.",tr_disc:"Bisi nyazo za Kigali (Kigali Bus Services, Royal Express) zikoresha sisitemu nyayo yo kwishyura idakoresha amaboko (Tap&Go), yakozwe na AC Group. Itunda ntabwo ifite amasezerano na bo — iyi ni amafaranga y'ubwikorezi y'ikigereranyo ya itunda ubwayo: amafaranga nyayo agenda, amafaranga y'urugendo nyayo akurikizwa, gusa ntabwo anyuze mu gikoresho nyacyo cyo gusoma ikarita ya bisi.",tr_msg:"Wakanze %1 RWF kuri %2"},
fr:{rh:"Vers quel compte<br>devons-nous envoyer ?",rl:"Entrez un numéro de téléphone ou de compte",ta:"Compte",tf:"Amis",co:"Contacts",ad:"+ Ajouter",nx:"Suivant",sw:"Prudence avant ce virement",sb:"Ce destinataire a été signalé par 3 autre(s) utilisateur(s) itunda. Vérifiez bien avant d'envoyer.",rs:"Signaler ce numéro comme arnaque",aq:"Combien voulez-vous envoyer ?",ta2:"Vers le compte %s",mx:"Max",send:"Envoyer",am:"Ajouter de l'argent",md:"itunda Pay Money",pr:"Points · Pay Money",cr:"Vos coupons",rq:"Demander de l'argent",cs:"Retirer",from:"Depuis le portefeuille Itunda",avail:"Disponible RWF %s",insuff:"Solde insuffisant — vous avez RWF %s",an:"Vous n'avez pas encore d'autre compte itunda pour recharger.",cn:"Annuler",o_phone_h:"Quel est votre numéro de téléphone ?",o_phone_s:"Nous allons vérifier si vous avez déjà un compte.",o_phone_l:"Numéro de téléphone",o_lang:"Langue",o_del:"Supprimer le dernier chiffre",o_nf_h:"Aucun compte itunda trouvé",o_nf_b:"Nous n'avons trouvé aucun compte pour ce numéro. Créons-en un.",o_name_h:"Quel est votre nom ?",o_name_s:"C'est ainsi que vous apparaîtrez auprès de vos amis et des commerçants.",o_first:"Prénom",o_last:"Nom",o_terms_h:"Acceptez les conditions d'itunda",o_terms_s:"Veuillez les consulter et les accepter avant de créer votre compte.",o_all:"Tout accepter",o_req:"Obligatoire",o_pin_h:"Créez un code PIN à 6 chiffres",o_pin_s:"Vous utiliserez ce code PIN pour vous connecter la prochaine fois.",o_pin2_h:"Confirmez votre code PIN",o_mis:"Cela ne correspond pas. Réessayez.",o_ref:"Vous avez un code de parrainage ?",o_create:"Créer un compte",s_title:"Paramètres",s_myinfo:"Mes informations",s_auth:"Authentification et sécurité",s_bio:"Déverrouiller avec la biométrie",s_bio_b:"Exiger Face/Empreinte pour ouvrir Itunda",s_dev:"Vérifier cet appareil avec la biométrie",s_dev_b:"Évitez de retaper votre mot de passe pour la vérification renforcée",s_display:"Affichage",s_theme:"Thème",s_theme_b:"Suivre l'appareil, ou forcer clair/sombre",s_sys:"Système",s_light:"Clair",s_dark:"Sombre",s_text:"Taille du texte",s_lang:"Langue",s_tp:"Virement et paiement",s_pay:"Payer",s_legal:"Documents légaux",s_credit:"Politique d'utilisation des données de crédit",s_priv:"Politique de confidentialité",s_terms:"Conditions et consentement",s_devices:"Appareils",s_thisdev:" (cet appareil)",s_trusted:"Approuvé — peut envoyer de l'argent",s_remove:"Retirer",s_notif:"Notifications",s_manage:"Gérer les notifications",s_money:"Notifications d'argent",s_general:"Notifications générales",s_markall:"Tout marquer comme lu",s_logout:"Se déconnecter",c_title:"Carte",c_et:"Votre propre carte itunda, en quelques secondes",c_es:"Une vraie carte de débit pour votre solde itunda — sans paperasse, sans attente.",c_f1:"Aucuns frais annuels, jamais",c_f2:"Émise instantanément dans l'application — aucune visite en agence",c_f3:"Définissez vos propres limites de dépense quotidiennes et mensuelles",c_f4:"Blocage en un clic en cas de perte",c_fin:"Quelle finition préférez-vous ?",c_get:"Obtenez votre carte %s",c_mask:"carte itunda",c_act:"✓ Active",c_frz:"Bloquée",c_freeze:"Bloquer la carte",c_unfreeze:"Débloquer la carte",c_pin:"Modifier le code PIN de la carte",c_lost:"Signaler perdue ou volée",c_close:"Fermer la carte",c_lim:"Limites de dépense",c_dl:"Limite quotidienne",c_ml:"Limite mensuelle",c_td:"Aujourd'hui : %1 / %2 RWF",c_tm:"Ce mois-ci : %1 / %2 RWF",c_rec:"Activité récente de la carte",c_none:"Aucun achat par carte pour l'instant — dès que vous utiliserez votre carte, ils apparaîtront ici.",c_disc:"itunda n'a pas encore de partenariat avec un réseau de cartes réel, donc ceci simule un véritable achat par carte — de l'argent réel est transféré, les vraies limites s'appliquent.",tr_title:"Transport",tr_bal:"Solde itunda Transit",tr_top:"Recharger",tr_tapt:"Tapez pour payer votre tarif",tr_tapd:"Choisissez votre opérateur et votre tarif réels — les vrais tarifs de Kigali vont de 200 à 500 RWF selon la distance ; itunda n'a pas de distance dérivée du GPS pour en calculer un automatiquement.",tr_low:"Solde insuffisant",tr_tap:"Payer %s RWF",tr_hist:"Historique des trajets",tr_none:"Aucun trajet pour l'instant — dès que vous paierez un tarif, il apparaîtra ici.",tr_disc:"Les vrais bus publics de Kigali (Kigali Bus Services, Royal Express) fonctionnent avec un vrai système de paiement sans contact appelé Tap&Go, construit par AC Group. itunda n'a pas de partenariat réel avec eux — ceci est le propre solde de transport simulé d'itunda : de l'argent réel est transféré, les vrais tarifs s'appliquent, il n'est simplement pas traité par un vrai lecteur de carte de bus.",tr_msg:"Tarif de %1 RWF payé chez %2"}};
const t=k=>(L[S.lang]&&L[S.lang][k])||L.en[k];
const amtMsg=bad=>bad?t('insuff').replace('%s',fmt(S.bank)):t('from')+' · '+t('avail').replace('%s',fmt(S.bank));
const PRODS=[{n:'Mountain coffee, 500 g',m:'Kigali Coffee Co-op',p:6500,o:8000,g:'harvest',s:12,c:'Food'},{n:'Umuganda tee, cotton',m:'Kigali Designers',p:9000,o:10500,g:'bag',s:5,c:'Fashion'},{n:'Agaseke basket, small',m:'Gisenyi Weavers',p:12000,o:0,g:'community',s:8,c:'Home'},{n:'Phone case, universal',m:'Nyabugogo Tech',p:3500,o:0,g:'airtime',s:30,c:'Electronics'},{n:'Honey, 250 g',m:'Musanze Apiary',p:4200,o:4700,g:'gift',s:3,c:'Food'},{n:'Kitenge fabric, 2 m',m:'Kimironko Market',p:15000,o:0,g:'voucher',s:9,c:'Fashion'},{n:'Wireless earphones',m:'Nyabugogo Tech',p:18500,o:25000,g:'celebrate',s:4,c:'Electronics'},{n:'Cooking oil, 3 L',m:'Remera Grocers',p:7800,o:0,g:'money',s:40,c:'Food'}];
const CATS=['All','Food','Fashion','Electronics','Home'];
const BANNERS=[{bg:'var(--br)',fg:'#17171C',t:'Mountain coffee, 500 g',p:6500,o:8000,g:'harvest'},{bg:'#BFEAD7',fg:'#0B3B2A',t:'Wireless earphones',p:18500,o:25000,g:'celebrate'},{bg:'#FFE2A8',fg:'#3D2A00',t:'Honey, 250 g',p:4200,o:4700,g:'gift'}];
const END=Date.now()+(23*3600+24*60+20)*1000;
const hms=()=>{let s=Math.max(0,Math.floor((END-Date.now())/1000));const z=n=>String(n).padStart(2,'0');return z(Math.floor(s/3600))+':'+z(Math.floor(s%3600/60))+':'+z(s%60)};
const pct=(p,o)=>o?Math.round(100-(p/o*100)):0;
const heart=on=>`<svg width="22" height="22" viewBox="0 0 24 24" fill="${on?'var(--er)':'none'}" stroke="${on?'var(--er)':'var(--tt)'}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="${P.heart}"/></svg>`;
const scCount=()=>Object.values(S.scart).reduce((a,b)=>a+b,0);
const scTotal=()=>Object.entries(S.scart).reduce((a,[i,q])=>a+q*PRODS[i].p,0);
const pcard=(x,i)=>{const d=pct(x.p,x.o);return `<div class="pc tap" onclick="openProd(${i})"><div class="pim">${gl(x.g,64)}<button class="hrt" id="h${i}" aria-label="Save ${x.n}" onclick="event.stopPropagation();tgFav(${i})">${heart(S.fav[i])}</button>${d?`<span class="dbadge">${d}% off</span>`:''}</div><div class="pn">${x.n}</div><div class="pm">${x.m}</div><div class="pp">${d?`<b style="color:var(--er)">${d}%</b> `:''}<b>${fmt(x.p)} RWF</b></div>${x.o?`<div class="po">${fmt(x.o)} RWF</div>`:''}<div class="pc2">Earn ${fmt(Math.round(x.p*0.01))} RWF back</div>${x.s<=5?`<div class="ps">${x.s} left</div>`:''}</div>`};
const prodGrid=()=>PRODS.map((x,i)=>[x,i]).filter(([x])=>S.cat==='All'||x.c===S.cat).map(([x,i])=>pcard(x,i)).join('');
const chipsHtml=()=>CATS.map(c=>`<button class="cch ${S.cat===c?'on':''}" onclick="setCat('${c}')">${c}</button>`).join('');
const MIS=[['Daily check-in','+50 RWF','celebrate'],['Spin the wheel','up to 500 RWF','money'],['Share a deal','+100 RWF','gift']];
const misHtml=()=>MIS.map(([l,r,g],k)=>`<button class="mis tap" ${S.claimed[k]?'disabled':''} onclick="claim(${k})">${gl(g,40)}<span>${l}</span><b>${S.claimed[k]?'Claimed':r}</b></button>`).join('');
const REST=[{n:'Kigali Bakery',cat:'Bread',r:4.8,rc:320,d:1.2,t:'15-25',tm:20,fee:0,min:2000,tag:'Free delivery',bg:'#FFE8C7',g:'bread',items:[['Croissant','Buttery, baked this morning',1200,'bread'],['Mandazi, 6 pieces','Sweet fried dough',1000,'mandazi'],['Fresh bread loaf','',1500,'bread'],['Fruit juice','Passion or mango',1800,'juice']]},{n:'Nyamirambo Grill',cat:'Brochette',r:4.7,rc:512,d:2.4,t:'25-35',tm:30,fee:1500,min:5000,tag:'Popular',bg:'#FFE1D6',g:'brochette',items:[['Goat brochette','Grilled with salt and onion',2500,'brochette'],['Chips','Crispy, large',1500,'chips'],['Fried plantain','',1200,'chips'],['Soda','',800,'juice']]},{n:'Mama Rice House',cat:'Rice',r:4.6,rc:208,d:3.1,t:'30-40',tm:35,fee:1500,min:4000,tag:'',bg:'#E6F4DC',g:'rice',items:[['Rice and beans','',2200,'rice'],['Isombe with rice','Cassava leaves',2800,'rice'],['Chapati','',700,'bread']]},{n:'Kimironko Coffee',cat:'Coffee',r:4.9,rc:144,d:0.8,t:'10-20',tm:15,fee:500,min:2000,tag:'New',bg:'#E7DDF7',g:'coffee',items:[['Rwandan coffee','Single origin',1500,'coffee'],['Cappuccino','',2000,'coffee'],['Banana bread','',1800,'bread']]}];
const ECATS=[['All','rice'],['Brochette','brochette'],['Chips','chips'],['Bread','bread'],['Coffee','coffee'],['Juice','juice']];
const ESORT=[['fast','Fastest'],['rating','Top rated'],['free','Free delivery'],['near','Nearest']];
const eList=()=>REST.map((r,i)=>[r,i]).filter(([r])=>S.ecat==='All'||r.cat===S.ecat||r.items.some(it=>it[3]===S.ecat.toLowerCase())).filter(([r])=>S.esort!=='free'||r.fee===0).sort((a,b)=>S.esort==='rating'?b[0].r-a[0].r:S.esort==='near'?a[0].d-b[0].d:a[0].tm-b[0].tm);
const eCards=()=>{const l=eList();return l.length?l.map(([r,i])=>`<div class="rcard tap" onclick="openERest(${i})"><div class="rimg" style="background:${r.bg}">${gl(r.g,92)}${r.tag?`<span class="rtag">${r.tag}</span>`:''}</div><div style="display:flex;justify-content:space-between;align-items:baseline;margin-top:12px"><b style="font-size:17px;letter-spacing:-.3px">${r.n}</b><span class="sm" style="font-weight:800">★ ${r.r}</span></div><div class="sm mu" style="margin-top:2px">${r.t} min · ${r.d} km · ${r.rc} reviews</div><div class="sm" style="margin-top:4px;font-weight:700;color:${r.fee?'var(--mu)':'var(--lk)'}">${r.fee?'Delivery '+fmt(r.fee)+' RWF':'Free delivery'} · Min ${fmt(r.min)} RWF</div></div>`).join(''):`<div class="pad mu" style="padding:30px 24px;text-align:center">No restaurants match. Try another category or filter.</div>`};
const eCatsHtml=()=>ECATS.map(([c,g])=>`<button class="ecat ${S.ecat===c?'on':''}" onclick="setECat('${c}')"><i>${gl(g,40)}</i>${c}</button>`).join('');
const eSortHtml=()=>ESORT.map(([k,l])=>`<button class="cch ${S.esort===k?'on':''}" onclick="setESort('${k}')">${l}</button>`).join('');
const eCount=()=>Object.values(S.ecart).reduce((a,b)=>a+b,0);
const eSub=()=>Object.entries(S.ecart).reduce((a,[k,q])=>a+q*REST[S.er].items[k][2],0);
const eFee=()=>S.pickup?0:REST[S.er].fee;
const ESTEPS=()=>S.pickup?['Order accepted','Preparing','Ready for pickup','Picked up']:['Order accepted','Preparing','On the way','Delivered'];
const ASEC=[['Everyday',[['bag','Shop','Products from every merchant',"openShop('shop')"],['restaurant','Eats','Order food or deliver',"openShop('eats')"]]],
['Your neighbourhood',[['market','Marketplace','Buy and sell near you',"openHood('market')"],['chat','Community','Local questions and posts',"openCommunity()"],['briefcase','Jobs','Neighbourhood gigs and part-time work',"openHood('jobs')"],['house','Property','Rentals and sales near you',"openHood('property')"],['market','Places','Find a place, eat here, reserve, pay',"openPlaces()"]]],
['Money tools',[['gift','Benefits','Points, coupons, rewards',"openBenefits()"],['chart','Invest','RSE stocks, real portfolio',"openInvest()"],['money','26-Week Savings','Escalating auto-save, streak bonus','open26()'],['money','31-Day Savings','Daily streak, tiered bonus rate','open31()']]],
['Accounts & cards',[['bank','Open account','itunda Account, other banks, RSE brokerage','openBank()'],['money','My assets','Accounts, loans, RSE holdings, cards, points','openBank()'],['wallet','Card','App-controlled spend limits, one-tap freeze','openCard()'],['busstop','Transit','Top up and tap to pay your Kigali bus fare','openTransit()'],['chart','Spending','Category breakdown from your ledger','openSpend()'],['community','Group account','Shared account with dues and split expenses'],['community','Family','Link a guardian or child, view read-only spending'],['globe','Foreign currency','Hold and convert USD, EUR, GBP'],['clock','Subscriptions','Recurring payments and billing plans'],['verify','Digital certificate','Sign agreements in itunda']]],
['Send & pay',[['send','Transfer','Auto-transfer, split a bill','flow()'],['receipt','Request money','Generate a payment request code','reqSheet()'],['settle','Auto top-up','Refill your account from a linked account'],['airtime','Mobile plan','MTN, Airtel, broadband']]],
['Save & grow',[['money','12-month deposit','Interest paid upfront, principal locked'],['community','Youth account','Capped starter account, ages 7-18'],['community','Ikimina','Rotating savings group, everyone takes a turn'],['bank','SACCO shares','Buy cooperative shares, earn a real dividend']]],
['Borrow',[['money','Get a loan','Personal, salary-backed, SME working capital'],['verify','Credit score','Free check, alternative data'],['harvest','Harvest advance','Coffee cooperative input financing'],['lock','VUP Financial Services','Means-tested government microloan'],['school','Student loan','BRD higher-education loan: 11% undergraduate, 12% postgraduate'],['bike','Moto-Taxi Ownership','Save a 30% down payment, then convert to a loan']]],
['Transport',[['moto','Rides','Request a ride or drive for real fares'],['bike','Bike rental','Rent a nearby bike or scooter by the minute'],['busstop','Bus','Book intercity bus seats'],['moto','Directions','Plan trips by bus, car, walk or bike',"openDirections()"]]],
['Support',[['chat','Live chat',"","supportChat()"],['airtime','Call support'],['warning3d','Report an issue with a transaction','',"reportSheet()"],['bell','Announcements','',"notifSheet()"],['airtime','USSD access','Basic banking on any phone']]]];
const AOPEN=[['Youth','community'],['Games','celebrate'],['Bank','bank','openBank()'],['Pick','flame']];
const ASHORT=[['Open account','bank','openBank()'],['Verify','verify'],['Send','send','flow()'],['Places','market',"openPlaces()"],['Property','house',"openHood('property')"],['Insurance','lock']];
const XS={'Places':'Discover · Reserve · Pay','Directions':'Bus · Car · Walk · Bike','Shop':'Products · Deals','Eats':'Food · Delivery','Map':'Live map · Layers','Marketplace':'Buy · Sell','Community':'Posts · Q&A','Jobs':'Gigs · Part-time','Property':'Rent · Buy','Benefits':'Points · Coupons','Invest':'RSE · Stocks','26-Week Savings':'Auto-save','31-Day Savings':'Daily streak','Open account':'itunda · Other banks','My assets':'Accounts · Loans · Cards','Card':'Limits · Freeze','Transit':'Bus fare','Spending':'By category','Group account':'Dues · Split','Family':'Guardian · Child','Foreign currency':'USD · EUR · GBP','Subscriptions':'Recurring','Digital certificate':'Sign','Transfer':'Auto · Split','Request money':'Payment code','Auto top-up':'Refill','Mobile plan':'MTN · Airtel','12-month deposit':'Interest upfront','Youth account':'Ages 7-18','Ikimina':'Group savings','SACCO shares':'Dividends','Get a loan':'Personal · SME','Credit score':'Free check','Harvest advance':'Coffee co-op','VUP Financial Services':'Microloan','Student loan':'BRD','Moto-Taxi Ownership':'Down payment','Rides':'Ride · Drive','Bike rental':'Bikes · Scooters','Bus':'Intercity seats','USSD access':'Any phone'};
const aRow=([g,t,s,on],gi,ri)=>`<div class="ar tap" role="button" tabindex="0" onclick="rsAdd(${gi},${ri});${on||'soon()'}"><div class="g">${gl(g,26)}</div><div class="t">${t}</div><div class="s">${S.lang==='en'?(XS[t]||''):(s||'')}</div></div>`;
const aGrid=(t,a)=>`<div class="agt" style="padding-bottom:12px">${t}</div><div class="ag">${a.map(([l,g,on])=>`<div class="gi tap" onclick="${on||"soon()"}"><div class="ico">${gl(g,38)}</div>${l}</div>`).join('')}</div>`;
const rsList=()=>(S.rs||[]).map(k=>{const[gi,ri]=k.split(':').map(Number),x=ASEC[gi]&&ASEC[gi][1][ri];return x?[gi,ri,x]:null}).filter(Boolean);
const allBody=q=>{q=(q||'').trim().toLowerCase();
if(!q){const rs=rsList();return (rs.length?`<div class="xc"><div class="xt">Recent services</div><div class="xr">${rs.map(([gi,ri,x])=>`<div class="gi tap" onclick="rsAdd(${gi},${ri});${x[3]||'soon()'}"><div class="ico">${gl(x[0],34)}</div>${x[1]}</div>`).join('')}</div></div>`:'')+ASEC.map(([t,r],gi)=>`<div class="xc xg" role="group" aria-label="${t}">${r.map((x,ri)=>aRow(x,gi,ri)).join('')}</div>`).join('')}
const m=ASEC.map(([t,r],gi)=>[t,r.map((x,ri)=>[x,ri]).filter(([x])=>x[1].toLowerCase().includes(q)),gi]).filter(([t,r])=>r.length);
return m.length?m.map(([t,r,gi])=>`<div class="xc xg" role="group" aria-label="${t}">${r.map(([x,ri])=>aRow(x,gi,ri)).join('')}</div>`).join(''):`<div class="pad mu" style="padding-top:28px;font-size:14px">No match for "${q.replace(/[<>&"]/g,'')}".</div>`};
function rsAdd(gi,ri){const k=gi+':'+ri;S.rs=[k,...(S.rs||[]).filter(x=>x!==k)].slice(0,4)}
function allSearch(v){S.aq=v;$('#abody').innerHTML=allBody(v)}
const unread=()=>THREADS.reduce((a,t)=>a+(S.read[t.id]?0:t.u),0);
const THREADS=[{id:'amina',n:'Amina K.',g:'community',t:'2 min',u:1,sub:'itunda · 078 ••• 214',m:[['them','Hi! Thanks for lunch'],['money',25000],['them','See you on Friday']]},{id:'ikimina',n:'Umurenge Savers',g:'community',t:'1 h',u:0,sub:'Ikimina group · 8 members',m:[['them','Next turn is Eric M. on the 1st'],['them','Contributions are due on Friday']]},{id:'bakery',n:'Kigali Bakery',g:'bread',t:'Today',u:0,sub:'Your order',m:[['them','Your order is on the way']]},{id:'support',n:'itunda support',g:'bell',t:'Yesterday',u:0,sub:'Help',m:[['them','Your report was reviewed. Thank you.']]}];
S.msgs={};THREADS.forEach(t=>S.msgs[t.id]=t.m.map(x=>x.slice()));
const thr=()=>THREADS.find(t=>t.id===S.chat);
const prev=m=>{const x=m[m.length-1];if(!x)return 'No messages yet';return x[0]==='money'?'Sent '+fmt(x[1])+' RWF':x[0]==='gift'?'Gift voucher':x[0]==='split'?'Split a bill':x[1]};
const bubble=(x,i)=>{const [k,v,e]=x;const R=c=>`<div style="display:flex;justify-content:flex-end;padding:4px 0">${c}</div>`;
 if(k==='me')return R(`<div style="max-width:78%;background:var(--br);color:var(--on);padding:10px 14px;border-radius:18px 18px 4px 18px;font-size:15px;line-height:21px">${v}</div>`);
 if(k==='them')return `<div style="display:flex;padding:4px 0"><div style="max-width:78%;background:var(--chip);padding:10px 14px;border-radius:18px 18px 18px 4px;font-size:15px;line-height:21px">${v}</div></div>`;
 if(k==='money')return R(`<div style="width:230px;border-radius:20px;background:var(--chip);padding:14px 16px;display:flex;align-items:center;gap:12px">${gl('send',38)}<div><div style="font-weight:800;font-size:17px">${fmt(v)} RWF</div><div class="sm mu">Sent</div></div></div>`);
 if(k==='gift')return R(`<div style="width:230px;border-radius:20px;background:var(--chip);padding:14px 16px;display:flex;align-items:center;gap:12px">${gl('gift',40)}<div><div style="font-weight:800;font-size:16px">Gift voucher</div><div class="sm mu">${fmt(v)} RWF</div></div></div>`);
 const share=Math.round(v/2);return R(`<div style="width:250px;border-radius:20px;background:var(--chip);padding:14px 16px"><div style="display:flex;align-items:center;gap:12px">${gl('settle',38)}<div><div style="font-weight:800;font-size:16px">Split a bill</div><div class="sm mu">Total ${fmt(v)} RWF · 2 people</div></div></div><button class="btn" style="height:44px;font-size:15px;margin-top:12px;border-radius:14px" ${e?'disabled':''} onclick="paySplit(${i})">${e?'Paid':'Pay my share ('+fmt(share)+' RWF)'}</button></div>`)};
const fmtPh=p=>'+250 '+[p.slice(0,3),p.slice(3,6),p.slice(6,9)].filter(Boolean).join(' ');
const obbar=()=>`<div class="bar"><button class="ib" aria-label="Back" onclick="obBack()">${ic('back',24)}</button></div>`;
const obpad=(id,len,txt)=>`<div class="keys" style="position:absolute;left:0;right:0;bottom:${txt?104:24}px">${['1','2','3','4','5','6','7','8','9','','0','del'].map(k=>`<button ${k?`onclick="obKey('${k}')"`:'disabled'} aria-label="${k==='del'?t('o_del'):k}">${k==='del'?'<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6H9l-5 6 5 6h11zM12 10l4 4M16 10l-4 4"/></svg>':k}</button>`).join('')}</div>`;
const pinDots=v=>`<div class="dots6" id="pd">${[0,1,2,3,4,5].map(i=>`<i class="${i<v.length?'on':''}"></i>`).join('')}</div>`;
const FIN={Indigo:{bg:'var(--br)',fg:'#17171C'},Midnight:{bg:'#202027',fg:'#F9FAFB'},Sand:{bg:'#E9D9B8',fg:'#2B2418'}};
const cardVis=(c,pre)=>{const f=FIN[S.finish];return `<div id="cv" class="cv ${c.frozen?'frozen':''}" style="margin:24px 24px 0;height:200px;border-radius:28px;background:${f.bg};color:${f.fg};padding:22px;position:relative;box-shadow:none"><div style="display:flex;justify-content:space-between;align-items:flex-start">${knot(52,f.fg)}<b style="font-size:15px">Bank</b></div><div style="position:absolute;left:22px;bottom:22px"><div style="font-size:13px;font-weight:700;opacity:.8">${t('c_mask')}</div><div style="font-size:20px;font-weight:800;letter-spacing:2px;margin-top:2px">•••• ${c.last}</div></div>${pre?'':`<div id="cst" style="position:absolute;right:22px;bottom:24px;font-size:13px;font-weight:800;background:rgba(127,127,127,.22);padding:6px 12px;border-radius:14px">${c.frozen?t('c_frz'):t('c_act')}</div>`}<div class="lk">${gl('lock',64)}</div></div>`};
const toast=m=>{document.querySelectorAll('#phone .toast').forEach(x=>x.remove());const t=document.createElement('div');t.className='toast';t.textContent=window.__ux?window.__ux(m):m;t.onclick=()=>t.remove();$('#phone').appendChild(t);setTimeout(()=>t.remove(),Math.min(4500,Math.max(2400,1500+m.length*45)))};
const row=(i,t,s,r,on)=>`<div class="row tap" onclick="${on||"soon()"}"><div class="ico">${gx(i,30)}</div><div><div class="t">${t}</div>${s?`<div class="s">${s}</div>`:''}</div><div class="r">${r||''}${ic('chev',16,'var(--tt)')}</div></div>`;
const gi=(i,l,on)=>`<div class="gi tap" onclick="${on||"soon()"}"><div class="ico">${gx(i,38)}</div>${l}</div>`;
const tabbar=()=>`<nav class="tabs">${[['home','Home','home'],['pay','Pay','qr'],['explore','Explore','compass'],['messages','Messages','msg'],['you','You','user']].map(([k,l,i])=>`<button class="${S.tab===k?'on':''}" onclick="tab('${k}')" style="position:relative">${ic(i,24)}${k==='messages'&&unread()?`<span aria-label="${unread()} unread" style="position:absolute;top:10px;left:calc(50% + 6px);min-width:16px;height:16px;border-radius:8px;background:#D92D20;color:#fff;font-size:10px;font-weight:800;display:flex;align-items:center;justify-content:center;padding:0 4px">${unread()}</span>`:''}${l}</button>`).join('')}</nav>`;
const bar=t=>`<div class="bar"><button class="ib" aria-label="Back" onclick="back()">${ic('back',24)}</button><b>${t}</b></div>`;
const topbar=(l,r)=>`<div class="top">${l}<div style="display:flex;gap:4px"><button class="ib" aria-label="Notifications" onclick="notifSheet()" style="position:relative">${ic('bell',24)}${S.nread?'':'<i style="position:absolute;top:10px;right:11px;width:8px;height:8px;border-radius:4px;background:#D92D20"></i>'}</button>${r||''}</div></div>`;
const screens={
home:()=>`${topbar(`<div style="display:flex;align-items:center;gap:8px">${knot(40)}<b style="font-size:20px;letter-spacing:-.5px">itunda</b></div>`,`<button class="ib" aria-label="Profile" onclick="tab('you')">${ic('user',24)}</button>`)}
<div class="pad" style="padding-top:12px;display:flex;align-items:center;gap:8px"><div class="dot"></div><span class="sm mu">MTN MoMo and Airtel Money are working normally</span></div>
<div class="pad" style="padding-top:28px"><div class="tap" onclick="openBank()" style="cursor:pointer"><div class="sm mu">itunda Bank</div><div class="big" style="margin-top:4px"><span id="bal">${fmt(S.bank)}</span> <span class="cu">RWF</span></div></div>
<div class="row tap" style="padding-top:14px" onclick="tab('pay')"><span class="mu" style="font-size:15px">itunda Pay</span><div class="r"><span style="color:var(--tx);font-weight:800;font-size:15px">${fmt(S.pay)} RWF</span>${ic('chev',16,'var(--tt)')}</div></div></div>
<div class="pad row2" style="padding-top:20px"><button class="btn" onclick="flow()">${t('send')}</button><button class="btn sec2" onclick="tab('pay')">${t('am')}</button></div>
<div class="sec"><div class="sech">Quick actions</div><div class="grid g4">${gi('send',t('send'),'flow()')}${gi('qr','Scan to pay',"tab('pay')")}${gi('bill','Pay bills',"openBill('REG electricity')")}${gi('phone','Airtime',"openBill('MTN airtime')")}</div></div>
<div class="sec"><div class="sech">Rwanda services</div><div class="grid g5">${gi('home','Irembo',"openBill('Irembo')")}${gi('bill','RRA taxes',"openBill('RRA taxes')")}${gi('bolt','REG electricity',"openBill('REG electricity')")}${gi('drop','WASAC water',"openBill('WASAC water')")}${gi('school','School fees',"openBill('School fees')")}</div></div>
<div class="sec"><div class="sech">Spending</div>${row('coin','312,000 RWF','Spent this period, mostly on food','','openSpend()')}${S.regPaid?row('bill','REG electricity','Paid this week','Paid','void 0'):row('bill','REG electricity','Upcoming, due Friday','18,500 RWF',"openBill('REG electricity',18500)")}</div>
<div class="sec"><div class="sech">For you</div>${row('coin',S.goal?S.goal.n:'Start your first savings goal',S.goal?fmt(S.goal.s)+' of '+fmt(S.goal.t)+' RWF saved':'A target and a date make saving easier','','openGoal()')}${row('trend','My credit score','Free check, alternative data','View')}</div>`,
benefits:()=>`${bar('Benefits')}<div class="pad" style="padding-top:28px"><div style="display:flex;align-items:center;gap:10px"><div class="sm mu">Rewards earned</div>${gl('celebrate',30)}</div><div class="big" style="margin-top:4px">6,400 RWF</div></div><div class="sec"><div class="sech">Earn more</div>${row('users','Invite a friend','Share a link, you both get a reward')}${row('bolt','Daily challenge','A small task for a small reward','Today')}${row('card','Card cashback','On every itunda card purchase')}</div><div class="sec"><div class="sech">Offers for you</div>${row('food','Kigali Bakery','5% back when you pay with QR')}${row('bus','Kigali bus fares','Points on every tap')}</div><div class="pad sm mu" style="padding-top:28px">Offers are sample data.</div>`,
shop:()=>{const eats=S.shopTab==='eats';const cartBtn=`<button class="ib" aria-label="Cart" onclick="openCart()" style="position:relative">${ic('bag',24)}${scCount()?`<span style="position:absolute;top:6px;right:4px;min-width:18px;height:18px;border-radius:9px;background:#D92D20;color:#fff;font-size:11px;font-weight:800;display:flex;align-items:center;justify-content:center;padding:0 4px">${scCount()}</span>`:''}</button>`;
const head=`<div class="top" style="padding:12px 24px 0 8px"><button class="ib" aria-label="Back" onclick="back()">${ic('back',24)}</button><div style="flex:1;height:44px;border-radius:14px;background:var(--chip);display:flex;align-items:center;gap:10px;padding:0 14px;color:var(--mu);font-size:15px;margin-right:4px">${ic('search',20)}${eats?'Search restaurants':'Search products'}</div>${cartBtn}</div><div class="seg"><button class="${eats?'':'on'}" onclick="setShopTab('shop')">Shop</button><button class="${eats?'on':''}" onclick="setShopTab('eats')">Eats</button></div>`;
if(eats)return head+`${S.addrOk?'':'<div class="bub"><span>Is your delivery address right? Kimironko, KG 11 Ave</span><button onclick="addrYes()">Yes</button></div>'}<div class="pad" style="padding-top:16px;display:flex;align-items:center;gap:6px;font-weight:800;font-size:17px">${ic('home',18)}Kimironko, Kigali${ic('chev',16,'var(--tt)')}</div><div class="chips" style="padding-top:18px;gap:6px" id="ecats">${eCatsHtml()}</div><div class="pad" style="padding-top:18px"><div style="border-radius:20px;background:var(--tint);padding:16px 18px;display:flex;align-items:center;justify-content:space-between"><div><div style="font-weight:800;font-size:16px">Free delivery on your first order</div><div class="sm mu" style="margin-top:2px">Sample offer for this prototype</div></div>${gl('gift',44)}</div></div><div class="chips" style="padding-top:20px" id="esort">${eSortHtml()}</div><div style="padding-top:18px" id="elist">${eCards()}</div>`;
const rv=S.rv.length?`<div class="sec" style="padding-bottom:0"><div class="sech">Recently viewed</div><div style="display:flex;gap:12px;overflow-x:auto;scrollbar-width:none;margin:0 -24px;padding:0 24px">${S.rv.map(i=>`<div class="tap" style="flex:0 0 96px;cursor:pointer" onclick="openProd(${i})"><div class="pim" style="border-radius:16px">${gl(PRODS[i].g,48)}</div><div style="font-size:12px;font-weight:700;margin-top:6px;line-height:16px">${PRODS[i].n}</div></div>`).join('')}</div></div>`:'';
return head+`<div style="padding-top:16px"><div class="snap" id="bn" onscroll="bnScroll(this)">${BANNERS.map(b=>`<div><div class="bn" style="background:${b.bg};color:${b.fg}"><div><div style="font-size:13px;font-weight:800">⏰ <span class="cd">${hms()}</span> Limited time offer</div><div style="font-size:20px;font-weight:800;letter-spacing:-.4px;margin-top:8px;line-height:26px;max-width:170px">${b.t}</div><div style="margin-top:8px;font-size:14px;font-weight:800">${pct(b.p,b.o)}% off · ${fmt(b.p)} RWF</div></div>${gl(b.g,92)}</div></div>`).join('')}</div><div class="dots" id="dots"><i class="on"></i><i></i><i></i></div></div>
<div class="sec" style="padding-top:24px"><div class="sech">Earn RWF<a>Sample rewards</a></div><div class="misrow" id="mis">${misHtml()}</div></div>
${rv}<div class="sec" style="padding-bottom:12px"><div class="sech">Recommended for you</div></div><div class="chips" id="cats">${chipsHtml()}</div><div class="pgrid" id="pgrid" style="padding-top:18px">${prodGrid()}</div><div class="pad fine" style="padding-top:24px">Products, prices and merchants are sample data.</div>${scCount()?`<div class="fab"><button class="btn" onclick="openCart()">View cart · ${scCount()} · ${fmt(scTotal())} RWF</button></div>`:''}`},
pay:()=>`${topbar('<b style="font-size:22px">Pay</b>')}<div class="pad" style="padding-top:24px;display:flex;align-items:center;justify-content:space-between"><div><div style="font-size:18px;font-weight:800">My payment code</div><div class="mu" style="font-size:14px;margin-top:4px;max-width:190px;line-height:20px">Show this code at the till to pay.</div></div><div style="width:104px;height:104px;border-radius:20px;background:var(--chip);display:flex;align-items:center;justify-content:center">${gl('qr3d',84)}</div></div><div class="pad" style="padding-top:36px"><div class="sm mu">${t('md')}</div><div class="big" style="margin-top:4px">${fmt(S.pay)} RWF</div></div><div class="pad row2" style="padding-top:16px"><button class="btn" onclick="flow()">${t('send')}</button><button class="btn sec2" onclick="sheetAdd()">${t('am')}</button></div><div class="sec"><div class="sech">More</div>${row('star',t('pr'),'','6,400')}${row('gift',t('cr'),'','0')}${row('recv',t('rq'),'','','reqSheet()')}${row('cash',t('cs'))}${row('card','itunda card','Debit card for your itunda Bank account','','openCard()')}</div>`,
explore:()=>`<div class="xp"><div class="xh"><b class="xn">${(S.name||'Amina Uwase')}</b><div class="xl"><button onclick="soon()">Support</button><i></i><button onclick="openSettings()">Settings</button></div></div><label class="asr xs">${ic('search',20)}<input id="sq" placeholder="Search" value="${(S.aq||'').replace(/"/g,'')}" oninput="allSearch(this.value)" aria-label="Search"></label><div class="xpills">${[['Bank','bank','openBank()'],['Mini apps','community'],['Games','celebrate'],['Verify','verify']].map(([l,g,on])=>`<button class="tap" onclick="${on||'soon()'}">${gl(g,24)}${l}</button>`).join('')}</div><div id="abody">${allBody(S.aq)}</div></div>`,
rest:()=>{const r=MENU[S.rest];return `${bar(r.n)}<div class="pad" style="padding-top:12px"><div class="mu" style="font-size:14px">${r.eta} · ${fmt(r.fee)} RWF delivery</div></div><div class="sec" style="padding-top:20px"><div class="sech">Menu</div>${r.items.map(([n,p],i)=>`<div class="row" style="cursor:default"><div><div class="t">${n}</div><div class="s">${fmt(p)} RWF</div></div><div class="r" style="gap:10px;color:var(--tx)"><button class="ib" style="width:36px;height:36px;border-radius:18px;background:var(--chip)" aria-label="Remove one ${n}" onclick="cartAdd(${i},-1)">${ic('minus',18)}</button><b id="q${i}" style="min-width:16px;text-align:center">${S.cart[i]||0}</b><button class="ib" style="width:36px;height:36px;border-radius:18px;background:var(--chip)" aria-label="Add one ${n}" onclick="cartAdd(${i},1)">${ic('plus',18)}</button></div></div>`).join('')}</div><div class="pad fine" style="padding-top:20px">Menu and prices are sample data.</div><div class="cta"><button id="cartbtn" class="btn" ${cartCount()?'':'disabled'} onclick="checkout()">${cartLabel()}</button></div>`},
checkout:()=>{const r=MENU[S.rest];const lines=Object.entries(S.cart).filter(([i,q])=>q>0).map(([i,q])=>{const [n,p]=r.items[i];return `<div style="display:flex;justify-content:space-between;height:44px;align-items:center;font-size:15px"><span>${q} × ${n}</span><b>${fmt(q*p)} RWF</b></div>`}).join('');const tot=cartTotal()+r.fee,bad=tot>S.pay;return `${bar('Checkout')}<div class="pad" style="padding-top:20px"><div class="h1" style="font-size:24px">${r.n}</div><div class="mu" style="margin-top:6px">Arrives in ${r.eta}</div></div><div class="pad" style="padding-top:16px">${lines}<div style="display:flex;justify-content:space-between;height:44px;align-items:center;font-size:15px;border-top:0"><span class="mu">Delivery</span><b>${fmt(r.fee)} RWF</b></div></div><div class="pad" style="padding-top:20px"><div style="display:flex;justify-content:space-between;align-items:baseline"><span style="font-size:18px;font-weight:800">Total</span><span style="font-size:28px;font-weight:800;letter-spacing:-.5px">${fmt(tot)} RWF</span></div><div style="margin-top:16px;display:flex;justify-content:space-between;font-size:14px"><span class="mu">Pay from</span><b>itunda Pay · ${fmt(S.pay)} RWF</b></div>${bad?`<div style="color:var(--er);font-size:14px;margin-top:10px">Not enough balance — you have RWF ${fmt(S.pay)}</div>`:''}</div><div class="cta"><button class="btn" ${bad?'disabled':''} onclick="payOrder()">Pay ${fmt(tot)} RWF</button></div>`},
ordered:()=>{const r=MENU[S.rest];return `<div style="display:flex;flex-direction:column;align-items:center;padding-top:clamp(28px,12vh,200px)"><div class="g3">${gl('delivered3d',132)}</div><div class="h1" style="margin-top:28px">Order placed</div><div class="mu" style="font-size:16px;margin-top:8px">${S.oN||r.n} · arrives in ${S.oE||r.eta}</div></div><div style="margin:44px 24px 0;padding:4px 20px;border-radius:20px;background:var(--chip)"><div style="display:flex;justify-content:space-between;height:52px;align-items:center;font-size:15px"><span class="mu">Paid with itunda Pay</span><b>${fmt(S.orderTot)} RWF</b></div><div style="display:flex;justify-content:space-between;height:52px;align-items:center;font-size:15px;border-top:0"><span class="mu">itunda Pay balance</span><b>${fmt(S.pay)} RWF</b></div></div><div class="cta" style="border:0"><button class="btn" onclick="done()">Done</button></div>`},
obPhone:()=>`<div class="ahead" style="justify-content:flex-end"><button class="chip" onclick="langSheet()" aria-label="Language">${t('o_lang')}</button></div><div class="pad" style="padding-top:24px"><div class="h1">${t('o_phone_h')}</div><div class="mu" style="font-size:16px;margin-top:8px">${t('o_phone_s')}</div></div><div class="field"><div class="sm mu">${t('o_phone_l')}</div><div id="phv" style="font-size:26px;font-weight:800;margin-top:4px;min-height:34px">${fmtPh(S.ob.ph)}</div></div><div class="pad" style="padding-top:16px"><a href="#" class="sm" style="color:var(--lk);font-weight:700" onclick="obSkip();return false">Skip sign-in (prototype shortcut)</a></div>${obpad(0,0,true)}<div class="cta"><button id="obnext" class="btn" ${S.ob.ph.length>=9?'':'disabled'} onclick="obPhoneNext()">${t('nx')}</button></div>`,
obNotFound:()=>`${obbar()}<div style="display:flex;flex-direction:column;align-items:center;text-align:center;padding:clamp(24px,8vh,120px) 32px 0"><div class="g3">${gl('warning3d',92)}</div><div class="h1" style="margin-top:24px">${t('o_nf_h')}</div><div class="mu" style="font-size:16px;margin-top:10px;line-height:24px">${t('o_nf_b')}</div></div><div class="cta"><button class="btn" onclick="obGo('obName')">${t('nx')}</button></div>`,
obName:()=>`${obbar()}<div class="pad" style="padding-top:16px"><div class="h1">${t('o_name_h')}</div><div class="mu" style="font-size:16px;margin-top:8px">${t('o_name_s')}</div></div><div class="pad"><div class="lab">${t('o_first')}</div><input class="in" id="fn" aria-label="First name" value="${S.ob.first}" oninput="obF('first',this.value)"><div class="lab">${t('o_last')}</div><input class="in" id="ln" aria-label="Last name" value="${S.ob.last}" oninput="obF('last',this.value)"></div><div class="cta"><button id="obnext" class="btn" ${S.ob.first.trim()&&S.ob.last.trim()?'':'disabled'} onclick="obGo('obTerms')">${t('nx')}</button></div>`,
obTerms:()=>{const o=S.ob,all=o.t&&o.p&&o.c;const tr=(k,ti,req)=>`<div class="row tap" onclick="tcTog('${k}')"><div class="cb ${o[k]?'on':''}">${o[k]?ic('plus',0).replace('<svg','<svg style="display:none"')+'<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#17171C" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L19 7"/></svg>':''}</div><div style="flex:1"><div class="t" style="font-size:15px">${ti}</div></div><span class="sm" style="color:${req?'var(--lk)':'var(--mu)'};font-weight:700">${t('o_req')}</span></div>`;return `${obbar()}<div class="pad" style="padding-top:16px"><div class="h1">${t('o_terms_h')}</div><div class="mu" style="font-size:16px;margin-top:8px">${t('o_terms_s')}</div></div><div class="pad" style="padding-top:22px"><div class="row tap" style="background:var(--chip);border-radius:16px;padding:14px 16px" onclick="tcAll()"><div class="cb ${all?'on':''}">${all?'<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#17171C" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L19 7"/></svg>':''}</div><div class="t" style="font-size:16px">${t('o_all')}</div></div><div style="padding-top:8px">${tr('t',t('s_terms'),true)}${tr('p',t('s_priv'),true)}${tr('c',t('s_credit'),true)}</div></div><div class="cta"><button id="obnext" class="btn" ${o.t&&o.p&&o.c?'':'disabled'} onclick="obGo('obPin')">${t('nx')}</button></div>`},
obPin:()=>`${obbar()}<div class="pad" style="padding-top:16px;text-align:center"><div class="h1">${t('o_pin_h')}</div><div class="mu" style="font-size:16px;margin-top:8px">${t('o_pin_s')}</div></div>${pinDots(S.ob.pin)}${obpad(0,0,false)}`,
obPin2:()=>`${obbar()}<div class="pad" style="padding-top:16px;text-align:center"><div class="h1">${t('o_pin2_h')}</div><div id="pe" style="color:var(--er);font-size:14px;margin-top:8px;min-height:20px">${S.ob.err||''}</div></div>${pinDots(S.ob.pin2)}<div class="pad" style="text-align:center;padding-top:10px"><a href="#" class="sm" style="color:var(--lk);font-weight:700" onclick="soon();return false">${t('o_ref')}</a></div>${obpad(0,0,true)}<div class="cta"><button id="obnext" class="btn" ${S.ob.pin2.length===6&&S.ob.pin2===S.ob.pin?'':'disabled'} onclick="obCreate()">${t('o_create')}</button></div>`,
obDone:()=>`<div style="display:flex;flex-direction:column;align-items:center;text-align:center;padding:clamp(28px,12vh,190px) 32px 0"><div class="g3">${gl('success3d',132)}</div><div class="h1" style="margin-top:26px">Welcome, ${S.name}</div><div class="mu" style="font-size:16px;margin-top:10px">Your itunda account is ready. This is a prototype, so no real account was created.</div></div><div class="cta" style="border:0"><button class="btn" onclick="obStart()">Get started</button></div>`,
settings:()=>{const o=S.set;const sw=(k)=>`<div class="sw ${o[k]?'on':''}" id="ss_${k}" role="switch" aria-checked="${o[k]}" tabindex="0" onclick="tgSet('${k}')"><i></i></div>`;
const tr=(t,s,k)=>`<div class="ar" style="cursor:default"><div style="min-width:0;flex:1"><div class="t">${t}</div>${s?`<div class="s">${s}</div>`:''}</div>${sw(k)}</div>`;
const sr=(t,s,r,on)=>`<div class="ar tap" onclick="${on||"soon()"}"><div style="min-width:0;flex:1"><div class="t">${t}</div>${s?`<div class="s">${s}</div>`:''}</div>${r?`<span class="sm mu" style="font-weight:700">${r}</span>`:''}${ic('chev',16,'var(--tt)')}</div>`;
const L2={en:'English',rw:'Kinyarwanda',fr:'Français'};
return `${bar(t('s_title'))}<div class="agt" style="padding-top:18px">${t('s_myinfo')}</div>${sr(t('s_myinfo'),'','')}
<div class="agt">${t('s_auth')}</div>${tr(t('s_bio'),t('s_bio_b'),'bio')}${tr(t('s_dev'),t('s_dev_b'),'devbio')}
<div class="agt">${t('s_display')}</div><div class="pad" style="padding-top:6px"><div style="font-size:16px;font-weight:700">${t('s_theme')}</div><div class="sm mu" style="margin:2px 0 10px">${t('s_theme_b')}</div><div class="req">${[['system',t('s_sys')],['light',t('s_light')],['dark',t('s_dark')]].map(([k,l])=>`<button class="${S.theme===k?'on':''}" onclick="setTheme('${k}')">${l}</button>`).join('')}</div></div>${sr(t('s_text'),'','')}${sr(t('s_lang'),'',L2[S.lang],'langSheet()')}
<div class="agt">${t('s_tp')}</div>${sr(t('send'),'','')}${sr(t('s_pay'),'','')}
<div class="agt">${t('s_legal')}</div>${sr(t('s_credit'),'','')}${sr(t('s_priv'),'','')}${sr(t('s_terms'),'','')}
<div class="agt">${t('s_devices')}</div><div class="ar" style="cursor:default"><div style="flex:1"><div class="t">Pixel 8${t('s_thisdev')}</div><div class="s">${t('s_trusted')}</div></div><span class="sm" style="color:var(--lk);font-weight:700" onclick="soon()">${t('s_remove')}</span></div>
<div class="agt">${t('s_notif')}</div>${sr(t('s_manage'),'','')}${tr(t('s_money'),'','money')}${tr(t('s_general'),'','general')}${sr(t('s_markall'),'','','S.nread=true;toast(\'OK\')')}
<div class="pad" style="padding-top:28px"><button class="btn sec2" onclick="logOut()">${t('s_logout')}</button></div>`},
transit:()=>{const low=S.tb<S.fare;return `${bar(t('tr_title'))}<div class="pad" style="padding-top:16px"><div class="sm mu">${t('tr_bal')}</div><div class="big" style="margin-top:4px">${fmt(S.tb)} RWF</div></div>
<div class="agt" style="padding-top:26px">${t('tr_top')}</div><div class="pad"><div class="req">${[1000,2000,5000].map(a=>`<button class="${S.topAmt===a?'on':''}" onclick="S.topAmt=${a};render('fade-none')">${fmt(a)} RWF</button>`).join('')}</div><button class="btn" style="margin-top:14px" ${S.topAmt>S.pay?'disabled':''} onclick="transitTop()">${t('tr_top')} ${fmt(S.topAmt)} RWF</button>${S.topAmt>S.pay?`<div style="color:var(--er);font-size:14px;margin-top:10px">${t('insuff').replace('%s',fmt(S.pay))}</div>`:''}</div>
<div class="agt">${t('tr_tapt')}</div><div class="pad"><div class="req">${['Kigali Bus Services','Royal Express'].map(o=>`<button class="${S.op===o?'on':''}" onclick="S.op='${o}';render('fade-none')">${o}</button>`).join('')}</div><div class="req" style="margin-top:10px">${[200,300,400,500].map(f=>`<button class="${S.fare===f?'on':''}" onclick="S.fare=${f};render('fade-none')">${f} RWF</button>`).join('')}</div><div class="sm mu" style="margin-top:10px;line-height:18px">${t('tr_tapd')}</div><button class="btn" style="margin-top:14px" ${low?'disabled':''} onclick="transitTap()">${low?t('tr_low'):t('tr_tap').replace('%s',S.fare)}</button></div>
<div class="agt">${t('tr_hist')}</div>${S.rides.length?S.rides.map(r=>`<div class="ar" style="cursor:default"><div class="g">${gl('busstop',30)}</div><div style="flex:1"><div class="t" style="font-size:15px">${r[0]}</div></div><b>−${r[1]} RWF</b></div>`).join(''):`<div class="pad mu" style="font-size:14px;line-height:20px">${t('tr_none')}</div>`}
<div class="pad fine" style="padding-top:26px;line-height:17px">${t('tr_disc').replace(/&/g,'&amp;')}</div>`},
nocard:()=>{const f=FIN[S.finish];return `${bar(t('c_title'))}${cardVis({frozen:false,last:'••••'},true)}<div class="pad" style="padding-top:26px"><div class="h1" style="font-size:24px;line-height:32px">${t('c_et')}</div><div class="mu" style="font-size:15px;margin-top:8px;line-height:22px">${t('c_es')}</div></div><div class="pad" style="padding-top:14px">${[t('c_f1'),t('c_f2'),t('c_f3'),t('c_f4')].map(t=>`<div style="display:flex;align-items:center;gap:12px;padding:7px 0;font-size:15px;font-weight:600">${gl('verify',26)}${t}</div>`).join('')}</div><div class="pad" style="padding-top:18px"><div style="font-size:15px;font-weight:800;margin-bottom:10px">${t('c_fin')}</div><div class="req">${Object.keys(FIN).map(k=>`<button class="${S.finish===k?'on':''}" onclick="setFinish('${k}')">${k}</button>`).join('')}</div></div><div class="cta"><button class="btn" onclick="getCard()">${t('c_get').replace('%s',S.finish)}</button></div>`},
card:()=>{const c=S.card;const sw=`<div class="sw ${c.frozen?'on':''}" id="sw_frozen" role="switch" aria-checked="${c.frozen}" tabindex="0" onclick="tgFreeze()"><i></i></div>`;return `${bar(t('c_title'))}${cardVis(c,false)}<div class="pad" style="padding-top:26px"><div style="display:flex;align-items:center;justify-content:space-between;padding:12px 0"><div style="font-size:16px;font-weight:700" id="frzl">${c.frozen?t('c_unfreeze'):t('c_freeze')}</div>${sw}</div>${row('lock',t('c_pin'))}${row('cash',t('c_lost'))}${row('receipt',t('c_close'))}</div><div class="pad" style="padding-top:18px"><div style="font-size:18px;font-weight:800;margin-bottom:8px">${t('c_lim')}</div><div style="display:flex;justify-content:space-between;font-size:14px;padding:6px 0"><span class="mu">${t('c_dl')}</span><b>${t('c_td').replace('%1','0').replace('%2','500,000')}</b></div><div style="display:flex;justify-content:space-between;font-size:14px;padding:6px 0"><span class="mu">${t('c_ml')}</span><b>${t('c_tm').replace('%1','0').replace('%2','5,000,000')}</b></div></div><div class="pad" style="padding-top:22px"><div style="font-size:18px;font-weight:800">${t('c_rec')}</div><div class="mu" style="font-size:14px;margin-top:8px;line-height:20px">${t('c_none')}</div></div><div class="pad fine" style="padding-top:22px">${t('c_disc')}</div>`},
product:()=>{const x=PRODS[S.pi],d=pct(x.p,x.o);return `${bar('Product')}<div style="padding:12px 24px 0"><div class="pim" style="aspect-ratio:auto;height:260px;border-radius:28px">${gl(x.g,132)}<button class="hrt" id="h${S.pi}" aria-label="Save" onclick="tgFav(${S.pi})" style="width:44px;height:44px">${heart(S.fav[S.pi])}</button></div></div><div class="pad" style="padding-top:20px"><div class="sm mu">${x.m}</div><div style="font-size:22px;font-weight:800;letter-spacing:-.4px;margin-top:4px;line-height:30px">${x.n}</div><div style="margin-top:14px;display:flex;align-items:baseline;gap:8px">${d?`<b style="color:var(--er);font-size:20px">${d}%</b>`:''}<b style="font-size:28px;letter-spacing:-.6px">${fmt(x.p)} RWF</b></div>${x.o?`<div class="po" style="font-size:14px">${fmt(x.o)} RWF</div>`:''}<div style="margin-top:12px;color:var(--lk);font-weight:800;font-size:14px">Earn ${fmt(Math.round(x.p*0.01))} RWF back (1% cashback)</div></div><div class="pad" style="padding-top:20px">${row('transit','Rider delivery','1 to 2 days','1,500 RWF')}${row('lock','Pay with itunda Pay','Balance '+fmt(S.pay)+' RWF')}${x.s<=5?`<div class="ps" style="padding-top:8px;font-size:14px">${x.s} left in stock</div>`:''}</div><div class="cta"><button class="btn" onclick="addCart(${S.pi})">Add to cart · ${fmt(x.p)} RWF</button></div>`},
scart:()=>{const ent=Object.entries(S.scart).filter(([i,q])=>q>0);const tot=scTotal()+1500,bad=tot>S.pay;const lines=ent.map(([i,q])=>{const x=PRODS[i];return `<div style="display:flex;align-items:center;gap:12px;padding:10px 0"><div class="pim" style="width:56px;height:56px;border-radius:16px;aspect-ratio:auto;flex-shrink:0">${gl(x.g,34)}</div><div style="flex:1;min-width:0"><div style="font-size:15px;font-weight:700;line-height:20px">${x.n}</div><div class="sm mu">${fmt(x.p)} RWF</div></div><div style="display:flex;align-items:center;gap:8px"><button class="ib" style="width:34px;height:34px;border-radius:17px;background:var(--chip)" aria-label="Remove one" onclick="scAdj(${i},-1)">${ic('minus',16)}</button><b style="min-width:14px;text-align:center">${q}</b><button class="ib" style="width:34px;height:34px;border-radius:17px;background:var(--chip)" aria-label="Add one" onclick="scAdj(${i},1)">${ic('plus',16)}</button></div></div>`}).join('');return `${bar('Cart')}<div class="pad" style="padding-top:12px">${lines}</div><div class="pad" style="padding-top:12px"><div style="display:flex;justify-content:space-between;height:44px;align-items:center;font-size:15px;border-top:0"><span class="mu">Delivery</span><b>1,500 RWF</b></div><div style="display:flex;justify-content:space-between;align-items:baseline;padding-top:8px"><span style="font-size:18px;font-weight:800">Total</span><span style="font-size:28px;font-weight:800;letter-spacing:-.5px">${fmt(tot)} RWF</span></div><div style="margin-top:14px;display:flex;justify-content:space-between;font-size:14px"><span class="mu">Pay from</span><b>itunda Pay · ${fmt(S.pay)} RWF</b></div>${bad?`<div style="color:var(--er);font-size:14px;margin-top:10px">Not enough balance — you have RWF ${fmt(S.pay)}</div>`:''}</div><div class="cta"><button class="btn" ${bad||!ent.length?'disabled':''} onclick="shopPay()">Pay ${fmt(tot)} RWF</button></div>`},
erest:()=>{const r=REST[S.er],n=eCount(),sub=eSub();const items=r.items.map((it,k)=>`<div class="mi"><div style="flex:1;min-width:0"><div style="font-size:16px;font-weight:800">${it[0]}</div>${it[1]?`<div class="sm mu" style="margin-top:3px;line-height:18px">${it[1]}</div>`:''}<div style="font-size:15px;font-weight:700;margin-top:8px">${fmt(it[2])} RWF</div></div><div class="th">${gl(it[3],48)}<button class="plus" aria-label="Add ${it[0]}" onclick="eAdd(${k})">${S.ecart[k]?S.ecart[k]:'+'}</button></div></div>`).join('');
return `<div style="height:210px;background:${r.bg};display:flex;align-items:center;justify-content:center;position:relative"><button class="ib" aria-label="Back" onclick="back()" style="position:absolute;left:8px;top:14px;background:var(--bg);border-radius:22px">${ic('back',24)}</button>${gl(r.g,120)}</div><div style="margin-top:-24px;background:var(--bg);border-radius:28px 28px 0 0;position:relative;padding:24px 24px 0"><div style="font-size:24px;font-weight:800;letter-spacing:-.5px">${r.n}</div><div class="sm" style="margin-top:6px;font-weight:700">★ ${r.r} <span class="mu" style="font-weight:500">(${r.rc} reviews) · ${r.d} km</span></div><div class="req" style="margin-top:16px"><button class="${S.pickup?'':'on'}" onclick="setPickup(false)">Delivery</button><button class="${S.pickup?'on':''}" onclick="setPickup(true)">Pickup</button></div><div class="sm mu" style="margin-top:10px">${S.pickup?'Ready in 10-15 min · Pickup is free':r.t+' min · '+(r.fee?fmt(r.fee)+' RWF delivery':'Free delivery')} · Min ${fmt(r.min)} RWF</div><div style="display:flex;gap:20px;font-size:16px;font-weight:800;padding-top:22px;border-bottom:0"><span style="border-bottom:2px solid var(--tx);padding-bottom:8px">Menu</span><span style="color:var(--tt)">Info</span><span style="color:var(--tt)">Reviews</span></div><div style="font-size:18px;font-weight:800;padding-top:18px">Popular</div>${items}</div><div class="pad fine" style="padding:20px 24px 0">Menus, prices and ratings are sample data.</div>${n?`<div class="cta"><button class="btn" onclick="eCart()">View cart · ${n} · ${fmt(sub)} RWF</button></div>`:''}`},
echeck:()=>{const r=REST[S.er],sub=eSub(),fee=eFee(),tot=sub+fee,bad=tot>S.pay,short=sub<r.min;const lines=Object.entries(S.ecart).filter(([k,q])=>q>0).map(([k,q])=>{const it=r.items[k];return `<div style="display:flex;align-items:center;gap:12px;padding:8px 0"><div style="flex:1;font-size:15px;font-weight:700">${it[0]}<div class="sm mu" style="font-weight:500">${fmt(it[2])} RWF</div></div><button class="ib" style="width:34px;height:34px;border-radius:17px;background:var(--chip)" aria-label="Remove one" onclick="eAdj(${k},-1)">${ic('minus',16)}</button><b style="min-width:14px;text-align:center">${q}</b><button class="ib" style="width:34px;height:34px;border-radius:17px;background:var(--chip)" aria-label="Add one" onclick="eAdj(${k},1)">${ic('plus',16)}</button></div>`}).join('');
return `${bar('Cart')}<div class="pad" style="padding-top:12px"><div class="req"><button class="${S.pickup?'':'on'}" onclick="setPickup(false);render('fade-none')">Delivery</button><button class="${S.pickup?'on':''}" onclick="setPickup(true);render('fade-none')">Pickup</button></div><div style="margin-top:16px;display:flex;align-items:center;gap:12px">${gl('gov',34)}<div><div style="font-size:15px;font-weight:800">${S.pickup?r.n:'Home'}</div><div class="sm mu">${S.pickup?r.d+' km away · ready in 10-15 min':'Kimironko, KG 11 Ave · '+r.t+' min'}</div></div></div></div>
${S.pickup?'':`<div class="pad" style="padding-top:18px"><div style="font-size:15px;font-weight:800;margin-bottom:10px">Request for the rider</div><div class="req">${['Leave at the door','Hand it to me','Call when nearby'].map(q=>`<button class="${S.req===q?'on':''}" onclick="setReq('${q}')">${q}</button>`).join('')}</div></div>`}
<div class="pad" style="padding-top:20px"><div style="font-size:17px;font-weight:800">${r.n}</div>${lines}</div><div class="pad" style="padding-top:14px"><div style="display:flex;justify-content:space-between;height:40px;align-items:center;font-size:15px;border-top:0"><span class="mu">Items</span><b>${fmt(sub)} RWF</b></div><div style="display:flex;justify-content:space-between;height:36px;align-items:center;font-size:15px"><span class="mu">${S.pickup?'Pickup':'Delivery'}</span><b>${fee?fmt(fee)+' RWF':'Free'}</b></div><div style="display:flex;justify-content:space-between;align-items:baseline;padding-top:6px"><span style="font-size:18px;font-weight:800">Total</span><span style="font-size:28px;font-weight:800;letter-spacing:-.5px">${fmt(tot)} RWF</span></div><div style="margin-top:14px;display:flex;justify-content:space-between;font-size:14px"><span class="mu">Pay with</span><b>itunda Pay · ${fmt(S.pay)} RWF</b></div>${short?`<div style="color:var(--er);font-size:14px;margin-top:10px">Add RWF ${fmt(r.min-sub)} more to reach the minimum order.</div>`:''}${bad?`<div style="color:var(--er);font-size:14px;margin-top:10px">Not enough balance — you have RWF ${fmt(S.pay)}</div>`:''}</div><div class="cta"><button class="btn" ${bad||short?'disabled':''} onclick="ePay()">Pay ${fmt(tot)} RWF</button></div>`},
etrack:()=>{const r=REST[S.er],st=ESTEPS(),k=S.trk;const eta=k>=3?(S.pickup?'Picked up':'Delivered'):k===2?(S.pickup?'Ready now':'Arriving in 8 min'):k===1?'About '+(r.tm-2)+' min':'About '+r.tm+' min';
return `${bar(S.pickup?'Your pickup':'Your delivery')}<div class="pad" style="padding-top:12px"><div id="eta" style="font-size:28px;font-weight:800;letter-spacing:-.6px">${eta}</div><div class="sm mu" style="margin-top:4px">${r.n} · ${S.pickup?'Pickup':'to Kimironko, KG 11 Ave'}</div></div><div class="pad" style="padding-top:16px"><svg viewBox="0 0 342 190" width="100%" style="border-radius:24px;display:block" role="img" aria-label="Map showing the rider on the way"><rect width="342" height="190" fill="var(--chip)"/><path d="M0 62L342 40M0 132L342 152M92 0L112 190M232 0L212 190" stroke="var(--bg)" stroke-width="12" opacity=".85" fill="none"/><path id="rt" d="M60 150C120 150 130 76 190 76S270 62 290 40" fill="none" stroke="var(--br)" stroke-width="5" stroke-linecap="round" stroke-dasharray="2 9"/><circle cx="60" cy="150" r="15" fill="var(--br)"/><svg x="50" y="140" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#17171C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="${P.bag}"/></svg><circle cx="290" cy="40" r="15" fill="var(--tx)"/><svg x="280" y="30" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--bg)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="${P.home}"/></svg>${S.pickup?'':`<circle r="9" fill="#fff" stroke="var(--tx)" stroke-width="3"><animateMotion dur="11s" begin="0s" fill="freeze" keyPoints="0;0;0.35;1" keyTimes="0;0.5;0.55;1" calcMode="linear"><mpath href="#rt"/></animateMotion></circle>`}</svg></div>
<div class="pad" style="padding-top:18px" id="tls">${st.map((s,i)=>`<div class="tl ${i<k?'done':i===k?'on':''}" id="tl${i}"><i>${i<=k?ic('plus',0):''}</i>${s}</div>`).join('')}</div>
<div class="pad" id="rider" style="padding-top:12px;${k>=2&&!S.pickup?'':'display:none'}"><div style="display:flex;align-items:center;gap:12px;padding:12px 0;border-top:0"><div class="ico">${gl('moto',34)}</div><div style="flex:1"><div style="font-size:15px;font-weight:800">Jean Claude</div><div class="sm mu">Your rider · ★ 4.9</div></div><button class="ib" aria-label="Call rider" onclick="toast('Calling is not in this prototype')" style="background:var(--chip);border-radius:22px">${ic('phone',22)}</button></div></div>
<div class="pad fine" style="padding-top:10px">Order tracking and the rider are simulated for this prototype.</div><div class="cta"><button class="btn" id="edone" onclick="done()" ${k>=3?'':'disabled'}>${k>=3?'Done':'Tracking your order'}</button></div>`},
messages:()=>`<div class="ahead"><b style="font-size:24px;letter-spacing:-.5px">Messages</b><div style="display:flex;gap:2px"><button class="ib" aria-label="Search" onclick="soon()">${ic('search',24)}</button><button class="ib" aria-label="New message" onclick="soon()">${ic('pencil',24)}</button></div></div><div style="padding-top:8px">${THREADS.map(t=>{const u=S.read[t.id]?0:t.u;return `<div class="ar tap" style="padding:12px 24px" onclick="openChat('${t.id}')"><div class="ico" style="width:52px;height:52px;border-radius:26px">${gl(t.g,34)}</div><div style="flex:1;min-width:0"><div style="display:flex;justify-content:space-between;align-items:baseline"><b style="font-size:16px">${t.n}</b><span class="sm mu">${t.t}</span></div><div style="display:flex;justify-content:space-between;align-items:center;gap:8px;margin-top:3px"><span class="sm mu" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${prev(S.msgs[t.id])}</span>${u?`<span style="min-width:20px;height:20px;border-radius:10px;background:var(--br);color:var(--on);font-size:12px;font-weight:800;display:flex;align-items:center;justify-content:center;padding:0 6px">${u}</span>`:''}</div></div></div>`}).join('')}</div><div class="pad fine" style="padding-top:20px">Conversations are sample data. Send money, gifts and split bills right in a chat.</div>`,
chat:()=>{const t=thr();const ms=S.msgs[t.id];return `${bar(t.n)}<div class="pad sm mu" style="padding-top:2px;padding-left:68px;margin-top:-6px">${t.sub}</div><div class="pad" style="padding-top:14px">${ms.length?ms.map(bubble).join(''):'<div class="mu" style="padding-top:30px;text-align:center">No messages yet. Say hello.</div>'}</div><div class="cta" style="display:flex;gap:8px;align-items:center;padding:10px 12px 14px"><button class="ib" aria-label="Send money, a gift or split a bill" onclick="chatMenu()" style="background:var(--chip);border-radius:22px;flex-shrink:0">${ic('plus',22)}</button><input id="msg" placeholder="Message" aria-label="Message" onkeydown="if(event.key==='Enter')chatSend()" style="flex:1;min-width:0;height:44px;border:0;border-radius:22px;background:var(--chip);padding:0 16px;font:inherit;font-size:15px;color:var(--tx);outline:0"><button class="ib" aria-label="Send message" onclick="chatSend()" style="background:var(--br);border-radius:22px;flex-shrink:0">${ic('send',20,'#17171C')}</button></div>`},
you:()=>{const yr=(g,t,s,r,on)=>`<div class="ar tap" onclick="${on||"soon()"}"><div class="g">${gl(g,32)}</div><div style="min-width:0"><div class="t">${t}</div>${s?`<div class="s">${s}</div>`:''}</div><span style="margin-left:auto;display:flex;align-items:center;gap:4px;font-size:14px;font-weight:700;color:var(--mu)">${r===undefined?'':r}${ic('chev',16,'var(--tt)')}</span></div>`;const nf=Object.values(S.fav).filter(Boolean).length;const nz=v=>(v==0||v==='0')?'':v;
return `<div class="ahead"><b style="font-size:24px;letter-spacing:-.5px">You</b><button class="ib" aria-label="Settings" onclick="openSettings()">${ic('gear',24)}</button></div>
<div class="ar tap" style="padding-top:18px;gap:16px" onclick="openProfile()"><div class="ico" style="width:68px;height:68px;border-radius:34px">${gl('community',46)}</div><div style="min-width:0"><div style="font-size:20px;font-weight:800">${S.name||'Amina Uwase'}</div><div class="s" style="font-size:13px;color:var(--mu);margin-top:2px">078 ••• 214 · View my profile</div></div>${ic('chev',16,'var(--tt)').replace('<svg','<svg style="margin-left:auto"')}</div>
${yr('verify','Verification','Identity verified','')}
<div class="agt">Partner earnings</div><div class="pad sm mu" style="line-height:19px">Earn 3% when people buy via your links.</div>${yr('send','Links shared','','2')}${yr('chart','Total clicks','','14')}${yr('money','Total earned','','1,240 RWF')}
${S.orders.length?`<div class="agt">My orders</div>${S.orders.slice(0,3).map(o=>yr(o.k==='Eats order'?'restaurant':'bag',o.k,o.s,fmt(o.t)+' RWF')).join('')}`:''}
<div class="agt">My favorites</div>${yr('heartred','Product wishlist','',nz(nf),'openShop(\'shop\')')}${yr('heartred','Marketplace wishlist','',nz(hdFav('market')),"openHood('market')")}${yr('heartred','Jobs wishlist','',nz(hdFav('jobs')),"openHood('jobs')")}${yr('heartred','Property wishlist','',nz(hdFav('property')),"openHood('property')")}${yr('heartred','Restaurant favorites','','','openShop(\'eats\')')}
<div class="agt">My listings</div>${yr('market','Marketplace','',nz(hdMine('market')),"openHood('market')")}${yr('briefcase','Jobs posted','',nz(hdMine('jobs')),"openHood('jobs')")}${yr('house','Property listed','',nz(hdMine('property')),"openHood('property')")}
<div class="agt">Settings</div>${yr('globe','Language','English, Kinyarwanda, Français','','langSheet()')}${yr('bell','Help and support','','')}<div class="pad fine" style="padding-top:20px">Your name, numbers and counts are sample data.</div>`},
bank:()=>{return `${bar('itunda Bank')}
<div class="pad" style="padding-top:20px"><div class="sm mu">itunda Bank account</div><div style="display:flex;justify-content:space-between;align-items:center;margin-top:4px"><span style="font-size:28px;font-weight:800;letter-spacing:-.5px">${fmt(S.bank)} RWF</span>${ic('chev',18,'var(--tt)')}</div><div style="display:flex;justify-content:space-between;margin-top:10px;font-size:14px"><span class="mu">itunda Pay</span><b>${fmt(S.pay)} RWF</b></div></div>
<div class="pad" style="padding-top:12px">${row('cyc','Auto-transfer','','2 active')}</div>
<div class="sec"><div class="sech">Recommended for you</div>${row('coin',S.goal?S.goal.n:'Start your first savings goal',S.goal?fmt(S.goal.s)+' of '+fmt(S.goal.t)+' RWF saved':'A target and a date make saving easier','','openGoal()')}${row('users','Join an Ikimina circle','Save in a rotating circle with people you trust')}${row('bank','Try SACCO shares','Buy cooperative shares, earn a real dividend')}</div>
<div class="sec"><div class="sech">Save &amp; grow</div>${row('coin','Interest jar','4.0% annual · RWF 18,400 earned so far','RWF 1,240')}${row('coin','School fees','RWF 120,000 of 300,000 · by 2027-01-31','40%')}${row('plus','New savings goal','Set a target and save towards it')}${row('up','Round-up saving','Rounding up to RWF 100','On')}${row('cal','26-week savings','5% base rate, escalates weekly')}${row('bolt','31-day savings','Daily streak, up to 10% bonus rate','','open31()')}${row('lock','12-month deposit','Interest paid upfront, principal locked')}${row('child','Youth account','A starter account for under-18s, parent-supervised')}${row('users','Group accounts','Shared savings for family, church or cooperative groups')}${row('users','Ikimina','Join a rotating savings circle with people you trust')}${row('bank','SACCO shares','Buy cooperative shares, earn a real dividend')}${row('trend','Investments','RSE stocks, bonds &amp; fixed income, IPOs')}</div>
<div class="sec"><div class="sech">Borrow</div>${row('wallet','Get a loan','Personal, salary-backed, SME working capital')}${row('plant','Harvest advance','Input financing from your coffee cooperative')}${row('shield','VUP Financial Services','Means-tested government microloan for farming, livestock, business')}${row('school','Student loan','BRD higher-education loan: 11% undergraduate, 12% postgraduate')}${row('bike','Moto-Taxi Ownership','Save a 30% down payment, then convert to a loan for your own bike')}</div>
<div class="sec"><div class="sech">Insights</div>${row('coin','312,000 RWF','Spent this period, mostly on food')}${row('trend','My credit score','Free check, alternative data','View')}</div>
<div class="sec"><div style="font-size:14px;font-weight:800">Deposit Protection Fund (simulation)</div><div style="display:flex;justify-content:space-between;margin-top:8px;font-size:13px"><span class="mu">Your covered balance</span><b>500,000 RWF</b></div><div class="fine" style="margin-top:4px">Covered up to RWF 500,000 per user</div><div class="fine">itunda's reserve: RWF 50,000,000</div><div class="fine" style="margin-top:12px">itunda is not a licensed bank, and this is not real government deposit insurance. "itunda Bank" is itunda's own product name for these savings, SACCO/Ikimina, loan, and investment features, not a separate licensed banking entity.</div><div class="fine" style="margin-top:12px">Amounts, rates and names here are sample data.</div></div>`},
save31:()=>`${bar('31-day savings')}<div class="pad" style="padding-top:32px"><div class="h1">Save a little every day for 31 days</div><div class="mu" style="font-size:16px;margin-top:12px;line-height:24px">The longer your daily streak, the higher your bonus rate, up to 10%.</div></div><div class="pad" style="padding-top:32px"><div style="display:flex;flex-wrap:wrap;gap:8px">${Array.from({length:31},(_,i)=>`<div style="width:18px;height:18px;border-radius:9px;background:${i<12?'var(--br)':'var(--chip)'};${i<12?`animation:dotin .35s ${i*40}ms both`:''}"></div>`).join('')}</div><div class="sm mu" style="margin-top:12px">Example: a 12-day streak</div></div><div class="pad" style="padding-top:28px"><div style="display:flex;justify-content:space-between;height:48px;align-items:center;font-size:15px"><span class="mu">Bonus rate at 31 days</span><b>up to 10%</b></div><div class="fine" style="margin-top:12px">itunda Bank is not a licensed bank. Sample copy for this prototype.</div></div><div class="cta"><button class="btn" onclick="soon()">Start saving</button></div>`,
recipient:()=>`${bar(t('send'))}<div class="pad" style="padding-top:20px"><div class="h1">${t('rh')}</div></div><div class="pad" style="padding-top:24px;display:flex;gap:20px;font-size:16px;font-weight:800"><span class="tap" role="tab" tabindex="0" aria-selected="${S.rtab!=='f'}" onclick="setRTab('a')" style="cursor:pointer;padding-bottom:8px;${S.rtab==='f'?'color:var(--tt)':'border-bottom:2px solid var(--tx)'}">${t('ta')}</span><span class="tap" role="tab" tabindex="0" aria-selected="${S.rtab==='f'}" onclick="setRTab('f')" style="cursor:pointer;padding-bottom:8px;${S.rtab==='f'?'border-bottom:2px solid var(--tx)':'color:var(--tt)'}">${t('tf')}</span></div><div class="field" ${S.rtab==='f'?'style="display:none"':''}><div class="sm mu">${t('rl')}</div><div style="display:flex;align-items:center;justify-content:space-between;margin-top:4px;min-height:32px"><div style="font-size:24px;font-weight:800">${S.to||'<span style="color:var(--tt);font-weight:500">0781 234 567</span>'}</div>${S.to?'<button class="ib" aria-label="Clear" onclick="clearTo()" style="width:32px;height:32px;border-radius:16px;background:var(--chip)"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button>':''}</div></div>${S.flagged?`<div class="warn"><div>${gl('warning3d',34)}</div><div><div style="font-size:15px;font-weight:800;color:var(--er)">${t('sw')}</div><div class="mu" style="font-size:14px;margin-top:4px;line-height:20px">${t('sb')}</div><div style="font-size:14px;font-weight:700;color:var(--lk);margin-top:8px">${t('rs')}</div></div></div>`:''}<div class="sec" style="padding-bottom:4px;${S.rtab==='f'?'display:none':''}"><div class="sech">${({rw:'Abo aherutse',fr:'Récents'})[S.lang]||'Recent'}</div><div style="display:flex;gap:18px;padding-top:6px">${[['Amina K.','0788 000 214',0],['Eric M.','0781 234 567',1]].map(([n,p,f])=>`<div class="tap" role="button" tabindex="0" onclick="pickGo('${p}',${f})" style="display:flex;flex-direction:column;align-items:center;gap:8px;font-size:12px;font-weight:700;cursor:pointer"><div style="width:56px;height:56px;border-radius:28px;background:var(--tint);color:var(--tintfg);display:flex;align-items:center;justify-content:center;font-size:20px;font-weight:800;${S.to===p?'box-shadow:0 0 0 2px var(--br)':''}">${n[0]}</div>${n.split(' ')[0]}</div>`).join('')}</div></div><div class="sec"><div class="sech">${t('co')}<a>${t('ad')}</a></div>${[['Amina K.','0788 000 214',0],['Eric M.','0781 234 567',1]].map(([n,p,f])=>`<div class="row tap" onclick="pick('${p}',${f})" ${S.to===p?'style="background:var(--tint);padding-left:10px;padding-right:10px"':''}><div class="ico">${gl('community',30)}</div><div><div class="t">${n}</div><div class="s">${p}</div></div></div>`).join('')}</div><div class="cta"><button class="btn" ${S.to?'':'disabled'} onclick="amount()">${t('nx')}</button></div>`,
amount:()=>{const v=S.amt?Number(S.amt):0,bad=v>S.bank;return `${bar(t('send'))}<div class="pad" style="padding-top:20px"><div class="h1">${t('aq')}</div><div class="mu" style="font-size:14px;margin-top:8px">${t('ta2').replace('%s',S.to)}</div></div><div style="padding:32px 24px 0;text-align:center"><div style="font-size:56px;font-weight:800;letter-spacing:-2px;color:${bad?'var(--er)':'var(--tx)'}"><span id="amt">${v?fmt(v):'0'}</span> <span style="font-size:20px;letter-spacing:0">RWF</span></div><div id="msg" class="${bad?'':'mu'}" style="margin-top:12px;font-size:14px;color:${bad?'var(--er)':''}">${amtMsg(bad)}</div><div style="margin-top:16px;display:flex;gap:8px;justify-content:center;flex-wrap:wrap">${(S.lastAmt&&S.lastAmt[S.to]&&S.lastAmt[S.to]<=S.bank)?`<button class="chip" style="background:var(--tint);color:var(--tintfg)" onclick="key('set:${S.lastAmt[S.to]}')">${fmt(S.lastAmt[S.to])}</button>`:''}${[5000,10000,50000].map(n=>`<button class="chip" aria-label="Add ${n}" onclick="key('add:${n}')">+${fmt(n)}</button>`).join('')}<button class="chip" style="background:var(--tint);color:var(--tintfg)" onclick="key('max')">${t('mx')}</button></div></div><div style="position:absolute;left:0;right:0;bottom:104px" class="keys">${['1','2','3','4','5','6','7','8','9','','0','⌫'].map(k=>`<button ${k?`onclick="key('${k}')"`:'disabled'} aria-label="${k==='⌫'?'Delete':k}">${k==='⌫'?'<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6H9l-5 6 5 6h11zM12 10l4 4M16 10l-4 4"/></svg>':k}</button>`).join('')}</div><div class="cta"><button id="go" class="btn" ${v&&!bad?'':'disabled'} onclick="confirm_()">${t('send')}</button></div>`},
sent:()=>`<div style="display:flex;flex-direction:column;align-items:center;padding-top:clamp(28px,12vh,200px)"><div class="g3">${gl('success3d',132)}</div><div class="h1" style="margin-top:28px;font-size:34px;line-height:42px">${fmt(S.sentAmt)} RWF</div><div class="mu" style="font-size:16px;margin-top:8px">${s9('to')} ${nm9(S.to)}</div></div><div style="margin:44px 24px 0;padding:4px 20px;border-radius:20px;background:var(--chip)"><div style="display:flex;justify-content:space-between;height:52px;align-items:center;font-size:15px"><span class="mu">${s9('tm')}</span><b>${new Date().toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'})}</b></div><div style="display:flex;justify-content:space-between;height:52px;align-items:center;font-size:15px;border-top:0"><span class="mu">${s9('fee')}</span><b>0 RWF</b></div><div style="display:flex;justify-content:space-between;height:52px;align-items:center;font-size:15px;border-top:0"><span class="mu">${s9('bal')}</span><b>${fmt(S.bank)} RWF</b></div><div style="display:flex;justify-content:space-between;height:52px;align-items:center;font-size:15px;border-top:0"><span class="mu">${s9('ref')}</span><b>IT-20481-7</b></div></div><div class="cta" style="border:0"><div class="row2"><button class="btn sec2" onclick="shareRcpt()">${s9('sh')}</button><button class="btn" onclick="done()">${s9('dn')}</button></div></div>`
};
let bal0=0;
/* v831: draw() lifted the bottom bar with a regex that stopped at the first </div>. Once the Talk composer held the quick-reply row (a nested div), the plus, message box and send button were left behind in the page. The bar is now cut with balanced div matching. */
function ctaBlock(h){const i=h.search(/<div class="cta"[^>]*>/);if(i<0)return null;const re=/<div\b|<\/div>/g;re.lastIndex=i;let d=0,m;while((m=re.exec(h))){if(m[0]==='</div>'){if(--d===0){return[h.slice(i,m.index+6)]}}else d++}return null}
function draw(mode,name){let html=screens[name]();const cm=ctaBlock(html);if(cm)html=html.replace(cm[0],'');const fm=html.match(/<div class="fab">[\s\S]*?<\/button><\/div>/);if(fm)html=html.replace(fm[0],'');const bar=(S.stack.length||!S.auth)?'':tabbar();$('#view').innerHTML=`<div class="screen ${mode}" id="sc">${html}</div>${cm?cm[0]:''}${fm?fm[0]:''}${bar}`;if(name==='home')countUp()}
function render(mode='fade'){draw(mode,S.auth?(S.stack.length?S.stack[S.stack.length-1]:S.tab):S.obStep)}
function togB(){tgHide()}
/* v405: mechanical odometer. Each digit is its own wheel (a strip of digits that rolls with WAAPI), so balances turn like a counter instead of re-typing text. */
const ODO_H=1.2,ODO_BASE=20;
function odoStatic(el,text){el.textContent='';for(const ch of text){const c=document.createElement('span');if(/\d/.test(ch)){c.className='od-c';const st=document.createElement('span');st.className='od-s';st.textContent=ch;c.appendChild(st)}else{c.className='od-p';c.textContent=ch}el.appendChild(c)}}
function odo(el,to,o){o=o||{};const reduce=matchMedia('(prefers-reduced-motion: reduce)').matches;const fin=Number(to).toLocaleString('en-US');el.dataset.roll=fin;
if(el.__odo){el.__odo.forEach(a=>{try{a.cancel()}catch(e){}});el.__odo=null}
const from=Math.max(0,Math.round(o.from||0)),end=Math.round(to);
if(reduce||from===end||!el.animate){odoStatic(el,fin);el.removeAttribute('aria-label');return}
const fs=from.toLocaleString('en-US'),n=fin.replace(/\D/g,'').length;const fd=String(from).padStart(n,'0').slice(-n),td=String(end).replace(/\D/g,''),up=end>from;
el.setAttribute('aria-label',fin);el.textContent='';
const D=o.dur||700,delay=o.delay||0,anims=[];const fromLen=String(from).length;let di=0;
const casc=Math.min(36,Math.max(14,Math.round(260/n)));
for(let k=0;k<fin.length;k++){const ch=fin[k];
 if(!/\d/.test(ch)){const c=document.createElement('span');c.className='od-p';c.textContent=ch;const left=el.lastChild;c.style.opacity=left&&left.style.opacity||'';el.appendChild(c);continue}
 const col=n-1-di,d0=+fd[di],d1=+td[di];di++;
 const c=document.createElement('span');c.className='od-c';const st=document.createElement('span');st.className='od-s od-m';
 let h='';for(let r=0;r<50;r++)h+='<i>'+(r%10)+'</i>';st.innerHTML=h;c.appendChild(st);el.appendChild(c);
 const lead=col>=fromLen&&col>0;
 let steps=up?((d1-d0+10)%10):-((d0-d1+10)%10);
 /* the lower wheels spin extra turns, like a real counter being wound */
 const extra=col===0?2:col===1?1:0;steps+=(up?1:-1)*10*extra;
 const s0=ODO_BASE+d0,s1=s0+steps;
 st.style.transform='translateY('+(-s0*ODO_H)+'em)';
 const dl=delay+(di-1)*casc;const dur=Math.max(380,D-n*casc*.5);
 if(steps===0){st.style.transform='translateY('+(-s1*ODO_H)+'em)';continue}
 const a=st.animate([{transform:'translateY('+(-s0*ODO_H)+'em)'},{transform:'translateY('+(-s1*ODO_H)+'em)'}],{duration:dur,delay:dl,easing:'cubic-bezier(.2,.8,.15,1)',fill:'both'});
 anims.push(a);
 if(lead){c.style.opacity=0;c.style.transition='opacity .35s ease '+dl+'ms';requestAnimationFrame(()=>requestAnimationFrame(()=>{c.style.opacity=1}));const pp=c.previousSibling;if(pp&&pp.className==='od-p'){pp.style.opacity=0;pp.style.transition=c.style.transition;requestAnimationFrame(()=>requestAnimationFrame(()=>{pp.style.opacity=1}))}}
}
el.__odo=anims;const last=anims.length?Promise.all(anims.map(a=>a.finished)):Promise.resolve();
last.then(()=>{if(el.__odo!==anims)return;el.__odo=null;odoStatic(el,fin);el.removeAttribute('aria-label')}).catch(()=>{})}
function countUp(){const el=$('#bal');if(!el)return;if(S.hide){bal0=S.bank;S.first=false;return}const from=bal0,to=S.bank;odo(el,to,{from,dur:S.first?1000:760,delay:S.first?140:60});bal0=to;S.first=false}
const MENU=[{n:'Kigali Bakery',eta:'15 to 25 min',fee:1500,items:[['Croissant',1200],['Mandazi, 6 pieces',1000],['Fresh bread loaf',1500],['Fruit juice',1800]]},{n:'Nyamirambo Grill',eta:'25 to 35 min',fee:1500,items:[['Goat brochette',2500],['Chips',1500],['Fried plantain',1200],['Soda',800]]}];
const cartCount=()=>Object.values(S.cart).reduce((a,b)=>a+b,0);
const cartTotal=()=>Object.entries(S.cart).reduce((a,[i,q])=>a+q*MENU[S.rest].items[i][1],0);
const cartLabel=()=>{const c=cartCount();return c?`View cart · ${c} item${c>1?'s':''} · ${fmt(cartTotal())} RWF`:'Add items to order'};
function openRest(i){S.rest=i;S.cart={};S.stack=['rest'];render('push')}
function cartAdd(i,d){S.cart[i]=Math.max(0,(S.cart[i]||0)+d);$('#q'+i).textContent=S.cart[i];const b=$('#cartbtn');b.textContent=cartLabel();b.disabled=!cartCount()}
function checkout(){S.stack.push('checkout');render('push')}
function payOrder(){const r=MENU[S.rest],t=cartTotal()+r.fee;$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div style="margin-bottom:12px">${gl('verified3d',60)}</div><div class="h1" style="font-size:22px;line-height:30px">Confirm it's you</div><div class="mu" style="font-size:15px;margin:8px 0 24px">Pay ${fmt(t)} RWF to ${r.n}</div><button class="btn" onclick="orderDone()">Confirm</button></div>`}
function orderDone(){S.oN=null;S.oE=null;const r=MENU[S.rest];S.orderTot=cartTotal()+r.fee;S.pay-=S.orderTot;S.cart={};closeSheet();S.stack=['ordered'];render('push')}
function langSheet(){const o=[['en','English'],['rw','Kinyarwanda'],['fr','Français']];$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="h1" style="font-size:22px;line-height:30px;margin-bottom:12px">Language</div>${o.map(([k,n])=>`<div class="row tap" style="padding:14px 0" onclick="setLang('${k}')"><b style="font-size:17px">${n}</b><div class="r" style="color:var(--lk)">${S.lang===k?'✓':''}</div></div>`).join('')}<div class="fine" style="margin-top:12px">Covers the Send flow and the Pay tab, using your app's own translations. Kinyarwanda and French have not been checked by a native speaker.</div></div>`}
function setLang(k){S.lang=k;closeSheet();render('fade-none')}
function openCard(){S.stack=[S.card?'card':'nocard'];render('push')}
function getCard(){S.card={last:'4417',frozen:false};S.stack=['card'];render('push');toast('Card ready to use')}
function tg(k){S.card[k]=!S.card[k];const s=$('#sw_'+k);s.classList.toggle('on',S.card[k]);s.setAttribute('aria-checked',S.card[k]);if(k==='frozen'){$('#cv').classList.toggle('frozen',S.card.frozen);$('#cst').textContent=S.card.frozen?'Frozen':'Active'}}
function setShopTab(k){S.shopTab=k;render('fade-none')}
function setCat(c){S.cat=c;$('#cats').innerHTML=chipsHtml();$('#pgrid').innerHTML=prodGrid()}
function openProd(i){S.pi=i;S.rv=[i,...S.rv.filter(x=>x!==i)].slice(0,6);S.stack=['shop','product'];render('push')}
function tgFav(i){S.fav[i]=!S.fav[i];document.querySelectorAll('#h'+i).forEach(e=>e.innerHTML=heart(S.fav[i]))}
function addCart(i){S.scart[i]=(S.scart[i]||0)+1;S.stack=['shop'];render('pop');toast('Added to cart')}
function openCart(){if(!scCount()){toast('Your cart is empty');return}S.stack=['shop','scart'];render('push')}
function scAdj(i,d){S.scart[i]=Math.max(0,(S.scart[i]||0)+d);if(!scCount()){S.stack=['shop'];render('pop');return}render('fade-none')}
function claim(k){if(S.claimed[k])return;const amt=k===0?50:k===2?100:[50,100,200,500][Math.floor(Math.random()*4)];S.claimed[k]=1;S.pay+=amt;$('#mis').innerHTML=misHtml();$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="g3" style="margin-bottom:12px">${gl('celebrate',72)}</div><div class="h1" style="font-size:22px;line-height:30px">You earned ${amt} RWF</div><div class="mu" style="font-size:15px;margin:8px 0 24px">Added to itunda Pay. Balance ${fmt(S.pay)} RWF. Sample reward for this prototype.</div><button class="btn" onclick="closeSheet()">OK</button></div>`}
function shopPay(){const t=scTotal()+1500;$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div style="margin-bottom:12px">${gl('verified3d',60)}</div><div class="h1" style="font-size:22px;line-height:30px">Confirm it's you</div><div class="mu" style="font-size:15px;margin:8px 0 24px">Pay ${fmt(t)} RWF to itunda Shop</div><button class="btn" onclick="shopDone()">Confirm</button></div>`}
function shopDone(){S.orders.unshift({k:'Shop order',s:'Processing',t:scTotal()+1500});S.orderTot=scTotal()+1500;S.pay-=S.orderTot;S.oN='itunda Shop';S.oE='1 to 2 days';S.scart={};closeSheet();S.stack=['ordered'];render('push')}
function bnScroll(el){const i=Math.round(el.scrollLeft/(el.clientWidth||1));document.querySelectorAll('#dots i').forEach((d,k)=>d.classList.toggle('on',k===i))}
setInterval(()=>document.querySelectorAll('.cd').forEach(e=>e.textContent=hms()),1000);
function addrYes(){S.addrOk=true;render('fade-none')}
function setECat(c){S.ecat=c;$('#ecats').innerHTML=eCatsHtml();$('#elist').innerHTML=eCards()}
function setESort(k){S.esort=k;$('#esort').innerHTML=eSortHtml();$('#elist').innerHTML=eCards()}
function openERest(i){if(S.er!==i||!S.stack.length){if(S.er!==i)S.ecart={}}S.er=i;S.stack=['shop','erest'];render('push')}
function eAdd(k){S.ecart[k]=(S.ecart[k]||0)+1;const y=$('#sc')?$('#sc').scrollTop:0;render('fade-none');if($('#sc'))$('#sc').scrollTop=y}
function eAdj(k,d){S.ecart[k]=Math.max(0,(S.ecart[k]||0)+d);if(!eCount()){S.stack=['shop','erest'];render('pop');return}render('fade-none')}
function eCart(){S.stack.push('echeck');render('push')}
function setPickup(v){S.pickup=v;if(S.stack[S.stack.length-1]==='erest')render('fade-none')}
function setReq(q){S.req=q;render('fade-none')}
function ePay(){const t=eSub()+eFee(),r=REST[S.er];$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div style="margin-bottom:12px">${gl('verified3d',60)}</div><div class="h1" style="font-size:22px;line-height:30px">Confirm it's you</div><div class="mu" style="font-size:15px;margin:8px 0 24px">Pay ${fmt(t)} RWF to ${r.n}</div><button class="btn" onclick="eDone()">Confirm</button></div>`}
function eDone(){const tot=eSub()+eFee();S.orders.unshift({k:'Eats order',s:'Order accepted',t:tot});S.pay-=tot;S.ecart={};S.trk=0;closeSheet();S.stack=['etrack'];render('push');trkStep(1,2600);trkStep(2,6500);trkStep(3,11500)}
function trkStep(k,ms){setTimeout(()=>{if(S.stack[S.stack.length-1]!=='etrack')return;S.trk=k;const r=REST[S.er],st=ESTEPS();const eo=S.orders.find(o=>o.k==='Eats order');if(eo)eo.s=['Order accepted','Preparing',S.pickup?'Ready for pickup':'On the way',S.pickup?'Picked up':'Delivered'][k];$('#eta').textContent=k>=3?(S.pickup?'Picked up':'Delivered'):k===2?(S.pickup?'Ready now':'Arriving in 8 min'):'About '+(r.tm-2)+' min';st.forEach((s,i)=>{const e=$('#tl'+i);e.className='tl '+(i<k?'done':i===k?'on':'');e.innerHTML='<i>'+(i<=k?ic('plus',0):'')+'</i>'+s});$('#rider').style.display=(k>=2&&!S.pickup)?'':'none';if(k>=3){const b=$('#edone');b.disabled=false;b.textContent='Done';toast(S.pickup?'Enjoy your order':'Your order has arrived')}},ms)}
function openShop(k){S.shopTab=k;S.stack=['shop'];render('push')}
function openBenefits(){S.stack=['benefits'];render('push')}
function openChat(id){S.chat=id;S.read[id]=1;S.stack=['chat'];render('push');chatEnd()}
function chatEnd(){const s=$('#sc');if(s)s.scrollTop=99999}
function chatSend(){const i=$('#msg'),v=((i&&i.value)||'').trim();if(!v)return;S.msgs[S.chat].push(['me',v]);render('fade-none');chatEnd();const n=$('#msg');if(n&&n.focus)n.focus()}
function chatMenu(){$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" style="padding-bottom:20px"><div class="h1" style="font-size:20px;line-height:28px;margin-bottom:6px">Send in this chat</div><div class="row tap" onclick="closeSheet();flow()"><div class="ico">${gl('send',30)}</div><div class="t">Send money</div></div><div class="row tap" onclick="giftSheet()"><div class="ico">${gl('gift',30)}</div><div class="t">Gift</div></div><div class="row tap" onclick="splitSheet()"><div class="ico">${gl('settle',30)}</div><div class="t">Split a bill</div></div></div>`}
function giftSheet(){S.giftAmt=5000;drawGift()}
function drawGift(){$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="g3" style="margin-bottom:10px">${gl('gift',64)}</div><div class="h1" style="font-size:22px;line-height:30px">Send a gift</div><div class="req" style="margin:16px 0 22px">${[2000,5000,10000].map(a=>`<button class="${S.giftAmt===a?'on':''}" onclick="S.giftAmt=${a};drawGift()">${fmt(a)} RWF</button>`).join('')}</div><button class="btn" ${S.giftAmt>S.pay?'disabled':''} onclick="giftSend()">Send ${fmt(S.giftAmt)} RWF gift</button>${S.giftAmt>S.pay?`<div style="color:var(--er);font-size:14px;margin-top:10px">Not enough balance — you have RWF ${fmt(S.pay)}</div>`:''}</div>`}
function giftSend(){S.pay-=S.giftAmt;S.msgs[S.chat].push(['gift',S.giftAmt]);closeSheet();render('fade-none');chatEnd()}
function splitSheet(){S.splitAmt=25000;drawSplit()}
function drawSplit(){$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="g3" style="margin-bottom:10px">${gl('settle',64)}</div><div class="h1" style="font-size:22px;line-height:30px">Split bills with ${thr().n}</div><div class="mu" style="font-size:14px;margin-top:6px">Each of you pays half.</div><div class="req" style="margin:16px 0 22px">${[10000,25000,50000].map(a=>`<button class="${S.splitAmt===a?'on':''}" onclick="S.splitAmt=${a};drawSplit()">${fmt(a)} RWF</button>`).join('')}</div><button class="btn" onclick="splitMake()">Create split bill</button></div>`}
function splitMake(){S.msgs[S.chat].push(['split',S.splitAmt,false]);closeSheet();render('fade-none');chatEnd()}
function paySplit(i){const x=S.msgs[S.chat][i],share=Math.round(x[1]/2);if(share>S.pay){toast('Not enough balance — you have RWF '+fmt(S.pay));return}S.pay-=share;x[2]=true;const y=$('#sc')?$('#sc').scrollTop:0;render('fade-none');if($('#sc'))$('#sc').scrollTop=y;toast('Paid '+fmt(share)+' RWF')}
function notifSheet(){const it=[];S.orders.forEach(o=>it.push([o.k==='Eats order'?'restaurant':'bag',o.k+': '+o.s,fmt(o.t)+' RWF']));THREADS.forEach(t=>{if(!S.read[t.id]&&t.u)it.push(['chat',t.n+' sent you a message',prev(S.msgs[t.id])])});it.push(['celebrate','Daily check-in is ready','Claim +50 RWF in Shop. Sample reward.'],['bolt','31-day savings','Keep your streak going. Sample reminder.']);$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" style="max-height:78%;overflow-y:auto"><div class="h1" style="font-size:22px;line-height:30px;margin-bottom:8px">Notifications</div>${it.map(([g,t,s])=>`<div class="row" style="cursor:default"><div class="ico">${gl(g,30)}</div><div><div class="t" style="font-size:15px">${t}</div><div class="s">${s}</div></div></div>`).join('')}<button class="btn sec2" style="margin-top:14px" onclick="S.nread=true;closeSheet();render('fade-none')">Mark all as read</button></div>`}
function obGo(s){S.obStep=s;if(s==='obPin'){S.ob.pin='';S.ob.pin2='';S.ob.err=''}render('push')}
function obBack(){const m={obNotFound:'obPhone',obName:'obNotFound',obTerms:'obName',obPin:'obTerms',obPin2:'obPin'};S.obStep=m[S.obStep]||'obPhone';render('pop')}
function obSkip(){S.auth=true;S.obStep=null;render('fade')}
function obF(k,v){S.ob[k]=v;const b=$('#obnext');if(b)b.disabled=!(S.ob.first.trim()&&S.ob.last.trim())}
function tcTog(k){S.ob[k]=!S.ob[k];render('fade-none')}
function tcAll(){const v=!(S.ob.t&&S.ob.p&&S.ob.c);S.ob.t=S.ob.p=S.ob.c=v;render('fade-none')}
function obPhoneNext(){const b=$('#obnext');b.disabled=true;b.textContent='Checking…';setTimeout(()=>obGo('obNotFound'),700)}
function obKey(d){const o=S.ob;if(S.obStep==='obPhone'){o.ph=d==='del'?o.ph.slice(0,-1):(o.ph.length<9?o.ph+d:o.ph);$('#phv').textContent=fmtPh(o.ph);$('#obnext').disabled=o.ph.length<9;return}
 const k=S.obStep==='obPin'?'pin':'pin2';o[k]=d==='del'?o[k].slice(0,-1):(o[k].length<6?o[k]+d:o[k]);$('#pd').innerHTML=[0,1,2,3,4,5].map(i=>`<i class="${i<o[k].length?'on':''}"></i>`).join('');
 if(S.obStep==='obPin'&&o.pin.length===6)setTimeout(()=>obGo('obPin2'),180);
 if(S.obStep==='obPin2'){if(o.pin2.length===6&&o.pin2!==o.pin){o.err=t('o_mis');o.pin2='';setTimeout(()=>render('fade-none'),250)}else{o.err='';$('#pe').textContent='';$('#obnext').disabled=!(o.pin2.length===6&&o.pin2===o.pin)}}}
function obCreate(){S.name=(S.ob.first.trim()+' '+S.ob.last.trim()).trim();S.obStep='obDone';render('push')}
function obStart(){S.auth=true;S.obStep=null;render('fade')}
function setFinish(f){S.finish=f;render('fade-none')}
function tgFreeze(){S.card.frozen=!S.card.frozen;$('#sw_frozen').classList.toggle('on',S.card.frozen);$('#cv').classList.toggle('frozen',S.card.frozen);$('#cst').textContent=S.card.frozen?t('c_frz'):t('c_act');$('#frzl').textContent=S.card.frozen?t('c_unfreeze'):t('c_freeze')}
function openSettings(){S.stack=['settings'];render('push')}
function tgSet(k){S.set[k]=!S.set[k];const s=$('#ss_'+k);s.classList.toggle('on',S.set[k]);s.setAttribute('aria-checked',S.set[k])}
function setTheme(t){S.theme=t;document.documentElement.dataset.theme=t==='system'?'':t;render('fade-none')}
function logOut(){S.auth=false;S.stack=[];S.obStep='obPhone';S.ob={ph:'',first:'',last:'',t:false,p:false,c:false,m:false,pin:'',pin2:'',err:''};render('fade')}
function openTransit(){S.stack=['transit'];render('push')}
function transitTop(){if(S.topAmt>S.pay)return;S.pay-=S.topAmt;S.tb+=S.topAmt;render('fade-none');toast('Topped up '+fmt(S.topAmt)+' RWF')}
function transitTap(){if(S.tb<S.fare)return;S.tb-=S.fare;S.rides.unshift([S.op,S.fare]);render('fade-none');toast(t('tr_msg').replace('%1',S.fare).replace('%2',S.op))}
function openBank(){S.stack=['bank'];render('push')}
function open31(){S.stack.push('save31');render('push')}
function tab(k){S.tab=k;S.stack=[];render('fade')}
function flow(){S.to='';S.amt='';S.flagged=false;S.stack=['recipient'];render('push')}
function back(){S.stack.pop();render('pop')}
function setRTab(k){S.rtab=k;render('fade-none')}
function clearTo(){S.to='';S.flagged=false;render('fade-none')}
function pickGo(p,f){if(f){pick(p,f);return}S.to=p;S.flagged=false;amount()}
function pick(p,f){S.to=p;S.flagged=!!f;render('fade-none')}
function amount(){S.amt='';S.stack.push('amount');render('push')}
const balAfter=v=>({rw:'Asigaye: RWF %s',fr:'Solde après : %s RWF'}[S.lang]||'Balance after: %s RWF').replace('%s',fmt(S.bank-v));
function key(k){if(String(k).startsWith('set:'))S.amt=k.slice(4);else if(k==='max')S.amt=String(S.bank);else if(String(k).startsWith('add:'))S.amt=String(Math.min(Number(S.amt||0)+Number(k.slice(4)),999999999));else if(k==='⌫')S.amt=S.amt.slice(0,-1);else if(S.amt.length<9)S.amt=(S.amt+k).replace(/^0+/,'');const v=S.amt?Number(S.amt):0,bad=v>S.bank;$('#amt').textContent=v?fmt(v):'0';$('#amt').parentElement.style.color=bad?'var(--er)':'var(--tx)';$('#amt').parentElement.style.fontSize=v>=1e7?'44px':'56px';const m=$('#msg');m.style.color=bad?'var(--er)':'var(--mu)';m.textContent=(v&&!bad)?balAfter(v):amtMsg(bad);$('#go').disabled=!(v&&!bad)}
function confirm_(){const v=Number(S.amt);$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div style="margin-bottom:12px">${gl('verified3d',60)}</div><div class="h1" style="font-size:22px;line-height:30px">Confirm it's you</div>${S.flagged?`<div style="display:flex;gap:10px;align-items:center;margin:14px 0 0;color:var(--er);font-size:14px;font-weight:700;line-height:19px">${gl('warning3d',30)}<span>${s9('wn')}</span></div>`:''}<div style="margin:16px 0 20px;padding:2px 18px;border-radius:20px;background:var(--chip)">${[[s9('rc'),nm9(S.to)],[s9('am'),fmt(v)+' RWF'],[s9('fee'),'0 RWF']].map(([a,b],i)=>`<div style="display:flex;justify-content:space-between;height:48px;align-items:center;font-size:15px;${i?'border-top:0':''}"><span class="mu">${a}</span><b>${b}</b></div>`).join('')}</div><div class="row2"><button class="btn sec2" onclick="closeSheet()">${s9('cn')}</button><button class="btn" onclick="finish()">${S.flagged?s9('sa'):s9('cf')}</button></div></div>`}
function closeSheet(){$('#layer').innerHTML=''}
function finish(){closeSheet();S.sentAmt=Number(S.amt);(S.lastAmt=S.lastAmt||{})[S.to]=S.sentAmt;S.bank-=S.sentAmt;S.stack=['sent'];render('push')}
function done(){S.oN=null;S.oE=null;S.stack=[];S.tab='home';render('fade')}
function sheetAdd(){$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div style="margin-bottom:12px">${gl('cashin3d',60)}</div><div class="h1" style="font-size:22px;line-height:30px">${t('am')}</div><div class="mu" style="font-size:15px;margin:8px 0 24px">${t('an')}</div><button class="btn sec2" onclick="closeSheet()">${t('cn')}</button></div>`}

/* v8: keyboard access, dialogs, request money */
(function(){const ph=document.getElementById('phone');
function fix(){ph.querySelectorAll('[onclick]:not(button):not([tabindex]):not(.sheetbg)').forEach(e=>{e.setAttribute('tabindex','0');e.setAttribute('role','button')});
ph.querySelectorAll('.sheet:not([role])').forEach(e=>{e.setAttribute('role','dialog');e.setAttribute('aria-modal','true');const f=e.querySelector('button');if(f)f.focus()});
ph.querySelectorAll('.tabs button').forEach(b=>b.toggleAttribute('aria-current',b.classList.contains('on')));
const m=ph.querySelector('#msg'),g=ph.querySelector('#go');if(m&&g&&!ph.querySelector('#qa')&&!ph.querySelector('#amt')&&typeof qa==='function')m.insertAdjacentHTML('afterend',`<div id="qa" class="req qa" style="padding-top:14px">${[1000,5000,10000].map(n=>`<button onclick="qa(${n})">+${fmt(n)}</button>`).join('')}</div>`)}
new MutationObserver(fix).observe(ph,{childList:true,subtree:true});
ph.addEventListener('keydown',e=>{const el=e.target;if((e.key==='Enter'||e.key===' ')&&el.getAttribute&&el.getAttribute('role')==='button'&&el.tagName!=='BUTTON'){e.preventDefault();el.click()}});
document.addEventListener('keydown',e=>{if(e.key==='Escape'&&document.querySelector('#layer .sheet'))closeSheet()});fix()})();
S.rqAmt=5000;S.sp=0;
function confetti(){if(matchMedia('(prefers-reduced-motion:reduce)').matches)return;try{navigator.vibrate&&navigator.vibrate(12)}catch(e){}const c=['#8F89FF','#6960F9','#BFEAD7','#FFE2A8','#FF8FA3'],p=document.getElementById('phone');for(let i=0;i<28;i++){const d=document.createElement('i');d.className='cf';const a=Math.PI*(1.1+Math.random()*.8),v=90+Math.random()*150;d.style.cssText=`background:${c[i%5]};--x:${Math.round(Math.cos(a)*v*1.1)}px;--y:${Math.round(Math.sin(a)*v*-1+260+Math.random()*80)}px;--r:${Math.round(Math.random()*720-360)}deg;animation-delay:${Math.round(Math.random()*120)}ms`;p.appendChild(d);setTimeout(()=>d.remove(),1800)}}
['finish','shopDone','orderDone'].forEach(n=>{const f=window[n];if(typeof f==='function')window[n]=function(){const r=f.apply(this,arguments);setTimeout(confetti,260);return r}});
{const _h=screens.home;screens.home=()=>{const h=_h(),k='<div class="sec"><div class="sech">Quick actions</div>';const card=`<div class="pad" style="padding-top:24px"><div class="tap" onclick="open31()" style="display:flex;align-items:center;gap:14px;background:var(--tint);border-radius:24px;padding:18px 18px 18px 20px;cursor:pointer"><div style="flex:1"><div class="sm" style="font-weight:800;color:var(--tintfg)">${t('x_nx')}</div><div style="font-size:18px;font-weight:800;letter-spacing:-.3px;line-height:25px;margin-top:4px">${t('x_nt')}</div><div class="sm" style="margin-top:6px;font-weight:700;color:var(--tintfg)">${t('x_nc')} ›</div></div>${gl('flame',56)}</div></div>`;const rec=['Amina K.','Eric M.','Grace U.','Jean Paul','Divine N.'].map(n=>`<button class="tap" onclick="flow();pick('${n}')" aria-label="Send to ${n}" style="flex:0 0 64px;border:0;background:none;display:flex;flex-direction:column;align-items:center;gap:8px;font-size:12px;font-weight:700;color:var(--tx)"><span style="width:56px;height:56px;border-radius:28px;background:var(--tint);color:var(--tintfg);display:flex;align-items:center;justify-content:center;font-size:18px;font-weight:800">${n[0]}</span>${n.split(' ')[0]}</button>`).join('');const strip=`<div class="sec" style="padding-bottom:12px"><div class="sech" style="margin:0">${t('x_sa')}</div></div><div class="chips" style="gap:14px">${rec}</div>`;return h.includes(k)?h.replace(k,card+strip+k):h}}
S.w26=0;
screens.w26=()=>{const w=S.w26,done=w>=26,amt=(w+1)*500,saved=500*w*(w+1)/2,total=500*26*27/2,bad=!done&&amt>S.bank;return `${bar(t('y_wt'))}<div class="pad" style="padding-top:28px"><div class="h1">${t(done?'y_wd':'y_wh')}</div><div class="mu" style="font-size:15px;margin-top:8px">${t('y_wp')}</div></div><div class="pad" style="padding-top:24px"><div class="sm mu">${t('y_ss')}</div><div class="big">${fmt(saved)} RWF</div><div style="height:8px;border-radius:4px;background:var(--chip);margin-top:12px"><div style="height:8px;border-radius:4px;background:var(--br);width:${Math.round(saved/total*100)}%;transition:width .4s"></div></div><div class="sm mu" style="margin-top:8px">${t('y_wg').replace('%1',fmt(total)).replace('%2',Math.min(w+1,26))}</div></div><div class="pad" style="padding-top:24px">${w<26?`<div class="sm" style="font-weight:700;color:var(--tintfg);margin-bottom:12px">${t('y_bn').replace('%1',4-w%4).replace('%2',fmt((w+4-w%4)*25))}</div>`:''}<div style="display:grid;grid-template-columns:repeat(7,1fr);gap:8px">${Array.from({length:26},(_,i)=>`<div style="height:40px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:800;background:${i<w?'var(--br)':'var(--chip)'};color:${i<w?'var(--on)':'var(--mu)'};${i===w?'box-shadow:inset 0 0 0 2px var(--br)':''}">${i+1}</div>`).join('')}</div>${bad?`<div style="color:var(--er);font-size:14px;margin-top:14px">${t('insuff').replace('%s',fmt(S.bank))}</div>`:''}${w?`<button class="chip" style="margin-top:16px" onclick="reset26()">${t('y_rs')}</button>`:''}<div class="fine" style="padding-top:18px">${t('y_sd')}</div></div><div class="cta"><button class="btn" ${done||bad?'disabled':''} onclick="save26()">${done?t('y_wc'):t('y_wb').replace('%1',fmt(amt)).replace('%2',w+1)}</button></div>`};
function open26(){S.stack=['w26'];render('push')}
function save26(){const amt=(S.w26+1)*500;if(amt>S.bank)return;S.bank-=amt;S.w26++;let m=t('y_sv').replace('%s',fmt(amt));if(S.w26%4===0){const b=S.w26*25;S.bank+=b;m+=' · '+t('y_bg').replace('%s',fmt(b))}render('fade-none');toast(m);if(S.w26>=26||S.w26%4===0)setTimeout(confetti,200)}
function reset26(){S.w26=0;render('fade-none');toast(t('y_rst'))}
function soon(){const ev=window.event,c=ev&&ev.target&&ev.target.closest?ev.target.closest('[onclick]'):null;let n='This feature';if(c){const t=c.querySelector('.t,.pn')||c.querySelector('span');n=((t?t.textContent:c.textContent)||'').trim().split('\n')[0].slice(0,40)||n}
$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="g3" style="margin-bottom:10px">${gl('clock',64)}</div><div class="h1" style="font-size:22px;line-height:30px">${n.replace(/</g,'&lt;')}${t('x_cs')}</div><div class="mu" style="font-size:15px;margin:8px 0 24px">${t('x_cb')}</div><div class="row2"><button class="btn sec2" onclick="closeSheet()">${t('x_no')}</button><button class="btn" onclick="closeSheet();toast(t('x_ok'))">${t('x_nm')}</button></div></div>`}

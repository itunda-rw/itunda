/* v31: profile screen */
S.pn=null;
{const T={"rw": {"Profile": "Umwirondoro", "Full name": "Amazina yombi", "Phone": "Telefoni", "Verification": "Kwemeza umwirondoro", "Verified": "Byemejwe", "Daily limit": "Ingano ntarengwa ku munsi", "Member since": "Umunyamuryango kuva", "March 2025": "Werurwe 2025", "Save": "Bika", "Name updated": "Izina ryavuguruwe", "Your details are sample data.": "Amakuru yawe ni ibitegererezo.", "Name can't be empty": "Izina ntirigomba kuba ubusa"}, "fr": {"Profile": "Profil", "Full name": "Nom complet", "Phone": "Téléphone", "Verification": "Vérification", "Verified": "Vérifié", "Daily limit": "Limite quotidienne", "Member since": "Membre depuis", "March 2025": "Mars 2025", "Save": "Enregistrer", "Name updated": "Nom mis à jour", "Your details are sample data.": "Vos informations sont des données d'exemple.", "Name can't be empty": "Le nom ne peut pas être vide"}},q=k=>(T[S.lang]&&T[S.lang][k])||k;window.pq31=q;
const pr=(a,b,top)=>`<div style="display:flex;justify-content:space-between;gap:16px;min-height:52px;align-items:center;font-size:15px;${top?'border-top:0':''}"><span class="mu">${a}</span><b style="text-align:right">${b}</b></div>`;
screens.profile=()=>{const nm=S.pn===null?(S.name||'Amina Uwase'):S.pn,ch=nm.trim()&&nm.trim()!==(S.name||'Amina Uwase');
return `${bar(q('Profile'))}<div style="display:flex;justify-content:center;padding-top:28px"><div style="width:88px;height:88px;border-radius:44px;background:var(--tint);color:var(--tintfg);display:flex;align-items:center;justify-content:center;font-size:34px;font-weight:800" id="pav">${(nm.trim()[0]||'?').toUpperCase().replace(/</g,'')}</div></div><div class="pad"><div class="lab">${q('Full name')}</div><input class="in" id="pname" maxlength="40" value="${nm.replace(/"/g,'&quot;')}" oninput="pName(this.value)" aria-label="${q('Full name')}"><div class="sm" id="perr" style="color:var(--er);margin-top:6px;min-height:18px"></div></div><div style="margin:12px 24px 0;padding:0 16px;border-radius:20px;background:var(--chip)">${pr(q('Phone'),'078 ••• 214')}${pr(q('Verification'),q('Verified'),1)}${pr(q('Daily limit'),fmt((S.lim||{day:1000000}).day)+' RWF',1)}${pr(q('Member since'),q('March 2025'),1)}</div><div class="pad fine" style="padding-top:14px">${q('Your details are sample data.')}</div><div class="cta"><button id="psave" class="btn" ${ch?'':'disabled'} onclick="pSave()">${q('Save')}</button></div>`};
}
function openProfile(){S.pn=null;S.stack.push('profile');render('push')}
function pName(v){S.pn=v;const cur=S.name||'Amina Uwase',ok=v.trim()&&v.trim()!==cur,b=$('#psave'),e=$('#perr'),a=$('#pav');if(b)b.disabled=!ok;if(e)e.textContent=v.length&&!v.trim()?pq31("Name can't be empty"):'';if(a)a.textContent=(v.trim()[0]||'?').toUpperCase()}
function pSave(){const v=(S.pn||'').trim();if(!v)return;S.name=v;S.pn=null;toast(pq31('Name updated'));render('fade-none')}

/* v33: Send again, one-tap repeat transfers on home */
(function(){const st=document.createElement('style');st.textContent='.sa{display:flex;gap:20px;overflow-x:auto;scrollbar-width:none;margin:0 -24px;padding:4px 24px 2px}.sa::-webkit-scrollbar{display:none}.sa button{border:0;background:none;padding:0;display:flex;flex-direction:column;align-items:center;gap:8px;font-size:12px;font-weight:700;min-width:60px}.sa .av{width:56px;height:56px;border-radius:28px;background:var(--tint);color:var(--tintfg);display:flex;align-items:center;justify-content:center;font-size:20px;font-weight:800}.sa .av.nw{background:var(--chip);color:var(--tx)}.sa button:focus-visible{outline:2px solid var(--lk);outline-offset:4px;border-radius:12px}';document.head.appendChild(st)})();
const SA33=[['Amina K.','0788 000 214'],['Eric M.','0781 234 567']];
const sa33t=()=>({rw:'Ohereza kandi',fr:'Envoyer à nouveau'}[S.lang]||'Send again');
const sa33n=()=>({rw:'Undi',fr:'Autre'}[S.lang]||'New');
function sendAgain(p){S.to=p;S.amt='';S.flagged=false;S.stack=['recipient','amount'];render('push')}
{const _h=screens.home;screens.home=()=>{const h=_h(),s=`<div class="sec" style="padding-top:28px"><div class="sech">${sa33t()}</div><div class="sa">${SA33.map(([n,p])=>`<button class="tap" aria-label="${sa33t()}: ${n}" onclick="sendAgain('${p}')"><span class="av">${n[0]}</span>${n.split(' ')[0]}</button>`).join('')}<button class="tap" aria-label="${sa33n()}" onclick="flow()"><span class="av nw">${ic('plus',24)}</span>${sa33n()}</button></div></div>`,k='<div class="sec"><div class="sech">Quick actions';return h.includes(k)?h.replace(k,s+k):h}}

/* v34: Toss-style quick add chips on the amount keypad */
function addAmt34(n){S.amt=String(Math.min(999999999,(Number(S.amt)||0)+n));key('')}
{const _a=screens.amount;screens.amount=()=>{const h=_a(),old='<div style="margin-top:16px"><button class="chip" onclick="key(\'max\')">',nw='<div style="margin-top:16px;display:flex;gap:8px;justify-content:center;flex-wrap:wrap">'+[1000,5000,10000].map(n=>`<button class="chip" aria-label="Add ${fmt(n)}" onclick="addAmt34(${n})">+${fmt(n)}</button>`).join('')+'<button class="chip" onclick="key(\'max\')">';return h.includes(old)?h.replace(old,nw):h}}

/* v35: amount in words under the keypad total, so a wrong zero is easy to catch */
const W35=(()=>{const a='zero one two three four five six seven eight nine ten eleven twelve thirteen fourteen fifteen sixteen seventeen eighteen nineteen'.split(' '),b='_ _ twenty thirty forty fifty sixty seventy eighty ninety'.split(' ');const h=n=>{let r='';if(n>=100){r+=a[Math.floor(n/100)]+' hundred';n%=100;if(n)r+=' '}if(n>=20){r+=b[Math.floor(n/10)];if(n%10)r+='-'+a[n%10]}else if(n||!r)r+=a[n];return r};return n=>{if(!n)return '';const p=[[1e6,'million'],[1e3,'thousand'],[1,'']];let r=[];for(const[d,w]of p){const q=Math.floor(n/d);n%=d;if(q)r.push(h(q)+(w?' '+w:''))}const t=r.join(' ');return t[0].toUpperCase()+t.slice(1)+' RWF'}})();
const wd35=()=>S.lang==='en'?W35(Number(S.amt)||0):'';
{const _a=screens.amount;screens.amount=()=>{const h=_a(),k='<div id="msg"';return h.includes(k)?h.replace(k,`<div id="wd" aria-hidden="true" style="margin-top:8px;font-size:13px;color:var(--tt);min-height:18px;line-height:18px">${wd35()}</div>`+k):h}}
{const _k=window.key;window.key=function(){const r=_k.apply(this,arguments);const e=document.getElementById('wd');if(e)e.textContent=wd35();return r}}

/* v36: Toss-style confirm sheet, one clear sentence, flat rows, one main action */
confirm_=function(){const v=Number(S.amt),n=nm9(S.to),first=S.lang==='en';const rows=[[s9('fee'),'0 RWF']];
$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" role="dialog" aria-modal="true" aria-label="Confirm"><div aria-hidden="true" style="width:36px;height:4px;border-radius:2px;background:var(--ln);margin:-14px auto 20px"></div>${first?'<div class="fine" style="margin:-6px 0 12px">Step 3 of 3 · Check before you send</div>':''}<div style="display:flex;align-items:center;gap:14px"><div style="width:48px;height:48px;border-radius:24px;background:var(--tint);color:var(--tintfg);display:flex;align-items:center;justify-content:center;font-size:19px;font-weight:800">${String(n).trim()[0]||'?'}</div><div class="mu" style="font-size:15px;font-weight:700">${s9('rc')} ${n}</div></div><div class="big" style="font-size:34px;letter-spacing:-1px;margin-top:14px">${fmt(v)} RWF</div>${first?`<div style="font-size:13px;color:var(--tt);margin-top:4px">${W35(v)}</div>`:''}${S.flagged?`<div style="display:flex;gap:10px;align-items:center;margin:16px 0 0;color:var(--er);font-size:14px;font-weight:700;line-height:19px">${gl('warning3d',30)}<span>${s9('wn')}</span></div>`:''}<div style="margin:20px 0 18px">${rows.map(([a,b],i)=>`<div style="display:flex;justify-content:space-between;height:48px;align-items:center;font-size:15px;border-top:0"><span class="mu">${a}</span><b>${b}</b></div>`).join('')}</div><div class="mu" style="font-size:13px;margin:-6px 0 18px">${balAfter(v)}</div><button class="btn" onclick="finish()">${S.flagged?s9('sa'):(first?'Send '+fmt(v)+' RWF':s9('cf'))}</button><button class="btn sec2" style="margin-top:8px;background:none;height:48px;font-size:16px" onclick="closeSheet()">${s9('cn')}</button></div>`};

/* v37: sending state, then a flat animated check on the result */
(function(){const st=document.createElement('style');st.textContent='.sn{position:absolute;inset:0;z-index:40;background:var(--bg);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:20px;animation:fadebg .2s}.sn svg{width:72px;height:72px;color:var(--br);overflow:visible}.sn .lk{stroke-dasharray:100 200;animation:snlk 1.9s cubic-bezier(.45,0,.25,1) infinite both}.sn .lk1{animation-delay:.18s}.sn .lk2{animation-delay:.3s}.sn .lk3{animation-delay:.42s}@keyframes snlk{0%{stroke-dashoffset:100}42%,68%{stroke-dashoffset:0}100%{stroke-dashoffset:-100}}@media (prefers-reduced-motion:reduce){.sn .lk{animation:none;stroke-dashoffset:0}}';document.head.appendChild(st);window.itLogo=function(){const d=i=>{const e=document.getElementById(i);return e?e.getAttribute('d'):''},kf=d('kf'),k=[d('k1'),d('k2'),d('k3')],P=c=>k.map((x,i)=>'<path class="lk lk'+(i+1)+'" pathLength="100" d="'+x+'"/>').join('');return '<svg viewBox="-45 -40 90 90" aria-hidden="true"><defs><mask id="snmk" maskUnits="userSpaceOnUse" x="-45" y="-50" width="90" height="90"><rect x="-45" y="-50" width="90" height="90" fill="#fff"/><g fill="none" stroke="#000" stroke-width="17" stroke-linecap="round" stroke-linejoin="round">'+P()+'</g></mask></defs><g transform="translate(0 5)" fill="none" stroke="currentColor" stroke-width="12" stroke-linecap="round" stroke-linejoin="round"><path class="lk" pathLength="100" d="'+kf+'" mask="url(#snmk)"/>'+P()+'</g></svg>'};})();
{const f=window.finish;let busy=0;window.finish=function(){if(busy)return;busy=1;const a=arguments,me=this,txt=({rw:'Birimo koherezwa…',fr:'Envoi en cours…'})[S.lang]||'Sending…';closeSheet();$('#layer').innerHTML=`<div class="sn" role="status" aria-live="polite">${window.itLogo()}<div style="font-size:17px;font-weight:800">${txt}</div></div>`;setTimeout(()=>{busy=0;$('#layer').innerHTML='';f.apply(me,a)},matchMedia('(prefers-reduced-motion: reduce)').matches?150:1000)}}
const CK37=`<div class="check" style="width:112px;height:112px;border-radius:56px"><svg width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="#17171C" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5L19 7"/></svg></div>`;
{const _s=screens.sent;screens.sent=()=>{const h=_s(),m=h.match(/<div class="g3">[\s\S]*?<\/svg><\/div>/);return m?h.replace(m[0],'<div class="g3">'+CK37+'</div>'):h}}

/* v38: flat glyphs replace the last 3D ones, same itunda palette */
const FL38=(d)=>`<g fill="none" stroke="#17171C" stroke-width="5" stroke-linecap="round" stroke-linejoin="round">${d}</g>`;
Object.assign(G,{
success3d:`<circle cx="40" cy="40" r="34" fill="#8F89FF"/>${FL38('<path d="M26 41l10 10 19-22"/>')}`,
verified3d:`<path d="M40 8l26 9v20c0 17-11 28-26 35C25 65 14 54 14 37V17Z" fill="#8F89FF"/>${FL38('<path d="M28 40l9 9 16-18"/>')}`,
warning3d:`<path d="M40 10c2.5 0 4.5 1.3 5.8 3.5l22 38c2.7 4.7-.6 10.5-5.8 10.5H18c-5.2 0-8.500-5.800-5.800-10.500l22-38C35.500 11.300 37.500 10 40 10Z" fill="#FFC53D"/>${FL38('<path d="M40 30v14"/>')}<circle cx="40" cy="54" r="3.200" fill="#17171C"/>`,
delivered3d:`<circle cx="40" cy="40" r="34" fill="#BFEAD7"/>${FL38('<path d="M24 33l16-8 16 8v18l-16 8-16-8Z"/><path d="M24 33l16 8 16-8M40 41v18"/>')}`,
qr3d:`<rect x="8" y="8" width="64" height="64" rx="18" fill="#EEEDFF"/>${FL38('<rect x="22" y="22" width="14" height="14" rx="3"/><rect x="44" y="22" width="14" height="14" rx="3"/><rect x="22" y="44" width="14" height="14" rx="3"/><path d="M46 46h4M58 46v12M46 58h8"/>')}`,
cashin3d:`<circle cx="40" cy="40" r="34" fill="#8F89FF"/>${FL38('<path d="M40 22v26M29 38l11 11 11-11M26 58h28"/>')}`});

/* v39: the same sending state for bills, shop and food payments */
;['billDone','shopDone','orderDone','eDone'].forEach(n=>{const f=window[n];if(typeof f!=='function')return;let busy=0;window[n]=function(){if(busy)return;busy=1;const a=arguments,me=this,txt=({rw:'Birimo kwishyurwa…',fr:'Paiement en cours…'})[S.lang]||'Paying…';closeSheet();$('#layer').innerHTML=`<div class="sn" role="status" aria-live="polite">${window.itLogo()}<div style="font-size:17px;font-weight:800">${txt}</div></div>`;setTimeout(()=>{busy=0;$('#layer').innerHTML='';f.apply(me,a)},matchMedia('(prefers-reduced-motion: reduce)').matches?150:900)}});

/* v40: bill, shop and food confirm sheets share the transfer sheet layout */
function cs40(to,total,fee,fn,sub){const first=S.lang==='en';$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" role="dialog" aria-modal="true" aria-label="Confirm"><div aria-hidden="true" style="width:36px;height:4px;border-radius:2px;background:var(--ln);margin:-14px auto 20px"></div><div style="display:flex;align-items:center;gap:14px"><div style="width:48px;height:48px;border-radius:24px;background:var(--tint);color:var(--tintfg);display:flex;align-items:center;justify-content:center;font-size:19px;font-weight:800">${String(to).trim()[0]||'?'}</div><div class="mu" style="font-size:15px;font-weight:700;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${s9('rc')} ${to}${sub?' · '+sub:''}</div></div><div class="big" style="font-size:34px;letter-spacing:-1px;margin-top:14px">${fmt(total)} RWF</div>${first?`<div style="font-size:13px;color:var(--tt);margin-top:4px">${W35(total)}</div>`:''}<div style="margin:20px 0 18px"><div style="display:flex;justify-content:space-between;height:48px;align-items:center;font-size:15px;border-top:0"><span class="mu">${s9('fee')}</span><b>${fmt(fee)} RWF</b></div></div><button class="btn" onclick="${fn}()">${s9('cf')}</button><button class="btn sec2" style="margin-top:8px;background:none;height:48px;font-size:16px" onclick="closeSheet()">${s9('cn')}</button></div>`};
payOrder=function(){const r=MENU[S.rest];cs40(r.n,cartTotal()+r.fee,r.fee,'orderDone')};
shopPay=function(){cs40('itunda Shop',scTotal()+1500,1500,'shopDone')};
ePay=function(){cs40(REST[S.er].n,eSub()+eFee(),eFee(),'eDone')};
billPay=function(){const B=S.bl;cs40(B.p,B.amt,0,'billDone',B.num)};

/* v41: home had Send three times, so the quick action becomes Request money */
{const _h=screens.home;screens.home=()=>{const h=_h(),re=/<div class="gi tap" onclick="flow\(\)"><div class="ico">[\s\S]*?<\/svg><\/div>[^<]*<\/div>/,lb=({rw:'Saba amafaranga',fr:'Demander'})[S.lang]||'Request';return re.test(h)?h.replace(re,gi('up',lb,'reqSheet()')):h}}

/* v42: calmer home, fewer blocks (status line and the 5-icon services grid are gone, services live behind one icon) */
{const _h=screens.home;screens.home=()=>{let h=_h();h=h.replace(/<div class="pad" style="padding-top:12px;display:flex;align-items:center;gap:8px"><div class="dot"><\/div>[\s\S]*?<\/div>/,'');const parts=h.split(/(?=<div class="sec")/).filter(p=>!/class="grid g5"/.test(p));h=parts.join('');const sv=({rw:'Serivisi',fr:'Services'})[S.lang]||'Services';h=h.replace('class="grid g4"','class="grid g5"').replace(/(class="grid g5">[\s\S]*?)(<\/div><\/div>)(?=\s*<div class="sec")/,(m,a,b)=>a+gi('home',sv,"tab('explore')")+b);return h}}

/* v43: much calmer home, only balance, main actions, four shortcuts, two recent items and one short list */
{const _h=screens.home;screens.home=()=>{const h=_h();const parts=h.split(/(?=<div class="sec")/);const head=parts.shift();const cut=r=>r.replace(/<\/div>\s*$/,'');const rowsOf=c=>c.split(/(?=<div class="row)/);
let quick='',recent='',list=null,spend=null,goal=null;
parts.forEach(p=>{if(/class="sa"/.test(p))return;if(/class="grid g5"/.test(p)){quick=p.replace(/<div class="gi tap" onclick="reqSheet\(\)">[\s\S]*?<\/svg><\/div>[^<]*<\/div>/,'').replace('class="grid g5"','class="grid g4"');return}
if(/actOpen\(/.test(p)){const r=rowsOf(p);recent=r.length>3?r[0]+r[1]+r[2]+'</div>':r.join('');return}
if(/openSpend\(/.test(p)){spend=p;return}if(/openGoal\(/.test(p)){goal=p;return}});
let list2='';if(goal){const g=rowsOf(goal),sp=spend?rowsOf(spend):[''];list2=g[0]+sp.slice(1).map((x,i,a)=>i===a.length-1?cut(x):x).join('')+(g.length>2?g[1]:cut(g[1]||''))+'</div>'}else if(spend){list2=spend}
return head+quick+recent+list2}}

/* v44: quieter home type and spacing, softer secondary text, calmer shortcut icons */
(function(){const st=document.createElement('style');st.textContent='.h9 .sec{padding:24px 16px 10px}.h9 .sech{font-size:17px;margin-bottom:10px}.h9 .sech a{color:var(--tt);font-weight:600}.h9 .row{padding:12px 0}.h9 .row .t{font-weight:600}.h9 .row .s{color:var(--tt)}.h9 .row .r{font-weight:600}.h9 .gi{font-weight:600;color:var(--mu);gap:10px}.h9 .gi .ico{width:56px;height:56px;border-radius:20px}.h9 .row2{gap:10px}.screen.h9{padding-bottom:112px}';document.head.appendChild(st)})();


/* v47: home rebuilt as cards, see CSS above */
Object.assign(TR9.fr,{'Bills':'Factures','Card':'Carte','Savings':'Épargne','All':'Tout','Spent this period':'Dépensé sur la période','Activity':'Activité','My credit score':'Mon score de crédit','Pay':'Payer','Due Friday':'Échéance vendredi','Free delivery on your first order':'Livraison offerte pour votre première commande','View':'Voir'});
Object.assign(TR9.rw,{'Bills':'Fagitire','Card':'Ikarita','Savings':'Kuzigama','All':'Byose','Spent this period':'Wakoresheje muri iki gihe','Activity':'Ibyakozwe','My credit score':'Amanota yanjye y\'inguzanyo','Pay':'Ishyura','Due Friday':'Bigomba kwishyurwa kuwa gatanu','Free delivery on your first order':'Kohererezwa ubuntu ku itegeko rya mbere','View':'Reba'});
screens.home=()=>{const top=`<div class="top"><button class="hbk" onclick="openBank()" aria-label="itunda Bank">${knot(34)}<b>itunda</b>${ic('chev',18,'var(--tt)')}</button><div style="display:flex;gap:4px"><button class="ib" aria-label="Scan to pay" onclick="tab('pay')">${ic('qr',24)}</button><button class="ib" aria-label="Notifications" onclick="notifSheet()" style="position:relative">${ic('bell',24)}${S.nread?'':'<i style="position:absolute;top:10px;right:11px;width:8px;height:8px;border-radius:4px;background:#D92D20"></i>'}</button></div></div>`;
const stop='event.stopPropagation();';
const acc=`<div class="hc"><div class="hr tap" role="button" tabindex="0" onclick="openBank()"><div class="hi">${gl('bank',28)}</div><div class="hm"><div class="ha"><span id="bal">${fmt(S.bank)}</span> <span class="cu">RWF</span></div><div class="sm mu">itunda Bank</div></div><button class="hp pr" onclick="${stop}flow()">${t('send')}</button></div><div class="hr tap" role="button" tabindex="0" onclick="tab('pay')"><div class="hi">${gl('wallet',28)}</div><div class="hm"><div class="ha"><span class="bv">${fmt(S.pay)}</span> <span class="cu">RWF</span></div><div class="sm mu">itunda Pay</div></div><button class="hp" onclick="${stop}tab('pay')">${t('am')}</button></div><div class="hf"><button onclick="openBill('REG electricity')">Bills</button><i></i><button onclick="openCard()">Card</button><i></i><button onclick="openGoal()">Savings</button><span class="hs"><button onclick="tab('explore')">All</button></span></div></div>`;
const bill=S.regPaid?'':`<div class="hr tap" role="button" tabindex="0" onclick="openBill('REG electricity',18500)"><div class="hi">${gx('bill',26)}</div><div class="hm"><div class="ha2">REG electricity</div><div class="sm mu"><span>Due Friday</span> · 18,500 RWF</div></div><button class="hp" onclick="${stop}openBill('REG electricity',18500)">Pay</button></div>`;
const spend=`<div class="hc"><div class="hr tap" role="button" tabindex="0" onclick="openSpend()"><div class="hm"><div class="ha">312,000 RWF</div><div class="sm mu">Spent this period</div></div><button class="hp pr" onclick="${stop}openAct()">Activity</button></div>${bill}</div>`;
const act=`<div class="hc"><div class="hct"><span>Recent activity</span><a onclick="openAct()">See all</a></div>${S.act.slice(0,2).map((x,i)=>row(x[0],x[1],x[2],signed(x[3]),'actOpen('+i+')')).join('')}</div>`;
const cs=`<div class="hc"><div class="hr tap" role="button" tabindex="0" onclick="openScore()"><div class="hm"><div class="ha2">My credit score</div></div><span class="hbd">${score()}</span>${ic('chev',16,'var(--tt)')}</div></div>`;
const pm=S.pd47?'':`<div class="hc hpm"><button class="hx" aria-label="Dismiss" onclick="S.pd47=1;render('fade-none')">${ic('plus',22).replace('<svg','<svg style="transform:rotate(45deg)"')}</button><div class="tap" role="button" tabindex="0" onclick="openShop('eats')" style="cursor:pointer"><div class="hpt">Free delivery on your first order</div><div class="sm" style="margin-top:6px;color:var(--tintfg);font-weight:700">View</div></div></div>`;
return top+acc+spend+act+cs+pm};

/* v48: Pockets (Toss storage pockets): list, detail with dated history, fill / take-out flow, interest sheet */
const esc48=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const ago48=(d,h,m)=>{const x=new Date();x.setDate(x.getDate()-d);x.setHours(h,m,0,0);return x.getTime()};
const day48=ts=>{const d=new Date(ts),n=new Date(),y=new Date(n.getTime()-864e5);return d.toDateString()===n.toDateString()?'Today':d.toDateString()===y.toDateString()?'Yesterday':d.toLocaleDateString('en-GB',{day:'numeric',month:'short'})};
const tm48=ts=>new Date(ts).toLocaleTimeString('en-GB',{hour:'2-digit',minute:'2-digit'});
S.pk=[
{id:'jar',n:'Interest jar',g:'coin',ir:0,h:[]},
{id:'emg',n:'Emergency fund',g:'shield',b:50000,ir:312,h:[{k:'in',a:20000,bal:50000,ts:ago48(5,9,12)},{k:'in',a:30000,bal:30000,ts:ago48(12,18,40)}]},
{id:'sch',n:'School fees',g:'school',b:120000,t:300000,ir:1150,h:[{k:'in',a:20000,bal:120000,ts:ago48(3,8,5)},{k:'in',a:100000,bal:100000,ts:ago48(20,12,30)}]}
];
S.pkF={};S.pkId='jar';S.mv={dir:'in',id:'jar',amt:''};
const pkGet=id=>S.pk.find(p=>p.id===id);
const pkBal=p=>p.id==='jar'?S.jar:p.b;
const pkSet=(p,v)=>{if(p.id==='jar')S.jar=v;else p.b=v};
const pkTotal=()=>S.pk.reduce((a,p)=>a+pkBal(p),0);
const pkIco=(p,s)=>`<div class="pkico" style="width:${s}px;height:${s}px;border-radius:${s/2}px">${gx(p.g,Math.round(s*.5))}</div>`;
const pkLog=(p,k,a)=>{(p.h=p.h||[]).unshift({k,a,bal:pkBal(p),ts:Date.now()})};
const CK48=`<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>`;
const PKL={in:'Fill',ru:'Round-up',out:'Take out'};
const DEL48=`<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6H9l-5 6 5 6h11zM12 10l4 4M16 10l-4 4"/></svg>`;

/* list */
function openPockets(){S.stack.push('pockets');render('push')}
function openPocket(id){S.pkId=id;S.stack.push('pocket');render('push')}
screens.pockets=()=>{const have=n=>S.pk.some(p=>p.n===n);
const chips=[['Trip','bus'],['Phone','phone']].filter(([n])=>!have(n)).map(([n,g])=>`<button class="chip tap" onclick="pkAdd('${n}','${g}')">${ic('plus',18)}${n}</button>`).join('')+`<button class="chip tap" onclick="pkNew()">${ic('plus',18)}Custom</button>`;
return `${bar('')}<div class="pad" style="padding-top:8px"><div class="sm mu" style="font-weight:600">Total in pockets</div><div class="pkTot">${fmt(pkTotal())} RWF</div></div><div style="padding-top:20px">${S.pk.map(p=>`<div class="pkrow" role="button" tabindex="0" onclick="openPocket('${p.id}')">${pkIco(p,52)}<div style="min-width:0"><div class="pkpn">${esc48(p.n)}</div><div class="pkpb">${fmt(pkBal(p))} RWF</div></div></div>`).join('')}</div><div class="pkchips">${chips}</div><div class="pad fine" style="padding-top:24px">Rates and balances are sample data for this prototype.</div>`};

/* detail */
screens.jar=()=>{S.pkId='jar';return screens.pocket()};
screens.pocket=()=>{const p=pkGet(S.pkId);
if(!p)return `${bar('Pockets')}<div class="pkempty">This pocket no longer exists.</div>`;
const b=pkBal(p),f=S.pkF[p.id]||'all',hh=(p.h||[]).filter(x=>f==='all'||(f==='in'?x.k!=='out':x.k==='out'));
const groups=[];hh.forEach(x=>{const d=day48(x.ts),g=groups[groups.length-1];if(g&&g[0]===d)g[1].push(x);else groups.push([d,[x]])});
const pct=p.t?Math.min(100,Math.round(b/p.t*100)):0;
const list=groups.length?groups.map(([d,xs])=>`<div class="pkg">${d}</div>${xs.map(x=>{const out=x.k==='out';return `<div class="pkr ${out?'':'pin'}"><div class="pkico">${ic(out?'minus':'plus',22)}</div><div class="pkl"><div class="t">${PKL[x.k]}</div><div class="s">${tm48(x.ts)}</div></div><div class="pkv"><b>${out?'−':'+'}${fmt(x.a)} RWF</b><span>${fmt(x.bal)} RWF</span></div></div>`}).join('')}`).join(''):`<div class="pkempty">${(p.h||[]).length?'Nothing matches this filter.':'No activity yet.<br>Fill this pocket to get started.'}</div>`;
const bt='height:52px;font-size:16px;border-radius:16px';
return `<div class="pkt"><button class="ib" aria-label="Back" onclick="back()">${ic('back',24)}</button><button class="pkm" onclick="pkManage()">Manage</button></div><div class="pkh">${pkIco(p,64)}<div class="pkn">${esc48(p.n)}</div><div class="pkb">${fmt(b)} RWF</div>${p.t?`<div class="pkbar" role="progressbar" aria-valuenow="${pct}" aria-valuemin="0" aria-valuemax="100"><i style="width:${pct}%"></i></div><div class="pks">${pct}% of ${fmt(p.t)} RWF</div>`:''}</div><div class="pkrow" role="button" tabindex="0" onclick="intSheet('${p.id}')" style="padding-top:18px"><div class="pkico" style="width:48px;height:48px;border-radius:24px">${ic('bolt',22)}</div><div><div class="pkpn">Interest received</div><div class="pkpb">${fmt(p.ir||0)} RWF</div></div><span class="pkch">${ic('chev',16,'var(--tt)')}</span></div><div class="pkdiv"></div><button class="pkf" onclick="pkFilter()" aria-haspopup="dialog">${{all:'All',in:'Fills',out:'Take-outs'}[f]}${ic('chev',16)}</button>${list}<div class="cta" style="display:flex;gap:12px"><button class="btn sec2" style="${bt}" onclick="openMv('in')">Fill</button><button class="btn" style="${bt}" ${b?'':'disabled'} onclick="openMv('out')">Take out</button></div>`};

function pkFilter(){const p=pkGet(S.pkId),f=S.pkF[p.id]||'all';
$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" role="dialog" aria-modal="true" aria-label="Filter"><div class="h1" style="font-size:22px;line-height:30px;margin-bottom:8px">Show</div>${[['all','All'],['in','Fills'],['out','Take-outs']].map(([k,l])=>`<button class="pkopt ${f===k?'on':''}" onclick="pkSetF('${k}')">${l}${f===k?CK48:''}</button>`).join('')}</div>`}
function pkSetF(k){S.pkF[S.pkId]=k;closeSheet();render('fade-none')}

/* interest */
function intSheet(id){const l=id?[pkGet(id)]:S.pk,tot=l.reduce((a,p)=>a+(p.ir||0),0),nx=l.reduce((a,p)=>a+Math.round(pkBal(p)*.04/12),0);
const r=(a,b,t)=>`<div style="display:flex;justify-content:space-between;gap:16px;min-height:48px;align-items:center;font-size:15px;${t?'border-top:0':''}"><span class="mu">${a}</span><b style="text-align:right">${b}</b></div>`;
$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" role="dialog" aria-modal="true" aria-label="Interest"><div class="mu" style="font-size:15px">${id?'Interest received':'Interest accrued through yesterday'}</div><div class="h1" style="margin-top:4px">${fmt(tot)} RWF</div><div style="margin:20px 0 4px;padding:0 16px;border-radius:20px;background:var(--chip)">${!id?l.map((p,i)=>r(esc48(p.n),fmt(p.ir||0)+' RWF',i)).join(''):''}${r('Rate (sample)','4.0% a year',!id?1:0)}${r('Next month, about',fmt(nx)+' RWF',1)}</div><div class="fine" style="margin:8px 0 16px">Interest builds daily on what is in the pocket. Sample data for this prototype.</div><button class="btn sec2" onclick="closeSheet()">Close</button></div>`}

/* fill / take out */
function openMv(dir){const p=pkGet(S.pkId);if(!p||(dir==='out'&&!pkBal(p)))return;S.mv={dir,id:p.id,amt:''};S.stack.push('mv');render('push')}
const mvMax=()=>{const m=S.mv,p=pkGet(m.id);return m.dir==='in'?S.bank:pkBal(p)};
const mvQ=()=>S.mv.dir==='in'?'How much to fill?':'How much to take out?';
/* v385: chips are always the same three (two steps + All), so the row never jumps; steps that do not fit are dimmed, not removed. v315: Toss amount screens. The question turns into a sentence with your amount in it ("10,000 RWF to fill?"), and the chips only offer what fits: with nothing typed there is one chip with the full amount, after typing, steps that stay within the limit. English only like the rest of this screen. */
const mvPrompt=(v,bad)=>!v?mvQ():fmt(v)+'<span class="mvu"> RWF</span>'+(bad?'':'<span class="mvw"> '+(S.mv.dir==='in'?'to fill?':'to take out?')+'</span>');
const mvChips=()=>{const v=S.mv.amt?Number(S.mv.amt):0,mx=mvMax(),st=mx>=1000000?[100000,1000000]:mx>=100000?[10000,100000]:mx>=10000?[1000,10000]:[1000,5000];
return st.map(n=>`<button class="chip tap" ${(!mx||v+n>mx)?'disabled':''} aria-label="Add ${fmt(n)}" onclick="mvAdd(${n})">+${fmt(n)}</button>`).join('')+`<button class="chip tap" ${(!mx||v>=mx)?'disabled':''} aria-label="All, ${fmt(mx)}" onclick="mvKey('max')">All</button>`};
screens.mv=()=>{const m=S.mv,p=pkGet(m.id),inn=m.dir==='in';
const bankIco=`<div class="pkico">${gl('bank',26)}</div>`,pIco=pkIco(p,52).replace(/width:52px;height:52px;border-radius:26px/,'');
const fr=inn?['From itunda Bank','Available '+fmt(S.bank)+' RWF',bankIco]:['From '+esc48(p.n),'Can take out '+fmt(pkBal(p))+' RWF',pIco];
const to=inn?['To '+esc48(p.n),'Balance '+fmt(pkBal(p))+' RWF',pIco]:['To itunda Bank','Balance '+fmt(S.bank)+' RWF',bankIco];
const v=m.amt?Number(m.amt):0,bad=v>mvMax();
return `${bar('')}<div class="mvh"><div class="mvt">${[fr,to].map(([a,b])=>`<div class="mvl"><div class="mvx">${a}</div><div class="mvs">${b}</div></div>`).join('')}</div><div class="mvi">${fr[2]}<i class="mvc ${inn?'pin':''}"></i>${to[2]}</div></div><div id="mva" class="mva ${v?'on':''} ${bad?'bad':''}" role="status">${mvPrompt(v,bad)}</div><div id="mvm" class="mvm ${bad?'bad':''}">${mvMsg(v,bad)}</div><div class="mvq" id="mvq">${mvChips()}</div><div class="keys mvk">${['1','2','3','4','5','6','7','8','9','00','0','⌫'].map(k=>`<button onclick="mvKey('${k}')" aria-label="${k==='⌫'?'Delete':k}">${k==='⌫'?'<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 12H4M10 6l-6 6 6 6"/></svg>':k}</button>`).join('')}</div><div class="cta"><button id="mvn" class="btn" ${v&&!bad?'':'disabled'} onclick="mvAsk()">Next</button></div>`};
function mvMsg(v,bad){const m=S.mv,p=pkGet(m.id);if(bad)return m.dir==='in'?t('insuff').replace('%s',fmt(S.bank)):'Only '+fmt(pkBal(p))+' RWF in this pocket';if(!v)return '';return 'Pocket balance after: '+fmt(m.dir==='in'?pkBal(p)+v:pkBal(p)-v)+' RWF'}
function mvUpd(){const v=S.mv.amt?Number(S.mv.amt):0,bad=v>mvMax(),a=$('#mva'),g=$('#mvm'),n=$('#mvn');if(!a)return;
a.innerHTML=mvPrompt(v,bad);const q=$('#mvq');if(q)q.innerHTML=mvChips();a.className='mva '+(v?'on ':'')+(bad?'bad':'');g.textContent=mvMsg(v,bad);g.className='mvm '+(bad?'bad':'');n.disabled=!(v&&!bad)}
function mvKey(k){let a=S.mv.amt;if(k==='max')a=mvMax()?String(mvMax()):'';else if(k==='⌫')a=a.slice(0,-1);else{a=(a+k).replace(/^0+/,'');if(a.length>9)return}S.mv.amt=a;mvUpd()}
function mvAdd(n){const a=(Number(S.mv.amt)||0)+n;if(a>999999999)return;S.mv.amt=String(a);mvUpd()}
function mvAsk(){const m=S.mv,p=pkGet(m.id),v=Number(m.amt);if(!p||!v||v>mvMax())return;const inn=m.dir==='in',nb=inn?pkBal(p)+v:pkBal(p)-v,verb=inn?'Fill':'Take out';
const rows=[['From',inn?'itunda Bank':esc48(p.n)],['To',inn?esc48(p.n):'itunda Bank'],['Fee','0 RWF'],['Pocket balance after',fmt(nb)+' RWF']];
$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" role="dialog" aria-modal="true" aria-label="${verb}"><div style="margin-bottom:12px">${gl('money',60)}</div><div class="h1" style="font-size:22px;line-height:30px">${verb} ${fmt(v)} RWF?</div><div style="margin:16px 0 20px;padding:2px 18px;border-radius:20px;background:var(--chip)">${rows.map(([a,b],i)=>`<div style="display:flex;justify-content:space-between;gap:16px;height:48px;align-items:center;font-size:15px;${i?'border-top:0':''}"><span class="mu">${a}</span><b style="text-align:right;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${b}</b></div>`).join('')}</div><div class="row2"><button class="btn sec2" onclick="closeSheet()">Cancel</button><button class="btn" onclick="mvDo()">${verb}</button></div></div>`}
function mvDo(){const m=S.mv,p=pkGet(m.id),v=Number(m.amt),inn=m.dir==='in';if(!p||!v||v>mvMax()){closeSheet();return}
const was=pkBal(p);if(inn){S.bank-=v;pkSet(p,was+v)}else{S.bank+=v;pkSet(p,was-v)}
pkLog(p,inn?'in':'out',v);addAct('coin',(inn?'To ':'From ')+esc48(p.n),inn?'Saved':'Received',inn?-v:v,inn?'Saved':'Received');
closeSheet();S.stack.pop();render('pop');toast(inn?'Added '+fmt(v)+' RWF to '+p.n:'Took out '+fmt(v)+' RWF');
if(inn&&p.t&&was<p.t&&pkBal(p)>=p.t)setTimeout(confetti,200)}

/* create, rename, delete */
function pkAdd(n,g){n=(n||'').trim().slice(0,20);if(!n){toast('Enter a name');return}
if(S.pk.length>=10){toast('You can have up to 10 pockets');return}
if(S.pk.some(x=>x.n.toLowerCase()===n.toLowerCase())){toast('You already have a pocket with that name');return}
const p={id:'p'+Date.now(),n,g:g||'wallet',b:0,ir:0,h:[]};S.pk.push(p);closeSheet();openPocket(p.id);toast(n+' pocket created')}
function pkNew(){$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" role="dialog" aria-modal="true" aria-label="New pocket"><div class="h1" style="font-size:22px;line-height:30px">Name your pocket</div><div class="lab" style="margin-top:16px">Pocket name</div><input class="in" id="pkn" maxlength="20" placeholder="For example, Wedding" autocomplete="off" onkeydown="if(event.key==='Enter')pkAdd(this.value)"><div class="row2" style="margin-top:24px"><button class="btn sec2" onclick="closeSheet()">Cancel</button><button class="btn" onclick="pkAdd($('#pkn').value)">Create</button></div></div>`;setTimeout(()=>{const i=$('#pkn');i&&i.focus()},60)}
function pkManage(){const p=pkGet(S.pkId),b=pkBal(p);
if(p.id==='jar'){$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" role="dialog" aria-modal="true" aria-label="Manage"><div class="h1" style="font-size:22px;line-height:30px">Interest jar</div><div class="mu" style="font-size:15px;margin:8px 0 24px;line-height:22px">Put money aside and take it out any time. This pocket is always here, so it can't be renamed or deleted.</div><button class="btn sec2" onclick="closeSheet()">Close</button></div>`;return}
$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" role="dialog" aria-modal="true" aria-label="Manage"><div class="h1" style="font-size:22px;line-height:30px">Manage pocket</div><div class="lab" style="margin-top:16px">Pocket name</div><input class="in" id="pkn" maxlength="20" value="${esc48(p.n)}" autocomplete="off" onkeydown="if(event.key==='Enter')pkRename()">${b?`<div class="fine" style="margin-top:12px">Take out the ${fmt(b)} RWF before deleting this pocket.</div>`:''}<div class="row2" style="margin-top:24px"><button class="btn sec2" ${b?'disabled':''} onclick="pkDelete()">Delete</button><button class="btn" onclick="pkRename()">Save</button></div></div>`}
function pkRename(){const p=pkGet(S.pkId),n=($('#pkn').value||'').trim().slice(0,20);if(!n){toast('Enter a name');return}
if(S.pk.some(x=>x.id!==p.id&&x.n.toLowerCase()===n.toLowerCase())){toast('You already have a pocket with that name');return}
p.n=n;closeSheet();render('fade-none');toast('Pocket renamed')}
function pkDelete(){const p=pkGet(S.pkId);if(!p||p.id==='jar'||pkBal(p))return;S.pk=S.pk.filter(x=>x.id!==p.id);closeSheet();S.stack.pop();render('pop');toast('Pocket deleted')}

/* round-ups also show in the Interest jar history */
{const f=window.finish;window.finish=function(){const j=S.jar,r=f.apply(this,arguments);if(S.jar>j)pkLog(pkGet('jar'),'ru',S.jar-j);return r}}

/* itunda Bank: Pockets row, live School fees, interest accrued through yesterday */
{const _b=screens.bank;screens.bank=()=>{let h=_b();
const sg='<div class="sec"><div class="sech">Save &amp; grow</div>',rec='<div class="sec"><div class="sech">Recommended for you</div>',old=row('coin','School fees','RWF 120,000 of 300,000 · by 2027-01-31','40%'),sc=pkGet('sch');
if(h.includes(sg))h=h.replace(sg,sg+row('wallet','Pockets',S.pk.length+' pockets · '+fmt(pkTotal())+' RWF','','openPockets()'));
if(sc&&h.includes(old))h=h.replace(old,row('school','School fees','RWF '+fmt(sc.b)+' of '+fmt(sc.t)+' · by 2027-01-31',Math.min(100,Math.round(sc.b/sc.t*100))+'%',"openPocket('sch')"));
const ir=S.pk.reduce((a,p)=>a+(p.ir||0),0),ib=`<div class="pad" style="padding-top:4px"><div class="row tap" role="button" tabindex="0" onclick="intSheet()"><div class="ico">${gx('bolt',30)}</div><div><div class="s" style="margin:0">Interest accrued through yesterday</div><div class="t" style="font-size:20px;font-weight:800;margin-top:2px">${fmt(ir)} RWF</div></div><div class="r">${ic('chev',16,'var(--tt)')}</div></div></div>`;
if(h.includes(rec))h=h.replace(rec,ib+rec);return h}}

/* v49: Home pockets card, auto-fill, Auto-transfer count */
PKL.auto='Auto-fill';
const NXT49=f=>{const d=new Date();if(f==='Daily')d.setDate(d.getDate()+1);else if(f==='Weekly')d.setDate(d.getDate()+((6-d.getDay()+7)%7||7));else d.setMonth(d.getMonth()+1,1);return d.toLocaleDateString('en-GB',{weekday:'short',day:'numeric',month:'short'})};
const FQ49={Daily:'Every day',Weekly:'Every Saturday',Monthly:'1st of every month'};
const autoOn=()=>S.pk.filter(p=>p.auto).length;
{const _p=screens.pocket;screens.pocket=()=>{let h=_p();const p=pkGet(S.pkId);if(!p)return h;
const row49=`<div class="pkrow" role="button" tabindex="0" onclick="autoSheet()"><div class="pkico" style="width:48px;height:48px;border-radius:24px">${ic('cyc',22)}</div><div><div class="pkpn">Auto-fill</div><div class="pkpb" style="font-size:17px">${p.auto?FQ49[p.auto.f]+' · '+fmt(p.auto.a)+' RWF':'Off'}</div></div><span class="pkch">${ic('chev',16,'var(--tt)')}</span></div>`;
return h.replace('<div class="pkdiv"></div>',row49+'<div class="pkdiv"></div>')}}
function autoSheet(){const p=pkGet(S.pkId);S.au=p.auto?{...p.auto}:{f:'Weekly',a:5000};drawAuto()}
function drawAuto(){const p=pkGet(S.pkId),A=S.au,on=!!p.auto;
$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" role="dialog" aria-modal="true" aria-label="Auto-fill"><div class="h1" style="font-size:22px;line-height:30px">Auto-fill ${esc48(p.n)}</div><div class="mu" style="font-size:14px;margin:6px 0 14px">Moves money from itunda Bank into this pocket on its own.</div><div class="pkauto">${Object.keys(FQ49).map(f=>`<button class="${A.f===f?'on':''}" onclick="S.au.f='${f}';drawAuto()">${f}</button>`).join('')}</div><div class="pkauto" style="margin:12px 0 0">${[1000,5000,10000,20000].map(a=>`<button class="${A.a===a?'on':''}" onclick="S.au.a=${a};drawAuto()">${fmt(a)} RWF</button>`).join('')}</div><div class="pknext">${FQ49[A.f]} · next on ${NXT49(A.f)}</div>${on?`<button class="pkopt" style="margin-top:8px" onclick="autoRun()">Run next transfer now (demo)</button>`:''}<div class="row2" style="margin-top:${on?8:24}px"><button class="btn sec2" onclick="${on?'autoOff()':'closeSheet()'}">${on?'Turn off':'Cancel'}</button><button class="btn" onclick="autoSave()">${on?'Save':'Start'}</button></div></div>`}
function autoSave(){const p=pkGet(S.pkId);p.auto={...S.au};closeSheet();render('fade-none');toast('Auto-fill on · '+FQ49[p.auto.f].toLowerCase())}
function autoOff(){const p=pkGet(S.pkId);delete p.auto;closeSheet();render('fade-none');toast('Auto-fill turned off')}
function autoRun(){const p=pkGet(S.pkId),a=p&&p.auto?p.auto.a:0;if(!a)return;if(S.bank<a){toast(t('insuff').replace('%s',fmt(S.bank)));return}
const was=pkBal(p);S.bank-=a;pkSet(p,was+a);pkLog(p,'auto',a);addAct('cyc','Auto-fill to '+esc48(p.n),'Saved',-a,'Saved');closeSheet();render('fade-none');toast('Added '+fmt(a)+' RWF to '+p.n);if(p.t&&was<p.t&&pkBal(p)>=p.t)setTimeout(confetti,200)}
/* Home: Pockets card before Recent activity */
{const _h=screens.home;screens.home=()=>{let h=_h();const k='<div class="hc"><div class="hct"><span>Recent activity</span>';if(!h.includes(k))return h;
const top=[...S.pk].sort((a,b)=>pkBal(b)-pkBal(a)).slice(0,2);
const card=`<div class="hc"><div class="hct"><span>Pockets</span><a onclick="openPockets()">See all</a></div>${top.map(p=>`<div class="hr tap" role="button" tabindex="0" onclick="openPocket('${p.id}')"><div class="hm"><div class="pkpn" style="font-size:13px">${esc48(p.n)}</div><div class="ha2">${fmt(pkBal(p))} RWF</div></div><button class="hp pr" aria-label="Fill ${esc48(p.n)}" onclick="event.stopPropagation();openPocket('${p.id}');openMv('in')">Fill</button></div>`).join('')}</div>`;
return h.replace(k,card+k)}}
/* Bank: count auto-fills in Auto-transfer */
{const _b=screens.bank;screens.bank=()=>{let h=_b();const n=autoOn();return n&&h.includes('2 active')?h.replace('2 active',(2+n)+' active'):h}}

/* v50: Bank account detail */
const BKX=x=>x[0]==='bag'||x[0]==='food'||x[0]==='bus'||/^From (MTN|Airtel)/.test(x[1]);
S.act.unshift=function(...a){a.forEach(x=>{if(Array.isArray(x)&&x[5]==null)x[5]=Date.now()});return Array.prototype.unshift.apply(this,a)};
S.bf='all';S.bq='';S.bqOn=false;
const ACC50='0214-3058-1980';
function ledger50(){let bal=S.bank;return S.act.filter(x=>!BKX(x)).map(x=>{const r={x,bal};bal-=x[3];return r})}
const when50=x=>x[5]?day48(x[5]):((x[2].split(' · ')[1])||'Earlier');
function bkList(){const f=S.bf,q=(S.bq||'').trim().toLowerCase();
const L=ledger50().filter(({x})=>(f==='all'||(f==='in'?x[3]>0:x[3]<0))&&(!q||x[1].toLowerCase().includes(q)));
if(!L.length)return `<div class="pkempty">${q||f!=='all'?'Nothing matches.':'No activity yet.'}</div>`;
const g=[];L.forEach(r=>{const d=when50(r.x),l=g[g.length-1];if(l&&l[0]===d)l[1].push(r);else g.push([d,[r]])});
return g.map(([d,rs])=>`<div class="pkg">${d}</div>${rs.map(({x,bal})=>{const inn=x[3]>0,sub=x[5]?tm48(x[5]):x[2].split(' · ')[0];return `<div class="bdr ${inn?'pin':''}" role="button" tabindex="0" onclick="actOpen(${S.act.indexOf(x)})"><div class="ico">${gx(x[0],26)}</div><div style="min-width:0"><div class="t">${x[1]}</div><div class="s">${sub}</div></div><div class="pkv"><b>${signed(x[3])}</b><span>${fmt(bal)} RWF</span></div></div>`}).join('')}`).join('')}
function openBankDetail(){S.bf='all';S.bq='';S.bqOn=false;S.stack.push('bankd');render('push')}
screens.bankd=()=>{const ir=S.pk.reduce((a,p)=>a+(p.ir||0),0);
return `<div class="bdt"><button class="ib" aria-label="Back" onclick="back()">${ic('back',24)}</button><button class="bb" onclick="S.stack.push(S.card?'card':'nocard');render('push')">${ic('card',20)}Card</button><button class="bb" onclick="bkManage()">${ic('gear',20)}Manage</button></div><button class="bdn" onclick="bkCopy()" aria-label="Copy account number">itunda Bank ${ACC50}</button><div class="bdb">${fmt(S.bank)} RWF</div><div class="pkrow" role="button" tabindex="0" onclick="intSheet()" style="padding-top:18px"><div class="pkico" style="width:44px;height:44px;border-radius:22px">${ic('bolt',22)}</div><div><div class="pkpn">Interest accrued through yesterday</div><div class="pkpb">${fmt(ir)} RWF</div></div><span class="pkch">${ic('chev',16,'var(--tt)')}</span></div><div class="bdband"></div><div class="bdf"><button class="pkf" onclick="bkFilter()" aria-haspopup="dialog">${{all:'All',in:'Money in',out:'Money out'}[S.bf]}${ic('chev',16)}</button><button class="bds" aria-label="Search" onclick="bkSearch()">${ic('search',20)}</button></div>${S.bqOn?`<label class="asr" style="margin-top:12px">${ic('search',20)}<input id="bq" placeholder="Search activity" value="${esc48(S.bq)}" oninput="bqSet(this.value)" aria-label="Search activity"></label>`:''}<div class="bdnew"><div class="pkg">New</div><div class="bdr" role="button" tabindex="0" onclick="openShop('eats')"><div class="ico">${gl('delivered3d',30)}</div><div style="min-width:0"><div class="t">Free delivery on your first order</div><div class="s">Try itunda Eats</div></div><span class="pkch">${ic('chev',16,'var(--tt)')}</span></div></div><div id="bkl">${bkList()}</div><div class="cta" style="display:flex;gap:12px"><button class="btn sec2" style="height:52px;font-size:16px;border-radius:16px" onclick="sheetAdd()">Fill</button><button class="btn" style="height:52px;font-size:16px;border-radius:16px" onclick="flow()">Send</button></div>`};
function bqSet(v){S.bq=v;const e=$('#bkl');if(e)e.innerHTML=bkList()}
function bkSearch(){S.bqOn=!S.bqOn;if(!S.bqOn)S.bq='';render('fade-none');if(S.bqOn)setTimeout(()=>{const i=$('#bq');i&&i.focus()},50)}
function bkFilter(){$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" role="dialog" aria-modal="true" aria-label="Filter"><div class="h1" style="font-size:22px;line-height:30px;margin-bottom:8px">Show</div>${[['all','All'],['in','Money in'],['out','Money out']].map(([k,l])=>`<button class="pkopt ${S.bf===k?'on':''}" onclick="S.bf='${k}';closeSheet();render('fade-none')">${l}${S.bf===k?CK48:''}</button>`).join('')}</div>`}
function bkCopy(){try{navigator.clipboard.writeText(ACC50).catch(()=>{})}catch(e){}toast('Account number copied')}
function bkManage(){const r=(a,b,t)=>`<div style="display:flex;justify-content:space-between;gap:16px;min-height:48px;align-items:center;font-size:15px;${t?'border-top:0':''}"><span class="mu">${a}</span><b style="text-align:right">${b}</b></div>`;
$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" role="dialog" aria-modal="true" aria-label="Manage"><div class="h1" style="font-size:22px;line-height:30px">Manage account</div><div style="margin:16px 0 4px;padding:0 16px;border-radius:20px;background:var(--chip)">${r('Account number',ACC50)}${r('Account name',esc48(S.name||'You'),1)}${r('Interest','4.0% a year (sample)',1)}</div><div class="fine" style="margin:8px 0 16px">Sample data for this prototype.</div><div class="row2"><button class="btn sec2" onclick="closeSheet()">Close</button><button class="btn" onclick="bkCopy();closeSheet()">Copy number</button></div></div>`}
/* Bank: account block opens the detail */
{const _b=screens.bank;screens.bank=()=>{const h=_b(),o='<div class="pad" style="padding-top:20px"><div class="sm mu">itunda Bank account</div>';return h.includes(o)?h.replace(o,'<div class="pad tap" role="button" tabindex="0" onclick="openBankDetail()" style="padding-top:20px;cursor:pointer"><div class="sm mu">itunda Bank account</div>'):h}}

/* v51: coin icons in the pocket history, Next bar above the keypad */
const COIN51=`<span class="pkcoin" aria-hidden="true">${knot(18,'#6960F9').replace('role="img" aria-label="itunda"','')}</span>`;
{const _p=screens.pocket;screens.pocket=()=>_p().replace(/(<div class="pkr(?: pin)?"><div class="pkico">)<svg[\s\S]*?<\/svg>/g,'$1'+COIN51)}
{const _m=screens.mv;screens.mv=()=>{const h=_m(),re=/<div class="cta"><button id="mvn" class="btn" (disabled )?onclick="mvAsk\(\)">Next<\/button><\/div>/,m=h.match(re);if(!m)return h;
return h.replace(re,'').replace('<div class="keys mvk">',`<button id="mvn" class="mvn" ${m[1]||''}onclick="mvAsk()">Next</button><div class="keys mvk">`)}}

/* v52: pocket goals (set in Manage), progress in the list, goal date estimate in Auto-fill */
const GOALS52=[0,50000,100000,250000,500000];
function pkManage(){const p=pkGet(S.pkId),b=pkBal(p);
if(p.id==='jar'){$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" role="dialog" aria-modal="true" aria-label="Manage"><div class="h1" style="font-size:22px;line-height:30px">Interest jar</div><div class="mu" style="font-size:15px;margin:8px 0 24px;line-height:22px">Put money aside and take it out any time. This pocket is always here, so it can't be renamed or deleted.</div><button class="btn sec2" onclick="closeSheet()">Close</button></div>`;return}
S.mg={n:p.n,t:p.t||0};drawMg()}
function drawMg(){const p=pkGet(S.pkId),b=pkBal(p),G=S.mg;
$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" role="dialog" aria-modal="true" aria-label="Manage"><div class="h1" style="font-size:22px;line-height:30px">Manage pocket</div><div class="lab" style="margin-top:16px">Pocket name</div><input class="in" id="pkn" maxlength="20" value="${esc48(G.n)}" autocomplete="off" onkeydown="if(event.key==='Enter')pkRename()"><div class="lab">Goal</div><div class="pkauto" style="margin-top:8px">${GOALS52.map(g=>`<button class="${G.t===g?'on':''}" onclick="S.mg.n=$('#pkn').value;S.mg.t=${g};drawMg()">${g?fmt(g):'None'}</button>`).join('')}</div>${b?`<div class="fine" style="margin-top:12px">Take out the ${fmt(b)} RWF before deleting this pocket.</div>`:''}<div class="row2" style="margin-top:24px"><button class="btn sec2" ${b?'disabled':''} onclick="pkDelete()">Delete</button><button class="btn" onclick="pkRename()">Save</button></div></div>`}
function pkRename(){const p=pkGet(S.pkId),n=($('#pkn').value||'').trim().slice(0,20);if(!n){toast('Enter a name');return}
if(S.pk.some(x=>x.id!==p.id&&x.n.toLowerCase()===n.toLowerCase())){toast('You already have a pocket with that name');return}
p.n=n;const t0=S.mg?S.mg.t:p.t;if(t0)p.t=t0;else delete p.t;closeSheet();render('fade-none');toast('Pocket saved')}
/* list: progress under the balance */
{const _l=screens.pockets;screens.pockets=()=>{let h=_l();S.pk.filter(p=>p.t).forEach(p=>{const pct=Math.min(100,Math.round(pkBal(p)/p.t*100));h=h.replace(new RegExp(`(onclick="openPocket\\('${p.id}'\\)">[\\s\\S]*?<div class="pkpb">[^<]*</div>)`),`$1<div class="pkbar" style="margin-top:8px;width:140px;height:6px"><i style="width:${pct}%"></i></div>`)});return h}}
/* auto-fill: when would the goal be reached */
const dt52=(f,n)=>{const d=new Date();if(f==='Daily')d.setDate(d.getDate()+n);else if(f==='Weekly'){d.setDate(d.getDate()+((6-d.getDay()+7)%7||7)+(n-1)*7)}else{d.setMonth(d.getMonth()+n,1)}return d.toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric'})};
{const _d=drawAuto;drawAuto=function(){_d.apply(this,arguments);const p=pkGet(S.pkId),A=S.au,e=document.querySelector('#layer .pknext');if(!p||!p.t||!e)return;const left=p.t-pkBal(p);
e.innerHTML+=`<br><span style="font-weight:600">${left<=0?'Goal already reached':'Reaches '+fmt(p.t)+' RWF by '+dt52(A.f,Math.ceil(left/A.a))}</span>`}}
</script>
<script>
/* v53: Toss-style settings hub, Security sub-screen, full-page Language picker */
(function(){
const st=document.createElement('style');
st.textContent='.stc{margin:12px 16px 0;background:var(--chip);border-radius:24px;padding:8px 0 10px}.stc .agt{padding:14px 24px 2px;color:var(--tx);font-size:17px;font-weight:800}.stc .ar{padding:14px 24px}.stc .ar .t{font-weight:600}.stc .ar:active{background:rgba(127,127,140,.12)}.prof{display:flex;align-items:center;gap:16px;padding:18px 24px 6px;cursor:pointer}.prof .av{width:64px;height:64px;border-radius:32px;background:var(--tint);color:var(--tintfg);font-size:26px;font-weight:800;display:flex;align-items:center;justify-content:center;flex-shrink:0}.prof b{font-size:22px;letter-spacing:-.4px}.prof .s{font-size:14px;color:var(--mu);margin-top:2px}.stt{font-size:24px;line-height:32px;font-weight:800;letter-spacing:-.5px;padding:22px 24px 14px}.ck{width:34px;height:34px;border-radius:17px;border:2px solid var(--ln);display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:all .2s}.ck.on{background:var(--br);border-color:var(--br)}.qm{width:20px;height:20px;border-radius:10px;border:1.5px solid var(--tt);color:var(--tt);font-size:12px;font-weight:700;display:inline-flex;align-items:center;justify-content:center;margin-left:8px;vertical-align:2px}';
document.head.appendChild(st);
const L=(e,r,f)=>({en:e,rw:r,fr:f}[S.lang]||e);
if(S.set.quick===undefined)S.set.quick=true;
if(S.set.pw===undefined)S.set.pw=0;
const PW=[['Every time you open','Igihe cyose ufunguye','À chaque ouverture'],['Once a day','Rimwe ku munsi','Une fois par jour'],['Every 7 days','Buri minsi 7','Tous les 7 jours']];
const push=n=>{S.stack.push(n);render('push')};
window.openSec=()=>push('security');
window.openLang=()=>push('language');
window.cyclePw=()=>{S.set.pw=(S.set.pw+1)%PW.length;render('fade-none')};
window.pickLang=k=>{S.lang=k;render('fade-none')};
const sw=k=>`<div class="sw ${S.set[k]?'on':''}" id="ss_${k}" role="switch" aria-checked="${!!S.set[k]}" tabindex="0" onclick="event.stopPropagation();tgSet('${k}')"><i></i></div>`;
const row=(t,s,r,on)=>`<div class="ar tap" onclick="${on||'soon()'}"><div style="min-width:0;flex:1"><div class="t">${t}</div>${s?`<div class="s">${s}</div>`:''}</div>${r?`<span style="font-size:15px;font-weight:600;color:var(--lk)">${r}</span>`:''}${ic('chev',16,'var(--tt)')}</div>`;
const trow=(t,s,k,extra='')=>`<div class="ar" style="cursor:default"><div style="min-width:0;flex:1"><div class="t">${t}${extra}</div>${s?`<div class="s">${s}</div>`:''}</div>${sw(k)}</div>`;
const L2={en:'English',rw:'Kinyarwanda',fr:'Français'};
screens.settings=()=>{const nm=S.name||'Amina Uwase';
return `${bar('')}
<div class="prof tap" onclick="soon()"><div class="av">${nm[0]}</div><div style="flex:1;min-width:0"><b>${nm}</b><div class="s">${t('s_myinfo')} · ${L('Address','Aderesi','Adresse')}</div></div>${ic('chev',18,'var(--tt)')}</div>
<div class="stc" style="margin-top:20px">${row(t('s_lang'),'',L2[S.lang],'openLang()')}${row(t('s_notif'),'','',"soon()")}
<div class="ar" style="cursor:default;flex-direction:column;align-items:stretch;gap:10px"><div class="t" style="font-weight:600">${t('s_theme')}</div><div class="req">${[['system',t('s_sys')],['light',t('s_light')],['dark',t('s_dark')]].map(([k,l])=>`<button class="${S.theme===k?'on':''}" onclick="setTheme('${k}')">${l}</button>`).join('')}</div></div>${row(t('s_text'))}</div>
<div class="stc"><div class="agt">${t('s_auth')}</div>${row(L('Security','Umutekano','Sécurité'),'','','openSec()')}${row(t('s_devices'),'Pixel 8'+t('s_thisdev'))}</div>
<div class="stc"><div class="agt">${t('s_tp')}</div>${row(t('send'))}${row(t('s_pay'))}</div>
<div class="stc"><div class="agt">${t('s_notif')}</div>${trow(t('s_money'),'','money')}${trow(t('s_general'),'','general')}${row(t('s_markall'),'','',"S.nread=true;toast('OK')")}</div>
<div class="stc"><div class="agt">${t('s_legal')}</div>${row(t('s_credit'))}${row(t('s_priv'))}${row(t('s_terms'))}</div>
<div class="pad" style="padding-top:24px;padding-bottom:30px"><button class="btn sec2" onclick="logOut()">${t('s_logout')}</button></div>`};
screens.security=()=>`${bar('')}<div class="stt">${L('Security','Umutekano','Sécurité')}</div>
${row(L('PIN check','Kugenzura PIN','Vérification du PIN'),'',PW[S.set.pw][{en:0,rw:1,fr:2}[S.lang]||0],'cyclePw()')}
${row(L('Passkeys','Passkeys','Passkeys'),'','1')}
${trow(L('Quick sign-in','Kwinjira vuba','Connexion rapide'),'','quick',`<span class="qm" onclick="event.stopPropagation();toast('${L('Sign in without typing your PIN on trusted devices','Injira udashyizemo PIN ku bikoresho wizeye','Connexion sans PIN sur les appareils de confiance')}')">?</span>`)}
${trow(t('s_bio'),t('s_bio_b'),'bio')}
${trow(t('s_dev'),t('s_dev_b'),'devbio')}
${row(L('Change PIN','Guhindura PIN','Changer le PIN'))}
${row(t('s_devices'),t('s_trusted'))}`;
screens.language=()=>`${bar('')}<div class="stt">${L('Which language should<br>itunda use?','Itunda ikoreshe<br>ururimi uwuhe?','Quelle langue<br>pour itunda ?')}</div>
${Object.entries(L2).map(([k,n])=>`<div class="ar tap" style="padding:18px 24px" onclick="pickLang('${k}')"><div class="t" style="flex:1;font-size:18px;font-weight:600">${n}</div><div class="ck ${S.lang===k?'on':''}">${ic('check',18,S.lang===k?'#17171C':'var(--tt)')}</div></div>`).join('')}
<div class="pad fine" style="padding-top:14px">${L('Covers the Send flow and the Pay tab. Kinyarwanda and French have not been checked by a native speaker.','Bikoreshwa mu kohereza no kwishyura. Ikinyarwanda n’Igifaransa ntibyasuzumwe n’abavuga ururimi kavukire.','Couvre l’envoi et l’onglet Payer. Le kinyarwanda et le français n’ont pas été relus par un locuteur natif.')}</div>`;
if(!P.check)P.check='M5 12l5 5L19 7';
if(S.stack.length&&S.stack[S.stack.length-1]==='settings')render('fade-none');
})();
</script>
<script>
/* v54: Display & haptics, Manage contacts, Delete account */
(function(){
const st=document.createElement('style');
st.textContent='.hd{padding:14px 24px;display:flex;align-items:center;gap:12px}.hd .t{font-size:20px;font-weight:800;letter-spacing:-.3px}.hd .s{font-size:14px;color:var(--mu);margin-top:2px}.hd button{height:44px;padding:0 22px;border-radius:14px;border:0;background:var(--tint);color:var(--tintfg);font-weight:800;font-size:16px}.gap{height:8px;background:color-mix(in srgb,var(--tx) 2.5%,var(--bg));margin:6px 0}.emp{text-align:center;padding:36px 32px 0}.emp b{font-size:20px;display:block;margin-top:18px}.emp div{color:var(--mu);font-size:15px;margin-top:6px;line-height:22px}.bl{display:flex;gap:12px;padding:12px 24px;font-size:14px;line-height:21px;color:var(--mu)}.bl i{width:5px;height:5px;border-radius:3px;background:var(--tt);margin-top:9px;flex-shrink:0}.dl{display:block;text-align:center;color:var(--tt);font-size:14px;font-weight:600;padding:18px 0 6px;text-decoration:underline;cursor:pointer}';
document.head.appendChild(st);
const L=(e,r,f)=>({en:e,rw:r,fr:f}[S.lang]||e);
const NM=()=>S.name||'Amina Uwase';
if(S.set.hap===undefined)S.set.hap=true;if(S.set.hapPay===undefined)S.set.hapPay=true;
if(!S.imp)S.imp='18 Sep 2026, 02:36';
window.go=n=>{S.stack.push(n);render('push')};
window.pickTheme=k=>{setTheme(k);render('fade-none')};
window.impContacts=()=>{const d=new Date();S.imp=d.toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric'})+', '+d.toTimeString().slice(0,5);toast(L('Contacts updated','Abakoresha bavuguruwe','Contacts mis à jour'));render('fade-none')};
const ck=on=>`<div style="width:34px;display:flex;justify-content:center">${ic('check',24,on?'var(--lk)':'var(--ln)')}</div>`;
const row=(t,r,on)=>`<div class="ar tap" style="padding:16px 24px" onclick="${on||'soon()'}"><div class="t" style="flex:1;font-weight:600">${t}</div>${r?`<span style="font-size:15px;font-weight:600;color:var(--tt)">${r}</span>`:''}${ic('chev',16,'var(--tt)')}</div>`;
const tg=(t,k)=>`<div class="ar" style="padding:16px 24px;cursor:default"><div class="t" style="flex:1;font-weight:600">${t}</div><div class="sw ${S.set[k]?'on':''}" id="ss_${k}" role="switch" aria-checked="${!!S.set[k]}" tabindex="0" onclick="tgSet('${k}')"><i></i></div></div>`;
const TN=()=>({system:L('Same as system','Nk’iy’igikoresho','Comme le système'),light:L('Light mode','Uburyo bw’umucyo','Mode clair'),dark:L('Dark mode','Uburyo bw’umwijima','Mode sombre')});
screens.display=()=>`${bar('')}<div class="stt">${L('Display & haptics','Imiterere & kunyeganyega','Affichage et vibrations')}</div>${row(L('Theme','Insanganyamatsiko','Thème'),TN()[S.theme],"go('theme')")}${row(L('Haptics','Kunyeganyega','Vibrations'),'',"go('haptics')")}`;
screens.theme=()=>`${bar('')}<div class="stt">${L('Theme','Insanganyamatsiko','Thème')}</div>${['light','dark','system'].map(k=>`<div class="ar tap" style="padding:20px 24px" onclick="pickTheme('${k}')"><div class="t" style="flex:1;font-weight:600;color:${S.theme===k?'var(--tx)':'var(--mu)'}">${TN()[k]}</div>${ck(S.theme===k)}</div>`).join('')}`;
screens.haptics=()=>`${bar('')}<div class="stt">${L('Haptics','Kunyeganyega','Vibrations')}</div>${tg(L('Vibrate on tap','Kunyeganyega ukoze','Vibrer au toucher'),'hap')}${tg(L('Vibrate when a payment succeeds','Kunyeganyega kwishyura byagenze neza','Vibrer quand un paiement réussit'),'hapPay')}`;
screens.contacts=()=>`${bar(L('Manage contacts','Gucunga abo uziranye','Gérer les contacts'))}
<div class="hd"><div style="flex:1;min-width:0"><div class="t">${L('Import new contacts','Kuzana abashya','Importer des contacts')}</div><div class="s">${L('Last imported','Byaherutse','Dernier import')} ${S.imp}</div></div><button onclick="impContacts()">${L('Import','Zana','Importer')}</button></div>
<div class="gap"></div>
<div class="hd" style="display:block;padding-bottom:0"><div class="t">${L('Blocked contacts','Abo wahagaritse','Contacts bloqués')}</div><div class="s">${L('They can’t send you money.','Ntibashobora kukohereza amafaranga.','Ils ne peuvent pas vous envoyer d’argent.')}</div></div>
<div class="emp"><svg width="200" height="120" viewBox="0 0 200 120" aria-hidden="true"><rect x="40" y="6" width="120" height="130" rx="22" fill="var(--chip)" stroke="var(--ln)" stroke-width="3"/><rect x="54" y="24" width="92" height="30" rx="10" fill="var(--bg)"/><circle cx="70" cy="39" r="9" fill="var(--br)"/><rect x="86" y="30" width="40" height="6" rx="3" fill="var(--lk)"/><rect x="86" y="41" width="30" height="5" rx="2.5" fill="var(--ln)"/><circle cx="70" cy="74" r="9" fill="var(--ln)"/><rect x="86" y="68" width="44" height="6" rx="3" fill="var(--ln)"/><circle cx="130" cy="39" r="16" fill="var(--br)" opacity=".7"/></svg><b>${L('No blocked contacts','Nta wahagaritse','Aucun contact bloqué')}</b><div>${L('Press and hold an entry in your activity list to block it.','Kanda ukomeze ku gikorwa kiri ku rutonde kugira ngo uhagarike.','Appuyez longuement sur une opération pour bloquer.')}</div></div>`;
screens.deleteacct=()=>{const it=(g,t,m)=>`<div class="ar tap" style="padding:18px 24px;gap:16px" onclick="toast('${m}')"><div style="width:40px;display:flex;justify-content:center">${gl(g,34)}</div><div class="t" style="flex:1;font-size:18px">${t}</div>${ic('chev',16,'var(--tt)')}</div>`;
const B=[L(`Anyone can delete their account.`,`Buri wese ashobora gusiba konti ye.`,`Tout le monde peut supprimer son compte.`),L(`Your personal data is erased, except what the law requires us to keep for a set period. We can't show you everything kept about ${NM()} afterwards.`,`Amakuru yawe arasibwa, uretse ayo amategeko adusaba kubika igihe runaka.`,`Vos données sont effacées, sauf celles que la loi impose de conserver. `),L(`Offers, events, vouchers and coupons are all lost.`,`Ibyiza, amatangazo, ama-voucher n'ibikuponi byose birabura.`,`Offres, événements, bons et coupons sont perdus.`),L(`Your itunda card is closed.`,`Ikarita yawe ya itunda irafungwa.`,`Votre carte itunda est fermée.`),L(`If you still owe money on a loan or other service, deletion may be blocked. Check that service's terms.`,`Niba ukibereyemo inguzanyo cyangwa indi serivisi, gusiba bishobora guhagarikwa.`,`Si vous devez encore de l'argent (prêt, service), la suppression peut être bloquée.`)];
return `${bar('')}<div class="stt" style="font-size:26px;line-height:36px">${L('Finish 3 things<br>to delete your account','Kuzuza ibintu 3<br>kugira ngo usibe konti','Terminez 3 étapes<br>pour supprimer le compte')}</div><div style="padding-top:10px">${it('cashin3d',L('Move your remaining money','Imura amafaranga asigaye','Transférer l’argent restant'),L('Opening: move your balance out','Gukuramo amafaranga asigaye','Retrait du solde'))}${it('receipt',L('Review data to be deleted','Reba amakuru azasibwa','Voir les données supprimées'),L('Opening: data review','Gusuzuma amakuru','Revue des données'))}${it('verify',L('Close linked services','Funga serivisi zihujwe','Fermer les services liés'),L('Opening: linked services','Serivisi zihujwe','Services liés'))}</div><div style="padding:30px 0 40px">${B.map(x=>`<div class="bl"><i></i><span>${x}</span></div>`).join('')}</div>`};
/* hub: swap theme chips for Display row, add Contacts row and Delete link */
const _s=screens.settings;
screens.settings=()=>{let h=_s();
h=h.replace(/<div class="ar" style="cursor:default;flex-direction:column[\s\S]*?<\/button><\/div><\/div>/,'');
h=h.replace(/(<div class="stc" style="margin-top:20px">)/,`$1<div class="ar tap" onclick="go('display')"><div class="t" style="flex:1;font-weight:600">${L('Display & haptics','Imiterere & kunyeganyega','Affichage et vibrations')}</div>${ic('chev',16,'var(--tt)')}</div><div class="ar tap" onclick="go('contacts')"><div class="t" style="flex:1;font-weight:600">${L('Manage contacts','Gucunga abo uziranye','Gérer les contacts')}</div>${ic('chev',16,'var(--tt)')}</div>`);
h=h.replace(/(<\/button><\/div>)$/,`$1<span class="dl" onclick="go('deleteacct')">${L('Delete account','Gusiba konti','Supprimer le compte')}</span><div style="height:24px"></div>`);
return h};
if(S.stack.length&&S.stack[S.stack.length-1]==='settings')render('fade-none');
})();
</script>
<script>
/* v55: Mini apps hub (Featured / Games / Points / Categories) + mini profile */
(function(){
const st=document.createElement('style');
st.textContent='.mh{display:flex;align-items:center;justify-content:space-between;padding:16px 12px 0}.msr{margin:10px 16px 0;height:48px;border-radius:16px;background:var(--chip);display:flex;align-items:center;gap:10px;padding:0 14px;color:var(--tt);font-size:16px}.mtabs{display:flex;border-bottom:0;margin-top:14px}.mtabs button{flex:1;height:46px;border:0;background:none;font:inherit;font-size:16px;font-weight:700;color:var(--tt);position:relative}.mtabs button.on{color:var(--tx)}.mtabs button.on:after{content:"";position:absolute;left:14%;right:14%;bottom:-1px;height:3px;border-radius:2px;background:var(--tx)}.mt2{font-size:20px;font-weight:800;letter-spacing:-.3px;padding:26px 24px 12px;display:flex;justify-content:space-between;align-items:center}.mcs{display:flex;gap:12px;overflow-x:auto;padding:0 16px;scrollbar-width:none}.mcs::-webkit-scrollbar{display:none}.mcd{flex:0 0 78%;min-width:0}.mcd .pv{position:relative;background:var(--chip);border-radius:24px;padding:18px;display:grid;grid-template-columns:repeat(3,1fr);gap:10px;height:170px;overflow:hidden}.mcd .pv i{font-style:normal;height:54px;border-radius:16px;display:flex;align-items:center;justify-content:center;font-size:26px;background:var(--bg)}.mcd .pv em{position:absolute;top:10px;right:12px;font-style:normal;font-size:12px;font-weight:700;background:var(--tx);color:var(--bg);padding:4px 10px;border-radius:12px}.mcd .tt{display:flex;gap:12px;align-items:center;padding:12px 4px 10px}.mcd .tt b{font-size:17px}.mcd .tt div div{font-size:13px;color:var(--mu)}.mcd button.w{width:100%;height:46px;border:0;border-radius:14px;background:var(--tint);color:var(--tintfg);font-weight:800;font-size:15px}.mi2{width:56px;height:56px;border-radius:16px;background:var(--chip);display:flex;align-items:center;justify-content:center;font-size:28px;flex-shrink:0}.rk{width:20px;text-align:center;font-weight:800;color:var(--mu);font-size:17px}.go{height:38px;padding:0 18px;border:0;border-radius:12px;background:var(--chip);color:var(--tx);font-weight:800;font-size:15px}.gcs{display:flex;gap:14px;overflow-x:auto;padding:16px 20px 0;scrollbar-width:none}.gcs::-webkit-scrollbar{display:none}.gc{flex:0 0 auto;text-align:center;font-size:13px;font-weight:700;color:var(--mu);background:none;border:0;font-family:inherit}.gc span{display:flex;width:56px;height:56px;border-radius:28px;background:var(--chip);align-items:center;justify-content:center;font-size:24px;margin:0 auto 6px;border:2px solid transparent}.gc.on{color:var(--lk)}.gc.on span{border-color:var(--lk)}.pgb{height:8px;border-radius:4px;background:var(--chip);margin:12px 0 6px;overflow:hidden}.pgb i{display:block;height:100%;background:var(--br)}';
document.head.appendChild(st);
const L=(e,r,f)=>({en:e,rw:r,fr:f}[S.lang]||e);
if(!S.mt)S.mt='feat';if(!S.gcat)S.gcat='all';if(S.mpts===undefined)S.mpts=0;
window.openMini=k=>{S.mt=k||'feat';S.stack.push('mini');render('push')};
window.miniTab=k=>{S.mt=k;render('fade-none')};
window.gCat=k=>{S.gcat=k;render('fade-none')};
window.startApp=n=>toast(L('Opening','Gufungura','Ouverture de')+' '+n+' — '+L('not in this prototype','ntabwo biri muri prototype','pas dans ce prototype'));
window.mPlay=()=>{if(S.mpts<10){S.mpts=Math.min(10,S.mpts+2)}toast('+2 RWF '+L('points','amanota','points'));render('fade-none')};
const APPS=[['📈','Practice Investing','Find out if you’d make money in stocks'],['🏷️','Deal of the Day','Only at this price, only today'],['🚌','Bus Times','Live Kigali bus arrivals'],['📱','Airtime Top-up','Buy MTN or Airtel airtime in seconds'],['🛡️','Safe Savings','Small daily saves that add up']];
const GAMES=[['🧩','Match Puzzle','Cute animal puzzle, play together',['puz','hot']],['🃏','Card Classic','Solo card game, no waiting',['cls']],['🍉','Fruit Merge','Merge fruit, reach the watermelon',['puz','hot']],['🌸','Daily Garden','Grow real-looking flowers',['new']],['🔤','Word Streak','A new word every day',['new','str']]];
const list=a=>a.map((x,i)=>`<div class="ar" style="padding:10px 24px;gap:14px;cursor:default"><span class="rk">${i+1}</span><div class="mi2">${x[0]}</div><div style="flex:1;min-width:0"><div class="t" style="font-size:17px">${x[1]}</div><div class="s" style="line-height:18px">${x[2]}</div></div><button class="go" onclick="startApp('${x[1]}')">${L('Start','Tangira','Lancer')}</button></div>`).join('');
const feat=()=>{const card=(t,s,b,ic2,em,n)=>`<div class="mcd"><div class="pv"><em>${n}</em>${em.map(e=>`<i>${e}</i>`).join('')}</div><div class="tt"><div class="mi2" style="width:48px;height:48px;font-size:24px">${ic2}</div><div><b>${t}</b><div>${s}</div></div></div><button class="w" onclick="startApp('${t}')">${b}</button></div>`;
return `<div class="mt2">${L('Before you pay full price','Mbere yo kwishyura igiciro cyuzuye','Avant de payer plein tarif')}</div><div class="mcs">${card('Deal Finder','Discount codes & coupons','See deals','🏷️',['🛒','✈️','🏨','🍔','👟','📚','🎧','💄','🧴'],'13.9K '+L('using','bakoresha','actifs'))}${card('Sale Calendar','Popular sales happening now','See schedule','🔔',['👕','🧥','👜','⌚','🕶️','🎒','🧢','👖','🧣'],'8.2K '+L('using','bakoresha','actifs'))}</div>
<div class="mt2">${L('Trending now','Bikunzwe ubu','Tendances')}</div>${list(APPS)}`};
const games=()=>{const C=[['all','▦',L('All','Byose','Tous')],['hot','🔥',L('Trending','Bikunzwe','Tendance')],['new','✨',L('New','Bishya','Nouveau')],['puz','🧩',L('Puzzle','Puzzle','Puzzle')],['cls','♟️',L('Classic','Gakondo','Classique')],['str','🧠',L('Strategy','Ingamba','Stratégie')]];
const p=S.mpts;
return `<div class="gcs">${C.map(c=>`<button class="gc ${S.gcat===c[0]?'on':''}" onclick="gCat('${c[0]}')"><span>${c[1]}</span>${c[2]}</button>`).join('')}</div>
<div class="mt2" style="padding-top:22px">${L('Point missions','Ibikorwa by’amanota','Missions points')}</div><div class="pad" style="padding-top:0"><div style="display:flex;align-items:center;gap:14px"><div class="mi2" style="width:64px;height:64px;font-size:32px">🧩</div><div style="flex:1;min-width:0"><div class="sm mu">Match Puzzle</div><div style="font-size:18px;font-weight:800;line-height:24px">${L('Play 1 minute, get 2 RWF','Kina umunota 1, ubone 2 RWF','1 minute de jeu, 2 RWF')}</div></div><button class="btn" style="width:auto;height:44px;padding:0 18px;font-size:15px" ${p>=10?'disabled':''} onclick="mPlay()">${L('Play','Kina','Jouer')}</button></div><div class="pgb"><i style="width:${p*10}%"></i></div><div style="text-align:right;font-size:15px;font-weight:700"><span style="color:var(--lk)">${p} RWF</span> / 10 RWF</div></div>
<div class="mt2">${L('Trending games','Imikino ikunzwe','Jeux tendance')}</div>${(()=>{const g=GAMES.filter(x=>S.gcat==='all'||x[3].includes(S.gcat));return g.length?list(g):`<div class="pad mu" style="font-size:15px">${L('Nothing here yet.','Nta kintu kirimo.','Rien pour l’instant.')}</div>`})()}`};
const pts=()=>`<div class="pad" style="padding-top:22px"><div class="sm mu">${L('Your points','Amanota yawe','Vos points')}</div><div class="big" style="margin-top:4px">${S.mpts} RWF</div><div class="sm mu" style="margin-top:6px">${L('Earn by playing missions. Points can be moved to your itunda Pay balance.','Bona amanota ukina. Ashobora kwimurirwa kuri itunda Pay.','Gagnez en jouant. Les points vont vers votre solde itunda Pay.')}</div></div><div class="mt2">${L('Missions','Ibikorwa','Missions')}</div>${[['🧩','Match Puzzle',L('Play 1 minute','Kina umunota 1','1 minute de jeu'),'+2 RWF'],['📈','Practice Investing',L('Finish a round','Soza urugendo','Finir une partie'),'+3 RWF'],['🏷️','Deal Finder',L('View a deal','Reba igicuruzwa','Voir une offre'),'+1 RWF']].map(x=>`<div class="ar" style="gap:14px;cursor:default"><div class="mi2">${x[0]}</div><div style="flex:1"><div class="t">${x[1]}</div><div class="s">${x[2]}</div></div><b style="color:var(--lk)">${x[3]}</b></div>`).join('')}`;
const cats=()=>`<div class="mt2">${L('Categories','Ibyiciro','Catégories')}</div><div class="pad" style="padding-top:0"><div class="req">${['Games','Shopping','Money','Travel','Learning','Lifestyle','Utilities'].map(c=>`<button onclick="soon()">${c}</button>`).join('')}</div></div>`;
screens.mini=()=>{const T=[['feat',L('Featured','Byatoranyijwe','À la une')],['games',L('Games','Imikino','Jeux')],['pts',L('Points','Amanota','Points')],['cats',L('Categories','Ibyiciro','Catégories')]];
return `<div class="mh"><button class="ib" aria-label="Back" onclick="back()">${ic('back',24)}</button><button class="ib" aria-label="Profile" onclick="go('miniprof')">${ic('user',24,'var(--tt)')}</button></div><div class="msr">${ic('search',20)}<span>${L('Search games, deals, tools…','Shakisha imikino, ibicuruzwa…','Rechercher jeux, offres…')}</span></div><div class="mtabs">${T.map(([k,l])=>`<button class="${S.mt===k?'on':''}" onclick="miniTab('${k}')">${l}</button>`).join('')}</div>${({feat,games,pts,cats})[S.mt]()}<div style="height:30px"></div>`};
screens.miniprof=()=>`${bar('')}<div class="hd" style="padding-top:10px"><div class="av" style="width:56px;height:56px;border-radius:16px;background:var(--tint);color:var(--tintfg);display:flex;align-items:center;justify-content:center;font-size:24px;font-weight:800">🐼</div><div style="flex:1"><div class="s" style="margin:0">${L('My profile','Umwirondoro wanjye','Mon profil')}</div><div class="t" style="font-size:22px">${L('Player','Umukinnyi','Joueur')}84825</div></div><button style="background:var(--chip);color:var(--tx)" onclick="soon()">${L('Edit','Hindura','Modifier')}</button></div>${[L('Connect friends','Huza n’inshuti','Ajouter des amis'),L('Purchase history','Amateka y’ibyaguzwe','Historique d’achats')].map(x=>`<div class="ar tap" style="padding:16px 24px" onclick="soon()"><div class="t" style="flex:1;font-weight:600">${x}</div>${ic('chev',16,'var(--tt)')}</div>`).join('')}`;
if(!P.user)P.user='M12 12a4 4 0 100-8 4 4 0 000 8zM4 21a8 8 0 0116 0z';
const _e=screens.explore;
screens.explore=()=>_e().replace(/onclick="soon\(\)">((?:(?!<\/button>)[\s\S])*?)(Mini apps|Games)<\/button>/g,(m,a,l)=>`onclick="openMini('${l==='Games'?'games':'feat'}')">${a}${l}</button>`);
})();
</script>
<script>
/* v56: Airtime Top-up mini app */
(function(){
const L=(e,r,f)=>({en:e,rw:r,fr:f}[S.lang]||e);
S.air=S.air||{op:'MTN',ph:'',amt:1000,done:null,hist:[]};
const _s=window.startApp;
window.startApp=n=>{if(n==='Airtime Top-up'){S.air.done=null;go('airtime')}else _s(n)};
window.airSet=(k,v)=>{S.air[k]=v;render('fade-none')};
window.airPh=v=>{S.air.ph=v.replace(/\D/g,'').slice(0,10);const b=document.getElementById('airgo');if(b){const ok=S.air.ph.length>=9&&S.air.amt<=S.pay;b.disabled=!ok}};
window.airPay=()=>{const A=S.air;if(A.ph.length<9||A.amt>S.pay)return;S.pay-=A.amt;A.hist.unshift([A.op,A.ph,A.amt]);A.done=[A.op,A.ph,A.amt];render('fade-none')};
const mask=p=>p.replace(/(\d{3})(\d{3})(\d+)/,'$1 $2 $3');
screens.airtime=()=>{const A=S.air;
if(A.done)return `${bar('')}<div style="text-align:center;padding:56px 32px 0"><div style="width:84px;height:84px;border-radius:42px;background:var(--br);margin:0 auto;display:flex;align-items:center;justify-content:center">${ic('check',44,'#17171C')}</div><div class="h1" style="font-size:26px;margin-top:22px">${L('Airtime sent','Airtime yoherejwe','Crédit envoyé')}</div><div class="mu" style="font-size:16px;margin-top:8px;line-height:24px">${fmt(A.done[2])} RWF ${A.done[0]}<br>${L('to','kuri','vers')} ${mask(A.done[1])}</div><div class="sm mu" style="margin-top:18px">${L('Balance','Asigaye','Solde')}: ${fmt(S.pay)} RWF</div></div><div class="cta"><button class="btn" onclick="S.air.done=null;S.air.ph='';back()">${L('Done','Byarangiye','Terminé')}</button></div>`;
const low=A.amt>S.pay,ok=A.ph.length>=9&&!low;
return `${bar('')}<div class="stt">${L('Buy airtime','Gura airtime','Acheter du crédit')}</div>
<div class="pad" style="padding-top:0"><div class="sm mu" style="margin-bottom:8px">${L('Network','Umuyoboro','Réseau')}</div><div class="req">${['MTN','Airtel'].map(o=>`<button class="${A.op===o?'on':''}" onclick="airSet('op','${o}')">${o}</button>`).join('')}</div>
<div class="sm mu" style="margin:20px 0 8px">${L('Phone number','Nimero ya telefoni','Numéro de téléphone')}</div><input id="airph" inputmode="numeric" value="${A.ph}" placeholder="078 000 0000" oninput="airPh(this.value)" style="width:100%;box-sizing:border-box;height:52px;border:0;border-radius:16px;background:var(--chip);padding:0 16px;font:inherit;font-size:20px;font-weight:700;color:var(--tx);outline:0">
<div class="sm mu" style="margin:20px 0 8px">${L('Amount','Amafaranga','Montant')}</div><div class="req">${[500,1000,2000,5000].map(a=>`<button class="${A.amt===a?'on':''}" onclick="airSet('amt',${a})">${fmt(a)} RWF</button>`).join('')}</div>
<div style="margin-top:22px;display:flex;justify-content:space-between;font-size:14px"><span class="mu">${L('Pay with','Ishyura na','Payer avec')}</span><b>itunda Pay · ${fmt(S.pay)} RWF</b></div>${low?`<div style="color:var(--er);font-size:14px;margin-top:10px">${L('Not enough balance','Amafaranga ntahagije','Solde insuffisant')} — RWF ${fmt(S.pay)}</div>`:''}
${A.hist.length?`<div style="font-size:16px;font-weight:800;margin-top:26px">${L('Recent','Aheruka','Récents')}</div>${A.hist.slice(0,3).map(h=>`<div style="display:flex;justify-content:space-between;padding:10px 0;font-size:15px"><span>${h[0]} · ${mask(h[1])}</span><b>−${fmt(h[2])} RWF</b></div>`).join('')}`:''}</div>
<div class="cta"><button id="airgo" class="btn" ${ok?'':'disabled'} onclick="airPay()">${L('Buy','Gura','Acheter')} ${fmt(A.amt)} RWF</button></div>`};
})();
</script>
<script>

const __MU=12.5,__R=6378137,__mx=o=>__R*o*Math.PI/180,__my=a=>__R*Math.log(Math.tan(Math.PI/4+a*Math.PI/360)),__X0=__mx(30.127),__Y0=__my(-1.9488);
window.ll2xy=(la,lo)=>[250+(__mx(lo)-__X0)/__MU,440-(__my(la)-__Y0)/__MU];
window.xy2ll=(x,y)=>{const Y=__Y0+(440-y)*__MU,X=__X0+(x-250)*__MU;return[(2*Math.atan(Math.exp(Y/__R))-Math.PI/2)*180/Math.PI,X/__R*180/Math.PI]};
/* v57: Kigali Maps — search, place page, route planner (bus/car/walk/bike) */
(function(){
const st=document.createElement('style');
st.textContent='.mps{margin:10px 16px 0;height:50px;border-radius:25px;background:var(--chip);display:flex;align-items:center;gap:10px;padding:0 8px 0 6px;color:var(--tt);font-size:16px}.chp{display:flex;gap:10px;overflow-x:auto;padding:14px 16px 0;scrollbar-width:none}.chp::-webkit-scrollbar{display:none}.chp button{flex:0 0 auto;height:40px;padding:0 18px;border-radius:20px;border:0;background:var(--chip);font:inherit;font-size:15px;font-weight:700;color:var(--tx)}.chp button.on{background:var(--lk);color:#fff}.pl{display:flex;align-items:center;gap:14px;padding:14px 20px}.pl i{width:42px;height:42px;border-radius:21px;background:var(--chip);display:flex;align-items:center;justify-content:center;flex-shrink:0}.pl b{flex:1;font-size:17px;font-weight:600}.pl span{color:var(--tt);font-size:14px}.acts{display:flex;gap:8px;overflow-x:auto;padding:14px 16px 0;scrollbar-width:none}.acts::-webkit-scrollbar{display:none}.acts button{flex:0 0 auto;height:44px;padding:0 20px;border-radius:22px;border:1.5px solid var(--ln);background:none;font:inherit;font-weight:700;font-size:15px;color:var(--tx)}.acts button.p{background:var(--tint);color:var(--tintfg);border-color:transparent}.acts button.q{background:var(--lk);color:#fff;border-color:transparent}.ptabs{display:flex;border-bottom:0;margin-top:16px;padding:0 8px}.ptabs button{flex:1;height:44px;border:0;background:none;font:inherit;font-weight:700;font-size:15px;color:var(--tt);position:relative}.ptabs button.on{color:var(--tx)}.ptabs button.on:after{content:"";position:absolute;left:20%;right:20%;bottom:-1px;height:3px;background:var(--tx);border-radius:2px}.mn{display:flex;align-items:center;gap:14px;padding:16px 24px;border-bottom:0}.mn .ph{width:84px;height:84px;border-radius:20px;display:flex;align-items:center;justify-content:center;font-size:40px;background:var(--tint);flex-shrink:0}.fi{display:flex;gap:14px;padding:12px 24px;font-size:15px;line-height:22px;align-items:flex-start}.fi svg{flex-shrink:0;margin-top:2px}.rbox{margin:8px 16px 0;border:1.5px solid var(--ln);border-radius:20px;padding:6px 14px}.modes{display:flex;justify-content:space-around;padding:12px 8px 10px}.modes button{height:44px;padding:0 16px;border-radius:22px;border:0;background:none;font:inherit;font-size:15px;font-weight:700;color:var(--mu);display:flex;align-items:center;gap:8px}.modes button.on{background:var(--lk);color:#fff}.rc{flex:0 0 74%;border:2px solid var(--ln);border-radius:20px;padding:14px 16px;background:var(--bg)}.rc.on{border-color:var(--lk)}.rc small{font-size:13px;color:var(--mu);display:block;margin-top:2px}.rc .m{font-size:32px;font-weight:800;letter-spacing:-.6px}.seg{display:flex;height:26px;border-radius:13px;overflow:hidden;margin:12px 0 6px;background:var(--chip)}.seg div{display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;color:#fff}.arr{display:flex;align-items:center;gap:10px;padding:7px 0;font-size:15px}.arr b.n{background:#3B7D20;color:#fff;border-radius:8px;padding:3px 10px;font-size:15px}.arr .t{font-weight:700}.arr .lv{margin-left:auto;font-size:12px;font-weight:700;color:#2BA84A;border:1px solid #2BA84A;border-radius:5px;padding:1px 6px}';
document.head.appendChild(st);
const L=(e,r,f)=>({en:e,rw:r,fr:f}[S.lang]||e);
const M=S.mp=S.mp||{mode:'bus',tab:'home',rf:'recent',rec:[['Nyamirambo Coffee House','15 Oct'],['KG 7 Ave 22, Kacyiru','04 Oct'],['Kimironko Market','04 Oct'],['Kigali Heights Dental','04 Oct']],opt:0,star:false};
const PLACE={n:'Nyamirambo Coffee House',cat:'Cafe, Dessert',rv:495,addr:'KN 3 Rd 12, Nyarugenge, Kigali',near:'251 m from Nyabugogo bus park'};
const MENU=[['☕','Americano',1800],['🥛','Café latte',2500],['🍮','Spanish latte',3000],['🧋','Milk tea',2200],['🥪','Grilled ham & cheese sandwich',4500]];
window.mpGo=n=>{S.stack.push(n);render('push')};
window.mpSet=(k,v)=>{M[k]=v;render('fade-none')};
window.mpDel=i=>{M.rec.splice(i,1);render('fade-none')};
window.mpArrive=()=>{M.mode='bus';M.opt=0;mpGo('route')};
const _s=window.startApp;window.openMaps=()=>{S.stack=['mapsearch'];render('push')};
const pin=(c='var(--tt)')=>ic('home',20,c);
const mic=ic('search',20,'var(--tt)');
screens.mapsearch=()=>{const chips=[['recent',L('Recent','Ibyaheruka','Récents')],['book',L('Bookings','Ibyateguwe','Réservations')],['place',L('Places','Ahantu','Lieux')],['bus',L('Bus','Bisi','Bus')],['route',L('Routes','Inzira','Itinéraires')]];
return `<div class="mh" style="padding-bottom:0"><button class="ib" aria-label="Back" onclick="back()">${ic('back',24)}</button><div style="flex:1;text-align:center;font-weight:800;font-size:18px">${L('Kigali Maps','Ikarita ya Kigali','Cartes de Kigali')}</div><span style="width:44px"></span></div>
<div class="mps">${mic}<span style="flex:1">${L('Search places, bus stops, addresses','Shakisha ahantu, aho bisi zihagarara','Lieux, arrêts de bus, adresses')}</span></div>
<div class="chp" style="padding-top:12px">${[['🏠',L('Home','Mu rugo','Maison')],['💼',L('Work','Akazi','Travail')],['📍','Kimironko']].map(x=>`<button onclick="soon()">${x[0]} ${x[1]}</button>`).join('')}</div>
<div class="chp">${chips.map(([k,l])=>`<button class="${M.rf===k?'on':''}" onclick="mpSet('rf','${k}')">${l}</button>`).join('')}</div>
<div style="padding-top:8px">${M.rec.length?M.rec.map((r,i)=>`<div class="pl tap" onclick="${i===0?"mpGo('place')":'soon()'}"><i>${pin()}</i><b>${r[0]}</b><span>${r[1]}</span><button class="ib" style="width:32px;height:32px" aria-label="Remove" onclick="event.stopPropagation();mpDel(${i})">${ic('plus',18,'var(--tt)').replace('<svg','<svg style="transform:rotate(45deg)"')}</button></div>`).join(''):`<div class="pad mu" style="text-align:center;padding-top:40px">${L('No recent searches','Nta byashakishijwe','Aucune recherche récente')}</div>`}</div>`};
screens.place=()=>{const T=[['home',L('Home','Ahabanza','Accueil')],['menu',L('Menu','Menu','Menu')],['photos',L('Photos','Amafoto','Photos')],['info',L('Info','Amakuru','Infos')]];
const hero=`<div style="margin:14px 16px 0;height:190px;border-radius:24px;background:#D9A56B;display:flex;align-items:center;justify-content:center;font-size:72px">☕</div>`;
const rowi=(g,t)=>`<div class="fi">${ic(g,20,'var(--tt)')}<div>${t}</div></div>`;
let body='';
if(M.tab==='home')body=`${hero}<div class="fi" style="padding-top:18px">${ic('home',20,'var(--tt)')}<div>${PLACE.addr}<div style="margin-top:6px"><span style="background:#D92D20;color:#fff;font-size:12px;font-weight:800;border-radius:12px;padding:2px 8px">BRT</span> <span class="mu">${PLACE.near}</span></div></div></div>${rowi('lock',L('Free parking for 2 hours at Kigali Tower, level 1','Parikingi ubuntu amasaha 2','Parking gratuit 2 h'))}${rowi('phone',`<b style="color:#2BA84A">${L('Open','Irafunguye','Ouvert')}</b> · ${L('closes at 22:00','ifunga saa 22:00','ferme à 22h')}`)}${rowi('phone','+250 788 000 323 <a style="color:var(--lk);font-weight:700" onclick="toast(\'Copied\')">'+L('Copy','Kopiya','Copier')+'</a>')}
<div class="mt2" style="padding-top:20px">${L('Menu','Menu','Menu')} ${MENU.length}</div><div class="mcs">${MENU.slice(0,3).map(m=>`<div style="flex:0 0 44%"><div class="mn" style="padding:0;border:0"><div class="ph" style="width:100%;height:120px">${m[0]}</div></div><div style="font-size:15px;margin-top:8px">${m[1]}</div><b>${fmt(m[2])} RWF</b></div>`).join('')}</div>
<div style="margin:24px 16px 0;background:var(--tint);border-radius:20px;padding:16px"><b style="color:var(--tintfg)">✨ ${L('AI summary','Incamake ya AI','Résumé IA')}</b><div style="margin-top:8px;font-size:15px;line-height:23px">${L('A spacious, comfortable cafe near the bus park, with espresso drinks, brunch and desserts. Good for working or meeting, with free Wi-Fi and easy parking.','Ikawa nini kandi yorohereye hafi ya gare, ifite ikawa, ifunguro rya mu gitondo n’ibiryohereye. Nziza ku kazi cyangwa guhurira, ifite Wi-Fi ubuntu.','Café spacieux près de la gare routière : cafés, brunch et desserts. Idéal pour travailler ou se retrouver, Wi-Fi gratuit.')}</div></div>`;
else if(M.tab==='menu')body=MENU.map(m=>`<div class="mn"><div style="flex:1"><div style="font-size:19px;font-weight:700">${m[1]}</div><div style="font-size:17px;margin-top:6px">${fmt(m[2])} RWF</div></div><div class="ph">${m[0]}</div></div>`).join('');
else if(M.tab==='photos')body=`<div class="chp">${['Exterior','Clips','Interior','Food & drink'].map((x,i)=>`<button class="${i?'':'on'}">${x}</button>`).join('')}</div><div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;padding:14px 16px">${['#6B4A2E','#3D5A80','#7B2D26','#2F4F3A'].map((g,i)=>`<div style="height:${i%3===0?170:120}px;border-radius:20px;background:${g};display:flex;align-items:center;justify-content:center;font-size:44px">${['🏠','🥐','🪑','☕'][i]}</div>`).join('')}</div>`;
else body=`${rowi('home',PLACE.addr)}${rowi('phone','Mon–Sun 07:00–22:00')}${rowi('phone','+250 788 000 323')}${rowi('bill',L('Groups, takeaway, reservations, Wi-Fi, separate restrooms','Amatsinda, kujyana, kubika, Wi-Fi','Groupes, à emporter, réservation, Wi-Fi'))}`;
return `<div class="mh" style="padding-bottom:0"><button class="ib" aria-label="Back" onclick="back()">${ic('back',24)}</button><b style="flex:1;font-size:19px;margin-left:6px">${PLACE.n}</b><button class="ib" aria-label="Save" onclick="M.star=!M.star;toast(M.star?'Saved':'Removed');render('fade-none')">${ic('star',24,M.star?'#F5B301':'var(--tx)')}</button></div>
<div style="padding:6px 24px 0"><div class="sm mu">${PLACE.cat} · ${L('Reviews','Ibitekerezo','Avis')} ${PLACE.rv}</div></div>
<div class="acts"><button class="p" onclick="toast('Set as start')">${L('Depart','Gutangira','Départ')}</button><button class="q" onclick="mpArrive()">${L('Arrive','Kugerayo','Arrivée')}</button><button onclick="toast('Link copied')">${L('Share','Sangiza','Partager')}</button><button onclick="toast('Calling is not in this prototype')">${L('Call','Hamagara','Appeler')}</button></div>
<div class="ptabs">${T.map(([k,l])=>`<button class="${M.tab===k?'on':''}" onclick="mpSet('tab','${k}')">${l}</button>`).join('')}</div>${body}<div style="height:30px"></div>`};
P.mbus='M5 4h14v12H5zM5 11h14M8 20v-4M16 20v-4';P.mcar='M4 15l2-7h12l2 7v4H4zM4 15h16M7 17.5h.01M17 17.5h.01';P.mwalk='M13 4.5a1 1 0 100 .01M10 21l2-7-2-3 3-3 2.5 3H19M10 9l-3 3';P.mbike='M6 18a3 3 0 100 .01M18 18a3 3 0 100 .01M6 18l4-8h5l3 8M10 10L9 7H7';const MODES=[['bus','mbus','35'],['car','mcar','17'],['walk','mwalk','1h34'],['bike','mbike','28']];
const OPT={bus:[['Best',35,'Tap&Go 400 RWF',[[3,'#8B95A1','🚶'],[22,'#3B7D20','305'],[4,'#8B95A1',''],[2,'#3B7D20','102'],[3,'#8B95A1','🚶']]],['305 + 1 transfer',34,'400 RWF',null],['Route 311',37,'300 RWF',null]],car:[['Live best',17,'7.9 km · Free',null],['Main road',18,'9.7 km · Free',null],['Shortest',22,'5.9 km · Free',null]],walk:[['Best',94,'5.6 km · 8,677 steps',null],['Main road',97,'6 km · 9,384 steps',null],['Avoid stairs',97,'5.7 km',null]],bike:[['Bike route',28,'6.7 km',null]]};
const tmin=m=>m>=60?Math.floor(m/60)+' h '+(m%60)+' min':m+' min';
const COLOR={bus:'#3B7D20',car:'#2E6BF0',walk:'#2E6BF0',bike:'#2E6BF0'};
const PATH={bus:'M250 60 C250 110 200 130 190 180 S120 230 100 290',car:'M250 60 C230 120 170 150 160 210 S110 260 100 290',walk:'M250 60 L250 120 L190 130 L180 220 L120 240 L100 290',bike:'M250 60 L250 100 L140 110 L150 230 L100 250 L100 290'};
screens.route=()=>{const o=OPT[M.mode],cur=o[Math.min(M.opt,o.length-1)];
const map=`<svg viewBox="0 0 340 330" width="100%" style="display:block;background:var(--chip)" role="img" aria-label="Route map"><path d="M0 90L340 70M0 200L340 220M90 0L110 330M240 0L220 330" stroke="var(--bg)" stroke-width="12" fill="none" opacity=".9"/><path d="${PATH[M.mode]}" fill="none" stroke="${COLOR[M.mode]}" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" ${M.mode==='bike'?'stroke-dasharray="1 10"':''}/><circle cx="250" cy="60" r="13" fill="#2BA84A"/><circle cx="100" cy="290" r="13" fill="#D92D20"/><text x="262" y="50" font-size="12" font-weight="800" fill="var(--tx)">${L('Start','Gutangira','Départ')}</text><text x="116" y="296" font-size="12" font-weight="800" fill="var(--tx)">${L('Arrive','Kugerayo','Arrivée')}</text></svg>`;
const seg=cur[3]?`<div class="seg">${cur[3].map(s=>`<div style="flex:${s[0]};background:${s[1]}">${s[2]}</div>`).join('')}</div>`:'';
const live=M.mode==='bus'?`<div style="padding:4px 24px 0"><div class="fi" style="padding:10px 0"><b>${L('Board at','Kurira kuri','Montez à')} Kimironko Market stop</b></div><div class="rbox" style="margin:0">${[['311','soon'],['305','1 min'],['311','9 min']].map(x=>`<div class="arr"><b class="n">${x[0]}</b><span class="t" style="color:${x[1]==='soon'?'#D92D20':'var(--tx)'}">${x[1]==='soon'?L('Arriving soon','Hafi kuhagera','Arrive'):x[1]}</span><span class="lv">${L('Seats','Intebe','Places')}</span></div>`).join('')}</div><div class="fi" style="padding:12px 0"><span class="mu">${L('11 stops · 22 min','Aho bisi zihagarara 11 · 22 min','11 arrêts · 22 min')}</span></div><div class="fi" style="padding:0"><b>${L('Get off at','Manuka kuri','Descendez à')} Nyabugogo Stop</b></div><div class="fi mu" style="padding:6px 0 0">${L('Walk 223 m · 3 min to','Genda 223 m · iminota 3 kugera','Marchez 223 m · 3 min jusqu’à')} ${PLACE.n}</div></div>`:'';
return `<div class="rbox" style="margin-top:14px"><div class="fi" style="padding:10px 4px"><span style="width:12px;height:12px;border-radius:6px;border:3px solid #2BA84A;margin:6px 6px 0 0"></span>KG 11 Ave, Kimironko</div><div class="fi" style="padding:10px 4px;border-top:0"><span style="width:12px;height:12px;border-radius:6px;border:3px solid #D92D20;margin:6px 6px 0 0"></span>${PLACE.n}</div></div>
<div class="modes">${MODES.map(([k,g,t])=>`<button class="${M.mode===k?'on':''}" onclick="M.opt=0;mpSet('mode','${k}')" aria-label="${k}">${ic(g,20,M.mode===k?'#fff':'var(--mu)')}${M.mode===k?tmin(o[0][1]):''}</button>`).join('')}</div>
${map}
<div class="mcs" style="padding:12px 16px 0">${o.map((x,i)=>`<div class="rc ${M.opt===i?'on':''}" onclick="mpSet('opt',${i})"><b style="color:${M.opt===i?'var(--lk)':'var(--mu)'}">${x[0]}</b><div class="m">${tmin(x[1])}</div><small>${x[2]}</small></div>`).join('')}</div>
<div style="padding:8px 24px 0">${seg}${cur[3]?`<div class="sm mu">2:06 pm – 2:41 pm · ${cur[2]}</div>`:''}</div>${live}<div class="cta"><div style="display:flex;gap:10px"><button class="btn sec2" style="flex:0 0 36%" onclick="toast('Preview: not in this prototype')">${L('Preview','Reba','Aperçu')}</button><button class="btn" onclick="toast('Navigation: not in this prototype')">${L('Start','Tangira','Démarrer')}</button></div></div>`.replace('<div class="rbox" style="margin-top:14px">',`<div class="mh" style="padding-bottom:0"><button class="ib" aria-label="Back" onclick="back()">${ic('back',24)}</button><b style="font-size:18px">${L('Directions','Inzira','Itinéraire')}</b></div><div class="rbox" style="margin-top:8px">`)};
/* put Maps first in Mini apps trending list */
})();
</script>
<script>
/* v59: Maps — map-first place sheet, route timeline with live arrivals, per-mode details */
(function(){
const st=document.createElement('style');
st.textContent='.sh2{position:relative;margin-top:-26px;background:var(--bg);border-radius:28px 28px 0 0;padding:10px 20px 24px;box-shadow:none}.hdl{width:44px;height:5px;border-radius:3px;background:var(--ln);margin:0 auto 14px;cursor:pointer}.fl{position:absolute;left:12px;right:12px;top:12px;height:50px;border-radius:25px;background:var(--bg);box-shadow:none;display:flex;align-items:center;padding:0 6px;gap:4px;z-index:2}.fl b{flex:1;font-size:18px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.mb{position:absolute;right:12px;width:44px;height:44px;border-radius:22px;background:var(--bg);box-shadow:none;display:flex;align-items:center;justify-content:center;border:0;z-index:2}.ti{position:relative;padding:0 0 20px 58px}.ti:before{content:"";position:absolute;left:23px;top:36px;bottom:-2px;border-left:4px dotted var(--ln)}.ti.bus:before{border-left:7px solid #3B7D20;border-radius:4px;left:21px;top:34px}.ti.last:before{display:none}.ti .dot{position:absolute;left:6px;top:0;width:34px;height:34px;border-radius:17px;border:3px solid var(--ln);display:flex;align-items:center;justify-content:center;background:var(--bg);font-size:14px}.ti .tm{position:absolute;left:0;top:44px;font-size:12px;font-weight:700;border:1px solid var(--ln);border-radius:6px;padding:1px 4px;background:var(--bg)}.ti h4{margin:0;font-size:18px;font-weight:800;line-height:34px}.ti .sub{font-size:14px;color:var(--mu)}.ti .wk{font-size:15px;color:var(--mu);padding:14px 0 2px}.ti .wk b{color:var(--tx)}.abox{border:1.5px solid var(--ln);border-radius:18px;padding:12px 16px;margin:10px 0}.stp{font-size:14px;color:var(--mu);padding:3px 0}.pbtn{display:inline-flex;align-items:center;gap:8px;height:40px;padding:0 18px;border-radius:20px;border:1.5px solid var(--ln);background:none;font:inherit;font-weight:700;font-size:15px;color:var(--tx);margin-top:10px}.ocp{flex:0 0 auto;height:42px;padding:0 16px;border-radius:21px;background:var(--bg);box-shadow:none;display:flex;align-items:center;gap:8px;font-size:15px;font-weight:700;border:2px solid transparent;color:var(--tx)}.ocp.on{background:var(--lk);color:#fff}.tg{font-size:12px;font-weight:700;border-radius:6px;padding:2px 8px;background:var(--chip);color:var(--mu)}';
document.head.appendChild(st);
const L=(e,r,f)=>({en:e,rw:r,fr:f}[S.lang]||e);
const M=S.mp;window.M=M;window.mpGo=n=>{M.exp=false;S.stack.push(n);render('push')};if(M.exp===undefined)M.exp=false;if(M.stops===undefined)M.stops=false;if(M.later===undefined)M.later=false;
const PL=window.PL={n:'Nyamirambo Coffee House'};
const _place=screens.place;
window.mpExp=v=>{M.exp=v;render('fade-none')};
const G=(ids)=>ids;
const poiMap=`<svg viewBox="0 0 340 300" width="100%" style="display:block;background:var(--chip)" role="img" aria-label="Map of the cafe area"><path d="M0 120L340 100M0 230L340 245M80 0L95 300M250 0L240 300" stroke="var(--bg)" stroke-width="14" fill="none"/><rect x="108" y="130" width="60" height="44" rx="4" fill="var(--ln)"/><rect x="180" y="130" width="52" height="44" rx="4" fill="var(--ln)"/><rect x="108" y="190" width="124" height="30" rx="4" fill="var(--ln)"/><rect x="260" y="130" width="60" height="80" rx="4" fill="var(--ln)"/><path d="M0 60C80 80 160 50 340 70" stroke="#6AA9F0" stroke-width="14" fill="none" opacity=".45"/><g font-size="11" font-weight="700" fill="var(--mu)"><text x="112" y="206">City Bank</text><text x="262" y="174">Office Suites</text><text x="14" y="150">Grill House</text><text x="116" y="268">Bus stop</text></g><circle cx="248" cy="106" r="7" fill="#2E6BF0"/><circle cx="130" cy="262" r="7" fill="#2E6BF0"/><g transform="translate(150 104)"><path d="M0 0c-14-18-24-28-24-40a24 24 0 0148 0c0 12-10 22-24 40z" fill="#E8604C"/><text x="-9" y="-30" font-size="18">☕</text></g><text x="108" y="104" font-size="12" font-weight="800" fill="var(--tx)">${PL.n}</text></svg>`;
screens.place=()=>{if(M.exp)return _place().replace(/(<div class="mh"[^>]*>)/,'$1<!--x-->').replace('onclick="back()"','onclick="mpExp(false)"');
return `<div style="position:relative">${poiMap}<div class="fl"><button class="ib" aria-label="Back" onclick="back()">${ic('back',22)}</button><b>${PL.n}</b><button class="ib" aria-label="Close" onclick="back()">${ic('plus',22).replace('<svg','<svg style="transform:rotate(45deg)"')}</button></div><button class="mb" style="top:76px" aria-label="Layers">${ic('grid',20)}</button><button class="mb" style="top:128px" aria-label="Saved places" onclick="toast('Saved places')">${ic('star',20,'#2E6BF0')}</button><button class="mb" style="bottom:46px" aria-label="My location" onclick="toast('Centered on you')">${ic('pin',20)}</button></div>
<div class="sh2"><div class="hdl" onclick="mpExp(true)" aria-label="Expand"></div><div style="display:flex;align-items:center"><b style="flex:1;font-size:24px;letter-spacing:-.4px">${PL.n}</b><button class="ib" style="background:var(--chip);border-radius:22px" aria-label="Save" onclick="M.star=!M.star;toast(M.star?'Saved':'Removed');render('fade-none')">${ic('star',22,M.star?'#F5B301':'var(--tx)')}</button></div>
<div class="sm mu" style="margin-top:4px">Cafe, Dessert · ${L('Reviews','Ibitekerezo','Avis')} 495</div><div style="margin-top:6px;font-size:15px"><b style="color:#2BA84A">${L('Open','Irafunguye','Ouvert')}</b> · ${L('closes at 22:00','ifunga saa 22:00','ferme à 22h')}</div><div style="margin-top:4px;font-size:15px"><b>4.4 km</b> <span class="mu">· Nyarugenge, Kigali</span></div>
<div class="acts" style="padding:14px 0 0"><button class="p" onclick="toast('Set as start')">${L('Depart','Gutangira','Départ')}</button><button class="q" onclick="mpArrive()">${L('Arrive','Kugerayo','Arrivée')}</button><button onclick="toast('Link copied')">${L('Share','Sangiza','Partager')}</button><button onclick="toast('Calling is not in this prototype')">${L('Call','Hamagara','Appeler')}</button><button onclick="toast('You’ll be notified of updates')">${L('Follow','Kurikira','Suivre')}</button></div>
<div class="mcs" style="padding:14px 0 0">${['#6B4A2E|🏠','#7B2D26|🥐','#3D5A80|🪑'].map(x=>{const[a,b]=x.split('|');return `<div style="flex:0 0 70%;height:150px;border-radius:20px;background:${a};display:flex;align-items:center;justify-content:center;font-size:56px" onclick="mpExp(true)">${b}</div>`}).join('')}</div><button class="pbtn" style="width:100%;justify-content:center" onclick="mpExp(true)">${L('More info','Amakuru yose','Plus d’infos')}</button></div>`};
const tmin=m=>m>=60?Math.floor(m/60)+' h '+(m%60)+' min':m+' min';
const PATH={bus:'M250 60 C250 110 200 130 190 180 S120 230 100 290',car:'M250 60 C230 120 170 150 160 210 S110 260 100 290',walk:'M250 60 L250 120 L190 130 L180 220 L120 240 L100 290',bike:'M250 60 L250 100 L140 110 L150 230 L100 250 L100 290'};
const ALT={bus:'M250 60 L250 150 L150 160 L110 290',car:'M250 60 L280 150 L200 250 L100 290',walk:'M250 60 L270 150 L200 170 L150 260 L100 290',bike:''};
const COLOR={bus:'#3B7D20',car:'#2E6BF0',walk:'#2E6BF0',bike:'#2E6BF0'};
const OPT={bus:[['Best',35],['305 + 1 transfer',34],['Route 311',37]],car:[['Live best',17,'7.9 km · Free'],['Main road',18,'9.7 km · Toll 1,000 RWF'],['Shortest',22,'5.9 km · Free']],walk:[['Best',94,'5.6 km · 8,677 steps','15 crossings · 1 stair'],['Main road',97,'6 km · 9,384 steps','16 crossings · 1 underpass'],['Avoid stairs',97,'5.7 km · 8,800 steps','12 crossings']],bike:[['Bike route',28,'6.7 km','Dedicated lane 3.1 km']]};
window.__OPT=OPT;const KM={bus:'busstop',car:'mcar',walk:'mwalk',bike:'mbike'};
const mapR=(chips)=>{const m=M.mode;return `<div style="position:relative"><svg viewBox="0 0 340 330" width="100%" style="display:block;background:var(--chip)" role="img" aria-label="Route map"><path d="M0 90L340 70M0 200L340 220M90 0L110 330M240 0L220 330" stroke="var(--bg)" stroke-width="12" fill="none" opacity=".9"/>${M.opt>0&&ALT[m]?`<path d="${ALT[m]}" fill="none" stroke="var(--tt)" stroke-width="7" stroke-linecap="round" opacity=".45"/>`:''}<path d="${PATH[m]}" fill="none" stroke="${COLOR[m]}" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" ${m==='bike'?'stroke-dasharray="1 10"':''}/>${m==='bus'?'<rect x="258" y="78" width="46" height="24" rx="8" fill="#3B7D20"/><text x="266" y="95" font-size="13" font-weight="800" fill="#fff">305 ›</text><rect x="120" y="226" width="46" height="24" rx="8" fill="#3B7D20"/><text x="130" y="243" font-size="13" font-weight="800" fill="#fff">102 ›</text>':''}<circle cx="250" cy="60" r="13" fill="#2BA84A"/><circle cx="100" cy="290" r="13" fill="#D92D20"/><text x="264" y="52" font-size="12" font-weight="800" fill="var(--tx)">${L('Start','Gutangira','Départ')}</text><text x="116" y="296" font-size="12" font-weight="800" fill="var(--tx)">${L('Arrive','Kugerayo','Arrivée')}</text></svg>${chips?`<div class="mcs" style="position:absolute;left:0;right:0;top:12px;padding:0 12px">${chips}</div>`:''}<button class="mb" style="bottom:12px" aria-label="My location" onclick="toast('Centered on you')">${ic('pin',20)}</button></div>`};
window.mpStops=()=>{M.stops=!M.stops;render('fade-none')};
const STOPS=['Kimironko Market','Kimironko Bus Park','Gisimenti','Remera Taxi Park','Stade Amahoro','Kisimenti','Kacyiru','Gishushu','Kigali Heights','Nyabugogo Road','Nyabugogo Bus Park'];
const busDetail=()=>`<div style="padding:6px 0 0"><div class="sm mu" style="padding-bottom:12px;border-bottom:0">${L('As of 2:05 pm (wait 1 min)','Guhera saa 8:05 (utegereze umunota 1)','À 14h05 (attente 1 min)')}</div></div>
<div style="padding-top:18px"><div class="ti"><div class="dot" style="border-color:#2BA84A">📍</div><span class="tm">14:06</span><h4>KG 11 Ave, Kimironko</h4><div class="wk">${L('Walk','Genda','Marcher')} <b>220 m · 3 min</b></div></div>
<div class="ti bus"><div class="dot" style="border-color:#3B7D20">🚌</div><h4>Kimironko Market ${L('boarding','kurira','montée')}</h4><div class="sub">Stop 06163</div><div class="abox"><b style="color:#3B7D20">🚌 305, 311</b><div style="border-top:0;margin:10px 0 4px"></div>${[['311','soon','Stop 1'],['305','1 min','Stop 1'],['311','9 min','Stop 7']].map(x=>`<div class="arr"><b class="n">${x[0]}</b><span class="t" style="color:${x[1]==='soon'?'#D92D20':'#D92D20'}">${x[1]==='soon'?L('Arriving soon','Hafi kuhagera','Arrive'):x[1]}</span><span class="mu">${x[2]}</span><span class="lv">${L('Seats','Intebe','Places')}</span></div>`).join('')}<div style="border-top:0;margin-top:8px;padding-top:10px;text-align:center;font-weight:700;font-size:15px" onclick="toast('More arrivals: not in this prototype')">${L('More arrival info','Andi makuru y’ihagera','Plus d’arrivées')} ›</div></div>
<div class="sub" style="padding-top:4px"><span onclick="mpStops()" style="cursor:pointer">${STOPS.length} ${L('stops','aho bisi zihagarara','arrêts')} · <b style="color:var(--tx)">22 min</b> ${M.stops?'⌃':'⌄'}</span></div>${M.stops?`<div style="padding:8px 0 0">${STOPS.map(s=>`<div class="stp">• ${s}</div>`).join('')}</div>`:''}</div>
<div class="ti bus"><div class="dot" style="border-color:#3B7D20">🔁</div><h4>Nyabugogo Bus Park ${L('transfer','guhindura','correspondance')}</h4><div class="sub">${L('Wait 4 min · board 102','Tegereza iminota 4 · bisi 102','Attente 4 min · bus 102')}</div><div class="sub" style="padding-top:8px"><b style="color:var(--tx)">2 ${L('stops','aho bisi zihagarara','arrêts')} · 2 min</b></div></div>
<div class="ti"><div class="dot" style="border-color:var(--tt)">🚶</div><h4>Nyabugogo Stop ${L('alight','manuka','descente')}</h4><div class="sub">Stop 07578</div><div class="wk">${L('Walk','Genda','Marcher')} <b>223 m · 3 min</b></div></div>
<div class="ti last"><div class="dot" style="border-color:#D92D20">📍</div><span class="tm">14:41</span><h4>${PL.n}</h4><div class="sub">KN 3 Rd 12, Nyarugenge, Kigali</div><button class="pbtn" onclick="toast('Calling is not in this prototype')">📞 ${L('Call','Hamagara','Appeler')}</button>
<div style="margin-top:14px;height:130px;border-radius:20px;background:#9BB8C9;display:flex;align-items:flex-end;padding:12px;font-weight:700;color:#1B2A33">${L('It’s on the left side of the road.','Iri ku ruhande rw’ibumoso rw’umuhanda.','Il est à gauche de la route.')}</div><div class="abox" style="margin-top:14px;font-size:15px" onclick="toast('Thanks for the feedback')">🙂 <b>${L('Tell us about this route','Tubwire ibijyanye n’iyi nzira','Donnez votre avis sur cet itinéraire')}</b> ›</div></div></div>`;
screens.route=()=>{const m=M.mode,o=OPT[m],cur=o[Math.min(M.opt,o.length-1)];const dot=(c)=>`<span style="width:12px;height:12px;border-radius:6px;border:3px solid ${c};margin:6px 6px 0 0;flex-shrink:0"></span>`;
const chips=m==='bus'?o.map((x,i)=>`<button class="ocp ${M.opt===i?'on':''}" onclick="mpSet('opt',${i})">${i===0?'🚌 ':''}${x[0]} <span style="opacity:.8">| ${x[1]} min</span></button>`).join(''):'';
const seg=`<div class="seg">${[[3,'#8B95A1','🚶'],[22,'#3B7D20','305'],[4,'#8B95A1',''],[2,'#3B7D20','102'],[3,'#8B95A1','🚶']].map(s=>`<div style="flex:${s[0]};background:${s[1]}">${s[2]}</div>`).join('')}</div>`;
let body='';
if(m==='bus')body=`<div class="sh2"><div class="hdl"></div><b style="color:var(--lk)">${cur[0]==='Best'?L('Best','Nziza','Optimal'):cur[0]}</b><div style="font-size:34px;font-weight:800;letter-spacing:-.8px">${cur[1]} min</div><div class="sm mu">2:06 pm – 2:41 pm · 400 RWF</div>${seg}${busDetail()}</div>`;
else body=`<div class="mcs" style="padding:12px 16px 0">${o.map((x,i)=>`<div class="rc ${M.opt===i?'on':''}" onclick="mpSet('opt',${i})"><b style="color:${M.opt===i?'var(--lk)':'var(--mu)'}">${i===0?(m==='car'?'✨ ':'')+(m==='car'?L('Live best','Nziza ubu','Optimal live'):L('Best','Nziza','Optimal')):x[0]}</b><div class="m">${tmin(x[1])}</div><small>${x[2]}</small>${x[3]?`<small>${x[3]}</small>`:''}${m==='car'?`<div style="margin-top:8px"><span class="tg">${L('Avg','Impuzandengo','Moy.')} · ${L('Usual traffic','Imodoka zisanzwe','Trafic habituel')}</span></div>`:''}</div>`).join('')}</div>${m==='car'?`<div style="margin:14px 16px 0;background:var(--tint);border-radius:22px;padding:14px 16px;display:flex;align-items:center;gap:12px" onclick="toast('Not in this prototype')"><span style="font-size:22px">✨</span><b style="flex:1;color:var(--tintfg);font-size:15px">${L('Get destination suggestions from your trips','Bona aho ujya ukurikije ingendo zawe','Suggestions de destinations selon vos trajets')}</b></div>`:''}`;
const hdr=`<div class="mh" style="padding-bottom:0"><button class="ib" aria-label="Back" onclick="back()">${ic('back',24)}</button><b style="font-size:18px;flex:1">${L('Directions','Inzira','Itinéraire')}</b><button class="ib" aria-label="Swap" onclick="toast('Start and destination swapped')">${ic('send',20)}</button></div><div class="rbox" style="margin-top:8px"><div class="fi" style="padding:10px 4px">${dot('#2BA84A')}KG 11 Ave, Kimironko</div><div class="fi" style="padding:10px 4px;border-top:0">${dot('#D92D20')}${PL.n}</div></div><div class="modes">${[['bus','mbus'],['car','mcar'],['walk','mwalk'],['bike','mbike']].map(([k,g])=>`<button class="${m===k?'on':''}" onclick="M.opt=0;mpSet('mode','${k}')" aria-label="${k}">${ic(g,20,m===k?'#fff':'var(--mu)')}${tmin(OPT[k][0][1]).replace(' min','m').replace(' h ','h')}</button>`).join('')}</div>`;
const act=m==='bus'?`<div class="cta"><div style="display:flex;gap:10px;align-items:center"><div style="flex:1"><b style="color:var(--lk);font-size:22px">35 min</b><div class="sm" style="color:var(--lk)">2:41 pm ${L('arrival','kugera','arrivée')}</div></div><button class="btn sec2" style="width:auto;padding:0 22px" onclick="toast('Preview: not in this prototype')">${L('Preview','Reba','Aperçu')}</button><button class="btn" style="width:auto;padding:0 22px" onclick="toast('Navigation: not in this prototype')">🚌 ${L('Start','Tangira','Démarrer')}</button></div></div>`:`<div class="cta"><div style="display:flex;gap:10px"><button class="btn sec2" style="flex:0 0 40%" onclick="M.later=!M.later;toast(M.later?'Leave later: pick a time':'Leave now');render('fade-none')">🕑 ${L('Leave later','Hagera nyuma','Partir plus tard')}</button><button class="btn" onclick="toast('Navigation: not in this prototype')">${m==='bike'?L('Preview route','Reba inzira','Aperçu'):L('Start','Tangira','Démarrer')}</button></div></div>`;
return hdr+mapR(chips)+body+act};
})();
</script>
<script>
/* v60: Maps home — full map view with pins, filters, layers, nearby sheet */
(function(){
const L=(e,r,f)=>({en:e,rw:r,fr:f}[S.lang]||e);
const M=S.mp;M.cat=M.cat||'all';M.sel=M.sel||null;M.layer=M.layer||0;
const st=document.createElement('style');
st.textContent='.mvc{position:absolute;left:0;right:0;top:66px;z-index:2}.mvs{position:absolute;left:12px;right:12px;top:12px;height:50px;border-radius:25px;background:var(--bg);box-shadow:none;display:flex;align-items:center;gap:8px;padding:0 6px;z-index:3;color:var(--tt);font-size:16px}.pulse{animation:pls 2s infinite}@keyframes pls{0%{r:10;opacity:.5}100%{r:26;opacity:0}}.pc{display:flex;gap:12px;align-items:center;padding:12px 0}.pc i{width:44px;height:44px;border-radius:14px;background:var(--chip);display:flex;align-items:center;justify-content:center;font-style:normal;font-size:22px;flex-shrink:0}';
document.head.appendChild(st);
const POI=window.POI=[{id:'cafe',c:'cafe',e:'☕',n:'Nyamirambo Coffee House',x:150,y:190,k:'Cafe, Dessert',r:'4.6 (495)',d:'4.4 km',o:'Open · closes 22:00'},
{id:'cafe2',c:'cafe',e:'☕',n:'Kigali Roast',x:260,y:300,k:'Cafe',r:'4.4 (212)',d:'1.2 km',o:'Open · closes 20:00'},
{id:'rest',c:'food',e:'🍽️',n:'Grill House',x:90,y:290,k:'Restaurant',r:'4.5 (803)',d:'2.0 km',o:'Open · closes 23:00'},
{id:'bus',c:'bus',e:'🚌',n:'Nyabugogo Stop',x:210,y:130,k:'Bus stop · 305, 102',r:'',d:'4.3 km',o:'Next: 305 in 1 min'},
{id:'bus2',c:'bus',e:'🚌',n:'Kimironko Market Stop',x:270,y:400,k:'Bus stop · 305, 311',r:'',d:'0.3 km',o:'Next: 311 arriving soon'},
{id:'pharm',c:'pharm',e:'💊',n:'City Pharmacy',x:60,y:170,k:'Pharmacy',r:'4.2 (96)',d:'3.1 km',o:'Open · closes 21:00'},
{id:'atm',c:'atm',e:'🏧',n:'ATM · City Bank',x:200,y:350,k:'ATM',r:'',d:'0.8 km',o:'24 hours'}];
const CATS=[['all',L('All','Byose','Tout')],['cafe','☕ '+L('Cafe','Ikawa','Café')],['food','🍽️ '+L('Food','Ibiryo','Repas')],['bus','🚌 '+L('Bus stops','Bisi','Arrêts')],['pharm','💊 '+L('Pharmacy','Farumasi','Pharmacie')],['atm','🏧 ATM']];
const LAYERS=[L('Standard','Isanzwe','Standard'),L('Satellite','Isanzure','Satellite'),L('Terrain','Imiterere y’ubutaka','Relief')];
window.mpPin=id=>{M.sel=(M.sel===id?null:id);render('fade-none')};
window.mpCat=k=>{M.cat=k;M.sel=null;render('fade-none')};
window.mpLayer=()=>{M.layer=(M.layer+1)%3;toast(LAYERS[M.layer]);render('fade-none')};
window.mpOpenPoi=id=>{if(id==='cafe')mpGo('place');else toast(L('Details for this place are not in the prototype','Amakuru y’aha hantu ntari muri prototype','Détails non disponibles dans le prototype'))};
window.openMaps=()=>{M.sel=null;S.stack=['mapview'];render('push')};
screens.mapview=()=>{const vis=POI.filter(p=>M.cat==='all'||p.c===M.cat),sel=POI.find(p=>p.id===M.sel);
const roads='<path d="M0 120L340 100M0 250L340 270M0 380L340 360M70 0L90 520M200 0L190 520M290 0L300 520" stroke="var(--bg)" stroke-width="13" fill="none"/>';
const blocks=[[100,140,80,40],[210,130,60,40],[100,200,80,40],[205,205,70,50],[20,280,55,60],[100,285,80,60],[210,290,65,55],[100,395,80,50],[210,390,70,60],[20,130,45,50]].map(b=>`<rect x="${b[0]}" y="${b[1]}" width="${b[2]}" height="${b[3]}" rx="5" fill="var(--ln)"/>`).join('');
const extra=M.layer===1?'<path d="M30 380L90 380L90 250L200 250L200 110L300 100" fill="none" stroke="#3B7D20" stroke-width="6" stroke-linecap="round"/><path d="M290 20L300 380L190 400" fill="none" stroke="#9B59B6" stroke-width="6" stroke-linecap="round"/>':M.layer===2?'<path d="M0 120L340 100" stroke="#D92D20" stroke-width="6" opacity=".8"/><path d="M0 250L200 260" stroke="#F5B301" stroke-width="6" opacity=".9"/><path d="M200 260L340 270" stroke="#2BA84A" stroke-width="6"/><path d="M190 0L190 520" stroke="#F5B301" stroke-width="6" opacity=".9"/>':'';
const pins=vis.map(p=>`<g onclick="mpPin('${p.id}')" style="cursor:pointer" role="button" aria-label="${p.n}"><circle cx="${p.x}" cy="${p.y-16}" r="${M.sel===p.id?21:16}" fill="${M.sel===p.id?'var(--lk)':'#E8604C'}" stroke="#fff" stroke-width="3"/><text x="${p.x}" y="${p.y-9}" font-size="${M.sel===p.id?20:16}" text-anchor="middle">${p.e}</text>${M.sel===p.id||vis.length<4?`<text x="${p.x}" y="${p.y+10}" font-size="11" font-weight="800" text-anchor="middle" fill="var(--tx)" stroke="var(--bg)" stroke-width="3" paint-order="stroke">${p.n}</text>`:''}</g>`).join('');
const map=`<svg viewBox="0 0 340 480" width="100%" style="display:block;background:var(--chip)" role="img" aria-label="Map of Kigali"><path d="M0 60C80 90 160 40 340 70L340 0L0 0z" fill="#6AA9F0" opacity=".35"/><ellipse cx="40" cy="80" rx="30" ry="14" fill="#8FD18A" opacity=".6"/>${roads}${blocks}${extra}${pins}<g transform="translate(250 440)"><circle class="pulse" r="10" fill="#2E6BF0"/><circle r="9" fill="#2E6BF0" stroke="#fff" stroke-width="3"/></g></svg>`;
const sheet=sel?`<div class="sh2"><div class="hdl" onclick="mpPin('${sel.id}')"></div><div style="display:flex;align-items:center;gap:8px"><b style="flex:1;font-size:22px;letter-spacing:-.3px">${sel.n}</b><button class="ib" style="background:var(--chip);border-radius:22px" aria-label="Close" onclick="mpPin('${sel.id}')">${ic('plus',20).replace('<svg','<svg style="transform:rotate(45deg)"')}</button></div><div class="sm mu" style="margin-top:4px">${sel.k}${sel.r?' · ★ '+sel.r:''}</div><div style="margin-top:6px;font-size:15px"><b style="color:#2BA84A">${sel.o}</b> · ${sel.d}</div><div class="acts" style="padding:14px 0 0"><button class="p" onclick="toast('Set as start')">${L('Depart','Gutangira','Départ')}</button><button class="q" onclick="mpArriveAt('${sel.id}')">${L('Arrive','Kugerayo','Arrivée')}</button><button onclick="mpOpenPoi('${sel.id}')">${L('Details','Amakuru','Détails')}</button></div></div>`
:`<div class="sh2"><div class="hdl"></div><b style="font-size:19px">${L('Nearby','Hafi yawe','À proximité')}</b>${vis.slice().sort((a,b)=>parseFloat(a.d)-parseFloat(b.d)).slice(0,4).map(p=>`<div class="pc tap" onclick="mpPin('${p.id}')"><i>${p.e}</i><div style="flex:1;min-width:0"><b style="font-size:16px">${p.n}</b><div class="sm mu">${p.k}</div></div><span class="sm mu">${p.d}</span></div>`).join('')||`<div class="mu" style="padding:16px 0">${L('Nothing nearby','Nta kintu hafi','Rien à proximité')}</div>`}</div>`;
return `<div style="position:relative"><div class="mvs"><button class="ib" aria-label="Back" onclick="back()" style="color:var(--tx)">${ic('back',22)}</button><span style="flex:1" onclick="mpGo('mapsearch')">${L('Search places, bus stops, addresses','Shakisha ahantu, aho bisi zihagarara','Lieux, arrêts, adresses')}</span><button class="ib" aria-label="Search" onclick="mpGo('mapsearch')">${ic('search',20,'var(--tt)')}</button></div>
<div class="mcs mvc" style="padding:0 12px">${CATS.map(([k,l])=>`<button class="ocp ${M.cat===k?'on':''}" onclick="mpCat('${k}')">${l}</button>`).join('')}</div>
${map}<button class="mb" style="top:130px" aria-label="Layers: ${LAYERS[M.layer]}" onclick="mpLayer()">${ic('grid',20,M.layer?'var(--lk)':'var(--tx)')}</button><button class="mb" style="top:182px" aria-label="Saved" onclick="toast('${L('Saved places: 1','Ahantu wabitse: 1','Lieux enregistrés : 1')}')">${ic('star',20,'#2E6BF0')}</button><button class="mb" style="bottom:46px" aria-label="My location" onclick="toast('${L('Centered on you','Uri hano','Centré sur vous')}')">${ic('pin',20,'#2E6BF0')}</button>${M.layer?`<div style="position:absolute;left:12px;bottom:46px;background:var(--bg);box-shadow:none;border-radius:14px;padding:6px 12px;font-size:13px;font-weight:700">${LAYERS[M.layer]}</div>`:''}</div>${sheet}<div style="height:24px"></div>`};
})();
</script>
<script>
/* v61: directions from any place, live search that drops pins, departure time + sort + stair-free */
(function(){
const L=(e,r,f)=>({en:e,rw:r,fr:f}[S.lang]||e);
const M=S.mp,CAFE='Nyamirambo Coffee House';
if(M.dep===undefined){M.dep=0;M.sort=0;M.ns=false;}
const _g=window.mpGo;
window.mpGo=n=>{if(n==='place')PL.n=CAFE;_g(n)};
window.mpArriveAt=id=>{const p=POI.find(x=>x.id===id);PL.n=p.n;M.mode='bus';M.opt=0;M.exp=false;S.stack.push('route');render('push')};
window.mpArrive=()=>mpArriveAt('cafe');
window.mpResult=id=>{M.cat='all';M.sel=id;if(S.stack[S.stack.length-1]==='mapsearch')S.stack.pop();S.stack[S.stack.length-1]==='mapview'?render('pop'):(S.stack=['mapview'],render('pop'))};
window.mpQ=v=>{const q=v.trim().toLowerCase(),el=document.getElementById('mpres'),rec=document.getElementById('mprec');if(!el)return;if(rec)rec.style.display=q?'none':'';
const r=q?POI.filter(p=>(p.n+' '+p.k).toLowerCase().includes(q)):[];
el.innerHTML=q?(r.length?r.map(p=>`<div class="pl tap" onclick="mpResult('${p.id}')"><i style="font-style:normal;font-size:20px">${p.e}</i><div style="flex:1;min-width:0"><b style="display:block;font-size:17px;font-weight:600">${p.n}</b><span>${p.k} · ${p.d}</span></div></div>`).join(''):`<div class="pad mu" style="text-align:center;padding-top:30px">${L('No results','Nta bisubizo','Aucun résultat')}</div>`):''};
const _ms=screens.mapsearch;
screens.mapsearch=()=>{let h=_ms();
h=h.replace(/(<div class="mps">[\s\S]*?)<span style="flex:1">[\s\S]*?<\/span><\/div>/,`$1<input id="mpq" autocomplete="off" placeholder="${L('Search places, bus stops, addresses','Shakisha ahantu, aho bisi zihagarara','Lieux, arrêts, adresses')}" oninput="mpQ(this.value)" style="flex:1;min-width:0;border:0;background:none;outline:0;font:inherit;font-size:16px;color:var(--tx)"></div>`);
h=h.replace(/(<div style="padding-top:8px">)/,'<div id="mpres"></div><div id="mprec">$1').replace(/$/,'</div>');
return h};
const DEP=[[0,L('Now','Ubu','Maintenant')],[15,L('In 15 min','Mu minota 15','Dans 15 min')],[30,L('In 30 min','Mu minota 30','Dans 30 min')],[60,L('In 1 hour','Mu isaha 1','Dans 1 h')]];
const SORT=[L('Best route','Inzira nziza','Meilleur itinéraire'),L('Fewest transfers','Guhindura bike','Moins de correspondances'),L('Least walking','Kugenda make','Moins de marche')];
window.mpDep=()=>{M.dep=(M.dep+1)%DEP.length;render('fade-none')};
window.mpSort=()=>{M.sort=(M.sort+1)%SORT.length;render('fade-none')};
window.mpNs=()=>{M.ns=!M.ns;render('fade-none')};
const t12=m=>{const h=Math.floor(m/60)%24,mm=String(m%60).padStart(2,'0');return (h%12||12)+':'+mm+(h>=12?' pm':' am')};
const t24=m=>String(Math.floor(m/60)%24).padStart(2,'0')+':'+String(m%60).padStart(2,'0');
const _r=screens.route;
screens.route=()=>{let h=_r();const d=DEP[M.dep][0],s=14*60+6+d,e=14*60+41+d;
if(PL.n!==CAFE){const p=POI.find(x=>x.n===PL.n);h=h.split('KN 3 Rd 12, Nyarugenge, Kigali').join(p?p.k:'Kigali')}
if(M.mode==='bus'){
h=h.split('2:06 pm – 2:41 pm').join(t12(s)+' – '+t12(e)).split('>14:06<').join('>'+t24(s)+'<').split('>14:41<').join('>'+t24(e)+'<').split('2:41 pm ').join(t12(e)+' ');
const tb=`<div style="display:flex;justify-content:space-between;align-items:center;padding:10px 20px;border-bottom:0;font-size:15px;font-weight:700"><span style="color:var(--lk);cursor:pointer" onclick="mpDep()">${d?L('Today','Uyu munsi','Aujourd’hui')+' '+t24(14*60+5+d)+' '+L('departure','kugenda','départ'):L('Leave now','Genda ubu','Partir maintenant')} ⌄</span><span style="cursor:pointer" onclick="mpSort()">${SORT[M.sort]}${M.ns?', '+L('no stairs','nta ntambwe','sans escaliers'):''} ⌄</span></div><div style="margin:12px 16px 0;border-radius:18px;padding:12px 14px;background:var(--tint);display:flex;align-items:center;gap:12px;cursor:pointer" onclick="mpNs()"><span style="font-size:22px">${M.ns?'♿':'🪜'}</span><b style="flex:1;font-size:14px;color:var(--tintfg)">${L('Avoid stairs when traveling with a stroller or wheelchair','Irinde ingazi ufite akagare k’umwana cyangwa intebe y’abafite ubumuga','Éviter les escaliers (poussette ou fauteuil roulant)')}</b><span class="tg" style="${M.ns?'background:var(--lk);color:#fff':''}">${M.ns?'ON':'OFF'}</span></div>`;
h=h.replace('<div style="position:relative"><svg viewBox="0 0 340 330"',tb+'<div style="position:relative"><svg viewBox="0 0 340 330"');
if(M.sort===1)h=h.replace('305 + 1 transfer','Direct 311');
if(M.sort===2)h=h.replace('Route 311','Least walking')}
return h};
})();
</script>
<script>
/* v62: Place Reviews + Nearby tabs; bus route filters (All / Bus / Bus + Moto-taxi) */
(function(){
const L=(e,r,f)=>({en:e,rw:r,fr:f}[S.lang]||e);
const M=S.mp;if(M.rs===undefined){M.rs=0;M.bf=0;}
window.mpRs=()=>{M.rs=(M.rs+1)%3;render('fade-none')};
window.mpBf=k=>{M.bf=k;M.opt=0;render('fade-none')};
const REV=[['Aline M.','2 days ago',5,'Perfect spot for working — fast Wi-Fi and the Spanish latte is great.',['Work-friendly','Wi-Fi']],['Eric N.','1 week ago',4,'Spacious and calm in the morning. Gets busy at lunch, parking is easy.',['Parking']],['Divine U.','2 weeks ago',5,'The sandwich and milk tea were excellent. Friendly staff.',['Food','Service']],['Jean P.','1 month ago',3,'Good coffee but slow service on weekends.',['Service']]];
const RS=[L('Latest','Bishya','Récents'),L('Highest rating','Amanota menshi','Mieux notés'),L('Lowest rating','Amanota make','Moins bien notés')];
const star=n=>'★'.repeat(n)+'<span style="color:var(--ln)">'+'★'.repeat(5-n)+'</span>';
const revBody=()=>{const r=REV.slice();if(M.rs===1)r.sort((a,b)=>b[2]-a[2]);if(M.rs===2)r.sort((a,b)=>a[2]-b[2]);
return `<div style="display:flex;gap:20px;align-items:center;padding:22px 24px 6px"><div style="text-align:center"><div style="font-size:46px;font-weight:800;letter-spacing:-1px">4.6</div><div style="color:#F5B301;font-size:15px">★★★★★</div><div class="sm mu">495 ${L('reviews','ibitekerezo','avis')}</div></div><div style="flex:1">${[[5,68],[4,22],[3,7],[2,2],[1,1]].map(x=>`<div style="display:flex;align-items:center;gap:8px;font-size:12px;color:var(--mu);padding:2px 0"><span style="width:8px">${x[0]}</span><div style="flex:1;height:6px;border-radius:3px;background:var(--chip);overflow:hidden"><i style="display:block;height:100%;width:${x[1]}%;background:#F5B301"></i></div></div>`).join('')}</div></div>
<div class="chp" style="padding-top:8px"><button class="on" onclick="mpRs()">${RS[M.rs]} ⌄</button><button onclick="toast('Photo reviews: 38')">${L('Photo reviews','Ibitekerezo n’amafoto','Avis avec photos')}</button><button onclick="toast('Write a review: not in this prototype')">✏️ ${L('Write a review','Andika igitekerezo','Écrire un avis')}</button></div>
${r.map(x=>`<div style="padding:18px 24px;border-bottom:0"><div style="display:flex;align-items:center;gap:10px"><div style="width:36px;height:36px;border-radius:18px;background:var(--tint);color:var(--tintfg);font-weight:800;display:flex;align-items:center;justify-content:center">${x[0][0]}</div><div style="flex:1"><b>${x[0]}</b><div class="sm mu">${x[1]}</div></div><span style="color:#F5B301;font-size:14px">${star(x[2])}</span></div><div style="margin-top:10px;font-size:15px;line-height:23px">${x[3]}</div><div style="display:flex;gap:6px;margin-top:10px;flex-wrap:wrap">${x[4].map(t=>`<span class="tg">${t}</span>`).join('')}</div></div>`).join('')}`};
const NM={cafe2:'320 m',rest:'150 m',bus:'120 m',pharm:'410 m',atm:'210 m',bus2:'600 m'};
const nearBody=()=>{const ids=Object.keys(NM).sort((a,b)=>parseInt(NM[a])-parseInt(NM[b]));
return `<div class="mt2" style="padding-top:20px">${L('Around this place','Hafi y’aha hantu','Autour de ce lieu')}</div>${ids.map(id=>{const p=POI.find(x=>x.id===id);return `<div class="pl tap" onclick="mpResult('${id}')"><i style="font-style:normal;font-size:20px">${p.e}</i><div style="flex:1;min-width:0"><b style="display:block;font-size:17px;font-weight:600">${p.n}</b><span>${p.k}${p.o?' · '+p.o:''}</span></div><span style="font-weight:700">${NM[id]}</span></div>`}).join('')}`};
const _p=screens.place;
screens.place=()=>{let h=_p();if(!M.exp)return h;const i=h.indexOf('<div class="ptabs">');if(i<0)return h;const E='</button></div>',j=h.indexOf(E,i)+E.length,k=h.lastIndexOf('<div style="height:30px"></div>');
const T=[['home',L('Home','Ahabanza','Accueil')],['menu','Menu'],['reviews',L('Reviews','Ibitekerezo','Avis')],['photos',L('Photos','Amafoto','Photos')],['nearby',L('Nearby','Hafi','Autour')],['info',L('Info','Amakuru','Infos')]];
let body=h.slice(j,k);if(M.tab==='reviews')body=revBody();else if(M.tab==='nearby')body=nearBody();
return h.slice(0,i)+`<div class="ptabs" style="overflow-x:auto;padding:0 4px;scrollbar-width:none">${T.map(([t,l])=>`<button class="${M.tab===t?'on':''}" style="flex:0 0 auto;padding:0 16px" onclick="mpSet('tab','${t}')">${l}</button>`).join('')}</div>`+body+h.slice(k)};
const _r=screens.route;
screens.route=()=>{let h=_r();if(M.mode!=='bus')return h;
const F=[[L('All','Byose','Tout'),3],[L('Bus','Bisi','Bus'),2],[L('Bus + Moto','Bisi + Moto','Bus + Moto'),1]];
const tabs=`<div style="display:flex;gap:22px;padding:0 20px;border-bottom:0;overflow-x:auto">${F.map((f,i)=>`<span style="padding:12px 0;font-weight:700;font-size:15px;white-space:nowrap;cursor:pointer;color:${M.bf===i?'var(--tx)':'var(--tt)'};border-bottom:3px solid ${M.bf===i?'var(--tx)':'transparent'}" onclick="mpBf(${i})">${f[0]} ${f[1]}</span>`).join('')}</div>`;
h=h.replace(/(<div style="display:flex;justify-content:space-between;align-items:center;padding:10px 20px;border-bottom)/,tabs+'$1');
if(M.bf===1)h=h.replace(/<button class="ocp[^"]*" onclick="mpSet\('opt',1\)">[\s\S]*?<\/button>/,'');
if(M.bf===2){h=h.replace(/<div class="mcs" style="position:absolute[\s\S]*?<\/div>(?=<button class="mb")/,'<div class="mcs" style="position:absolute;left:0;right:0;top:12px;padding:0 12px"><button class="ocp on">🚌+🛵 Bus + Moto-taxi <span style="opacity:.8">| 29 min</span></button></div>');
h=h.split('35 min').join('29 min').split('400 RWF').join('1,800 RWF')}
return h};
})();
</script>
<script>
/* v63: Place details for every map pin (reviews, photos, nearby, bus arrivals), per-place Save, Saved places list */
(function(){
const L=(e,r,f)=>({en:e,rw:r,fr:f}[S.lang]||e);
const M=S.mp,CAFE='Nyamirambo Coffee House';
if(!M.sv)M.sv={};
if(!P.pin)P.pin='M12 9a3 3 0 100 6 3 3 0 000-6zM12 3v3M12 18v3M3 12h3M18 12h3M12 5a7 7 0 100 14 7 7 0 000-14z';
const isSv=id=>id==='cafe'?!!M.star:!!M.sv[id];
const byName=()=>POI.find(x=>x.n===PL.n);
const X=window.PX={
cafe2:{a:'KG 9 Ave 14, Kimironko',p:'+250 788 111 204',h:'Mon–Sun 07:00–20:00',g:['#5B3A29','#C58B5C'],f:['Wi-Fi','Takeaway','Cards accepted'],s:['Small roastery with single-origin Rwandan coffee, pastries and a few tables by the window.','Ikawa nto yokeje ikorerwa mu Rwanda, hamwe n’utuntu turyohereye.','Petite torréfaction de café rwandais, pâtisseries et quelques tables près de la fenêtre.']},
rest:{a:'KN 5 Rd 3, Nyamirambo',p:'+250 788 222 515',h:'Mon–Sun 10:00–23:00',g:['#7B2D26','#E8A87C'],f:['Groups','Takeaway','Mobile money'],s:['Grilled goat and tilapia, brochettes and cold drinks. Busy after 19:00, so book ahead for groups.','Imbuzi n’amafi bitogosheje, brochettes n’ibinyobwa bikonje. Hakunda abantu nyuma ya saa 19:00.','Chèvre et tilapia grillés, brochettes et boissons fraîches. Complet après 19h, réservez pour les groupes.']},
pharm:{a:'KN 4 Ave 21, Nyarugenge',p:'+250 788 333 096',h:'Mon–Sat 08:00–21:00',g:['#2F4F3A','#B7D3A8'],f:['Prescriptions','Insurance accepted','Delivery'],s:['Pharmacist on duty during opening hours. Accepts most insurance cards and delivers within Nyarugenge.','Umufarumasiye ahari mu masaha y’akazi. Yemera ubwishingizi bwinshi kandi ageza imiti mu Nyarugenge.','Pharmacien de garde aux heures d’ouverture. Accepte la plupart des assurances, livraison dans Nyarugenge.']},
atm:{a:'KN 2 St 8, Nyarugenge',p:'',h:'24 hours',g:['#3D5A80','#98C1D9'],f:['Cash withdrawal','Balance check','Deposit']},
bus:{a:'KN 3 Rd, Nyabugogo',p:'',h:'05:30–22:30',g:['#3B7D20','#B7D3A8'],f:['Shelter','Tap&Go']},
bus2:{a:'KG 11 Ave, Kimironko',p:'',h:'05:30–22:30',g:['#3B7D20','#B7D3A8'],f:['Shelter','Tap&Go']},hosp:{a:'KG 544 St, Kacyiru',p:'+250 788 123 400',h:'Mon–Sun 24 hours',g:['#2F5D7C','#A9CFE6'],f:['Emergency','Insurance accepted','Pharmacy on site'],s:['Large referral hospital with a 24-hour emergency unit, laboratory and pharmacy. Bring your insurance card and ID.','Ibitaro bikuru byakira indembe, bifite ubutabazi bwihuse amasaha 24, laboratwari na farumasi. Zana ikarita y’ubwishingizi n’indangamuntu.','Grand hôpital de référence avec urgences 24 h/24, laboratoire et pharmacie. Apportez votre carte d’assurance et une pièce d’identité.']},hosp2:{a:'KG 7 Ave 40, Kacyiru',p:'+250 788 123 477',h:'Mon–Sat 07:00–19:00',g:['#2F5D7C','#A9CFE6'],f:['Walk-in visits','Insurance accepted','Lab tests'],s:['Neighbourhood clinic for check-ups and minor illness. No appointment needed, shorter waits before 10:00.','Ivuriro ry’ubugari rikira abarwayi basanzwe n’indwara zoroheje. Nta gahunda ikenewe, hakunda gutegereza gake mbere ya saa 4:00.','Clinique de quartier pour consultations et petits soins. Sans rendez-vous, moins d’attente avant 10 h.']},cafe3:{a:'KG 11 Ave 8, Kimironko',p:'+250 788 111 330',h:'Mon–Sat 07:00–19:00',g:['#6B4A2E','#D9A56B'],f:['Takeaway','Wi-Fi','Mobile money'],s:['Small corner cafe a short walk from the market, with fresh coffee, chapati and samosas.','Ikawa ntoya hafi y’isoko, ifite ikawa nshya, chapati na samosa.','Petit café d’angle près du marché, avec café frais, chapati et samoussas.']},cafe4:{a:'KG 17 Ave 5, Remera',p:'+250 788 111 481',h:'Mon–Sun 07:30–21:00',g:['#6B4A2E','#D9A56B'],f:['Wi-Fi','Cards accepted','Outdoor seating'],s:['Bright cafe with outdoor seating, popular with students for its quiet mornings and filter coffee.','Ikawa ifite umucyo n’intebe hanze, ikundwa n’abanyeshuri mu gitondo gituje.','Café lumineux avec terrasse, apprécié des étudiants pour ses matinées calmes.']},rest2:{a:'KG 11 Ave 20, Kimironko',p:'+250 788 222 640',h:'Mon–Sun 11:00–22:00',g:['#7B2D26','#E8A87C'],f:['Takeaway','Mobile money','Groups'],s:['Brochettes grilled to order with fries and salad. Quick lunch stop near the market.','Brochettes zotsindwa ako kanya hamwe n’ifiriti na salade. Ahantu heza ho kurira saa sita hafi y’isoko.','Brochettes grillées à la commande avec frites et salade. Idéal pour un déjeuner rapide près du marché.']},rest3:{a:'KN 5 Rd 18, Nyamirambo',p:'+250 788 222 731',h:'Mon–Sun 10:00–22:30',g:['#7B2D26','#E8A87C'],f:['Groups','Takeaway','Cards accepted'],s:['Rwandan home cooking: isombe, beans, plantain and grilled fish. Large tables for families.','Ibiryo bya kinyarwanda: isombe, ibishyimbo, igitoki n’amafi atogosheje. Hari ameza manini y’imiryango.','Cuisine rwandaise maison : isombe, haricots, plantain et poisson grillé. Grandes tables pour les familles.']},rest4:{a:'KG 7 Ave 12, Kiyovu',p:'+250 788 222 852',h:'Mon–Sun 12:00–00:00',g:['#7B2D26','#E8A87C'],f:['Rooftop seating','Cards accepted','Reservations'],s:['Rooftop restaurant with a view over the city. Best at sunset, so book a table in advance.','Resitora yo hejuru ireba umujyi wose. Ni nziza izuba rirenze, bika ameza hakiri kare.','Restaurant en terrasse avec vue sur la ville. Magnifique au coucher du soleil, pensez à réserver.']},pharm2:{a:'KG 11 Ave 3, Kimironko',p:'+250 788 333 140',h:'Mon–Sat 08:00–20:00',g:['#2F4F3A','#B7D3A8'],f:['Prescriptions','Insurance accepted'],s:['Pharmacist on duty during opening hours. Prescriptions, first aid and baby care.','Umufarumasiye ahari mu masaha y’akazi. Imiti yandikirwa, ubutabazi bw’ibanze n’ibikoresho by’abana.','Pharmacien de garde aux heures d’ouverture. Ordonnances, premiers soins et puériculture.']},pharm3:{a:'KG 17 Ave 12, Remera',p:'+250 788 333 258',h:'Mon–Sun 08:00–21:00',g:['#2F4F3A','#B7D3A8'],f:['Prescriptions','Insurance accepted','Delivery'],s:['Open seven days. Delivers within Remera and accepts most insurance cards.','Ifungura iminsi yose. Igeza imiti muri Remera kandi yemera ubwishingizi bwinshi.','Ouverte sept jours sur sept. Livraison à Remera et la plupart des assurances acceptées.']},atm2:{a:'KG 11 Ave, Kimironko',p:'',h:'24 hours',g:['#3D5A80','#98C1D9'],f:['Cash withdrawal','Balance check','Deposit']},atm3:{a:'KG 17 Ave, Remera Mall',p:'',h:'24 hours',g:['#3D5A80','#98C1D9'],f:['Cash withdrawal','Balance check']},bus3:{a:'KG 17 Ave, Remera',p:'',h:'05:30–22:30',g:['#3B7D20','#B7D3A8'],f:['Shelter','Tap&Go']},bus4:{a:'KG 9 Ave, Gisozi',p:'',h:'05:30–22:30',g:['#3B7D20','#B7D3A8'],f:['Shelter','Tap&Go']},bus5:{a:'KK 15 Rd, Kicukiro Centre',p:'',h:'05:30–22:30',g:['#3B7D20','#B7D3A8'],f:['Shelter','Tap&Go']}};
const REV={cafe:[['Aline M.','2 days ago',5,'Quiet corner for the laptop and the coffee is strong.'],['Eric N.','1 week ago',4,'Friendly staff. Gets crowded around lunch.'],['Divine U.','2 weeks ago',4,'Good pastries, fair prices.']],
food:[['Jean P.','3 days ago',5,'Best brochettes in the area, cooked fresh.'],['Sandrine K.','1 week ago',4,'Big portions. Service is slow on weekends.'],['Patrick H.','3 weeks ago',4,'Good for groups, easy to pay with mobile money.']],
hosp:[['Chantal R.','3 days ago',5,'Quick triage at the emergency desk and the staff were calm and clear.'],['Moses K.','2 weeks ago',4,'Clean wards and good doctors. Parking fills up by midday.'],['Aimée N.','1 month ago',4,'Lab results were ready the same afternoon.']],
pharm:[['Claudine B.','4 days ago',5,'Quick service and they had everything on my prescription.'],['Olivier T.','2 weeks ago',4,'Clean and well stocked. Short queue before noon.'],['Grace M.','1 month ago',4,'Pharmacist explained each medicine clearly.']]};
const EM={cafe:['🏠','🥐','🪑','☕'],food:['🔥','🍢','🪑','🥤'],pharm:['🏠','💊','🧴','🩺'],hosp:['🏥','🚑','🩺','💊'],atm:['🏧'],bus:['🚌']};
const star=n=>'★'.repeat(n)+'<span style="color:var(--ln)">'+'★'.repeat(5-n)+'</span>';
const dist=(a,b)=>Math.round(Math.hypot(a.x-b.x,a.y-b.y)*12.5/10)*10;
const rowi=(g,t)=>`<div class="fi">${ic(g,20,'var(--tt)')}<div>${t}</div></div>`;
const kind=p=>p.c==='bus'||p.c==='atm'?p.c:p.c;
window.mpSave=id=>{if(id==='cafe')M.star=!M.star;else M.sv[id]=!M.sv[id];toast(isSv(id)?L('Saved','Byabitswe','Enregistré'):L('Removed from saved','Byakuweho','Retiré des favoris'));render('fade-none')};
window.mpOpenPoi=id=>{const p=POI.find(x=>x.id===id);PL.n=p.n;M.tab='home';M.exp=false;S.stack.push('place');render('push')};
const tabsFor=p=>p.c==='bus'||p.c==='atm'?[['home',L('Home','Ahabanza','Accueil')],['nearby',L('Nearby','Hafi','Autour')],['info',L('Info','Amakuru','Infos')]]:[['home',L('Home','Ahabanza','Accueil')],['reviews',L('Reviews','Ibitekerezo','Avis')],['photos',L('Photos','Amafoto','Photos')],['nearby',L('Nearby','Hafi','Autour')],['info',L('Info','Amakuru','Infos')]];
const ex=p=>X[p.id]||{};
const openNow=p=>`<b style="color:#2BA84A">${p.o.split(' · ')[0]}</b>${p.o.includes(' · ')?' · '+p.o.split(' · ')[1]:''}`;
const arrivals=p=>{const rt=(p.k.split('· ')[1]||'').split(',').map(s=>s.trim()).filter(Boolean),T=[1,4,9,13];const soon=/soon/.test(p.o);
return `<div class="rbox" style="margin:14px 24px 0">${T.map((t,i)=>{const r=rt[i%rt.length],s=i===0&&soon;return `<div class="arr"><b class="n">${r}</b><span class="t" style="color:${s?'#D92D20':'var(--tx)'}">${s?L('Arriving soon','Hafi kuhagera','Arrive'):t+' min'}</span><span class="lv">${L('Seats','Intebe','Places')}</span></div>`}).join('')}</div>`};
const body=p=>{const e=ex(p),t=M.tab;
if(t==='reviews'){const rv=REV[p.c]||REV.cafe,m=(p.r||'').match(/([\d.]+) \((\d+)\)/)||[0,'4.5','100'];
return `<div style="display:flex;gap:20px;align-items:center;padding:22px 24px 6px"><div style="text-align:center"><div style="font-size:46px;font-weight:800;letter-spacing:-1px">${m[1]}</div><div style="color:#F5B301;font-size:15px">★★★★★</div><div class="sm mu">${m[2]} ${L('reviews','ibitekerezo','avis')}</div></div></div>
<div class="chp" style="padding-top:8px"><button class="on">${L('Latest','Bishya','Récents')}</button><button onclick="toast('${L('Write a review: not in this prototype','Kwandika igitekerezo: ntabwo kiri muri prototype','Écrire un avis : non disponible dans le prototype')}')">${L('Write a review','Andika igitekerezo','Écrire un avis')}</button></div>
${rv.map(x=>`<div style="padding:18px 24px;border-bottom:0"><div style="display:flex;align-items:center;gap:10px"><div style="width:36px;height:36px;border-radius:18px;background:var(--tint);color:var(--tintfg);font-weight:800;display:flex;align-items:center;justify-content:center">${x[0][0]}</div><div style="flex:1"><b>${x[0]}</b><div class="sm mu">${x[1]}</div></div><div style="color:#F5B301;font-size:14px">${star(x[2])}</div></div><div style="margin-top:10px;font-size:15px;line-height:22px">${x[3]}</div></div>`).join('')}`}
if(t==='photos'){const em=EM[p.c]||EM.cafe,g=e.g||['#6B4A2E','#D9A56B'];return `<div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;padding:14px 16px">${em.concat(em).slice(0,4).map((x,i)=>`<div style="height:${i%3===0?170:120}px;border-radius:20px;background:${i%2?g[1]:g[0]};display:flex;align-items:center;justify-content:center;font-size:44px">${x}</div>`).join('')}</div>`}
if(t==='nearby'){const o=POI.filter(x=>x.id!==p.id).map(x=>[x,dist(p,x)]).sort((a,b)=>a[1]-b[1]);
return `<div class="mt2" style="padding-top:20px">${L('Around this place','Hafi y’aha hantu','Autour de ce lieu')}</div>${o.map(([x,d])=>`<div class="pl tap" onclick="mpResult('${x.id}')"><i style="font-style:normal;font-size:20px">${x.e}</i><div style="flex:1;min-width:0"><b style="display:block;font-size:17px;font-weight:600">${x.n}</b><span>${x.k}</span></div><span>${d} m</span></div>`).join('')}`}
if(t==='info')return `${rowi('home',e.a||'Kigali')}${rowi('phone',e.h||p.o)}${e.p?rowi('phone',e.p):''}${rowi('bill',(e.f||[]).join(', '))}`;
return `${p.c==='bus'?arrivals(p):`<div style="margin:14px 16px 0;height:170px;border-radius:24px;background:${(e.g||['#999','#ccc'])[0]};display:flex;align-items:center;justify-content:center;font-size:64px">${p.e}</div>`}
<div class="fi" style="padding-top:18px">${ic('home',20,'var(--tt)')}<div>${e.a||'Kigali'}</div></div>${rowi('phone',openNow(p))}${e.p?rowi('phone',e.p+' <a style="color:var(--lk);font-weight:700" onclick="toast(\''+L('Copied','Byakoporowe','Copié')+'\')">'+L('Copy','Koporora','Copier')+'</a>'):''}${e.f?rowi('bill',e.f.join(', ')):''}
${e.s?`<div style="margin:24px 16px 0;background:var(--tint);border-radius:20px;padding:16px"><b style="color:var(--tintfg)">✨ ${L('AI summary','Incamake ya AI','Résumé IA')}</b><div style="margin-top:8px;font-size:15px;line-height:23px">${L(...e.s)}</div></div>`:''}`};
const acts=p=>{const e=ex(p);return `<div class="acts" style="padding:14px 0 0"><button class="p" onclick="toast('${L('Set as start','Shyiraho nk’itangiriro','Définir comme départ')}')">${L('Depart','Gutangira','Départ')}</button><button class="q" onclick="mpArriveAt('${p.id}')">${L('Arrive','Kugerayo','Arrivée')}</button>${e.p?`<button onclick="toast('${L('Calling','Guhamagara','Appel')} ${e.p}')">${L('Call','Hamagara','Appeler')}</button>`:''}<button onclick="toast('${L('Link copied','Link yakoporowe','Lien copié')}')">${L('Share','Sangiza','Partager')}</button></div>`};
const mini=p=>{const near=POI.filter(x=>x.id!==p.id).map(x=>[x,dist(p,x)]).sort((a,b)=>a[1]-b[1]).slice(0,3);
const dots=near.map(([x])=>{const cx=Math.max(24,Math.min(316,170+(x.x-p.x)*.9)),cy=Math.max(80,Math.min(250,150+(x.y-p.y)*.9));return `<circle cx="${cx}" cy="${cy-10}" r="13" fill="var(--bg)" stroke="var(--ln)" stroke-width="2"/><text x="${cx}" y="${cy-5}" font-size="13" text-anchor="middle">${x.e}</text>`}).join('');
return `<svg viewBox="0 0 340 300" width="100%" style="display:block;background:var(--chip)" role="img" aria-label="${p.n}"><path d="M0 120L340 100M0 230L340 245M80 0L95 300M250 0L240 300" stroke="var(--bg)" stroke-width="14" fill="none"/><rect x="108" y="130" width="60" height="44" rx="4" fill="var(--ln)"/><rect x="180" y="190" width="52" height="30" rx="4" fill="var(--ln)"/><rect x="260" y="130" width="60" height="80" rx="4" fill="var(--ln)"/>${dots}<circle cx="170" cy="140" r="22" fill="var(--lk)" stroke="#fff" stroke-width="3"/><text x="170" y="148" font-size="22" text-anchor="middle">${p.e}</text></svg>`};
const _pl=screens.place;
screens.place=()=>{const p=byName();
if(!p||p.id==='cafe'){return _pl().split("toast('Calling is not in this prototype')").join("toast('"+L('Calling','Guhamagara','Appel')+" +250 788 000 323')")}
const sv=isSv(p.id),stv=`<button class="ib" style="background:var(--chip);border-radius:22px" aria-label="${sv?'Remove from saved':'Save'}" onclick="mpSave('${p.id}')">${ic('star',22,sv?'#F5B301':'var(--tx)')}</button>`;
if(!M.exp)return `<div style="position:relative">${mini(p)}<div class="fl"><button class="ib" aria-label="Back" onclick="back()">${ic('back',22)}</button><b>${p.n}</b><button class="ib" aria-label="Close" onclick="back()">${ic('plus',22).replace('<svg','<svg style="transform:rotate(45deg)"')}</button></div><button class="mb" style="bottom:46px" aria-label="My location" onclick="toast('${L('Centered on you','Uri hano','Centré sur vous')}')">${ic('pin',20,'#2E6BF0')}</button></div>
<div class="sh2"><div class="hdl" onclick="mpExp(true)" aria-label="Expand"></div><div style="display:flex;align-items:center;gap:8px"><b style="flex:1;font-size:24px;letter-spacing:-.4px">${p.n}</b>${stv}</div><div class="sm mu" style="margin-top:4px">${p.k}${p.r?' · ★ '+p.r:''}</div><div style="margin-top:6px;font-size:15px">${openNow(p)}</div><div style="margin-top:4px;font-size:15px"><b>${p.d}</b> <span class="mu">· ${(ex(p).a||'Kigali').split(', ').pop()}</span></div>${acts(p)}<button class="pbtn" style="width:100%;justify-content:center" onclick="mpExp(true)">${L('More info','Amakuru yose','Plus d’infos')}</button></div>`;
return `<div class="mh" style="padding-bottom:0"><button class="ib" aria-label="Back" onclick="mpExp(false)">${ic('back',24)}</button><b style="flex:1;font-size:19px;margin-left:6px">${p.n}</b>${stv}</div><div style="padding:6px 24px 0"><div class="sm mu">${p.k}${p.r?' · ★ '+p.r:''}</div></div><div style="padding:0 16px">${acts(p)}</div>
<div class="ptabs" style="overflow-x:auto;padding:0 4px;scrollbar-width:none">${tabsFor(p).map(([k,l])=>`<button class="${M.tab===k?'on':''}" style="flex:0 0 auto;padding:0 16px" onclick="mpSet('tab','${k}')">${l}</button>`).join('')}</div>${body(p)}<div style="height:30px"></div>`};
screens.mpsaved=()=>{const s=POI.filter(p=>isSv(p.id));
return `<div class="mh" style="padding-bottom:0"><button class="ib" aria-label="Back" onclick="back()">${ic('back',24)}</button><b style="flex:1;font-size:19px;margin-left:6px">${L('Saved places','Ahantu wabitse','Lieux enregistrés')}</b></div>
${s.length?s.map(p=>`<div class="pl tap" onclick="mpOpenPoi('${p.id}')"><i style="font-style:normal;font-size:20px">${p.e}</i><div style="flex:1;min-width:0"><b style="display:block;font-size:17px;font-weight:600">${p.n}</b><span>${p.k} · ${p.d}</span></div><button class="ib" style="width:36px;height:36px" aria-label="Remove from saved" onclick="event.stopPropagation();mpSave('${p.id}')">${ic('star',22,'#F5B301')}</button></div>`).join(''):`<div class="pad" style="text-align:center;padding-top:72px"><div style="font-size:44px">⭐</div><div style="font-size:18px;font-weight:800;margin-top:14px">${L('No saved places yet','Nta hantu wabitse','Aucun lieu enregistré')}</div><div class="mu" style="margin-top:8px;font-size:15px;line-height:22px">${L('Tap the star on any place to keep it here.','Kanda inyenyeri ku hantu kugira ngo uhabike hano.','Touchez l’étoile d’un lieu pour le garder ici.')}</div><div style="padding-top:24px"><button class="btn sec2" style="height:48px;font-size:16px" onclick="back()">${L('Back to map','Garuka ku ikarita','Retour à la carte')}</button></div></div>`}`};
const _mv=screens.mapview;
screens.mapview=()=>{let h=_mv();const n=POI.filter(p=>isSv(p.id)).length;
h=h.replace(/aria-label="Saved" onclick="toast\('[^']*'\)"/,'aria-label="'+L('Saved places','Ahantu wabitse','Lieux enregistrés')+'" onclick="mpGo(\'mpsaved\')"');
if(n)h=h.replace(/(aria-label="[^"]*" onclick="mpGo\('mpsaved'\)">[\s\S]*?<\/button>)/,'$1<span style="position:absolute;right:6px;top:176px;min-width:18px;height:18px;padding:0 5px;border-radius:9px;background:var(--lk);color:#fff;font-size:11px;font-weight:800;display:flex;align-items:center;justify-content:center;pointer-events:none">'+n+'</span>');
return h};
})();
</script>
<script>
/* v64: working Start/Preview navigation, Depart sets route start, call sheet, write a review, map shortcuts and recents, community replies */
(function(){
const L=(e,r,f)=>({en:e,rw:r,fr:f}[S.lang]||e);
const M=S.mp;if(!M.myrev)M.myrev={};if(M.from===undefined)M.from=null;M.nv=M.nv||{i:0,pre:false};
const lay=h=>{$('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet">'+h+'</div>'};
const cur=()=>POI.find(x=>x.n===PL.n);
const esc=s=>String(s).replace(/</g,'&lt;');
/* ---- Call sheet ---- */
window.mpCall=num=>{lay(`<div class="h1" style="font-size:22px;line-height:30px">${L('Call','Hamagara','Appeler')} ${esc(PL.n)}?</div><div class="mu" style="font-size:16px;margin:8px 0 24px">${num}</div><div class="row2"><button class="btn sec2" onclick="closeSheet()">${L('Cancel','Bireke','Annuler')}</button><button class="btn" onclick="closeSheet();toast('${L('Calling','Guhamagara','Appel en cours')} ${num}…')">${L('Call','Hamagara','Appeler')}</button></div>`)};
/* ---- Depart: choose the route start ---- */
window.mpDepart=id=>{const p=id?POI.find(x=>x.id===id):cur();M.from=p?p.n:PL.n;toast(L('Start set to ','Itangiriro: ','Départ : ')+M.from+L('. Tap Arrive on another place.','. Kanda Kugerayo ahandi.','. Touchez Arrivée sur un autre lieu.'))};
const _aa=window.mpArriveAt;
window.mpArriveAt=id=>{const p=POI.find(x=>x.id===id);if(p&&M.from===p.n)M.from=null;_aa(id)};
window.mpAddr=(label,addr)=>{PL.n=addr;M.mode='bus';M.opt=0;M.exp=false;if(M.from===addr)M.from=null;S.stack.push('route');render('push')};
/* ---- Write a review ---- */
M.wr=M.wr||{n:0};
window.mpWrite=()=>{const p=cur();if(!p)return;M.wr={n:0,id:p.id};wrSheet()};
function wrSheet(){const n=M.wr.n,t=(document.getElementById('wrt')||{}).value||'';
lay(`<div class="h1" style="font-size:22px;line-height:30px">${L('Review','Tanga igitekerezo kuri','Avis sur')} ${esc(PL.n)}</div><div style="display:flex;gap:6px;margin:14px 0 6px">${[1,2,3,4,5].map(i=>`<button class="ib" aria-label="${i} ★" style="width:48px;height:48px;font-size:34px;line-height:1;color:${i<=n?'#F5B301':'var(--ln)'}" onclick="mpWrStar(${i})">★</button>`).join('')}</div>
<textarea id="wrt" rows="3" maxlength="200" placeholder="${L('Share what it was like (optional)','Tubwire uko byari bimeze (si ngombwa)','Racontez votre expérience (facultatif)')}" style="width:100%;border:0;border-radius:14px;background:var(--chip);color:var(--tx);font:inherit;font-size:15px;padding:12px;resize:none;outline:0;margin:6px 0 18px">${esc(t)}</textarea>
<div class="row2"><button class="btn sec2" onclick="closeSheet()">${L('Cancel','Bireke','Annuler')}</button><button class="btn" ${n?'':'disabled'} onclick="mpWrPost()">${L('Post review','Ohereza','Publier')}</button></div>`)}
window.mpWrStar=i=>{M.wr.n=i;wrSheet();const e=document.getElementById('wrt');if(e)e.focus()};
window.mpWrPost=()=>{const id=M.wr.id,t=(document.getElementById('wrt')||{}).value.trim();(M.myrev[id]=M.myrev[id]||[]).unshift([M.wr.n,t]);M.tab='reviews';closeSheet();toast(L('Review posted','Igitekerezo cyoherejwe','Avis publié'));render('fade-none')};
const star=n=>'★'.repeat(n)+'<span style="color:var(--ln)">'+'★'.repeat(5-n)+'</span>';
const mine=()=>{const p=cur();return p&&M.myrev[p.id]?M.myrev[p.id].map(x=>`<div style="padding:18px 24px;border-bottom:0;background:var(--tint)"><div style="display:flex;align-items:center;gap:10px"><div style="width:36px;height:36px;border-radius:18px;background:var(--br);color:var(--on);font-weight:800;display:flex;align-items:center;justify-content:center">${esc((S.name||'Amina')[0])}</div><div style="flex:1"><b>${L('You','Wowe','Vous')}</b><div class="sm mu">${L('Just now','Ubu nyine','À l’instant')}</div></div><div style="color:#F5B301;font-size:14px">${star(x[0])}</div></div>${x[1]?`<div style="margin-top:10px;font-size:15px;line-height:22px">${esc(x[1])}</div>`:''}</div>`).join(''):''};
const _pl=screens.place;
screens.place=()=>{let h=_pl();
h=h.replace(/toast\('(?:Calling|Guhamagara|Appel) (\+250 [\d ]+)'\)/g,"mpCall('$1')");
h=h.replace(/toast\('(?:Set as start|Shyiraho nk’itangiriro|Définir comme départ)'\)/g,'mpDepart()');
h=h.replace(/toast\('(?:Write a review|Kwandika igitekerezo|Écrire un avis)[^']*'\)/g,'mpWrite()');
if(M.tab==='reviews'&&M.exp){const k='<div style="padding:18px 24px;border-bottom:0">',m=mine();if(m){const i=h.indexOf(k);if(i>=0)h=h.slice(0,i)+m+h.slice(i)}}
return h};
/* ---- Map: shortcuts, recents, Depart on the pin sheet, saved count ---- */
const _ms=screens.mapsearch;
screens.mapsearch=()=>{let h=_ms(),k=0;const seq=["mpAddr('Home','KG 7 Ave 22, Kacyiru')","mpAddr('Work','Kigali Heights, KG 7 Ave')","mpResult('bus2')"];
M.rec.forEach((r,i)=>{if(i>0)seq.push(/Kimironko Market/.test(r[0])?"mpResult('bus2')":"mpAddr('"+r[0].replace(/'/g,'')+"','"+r[0].replace(/'/g,'')+"')")});
return h.replace(/onclick="soon\(\)"/g,()=>'onclick="'+(seq[k++]||'soon()')+'"')};
const _mv=screens.mapview;
screens.mapview=()=>{let h=_mv();return M.sel?h.replace(/toast\('Set as start'\)/,"mpDepart('"+M.sel+"')"):h};
/* ---- Route: custom start + working Start / Preview ---- */
const _rt=screens.route;
screens.route=()=>{let h=_rt();
if(M.from&&M.from!==PL.n)h=h.split('</span>KG 11 Ave, Kimironko</div>').join('</span>'+esc(M.from)+' <a style="color:var(--lk);font-weight:700;font-size:13px" onclick="M.from=null;render(\'fade-none\')">'+L('Reset','Subiza','Réinit.')+'</a></div>');
/* the bus bar nests divs, so draw() cut it short and left Start/Preview in the scroll area; flatten it so it docks at the bottom */
h=h.replace(/<div class="cta"><div style="display:flex;gap:10px;align-items:center"><div style="flex:1">(<b[^>]*>[^<]*<\/b>)<div class="sm" style="color:var\(--lk\)">([^<]*)<\/div><\/div>([\s\S]*?)<\/div><\/div>/,'<div class="cta" style="display:flex;gap:10px;align-items:center"><span style="flex:1;display:flex;flex-direction:column;white-space:nowrap">$1<span class="sm" style="color:var(--lk)">$2</span></span>$3</div>');
return h.split("toast('Navigation: not in this prototype')").join('mpStart(false)').split("toast('Preview: not in this prototype')").join('mpStart(true)')};
/* ---- Navigation ---- */
const TOT={bus:35,car:17,walk:94,bike:28};
const PATH={bus:'M250 60 C250 110 200 130 190 180 S120 230 100 290',car:'M250 60 C230 120 170 150 160 210 S110 260 100 290',walk:'M250 60 L250 120 L190 130 L180 220 L120 240 L100 290',bike:'M250 60 L250 100 L140 110 L150 230 L100 250 L100 290'};
const steps=()=>{const d=esc(PL.n),o=M.from||'KG 11 Ave, Kimironko';return ({
bus:[['🚶',L('Walk to Kimironko Market stop','Genda ugana kuri Kimironko Market','Marchez jusqu’à l’arrêt Kimironko Market'),'3 min'],['🚌',L('Board bus 305 toward Nyabugogo','Zamuka bisi 305 yerekeza Nyabugogo','Montez dans le bus 305 vers Nyabugogo'),'22 min'],['🔁',L('Change to bus 102 at Nyabugogo','Hindura bisi 102 i Nyabugogo','Changez pour le bus 102 à Nyabugogo'),'2 min'],['🚶',L('Walk to ','Genda ugana kuri ','Marchez jusqu’à ')+d,'3 min'],['📍',L('You have arrived at ','Wageze kuri ','Vous êtes arrivé à ')+d,'']],
car:[['⬆️',L('Head south from ','Jya mu majyepfo uva kuri ','Direction sud depuis ')+esc(o),'400 m'],['↰',L('Turn left onto KG 7 Ave','Bakira ibumoso kuri KG 7 Ave','Tournez à gauche sur KG 7 Ave'),'3.1 km'],['↱',L('Turn right toward Nyabugogo','Bakira iburyo ujya Nyabugogo','Tournez à droite vers Nyabugogo'),'4 km'],['📍',L('You have arrived at ','Wageze kuri ','Vous êtes arrivé à ')+d,'']],
walk:[['⬆️',L('Head south from ','Jya mu majyepfo uva kuri ','Direction sud depuis ')+esc(o),'1.2 km'],['↰',L('Turn left at the roundabout','Bakira ibumoso ku kiruhuko','Tournez à gauche au rond-point'),'2.4 km'],['↱',L('Turn right onto KN 3 Rd','Bakira iburyo kuri KN 3 Rd','Tournez à droite sur KN 3 Rd'),'2 km'],['📍',L('You have arrived at ','Wageze kuri ','Vous êtes arrivé à ')+d,'']],
bike:[['⬆️',L('Head south on the bike lane','Jya mu majyepfo ku muhanda w’amagare','Direction sud sur la piste cyclable'),'1.5 km'],['↱',L('Turn right at KG 9 Ave','Bakira iburyo kuri KG 9 Ave','Tournez à droite sur KG 9 Ave'),'3 km'],['↰',L('Turn left toward ','Bakira ibumoso ujya kuri ','Tournez à gauche vers ')+d,'2.2 km'],['📍',L('You have arrived at ','Wageze kuri ','Vous êtes arrivé à ')+d,'']]})[M.mode]||[]};
let tm=null;
const tick=()=>{if(S.stack[S.stack.length-1]!=='nav'){clearInterval(tm);tm=null;return}const n=steps().length;if(M.nv.i<n-1){M.nv.i++;render('fade-none')}else{clearInterval(tm);tm=null}};
window.mpStart=pre=>{M.nv={i:0,pre:!!pre};S.stack.push('nav');render('push');clearInterval(tm);tm=setInterval(tick,pre?3500:6000)};
window.mpNext=()=>{const n=steps().length;if(M.nv.i<n-1){M.nv.i++;render('fade-none')}};
window.mpEnd=()=>{clearInterval(tm);tm=null;const arr=M.nv.i>=steps().length-1;M.from=null;S.stack=['mapview'];M.sel=null;render('pop');toast(arr?L('Trip finished','Urugendo rurarangiye','Trajet terminé'):L('Navigation ended','Kuyobora byahagaze','Navigation arrêtée'))};
screens.nav=()=>{const st=steps(),n=st.length,i=Math.min(M.nv.i,n-1),s=st[i],last=i===n-1,tot=TOT[M.mode]||30,left=Math.round(tot*(1-i/(n-1))),col=M.mode==='bus'?'#3B7D20':'#2E6BF0';
const probe=document.createElementNS('http://www.w3.org/2000/svg','svg'),pp=document.createElementNS('http://www.w3.org/2000/svg','path');pp.setAttribute('d',PATH[M.mode]);probe.appendChild(pp);probe.style.cssText='position:absolute;visibility:hidden';document.body.appendChild(probe);
const len=pp.getTotalLength(),pt=pp.getPointAtLength(len*i/(n-1));probe.remove();
const arr=new Date(2026,9,15,14,6+left).toLocaleTimeString([], {hour:'numeric',minute:'2-digit'});
return `<div style="position:relative"><svg viewBox="0 0 340 330" width="100%" style="display:block;background:var(--chip)" role="img" aria-label="${L('Navigation map','Ikarita y’urugendo','Carte de navigation')}"><path d="M0 90L340 70M0 200L340 220M90 0L110 330M240 0L220 330" stroke="var(--bg)" stroke-width="12" fill="none" opacity=".9"/><path d="${PATH[M.mode]}" fill="none" stroke="var(--ln)" stroke-width="9" stroke-linecap="round"/><path d="${PATH[M.mode]}" fill="none" stroke="${col}" stroke-width="7" stroke-linecap="round" stroke-dasharray="${len}" stroke-dashoffset="${len*i/(n-1)}" style="transition:stroke-dashoffset .6s"/><circle cx="100" cy="290" r="11" fill="#D92D20"/><circle cx="${pt.x}" cy="${pt.y}" r="16" fill="#2E6BF0" opacity=".25"/><circle cx="${pt.x}" cy="${pt.y}" r="8" fill="#2E6BF0" stroke="#fff" stroke-width="3"/></svg>
<div style="position:absolute;left:12px;right:12px;top:12px;background:${last?'#0A8F5B':'var(--lk)'};color:#fff;border-radius:20px;padding:14px 16px;display:flex;align-items:center;gap:14px;box-shadow:none" role="status" aria-live="polite"><span style="font-size:30px;line-height:1">${s[0]}</span><div style="flex:1;min-width:0"><div style="font-size:17px;font-weight:800;line-height:22px">${s[1]}</div>${s[2]?`<div style="font-size:13px;opacity:.9;margin-top:2px">${s[2]}</div>`:''}</div></div></div>
<div style="padding:16px 24px 0"><div style="display:flex;align-items:baseline;gap:10px"><b style="font-size:30px;letter-spacing:-.5px;color:${last?'var(--ok)':'var(--lk)'}">${last?L('Arrived','Wageze','Arrivé'):left+' min'}</b>${last?'':`<span class="mu" style="font-size:15px">${arr} ${L('arrival','kugera','arrivée')}</span>`}</div>
<div class="mu" style="font-size:14px;margin-top:4px">${M.nv.pre?L('Route preview','Kureba inzira','Aperçu de l’itinéraire')+' · ':''}${L('Step','Intambwe','Étape')} ${i+1}/${n}</div></div>
${st.slice(i+1,i+3).map(x=>`<div class="fi" style="padding:12px 24px"><span style="font-size:20px;width:24px;text-align:center">${x[0]}</span><div style="flex:1">${x[1]}</div><span class="mu" style="font-size:13px">${x[2]}</span></div>`).join('')}
<div class="cta"><div style="display:flex;gap:10px"><button class="btn sec2" style="flex:0 0 36%" onclick="mpEnd()">${last?L('Done','Byarangiye','Terminé'):L('End','Hagarika','Arrêter')}</button>${last?'':`<button class="btn" onclick="mpNext()">${L('Next step','Intambwe ikurikira','Étape suivante')}</button>`}</div></div>`};
/* ---- Community replies ---- */
const REP={1:[['Jean P.','Try the plumber near Remera market, he came the same day for me.'],['Sandrine K.','I can send you his number.']],2:[['Aline N.','Yes, I switched last week and save 15 minutes.']],3:[['Eric M.','See you there.']]};
window.postReplies=id=>{const p=S.posts.find(x=>x.id===id);p.rp=p.rp||(REP[id]||[]).slice();
lay(`<div class="h1" style="font-size:22px;line-height:30px;margin-bottom:6px">${L('Replies','Ibisubizo','Réponses')} · ${p.rp.length}</div><div style="max-height:260px;overflow-y:auto">${p.rp.length?p.rp.map(r=>`<div style="padding:12px 0;border-bottom:0"><b style="font-size:14px">${esc(r[0])}</b><div style="font-size:15px;line-height:22px;margin-top:2px">${esc(r[1])}</div></div>`).join(''):`<div class="mu" style="padding:18px 0">${L('No replies yet. Be the first to answer.','Nta bisubizo. Ba uwa mbere.','Pas encore de réponse. Soyez le premier.')}</div>`}</div>
<div style="display:flex;gap:10px;margin-top:14px"><input id="rpi" class="in" style="font-size:16px;height:48px;border:0;background:var(--chip);border-radius:14px;padding:0 14px" placeholder="${L('Write a reply','Andika igisubizo','Écrire une réponse')}" onkeydown="if(event.key==='Enter')postReplySend(${id})"><button class="btn" style="width:auto;padding:0 20px;height:48px;font-size:16px;border-radius:14px" onclick="postReplySend(${id})">${L('Send','Ohereza','Envoyer')}</button></div>`)};
window.postReplySend=id=>{const p=S.posts.find(x=>x.id===id),v=document.getElementById('rpi').value.trim();if(!v)return;p.rp.push([S.name||'Amina Uwase',v]);p.c++;postReplies(id);render('fade-none')};
const _cm=screens.community;
screens.community=()=>{let k=0;return _cm().replace(/toast\('Replies are not in this prototype'\)/g,()=>'postReplies('+(S.posts[k++]||{}).id+')')};
})();
</script>
<script>
/* v65: Explore/You/Pay/Benefits/Settings "coming soon" buttons now open real screens; new screens: service detail (loans, verify, bus, bike, support...), currency exchange, subscriptions, ride request */
(function(){
const esc=s=>String(s).replace(/</g,'&lt;');
const hd=(t)=>`<div class="mh" style="padding-bottom:0"><button class="ib" aria-label="Back" onclick="back()">${ic('back',24)}</button><b style="flex:1;font-size:19px;margin-left:6px">${esc(t)}</b></div>`;
const lay=h=>{$('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet">'+h+'</div>'};
const ref=()=>'ITN-'+String(Math.floor(10000+Math.random()*89999));
const fm=n=>fmt(Math.round(n));
const done=(e,t,b,ex)=>lay(`<div class="g3" style="font-size:56px;line-height:1;margin-bottom:10px">${e}</div><div class="h1" style="font-size:22px;line-height:30px">${esc(t)}</div><div class="mu" style="font-size:15px;margin:8px 0 ${ex?'8px':'24px'};line-height:22px">${esc(b)}</div>${ex?`<div style="font-weight:800;margin-bottom:24px">${esc(ex)}</div>`:''}<button class="btn" onclick="closeSheet()">OK</button>`);
S.sv2=S.sv2||{};
const SV={
verify:{e:'🪪',t:'Verify your identity',b:'Confirm who you are to unlock higher limits and loans.',f:[['You need','National ID or passport'],['Takes','About 3 minutes'],['Unlocks','Send up to 5,000,000 RWF a day']],cta:'Start verification',d:['📨','Verification submitted','We will confirm within 1 business day.']},
family:{e:'👨‍👩‍👧',t:'Family',b:'Link a guardian or a child. Guardians see spending read-only.',f:[['Guardian view','Read-only spending'],['Child limit','Set by the guardian'],['Link with','Phone number']],cta:'Invite a family member',d:['📨','Invite sent','They will see a request the next time they open itunda.']},
cert:{e:'✍️',t:'Digital certificate',b:'Sign agreements in itunda. A signed copy is stored in your documents.',f:[['Valid for','12 months'],['Accepted by','Banks, SACCOs, employers'],['Cost','Free']],cta:'Get my certificate',d:['✅','Certificate issued','You can now sign agreements from any itunda screen.']},
atu:{e:'🔁',t:'Auto top-up',b:'Refill your account from a linked account when it runs low.',amt:{lab:'Refill when balance is below',min:5000,max:50000,step:5000,def:10000},f:[['Refill from','Linked MoMo account'],['Refill amount','Same as the threshold'],['Fee','Free']],cta:'Turn on auto top-up',d:['✅','Auto top-up is on','We will refill your account when it drops below your limit.']},
harvest:{e:'☕',t:'Harvest advance',b:'Input financing for coffee cooperative members, repaid after the harvest.',amt:{lab:'Advance amount',min:100000,max:2000000,step:100000,def:500000},terms:[4,6,8],rate:12,f:[['For','Cooperative members'],['Repay','From harvest sales'],['Needs','Cooperative ID']],cta:'Apply for advance',d:['📨','Application submitted','Your cooperative will confirm your membership, then we release the funds.']},
vup:{e:'🌱',t:'VUP Financial Services',b:'Means-tested government microloan for households in the VUP programme.',amt:{lab:'Loan amount',min:50000,max:500000,step:50000,def:150000},terms:[6,12,18],rate:2,f:[['Eligible','VUP programme households'],['Checked by','Your sector office'],['Rate','2% a year']],cta:'Apply for microloan',d:['📨','Application submitted','Your sector office will contact you to confirm eligibility.']},
student:{e:'🎓',t:'Student loan',b:'BRD higher-education loan: 11% undergraduate, 12% postgraduate.',amt:{lab:'Loan amount',min:200000,max:3000000,step:100000,def:1000000},terms:[12,24,36],rate:11,f:[['Level','Undergraduate 11%, postgraduate 12%'],['Needs','Admission letter'],['Repay','Starts after graduation']],cta:'Apply for student loan',d:['📨','Application submitted','Upload your admission letter in the next step.']},
moto:{e:'🏍️',t:'Moto-Taxi ownership',b:'Save a 30% down payment, then convert the rest into a loan.',amt:{lab:'Motorbike price',min:1500000,max:3000000,step:100000,def:2000000},terms:[24,36,48],rate:14,down:.3,f:[['Down payment','30% saved first'],['Needs','Valid licence and permit'],['Rate','14% a year']],cta:'Start saving for a motorbike',d:['🎯','Savings goal created','Your 30% down payment goal is ready. Loan opens when you reach it.']},
bike:{e:'🚲',t:'Bike rental',b:'Rent a nearby bike or scooter by the minute.',opts:[['Bike',20],['E-scooter',50]],unit:'RWF / min',f:[['Nearest','Kimironko Market · 120 m'],['Unlock','Scan the QR on the handlebar'],['Pay','From your itunda balance']],cta:'Unlock',d:['🔓','Unlock code 4821','Enter it on the lock. Your ride ends when you lock the bike.']},
bus:{e:'🚌',t:'Intercity bus',b:'Book a seat from Kigali.',opts:[['Huye',3500],['Musanze',3000],['Rubavu',4000],['Rusizi',7500]],unit:'RWF',f:[['Departs','Nyabugogo, every 30 min'],['Luggage','1 bag included'],['Cancel','Free up to 2 h before']],cta:'Book seat',d:['🎫','Seat booked','Show the ticket code at Nyabugogo.']},
call:{e:'📞',t:'Call support',b:'Talk to a person who can help with your account.',f:[['Hours','Mon–Sat, 07:00–20:00'],['Number','+250 788 000 000'],['Cost','Free from itunda']],cta:'Call support',call:1},
ussd:{e:'#️⃣',t:'USSD access',b:'Basic banking on any phone, no data needed.',f:[['Dial','*182*7#'],['Works on','MTN and Airtel'],['You can','Check balance, send, buy airtime']],cta:'Copy code',copy:'*182*7#'},
invite:{e:'🎁',t:'Invite a friend',b:'You both get 500 RWF when they send their first payment.',f:[['Your code','AMINA-K7'],['Friends joined','0'],['Earned','0 RWF']],cta:'Share invite link',copy:'itunda.rw/i/AMINA-K7'},
cashout:{e:'💸',t:'Cash out',b:'Move your pay money to mobile money.',amt:{lab:'Amount',min:1000,max:50000,step:1000,def:5000},opts:[['MTN MoMo ••0788',0],['Airtel Money ••0732',0]],f:[['Arrives','Within a minute'],['Fee','Free']],cta:'Cash out',d:['✅','Cash out requested','The money should arrive within a minute.']}};
const st=k=>{const c=SV[k];return S.sv2[k]=S.sv2[k]||{a:c.amt?c.amt.def:0,tm:0,o:0}};
const pmt=(P,r,n)=>{const i=r/1200;return i?P*i/(1-Math.pow(1+i,-n)):P/n};
window.openSvc=k=>{S.svk=k;S.stack.push('svc');render('push')};
window.svcSet=(f,v)=>{const s=st(S.svk),c=SV[S.svk];if(f==='a')s.a=Math.max(c.amt.min,Math.min(c.amt.max,s.a+v));else s[f]=v;render('fade-none')};
window.svcGo=()=>{const k=S.svk,c=SV[k],s=st(k);
if(c.call)return lay(`<div class="h1" style="font-size:22px;line-height:30px">Call itunda support?</div><div class="mu" style="font-size:16px;margin:8px 0 24px">+250 788 000 000</div><div class="row2"><button class="btn sec2" onclick="closeSheet()">Cancel</button><button class="btn" onclick="closeSheet();toast('Calling +250 788 000 000…')">Call</button></div>`);
if(c.copy){toast('Copied '+c.copy);return}
let ex='';if(c.terms)ex='Reference '+ref();else if(c.opts&&c.unit)ex=c.opts[s.o][0]+' · '+fm(c.opts[s.o][1])+' '+c.unit;
done(c.d[0],c.d[1],c.d[2],ex)};
screens.svc=()=>{const k=S.svk,c=SV[k],s=st(k),a=c.amt;
const mo=c.terms?pmt(s.a*(c.down?1-c.down:1),c.rate,c.terms[s.tm]):0;
const chips=(arr,cur,fn,lab)=>`<div class="chp" style="padding:14px 24px 0">${arr.map((x,i)=>`<button class="${cur===i?'on':''}" onclick="${fn}(${i})">${lab(x)}</button>`).join('')}</div>`;
return `${hd(c.t)}<div style="padding:22px 24px 0"><div style="width:72px;height:72px;border-radius:36px;background:var(--tint);display:flex;align-items:center;justify-content:center;font-size:36px">${c.e}</div><div class="h1" style="margin-top:16px">${esc(c.t)}</div><div class="mu" style="font-size:15px;line-height:22px;margin-top:8px">${esc(c.b)}</div></div>
${a?`<div style="margin:22px 24px 0;padding:16px;border-radius:20px;background:var(--chip)"><div class="sm mu">${a.lab}</div><div style="display:flex;align-items:center;justify-content:space-between;margin-top:6px"><button class="ib" style="background:var(--bg);border-radius:22px;font-size:24px" aria-label="Decrease" onclick="svcSet('a',-${a.step})">−</button><b style="font-size:26px;letter-spacing:-.5px">${fm(s.a)} RWF</b><button class="ib" style="background:var(--bg);border-radius:22px;font-size:24px" aria-label="Increase" onclick="svcSet('a',${a.step})">+</button></div></div>`:''}
${c.terms?chips(c.terms,s.tm,'svcTerm',x=>x+' months')+`<div style="margin:16px 24px 0;display:flex;justify-content:space-between;font-size:15px"><span class="mu">Monthly payment</span><b>${fm(mo)} RWF</b></div>${c.down?`<div style="margin:8px 24px 0;display:flex;justify-content:space-between;font-size:15px"><span class="mu">Down payment to save</span><b>${fm(s.a*c.down)} RWF</b></div>`:''}`:''}
${c.opts?chips(c.opts,s.o,'svcOpt',x=>x[0]+(c.unit?' · '+fm(x[1])+' '+c.unit:'')):''}
<div style="margin-top:18px">${c.f.map(x=>`<div style="display:flex;justify-content:space-between;gap:16px;padding:14px 24px;border-top:0;font-size:15px"><span class="mu">${x[0]}</span><b style="text-align:right">${esc(x[1])}</b></div>`).join('')}</div><div style="height:100px"></div>
<div class="cta"><button class="btn" onclick="svcGo()">${c.cta}</button></div>`};
window.svcTerm=i=>svcSet('tm',i);window.svcOpt=i=>svcSet('o',i);
/* ---- Foreign currency ---- */
const FX=[['USD','🇺🇸',1445],['EUR','🇪🇺',1680],['GBP','🇬🇧',1960]];
S.fx=S.fx||{c:0,a:50000,w:{USD:0,EUR:0,GBP:0}};
window.fxSet=(f,v)=>{if(f==='c')S.fx.c=v;else S.fx.a=Math.max(10000,S.fx.a+v);render('fade-none')};
window.fxGo=()=>{const x=S.fx,r=FX[x.c],got=x.a/r[2];S.bank-=x.a;x.w[r[0]]+=got;render('fade-none');done('💱','Converted to '+r[0],fm(x.a)+' RWF became '+got.toFixed(2)+' '+r[0]+'. It is held in your '+r[0]+' wallet.')};
screens.fx=()=>{const x=S.fx,r=FX[x.c],got=x.a/r[2],bad=x.a>S.bank;
return `${hd('Foreign currency')}<div class="chp" style="padding-top:18px">${FX.map((f,i)=>`<button class="${x.c===i?'on':''}" onclick="fxSet('c',${i})">${f[1]} ${f[0]}</button>`).join('')}</div>
<div style="margin:22px 24px 0;padding:16px;border-radius:20px;background:var(--chip)"><div class="sm mu">You pay</div><div style="display:flex;align-items:center;justify-content:space-between;margin-top:6px"><button class="ib" style="background:var(--bg);border-radius:22px;font-size:24px" aria-label="Decrease" onclick="fxSet('a',-10000)">−</button><b style="font-size:26px;letter-spacing:-.5px;color:${bad?'var(--er)':'var(--tx)'}">${fm(x.a)} RWF</b><button class="ib" style="background:var(--bg);border-radius:22px;font-size:24px" aria-label="Increase" onclick="fxSet('a',10000)">+</button></div></div>
<div style="text-align:center;padding:14px 0 0;font-size:20px">↓</div>
<div style="margin:6px 24px 0;padding:16px;border-radius:20px;background:var(--tint)"><div class="sm" style="color:var(--tintfg)">You get</div><b style="font-size:30px;letter-spacing:-.6px;color:var(--tintfg)">${got.toFixed(2)} ${r[0]}</b></div>
<div style="padding:18px 24px 0;font-size:14px" class="mu">1 ${r[0]} = ${fm(r[2])} RWF · No fee</div>${bad?`<div style="padding:8px 24px 0;font-size:14px;color:var(--er)">Not enough balance. You have ${fm(S.bank)} RWF.</div>`:''}
<div style="margin-top:20px">${FX.map(f=>`<div style="display:flex;justify-content:space-between;padding:14px 24px;border-top:0;font-size:15px"><span>${f[1]} ${f[0]} wallet</span><b>${S.fx.w[f[0]].toFixed(2)}</b></div>`).join('')}</div><div style="height:100px"></div>
<div class="cta"><button class="btn" ${bad?'disabled':''} onclick="fxGo()">Convert to ${r[0]}</button></div>`};
/* ---- Subscriptions ---- */
S.subs=S.subs||[['📺','Canal+ Rwanda',12000,'Monthly','3 Nov',1],['📶','MTN data bundle',5000,'Weekly','Every Mon',1],['🏋️','Gym Kigali',25000,'Monthly','1 Nov',1],['🎵','Music streaming',3000,'Monthly','9 Nov',0]];
window.subTg=i=>{const s=S.subs[i];s[5]=s[5]?0:1;toast(s[5]?s[1]+' resumed':s[1]+' paused');render('fade-none')};
screens.subs=()=>{const mo=S.subs.reduce((a,s)=>a+(s[5]?s[2]*(s[3]==='Weekly'?4:1):0),0);
return `${hd('Subscriptions')}<div style="padding:20px 24px 4px"><div class="sm mu">Monthly total</div><div class="big" style="font-size:34px">${fm(mo)} RWF</div></div>
${S.subs.map((s,i)=>`<div class="row" style="padding:12px 24px"><div class="ico">${s[0]}</div><div style="flex:1;min-width:0"><div class="t" style="opacity:${s[5]?1:.5}">${s[1]}</div><div class="s">${fm(s[2])} RWF · ${s[3]} · ${s[5]?'Next '+s[4]:'Paused'}</div></div><div class="sw ${s[5]?'on':''}" role="switch" aria-checked="${!!s[5]}" aria-label="${s[1]}" tabindex="0" onclick="subTg(${i})"><i></i></div></div>`).join('')}
<div class="pad fine" style="padding-top:16px">Paused subscriptions are not charged. You can resume them any time.</div>`};
/* ---- Ride request ---- */
S.rd=S.rd||{d:0,v:0};
const DEST=[['Kigali Heights',2.1],['Nyabugogo',4.3],['Airport',9.8]],VEH=[['🏍️','Moto',300,2],['🚗','Car',900,5]];
window.rdSet=(f,v)=>{S.rd[f]=v;render('fade-none')};
const rfare=()=>{const v=VEH[S.rd.v],km=DEST[S.rd.d][1];return Math.round((v[2]+km*(v[1]==='Moto'?250:450))/100)*100};
window.rdGo=()=>{const v=VEH[S.rd.v];done(v[0],'Driver on the way','Jean M. · '+(v[1]==='Moto'?'RAD 482 C':'RAB 215 K')+' · arrives in '+v[3]+' min',fm(rfare())+' RWF · pay by itunda')};
screens.ride=()=>`${hd('Rides')}<div class="rbox" style="margin-top:14px"><div class="fi" style="padding:10px 4px"><span style="width:12px;height:12px;border-radius:6px;border:3px solid #2BA84A;margin:6px 6px 0 0"></span>${S.mp&&S.mp.from?esc(S.mp.from):'KG 11 Ave, Kimironko'}</div><div class="fi" style="padding:10px 4px;border-top:0"><span style="width:12px;height:12px;border-radius:6px;border:3px solid #D92D20;margin:6px 6px 0 0"></span>${DEST[S.rd.d][0]}</div></div>
<div class="agt" style="padding-top:20px">Where to?</div><div class="chp" style="padding-top:6px">${DEST.map((d,i)=>`<button class="${S.rd.d===i?'on':''}" onclick="rdSet('d',${i})">${d[0]}</button>`).join('')}</div>
<div style="padding-top:14px">${VEH.map((v,i)=>`<div class="row tap" style="padding:12px 24px;${S.rd.v===i?'background:var(--tint)':''}" onclick="rdSet('v',${i})"><div class="ico" style="font-size:22px">${v[0]}</div><div style="flex:1"><div class="t">${v[1]}</div><div class="s">${v[3]} min away</div></div><b>${S.rd.v===i?fm(rfare()):fm(Math.round((v[2]+DEST[S.rd.d][1]*(v[1]==='Moto'?250:450))/100)*100)} RWF</b></div>`).join('')}</div><div style="height:100px"></div>
<div class="cta"><button class="btn" onclick="rdGo()">Request ${VEH[S.rd.v][1].toLowerCase()}</button></div>`;
/* ---- Route "coming soon" buttons to the screens above ---- */
const R={'Support':()=>openSvc('call'),'Call support':()=>openSvc('call'),'Help and support':()=>supportChat(),'Verify':()=>openSvc('verify'),'Verification':()=>openSvc('verify'),'Group account':()=>{S.stack.push('grp');render('push')},'Family':()=>openSvc('family'),'Foreign currency':()=>{S.stack.push('fx');render('push')},'Subscriptions':()=>{S.stack.push('subs');render('push')},'Digital certificate':()=>openSvc('cert'),'Auto top-up':()=>openSvc('atu'),'Mobile plan':()=>{S.air.done=null;S.stack.push('airtime');render('push')},'12-month deposit':()=>{S.stack.push('dep');render('push')},'Youth account':()=>{S.stack.push('yth');render('push')},'Ikimina':()=>{S.stack.push('ikim');render('push')},'SACCO shares':()=>{S.stack.push('sacco');render('push')},'Get a loan':()=>{S.stack.push('loan');render('push')},'Credit score':()=>openScore(),'Harvest advance':()=>openSvc('harvest'),'VUP Financial Services':()=>openSvc('vup'),'Student loan':()=>openSvc('student'),'Moto-Taxi Ownership':()=>openSvc('moto'),'Rides':()=>{S.stack.push('ride');render('push')},'Bike rental':()=>openSvc('bike'),'Bus':()=>openSvc('bus'),'USSD access':()=>openSvc('ussd'),'Invite a friend':()=>openSvc('invite'),'Cash out':()=>openSvc('cashout')};
/* ---- Settings & security ---- */
S.nt=S.nt||{Payments:1,Offers:0,Community:1,'Map updates':0};S.dv=S.dv||[['📱','This phone','Kigali · Active now',1],['💻','Chrome on Windows','Kigali · 2 days ago',0],['📱','Tecno Spark','Huye · 3 weeks ago',0]];S.pkey=S.pkey||0;S.ts=S.ts||1;
const sw=(on,fn,l)=>`<div class="sw ${on?'on':''}" role="switch" aria-checked="${!!on}" aria-label="${l}" tabindex="0" onclick="${fn}"><i></i></div>`;
window.ntTg=k=>{S.nt[k]=S.nt[k]?0:1;render('fade-none')};
screens.notif=()=>`${hd('Notifications')}<i class="nt880" hidden></i><div class="pad fine" style="padding-top:16px">Choose what itunda can notify you about.</div>${Object.keys(S.nt).map(k=>`<div class="row" style="padding:14px 24px"><div style="flex:1"><div class="t">${k}</div><div class="s">${({Payments:'Money in, money out, bills',Offers:'Deals and cashback',Community:'Replies and neighbourhood posts','Map updates':'Bus delays and saved places'})[k]}</div></div>${sw(S.nt[k],`ntTg('${k}')`,k)}</div>`).join('')}`;
window.tsSet=v=>{S.ts=v;$('#phone').style.zoom=v;render('fade-none')};
screens.tsize=()=>`${hd('Text size')}<div style="padding:24px"><div style="font-size:16px;line-height:24px">Your balance and payments will look like this. Pick the size that is easiest to read.</div></div><div class="chp" style="padding-top:0">${[['Small',.92],['Default',1],['Large',1.1]].map(([l,v])=>`<button class="${S.ts===v?'on':''}" onclick="tsSet(${v})">${l}</button>`).join('')}</div>`;
window.dvOut=i=>{const d=S.dv[i];S.dv.splice(i,1);toast(d[1]+' signed out');render('fade-none')};
screens.devs=()=>`${hd('Devices')}<div class="pad fine" style="padding-top:16px">Devices signed in to your itunda account.</div>${S.dv.map((d,i)=>`<div class="row" style="padding:12px 24px"><div class="ico">${d[0]}</div><div style="flex:1"><div class="t">${d[1]}</div><div class="s">${d[2]}</div></div>${d[3]?'':`<button class="chip" style="color:var(--er)" onclick="dvOut(${i})">Sign out</button>`}</div>`).join('')}`;
window.pkTg=()=>{S.pkey=S.pkey?0:1;toast(S.pkey?'Passkey added. Use your fingerprint or face to sign in.':'Passkey removed');render('fade-none')};
screens.pk=()=>`${hd('Passkeys')}<div style="padding:28px 24px 0"><div style="width:72px;height:72px;border-radius:36px;background:var(--tint);display:flex;align-items:center;justify-content:center;font-size:36px">🔑</div><div class="h1" style="margin-top:16px">Sign in without your PIN</div><div class="mu" style="font-size:15px;line-height:22px;margin-top:8px">A passkey uses your fingerprint, face or screen lock. It cannot be guessed or shared.</div></div><div class="row" style="padding:22px 24px"><div style="flex:1"><div class="t">Use a passkey on this phone</div><div class="s">${S.pkey?'On':'Off'}</div></div>${sw(S.pkey,'pkTg()','Passkey')}</div>`;
S.pn2={s:0,a:'',b:''};
window.pnKey=k=>{const p=S.pn2,f=['a','b','c'][p.s];p[f]=p[f]||'';if(k==='<')p[f]=p[f].slice(0,-1);else if(p[f].length<4)p[f]+=k;if(p[f].length===4){if(p.s===0){p.s=1;p.b=''}else if(p.s===1){p.c='';p.s=2}else if(p.c===p.b){S.pn2={s:0,a:'',b:''};back();return done('🔒','PIN changed','Use your new PIN next time you confirm a payment.')}else{p.c='';toast('PINs do not match. Try again.')}}render('fade-none')};
screens.pin=()=>{const p=S.pn2,v=[p.a,p.b,p.c||''][p.s]||'';return `${hd('Change PIN')}<div style="padding:28px 24px 0"><div class="h1">${['Enter your current PIN','Choose a new PIN','Confirm your new PIN'][p.s]}</div></div><div class="dots6">${[0,1,2,3].map(i=>`<i class="${i<v.length?'on':''}"></i>`).join('')}</div><div class="keys" style="margin-top:24px">${[1,2,3,4,5,6,7,8,9,'',0,'<'].map(k=>`<button ${k===''?'disabled':''} aria-label="${k==='<'?'Delete':k}" onclick="pnKey('${k}')">${k==='<'?'⌫':k}</button>`).join('')}</div>`};
const DOCS={'Privacy policy':['What we collect','Your name, phone number, transactions and the device you use. We collect only what we need to run your account.','How we use it','To process payments, prevent fraud and improve itunda. We never sell your personal data.','Your choices','You can ask for a copy of your data or ask us to delete your account from Settings.'],
'Terms & consent':['Using itunda','You must be 18 or older, or use a youth account linked to a guardian.','Payments','Payments are final once confirmed with your PIN. Report a mistake from Explore, then Support.','Consent','You agree to these terms when you create an account. You can withdraw consent by closing your account.'],
'Credit data usage policy':['What credit data means','Your payment history, savings habits and bill payments can be used to build your credit score.','Who sees it','Only lenders you apply to, and only after you agree.','Turning it off','You can stop using alternative data in Settings. Your score may be lower or unavailable.']};
window.openDoc=n=>{S.doc=n;S.stack.push('doc');render('push')};
screens.doc=()=>{const d=DOCS[S.doc]||[];return `${hd(S.doc)}<div style="padding:20px 24px 40px">${d.map((x,i)=>i%2?`<p style="font-size:15px;line-height:24px;margin:6px 0 20px">${x}</p>`:`<b style="font-size:17px">${x}</b>`).join('')}<div class="fine">Last updated 1 October 2026</div></div>`};
Object.assign(R,{'Notifications':()=>{S.stack.push('notif');render('push')},'Text size':()=>{S.stack.push('tsize');render('push')},'Devices':()=>{S.stack.push('devs');render('push')},'Passkeys':()=>{S.stack.push('pk');render('push')},'Change PIN':()=>{S.pn2={s:0,a:'',b:''};S.stack.push('pin');render('push')},'Privacy policy':()=>openDoc('Privacy policy'),'Terms & consent':()=>openDoc('Terms & consent'),'Credit data usage policy':()=>openDoc('Credit data usage policy')});

const _so=soon;
soon=function(){const ev=window.event,c=ev&&ev.target&&ev.target.closest?ev.target.closest('[onclick]'):null;
if(c){const e=c.querySelector('.t,.pn'),n=((e||c).textContent||'').trim().split('\n')[0].trim(),top=S.stack[S.stack.length-1];
if(R[n]&&top!=='bank'&&top!=='svc'){R[n]();return}}
return _so.apply(this,arguments)};
})();
</script>
<script>
/* v66: Points + redeem, Coupons, Daily challenge, Card cashback, offer pages, partner link stats, mini-profile edit / friends / purchase history */
(function(){
const esc=s=>String(s).replace(/</g,'&lt;').replace(/"/g,'&quot;');
const hd=t=>`<div class="mh" style="padding-bottom:0"><button class="ib" aria-label="Back" onclick="back()">${ic('back',24)}</button><b style="flex:1;font-size:19px;margin-left:6px">${esc(t)}</b></div>`;
const lay=h=>{$('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet">'+h+'</div>'};
const done=(e,t,b)=>lay(`<div class="g3" style="font-size:56px;line-height:1;margin-bottom:10px">${e}</div><div class="h1" style="font-size:22px;line-height:30px">${esc(t)}</div><div class="mu" style="font-size:15px;margin:8px 0 24px;line-height:22px">${esc(b)}</div><button class="btn" onclick="closeSheet()">OK</button>`);
const fm=n=>fmt(Math.round(n));
const go=(k,fn)=>{S.stack.push(k);render('push')};
const sw=(on,fn,l)=>`<div class="sw ${on?'on':''}" role="switch" aria-checked="${!!on}" aria-label="${l}" tabindex="0" onclick="${fn}"><i></i></div>`;
const hr=(e,t,s,r,on)=>`<div class="row ${on?'tap':''}" style="padding:12px 24px" ${on?`onclick="${on}"`:''}><div class="ico" style="font-size:20px">${e}</div><div style="flex:1;min-width:0"><div class="t">${t}</div>${s?`<div class="s">${s}</div>`:''}</div>${r?`<b>${r}</b>`:''}</div>`;
if(S.pts===undefined)S.pts=6400;
S.ph=S.ph||[['🥐','Kigali Bakery QR payment','+120','Yesterday'],['🚌','Bus tap, Kimironko','+20','Yesterday'],['🎁','Welcome reward','+500','2 weeks ago']];
const hist=()=>`<div class="agt">Recent activity</div>${S.ph.map(x=>hr(x[0],x[1],x[3],x[2].startsWith('-')?x[2]:x[2])).join('')}`;
const addPh=(e,t,a)=>S.ph.unshift([e,t,a,'Just now']);
/* ---- Points ---- */
S.rd2=S.rd2||1000;
window.ptsAmt=d=>{S.rd2=Math.max(1000,Math.min(Math.max(1000,Math.floor(S.pts/1000)*1000),S.rd2+d));render('fade-none')};
window.ptsRedeem=()=>{const a=S.rd2;if(a>S.pts)return;S.pts-=a;S.pay+=a;addPh('💸','Redeemed to Pay money','-'+fm(a));S.rd2=Math.min(S.rd2,Math.max(1000,Math.floor(S.pts/1000)*1000));done('✅','Redeemed',fm(a)+' points added to your Pay money. New balance '+fm(S.pay)+' RWF.');render('fade-none')};
screens.pts=()=>{const can=S.pts>=1000,a=Math.min(S.rd2,Math.max(1000,Math.floor(S.pts/1000)*1000));
return `${hd('Points')}<div style="padding:22px 24px 0"><div class="sm mu">Your points</div><div class="big">${fm(S.pts)}</div><div class="mu" style="font-size:14px;margin-top:4px">1 point = 1 RWF in Pay money</div></div>
<div style="margin:22px 24px 0;padding:16px;border-radius:20px;background:var(--chip)"><div class="sm mu">Redeem</div><div style="display:flex;align-items:center;justify-content:space-between;margin-top:6px"><button class="ib" style="background:var(--bg);border-radius:22px;font-size:24px" aria-label="Decrease" onclick="ptsAmt(-1000)">−</button><b style="font-size:26px;letter-spacing:-.5px">${fm(can?a:0)} pts</b><button class="ib" style="background:var(--bg);border-radius:22px;font-size:24px" aria-label="Increase" onclick="ptsAmt(1000)">+</button></div>${can?'':'<div class="sm mu" style="margin-top:8px">You need at least 1,000 points to redeem.</div>'}</div>
<div style="padding-top:8px">${hist()}</div><div style="height:100px"></div><div class="cta"><button class="btn" ${can?'':'disabled'} onclick="ptsRedeem()">Redeem to Pay money</button></div>`};
/* ---- Coupons ---- */
S.cp=S.cp||[['🥐','Kigali Bakery','5% off any order','Expires 31 Oct','BAKE5',0],['🚌','Kigali bus fares','2 free rides','Expires 15 Nov','RIDE2',0],['🍽️','Nyamirambo Grill','Free soda with a meal','Expires 20 Oct','SODA1',0]];
window.cpUse=i=>{const c=S.cp[i];c[5]=1;lay(`<div class="g3" style="font-size:56px;line-height:1;margin-bottom:10px">${c[0]}</div><div class="h1" style="font-size:22px;line-height:30px">${c[1]}</div><div class="mu" style="font-size:15px;margin:6px 0 16px">${c[2]}</div><div style="background:var(--chip);border-radius:16px;padding:18px;text-align:center;font-size:28px;font-weight:800;letter-spacing:4px">${c[4]}</div><div class="fine" style="margin:10px 0 20px;text-align:center">Show this code at the till or enter it at checkout.</div><button class="btn" onclick="closeSheet()">Done</button>`);render('fade-none')};
screens.coupons=()=>{const a=S.cp.map((c,i)=>[c,i]).filter(([c])=>!c[5]),u=S.cp.filter(c=>c[5]);
return `${hd('Your coupons')}${a.length?a.map(([c,i])=>hr(c[0],c[1],c[2]+' · '+c[3],'',null).replace('</div></div>','</div><button class="chip" style="margin-left:auto" onclick="cpUse('+i+')">Use</button></div>')).join(''):`<div class="pad" style="text-align:center;padding-top:64px"><div style="font-size:44px">🎟️</div><div style="font-size:18px;font-weight:800;margin-top:14px">No coupons right now</div><div class="mu" style="margin-top:8px;font-size:15px;line-height:22px">Complete the daily challenge or turn on an offer to earn coupons.</div></div>`}
${u.length?`<div class="agt">Used</div>${u.map(c=>`<div style="opacity:.5">${hr(c[0],c[1],c[2],'Used',null)}</div>`).join('')}`:''}`};
/* ---- Daily challenge ---- */
S.dc=S.dc||{streak:3,went:{},claimed:{},bonus:0};
const TK=[['🗺️','Plan a trip','openDirections()',50],['💸','Start a money transfer','flow()',50],['⭐','Check your points','S.stack.push(\'pts\');render(\'push\')',30]];
window.dcGo=i=>{S.dc.went[i]=1;(new Function(TK[i][2]))()};
window.dcClaim=i=>{S.dc.claimed[i]=1;S.pts+=TK[i][3];addPh(TK[i][0],'Daily challenge: '+TK[i][1],'+'+TK[i][3]);toast('+'+TK[i][3]+' points');if(TK.every((t,j)=>S.dc.claimed[j])&&!S.dc.bonus){S.dc.bonus=1;S.dc.streak++;S.pts+=100;addPh('🔥','Daily challenge bonus','+100');S.cp.unshift(['🎁','Daily bonus','10% off your next order','Expires in 7 days','DAILY10',0]);done('🔥','Challenge complete','Streak is now '+S.dc.streak+' days. You earned 100 bonus points and a coupon.')}render('fade-none')};
screens.challenge=()=>`${hd('Daily challenge')}<div style="padding:22px 24px 0"><div style="font-size:40px">🔥</div><div class="h1" style="margin-top:6px">${S.dc.streak}-day streak</div><div class="mu" style="font-size:15px;line-height:22px;margin-top:6px">Finish all three tasks today for a 100 point bonus and a coupon.</div></div><div style="padding-top:14px">${TK.map((t,i)=>hr(t[0],t[1],'+'+t[3]+' points','',null).replace('</div></div>','</div>'+(S.dc.claimed[i]?'<span style="margin-left:auto;color:var(--ok);font-weight:800">Done ✓</span>':S.dc.went[i]?`<button class="chip" style="margin-left:auto;background:var(--br);color:var(--on)" onclick="dcClaim(${i})">Claim</button>`:`<button class="chip" style="margin-left:auto" onclick="dcGo(${i})">Go</button>`)+'</div>')).join('')}</div><div class="pad fine" style="padding-top:16px">Tap Go, do the task, then come back and claim your points.</div>`;
/* ---- Card cashback ---- */
S.cbk=S.cbk||{b:0};const BO=['Food','Transit','Shopping'];
window.cbSet=i=>{S.cbk.b=i;toast(BO[i]+' now earns 3% back');render('fade-none')};
screens.cashback=()=>`${hd('Card cashback')}<div style="padding:22px 24px 0"><div class="sm mu">Earned this month</div><div class="big">3,200 RWF</div><div class="mu" style="font-size:14px;margin-top:4px">1% back on every itunda card purchase</div></div>
<div class="agt">Pick one category to earn 3%</div><div class="chp" style="padding-top:0">${BO.map((b,i)=>`<button class="${S.cbk.b===i?'on':''}" onclick="cbSet(${i})">${b}</button>`).join('')}</div>
<div class="agt">Recent cashback</div>${hr('🍽️','Nyamirambo Grill','Yesterday','+45 RWF')}${hr('🛍️','Kimironko Market','3 days ago','+30 RWF')}${hr('🚌','Bus top-up','5 days ago','+10 RWF')}
<div style="height:100px"></div><div class="cta"><button class="btn" onclick="${S.card?'openCard()':'getCard()'}">${S.card?'View my card':'Get itunda card'}</button></div>`;
/* ---- Offers ---- */
S.of=S.of||{};
const OF={bakery:['🥐','Kigali Bakery','5% back when you pay with QR',[['Valid','Every day until 31 Dec'],['Max back','5,000 RWF a month'],['How','Scan the bakery QR with itunda Pay']],'Order from Kigali Bakery','openRest(0)'],bus:['🚌','Kigali bus fares','Points on every tap',[['Earn','1 point per 100 RWF of fare'],['Valid','Every Kigali bus'],['How','Tap your itunda card or phone']],'Top up bus card','openTransit()']};
window.ofOpen=k=>{S.ok=k;go('offer')};
window.ofTg=()=>{S.of[S.ok]=!S.of[S.ok];toast(S.of[S.ok]?'Offer on':'Offer off');render('fade-none')};
screens.offer=()=>{const o=OF[S.ok];return `${hd(o[1])}<div style="padding:22px 24px 0"><div style="width:72px;height:72px;border-radius:36px;background:var(--tint);display:flex;align-items:center;justify-content:center;font-size:36px">${o[0]}</div><div class="h1" style="margin-top:16px">${o[2]}</div></div><div class="row" style="padding:18px 24px"><div style="flex:1"><div class="t">Turn on this offer</div><div class="s">${S.of[S.ok]?'On':'Off'}</div></div>${sw(S.of[S.ok],'ofTg()','Offer')}</div>${o[3].map(x=>`<div style="display:flex;justify-content:space-between;gap:16px;padding:14px 24px;border-top:0;font-size:15px"><span class="mu">${x[0]}</span><b style="text-align:right">${x[1]}</b></div>`).join('')}<div style="height:100px"></div><div class="cta"><button class="btn" onclick="${o[5]}">${o[4]}</button></div>`};
/* ---- Partner links ---- */
S.lk=S.lk||[['Solar lamp','itunda.rw/p/sl-91',9,840],['Coffee grinder','itunda.rw/p/cg-22',5,400]];
window.lkNew=()=>{const n=['Rain jacket','Phone case','Water filter'][S.lk.length%3];S.lk.unshift([n,'itunda.rw/p/'+n.slice(0,2).toLowerCase()+'-'+(10+S.lk.length*7),0,0]);toast('Link created for '+n);render('fade-none')};
screens.links=()=>{const c=S.lk.reduce((a,l)=>a+l[2],0),e=S.lk.reduce((a,l)=>a+l[3],0);
return `${hd('Partner earnings')}<div style="display:flex;gap:10px;padding:20px 24px 0">${[['Links',S.lk.length],['Clicks',c],['Earned',fm(e)+' RWF']].map(x=>`<div style="flex:1;background:var(--chip);border-radius:16px;padding:12px"><div class="sm mu">${x[0]}</div><b style="font-size:17px">${x[1]}</b></div>`).join('')}</div><div class="pad fine" style="padding-top:12px">You earn 3% on purchases made through a product link you shared.</div>
${S.lk.map((l,i)=>hr('🔗',l[0],l[1]+' · '+l[2]+' clicks',fm(l[3])+' RWF',null).replace('</div></div>','</div><button class="ib" style="width:36px;height:36px" aria-label="Copy link" onclick="toast(\'Copied '+l[1]+'\')">⧉</button></div>')).join('')}<div style="height:100px"></div><div class="cta"><button class="btn" onclick="lkNew()">Create a product link</button></div>`};
/* ---- Mini profile ---- */
S.mpf=S.mpf||{n:'Player84825',a:'🐼'};S.fr=S.fr||[['Claire U.',0],['Eric M.',0],['Aline N.',0],['Jean P.',0]];
window.mpfEdit=()=>{lay(`<div class="h1" style="font-size:22px;line-height:30px">Edit profile</div><div style="display:flex;gap:8px;margin:14px 0">${['🐼','🦁','🦊','🐸','🦉'].map(a=>`<button class="ib" aria-label="Avatar ${a}" style="width:48px;height:48px;font-size:26px;border-radius:16px;background:${S.mpf.a===a?'var(--tint)':'var(--chip)'}" onclick="S.mpf.a='${a}';mpfEdit()">${a}</button>`).join('')}</div><input id="mpn" class="in" maxlength="16" value="${esc(S.mpf.n)}" aria-label="Nickname" style="font-size:18px;margin-bottom:20px"><div class="row2"><button class="btn sec2" onclick="closeSheet()">Cancel</button><button class="btn" onclick="mpfSave()">Save</button></div>`)};
window.mpfSave=()=>{const v=document.getElementById('mpn').value.trim();if(!v){toast('Enter a nickname');return}S.mpf.n=v;closeSheet();toast('Profile saved');render('fade-none')};
window.frTg=i=>{S.fr[i][1]=S.fr[i][1]?0:1;toast(S.fr[i][1]?'Request sent to '+S.fr[i][0]:'Request cancelled');render('fade-none')};
screens.friends=()=>`${hd('Connect friends')}<div class="pad fine" style="padding-top:16px">People from your contacts who play on itunda.</div>${S.fr.map((f,i)=>`<div class="row" style="padding:12px 24px"><div class="ico" style="background:var(--tint);color:var(--tintfg);font-weight:800">${f[0][0]}</div><div class="t" style="flex:1">${f[0]}</div><button class="chip" style="${f[1]?'':'background:var(--br);color:var(--on)'}" onclick="frTg(${i})">${f[1]?'Requested':'Add'}</button></div>`).join('')}`;
screens.phist=()=>{const o=(S.orders||[]).map(x=>[x.k==='Eats order'?'🍽️':'🛍️',x.k,x.s,fm(x.t)+' RWF']),s=[['🪙','Game coins, 500 pack','2 weeks ago','1,000 RWF'],['📱','Airtime top-up','3 weeks ago','2,000 RWF']];
return `${hd('Purchase history')}${o.concat(s).map(x=>hr(x[0],x[1],x[2],x[3],null)).join('')}`};
const _mp=screens.miniprof;
screens.miniprof=()=>{let h=_mp(),k=0;const seq=['mpfEdit()',"go('friends')","go('phist')"];
h=h.replace(/onclick="soon\(\)"/g,()=>'onclick="'+(seq[k++]||'soon()')+'"').replace(/(<div class="t" style="font-size:22px">)[^<]*(<\/div>)/,'$1'+esc(S.mpf.n)+'$2').replace('🐼',S.mpf.a);return h};
window.go=window.go||function(k){S.stack.push(k);render('push')};
/* keep points in sync on Pay and Benefits */
const syn=(n,fn)=>{const _o=screens[n];screens[n]=()=>fn(_o())};
syn('benefits',h=>h.replace('6,400 RWF',fm(S.pts)+' RWF'));
syn('pay',h=>{h=h.replace('>6,400<','>'+fm(S.pts)+'<');const n=S.cp.filter(c=>!c[5]).length;return h.replace(/(Your Coupons[\s\S]{0,260}?<div class="r">)0/,'$1'+n)});
/* wire the buttons */
const R2={'Points · Pay Money':()=>go('pts'),'Your Coupons':()=>go('coupons'),'Daily challenge':()=>go('challenge'),'Card cashback':()=>go('cashback'),'Kigali Bakery':()=>ofOpen('bakery'),'Kigali bus fares':()=>ofOpen('bus'),'Links shared':()=>go('links'),'Total clicks':()=>go('links'),'Total earned':()=>go('links')};
const _s6=soon;
soon=function(){const ev=window.event,c=ev&&ev.target&&ev.target.closest?ev.target.closest('[onclick]'):null;
if(c){const e=c.querySelector('.t,.pn'),n=((e||c).textContent||'').trim().split('\n')[0].trim();if(R2[n]){R2[n]();return}}
return _s6.apply(this,arguments)};
})();
</script>
<script>
/* v67: Settings (My info, Send, Pay), bank shortcuts (26-week, Investments, Spending, Auto-transfer), working 31-day savings, referral code, mini-app categories, Call + More arrivals sheets */
(function(){
const esc=s=>String(s).replace(/</g,'&lt;').replace(/"/g,'&quot;');
const hd=t=>`<div class="mh" style="padding-bottom:0"><button class="ib" aria-label="Back" onclick="back()">${ic('back',24)}</button><b style="flex:1;font-size:19px;margin-left:6px">${esc(t)}</b></div>`;
const lay=h=>{$('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet">'+h+'</div>'};
const done=(e,t,b)=>lay(`<div class="g3" style="font-size:56px;line-height:1;margin-bottom:10px">${e}</div><div class="h1" style="font-size:22px;line-height:30px">${esc(t)}</div><div class="mu" style="font-size:15px;margin:8px 0 24px;line-height:22px">${esc(b)}</div><button class="btn" onclick="closeSheet()">OK</button>`);
const fm=n=>fmt(Math.round(n));
const sw=(on,fn,l)=>`<div class="sw ${on?'on':''}" role="switch" aria-checked="${!!on}" aria-label="${l}" tabindex="0" onclick="${fn}"><i></i></div>`;
const push=k=>{S.stack.push(k);render('push')};
const trow=(t,s,on,fn)=>`<div class="row" style="padding:14px 24px"><div style="flex:1"><div class="t">${t}</div>${s?`<div class="s">${s}</div>`:''}</div>${sw(on,fn,t)}</div>`;
/* ---- Send / Pay settings ---- */
S.tps=S.tps||{lim:1000000,pin:1,sms:0,unk:1,src:0,ask:1,ru:1};S.tpk=S.tpk||'send';
window.tpTg=k=>{S.tps[k]=S.tps[k]?0:1;render('fade-none')};
window.tpLim=d=>{S.tps.lim=Math.max(500000,Math.min(5000000,S.tps.lim+d));render('fade-none')};
window.tpSrc=i=>{S.tps.src=i;toast('Default source: '+['Pay money','itunda Bank','itunda card'][i]);render('fade-none')};
screens.tpset=()=>{const o=S.tps;
if(S.tpk==='send')return `${hd('Send')}<div style="margin:20px 24px 0;padding:16px;border-radius:20px;background:var(--chip)"><div class="sm mu">Daily sending limit</div><div class="tap" role="button" tabindex="0" onclick="bkLim()" style="display:flex;align-items:center;justify-content:space-between;margin-top:6px;cursor:pointer"><b style="font-size:24px;letter-spacing:-.5px">${fm(S.lim.day)} RWF</b><span class="sm mu">Left ${fm(Math.max(0,S.lim.day-S.lim.used))} · Change</span></div></div><div style="padding-top:10px">${trow('Confirm with PIN','Ask for your PIN before every transfer',o.pin,"tpTg('pin')")}${trow('Text the recipient','Send an SMS when money arrives',o.sms,"tpTg('sms')")}${trow('Warn on new numbers','Extra check before sending to someone new',o.unk,"tpTg('unk')")}</div>`;
return `${hd('Pay')}<div class="agt" style="padding-top:20px">Pay from</div><div class="chp" style="padding-top:6px">${['Pay money','itunda Bank','itunda card'].map((x,i)=>`<button class="${o.src===i?'on':''}" onclick="tpSrc(${i})">${x}</button>`).join('')}</div><div style="padding-top:10px">${trow('Ask before large payments','Confirm anything above 50,000 RWF',o.ask,"tpTg('ask')")}${trow('Round up and save','Round each payment up to the next 100 RWF',o.ru,"tpTg('ru')")}</div>`};
/* ---- Auto-transfer ---- */
S.at=S.at||[['🎯','School fees goal','Every Friday','5,000',1],['🏠','Rent','1st of each month','80,000',1]];
window.atTg=i=>{S.at[i][4]=S.at[i][4]?0:1;toast(S.at[i][1]+(S.at[i][4]?' resumed':' paused'));render('fade-none')};
window.atNew=()=>{S.at.push(['🪙','Interest jar','Every Monday','2,000',1]);toast('Auto-transfer added');render('fade-none')};
screens.autot=()=>`${hd('Auto-transfer')}<div class="pad fine" style="padding-top:16px">Money moves on its own from your Pay money. We skip a transfer if your balance is too low.</div>${S.at.map((a,i)=>`<div class="row" style="padding:12px 24px"><div class="ico">${a[0]}</div><div style="flex:1;min-width:0"><div class="t" style="opacity:${a[4]?1:.5}">${a[1]}</div><div class="s">${a[3]} RWF · ${a[2]}</div></div>${sw(a[4],'atTg('+i+')',a[1])}</div>`).join('')}<div style="height:100px"></div><div class="cta"><button class="btn" onclick="atNew()">New auto-transfer</button></div>`;
/* ---- 31-day savings ---- */
S.s31=S.s31||{d:0,t:0};
window.s31Save=()=>{const s=S.s31;if(s.t)return;if(S.bank<500){toast('Not enough balance');return}S.bank-=500;s.d++;s.t=1;render('fade-none');if(s.d>=31)done('🏆','31 days complete','You earned the full 10% bonus rate. Well done.')};
window.s31Next=()=>{S.s31.t=0;render('fade-none')};
screens.save31=()=>{const s=S.s31,r=(s.d*10/31).toFixed(1);
return `${hd('31-day savings')}<div class="pad" style="padding-top:24px"><div class="h1">Save a little every day for 31 days</div><div class="mu" style="font-size:16px;margin-top:12px;line-height:24px">The longer your daily streak, the higher your bonus rate, up to 10%.</div></div><div class="pad" style="padding-top:28px"><div style="display:flex;flex-wrap:wrap;gap:8px">${Array.from({length:31},(_,i)=>`<div style="width:18px;height:18px;border-radius:9px;background:${i<s.d?'var(--br)':'var(--chip)'}"></div>`).join('')}</div><div class="sm mu" style="margin-top:12px">${s.d?s.d+'-day streak':'Your streak starts today'}</div></div><div class="pad" style="padding-top:22px"><div style="display:flex;justify-content:space-between;height:44px;align-items:center;font-size:15px"><span class="mu">Bonus rate now</span><b>${r}%</b></div><div style="display:flex;justify-content:space-between;height:44px;align-items:center;font-size:15px;border-top:0"><span class="mu">Saved so far</span><b>${fm(s.d*500)} RWF</b></div><div class="fine" style="margin-top:12px">itunda Bank is not a licensed bank. Sample copy for this prototype.</div></div><div class="cta"><button class="btn" ${s.t||s.d>=31?'disabled':''} onclick="s31Save()">${s.d>=31?'Completed':s.t?'Saved today ✓':'Save 500 RWF today'}</button>${s.t?'<div style="text-align:center;padding-top:10px"><a style="color:var(--lk);font-weight:700;font-size:14px" onclick="s31Next()">Skip to tomorrow (demo)</a></div>':''}</div>`};
/* ---- Referral code ---- */
window.refSheet=()=>lay(`<div class="h1" style="font-size:22px;line-height:30px">Referral code</div><div class="mu" style="font-size:15px;margin:6px 0 14px">Enter the code a friend shared with you.</div><input id="rfc" class="in" maxlength="12" placeholder="e.g. AMINA-K7" aria-label="Referral code" style="font-size:18px;text-transform:uppercase;margin-bottom:18px" value="${esc(S.refc||'')}"><div class="row2"><button class="btn sec2" onclick="closeSheet()">Cancel</button><button class="btn" onclick="refApply()">Apply</button></div>`);
window.refApply=()=>{const v=document.getElementById('rfc').value.trim().toUpperCase();if(v.length<4){toast('Enter a valid code');return}S.refc=v;closeSheet();toast('Code '+v+' applied. You both get a reward.')};
/* ---- Mini-app categories ---- */
const MC={Games:[['🎲','Ludo Rwanda','Play with friends'],['🧩','Word Puzzle','Daily puzzle'],['🏎️','Kigali Racer','Endless driving']],Shopping:[['🛍️','Market Deals','Local offers'],['🧺','Grocery List','Plan and share'],['📦','Parcel Track','Follow deliveries']],Money:[['🧮','Budget Buddy','Track monthly spend'],['💱','Rate Watch','Currency alerts'],['🧾','Receipt Box','Keep your receipts']],Travel:[['🚌','Bus Times','Live arrivals'],['🗺️','Trip Planner','Plan a weekend'],['🏨','Stay Finder','Guesthouses in Rwanda']],Learning:[['🔤','Kinyarwanda 101','Learn basics'],['🧠','Quiz Night','Test your knowledge'],['📚','Library','Free e-books']],Lifestyle:[['🍲','Recipes','Rwandan classics'],['💪','Fit 30','30-day workouts'],['🎵','Radio','Local stations']],Utilities:[['🔦','Flashlight','Quick light'],['📏','Converter','Units and sizes'],['⏰','Reminders','Never forget']]};
S.mfav=S.mfav||{};
window.miniCat=c=>{S.mck=c;push('minicat')};
window.mfTg=n=>{S.mfav[n]=!S.mfav[n];toast(S.mfav[n]?n+' added':n+' removed');render('fade-none')};
screens.minicat=()=>`${hd(S.mck)}${MC[S.mck].map(a=>`<div class="row" style="padding:12px 24px"><div class="ico" style="font-size:22px">${a[0]}</div><div style="flex:1;min-width:0"><div class="t">${a[1]}</div><div class="s">${a[2]}</div></div><button class="chip" style="${S.mfav[a[1]]?'':'background:var(--br);color:var(--on)'}" onclick="mfTg('${a[1]}')">${S.mfav[a[1]]?'Added':'Add'}</button></div>`).join('')}`;
const _mi=screens.mini;
screens.mini=()=>_mi().replace(/<button onclick="soon\(\)">(Games|Shopping|Money|Travel|Learning|Lifestyle|Utilities)<\/button>/g,'<button onclick="miniCat(\'$1\')">$1</button>');
/* ---- Calling and More arrivals ---- */
window.etCall=()=>lay(`<div class="h1" style="font-size:22px;line-height:30px">Call your rider?</div><div class="mu" style="font-size:16px;margin:8px 0 24px">Jean Claude · +250 788 456 112</div><div class="row2"><button class="btn sec2" onclick="closeSheet()">Cancel</button><button class="btn" onclick="closeSheet();toast('Calling Jean Claude…')">Call</button></div>`);
window.mpMore=()=>lay(`<div class="h1" style="font-size:22px;line-height:30px;margin-bottom:8px">Upcoming arrivals</div>${[['305','24 min'],['102','31 min'],['305','38 min'],['311','45 min']].map(a=>`<div style="display:flex;align-items:center;gap:12px;padding:10px 0;border-top:0"><b style="background:#3B7D20;color:#fff;border-radius:8px;padding:2px 10px">${a[0]}</b><span style="flex:1;font-weight:700">${a[1]}</span><span class="sm mu">Seats</span></div>`).join('')}<button class="btn" style="margin-top:16px" onclick="closeSheet()">Close</button>`);
for(const n of Object.keys(screens)){const o=screens[n];screens[n]=function(){let h=o.apply(this,arguments);if(typeof h!=='string'||h.indexOf('is not in this prototype')<0)return h;
h=h.split('aria-label="Call rider" onclick="toast(\'Calling is not in this prototype\')"').join('aria-label="Call rider" onclick="etCall()"');
return h.split("toast('Calling is not in this prototype')").join("mpCall('+250 788 000 323')").split("toast('More arrivals: not in this prototype')").join('mpMore()')}}
/* ---- Wire buttons ---- */
const R3={'Auto-transfer':()=>push('autot'),'26-week savings':()=>push('w26'),'Investments':()=>push('invest'),'312,000 RWF':()=>push('spend'),'Have a referral code?':()=>refSheet()};
const R4={'Send':()=>{S.tpk='send';push('tpset')},'Pay':()=>{S.tpk='pay';push('tpset')},'A':()=>openProfile()};
const _s7=soon;
soon=function(){const ev=window.event,c=ev&&ev.target&&ev.target.closest?ev.target.closest('[onclick]'):null;
if(c){const e=c.querySelector('.t,.pn'),n=((e||c).textContent||'').trim().split('\n')[0].trim(),top=S.stack[S.stack.length-1];
if(R3[n]){R3[n]();return}if(top==='settings'&&c.classList.contains('prof')){openProfile();return}if(top==='settings'&&R4[n]){R4[n]();return}}
return _s7.apply(this,arguments)};
})();
</script>
<script>
/* v68: keyboard + screen-reader access for every tappable row, Esc closes sheets / goes back, copy never throws, reduced motion */
(function(){
const ph=document.getElementById('phone');
const st=document.createElement('style');
st.textContent=':focus{outline:none}:focus-visible{outline:3px solid var(--lk);outline-offset:2px;border-radius:10px}.sheetbg:focus-visible{outline:none}@media (prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.01ms!important;animation-delay:0s!important;transition-duration:.01ms!important}}';
document.head.appendChild(st);
/* tappable divs become real keyboard targets */
const fix=()=>ph.querySelectorAll('[onclick]:not(button):not(a):not(input):not(.sheetbg):not(.toast):not([role]):not([tabindex])').forEach(e=>{e.setAttribute('role','button');e.tabIndex=0});
let q=0;new MutationObserver(()=>{if(q)return;q=requestAnimationFrame(()=>{q=0;fix()})}).observe(ph,{childList:true,subtree:true});fix();
ph.addEventListener('keydown',e=>{const t=e.target;if((e.key==='Enter'||e.key===' ')&&t.getAttribute&&t.getAttribute('role')==='button'&&t.tagName!=='BUTTON'){e.preventDefault();t.click()}});
/* Esc: close the open sheet first, otherwise go back one screen */
document.addEventListener('keydown',e=>{if(e.key!=='Escape')return;const ly=document.getElementById('layer');
if(ly&&ly.innerHTML.trim()){closeSheet();return}
if(/INPUT|TEXTAREA/.test((document.activeElement||{}).tagName||''))return;
if(S.auth&&S.stack.length)back()});
/* sheets: move focus inside when one opens so keyboard users are not left behind */
new MutationObserver(()=>{const s=document.querySelector('#layer .sheet');if(s&&!s.__f){s.__f=1;const b=s.querySelector('input,button');if(b&&!/INPUT/.test(b.tagName))b.focus({preventScroll:true});else if(b)b.focus({preventScroll:true})}}).observe(document.getElementById('layer'),{childList:true});
/* copy: fall back to a hidden textarea, never reject (blocked clipboard, http, iframes) */
const legacy=t=>{try{const a=document.createElement('textarea');a.value=t;a.style.cssText='position:fixed;opacity:0;top:0';document.body.appendChild(a);a.select();document.execCommand('copy');a.remove()}catch(_){}};
const real=navigator.clipboard&&navigator.clipboard.writeText?navigator.clipboard.writeText.bind(navigator.clipboard):null;
try{Object.defineProperty(navigator,'clipboard',{configurable:true,value:{writeText:t=>{legacy(t);return real?real(t).catch(()=>{}):Promise.resolve()}}})}catch(_){}
document.title=document.title.replace('v67','v69').replace('v68','v69').replace('v69','v70').replace('v70','v71').replace('v71','v72').replace('v72','v73').replace('v73','v74');
})();
</script>
<style id="v69">
/* v69: contrast fixes (WCAG AA) for muted text, links and selected chips */
:root{--mu:#6B7684;--tt:#6B7684;--lk:#5A51EC}
:root[data-theme=light]{--mu:#6B7684;--tt:#6B7684;--lk:#5A51EC}
@media (prefers-color-scheme:dark){:root:not([data-theme=light]){--tt:#9EA4AE;--mu:#9EA4AE}.chp button.on,.ocp.on{color:var(--on)}}
:root[data-theme=dark]{--tt:#9EA4AE;--mu:#9EA4AE}
:root[data-theme=dark] .chp button.on,:root[data-theme=dark] .ocp.on{color:var(--on)}
@media (prefers-color-scheme:light){:root{--ok:#08794D}}:root[data-theme=light]{--ok:#08794D}:root[data-theme=dark]{--ok:#0A8F5B}
@media (prefers-color-scheme:dark){:root:not([data-theme=light]) #phone [style*="background:var(--lk)"]{color:var(--on)!important}}
:root[data-theme=dark] #phone [style*="background:var(--lk)"]{color:var(--on)!important}
</style>
<script>
/* v70: French + Kinyarwanda for Bank, Benefits, Shop, Loan, Invest, Ikimina and Cashback copy (rw strings: please have a native speaker review) */
(function(){
const D={
'Interest accrued through yesterday':['Intérêts cumulés jusqu’à hier','Inyungu kugeza ejo hashize'],
'Start your first savings goal':['Commencez votre premier objectif d’épargne','Tangira intego yawe ya mbere yo kuzigama'],
'A target and a date make saving easier':['Un objectif et une date facilitent l’épargne','Intego n’itariki bituma kuzigama byoroha'],
'Join an Ikimina circle':['Rejoindre un cercle Ikimina','Injira mu kimina'],
'Save in a rotating circle with people you trust':['Épargnez en cercle tournant avec des personnes de confiance','Zigama mu kimina hamwe n’abantu wizeye'],
'Try SACCO shares':['Essayer les parts SACCO','Gerageza imigabane ya SACCO'],
'Buy cooperative shares, earn a real dividend':['Achetez des parts de coopérative et gagnez un vrai dividende','Gura imigabane ya koperative, ubone inyungu nyayo'],
'Pockets':['Poches','Imifuka'],
'New savings goal':['Nouvel objectif d’épargne','Intego nshya yo kuzigama'],
'Set a target and save towards it':['Fixez un objectif et épargnez pour l’atteindre','Shyiraho intego maze uzigame ugana kuyigeraho'],
'Round-up saving':['Épargne par arrondi','Kuzigama uzengurutse'],
'Group accounts':['Comptes de groupe','Konti z’amatsinda'],
'Shared savings for family, church or cooperative groups':['Épargne partagée pour famille, église ou coopérative','Kuzigama hamwe mu muryango, itorero cyangwa koperative'],
'Join a rotating savings circle with people you trust':['Rejoignez un cercle d’épargne tournant avec des personnes de confiance','Injira mu kimina n’abantu wizeye'],
'SACCO shares':['Parts SACCO','Imigabane ya SACCO'],
'Investments':['Investissements','Ishoramari'],
'RSE stocks, bonds & fixed income, IPOs':['Actions RSE, obligations, revenu fixe et introductions en bourse','Imigabane ya RSE, impapuro mpeshamwenda n’izindi'],
'Personal, salary-backed, SME working capital':['Personnel, adossé au salaire, fonds de roulement PME','Inguzanyo bwite, ishingiye ku mushahara, igishoro cy’imishinga mito'],
'Input financing from your coffee cooperative':['Financement d’intrants via votre coopérative de café','Inkunga y’ibikoresho ivuye muri koperative y’ikawa'],
'Spent this period, mostly on food':['Dépensé sur la période, surtout en nourriture','Wakoresheje muri iki gihe, cyane cyane ku biribwa'],
'Free check, alternative data':['Vérification gratuite, données alternatives','Igenzura ry’ubuntu, amakuru atandukanye'],
'Your covered balance':['Votre solde couvert','Amafaranga yawe arinzwe'],
'Amounts, rates and names here are sample data.':['Les montants, taux et noms sont des données d’exemple.','Imibare, ibipimo n’amazina ni ingero gusa.'],
'Rewards earned':['Récompenses gagnées','Ibihembo wabonye'],
'Earn more':['Gagner plus','Ongera ubone'],
'Invite a friend':['Inviter un ami','Tumira inshuti'],
'Share a link, you both get a reward':['Partagez un lien, vous gagnez tous les deux','Sangiza link, mwembi muhabwe igihembo'],
'Daily challenge':['Défi du jour','Umukoro wa buri munsi'],
'A small task for a small reward':['Une petite tâche pour une petite récompense','Umukoro muto ku gihembo gito'],
'Card cashback':['Cashback carte','Cashback ya karita'],
'On every itunda card purchase':['Sur chaque achat avec la carte itunda','Kuri buri kugura ukoresheje karita ya itunda'],
'Offers for you':['Offres pour vous','Ibyo twakugeneye'],
'Kigali bus fares':['Tarifs des bus de Kigali','Ibiciro bya bisi i Kigali'],
'Points on every tap':['Des points à chaque passage','Amanota kuri buri gukoresha'],
'Offers are sample data.':['Les offres sont des données d’exemple.','Ibyatanzwe ni ingero gusa.'],
'Sample rewards':['Récompenses d’exemple','Ibihembo by’urugero'],
'Daily check-in':['Pointage quotidien','Kwiyandikisha buri munsi'],
'Spin the wheel':['Tourner la roue','Zunguza uruziga'],
'Share a deal':['Partager une offre','Sangiza ibyatanzwe'],
'Food':['Alimentation','Ibiribwa'],'Fashion':['Mode','Imideli'],'Electronics':['Électronique','Ibikoresho by’ikoranabuhanga'],'Home':['Maison','Mu rugo'],
'Products, prices and merchants are sample data.':['Produits, prix et marchands sont des données d’exemple.','Ibicuruzwa, ibiciro n’abacuruzi ni ingero gusa.'],
'How much do you need?':['De combien avez-vous besoin ?','Ukeneye angahe?'],
'Repay over':['Remboursement sur','Kwishyura mu gihe cya'],
'Monthly instalment':['Mensualité','Ayo kwishyura buri kwezi'],
'Total to repay':['Total à rembourser','Yose yo kwishyura'],
'Rate (sample)':['Taux (exemple)','Igipimo (urugero)'],
'Total interest':['Total des intérêts','Inyungu zose'],
'Final payment':['Dernier paiement','Ubwishyu bwa nyuma'],
'Portfolio value':['Valeur du portefeuille','Agaciro k’ishoramari'],
'Rwanda Stock Exchange':['Bourse du Rwanda','Isoko ry’imigabane mu Rwanda'],
'Not held':['Non détenu','Nta na kimwe ufite'],
'Next to receive':['Prochain bénéficiaire','Uzakurikira guhabwa'],
'This round':['Ce tour','Uru ruzinduko'],
'Paid':['Payé','Yishyuwe'],
'Open group chat':['Ouvrir la discussion du groupe','Fungura ikiganiro cy’itsinda'],
'Sample group for this prototype.':['Groupe d’exemple pour ce prototype.','Itsinda ry’urugero muri iki kigereranyo.'],
'Earned this month':['Gagné ce mois-ci','Wabonye muri uku kwezi'],
'Recent cashback':['Cashback récent','Cashback ya vuba'],
'Get itunda card':['Obtenir la carte itunda','Fata karita ya itunda'],
'Yesterday':['Hier','Ejo hashize'],'Shopping':['Achats','Guhaha'],'Transit':['Transport','Ingendo']
};

const E2={
'School fees':['Frais de scolarité','Amafaranga y’ishuri'],'Emergency fund':['Fonds d’urgence','Amafaranga y’ihutirwa'],'Fill':['Alimenter','Uzuza'],
'Received · Yesterday':['Reçu · Hier','Wakiriye · Ejo hashize'],'Paid · Tuesday':['Payé · Mardi','Yishyuwe · Ku wa kabiri'],
'My assets':['Mes actifs','Umutungo wanjye'],'Accounts, loans, RSE holdings, cards, points':['Comptes, prêts, titres RSE, cartes, points','Konti, inguzanyo, imigabane ya RSE, amakarita, amanota'],
'App-controlled spend limits, one-tap freeze':['Plafonds de dépenses dans l’app, blocage en un geste','Ibigero by’ikoreshwa muri porogaramu, guhagarika ukoze rimwe'],
'Top up and tap to pay your Kigali bus fare':['Rechargez et payez votre bus de Kigali d’un geste','Shyiramo amafaranga wishyure bisi ya Kigali'],
'Category breakdown from your ledger':['Répartition par catégorie de vos opérations','Ibyiciro by’ibyo wakoresheje'],
'Group account':['Compte de groupe','Konti y’itsinda'],'Shared account with dues and split expenses':['Compte partagé avec cotisations et dépenses réparties','Konti isangiwe n’imisanzu n’ibiciro bigabanywa'],
'Family':['Famille','Umuryango'],'Link a guardian or child, view read-only spending':['Liez un tuteur ou un enfant, consultez les dépenses en lecture seule','Huza umubyeyi cyangwa umwana, urebe ibyo bakoresheje gusa'],
'Foreign currency':['Devises étrangères','Amafaranga y’amahanga'],'Hold and convert USD, EUR, GBP':['Détenez et convertissez USD, EUR, GBP','Bika uhindure USD, EUR, GBP'],
'Subscriptions':['Abonnements','Kwiyandikisha buri gihe'],'Recurring payments and billing plans':['Paiements récurrents et plans de facturation','Kwishyura buri gihe n’ingengabihe'],
'Digital certificate':['Certificat numérique','Icyemezo cy’ikoranabuhanga'],'Sign agreements in itunda':['Signez des accords dans itunda','Sinya amasezerano muri itunda'],
'Auto-transfer':['Virement automatique','Kohereza byikora'],'Auto-transfer, split a bill':['Virement automatique, partage de facture','Kohereza byikora, gabanya fagitire'],
'Generate a payment request code':['Générer un code de demande de paiement','Kora kode isaba kwishyurwa'],'Auto top-up':['Recharge automatique','Kuzuza byikora'],
'Refill your account from a linked account':['Rechargez votre compte depuis un compte lié','Uzuza konti yawe uvuye kuri konti wahujije'],

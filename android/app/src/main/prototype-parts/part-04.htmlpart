['frCart','frQ','frM2'].forEach(n=>{const o=window[n];window[n]=function(){const r=o.apply(this,arguments);tog();return r}});
/* 3. one Accessibility button, the two switches move into a sheet */
const axr=(t,s,on,f)=>`<div style="display:flex;align-items:center;gap:12px;padding:14px 0"><div style="flex:1"><b>${t}</b><div class="mu" style="font-size:14px">${s}</div></div><button class="ftsw" role="switch" aria-checked="${!!on}" aria-label="${t}" onclick="${f}"></button></div>`;
window.frAxO=()=>{document.getElementById('layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" role="dialog" aria-label="Accessibility"><b style="font-size:22px;letter-spacing:-.4px">Accessibility</b>${axr('Voice guide','Reads each step aloud',FR.vo,'frAx(0)')}${axr('Larger text','Easier to read',FR.lt,'frAx(1)')}<button class="btn" style="margin-top:8px" onclick="closeSheet()">Done</button></div>`};

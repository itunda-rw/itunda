try{(()=>{
const _s=screens.mpsaved,M=S.mp;
const FD=['⭐ Favorites','📌 Want to go','🍽️ Lunch spots'];
const st=document.createElement('style');
st.textContent='#phone .nb.sf{padding:12px 20px 12px}#phone .nb button.on{background:var(--lk);color:#fff}#phone .sfe{padding:48px 20px;text-align:center;font-size:15px;color:var(--tt)}';
document.head.appendChild(st);
window.svF=k=>{M.sf=k;render('fade-none')};
screens.mpsaved=function(){
 const h=String(_s.apply(this,arguments)),T=document.createElement('div');T.innerHTML=h;
 const rows=[...T.querySelectorAll('.pl.tap')];if(!rows.length)return h;
 const fid=r=>((r.getAttribute('onclick')||'').match(/'([^']+)'/)||[])[1],fo=r=>(M.fd&&M.fd[fid(r)])||0;
 const cnt=[rows.length,0,0,0];rows.forEach(r=>cnt[fo(r)+1]++);
 const sf=M.sf||0;
 const chips=['All',...FD].map((x,k)=>`<button class="${k===sf?'on':''}" onclick="svF(${k})">${x} ${cnt[k]}</button>`).join('');
 rows.forEach(r=>{if(sf&&fo(r)!==sf-1)r.remove()});
 const hd=T.querySelector('.mh'),last=rows.filter(r=>T.contains(r)).pop();
 if(hd)hd.insertAdjacentHTML('afterend',`<div class="nb sf" aria-label="Folders">${chips}</div>`);

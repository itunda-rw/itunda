<style id="ez649s">
/* v649: Eats. "Arrives by" on the restaurant page lines up with the text above it; the side-and-drink rail in the cart lines up with its title and has room before Delivery time; the tracking page gets its order summary back and a delivery code. */
#phone .ez-arr{padding:0 24px;margin-top:4px!important}
#phone .ez-sg{padding-bottom:20px}
#phone .ez-sg .ez-rail{padding-left:0}
#phone .ez-dc{padding:20px 24px 0}

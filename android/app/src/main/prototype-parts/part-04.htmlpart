screens.place=function(){
 const h=String(_p.apply(this,arguments)),p=(window.POI||[]).find(z=>z.n===PL.n);
 if(M.exp||!p||p.c==='bus'||p.id==='drop')return h;
 const T=document.createElement('div');T.innerHTML=h;const mo=T.querySelector('.mo');if(!mo)return h;
 const food=p.c==='food'||p.c==='cafe',k=String(p.id).split('').reduce((a,c)=>a+c.charCodeAt(0),0);
 const kw=food?['Tasty','Good atmosphere','Friendly staff','Good value','Quiet']:['Easy to find','Friendly staff','Clean','Good value','Worth a visit'];
 const n=kw.map((x,i)=>[x,120+(k*(i+3))%190]).sort((a,b)=>b[1]-a[1]),mx=n[0][1],tot=n.reduce((a,x)=>a+x[1],0),m=(M.mem||{})[PL.n]||'';
 mo.insertAdjacentHTML('beforebegin',`<div class="kwd"><b>What visitors liked</b><small>${tot} votes · sample data</small>${n.map(x=>`<div class="kwr"><span>${x[0]}</span><u><i style="width:${Math.round(x[1]/mx*100)}%"></i></u><em>${x[1]}</em></div>`).join('')}</div><div class="mem"><b>My note</b><input maxlength="80" placeholder="Add a note only you can see" aria-label="My note" value="${esc(m)}" onchange="plMemo(this.value)"></div>`);
 return T.innerHTML};
screens.route=function(){
 const h=String(_r.apply(this,arguments));
 if((M.mode||'bus')!=='bus')return h;
 const T=document.createElement('div');T.innerHTML=h;const c=T.querySelector('.rcd.on');if(!c)return h;
 c.insertAdjacentHTML('afterend',`<div class="stp"><button class="t" onclick="rtStops()">${M.stp?'Hide':'Show'} ${STOPS.length} stops</button>${M.stp?`<div class="stl">${STOPS.map((s,i)=>`<div><b${i&&i<STOPS.length-1?' style="font-weight:600"':''}>${s}</b><small>${i?(i<STOPS.length-1?i*2+' min':'Get off · '+i*2+' min'):'Board'}</small></div>`).join('')}</div><div class="pad fine" style="padding:6px 0 0">Sample stops.</div>`:''}<div class="gof"><button class="${M.gof?'on':''}" onclick="rtGet()">🔔 Get-off alert</button><small>${M.gof?'On · we will tell you one stop before Nyabugogo':'Be told one stop before you get off'}</small></div></div>`);
 return T.innerHTML};
})()}catch(x){console.error('naver-v615',x)}

/* v616: Naver Maps / Naver Place. Place: (1) "Good for" chips like Naver's visit-purpose tags (Solo, Friends, Date, Work or Family, picked from the place's kind) with the share of visitors who chose each. (2) A revisit line like Naver's: "Revisit rate 41% · 3 in 10 come with friends". Both sit above "What visitors liked". Directions: (3) Car routes get "Parking near" like Naver's destination parking: the nearest lot, distance, price and free spaces now. (4) Bike routes get "Bike stations": the nearest pick-up station with bikes free, and the drop-off station with docks free. English only; shares, lots and stations are sample data. */
try{(()=>{
const _p=screens.place,_r=screens.route,M=S.mp;
const st=document.createElement('style');
st.textContent='#phone .gfr{display:flex;flex-wrap:wrap;gap:8px;margin:16px 20px 0}#phone .gfr b{width:100%;font-size:16px}#phone .gfr span{height:32px;line-height:32px;border-radius:16px;padding:0 12px;background:var(--chip);font-size:13px;font-weight:700}#phone .gfr em{font-style:normal;color:var(--lk);margin-left:4px}#phone .rvt{margin:10px 20px 0;font-size:14px;color:var(--mu)}#phone .nrb{margin:12px 20px 0;padding:12px 14px;border-radius:14px;background:var(--chip);font-size:14px;line-height:20px}#phone .nrb b{display:block;font-size:15px}#phone .nrb small{color:var(--mu)}';

{const css=document.createElement('style');
css.textContent='.cta .btn,.fta,.ftq button,.ftm,.fpk,.fadd button{transition:transform .12s}.cta .btn:active,.fta:active,.ftq button:active,.ftm:active,.fpk:active,.fadd button:active{transform:scale(.97)}.fadd{display:flex;gap:8px;overflow-x:auto;scrollbar-width:none}.fadd::-webkit-scrollbar{display:none}.fadd button{flex:none;height:40px;padding:0 14px;border:0;border-radius:20px;background:var(--chip);color:var(--tx);font:inherit;font-size:14px;font-weight:700}@media(prefers-reduced-motion:reduce){.cta .btn,.fta,.ftq button,.ftm,.fpk,.fadd button{transition:none}}';

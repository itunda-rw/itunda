#phone .ez-pp{margin:26px 0 0}
#phone .ez-pp h3{margin:0 24px 6px;font-size:18px;font-weight:800}
#phone .ez-pp .stk{padding-left:24px;padding-right:24px}
#phone .ez-bx{margin:26px 24px 0}
#phone .ez-bx h3{margin:0 0 12px;font-size:18px;font-weight:800}

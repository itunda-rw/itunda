/* v663: itunda 증권, round 6. Stock page: an "Investment metrics" block (P/E, P/B, ROE, dividend yield) as four tiles, each with a one-line plain meaning ("Price vs yearly profit"), like Toss's 투자 지표. Sample numbers, steady per stock. */
const I=S.inv,T=(e,f)=>({en:e,fr:f||e,rw:e}[S.lang]||e);
const hash=s=>{let h=2166136261;for(let i=0;i<s.length;i++){h^=s.charCodeAt(i);h=Math.imul(h,16777619)}return h>>>0};
const st=tk=>STK.find(x=>x[0]===tk);
const dom=h=>{const d=document.createElement('div');d.innerHTML=h;return d};
const _sk=screens.stock;
if(_sk)screens.stock=function(){let h=String(_sk.apply(this,arguments));try{
 const tk=I.sk,s=st(tk);if(!s||h.indexOf('ez-mt')>=0)return h;
 const g=k=>hash(tk+k),pe=(6+g('pe')%140/10).toFixed(1),pb=(0.6+g('pb')%25/10).toFixed(1),roe=(7+g('roe')%160/10).toFixed(1),dy=(2+g('dy')%70/10).toFixed(1);
 const t=[[T('P/E','PER'),pe+'x',T('Price vs yearly profit','Cours vs bénéfice annuel')],[T('P/B','PBR'),pb+'x',T('Price vs company assets','Cours vs actifs')],[T('ROE','ROE'),roe+'%',T('Profit made from owners’ money','Profit sur fonds propres')],[T('Dividend yield','Rendement'),dy+'%',T('Yearly dividend vs price','Dividende annuel vs cours')]];
 const blk=`<div class="ez-mt"><h3>${T('Investment metrics','Indicateurs')}</h3><div class="sm mu">${T('Sample numbers','Chiffres d’exemple')}</div><div class="g">${t.map(x=>`<div><span>${x[0]}</span><b>${x[1]}</b><em>${x[2]}</em></div>`).join('')}</div></div>`;
 const R=dom(h),at=R.querySelector('.ez-vt')||R.querySelector('.ez-bx');if(!at)return h;
 at.insertAdjacentHTML('beforebegin',blk);return R.innerHTML}catch(e){console.error('ez663 stock',e);return h}};
})()}catch(x){console.error('v663',x)}
document.title=document.title.replace(/v\d+/,'v663');
</script>

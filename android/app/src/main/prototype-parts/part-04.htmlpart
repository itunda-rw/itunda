<script id="ez666">
try{(()=>{
if(typeof screens==='undefined'||typeof STK==='undefined'||!S.inv)return;
/* v666: itunda 증권, round 9. From the Toss 증권 research (financials shown as simple 5-year bars; the amount you are short is worked out for you). Stock page: a "Financials" block with a Revenue / Operating profit switch and five yearly bars, the latest one highlighted, plus a plain line on how it moved vs last year. Order sheet: when a buy costs more than your itunda Bank balance, the cost summary adds "You need N RWF more in itunda Bank". Sample numbers. */
const I=S.inv,T=(e,f)=>({en:e,fr:f||e,rw:e}[S.lang]||e);
const hash=s=>{let h=2166136261;for(let i=0;i<s.length;i++){h^=s.charCodeAt(i);h=Math.imul(h,16777619)}return h>>>0};
const st=tk=>STK.find(x=>x[0]===tk);
const dom=h=>{const d=document.createElement('div');d.innerHTML=h;return d};
const nf=n=>Math.round(n).toLocaleString('en-US');
I.fz=I.fz||'rev';
window.ezFz=k=>{I.fz=k;render('fade-none')};
const series=(tk,k)=>{const b=60+hash(tk+'fb')%240;let v=b,out=[];for(let i=0;i<5;i++){out.push(v);v=v*(1+((hash(tk+k+i)%21)-6)/100)}
 return k==='op'?out.map((x,i)=>x*(0.12+(hash(tk+'m'+i)%10)/100)):out};
const _sk=screens.stock;
if(_sk)screens.stock=function(){let h=String(_sk.apply(this,arguments));try{
 const tk=I.sk,s=st(tk);if(!s||h.indexOf('ez-fn')>=0)return h;
 const a=series(tk,I.fz),mx=Math.max(...a),yr=[2022,2023,2024,2025,2026],ch=(a[4]/a[3]-1)*100;
 const lab=I.fz==='rev'?T('Revenue','Chiffre d’affaires'):T('Operating profit','Résultat d’exploitation');
 const blk=`<div class="ez-fn"><h3>${T('Financials','Résultats')}</h3><div class="tg"><button class="${I.fz==='rev'?'on':''}" onclick="ezFz('rev')">${T('Revenue','Chiffre d’affaires')}</button><button class="${I.fz==='op'?'on':''}" onclick="ezFz('op')">${T('Operating profit','Résultat d’exploitation')}</button></div><div class="bars">${a.map((x,i)=>`<div class="${i===4?'cur':''}"><em>${x.toFixed(0)}</em><i style="height:${Math.max(8,Math.round(x/mx*92))}px"></i></div>`).join('')}</div><div class="yr">${yr.map(y=>`<span>${y}</span>`).join('')}</div><div class="sum">${lab} ${ch>=0?T('rose','a progressé de'):T('fell','a reculé de')} <b class="${ch>=0?'up':'dn'}">${Math.abs(ch).toFixed(1)}%</b> ${T('vs last year','vs l’an dernier')} · <span class="mu">${T('RWF billion, sample numbers','milliards RWF, chiffres d’exemple')}</span></div></div>`;
 const R=dom(h),at=R.querySelector('.ez-dv')||R.querySelector('.ez-vt');if(!at)return h;
 at.insertAdjacentHTML('beforebegin',blk);return R.innerHTML}catch(e){console.error('ez666 stock',e);return h}};
/* order sheet: shortfall line */
const enh=()=>{try{
 const lay=document.getElementById('layer'),cs=lay&&lay.querySelector('.ez-cs');if(!cs||cs.querySelector('.ez-sf')){return}
 const t=I.tr;if(!t||t.side!=='buy')return;
 const p=(t.type==='limit'&&t.lim)?t.lim:st(t.tk)[2],q=Math.max(0,Number(t.q)||0),v=q*p,f=q?Math.max(100,Math.round(v*.004)):0,need=v+f-S.bank;
 if(q&&need>0)cs.insertAdjacentHTML('beforeend',`<div class="ez-sf" style="color:var(--er);font-weight:700;border-top:1px solid var(--ln)"><span style="color:var(--er)">${T('You need more in itunda Bank','Il manque dans itunda Bank')}</span><b>${nf(need)} RWF</b></div>`)}catch(e){console.error('ez666 sheet',e)}};
const lay=document.getElementById('layer');
if(lay)new MutationObserver(()=>enh()).observe(lay,{childList:true,subtree:true});
})()}catch(x){console.error('v666',x)}
document.title=document.title.replace(/v\d+/,'v666');
</script>
<style id="ez667s">
#phone .ez-tr{margin:22px 24px 0}
#phone .ez-tr h3{margin:0;font-size:18px;font-weight:800}
#phone .ez-tr svg{display:block;width:100%;height:120px;margin-top:12px}
#phone .ez-tr .tg{display:flex;gap:8px;margin-top:10px}
#phone .ez-tr .tg button{height:32px;padding:0 14px;border:0;border-radius:16px;background:var(--chip);color:var(--tx);font:inherit;font-size:13px;font-weight:700}
#phone .ez-tr .tg button.on{background:var(--tx);color:var(--bg)}
#phone .ez-tr .lg{display:flex;gap:16px;margin-top:12px;font-size:13px;color:var(--mu)}
#phone .ez-tr .lg i{display:inline-block;width:14px;height:0;border-top:3px solid;vertical-align:middle;margin-right:6px}
#phone .ez-tr .sm2{margin-top:8px;font-size:14px}
</style>
<script id="ez667">
try{(()=>{
if(typeof screens==='undefined'||typeof STK==='undefined'||!S.inv)return;
/* v667: itunda 증권, round 10. Toss 증권 added an "investment asset trend" (value vs. what you put in, over 1 week / 1 month / 3 months / 1 year). Portfolio: when you hold stocks, an "Asset trend" block with a two-line chart (your value, and the amount you put in as a dashed line), a 1W / 1M / 3M / 1Y switch, and one line saying how far the value is above or below what you put in. The chart is a sample history that always ends at today's real value. */
const I=S.inv,T=(e,f)=>({en:e,fr:f||e,rw:e}[S.lang]||e);
const hash=s=>{let h=2166136261;for(let i=0;i<s.length;i++){h^=s.charCodeAt(i);h=Math.imul(h,16777619)}return h>>>0};
const st=tk=>STK.find(x=>x[0]===tk);
const dom=h=>{const d=document.createElement('div');d.innerHTML=h;return d};
const nf=n=>Math.round(n).toLocaleString('en-US');
I.tp=I.tp||'1M';
window.ezTp=k=>{I.tp=k;render('fade-none')};
const _iv=screens.invest;
if(_iv)screens.invest=function(){let h=String(_iv.apply(this,arguments));try{
 if(I.tab!=='port'||h.indexOf('ez-tr')>=0)return h;
 const ks=Object.keys(S.hold||{}).filter(k=>S.hold[k]&&S.hold[k].q>0&&st(k));if(!ks.length)return h;
 let now=0,cost=0;ks.forEach(k=>{now+=S.hold[k].q*st(k)[2];cost+=S.hold[k].q*S.hold[k].avg});
 const P={'1W':[8,.02],'1M':[16,.05],'3M':[24,.09],'1Y':[32,.16]},[n,amp]=P[I.tp]||P['1M'],sd=hash(ks.join()+I.tp);
 const v=[];for(let i=0;i<n;i++){const f=(n-1-i)/(n-1),w=((hash(sd+'x'+i)%2001)/1000-1);v.push(i===n-1?now:now*(1-f*amp*(((sd%9)-3)/4)+w*amp*.18*Math.min(1,f*3)))}
 const lo=Math.min(...v,cost),hi=Math.max(...v,cost),Y=x=>10+(1-(x-lo)/((hi-lo)||1))*100,X=i=>i/(n-1)*300;
 const up=now>=cost,col=up?'var(--ok)':'var(--er)',d=now-cost,pc=cost?d/cost*100:0;
 const svg=`<svg viewBox="0 0 300 120" preserveAspectRatio="none" role="img" aria-label="${T('Asset trend','Évolution du patrimoine')}"><line x1="0" x2="300" y1="${Y(cost).toFixed(1)}" y2="${Y(cost).toFixed(1)}" stroke="var(--mu)" stroke-width="1.5" stroke-dasharray="4 4" vector-effect="non-scaling-stroke"/><polyline fill="none" stroke="${col}" stroke-width="2.5" stroke-linejoin="round" vector-effect="non-scaling-stroke" points="${v.map((x,i)=>X(i).toFixed(1)+','+Y(x).toFixed(1)).join(' ')}"/></svg>`;
 const blk=`<div class="ez-tr"><h3>${T('Asset trend','Évolution du patrimoine')}</h3>${svg}<div class="tg">${['1W','1M','3M','1Y'].map(k=>`<button class="${I.tp===k?'on':''}" onclick="ezTp('${k}')">${k}</button>`).join('')}</div><div class="lg"><span><i style="border-color:${col}"></i>${T('Value','Valeur')} ${nf(now)}</span><span><i style="border-color:var(--mu);border-top-style:dashed"></i>${T('Put in','Investi')} ${nf(cost)}</span></div><div class="sm2">${T('Your stocks are worth ','Vos actions valent ')}<b class="${up?'up':'dn'}">${nf(Math.abs(d))} RWF ${up?T('more','de plus'):T('less','de moins')} (${Math.abs(pc).toFixed(1)}%)</b> ${T('than you put in.','que ce que vous avez investi.')} <span class="mu">${T('Sample history','Historique d’exemple')}</span></div></div>`;
 const R=dom(h),td=R.querySelector('.ez-td');if(!td)return h;
 const box=td.closest('.pad')||td.parentElement;box.insertAdjacentHTML('afterend',blk);return R.innerHTML}catch(e){console.error('ez667 invest',e);return h}};
})()}catch(x){console.error('v667',x)}
document.title=document.title.replace(/v\d+/,'v667');
</script>
<style id="ez668s">
#phone .ez-gp{margin:24px 0 0}
#phone .ez-gp .hd{display:flex;justify-content:space-between;align-items:center;margin:0 24px}
#phone .ez-gp h3{margin:0;font-size:18px;font-weight:800}
#phone .ez-gp .hd button{border:0;background:none;color:var(--lk);font:inherit;font-weight:700;font-size:14px}
#phone .ez-gp .hint{margin:8px 24px 0;font-size:13px;color:var(--mu)}
#phone .ez-gp .g{display:flex;justify-content:space-between;align-items:center;padding:12px 24px;cursor:pointer}
#phone .ez-gp .g b{display:block;font-size:16px}
#phone .ez-gp .g small{display:block;font-size:13px;color:var(--mu);margin-top:2px}
#phone .ez-gp .g div:last-child{text-align:right}
.ez-gs input{width:100%;box-sizing:border-box;height:52px;border:0;border-radius:14px;background:var(--chip);color:var(--tx);font:inherit;font-size:16px;padding:0 16px;margin-top:12px}
.ez-gs .t{font-size:13px;color:var(--mu);font-weight:600;margin-top:16px}
</style>
<script id="ez668">
try{(()=>{
if(typeof screens==='undefined'||typeof STK==='undefined'||!S.inv)return;
/* v668: itunda 증권, round 11. Toss 증권 added "종목 묶어보기" (group your holdings your own way and see each group's return). Portfolio: a "My groups" block under the asset trend. "+ New group" opens a sheet: a name and the stocks you hold; each group row shows its value and return since you bought; tap a row to edit or delete it. Sample data. */
const I=S.inv,T=(e,f)=>({en:e,fr:f||e,rw:e}[S.lang]||e);
const st=tk=>STK.find(x=>x[0]===tk);
const dom=h=>{const d=document.createElement('div');d.innerHTML=h;return d};
const nf=n=>Math.round(n).toLocaleString('en-US');
const ea=s=>String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
I.grp=I.grp||[];I.gid=I.gid||1;
const held=()=>Object.keys(S.hold||{}).filter(k=>S.hold[k]&&S.hold[k].q>0&&st(k));
const stat=g=>{let v=0,c=0;g.tks.forEach(k=>{if(S.hold[k]&&S.hold[k].q>0&&st(k)){v+=S.hold[k].q*st(k)[2];c+=S.hold[k].q*S.hold[k].avg}});return{v,c,d:v-c,p:c?(v-c)/c*100:0}};
const drawG=()=>{const D=I.gd,lay=document.getElementById('layer');if(!lay)return;
 lay.innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet ez-gs"><div style="font-size:20px;font-weight:800">${D.id?T('Edit group','Modifier le groupe'):T('New group','Nouveau groupe')}</div><input id="ezgn" maxlength="20" value="${ea(D.name)}" placeholder="${T('Group name, like Long term','Nom du groupe, ex. Long terme')}" oninput="I_gname(this.value)" aria-label="${T('Group name','Nom du groupe')}"><div class="t">${T('Stocks you hold','Actions que vous détenez')}</div><div class="req" role="group" style="margin-top:8px">${held().map(k=>`<button class="${D.tks.includes(k)?'on':''}" aria-pressed="${D.tks.includes(k)}" onclick="ezGTk('${k}')">${k}</button>`).join('')}</div><button class="btn" style="margin-top:20px" onclick="ezGSave()">${T('Save','Enregistrer')}</button>${D.id?`<button class="btn sec2" style="margin-top:10px" onclick="ezGDel(${D.id})">${T('Delete group','Supprimer')}</button>`:''}</div>`};
window.I_gname=v=>{I.gd.name=v};
window.ezGNew=id=>{const g=id&&I.grp.find(x=>x.id===id);I.gd=g?{id:g.id,name:g.name,tks:g.tks.slice()}:{id:0,name:'',tks:[]};drawG()};
window.ezGTk=k=>{const a=I.gd.tks,i=a.indexOf(k);i<0?a.push(k):a.splice(i,1);drawG()};
window.ezGSave=()=>{const D=I.gd,n=(D.name||'').trim();if(!n||!D.tks.length){toast(T('Add a name and pick a stock','Ajoutez un nom et une action'));return}
 if(D.id){const g=I.grp.find(x=>x.id===D.id);if(g){g.name=n;g.tks=D.tks.slice()}}else I.grp.push({id:I.gid++,name:n,tks:D.tks.slice()});closeSheet();render('fade-none')};
window.ezGDel=id=>{I.grp=I.grp.filter(x=>x.id!==id);closeSheet();render('fade-none')};
const _iv=screens.invest;
if(_iv)screens.invest=function(){let h=String(_iv.apply(this,arguments));try{
 if(I.tab!=='port'||h.indexOf('ez-gp')>=0||!held().length)return h;
 const rows=I.grp.map(g=>{const s=stat(g);return `<div class="g" onclick="ezGNew(${g.id})" role="button" tabindex="0"><div><b>${ea(g.name)}</b><small>${g.tks.join(' · ')}</small></div><div><b>${nf(s.v)} RWF</b><small class="${s.d>=0?'up':'dn'}">${s.d>=0?'+':'−'}${nf(Math.abs(s.d))} (${(s.p>=0?'+':'−')+Math.abs(s.p).toFixed(1)}%)</small></div></div>`}).join('');
 const blk=`<div class="ez-gp"><div class="hd"><h3>${T('My groups','Mes groupes')}</h3><button onclick="ezGNew(0)">+ ${T('New group','Nouveau groupe')}</button></div>${rows||`<div class="hint">${T('Group your stocks your own way, like Long term or Dividends, and see how each group is doing.','Regroupez vos actions à votre façon, ex. Long terme ou Dividendes, et suivez chaque groupe.')}</div>`}</div>`;
 const R=dom(h),at=R.querySelector('.ez-tr')||R.querySelector('.ez-td');if(!at)return h;
 (at.classList.contains('ez-tr')?at:(at.closest('.pad')||at)).insertAdjacentHTML('afterend',blk);return R.innerHTML}catch(e){console.error('ez668 invest',e);return h}};
})()}catch(x){console.error('v668',x)}
document.title=document.title.replace(/v\d+/,'v668');
</script>
<style id="ez669s">
#phone .ez-gf{margin:22px 24px 0;padding:16px 18px;border-radius:20px;background:var(--chip);display:flex;align-items:center;justify-content:space-between;gap:12px}
#phone .ez-gf b{display:block;font-size:16px}
#phone .ez-gf small{display:block;font-size:13px;color:var(--mu);margin-top:2px}
#phone .ez-gf button{flex:none;height:40px;padding:0 16px;border:0;border-radius:20px;background:var(--tx);color:var(--bg);font:inherit;font-size:14px;font-weight:700}
#phone .ez-gl{margin:24px 0 0}
#phone .ez-gl h3{margin:0 24px 6px;font-size:18px;font-weight:800}
#phone .ez-gl .g{padding:12px 24px}
#phone .ez-gl .g b{display:block;font-size:16px}
#phone .ez-gl .g small{display:block;font-size:13px;color:var(--mu);margin-top:2px}
#phone .ez-gl .g .a{display:flex;gap:8px;margin-top:10px}
#phone .ez-gl .g .a button{height:34px;padding:0 14px;border:0;border-radius:17px;background:var(--chip);color:var(--tx);font:inherit;font-size:13px;font-weight:700}
.ez-gd .q{display:flex;align-items:center;justify-content:space-between;margin-top:16px}
.ez-gd .q div{display:flex;align-items:center;gap:14px}
.ez-gd .q button{width:38px;height:38px;border:0;border-radius:19px;background:var(--chip);color:var(--tx);font:inherit;font-size:20px;font-weight:700}
.ez-gd input{width:100%;box-sizing:border-box;height:52px;border:0;border-radius:14px;background:var(--chip);color:var(--tx);font:inherit;font-size:16px;padding:0 16px;margin-top:10px}
.ez-gd .t{font-size:13px;color:var(--mu);font-weight:600;margin-top:16px}
</style>
<script id="ez669">
try{(()=>{
if(typeof screens==='undefined'||typeof STK==='undefined'||!S.inv)return;
/* v669: itunda 증권, round 12. Toss 증권 lets you gift shares you hold to a friend (just a name and contact; they accept or decline, and a declined gift is cancelled). Stock page: when you hold the stock, a "Gift shares" card opens a sheet to pick a friend (or type a name) and how many shares; sending takes them out of your holding. Portfolio: a "Gifts you sent" list with a Waiting / Accepted / Declined status; for the demo, two buttons play the friend's answer, and a declined gift puts the shares back. A short note says gift tax rules may apply. Sample friends, no real transfer. */
const I=S.inv,T=(e,f)=>({en:e,fr:f||e,rw:e}[S.lang]||e);
const st=tk=>STK.find(x=>x[0]===tk);
const dom=h=>{const d=document.createElement('div');d.innerHTML=h;return d};
const ea=s=>String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const FR=['Aline M.','Eric N.','Grace U.'];
I.gifts=I.gifts||[];I.giid=I.giid||1;
const have=tk=>(S.hold&&S.hold[tk]&&S.hold[tk].q)||0;
const draw=()=>{const G=I.gf,lay=document.getElementById('layer');if(!lay)return;const mx=have(G.tk);
 lay.innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet ez-gd"><div style="font-size:20px;font-weight:800">${T('Gift ','Offrir ')}${G.tk}</div><div class="t">${T('Who is it for?','Pour qui ?')}</div><div class="req" role="group" style="margin-top:8px">${FR.map(n=>`<button class="${G.to===n?'on':''}" aria-pressed="${G.to===n}" onclick="ezGfTo('${n}')">${n}</button>`).join('')}</div><input value="${ea(FR.includes(G.to)?'':G.to)}" maxlength="24" placeholder="${T('Or type a name','Ou saisissez un nom')}" oninput="ezGfName(this.value)" aria-label="${T('Friend name','Nom de l’ami')}"><div class="q"><span>${T('Shares','Actions')} <span class="mu">(${T('you hold ','vous détenez ')}${mx})</span></span><div><button onclick="ezGfQ(-1)" aria-label="${T('Fewer','Moins')}">−</button><b style="min-width:20px;text-align:center">${G.q}</b><button onclick="ezGfQ(1)" aria-label="${T('More','Plus')}">+</button></div></div><div class="sm mu" style="margin-top:14px;line-height:20px">${T('Your friend can accept or decline. If they decline, the shares come back to you. Gift tax rules may apply, so check what applies to you.','Votre ami peut accepter ou refuser. En cas de refus, les actions vous reviennent. Des règles fiscales sur les dons peuvent s’appliquer.')}</div><button class="btn" style="margin-top:18px" onclick="ezGfSend()">${T('Send gift','Envoyer le cadeau')}</button></div>`};
window.ezGfOpen=tk=>{if(!have(tk))return;I.gf={tk,to:'',q:1};draw()};
window.ezGfTo=n=>{I.gf.to=n;draw()};
window.ezGfName=v=>{I.gf.to=v};
window.ezGfQ=d=>{I.gf.q=Math.max(1,Math.min(have(I.gf.tk),I.gf.q+d));draw()};
window.ezGfSend=()=>{const G=I.gf,to=(G.to||'').trim();if(!to){toast(T('Pick a friend or type a name','Choisissez un ami'));return}
 const q=Math.min(G.q,have(G.tk));if(q<1)return;S.hold[G.tk].q-=q;if(S.hold[G.tk].q<=0)delete S.hold[G.tk];
 I.gifts.unshift({id:I.giid++,tk:G.tk,q,to,st:'wait'});closeSheet();render('fade-none');toast(T('Gift sent to ','Cadeau envoyé à ')+to)};
window.ezGfAns=(id,ok)=>{const g=I.gifts.find(x=>x.id===id);if(!g||g.st!=='wait')return;
 if(ok)g.st='ok';else{g.st='no';if(S.hold[g.tk])S.hold[g.tk].q+=g.q;else S.hold[g.tk]={q:g.q,avg:st(g.tk)[2]}}render('fade-none')};
const _sk=screens.stock;
if(_sk)screens.stock=function(){let h=String(_sk.apply(this,arguments));try{
 const tk=I.sk;if(!tk||!st(tk)||!have(tk)||h.indexOf('ez-gf')>=0)return h;
 const R=dom(h),at=R.querySelector('.ez-vt')||R.querySelector('.ez-bx');if(!at)return h;
 at.insertAdjacentHTML('beforebegin',`<div class="ez-gf"><div><b>${T('Gift shares','Offrir des actions')}</b><small>${T('Send some of your ','Envoyez une partie de vos ')}${tk}${T(' to a friend',' à un ami')}</small></div><button onclick="ezGfOpen('${tk}')">${T('Gift','Offrir')}</button></div>`);return R.innerHTML}catch(e){console.error('ez669 stock',e);return h}};
const _iv=screens.invest;
if(_iv)screens.invest=function(){let h=String(_iv.apply(this,arguments));try{
 if(I.tab!=='port'||h.indexOf('ez-gl')>=0||!I.gifts.length)return h;
 const lab={wait:T('Waiting for an answer','En attente'),ok:T('Accepted','Accepté'),no:T('Declined, shares returned','Refusé, actions rendues')};
 const rows=I.gifts.map(g=>`<div class="g"><b>${g.q} ${g.tk} ${T('to','à')} ${ea(g.to)}</b><small>${lab[g.st]}</small>${g.st==='wait'?`<div class="a"><button onclick="ezGfAns(${g.id},1)">${T('Demo: accepted','Démo : accepté')}</button><button onclick="ezGfAns(${g.id},0)">${T('Demo: declined','Démo : refusé')}</button></div>`:''}</div>`).join('');
 const R=dom(h),at=R.querySelector('.ez-gp')||R.querySelector('.ez-tr');if(!at)return h;
 at.insertAdjacentHTML('afterend',`<div class="ez-gl"><h3>${T('Gifts you sent','Cadeaux envoyés')}</h3>${rows}</div>`);return R.innerHTML}catch(e){console.error('ez669 invest',e);return h}};
})()}catch(x){console.error('v669',x)}
document.title=document.title.replace(/v\d+/,'v669');
</script>
<style id="ez670">
/* v670: Eats. The "Popular this week" rail had collapsed (cards drawn on top of each other) because the stocks list reuses the class name ez-rk with a 16px width. Restaurant page: the free-delivery banner repeated "Fee Free" from the line above, Group order sat in a bordered box, and the menu chips were black pills. Restaurant names in the grid are no longer cut to one line. */
#phone .ez-rail>.ez-rk{width:148px;flex:none;font-size:inherit;font-weight:inherit;color:inherit;text-align:left}
#phone .ez-rail>.ez-rk>.ez-c{width:100%}
#phone .ez-rail>.ez-rk>b{left:8px;top:2px}
#phone .e2-pm:not(.tap){display:none}
#phone .e2-sh>div>button.tap{border:0!important;box-shadow:none!important;background:none!important;border-radius:0!important;padding-left:0!important;padding-right:0!important}
#phone .e2-sc button.on{background:var(--tint)!important;color:var(--tintfg)!important}
#phone .ez-g .ez-n{white-space:normal;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;text-overflow:clip;line-height:20px}
</style>

<style id="ez671">
/* v671: Book a viewing, quiet. Before: two rows of grey chips (the chosen one barely different), the time row cut off at the edge, a summary line and a button saying the same thing twice. Now: two plain questions (Which day?, What time?) as rows with a check on the chosen one, and one button that names the slot. */
#phone .ezv-q{font-size:15px;font-weight:800;margin:26px 0 4px}
#phone .ezv-r{display:flex;align-items:center;justify-content:space-between;width:100%;min-height:52px;border:0;background:none!important;box-shadow:none;border-radius:0;padding:0;font:inherit;font-size:17px;color:var(--mu);text-align:left;cursor:pointer}
#phone .ezv-r.on{color:var(--tx);font-weight:800}
#phone .ezv-r svg{width:22px;height:22px;color:var(--lk);fill:none;stroke:currentColor;stroke-width:2.4;stroke-linecap:round;stroke-linejoin:round}
#phone .ezv-n{font-size:13px;line-height:19px;color:var(--mu);text-align:center;margin-top:10px}
/* v671: the three stacked grey toggle bars on List a home, Post a job and the Marketplace radius become plain rows with a check; Perks chips become check rows too. */
#phone .dg-sg{display:block;background:none;border-radius:0;padding:0;margin-top:2px}
#phone .dg-sg button{display:flex;align-items:center;justify-content:space-between;width:100%;height:auto;min-height:44px;padding:0;border:0;border-radius:0;background:none!important;box-shadow:none!important;color:var(--mu);font-size:17px;font-weight:400;text-align:left}
#phone .dg-sg button.on{color:var(--tx);font-weight:800}
#phone .dg-sg button.on::after,#phone #layer .v6b>div[style*="flex-wrap:wrap"]>.cch.on::after{content:"";flex:none;width:16px;height:9px;border-left:2.5px solid var(--lk);border-bottom:2.5px solid var(--lk);transform:rotate(-45deg) translateY(-2px)}
#phone #layer .v6b>div[style*="flex-wrap:wrap"]:has(>.cch){display:block!important}
#phone #layer .v6b>div[style*="flex-wrap:wrap"]>.cch{display:flex;align-items:center;justify-content:space-between;width:100%;min-height:48px;padding:0!important;margin:0!important;border:0;border-radius:0;background:none!important;box-shadow:none!important;color:var(--mu);font-size:17px;font-weight:400;text-align:left}
#phone #layer .v6b>div[style*="flex-wrap:wrap"]>.cch.on{color:var(--tx);font-weight:800}
</style>
<script id="ez671s">
try{(()=>{
const CK='<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>';
const esc=s=>String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;');
const fix=()=>{
 if(S.lang!=='en')return;
 const sh=document.querySelector('#layer .sheet'),b=sh&&(sh.querySelector('.v6b')||null);if(!b||b.dataset.ez671)return;
 const g=b.querySelectorAll('.chp');if(g.length<2)return;
 const read=c=>[...c.querySelectorAll('button')].map(x=>({t:x.textContent.trim(),on:x.classList.contains('on'),f:x.getAttribute('onclick')}));
 const days=read(g[0]),times=read(g[1]);
 return T.innerHTML};
})()}catch(x){console.error('naver-v569',x)}
</script>
<script>
/* v570: Naver Maps domain 2, the Transit tab. A "Transit" chip on the map opens a screen with two tabs like Naver's: Nearby (each bus stop with its buses, minutes to arrival and how full the bus is) and Favorites (the buses you starred, so they are one tap away). Tap a row to open the stop; tap the star to favorite a bus. Sample arrivals change by the minute. English only. The old itunda Transit fare screen is unchanged. */
try{(()=>{
const M=S.mp,_mv=screens.mapview;
const LN={bus:[['305','Kimironko'],['102','Remera'],['21','Town']],bus2:[['311','Nyabugogo'],['305','Nyabugogo'],['17','Kacyiru']]};
const CR=['Seats available','Standing room','Crowded'],CC=['#2BA84A','#F5A524','#E5484D'];
const arr=(id,ln)=>{const sd=(id+ln).split('').reduce((a,c)=>a+c.charCodeAt(0),0),m=new Date().getMinutes();return{w:(m*3+sd)%12+1,k:(sd+(m>>2))%3}};
const st=document.createElement('style');
st.textContent='#phone .tr{display:flex;align-items:center;gap:10px;padding:12px 16px 12px 20px}#phone .tr .ln{flex:none;min-width:48px;height:32px;line-height:32px;text-align:center;border-radius:16px;background:var(--lk);color:#fff;font-weight:800;font-size:14px}#phone .tr div{flex:1;min-width:0}#phone .tr b{display:block;font-size:16px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}#phone .tr span{font-size:13px;color:var(--tt)}#phone .tr .mn{flex:none;text-align:right;font-size:16px;font-weight:800}#phone .trh{padding:16px 20px 4px;font-size:14px;font-weight:700;color:var(--tt)}#phone .tr .ib{width:36px;height:36px}';
document.head.appendChild(st);
window.trTab=k=>{M.trt=k;render('fade-none')};
window.trFav=(id,ln)=>{M.fv=M.fv||{};const k=id+'|'+ln;if(M.fv[k])delete M.fv[k];else M.fv[k]=1;toast(M.fv[k]?'Added to favorites':'Removed from favorites');render('fade-none')};
const row=(id,ln,to,stop,showStop)=>{const a=arr(id,ln),f=M.fv&&M.fv[id+'|'+ln];
 return `<div class="tr tap" onclick="mpOpenPoi('${id}')"><i class="ln" style="font-style:normal">${ln}</i><div><b>${showStop?stop:'to '+to}</b><span>${showStop?'to '+to+' · ':''}<span style="color:${CC[a.k]};font-weight:700">${CR[a.k]}</span></span></div><span class="mn">${a.w<2?'Soon':a.w+' min'}</span><button class="ib" aria-label="${f?'Remove from favorites':'Add to favorites'}" onclick="event.stopPropagation();trFav('${id}','${ln}')">${ic('star',22,f?'#F5B301':'#B8BFCA')}</button></div>`};
screens.mptransit=()=>{
 const t=M.trt||0,stops=POI.filter(p=>p.c==='bus'&&LN[p.id]);
 let body='';
 if(!t)body=stops.map(p=>`<div class="trh">${p.n}</div>`+LN[p.id].map(l=>row(p.id,l[0],l[1],p.n,false)).join('')).join('');
 else{const f=[];stops.forEach(p=>LN[p.id].forEach(l=>{if(M.fv&&M.fv[p.id+'|'+l[0]])f.push(row(p.id,l[0],l[1],p.n,true))}));
  body=f.length?f.join(''):'<div style="padding:56px 24px;text-align:center;color:var(--tt);font-size:15px;line-height:22px">No favorite buses yet.<br>Tap the star on a bus in Nearby to keep it here.</div>'}
 return `<div class="mh" style="padding-bottom:0"><button class="ib" aria-label="Back" onclick="back()">${ic('back',24)}</button><b style="flex:1;font-size:19px;margin-left:6px">Transit</b></div><div class="nb sf" role="tablist">${['Nearby','Favorites'].map((x,k)=>`<button role="tab" aria-selected="${k===t}" class="${k===t?'on':''}" onclick="trTab(${k})">${x}</button>`).join('')}</div>${body}`};
screens.mapview=function(){
 const h=String(_mv.apply(this,arguments)),T=document.createElement('div');T.innerHTML=h;
 const b=T.querySelector('[onclick="mpCat(\'atm\')"]');if(!b||T.querySelector('[onclick="mpGo(\'mptransit\')"]'))return h;
 const c=b.cloneNode(true);c.setAttribute('onclick',"mpGo('mptransit')");c.textContent='🚍 Transit';c.className=b.className.replace(/\b(on|act\w*|sel\w*)\b/g,'').trim();
 b.after(c);return T.innerHTML};
})()}catch(x){console.error('naver-v570',x)}
</script>
<script>
/* v571: Naver Maps / Naver Place, Directions and Place. Directions (before: one route card at a time, the other routes were only reachable by a pill that cycled the sort): a row of sort tabs (Recommended, Fastest, Fewest transfers, Least walking) like Naver, and every route is a card in the list with its time, arrival, fare and leg bar; the chosen one is highlighted and opens its details, the others carry a tag (Fastest, Fewest transfers, Least walking). Tap a card to choose it. Places (before: the sheet went from the action pills straight to photos, and the map pin sheet offered a 127 min walk as its main trip): Naver's tab row under the pills (Home, Menu, Reviews, Photos, Nearby) opens the full page on that tab, and the Directions button on the map pin sheet shows the bus time when walking would take more than 25 minutes. English only; sample data. */
try{(()=>{
const M=S.mp,_r=screens.route,_pl=screens.place;
const st=document.createElement('style');
st.textContent='#phone .rst,#phone .nm-tb{display:flex;gap:6px;overflow-x:auto;scrollbar-width:none;padding:10px 16px 0}#phone .rst::-webkit-scrollbar,#phone .nm-tb::-webkit-scrollbar{display:none}#phone .rst button{flex:none;height:36px;padding:0 14px;border:0;border-radius:18px;background:var(--chip);color:var(--mu);font:inherit;font-weight:700;font-size:14px}#phone .rst button.on{background:var(--on,#17171C);color:#fff}#phone .nm-tb{padding:6px 20px 0;gap:0;border-bottom:1px solid var(--ln)}#phone .nm-tb button{flex:1;height:44px;border:0;border-bottom:2px solid transparent;background:none;color:var(--mu);font:inherit;font-weight:700;font-size:15px}#phone .nm-tb button:first-child{color:var(--tx);border-bottom-color:var(--tx)}#phone .alt{margin:10px 16px 0;padding:14px 16px;border:1px solid var(--ln);border-radius:16px;background:var(--bg);cursor:pointer}#phone .alt .a1{display:flex;align-items:baseline;gap:8px}#phone .alt .a1 b{font-size:20px;font-weight:800}#phone .alt .a1 span{font-size:13px;color:var(--mu)}#phone .alt .a1 em{margin-left:auto;font-style:normal;font-size:14px;font-weight:700}#phone .alt .tg{display:inline-block;margin-bottom:6px;font-size:12px;font-weight:800;color:var(--tintfg);background:var(--tint);border-radius:10px;padding:2px 8px}#phone .alt .rbr{display:flex;gap:2px;height:22px;margin-top:10px;border-radius:6px;overflow:hidden}#phone .alt .rbr i{font-style:normal;color:#fff;text-align:center;font-size:12px;line-height:22px;font-weight:800;overflow:hidden;white-space:nowrap}';
document.head.appendChild(st);
const SO=['Recommended','Fastest','Fewest transfers','Least walking'];
const num=x=>parseInt(String(x).replace(/[^\d]/g,''),10)||0;
const mins=x=>{const m=/(?:(\d+)\s*h)?\s*(?:(\d+)\s*min)?/.exec(x)||[];return num(m[1]||0)*60+num(m[2]||0)};
const read=html=>{const t=document.createElement('div');t.innerHTML=html;const c=t.querySelector('.rcd.on'),r=c&&c.querySelector('.rt1');if(!r)return null;
 const bar=c.querySelector('.rbr'),seg=bar?[...bar.children]:[],walk=seg.filter(i=>/🚶/.test(i.textContent)).reduce((a,i)=>a+num(i.textContent),0);
 return{t:r.querySelector('b')?r.querySelector('b').textContent:'',a:r.querySelector('span')?r.querySelector('span').textContent:'',f:r.querySelector('em')?r.querySelector('em').textContent:'',bar:bar?bar.outerHTML:'',m:mins(r.querySelector('b')?r.querySelector('b').textContent:''),w:walk,x:Math.max(0,seg.filter(i=>!/🚶/.test(i.textContent)).length-1),k:r.textContent}};
screens.route=function(){
 const h=String(_r.apply(this,arguments));
 try{
  const T=document.createElement('div');T.innerHTML=h;
  const dpp=T.querySelector('.dpp'),sel=T.querySelector('.rsh .rcd.on');
  if(!dpp||!sel)return h;
  const bus=(M.mode||'bus')==='bus',so=M.so||0;
  if(bus){if(dpp.children[1])dpp.children[1].remove();
   dpp.insertAdjacentHTML('afterend',`<div class="rst" role="tablist">${SO.map((x,i)=>`<button role="tab" aria-selected="${i===so}" class="${i===so?'on':''}" onclick="M.opt=0;mpSet('so',${i})">${x}</button>`).join('')}</div>`)}
  const all=[];
  if(all.length>1){
   const mn=(k,f)=>{const v=Math.min(...all.map(f));return all.filter(d=>f(d)===v).length===1?all.find(d=>f(d)===v):null};
   const tg=new Map([[mn('m',d=>d.m),'⚡ Fastest'],[mn('x',d=>d.x),'↔ Fewest transfers'],[mn('w',d=>d.w),'🚶 Least walking']]);
   const chosen=(all.find(d=>d.i===Math.min(cur,all[all.length-1].i))||all[0]).i;
   const card=d=>`<div class="alt" role="button" tabindex="0" onclick="M.opt=${d.i};render('fade-none')">${tg.get(d)?`<span class="tg">${tg.get(d)}</span>`:''}<div class="a1"><b>${d.t}</b><span>${d.a}</span><em>${d.f}</em></div>${d.bar}</div>`;
   const before=all.filter(d=>d.i<chosen),after=all.filter(d=>d.i>chosen);
   sel.insertAdjacentHTML('beforebegin',before.map(card).join(''));
   sel.insertAdjacentHTML('afterend',after.map(card).join(''))}
  return T.innerHTML
 }catch(x){console.error('route-v571',x);return h}};
screens.place=function(){
 const h=String(_pl.apply(this,arguments));
 try{
  const i=h.indexOf('<div class="nm-ph"');if(i<0||h.indexOf('nm-tb')>=0)return h;
  const p=(window.POI||[]).find(x=>x.n===PL.n),food=p&&/^(food|cafe)$/.test(p.c);
  const T=[['home','Home'],food?['menu','Menu']:null,['reviews','Reviews'],['photos','Photos'],['nearby','Nearby']].filter(Boolean);
  return h.slice(0,i)+`<div class="nm-tb" role="tablist">${T.map(([k,l])=>`<button role="tab" onclick="M.tab='${k}';mpExp(true)">${l}</button>`).join('')}</div>`+h.slice(i)
 }catch(x){console.error('place-v571',x);return h}};
const fix=()=>document.querySelectorAll('#phone button').forEach(b=>{
 if(b.dataset.v571||!/^Directions/.test(b.textContent.trim())||!/🚶/.test(b.textContent))return;
 const w=mins(b.textContent.replace(/^Directions\s*·?\s*/,'').replace('🚶','')),sh=b.closest('.sh2,.rsh,div[class*="sheet"]')||(b.parentElement&&b.parentElement.parentElement);
 if(w<=25||!sh)return;
 const c=[...sh.querySelectorAll('span,div,i')].find(x=>!x.children.length&&/^🚌\s*\d+/.test(x.textContent.trim()));
 if(!c)return;b.dataset.v571=1;b.innerHTML='Directions<span style="display:block;font-size:12px;font-weight:600;opacity:.85;line-height:15px">'+c.textContent.trim()+'</span>'});
new MutationObserver(fix).observe(document.getElementById('phone'),{childList:true,subtree:true});fix();
})()}catch(x){console.error('naver-v571',x)}
</script>
<script>
/* v572: Naver Maps domain 2, Transit tab, part 2. Tap a bus in Nearby or Favorites and a bus page opens like Naver's: the next three arrivals with how full each bus is, a "Get-on alert" switch (a bell then shows on that bus in the list), the stops along the line with the bus drawn where it is now, and a Directions button to the stop. English only; sample arrivals change by the minute. */
try{(()=>{
const M=S.mp,_t=screens.mptransit;if(!_t)return;
const CR=['Seats available','Standing room','Crowded'],CC=['#2BA84A','#F5A524','#E5484D'];
const arr=(id,ln)=>{const sd=(id+ln).split('').reduce((a,c)=>a+c.charCodeAt(0),0),m=new Date().getMinutes();return{w:(m*3+sd)%12+1,k:(sd+(m>>2))%3,sd}};
const STP=['Nyabugogo','Town Centre','Kigali Heights','Kacyiru','Remera','Kimironko Market'];
const st=document.createElement('style');
st.textContent='#phone .tl2{padding:8px 20px 0}#phone .tl2 .a{display:flex;align-items:center;gap:12px;padding:12px 0;border-bottom:1px solid var(--ln)}#phone .tl2 .a b{font-size:20px;font-weight:800;min-width:72px}#phone .tl2 .a span{font-size:14px;font-weight:700}#phone .tlb{display:flex;align-items:center;justify-content:space-between;margin:16px 20px 0;height:52px;padding:0 18px;border:1px solid var(--ln);border-radius:16px;font-weight:700;font-size:16px}#phone .tlb i{width:46px;height:28px;border-radius:14px;background:var(--ln);position:relative}#phone .tlb i:after{content:"";position:absolute;top:3px;left:3px;width:22px;height:22px;border-radius:11px;background:#fff;transition:left .2s}#phone .tlb.on i{background:var(--lk)}#phone .tlb.on i:after{left:21px}#phone .tls{margin:20px 20px 0;padding-left:22px;border-left:3px solid var(--ln)}#phone .tls div{position:relative;padding:9px 0;font-size:15px;color:var(--mu)}#phone .tls div:before{content:"";position:absolute;left:-29px;top:14px;width:9px;height:9px;border-radius:5px;background:var(--bg);border:2px solid var(--tt)}#phone .tls .me{color:var(--tx);font-weight:800}#phone .tls .me:before{background:var(--lk);border-color:var(--lk)}#phone .tls .bs{color:var(--lk);font-weight:800}#phone .tls .bs:before{content:"🚌";border:0;background:none;width:auto;height:auto;left:-36px;top:8px;font-size:14px}';
document.head.appendChild(st);
window.trOpen=(id,ln)=>{M.tl={id,ln};mpGo('mptline')};
window.trAl=()=>{const k=M.tl.id+'|'+M.tl.ln;M.al=M.al||{};if(M.al[k])delete M.al[k];else M.al[k]=1;toast(M.al[k]?'You will get a buzz 3 min before it arrives':'Alert off');render('fade-none')};
screens.mptline=()=>{
 const {id,ln}=M.tl||{id:'bus',ln:'305'},p=(window.POI||[]).find(x=>x.id===id)||{n:'Bus stop'},a=arr(id,ln),on=M.al&&M.al[id+'|'+ln];
 const ts=[a.w,a.w+7+a.sd%4,a.w+16+a.sd%5],ks=[a.k,(a.k+1)%3,(a.k+2)%3];
 const me=Math.min(4,1+a.sd%4),stops=STP.slice(0,5);stops[me]=p.n;
 const bus=Math.max(0,me-Math.max(1,Math.ceil(a.w/4)));
 const list=stops.map((s,i)=>(i===bus?`<div class="bs">Bus ${ln} · now</div>`:'')+`<div class="${i===me?'me':''}">${s}${i===me?' · your stop':''}</div>`).join('');
 return `<div class="mh" style="padding-bottom:0"><button class="ib" aria-label="Back" onclick="back()">${ic('back',24)}</button><b style="flex:1;font-size:19px;margin-left:6px">Bus ${ln}</b><button class="ib" aria-label="Directions to stop" onclick="mpArriveAt('${id}')">${ic('search',22)}</button></div><div style="padding:6px 20px 0"><div style="font-size:14px;color:var(--tt)">${p.n}</div></div><div class="tl2">${ts.map((w,i)=>`<div class="a"><b>${i?w+' min':(w<2?'Soon':w+' min')}</b><span style="color:${CC[ks[i]]}">${CR[ks[i]]}</span></div>`).join('')}</div><button class="tlb ${on?'on':''}" role="switch" aria-checked="${!!on}" onclick="trAl()">Get-on alert · 3 min before<i></i></button><div class="tls">${list}</div>`};
screens.mptransit=function(){
 const T=document.createElement('div');T.innerHTML=String(_t.apply(this,arguments));
 T.querySelectorAll('.tr').forEach(r=>{const m=/mpOpenPoi\('([^']+)'\)/.exec(r.getAttribute('onclick')||''),ln=r.querySelector('.ln');if(!m||!ln)return;
  const t=ln.textContent.trim();r.setAttribute('onclick',`trOpen('${m[1]}','${t}')`);
  if(M.al&&M.al[m[1]+'|'+t]){const b=r.querySelector('b');if(b)b.insertAdjacentText('beforeend',' 🔔')}});
 return T.innerHTML};
})()}catch(x){console.error('naver-v572',x)}
</script>
<script>
/* v573: Naver Maps domain 3, one search bar. The map search used to list only places. Now one bar finds places, bus stops and bus lines (by number or destination), in separate sections like Naver's combined search, with the matched letters highlighted. A bus line opens its bus page; a stop or place opens on the map. Anything that matches nothing says so. English only; sample lines. */
try{(()=>{
const M=S.mp,LN={bus:[['305','Kimironko'],['102','Remera'],['21','Town']],bus2:[['311','Nyabugogo'],['305','Nyabugogo'],['17','Kacyiru']]};
const esc=x=>String(x).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const st=document.createElement('style');
st.textContent='#phone .us mark{background:none;color:var(--lk);font-weight:800}#phone .us .trh{padding:18px 24px 4px}#phone .us .bl{display:flex;align-items:center;gap:12px;padding:10px 24px;cursor:pointer}#phone .us .bl i{flex:none;min-width:48px;height:32px;line-height:32px;text-align:center;border-radius:16px;background:var(--lk);color:#fff;font-style:normal;font-weight:800;font-size:14px}#phone .us .bl b{display:block;font-size:16px;font-weight:700}#phone .us .bl span{font-size:13px;color:var(--tt)}';
document.head.appendChild(st);
const hi=(t,ws)=>{let o=esc(t);ws.forEach(w=>{if(w)o=o.replace(new RegExp('('+w.replace(/[.*+?^${}()|[\]\\]/g,'\\$&')+')','ig'),'<mark>$1</mark>')});return o};
window.mpQ=v=>{
 const q=v.trim().toLowerCase(),el=document.getElementById('mpres'),rec=document.getElementById('mprec');if(!el)return;
 if(rec)rec.style.display=q?'none':'';if(!q){el.innerHTML='';return}
 const ws=q.split(/\s+/).map(esc),P=window.POI||[],all=t=>ws.every(w=>t.toLowerCase().includes(w));
 const places=P.filter(p=>p.c!=='bus'&&all(p.n+' '+(p.k||''))),stops=P.filter(p=>p.c==='bus'&&all(p.n+' '+(p.k||'')));
 const lines=[];P.filter(p=>p.c==='bus'&&LN[p.id]).forEach(p=>LN[p.id].forEach(l=>{if(all('bus '+l[0]+' '+l[1]+' '+p.n))lines.push([p,l])}));
 const sec=(h,rows,n)=>rows.length?`<div class="trh">${h} ${n}</div>`+rows.slice(0,4).join(''):'';
 const pr=p=>`<div class="pl tap" onclick="mpResult('${p.id}')"><i style="font-style:normal;font-size:20px">${p.e||'📍'}</i><div style="flex:1;min-width:0"><b style="display:block;font-size:17px;font-weight:600">${hi(p.n,ws)}</b><span>${esc(p.k||'')} · ${esc(p.d||'')}</span></div></div>`;
 const lr=([p,l])=>`<div class="bl tap" onclick="trOpen('${p.id}','${l[0]}')"><i>${hi(l[0],ws)}</i><div><b>to ${hi(l[1],ws)}</b><span>from ${esc(p.n)}</span></div></div>`;
 const h=sec('Bus lines',lines.map(lr),lines.length)+sec('Places',places.map(pr),places.length)+sec('Bus stops',stops.map(pr),stops.length);
 el.innerHTML='<div class="us">'+(h||'<div class="pad mu" style="text-align:center;padding-top:30px">No results for “'+esc(v.trim())+'”<br><span class="sm">Try a place, a bus number or a stop</span></div>')+'</div>'};
})()}catch(x){console.error('naver-v573',x)}
</script>
<script>
/* v574: Naver Maps domain 4, Discover. A "Discover" chip on the map opens a page like Naver's Discover tab: category chips, "Trending now" (a ranked list with up and down arrows since the last hour), "Coupons nearby" with a Claim button that turns into Claimed, and "Picked for you" (open places with the best ratings). Tap a place to open it on the map. English only; ranks and coupons are sample data that shift by the hour. */
try{(()=>{
const M=S.mp,_mv=screens.mapview;
const CT=[['all','All'],['cafe','Cafe'],['food','Food'],['pharm','Pharmacy'],['hosp','Hospital']];
const hr=()=>new Date().getHours(),sd=s=>String(s).split('').reduce((a,c)=>a+c.charCodeAt(0),0);
const rv=p=>{const m=/\((\d+)\)/.exec(p.r||'');return m?+m[1]:0},rt=p=>parseFloat(p.r)||0;
const CP=[['10% off your order',10],['Free pastry with a drink',0],['RWF 1,000 off',1],['2 for 1 on weekdays',2]];
const st=document.createElement('style');
st.textContent='#phone .dc{display:flex;align-items:center;gap:12px;padding:11px 24px;cursor:pointer}#phone .dc .rk{flex:none;width:24px;font-size:18px;font-weight:800;color:var(--lk);text-align:center}#phone .dc .mv{flex:none;width:30px;font-size:12px;font-weight:800;text-align:right}#phone .dc b{display:block;font-size:16px;font-weight:700}#phone .dc span{font-size:13px;color:var(--tt)}#phone .dc div{flex:1;min-width:0}#phone .dh{padding:24px 24px 4px;font-size:18px;font-weight:800}#phone .cpn{display:flex;align-items:center;gap:12px;margin:8px 24px 0;padding:14px 16px;border:1px dashed var(--br);border-radius:16px;background:var(--tint)}#phone .cpn div{flex:1;min-width:0}#phone .cpn b{display:block;font-size:15px;font-weight:800;color:var(--tintfg)}#phone .cpn span{font-size:13px;color:var(--mu)}#phone .cpn button{flex:none;height:36px;padding:0 16px;border:0;border-radius:18px;background:var(--lk);color:#fff;font:inherit;font-weight:800;font-size:14px}#phone .cpn button.d{background:var(--chip);color:var(--tt)}';
document.head.appendChild(st);
window.dcCat=k=>{M.dc=k;render('fade-none')};
window.dcCp=id=>{M.cp=M.cp||{};M.cp[id]=1;toast('Coupon saved. Show it at the counter');render('fade-none')};
screens.mpdiscover=()=>{
 const k=M.dc||'all',P=(window.POI||[]).filter(p=>p.c!=='bus'&&p.c!=='atm'&&(k==='all'||p.c===k));
 const rank=[...P].sort((a,b)=>rv(b)+sd(b.id+hr())%40-rv(a)-sd(a.id+hr())%40).slice(0,5);
 const mv=p=>{const d=sd(p.id+hr())%5-2;return d>0?`<em style="font-style:normal;color:#E5484D">▲${d}</em>`:d<0?`<em style="font-style:normal;color:#3B82F6">▼${-d}</em>`:'<em style="font-style:normal;color:var(--tt)">–</em>'};
 const row=(p,i)=>`<div class="dc tap" onclick="mpOpenPoi('${p.id}')"><i class="rk" style="font-style:normal">${i+1}</i><div><b>${p.n}</b><span>${p.k||''}${p.r?' · ★ '+p.r:''} · ${p.d||''}</span></div><span class="mv">${mv(p)}</span></div>`;
 const food=P.filter(p=>/^(food|cafe)$/.test(p.c)).slice(0,3);
 const cp=food.map(p=>{const c=CP[sd(p.id)%4],got=M.cp&&M.cp[p.id];return `<div class="cpn"><div><b>${c[0]}</b><span>${p.n}</span></div><button class="${got?'d':''}" ${got?'disabled':''} onclick="dcCp('${p.id}')">${got?'Claimed':'Claim'}</button></div>`}).join('');
 const pick=P.filter(p=>!/closed/i.test(p.o||'')&&rt(p)>0).sort((a,b)=>rt(b)-rt(a)).slice(0,3);
 return `<div class="mh" style="padding-bottom:0"><button class="ib" aria-label="Back" onclick="back()">${ic('back',24)}</button><b style="flex:1;font-size:19px;margin-left:6px">Discover</b></div><div class="nb sf" style="padding-top:10px">${CT.map(([c,l])=>`<button class="${k===c?'on':''}" onclick="dcCat('${c}')">${l}</button>`).join('')}</div><div class="dh">Trending now</div>${rank.length?rank.map(row).join(''):'<div class="pad mu" style="padding:20px 24px">Nothing here yet</div>'}${cp?`<div class="dh">Coupons nearby</div>${cp}`:''}${pick.length?`<div class="dh">Picked for you</div>${pick.map((p,i)=>`<div class="dc tap" onclick="mpOpenPoi('${p.id}')"><i class="rk" style="font-style:normal;font-size:20px">${p.e||'📍'}</i><div><b>${p.n}</b><span>★ ${p.r} · ${(p.o||'').replace(/^Open · ?/,'Open ')}</span></div></div>`).join('')}`:''}<div style="height:24px"></div>`};
screens.mapview=function(){
 const h=String(_mv.apply(this,arguments)),T=document.createElement('div');T.innerHTML=h;
 const b=T.querySelector('[onclick="mpGo(\'mptransit\')"]')||T.querySelector('[onclick="mpCat(\'atm\')"]');
 if(!b||T.querySelector('[onclick="mpGo(\'mpdiscover\')"]'))return h;
 const c=b.cloneNode(true);c.setAttribute('onclick',"mpGo('mpdiscover')");c.textContent='🔥 Discover';c.className=b.className.replace(/\b(on|act\w*|sel\w*)\b/g,'').trim();
 b.after(c);return T.innerHTML};
})()}catch(x){console.error('naver-v574',x)}
</script>
<script>
/* v575: Naver Maps domain 5, Booking tab. A "Book" chip on the map opens one page for everything you have booked, like Naver's Booking tab: Your bookings (table reservations with Cancel, and places where you are in line with Leave line), Book now (open restaurants and cafes, each with Reserve and Get in line), and Recent orders from itunda Eats. Reserve opens the place so you pick the time and guests there. English only; sample places and orders. */
try{(()=>{
const M=S.mp,_mv=screens.mapview;
const st=document.createElement('style');
st.textContent='#phone .bk{display:flex;align-items:center;gap:12px;padding:12px 24px}#phone .bk>i{flex:none;width:44px;height:44px;border-radius:22px;background:var(--chip);display:flex;align-items:center;justify-content:center;font-style:normal;font-size:20px}#phone .bk div{flex:1;min-width:0}#phone .bk b{display:block;font-size:16px;font-weight:700}#phone .bk span{font-size:13px;color:var(--tt)}#phone .bk button{flex:none;height:36px;padding:0 14px;border:1px solid var(--ln);border-radius:18px;background:none;color:var(--tx);font:inherit;font-weight:700;font-size:13px}#phone .bk button.m{background:var(--lk);border-color:var(--lk);color:#fff}#phone .bk .bg{display:flex;gap:6px;flex:none}#phone .bkh{padding:22px 24px 4px;font-size:18px;font-weight:800}#phone .bke{padding:14px 24px;font-size:14px;color:var(--tt);line-height:20px}';
document.head.appendChild(st);
window.bkCancel=i=>{M.rsv.splice(i,1);toast('Reservation cancelled');render('fade-none')};
screens.mpbook=()=>{
 const P=window.POI||[],rs=(M.rsv||[]),qu=M.qu||{},ids=Object.keys(qu);
 const rrows=rs.map((r,i)=>`<div class="bk"><i>📅</i><div><b>${r.p}</b><span>${r.t} · ${r.n} ${r.n==1?'person':'people'}</span></div><button onclick="bkCancel(${i})">Cancel</button></div>`).join('');
 const qrows=ids.map(id=>{const p=P.find(x=>x.id===id);return p?`<div class="bk"><i>🚶</i><div><b>${p.n}</b><span>You are number ${qu[id]} · about ${qu[id]*5} min</span></div><button onclick="qLeave('${id}')">Leave line</button></div>`:''}).join('');
 const mine=rrows+qrows;
 const avail=P.filter(p=>/^(food|cafe)$/.test(p.c)&&!/closed/i.test(p.o||'')).slice(0,5);
 const brow=avail.map(p=>`<div class="bk"><i>${p.e||'🍽️'}</i><div><b>${p.n}</b><span>${p.k||''}${p.r?' · ★ '+p.r:''} · ${p.d||''}</span></div><div class="bg"><button onclick="mpOpenPoi('${p.id}')">Reserve</button>${qu[p.id]?'':`<button class="m" onclick="qJoin('${p.id}')">Get in line</button>`}</div></div>`).join('');
 const od=(S.orders||[]).slice(0,3).map(o=>`<div class="bk"><i>🥡</i><div><b>${o.k}</b><span>${o.s||''}</span></div><span style="font-weight:700;color:var(--tx)">${fmt(o.t)} RWF</span></div>`).join('');
 return `<div class="mh" style="padding-bottom:0"><button class="ib" aria-label="Back" onclick="back()">${ic('back',24)}</button><b style="flex:1;font-size:19px;margin-left:6px">Book</b></div><div class="bkh">Your bookings</div>${mine||'<div class="bke">Nothing booked yet. Reserve a table or get in line below.</div>'}<div class="bkh">Book now</div>${brow||'<div class="bke">No places are open right now.</div>'}${od?`<div class="bkh">Recent orders</div>${od}`:''}<div style="height:24px"></div>`};
screens.mapview=function(){
 const h=String(_mv.apply(this,arguments)),T=document.createElement('div');T.innerHTML=h;
 const b=T.querySelector('[onclick="mpGo(\'mpdiscover\')"]')||T.querySelector('[onclick="mpGo(\'mptransit\')"]')||T.querySelector('[onclick="mpCat(\'atm\')"]');
 if(!b||T.querySelector('[onclick="mpGo(\'mpbook\')"]'))return h;
 const c=b.cloneNode(true);c.setAttribute('onclick',"mpGo('mpbook')");c.textContent='📅 Book';c.className=b.className.replace(/\b(on|act\w*|sel\w*)\b/g,'').trim();
 b.after(c);return T.innerHTML};
})()}catch(x){console.error('naver-v575',x)}
</script>
<script>
/* v576: Naver Maps domain 6, MY. A "MY" chip on the map opens a page like Naver's MY tab: your name with counts (reviews, saved, bookings), a Notifications inbox built from what you did in Maps (reservations, places you are in line at, bus alerts, claimed coupons) with unread dots and Mark all read, Receipt check for recent Eats orders (a matched receipt marks the order Receipt verified, as Naver does for reviews), and My reviews with stars; tap one to open the place. English only; inbox items follow your own actions.*/
try{(()=>{
const M=S.mp,_mv=screens.mapview;
const st=document.createElement('style');
st.textContent='#phone .my{display:flex;align-items:center;gap:12px;padding:12px 24px}#phone .my>i{flex:none;width:40px;height:40px;border-radius:20px;background:var(--chip);display:flex;align-items:center;justify-content:center;font-style:normal;font-size:18px;position:relative}#phone .my>i.u:after{content:"";position:absolute;top:0;right:0;width:10px;height:10px;border-radius:5px;background:#E5484D;border:2px solid var(--bg)}#phone .my div{flex:1;min-width:0}#phone .my b{display:block;font-size:15px;font-weight:700}#phone .my span{font-size:13px;color:var(--tt)}#phone .my button{flex:none;height:34px;padding:0 14px;border:1px solid var(--ln);border-radius:17px;background:none;color:var(--tx);font:inherit;font-weight:700;font-size:13px}#phone .myh{display:flex;align-items:center;justify-content:space-between;padding:24px 24px 4px;font-size:18px;font-weight:800}#phone .myh a{font-size:14px;color:var(--lk);font-weight:700;cursor:pointer}#phone .mys{display:flex;margin:14px 24px 0;border:1px solid var(--ln);border-radius:16px}#phone .mys div{flex:1;text-align:center;padding:14px 0}#phone .mys b{display:block;font-size:20px;font-weight:800}#phone .mys span{font-size:12px;color:var(--tt)}#phone .mye{padding:12px 24px;font-size:14px;color:var(--tt)}';
document.head.appendChild(st);
window.myRead=()=>{M.nr=1;render('fade-none')};
window.myRcpt=i=>{M.rc=M.rc||{};M.rc[i]=1;toast('Receipt matched. Your review will show Receipt verified');render('fade-none')};
screens.mpmy=()=>{
 const P=window.POI||[],pn=id=>(P.find(x=>x.id===id)||{n:id}).n,u=M.nr?'':'u';
 const rv=[];Object.entries(M.myrev||{}).forEach(([id,a])=>a.forEach(r=>rv.push([id,r[0],r[1]])));
 const sv=P.filter(p=>p.id==='cafe'?!!M.star:!!(M.sv&&M.sv[p.id])).length,bk=(M.rsv||[]).length+Object.keys(M.qu||{}).length;
 const nt=[];
 (M.rsv||[]).slice(0,2).forEach(r=>nt.push(['📅','Table confirmed',r.p+' · '+r.t]));
 Object.entries(M.qu||{}).forEach(([id,n])=>nt.push(['🚶','You are in line',pn(id)+' · number '+n]));
 Object.keys(M.al||{}).forEach(k=>nt.push(['🔔','Bus alert is on','Bus '+k.split('|')[1]]));
 Object.keys(M.cp||{}).forEach(id=>nt.push(['🎟️','Coupon saved',pn(id)]));
 const ntr=nt.slice(0,5).map(n=>`<div class="my"><i class="${u}">${n[0]}</i><div><b>${n[1]}</b><span>${n[2]}</span></div></div>`).join('');
 const od=(S.orders||[]).slice(0,2).map((o,i)=>{const ok=M.rc&&M.rc[i];return `<div class="my"><i>🧾</i><div><b>${o.k}</b><span>${ok?'Receipt verified ✓':(o.s||'Recent order')}</span></div>${ok?'':`<button onclick="myRcpt(${i})">Check receipt</button>`}</div>`}).join('');
 const rr=rv.map(r=>`<div class="my tap" onclick="mpOpenPoi('${r[0]}')"><i>★</i><div><b>${pn(r[0])} <span style="color:#F5B301">${'★'.repeat(r[1])}</span></b><span>${String(r[2]||'No text').replace(/</g,'&lt;').slice(0,70)}</span></div></div>`).join('');
 return `<div class="mh" style="padding-bottom:0"><button class="ib" aria-label="Back" onclick="back()">${ic('back',24)}</button><b style="flex:1;font-size:19px;margin-left:6px">MY</b></div><div style="padding:8px 24px 0;font-size:22px;font-weight:800">${S.name||'Amina'}</div><div class="mys"><div><b>${rv.length}</b><span>Reviews</span></div><div><b>${sv}</b><span>Saved</span></div><div><b>${bk}</b><span>Bookings</span></div></div><div class="myh">Notifications${ntr&&!M.nr?'<a onclick="myRead()">Mark all read</a>':''}</div>${ntr||'<div class="mye">Nothing new. Reservations, queues and alerts show up here.</div>'}${od?`<div class="myh">Receipt check</div>${od}`:''}<div class="myh">My reviews</div>${rr||'<div class="mye">No reviews yet. Open a place and tap Write a review.</div>'}<div style="height:24px"></div>`};
screens.mapview=function(){
 const h=String(_mv.apply(this,arguments)),T=document.createElement('div');T.innerHTML=h;
 const b=T.querySelector('[onclick="mpGo(\'mpbook\')"]')||T.querySelector('[onclick="mpCat(\'atm\')"]');
 if(!b||T.querySelector('[onclick="mpGo(\'mpmy\')"]'))return h;
 const c=b.cloneNode(true);c.setAttribute('onclick',"mpGo('mpmy')");c.textContent='👤 MY';c.className=b.className.replace(/\b(on|act\w*|sel\w*)\b/g,'').trim();
 b.after(c);return T.innerHTML};
})()}catch(x){console.error('naver-v576',x)}
</script>
<script>
/* v577: MY, receipt check now reaches your reviews. Before (v576): "Check receipt" only marked the order. Now each matched receipt gives you one Receipt verified review: the MY page says so under Receipt check, the next review you post on any place carries a green "Receipt verified" tag (on the place's Reviews tab and in My reviews), and the credit is used up. English only. */
try{(()=>{
const M=S.mp,_rc=window.myRcpt,_wp=window.mpWrPost,_my=screens.mpmy,_pl=screens.place;
if(!_rc||!_wp)return;
window.myRcpt=function(i){if(M.rc&&M.rc[i])return;M.rcc=(M.rcc||0)+1;return _rc.apply(this,arguments)};
window.mpWrPost=function(){const id=M.wr&&M.wr.id,use=(M.rcc||0)>0,r=_wp.apply(this,arguments);
 if(use&&id&&M.myrev[id]&&M.myrev[id][0]){M.myrev[id][0][2]='v';M.rcc--;render('fade-none')}return r};
if(_my)screens.mpmy=function(){
 const T=document.createElement('div');T.innerHTML=String(_my.apply(this,arguments));
 try{const fl=[];Object.values(M.myrev||{}).forEach(a=>a.forEach(r=>fl.push(r[2]==='v')));
  const rows=[...T.querySelectorAll('.my.tap')];rows.forEach((r,i)=>{if(fl[i]){const s=r.querySelector('span:last-child');if(s)s.insertAdjacentHTML('beforebegin','<span style="color:#12803C;font-weight:800;font-size:12px">✓ Receipt verified</span><br>')}});
  const h=[...T.querySelectorAll('.myh')].find(x=>/^Receipt check/.test(x.textContent));
  if(h&&(M.rcc||0)>0)h.insertAdjacentHTML('afterend',`<div class="mye" style="color:#12803C;font-weight:700">${M.rcc} verified review${M.rcc>1?'s':''} ready. Write a review on any place and it gets the tag.</div>`)}catch(e){}
 return T.innerHTML};
screens.place=function(){let h=String(_pl.apply(this,arguments));
 try{const p=(window.POI||[]).find(x=>x.n===PL.n),a=p&&M.myrev&&M.myrev[p.id];
  if(a&&a.some(r=>r[2]==='v')){let i=0;h=h.replace(/<b>You<\/b>/g,m=>{const r=a[i++];return r&&r[2]==='v'?m+' <span style="color:#12803C;font-size:12px;font-weight:800">✓ Receipt verified</span>':m})}}catch(e){}
 return h};
})()}catch(x){console.error('naver-v577',x)}
</script>
<script>
/* v578: Naver Maps domain 7, Street view. The map already had Standard, Satellite and Terrain layers, so this adds Naver's street-level preview. A "Street view" pill on the place sheet opens a 360 degree scene you drag sideways to look around, with a compass reading (N, NE, E ...) and Forward / Back buttons that move you along the street (the buildings change each step). The shop with the place's name is in front of you when it opens. It is a drawn sample scene: real street photos are not in the prototype, and the page says so. English only. */
try{(()=>{
const M=S.mp,_pl=screens.place,W=1170,PAL=['#E8C9A0','#D9E2EC','#F2D7D5','#CFE5D3','#F6E3A8','#C9D3F2'];
const rnd=s=>{let a=s*7+13;return()=>{a=(a*9301+49297)%233280;return a/233280}};
const esc=x=>String(x).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const seedOf=s=>String(s).split('').reduce((a,c)=>a+c.charCodeAt(0),0);
const scene=(seed,name)=>{const r=rnd(seed);let x=0,o='';
 while(x<W){const w=Math.min(W-x,130+Math.floor(r()*70)),h=170+Math.floor(r()*140),c=PAL[Math.floor(r()*6)];
  o+=`<rect x="${x}" y="${400-h}" width="${w-6}" height="${h}" fill="${c}"/>`;
  for(let wy=400-h+20;wy<350;wy+=44)for(let wx=x+14;wx<x+w-34;wx+=36)o+=`<rect x="${wx}" y="${wy}" width="20" height="26" rx="3" fill="#7E97B0" opacity=".75"/>`;x+=w}
 o+=`<rect x="470" y="290" width="230" height="110" fill="#fff"/><rect x="470" y="290" width="230" height="40" fill="#6960F9"/><text x="585" y="317" text-anchor="middle" font-size="16" font-weight="800" fill="#fff" font-family="sans-serif">${esc(String(name).slice(0,17))}</text><rect x="500" y="345" width="70" height="55" fill="#BFD8F2"/><rect x="600" y="345" width="70" height="55" fill="#BFD8F2"/>`;
 [90,330,760,1000].forEach(t=>{o+=`<rect x="${t-4}" y="350" width="8" height="55" fill="#7A5A3A"/><circle cx="${t}" cy="335" r="34" fill="#4FA35A"/>`});
 return `<svg width="${W}" height="560" viewBox="0 0 ${W} 560" style="display:block;flex:none"><defs><linearGradient id="sk" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#9CC3EA"/><stop offset="1" stop-color="#E8F1FA"/></linearGradient></defs><rect width="${W}" height="400" fill="url(#sk)"/>${o}<rect y="400" width="${W}" height="30" fill="#B9BEC6"/><rect y="430" width="${W}" height="130" fill="#4A4F57"/>${[0,1,2,3,4,5,6,7].map(i=>`<rect x="${i*150+30}" y="500" width="80" height="6" fill="#F9FAFB"/>`).join('')}</svg>`};
const dir=o=>{const d=Math.round(((o+195-585)/W*360+360)%360),n=['N','NE','E','SE','S','SW','W','NW'][Math.round(d/45)%8];return n+' · '+d+'°'};
window.svDown=e=>{M.svd=e.clientX;e.currentTarget.setPointerCapture&&e.currentTarget.setPointerCapture(e.pointerId)};
window.svMove=e=>{if(M.svd==null)return;const dx=e.clientX-M.svd;M.svd=e.clientX;M.svo=(((M.svo==null?390:M.svo)-dx)%W+W)%W;const s=document.getElementById('svs'),h=document.getElementById('svh');if(s)s.style.transform=`translateX(${-M.svo}px)`;if(h)h.textContent='Facing '+dir(M.svo)};
window.svUp=()=>{M.svd=null};
window.svGo=d=>{M.svs=Math.max(0,Math.min(8,(M.svs||0)+d));render('fade-none')};
screens.mpsv=()=>{
 const n=PL.n||'Street',st=M.svs||0,o=M.svo==null?390:M.svo,sc=scene(seedOf(n)+st*31,n);
 return `<div class="mh" style="padding-bottom:0"><button class="ib" aria-label="Back" onclick="back()">${ic('back',24)}</button><b style="flex:1;font-size:19px;margin-left:6px;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">Street view · ${esc(n)}</b></div><div style="overflow:hidden;height:560px;margin-top:10px;touch-action:pan-y;cursor:grab" onpointerdown="svDown(event)" onpointermove="svMove(event)" onpointerup="svUp()" onpointercancel="svUp()" role="img" aria-label="Street view, drag sideways to look around"><div id="svs" style="display:flex;width:${W*2}px;transform:translateX(${-o}px)">${sc}${sc}</div></div><div style="padding:14px 24px 0"><div id="svh" style="font-size:16px;font-weight:800">Facing ${dir(o)}</div><div style="font-size:13px;color:var(--tt);margin-top:4px">Drag sideways to look around · Position ${st+1} of 9</div><div style="display:flex;gap:10px;margin-top:14px"><button class="btn sec2" style="flex:1;height:48px" ${st?'':'disabled'} onclick="svGo(-1)">↓ Back</button><button class="btn" style="flex:1;height:48px" ${st<8?'':'disabled'} onclick="svGo(1)">↑ Forward</button></div><div style="font-size:12px;color:var(--tt);margin-top:12px;line-height:17px">Sample scene. Real street photos are not in this prototype.</div></div>`};
screens.place=function(){let h=String(_pl.apply(this,arguments));
 try{if(h.indexOf('nm-p')>=0&&h.indexOf("mpGo('mpsv')")<0){const k=h.indexOf('🔗 Share</button>');if(k>=0){const a=h.lastIndexOf('<button',k);h=h.slice(0,a)+`<button onclick="M.svo=null;M.svs=0;mpGo('mpsv')">🛣️ Street view</button>`+h.slice(a)}}}catch(e){}
 return h};
})()}catch(x){console.error('naver-v578',x)}
</script>
<script>
/* v579: Naver Maps domain 8, weather on the map. Naver's map home shows the weather. Here a chip at the start of the map's filter row shows the real Kigali temperature and sky (from Open-Meteo, no key, refreshed every 30 min); tap it for the rain chance over the next two hours. On walking and bike routes a line under the time pills warns when rain is likely (50% or more) and suggests the bus. If the weather cannot be fetched (offline) nothing is shown. English only. */
try{(()=>{
const M=S.mp,_mv=screens.mapview,_r=screens.route;
const IC=c=>c===0?'☀️':c<=2?'🌤️':c===3?'☁️':c<=48?'🌫️':c<=67?'🌧️':c<=77?'❄️':c<=82?'🌦️':'⛈️';
const get=()=>{if(M.wxAt&&Date.now()-M.wxAt<18e5)return;M.wxAt=Date.now();
 fetch('https://api.open-meteo.com/v1/forecast?latitude=-1.944&longitude=30.061&current=temperature_2m,weather_code&hourly=precipitation_probability&forecast_hours=2&timezone=auto')
 .then(r=>r.json()).then(d=>{if(!d.current)return;M.wx={t:Math.round(d.current.temperature_2m),c:d.current.weather_code,p:Math.max(...((d.hourly&&d.hourly.precipitation_probability)||[0]))};
  const top=S.stack[S.stack.length-1];if(top==='mapview'||top==='route')render('fade-none')}).catch(()=>{M.wxAt=0})};
window.wxInfo=()=>{const w=M.wx;if(w)toast(`Kigali ${w.t}° · rain chance ${w.p}% in the next 2 hours`)};
screens.mapview=function(){
 get();const h=String(_mv.apply(this,arguments));if(!M.wx||h.indexOf('wxInfo')>=0)return h;
 const T=document.createElement('div');T.innerHTML=h;
 const b=T.querySelector('[onclick="mpCat(\'all\')"]')||T.querySelector('[onclick^="mpCat("]');if(!b)return h;
 const c=b.cloneNode(true);c.setAttribute('onclick','wxInfo()');c.textContent=IC(M.wx.c)+' '+M.wx.t+'°';c.className=b.className.replace(/\b(on|act\w*|sel\w*)\b/g,'').trim();
 b.before(c);return T.innerHTML};
if(_r)screens.route=function(){
 get();const h=String(_r.apply(this,arguments));
 try{const w=M.wx,m=M.mode||'bus';if(!w||w.p<50||(m!=='walk'&&m!=='bike'))return h;
  const T=document.createElement('div');T.innerHTML=h;const d=T.querySelector('.dpp');if(!d)return h;
  d.insertAdjacentHTML('afterend',`<div style="margin:8px 16px 0;padding:10px 14px;border-radius:12px;background:var(--tint);color:var(--tintfg);font-size:14px;font-weight:700">🌧️ Rain likely (${w.p}%). The bus may be drier.</div>`);return T.innerHTML}catch(e){return h}};
})()}catch(x){console.error('naver-v579',x)}
</script>
<script>
/* v580: test-pass fixes on v571-v579, found by running every new screen in a browser at 390 px. (1) The map's filter row is hidden by an old global rule, so the Transit, Discover, Book, MY and weather chips never showed; they now sit in their own row under the search bar. (2) Bus routes: the other routes were never listed (the options did not change with the old counter); they now come from the four sort choices, and tapping a card applies that sort. (3) Search: a bus number was invisible inside its badge when highlighted. (4) Bus page: the Get-on alert switch had no track colour. (5) Place tab row: "Reviews", "Photos" and "Nearby" wrapped onto two lines. (6) Book: names wrapped to four lines beside two buttons; the buttons now sit under the text. (7) Street view: the shop sign text ran off the sign. English only. */
try{(()=>{
const M=S.mp,_mv=screens.mapview;
const st=document.createElement('style');
st.textContent='#phone .us .bl i mark{color:#fff}#phone .tlb{background:var(--bg);width:calc(100% - 40px)}#phone .tlb i{background:#C9CED6}#phone .tlb.on i{background:var(--lk)}#phone .nm-tb{overflow-x:auto;scrollbar-width:none;padding:6px 12px 0}#phone .nm-tb::-webkit-scrollbar{display:none}#phone .nm-tb button{flex:none;white-space:nowrap;padding:0 12px;font-size:14px}#phone .bk{flex-wrap:wrap}#phone .bk>div:not(.bg){flex:1 1 0}#phone .bk .bg{flex:1 0 100%;padding-left:56px;margin-top:-4px}#phone .mpx{position:absolute;top:68px;left:0;right:0;z-index:6;display:flex;gap:8px;padding:0 12px;overflow-x:auto;scrollbar-width:none}#phone .mpx::-webkit-scrollbar{display:none}#phone .mpx button{flex:none;height:36px;padding:0 14px;border:0;border-radius:18px;background:var(--bg);color:var(--tx);font:inherit;font-weight:700;font-size:14px;box-shadow:0 1px 5px rgba(0,0,0,.2)}';
document.head.appendChild(st);
screens.mapview=function(){
 const h=String(_mv.apply(this,arguments)),T=document.createElement('div');T.innerHTML=h;
 try{const bs=[...T.querySelectorAll('.mvc button')].filter(b=>/wxInfo|mpGo\('(mptransit|mpdiscover|mpbook|mpmy)'\)/.test(b.getAttribute('onclick')||''));
  const bar=T.querySelector('.mvs');if(!bs.length||!bar||T.querySelector('.mpx'))return h;
  const row=document.createElement('div');row.className='mpx';
  bs.sort((a,b)=>(/wxInfo/.test(b.getAttribute('onclick'))?1:0)-(/wxInfo/.test(a.getAttribute('onclick'))?1:0));
  bs.forEach(b=>{b.removeAttribute('class');row.appendChild(b)});
  bar.after(row)}catch(e){return h}
 return T.innerHTML};
})()}catch(x){console.error('naver-v580',x)}
/* v580 also: the sample bus trip has one real route, so the route list now shows three sample routes built from it (Recommended, Fastest with a 311 and RWF 100 more, Least walking with a 102 and 4 min more). The sort tabs pick one (Recommended and Fewest transfers: the first, Fastest: the second, Least walking: the third) and tapping a card does the same. */
try{(()=>{
const M=S.mp,_r=screens.route,num=x=>parseInt(String(x).replace(/[^\d]/g,''),10)||0;
const f2=x=>String(Math.floor(x/60)%24).padStart(2,'0')+':'+String(x%60).padStart(2,'0');
const SOI=[0,1,0,2],SOT=[0,1,3];
screens.route=function(){
 const h=String(_r.apply(this,arguments));
 try{
  if((M.mode||'bus')!=='bus')return h;
  const T=document.createElement('div');T.innerHTML=h;
  const c=T.querySelector('.rsh .rcd.on');if(!c||T.querySelector('.alt'))return h;
  const r=c.querySelector('.rt1'),b=r&&r.querySelector('b'),sp=r&&r.querySelector('span'),em=r&&r.querySelector('em'),bar=c.querySelector('.rbr'),tag=c.querySelector('.rtag');
  const m=sp&&/(\d+):(\d+)/.exec(sp.textContent);if(!b||!m||!em||!bar)return h;
  const kids=[...bar.children],wk=kids.filter(i=>/🚶/.test(i.textContent)).map(i=>num(i.textContent)),bc=(kids.find(i=>!/🚶/.test(i.textContent))||{style:{}}).style.background||'#3B7D20';
  const t0=num(b.textContent),st=(+m[1])*60+(+m[2]),f0=num(em.textContent)||400,w=[wk[0]||5,wk[1]||6];
  const V=[{k:'✨ Recommended',t:t0,f:f0,w:w,ln:'305'},{k:'⚡ Fastest',t:Math.max(12,t0-5),f:f0+100,w:[Math.max(2,w[0]-2),Math.max(2,w[1]-3)],ln:'311'},{k:'🚶 Least walking',t:t0+4,f:f0,w:[2,2],ln:'102'}];
  const bh=v=>{const bt=Math.max(3,v.t-v.w[0]-v.w[1]),s=(f,bg,tx)=>`<i style="flex:${f} 1 0%;background:${bg};font-size:13px">${tx}</i>`;return `<div class="rbr">${s(v.w[0],'var(--tt)','🚶 '+v.w[0])}${s(bt,bc,v.ln+' · '+bt)}${s(v.w[1],'var(--tt)','🚶 '+v.w[1])}</div>`};
  const sel=SOI[M.so||0],v0=V[sel];
  b.textContent=v0.t+' min';sp.textContent=f2(st)+' → '+f2(st+v0.t);em.textContent=v0.f+' RWF';bar.outerHTML=bh(v0);if(tag)tag.textContent=v0.k;
  const card=(v,i)=>`<div class="alt" role="button" tabindex="0" onclick="M.opt=0;mpSet('so',${SOT[i]})"><span class="tg">${v.k}</span><div class="a1"><b>${v.t} min</b><span>${f2(st)} → ${f2(st+v.t)}</span><em>${v.f} RWF</em></div>${bh(v)}</div>`;
  c.insertAdjacentHTML('beforebegin',V.map((v,i)=>i<sel?card(v,i):'').join(''));
  c.insertAdjacentHTML('afterend',V.map((v,i)=>i>sel?card(v,i):'').join(''));
  return T.innerHTML
 }catch(e){return h}};
})()}catch(x){console.error('naver-v580b',x)}
</script>
<script>
/* v581: Naver Maps / Naver Place, Directions and Place. Directions: "Arrive by" like Naver's arrival-time option. Pick 3 clock times under the depart chips and the page says when to leave ("Leave at 2:25 pm to arrive by 3:00 pm"), from the chosen route's time; picking a depart chip clears it. Places: a "From the owner" notice card (Naver's owner notice) and "Also searched with" chips (Naver's related places) above "More about this place"; tap a chip to open that place. English only; notices are sample data. */
try{(()=>{
const _r=screens.route,_p=screens.place,M=S.mp,_s=window.mpSet;

#phone .ez-rail .ez-n{white-space:normal;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;text-overflow:clip;line-height:19px;min-height:38px}
#phone .nvc .ez655w{font-size:13px;font-weight:600;color:var(--mu);margin-top:3px}

#phone .chp.ez655n{flex-wrap:nowrap!important;gap:6px!important;overflow-x:auto;scrollbar-width:none}#phone .chp.ez655n button{padding:0 10px!important;font-size:14px!important;flex:none}#phone .chp button .ez655c{font-weight:600;color:var(--mu);margin-left:3px;font-size:12px}
#phone .ez655h .row .s{color:var(--mu)}
</style>
<script id="ez655">
try{(()=>{
if(typeof screens==='undefined'||typeof S==='undefined')return;
const T=(e,f,r)=>({en:e,fr:f,rw:r}[S.lang]||e);
const dom=h=>{const d=document.createElement('div');d.innerHTML=h;return d};
/* shared travel-time model: same pace as the route screen (bus 305 about 35 min for 10.6 km, car about 17 min) */
const MIN={bus:k=>Math.round(8+k*2.5),car:k=>Math.round(3+k*1.4),walk:k=>Math.max(1,Math.round(k*12)),bike:k=>Math.max(2,Math.round(k*4.5))};
const MODE_EN={bus:['by bus','en bus','muri bisi'],car:['by car','en voiture','mu modoka'],walk:['walk','à pied','n’amaguru'],bike:['by bike','à vélo','ku igare']};
const KM={'Nyamirambo Coffee House':10.6,'KG 7 Ave 22, Kacyiru':6.2,'Kimironko Market':0.9,'Kigali Heights Dental':6.8,'Kigali Heights, KG 7 Ave':6.8,'Home':6.2,'Work':6.8};
const mode=()=>((S.dh&&S.dh.mode)||'bus');
const eta=(k,m)=>{m=m||mode();return (MIN[m]||MIN.bus)(k)};
const fmtMin=n=>n>=60?Math.floor(n/60)+' h'+(n%60?' '+String(n%60).padStart(2,'0'):''):n+' min';

/* Directions hub: recent routes and Home / Work show the time for the mode you picked */
if(screens.dirhub){const _d=screens.dirhub;
screens.dirhub=function(){const h=String(_d.apply(this,arguments));try{
 if(h.indexOf('Recent routes')<0||h.indexOf('ez655')>=0)return h;
 const R=dom(h),m=mode();
 R.querySelectorAll('.pl.tap').forEach(r=>{
  const b=r.querySelector('b');if(!b||r.closest('.icx'))return;
  const nm=b.textContent.trim(),k=KM[nm];if(!k)return;
  const t=fmtMin(eta(k,m));
  let wrap=b.parentElement&&b.parentElement!==r?b.parentElement:null,sub=wrap&&wrap.querySelector('span');
  const old=((sub||r.querySelector('span')||{}).textContent||'').trim();
  const date=old.split(' · ').pop();
  if(!wrap){
   const sp=r.querySelector('span');
   wrap=document.createElement('div');wrap.style.cssText='flex:1;min-width:0';
   b.setAttribute('style','display:block;font-size:17px;font-weight:600');
   sub=document.createElement('span');sub.setAttribute('style','font-size:14px;color:var(--tt)');
   r.insertBefore(wrap,b);wrap.appendChild(b);wrap.appendChild(sub);if(sp)sp.remove()}
  sub.textContent=k+' km · '+t+' · '+date;sub.classList.add('ez655t')});
 R.querySelectorAll('.chp button').forEach(bt=>{
  const oc=bt.getAttribute('onclick')||'';
  const key=/'Home'/.test(oc)?'Home':/'Work'/.test(oc)?'Work':'';
  if(!key||bt.querySelector('.ez655c'))return;bt.parentElement.classList.add('ez655n');
  const s=document.createElement('span');s.className='ez655c';s.textContent='· '+fmtMin(eta(KM[key],m));bt.appendChild(s)});
 return R.innerHTML}catch(e){console.error('ez655 dirhub',e);return h}}}

/* Eats home: the address shows the neighbourhood without a cut-off, and the promo sub-line fits on one line */
if(screens.shop){const _s=screens.shop;
screens.shop=function(){let h=String(_s.apply(this,arguments));try{
 if(S.shopTab==='eats'){
  h=h.replace('<span>Kimironko, KG 11 Ave</span>','<span>Kimironko</span>').replace('<small>Code FREEDEL, applied at checkout</small>','<small>Code FREEDEL, auto-applied</small>')}
 return h}catch(e){return h}}}

/* Places hub: each card says how long it takes to get there (walk when close, drive when not) */
if(screens.placehub){const _p=screens.placehub;
screens.placehub=function(){const h=String(_p.apply(this,arguments));try{
 if(h.indexOf('class="nvc"')<0||h.indexOf('ez655w')>=0)return h;
 const R=dom(h);
 R.querySelectorAll('.nvc .s .mu').forEach(s=>{
  const m=s.textContent.match(/([\d.]+)\s*km/);if(!m)return;
  const k=parseFloat(m[1]);
  const w=k<=1.5?'🚶 '+T(fmtMin(eta(k,'walk'))+' walk',fmtMin(eta(k,'walk'))+' à pied',fmtMin(eta(k,'walk'))+' n’amaguru'):'🚗 '+T(fmtMin(eta(k,'car'))+' drive',fmtMin(eta(k,'car'))+' en voiture',fmtMin(eta(k,'car'))+' mu modoka');
  const row=s.parentElement;if(row)row.insertAdjacentHTML('afterend','<div class="ez655w">'+w+'</div>')});
 return R.innerHTML}catch(e){console.error('ez655 placehub',e);return h}}}

/* Home: one quiet block that links the three places-and-trips areas, with real numbers */
const _h=screens.home;
if(_h){screens.home=function(){const h=String(_h.apply(this,arguments));try{
 if(h.indexOf('ez655h')>=0)return h;
 const k='<div class="hc"><div class="hct"><span>Recent activity';
 const i=h.indexOf(k);if(i<0)return h;
 const rw=(ico,t,s,on)=>typeof row==='function'?row(ico,t,s,'',on):'';
 const blk='<div class="hc ez655h"><div class="hct"><span>'+T('Around you','Autour de vous','Hafi yawe')+'</span></div>'
  +rw('market',T('Kigali Roast','Kigali Roast','Kigali Roast'),T('Cafe · open till 20:00 · 3 min walk','Café · ouvert jusqu’à 20:00 · 3 min à pied','Cafe · ifunguye kugeza 20:00 · iminota 3 n’amaguru'),'openPlaces()')
  +rw('restaurant',T('Eats','Repas','Ibiryo'),T('Free delivery on your first order','Livraison offerte sur votre première commande','Kugezwaho ku buntu ku itegeko rya mbere'),"openShop('eats')")
  +rw('moto',T('Home','Domicile','Mu rugo'),T('About '+fmtMin(eta(KM.Home,'bus'))+' by bus · leave now','Environ '+fmtMin(eta(KM.Home,'bus'))+' en bus · partir maintenant','Hafi y’iminota '+eta(KM.Home,'bus')+' muri bisi · genda ubu'),"openDirections()")
  +'</div>';
 return h.slice(0,i)+blk+h.slice(i)}catch(e){console.error('ez655 home',e);return h}}}

})()}catch(x){console.error('v655',x)}
document.title=document.title.replace(/v\d+/,'v655');
</script>
<script id="ez656">
try{(()=>{
if(typeof screens==='undefined'||typeof S==='undefined'||!S.mp)return;
/* v656: Places and Directions, consistency pass. (1) Places hub: the picture tile on each card is the place's own emoji (Sweet Tooth Cakes showed a coffee cup, Fresh Press a stew pot). (2) Directions: a place within 1.5 km opens on Walk instead of Bus, unless you chose a mode in the Directions hub or on the route screen. (3) Recent routes in the Directions hub show the place's own emoji instead of the same target icon. Also in the v499 route builder (edited in place above): a walk, bike or car trip whose start and end sit next to the same road node now goes straight there instead of via that node, so a 0.2 km walk reads about 3 min on the route screen, like the "2 min walk" on the Places card, not 10 min. (v654's leave-later strip never ran because it tested a global M that does not exist; the Depart picker from v501 does that job, so it stays off.) */
const M=S.mp,P=()=>window.POI||[];
const dom=h=>{const d=document.createElement('div');d.innerHTML=h;return d};
const kmOf=p=>p?parseFloat(p.d)||0:0;

/* 1. Places hub: own emoji first */
if(screens.placehub){const _h=screens.placehub;
screens.placehub=function(){const h=String(_h.apply(this,arguments));try{
 if(h.indexOf('class="nvc"')<0)return h;
 const R=dom(h);
 R.querySelectorAll('.nvc').forEach(c=>{
  const id=((c.getAttribute('onclick')||'').match(/'([^']+)'/)||[])[1],p=P().find(x=>x.id===id),t=c.querySelector('.ph div');
  if(p&&p.e&&t)t.textContent=p.e});
 return R.innerHTML}catch(e){console.error('ez656 placehub',e);return h}}}

/* 2. Directions: short trips start on Walk */
if(typeof window.mpSet==='function'){const _s=window.mpSet;window.mpSet=(k,v)=>{if(k==='mode')M.mchosen=true;return _s(k,v)}}
const prep=id=>{try{
 const p=P().find(x=>x.id===id),k=kmOf(p);
 if(!p||!k||M.mchosen)return;
 M.mode=(S.dh&&S.dh.mode)||(k<=1.5?'walk':'bus')}catch(e){console.error('ez656 prep',e)}};
['mpDir','mpArriveAt'].forEach(n=>{const f=window[n];if(typeof f!=='function')return;
 window[n]=function(id){prep(id);return f.apply(this,arguments)}});
{const _b=window.back;if(typeof _b==='function')window.back=function(){try{if(S.stack&&S.stack[S.stack.length-1]==='route')M.mchosen=false}catch(e){}return _b.apply(this,arguments)}}

/* 3. Directions hub: recent routes show the place's own emoji */
if(screens.dirhub){const _d=screens.dirhub;
screens.dirhub=function(){const h=String(_d.apply(this,arguments));try{
 if(h.indexOf('Recent routes')<0)return h;
 const R=dom(h);
 R.querySelectorAll('.pl.tap').forEach(r=>{
  const ic=r.querySelector(':scope>i'),id=((r.getAttribute('onclick')||'').match(/dhGo\('([^']+)'/)||[])[1];if(!ic||!id)return;
  const p=P().find(x=>x.id===id);
  if(p&&p.e){ic.textContent=p.e;ic.style.fontSize='22px'}});
 return R.innerHTML}catch(e){console.error('ez656 dirhub',e);return h}}}
})()}catch(x){console.error('v656',x)}
/* v657: map pins sit where the distance label says. Every place's "x.x km" label (and the route screen built on it) disagreed with its pin on the real map: Kimironko Brochette said 6.3 km but its pin sat on top of you. Each pin keeps its direction from you and moves to label / 1.25 km straight-line; delivery places that had no pin get one. */
try{(()=>{
if(!window.POI)return;
const YOU=[-1.9488,30.127],r=Math.PI/180,kx=111.32*Math.cos(YOU[0]*r);
window.POI.forEach(p=>{if(p.__p657)return;p.__p657=1;
 const k=(parseFloat(p.d)||0)/1.25;if(!k)return;
 let dy=0,dx=0;
 if(Array.isArray(p.ll)){dy=(p.ll[0]-YOU[0])*111.32;dx=(p.ll[1]-YOU[1])*kx}
 let m=Math.hypot(dx,dy);
 if(m<.05){const h=String(p.id).split('').reduce((s,c)=>(s*31+c.charCodeAt(0))>>>0,7),b=(h%360)*r;dx=Math.sin(b);dy=Math.cos(b);m=1}
 p.ll=[YOU[0]+dy/m*k/111.32,YOU[1]+dx/m*k/kx]});
})()}catch(x){console.error('v657',x)}
/* v657: one travel-time model. Place page ("🚌 35 min" was scraped from an old fixed header) and Places cards (own pace) now use the same road-network routes as the Directions screen, so a place shows the same minutes everywhere. */
try{(()=>{
if(typeof screens==='undefined'||typeof window.__rt!=='function')return;
const T=(e,f,r)=>({en:e,fr:f,rw:r}[S.lang]||e);
const P=()=>window.POI||[];
const secs=(m,p)=>{try{const me=window.__ep('My location'),r=window.__rt(m,me,window.__ep(p.n))[0];return r&&r.secs}catch(e){return 0}};
const mn=s=>Math.max(1,Math.round(s/60)),fm=n=>n>=60?Math.floor(n/60)+' h '+(n%60)+' min':n+' min';
const _pl=screens.place;
if(_pl)screens.place=function(){const h=String(_pl.apply(this,arguments));try{
 const p=P().find(x=>x.n===PL.n);if(!p||p.c==='bus'||h.indexOf('\u{1F68C} ')<0)return h;
 const s=secs('bus',p);if(!s)return h;
 return h.replace(/(<span class="mu">[^<]*?)\u{1F68C} [^<]*?(<\/span>)/u,'$1\u{1F68C} '+fm(mn(s))+'$2')}catch(e){console.error('v657 place',e);return h}};
const _hb=screens.placehub;
if(_hb)screens.placehub=function(){const h=String(_hb.apply(this,arguments));try{
 if(h.indexOf('ez655w')<0)return h;
 const d=document.createElement('div');d.innerHTML=h;
 d.querySelectorAll('.nvc').forEach(c=>{
  const id=((c.getAttribute('onclick')||'').match(/'([^']+)'/)||[])[1],p=P().find(x=>x.id===id),w=c.querySelector('.ez655w');if(!p||!w)return;
  const k=parseFloat(p.d)||0,m=k<=1.5?'walk':'car',s=secs(m,p);if(!s)return;
  const t=fm(mn(s));
  w.textContent=m==='walk'?'\u{1F6B6} '+T(t+' walk',t+' à pied',t+' n’amaguru'):'\u{1F697} '+T(t+' drive',t+' en voiture',t+' mu modoka')});
 return d.innerHTML}catch(e){console.error('v657 hub',e);return h}};
})()}catch(x){console.error('v657b',x)}
document.title=document.title.replace(/v\d+/,'v657');
</script>
<style id="ez658s">
/* v658: itunda 증권, after Toss 증권 */
#phone .ez-rk{width:16px;flex:none;font-size:15px;font-weight:800;color:var(--lk);text-align:left}

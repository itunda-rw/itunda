<script id="ez665">
try{(()=>{
if(typeof screens==='undefined'||typeof STK==='undefined'||!S.inv)return;
/* v665: itunda 증권, round 8. After searching Toss 증권: its pitch is low, clearly stated costs, so the order sheet now shows the cost before you confirm: shares x price, the fee, and a total line ("You pay" when buying, "You receive" when selling). It updates as the share count changes. Sample fee, same 0.4% as the rest of Invest. */
const I=S.inv,T=(e,f)=>({en:e,fr:f||e,rw:e}[S.lang]||e);
const st=tk=>STK.find(x=>x[0]===tk);
const nf=n=>Math.round(n).toLocaleString('en-US');
const fee=v=>Math.max(100,Math.round(v*.004));
const enhance=()=>{try{
 const lay=document.getElementById('layer');if(!lay||lay.querySelector('.ez-cs'))return;
 const t=I.tr;if(!t||!lay.querySelector('#trq'))return;
 const at=lay.querySelector('.ez-am')||lay.querySelector('.ez-mx');if(!at)return;
 const q=Math.max(0,Number(t.q)||0),p=(t.type==='limit'&&t.lim)?t.lim:st(t.tk)[2],v=q*p,f=q?fee(v):0,buy=t.side==='buy';
 at.insertAdjacentHTML('afterend',`<div class="ez-cs"><div><span>${q} ${q===1?T('share','action'):T('shares','actions')} × ${nf(p)}</span><b>${nf(v)} RWF</b></div><div><span>${T('Fee (0.4%, min 100)','Frais (0,4 %, min 100)')}</span><b>${nf(f)} RWF</b></div><div class="t"><span>${buy?T('You pay','Vous payez'):T('You receive','Vous recevez')}</span><b>${nf(buy?v+f:Math.max(0,v-f))} RWF</b></div></div>`)}catch(e){console.error('ez665 sheet',e)}};
const lay=document.getElementById('layer');
if(lay)new MutationObserver(()=>{if(!lay.querySelector('.ez-cs'))enhance()}).observe(lay,{childList:true,subtree:true});
})()}catch(x){console.error('v665',x)}
document.title=document.title.replace(/v\d+/,'v665');
</script>

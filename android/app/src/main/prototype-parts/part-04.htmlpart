 const all=window.POI||[],o=all.filter(z=>z.id!==p.id),r=[0,1,2].map(j=>o[(k+j*3)%o.length]).filter((z,j,a)=>z&&a.indexOf(z)===j);
 mo.insertAdjacentHTML('beforebegin',`<div class="own"><small>📢 From the owner · ${1+k%5} days ago</small><div>${nt[k%2]}</div></div>${r.length?`<div class="als"><b>Also searched with</b><div>${r.map(z=>`<button onclick="mpResult('${z.id}')">${z.e||''} ${z.n}</button>`).join('')}</div></div>`:''}`);
 return T.innerHTML};
})()}catch(x){console.error('naver-v581',x)}
</script>
<script>
/* v582: Naver Maps / Naver Place. Directions: car routes get Naver's route-option tabs (Recommended, Fastest now, Shortest) that pick the matching route from the list, with a line under them on how it differs (minutes and km against Recommended). Places: a "News" block like Naver's place news, two dated posts from the owner under the notice, with a Like button that counts. English only; posts are sample data. */
try{(()=>{
const _r=screens.route,_p=screens.place,M=S.mp;
const st=document.createElement('style');
st.textContent='#phone .cro{display:flex;gap:8px;padding:10px 20px 0}#phone .cro button{height:34px;border:0;border-radius:17px;padding:0 13px;background:var(--chip);color:var(--tx);font:inherit;font-weight:700;font-size:13px}#phone .cro button.on{background:var(--lk);color:#fff}#phone .crl{padding:8px 20px 0;font-size:13px;color:var(--mu)}#phone .nws{margin:14px 20px 0}#phone .nws b{display:block;font-size:15px;margin-bottom:8px}#phone .nws div{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:12px 0;font-size:14px;line-height:20px}#phone .nws small{display:block;color:var(--mu);font-size:12px}#phone .nws button{flex:none;height:32px;border:0;border-radius:16px;padding:0 12px;background:var(--chip);color:var(--tx);font:inherit;font-weight:700;font-size:13px}#phone .nws button.on{background:var(--lk);color:#fff}';
document.head.appendChild(st);
window.crOpt=k=>{const L=(M._r&&M._r.list)||[];if(!L.length)return;let i=0;if(k===1)L.forEach((x,j)=>{if(x.secs<L[i].secs)i=j});if(k===2)L.forEach((x,j)=>{if(x.dist<L[i].dist)i=j});M.cro=k;M.opt=i;render('fade-none')};
window.nwLike=id=>{M.nl=M.nl||{};M.nl[id]=!M.nl[id];render('fade-none')};
screens.route=function(){
 const h=String(_r.apply(this,arguments));
 if((M.mode||'bus')!=='car'||!M._r||!M._r.list||M._r.list.length<2)return h;
 const T=document.createElement('div');T.innerHTML=h;const d=T.querySelector('.dpc');if(!d)return h;
 const Ls=M._r.list,a=Ls[0],c=Ls[Math.min(M.opt||0,Ls.length-1)],k=M.cro||0;
 const dm=Math.round((c.secs-a.secs)/60),dk=((c.dist-a.dist)/1000).toFixed(1);
 const ln=c===a?'Balanced time and distance. No tolls on this trip.':(dm<0?Math.abs(dm)+' min faster':dm>0?dm+' min slower':'Same time')+' · '+(dk<0?Math.abs(dk)+' km shorter':dk>0?dk+' km longer':'same distance')+' than Recommended';
 d.insertAdjacentHTML('afterend',`<div class="cro">${['Recommended','Fastest now','Shortest'].map((l,i)=>`<button class="${k===i?'on':''}" onclick="crOpt(${i})">${l}</button>`).join('')}</div><div class="crl">${ln}</div>`);
 return T.innerHTML};
screens.place=function(){
 const h=String(_p.apply(this,arguments)),p=(window.POI||[]).find(z=>z.n===PL.n);
 if(M.exp||!p)return h;const i=h.indexOf('<div class="als"'),j=i<0?h.indexOf('<div class="mo"'):i;if(j<0)return h;
 const food=p.c==='food'||p.c==='cafe',k=String(p.id).split('').reduce((a,c)=>a+c.charCodeAt(0),0);
 const ps=food?[['New iced drinks added','3 days ago'],['Extended hours on Fridays','2 weeks ago']]:[['Spring offer for new visitors','4 days ago'],['We moved the entrance to the side street','3 weeks ago']];
 const n=`<div class="nws"><b>News</b>${ps.map((x,q)=>{const id=p.id+q,on=M.nl&&M.nl[id];return `<div><span>${x[0]}<small>${x[1]}</small></span><button class="${on?'on':''}" onclick="nwLike('${id}')">♥ ${3+(k+q)%9+(on?1:0)}</button></div>`}).join('')}</div>`;
 return h.slice(0,j)+n+h.slice(j)};
})()}catch(x){console.error('naver-v582',x)}
</script>
<script>
/* v583: Naver Maps / Naver Place. Directions: bus routes get a "Next buses" row like Naver's departure list: clock times of the next four buses on the chosen route; tap one to leave on that bus (it sets the depart time and the arrival moves with it). Places: a coupon card on the place page like Naver's place coupons, with a Claim button that turns into "Claimed" and is kept per place. English only; coupons and bus times are sample data that follow the clock. */
try{(()=>{
const _r=screens.route,_p=screens.place,M=S.mp;
const f=m=>{m=((m%1440)+1440)%1440;const h=Math.floor(m/60),n=m%60;return(h%12||12)+':'+String(n).padStart(2,'0')+(h<12?' am':' pm')};
const st=document.createElement('style');
st.textContent='#phone .nbs{display:flex;gap:8px;align-items:center;padding:10px 20px 0;overflow-x:auto;scrollbar-width:none}#phone .nbs::-webkit-scrollbar{display:none}#phone .nbs b{flex:none;font-size:13px;color:var(--mu)}#phone .nbs button{flex:none;height:34px;border:0;border-radius:17px;padding:0 13px;background:var(--chip);color:var(--tx);font:inherit;font-weight:700;font-size:13px}#phone .nbs button.on{background:var(--lk);color:#fff}#phone .cpn{margin:14px 20px 0;padding:14px 16px;border-radius:16px;background:var(--tint);display:flex;align-items:center;justify-content:space-between;gap:12px}#phone .cpn span{font-size:15px;font-weight:700;color:var(--tintfg)}#phone .cpn small{display:block;font-size:12px;font-weight:600;margin-top:2px}#phone .cpn button{flex:none;height:34px;border:0;border-radius:17px;padding:0 14px;background:var(--lk);color:#fff;font:inherit;font-weight:700;font-size:13px}#phone .cpn button.on{background:var(--chip);color:var(--mu)}';
document.head.appendChild(st);
window.nbGo=v=>{M.dp=v;render('fade-none')};
window.cpClaim=id=>{M.cpn=M.cpn||{};M.cpn[id]=!M.cpn[id];toast(M.cpn[id]?'Coupon claimed':'Coupon removed');render('fade-none')};
screens.route=function(){
 const h=String(_r.apply(this,arguments));
 if((M.mode||'bus')!=='bus')return h;
 const T=document.createElement('div');T.innerHTML=h;const d=T.querySelector('.dpc');if(!d)return h;
 const n=new Date(),now=n.getHours()*60+n.getMinutes(),g=[0,9,21,34],cur=M.dp||0;
 d.insertAdjacentHTML('afterend',`<div class="nbs"><b>Next buses</b>${g.map(x=>`<button class="${cur===x?'on':''}" onclick="nbGo(${x})">${x?f(now+x):'Now'}</button>`).join('')}</div>`);
 return T.innerHTML};
screens.place=function(){
 const h=String(_p.apply(this,arguments)),p=(window.POI||[]).find(z=>z.n===PL.n);
 if(M.exp||!p)return h;const j=h.indexOf('<div class="nws"');if(j<0)return h;
 const food=p.c==='food'||p.c==='cafe',on=M.cpn&&M.cpn[p.id];
 return h.slice(0,j)+`<div class="cpn"><span>🎟️ ${food?'10% off your first order here':'Free first visit for itunda members'}<small>Valid for 7 days</small></span><button class="${on?'on':''}" onclick="cpClaim('${p.id}')">${on?'Claimed':'Claim'}</button></div>`+h.slice(j)};
})()}catch(x){console.error('naver-v583',x)}
</script>
<script>
/* v584: Naver Place booking. The Reserve sheet used to offer four fixed times, always today. Now it works like Naver's booking: a date strip (Today, Tomorrow and the next two days), a time grid where some slots are "Full" and today's past times are greyed out, a guests stepper (1 to 8), optional request chips (Window seat, Quiet table, Birthday) and a button that reads back the choice ("Book · Tomorrow 19:00 · 2 people"). Reservations list and the Book tab show the date. English only; which slots are full is sample data. */
try{(()=>{
const M=S.mp,sl=['12:00','13:00','14:00','18:00','19:00','20:00'],rq=['Window seat','Quiet table','Birthday'];
const days=()=>{const n=new Date(),w=['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];return[0,1,2,3].map(i=>{const d=new Date(n.getTime()+i*864e5);return i==0?'Today':i==1?'Tomorrow':w[d.getDay()]+' '+d.getDate()})};
const full=(p,d,s)=>(String(p+d+s).split('').reduce((a,c)=>a+c.charCodeAt(0),0)%4)===0;
const past=(d,s)=>{if(d)return false;const n=new Date();return +s.slice(0,2)*60<=n.getHours()*60+n.getMinutes()};
const ok=(p,d,s)=>!full(p,d,s)&&!past(d,s);
const st=document.createElement('style');
st.textContent='#phone .bkd{display:flex;gap:8px;overflow-x:auto;scrollbar-width:none}#phone .bkd::-webkit-scrollbar{display:none}#phone .bkd button,#phone .bkg button,#phone .bkn button{height:40px;border:0;border-radius:20px;padding:0 14px;background:var(--chip);color:var(--tx);font:inherit;font-weight:700;font-size:14px;flex:none;white-space:nowrap}#phone .bkd button.on,#phone .bkg button.on,#phone .bkn button.on{background:var(--lk);color:#fff}#phone .bkg{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}#phone .bkg button:disabled{opacity:.4;text-decoration:line-through}#phone .bkn{display:flex;gap:8px;flex-wrap:wrap}#phone .bks{display:flex;align-items:center;gap:18px}#phone .bks button{width:40px;padding:0;font-size:20px}#phone .bks b{font-size:18px;min-width:80px;text-align:center}';
document.head.appendChild(st);
const lb=t=>`<div class="sm mu" style="padding:18px 0 8px;font-weight:700">${t}</div>`;
window.rsvSet=(k,v)=>{const q=M.rq=Object.assign({t:'18:00',n:2,d:0},M.rq);q[k]=v;const p=PL.n;if(!ok(p,q.d,q.t||'')){q.t=sl.find(s=>ok(p,q.d,s))||''}plRsv()};
window.rsvNote=v=>{M.rq.k=M.rq.k===v?'':v;plRsv()};
window.plRsv=()=>{const q=M.rq=Object.assign({t:'18:00',n:2,d:0},M.rq),p=PL.n,D=days();
 if(!ok(p,q.d,q.t||''))q.t=sl.find(s=>ok(p,q.d,s))||'';
 const lab=(q.t?D[q.d]+' '+q.t+' · ':'')+q.n+(q.n==1?' person':' people');
 $('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="h1" style="font-size:22px;line-height:30px">Reserve a table</div><div class="mu" style="margin-top:4px">${p}</div>${lb('Date')}<div class="bkd">${D.map((x,i)=>`<button class="${q.d===i?'on':''}" onclick="rsvSet('d',${i})">${x}</button>`).join('')}</div>${lb('Time')}<div class="bkg">${sl.map(s=>`<button class="${q.t===s?'on':''}" ${ok(p,q.d,s)?'':'disabled'} onclick="rsvSet('t','${s}')">${s}${full(p,q.d,s)?' · Full':''}</button>`).join('')}</div>${lb('Guests')}<div class="bks"><button class="bkn" aria-label="Fewer" onclick="rsvSet('n',${Math.max(1,q.n-1)})" style="width:40px;height:40px;border:0;border-radius:20px;background:var(--chip);color:var(--tx);font:inherit;font-size:20px;font-weight:700">−</button><b>${q.n} ${q.n==1?'person':'people'}</b><button aria-label="More" onclick="rsvSet('n',${Math.min(8,q.n+1)})" style="width:40px;height:40px;border:0;border-radius:20px;background:var(--chip);color:var(--tx);font:inherit;font-size:20px;font-weight:700">+</button></div>${lb('Request (optional)')}<div class="bkn">${rq.map(x=>`<button class="${q.k===x?'on':''}" onclick="rsvNote('${x}')">${x}</button>`).join('')}</div><button class="btn" style="margin-top:22px" ${q.t?'':'disabled'} onclick="plBook()">${q.t?'Book · '+lab:'No tables left this day'}</button></div>`};
window.plBook=()=>{const q=M.rq,D=days();if(!q.t)return;M.rsv.unshift({p:PL.n,t:(q.d?D[q.d]+' ':'')+q.t,n:q.n,k:q.k||''});closeSheet();toast('Table for '+q.n+' · '+(q.d?D[q.d]+' ':'')+q.t);render('fade-none')};
window.plRsvList=()=>{const h=M.rsv.length?M.rsv.map((r,i)=>`<div style="display:flex;align-items:center;gap:12px;padding:12px 0"><div style="flex:1;min-width:0"><b style="display:block;font-size:17px;font-weight:600">${r.p}</b><span class="mu" style="font-size:14px">${/^\d/.test(r.t)?'Today · ':''}${r.t} · ${r.n} ${r.n==1?'person':'people'}${r.k?' · '+r.k:''}</span></div><button class="tap" style="border:0;background:var(--chip);border-radius:18px;height:36px;padding:0 14px;font:inherit;font-weight:700;font-size:14px;color:var(--tx)" onclick="plRsvCx(${i})">Cancel</button></div>`).join(''):'<div class="mu" style="padding:14px 0">No reservations yet.</div>';$('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="h1" style="font-size:22px;line-height:30px">Reservations</div>'+h+'</div>'};
})()}catch(x){console.error('naver-v584',x)}
</script>
<script>
/* v585: Naver Maps walking and bike options. Walk routes get Naver's option tabs (Recommended, Shortest, Main roads) and bike routes (Recommended, Shortest, Bike-friendly). Each picks the matching route from the list, with a line under the tabs saying how it differs from Recommended; walking also shows steps (about 0.75 m a step). When there is only one route the page says so instead of showing tabs that do nothing. English only; "Main roads" and "Bike-friendly" pick the longest alternative as the sample. */
try{(()=>{
const _r=screens.route,M=S.mp;
const st=document.createElement('style');
st.textContent='#phone .wko{display:flex;gap:8px;padding:10px 20px 0;overflow-x:auto;scrollbar-width:none}#phone .wko::-webkit-scrollbar{display:none}#phone .wko button{flex:none;height:34px;border:0;border-radius:17px;padding:0 13px;background:var(--chip);color:var(--tx);font:inherit;font-weight:700;font-size:13px}#phone .wko button.on{background:var(--lk);color:#fff}#phone .wkl{padding:8px 20px 0;font-size:13px;color:var(--mu)}';
document.head.appendChild(st);
window.wkOpt=k=>{const L=(M._r&&M._r.list)||[];if(!L.length)return;let i=0;if(k===1)L.forEach((x,j)=>{if(x.dist<L[i].dist)i=j});if(k===2)L.forEach((x,j)=>{if(x.dist>L[i].dist||j&&x.dist===L[i].dist&&x.secs>L[i].secs)i=j});M.wko=k;M.opt=i;render('fade-none')};
screens.route=function(){
 const h=String(_r.apply(this,arguments)),m=M.mode||'bus';
 if(m!=='walk'&&m!=='bike'||!M._r||!M._r.list)return h;
 const T=document.createElement('div');T.innerHTML=h;const d=T.querySelector('.dpc');if(!d)return h;
 const Ls=M._r.list,a=Ls[0],c=Ls[Math.min(M.opt||0,Ls.length-1)],k=M.wko||0;
 const steps=m==='walk'?' · about '+Math.round(c.dist/.75).toLocaleString('en-US')+' steps':'';
 if(Ls.length<2){d.insertAdjacentHTML('afterend',`<div class="wkl">Only one route found for this trip${steps}</div>`);return T.innerHTML}
 const dm=Math.round((c.secs-a.secs)/60),dk=((c.dist-a.dist)/1000).toFixed(1);
 const ln=c===a?'Balanced time and distance'+steps:(dm<0?Math.abs(dm)+' min faster':dm>0?dm+' min slower':'Same time')+' · '+(dk<0?Math.abs(dk)+' km shorter':dk>0?dk+' km longer':'same distance')+' than Recommended'+steps;
 const tabs=['Recommended','Shortest',m==='walk'?'Main roads':'Bike-friendly'];
 d.insertAdjacentHTML('afterend',`<div class="wko">${tabs.map((l,i)=>`<button class="${k===i?'on':''}" onclick="wkOpt(${i})">${l}</button>`).join('')}</div><div class="wkl">${ln}</div>`);
 return T.innerHTML};
})()}catch(x){console.error('naver-v585',x)}
</script>
<script>
/* v586: Naver Maps "share route". The Share pill on the route used to only copy a link. Now it opens a Share route sheet like Naver's: a preview of the message (place, mode, trip time, arrival time and link), a row for each person or group in Messages with a Send button (the message lands in that chat and the button turns into "Sent"), and Copy link. English only; the people are the sample chats. */
try{(()=>{
const M=S.mp;
const st=document.createElement('style');
st.textContent='#phone .shp{margin:12px 0 4px;padding:12px 14px;border-radius:14px;background:var(--chip);font-size:14px;line-height:20px}#phone .shr{display:flex;align-items:center;gap:12px;padding:10px 0}#phone .shr span{flex:1;min-width:0;font-size:16px;font-weight:600}#phone .shr button{flex:none;height:34px;border:0;border-radius:17px;padding:0 14px;background:var(--lk);color:#fff;font:inherit;font-weight:700;font-size:13px}#phone .shr button.on{background:var(--chip);color:var(--mu)}';
document.head.appendChild(st);
const msg=()=>{const a=document.querySelector('.rcd.on .rt1'),b=a&&a.querySelector('b'),s=a&&a.querySelector('span');const md={bus:'by bus',car:'by car',walk:'on foot',bike:'by bike'}[M.mode||'bus'];return 'On my way to '+PL.n+' '+md+(b?' · '+b.textContent:'')+(s?' · '+s.textContent:'')+' · itunda.rw/route/'+encodeURIComponent(PL.n)};
const ppl=()=>(typeof THREADS!=='undefined'?THREADS:[]).filter(t=>t.g==='community');
const show=()=>{const m=M.shm||(M.shm=msg()),sn=M.shs||(M.shs={});
 $('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="h1" style="font-size:22px;line-height:30px">Share route</div><div class="shp">${m.replace(/</g,'&lt;')}</div>${ppl().map(t=>`<div class="shr"><span>${t.n}</span><button class="${sn[t.id]?'on':''}" ${sn[t.id]?'disabled':''} onclick="shrSend('${t.id}')">${sn[t.id]?'Sent':'Send'}</button></div>`).join('')}<button class="btn sec2" style="margin-top:12px" onclick="shrCopy()">Copy link</button></div>`};
window.rtShr=()=>{M.shm=msg();M.shs={};show()};
window.shrSend=id=>{S.msgs[id]=S.msgs[id]||[];S.msgs[id].push(['me',M.shm]);M.shs[id]=1;toast('Route sent');show()};
window.shrCopy=()=>{try{navigator.clipboard.writeText('itunda.rw/route/'+encodeURIComponent(PL.n))}catch(e){}toast('Route link copied')};
})()}catch(x){console.error('naver-v586',x)}
</script>
<script>
/* v587: Naver Place "suggest an edit". The link at the end of the place sheet used to show a thank-you toast and nothing else. Now it opens a form like Naver's information-fix page: what is wrong (Closed for good, Wrong hours, Wrong phone, Wrong address, Other), one field for the right answer that changes with the choice (hours, phone number, address), and Send. The button stays off until a reason and an answer are filled in. After sending, the sheet shows "Under review" for that place and reason, and sending the same fix twice is blocked. English only; nothing is really sent. */
try{(()=>{
const M=S.mp,R=[['closed','Closed for good','Anything to add (optional)'],['hours','Wrong hours','e.g. Mon–Sat 07:00–21:00'],['phone','Wrong phone','e.g. 078 123 4567'],['addr','Wrong address','e.g. KN 3 Rd 12, Nyarugenge'],['other','Other','Tell us what is wrong']];
const st=document.createElement('style');
st.textContent='#phone .edc{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}#phone .edc button{height:36px;border:0;border-radius:18px;padding:0 14px;background:var(--chip);color:var(--tx);font:inherit;font-weight:700;font-size:14px}#phone .edc button.on{background:var(--lk);color:#fff}#phone .edc button:disabled{opacity:.5}#phone .edi{width:100%;box-sizing:border-box;height:48px;border:0;border-radius:14px;background:var(--chip);padding:0 14px;margin-top:14px;font:inherit;font-size:16px;color:var(--tx);outline:0}';
document.head.appendChild(st);
const sent=(p,k)=>(M.sug||[]).some(x=>x.p===p&&x.k===k);
const show=()=>{const e=M.ed||(M.ed={k:'',v:''}),p=PL.n,r=R.find(x=>x[0]===e.k),ok=e.k&&(e.k==='closed'||e.v.trim().length>1)&&!sent(p,e.k);
 $('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="h1" style="font-size:22px;line-height:30px">Suggest an edit</div><div class="mu" style="margin-top:4px">${p}</div><div class="edc">${R.map(x=>`<button class="${e.k===x[0]?'on':''}" ${sent(p,x[0])?'disabled':''} onclick="edPick('${x[0]}')">${sent(p,x[0])?x[1]+' · Under review':x[1]}</button>`).join('')}</div>${r?`<input class="edi" id="edv" value="${e.v.replace(/"/g,'&quot;')}" placeholder="${r[2]}" aria-label="${r[1]}" oninput="M_ed(this.value)">`:''}<button class="btn" id="edgo" style="margin-top:18px" ${ok?'':'disabled'} onclick="edSend()">Send</button></div>`};
window.plEdit=()=>{M.ed={k:'',v:''};show()};
window.edPick=k=>{M.ed={k,v:''};show();const i=$('#edv');if(i)i.focus()};
window.M_ed=v=>{M.ed.v=v;const b=$('#edgo');if(b)b.disabled=!(M.ed.k==='closed'||v.trim().length>1)};
window.edSend=()=>{const e=M.ed;M.sug=M.sug||[];M.sug.push({p:PL.n,k:e.k,v:e.v.trim()});closeSheet();toast('Thanks, your suggestion is under review')};
})()}catch(x){console.error('naver-v587',x)}
</script>
<script>
/* v588: Naver Place "Blog reviews". Naver's review page has two kinds of reviews, visitor reviews and blog reviews. The Reviews tab now has a two-part switch at the top (Visitor reviews, Blog reviews). Blog reviews list four posts with a picture tile, title, blogger, date and two lines of the post, and a count in the switch; tapping a post says it opens in the browser in the real app. The choice is kept per place. English only; the posts are sample data. */
try{(()=>{
const _p=screens.place,M=S.mp;
const st=document.createElement('style');
st.textContent='#phone .rvs{display:flex;gap:8px;padding:12px 20px 0}#phone .rvs button{flex:1;height:38px;border:0;border-radius:19px;background:var(--chip);color:var(--tx);font:inherit;font-weight:700;font-size:14px}#phone .rvs button.on{background:var(--lk);color:#fff}#phone .blg{display:flex;gap:12px;padding:14px 20px;align-items:flex-start;cursor:pointer}#phone .blg i{flex:none;width:64px;height:64px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:28px;font-style:normal}#phone .blg b{display:block;font-size:16px;line-height:22px}#phone .blg small{display:block;color:var(--mu);font-size:12px;margin-top:2px}#phone .blg p{margin:4px 0 0;font-size:14px;line-height:20px;color:var(--mu);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}';
document.head.appendChild(st);
window.rvKind=k=>{M.rvk=M.rvk||{};M.rvk[PL.n]=k;render('fade-none')};
const BG=['#FFE8C7','#E3F4E8','#E6EAFB','#F3E6FA'];
screens.place=function(){
 const h=String(_p.apply(this,arguments)),p=(window.POI||[]).find(z=>z.n===PL.n);
 if(!M.exp||M.tab!=='reviews'||!p)return h;
 const T=document.createElement('div');T.innerHTML=h;const tb=T.querySelector('.ptabs');if(!tb)return h;
 const food=p.c==='food'||p.c==='cafe',k=String(p.id).split('').reduce((a,c)=>a+c.charCodeAt(0),0),blog=(M.rvk&&M.rvk[PL.n])==='blog';
 const em=food?['☕','🍰','🍜','🥐']:['📍','🏙️','🚶','📸'],ti=food?['A quiet corner for weekend brunch','Is it worth the queue? My honest visit','Best seat in the house, and what to order','Rainy day treat in Nyamirambo']:['What to know before you visit','A first visit, step by step','Worth a detour? Our weekend trip','Hidden spots near '+p.n],bl=['Aline M.','Kigali Daily','Jean B.','Weekend Notes'];
 const n=4,posts=ti.map((t,i)=>`<div class="blg" onclick="toast('Blog posts open in the browser in the real app')"><i style="background:${BG[i]}">${em[i]}</i><div style="min-width:0"><b>${t}</b><small>${bl[i]} · ${1+(k+i*5)%28} days ago</small><p>We went on a Saturday and the place was calm. Here is what we liked, what we would skip and how to get there from the bus stop.</p></div></div>`).join('');
 let nx=tb.nextElementSibling;const sw=`<div class="rvs"><button class="${blog?'':'on'}" onclick="rvKind('visitor')">Visitor reviews</button><button class="${blog?'on':''}" onclick="rvKind('blog')">Blog reviews ${n}</button></div>`;
 if(blog){while(nx&&!nx.matches('.cta,.fab')){const d=nx;nx=nx.nextElementSibling;d.remove()}tb.insertAdjacentHTML('afterend',sw+posts+'<div class="pad fine" style="padding:12px 20px">Blog posts are sample data.</div>')}
 else tb.insertAdjacentHTML('afterend',sw);
 return T.innerHTML};
})()}catch(x){console.error('naver-v588',x)}
</script>
<script>
/* v589: Naver Maps "recently viewed". Every place you open is remembered (last six, newest first, no repeats). The map search screen shows them as a "Recently viewed" row of chips above the recent searches, with a Clear link; tap a chip to open that place again. Nothing shows until you have opened one. English only. */
try{(()=>{
const _p=screens.place,_s=screens.mapsearch,M=S.mp;
const st=document.createElement('style');
st.textContent='#phone .rvw{padding:14px 20px 0}#phone .rvw div.h{display:flex;justify-content:space-between;align-items:center;font-size:15px;font-weight:800;margin-bottom:8px}#phone .rvw div.h a{font-size:13px;font-weight:700;color:var(--lk)}#phone .rvw div.c{display:flex;gap:8px;overflow-x:auto;scrollbar-width:none}#phone .rvw div.c::-webkit-scrollbar{display:none}#phone .rvw button{flex:none;height:36px;border:0;border-radius:18px;padding:0 14px;background:var(--chip);color:var(--tx);font:inherit;font-weight:700;font-size:14px;white-space:nowrap}';
document.head.appendChild(st);
window.rvwClear=()=>{M.rvw=[];render('fade-none')};
screens.place=function(){
 const p=(window.POI||[]).find(z=>z.n===PL.n);
 if(p){const a=(M.rvw||[]).filter(x=>x!==p.id);a.unshift(p.id);M.rvw=a.slice(0,6)}
 return _p.apply(this,arguments)};
screens.mapsearch=function(){
 const h=String(_s.apply(this,arguments)),P=window.POI||[],l=(M.rvw||[]).map(id=>P.find(z=>z.id===id)).filter(Boolean);
 const k='<div id="mprec">',i=h.indexOf(k);if(!l.length||i<0)return h;
 return h.slice(0,i)+`<div class="rvw"><div class="h">Recently viewed<a onclick="rvwClear()">Clear</a></div><div class="c">${l.map(z=>`<button onclick="mpResult('${z.id}')">${z.e||'📍'} ${z.n}</button>`).join('')}</div></div>`+h.slice(i)};
})()}catch(x){console.error('naver-v589',x)}
</script>
<script>
/* v590: Naver Maps "Last bus" departure. Naver lets you plan from the last train; here the "Next buses" row on bus routes gets a "Last bus 9:40 pm" button. Tap it and the trip is planned on the last bus (the depart time moves to 9:40 pm and the arrival with it). After 9:40 pm the button reads "Last bus has left" and is off. The button is on while that time is chosen. English only; 9:40 pm is the sample last bus, as on the route card since v560. */
try{(()=>{
const _r=screens.route,M=S.mp,LB=21*60+40;
const f=m=>{const h=Math.floor(m/60),n=m%60;return(h%12||12)+':'+String(n).padStart(2,'0')+(h<12?' am':' pm')};
const st=document.createElement('style');
st.textContent='#phone .nbs button:disabled{opacity:.5}';
document.head.appendChild(st);
screens.route=function(){
 const h=String(_r.apply(this,arguments));
 if((M.mode||'bus')!=='bus')return h;
 const T=document.createElement('div');T.innerHTML=h;const r=T.querySelector('.nbs');if(!r)return h;
 const n=new Date(),now=n.getHours()*60+n.getMinutes(),left=LB-now,gone=left<=0;
 r.insertAdjacentHTML('beforeend',`<button class="${!gone&&M.dp===left?'on':''}" ${gone?'disabled':''} onclick="nbGo(${Math.max(0,left)})">${gone?'Last bus has left':'Last bus '+f(LB)}</button>`);
 return T.innerHTML};
})()}catch(x){console.error('naver-v590',x)}
</script>
<script>
/* v591: Naver Place "visitor tips". A "Tips from visitors" block on the place sheet, under the coupon and above News: three short one-line tips (best time to go, what to order or do, how to get in), each with a "Helpful" count that goes up by one when tapped (tap again to take it back). The counts and the tips are sample data. English only. */
try{(()=>{
const _p=screens.place,M=S.mp;
const st=document.createElement('style');
st.textContent='#phone .tps{margin:14px 20px 0}#phone .tps b{display:block;font-size:15px;margin-bottom:6px}#phone .tps div{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:8px 0;font-size:14px;line-height:20px}#phone .tps button{flex:none;height:30px;border:0;border-radius:15px;padding:0 11px;background:var(--chip);color:var(--tx);font:inherit;font-weight:700;font-size:12px}#phone .tps button.on{background:var(--lk);color:#fff}';
document.head.appendChild(st);
window.tpLike=id=>{M.tpl=M.tpl||{};M.tpl[id]=!M.tpl[id];render('fade-none')};
screens.place=function(){
 const h=String(_p.apply(this,arguments)),p=(window.POI||[]).find(z=>z.n===PL.n);
 if(M.exp||!p)return h;const j=h.indexOf('<div class="nws"');if(j<0)return h;
 const food=p.c==='food'||p.c==='cafe',k=String(p.id).split('').reduce((a,c)=>a+c.charCodeAt(0),0);
 const t=food?['Go before 11:30 to skip the lunch queue','Ask for the corner table by the window','Pay with itunda Pay at the till, it is quicker']:['Quietest on weekday mornings','The side entrance is step-free','Bring your ID for member prices'];
 const b=`<div class="tps"><b>Tips from visitors</b>${t.map((x,i)=>{const id=p.id+i,on=M.tpl&&M.tpl[id];return `<div><span>${x}</span><button class="${on?'on':''}" onclick="tpLike('${id}')">👍 ${4+(k*(i+2))%17+(on?1:0)}</button></div>`}).join('')}</div>`;
 return h.slice(0,j)+b+h.slice(j)};
})()}catch(x){console.error('naver-v591',x)}
</script>
<script>
/* v592: Naver Maps domain 9, Navigation (driving). Naver's home has a Navigation tab; here a "Drive" chip on the map opens it. (1) Where to?: places with the trip time by car and a check on arrival, like Naver's: "Open when you arrive", "Closes soon after you arrive" or "Closed when you arrive" (from the closing time and the clock). (2) Best time to leave: Now, +30 min, +1 h, +2 h with the trip time and how busy the road is; tap one to see when to leave and arrive. (3) Safe driving: no destination, speed against the limit, the next speed camera with a countdown, and the traffic light with a countdown. (4) Driving score: week or month bars, a score, how you compare, and three habits. (5) On the road: parking, fuel and EV charging lists. In a car trip (Directions, Start): a Report button (Accident, Roadworks, Closed road, Hazard) and a speed camera alert, including a rear-facing camera, as Naver added in 2026. English only; scores, cameras, lights and places are sample data. */
try{(()=>{
const M=S.mp,_mv=screens.mapview,_nav=screens.nav;
M.dv=M.dv||{off:0,sel:'cafe2',rg:'week',road:'parking',rep:[],ro:false,s:{t:0,cd:720}};
const DV=window.__dv={t:null,w:null};
const st=document.createElement('style');
st.textContent='#phone .dvh{padding:22px 24px 4px;font-size:18px;font-weight:800}#phone .dvr{display:flex;align-items:center;gap:12px;padding:10px 24px}#phone .dvr.on{background:var(--chip)}#phone .dvr>i{flex:none;width:44px;height:44px;border-radius:22px;background:var(--chip);display:flex;align-items:center;justify-content:center;font-style:normal;font-size:20px}#phone .dvr.on>i{background:var(--bg)}#phone .dvr div{flex:1;min-width:0}#phone .dvr b{display:block;font-size:16px;font-weight:700}#phone .dvr span{font-size:13px;color:var(--tt)}#phone .dvr em{font-style:normal;font-weight:700;font-size:13px}#phone .dvr button{flex:none;height:36px;padding:0 16px;border:0;border-radius:18px;background:var(--lk);color:#fff;font:inherit;font-weight:700;font-size:13px}#phone .dvp{display:flex;gap:8px;padding:6px 24px 0;overflow-x:auto;scrollbar-width:none}#phone .dvp::-webkit-scrollbar{display:none}#phone .dvp button{flex:none;border:1px solid var(--ln);border-radius:14px;background:none;color:var(--tx);font:inherit;padding:8px 12px;text-align:left;min-width:78px}#phone .dvp button.on{border-color:var(--lk);background:var(--chip)}#phone .dvp b{display:block;font-size:12px;color:var(--tt);font-weight:700}#phone .dvp i{display:block;font-style:normal;font-size:17px;font-weight:800;margin-top:2px}#phone .dvp small{font-size:11px;font-weight:700}#phone .dvn{padding:10px 24px 0;font-size:14px;line-height:20px;color:var(--tt)}#phone .dvc{margin:12px 24px 0;padding:16px;border-radius:20px;background:var(--chip)}#phone .dvc b{font-size:16px}#phone .dvc .btn{margin-top:12px}#phone .dvb2{display:flex;align-items:flex-end;gap:8px;height:84px;margin-top:12px}#phone .dvb2 div{flex:1;display:flex;flex-direction:column;justify-content:flex-end;align-items:center;gap:4px;height:100%;font-size:11px;color:var(--tt)}#phone .dvb2 i{display:block;width:100%;border-radius:6px;background:var(--lk);opacity:.35}#phone .dvb2 div:last-child i{opacity:1}#phone .dvt{display:flex;gap:8px;padding:6px 24px 0}#phone .dvt button{border:0;border-radius:16px;background:var(--chip);color:var(--tx);font:inherit;font-weight:700;font-size:13px;height:32px;padding:0 14px}#phone .dvt button.on{background:var(--lk);color:#fff}#phone .dvrb{position:absolute;left:10px;bottom:14px;height:40px;padding:0 16px;border:0;border-radius:20px;background:var(--bg);color:var(--tx);font:inherit;font-weight:800;font-size:14px;box-shadow:0 1px 6px rgba(0,0,0,.25);z-index:5}#phone .dvrp{position:absolute;left:10px;bottom:64px;grid-template-columns:1fr 1fr;gap:8px;padding:10px;border-radius:18px;background:var(--bg);box-shadow:0 2px 10px rgba(0,0,0,.3);z-index:5}#phone .dvrp button{height:44px;padding:0 12px;border:0;border-radius:14px;background:var(--chip);color:var(--tx);font:inherit;font-weight:700;font-size:13px;text-align:left}#phone .dvrb.in{position:static!important;left:auto!important;display:block;width:calc(100% - 48px);margin:12px 24px 0;box-shadow:none;background:var(--chip)}#phone .dvrp.in{position:static!important;left:auto!important;width:calc(100% - 48px);grid-template-columns:repeat(2,minmax(0,1fr));margin:8px 24px 0;padding:0;box-shadow:none;background:none}#phone .dvcam{position:absolute;left:10px;right:70px;bottom:64px;display:none;padding:10px 14px;border-radius:16px;background:#E5484D;color:#fff;font-weight:800;font-size:14px;z-index:4}';
document.head.appendChild(st);
const REP=[['🚗','Accident'],['🚧','Roadworks'],['⛔','Road closed'],['⚠️','Hazard']];
const CAMS=[{at:.3,lim:50,rear:false},{at:.65,lim:50,rear:true}];
const now=()=>{const d=new Date();return d.getHours()*60+d.getMinutes()};
const clk=m=>{m=((m%1440)+1440)%1440;const h=Math.floor(m/60);return (h%12||12)+':'+String(m%60).padStart(2,'0')+' '+(h<12?'am':'pm')};
const eta=p=>Math.max(2,Math.round(1.85*(parseFloat(p.d)||0)));
const fac=h=>{h=((h%1440)+1440)%1440/60;return(h>=7&&h<9.5)||(h>=17&&h<19.5)?1.6:(h>=6&&h<7)||(h>=9.5&&h<11)||(h>=16&&h<17)||(h>=19.5&&h<20.5)?1.25:1};
const tf=f=>f>=1.6?['Heavy','#E5484D']:f>=1.25?['Busy','#F5A524']:['Smooth','#2BA84A'];
const dest=()=>(window.POI||[]).filter(p=>/^(cafe|food|pharm|atm)$/.test(p.c)).sort((a,b)=>(parseFloat(a.d)||0)-(parseFloat(b.d)||0)).slice(0,5);
const chk=p=>{const m=/closes (\d\d):(\d\d)/.exec(p.o||''),a=now()+eta(p);if(!m)return['Open 24 hours','#2BA84A'];const c=+m[1]*60+ +m[2];return a>=c?['Closed when you arrive','#E5484D']:c-a<=30?['Closes soon after you arrive','#F5A524']:['Open when you arrive','#2BA84A']};
const ROAD={parking:[['🅿️','Kigali Heights Parking','0.6 km','RWF 500/h · 24 spaces'],['🅿️','Union Trade Centre','1.1 km','RWF 400/h · Full'],['🅿️','Nyarugenge Open Lot','1.9 km','RWF 300/h · 8 spaces']],fuel:[['⛽','SP Kimironko','0.9 km','Petrol and diesel · open 24 hours'],['⛽','Engen Remera','1.8 km','Petrol and diesel · closes 22:00'],['⛽','Rubis Kacyiru','2.7 km','Petrol and diesel · open 24 hours']],ev:[['🔌','Convention Centre EV Point','1.4 km','22 kW · 2 of 4 free'],['🔌','Remera Mall Charger','2.3 km','7 kW · 1 of 2 free'],['🔌','Kacyiru Hub','3.0 km','50 kW fast · busy']]};
const SC={week:{l:['M','T','W','T','F','S','S'],v:[82,76,88,91,79,85,90],s:84,c:'71%'},month:{l:['W1','W2','W3','W4'],v:[78,81,84,87],s:82,c:'64%'}};
const rep=()=>{const n=M.dv.rep.length;return n?`${n} report${n>1?'s':''} shared by you`:'Report accidents and hazards while you drive'};
window.dvSel=id=>{M.dv.sel=id;render('fade-none')};
window.dvOff=i=>{M.dv.off=i;render('fade-none')};
window.dvGo=id=>{M.mode='car';mpDir(id)};
window.dvRg=k=>{M.dv.rg=k;render('fade-none')};
window.dvRoad=k=>{M.dv.road=k;render('fade-none')};
window.dvRepTog=()=>{M.dv.ro=!M.dv.ro;const e=document.getElementById('dvrp');if(e)e.style.display=M.dv.ro?'grid':'none'};
window.dvReport=k=>{M.dv.rep.push(k);M.dv.ro=false;const e=document.getElementById('dvrp');if(e)e.style.display='none';toast(k+' reported. Drivers nearby will see it.')};
window.dvEnd=()=>{clearInterval(DV.t);DV.t=null;back()};
const repUI=(i)=>`<button class="dvrb${i?' in':''}" onclick="dvRepTog()" aria-label="Report">⚠️ Report</button><div id="dvrp" class="dvrp${i?' in':''}" style="display:${M.dv.ro?'grid':'none'}">${REP.map(r=>`<button onclick="dvReport('${r[1]}')">${r[0]} ${r[1]}</button>`).join('')}</div>`;
screens.mpdrive=()=>{
 const D=M.dv,P=dest(),sel=P.find(p=>p.id===D.sel)||P[0];
 const rows=P.map(p=>{const c=chk(p);return`<div class="dvr tap ${p.id===sel.id?'on':''}" onclick="dvSel('${p.id}')"><i>${p.e}</i><div><b>${p.n}</b><span>${eta(p)} min · ${p.d}</span><br><em style="color:${c[1]}">${c[0]}</em></div><button onclick="event.stopPropagation();dvGo('${p.id}')">Go</button></div>`}).join('');
 const b=eta(sel),n=now(),ofs=[0,30,60,120],times=ofs.map(o=>{const f=fac(n+o),m=Math.round(b*f);return{o,m,t:tf(f)}}),best=times.reduce((a,x)=>x.m<a.m?x:a,times[0]),cur=times[D.off]||times[0];
 const pills=times.map((x,i)=>`<button class="${i===D.off?'on':''}" onclick="dvOff(${i})"><b>${x.o?(x.o<60?'+'+x.o+' min':'+'+x.o/60+' h'):'Now'}${x===best&&best.m<Math.max(...times.map(y=>y.m))?' · Best':''}</b><i>${x.m} min</i><small style="color:${x.t[1]}">${x.t[0]}</small></button>`).join('');
 const S0=SC[D.rg],bars=S0.v.map((v,i)=>`<div><i style="height:${Math.round((v-50)/50*100)}%"></i>${S0.l[i]}</div>`).join('');
 const rd=ROAD[D.road].map(r=>`<div class="dvr tap" onclick="toast('Sample place: not on the prototype map')"><i>${r[0]}</i><div><b>${r[1]}</b><span>${r[2]} · ${r[3]}</span></div></div>`).join('');
 return`<div class="mh" style="padding-bottom:0"><button class="ib" aria-label="Back" onclick="back()">${ic('back',24)}</button><b style="flex:1;font-size:19px;margin-left:6px">Drive</b></div>
<div class="dvh">Where to?</div>${rows}
<div class="dvh">Best time to leave for ${sel.n}</div><div class="dvp">${pills}</div><div class="dvn">Leave at ${clk(n+cur.o)} and arrive about ${clk(n+cur.o+cur.m)}.${best.o&&best.m<times[0].m?' Leaving '+(best.o<60?best.o+' min':best.o/60+' h')+' later saves '+(times[0].m-best.m)+' min.':''}</div>
<div class="dvc"><b>Safe driving</b><div class="dvn" style="padding:4px 0 0">No destination needed. See your speed, the next speed camera and the traffic light. ${rep()}.</div><button class="btn" onclick="mpGo('mpsafe')">Start safe driving</button></div>
<div class="dvh">Driving score</div><div class="dvt"><button class="${D.rg==='week'?'on':''}" onclick="dvRg('week')">This week</button><button class="${D.rg==='month'?'on':''}" onclick="dvRg('month')">This month</button></div>
<div class="dvc"><div style="display:flex;align-items:baseline;gap:8px"><b style="font-size:40px;letter-spacing:-1px">${S0.s}</b><span class="mu">out of 100</span></div><div class="dvn" style="padding:2px 0 0">Better than ${S0.c} of drivers. Scores need 10 km or more in 4 weeks; you have driven 38 km.</div><div class="dvb2">${bars}</div><div class="dvn" style="padding:12px 0 0">Speeding: Good · Braking: Good · Acceleration: Fair</div></div>
<div class="dvh">On the road</div><div class="dvt"><button class="${D.road==='parking'?'on':''}" onclick="dvRoad('parking')">🅿️ Parking</button><button class="${D.road==='fuel'?'on':''}" onclick="dvRoad('fuel')">⛽ Fuel</button><button class="${D.road==='ev'?'on':''}" onclick="dvRoad('ev')">🔌 EV charging</button></div>${rd}<div class="dvn" style="padding-bottom:24px">Sample places and scores.</div>`};
const sp=t=>Math.round(44+9*Math.sin(t/4));
const lt=t=>{const c=t%45;return c<20?['Red',20-c,'#E5484D']:['Green',45-c,'#2BA84A']};
screens.mpsafe=()=>{const s=M.dv.s,v=sp(s.t),l=lt(s.t);setTimeout(()=>{if(!DV.t)DV.t=setInterval(()=>{if(S.stack[S.stack.length-1]!=='mpsafe'){clearInterval(DV.t);DV.t=null;return}const s=M.dv.s;s.t++;s.cd-=sp(s.t)*.278;if(s.cd<=0){s.cd=900;toast('Passed the speed camera')}const e=x=>document.getElementById(x),v=sp(s.t),l=lt(s.t);if(e('dvsp')){e('dvsp').textContent=v;e('dvsp').style.color=v>50?'#E5484D':'var(--tx)'}if(e('dvcm'))e('dvcm').textContent=Math.max(10,Math.round(s.cd/10)*10)+' m';if(e('dvlt')){e('dvlt').textContent=l[0]+' '+l[1]+' s';e('dvlt').style.color=l[2]}},1000)},0);
 return`<div style="position:relative;min-height:560px"><div class="mh" style="padding-bottom:0"><b style="flex:1;font-size:19px;margin-left:24px">Safe driving</b></div>
<div style="text-align:center;padding-top:28px"><div id="dvsp" style="font-size:96px;font-weight:800;letter-spacing:-3px;line-height:96px;color:${v>50?'#E5484D':'var(--tx)'}">${v}</div><div class="mu" style="font-size:15px">km/h · limit 50</div></div>
<div class="dvc"><b>📷 Next speed camera</b><div id="dvcm" style="font-size:28px;font-weight:800;margin-top:4px">${Math.max(10,Math.round(s.cd/10)*10)} m</div><div class="dvn" style="padding:2px 0 0">Limit 50 km/h</div></div>
<div class="dvc"><b>🚦 Traffic light ahead</b><div id="dvlt" style="font-size:28px;font-weight:800;margin-top:4px;color:${l[2]}">${l[0]} ${l[1]} s</div></div>
${repUI(1)}</div><div class="cta"><button class="btn" onclick="dvEnd()">End safe driving</button></div>`};
screens.nav=function(){const h=String(_nav.apply(this,arguments)),N=M.nr;if(!N||N.mode!=='car')return h;const k=h.lastIndexOf('</div><div class="cta" id="nvf">');if(k<0)return h;
 setTimeout(()=>{if(DV.w)return;DV.w=setInterval(()=>{if(S.stack[S.stack.length-1]!=='nav'||!M.nr){clearInterval(DV.w);DV.w=null;return}const el=document.getElementById('dvcam');if(!el||!M.nv)return;const f=M.nv.f;let c=null;for(const x of CAMS)if(f>x.at-.09&&f<x.at+.005)c=x;if(!c){el.style.display='none';return}const d=Math.max(20,Math.round((c.at-f)/.09*450/10)*10);el.textContent='📷 '+(c.rear?'Rear camera ':'Speed camera ')+d+' m · '+c.lim+' km/h';el.style.display='block'},400)},0);
 return h.slice(0,k)+repUI()+'<div id="dvcam" class="dvcam"></div>'+h.slice(k)};
screens.mapview=function(){
 const h=String(_mv.apply(this,arguments)),T=document.createElement('div');T.innerHTML=h;
 try{const row=T.querySelector('.mpx');if(!row||T.querySelector('[onclick="mpGo(\'mpdrive\')"]'))return h;
  const b=row.querySelector('button');if(!b)return h;const c=b.cloneNode(true);c.setAttribute('onclick',"mpGo('mpdrive')");c.textContent='🚗 Drive';row.appendChild(c)}catch(e){return h}
 return T.innerHTML};
})()}catch(x){console.error('naver-v592',x)}
</script>
<script>
/* v593: Naver Maps domain 10, Indoor and 3D. Two chips on the map. "Indoor" opens a sample mall (Kigali Heights) like Naver's indoor map: a floor switcher (B1 to 3F), a drawn floor plan, filter chips (Food, Shops, Lifts, Toilets, Info), tap a unit for its card. Directions inside draws the walk from the entrance on the plan (to the lift first when the unit is on another floor), with steps, metres and minutes. "AR guide" opens a camera-style screen: it scans for 2 seconds, then counts down each step (go straight, take the lift, arrive) with a moving arrow; it is drawn, the real app uses the camera. "3D" opens Flying View style: five Kigali landmarks as blocks on a map; drag sideways to turn, up and down to tilt, tap a block for its name. English only; plans, units and landmark shapes are sample. */
try{(()=>{
const M=S.mp,_mv=screens.mapview;
M.id=M.id||{fl:'1F',cat:'all',sel:null,dir:false};M.td=M.td||{rot:-30,tilt:55,sel:null};
const IN=window.__in={t:null};
const st=document.createElement('style');
st.textContent='#phone .inf{display:flex;gap:8px;padding:10px 20px 0;overflow-x:auto;scrollbar-width:none}#phone .inf::-webkit-scrollbar{display:none}#phone .inf button{flex:none;height:34px;padding:0 14px;border:0;border-radius:17px;background:var(--chip);color:var(--tx);font:inherit;font-weight:700;font-size:13px}#phone .inf button.on{background:var(--lk);color:#fff}#phone .inc{margin:12px 20px 0;padding:14px 16px;border-radius:20px;background:var(--chip)}#phone .inc b{font-size:16px}#phone .inc .mu{font-size:13px;margin-top:2px}#phone .inc .g{display:flex;gap:8px;margin-top:12px}#phone .inc .g button{flex:1;height:42px;border:0;border-radius:21px;background:var(--bg);color:var(--tx);font:inherit;font-weight:700;font-size:14px}#phone .inc .g button.m{background:var(--lk);color:#fff}#phone .ins{padding:6px 0 0;font-size:14px;line-height:22px}#phone .arview{position:relative;height:560px;overflow:hidden;background:linear-gradient(#2B3340,#11151C 55%,#3A4350 55%,#1A1F27);color:#fff}#phone .arview .fl{position:absolute;left:0;right:0;bottom:0;height:45%;perspective:300px;overflow:hidden}#phone .arview .fl i{position:absolute;left:50%;width:46px;height:46px;margin-left:-23px;border-top:8px solid #fff;border-left:8px solid #fff;transform:rotate(45deg) rotateX(50deg);opacity:0;animation:arw 1.6s infinite}#phone .arview .fl i:nth-child(2){animation-delay:.5s}#phone .arview .fl i:nth-child(3){animation-delay:1s}@keyframes arw{0%{bottom:0;opacity:0}30%{opacity:.95}100%{bottom:130px;opacity:0}}#phone .arb{position:absolute;left:12px;right:12px;top:12px;padding:14px 16px;border-radius:18px;background:var(--lk);font-weight:800}#phone .arb small{display:block;font-weight:600;opacity:.85;margin-top:2px}#phone .td{position:relative;height:520px;overflow:hidden;background:var(--chip);perspective:900px;touch-action:none;cursor:grab}#phone .tds{position:absolute;left:50%;top:50%;width:300px;height:300px;margin:-150px 0 0 -150px;transform-style:preserve-3d;background:var(--bg);border-radius:8px;background-image:linear-gradient(var(--ln) 1px,transparent 1px),linear-gradient(90deg,var(--ln) 1px,transparent 1px);background-size:30px 30px}#phone .tb{position:absolute;transform-style:preserve-3d}#phone .tb u{position:absolute;display:block}#phone .tb .t{inset:0}#phone .tb .f{transform-origin:0 0;transform:rotateX(90deg)}#phone .tb .s{transform-origin:0 0;transform:rotateY(-90deg)}';
document.head.appendChild(st);
const mk=(f,rows)=>rows.map(r=>({id:f+r[0],n:r[1],c:r[2],x:r[3],y:r[4],w:r[5],h:r[6],o:r[7]||'Open · closes 21:00'}));
const AM=f=>[['lift','Lifts','lift',152,130,36,36,'All floors'],['wc','Toilets','wc',250,130,36,36,'All floors']].concat(f==='1F'?[['info','Information desk','info',54,130,36,36,'Open · closes 20:00']]:[]);
const FL={B1:mk('B1',[['a','Fresh Market','shop',14,16,150,74],['b','Parking P1 desk','info',176,16,150,74],['c','Car wash','shop',14,200,150,74],['d','Pharmacy Plus','shop',176,200,150,74]].concat(AM('B1'))),
'1F':mk('1F',[['a','Cafe Neo','food',14,16,100,74],['b','Mama’s Kitchen','food',120,16,100,74],['c','Book Corner','shop',226,16,100,74],['d','Phone Fix','shop',14,200,100,74],['e','Kigali Bakery','food',226,200,100,74]].concat(AM('1F'))),
'2F':mk('2F',[['a','Fashion House','shop',14,16,150,74],['b','Shoe Studio','shop',176,16,150,74],['c','Sushi Bar','food',14,200,150,74],['d','Grill Room','food',176,200,150,74]].concat(AM('2F'))),
'3F':mk('3F',[['a','Cinema Hall','shop',14,16,200,74],['b','Game Zone','shop',226,16,100,74],['c','Rooftop Lounge','food',14,200,150,74],['d','Dental Care','shop',176,200,150,74]].concat(AM('3F')))};
const FS=Object.keys(FL),CT=[['all','All'],['food','🍽️ Food'],['shop','🛍️ Shops'],['lift','🛗 Lifts'],['wc','🚻 Toilets'],['info','ℹ️ Info']],EM={lift:'🛗',wc:'🚻',info:'ℹ️'};
const all=()=>FS.flatMap(f=>FL[f].map(u=>({...u,f})));
const cen=u=>[u.x+u.w/2,u.y+u.h/2];
const len=p=>p.reduce((a,q,i)=>i?a+Math.hypot(q[0]-p[i-1][0],q[1]-p[i-1][1]):0,0);
const door=(u,s)=>u.y<100?[cen(u)[0],u.y+u.h]:u.y>150?[cen(u)[0],u.y]:cen(u);
const legTo=(u,from)=>{const c=cen(u),d=door(u),a=[from,[from[0],150]];if(u.c==='lift'||u.c==='wc'||u.c==='info'){a.push([c[0],150],c)}else{a.push([d[0],150],d,c)}return a};
const route=u=>{const E=[170,285],Lc=cen(FL['1F'].find(x=>x.c==='lift')),same=u.f==='1F';if(same)return{legs:{'1F':legTo(u,E)},steps:[['Go to '+u.n,len(legTo(u,E))*.4]]};
 const l1=[E,[170,150],Lc],l2=legTo(u,Lc),d=Math.abs(FS.indexOf(u.f)-FS.indexOf('1F'))*3;return{legs:{'1F':l1,[u.f]:l2},steps:[['Walk to the lift',len(l1)*.4],['Take the lift to '+u.f,d],['Walk to '+u.n,len(l2)*.4]]}};
const mins=r=>r.steps.reduce((a,s)=>a+s[1],0);
window.inFl=f=>{M.id.fl=f;render('fade-none')};window.inCat=c=>{M.id.cat=c;render('fade-none')};
window.inSel=id=>{M.id.sel=id;M.id.dir=false;render('fade-none')};window.inDir=()=>{M.id.dir=true;const u=all().find(x=>x.id===M.id.sel);if(u&&u.f!==M.id.fl&&M.id.fl!=='1F'){}render('fade-none')};
const cur=()=>all().find(u=>u.id===M.id.sel);
screens.mpindoor=()=>{const D=M.id,us=FL[D.fl],u=cur(),r=u&&D.dir?route(u):null,seg=r&&r.legs[D.fl];
 const rects=us.map(x=>{const on=D.cat==='all'||x.c===D.cat,s=x.id===D.sel,sm=EM[x.c];return`<g onclick="inSel('${x.id}')" opacity="${on?1:.3}"><rect x="${x.x}" y="${x.y}" width="${x.w}" height="${x.h}" rx="8" fill="${s?'var(--lk)':'var(--chip)'}" ${s?'fill-opacity=".25" stroke="var(--lk)" stroke-width="2"':'stroke="var(--ln)"'}/><text x="${x.x+x.w/2}" y="${x.y+x.h/2+(sm?6:4)}" text-anchor="middle" font-size="${sm?20:11}" font-weight="700" fill="var(--tx)">${sm||x.n}</text></g>`}).join('');
 const line=seg?`<polyline points="${seg.map(p=>p.join(',')).join(' ')}" fill="none" stroke="var(--lk)" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="1 9"/><circle cx="${seg[0][0]}" cy="${seg[0][1]}" r="7" fill="var(--lk)"/>`:'';
 const ent=D.fl==='1F'?'<text x="170" y="298" text-anchor="middle" font-size="11" font-weight="700" fill="var(--tt)">▲ Entrance</text>':'';
 const card=u?`<div class="inc"><b>${u.n}</b><div class="mu">${u.f} · ${u.o}</div>${r?`<div class="ins">${r.steps.map((s,i)=>`${i+1}. ${s[0]} · ${Math.round(s[1])} m`).join('<br>')}<br><b>About ${Math.max(1,Math.round(mins(r)/72))} min on foot</b></div>`:''}<div class="g">${r?'':'<button onclick="inDir()">Directions inside</button>'}<button class="m" onclick="inAR()">AR guide</button></div></div>`:'<div class="inc"><div class="mu" style="margin:0">Tap a shop, lift or toilet on the plan.</div></div>';
 return`<div class="mh" style="padding-bottom:0"><button class="ib" aria-label="Back" onclick="back()">${ic('back',24)}</button><div style="flex:1;margin-left:6px"><b style="font-size:19px;display:block">Kigali Heights</b><span class="mu" style="font-size:13px">Indoor map · sample</span></div></div>
<div class="inf">${FS.map(f=>`<button class="${f===D.fl?'on':''}" onclick="inFl('${f}')">${f}</button>`).join('')}</div><div class="inf">${CT.map(c=>`<button class="${c[0]===D.cat?'on':''}" onclick="inCat('${c[0]}')">${c[1]}</button>`).join('')}</div>
<svg viewBox="0 0 340 310" width="100%" style="display:block;margin-top:10px" role="img" aria-label="Floor plan"><rect x="4" y="4" width="332" height="282" rx="14" fill="none" stroke="var(--ln)"/>${rects}${line}${ent}</svg>${card}<div style="height:24px"></div>`};
window.inAR=()=>{const u=cur();if(!u)return;const r=route(u);M.id.ar={r,s:0,left:r.steps[0][1],k:0,u:u.n};S.stack.push('mpar');render('push')};
const arTxt=a=>{const s=a.r.steps[a.s];return a.k<3?['Scanning your surroundings','Point the camera at the shops around you']:[s[0],Math.max(0,Math.round(a.left))+' m']};
screens.mpar=()=>{const a=M.id.ar;if(!a)return'';setTimeout(()=>{if(IN.t)return;IN.t=setInterval(()=>{if(S.stack[S.stack.length-1]!=='mpar'||!M.id.ar){clearInterval(IN.t);IN.t=null;return}const a=M.id.ar;if(a.done)return;a.k++;if(a.k>3){a.left-=3;if(a.left<=0){a.s++;if(a.s>=a.r.steps.length){a.done=true;toast('You have arrived');render('fade-none');return}a.left=a.r.steps[a.s][1]}}const t=arTxt(a),e=document.getElementById('arb');if(e)e.innerHTML=t[0]+'<small>'+t[1]+'</small>'},700)},0);
 const t=a.done?['You have arrived',a.u]:arTxt(a);
 return`<div class="arview"><div class="arb" id="arb">${t[0]}<small>${t[1]}</small></div><div class="fl"><i></i><i></i><i></i></div><div style="position:absolute;left:0;right:0;bottom:12px;text-align:center;font-size:12px;opacity:.7">Sample view. The real app uses your camera.</div></div><div class="cta"><button class="btn" onclick="inArEnd()">${a.done?'Done':'End AR guide'}</button></div>`};
window.inArEnd=()=>{clearInterval(IN.t);IN.t=null;back()};
const LM=[['Kigali Convention Centre',40,30,90,80,36,'#7C6CF0'],['Kigali Heights',170,40,60,50,64,'#4A90E2'],['Union Trade Centre',60,170,50,50,78,'#E2884A'],['BK Arena',190,190,80,80,34,'#3FB27F'],['Kigali City Tower',130,120,44,36,88,'#D95B7D']];
const box=(l,i)=>{const[n,x,y,w,d,h,c]=l,sel=M.td.sel===i;const f=(cls,st,sh)=>`<u class="${cls}" style="${st};background:${c};filter:brightness(${sh});${sel?'outline:2px solid #fff':''}"></u>`;
 return`<div class="tb" onclick="tdSel(${i})" style="left:${x}px;top:${y}px;width:${w}px;height:${d}px">${f('t',`transform:translateZ(${h}px)`,1.15)}${f('f',`left:0;top:${d}px;width:${w}px;height:${h}px`,.95)}${f('f',`left:0;top:0;width:${w}px;height:${h}px`,.8)}${f('s',`left:0;top:0;width:${h}px;height:${d}px`,.7)}${f('s',`left:${w}px;top:0;width:${h}px;height:${d}px`,.85)}</div>`};
const tf=()=>`rotateX(${M.td.tilt}deg) rotateZ(${M.td.rot}deg)`;
window.tdSel=i=>{if(window.__tdm)return;M.td.sel=M.td.sel===i?null:i;render('fade-none')};
window.tdSet=(r,t)=>{M.td.rot+=r;M.td.tilt=Math.max(0,Math.min(75,M.td.tilt+t));const e=document.getElementById('tds');if(e)e.style.transform=tf()};
screens.mp3d=()=>{const s=M.td.sel!=null?LM[M.td.sel]:null;
 setTimeout(()=>{const e=document.getElementById('td');if(!e||e.__b)return;e.__b=1;let px=null,py=null;e.onpointerdown=ev=>{px=ev.clientX;py=ev.clientY;window.__tdm=false};e.onpointermove=ev=>{if(px==null)return;const dx=ev.clientX-px,dy=ev.clientY-py;if(Math.abs(dx)+Math.abs(dy)>3)window.__tdm=true;px=ev.clientX;py=ev.clientY;tdSet(dx*.5,-dy*.4)};e.onpointerup=e.onpointerleave=()=>{px=null;setTimeout(()=>{window.__tdm=false},50)}},0);
 return`<div class="mh" style="padding-bottom:0"><button class="ib" aria-label="Back" onclick="back()">${ic('back',24)}</button><div style="flex:1;margin-left:6px"><b style="font-size:19px;display:block">3D view</b><span class="mu" style="font-size:13px">Kigali landmarks · drawn sample</span></div></div>
<div class="td" id="td"><div class="tds" id="tds" style="transform:${tf()}">${LM.map(box).join('')}</div></div>
<div class="inf"><button onclick="tdSet(-30,0)">⟲ Turn</button><button onclick="tdSet(30,0)">⟳ Turn</button><button onclick="tdSet(0,-15)">Flatter</button><button onclick="tdSet(0,15)">Steeper</button></div>
<div class="inc"><b>${s?s[0]:'Drag to look around'}</b><div class="mu">${s?s[5]+' m tall (sample)':'Turn it sideways, tilt it up and down, tap a block for its name.'}</div></div>`};
screens.mapview=function(){const h=String(_mv.apply(this,arguments)),T=document.createElement('div');T.innerHTML=h;
 try{const row=T.querySelector('.mpx');if(!row||T.querySelector('[onclick="mpGo(\'mpindoor\')"]'))return h;const b=row.querySelector('button');if(!b)return h;
  [['mpindoor','🏬 Indoor'],['mp3d','🏙️ 3D']].forEach(x=>{const c=b.cloneNode(true);c.setAttribute('onclick',"mpGo('"+x[0]+"')");c.textContent=x[1];row.appendChild(c)})}catch(e){return h}
 return T.innerHTML};
})()}catch(x){console.error('naver-v593',x)}
</script>
<script>
/* v594: Naver Maps domain 11, Parking and EV. A "Parking" chip on the map opens two tabs. Parking: four lots with free spaces now (Plenty, Few, Full; they shift every 3 minutes), the price per hour and the distance. Tap a lot: pick hours (1 to 8), see the fee, and Reserve (held 15 minutes; Cancel). "Save where I parked" keeps the lot and level, then shows time parked and the fee so far. EV charging: four chargers with connector, kW, free ports and price per kWh; filters All, Fast (50 kW and up) and Available. Start charging shows the battery rising, kWh and cost, and Stop gives the total. English only; spaces, ports, prices and the charging speed are sample data. */
try{(()=>{
const M=S.mp,_mv=screens.mapview;
M.pk=M.pk||{tab:'park',sel:0,hrs:2,res:null,car:null,lvl:'P1',f:'all',chg:null,last:null};
const PK=window.__pk={t:null};
const st=document.createElement('style');
st.textContent='#phone .pkb{height:10px;border-radius:5px;background:var(--ln);margin-top:10px;overflow:hidden}#phone .pkb i{display:block;height:100%;background:#2BA84A;border-radius:5px}#phone .pks{display:flex;align-items:center;justify-content:center;gap:18px;margin-top:10px}#phone .pks button{width:40px;height:40px;border:0;border-radius:20px;background:var(--bg);color:var(--tx);font:inherit;font-size:20px;font-weight:700}#phone .pks b{font-size:20px;min-width:60px;text-align:center}';
document.head.appendChild(st);
const LT=[['Kigali Heights Parking',.6,500,40],['Union Trade Centre',1.1,400,30],['Nyarugenge Open Lot',1.9,300,60],['City Market Garage',2.4,600,80]];
const CH=[['Convention Centre EV Point',1.4,22,'Type 2',4,350],['Remera Mall Charger',2.3,7,'Type 2',2,300],['Kacyiru Hub',3,50,'CCS',4,420],['Airport Fast Charge',9.8,60,'CCS',6,450]];
const tk=()=>Math.floor(Date.now()/180000);
const fr=(i,cap,k)=>(tk()*(i+3)+i*11+(k||0))%(cap+1);
const stt=(f,cap)=>f===0?['Full','#E5484D']:f<=cap*.15?['Few left','#F5A524']:['Plenty','#2BA84A'];
const rwf=n=>Math.round(n).toLocaleString('en-US');
const pct=()=>{const c=M.pk.chg;return c?Math.min(100,20+(Date.now()-c.t)/1000*CH[c.i][2]*.04):0};
const sum=()=>{const c=M.pk.chg,p=pct(),k=(p-20)/100*40;return{p,k,cost:k*CH[c.i][5]}};
window.pkTab=t=>{M.pk.tab=t;render('fade-none')};window.pkSel=i=>{M.pk.sel=i;render('fade-none')};
window.pkHrs=d=>{M.pk.hrs=Math.max(1,Math.min(8,M.pk.hrs+d));render('fade-none')};
window.pkRes=()=>{const l=LT[M.pk.sel];M.pk.res={i:M.pk.sel,h:M.pk.hrs,t:Date.now()};toast('Space held at '+l[0]+' for 15 minutes');render('fade-none')};
window.pkCancel=()=>{M.pk.res=null;toast('Reservation cancelled');render('fade-none')};
window.pkLvl=l=>{M.pk.lvl=l;render('fade-none')};
window.pkSave=()=>{M.pk.car={i:M.pk.sel,l:M.pk.lvl,t:Date.now()};toast('Saved where you parked');render('fade-none')};
window.pkClear=()=>{M.pk.car=null;render('fade-none')};
window.pkF=f=>{M.pk.f=f;render('fade-none')};
window.pkStart=i=>{M.pk.chg={i,t:Date.now()};render('fade-none')};
window.pkStop=()=>{const s=sum();M.pk.last='Last session: '+s.k.toFixed(1)+' kWh · RWF '+rwf(s.cost);M.pk.chg=null;toast('Charging stopped · RWF '+rwf(s.cost));render('fade-none')};
screens.mpparking=()=>{const P=M.pk,t=P.tab;
 setTimeout(()=>{if(PK.t)return;PK.t=setInterval(()=>{if(S.stack[S.stack.length-1]!=='mpparking'){clearInterval(PK.t);PK.t=null;return}const c=P.chg,e=x=>document.getElementById(x);if(c&&e('pkp')){const s=sum();e('pkp').textContent=Math.round(s.p)+'%';e('pkbar').style.width=s.p+'%';e('pkk').textContent=s.k.toFixed(1)+' kWh · RWF '+rwf(s.cost)}if(P.car&&e('pkc')){const m=Math.floor((Date.now()-P.car.t)/60000),r=LT[P.car.i][2];e('pkc').textContent='Parked '+m+' min · fee so far RWF '+rwf(Math.max(1,Math.ceil(m/60))*r)}},1000)},0);
 let body='';
 if(t==='park'){const l=LT[P.sel],f=fr(P.sel,l[3]),r=P.res;
  const rows=LT.map((x,i)=>{const f=fr(i,x[3]),s=stt(f,x[3]);return`<div class="dvr tap ${i===P.sel?'on':''}" onclick="pkSel(${i})"><i>🅿️</i><div><b>${x[0]}</b><span>${x[1]} km · RWF ${x[2]}/h</span><br><em style="color:${s[1]}">${s[0]} · ${f} of ${x[3]} free</em></div></div>`}).join('');
  const rc=r?`<div class="inc"><b>Space held</b><div class="mu">${LT[r.i][0]} · ${r.h} h · RWF ${rwf(LT[r.i][2]*r.h)} · held 15 min</div><div class="g"><button onclick="pkCancel()">Cancel</button></div></div>`:'';
  const cc=P.car?`<div class="inc"><b>Your car · ${LT[P.car.i][0]}, ${P.car.l}</b><div class="mu" id="pkc">Parked 0 min · fee so far RWF ${rwf(LT[P.car.i][2])}</div><div class="g"><button onclick="pkClear()">I have left</button></div></div>`:'';
  body=`${rc}${cc}<div class="dvh">Parking near you</div>${rows}<div class="inc"><b>${l[0]}</b><div class="pks"><button onclick="pkHrs(-1)" aria-label="Fewer hours">−</button><b>${P.hrs} h</b><button onclick="pkHrs(1)" aria-label="More hours">+</button></div><div class="mu" style="text-align:center;margin-top:8px">Fee RWF ${rwf(l[2]*P.hrs)}</div><div class="g"><button class="m" ${f?'':'disabled style="opacity:.4"'} onclick="pkRes()">${f?'Reserve a space':'Lot is full'}</button></div></div><div class="inf" style="padding-top:12px">${['P1','P2','P3'].map(v=>`<button class="${v===P.lvl?'on':''}" onclick="pkLvl('${v}')">${v}</button>`).join('')}<button onclick="pkSave()">📍 Save where I parked</button></div>`}
 else{const c=P.chg,cs=c?sum():null;
  const chg=c?`<div class="inc"><b>⚡ Charging at ${CH[c.i][0]}</b><div style="font-size:34px;font-weight:800;margin-top:6px" id="pkp">${Math.round(cs.p)}%</div><div class="pkb"><i id="pkbar" style="width:${cs.p}%"></i></div><div class="mu" id="pkk" style="margin-top:8px">${cs.k.toFixed(1)} kWh · RWF ${rwf(cs.cost)}</div><div class="g"><button class="m" onclick="pkStop()">Stop charging</button></div></div>`:(P.last?`<div class="dvn">${P.last}</div>`:'');
  const rows=CH.map((x,i)=>({x,i,f:fr(i,x[4],2)})).filter(o=>P.f==='fast'?o.x[2]>=50:P.f==='free'?o.f>0:true).map(o=>{const s=stt(o.f,o.x[4]);return`<div class="dvr"><i>🔌</i><div><b>${o.x[0]}</b><span>${o.x[1]} km · ${o.x[3]} · ${o.x[2]} kW · RWF ${o.x[5]}/kWh</span><br><em style="color:${s[1]}">${o.f} of ${o.x[4]} ports free</em></div><button ${o.f&&!c?'':'disabled style="opacity:.4"'} onclick="pkStart(${o.i})">Start</button></div>`}).join('')||'<div class="dvn">No chargers match.</div>';
  body=`${chg}<div class="inf">${[['all','All'],['fast','Fast 50 kW+'],['free','Available']].map(f=>`<button class="${f[0]===P.f?'on':''}" onclick="pkF('${f[0]}')">${f[1]}</button>`).join('')}</div>${rows}`}
 return`<div class="mh" style="padding-bottom:0"><button class="ib" aria-label="Back" onclick="back()">${ic('back',24)}</button><b style="flex:1;font-size:19px;margin-left:6px">Parking and EV</b></div><div class="inf">${[['park','🅿️ Parking'],['ev','🔌 EV charging']].map(x=>`<button class="${x[0]===t?'on':''}" onclick="pkTab('${x[0]}')">${x[1]}</button>`).join('')}</div>${body}<div class="dvn" style="padding-bottom:24px">Sample spaces, ports and prices.</div>`};
screens.mapview=function(){const h=String(_mv.apply(this,arguments)),T=document.createElement('div');T.innerHTML=h;
 try{const row=T.querySelector('.mpx');if(!row||T.querySelector('[onclick="mpGo(\'mpparking\')"]'))return h;const b=row.querySelector('button');if(!b)return h;const c=b.cloneNode(true);c.setAttribute('onclick',"mpGo('mpparking')");c.textContent='🅿️ Parking';row.appendChild(c)}catch(e){return h}
 return T.innerHTML};
})()}catch(x){console.error('naver-v594',x)}
</script>
<script>
/* v595: Naver Maps domain 12, Offline maps and Share my location. Two chips on the map. "Offline": five areas (Kigali City, Nyarugenge, Gasabo, Musanze, Huye) with their size; Download shows a progress bar for about 4 seconds, then Downloaded with Update and Delete; the top shows the space maps use; switches for Wi-Fi only and Auto-update. "Share": pick people (Aline M., Eric N., Family group), pick how long (15 min, 1 hour, 8 hours, Until I arrive), switches for Show battery and Tell them when I arrive; Start sharing shows who, a live countdown (or "until you arrive"), Stop sharing, and for Until I arrive a demo button that tells them you arrived. English only; sizes, people and the sharing are sample, nothing is really sent. */
try{(()=>{
const M=S.mp,_mv=screens.mapview;
M.of=M.of||{a:{},wifi:true,auto:true};M.sh=M.sh||{who:{},dur:'1h',bat:true,arr:true,act:null};
const OT={t:null};
const st=document.createElement('style');
st.textContent='#phone .dvr button.tg{width:48px;height:28px;padding:0;border-radius:14px;background:var(--ln)}#phone .dvr button.tg i{position:absolute;top:3px;left:3px;width:22px;height:22px;border-radius:11px;background:#fff;transition:.15s}#phone .dvr button.tg{position:relative}#phone .dvr button.tg.on{background:var(--lk)}#phone .dvr button.tg.on i{left:23px}#phone .dvr button.gh{background:var(--chip);color:var(--tx);padding:0 10px;font-size:12px}';
document.head.appendChild(st);
const AR=[['kgl','Kigali City',180],['nyr','Nyarugenge',96],['gsb','Gasabo',120],['mzs','Musanze',74],['hye','Huye',66]];
const PP=[['al','Aline M.','👩🏾'],['er','Eric N.','👨🏿'],['fm','Family group','👪']];
const DU={'15m':['15 min',15*60],'1h':['1 hour',3600],'8h':['8 hours',8*3600],'arr':['Until I arrive',0]};
const prog=a=>{const x=M.of.a[a];if(!x)return 0;if(x.s==='done')return 1;const p=Math.min(1,(Date.now()-x.t)/4000);if(p>=1)x.s='done';return p};
const used=()=>AR.reduce((n,a)=>n+(prog(a[0])>=1?a[2]:0),0);
const mm=s=>Math.floor(s/60)+':'+String(s%60).padStart(2,'0');
window.ofDl=id=>{M.of.a[id]={s:'dl',t:Date.now()};render('fade-none')};
window.ofDel=id=>{delete M.of.a[id];toast('Offline map deleted');render('fade-none')};
window.ofUp=id=>{M.of.a[id]={s:'dl',t:Date.now()};toast('Updating');render('fade-none')};
window.ofTg=k=>{M.of[k]=!M.of[k];render('fade-none')};
window.shWho=id=>{M.sh.who[id]=!M.sh.who[id];render('fade-none')};
window.shDur=d=>{M.sh.dur=d;render('fade-none')};
window.shTg=k=>{M.sh[k]=!M.sh[k];render('fade-none')};
window.shStart=()=>{const w=PP.filter(p=>M.sh.who[p[0]]).map(p=>p[1]),d=DU[M.sh.dur];if(!w.length)return;M.sh.act={w,d:M.sh.dur,end:d[1]?Date.now()+d[1]*1000:0};toast('Sharing your location with '+w.join(', '));render('fade-none')};
window.shStop=()=>{M.sh.act=null;toast('Stopped sharing');render('fade-none')};
window.shArr=()=>{const w=M.sh.act.w.join(', ');M.sh.act=null;toast(M.sh.arr?w+' was told you arrived':'Sharing ended');render('fade-none')};
const tick=(fn)=>{setTimeout(()=>{if(OT.t)return;OT.t=setInterval(()=>{const top=S.stack[S.stack.length-1];if(top!=='mpoffline'&&top!=='mpshare'){clearInterval(OT.t);OT.t=null;return}fn()},500)},0)};
const hd=(t)=>`<div class="mh" style="padding-bottom:0"><button class="ib" aria-label="Back" onclick="back()">${ic('back',24)}</button><b style="flex:1;font-size:19px;margin-left:6px">${t}</b></div>`;
const tg=(on,f,l)=>`<button class="tg ${on?'on':''}" role="switch" aria-checked="${!!on}" aria-label="${l}" onclick="${f}"><i></i></button>`;
screens.mpoffline=()=>{tick(()=>{AR.forEach(a=>{const x=M.of.a[a[0]];if(!x)return;const p=prog(a[0]),b=document.getElementById('ob'+a[0]),t=document.getElementById('ot'+a[0]);if(x.s==='dl'&&b)b.style.width=Math.round(p*100)+'%';if(x.s==='dl'&&t)t.textContent='Downloading '+Math.round(p*100)+'%';if(p>=1&&x.s==='done'&&b)render('fade-none')})});
 const rows=AR.map(a=>{const x=M.of.a[a[0]],p=prog(a[0]),dl=x&&p<1,dn=x&&p>=1;
  return`<div class="dvr"><i>🗺️</i><div><b>${a[1]}</b><span id="ot${a[0]}">${dl?'Downloading '+Math.round(p*100)+'%':dn?'Downloaded · '+a[2]+' MB':a[2]+' MB'}</span>${dl?`<div class="pkb"><i id="ob${a[0]}" style="width:${Math.round(p*100)}%"></i></div>`:''}</div>${dn?`<button class="gh" onclick="ofUp('${a[0]}')">Update</button><button class="gh" onclick="ofDel('${a[0]}')">Delete</button>`:dl?'':`<button onclick="ofDl('${a[0]}')">Download</button>`}</div>`}).join('');
 return`${hd('Offline maps')}<div class="inc"><b>${used()} MB used</b><div class="mu">Offline maps work with no internet: places, search and walking routes in the area.</div></div><div class="dvh">Areas</div>${rows}<div class="dvh">Settings</div><div class="dvr"><div><b>Download on Wi-Fi only</b><span>Saves your mobile data</span></div>${tg(M.of.wifi,"ofTg('wifi')",'Wi-Fi only')}</div><div class="dvr"><div><b>Update automatically</b><span>When new map data is out</span></div>${tg(M.of.auto,"ofTg('auto')",'Auto-update')}</div><div class="dvn" style="padding-bottom:24px">Sample sizes and downloads.</div>`};
screens.mpshare=()=>{const H=M.sh,a=H.act;tick(()=>{const e=document.getElementById('shc');if(!a||!e||!H.act)return;if(H.act.end){const s=Math.max(0,Math.round((H.act.end-Date.now())/1000));e.textContent=s?mm(s)+' left':'Ended';if(!s){H.act=null;toast('Sharing ended');render('fade-none')}}});
 if(a)return`${hd('Share my location')}<div class="inc"><b>📡 Sharing with ${a.w.join(', ')}</b><div class="mu" id="shc">${a.end?mm(Math.max(0,Math.round((a.end-Date.now())/1000)))+' left':'Until you arrive'}</div><div class="mu">${H.bat?'Battery level shown · ':''}Updated just now</div><div class="g"><button class="m" onclick="shStop()">Stop sharing</button></div>${a.end?'':'<div class="g"><button onclick="shArr()">I have arrived (demo)</button></div>'}</div><div class="dvn">They see where you are on their map until it ends. You can stop at any time.</div>`;
 const rows=PP.map(p=>`<div class="dvr tap ${H.who[p[0]]?'on':''}" onclick="shWho('${p[0]}')"><i>${H.who[p[0]]?'✓':p[2]}</i><div><b>${p[1]}</b></div></div>`).join('');
 const n=PP.filter(p=>H.who[p[0]]).length;
 return`${hd('Share my location')}<div class="dvh">Who can see it?</div>${rows}<div class="dvh">For how long?</div><div class="inf">${Object.keys(DU).map(k=>`<button class="${k===H.dur?'on':''}" onclick="shDur('${k}')">${DU[k][0]}</button>`).join('')}</div><div class="dvr" style="margin-top:8px"><div><b>Show battery level</b></div>${tg(H.bat,"shTg('bat')",'Show battery')}</div><div class="dvr"><div><b>Tell them when I arrive</b></div>${tg(H.arr,"shTg('arr')",'Arrival notice')}</div><div class="cta"><button class="btn" ${n?'':'disabled'} onclick="shStart()">${n?'Start sharing':'Pick someone first'}</button></div><div style="height:90px"></div>`};
screens.mapview=function(){const h=String(_mv.apply(this,arguments)),T=document.createElement('div');T.innerHTML=h;
 try{const row=T.querySelector('.mpx');if(!row||T.querySelector('[onclick="mpGo(\'mpoffline\')"]'))return h;const b=row.querySelector('button');if(!b)return h;
  [['mpoffline','⬇️ Offline'],['mpshare','📡 Share']].forEach(x=>{const c=b.cloneNode(true);c.setAttribute('onclick',"mpGo('"+x[0]+"')");c.textContent=x[1];row.appendChild(c)})}catch(e){return h}
 return T.innerHTML};
})()}catch(x){console.error('naver-v595',x)}
</script>
<script>
/* v596: Naver Maps domain 13, Share a saved list. Naver lets you share a bookmark folder. On Saved places a "Share this folder" row sits under the folder chips (All, Favorites, Want to go, Lunch spots). It opens Share list: the folder and its places, who can open it (Private, Anyone with the link, Public), a switch to let others add places, the link with Copy, Send to Aline M., Eric N. or Family group (the button turns into Sent), and how many people opened it. A shared folder shows a link mark on its chip. Choosing Private stops sharing. English only; the link and the people are sample, nothing is really sent. */
try{(()=>{
const M=S.mp,_sv=screens.mpsaved;
M.sl=M.sl||{};
const FD=['All','⭐ Favorites','📌 Want to go','🍽️ Lunch spots'],PP=['Aline M.','Eric N.','Family group'];
const st=document.createElement('style');
st.textContent='#phone .slr{display:flex;align-items:center;gap:10px;margin:0 20px 8px;padding:12px 14px;border-radius:16px;background:var(--chip);font-weight:700;font-size:14px}#phone .slr span{flex:1}#phone .slr button{height:34px;padding:0 14px;border:0;border-radius:17px;background:var(--lk);color:#fff;font:inherit;font-weight:700;font-size:13px}#phone .slo{display:flex;align-items:center;gap:12px;padding:12px 24px}#phone .slo>i{flex:none;width:22px;height:22px;border-radius:11px;border:2px solid var(--ln);box-sizing:border-box}#phone .slo.on>i{border:7px solid var(--lk)}#phone .slo div{flex:1}#phone .slo b{display:block;font-size:15px}#phone .slo small{font-size:13px;color:var(--tt)}#phone .slk{display:flex;align-items:center;gap:10px;margin:8px 24px 0;padding:12px 14px;border-radius:14px;background:var(--chip);font-size:14px;font-weight:700}#phone .slk span{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}#phone .slk button{height:32px;padding:0 12px;border:0;border-radius:16px;background:var(--bg);color:var(--tx);font:inherit;font-weight:700;font-size:13px}#phone .slk button[disabled]{opacity:.5}';
document.head.appendChild(st);
const sv=id=>id==='cafe'?!!M.star:!!(M.sv&&M.sv[id]);
const places=k=>(window.POI||[]).filter(p=>sv(p.id)&&(k===0||((M.fd&&M.fd[p.id])||0)===k-1));
const cfg=k=>M.sl[k]=M.sl[k]||{vis:'private',add:false,sent:{}};
const lnk=k=>'itunda.rw/l/'+(FD[k]+k).split('').reduce((a,c)=>(a*31+c.charCodeAt(0))%1679616,7).toString(36).padStart(4,'k');
window.slOpen=()=>{M.slk=M.sf||0;mpGo('mpshlist')};
window.slVis=v=>{const c=cfg(M.slk);c.vis=v;if(v==='private')c.sent={};toast(v==='private'?'Stopped sharing':'Anyone '+(v==='link'?'with the link':'on itunda')+' can open this list');render('fade-none')};
window.slAdd=()=>{const c=cfg(M.slk);c.add=!c.add;render('fade-none')};
window.slCopy=()=>{try{navigator.clipboard&&navigator.clipboard.writeText('https://'+lnk(M.slk))}catch(e){}toast('Link copied')};
window.slSend=i=>{cfg(M.slk).sent[i]=true;toast('Sent to '+PP[i]);render('fade-none')};
screens.mpsaved=function(){const h=String(_sv.apply(this,arguments)),T=document.createElement('div');T.innerHTML=h;
 try{const bar=T.querySelector('.nb.sf');if(!bar||T.querySelector('.slr'))return h;const k=M.sf||0,c=M.sl[k];
  [...bar.querySelectorAll('button')].forEach((b,i)=>{if(M.sl[i]&&M.sl[i].vis!=='private')b.insertAdjacentHTML('beforeend',' 🔗')});
  bar.insertAdjacentHTML('afterend',`<div class="slr"><span>${c&&c.vis!=='private'?'🔗 Shared · '+(c.vis==='link'?'anyone with the link':'public'):'Share '+FD[k].replace(/^All$/,'all saved places')}</span><button onclick="slOpen()">${c&&c.vis!=='private'?'Manage':'Share'}</button></div>`)}catch(e){return h}
 return T.innerHTML};
screens.mpshlist=()=>{const k=M.slk||0,c=cfg(k),ps=places(k),on=c.vis!=='private';
 const o=(v,t,s)=>`<div class="slo tap ${c.vis===v?'on':''}" onclick="slVis('${v}')"><i></i><div><b>${t}</b><small>${s}</small></div></div>`;
 const names=ps.slice(0,3).map(p=>p.n).join(', ')+(ps.length>3?' and '+(ps.length-3)+' more':'');
 return`<div class="mh" style="padding-bottom:0"><button class="ib" aria-label="Back" onclick="back()">${ic('back',24)}</button><b style="flex:1;font-size:19px;margin-left:6px">Share list</b></div>
<div class="inc"><b>${FD[k]}</b><div class="mu">${ps.length} place${ps.length===1?'':'s'}${names?' · '+names:''}</div></div>
<div class="dvh">Who can open it?</div>${o('private','Only me','Not shared')}${o('link','Anyone with the link','People you send it to')}${o('public','Public','Anyone on itunda can find it')}
${on?`<div class="dvr"><div><b>Let people add places</b><span>They can add to this list</span></div><button class="tg ${c.add?'on':''}" role="switch" aria-checked="${c.add}" aria-label="Let people add places" onclick="slAdd()"><i></i></button></div>
<div class="slk"><span>${lnk(k)}</span><button onclick="slCopy()">Copy</button></div>
<div class="dvh">Send to</div>${PP.map((n,i)=>`<div class="slk" style="background:none;padding:6px 0"><span>${n}</span><button style="background:${c.sent[i]?'var(--chip)':'var(--lk)'};color:${c.sent[i]?'var(--tt)':'#fff'}" ${c.sent[i]?'disabled':''} onclick="slSend(${i})">${c.sent[i]?'Sent':'Send'}</button></div>`).join('')}
<div class="dvn">${3+Object.keys(c.sent).length*2} people opened this list this week (sample).</div>`:'<div class="dvn">Choose who can open this list. Only you can change it.</div>'}<div style="height:30px"></div>`};
})()}catch(x){console.error('naver-v596',x)}
</script>
<script>
/* v597: Naver Maps domain 14, Report a map error. A "Fix map" chip opens a short report flow like Naver's map-correction page. Step 1: what is wrong (Missing place, Road problem, Wrong place location, Something else). Step 2 changes with the choice: Missing place (name, kind, tap the map to drop a pin), Road problem (which road, what is wrong, tap the map), Wrong place location (pick the place, tap its right spot), Something else (a note). The pin shows "near KG 9 Ave". Send stays off until the form is complete; then the report joins "Your reports" as Under review, and Withdraw removes it. English only; the map is a drawn sample and nothing is really sent. */
try{(()=>{
const M=S.mp,_mv=screens.mapview;
M.fx=M.fx||{step:0,type:null,name:'',cat:null,pin:null,note:'',road:null,iss:null,place:null,rep:[]};
const F=M.fx;
const st=document.createElement('style');
st.textContent='#phone .fxm{display:block;overflow:hidden;margin:10px 20px 0;width:calc(100% - 40px);border-radius:16px;background:var(--chip);touch-action:manipulation}#phone .fxl{display:block;padding:12px 24px 4px;font-size:14px;font-weight:700}#phone .fxi{margin:0 24px;width:calc(100% - 48px)}';
document.head.appendChild(st);
const TY=[['place','📍','Missing place','A shop, cafe or service is not on the map'],['road','🚧','Road problem','Closed, one-way, missing or wrong name'],['move','🧭','Wrong place location','A place is in the wrong spot'],['other','💬','Something else','Tell us what you saw']];
const RD=[['KG 7 Ave','h',70],['KG 11 Ave','h',150],['KN 2 Rd','v',110],['KG 9 Ave','v',240]];
const near=p=>RD.map(r=>[r[0],Math.abs(r[1]==='h'?p[1]-r[2]:p[0]-r[2])]).sort((a,b)=>a[1]-b[1])[0][0];
const reset=()=>{Object.assign(F,{step:0,type:null,name:'',cat:null,pin:null,note:'',road:null,iss:null,place:null})};
window.fxType=t=>{F.type=t;F.step=1;render('fade-none')};
window.fxBack=()=>{F.step=0;render('fade-none')};
window.fxSet=(k,v)=>{F[k]=v;render('fade-none')};
window.fxIn=(k,v)=>{F[k]=v;const b=document.getElementById('fxs');if(b)b.disabled=!ok()};
window.fxPin=e=>{const r=e.currentTarget.getBoundingClientRect();F.pin=[Math.round((e.clientX-r.left)/r.width*340),Math.round((e.clientY-r.top)/r.height*220)];render('fade-none')};
const ok=()=>{const t=F.type;return t==='place'?F.name.trim().length>=2&&F.cat&&F.pin:t==='road'?F.road&&F.iss&&F.pin:t==='move'?F.place&&F.pin:t==='other'?F.note.trim().length>=5:false};
window.fxSend=()=>{if(!ok())return;const t=TY.find(x=>x[0]===F.type),s=F.type==='place'?F.name.trim():F.type==='road'?F.road+' · '+F.iss:F.type==='move'?F.place:F.note.trim().slice(0,30);F.rep.unshift({t:t[2],s,w:F.pin?near(F.pin):''});reset();toast('Thanks. Your report is under review.');render('fade-none')};
window.fxDel=i=>{F.rep.splice(i,1);toast('Report withdrawn');render('fade-none')};
const chips=(k,a,v)=>`<div class="inf" style="padding-top:4px">${a.map(x=>`<button class="${x===v?'on':''}" onclick="fxSet('${k}','${x}')">${x}</button>`).join('')}</div>`;
const map=()=>`<div class="fxm" onclick="fxPin(event)" role="button" aria-label="Tap the map to drop a pin"><svg viewBox="0 0 340 220" width="100%" style="display:block"><rect width="340" height="220" fill="var(--chip)" rx="16"/><g stroke="var(--bg)" stroke-width="12" fill="none"><path d="M0 70H340M0 150H340M110 0V220M240 0V220"/></g><g font-size="10" font-weight="700" fill="var(--tt)"><text x="8" y="66">KG 7 Ave</text><text x="8" y="146">KG 11 Ave</text><text x="114" y="12">KN 2 Rd</text><text x="244" y="12">KG 9 Ave</text></g>${F.pin?`<circle cx="${F.pin[0]}" cy="${F.pin[1]}" r="9" fill="#E5484D" stroke="#fff" stroke-width="3"/>`:''}</svg></div><div class="dvn" style="padding-top:6px">${F.pin?'Pin dropped near '+near(F.pin):'Tap the map to drop a pin.'}</div>`;
screens.mpfix=()=>{
 const hd=`<div class="mh" style="padding-bottom:0"><button class="ib" aria-label="Back" onclick="${F.step?'fxBack()':'back()'}">${ic('back',24)}</button><b style="flex:1;font-size:19px;margin-left:6px">Report a map error</b></div>`;
 if(!F.step){const reps=F.rep.map((r,i)=>`<div class="dvr"><i>📝</i><div><b>${r.s}</b><span>${r.t}${r.w?' · near '+r.w:''}</span><br><em style="color:#F5A524">Under review</em></div><button class="gh" onclick="fxDel(${i})">Withdraw</button></div>`).join('');
  return`${hd}<div class="dvh">What is wrong?</div>${TY.map(t=>`<div class="dvr tap" onclick="fxType('${t[0]}')"><i>${t[1]}</i><div><b>${t[2]}</b><span>${t[3]}</span></div></div>`).join('')}${reps?`<div class="dvh">Your reports</div>${reps}`:''}<div class="dvn" style="padding-bottom:24px">Reports are checked before the map changes.</div>`}
 const t=F.type,P=(window.POI||[]).slice(0,5).map(p=>p.n);let f='';
 if(t==='place')f=`<span class="fxl">Name of the place</span><input class="in fxi" aria-label="Name of the place" placeholder="For example, Green Bowl" value="${F.name.replace(/"/g,'&quot;')}" oninput="fxIn('name',this.value)"><span class="fxl">What kind of place?</span>${chips('cat',['Food','Cafe','Shop','Service','Other'],F.cat)}<span class="fxl">Where is it?</span>${map()}`;
 if(t==='road')f=`<span class="fxl">Which road?</span>${chips('road',RD.map(r=>r[0]),F.road)}<span class="fxl">What is wrong?</span>${chips('iss',['Closed','Wrong one-way','Road missing','Wrong name'],F.iss)}<span class="fxl">Where?</span>${map()}`;
 if(t==='move')f=`<span class="fxl">Which place?</span>${chips('place',P,F.place)}<span class="fxl">Where is it really?</span>${map()}`;
 if(t==='other')f=`<span class="fxl">What did you see?</span><input class="in fxi" aria-label="What did you see" placeholder="Write a short note" value="${F.note.replace(/"/g,'&quot;')}" oninput="fxIn('note',this.value)">`;
 return`${hd}<div class="dvh">${TY.find(x=>x[0]===t)[2]}</div>${f}<div class="cta"><button class="btn" id="fxs" ${ok()?'':'disabled'} onclick="fxSend()">Send report</button></div><div style="height:90px"></div>`};
screens.mapview=function(){const h=String(_mv.apply(this,arguments)),T=document.createElement('div');T.innerHTML=h;
 try{const row=T.querySelector('.mpx');if(!row||T.querySelector('[onclick="mpGo(\'mpfix\')"]'))return h;const b=row.querySelector('button');if(!b)return h;const c=b.cloneNode(true);c.setAttribute('onclick',"mpGo('mpfix')");c.textContent='🛠️ Fix map';row.appendChild(c)}catch(e){return h}
 return T.innerHTML};
})()}catch(x){console.error('naver-v597',x)}
/* v598: Naver Maps domain 15, Walking navigation. Naver added real-time voice-guided walking directions in 2026, with bus links and indoor guidance. A "Walk" chip on the map opens it. (1) Where to?: places with the walking time and the same "Open when you arrive" check as Drive; tap one to pick it. (2) Route card: "Walk only" or, when the walk is over about 12 minutes, "Walk + bus" (walk to the stop, bus 305 in 4 min, ride, short walk), with a leg bar, arrival time and distance. (3) Voice guidance and Avoid stairs switches (Avoid stairs swaps the overpass and the underpass for ramps and street-level crossings). (4) Start walking opens turn-by-turn: a big next-turn card with the distance, the drawn route with a moving dot, left and arrival time, a progress bar, and spoken lines about 100 m before each turn ("In 90 meters, use the pedestrian overpass") using the phone's speech if it has one. Pause, Voice on or off, and a Live view switch (a camera-style view with a big arrow) sit under the map. At the end: "You have arrived", or for Walk + bus "At the bus stop" with the bus time. (5) Your walks: finished walks with distance and time, and a km total for the week. Indoor guide opens the indoor map. English only; routes, bus times and weekly km are sample data and the walk is a simulation. */
try{(()=>{
const M=S.mp,_mv=screens.mapview;
M.wk=M.wk||{sel:null,plan:'walk',voice:true,ns:false,run:null,hist:[]};
const K=M.wk,WK={t:null};
const st=document.createElement('style');
st.textContent='#phone .wkb{display:flex;align-items:center;gap:14px;margin:12px 20px 0;padding:16px;border-radius:20px;background:var(--lk);color:#fff}#phone .wkb i{font-style:normal;font-size:40px;flex:none;width:56px;text-align:center}#phone .wkb b{display:block;font-size:26px;font-weight:800}#phone .wkb span{font-size:15px}#phone .wkm{margin:10px 20px 0;border-radius:20px;background:var(--chip);overflow:hidden}#phone .wkl{display:none;height:226px;background:#14181F;color:#fff;align-items:center;justify-content:center;flex-direction:column;text-align:center;padding:0 16px}#phone .wkv{margin:10px 20px 0;padding:10px 14px;border-radius:14px;background:var(--chip);font-size:14px;line-height:20px;min-height:20px}#phone .wks{display:flex;justify-content:space-between;padding:12px 24px 0}#phone .wks div{text-align:center;flex:1}#phone .wks b{display:block;font-size:20px;font-weight:800}#phone .wks span{font-size:12px;color:var(--tt)}#phone .wkg{height:6px;border-radius:3px;background:var(--chip);margin:12px 24px 0;overflow:hidden}#phone .wkg i{display:block;height:100%;background:var(--lk);width:0}#phone .wkc{display:flex;gap:8px;padding:12px 20px 0}#phone .wkc button{flex:1;height:44px;border:1px solid var(--ln);border-radius:22px;background:none;color:var(--tx);font:inherit;font-weight:700;font-size:14px}#phone .wkq{display:flex;height:10px;border-radius:5px;overflow:hidden;margin-top:10px;gap:2px}#phone .wkq i{display:block;height:100%}';
document.head.appendChild(st);
const now=()=>{const d=new Date();return d.getHours()*60+d.getMinutes()};
const clk=m=>{m=((m%1440)+1440)%1440;const h=Math.floor(m/60);return (h%12||12)+':'+String(m%60).padStart(2,'0')+' '+(h<12?'am':'pm')};
const dm=p=>{const v=parseFloat(p.d)||0;return /km/i.test(p.d||'')?Math.round(v*1000):Math.round(v)};
const fm=m=>m>=1000?(m/1000).toFixed(1)+' km':Math.max(10,Math.round(m/10)*10)+' m';
const wmin=m=>Math.max(1,Math.ceil(m/80));
const dest=()=>(window.POI||[]).filter(p=>/^(cafe|food|pharm|atm)$/.test(p.c)).sort((a,b)=>dm(a)-dm(b)).slice(0,5);
const chk=(p,min)=>{const m=/closes (\d\d):(\d\d)/.exec(p.o||''),a=now()+min;if(!m)return['Open 24 hours','#2BA84A'];const c=+m[1]*60+ +m[2];return a>=c?['Closed when you arrive','#E5484D']:c-a<=30?['Closes soon after you arrive','#F5A524']:['Open when you arrive','#2BA84A']};
const plans=p=>{const m=dm(p),r={walk:{m,min:wmin(m)}};if(wmin(m)>12){const w1=Math.min(500,Math.round(m*.15/10)*10),w2=150,ride=Math.max(2,Math.round((m-w1-w2)/350)),wait=4;r.bus={w1,w2,ride,wait,min:wmin(w1)+wait+ride+wmin(w2)}}return r};
const STEPS=(ns,end)=>[[0,'⬆️','Head north on KN 2 Rd'],[.12,'⬅️','Turn left onto KG 7 Ave'],[.3,ns?'♿':'🌉',ns?'Cross at street level using the ramp':'Use the pedestrian overpass'],[.5,'🚸','Cross at the crosswalk when the signal is green'],[.66,'➡️','Turn right onto KG 11 Ave'],[.82,ns?'♿':'🚶',ns?'Keep to the step-free path':'Take the stairs down to the underpass'],[.94,'🏁',end]];
const endTx=R=>R.bus?'The bus stop is ahead on your right':'Your destination is on the left';
const view=R=>{const S0=STEPS(R.ns,endTx(R)),tot=R.total,pos=R.pos;let i=pos<R.sp*1.5?0:S0.findIndex(s=>s[0]*tot>pos+.5);if(i<0)i=S0.length-1;const s=S0[i],d=i===0?0:Math.max(0,Math.round(s[0]*tot-pos)),left=Math.max(0,tot-pos);return{i,s,d,nx:S0[i+1],last:S0.length-1,left,min:wmin(left),frac:Math.min(1,pos/tot)}};
const ge=x=>document.getElementById(x);
const say=(R,t)=>{const e=ge('wkvo');if(!R.voice){if(e)e.textContent='🔇 Voice is off';return}if(e)e.textContent='🔊 '+t;try{if(window.speechSynthesis){speechSynthesis.cancel();speechSynthesis.speak(new SpeechSynthesisUtterance(t))}}catch(x){}};
const paint=(R,v)=>{v=v||view(R);const set=(i,t)=>{const e=ge(i);if(e)e.textContent=t};set('wkic',v.s[1]);set('wkdist',v.d?fm(v.d):'Now');set('wktx',v.s[2]);set('wknx',v.nx?'Then: '+v.nx[2]:'Last step');set('wkleft',fm(v.left));set('wkmin',v.min+' min');set('wkarr',clk(now()+v.min));set('wklic',v.s[1]);set('wkltx',(v.d?fm(v.d)+' · ':'')+v.s[2]);const b=ge('wkbar');if(b)b.style.width=Math.round(v.frac*100)+'%';const p=ge('wkpath'),dn=ge('wkdone'),dot=ge('wkdot');if(p&&dot&&p.getTotalLength){const L=p.getTotalLength(),pt=p.getPointAtLength(L*v.frac);dot.setAttribute('cx',pt.x);dot.setAttribute('cy',pt.y);if(dn)dn.setAttribute('stroke-dasharray',(L*v.frac)+' '+L)}};
const low=t=>t.charAt(0).toLowerCase()+t.slice(1);
const tick=()=>{const R=K.run;if(S.stack[S.stack.length-1]!=='mpwalknav'||!R){clearInterval(WK.t);WK.t=null;return}if(R.paused||R.done)return;R.pos=Math.min(R.total,R.pos+R.sp);const v=view(R);if(R.pos>=R.total){R.done=true;K.hist.unshift({n:R.n+(R.bus?' (to the bus stop)':''),m:R.total,min:wmin(R.total),w:clk(now())});say(R,R.bus?'You have reached the bus stop':'You have arrived');clearInterval(WK.t);WK.t=null;render('fade-none');return}if(v.i>0&&v.d<=100&&!R.ann[v.i]){R.ann[v.i]=1;say(R,(v.i===v.last?'In ':'In ')+Math.max(10,Math.round(v.d/10)*10)+' meters, '+low(v.s[2]))}paint(R,v)};
window.wkSel=id=>{K.sel=id;render('fade-none')};
window.wkPlan=k=>{K.plan=k;render('fade-none')};
window.wkTog=k=>{K[k]=!K[k];render('fade-none')};
window.wkStart=()=>{const P=dest(),p=P.find(x=>x.id===K.sel)||P[0],pl=plans(p),b=K.plan==='bus'&&pl.bus,total=b?pl.bus.w1:pl.walk.m;K.run={id:p.id,n:p.n,bus:!!b,total,pos:0,sp:Math.max(12,Math.round(total/80)),ann:{},paused:false,done:false,live:false,voice:K.voice,ns:K.ns,plan:pl};mpGo('mpwalknav')};
window.wkEnd=()=>{clearInterval(WK.t);WK.t=null;const R=K.run;if(R&&!R.done&&R.pos>=R.sp)K.hist.unshift({n:R.n+(R.bus?' (to the bus stop)':''),m:Math.round(R.pos),min:wmin(R.pos),w:clk(now())});try{window.speechSynthesis&&speechSynthesis.cancel()}catch(x){}K.run=null;back()};
window.wkPause=()=>{const R=K.run;if(!R)return;R.paused=!R.paused;const e=ge('wkpa');if(e)e.textContent=R.paused?'▶ Resume':'⏸ Pause'};
window.wkVoice=()=>{const R=K.run;if(!R)return;K.voice=!K.voice;R.voice=K.voice;const e=ge('wkvb');if(e)e.textContent=K.voice?'🔊 Voice on':'🔇 Voice off';const v=ge('wkvo');if(v)v.textContent=K.voice?'🔊 Voice guidance is on':'🔇 Voice is off';if(!K.voice){try{window.speechSynthesis&&speechSynthesis.cancel()}catch(x){}}};
window.wkLive=()=>{const R=K.run;if(!R)return;R.live=!R.live;const m=ge('wkmap'),l=ge('wklive'),b=ge('wklb');if(m)m.style.display=R.live?'none':'block';if(l)l.style.display=R.live?'flex':'none';if(b)b.textContent=R.live?'🗺️ Map view':'📷 Live view'};
screens.mpwalk=()=>{
 const P=dest(),p=P.find(x=>x.id===K.sel)||P[0],pl=plans(p),ep=K.plan==='bus'&&pl.bus?'bus':'walk',cur=pl[ep],n=now();
 const rows=P.map(q=>{const mn=plans(q).walk.min,c=chk(q,mn);return`<div class="dvr tap ${q.id===p.id?'on':''}" onclick="wkSel('${q.id}')"><i>${q.e}</i><div><b>${q.n}</b><span>${mn} min walk · ${fm(dm(q))}</span><br><em style="color:${c[1]}">${c[0]}</em></div></div>`}).join('');
 const tabs=`<div class="dvt"><button class="${ep==='walk'?'on':''}" onclick="wkPlan('walk')">🚶 Walk only · ${pl.walk.min} min</button>${pl.bus?`<button class="${ep==='bus'?'on':''}" onclick="wkPlan('bus')">🚌 Walk + bus · ${pl.bus.min} min</button>`:''}</div>`;
 let legs,txt;
 if(ep==='bus'){const b=pl.bus,tot=wmin(b.w1)+b.wait+b.ride+wmin(b.w2),w=x=>Math.round(x/tot*100)+'%';legs=`<div class="wkq"><i style="width:${w(wmin(b.w1))};background:var(--tt)"></i><i style="width:${w(b.wait)};background:#F5A524"></i><i style="width:${w(b.ride)};background:var(--lk)"></i><i style="width:${w(wmin(b.w2))};background:var(--tt)"></i></div>`;txt=`Walk ${fm(b.w1)} to the stop · Bus 305 in ${b.wait} min · Ride ${b.ride} min · Walk ${b.w2} m. Walking now covers the first part.`}
 else{legs=`<div class="wkq"><i style="width:100%;background:var(--tt)"></i></div>`;txt=K.ns?'Step-free: ramps and street-level crossings, no stairs.':'Includes 1 overpass, 1 crossing and 1 underpass.'}
 const sw=(k,ic,t,s)=>`<div class="dvr"><i>${ic}</i><div><b>${t}</b><span>${s}</span></div><button onclick="wkTog('${k}')">${K[k]?'On':'Off'}</button></div>`;
 const hs=K.hist.map(h=>`<div class="dvr"><i>👣</i><div><b>${h.n}</b><span>${fm(h.m)} · ${h.min} min · ${h.w}</span></div></div>`).join('');
 const wk=(6.8+K.hist.reduce((a,h)=>a+h.m,0)/1000).toFixed(1);
 return`<div class="mh" style="padding-bottom:0"><button class="ib" aria-label="Back" onclick="back()">${ic('back',24)}</button><b style="flex:1;font-size:19px;margin-left:6px">Walk</b></div>
<div class="dvh">Where to?</div>${rows}
<div class="dvh">Route to ${p.n}</div>${tabs}
<div class="dvc"><b>${cur.min} min · ${fm(ep==='bus'?cur.w1+cur.w2:cur.m)} on foot</b><div class="dvn" style="padding:4px 0 0">Leave now and arrive about ${clk(n+cur.min)}.</div>${legs}<div class="dvn" style="padding:10px 0 0">${txt}</div><button class="btn" onclick="wkStart()">Start walking</button></div>
<div class="dvh">Settings</div>${sw('voice','🔊','Voice guidance','Spoken directions while you walk')}${sw('ns','♿','Avoid stairs','Ramps and street-level crossings')}
<div class="dvh">Inside a building?</div><div class="dvr tap" onclick="mpGo('mpindoor')"><i>🏬</i><div><b>Indoor guide</b><span>Floor plans and shops inside a mall</span></div></div>
<div class="dvh">Your walks</div>${hs||'<div class="dvn">No walks yet. Start one above.</div>'}<div class="dvn" style="padding-bottom:24px">This week: ${wk} km on foot. Sample routes and bus times.</div>`};
screens.mpwalknav=()=>{
 const R=K.run;if(!R)return`<div class="mh"><button class="ib" aria-label="Back" onclick="back()">${ic('back',24)}</button><b style="flex:1;font-size:19px;margin-left:6px">Walking</b></div><div class="dvn">No walk in progress.</div>`;
 if(R.done){const b=R.plan.bus;return`<div class="mh" style="padding-bottom:0"><b style="flex:1;font-size:19px;margin-left:24px">Walking</b></div><div class="dvc" style="text-align:center"><div style="font-size:48px">🏁</div><b style="font-size:20px">${R.bus?'At the bus stop':'You have arrived'}</b><div class="dvn" style="padding:6px 0 0">${R.bus?`Bus 305 arrives in ${b.wait} min · Seats available. Ride about ${b.ride} min, then walk ${b.w2} m to ${R.n}.`:R.n}</div><div class="dvn" style="padding:6px 0 0">You walked ${fm(R.total)} in ${wmin(R.total)} min.</div></div><div class="cta"><button class="btn" onclick="wkEnd()">Done</button></div>`}
 const v=view(R);
 setTimeout(()=>{if(!WK.t)WK.t=setInterval(tick,1000);paint(R)},0);
 return`<div class="mh" style="padding-bottom:0"><b style="flex:1;font-size:19px;margin-left:24px">Walking${R.bus?' to the bus stop':''}</b></div>
<div class="wkb"><i id="wkic">${v.s[1]}</i><div><b id="wkdist">${v.d?fm(v.d):'Now'}</b><span id="wktx">${v.s[2]}</span></div></div>
<div class="dvn" id="wknx" style="padding-top:8px">${v.nx?'Then: '+v.nx[2]:'Last step'}</div>
<div class="wkm"><div id="wkmap" style="display:${R.live?'none':'block'}"><svg viewBox="0 0 340 220" width="100%" style="display:block"><path id="wkpath" d="M30 190L30 120L120 120L120 60L250 60L250 140L310 140" fill="none" stroke="var(--bg)" stroke-width="10" stroke-linecap="round" stroke-linejoin="round"/><path id="wkdone" d="M30 190L30 120L120 120L120 60L250 60L250 140L310 140" fill="none" stroke="var(--lk)" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="0 2000"/><text x="302" y="132" font-size="16">🏁</text><circle id="wkdot" cx="30" cy="190" r="8" fill="#E5484D" stroke="#fff" stroke-width="3"/></svg></div><div class="wkl" id="wklive" style="display:${R.live?'flex':'none'}"><div id="wklic" style="font-size:96px;line-height:104px">${v.s[1]}</div><div id="wkltx" style="font-size:16px;font-weight:700;margin-top:6px">${v.s[2]}</div><div style="font-size:12px;opacity:.7;margin-top:8px">Live view · sample</div></div></div>
<div class="wkv" id="wkvo">${R.voice?'🔊 Voice guidance is on':'🔇 Voice is off'}</div>
<div class="wks"><div><b id="wkleft">${fm(v.left)}</b><span>Left</span></div><div><b id="wkmin">${v.min} min</b><span>Time</span></div><div><b id="wkarr">${clk(now()+v.min)}</b><span>Arrive</span></div></div>
<div class="wkg"><i id="wkbar" style="width:${Math.round(v.frac*100)}%"></i></div>
<div class="wkc"><button id="wkpa" onclick="wkPause()">${R.paused?'▶ Resume':'⏸ Pause'}</button><button id="wkvb" onclick="wkVoice()">${R.voice?'🔊 Voice on':'🔇 Voice off'}</button><button id="wklb" onclick="wkLive()">${R.live?'🗺️ Map view':'📷 Live view'}</button></div><div style="height:90px"></div>
<div class="cta"><button class="btn" onclick="wkEnd()">End walk</button></div>`};
screens.mapview=function(){const h=String(_mv.apply(this,arguments)),T=document.createElement('div');T.innerHTML=h;
 try{const row=T.querySelector('.mpx');if(!row||T.querySelector('[onclick="mpGo(\'mpwalk\')"]'))return h;const b=row.querySelector('button');if(!b)return h;const c=b.cloneNode(true);c.setAttribute('onclick',"mpGo('mpwalk')");c.textContent='🚶 Walk';row.appendChild(c)}catch(e){return h}
 return T.innerHTML};
})()}catch(x){console.error('naver-v598',x)}
/* v599: Naver Maps domain 16, Smart Around. Naver's home suggests places from the time, the weather and what you saved or visited, and its Cue: search answers questions about places. An "Around" chip opens it. (1) Context line: day, time and weather (Sunny or Rainy switch, sample). A "Preview time" row tries Now, 8 am, 1 pm, 7 pm, 11 pm. (2) For you now: up to 4 places ranked by the time of day (cafes in the morning and afternoon, food at lunch and dinner, pharmacy and cash late at night), distance, rating, whether you saved it, how often you go to that kind of place, and rain (nearer places and bus stops rise). Places that will be closed when you arrive are left out. Each row says why in one line, and has Walk (opens Walk with it chosen) and Save. (3) Personalise switch: Off ignores saved places and visits. (4) Ask about nearby: a box with example chips ("coffee to work", "open late", "medicine", "cash", "bus") that answers with up to 3 places. English only; weather, visit counts and answers are sample data. */
try{(()=>{
const M=S.mp,_mv=screens.mapview;
M.ar=M.ar||{t:null,wx:'sun',pers:true,q:'',ans:null};
const A=M.ar;
const VIS={cafe:4,food:2,pharm:0,atm:1,bus:6};
const now=()=>{const d=new Date();return d.getHours()*60+d.getMinutes()};
const clk=m=>{m=((m%1440)+1440)%1440;const h=Math.floor(m/60);return (h%12||12)+':'+String(m%60).padStart(2,'0')+' '+(h<12?'am':'pm')};
const dkm=p=>{const v=parseFloat(p.d)||0;return /km/i.test(p.d||'')?v:v/1000};
const wmin=p=>Math.max(1,Math.ceil(dkm(p)*1000/80));
const sv=id=>id==='cafe'?!!M.star:!!M.sv[id];
const T=()=>A.t==null?now():A.t;
const bk=m=>{const h=m/60;return h>=5&&h<11?'morning':h>=11&&h<14?'lunch':h>=14&&h<17?'afternoon':h>=17&&h<21?'evening':'night'};
const PREF={morning:{cafe:1,food:.5,pharm:.3,atm:.4,bus:.6},lunch:{food:1,cafe:.5,pharm:.3,atm:.4,bus:.3},afternoon:{cafe:1,food:.4,pharm:.3,atm:.4,bus:.4},evening:{food:1,cafe:.3,pharm:.3,atm:.4,bus:.5},night:{pharm:.6,atm:.5,bus:.4,food:.3,cafe:.1}};
const BL={morning:'this morning',lunch:'lunchtime',afternoon:'this afternoon',evening:'this evening',night:'late at night'};
const open=(p,t)=>{const a=t+wmin(p),m=/closes (\d\d):(\d\d)/.exec(p.o||'');if(!m)return['Open now','#2BA84A',99];const c=+m[1]*60+ +m[2];if(t/60<5)return['Closed when you arrive','#E5484D',0];return a>=c?['Closed when you arrive','#E5484D',0]:c-a<=30?['Closes soon after you arrive','#F5A524',c]:['Open until '+m[1]+':'+m[2],'#2BA84A',c]};
const score=(p,t)=>{const b=bk(t),pr=(PREF[b][p.c]||0),km=dkm(p),rt=parseFloat(p.r)||4.2,why=[];let s=pr*3+Math.max(0,3-km)+rt*.4;
 if(pr>=1)why.push('Good for '+BL[b]);
 if(A.pers){if(sv(p.id)){s+=1.5;why.push('You saved this')}const v=VIS[p.c]||0;if(v>=3){s+=v/10;why.push('You go to this kind of place often')}}
 if(A.wx==='rain'&&km<1){s+=1.2;why.push('Close by for a rainy day')}
 return{p,s,why,o:open(p,t)}};
const rank=(list,t)=>list.filter(p=>dkm(p)<=3).map(p=>score(p,t)).filter(x=>x.o[2]>0).sort((a,b)=>b.s-a.s);
const row=x=>{const p=x.p,fav=sv(p.id);return`<div class="dvr tap" onclick="mpDir('${p.id}')"><i>${p.e}</i><div><b>${p.n}</b><span>${wmin(p)} min walk · ${dkm(p).toFixed(1)} km${p.r?' · ★ '+p.r.split(' ')[0]:''}</span><br><em style="color:${x.o[1]}">${x.o[0]}</em>${x.why.length?`<br><span>${x.why.slice(0,2).join(' · ')}</span>`:''}</div><button onclick="event.stopPropagation();arWalk('${p.id}')">Walk</button><button class="gh" aria-label="${fav?'Remove from saved':'Save'}" onclick="event.stopPropagation();mpSave('${p.id}')">${fav?'♥':'♡'}</button></div>`};
window.arT=i=>{A.t=[null,480,780,1140,1380][i];A.ans=null;render('fade-none')};
window.arWx=k=>{A.wx=k;A.ans=null;render('fade-none')};
window.arPers=()=>{A.pers=!A.pers;A.ans=null;render('fade-none')};
window.arWalk=id=>{if(M.wk){M.wk.sel=id;M.wk.plan='walk'}mpGo('mpwalk')};
window.arIn=v=>{A.q=v};
window.arAsk=q=>{q=(q||'').trim();A.q=q;const l=q.toLowerCase(),t=T(),P=window.POI||[];let cats=[],late=/late|night|24|open late/.test(l);
 if(/coffee|cafe|work|study|dessert|cake/.test(l))cats.push('cafe');if(/eat|lunch|dinner|hungry|food|restaurant|grill/.test(l))cats.push('food');if(/medicine|pharmac|sick|pain|drug/.test(l))cats.push('pharm');if(/cash|money|atm|withdraw/.test(l))cats.push('atm');if(/bus|ride|stop|transit/.test(l))cats.push('bus');
 if(!q){toast('Type a question first');return}
 let r=rank(P.filter(p=>!cats.length||cats.includes(p.c)),t);
 if(late)r=r.sort((a,b)=>b.o[2]-a.o[2]);
 if(!cats.length&&!late)A.ans={q,msg:'I could not match that to a nearby place. Try coffee, food, medicine, cash or bus.',r:[]};
 else A.ans={q,msg:r.length?(late?'These are open latest near you:':'Here are the best matches near you '+BL[bk(t)]+':'):'Nothing nearby will be open when you arrive.',r:r.slice(0,3)};
 render('fade-none')};
const sw=(ic,t,s,k,on)=>`<div class="dvr"><i>${ic}</i><div><b>${t}</b><span>${s}</span></div><button onclick="${k}">${on}</button></div>`;
screens.mparound=()=>{
 const t=T(),d=['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'][new Date().getDay()],we=[0,6].includes(new Date().getDay()),P=window.POI||[];
 const top=rank(P,t).slice(0,4),tl=[['Now',A.t==null],['8 am',A.t===480],['1 pm',A.t===780],['7 pm',A.t===1140],['11 pm',A.t===1380]];
 const ans=A.ans?`<div class="dvc"><b>${A.ans.q.replace(/</g,'&lt;')}</b><div class="dvn" style="padding:4px 0 0">${A.ans.msg}</div></div>${A.ans.r.map(row).join('')}`:'';
 const chips=['coffee to work','open late','medicine','cash','bus'].map(c=>`<button onclick="arAsk('${c}')">${c}</button>`).join('');
 return`<div class="mh" style="padding-bottom:0"><button class="ib" aria-label="Back" onclick="back()">${ic('back',24)}</button><b style="flex:1;font-size:19px;margin-left:6px">Around you</b></div>
<div class="dvn" style="padding-top:8px">${d} ${clk(t)} · ${A.wx==='rain'?'🌧️ Rain · 21°':'☀️ Sunny · 27°'}${we?' · Weekend hours can differ':''}</div>
<div class="dvt"><button class="${A.wx==='sun'?'on':''}" onclick="arWx('sun')">☀️ Sunny</button><button class="${A.wx==='rain'?'on':''}" onclick="arWx('rain')">🌧️ Rainy</button></div>
<div class="dvh">Preview time</div><div class="dvp">${tl.map((x,i)=>`<button class="${x[1]?'on':''}" onclick="arT(${i})"><i>${x[0]}</i></button>`).join('')}</div>
<div class="dvh">For you ${BL[bk(t)]}</div>${top.length?top.map(row).join(''):'<div class="dvn">Nothing nearby will be open when you arrive.</div>'}
<div class="dvh">Ask about nearby</div><div class="inf" style="padding-top:4px">${chips}</div>
<input class="in" style="margin:10px 24px 0;width:calc(100% - 48px)" aria-label="Ask about nearby places" placeholder="For example, a quiet cafe to work" value="${(A.q||'').replace(/"/g,'&quot;')}" oninput="arIn(this.value)" onkeydown="if(event.key==='Enter')arAsk(this.value)"><div class="cta" style="position:static;padding:10px 24px 0"><button class="btn" onclick="arAsk(S.mp.ar.q)">Ask</button></div>${ans}
<div class="dvh">Personalise</div>${sw('✨','Use my saved places and visits',A.pers?'Picks places you saved and visit often':'Plain nearby results only','arPers()',A.pers?'On':'Off')}
<div class="dvn" style="padding-bottom:24px">Nearby means within 3 km. Sample weather, visit counts and answers.</div>`};
screens.mapview=function(){const h=String(_mv.apply(this,arguments)),Tm=document.createElement('div');Tm.innerHTML=h;
 try{const rw=Tm.querySelector('.mpx');if(!rw||Tm.querySelector('[onclick="mpGo(\'mparound\')"]'))return h;const b=rw.querySelector('button');if(!b)return h;const c=b.cloneNode(true);c.setAttribute('onclick',"mpGo('mparound')");c.textContent='✨ Around';rw.appendChild(c)}catch(e){return h}
 return Tm.innerHTML};
})()}catch(x){console.error('naver-v599',x)}
/* v600: Naver Maps domain 17, Road alerts. Naver keeps adding real-time accident and traffic-restriction info and made road reports easier. A "Road alerts" chip opens three tabs. (1) Nearby: a card for your usual route ("2 alerts on your route, +9 min", with a leave-earlier tip), filter chips (All, Accident, Roadworks, Closed, Hazard), and sample incidents with road, distance, age or end time, delay, and the lane. Each has Still there (adds a confirmation), Cleared (hides it, with "Show cleared" to bring it back) and, for route incidents, Avoid (the road joins an "Avoiding" list, the delay drops out and a 2 min detour is added; tap the road to stop avoiding). (2) My reports: choose a type (Accident, Roadworks, Closed road, Hazard), where (Here, 500 m ahead, On my route) and an optional lane, then Send; it joins your list with a confirmation count and Withdraw. Reports made in Drive are counted too. (3) Alerts: switches for Accidents, Roadworks and closures, Hazards, Speed cameras, Voice alerts and Only on my route, an alert distance (500 m, 1 km, 2 km) and Preview alert, which shows the nearest alert in range and speaks it if voice is on. English only; incidents, delays and confirmations are sample data. */
try{(()=>{
const M=S.mp,_mv=screens.mapview;
M.rd=M.rd||{tab:'near',f:'all',gone:{},vote:{},avoid:{},mine:[],rp:{type:null,where:'here',lane:null},al:{acc:true,work:true,haz:true,cam:true,voice:true,route:false,dist:1000},pv:null};
const R=M.rd;
const now=()=>{const d=new Date();return d.getHours()*60+d.getMinutes()};
const clk=m=>{m=((m%1440)+1440)%1440;const h=Math.floor(m/60);return (h%12||12)+':'+String(m%60).padStart(2,'0')+' '+(h<12?'am':'pm')};
const INC=[{id:'a1',t:'acc',e:'🚗',n:'Accident',r:'KN 2 Rd',km:.8,age:12,d:6,note:'Left lane blocked',route:true,conf:9},{id:'w1',t:'work',e:'🚧',n:'Roadworks',r:'KG 7 Ave',km:1.5,until:'6:00 pm',d:3,note:'One lane open',route:true,conf:5},{id:'h1',t:'haz',e:'⚠️',n:'Pothole',r:'KG 11 Ave',km:.5,age:35,d:0,note:'Right lane',route:false,conf:3},{id:'c1',t:'closed',e:'⛔',n:'Road closed',r:'KG 9 Ave',km:2.2,until:'Monday',d:0,note:'Use KG 11 Ave instead',route:false,conf:14},{id:'e1',t:'closed',e:'🎫',n:'Event traffic',r:'Convention Centre',km:3.1,until:'9:00 pm',d:4,note:'Parking for ticket holders only',route:false,conf:7}];
const TY=[['acc','🚗','Accident'],['work','🚧','Roadworks'],['closed','⛔','Road closed'],['haz','⚠️','Hazard']];
const FL=[['all','All'],['acc','Accident'],['work','Roadworks'],['closed','Closed'],['haz','Hazard']];
const alk=t=>t==='closed'?'work':t;
const st=document.createElement('style');
st.textContent='#phone .rdw{margin:12px 24px 0;padding:12px 14px;border-radius:14px;border:2px solid #E5484D;font-size:14px;line-height:20px}#phone .rdb{display:flex;gap:8px;padding:8px 24px 10px 80px;flex-wrap:wrap}#phone .rdb button{border:1px solid var(--ln);border-radius:16px;background:none;color:var(--tx);font:inherit;font-size:13px;font-weight:700;height:32px;padding:0 12px}#phone .rdb button.on{border-color:var(--lk);background:var(--chip)}';
document.head.appendChild(st);
const vis=()=>INC.filter(x=>!R.gone[x.id]&&(R.f==='all'||x.t===R.f)&&(!R.al.route||x.route));
const cnt=x=>x.conf+(R.vote[x.id]?1:0);
const info=x=>(x.age?x.age+' min ago':'Planned · until '+x.until)+' · '+x.km.toFixed(1)+' km';
const dl=x=>x.d>0?'+'+x.d+' min':'No delay';
window.rdTab=k=>{R.tab=k;render('fade-none')};
window.rdF=k=>{R.f=k;render('fade-none')};
window.rdVote=id=>{R.vote[id]=!R.vote[id];render('fade-none')};
window.rdGone=id=>{R.gone[id]=1;toast('Thanks. Cleared reports are checked.');render('fade-none')};
window.rdShow=()=>{R.gone={};render('fade-none')};
window.rdAvoid=id=>{const x=INC.find(i=>i.id===id);R.avoid[x.r]=!R.avoid[x.r];if(!R.avoid[x.r])delete R.avoid[x.r];toast(R.avoid[x.r]?'Routes will avoid '+x.r:'No longer avoiding '+x.r);render('fade-none')};
window.rdUn=r=>{delete R.avoid[r];render('fade-none')};
window.rdRp=(k,v)=>{R.rp[k]=(R.rp[k]===v&&k==='lane')?null:v;render('fade-none')};
window.rdSend=()=>{const t=TY.find(x=>x[0]===R.rp.type);if(!t)return;const w={here:'Here',ahead:'500 m ahead',route:'On my route'}[R.rp.where];R.mine.unshift({e:t[1],n:t[2],w,l:R.rp.lane,at:clk(now()),c:1+Math.floor(Math.random()*4)});R.rp={type:null,where:'here',lane:null};toast(t[2]+' reported. Drivers nearby will see it.');render('fade-none')};
window.rdDel=i=>{R.mine.splice(i,1);toast('Report withdrawn');render('fade-none')};
window.rdAl=k=>{R.al[k]=!R.al[k];if(k!=='voice')R.pv=null;render('fade-none')};
window.rdDist=d=>{R.al.dist=d;R.pv=null;render('fade-none')};
window.rdOk=()=>{R.pv=null;render('fade-none')};
window.rdPrev=()=>{const x=INC.filter(i=>!R.gone[i.id]&&R.al[alk(i.t)]&&i.km*1000<=R.al.dist&&(!R.al.route||i.route)).sort((a,b)=>a.km-b.km)[0];if(!x){R.pv='No alerts within '+(R.al.dist>=1000?R.al.dist/1000+' km':R.al.dist+' m')+' with your settings.';render('fade-none');return}
 const m=Math.max(100,Math.round(x.km*1000/100)*100),t=x.n+' ahead in '+m+' meters on '+x.r+(x.note?'. '+x.note:'');R.pv=t;if(R.al.voice){try{if(window.speechSynthesis){speechSynthesis.cancel();speechSynthesis.speak(new SpeechSynthesisUtterance(t))}}catch(e){}}render('fade-none')};
const chip=(a,on,fn)=>`<div class="inf" style="padding-top:4px">${a.map(x=>`<button class="${on(x)?'on':''}" onclick="${fn(x)}">${x[1]}</button>`).join('')}</div>`;
const near=()=>{const v=vis().sort((a,b)=>a.km-b.km),all=INC.filter(x=>!R.gone[x.id]&&x.route&&!R.avoid[x.r]),av=Object.keys(R.avoid).length,sum=all.reduce((a,x)=>a+x.d,0)+av*2,n=all.length;
 const card=`<div class="dvc"><b>Your usual route</b><div class="dvn" style="padding:4px 0 0">${n?n+' alert'+(n>1?'s':'')+' on your route · +'+sum+' min':'No alerts on your route'}${av?' (includes '+av*2+' min detour)':''}.${sum>=5?' Leave about '+(sum+5)+' min earlier, or avoid a road below.':''}</div></div>`;
 const avl=Object.keys(R.avoid).length?`<div class="dvn" style="padding:8px 24px 0">Avoiding:</div><div class="inf" style="padding-top:4px">${Object.keys(R.avoid).map(r=>`<button class="on" onclick="rdUn('${r}')">${r} ✕</button>`).join('')}</div>`:'';
 const rows=v.map(x=>`<div class="dvr"><i>${x.e}</i><div><b>${x.n} · ${x.r}</b><span>${info(x)}</span><br><em style="color:${x.d>=5?'#E5484D':x.d>0?'#F5A524':'#2BA84A'}">${dl(x)}</em> <span>· ${x.note}</span><br><span>${cnt(x)} drivers confirmed</span></div></div><div class="rdb"><button class="${R.vote[x.id]?'on':''}" onclick="rdVote('${x.id}')">${R.vote[x.id]?'✓ Still there':'Still there'}</button><button onclick="rdGone('${x.id}')">Cleared</button>${x.route?`<button class="${R.avoid[x.r]?'on':''}" onclick="rdAvoid('${x.id}')">${R.avoid[x.r]?'Avoiding':'Avoid'}</button>`:''}</div>`).join('');
 const gn=Object.keys(R.gone).length;
 return card+avl+`<div class="dvh">Nearby</div>`+chip(FL,x=>x[0]===R.f,x=>`rdF('${x[0]}')`)+(rows||'<div class="dvn">No alerts to show.</div>')+(gn?`<div class="dvr tap" onclick="rdShow()"><i>↩️</i><div><b>Show cleared (${gn})</b></div></div>`:'')+(R.al.route?'<div class="dvn">Showing only alerts on your route.</div>':'')};
const mine=()=>{const rp=R.rp,dv=(M.dv&&M.dv.rep)||[],ok=!!rp.type;
 const l=R.mine.map((m,i)=>`<div class="dvr"><i>${m.e}</i><div><b>${m.n}</b><span>${m.w}${m.l?' · '+m.l:''} · ${m.at}</span><br><em style="color:#2BA84A">${m.c} driver${m.c>1?'s':''} confirmed</em></div><button class="gh" onclick="rdDel(${i})">Withdraw</button></div>`).join('');
 return`<div class="dvh">What did you see?</div>${chip(TY.map(t=>[t[0],t[1]+' '+t[2]]),x=>x[0]===rp.type,x=>`rdRp('type','${x[0]}')`)}<div class="dvh">Where?</div>${chip([['here','Here'],['ahead','500 m ahead'],['route','On my route']],x=>x[0]===rp.where,x=>`rdRp('where','${x[0]}')`)}<div class="dvh">Which lane? (optional)</div>${chip([['l','Left lane'],['r','Right lane'],['a','All lanes']],x=>rp.lane===x[1],x=>`rdRp('lane','${x[1]}')`)}<div class="cta" style="position:static;padding:14px 24px 0"><button class="btn" ${ok?'':'disabled'} onclick="rdSend()">Send report</button></div><div class="dvh">Your reports</div>${l||'<div class="dvn">No reports yet.</div>'}${dv.length?`<div class="dvn">Also reported while driving: ${dv.join(', ')}.</div>`:''}<div class="dvn" style="padding-bottom:24px">Reports are shown to drivers nearby and checked by others.</div>`};
const alerts=()=>{const A=R.al,sw=(ic,t,s,k)=>`<div class="dvr"><i>${ic}</i><div><b>${t}</b><span>${s}</span></div><button onclick="rdAl('${k}')">${A[k]?'On':'Off'}</button></div>`,dd=[[500,'500 m'],[1000,'1 km'],[2000,'2 km']];
 return`<div class="dvh">Alert me about</div>${sw('🚗','Accidents','Crashes and blocked lanes','acc')}${sw('🚧','Roadworks and closures','Works, closed roads, event traffic','work')}${sw('⚠️','Hazards','Potholes, debris, flooding','haz')}${sw('📷','Speed cameras','Fixed and rear-facing cameras','cam')}<div class="dvh">How</div>${sw('🔊','Voice alerts','Speak the alert while you drive','voice')}${sw('🛣️','Only on my route','Hide alerts off your usual route','route')}<div class="dvh">Alert distance</div>${chip(dd,x=>x[0]===A.dist,x=>`rdDist(${x[0]})`)}<div class="cta" style="position:static;padding:14px 24px 0"><button class="btn" onclick="rdPrev()">Preview alert</button></div><div class="dvn" style="padding-bottom:24px">Sample incidents and settings.</div>`};
screens.mproad=()=>{const T=[['near','Nearby'],['my','My reports'],['al','Alerts']],pv=R.pv?`<div class="rdw"><b>⚠️ ${R.pv}</b><br><button class="gh" onclick="rdOk()">Dismiss</button></div>`:'';
 return`<div class="mh" style="padding-bottom:0"><button class="ib" aria-label="Back" onclick="back()">${ic('back',24)}</button><b style="flex:1;font-size:19px;margin-left:6px">Road alerts</b></div><div class="dvt">${T.map(t=>`<button class="${R.tab===t[0]?'on':''}" onclick="rdTab('${t[0]}')">${t[1]}</button>`).join('')}</div>${pv}${R.tab==='near'?near():R.tab==='my'?mine():alerts()}`};
screens.mapview=function(){const h=String(_mv.apply(this,arguments)),Tm=document.createElement('div');Tm.innerHTML=h;
 try{const rw=Tm.querySelector('.mpx');if(!rw||Tm.querySelector('[onclick="mpGo(\'mproad\')"]'))return h;const b=rw.querySelector('button');if(!b)return h;const c=b.cloneNode(true);c.setAttribute('onclick',"mpGo('mproad')");c.textContent='🚨 Road alerts';rw.appendChild(c)}catch(e){return h}
 return Tm.innerHTML};
})()}catch(x){console.error('naver-v600',x)}
/* v601: Naver Maps domain 18, Car mode and commute. Naver's in-car app (Hyundai Pleos Connect) shows likely destinations, nearby fuel stations and a driving score, guides to a station or charger when fuel or battery is low, puts the home-work route first at commute hours, and gives a Today Briefing. A "Car mode" chip opens it. (1) Preview time (Now, 7:30 am, 12:30 pm, 6 pm, 10 pm). (2) Likely destination: Work from 6:30 to 9:30 am, Home from 4:30 to 7:30 pm, otherwise a recent place; with the trip time for the traffic then, a traffic label, and Go (opens a car route). A "Commute first" switch turns the home-work priority off. (3) Your car: Petrol or Electric, a level slider with the distance left (about 5 km a percent for petrol, 3 km for electric). When the level is under 20% (15% for electric) and "Guide me when low" is on, a banner offers the nearest station or charger with Go. The nearest three stations or chargers are listed. (4) Today Briefing: weather, the next appointment with when to leave (trip time at that hour plus 5 min) and a reminder, two sample headlines, and Play briefing, which speaks it if the phone has speech. (5) Driving score row that opens Drive. English only; places, appointments, headlines and levels are sample data. */
try{(()=>{
const M=S.mp,_mv=screens.mapview;
M.cm=M.cm||{t:null,first:true,kind:'fuel',lvl:{fuel:62,ev:68},auto:true};
const C=M.cm;
const now=()=>{const d=new Date();return d.getHours()*60+d.getMinutes()};
const clk=m=>{m=((m%1440)+1440)%1440;const h=Math.floor(m/60);return (h%12||12)+':'+String(m%60).padStart(2,'0')+' '+(h<12?'am':'pm')};
const T=()=>C.t==null?now():C.t;
const fac=h=>{h=((h%1440)+1440)%1440/60;return(h>=7&&h<9.5)||(h>=17&&h<19.5)?1.6:(h>=6&&h<7)||(h>=9.5&&h<11)||(h>=16&&h<17)||(h>=19.5&&h<20.5)?1.25:1};
const tf=f=>f>=1.6?['Heavy traffic','#E5484D']:f>=1.25?['Busy','#F5A524']:['Smooth','#2BA84A'];
const PL={home:{id:'home',e:'🏠',n:'Home',a:'Kimironko, KG 11 Ave',b:14},work:{id:'work',e:'💼',n:'Work',a:'Kigali Heights, KG 7 Ave',b:18},recent:{id:'cafe2',e:'☕',n:'Kigali Roast',a:'Recent place · Cafe',b:6}};
const likely=t=>{const h=t/60;if(C.first&&h>=6.5&&h<9.5)return PL.work;if(C.first&&h>=16.5&&h<19.5)return PL.home;return PL.recent};
const eta=(p,t)=>Math.round(p.b*fac(t));
const ST={fuel:[['⛽','SP Kimironko',.9,'Petrol and diesel · open 24 hours'],['⛽','Engen Remera',1.8,'Petrol and diesel · closes 22:00'],['⛽','Rubis Kacyiru',2.7,'Petrol and diesel · open 24 hours']],ev:[['🔌','Convention Centre EV Point',1.4,'22 kW · 2 of 4 free'],['🔌','Remera Mall Charger',2.3,'7 kW · 1 of 2 free'],['🔌','Kacyiru Hub',3.0,'50 kW fast · busy']]};
const AP=[{m:600,n:'Team stand-up',w:'Kigali Heights, KG 7 Ave',b:18},{m:930,n:'Dentist',w:'Kacyiru Clinic',b:12},{m:1140,n:'Dinner with Marie',w:'Grill House',b:10}];
const NEWS=['City council opens the new KN 2 Rd cycle lane on Monday','Kigali Convention Centre hosts a trade fair this week'];
const lowAt=()=>C.kind==='fuel'?20:15;
const lv=()=>C.lvl[C.kind];
const left=()=>Math.round(lv()*(C.kind==='fuel'?5:3));
const go=p=>{const tmp={id:p.id,c:'x',e:p.e,n:p.n,x:150,y:190,k:p.a,r:'',d:'1 km',o:''};const P=window.POI,nw=!P.find(x=>x.id===p.id);if(nw)P.push(tmp);M.mode='car';try{mpDir(p.id)}finally{if(nw)P.splice(P.indexOf(tmp),1)}};
const st=document.createElement('style');
st.textContent='#phone .cmb{margin:12px 24px 0;padding:14px;border-radius:16px;border:2px solid #F5A524;font-size:14px;line-height:20px}#phone .cmb button{margin-top:8px}#phone .cmr{width:calc(100% - 48px);margin:10px 24px 0;display:block}';
document.head.appendChild(st);
window.cmT=i=>{C.t=[null,450,750,1080,1320][i];render('fade-none')};
window.cmFirst=()=>{C.first=!C.first;render('fade-none')};
window.cmAuto=()=>{C.auto=!C.auto;render('fade-none')};
window.cmKind=k=>{C.kind=k;render('fade-none')};
window.cmLvl=v=>{C.lvl[C.kind]=+v;const e=document.getElementById('cmlv'),b=document.getElementById('cmlb');if(e)e.textContent=left()+' km left · '+v+'%';};
window.cmLvlEnd=()=>render('fade-none');
window.cmGo=id=>{if(id==='home')go(PL.home);else if(id==='work')go(PL.work);else go(PL.recent)};
window.cmStn=i=>{const s=ST[C.kind][i];go({id:'cmstn'+C.kind+i,e:s[0],n:s[1],a:s[3]})};
window.cmRem=t=>toast('Reminder set for '+t+'. Sample only.');
window.cmPlay=()=>{const t=T(),a=AP.find(x=>x.m>t),tx='Good '+(t<720?'morning':t<1020?'afternoon':'evening')+'. '+(a?'Your next appointment is '+a.n+' at '+clk(a.m)+'. Leave by '+clk(a.m-eta(a,a.m-a.b)-5)+'. ':'You have no more appointments today. ')+'Weather is sunny and 27 degrees. '+NEWS[0]+'.';toast('Playing briefing');try{if(window.speechSynthesis){speechSynthesis.cancel();speechSynthesis.speak(new SpeechSynthesisUtterance(tx))}}catch(e){}};
screens.mpcar=()=>{
 const t=T(),p=likely(t),f=fac(t),tr=tf(f),e=eta(p,t),a=AP.find(x=>x.m>t),k=C.kind,low=lv()<lowAt(),stn=ST[k],tl=[['Now',C.t==null],['7:30 am',C.t===450],['12:30 pm',C.t===750],['6 pm',C.t===1080],['10 pm',C.t===1320]];
 const lw=C.auto&&low?`<div class="cmb"><b>${k==='fuel'?'⛽ Fuel is low':'🔌 Battery is low'} (${lv()}%)</b><br>Nearest ${k==='fuel'?'station':'charger'}: ${stn[0][1]} · ${stn[0][2]} km · ${stn[0][3]}<br><button class="btn" onclick="cmStn(0)">Go there</button></div>`:'';
 const sr=stn.map((s,i)=>`<div class="dvr tap" onclick="cmStn(${i})"><i>${s[0]}</i><div><b>${s[1]}</b><span>${s[2]} km · ${s[3]}</span></div><button onclick="event.stopPropagation();cmStn(${i})">Go</button></div>`).join('');
 const ap=a?(()=>{const lb=a.m-eta(a,a.m-a.b)-5;return`<div class="dvr"><i>📅</i><div><b>${a.n} · ${clk(a.m)}</b><span>${a.w}</span><br><em style="color:${lb<=t+10?'#E5484D':'#2BA84A'}">${lb<=t?'Leave now':'Leave by '+clk(lb)}</em> <span>· ${eta(a,a.m-a.b)} min drive</span></div><button onclick="cmRem('${clk(lb)}')">Remind</button></div>`})():'<div class="dvr"><i>📅</i><div><b>No more appointments today</b></div></div>';
 return`<div class="mh" style="padding-bottom:0"><button class="ib" aria-label="Back" onclick="back()">${ic('back',24)}</button><b style="flex:1;font-size:19px;margin-left:6px">Car mode</b></div>
<div class="dvh">Preview time</div><div class="dvp">${tl.map((x,i)=>`<button class="${x[1]?'on':''}" onclick="cmT(${i})"><i>${x[0]}</i></button>`).join('')}</div>
<div class="dvh">Likely destination · ${clk(t)}</div><div class="dvc"><div style="display:flex;align-items:center;gap:12px"><span style="font-size:32px">${p.e}</span><div style="flex:1"><b style="font-size:18px">${p.n}</b><div class="dvn" style="padding:0">${p.a}</div></div></div><div style="font-size:28px;font-weight:800;margin-top:10px">${e} min</div><div style="color:${tr[1]};font-weight:700;font-size:14px">${tr[0]}</div><button class="btn" onclick="cmGo('${p.id}')">Go</button></div>
<div class="dvr"><i>🔁</i><div><b>Commute first</b><span>Work in the morning, home in the evening</span></div><button onclick="cmFirst()">${C.first?'On':'Off'}</button></div>
<div class="dvh">Your car</div><div class="dvt"><button class="${k==='fuel'?'on':''}" onclick="cmKind('fuel')">⛽ Petrol</button><button class="${k==='ev'?'on':''}" onclick="cmKind('ev')">🔌 Electric</button></div>
<div class="dvn" style="padding-bottom:0"><b id="cmlv" style="font-size:18px;color:var(--tx)">${left()} km left · ${lv()}%</b></div><input id="cmlb" class="cmr" type="range" min="0" max="100" value="${lv()}" aria-label="${k==='fuel'?'Fuel level':'Battery level'}" oninput="cmLvl(this.value)" onchange="cmLvlEnd()"><div class="dvr"><i>🧭</i><div><b>Guide me when low</b><span>Under ${lowAt()}%, offer the nearest ${k==='fuel'?'station':'charger'}</span></div><button onclick="cmAuto()">${C.auto?'On':'Off'}</button></div>${lw}
<div class="dvh">${k==='fuel'?'Fuel stations':'EV chargers'} nearby</div>${sr}
<div class="dvh">Today Briefing</div><div class="dvr"><i>☀️</i><div><b>Sunny · 27°</b><span>${t>=1080||t<360?'Clear evening, light wind':'Rain chance 10% this afternoon'}</span></div></div>${ap}${NEWS.map(n=>`<div class="dvr"><i>📰</i><div><span style="color:var(--tx)">${n}</span></div></div>`).join('')}<div class="cta" style="position:static;padding:12px 24px 0"><button class="btn" onclick="cmPlay()">🔊 Play briefing</button></div>
<div class="dvh">Driving score</div><div class="dvr tap" onclick="mpGo('mpdrive')"><i>🏆</i><div><b>84 out of 100</b><span>Better than 71% of drivers this week</span></div></div><div class="dvn" style="padding-bottom:24px">Sample places, appointments and headlines.</div>`};
screens.mapview=function(){const h=String(_mv.apply(this,arguments)),Tm=document.createElement('div');Tm.innerHTML=h;
 try{const rw=Tm.querySelector('.mpx');if(!rw||Tm.querySelector('[onclick="mpGo(\'mpcar\')"]'))return h;const b=rw.querySelector('button');if(!b)return h;const c=b.cloneNode(true);c.setAttribute('onclick',"mpGo('mpcar')");c.textContent='🚘 Car mode';rw.appendChild(c)}catch(e){return h}
 return Tm.innerHTML};
})()}catch(x){console.error('naver-v601',x)}
/* v602: Naver Maps instant search. While you type in the map search, Naver shows useful facts for each result without opening it, such as opening and closing times. Every place result now gets a status line with the walk time when it is 30 minutes or less: "Open · until 22:00" (green), "Closes soon · 20:00" (amber), "Closed" (red), "Open 24 hours", or the next bus for a stop. Two chips sit above the results: "Open now" hides places that are closed or will close before you could get there, and "Nearest" sorts each group by distance. The chips stay on between searches in this session. English only; hours and distances are the sample data already in the map. */
try{(()=>{
const M=S.mp,_q=window.mpQ;
M.is=M.is||{open:false,near:false,v:''};
const I=M.is;
const now=()=>{const d=new Date();return d.getHours()*60+d.getMinutes()};
const dkm=p=>{const v=parseFloat(p.d)||0;return /km/i.test(p.d||'')?v:v/1000};
const wm=p=>Math.max(1,Math.ceil(dkm(p)*1000/80));
const stat=p=>{const o=p.o||'',m=/closes (\d\d):(\d\d)/.exec(o),n=now();if(/24 hours/i.test(o))return['Open 24 hours','#2BA84A',1];if(/^Next/i.test(o))return[o,'#2BA84A',1];if(!m)return[o||'Hours not listed','var(--tt)',1];const c=+m[1]*60+ +m[2],a=n+wm(p);if(n>=c||n<300)return['Closed','#E5484D',0];if(a>=c)return['Closed when you arrive · '+m[1]+':'+m[2],'#E5484D',0];return c-a<=30?['Closes soon · '+m[1]+':'+m[2],'#F5A524',1]:['Open · until '+m[1]+':'+m[2],'#2BA84A',1]};
const enh=()=>{const el=document.getElementById('mpres'),P=window.POI||[];if(!el||!I.v.trim())return;const us=el.querySelector('.us');if(!us)return;
 const rows=[...us.querySelectorAll('.pl[onclick^="mpResult("]')];if(!rows.length)return;
 rows.forEach(r=>{const id=/mpResult\('([^']+)'/.exec(r.getAttribute('onclick'))[1],p=P.find(x=>x.id===id);if(!p)return;const s=stat(p);r.dataset.id=id;r.dataset.ok=s[2];r.dataset.km=dkm(p);const d=r.querySelector('div');if(d&&!d.querySelector('.isx')){const e=document.createElement('div');e.className='isx';e.style.cssText='font-size:13px;font-weight:700;margin-top:2px;color:'+s[1];e.textContent=s[0]+(wm(p)<=30?' · '+wm(p)+' min walk':'');d.appendChild(e)}});
 if(I.open)rows.forEach(r=>{if(r.dataset.ok==='0')r.remove()});
 if(I.near){const hs=[...us.querySelectorAll('.trh')];hs.forEach(h=>{const g=[];let n=h.nextElementSibling;while(n&&n.classList.contains('pl')){g.push(n);n=n.nextElementSibling}if(g.length>1){g.sort((a,b)=>a.dataset.km-b.dataset.km);let at=h;g.forEach(x=>{at.after(x);at=x})}})}
 [...us.querySelectorAll('.trh')].forEach(h=>{const n=h.nextElementSibling;if(!n||n.classList.contains('trh'))h.remove()});
 const left=us.querySelectorAll('.pl,.bl').length;
 const bar=document.createElement('div');bar.className='inf';bar.id='isbar';bar.style.cssText='padding:8px 0 4px';bar.innerHTML=`<button class="${I.open?'on':''}" onclick="isTog('open')">Open now</button><button class="${I.near?'on':''}" onclick="isTog('near')">Nearest</button>`;us.insertBefore(bar,us.firstChild);
 if(!left){const m=document.createElement('div');m.className='pad mu';m.style.cssText='text-align:center;padding-top:30px';m.textContent='Nothing open right now matches';us.appendChild(m)}};
window.isTog=k=>{I[k]=!I[k];window.mpQ(I.v)};
window.mpQ=function(v){I.v=String(v==null?'':v);const r=_q.apply(this,arguments);try{enh()}catch(e){console.error('naver-v602',e)}return r};
})()}catch(x){console.error('naver-v602',x)}
/* v603: Naver Maps map controls. Naver's vector map rotates and tilts. A control stack on the left of the map: a compass (its needle turns against the map; tap to face north again and drop the tilt), rotate left and right in 45 degree steps, a 2D/3D tilt switch (55 degrees) and a Heading up / North up switch (heading up turns the map to a sample 40 degree heading). Changes animate and stay while you are on the map. Pins still open when tapped; their labels turn with the map. English only; this is a drawn sample map. */
try{(()=>{
const M=S.mp,_mv=screens.mapview;
M.mc=M.mc||{rot:0,tilt:0,zoom:1,head:false};
const C=M.mc,HD=40;
const eff=()=>C.rot+(C.head?-HD:0);
const tr=()=>`rotateX(${C.tilt}deg) rotateZ(${eff()}deg) scale(${C.zoom})`;
const apply=()=>{const m=document.getElementById('mcm'),c=document.getElementById('mcn'),t=document.getElementById('mct'),h=document.getElementById('mch');if(m)m.style.transform=tr();if(c)c.style.transform='rotate('+eff()+'deg)';if(t)t.textContent=C.tilt?'3D':'2D';if(h){h.textContent=C.head?'🧭':'⬆️';h.setAttribute('aria-label',C.head?'Heading up. Tap for north up':'North up. Tap for heading up')}};
window.mcRot=d=>{C.rot=((C.rot+d)%360+360)%360;if(C.rot>180)C.rot-=360;apply()};
window.mcTilt=()=>{C.tilt=C.tilt?0:55;apply()};
window.mcHead=()=>{C.head=!C.head;toast(C.head?'Heading up. Sample heading 40°':'North up');apply()};
window.mcNorth=()=>{C.rot=0;C.tilt=0;C.head=false;apply()};
const st=document.createElement('style');
st.textContent='#phone .mcw{position:relative;overflow:hidden;perspective:800px;background:var(--chip)}#phone .mcm{transform-origin:50% 62%;transition:transform .35s ease}#phone .mcc{position:absolute;left:10px;top:130px;display:flex;flex-direction:column;gap:6px;z-index:5}#phone .mcc button{width:40px;height:40px;border:0;border-radius:20px;background:var(--bg);color:var(--tx);box-shadow:0 1px 6px rgba(0,0,0,.25);font:inherit;font-size:16px;font-weight:800;display:flex;align-items:center;justify-content:center;padding:0}';
document.head.appendChild(st);
screens.mapview=function(){const h=String(_mv.apply(this,arguments)),T=document.createElement('div');T.innerHTML=h;
 try{const svg=T.querySelector('svg[aria-label="Map of Kigali"]');if(!svg||T.querySelector('.mcw'))return h;
  const w=document.createElement('div');w.className='mcw';const m=document.createElement('div');m.className='mcm';m.id='mcm';m.style.transform=tr();svg.replaceWith(w);m.appendChild(svg);w.appendChild(m);
  const c=document.createElement('div');c.className='mcc';c.innerHTML=`<button aria-label="Compass. Tap to face north" onclick="mcNorth()"><span id="mcn" style="display:block;transform:rotate(${eff()}deg);font-size:15px;line-height:15px">🧭</span></button><button aria-label="Rotate left" onclick="mcRot(-45)">⟲</button><button aria-label="Rotate right" onclick="mcRot(45)">⟳</button><button id="mct" aria-label="Tilt" onclick="mcTilt()">${C.tilt?'3D':'2D'}</button><button id="mch" aria-label="${C.head?'Heading up. Tap for north up':'North up. Tap for heading up'}" onclick="mcHead()">${C.head?'🧭':'⬆️'}</button>`;w.appendChild(c)}catch(e){return h}
 return T.innerHTML};
})()}catch(x){console.error('naver-v603',x)}
/* v604: Walk hookup in Directions. In Directions with Walk chosen, Start now opens the voice-guided walking navigation from v598 (turn card, overpass and crossing calls, Live view, Pause) for that route: its real distance and the place you picked ("Arrive at Kigali Roast"). Preview and every other mode (bus, car, bike) still use the original navigation. Voice guidance and Avoid stairs follow the Walk settings. English only; the walk is a simulation. */
try{(()=>{
const M=S.mp,_s=window.mpStart;
window.mpStart=function(pre){
 if(pre||M.mode!=='walk'||!M.wk)return _s.apply(this,arguments);
 const r=_s.apply(this,arguments);
 try{const N=M.nr;if(!N||N.mode!=='walk'||!N.r||!(N.r.dist>0)||S.stack[S.stack.length-1]!=='nav')return r;
  const K=M.wk,total=Math.max(60,Math.round(N.r.dist)),name=(window.PL&&window.PL.n)||'your destination';
  S.stack.pop();M.nr=null;
  K.run={id:'dir',n:name,bus:false,total,pos:0,sp:Math.max(12,Math.round(total/80)),ann:{},paused:false,done:false,live:false,voice:K.voice,ns:K.ns,plan:{walk:{m:total,min:Math.max(1,Math.ceil(total/80))}}};
  S.stack.push('mpwalknav');render('push')}catch(e){console.error('naver-v604',e)}
 return r};
})()}catch(x){console.error('naver-v604',x)}
/* v605: Naver Maps walking slope. Naver now shows the gradient when you search a walking route. On the Walk screen a "Slope" card sits under the route card: a label (Flat, Gentle slope, Moderate climb, Steep), the steepest grade, total climb and descent in metres, an elevation line coloured by grade (green under 3%, amber 3 to 8%, red above), and a line for strollers and wheelchairs. When the steepest part is 6% or more a "Choose the flatter route (+2 min)" button halves the hills and shows the new numbers; tap it again to go back. In walking navigation (Walk screen or Directions Start) a line above the voice banner shows the grade where you are (Flat, Uphill 6%, Downhill 3%), and the voice says "Steep climb ahead, 9 percent" once when a part of 8% or more is two sections away. Each place and route has its own profile. English only; the elevation is generated sample data.*/
try{(()=>{
const M=S.mp,_w=screens.mpwalk,_n=screens.mpwalknav;
const SL={t:null};
const N=24,hash=s=>String(s).split('').reduce((a,c)=>a+c.charCodeAt(0),0);
const dm=p=>{const v=parseFloat(p.d)||0;return /km/i.test(p.d||'')?Math.round(v*1000):Math.round(v)};
const wmin=m=>Math.max(1,Math.ceil(m/80));
const fm=m=>m>=1000?(m/1000).toFixed(1)+' km':Math.max(10,Math.round(m/10)*10)+' m';
const dest=()=>(window.POI||[]).filter(p=>/^(cafe|food|pharm|atm)$/.test(p.c)).sort((a,b)=>dm(a)-dm(b)).slice(0,5);
const prof=(key,total,flat)=>{const s=hash(key),amp=Math.min(30,Math.max(1.5,total*.01))*(flat?.5:1),e=[];for(let i=0;i<=N;i++){const t=i/N;e.push(amp*Math.sin(t*Math.PI*(1+s%3)*.9+s%7)+(s%2?1:-1)*t*amp*.6)}const e0=e[0];const el=e.map(x=>x-e0),seg=total/N,g=[];for(let i=0;i<N;i++)g.push((el[i+1]-el[i])/seg*100);let up=0,dn=0;for(let i=0;i<N;i++){const d=el[i+1]-el[i];if(d>0)up+=d;else dn-=d}return{el,g,up,dn,max:Math.max(...g.map(Math.abs))}};
const lab=m=>m<3?['Flat','#2BA84A']:m<6?['Gentle slope','#2BA84A']:m<10?['Moderate climb','#F5A524']:['Steep','#E5484D'];
const col=g=>{g=Math.abs(g);return g<3?'#2BA84A':g<8?'#F5A524':'#E5484D'};
window.slFlat=()=>{M.wk.flat=!M.wk.flat;render('fade-none')};
const card=()=>{const K=M.wk,P=dest(),p=P.find(x=>x.id===K.sel)||P[0];if(!p)return'';let tot=dm(p);const m=tot;if(K.plan==='bus'&&wmin(m)>12)tot=Math.min(500,Math.round(m*.15/10)*10);
 const f=!!K.flat,pr=prof(p.id,tot,f),L=lab(Math.round(pr.max)),mx=Math.max(...pr.el),mn=Math.min(...pr.el),rg=(mx-mn)||1;
 const X=i=>(i/N*300).toFixed(1),Y=v=>(60-(v-mn)/rg*44).toFixed(1);
 let seg='';for(let i=0;i<N;i++)seg+=`<line x1="${X(i)}" y1="${Y(pr.el[i])}" x2="${X(i+1)}" y2="${Y(pr.el[i+1])}" stroke="${col(pr.g[i])}" stroke-width="4" stroke-linecap="round"/>`;
 const area=`<polygon points="0,66 ${pr.el.map((v,i)=>X(i)+','+Y(v)).join(' ')} 300,66" fill="var(--bg)" opacity=".6"/>`;
 const mxr=Math.round(pr.max),sm=mxr<=5?'Fine for strollers and wheelchairs.':mxr<8?'A little hard for wheelchairs on the steepest part.':'Steep for strollers and wheelchairs.';
 const btn=(mxr>=6||f)?`<button class="btn" onclick="slFlat()">${f?'Back to the usual route':'Choose the flatter route (+2 min)'}</button>`:'';
 return`<div class="dvh">Slope</div><div class="dvc"><b style="color:${L[1]}">${L[0]} · steepest ${mxr}%</b><div class="dvn" style="padding:4px 0 0">↑ ${Math.round(pr.up)} m climb · ↓ ${Math.round(pr.dn)} m down${f?' · flatter route (+2 min)':''}</div><svg viewBox="0 0 300 70" width="100%" style="display:block;margin-top:10px" role="img" aria-label="Elevation along the walk">${area}${seg}</svg><div style="display:flex;justify-content:space-between;font-size:12px;color:var(--tt)"><span>Start</span><span>${fm(tot)}</span></div><div class="dvn" style="padding:8px 0 0">Green: flat · Amber: slope · Red: steep. ${sm}</div>${btn}</div>`};
screens.mpwalk=function(){const h=String(_w.apply(this,arguments));try{const k='<div class="dvh">Settings</div>';const i=h.indexOf(k);if(i<0)return h;return h.slice(0,i)+card()+h.slice(i)}catch(e){console.error('naver-v605',e);return h}};
const cur=()=>{const R=M.wk&&M.wk.run;if(!R||R.done)return null;const pr=prof(R.id,R.total,M.wk.flat),i=Math.min(N-1,Math.floor(R.pos/R.total*N)),g=pr.g[i];return{R,pr,i,g}};
const gtx=g=>Math.abs(g)<1.5?'→ Flat':g>0?'↗ Uphill '+Math.round(g)+'%':'↘ Downhill '+Math.round(-g)+'%';
const tick=()=>{if(S.stack[S.stack.length-1]!=='mpwalknav'){clearInterval(SL.t);SL.t=null;return}const c=cur();if(!c)return;const e=document.getElementById('wkgr');if(e){e.textContent=gtx(c.g);e.style.color=col(c.g)}
 if(!c.R.sl){const a=c.pr.g[Math.min(N-1,c.i+2)];if(Math.abs(a)>=8&&a>0){c.R.sl=1;const t='Steep climb ahead, '+Math.round(a)+' percent';const v=document.getElementById('wkvo');if(c.R.voice){if(v)v.textContent='🔊 '+t;try{if(window.speechSynthesis){speechSynthesis.cancel();speechSynthesis.speak(new SpeechSynthesisUtterance(t))}}catch(x){}}}}};
screens.mpwalknav=function(){const h=String(_n.apply(this,arguments));try{const c=cur(),k='<div class="wkv" id="wkvo">';const i=h.indexOf(k);if(!c||i<0)return h;setTimeout(()=>{if(!SL.t)SL.t=setInterval(tick,800)},0);return h.slice(0,i)+`<div class="dvn" id="wkgr" style="padding:8px 24px 0;font-weight:700;color:${col(c.g)}">${gtx(c.g)}</div>`+h.slice(i)}catch(e){console.error('naver-v605',e);return h}};
})()}catch(x){console.error('naver-v605',x)}
/* v606: Naver Maps domain 19, Place Agent. Naver's Place Agent finds places from a plain sentence with several conditions, explains why each fits, takes follow-ups ("Which of these is quiet?") and books in the chat. An "Ask AI" chip on the map opens it. (1) Ask: type a sentence or tap a starter; the agent reads the kind of place (coffee, food, medicine, cash, bus) and conditions (quiet, Wi-Fi, parking, groups, family, outdoor, open late, near, top rated) and lists up to 3 places with the reasons they fit. (2) Follow-up: with no new kind of place, a question narrows the last list. (3) Book: tables and cafes show Book; pick day, time and people in the chat, agree to share your details, Confirm adds it to Book. AI notice always shown. English only; sample places, traits and answers. */
try{(()=>{
const M=S.mp,_mv=screens.mapview;
M.ag=M.ag||{m:[],last:[],q:'',bk:null};
const A=M.ag,P=()=>window.POI||[];
const esc=s=>String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const TR={cafe:['quiet','wifi','work'],cafe2:['wifi','work','takeaway'],rest:['parking','groups','family','outdoor']};
const CT=[['cafe',/coffee|cafe|dessert|cake|work|study|laptop/],['food',/eat|lunch|dinner|hungry|food|restaurant|grill|meal/],['pharm',/medicine|pharmac|sick|pain|drug/],['atm',/cash|money|atm|withdraw/],['bus',/\bbus\b|stop|transit/]];
const CD=[['quiet','Quiet',/quiet|calm|peaceful/],['wifi','Wi-Fi',/wi-?fi|internet|work|study|laptop/],['parking','Parking',/parking|by car|drive/],['groups','Good for groups',/group|party|friends|birthday/],['family','Family friendly',/family|kids|child/],['outdoor','Outdoor seating',/outdoor|terrace|garden|patio/],['late','Open late',/\blate\b|night/],['near','Close by',/near|close|walk|nearby|short/],['top','Top rated',/best|top|great|rated|good reviews/]];
const km=p=>{const v=parseFloat(p.d)||0;return /km/i.test(p.d||'')?v:v/1000};
const has=(p,k)=>k==='late'?(/24 hours/.test(p.o||'')||/closes (2[2-3]|00)/.test(p.o||'')):k==='near'?km(p)<=1.5:k==='top'?(parseFloat(p.r)||0)>=4.5:(TR[p.id]||[]).includes(k);
const rsv=p=>p.c==='cafe'||p.c==='food';
const mk=(id,s)=>{const p=P().find(x=>x.id===id);return p};
window.agIn=v=>{A.q=v};
window.agAsk=q=>{q=(q||'').trim();if(!q){toast('Type a question first');return}A.q='';A.bk=null;A.m.push({r:'u',x:q});const l=q.toLowerCase();
 const cats=CT.filter(c=>c[1].test(l)).map(c=>c[0]),cd=CD.filter(c=>c[2].test(l)&&!(c[0]==='wifi'&&!/wi-?fi|internet|laptop/.test(l)&&cats.length===0&&false));
 const fu=!cats.length&&A.last.length&&cd.length;let pool=fu?A.last.map(i=>P().find(p=>p.id===i)).filter(Boolean):P().filter(p=>(!cats.length||cats.includes(p.c))&&km(p)<=5);
 if(!cats.length&&!fu&&!cd.length){A.m.push({r:'a',x:'I could not match that. Try a kind of place and what matters, like "a quiet cafe with Wi-Fi" or "a restaurant with parking for a group".',res:[]});render('fade-none');return}
 const sc=pool.map(p=>{const hit=cd.filter(c=>has(p,c[0]));return{p,hit,n:hit.length}}).filter(x=>!cd.length||x.n>0).sort((a,b)=>b.n-a.n||km(a.p)-km(b.p));
 const full=sc.filter(x=>x.n===cd.length).length,top=sc.slice(0,3);
 A.last=top.map(x=>x.p.id);
 A.m.push({r:'a',x:!top.length?'Nothing nearby matches that. Try fewer conditions.':fu?'Narrowed down from the last list:':full===top.length?'Here '+(top.length>1?'are the places':'is the place')+' that fit:':full?'Best fit first. The others match only some conditions:':'No place fits everything. These match the most:',res:top.map(x=>({id:x.p.id,why:x.hit.map(h=>h[1]).concat([km(x.p).toFixed(1)+' km away']).join(' · ')}))});
 render('fade-none')};
window.agBook=id=>{A.bk={id,d:'Today',t:'19:00',n:2,ok:false};render('fade-none')};
window.agSet=(k,v)=>{if(A.bk){A.bk[k]=v;render('fade-none')}};
window.agOk=()=>{if(A.bk){A.bk.ok=!A.bk.ok;render('fade-none')}};
window.agGo=()=>{const b=A.bk,p=b&&P().find(x=>x.id===b.id);if(!p||!b.ok)return;M.rsv.unshift({p:p.n,t:b.d+' '+b.t,n:b.n,k:''});A.m.push({r:'a',x:'Booked: '+p.n+', '+b.d.toLowerCase()+' at '+b.t+' for '+b.n+'. You can cancel it in Book.',res:[]});A.bk=null;toast('Table for '+b.n+' · '+b.d+' '+b.t);render('fade-none')};
window.agReset=()=>{A.m=[];A.last=[];A.bk=null;render('fade-none')};
const row=r=>{const p=P().find(x=>x.id===r.id);if(!p)return'';return`<div class="dvr tap" onclick="mpDir('${p.id}')"><i>${p.e}</i><div><b>${p.n}</b><span>${p.r?'★ '+p.r.split(' ')[0]+' · ':''}${p.o}</span><br><span>${r.why}</span></div>${rsv(p)?`<button onclick="event.stopPropagation();agBook('${p.id}')">Book</button>`:''}</div>`};
const pills=(k,list,cur)=>`<div class="dvp">${list.map(v=>`<button class="${v===cur?'on':''}" onclick="agSet('${k}',${typeof v==='number'?v:`'${v}'`})"><i>${v}</i></button>`).join('')}</div>`;
screens.mpagent=()=>{const b=A.bk,bp=b&&P().find(x=>x.id===b.id);
 const msgs=A.m.map(m=>m.r==='u'?`<div class="agu">${esc(m.x)}</div>`:`<div class="aga">${esc(m.x)}</div>${(m.res||[]).map(row).join('')}`).join('');
 const st=['a quiet cafe with Wi-Fi to work','a restaurant with parking for a group','open late near me','medicine nearby'],fl=['Which of these is quiet?','Closest one','Open late'];
 const chips=(A.last.length&&A.m.length?fl:st).map(c=>`<button onclick="agAsk('${c}')">${c}</button>`).join('');
 const card=bp?`<div class="dvc"><b>Book ${bp.n}</b><div class="dvh" style="padding:10px 0 2px;font-size:14px">Day</div>${pills('d',['Today','Tomorrow'],b.d)}<div class="dvh" style="padding:10px 0 2px;font-size:14px">Time</div>${pills('t',['12:00','13:00','19:00','20:00'],b.t)}<div class="dvh" style="padding:10px 0 2px;font-size:14px">People</div>${pills('n',[1,2,3,4,5,6],b.n)}<div class="dvr tap" style="padding:12px 0 0" onclick="agOk()"><i>${b.ok?'☑️':'⬜'}</i><div><span>I agree to share my name and phone number with ${bp.n} to hold this booking.</span></div></div><button class="btn" style="margin-top:12px" ${b.ok?'':'disabled'} onclick="agGo()">Confirm booking</button><button class="btn sec2" style="margin-top:8px" onclick="A_c()">Cancel</button></div>`:'';
 return`<div class="mh" style="padding-bottom:0"><button class="ib" aria-label="Back" onclick="back()">${ic('back',24)}</button><b style="flex:1;font-size:19px;margin-left:6px">Place Agent</b>${A.m.length?'<button class="chip" onclick="agReset()">New chat</button>':''}</div>
<div class="dvn" style="padding-top:8px">Describe the place in one sentence. Add conditions, ask follow-ups, and book right here.</div>
${msgs}${card}
<div class="inf" style="padding-top:10px">${chips}</div>
<input class="in" style="margin:10px 24px 0;width:calc(100% - 48px)" aria-label="Ask Place Agent" placeholder="For example, a quiet cafe with Wi-Fi" value="${esc(A.q)}" oninput="agIn(this.value)" onkeydown="if(event.key==='Enter')agAsk(this.value)"><div class="cta" style="position:static;padding:10px 24px 0"><button class="btn" onclick="agAsk(S.mp.ag.q)">Send</button></div>
<div class="dvn" style="padding-bottom:24px">AI answers can be wrong. Check details before you go. Sample places, traits and answers.</div>`};
window.A_c=()=>{A.bk=null;render('fade-none')};
const st=document.createElement('style');st.textContent='.agu{margin:10px 24px 0 56px;padding:10px 14px;border-radius:18px 18px 4px 18px;background:var(--br);color:var(--on);font-size:15px;font-weight:600;width:fit-content;margin-left:auto;margin-right:24px;max-width:80%}.aga{margin:10px 24px 2px;padding:10px 14px;border-radius:18px 18px 18px 4px;background:var(--chip);font-size:15px;width:fit-content;max-width:86%}';document.head.appendChild(st);
screens.mapview=function(){const h=String(_mv.apply(this,arguments)),T=document.createElement('div');T.innerHTML=h;
 try{const rw=T.querySelector('.mpx');if(!rw||T.querySelector('[onclick="mpGo(\'mpagent\')"]'))return h;const b=rw.querySelector('button');if(!b)return h;const c=b.cloneNode(true);c.setAttribute('onclick',"mpGo('mpagent')");c.textContent='🤖 Ask AI';rw.appendChild(c)}catch(e){return h}
 return T.innerHTML};
})()}catch(x){console.error('naver-v606',x)}
/* v607: Naver Maps domain 20, Visitor mode. Naver's BE LOCAL tab shows visitors recommended places, restaurant coupons, reservations and payments, and Naver added passport verification for foreign users. A "Visitor" chip on the map opens "Visit Kigali". (1) Visitor mode switch (On or Off). (2) Passport check: enter a passport number (6 to 9 letters or digits); it shows Verified with only the last 3 characters and unlocks coupons; Remove clears it. (3) Local picks: three places with why a visitor would go, Directions and a coupon (10 to 15 percent) with Claim, which needs the passport check and turns into Claimed. (4) Say it in Kinyarwanda: five phrases, tap to copy. English only; sample picks, coupons and verification, no real passport data is stored or sent. */
try{(()=>{
const M=S.mp,_mv=screens.mapview;
M.vs=M.vs||{on:true,ver:null,cp:{},q:''};
const V=M.vs,esc=s=>String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const PK=[['cafe','☕','Rwandan coffee grown and roasted close by','10% off a drink'],['cafe2','☕','A calm first stop with an easy menu','10% off a drink'],['rest','🍽️','Grilled brochettes and local dishes','15% off the bill']];
const PH=[['Muraho','Hello'],['Murakoze','Thank you'],['Ni angahe?','How much is it?'],['Amazi','Water'],['Mbabarira','Excuse me, sorry']];
window.vsIn=v=>{V.q=v.replace(/[^A-Za-z0-9]/g,'').toUpperCase().slice(0,9)};
window.vsOn=()=>{V.on=!V.on;render('fade-none')};
window.vsVer=()=>{if(!/^[A-Z0-9]{6,9}$/.test(V.q)){toast('Enter 6 to 9 letters or numbers');return}V.ver=V.q.slice(-3);V.q='';toast('Passport verified');render('fade-none')};
window.vsRm=()=>{V.ver=null;V.cp={};toast('Passport removed');render('fade-none')};
window.vsClaim=id=>{if(!V.ver){toast('Verify your passport first');return}V.cp[id]=true;toast('Coupon claimed');render('fade-none')};
window.vsCopy=i=>{const p=PH[i];try{navigator.clipboard&&navigator.clipboard.writeText(p[0])}catch(e){}toast(p[0]+' · '+p[1])};
screens.mpvisitor=()=>{const P=window.POI||[];
 const pick=PK.map(([id,e,why,cp])=>{const p=P.find(x=>x.id===id);if(!p)return'';const got=V.cp[id];return`<div class="dvr tap" onclick="mpDir('${id}')"><i>${e}</i><div><b>${p.n}</b><span>${why}</span><br><span>${p.d} · ${p.o}</span><br><em style="color:var(--ok)">${cp}</em></div><button ${got?'disabled':''} onclick="event.stopPropagation();vsClaim('${id}')">${got?'Claimed':'Claim'}</button></div>`}).join('');
 const ver=V.ver?`<div class="dvr"><i>🛂</i><div><b>Passport verified</b><span>Ending ${V.ver}</span></div><button onclick="vsRm()">Remove</button></div>`:`<div class="dvr"><i>🛂</i><div><b>Verify your passport</b><span>Unlocks coupons, bookings and payments</span></div></div><input class="in" style="margin:6px 24px 0;width:calc(100% - 48px)" aria-label="Passport number" placeholder="Passport number" autocomplete="off" value="${esc(V.q)}" oninput="vsIn(this.value);this.value=S.mp.vs.q" onkeydown="if(event.key==='Enter')vsVer()"><div class="cta" style="position:static;padding:10px 24px 0"><button class="btn" onclick="vsVer()">Verify</button></div>`;
 return`<div class="mh" style="padding-bottom:0"><button class="ib" aria-label="Back" onclick="back()">${ic('back',24)}</button><b style="flex:1;font-size:19px;margin-left:6px">Visit Kigali</b></div>
<div class="dvr"><i>🧳</i><div><b>Visitor mode</b><span>${V.on?'Showing picks for people visiting Rwanda':'Showing your usual map'}</span></div><button onclick="vsOn()">${V.on?'On':'Off'}</button></div>
${V.on?`<div class="dvh">Passport</div>${ver}<div class="dvh">Local picks</div>${pick}<div class="dvh">Say it in Kinyarwanda</div>${PH.map((p,i)=>`<div class="dvr tap" onclick="vsCopy(${i})"><i>💬</i><div><b>${p[0]}</b><span>${p[1]}</span></div></div>`).join('')}`:'<div class="dvn">Turn on visitor mode for local picks, coupons and phrases.</div>'}
<div class="dvn" style="padding-bottom:24px">Sample picks and coupons. Verification here is a demo; no passport data is stored or sent.</div>`};
screens.mapview=function(){const h=String(_mv.apply(this,arguments)),T=document.createElement('div');T.innerHTML=h;
 try{const rw=T.querySelector('.mpx');if(!rw||T.querySelector('[onclick="mpGo(\'mpvisitor\')"]'))return h;const b=rw.querySelector('button');if(!b)return h;const c=b.cloneNode(true);c.setAttribute('onclick',"mpGo('mpvisitor')");c.textContent='🧳 Visitor';rw.appendChild(c)}catch(e){return h}
 return T.innerHTML};
})()}catch(x){console.error('naver-v607',x)}
/* v608: Naver Maps domain 21, Bookmarks 2.0. Naver added new emoji for Bookmark list icons, open or closed and booking or order labels on saved places, and viewing and sharing saved walking courses in the Bookmark tab. On Saved places: (1) Pick a folder chip and an "Icon for this list" row appears with 8 emoji; tap one and the chip shows it. (2) Every saved place gets a status line: Open until 22:00 (green), Closes soon (amber), Closed (red), Open 24 hours, or the next bus; cafes and restaurants add a Book label and cafes also Order ahead. (3) A "Walking courses" section lists 3 saved courses (distance, time, climb) with Walk, which opens walking directions to the course's end place, and Share, which copies a link. New courses are made on itunda for web, as on Naver. English only; sample courses and statuses. */
try{(()=>{
const M=S.mp,_s=screens.mpsaved;
M.fe=M.fe||[];
const EM=['⭐','📌','🍽️','☕','❤️','🏖️','🎒','🛍️'],DEF=['⭐','📌','🍽️'];
const CRS=[['c1','City centre stroll','3.2 km · 45 min · 40 m climb','cafe2'],['c2','Market and bus loop','1.1 km · 15 min · flat','bus2'],['c3','Grill House evening walk','2.4 km · 32 min · 25 m climb','rest']];
window.bmIc=e=>{const k=(M.sf||0)-1;if(k<0)return;M.fe[k]=e;toast('Icon changed');render('fade-none')};
window.bmWalk=id=>{if(M.wk){M.wk.sel=id;M.wk.plan='walk'}mpGo('mpwalk')};
window.bmShare=c=>{try{navigator.clipboard&&navigator.clipboard.writeText('https://itunda.rw/course/'+c)}catch(e){}toast('Course link copied')};
const clock=()=>{const d=new Date();return d.getHours()*60+d.getMinutes()};
const stat=p=>{const o=p.o||'';if(/24 hours/.test(o))return['Open 24 hours','#2BA84A'];const m=/closes (\d\d):(\d\d)/.exec(o);if(!m)return[o,'var(--mu)'];const c=+m[1]*60+ +m[2],n=clock();if(n<360||n>=c)return['Closed','#E5484D'];return c-n<=60?['Closes soon · '+m[1]+':'+m[2],'#F5A524']:['Open until '+m[1]+':'+m[2],'#2BA84A']};
const lab=p=>p.c==='cafe'?' · Book · Order ahead':p.c==='food'?' · Book':'';
screens.mpsaved=function(){const h=String(_s.apply(this,arguments)),T=document.createElement('div');T.innerHTML=h;
 try{const bar=T.querySelector('.nb.sf');if(!bar||T.querySelector('.bmx'))return h;const P=window.POI||[],k=M.sf||0;
  [...bar.querySelectorAll('button')].forEach((b,i)=>{if(i>0&&M.fe[i-1])b.innerHTML=b.innerHTML.replace(/^[^\s]+/,M.fe[i-1])});
  T.querySelectorAll('.pl.tap').forEach(r=>{const id=((r.getAttribute('onclick')||'').match(/'([^']+)'/)||[])[1],p=P.find(x=>x.id===id),sp=r.querySelector('span');if(!p||!sp)return;const s=stat(p);sp.insertAdjacentHTML('beforeend',`<br><em class="bmx" style="font-style:normal;font-weight:700;color:${s[1]}">${s[0]}${lab(p)}</em>`)});
  let ins='';
  if(k>0){const cur=M.fe[k-1]||DEF[k-1];ins+=`<div class="dvh" style="font-size:15px;padding-top:10px">Icon for this list</div><div class="dvp">${EM.map(e=>`<button class="${e===cur?'on':''}" aria-label="Use ${e}" onclick="bmIc('${e}')"><i>${e}</i></button>`).join('')}</div>`}
  const cs=`<div class="dvh">Walking courses</div>${CRS.map(c=>`<div class="dvr"><i>🥾</i><div><b>${c[1]}</b><span>${c[2]}</span></div><button onclick="bmWalk('${c[3]}')">Walk</button><button class="gh" onclick="bmShare('${c[0]}')">Share</button></div>`).join('')}<div class="dvn" style="padding-bottom:24px">New courses are made on itunda for web. Sample courses and open hours.</div>`;
  const anchor=T.querySelector('.slr')||bar;anchor.insertAdjacentHTML('afterend',ins);
  T.insertAdjacentHTML('beforeend',cs)}catch(e){console.error('naver-v608',e);return h}
 return T.innerHTML};
})()}catch(x){console.error('naver-v608',x)}
/* v609: Naver Maps domain 22, Intercity hookup. Naver added a button for booking train tickets on the results of intercity directions. In Directions a "Going to another city?" section (and a "🚍 Intercity" chip on the map, same section on its own page) lists Huye, Musanze, Rubavu and Rusizi with the trip time, the fare, the next bus (about 30 minutes from now, or 06:00 tomorrow after the last bus) and a Fastest or Cheapest tag. "Book a seat" sets the city, day, bus and 1 seat in the existing Intercity bus booking and opens it, so you only review and pay from itunda Pay. English only; sample departures. */
try{(()=>{
const M=S.mp,_dh=screens.dirhub,_mv=screens.mapview;
const CI=[['Huye',3500,'about 2 h',120],['Musanze',3000,'about 2 h',120],['Rubavu',4000,'about 3 h 30',210],['Rusizi',7500,'about 5 h',300]];
const p2=n=>String(n).padStart(2,'0');
const nxt=()=>{const n=new Date(),m=Math.max(Math.ceil((n.getHours()*60+n.getMinutes()+30)/30)*30,330);return m<=1350?{d:0,t:p2(Math.floor(m/60))+':'+p2(m%60)}:{d:1,t:'06:00'}};
window.icBook=i=>{const x=nxt();S.bus=Object.assign(S.bus||{},{to:i,day:x.d,time:x.t,seats:1});openSvc('bus')};
const sec=()=>{const x=nxt(),mn=Math.min(...CI.map(c=>c[3])),ch=Math.min(...CI.map(c=>c[1]));
 return`<div class="dvh">Going to another city?</div><div class="dvn" style="padding-top:2px">Buses leave Nyabugogo. Free to cancel up to 2 hours before.</div>${CI.map((c,i)=>{const tg=[c[3]===mn&&'Fastest',c[1]===ch&&'Cheapest'].filter(Boolean).join(' · ');return`<div class="dvr"><i>🚍</i><div><b>${c[0]}</b><span>${c[2]} · ${c[1].toLocaleString('en-US')} RWF</span><br><span>Next bus ${x.d?'tomorrow ':''}${x.t}</span>${tg?`<br><em style="font-style:normal;font-weight:700;color:var(--ok)">${tg}</em>`:''}</div><button onclick="icBook(${i})">Book a seat</button></div>`}).join('')}`};
screens.dirhub=function(){const h=String(_dh.apply(this,arguments));return h.includes('icBook(')?h:h+'<div class="icx">'+sec()+'<div class="dvn" style="padding-bottom:24px">Sample departures. You review and pay in the next step.</div></div>'};
screens.mpinter=()=>`<div class="mh" style="padding-bottom:0"><button class="ib" aria-label="Back" onclick="back()">${ic('back',24)}</button><b style="flex:1;font-size:19px;margin-left:6px">Intercity</b></div>${sec()}<div class="dvn" style="padding-bottom:24px">Sample departures. You review and pay in the next step.</div>`;
screens.mapview=function(){const h=String(_mv.apply(this,arguments)),T=document.createElement('div');T.innerHTML=h;
 try{const rw=T.querySelector('.mpx');if(!rw||T.querySelector('[onclick="mpGo(\'mpinter\')"]'))return h;const b=rw.querySelector('button');if(!b)return h;const c=b.cloneNode(true);c.setAttribute('onclick',"mpGo('mpinter')");c.textContent='🚍 Intercity';rw.appendChild(c)}catch(e){return h}
 return T.innerHTML};
})()}catch(x){console.error('naver-v609',x)}
/* v610: Naver Maps domain 23, Ride and bike links. Naver Map lets you request a taxi and reach bikes and scooters from the map. A "🚕 Ride" chip on the map opens "Ride or bike" and Directions gets a "Ride or bike there" row. (1) Pick a destination (up to 4 saved or nearby places; Directions passes the one you are viewing). (2) Moto and Car rows show the fare (same formula as Rides: 300 + 250 per km for moto, 900 + 450 per km for car, to the nearest 100 RWF), pickup wait and trip time, with a walk time for comparison. (3) Request shows the driver, plate and arrival, "pay by itunda after the trip", and Cancel. (4) "Rent a bike or scooter" opens Bike rental (20 and 50 RWF per min) with a ride-time estimate. Sample drivers; no money moves until a trip ends. English only. */
try{(()=>{
const M=S.mp,_dh=screens.dirhub,_mv=screens.mapview;
M.rd2=M.rd2||{to:null,v:0,req:null};const R=M.rd2;
const P=()=>window.POI||[],km=p=>{const v=parseFloat(p.d)||0;return /km/i.test(p.d||'')?v:v/1000};
const VH=[['🏍️','Moto',300,250,2,25,'RAD 482 C'],['🚗','Car',900,450,5,30,'RAB 215 K']];
const fare=(v,k)=>Math.round((VH[v][2]+k*VH[v][3])/100)*100,fmt=n=>n.toLocaleString('en-US');
const mins=(v,k)=>Math.max(2,Math.round(k/VH[v][5]*60));
const dest=()=>P().find(p=>p.id===R.to)||P().find(p=>p.c==='food')||P()[0];
window.rdTo=id=>{R.to=id;R.req=null;render('fade-none')};
window.rdV=i=>{R.v=i;R.req=null;render('fade-none')};
window.rdReq=()=>{const p=dest();if(!p)return;R.req={n:p.n,v:R.v,f:fare(R.v,km(p))};toast('Driver on the way');render('fade-none')};
window.rdCancel=()=>{R.req=null;toast('Ride cancelled');render('fade-none')};
window.rdOpen=id=>{if(id)R.to=id;R.req=null;mpGo('mpride')};
screens.mpride=()=>{const p=dest(),k=p?km(p):0,wk=Math.max(1,Math.round(k/5*60)),bk=Math.max(1,Math.round(k*5));
 const chips=P().filter(x=>x.c!=='bus'&&km(x)<=6).slice(0,4).map(x=>`<button class="${x.id===(p&&p.id)?'on':''}" onclick="rdTo('${x.id}')">${x.n}</button>`).join('');
 const req=R.req?`<div class="dvc"><b>${VH[R.req.v][0]} Driver on the way</b><div class="dvn" style="padding:6px 0 0">Jean M. · ${VH[R.req.v][6]} · arrives in ${VH[R.req.v][4]} min</div><div class="dvn" style="padding:2px 0 0">To ${R.req.n} · ${fmt(R.req.f)} RWF · pay by itunda after the trip</div><button class="btn sec2" style="margin-top:12px" onclick="rdCancel()">Cancel ride</button></div>`:'';
 return`<div class="mh" style="padding-bottom:0"><button class="ib" aria-label="Back" onclick="back()">${ic('back',24)}</button><b style="flex:1;font-size:19px;margin-left:6px">Ride or bike</b></div>
<div class="dvh">Where to?</div><div class="chp" style="padding-top:6px">${chips}</div>
${p?`<div class="dvn">${p.n} · ${p.d} away · walking about ${wk} min</div>
${VH.map((v,i)=>`<div class="dvr tap" onclick="rdV(${i})" style="${R.v===i?'background:var(--tint)':''}"><i>${v[0]}</i><div><b>${v[1]}</b><span>${v[4]} min away · about ${mins(i,k)} min trip</span></div><b>${fmt(fare(i,k))} RWF</b></div>`).join('')}
${req||`<div class="cta" style="position:static;padding:14px 24px 0"><button class="btn" onclick="rdReq()">Request ${VH[R.v][1].toLowerCase()}</button></div>`}
<div class="dvh">Or by bike</div><div class="dvr tap" onclick="openSvc('bike')"><i>🚲</i><div><b>Rent a bike or scooter</b><span>From 20 RWF/min · about ${bk} min ≈ ${fmt(bk*20)} RWF</span></div></div>`:''}
<div class="dvn" style="padding-bottom:24px">Sample drivers and fares. Nothing is charged until a trip ends.</div>`};
screens.dirhub=function(){let h=String(_dh.apply(this,arguments));if(h.includes('rdOpen('))return h;const s=`<div class="dvr tap" onclick="rdOpen(S.dh&&S.dh.dest)"><i>🚕</i><div><b>Ride or bike there</b><span>Moto, car, or a rented bike</span></div></div>`;return h.includes('<div class="icx">')?h.replace('<div class="icx">',s+'<div class="icx">'):h+s};
screens.mapview=function(){const h=String(_mv.apply(this,arguments)),T=document.createElement('div');T.innerHTML=h;
 try{const rw=T.querySelector('.mpx');if(!rw||T.querySelector('[onclick="mpGo(\'mpride\')"]'))return h;const b=rw.querySelector('button');if(!b)return h;const c=b.cloneNode(true);c.setAttribute('onclick',"mpGo('mpride')");c.textContent='🚕 Ride';rw.appendChild(c)}catch(e){return h}
 return T.innerHTML};
})()}catch(x){console.error('naver-v610',x)}
/* v611: Naver Maps domain 24, Disaster alerts. Naver Map added flood, dam-release and large-fire alerts to its incident icons, shows nearby important incidents as cards on the map home with a link to disaster action guidance, pre-marks flood-warning areas on route lines, warns about heavy rain or snow ahead on a route, and lets people share real-time damage reports. A "🌊 Safety" chip opens "Safety alerts". (1) Now: four sample alerts (Flood warning, Landslide risk, Heavy rain, Large fire) with level (Danger or Warning), place, distance, how long ago and until when; "What to do" opens three safety steps. (2) On your route: the alerts that touch your usual route; a flood area is pre-marked and Avoid adds a 6 min detour (tap again to stop). (3) Report what you see: Flooded road, Landslide, Fire, Fallen tree, with Here, 500 m ahead or On my route; it joins "Your reports" with a confirmation count and Withdraw. (4) Alert me about: switches for Flood, Landslide, Large fire and Heavy rain on my route. The chip shows the number of active alerts. English only; alerts, places and confirmations are sample data, not official warnings. */
try{(()=>{
const M=S.mp,_mv=screens.mapview;
M.ds=M.ds||{open:null,off:{},avoid:false,mine:[],rp:{type:null,where:'here'}};const D=M.ds;
const AL=[{id:'f1',t:'flood',e:'🌊',n:'Flood warning',r:'KN 3 Rd, low-lying section',km:2.4,age:25,until:'6:00 pm',lv:'Danger',route:true},{id:'l1',t:'slide',e:'⛰️',n:'Landslide risk',r:'Steep slope near KG 9 Ave',km:4.8,age:70,until:'Tomorrow',lv:'Warning',route:false},{id:'r1',t:'rain',e:'🌧️',n:'Heavy rain',r:'Kigali city',km:0,age:15,until:'7:00 pm',lv:'Warning',route:true},{id:'x1',t:'fire',e:'🔥',n:'Large fire',r:'Industrial area',km:6.1,age:40,until:'Ongoing',lv:'Danger',route:false}];
const TIPS={flood:['Do not walk or drive through flood water. Even shallow water can sweep a vehicle away.','Move to higher ground and keep away from rivers and drains.','Use another road and tell family where you are.'],slide:['Stay away from steep slopes and the foot of hillsides.','Cracks, mud in streams or tilted trees are warning signs. Leave early if you see them.','Move to firm, higher ground out of the slope\'s path.'],rain:['Slow down and keep a long gap in the rain.','Avoid low roads and underpasses that fill quickly.','Wait for the rain to ease if you can do so safely.'],fire:['Keep well away and stay upwind of the smoke.','Do not go near to film or look. Let fire crews work.','Call local emergency services if people are in danger.']};
const TY=[['flood','🌊','Flooded road'],['slide','⛰️','Landslide'],['fire','🔥','Fire'],['tree','🌳','Fallen tree']],SW=[['flood','🌊','Flood warnings','Rising water on roads and low areas'],['slide','⛰️','Landslide risk','Steep slopes after heavy rain'],['fire','🔥','Large fires','Fires that affect roads or air'],['rain','🌧️','Heavy rain on my route','Warn me before I set off']];
const clk=m=>{m=((m%1440)+1440)%1440;const h=Math.floor(m/60);return (h%12||12)+':'+String(m%60).padStart(2,'0')+' '+(h<12?'am':'pm')};
const act=()=>AL.filter(a=>!D.off[a.t]);
const col=a=>a.lv==='Danger'?'#E5484D':'#F5A524';
window.dsOpen=id=>{D.open=D.open===id?null:id;render('fade-none')};
window.dsAvoid=()=>{D.avoid=!D.avoid;toast(D.avoid?'Route avoids the flood area · +6 min':'No longer avoiding');render('fade-none')};
window.dsSw=k=>{D.off[k]=D.off[k]?0:1;render('fade-none')};
window.dsRp=(k,v)=>{D.rp[k]=v;render('fade-none')};
window.dsSend=()=>{const t=TY.find(x=>x[0]===D.rp.type);if(!t)return;const w={here:'Here',ahead:'500 m ahead',route:'On my route'}[D.rp.where],d=new Date();D.mine.unshift({e:t[1],n:t[2],w,at:clk(d.getHours()*60+d.getMinutes()),c:1+Math.floor(Math.random()*3)});D.rp={type:null,where:'here'};toast(t[2]+' reported. People nearby will see it.');render('fade-none')};
window.dsDel=i=>{D.mine.splice(i,1);toast('Report withdrawn');render('fade-none')};
const chip=(a,on,fn)=>`<div class="inf" style="padding-top:4px">${a.map(x=>`<button class="${on(x)?'on':''}" onclick="${fn(x)}">${x[1]}</button>`).join('')}</div>`;
screens.mpdisaster=()=>{const A=act(),rt=A.filter(a=>a.route);
 const cards=A.length?A.map(a=>{const d=clk(new Date().getHours()*60+new Date().getMinutes()-a.age);return`<div class="dvr tap" onclick="dsOpen('${a.id}')"><i>${a.e}</i><div><b>${a.n}</b><span>${a.r}${a.km?' · '+a.km.toFixed(1)+' km':''}</span><br><em style="font-style:normal;font-weight:700;color:${col(a)}">${a.lv}</em> <span>· since ${d} · until ${a.until}</span>${D.open===a.id?`<div style="padding-top:8px;font-size:14px;line-height:21px"><b>What to do</b>${TIPS[a.t].map(t=>'<br>• '+t).join('')}</div>`:'<br><span>What to do ›</span>'}</div></div>`}).join(''):'<div class="dvn">No active alerts near you.</div>';
 const route=rt.length?`<div class="dvc"><b>Your usual route</b><div class="dvn" style="padding:4px 0 0">${rt.length} alert${rt.length>1?'s':''} on your route: ${rt.map(a=>a.n.toLowerCase()).join(' and ')}.${rt.some(a=>a.t==='flood')?(D.avoid?' Your route now avoids the flood area (+6 min).':' The flood area is marked on your route line.'):''}</div>${rt.some(a=>a.t==='flood')?`<button class="btn sec2" style="margin-top:10px" onclick="dsAvoid()">${D.avoid?'Stop avoiding':'Avoid flood area'}</button>`:''}</div>`:'<div class="dvn">No alerts on your usual route.</div>';
 const mine=D.mine.map((m,i)=>`<div class="dvr"><i>${m.e}</i><div><b>${m.n}</b><span>${m.w} · ${m.at}</span><br><em style="font-style:normal;color:#2BA84A">${m.c} person${m.c>1?'s':''} confirmed</em></div><button class="gh" onclick="dsDel(${i})">Withdraw</button></div>`).join('');
 return`<div class="mh" style="padding-bottom:0"><button class="ib" aria-label="Back" onclick="back()">${ic('back',24)}</button><b style="flex:1;font-size:19px;margin-left:6px">Safety alerts</b></div>
<div class="dvh">Now</div>${cards}<div class="dvh">On your route</div>${route}
<div class="dvh">Report what you see</div>${chip(TY.map(t=>[t[0],t[1]+' '+t[2]]),x=>x[0]===D.rp.type,x=>`dsRp('type','${x[0]}')`)}${chip([['here','Here'],['ahead','500 m ahead'],['route','On my route']],x=>x[0]===D.rp.where,x=>`dsRp('where','${x[0]}')`)}<div class="cta" style="position:static;padding:12px 24px 0"><button class="btn" ${D.rp.type?'':'disabled'} onclick="dsSend()">Send report</button></div>
<div class="dvh">Your reports</div>${mine||'<div class="dvn">No reports yet.</div>'}
<div class="dvh">Alert me about</div>${SW.map(s=>`<div class="dvr"><i>${s[1]}</i><div><b>${s[2]}</b><span>${s[3]}</span></div><button onclick="dsSw('${s[0]}')">${D.off[s[0]]?'Off':'On'}</button></div>`).join('')}
<div class="dvn" style="padding-bottom:24px">Sample alerts, not official warnings. In an emergency follow local authorities.</div>`};
screens.mapview=function(){const h=String(_mv.apply(this,arguments)),T=document.createElement('div');T.innerHTML=h;
 try{const rw=T.querySelector('.mpx');if(!rw||T.querySelector('[onclick="mpGo(\'mpdisaster\')"]'))return h;const b=rw.querySelector('button');if(!b)return h;const c=b.cloneNode(true);c.setAttribute('onclick',"mpGo('mpdisaster')");c.textContent='🌊 Safety · '+act().length;rw.appendChild(c)}catch(e){return h}
 return T.innerHTML};
})()}catch(x){console.error('naver-v611',x)}
/* v612: Naver Maps domain 25, Hands-free voice. Naver Map is bringing real-time voice guidance and voice commands, such as asking when you will arrive or where the nearest convenience store is, to Meta, Google and Samsung smart glasses. A "🕶️ Hands-free" chip opens it. (1) Connect: pick Meta, Google or Samsung glasses (Connect, then Connected with Disconnect). (2) Voice replies switch (On speaks each answer; Off only shows it). (3) Ask: tap the mic (where the browser has speech recognition) or type or tap a command: "When will I arrive?", "What's my next turn?", "Where's the nearest cafe?" (also restaurant, pharmacy, cash machine, bus stop), "Stop guidance". The answer shows in a Glasses view card and is spoken if voice replies are on. Arrival uses the walk to the place you are viewing in Directions (5 km/h), the nearest place uses distance. English only; sample turns and places, no real glasses are connected. */
try{(()=>{
const M=S.mp,_mv=screens.mapview;
M.hf=M.hf||{dev:null,voice:true,q:'',ans:null,on:true};const H=M.hf;
const P=()=>window.POI||[],km=p=>{const v=parseFloat(p.d)||0;return /km/i.test(p.d||'')?v:v/1000};
const DV=[['meta','Meta glasses'],['google','Google glasses'],['samsung','Samsung glasses']];
const CT=[['cafe',/coffee|cafe/,'cafe'],['food',/restaurant|food|eat|lunch|dinner/,'restaurant'],['pharm',/pharmac|medicine/,'pharmacy'],['atm',/cash|atm|money/,'cash machine'],['bus',/\bbus\b|stop/,'bus stop']];
const dest=()=>P().find(p=>p.id===(S.dh&&S.dh.dest))||P().find(p=>p.c==='food')||P()[0];
const reply=q=>{const l=q.toLowerCase();
 if(/stop|cancel|end/.test(l)&&/guid|navig|route|stop/.test(l)){H.on=false;return'Guidance stopped.'}
 if(/arriv|how long|eta|when/.test(l)){const d=dest();if(!d)return'I have no destination yet.';if(!H.on){H.on=true}const m=Math.max(1,Math.round(km(d)/5*60)),t=new Date(Date.now()+m*6e4);return`You will arrive at ${d.n} in ${m} minute${m>1?'s':''}, at ${t.toLocaleTimeString('en-GB',{hour:'2-digit',minute:'2-digit'})}.`}
 if(/turn|next|direction/.test(l))return H.on?'In 120 meters, turn right onto KG 11 Ave.':'Guidance is stopped. Say "When will I arrive" to restart.';
 const c=CT.find(x=>x[1].test(l));
 if(/near|where|find|closest/.test(l)&&c){const p=P().filter(x=>x.c===c[0]).sort((a,b)=>km(a)-km(b))[0];return p?`The nearest ${c[2]} is ${p.n}, ${p.d} away.`:`I could not find a ${c[2]} nearby.`}
 return'Sorry, I did not catch that. Try "When will I arrive?" or "Where is the nearest cafe?"'};
const say=t=>{if(!H.voice)return;try{if(window.speechSynthesis){speechSynthesis.cancel();speechSynthesis.speak(new SpeechSynthesisUtterance(t))}}catch(e){}};
window.hfIn=v=>{H.q=v};
window.hfAsk=q=>{q=(q||'').trim();if(!q){toast('Say or type a command');return}if(!H.dev){toast('Connect glasses first');return}const a=reply(q);H.ans={q,a};H.q='';say(a);render('fade-none')};
window.hfDev=k=>{H.dev=H.dev===k?null:k;H.ans=null;toast(H.dev?'Connected':'Disconnected');render('fade-none')};
window.hfV=()=>{H.voice=!H.voice;render('fade-none')};
window.hfMic=()=>{const R=window.SpeechRecognition||window.webkitSpeechRecognition;if(!R){toast('Speech input is not available here. Type or tap a command.');return}try{const r=new R();r.lang='en-US';r.onresult=e=>hfAsk(e.results[0][0].transcript);r.onerror=()=>toast('Could not hear you');r.start()}catch(e){toast('Could not start the microphone')}};
screens.mphands=()=>{const cm=['When will I arrive?','What\'s my next turn?','Where\'s the nearest cafe?','Where\'s the nearest pharmacy?','Stop guidance'];
 return`<div class="mh" style="padding-bottom:0"><button class="ib" aria-label="Back" onclick="back()">${ic('back',24)}</button><b style="flex:1;font-size:19px;margin-left:6px">Hands-free</b></div>
<div class="dvn" style="padding-top:8px">Walk with voice guidance on smart glasses, and ask questions by voice.</div>
<div class="dvh">Glasses</div>${DV.map(d=>`<div class="dvr"><i>🕶️</i><div><b>${d[1]}</b><span>${H.dev===d[0]?'Connected':'Not connected'}</span></div><button onclick="hfDev('${d[0]}')">${H.dev===d[0]?'Disconnect':'Connect'}</button></div>`).join('')}
<div class="dvr"><i>🔊</i><div><b>Voice replies</b><span>Speak each answer out loud</span></div><button onclick="hfV()">${H.voice?'On':'Off'}</button></div>
<div class="dvh">Ask</div><div class="inf" style="padding-top:4px">${cm.map(c=>`<button onclick="hfAsk(this.textContent)">${c}</button>`).join('')}</div>
<input class="in" style="margin:10px 24px 0;width:calc(100% - 48px)" aria-label="Voice command" placeholder="Type a command" value="${(H.q||'').replace(/"/g,'&quot;')}" oninput="hfIn(this.value)" onkeydown="if(event.key==='Enter')hfAsk(this.value)"><div class="cta" style="position:static;padding:10px 24px 0;display:flex;gap:8px"><button class="btn" onclick="hfAsk(S.mp.hf.q)">Send</button><button class="btn sec2" aria-label="Speak" onclick="hfMic()">🎤</button></div>
${H.ans?`<div class="dvh">Glasses view</div><div class="dvc"><div class="dvn" style="padding:0">You: ${H.ans.q.replace(/[<>&]/g,'')}</div><b style="display:block;margin-top:8px;font-size:17px">${H.ans.a}</b></div>`:''}
<div class="dvn" style="padding-bottom:24px">Sample turns and places. No real glasses are connected.</div>`};
screens.mapview=function(){const h=String(_mv.apply(this,arguments)),T=document.createElement('div');T.innerHTML=h;
 try{const rw=T.querySelector('.mpx');if(!rw||T.querySelector('[onclick="mpGo(\'mphands\')"]'))return h;const b=rw.querySelector('button');if(!b)return h;const c=b.cloneNode(true);c.setAttribute('onclick',"mpGo('mphands')");c.textContent='🕶️ Hands-free';rw.appendChild(c)}catch(e){return h}
 return T.innerHTML};
})()}catch(x){console.error('naver-v612',x)}
/* v613: Naver Maps domain 26, Driving-style arrival and car connection. Naver Navigation gives arrival estimates based on your driving style and can open the app automatically when your car connects over Bluetooth. In Car mode two cards sit under "Commute first". (1) Driving style: Auto (learned from your last 20 trips, Relaxed in this sample), Relaxed (estimates 10% longer), Typical (standard) or Quick (7% shorter). The Likely destination time follows it and a line under it says how many minutes it differs from the standard estimate. Leave-by times on appointments still use the standard estimate. (2) Car connection: "Open Car mode when my car connects" switch (On or Off), the paired car (Add my car, then Toyota RAV4 with Remove), and "Simulate connecting", which shows "Connected to your car. Car mode opened" when the switch is on and the car is paired, or says what is missing. English only; the style, trips and Bluetooth are sample; nothing is paired for real. */
try{(()=>{
const M=S.mp,_c=screens.mpcar;
M.dst=M.dst||{style:'auto',on:true,car:null,msg:null};const D=M.dst;
const ST={auto:['Auto','Learned from your last 20 trips: you drive about 8% under the usual pace',1.10],relaxed:['Relaxed','Estimates about 10% longer',1.10],typical:['Typical','Standard estimate',1],quick:['Quick','Estimates about 7% shorter',.93]};
const f=()=>ST[D.style][2];
window.dsStyle=k=>{D.style=k;render('fade-none')};
window.dsBt=()=>{D.on=!D.on;D.msg=null;render('fade-none')};
window.dsCar=()=>{D.car=D.car?null:'Toyota RAV4';D.msg=null;toast(D.car?'Car added':'Car removed');render('fade-none')};
window.dsSim=()=>{D.msg=!D.car?'Add your car first.':!D.on?'Auto-open is off. Turn it on to open Car mode when your car connects.':'Connected to '+D.car+'. Car mode opened with your likely destination.';render('fade-none')};
screens.mpcar=function(){let h=String(_c.apply(this,arguments));if(h.includes('dsStyle('))return h;
 h=h.replace(/(<div style="font-size:28px;font-weight:800;margin-top:10px">)(\d+) min(<\/div>)/,(m,a,n,z)=>{const adj=Math.max(1,Math.round(n*f())),d=adj-n;return a+adj+' min'+z+`<div class="dvn" style="padding:2px 0 0">${D.style==='typical'?'Standard estimate for a typical driver.':'For your style ('+ST[D.style==='auto'?'relaxed':D.style][0].toLowerCase()+'): '+(d===0?'same as':Math.abs(d)+' min '+(d>0?'longer':'shorter')+' than')+' the standard '+n+' min.'}</div>`});
 const cards=`<div class="dvh">Driving style</div><div class="dvp">${Object.keys(ST).map(k=>`<button class="${D.style===k?'on':''}" onclick="dsStyle('${k}')"><i>${ST[k][0]}</i></button>`).join('')}</div><div class="dvn" style="padding-top:6px">${ST[D.style][1]}.</div>
<div class="dvh">Car connection</div><div class="dvr"><i>🚗</i><div><b>${D.car||'No car paired'}</b><span>${D.car?'Bluetooth paired':'Pair your car to use auto-open'}</span></div><button onclick="dsCar()">${D.car?'Remove':'Add my car'}</button></div><div class="dvr"><i>📲</i><div><b>Open Car mode when my car connects</b><span>Starts with your likely destination</span></div><button onclick="dsBt()">${D.on?'On':'Off'}</button></div><div class="cta" style="position:static;padding:10px 24px 0"><button class="btn sec2" onclick="dsSim()">Simulate connecting</button></div>${D.msg?`<div class="dvn" style="padding-top:8px;color:var(--tx)"><b>${D.msg}</b></div>`:''}<div class="dvn">Sample driving style and Bluetooth. Nothing is paired for real.</div>`;
 return h.includes('<div class="dvh">Your car</div>')?h.replace('<div class="dvh">Your car</div>',cards+'<div class="dvh">Your car</div>'):h+cards};
})()}catch(x){console.error('naver-v613',x)}
/* v614: Naver Maps domain 27, Traffic cameras. Naver Map streams real-time traffic-camera views so you can check how busy a road is. A "📹 Cameras" chip opens "Traffic cameras". (1) Five sample cameras on city roads with a traffic label (Light, Moderate or Heavy), average speed, and a star to save. (2) Filters: All, On my route, Saved. (3) Tap one for a "Live" view (a drawn road scene whose car count follows the traffic level, with the time it was taken), Refresh (new scene, speed and time change slightly), and a one-line advice (for example leave later or use another road). English only; views, speeds and levels are sample, not real video. */
try{(()=>{
const M=S.mp,_mv=screens.mapview;
M.cam=M.cam||{f:'all',sel:null,fav:{},k:0,ov:{}};const C=M.cam;
const CAM=[{id:'c1',n:'KN 2 Rd · Nyabugogo',lv:2,sp:14,route:true},{id:'c2',n:'KG 7 Ave · Roundabout',lv:1,sp:32,route:true},{id:'c3',n:'KN 3 Rd · Kimironko',lv:0,sp:48,route:false},{id:'c4',n:'KG 11 Ave · Remera',lv:1,sp:30,route:false},{id:'c5',n:'KG 9 Ave · Gisozi',lv:0,sp:52,route:false}];
const LV=[['Light','#2BA84A','Roads are clear. Good time to go.'],['Moderate','#F5A524','Some slow traffic. Allow a few extra minutes.'],['Heavy','#E5484D','Heavy traffic. Leave later or take another road.']];
const clk=d=>d.toLocaleTimeString('en-GB',{hour:'2-digit',minute:'2-digit',second:'2-digit'});
const cur=c=>{const o=C.ov[c.id]||{};return{lv:o.lv==null?c.lv:o.lv,sp:o.sp==null?c.sp:o.sp,at:o.at}};
const rnd=s=>()=>(s=(s*1664525+1013904223)>>>0)/4294967296;
const scene=(c,v)=>{let h=0;for(const ch of c.id)h=h*31+ch.charCodeAt(0);const r=rnd(h+C.k*977+7),n=[3,7,12][v.lv],cols=['#E5484D','#3B82F6','#F5F5F5','#F5A524','#6B7280'];let cars='';
 for(let i=0;i<n;i++){const lane=i%4,y=[46,72,104,130][lane],x=10+((i*(300/n)+r()*20)%280),dir=lane<2;cars+=`<rect x="${x.toFixed(0)}" y="${y}" width="${v.lv===2?30:26}" height="14" rx="4" fill="${cols[Math.floor(r()*cols.length)]}"/>`}
 return`<svg viewBox="0 0 320 180" role="img" aria-label="Traffic camera view, ${LV[v.lv][0].toLowerCase()} traffic" style="width:100%;border-radius:12px;display:block"><rect width="320" height="180" fill="#333D4B"/><rect y="36" width="320" height="116" fill="#454C57"/><path d="M0 92H320M0 100H320" stroke="#F5D547" stroke-width="2"/><path d="M0 66H320M0 126H320" stroke="#fff" stroke-width="1.5" stroke-dasharray="14 12" opacity=".7"/>${cars}<rect x="8" y="8" width="44" height="18" rx="9" fill="#E5484D"/><text x="30" y="21" fill="#fff" font-size="11" font-weight="700" text-anchor="middle">LIVE</text><text x="312" y="21" fill="#fff" font-size="11" text-anchor="end">${v.at}</text></svg>`};
window.cmF=k=>{C.f=k;C.sel=null;render('fade-none')};
window.cmSel=id=>{C.sel=C.sel===id?null:id;if(C.sel&&!(C.ov[id]||{}).at)C.ov[id]={at:clk(new Date())};render('fade-none')};
window.cmFav=id=>{C.fav[id]=!C.fav[id];render('fade-none')};
window.cmRef=id=>{const c=CAM.find(x=>x.id===id),o=C.ov[id]||{},b=cur(c);C.k++;const ch=Math.random();let lv=b.lv;if(ch<.2&&lv<2)lv++;else if(ch>.8&&lv>0)lv--;C.ov[id]={lv,sp:Math.max(8,Math.round(b.sp+(Math.random()*8-4)+(lv-b.lv)*-8)),at:clk(new Date())};toast('Updated');render('fade-none')};
screens.mpcam=()=>{const l=CAM.filter(c=>C.f==='all'||(C.f==='route'&&c.route)||(C.f==='saved'&&C.fav[c.id]));
 const rows=l.map(c=>{const v=cur(c),L=LV[v.lv],open=C.sel===c.id;return`<div class="dvr tap" onclick="cmSel('${c.id}')"><i>📹</i><div><b>${c.n}</b><span>${v.sp} km/h average${c.route?' · on your route':''}</span><br><em style="font-style:normal;font-weight:700;color:${L[1]}">${L[0]}</em></div><button aria-label="${C.fav[c.id]?'Unsave':'Save'} camera" onclick="event.stopPropagation();cmFav('${c.id}')">${C.fav[c.id]?'★':'☆'}</button></div>${open?`<div style="padding:0 24px 8px">${scene(c,v)}<div class="dvn" style="padding:8px 0 0">${L[2]}</div><div style="display:flex;gap:8px;padding-top:8px"><button class="btn sec2" onclick="cmRef('${c.id}')">Refresh</button></div></div>`:''}`}).join('');
 return`<div class="mh" style="padding-bottom:0"><button class="ib" aria-label="Back" onclick="back()">${ic('back',24)}</button><b style="flex:1;font-size:19px;margin-left:6px">Traffic cameras</b></div>
<div class="dvn" style="padding-top:8px">See how busy a road is before you go.</div>${chip([['all','All'],['route','On my route'],['saved','Saved']],x=>x[0]===C.f,x=>`cmF('${x[0]}')`)}
${rows||'<div class="dvn">'+(C.f==='saved'?'No saved cameras yet. Tap ☆ on a camera.':'No cameras on your route.')+'</div>'}<div class="dvn" style="padding-bottom:24px">Sample views, speeds and levels. These are drawings, not real video.</div>`};
const chip=(a,on,fn)=>`<div class="inf" style="padding-top:4px">${a.map(x=>`<button class="${on(x)?'on':''}" onclick="${fn(x)}">${x[1]}</button>`).join('')}</div>`;
screens.mapview=function(){const h=String(_mv.apply(this,arguments)),T=document.createElement('div');T.innerHTML=h;
 try{const rw=T.querySelector('.mpx');if(!rw||T.querySelector('[onclick="mpGo(\'mpcam\')"]'))return h;const b=rw.querySelector('button');if(!b)return h;const c=b.cloneNode(true);c.setAttribute('onclick',"mpGo('mpcam')");c.textContent='📹 Cameras';rw.appendChild(c)}catch(e){return h}
 return T.innerHTML};
})()}catch(x){console.error('naver-v614',x)}

/* v615: Naver Maps / Naver Place. Place: (1) "What visitors liked" like Naver's review keywords: five short phrases with a bar and a vote count (sample, ranked high to low), above "More about this place". (2) "My note" like the memo Naver lets you add to a saved place: one line (80 letters) kept per place, shown again when you come back; clearing it removes it. Directions (bus routes): (3) "Show 11 stops" like Naver's stop list: opens the stops from boarding to getting off with minutes from boarding. (4) "Get-off alert" pill like Naver's: on, it says we will tell you one stop before Nyabugogo. English only; keywords, votes and stops are sample data. */
try{(()=>{
const _p=screens.place,_r=screens.route,M=S.mp;

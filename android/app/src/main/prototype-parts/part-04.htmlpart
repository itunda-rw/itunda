</style>
<script id="ez649">
try{(()=>{
if(typeof screens==='undefined'||!screens.etrack)return;
const T=(e,f,r)=>({en:e,fr:f,rw:r}[S.lang]||e);
const _t9=screens.etrack;
/* Why the summary was missing: v646 put it inside #etx, and #etx is rewritten twice a second by the live tracker, so the dishes, total and "Arrives by" vanished half a second after the page opened. It now sits above #etx, where the tracker does not touch it. */
screens.etrack=function(){const h=_t9.apply(this,arguments);try{
 const a=h.indexOf('<div class="ez-ts"'),x=h.indexOf('id="etx"');
 if(a<0||x<0)return h;
 const c=h.indexOf('Cancel order',a);
 let sum='',rest=h;
 if(c>0&&a>x){const end=h.lastIndexOf('<button',c);sum=h.slice(a,end);rest=h.slice(0,a)+h.slice(end)}
 else if(a<x){return h}
 else return h;
 const o=S.orders.find(y=>y.k==='Eats order'&&y.items);
 const live=o&&!o.pickup&&!/Delivered|Picked up|Cancelled/.test(o.s||'')&&!S.ecancel;
 const code=live?`<div class="ez-dc"><div class="sm mu" style="font-size:13px">${T('Delivery code','Code de livraison','Kode yo kugezwaho')}</div><div class="ez-dn">4821</div><div class="sm mu" style="margin-top:2px;font-size:13px">${T('Tell your rider this code at the door. Not before.','Donnez ce code au livreur à la porte. Pas avant.','Gira umushoferi iyi kode ku muryango. Si mbere.')}</div></div>`:'';
 const k=rest.lastIndexOf('<div',rest.indexOf('id="etx"'));
 return rest.slice(0,k)+code+sum+rest.slice(k);
}catch(e){console.error('ez649',e);return h}};
})()}catch(x){console.error('eats-v649',x)}
</script>
<script id="ez650">
try{(()=>{
if(typeof screens==='undefined'||!screens.eorders)return;
const T=(e,f,r)=>({en:e,fr:f,rw:r}[S.lang]||e);
const hm=t=>{const d=new Date(t);return String(d.getHours()).padStart(2,'0')+':'+String(d.getMinutes()).padStart(2,'0')};
const _o9=screens.eorders;
/* v650: an order still on its way shows when it arrives (or is ready) and the delivery code, right in the Orders list. */
screens.eorders=function(){const h=_o9.apply(this,arguments);try{
 if(h.includes('ez-ol'))return h;
 const L=S.orders.filter(o=>o.k==='Eats order'&&o.items);if(!L.length)return h;
 const seg=h.split('<div class="ez-or"');if(seg.length<2)return h;
 for(let n=1;n<seg.length;n++){const o=L[n-1];if(!o||!o.eta||/Delivered|Picked up|Cancelled/.test(o.s||''))continue;
  const m=seg[n].indexOf('margin-top:2px;color:');if(m<0)continue;
  const e=seg[n].indexOf('</div>',m);if(e<0)continue;
  const line=`<div class="ez-ol sm mu" style="margin-top:2px">${o.pickup?T('Ready by','Prêt vers','Bizaba byiteguye saa'):T('Arrives by','Arrive vers','Bizahagera saa')} ${hm(o.eta)}${o.pickup?'':' · '+T('Code','Code','Kode')+' 4821'}</div>`;
  seg[n]=seg[n].slice(0,e+6)+line+seg[n].slice(e+6)}
 return seg.join('<div class="ez-or"');
}catch(e){console.error('ez650',e);return h}};
})()}catch(x){console.error('eats-v650',x)}
</script>



<script id="ez654">
try{(()=>{
if(typeof screens==='undefined'||!screens.route||typeof M==='undefined')return;
/* v654 Directions: "Leave now" strip under the travel modes with the arrival time, and a leave-later picker (in 15 min, 30 min, 1 hour) that moves the arrival time. */
const T=(e,f,r)=>({en:e,fr:f,rw:r}[S.lang]||e);
const hm=ms=>{const d=new Date(ms);return String(d.getHours()).padStart(2,'0')+':'+String(d.getMinutes()).padStart(2,'0')};
const OFF=[[0,'Leave now','Partir maintenant','Genda ubu'],[15,'In 15 min','Dans 15 min','Mu minota 15'],[30,'In 30 min','Dans 30 min','Mu minota 30'],[60,'In 1 hour','Dans 1 h','Mu isaha 1']];
window.rdep=k=>{M.dep=k;render('fade-none')};
const _r=screens.route;
screens.route=()=>{let h=_r();try{
 const o=OPT[M.mode],cur=o[Math.min(M.opt,o.length-1)],off=OFF[M.dep||0],now=Date.now();
 const go=now+off[0]*60000,arr=go+cur[1]*60000;
 const chips=OFF.map((x,i)=>`<button class="${(M.dep||0)===i?'on':''}" onclick="rdep(${i})" style="flex:none;height:34px;padding:0 14px;border-radius:17px;border:0;font-size:13px;font-weight:700;background:${(M.dep||0)===i?'var(--tx)':'var(--chip)'};color:${(M.dep||0)===i?'var(--bg)':'var(--tx)'}">${T(x[1],x[2],x[3])}</button>`).join('');
 const strip=`<div style="padding:12px 24px 0"><div style="display:flex;justify-content:space-between;align-items:baseline"><div style="font-size:16px;font-weight:800">${T('Arrive','Kugerayo','Arrivée')} ${hm(arr)}</div><div class="sm mu">${T('Leave','Genda','Départ')} ${hm(go)} · ${cur[1]} min</div></div><div style="display:flex;gap:8px;overflow-x:auto;margin-top:10px;scrollbar-width:none">${chips}</div></div>`;
 const m=h.indexOf('<div class="modes">');if(m<0)return h;
 const e=h.indexOf('</button></div>',m);if(e<0)return h;
 const at=e+'</button></div>'.length;
 return h.slice(0,at)+strip+h.slice(at)
}catch(x){console.error('ez654',x);return h}};
})()}catch(x){console.error('dir-v654',x)}
</script>
<style id="ez655s">
/* v655: Eats header and cards no longer cut names; Directions and Places show real travel times; Home gets one quiet "Around you" block. */
#phone .ez-ad{font-size:15px}
#phone .ez-ad span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
#phone .ez-promo b{font-size:15px;line-height:20px;display:block}

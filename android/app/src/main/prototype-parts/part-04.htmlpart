<script id="ez662">
try{(()=>{
if(typeof screens==='undefined'||typeof STK==='undefined'||!S.inv)return;
/* v662: itunda 증권, round 5. Portfolio: a "Today" line under the invested value (how much your shares moved today, in RWF and %), like Toss's daily gain. Stock page: a "Will it rise today?" card with Rise / Fall buttons; after you vote it shows the sample crowd split and your pick, and a tap on the same card keeps the vote (one vote per stock). Sample data. */
const I=S.inv,T=(e,f)=>({en:e,fr:f||e,rw:e}[S.lang]||e);
const hash=s=>{let h=2166136261;for(let i=0;i<s.length;i++){h^=s.charCodeAt(i);h=Math.imul(h,16777619)}return h>>>0};
const st=tk=>STK.find(x=>x[0]===tk);
const dom=h=>{const d=document.createElement('div');d.innerHTML=h;return d};
const nf=n=>Math.round(n).toLocaleString('en-US');
const sgn=n=>(n>=0?'+':'−')+Math.abs(n).toFixed(1)+'%';
I.vt=I.vt||{};
window.ezVote=(tk,d)=>{if(I.vt[tk])return;I.vt[tk]=d;render('fade-none')};

const _iv=screens.invest;
if(_iv)screens.invest=function(){let h=String(_iv.apply(this,arguments));try{
 if(I.tab!=='port'||h.indexOf('ez-td')>=0)return h;
 const ks=Object.keys(S.hold||{}).filter(k=>S.hold[k]&&S.hold[k].q>0&&st(k));if(!ks.length)return h;
 let now=0,was=0;ks.forEach(k=>{const q=S.hold[k].q,p=st(k)[2],o=(I.open&&I.open[k])||p;now+=q*p;was+=q*o});
 const d=now-was,pc=was?d/was*100:0;
 const R=dom(h),leaf=[...R.querySelectorAll('*')].find(x=>x.children.length===0&&/since you bought|kuva waguze|depuis l’achat/.test(x.textContent));
 if(!leaf)return h;
 const el=leaf.closest('.sm')||leaf;
 el.insertAdjacentHTML('afterend',`<div class="ez-td"><span>${T('Today','Aujourd’hui')}</span><b class="${d>=0?'up':'dn'}">${d>=0?'+':'−'}${nf(Math.abs(d))} RWF (${sgn(pc)})</b></div>`);
 return R.innerHTML}catch(e){console.error('ez662 invest',e);return h}};

const _sk=screens.stock;
if(_sk)screens.stock=function(){let h=String(_sk.apply(this,arguments));try{
 const tk=I.sk,s=st(tk);if(!s||h.indexOf('ez-vt')>=0)return h;
 const R=dom(h),v=I.vt[tk],base=38+hash(tk+'vt')%30,n=420+hash(tk+'vn')%900;
 let up=base,tot=n;if(v){tot+=1;up=Math.round(((base/100*n)+(v==='up'?1:0))/tot*100)}
 const body=v?`<div class="rs"><i style="width:${up}%;background:var(--ok)"></i><i style="width:${100-up}%;background:var(--er)"></i></div><div class="rl"><span>${T('Rise','Hausse')} <b>${up}%</b></span><span>${nf(tot)} ${T('votes','votes')}</span><span>${T('Fall','Baisse')} <b>${100-up}%</b></span></div><div class="me">${T('You picked ','Votre choix : ')}${v==='up'?T('Rise','Hausse'):T('Fall','Baisse')}</div>`
  :`<div class="bt"><button onclick="ezVote('${tk}','up')" style="color:var(--ok)">${T('Rise','Hausse')} ▲</button><button onclick="ezVote('${tk}','dn')" style="color:var(--er)">${T('Fall','Baisse')} ▼</button></div>`;
 const blk=`<div class="ez-vt"><h3>${T('Will it rise today?','Va-t-elle monter aujourd’hui ?')}</h3><p>${T('Vote to see what other investors think (sample votes)','Votez pour voir l’avis des autres investisseurs (votes d’exemple)')}</p>${body}</div>`;
 const at=R.querySelector('.ez-bx')||[...R.querySelectorAll('.agt')].find(e=>/^Key stats/.test(e.textContent.trim()));
 if(!at)return h;
 at.insertAdjacentHTML('beforebegin',blk);return R.innerHTML}catch(e){console.error('ez662 stock',e);return h}};
})()}catch(x){console.error('v662',x)}
document.title=document.title.replace(/v\d+/,'v662');
</script>

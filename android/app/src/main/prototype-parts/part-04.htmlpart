const _sk=screens.stock;
if(_sk)screens.stock=function(){let h=String(_sk.apply(this,arguments));try{
 const tk=I.sk,s=st(tk);if(!s||h.indexOf('ez-dv')>=0)return h;
 const g=hash(tk+'dvd'),per=Math.max(1,Math.round(s[2]*(0.012+g%20/1000))),d=new Date(Date.now()+(20+g%60)*864e5),
  ds=d.toLocaleDateString(S.lang==='fr'?'fr-FR':'en-GB',{day:'numeric',month:'short',year:'numeric'}),fq=[T('Twice a year','Deux fois par an'),T('Once a year','Une fois par an')][g%2];
 const q=S.hold&&S.hold[tk]&&S.hold[tk].q>0?S.hold[tk].q:0;
 const blk=`<div class="ez-dv"><h3>${T('Dividend','Dividende')}</h3><div class="r"><span>${T('Next payment','Prochain versement')}</span><b>${ds}</b></div><div class="r"><span>${T('Per share','Par action')}</span><b>${nf(per)} RWF</b></div><div class="r"><span>${T('How often','Fréquence')}</span><b>${fq}</b></div>${q?`<div class="pay">${T('You would get about ','Vous recevriez environ ')}<b>${nf(per*q)} RWF</b>${T(' for your ',' pour vos ')}${q}${T(' shares.',' actions.')}</div>`:''}<div class="sm mu" style="margin-top:10px">${T('Sample numbers','Chiffres d’exemple')}</div></div>`;
 const R=dom(h),at=R.querySelector('.ez-vt');if(!at)return h;
 at.insertAdjacentHTML('beforebegin',blk);return R.innerHTML}catch(e){console.error('ez664 stock',e);return h}};
})()}catch(x){console.error('v664',x)}

const dist=x=>{const p=AR[area(x)],q=AR[S.mxHood];return p&&q?Math.hypot(p[0]-q[0],p[1]-q[1]):4};
const km=x=>{const d=dist(x);return d<.5?'0.'+(2+hs(x.id)%6)+' km':d.toFixed(1)+' km'};
const eta=x=>{const d=dist(x);return d<=1.5?Math.max(3,Math.round(d*12))+' min walk':'about '+Math.max(8,Math.round(d*4))+' min by moto'};
const ago=x=>x.ago||0,when=x=>{const a=ago(x);return a<1?'Just now':a<24?a+' h ago':a<48?'Yesterday':Math.floor(a/24)+' d ago'};
const hrs=x=>{const m=/(\d\d):(\d\d)\D+(\d\d):(\d\d)/.exec(x.sh||'');return m?((+m[3]*60+ +m[4])-(+m[1]*60+ +m[2]))/60:0};
const hourly=x=>{const h=hrs(x);return h>0&&x.u!=='month'&&x.n?Math.round(x.n/h/10)*10:0};
const pay=x=>fmt(x.n)+' RWF / '+x.u,nApp=x=>2+hs('a'+x.id)%9,stT=x=>S.hdApplied[x.id]?STS[S.jbSt[x.id]||0]:'';
const pks=x=>x.pk||({1:['Paid same day'],8:['Training'],9:['Transport'],10:['Paid weekly'],11:['Meal included'],12:['Meal included']}[x.id])||[];
const px=x=>Math.round(48+(x+3)*30),py=y=>Math.round(290-(y+3.5)*26);
const jmap=()=>{const R=RV[S.mxRad],c=AR[S.mxHood];return `<div style="margin:10px 24px 0;border-radius:20px;background:var(--chip);overflow:hidden"><svg viewBox="0 0 330 312" width="100%" role="img" aria-label="Map of open jobs by area">${c&&R?`<ellipse cx="${px(c[0])}" cy="${py(c[1])}" rx="${R*30}" ry="${R*26}" fill="var(--tint)" opacity=".5" stroke="var(--tintfg)" stroke-dasharray="4 4"/>`:''}${Object.keys(AR).map(a=>{const n=H.items.filter(x=>area(x)===a&&!x.st).length,here=a===S.mxHood,X=px(AR[a][0]),Y=py(AR[a][1]);return `<g onclick="jnArea('${a}')" style="cursor:pointer"><circle cx="${X}" cy="${Y}" r="${here?19:15}" fill="${n?'var(--tintfg)':'var(--mu)'}" opacity="${n?1:.4}" ${here?'stroke="var(--tx)" stroke-width="3"':''}/><text x="${X}" y="${Y+5}" text-anchor="middle" font-size="14" font-weight="800" fill="#fff">${n}</text><text x="${X}" y="${Y+(here?34:30)}" text-anchor="middle" font-size="11" font-weight="700" fill="var(--tx)">${a}</text></g>`}).join('')}</svg><div class="sm mu" style="padding:0 14px 10px">Tap an area to see its jobs. Your area has a dark ring.</div></div>`};
window.jnArea=a=>{S.jbfl=S.jbfl||{};S.jbfl.area=S.jbfl.area===a?'':a;S.jnMap=0;jnRedraw()};
const cat=()=>CT.includes(S.jbCat)?S.jbCat:'All';
const list=()=>{const q=S.jnQ.trim().toLowerCase(),c=cat(),R=RV[S.mxRad];
const l=H.items.filter(x=>!(S.jbHide||{})[x.id]&&window.jbFltOk(x)&&(c==='All'||(c==='Today'&&x.start==='asap'&&!x.st)||kind(x)===c||(c==='Saved'&&S.hdFav['jobs:'+x.id])||(c==='Applied'&&S.hdApplied[x.id])||(c==='Shifts'&&S.hdApplied[x.id]&&(S.jbSt[x.id]||0)>=2)||(c==='Mine'&&x.who==='You'))&&(SP.includes(c)||(S.jbfl||{}).area||dist(x)<=R)&&(!q||(x.ti+' '+x.who+' '+x.loc+' '+kind(x)).toLowerCase().includes(q)));
return l.sort(S.jnSort?(a,b)=>dist(a)-dist(b):(a,b)=>ago(a)-ago(b))};
const row=x=>{const ap=stT(x),tg=[`<span class="jn-t">${x.c}</span>`],hr=hourly(x);
if(!x.st&&ago(x)<24)tg.unshift('<span class="jn-t hi">New</span>');if(x.start==='asap'&&!x.st)tg.push('<span class="jn-t hi">Start ASAP</span>');pks(x).slice(0,2).forEach(p=>tg.push('<span class="jn-t">'+p+'</span>'));if(x.op>1)tg.push('<span class="jn-t">'+x.op+' openings</span>');
return `<div class="dg-r" role="button" tabindex="0" style="${x.st?'opacity:.55':''}" onclick="hdOpen('jobs',${x.id})"><div class="dg-th">${gl(x.g,44)}</div><div class="dg-b"><div class="dg-t">${esc(x.ti)}</div><div class="dg-s">${esc(x.who)} · ${km(x)} · ${when(x)}</div><div class="dg-p">${x.st?'<span class="dg-st sd">Filled</span>':ap?`<span class="dg-st">${ap}</span>`:''}${pay(x)}</div>${hr?`<div class="jn-sh">≈ ${fmt(hr)} RWF / hour</div>`:''}${x.sh?`<div class="jn-sh">🕒 ${esc(x.sh)}</div>`:''}<div class="jn-m">${tg.join('')}<span class="jn-p">👥 ${nApp(x)}</span></div></div><span class="dg-h" onclick="event.stopPropagation()">${hdHeart('jobs',x.id)}</span></div>`};
const body=()=>(S.jnMap?jmap():'')+body1();const body1=()=>{const l=list(),c=cat();if(!l.length)return `<div class="dg-e"><div style="font-size:40px">💼</div><b>${c==='Saved'?'Nothing saved yet':c==='Applied'?'You have not applied yet':c==='Shifts'?'No shifts yet':c==='Mine'?'You have not posted a job yet':'No jobs near '+esc(S.mxHood)+' yet'}</b><div class="sm mu">${c==='Saved'?'Tap the heart on a job to keep it here.':c==='Applied'?'Chat with an employer or tap Apply on a job.':c==='Shifts'?'When an employer invites you, your shift shows here. Check in, check out and get paid.':c==='Mine'?'Post a job and neighbours can chat with you.':'Try a wider range, or another category.'}</div><div style="display:flex;gap:10px;justify-content:center;margin-top:14px">${S.mxRad<2&&!SP.includes(c)?'<button class="cch" onclick="mxSetRad(2)">Widen range</button>':''}<button class="cch on" onclick="hdPost()">Post a job</button></div></div>`;return l.map(row).join('')};
const bar_=()=>{const F=S.jbfl||{},n=(F.area?1:0)+(F.unit?1:0)+(F.hide?1:0),k=list().length;return `<span class="mu sm">${k} jobs</span><span style="flex:1"></span><button class="cch ${S.jnMap?'on':''}" onclick="S.jnMap=S.jnMap?0:1;jnRedraw()">🗺 Map</button><button class="cch" onclick="jnSortT()">${S.jnSort?'Nearest':'Latest'} ⇅</button><button class="cch ${(S.jn13al||[]).includes(jn13k())?'on':''}" onclick="jn13Al()">🔔 Alert</button><button class="cch ${n?'on':''}" onclick="jbFilt()">Filter${n?' · '+n:''}</button>`};
const chips=()=>CT.map(c=>`<button class="cch ${cat()===c?'on':''}" onclick="jbCat('${c}')">${c}</button>`).join('')+'<button class="cch" onclick="jbProf()">👤 Profile</button>';
window.jnRedraw=()=>{if($('#jnl'))$('#jnl').innerHTML=body();if($('#jncc'))$('#jncc').innerHTML=chips();if($('#jnbr'))$('#jnbr').innerHTML=bar_()};
window.jbCat=c=>{if(c)S.jbCat=c;jnRedraw()};window.jnSortT=()=>{S.jnSort=S.jnSort?0:1;jnRedraw()};window.jnSearch=v=>{S.jnQ=v;jnRedraw()};
window.jnHood=()=>{$('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="h1" style="font-size:22px;line-height:30px">Your neighbourhood</div><div class="sm mu" style="margin-top:6px;line-height:20px">Jobs, Marketplace, Community and Property use the same neighbourhood. You see what is close to home, so everything is a short trip away.</div><div style="margin-top:10px">'+HOODS.map(a=>`<div class="dg-o" role="button" tabindex="0" onclick="mxSetHood('${a}')"><span>${a}</span><b>${S.mxHood===a?'✓':''}</b></div>`).join('')+'</div><div class="lab" style="margin-top:14px">Range</div><div class="dg-sg">'+RAD.map((l,i)=>`<button class="${S.mxRad===i?'on':''}" onclick="mxSetRad(${i})">${l}</button>`).join('')+'</div></div>'};
window.jnBump=id=>{const x=H.items.find(i=>i.id===id);if(!x)return;x.ago=0;toast('Moved to the top of '+area(x));render('fade-none')};
const oR=window.rf2;window.rf2=function(){if(S.hd==='jobs'&&$('#jnl'))jnRedraw();else if(oR)return oR.apply(this,arguments)};
const oT=window.hdTg;window.hdTg=function(t,id){oT.apply(this,arguments);if(t==='jobs'&&S.jbCat==='Saved'&&$('#jnl'))jnRedraw()};
const oA=window.jbApplyGo;if(oA)window.jbApplyGo=function(){oA.apply(this,arguments);[5200,12200].forEach(t=>setTimeout(()=>{if(S.hd==='jobs'&&$('#jnl'))jnRedraw()},t))};
if(!$('#jn503')){const s=document.createElement('style');s.id='jn503';s.textContent='.jn-sh{font-size:13px;color:var(--mu)}.jn-m{display:flex;gap:6px;align-items:center;flex-wrap:wrap;margin-top:auto;padding-top:4px}.jn-t{font-size:12px;font-weight:700;padding:2px 8px;border-radius:10px;background:var(--chip);color:var(--mu)}.jn-t.hi{background:var(--tint);color:var(--tintfg)}.jn-p{margin-left:auto;font-size:13px;color:var(--tt)}.jn-g{display:grid;grid-template-columns:1fr 1fr;gap:14px}.jn-g span{display:block;font-size:12px;color:var(--tt)}.jn-g b{font-size:14px;line-height:19px}.jn-rv{font-size:14px;line-height:21px;margin-top:12px;color:var(--mu)}';document.head.appendChild(s)}
const oS=screens.hood;screens.hood=function(){if(S.hd!=='jobs')return oS.apply(this,arguments);
return `${bar(H.t)}<div class="dg-loc"><button class="dg-hb" onclick="jnHood()">📍 ${esc(S.mxHood)} <i>▾</i></button><span class="dg-v">✓ Verified area</span></div><div class="dg-q"><input id="jnq" type="search" aria-label="Search jobs" placeholder="Search jobs in ${esc(S.mxHood)}" value="${esc(S.jnQ)}" oninput="jnSearch(this.value)"></div><div class="chips" style="padding-top:12px" id="jncc">${chips()}</div><div class="dg-ib" id="jnbr">${bar_()}</div><div id="jnl" style="padding-top:6px">${body()}</div><div class="pad fine" style="padding-top:18px">Listings are sample data for this prototype.</div><div class="fab"><button class="btn" onclick="hdPost()" style="height:46px;padding:0 20px;font-size:15px;border-radius:23px;width:auto">+ Post a job</button></div>`};
const oI=screens.hoodItem;screens.hoodItem=function(){let h=oI.apply(this,arguments);if(S.hd!=='jobs'||h.includes('jn-g')||h.includes('jn-mine'))return h;const x=H.items.find(i=>i.id===S.hdI);if(!x)return h;
const mine=x.who==='You',a=area(x),hr=hourly(x),SEL='<div class="dg-sel" style="margin:16px 0 0">';
const cardA=mine?`<div class="dg-sel jn-mine" style="margin:16px 0 0"><div class="dg-sr"><div class="dg-av">Y</div><div style="flex:1"><b>Your job</b><div class="sm mu">${esc(a)} · posted ${when(x)}</div></div></div><div class="dg-n">💬 ${2+hs('c'+x.id)%9} chats · ♡ ${1+hs('l'+x.id)%14} saves · 👁 ${20+hs('v'+x.id)%80} views · 👥 ${nApp(x)} applicants</div>${x.st?'':`<button class="cch on" style="margin-top:10px;height:44px" onclick="jnBump(${x.id})">Bump to top</button>`}</div>`
:`${SEL}<div class="jn-g"><div><span>🕒 Shift</span><b>${x.sh?esc(x.sh):'Ask the employer'}</b></div><div><span>💰 Per hour</span><b>${hr?'≈ '+fmt(hr)+' RWF':'Not fixed'}</b></div><div><span>📍 From ${esc(S.mxHood)}</span><b>${km(x)} · ${eta(x)}</b></div><div><span>🗓 Posted</span><b>${when(x)} · ${nApp(x)} applied</b></div>${pks(x).length?`<div style="grid-column:1/3"><span>🎁 Perks</span><b>${pks(x).join(' · ')}</b></div>`:''}${x.op>1?`<div style="grid-column:1/3"><span>👥 Openings</span><b>${x.op} people needed</b></div>`:''}</div></div>`;
const an='<div style="font-size:15px;line-height:23px;margin-top:16px">',i=h.indexOf(an);h=i>=0?h.slice(0,i)+cardA+h.slice(i):h;
if(mine)return h;
const tmp=36.5+(hs(x.who)%80)/10,col=tmp<37.5?'#4C8DF6':tmp<40?'#2E9E5B':'#F08A24',rv=['Pays on time every week.','Clear hours and a friendly boss.','Easy to reach from home.','Fair and respectful.'];
const cardE=`${SEL.replace('16px','18px')}<div class="dg-sr"><div class="dg-av">${esc(x.who[0])}</div><div style="flex:1;min-width:0"><b>${esc(x.who)}</b><div class="sm mu">${esc(a)} · Verified local business</div></div><div class="dg-tmp"><b style="color:${col}">${tmp.toFixed(1)}°C</b><div class="dg-tb"><i style="width:${Math.min(100,(tmp-30)*5)}%;background:${col}"></i></div><span>Manner temperature</span></div></div><div class="dg-n">Replies within an hour · ${70+hs(x.who)%30}% reply rate · ${3+hs(x.who)%20} people hired</div><div class="jn-rv">💬 “${rv[hs(x.who)%4]}”<br>💬 “${rv[(hs(x.who)+2)%4]}”<div style="font-size:12px;color:var(--tt);margin-top:4px">From neighbours who worked here</div></div></div><div class="dg-n" style="margin:10px 0 0">🛡 Never pay to get a job. Meet at the workplace in daylight and tell a friend where you are going.</div>`;
const m=/<div class="tap"[^>]*onclick="jbEmp\(/.exec(h);return m?h.slice(0,m.index)+cardE+h.slice(m.index):h};
if(document.title)document.title=document.title.replace(/v\d+/,'v503');
})()}catch(e){console.error('jobs-v503',e)}
</script>
<script>
/* v504: Community, a real neighbourhood community (Daangn "Life" style). Before: one city-wide feed with a search field and area chips. Now: Community shares your neighbourhood and range with Marketplace and Jobs (📍 on top, with how many neighbours live there), and the feed only shows posts from there and nearby. Every post shows its area, distance, how long ago it was posted and how many neighbours looked at it. A "Ask your neighbours something…" bar sits on top, topic chips (Ask, Tips, Events, Safety, Lost & found, Saved, Following, Mine) filter the feed, Latest / Popular sort and Muted still work, and an empty feed offers "Widen range". New posts default to your neighbourhood. Six new sample posts so each area has some. Polls, events, replies, follow, mute and report are unchanged. English only; rw/fr need native review. */
try{(function(){
const esc=s=>String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/"/g,'&quot;');
const AR={Kimironko:[5,3],Remera:[3.5,2],Kimihurura:[2.5,2.5],Kacyiru:[1,3.5],Gisozi:[1,6],Nyamirambo:[-3,1],Nyabugogo:[-3,-1],Kicukiro:[3,-3],Gikondo:[1,-3.5]};
const RV=[0,3,8],TOP=[['All','All'],['Ask','Ask'],['Tips','Tips'],['Events','Events'],['Safety','Safety'],['Lost','Lost & found'],['Saved','Saved'],['Following','Following'],['Mine','Mine']],SP=['Saved','Following','Mine'];
if(S.mxHood===undefined){S.mxHood='Kimironko';S.mxRad=1}
if(!S.cnSeed&&S.posts&&S.cm){S.cnSeed=1;S.posts.push(
{id:201,who:'Diane K.',t:'25 min ago',a:25,area:'Kimironko',cat:'Ask',x:'Where can I find a reliable tailor near Kimironko market? I need a school uniform fixed by Monday.',l:4,c:2,me:false,rp:[['Eric M.','Ask for Mama Chantal at the market, second row. Fast and fair.'],['Aline N.','Seconded. She fixed mine in one day.']]},
{id:202,who:'Patrick H.',t:'3 h ago',a:180,area:'Kacyiru',cat:'Tips',x:'Tip: the 8:00 bus from Kacyiru to town is almost empty, the 7:00 one is packed. Leave 30 minutes later and you get a seat.',l:19,c:5,me:false,v:1,rp:[]},
{id:203,who:'Gisozi Sector Office',t:'5 h ago',a:300,area:'Gisozi',cat:'Events',x:'Community clean-up in Gisozi this Saturday at 8:00. Gloves and bags are provided at the sector office.',l:31,c:6,me:false,v:1,rp:[],ev:{w:'Sat 08:00',wh:'Gisozi sector office',n:42,me:0,rm:0,x:0}},
{id:204,who:'Grace U.',t:'Yesterday',a:1500,area:'Kicukiro',cat:'Lost',x:'Lost a black school bag near Kicukiro centre on Tuesday evening. It has exercise books inside. Please message me.',l:9,c:1,me:false,rp:[]},
{id:205,who:'Joseph T.',t:'Yesterday',a:1700,area:'Remera',cat:'Safety',x:'The street lights on the road behind Remera stadium are out again. Walk in groups after dark until it is fixed.',l:27,c:7,me:false,rp:[['Claire U.','Thanks. I reported it to the cell office this morning.']]},
{id:206,who:'Sandrine M.',t:'2 d ago',a:2800,area:'Kimironko',cat:'Tips',x:'The new bakery on the Kimironko main road sells fresh bread at 6:00 for 300 RWF. Worth the walk.',l:15,c:3,me:false,rp:[]})}
const hs=n=>{let h=0;String(n).split('').forEach(c=>h=(h*31+c.charCodeAt(0))>>>0);return h};
const pa=p=>p.area||S.mxHood,dist=p=>{const a=AR[pa(p)],b=AR[S.mxHood];return a&&b?Math.hypot(a[0]-b[0],a[1]-b[1]):4};
const km=p=>{const d=dist(p);return d<.5?'0.'+(2+hs(p.id)%6)+' km':d.toFixed(1)+' km'};
const feed=()=>{const all=S.posts,cm=S.cm,sv=cm.area,sp=SP.includes(cm.cat),R=RV[S.mxRad];
S.posts=all.filter(p=>sp||!p.area||dist(p)<=R).map(p=>Object.assign({},p,{area:pa(p)+' · '+km(p),t:p.t+' · 👁 '+(30+hs('v'+p.id)%170)}));cm.area='';
let h='';try{h=window.rowsC2()}finally{S.posts=all;cm.area=sv}
const n=(h.match(/class="post"/g)||[]).length;
if(!n&&!sp&&S.mxRad<2)h+='<div style="text-align:center;padding-top:6px"><button class="cch" onclick="mxSetRad(2)">Widen range</button></div>';
return {h,n}};
const bar_=n=>{const nm=Object.keys(S.cm.mute).length;return `<span class="mu sm">${n} ${SP.includes(S.cm.cat)?'posts':'near '+esc(S.mxHood)}</span><span style="flex:1"></span><button class="cch" onclick="cmSort()">${S.cm.sort?'Popular':'Latest'} ⇅</button>${nm?`<button class="cch" onclick="cmMuted()">🔇 ${nm}</button>`:''}`};
const chips=()=>TOP.map(([k,l])=>`<button class="cch ${S.cm.cat===k?'on':''}" onclick="cnCat('${k}')">${l}</button>`).join('');
window.cnRedraw=()=>{const f=feed();if($('#cnl'))$('#cnl').innerHTML=f.h;if($('#cnc'))$('#cnc').innerHTML=chips();if($('#cnb'))$('#cnb').innerHTML=bar_(f.n)};
window.cnCat=k=>{S.cm.cat=k;cnRedraw()};window.cnSearch=v=>{S.cm.q=v;cnRedraw()};
const oP=window.postSheet;if(oP)window.postSheet=function(){const sv=S.cm.area;S.cm.area=S.mxHood;try{return oP.apply(this,arguments)}finally{S.cm.area=sv}};
const oRd=window.render;window.render=render=function(m){const had=$('#cnl'),y=had&&$('#sc')?$('#sc').scrollTop:0,r=oRd.apply(this,arguments);if(had&&m==='fade-none'&&$('#cnl')&&$('#sc'))$('#sc').scrollTop=y;return r};
if(!$('#cn504')){const s=document.createElement('style');s.id='cn504';s.textContent='.cn-c{display:flex;align-items:center;gap:10px;margin:12px 24px 0;padding:0 16px;height:48px;border-radius:24px;background:var(--chip);color:var(--mu);font-size:15px;font-weight:600;cursor:pointer}';document.head.appendChild(s)}
screens.community=function(){const f=feed(),d=S.cqDraft&&S.cqDraft.t;
return `${bar('Community')}<div class="dg-loc"><button class="dg-hb" onclick="jnHood()">📍 ${esc(S.mxHood)} <i>▾</i></button><span class="dg-v">✓ Verified area</span></div><div class="dg-n" style="margin:4px 24px 0">${(900+hs(S.mxHood)%900).toLocaleString('en-US')} neighbours here</div><div class="dg-q"><input id="cnq" type="search" aria-label="Search posts" placeholder="Search posts in ${esc(S.mxHood)}" value="${esc(S.cm.q)}" oninput="cnSearch(this.value)"></div><div class="cn-c" role="button" tabindex="0" onclick="postSheet()"><span>✏️</span><span>${d?'Continue your draft…':'Ask your neighbours something…'}</span></div><div class="chips" style="padding-top:12px" id="cnc">${chips()}</div><div class="dg-ib" id="cnb">${bar_(f.n)}</div><div id="cnl" style="padding-top:6px">${f.h}</div><div class="pad fine" style="padding-top:18px">Posts are sample data for this prototype.</div>`};
if(document.title)document.title=document.title.replace(/v\d+/,'v504');
})()}catch(e){console.error('community-v504',e)}
</script>
<script>
/* v507 (builds on v506 and v505, below): homes can show a Price dropped tag with the old price crossed out; rentals show extra costs beside the rent (none, water and power extra, or service charge), which an owner or agent picks when listing; the listing page has a Living in this area card with a neighbour rating and two neighbour comments. v506 (builds on v505, below): List a property now starts with who is listing (Owner or Agent) and when it is available, defaults the neighbourhood to yours, and tags the listing; every home shows an Available now / Available from date line, with an Available now filter; a Map view shows a pin per area with home counts and your range circled, tap a pin to see that area. v505: */
/* v505: Property, a real neighbourhood property board (Daangn Real Estate style). Before: one city-wide list with search, beds chips and filter. Now: Property shares your neighbourhood and range with Marketplace, Jobs and Community (📍 on top; My area, up to 3 km, up to 8 km), so you only see homes close to where you live. Each row shows area, distance, how long ago it was listed, price (with price per m² for sales), size, and tags (Owner direct or Agent, Verified, New, Furnished). Deal chips (All, Rent, Sale, Saved, Mine), type chips (Apartment, House, Room, Shop, Land), Newest / Price / Size / Nearest sort, Filter, Compare and Viewings all still work. Listing page: distance and walk or moto time from your neighbourhood, an Owner or Agent card with verified status, manner temperature, reply rate and homes listed, an owner-direct note, and a safe-visit note; your own listings get Bump to top. Five new sample homes so every area has some. English only; rw/fr need native review. */
try{(function(){
const H=HD.property,esc=s=>String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/"/g,'&quot;');
const AR={Kimironko:[5,3],Remera:[3.5,2],Kimihurura:[2.5,2.5],Kacyiru:[1,3.5],Gisozi:[1,6],Nyamirambo:[-3,1],Nyabugogo:[-3,-1],Kicukiro:[3,-3],Gikondo:[1,-3.5],Nyarutarama:[3,4.5],Bugesera:[12,-10]};
const RV=[0,3,8],DEAL=['All','Rent','Sale','Saved','Mine'],KINDS=[['','Any type'],['apt','Apartment'],['house','House'],['room','Room'],['shop','Shop'],['land','Land']],SORTS=['Newest','Price ↑','Price ↓','Size','Nearest'];
if(S.mxHood===undefined){S.mxHood='Kimironko';S.mxRad=1}
if(!H.pn){H.pn=1;H.items.push(
{id:11,ti:'2-bedroom apartment',loc:'Gisozi',n:180000,u:'mo',beds:2,baths:1,m2:70,furn:0,g:'house',c:'Rent',who:'Agent Samuel',d:'Bright first-floor apartment with tiled floors, prepaid water and power. Ten minutes from the main road.',k:'apt',am:['water','power','sec'],dp:2,ago:1,ok:1},
{id:12,ti:'Single room near the market',loc:'Kicukiro',n:40000,u:'mo',beds:1,baths:1,m2:12,furn:0,g:'house',c:'Rent',who:'Mama Chantal',d:'Clean room in a family compound. Shared tap and latrine, very quiet. You deal with the owner.',k:'room',am:['water'],dp:1,ago:4,ok:0},
{id:13,ti:'Studio, owner direct',loc:'Kimironko',n:120000,u:'mo',beds:1,baths:1,m2:30,furn:1,g:'house',c:'Rent',who:'Eric M.',d:'Furnished studio with Wi-Fi, two minutes from the Kimironko bus stop. Available now.',k:'apt',am:['net','water','sec'],dp:1,ago:0,ok:1},
{id:14,ti:'1-bedroom, furnished',loc:'Kacyiru',n:300000,u:'mo',beds:1,baths:1,m2:55,furn:1,g:'house',c:'Rent',who:'Agent Diane',d:'Modern apartment with a lift, parking and 24-hour security. Close to offices and embassies.',k:'apt',am:['lift','sec','net','park'],dp:2,ago:2,ok:1},
{id:15,ti:'Family house with yard',loc:'Remera',n:48000000,u:'',beds:3,baths:2,m2:180,furn:null,g:'house',c:'Sale',who:'Jean B.',d:'Sold by the owner. Titled plot, small garden, walking distance to a school and the bus stop.',k:'house',am:['gar','park','water'],dp:0,ago:5,ok:1})}
const hs=n=>{let h=0;String(n).split('').forEach(c=>h=(h*31+c.charCodeAt(0))>>>0);return h};
const area=x=>AR[x.loc]?x.loc:x.who==='You'?S.mxHood:(x.loc||'Kigali');
const dist=x=>{const p=AR[area(x)],q=AR[S.mxHood];return p&&q?Math.hypot(p[0]-q[0],p[1]-q[1]):4};
const km=x=>{const d=dist(x);return d<.5?'0.'+(2+hs(x.id)%6)+' km':d.toFixed(1)+' km'};
const eta=x=>{const d=dist(x);return d<=1.5?Math.max(3,Math.round(d*12))+' min walk':'about '+Math.max(8,Math.round(d*4))+' min by moto'};
const ago=x=>x.ago||0,when=x=>{const a=ago(x);return a<1?'Today':a===1?'Yesterday':a+' d ago'};
const owner=x=>x.ag?false:x.who==='You'||!/Agent/i.test(x.who);
const price=x=>fmt(x.n)+' RWF'+(x.u==='mo'?' / month':'');
const KN={apt:'Apartment',house:'House',room:'Room',shop:'Shop',land:'Land'};
const fOk=x=>{const f=S.pf;if(S.pHide[x.id]||(f.area&&x.loc!==f.area)||(f.kind&&x.k!==f.kind)||(f.furn&&!x.furn)||(f.hide&&x.st)||f.am.some(a=>!(x.am||[]).includes(a)))return 0;
if(f.band){const t=x.u?[1e5,3e5]:[5e7,15e7];if((x.n<t[0]?1:x.n<t[1]?2:3)!==f.band)return 0}return 1};
const nF=()=>{const f=S.pf;return(f.area?1:0)+(f.kind?1:0)+(f.band?1:0)+(f.furn?1:0)+f.am.length+(f.hide?1:0)};
const list=()=>{const q=(S.prQ||'').trim().toLowerCase(),c=DEAL.includes(S.prCat)?S.prCat:'All',sp=c==='Saved'||c==='Mine',R=RV[S.mxRad],s=S.prSort;
const l=H.items.filter(x=>(c==='All'||x.c===c||(c==='Saved'&&S.hdFav['property:'+x.id])||(c==='Mine'&&x.who==='You'))&&(sp||S.pf.area||dist(x)<=R)&&(!q||(x.ti+' '+x.loc+' '+(KN[x.k]||'')).toLowerCase().includes(q))&&fOk(x)&&(!S.pnNow||av(x)===0));
return l.sort(s===1?(a,b)=>a.n-b.n:s===2?(a,b)=>b.n-a.n:s===3?(a,b)=>(b.m2||0)-(a.m2||0):s===4?(a,b)=>dist(a)-dist(b):(a,b)=>ago(a)-ago(b))};
const row=x=>{const cm=S.pCmp.includes(x.id),tg=[];
if(x.st)tg.push(`<span class="jn-t">${x.c==='Rent'?'Rented':'Sold'}</span>`);
tg.push(`<span class="jn-t ${owner(x)?'hi':''}">${owner(x)?'Owner direct':'Agent'}</span>`);
if(x.ok)tg.push('<span class="jn-t" style="color:var(--ok)">✓ Verified</span>');if(pd(x)&&!x.st)tg.push('<span class="jn-t hi">↓ Price dropped</span>');if(!x.st&&ago(x)<=2)tg.push('<span class="jn-t hi">New</span>');if(x.furn)tg.push('<span class="jn-t">Furnished</span>');
return `<div class="dg-r" role="button" tabindex="0" style="${x.st?'opacity:.55':''}" onclick="hdOpen('property',${x.id})"><div class="dg-th">${gl(x.g,44)}</div><div class="dg-b"><div class="dg-t">${esc(x.ti)}</div><div class="dg-s">${esc(area(x))} · ${km(x)} · ${when(x)}</div><div class="dg-p">${pd(x)&&!x.st?`<s class="jn-sh" style="margin-right:6px;font-weight:600">${fmt(Math.round(x.n/(1-pd(x)/100)/1000)*1000)}</s>`:''}${price(x)}</div><div class="jn-sh">${KN[x.k]||'Home'}${x.beds?' · '+x.beds+' beds':''}${x.m2?' · '+x.m2+' m²':''}${x.c==='Sale'&&x.m2?' · ≈ '+fmt(Math.round(x.n/x.m2))+' RWF / m²':''}</div><div class="jn-sh">🗓 ${avail(x)}</div><div class="jn-m">${tg.join('')}<span class="jn-p"><button class="cch ${cm?'on':''}" aria-pressed="${cm}" aria-label="Compare" style="height:30px;padding:0 10px;font-size:13px" onclick="event.stopPropagation();pCmpT(${x.id})">${cm?'✓':'⇄'}</button></span></div></div><span class="dg-h" onclick="event.stopPropagation()">${hdHeart('property',x.id)}</span></div>`};
const body=()=>(S.pnMap?mapH():'')+body1();const body1=()=>{const l=list(),c=S.prCat;if(!l.length)return `<div class="dg-e"><div style="font-size:40px">🏡</div><b>${c==='Saved'?'Nothing saved yet':c==='Mine'?'You have not listed a home yet':'No homes near '+esc(S.mxHood)+' yet'}</b><div class="sm mu">${c==='Saved'?'Tap the heart on a home to keep it here.':c==='Mine'?'List a home and neighbours can message you.':'Try a wider range or fewer filters.'}</div><div style="display:flex;gap:10px;justify-content:center;margin-top:14px">${S.mxRad<2&&c!=='Saved'&&c!=='Mine'?'<button class="cch" onclick="mxSetRad(2)">Widen range</button>':''}${nF()?'<button class="cch" onclick="pFr();render(\'fade-none\')">Clear filters</button>':''}<button class="cch on" onclick="hdPost()">List a property</button></div></div>`;return l.map(row).join('')};
const bar_=()=>{const n=nF(),c=S.prCat;return `<span class="mu sm">${list().length} homes</span><span style="flex:1"></span><button class="cch ${S.pnMap?'on':''}" onclick="S.pnMap=S.pnMap?0:1;pnRedraw()">🗺 Map</button><button class="cch" onclick="pnSort()">⇅ ${SORTS[S.prSort]||SORTS[0]}</button><button class="cch ${n?'on':''}" onclick="pFilt()">Filter${n?' · '+n:''}</button>`};
const chips=()=>DEAL.map(c=>`<button class="cch ${S.prCat===c?'on':''}" onclick="prCat('${c}')">${c}</button>`).join('')+`<button class="cch" onclick="pCmpOpen()">⇄ Compare${S.pCmp.length?' · '+S.pCmp.length:''}</button><button class="cch" onclick="pVws()">📅 Viewings${S.prV.length?' · '+S.prV.length:''}</button>`;
const kchips=()=>KINDS.map(([k,l])=>`<button class="cch ${(S.pf.kind||'')===k?'on':''}" onclick="pnKind('${k}')">${l}</button>`).join('')+`<button class="cch ${S.pnNow?'on':''}" onclick="S.pnNow=S.pnNow?0:1;pnRedraw()">🗓 Available now</button>`;
window.pnRedraw=()=>{if($('#pnl'))$('#pnl').innerHTML=body();if($('#pnc'))$('#pnc').innerHTML=chips();if($('#pnk'))$('#pnk').innerHTML=kchips();if($('#pnb'))$('#pnb').innerHTML=bar_()};
window.prCat=c=>{S.prCat=c;pnRedraw()};window.pnKind=k=>{S.pf.kind=k;pnRedraw()};window.pnSearch=v=>{S.prQ=v;pnRedraw()};window.pnSort=()=>{S.prSort=((S.prSort||0)+1)%SORTS.length;pnRedraw()};
window.pnBump=id=>{const x=H.items.find(i=>i.id===id);if(!x)return;x.ago=0;toast('Moved to the top of '+area(x));render('fade-none')};

const av=x=>x.av===undefined?[0,0,7,14,30][hs(x.id)%5]:x.av;
const avail=x=>{const a=av(x);if(!a)return 'Available now';const d=new Date();d.setDate(d.getDate()+a);return 'Available from '+d.toLocaleDateString('en-GB',{day:'numeric',month:'short'})};
const MP=Object.keys(AR).filter(k=>k!=='Bugesera'),px=x=>Math.round(48+(x+3)*30),py=y=>Math.round(290-(y+4)*26);
const mapH=()=>{const R=RV[S.mxRad],c=AR[S.mxHood];return `<div style="margin:10px 24px 0;border-radius:20px;background:var(--chip);overflow:hidden"><svg viewBox="0 0 330 312" width="100%" role="img" aria-label="Map of homes by area">${c&&R?`<ellipse cx="${px(c[0])}" cy="${py(c[1])}" rx="${R*30}" ry="${R*26}" fill="var(--tint)" opacity=".5" stroke="var(--tintfg)" stroke-dasharray="4 4"/>`:''}${MP.map(a=>{const n=H.items.filter(x=>area(x)===a&&!x.st&&!S.pHide[x.id]).length,here=a===S.mxHood,X=px(AR[a][0]),Y=py(AR[a][1]);return `<g onclick="pnArea('${a}')" style="cursor:pointer"><circle cx="${X}" cy="${Y}" r="${here?19:15}" fill="${n?'var(--tintfg)':'var(--mu)'}" opacity="${n?1:.4}" ${here?'stroke="var(--tx)" stroke-width="3"':''}/><text x="${X}" y="${Y+5}" text-anchor="middle" font-size="14" font-weight="800" fill="#fff">${n}</text><text x="${X}" y="${Y+(here?34:30)}" text-anchor="middle" font-size="11" font-weight="700" fill="var(--tx)">${a}</text></g>`}).join('')}</svg><div class="sm mu" style="padding:0 14px 10px">Tap an area to see its homes. Your area has a dark ring.</div></div>`};
window.pnArea=a=>{S.pf.area=S.pf.area===a?'':a;S.pnMap=0;pnRedraw()};
const ohp=window.hdPost;
window.hdPost=function(){if(S.hd!=='property')return ohp.apply(this,arguments);S.pn6=S.pn6||{who:'owner',av:0,ex:'none'};pnPre()};
window.pnPre=()=>{const F=S.pn6;$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="h1" style="font-size:22px;line-height:30px">List a home in ${esc(S.mxHood)}</div><div class="lab" style="margin-top:12px">You are listing as</div><div class="dg-sg"><button class="${F.who==='owner'?'on':''}" onclick="S.pn6.who='owner';pnPre()">Owner</button><button class="${F.who==='agent'?'on':''}" onclick="S.pn6.who='agent';pnPre()">Agent</button></div><div class="lab" style="margin-top:14px">Available</div><div class="dg-sg">${[[0,'Now'],[7,'In a week'],[30,'Next month']].map(([v,l])=>`<button class="${F.av===v?'on':''}" onclick="S.pn6.av=${v};pnPre()">${l}</button>`).join('')}</div><div class="lab" style="margin-top:14px">Costs besides rent (if renting)</div><div class="dg-sg">${[['none','None'],['util','Water, power'],['svc','Service charge']].map(([v,l])=>`<button class="${(F.ex||'none')===v?'on':''}" onclick="S.pn6.ex='${v}';pnPre()">${l}</button>`).join('')}</div><button class="btn" style="margin-top:18px" onclick="pnGo()">Continue</button></div>`};
window.pnGo=()=>{closeSheet();ohp();try{S.pqf.l=S.mxHood;WZ.r.pw.draw()}catch(e){}};
const oG=window.pqGo;if(oG)window.pqGo=function(){const F=S.pqf,nw=F&&!F.id,n0=H.items.length,r=oG.apply(this,arguments);if(nw&&H.items.length>n0&&H.items[0].who==='You'){const x=H.items[0],p=S.pn6||{who:'owner',av:0};x.ag=p.who==='agent'?1:0;x.av=p.av;x.ex=p.ex||'none';if(x.loc==='Kigali')x.loc=S.mxHood;if($('#pnl'))pnRedraw()}return r};

const pd=x=>x.pd===undefined?(hs('p'+x.id)%5===0?5:0):x.pd;
const EX={none:'No extra costs beside the rent',util:'Water and power are extra (prepaid)',svc:'Service charge applies, ask for the amount'},ex=x=>x.ex||['none','util','svc'][hs('e'+x.id)%3];
const LQ=['Quiet at night.','Water is reliable.','Easy to find a moto.','Friendly neighbours.','Close to the market.','Roads get muddy in the rainy season.'];
const living=x=>{const a=area(x),h=hs(a),r=(4+(h%9)/10).toFixed(1);return `<div class="dg-sel pn-l" style="margin:14px 0 0"><b>Living in ${esc(a)}</b><div class="sm mu" style="margin-top:2px">★ ${r} · ${20+h%80} neighbours rated this area</div><div class="jn-rv">💬 “${LQ[h%6]}”<br>💬 “${LQ[(h+3)%6]}”</div></div>`};
const oT=window.hdTg;window.hdTg=function(t,id){oT.apply(this,arguments);if(t==='property'&&S.prCat==='Saved'&&$('#pnl'))pnRedraw()};
const oC=window.pCmpT;if(oC)window.pCmpT=function(){try{oC.apply(this,arguments)}catch(e){}if(S.hd==='property'&&$('#pnl'))pnRedraw()};
const oS=screens.hood;screens.hood=function(){if(S.hd!=='property')return oS.apply(this,arguments);
const tip=S.pTip?'':`<div style="margin:12px 24px 0;padding:14px 16px;border-radius:20px;background:var(--tint)"><b style="color:var(--tintfg)">Stay safe</b><div class="sm" style="margin-top:2px;line-height:19px">Never pay a deposit before you have seen the home and read the contract.</div><button class="cch" style="height:40px;margin-top:8px" onclick="S.pTip=1;render('fade-none')">Got it</button></div>`;
return `${bar(H.t)}<div class="dg-loc"><button class="dg-hb" onclick="jnHood()">📍 ${esc(S.mxHood)} <i>▾</i></button><span class="dg-v">✓ Verified area</span></div><div class="dg-q"><input id="pnq" type="search" aria-label="Search homes" placeholder="Search homes in ${esc(S.mxHood)}" value="${esc(S.prQ||'')}" oninput="pnSearch(this.value)"></div><div class="chips" style="padding-top:12px" id="pnc">${chips()}</div><div class="chips" style="padding-top:8px" id="pnk">${kchips()}</div><div class="dg-ib" id="pnb">${bar_()}</div>${tip}<div id="pnl" style="padding-top:6px">${body()}</div><div class="pad fine" style="padding-top:18px">Listings are sample data for this prototype.</div><div class="fab"><button class="btn" onclick="hdPost()" style="height:46px;padding:0 20px;font-size:15px;border-radius:23px;width:auto">+ List a home</button></div>`};
const oI=screens.hoodItem;screens.hoodItem=function(){let h=oI.apply(this,arguments);if(S.hd!=='property'||h.includes('pn-l'))return h;const x=H.items.find(i=>i.id===S.hdI);if(!x)return h;
const mine=x.who==='You',own=owner(x)&&!mine,SEL='<div class="dg-sel pn-l" style="margin:18px 0 0">';
h=h.replace(/(<div class="sm mu" style="margin-top:6px">)([^<]*)(<\/div>)/,(m,a,t,z)=>a+t+' · '+km(x)+' from '+esc(S.mxHood)+z);
if(mine){const i=h.indexOf('<div style="margin-top:8px">');const c=`${SEL}<b>Your listing</b><div class="sm mu" style="margin-top:2px">Listed ${when(x).toLowerCase()} in ${esc(area(x))}. Bump it to move it to the top.</div>${x.st?'':`<button class="cch on" style="margin-top:10px;height:44px" onclick="pnBump(${x.id})">Bump to top</button>`}</div>`;return i>=0?h.slice(0,i)+c+h.slice(i):h}
const tmp=36.5+(hs(x.who)%80)/10,col=tmp<37.5?'#4C8DF6':tmp<40?'#2E9E5B':'#F08A24';
const card=`${SEL}<div class="dg-sr"><div class="dg-av">${esc(x.who[0])}</div><div style="flex:1;min-width:0"><b>${esc(x.who)}</b><div class="sm mu">${own?'Owner':'Agent'} · ${x.ok?'Verified listing':'Not verified yet'}</div></div><div class="dg-tmp"><b style="color:${col}">${tmp.toFixed(1)}°C</b><div class="dg-tb"><i style="width:${Math.min(100,(tmp-30)*5)}%;background:${col}"></i></div><span>Manner temperature</span></div></div><div class="dg-n">Replies within an hour · ${70+hs(x.who)%30}% reply rate · ${1+hs(x.who)%6} homes listed<br>📍 ${km(x)} from ${esc(S.mxHood)} · ${eta(x)}<br>🗓 ${avail(x)}${x.c==='Rent'?'<br>💡 '+EX[ex(x)]:''}${pd(x)?'<br>↓ Price dropped '+pd(x)+'%':''}</div>${own?'<div class="dg-n">🤝 Owner direct: you talk to the owner, with no agent in between.</div>':'<div class="dg-n">💬 Ask the agent about any fee before you visit.</div>'}</div><div class="dg-n" style="margin:10px 0 0">🛡 Visit in daylight, take a friend, and never pay before you have seen the home and read the contract.</div>`+living(x);
if(own)h=h.replace('Agent · itunda user','Owner · itunda user');
const m=/<div class="tap"[^>]*onclick="pAgent\(/.exec(h);return m?h.slice(0,m.index)+card+h.slice(m.index):h};
if(document.title)document.title=document.title.replace(/v\d+/,'v510');
})()}catch(e){console.error('property-v507',e)}
</script>
<script>
/* v510: Post a job asks for shift, openings and perks first (see the v510 note in the Jobs block above). English only. */
try{(function(){
const H=HD.jobs,ohp=window.hdPost,DY=['Mon–Fri','Mon–Sat','Weekends','Flexible'],HR={Morning:'07:00–13:00',Afternoon:'13:00–19:00',Evening:'16:00–22:00','Full day':'08:00–17:00'},PK=['Paid same day','Meal included','Transport'];
const f=()=>S.jn10=S.jn10||{d:'Mon–Fri',h:'Morning',o:1,pk:[]};
window.hdPost=function(){if(S.hd!=='jobs')return ohp.apply(this,arguments);f();jnPre()};
window.jnPre=()=>{const F=f(),seg=(k,a)=>'<div class="dg-sg">'+a.map(([v,l])=>`<button class="${F[k]===v?'on':''}" onclick="S.jn10.${k}=${typeof v==='number'?v:"'"+v+"'"};jnPre()">${l}</button>`).join('')+'</div>';
$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="h1" style="font-size:22px;line-height:30px">Post a job in ${S.mxHood}</div><div class="lab" style="margin-top:12px">Days</div>${seg('d',DY.map(v=>[v,v]))}<div class="lab" style="margin-top:12px">Hours</div>${seg('h',Object.keys(HR).map(v=>[v,v]))}<div class="lab" style="margin-top:12px">People needed</div>${seg('o',[[1,'1'],[2,'2'],[3,'3 or more']])}<div class="lab" style="margin-top:12px">Perks</div><div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:6px">${PK.map(p=>`<button class="cch ${F.pk.includes(p)?'on':''}" onclick="jnPk('${p}')">${p}</button>`).join('')}</div><button class="btn" style="margin-top:18px" onclick="jnGo()">Continue</button></div>`};
window.jnPk=p=>{const a=f().pk,i=a.indexOf(p);i<0?a.push(p):a.splice(i,1);jnPre()};
window.jnGo=()=>{closeSheet();ohp();try{S.jbq2.l=S.mxHood;WZ.r.jw.draw()}catch(e){}};
const oG=window.jqGo;if(oG)window.jqGo=function(){const nw=S.jbq2&&!S.jbq2.id,n0=H.items.length,r=oG.apply(this,arguments);
if(nw&&H.items.length>n0&&H.items[0].who==='You'){const x=H.items[0],p=f();x.sh=p.d==='Flexible'?'Flexible · you pick the hours':p.d+' · '+HR[p.h];x.op=p.o;x.pk=p.pk.slice();if(x.loc==='Kigali')x.loc=S.mxHood;if($('#jnl'))jnRedraw()}return r};
})()}catch(e){console.error('jobs-v510',e)}
/* v511: Jobs, work that is safe and paid. Before: you could find and apply to a job nearby, but nothing after that. Now: (1) a "Today" chip shows jobs that can start right now; (2) once you are hired, the job page shows your shift as three taps: Check in at work, Check out, then Get paid, and the pay lands in itunda Pay Activity the same day, so nobody works and waits for money; (3) every job page says how you are paid and how to report a problem in one tap; (4) after pay, rate the employer (Pays on time / Fair hours / Not great). Check in asks you to be at the workplace, as Daangn Alba does. English only; rw/fr need native review. */
try{(function(){
const H=HD.jobs,oh=screens.hoodItem;S.jn11=S.jn11||{};
const st=id=>S.jn11[id]||0,card=x=>{const k=st(x.id),sh=x.sh||'Your shift',pay=fmt(x.n)+' RWF',
T3=[['Check in at work','Tap when you arrive. Your employer sees you are on time.','Check in'],['You are at work','Checked in. Tap when your shift ends.','Check out'],['Shift done','Your employer pays you through itunda Pay today.','Get paid'],['Paid '+pay,'Added to itunda Pay. Rate your employer to help neighbours.','']][k];
const rate=k===3&&!S.jn11['r'+x.id]?'<div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:12px">'+['Pays on time','Fair hours','Not great'].map(v=>`<button class="cch" onclick="jn11Rate(${x.id},'${v}')">${v}</button>`).join('')+'</div>':k===3?'<div class="sm mu" style="margin-top:10px">Thanks, your rating helps neighbours.</div>':'';
return `<div class="dg-sel" style="margin:16px 0 0"><div class="dg-sr"><div class="dg-av">${k===3?'✓':'🕒'}</div><div style="flex:1"><b>${T3[0]}</b><div class="sm mu">${esc(sh)}</div></div></div><div class="dg-n">${T3[1]}</div>${T3[2]?`<button class="btn" style="margin-top:12px;height:46px" onclick="jn11Go(${x.id})">${T3[2]}</button>`:''}${rate}</div>`};
const safe=`<div class="dg-n" style="margin:10px 0 0">💰 Get paid through itunda Pay, the same day. Not paid? <span style="color:var(--tintfg);font-weight:700" onclick="toast('Report sent. We will contact the employer within a day.')">Report in 1 tap</span></div>`;
screens.hoodItem=function(){let h=oh.apply(this,arguments);if(S.hd!=='jobs')return h;const x=H.items.find(i=>i.id===S.hdI);if(!x||x.who==='You'||h.includes('jn11'))return h;
const i=h.indexOf('<div class="cta"');const add=(S.hdApplied[x.id]&&(S.jbSt[x.id]||0)>=2?'<span class="jn11"></span>'+card(x):'<span class="jn11"></span>')+safe;
return i>=0?h.slice(0,i).replace(/<\/div>\s*$/,add+'</div>')+h.slice(i):h+add};
window.jn11Go=id=>{const x=H.items.find(i=>i.id===id),k=st(id);S.jn11[id]=k+1;
if(k===2){try{S.pay+=x.n;S.act.unshift(['up','Wage · '+x.who,'Paid · Just now',x.n,'Paid'])}catch(e){}toast('Paid '+fmt(x.n)+' RWF in itunda Pay')}else toast(k===0?'Checked in':'Checked out');render('fade-none')};
window.jn11Rate=(id,v)=>{S.jn11['r'+id]=v;toast('Thanks for rating');render('fade-none')};
})()}catch(e){console.error('jobs-v511',e)}
/* v512: Jobs, one tap to apply. Before: Apply opened a sheet asking for a note, a hurdle for a quick neighbourhood gig. Now: Apply sends your itunda profile to the employer in one tap and opens the chat, like Daangn Alba; you can still Message first. The itunda Pay balance now goes up when you tap Get paid (v511 only added the Activity row). English only; rw/fr need native review. */
try{(function(){const H=HD.jobs,oA=window.jbApply;
window.jbApply=function(id){if(S.hd!=='jobs'||!window.jbApplyGo)return oA.apply(this,arguments);const x=H.items.find(i=>i.id===id);if(!x||S.hdApplied[id])return;window.jbApplyGo(id);try{closeSheet()}catch(e){}toast('Applied with your profile')};
})()}catch(e){console.error('jobs-v512',e)}
/* v513: Jobs, My shifts and alerts. Before: hired jobs were mixed in with Applied, and you had to keep opening the app to see new work. Now: (1) a Shifts chip lists only jobs you are hired for, so today's shift is one tap away (check in, check out, get paid); (2) a 🔔 Alert button next to Filter turns on alerts for what you are looking at (your search, or the category, in your neighbourhood); tap again to turn it off. When a match is posted, a notice tells you the title, pay and distance. English only; rw/fr need native review. */
try{(function(){const H=HD.jobs;S.jn13al=S.jn13al||[];
window.jn13k=()=>{const q=(S.jnQ||'').trim(),c=S.jbCat;return (q||(c&&c!=='All'&&!['Saved','Applied','Shifts','Mine'].includes(c)?c:'Any job'))+' · '+S.mxHood};
window.jn13Al=()=>{const k=jn13k(),a=S.jn13al,i=a.indexOf(k);if(i>=0){a.splice(i,1);toast('Alert off: '+k)}else{a.push(k);toast('Alert on: '+k);
setTimeout(()=>{if(!S.jn13al.includes(k))return;const x=H.items.find(y=>!y.st&&y.who!=='You'&&!S.hdApplied[y.id]&&y.loc&&y.loc.includes(S.mxHood));if(x)toast('New near '+S.mxHood+': '+x.ti+' · '+fmt(x.n)+' RWF / '+x.u)},7000)}
try{jnRedraw()}catch(e){}};
})()}catch(e){console.error('jobs-v513',e)}
</script>
<script>
/* v514: Community, closer to Daangn "Life" (동네생활). Before: one feed with topic chips, no way to tell who a neighbour is, and nothing to do besides read and like. Now: (1) every neighbour shows a manner temperature (36.0 to 40.9 °C) next to the name, with a bar, verified-neighbour line and reply time on their profile; (2) new topics Local food and Together, with sample posts, some with a photo; (3) each post has quick reactions (Helpful, Me too, Thanks) that count up when tapped; (4) on All, Groups near you (Join opens a group chat in Messages) and Shops near you (opens a chat with the shop). Everything from v504 (range, 📍 area, search, sort, polls, events, replies, follow, mute) is unchanged. English only; rw/fr need native review. */
try{(function(){
const esc=s=>String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/"/g,'&quot;');
const hs=n=>{let h=0;String(n).split('').forEach(c=>h=(h*31+c.charCodeAt(0))>>>0);return h};
const TOP=[['All','All'],['Ask','Ask'],['Tips','Tips'],['Food','Local food'],['Together','Together'],['Events','Events'],['Safety','Safety'],['Lost','Lost & found'],['Saved','Saved'],['Following','Following'],['Mine','Mine']];
const LB={Food:'Local food',Together:'Together'};
const RX=[['help','Helpful'],['me','Me too'],['thx','Thanks']];
const GR=[['Kimironko morning runners','Running · 46 neighbours','celebrate'],['Remera parents','Parents · 128 neighbours','community'],['Kicukiro football','Sports · 62 neighbours','celebrate']];
const SH=[['Kigali Bakery','Fresh bread from 6:00 · 0.3 km','bread','Good morning! Fresh bread is out at 6:00. What can we set aside for you?'],['Mama Chantal Tailor','Alterations in a day · 0.6 km','bag','Hello! Bring your clothes before 10:00 for same-day pick-up.'],['Remera Grocers','Delivery in Remera · 1.4 km','money','Hi! Send us your list and we deliver within 30 minutes.']];
S.cn=S.cn||{rx:{},g:{}};
if(!S.cn14&&S.posts){S.cn14=1;S.posts.push(
{id:301,who:'Sandrine M.',t:'40 min ago',a:40,area:'Kimironko',cat:'Food',x:'The brochette stall behind Kimironko market is the best this month. 1,500 RWF for three sticks with chips. Go before 19:00.',l:12,c:2,me:false,ph:'harvest',rp:[['Eric M.','Agreed. Ask for the spicy sauce.'],['Aline N.','Went yesterday, long line but worth it.']]},
{id:302,who:'Eric M.',t:'2 h ago',a:120,area:'Kimironko',cat:'Together',x:'Anyone up for a Saturday morning run from Kimironko bus stage to Remera? Easy pace, about 5 km.',l:8,c:3,me:false,rp:[['Diane K.','Count me in.']],ev:{w:'Sat 06:30',wh:'Kimironko bus stage',n:7,me:0,rm:0,x:0}},
{id:303,who:'Mama Chantal',t:'4 h ago',a:240,area:'Remera',cat:'Food',x:'Now delivering isombe and rice every Friday in Remera. Order before 10:00 and it arrives at lunch.',l:21,c:4,me:false,v:1,ph:'bread',rp:[]},
{id:304,who:'Patrick H.',t:'Yesterday',a:1500,area:'Kacyiru',cat:'Together',x:'Sharing a cab to the airport on Sunday at 5:00 from Kacyiru. Two seats left, split the fare.',l:5,c:1,me:false,rp:[]})}
const tm=n=>(36+hs(n)%50/10).toFixed(1),tc=t=>t>=39?'#E8590C':t>=37?'var(--ok)':'var(--mu)';
const fix=(c,cat)=>LB[cat]?c.replace('>Ask</span>','>'+LB[cat]+'</span>'):c;
const rxRow=id=>RX.map(([k,l])=>{const on=S.cn.rx[id+k];return `<button class="cn-r ${on?'on':''}" aria-pressed="${!!on}" onclick="event.stopPropagation();cnRx(${id},'${k}')">${l} ${3+hs(id+k)%12+(on?1:0)}</button>`}).join('');
const proc=h=>h.split('<div class="post"').map((c,i)=>{if(!i)return c;const m=c.match(/cmOpen\((\d+)\)/),p=m&&S.posts.find(x=>x.id===+m[1]);if(!p)return c;
c=fix(c,p.cat).replace(/(cmWho\(\d+\)">[^<]*<\/button>)/,`$1<span class="cn-t" style="color:${tc(tm(p.who))}">${tm(p.who)}°C</span>`);
const k=c.indexOf('<div class="act">');if(k<0)return c;const e=c.indexOf('</div>',k)+6;
return c.slice(0,k)+(p.ph?`<div class="cn-ph">${gl(p.ph,72)}</div>`:'')+c.slice(k,e)+`<div class="cn-rx" id="cnrx${p.id}">${rxRow(p.id)}</div>`+c.slice(e)}).join('<div class="post"');
const strips=()=>`<div id="cnx"><div class="cn-h">Groups near you</div><div class="cn-st">${GR.map(([n,s,g],i)=>`<div class="cn-sc"><div>${gl(g,40)}</div><b>${n}</b><span>${s}</span><button class="cch ${S.cn.g[i]?'on':''}" onclick="cnJoin(${i})">${S.cn.g[i]?'Open chat':'Join'}</button></div>`).join('')}</div><div class="cn-h">Shops near you</div><div class="cn-st">${SH.map(([n,s,g],i)=>`<div class="cn-sc" role="button" tabindex="0" onclick="cnShop(${i})"><div>${gl(g,40)}</div><b>${n}</b><span>${s}</span><button class="cch">Message</button></div>`).join('')}</div></div>`;
function enh(){document.querySelectorAll('[id=cnl]').forEach(l=>{if(!l.innerHTML.includes('cn-rx'))l.innerHTML=proc(l.innerHTML);const par=l.parentNode,x=par.querySelector('#cnx');if(x)x.remove();if(S.cm.cat==='All'&&!(S.cm.q||'').trim())l.insertAdjacentHTML('beforebegin',strips());
const c=par.querySelector('#cnc');if(c)c.innerHTML=TOP.map(([k,l2])=>`<button class="cch ${S.cm.cat===k?'on':''}" onclick="cnCat('${k}')">${l2}</button>`).join('')})}
window.cnRx=(id,k)=>{S.cn.rx[id+k]=!S.cn.rx[id+k];const r=$('#cnrx'+id);if(r)r.innerHTML=rxRow(id)};
window.cnJoin=i=>{const id='cng'+i,g=GR[i];if(S.cn.g[i]){S.tab='messages';openChat(id);return}S.cn.g[i]=1;hdThread(id,g[0],'Neighbourhood group · '+g[1].split(' · ')[1],[['them','Welcome to '+g[0]+'. Say hi to your neighbours!']]);toast('Joined '+g[0]);const x=$('#cnx');if(x)x.outerHTML=strips()};
window.cnShop=i=>{const id='cns'+i,s=SH[i];hdThread(id,s[0],'Local shop · '+s[1].split(' · ')[1],[['them',s[3]]]);S.tab='messages';openChat(id)};
const oW=window.cmWho;if(oW)window.cmWho=function(id){const r=oW.apply(this,arguments),p=S.posts.find(x=>x.id===id),s=$('#layer .sheet');
if(p&&s&&s.children[0]&&!s.querySelector('.cn-mt')){const t=tm(p.who),a=String(p.area||S.mxHood).split(' · ')[0];s.children[0].insertAdjacentHTML('afterend',`<div class="cn-mt"><div style="display:flex;justify-content:space-between;font-size:15px"><b>Manner temperature</b><b style="color:${tc(t)}">${t}°C</b></div><div class="cn-bar"><i style="width:${Math.round((t-35)/6*100)}%;background:${tc(t)}"></i></div><div class="sm mu">Verified neighbour of ${esc(a)} · replies in about ${1+hs(p.who)%5} hours</div></div>`)}return r};
const oR=window.render;window.render=render=function(){const r=oR.apply(this,arguments);try{enh()}catch(e){}return r};
const oC=window.cnRedraw;if(oC)window.cnRedraw=function(){const r=oC.apply(this,arguments);try{enh()}catch(e){}return r};
if(!$('#cn514')){const s=document.createElement('style');s.id='cn514';s.textContent='.cn-t{margin-left:6px;font-size:12px;font-weight:700}.cn-ph{margin-top:12px;height:140px;border-radius:20px;background:var(--tint);display:flex;align-items:center;justify-content:center}.cn-rx{display:flex;gap:8px;flex-wrap:wrap;padding-top:6px}.cn-r{border:0;border-radius:16px;background:var(--chip);color:var(--mu);font:inherit;font-size:13px;font-weight:600;padding:0 12px;height:32px}.cn-r.on{background:var(--tint);color:var(--tintfg);font-weight:700}.cn-h{margin:16px 24px 0;font-size:16px;font-weight:700}.cn-st{display:flex;gap:10px;overflow-x:auto;padding:10px 24px 2px;scrollbar-width:none}.cn-sc{flex:0 0 150px;display:flex;flex-direction:column;align-items:flex-start;gap:4px;padding:14px;border-radius:20px;background:var(--chip);cursor:pointer}.cn-sc b{font-size:14px;font-weight:700;line-height:19px}.cn-sc span{font-size:12px;color:var(--mu);line-height:16px;flex:1}.cn-sc .cch{margin-top:8px}.cn-mt{margin:14px 0 4px;padding:14px 16px;border-radius:16px;background:var(--chip)}.cn-bar{height:6px;border-radius:3px;background:var(--bg,#fff);margin:10px 0 8px;overflow:hidden}.cn-bar i{display:block;height:100%;border-radius:3px}';document.head.appendChild(s)}
document.title=document.title.replace(/v\d+/,'v514');
})()}catch(e){console.error('community-v514',e)}
</script>
<script>
/* v515: Marketplace, safer and closer to Daangn Market (당근마켓). Before: you found a nearby listing, then chatted and paid in cash with nothing to protect you. Now, on a listing page: (1) Pay safely with itunda Pay: your money is held until you tap I got the item, which pays the seller; Cancel and refund returns it to your balance; the listing shows Reserved while the money is held and Sold when it is released; (2) Make an offer sends a fair price (asking, 5%, 10% or 20% off) to the seller's chat; (3) Set a meet-up picks a public spot near the seller and a time, sends it to the chat and shows it on the listing. Rows of paid listings show a Safe pay tag. Everything from v502 to v509 is unchanged. English only; rw/fr need native review. */
try{(function(){
const H=HD.market,esc=s=>String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/"/g,'&quot;');
const it=id=>H.items.find(i=>i.id===id),area=x=>x.sub.split(' · ')[0],R5=(p,f)=>Math.round(p*f/500)*500;
const sh=h=>{$('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet">'+h+'</div>'};
const T1='class="h1" style="font-size:22px;line-height:30px"';
const post=(x,m)=>{const th='hdmarket'+x.id;hdThread(th,x.who,x.ti,[]);S.msgs[th]=S.msgs[th]||[];m.forEach(y=>S.msgs[th].push(y));return th};
const chat=(x,m)=>{const th=post(x,m);closeSheet();S.tab='messages';openChat(th)};
const pick=(c,v)=>{document.querySelectorAll('.'+c).forEach(b=>b.classList.toggle('on',b.dataset.v===v))};
window.mkOffer=id=>{const x=it(id);S.mk15={o:0};sh(`<div ${T1}>Make an offer</div><div class="sm mu" style="margin-top:6px;line-height:20px">Asking ${fmt(x.p)} RWF. Sellers answer faster when the offer is fair.</div><div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:14px">${[...new Set([1,.95,.9,.8].map(f=>R5(x.p,f)))].map(v=>`<button class="cch mk-o" data-v="${v}" onclick="mkOfSel(${v})">${fmt(v)} RWF</button>`).join('')}</div><button class="btn" id="mkog" style="margin-top:18px" disabled onclick="mkOfGo(${id})">Send offer</button>`)};
window.mkOfSel=v=>{S.mk15.o=v;pick('mk-o',String(v));$('#mkog').disabled=false};
window.mkOfGo=id=>{const x=it(id);toast('Offer sent to '+x.who);chat(x,[['me','Would you take '+fmt(S.mk15.o)+' RWF for the '+x.ti+'?']])};
window.mkMeet=id=>{const x=it(id),a=area(x);S.mk15={s:'',t:''};sh(`<div ${T1}>Set a meet-up</div><div class="sm mu" style="margin-top:6px;line-height:20px">Meet in a public place and check the item before you pay.</div><div class="lab" style="margin-top:14px">Where</div><div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:6px">${[a+' bus stop',a+' market',a+' sector office'].map(v=>`<button class="cch mk-s" data-v="${esc(v)}" onclick="mkMt('s',this.dataset.v)">${esc(v)}</button>`).join('')}</div><div class="lab" style="margin-top:14px">When</div><div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:6px">${['Today 17:00','Tomorrow 10:00','Sat 09:00','Sun 15:00'].map(v=>`<button class="cch mk-t" data-v="${v}" onclick="mkMt('t',this.dataset.v)">${v}</button>`).join('')}</div><button class="btn" id="mkmg" style="margin-top:18px" disabled onclick="mkMeetGo(${id})">Send to ${esc(x.who)}</button>`)};
window.mkMt=(k,v)=>{S.mk15[k]=v;pick('mk-'+k,v);$('#mkmg').disabled=!(S.mk15.s&&S.mk15.t)};
window.mkMeetGo=id=>{const x=it(id),m=S.mk15;x.mt={s:m.s,t:m.t};toast('Meet-up sent to '+x.who);chat(x,[['me','Can we meet at '+m.s+' on '+m.t+'?']])};
window.mkPay=id=>{const x=it(id),n=typeof S.bank==='number',ok=!n||S.bank>=x.p;sh(`<div ${T1}>Pay safely</div><div class="sm mu" style="margin-top:6px;line-height:20px">itunda holds your money until you confirm you got the item. If something is wrong, you get it back.</div><div class="dg-sel" style="margin:14px 0 0"><div style="display:flex;justify-content:space-between;gap:10px"><span>${esc(x.ti)}</span><b style="white-space:nowrap">${fmt(x.p)} RWF</b></div><div class="sm mu" style="margin-top:4px">From itunda Pay${n?' · balance '+fmt(S.bank)+' RWF':''} · fee 0 RWF</div></div>${ok?'':'<div class="sm" style="color:var(--er);margin-top:10px">Not enough in itunda Pay. Add money first.</div>'}<div class="row2"><button class="btn sec2" style="flex:0 0 34%;width:auto" onclick="closeSheet()">Not now</button><button class="btn" style="flex:1;width:auto" ${ok?'':'disabled'} onclick="mkPayGo(${id})">Pay ${fmt(x.p)} RWF</button></div>`)};
window.mkPayGo=id=>{const x=it(id);if(typeof S.bank==='number')S.bank-=x.p;x.sp=1;x.st='reserved';post(x,[['me','I paid safely with itunda Pay. When can we meet?']]);closeSheet();toast('Paid. Your money is held until you confirm');render('fade-none')};
window.mkGot=id=>{const x=it(id);x.sp=2;x.st='sold';post(x,[['me','Got it, thank you! Payment released.']]);toast('Payment sent to '+x.who);render('fade-none')};
window.mkRef=id=>{const x=it(id);if(typeof S.bank==='number')S.bank+=x.p;x.sp=0;x.st='';toast('Refunded to itunda Pay');render('fade-none')};
const oI=screens.hoodItem;screens.hoodItem=function(){const h=oI.apply(this,arguments);if(S.hd!=='market'||h.includes('mk-c'))return h;const x=it(S.hdI);if(!x||x.who==='You')return h;
let b='';const B=(t,f,s)=>`<button class="btn${s?' sec2':''}" style="margin-top:${s?8:12}px" onclick="${f}(${x.id})">${t}</button>`;
if(x.sp===2)b=`<b>Deal done</b><div class="sm mu">Payment sent to ${esc(x.who)}.</div>`;
else if(x.sp===1)b=`<b>Paid · held safely</b><div class="sm mu" style="line-height:20px">${fmt(x.p)} RWF is held by itunda. Check the item, then confirm to pay ${esc(x.who)}.</div>`+B('I got the item','mkGot')+B('Cancel and refund','mkRef',1)+B(x.mt?'Change meet-up':'Set a meet-up','mkMeet',1);
else if(x.st!=='sold')b=(x.p&&!x.st?`<b>Pay safely with itunda Pay</b><div class="sm mu" style="line-height:20px">Your money is held until you confirm you got the item. No fee.</div>`+B('Pay safely · '+fmt(x.p)+' RWF','mkPay')+B('Make an offer','mkOffer',1):'')+B(x.mt?'Change meet-up':'Set a meet-up','mkMeet',1);
if(!b)return h;if(x.mt&&x.sp!==2)b=`<div class="sm" style="font-weight:700;margin-bottom:8px">Meet-up: ${esc(x.mt.t)} · ${esc(x.mt.s)}</div>`+b;
const card=`<div class="dg-sel mk-c" style="margin-top:12px">${b}</div>`,c=h.indexOf('<div class="cta"');return c>0?h.slice(0,c)+card+h.slice(c):h+card};
const proc=l=>{if(l.innerHTML.includes('mk-sp'))return;l.innerHTML=l.innerHTML.replace(/<div class="dg-r"[^>]*hdOpen\('market',(\d+)\)[\s\S]*?<div class="dg-m">/g,(m,id)=>{const x=it(+id);return x&&x.p&&x.who!=='You'&&x.st!=='sold'?m+'<span class="mk-sp">Safe pay</span>':m})};
const enh=()=>document.querySelectorAll('[id=mxl2]').forEach(proc);
const oR=window.render;window.render=render=function(){const r=oR.apply(this,arguments);try{enh()}catch(e){}return r};
const oM=window.mxRedraw;if(oM)window.mxRedraw=function(){const r=oM.apply(this,arguments);try{enh()}catch(e){}return r};
if(!$('#mk515')){const s=document.createElement('style');s.id='mk515';s.textContent='.mk-sp{color:var(--ok);font-weight:700}';document.head.appendChild(s)}
document.title=document.title.replace(/v\d+/,'v515');
})()}catch(e){console.error('market-v515',e)}
</script>
<script>
/* v516: Marketplace, closer to Daangn Market (당근마켓) where trust between neighbours is the product. Before: the seller's manner temperature was a fixed number and nothing a buyer did could change it. Now: (1) after you tap I got the item, a short review (Great, Okay, Not good, plus what went well) moves the seller's manner temperature up or down and adds to their deal count; (2) tap the seller card to open a neighbour profile: temperature, deals done, what neighbours say (On time, Fair price, Item as described, Kind and polite, with counts that include your review), and Selling / Sold lists; (3) owners can Lower the price on their own listing: the row shows the old price struck through with a red percentage, and the listing moves to the top; (4) an Available only toggle hides Reserved and Sold rows; (5) tapping the search field shows your recent searches and popular words near your neighbourhood. Everything from v502 to v515 is unchanged. English only; rw/fr need native review. */
try{(function(){
const H=HD.market,esc=s=>String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/"/g,'&quot;');
const it=id=>H.items.find(i=>i.id===id),area=x=>x.sub.split(' · ')[0];
const hs=n=>{let h=0;String(n).split('').forEach(c=>h=(h*31+c.charCodeAt(0))>>>0);return h};
const sh=h=>{$('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet">'+h+'</div>'};
const T1='class="h1" style="font-size:22px;line-height:30px"';
S.mxMt=S.mxMt||{};S.mxTg=S.mxTg||{};S.mxDl=S.mxDl||{};S.mxRc=S.mxRc||[];
const TG=['On time','Fair price','Item as described','Kind and polite'];
const temp=w=>w==='You'?36.5:Math.max(30,Math.min(99,36.5+(hs(w)%80)/10+(S.mxMt[w]||0)));
const col=t=>t<37.5?'#4C8DF6':t<40?'#2E9E5B':'#F08A24';
const tmp=w=>{const t=temp(w);return `<div class="dg-tmp"><b style="color:${col(t)}">${t.toFixed(1)}°C</b><div class="dg-tb"><i style="width:${Math.min(100,(t-30)*5)}%;background:${col(t)}"></i></div><span>Manner temperature</span></div>`};
const cnt=(w,t)=>1+hs(w+t)%12+((S.mxTg[w]||{})[t]||0);
const deals=w=>3+hs(w)%20+(S.mxDl[w]||0);

/* neighbour profile */
window.mxSeller=w=>{S.mxSel=w;S.mxPf='sell';S.stack.push('mxSeller');render('push')};
window.mxPf=k=>{S.mxPf=k;render('fade-none')};
window.mxOpen=id=>{S.hdI=id;S.stack.push('hoodItem');render('push')};
screens.mxSeller=()=>{const w=S.mxSel,all=H.items.filter(y=>y.who===w),sell=all.filter(y=>y.st!=='sold'),sold=all.filter(y=>y.st==='sold'),l=S.mxPf==='sold'?sold:sell,a=all[0]?area(all[0]):S.mxHood;
const row=y=>`<div class="hdc" role="button" tabindex="0" onclick="mxOpen(${y.id})"><div class="th" style="${y.st==='sold'?'opacity:.5':''}">${gl(y.g,40)}</div><div><div class="t">${esc(y.ti)}</div><div class="s">${esc(y.sub)}</div><div class="pr">${y.st?`<span class="dg-st ${y.st==='sold'?'sd':''}">${y.st==='sold'?'Sold':'Reserved'}</span> `:''}${y.p?fmt(y.p)+' RWF':'Free'}${y.old?` <s class="mk-old">${fmt(y.old)}</s>`:''}</div></div></div>`;
const tg=TG.map(t=>[t,cnt(w,t)]).sort((p,q)=>q[1]-p[1]);
return `${bar('Neighbour')}<div class="dg-sel" style="margin-top:12px"><div class="dg-sr"><div class="dg-av" style="width:56px;height:56px;border-radius:28px;font-size:22px">${esc(w[0])}</div><div style="flex:1;min-width:0"><b style="font-size:18px">${esc(w)}</b><div class="sm mu">${esc(a)} · Verified neighbour</div></div>${tmp(w)}</div><div class="dg-n">${deals(w)} deals done · ${70+hs(w)%30}% reply rate · Replies within an hour</div></div><div class="pad" style="padding-top:22px"><b style="font-size:17px">What neighbours say</b>${tg.map(([t,n])=>`<div class="mk-tg"><span>${t}</span><b>${n}</b></div>`).join('')}</div><div class="seg"><button class="${S.mxPf==='sold'?'':'on'}" onclick="mxPf('sell')">Selling ${sell.length}</button><button class="${S.mxPf==='sold'?'on':''}" onclick="mxPf('sold')">Sold ${sold.length}</button></div><div style="padding-top:8px">${l.length?l.map(row).join(''):`<div class="dg-e"><b>${S.mxPf==='sold'?'Nothing sold yet':'Nothing for sale right now'}</b></div>`}</div>`};

/* review after a deal */
window.mxRvOpen=id=>{const x=it(id);if(!x)return;S.mk16={id,f:-1,tg:[]};
sh(`<div ${T1}>How was the deal with ${esc(x.who)}?</div><div class="sm mu" style="margin-top:6px;line-height:20px">Your answer changes their manner temperature, so neighbours know who they are meeting.</div><div class="dg-sg" style="margin-top:14px">${[['😊','Great'],['🙂','Okay'],['😕','Not good']].map(([e,l],i)=>`<button class="mk-f" data-v="${i}" onclick="mxRvF(${i})">${e} ${l}</button>`).join('')}</div><div id="mk16t" style="display:none"><div class="lab" style="margin-top:14px">What went well?</div><div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:6px">${TG.map(t=>`<button class="cch" data-v="${t}" onclick="mxRvT(this)">${t}</button>`).join('')}</div></div><button class="btn" id="mk16g" style="margin-top:18px" disabled onclick="mxRvGo()">Send review</button><button class="btn sec2" style="margin-top:10px" onclick="closeSheet()">Not now</button>`)};
window.mxRvF=i=>{S.mk16.f=i;document.querySelectorAll('.mk-f').forEach(b=>b.classList.toggle('on',+b.dataset.v===i));$('#mk16t').style.display=i<2?'block':'none';$('#mk16g').disabled=false};
window.mxRvT=b=>{const t=b.dataset.v,a=S.mk16.tg,k=a.indexOf(t);if(k<0)a.push(t);else a.splice(k,1);b.classList.toggle('on',k<0)};
window.mxRvGo=()=>{const m=S.mk16,x=it(m.id);if(!x)return;const w=x.who;S.mxMt[w]=(S.mxMt[w]||0)+[.5,.1,-.4][m.f];S.mxDl[w]=(S.mxDl[w]||0)+1;S.mxTg[w]=S.mxTg[w]||{};if(m.f<2)m.tg.forEach(t=>S.mxTg[w][t]=(S.mxTg[w][t]||0)+1);x.rv=1;closeSheet();toast('Thanks. '+w+' is now '+temp(w).toFixed(1)+'°C');render('fade-none')};
const g0=window.mkGot;window.mkGot=function(id){const r=g0.apply(this,arguments);setTimeout(()=>{const x=it(id);if(x&&!x.rv&&S.hd==='market')mxRvOpen(id)},450);return r};

/* lower the price */
window.mxDrop=id=>{const x=it(id);if(!x||!x.p)return;const o=[...new Set([.95,.9,.8].map(f=>Math.round(x.p*f/100)*100))].filter(v=>v>0&&v<x.p);if(!o.length){toast('This price is already low');return}S.mk16={id,p:0};
sh(`<div ${T1}>Lower the price</div><div class="sm mu" style="margin-top:6px;line-height:20px">Now ${fmt(x.p)} RWF. Neighbours who saved this listing see the new price, and it moves to the top.</div><div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:14px">${o.map(v=>`<button class="cch mk-d" data-v="${v}" onclick="mxDropSel(${v})">${fmt(v)} RWF · ${Math.round((1-v/x.p)*100)}% off</button>`).join('')}</div><button class="btn" id="mk16d" style="margin-top:18px" disabled onclick="mxDropGo()">Lower price</button>`)};
window.mxDropSel=v=>{S.mk16.p=v;document.querySelectorAll('.mk-d').forEach(b=>b.classList.toggle('on',+b.dataset.v===v));$('#mk16d').disabled=false};
window.mxDropGo=()=>{const x=it(S.mk16.id);if(!x||!S.mk16.p)return;x.old=x.old||x.p;x.p=S.mk16.p;x.sub=area(x)+' · Just now';closeSheet();toast('Price lowered. Saved neighbours are told');render('fade-none')};

/* listing page */
const o16=screens.hoodItem;screens.hoodItem=function(){let h=o16.apply(this,arguments);if(S.hd!=='market')return h;const x=it(S.hdI);if(!x)return h;
if(x.who!=='You'){h=h.replace(/<div class="dg-tmp">[\s\S]*?<span>Manner temperature<\/span><\/div>/,tmp(x.who)).replace('<div class="dg-sr"><div class="dg-av">',`<div class="dg-sr" role="button" tabindex="0" data-w="${esc(x.who)}" onclick="mxSeller(this.dataset.w)" style="cursor:pointer"><div class="dg-av">`).replace(' · Verified neighbour</div>',' · Verified neighbour · <span style="color:var(--lk);font-weight:700">Profile ›</span></div>');
if(x.sp===2&&!x.rv){const m=`Payment sent to ${esc(x.who)}.</div>`;h=h.replace(m,m+`<button class="btn" style="margin-top:12px" onclick="mxRvOpen(${x.id})">Leave a review</button>`)}}
else if(x.p&&x.st!=='sold')h=h.replace('>Bump to top</button>','>Bump to top</button><button class="cch" style="margin-top:8px;height:44px;width:100%;justify-content:center" onclick="mxDrop('+x.id+')">Lower the price</button>');
if(x.old&&x.p<x.old){const n=`<div class="dg-n" style="margin:10px 24px 0">↓ Lowered from ${fmt(x.old)} RWF · ${Math.round((1-x.p/x.old)*100)}% off</div>`,c=h.indexOf('<div class="cta"');h=c>0?h.slice(0,c)+n+h.slice(c):h+n}
return h};

/* list: price drops, available only, search suggestions */
const KW=['Phone','Bicycle','Sofa','Baby clothes','Textbooks','Fridge'];
const rec=w=>{S.mxRc=[w,...S.mxRc.filter(y=>y!==w)].slice(0,6)};
const chip=w=>`<button class="cch" data-k="${esc(w)}" onclick="mxKw(this.dataset.k)">${esc(w)}</button>`;
const panel=()=>`<div class="mk-sg">${S.mxRc.length?`<div class="mk-sh"><b>Recent searches</b><button onclick="mxRcClr()">Clear</button></div><div class="mk-sc">${S.mxRc.map(chip).join('')}</div>`:''}<div class="mk-sh"><b>Popular near ${esc(S.mxHood)}</b></div><div class="mk-sc">${KW.map(chip).join('')}</div></div>`;
window.mxKw=w=>{const q=$('#mxq');if(q)q.value=w;rec(w);mxSearch(w)};
window.mxRcClr=()=>{S.mxRc=[];const l=$('#mxl2'),q=$('#mxq');if(l&&q&&!q.value.trim())l.innerHTML=panel()};
window.mxAv=()=>{S.mxAv=!S.mxAv;const l=$('#mxl2'),b=$('#mk-avb');if(l)l.classList.toggle('mk-av',!!S.mxAv);if(b)b.classList.toggle('on',!!S.mxAv)};
const enh=()=>{const l=$('#mxl2');if(!l)return;l.classList.toggle('mk-av',!!S.mxAv);
if(l.querySelector('.dg-r')){
if(H.items.some(x=>x.old))l.innerHTML=l.innerHTML.replace(/(<div class="dg-r"[^>]*hdOpen\('market',(\d+)\)[\s\S]*?<div class="dg-p">)([\s\S]*?)(<\/div><div class="dg-m">)/g,(m,a,id,p,e)=>{const x=it(+id);return x&&x.old&&x.p<x.old&&!p.includes('mk-dn')?a+p+`<s class="mk-old">${fmt(x.old)}</s><span class="mk-dn">↓${Math.round((1-x.p/x.old)*100)}%</span>`+e:m});
if(!l.querySelector('#mk-avb'))l.insertAdjacentHTML('afterbegin',`<div style="padding:10px 24px 0"><button id="mk-avb" class="cch ${S.mxAv?'on':''}" onclick="mxAv()">✓ Available only</button></div>`)}
const q=$('#mxq');if(q&&!q.dataset.m16){q.dataset.m16=1;
q.addEventListener('focus',()=>{if(!q.value.trim()){const b=$('#mxl2');if(b)b.innerHTML=panel()}});
q.addEventListener('keydown',e=>{if(e.key==='Enter'&&q.value.trim()){rec(q.value.trim());q.blur()}});
q.addEventListener('blur',()=>setTimeout(()=>{if(!q.value.trim()&&$('.mk-sg'))mxRedraw()},350))}};
const oR=window.render;window.render=render=function(){const r=oR.apply(this,arguments);try{enh()}catch(e){}return r};
const oM=window.mxRedraw;if(oM)window.mxRedraw=function(){const r=oM.apply(this,arguments);try{enh()}catch(e){}return r};
if(!$('#mk516')){const s=document.createElement('style');s.id='mk516';s.textContent='.mk-old{color:var(--tt);font-size:13px;font-weight:500;text-decoration:line-through}.mk-dn{color:var(--er);font-size:13px;font-weight:800}.mk-tg{display:flex;justify-content:space-between;padding:12px 0;font-size:15px;border-bottom:1px solid var(--chip)}.mk-av .dg-r:has(.dg-st){display:none}.mk-sg{padding:6px 24px 0}.mk-sh{display:flex;justify-content:space-between;align-items:center;margin-top:16px}.mk-sh button{border:0;background:none;color:var(--tt);font-size:13px}.mk-sc{display:flex;flex-wrap:wrap;gap:8px;margin-top:8px}';document.head.appendChild(s)}
document.title=document.title.replace(/v\d+/,'v516');
})()}catch(e){console.error('market-v516',e)}
</script>
<script>
/* v517: Jobs, trust between neighbours and employers (Daangn Alba style). Before: after a shift you could rate the employer, but nothing changed, the employer could not hire anyone, and you could not tell if the pay was fair. Now: (1) your rating after a shift (Pays on time, Fair hours, Not great) moves the employer's manner temperature and adds to their people-hired count; (2) tap Profile on the employer card to open the employer page: temperature, people hired, what workers say (Pays on time, Fair hours, Friendly boss, Clear tasks, with counts that include your rating) and their open jobs; (3) a job page says if the pay is above, fair or below what neighbours earn for the same kind of work; (4) on your own job, tap Hire on a shortlisted applicant: when all openings are filled the job shows Filled. English only; rw/fr need native review. */
try{(function(){
const H=HD.jobs,esc=s=>String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/"/g,'&quot;');
const hs=n=>{let h=0;String(n).split('').forEach(c=>h=(h*31+c.charCodeAt(0))>>>0);return h};
const it=id=>H.items.find(i=>i.id===id);
S.jn17=S.jn17||{mt:{},tg:{},dl:{},hr:{}};
const TG=['Pays on time','Fair hours','Friendly boss','Clear tasks'],RT={'Pays on time':[.5,1],'Fair hours':[.4,1],'Not great':[-.5,0]};
const temp=w=>Math.max(30,Math.min(99,36.5+(hs(w)%80)/10+(S.jn17.mt[w]||0)));
const col=t=>t<37.5?'#4C8DF6':t<40?'#2E9E5B':'#F08A24';
const tmp=w=>{const t=temp(w);return `<div class="dg-tmp"><b style="color:${col(t)}">${t.toFixed(1)}°C</b><div class="dg-tb"><i style="width:${Math.min(100,(t-30)*5)}%;background:${col(t)}"></i></div><span>Manner temperature</span></div>`};
const cnt=(w,t)=>1+hs(w+t)%12+((S.jn17.tg[w]||{})[t]||0),hired=w=>3+hs(w)%20+(S.jn17.dl[w]||0);
const hrly=x=>{const m=/(\d\d):(\d\d)\D+(\d\d):(\d\d)/.exec(x.sh||''),h=m?((+m[3]*60+ +m[4])-(+m[1]*60+ +m[2]))/60:0;return h>0&&x.u!=='month'&&x.n?x.n/h:0};

/* rating moves the temperature */
const r0=window.jn11Rate;window.jn11Rate=function(id,v){const x=it(id);if(x&&RT[v]){const w=x.who,r=RT[v];S.jn17.mt[w]=(S.jn17.mt[w]||0)+r[0];S.jn17.dl[w]=(S.jn17.dl[w]||0)+1;if(r[1]){S.jn17.tg[w]=S.jn17.tg[w]||{};S.jn17.tg[w][v]=(S.jn17.tg[w][v]||0)+1}}
const o=r0&&r0.apply(this,arguments);if(x)toast('Thanks. '+x.who+' is now '+temp(x.who).toFixed(1)+'°C');return o};

/* employer page */
window.jbEmp=id=>{const x=it(id);if(!x||x.who==='You')return;S.jnEw=x.who;S.stack.push('jnEmp');render('push')};
screens.jnEmp=()=>{const w=S.jnEw,all=H.items.filter(y=>y.who===w),open=all.filter(y=>!y.st),a=String(all[0]&&all[0].loc||'Kigali'),tg=TG.map(t=>[t,cnt(w,t)]).sort((p,q)=>q[1]-p[1]);
const row=y=>`<div class="hdc" role="button" tabindex="0" onclick="hdOpen('jobs',${y.id})"><div class="th">${gl(y.g,40)}</div><div style="flex:1;min-width:0"><div class="t">${esc(y.ti)}</div><div class="s">${esc(y.sh||y.loc)}</div><div class="pr">${fmt(y.n)} RWF / ${y.u}</div></div></div>`;
return `${bar('Employer')}<div class="dg-sel" style="margin-top:12px"><div class="dg-sr"><div class="dg-av" style="width:56px;height:56px;border-radius:28px;font-size:22px">${esc(w[0])}</div><div style="flex:1;min-width:0"><b style="font-size:18px">${esc(w)}</b><div class="sm mu">${esc(a)} · Verified local business</div></div>${tmp(w)}</div><div class="dg-n">${hired(w)} people hired · ${70+hs(w)%30}% reply rate · Replies within an hour</div></div><div class="pad" style="padding-top:22px"><b style="font-size:17px">What workers say</b>${tg.map(([t,n])=>`<div class="mk-tg"><span>${t}</span><b>${n}</b></div>`).join('')}</div><div class="pad" style="padding-top:18px"><b style="font-size:17px">Open jobs · ${open.length}</b></div><div>${open.length?open.map(row).join(''):'<div class="pad sm mu">No open jobs right now.</div>'}</div><div style="height:40px"></div>`};

/* Hire from shortlist */
window.jnHire=(id,i)=>{const x=it(id),a=S.jbAp&&S.jbAp[id];if(!x||!a||!a[i])return;S.jn17.hr[id]=S.jn17.hr[id]||{};S.jn17.hr[id][i]=1;const n=Object.keys(S.jn17.hr[id]).length,op=x.op||1;
if(n>=op){x.st=1;toast(a[i].n+' hired. Job is now Filled')}else toast(a[i].n+' hired. '+(op-n)+' more to go');render('fade-none')};

/* job page */
const oh=screens.hoodItem;screens.hoodItem=function(){let h=oh.apply(this,arguments);if(S.hd!=='jobs')return h;const x=it(S.hdI);if(!x)return h;
if(x.who==='You'){if(S.jbAp&&S.jbAp[x.id]){let k=-1;const ap=S.jbAp[x.id].map((p,i)=>[p,i]).filter(([p])=>p.s===1);h=h.replace(/<span class="sm" style="font-weight:700;color:var\(--ok\)">Shortlisted<\/span>/g,m=>{k++;const e=ap[k];if(!e)return m;const on=(S.jn17.hr[x.id]||{})[e[1]];return `<span style="display:flex;gap:8px;align-items:center">${m}${on?'<b class="sm" style="color:var(--ok)">✓ Hired</b>':`<button class="cch on" style="height:30px" onclick="jnHire(${x.id},${e[1]})">Hire</button>`}</span>`})}return h}
h=h.replace(/<div class="dg-tmp">[\s\S]*?<span>Manner temperature<\/span><\/div>/,tmp(x.who)).replace(/\d+ people hired/,hired(x.who)+' people hired').replace(' · Verified local business</div>',` · Verified local business · <span style="color:var(--lk);font-weight:700" onclick="jbEmp(${x.id})">Profile ›</span></div>`);
const r=hrly(x),pe=H.items.filter(y=>y.id!==x.id&&y.k&&y.k===x.k&&hrly(y)>0);
if(r&&pe.length>=2&&!h.includes('jn17p')){const av=pe.reduce((s,y)=>s+hrly(y),0)/pe.length,d=Math.round((r/av-1)*100),m=d>=8?'Pays '+d+'% above the usual for '+x.k+' jobs near you.':d<=-8?'Pays '+(-d)+'% below the usual for '+x.k+' jobs near you. Ask what is included.':'Fair pay for '+x.k+' jobs near you.';
h=h.replace('<div class="dg-sel" style="margin:18px 0 0">',`<div class="dg-n jn17p" style="margin:16px 0 0">📊 ${m}</div><div class="dg-sel" style="margin:18px 0 0">`)}
return h};
document.title=document.title.replace(/v\d+/,'v517');
})()}catch(e){console.error('jobs-v517',e)}
</script>
<script>
/* v518: the neighbourhood picker moves into the app bar, like the delivery address in Eats. Before: Marketplace, Jobs, Community and Property each had their own row under the title with the area name and a "Verified area" tag, so the place you were looking at sat in the middle of the page and the bar only held a title. Now: the bar is back, then your neighbourhood with a small line above it ("Jobs near") and a down arrow; tap it to change area and range, and the same choice applies to all four. The extra row is gone, so the search field moves up. The bar stays on top while you scroll. English only; rw/fr need native review. */
try{(function(){
const RE=/<div class="bar">(<button class="ib"[\s\S]*?<\/button>)<b>([^<]*)<\/b><\/div><div class="dg-loc"><button class="dg-hb" onclick="(\w+)\(\)">\uD83D\uDCCD ([^<]*?) <i>\u25BE<\/i><\/button><span class="dg-v">[^<]*<\/span><\/div>/;
const fix=h=>typeof h!=='string'?h:h.replace(RE,(m,back,t,fn,n)=>`<div class="lc-top"><div class="lc-ad">${back}<button class="lc-adb" onclick="${fn}()" aria-label="Change neighbourhood, now ${n}"><span style="color:var(--tintfg);display:flex"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11a7 7 0 0114 0c0 4.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg></span><span style="min-width:0;flex:1"><small>${t} near</small><b>${n} ${ic('chev',16)}</b></span></button></div></div>`);
['hood','community'].forEach(k=>{const o=screens[k];screens[k]=function(){return fix(o.apply(this,arguments))}});
if(!$('#lc518')){const s=document.createElement('style');s.id='lc518';s.textContent='#phone .lc-top{position:sticky;top:0;z-index:6;background:var(--bg);padding-bottom:4px}#phone .lc-ad{display:flex;align-items:center;gap:6px;padding:10px 12px 6px 8px}#phone .lc-adb{flex:1;min-width:0;display:flex;align-items:center;gap:8px;border:0;background:none;font:inherit;color:inherit;text-align:left;padding:4px 6px;min-height:44px}#phone .lc-adb b{display:flex;align-items:center;gap:2px;font-size:17px;font-weight:800;letter-spacing:-.3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}#phone .lc-adb b svg{transform:rotate(90deg);flex:none}#phone .dg-ib>span,#phone .dg-m>span{white-space:nowrap}#phone .lc-adb small{display:block;font-size:12px;color:var(--mu);margin-bottom:1px}';document.head.appendChild(s)}
document.title=document.title.replace(/v\d+/,'v518');
})()}catch(e){console.error('hood-bar-v518',e)}
</script>
<script>
/* v519: Marketplace, Jobs, Property and Community go back to the quiet itunda look. Before: each list stacked a pill row, a second pill row (Property types, Compare, Viewings), a count + Map + Sort + Alert + Filter row, "Available only", a "Popular near" ticker with fire emojis, a safety banner, Groups and Shops carousels, and every card carried 3 to 5 tags, counters (comments, hearts, applicants, views) and extra lines (hourly rate, schedule, availability). Now: search, one row of plain text tabs (underline on the chosen one), one quiet line with the count on the left and Sort + Filter as plain text on the right, then listings with title, place, and price only. Cards are flat rows with a smaller icon, no pills. The Post/Sell/List button sits at the bottom with room under the last row so it no longer covers a listing. Community keeps the ask box and the posts, with Like and Reply under each post (Helpful / Me too / Thanks, Save, Share and the RSVP buttons are off the feed and stay on the post page); Groups and Shops carousels, the "neighbours here" line, tags and view counts are off the feed. Nothing is deleted from the code: Map, Alert, Compare, Viewings, Available only, Popular, Groups and Shops are hidden on the list pages and can be moved into Filter or detail pages next. English only. */
try{(function(){
if($('#q519'))return;
const L='#mxl2,#jnl,#pnl,#cnl',T='#mxcc,#jncc,#pnc,#cnc';
const css=`
/* tabs: plain text, underline on the chosen one */
#phone :is(${T}){gap:20px!important;padding:6px 24px 0!important;border-bottom:0}
#phone :is(${T}) .cch{background:none!important;border-radius:0!important;padding:0 2px!important;height:44px!important;font-size:16px!important;font-weight:700!important;color:var(--tt)!important;position:relative!important;flex:0 0 auto;white-space:nowrap;box-shadow:none!important}
#phone :is(${T}) .cch.on{color:var(--tx)!important}
#phone :is(${T}) .cch.on::after{content:"";position:absolute;left:0;right:0;bottom:2px;height:3px;border-radius:2px;background:var(--tx)}
#phone #pnc .cch:nth-last-child(-n+2){display:none!important}
#phone #pnk{display:none!important}
/* one quiet line: count left, Sort + Filter as text right */
#phone :is(#mxbr,#jnbr,#pnb,#cnb){padding:8px 24px 4px!important;gap:16px!important;align-items:center}
#phone :is(#mxbr,#jnbr,#pnb,#cnb) .cch{background:none!important;border-radius:0!important;padding:0!important;height:36px!important;font-size:14px!important;font-weight:700!important;color:var(--mu)!important;min-width:0!important}
#phone :is(#jnbr,#pnb) .cch:nth-child(3){display:none!important}
#phone #jnbr .cch:nth-child(5){display:none!important}
/* noise on Marketplace / Property / Community */
#phone #mxl2>div:has(#mk-avb),#phone #mxl2>div:has(>div[data-h44s]){display:none!important}
#phone #pnb~div:not(#pnl):not(.pad):has(button){display:none!important}
#phone .dg-n,#phone #cnx{display:none!important}
/* listing cards: title, place, price */
#phone :is(#mxl2,#jnl,#pnl) .dg-r{padding:14px 24px!important;gap:14px!important;align-items:center}
#phone :is(#mxl2,#jnl,#pnl) .dg-th{width:60px!important;height:60px!important;min-width:60px!important;border-radius:18px!important;flex:none}
#phone :is(#mxl2,#jnl,#pnl) .dg-th svg{width:30px!important;height:30px!important}
#phone :is(#mxl2,#jnl,#pnl) .dg-t{font-size:16px!important;line-height:22px!important}
#phone :is(#mxl2,#jnl,#pnl) .dg-s{font-size:13px!important;line-height:18px!important;margin-top:2px!important}
#phone :is(#mxl2,#jnl,#pnl) .dg-p{font-size:16px!important;margin-top:4px!important}
#phone #mxl2 .dg-m{display:none!important}
#phone #jnl .jn-sh{display:none!important}
#phone #pnl .jn-sh~.jn-sh{display:none!important}
#phone :is(#jnl,#pnl) .jn-m .jn-t,#phone :is(#jnl,#pnl) .jn-m .jn-p{display:none!important}
#phone :is(#jnl,#pnl) .jn-m:not(:has(*:not(.jn-t):not(.jn-p))){display:none!important}
#phone :is(#mxl2,#jnl,#pnl,#cnl){padding-bottom:110px!important}
/* community feed */
#phone .cn-c{background:var(--chip)!important;border-radius:22px!important;min-height:48px!important;font-size:15px!important;font-weight:600!important;color:var(--mu)!important;padding:0 18px!important}
#phone .cn-c>span:first-child{display:none!important}
#phone #cnl .post>div[style*="margin-top:10px"][style*="flex-wrap"]{display:none!important}
#phone #cnl .cn-t{display:none!important}
#phone #cnl .cn-rx{display:none!important}
#phone #cnl .post .act>button:nth-child(n+3){display:none!important}
#phone #cnl .post .act svg{color:var(--mu)!important;stroke:currentColor}
#phone #cnl .post div[data-v352]>div:nth-child(2){display:none!important}
#phone #cnl .post div[data-v352]{padding:10px 14px!important}
`;
const s=document.createElement('style');s.id='q519';s.textContent=css;document.head.appendChild(s);
/* strip the "👁 169" view counts from post meta lines */
const strip=()=>{document.querySelectorAll('#cnl .post .sm.mu').forEach(e=>{const n=e.firstChild;if(n&&n.nodeType===3&&/\s·\s👁\s*\d+/.test(n.nodeValue))n.nodeValue=n.nodeValue.replace(/\s·\s👁\s*\d+/,'')})};
const ph=document.getElementById('phone');
if(ph){new MutationObserver(strip).observe(ph,{childList:true,subtree:true});strip()}
document.title=document.title.replace(/v\d+/,'v519');
})()}catch(e){console.error('quiet-v519',e)}
</script>
<style id="q520">
/* v520: product lists. No divider lines, Toss-style spacing and type, Danggeun-style big photo. */
#phone :is(#mxl2,#jnl,#pnl,#cnl) .dg-r,#phone .e2-it{border-bottom:0!important;border-top:0!important}
/* Marketplace listings: big photo left, calm type, heart bottom-right */
#phone #mxl2 .dg-r{padding:20px 24px!important;gap:16px!important;align-items:flex-start!important}
#phone #mxl2 .dg-th{width:116px!important;height:116px!important;min-width:116px!important;border-radius:20px!important;background:var(--chip)!important}
#phone #mxl2 .dg-th svg{width:72px!important;height:72px!important}
#phone #mxl2 .dg-b{gap:0!important;min-height:116px;padding-right:34px!important}
#phone #mxl2 .dg-t{font-size:17px!important;line-height:24px!important;font-weight:600!important;letter-spacing:-.3px;-webkit-line-clamp:2}
#phone #mxl2 .dg-s{font-size:13px!important;line-height:18px!important;margin-top:4px!important;color:var(--tt)}
#phone #mxl2 .dg-p{font-size:18px!important;line-height:24px!important;font-weight:800!important;letter-spacing:-.4px;margin-top:auto!important;padding-top:8px}
#phone #mxl2 .dg-h{top:auto!important;bottom:18px!important;right:20px!important}
/* Food menu rows: same rhythm, no lines */
#phone .e2-it{padding:16px 24px!important;gap:16px!important}
#phone .e2-th{width:104px!important;height:104px!important;border-radius:20px!important}
#phone .e2-in{font-size:17px!important;line-height:24px!important;letter-spacing:-.3px}
#phone .e2-id{font-size:13px!important;line-height:18px!important;margin-top:4px!important}
#phone .e2-ip{font-size:17px!important;margin-top:10px!important}
</style>
<style id="q521">
/* v521: Marketplace, Jobs, Property and Community get the same quiet bar as Shop: one row (back, area, icons), one row of plain tabs, then the list. */
#phone .q21-bar{display:flex;align-items:center;gap:0;padding:10px 8px 0 8px}
#phone .q21-loc{flex:1;min-width:0;display:flex;align-items:center;gap:6px;height:46px;border:0;background:none;font:inherit;color:var(--tx);text-align:left;padding:0 6px}
#phone .q21-loc svg:first-child{color:var(--tintfg);flex:none}
#phone .q21-loc b{font-size:19px;font-weight:800;letter-spacing:-.4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#phone .q21-loc svg:last-child{flex:none;color:var(--mu)}
#phone .q21-bar .ib{width:42px;flex:none}
#phone .q21-qrow{display:none;padding:6px 16px 0}
#phone .q21-qrow.open{display:block}
#phone .q21-qrow input{width:100%;height:46px;border-radius:14px;border:0;background:var(--chip);color:var(--tx);font:inherit;font-size:15px;padding:0 16px;box-sizing:border-box;margin:0}
/* the old search row, location row and count/sort/filter row are gone from view (kept in the page so sort and filter still work) */
#phone :is(#mxbr,#jnbr,#pnb,#cnb),#phone #pnk,#phone .cn-c{display:none!important}
/* tabs: exactly Shop's tabs */
#phone :is(#mxcc,#jncc,#pnc,#cnc).chips{display:flex;gap:4px;padding:12px 16px 0!important;overflow-x:auto;scrollbar-width:none;border-bottom:0}
#phone :is(#mxcc,#jncc,#pnc,#cnc).chips::-webkit-scrollbar{display:none}
#phone :is(#mxcc,#jncc,#pnc,#cnc).chips .cch{flex:none;height:44px!important;padding:0 16px!important;border-radius:14px!important;border:0!important;font-size:17px!important;font-weight:600!important;background:none!important;color:var(--mu)!important}
#phone :is(#mxcc,#jncc,#pnc,#cnc).chips .cch.on{font-weight:800!important;background:var(--chip)!important;color:var(--tx)!important}
#phone :is(#mxcc,#jncc,#pnc,#cnc).chips .cch.on::after{content:none!important;display:none!important}
/* personal tabs live behind the person icon, like My shopping in Shop (the chosen one still shows) */
#phone :is(#mxcc,#jncc,#pnc,#cnc) .cch:is([onclick*="'Saved'"],[onclick*="'Mine'"],[onclick*="'Applied'"],[onclick*="'Shifts'"],[onclick*="'Following'"],[onclick*="jbProf"],[onclick*="pCmpOpen"],[onclick*="pVws"]):not(.on){display:none!important}
/* rows: one line of place info so every row is the same height */
#phone :is(#mxl2,#jnl,#pnl) .dg-s{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#phone #pnl .jn-sh{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-size:13px}
#phone #mxl2 .dg-b{padding-right:0!important}
/* the main action: one small pill at the right, same on all four */
#phone .fab{justify-content:flex-end!important;padding-right:20px!important}
#phone .fab .btn{height:46px!important;padding:0 20px!important;font-size:15px!important;border-radius:23px!important;width:auto!important}
/* community posts: quieter */
#phone #cnl .post{padding:18px 24px!important}
#phone #cnl .post .act{gap:22px}
#phone #cnl .post :is([aria-label="More"],[aria-label="Options"]){color:var(--tt)!important}
/* the two small sheets */
#phone .q21-row{display:flex;align-items:center;gap:12px;padding:16px 4px;font-size:17px;font-weight:600;cursor:pointer;min-height:56px}
#phone .q21-row span:first-child{flex:1}
#phone .q21-row.on{font-weight:800}
#phone .q21-row.on span:last-child{color:var(--lk)}
</style>
<script>
/* v521: Marketplace, Jobs, Property and Community use the same quiet bar as Shop. Before: after v518 to v520 these four still stacked four rows above the first listing (area name with a small line above it, a search field, a row of tabs with up to 14 pills, then a count + Map + Sort + Alert + Filter row), and the Property and Jobs lists still carried a wide centred button and rows that wrapped to two or three lines. Now: row 1 is the bar (back, your area, then three icons: search, sort and filter, my things), row 2 is plain text tabs with the chosen one in a soft chip, exactly as in Shop, then the list. Search opens as a field under the bar when you tap the magnifier. The sort, map, alert and filter buttons are in one sheet behind the sliders icon; Saved, Mine, Applied, Shifts, Following, Profile, Compare and Viewings are in one sheet behind the person icon (the tab you are on still shows). Community's ask box is a small Ask button at the bottom right, like Sell, Post a job and List a home, which are now the same small size. Rows keep one line of place info. English only; rw/fr need native review. Nothing is removed from the code. */
try{(function(){
if(window.__q521)return;window.__q521=1;
const I=(p,s)=>`<svg width="${s||24}" height="${s||24}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${p}</svg>`;
const PIN=I('<path d="M12 21s-7-6.2-7-11a7 7 0 0114 0c0 4.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/>',22);
const DOWN=I('<path d="M6 9l6 6 6-6"/>',18);
const SRCH=I('<path d="M11 4a7 7 0 100 14 7 7 0 000-14zM21 21l-5-5"/>',24);
const TUNE=I('<path d="M4 7h10M18 7h2M4 17h2M10 17h10"/><circle cx="16" cy="7" r="2"/><circle cx="8" cy="17" r="2"/>',24);
const USER=I('<path d="M12 12a3 3 0 100-6 3 3 0 000 6zM6 20c0-3 3-5 6-5s6 2 6 5"/>',24);
const CHEV=I('<path d="M9 5l7 7-7 7"/>',16);
const TABS='#mxcc,#jncc,#pnc,#cnc',TOOLS='#mxbr,#jnbr,#pnb,#cnb';
const MINE=/'(Saved|Mine|Applied|Shifts|Following)'|jbProf|pCmpOpen|pVws/;
const fix=h=>{
 if(typeof h!=='string'||h.indexOf('lc-top')<0)return h;
 const t=document.createElement('template');t.innerHTML=h;const f=t.content;
 const top=f.querySelector('.lc-top');if(!top||top.querySelector('.q21-bar'))return h;
 const back=top.querySelector('.ib'),loc=top.querySelector('.lc-adb'),qw=f.querySelector('.dg-q');
 if(!back||!loc||!qw)return h;
 const fn=(loc.getAttribute('onclick')||'').replace(/"/g,'&quot;'),name=(loc.querySelector('b')||{}).textContent||'';
 const inp=qw.querySelector('input'),has=inp&&inp.getAttribute('value');
 const bar=document.createElement('div');
 bar.innerHTML=`<div class="q21-bar">${back.outerHTML}<button class="q21-loc" onclick="${fn}" aria-label="Change neighbourhood, now ${name.trim()}">${PIN}<b>${name.trim()}</b>${DOWN}</button><button class="ib" aria-label="Search" onclick="q21S()">${SRCH}</button><button class="ib" aria-label="Sort and filter" onclick="q21T()">${TUNE}</button><button class="ib" aria-label="My things" onclick="q21M()">${USER}</button></div>`;
 top.innerHTML='';top.appendChild(bar.firstChild);
 qw.className='q21-qrow'+(has?' open':'');qw.removeAttribute('style');top.appendChild(qw);
 const cn=f.querySelector('.cn-c');
 if(cn&&!f.querySelector('.fab')){const d=document.createElement('div');d.className='fab';d.innerHTML='<button class="btn" onclick="postSheet()">+ Ask</button>';f.appendChild(d)}
 return t.innerHTML};
['hood','community'].forEach(k=>{const o=screens[k];if(typeof o!=='function')return;screens[k]=function(){return fix(o.apply(this,arguments))}});
const lay=()=>document.getElementById('layer');
const sheet=(title,rows)=>{
 lay().innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="h1" style="font-size:22px;line-height:30px;margin-bottom:6px">${title}</div>${rows.map((r,i)=>`<div class="q21-row tap${r.on?' on':''}" role="button" tabindex="0" data-q21="${i}"><span>${r.l}</span><span>${r.on?'✓':CHEV}</span></div>`).join('')}</div>`;
 lay().querySelectorAll('[data-q21]').forEach(e=>e.addEventListener('click',()=>{const r=rows[+e.dataset.q21];lay().innerHTML='';try{new Function(r.c)()}catch(x){console.error('q21',x)}}))};
const clean=s=>s.replace(/^[^\p{L}\p{N}]+/u,'').replace(/[⇅]/g,'').trim();
window.q21S=()=>{const r=document.querySelector('#phone .q21-qrow');if(!r)return;r.classList.toggle('open');const i=r.querySelector('input');if(r.classList.contains('open')&&i)i.focus()};
window.q21T=()=>{const tb=document.querySelector(TOOLS);if(!tb)return;
 const rows=[...tb.querySelectorAll('button')].map(b=>{const c=b.getAttribute('onclick')||'',x=(b.textContent||'').trim();
  const sort=/sort/i.test(c);return{l:sort?'Sort · '+clean(x):/map/i.test(c)?'Map':/Al(ert)?\b|jn13Al/.test(c)?'Job alerts':clean(x)||x,c}}).filter(r=>r.c);
 sheet('Sort and filter',rows)};
window.q21M=()=>{const tb=document.querySelector(TABS);if(!tb)return;
 const rows=[...tb.querySelectorAll('button')].filter(b=>MINE.test(b.getAttribute('onclick')||'')).map(b=>{const c=b.getAttribute('onclick')||'';
  return{l:/jbProf/.test(c)?'My job profile':/pCmpOpen/.test(c)?'Compare homes':/pVws/.test(c)?'My viewings':clean(b.textContent||'')||'Mine',c,on:b.classList.contains('on')}});
 if(!rows.length)return;sheet('My things',rows)};
document.title=document.title.replace(/v\d+/,'v521');
})()}catch(e){console.error('quiet-v521',e)}
</script>
<script>try{document.title=document.title.replace(/v\d+/,'v521')}catch(e){}</script>
<style id="v522">/* v522: Marketplace, Jobs, Property borrow Shop's card language: large rounded image tiles, heart on the tile, accent pricing, full-bleed detail hero */
#phone #mxl2{display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px 14px;padding:8px 24px 120px!important}
#phone #mxl2>*:not(.dg-r){grid-column:1/-1;padding-left:0!important;padding-right:0!important}
#phone #mxl2 .dg-r{display:block!important;padding:0!important;border:0!important;min-width:0}
#phone #mxl2 .dg-th{width:100%!important;height:auto!important;min-width:0!important;aspect-ratio:1/1;border-radius:20px!important;background:var(--chip)!important}
#phone #mxl2 .dg-th svg{width:64px;height:64px}
#phone #mxl2 .dg-b{padding:0!important;min-height:0!important;margin-top:10px;gap:0!important}
#phone #mxl2 .dg-t{font-size:14px!important;line-height:19px!important;font-weight:600!important;letter-spacing:0!important}
#phone #mxl2 .dg-s{font-size:12px!important;line-height:16px!important;white-space:normal}
#phone #mxl2 .dg-p{font-size:16px!important;font-weight:700!important;margin-top:6px!important;padding-top:0!important}
#phone #mxl2 .dg-m{display:flex!important;justify-content:flex-start;margin-top:6px}
#phone #mxl2 .dg-m span:not(.mk-sp){display:none}
#phone #mxl2 .dg-m .mk-sp{font-size:11px;font-weight:800;padding:3px 8px;border-radius:10px;background:var(--tint);color:var(--tintfg)}
#phone #mxl2 .dg-h,#phone #pnl .dg-h{top:6px!important;right:6px!important;bottom:auto!important}
#phone #pnl{padding:8px 24px 120px}
#phone #pnl .dg-r{display:block!important;padding:0 0 26px!important;border:0!important}
#phone #pnl .dg-th{width:100%!important;height:auto!important;min-width:0!important;aspect-ratio:16/10;border-radius:24px!important;background:var(--chip)!important}
#phone #pnl .dg-th svg{width:84px;height:84px}
#phone #pnl .dg-b{padding:0!important;min-height:0!important;margin-top:12px;gap:0!important}
#phone #pnl .dg-t{font-size:18px!important;line-height:24px!important;font-weight:700!important}
#phone #pnl .dg-p{font-size:20px!important;font-weight:800!important;margin-top:4px!important;padding-top:0!important}
#phone #pnl .dg-h{top:10px!important;right:10px!important;background:color-mix(in srgb,var(--bg) 80%,transparent);border-radius:18px}
#phone #jnl{padding:8px 0 120px}
#phone #jnl .dg-r{background:var(--chip);border-radius:24px;margin:0 24px 12px;padding:14px 16px!important;border:0!important}
#phone #jnl .dg-th{background:var(--bg)!important}
#phone #jnl .dg-p{color:var(--lk);font-weight:800!important}
#phone .pim[style*="height:230px"],#phone .pim[style*="height:200px"]{height:260px!important;margin:-12px -24px 0!important;width:calc(100% + 48px)!important;border-radius:0 0 32px 32px!important;background:color-mix(in srgb,var(--lk) 9%,var(--bg))!important}
#phone .pim[style*="height:230px"] svg,#phone .pim[style*="height:200px"] svg{width:120px;height:120px}
</style>
<script>try{(function(){var ph=document.getElementById('phone');if(!ph)return;var run=function(){ph.querySelectorAll('.dg-p').forEach(function(e){if(/^\s*Free\b/i.test(e.textContent))e.style.color='var(--ok)'})};new MutationObserver(run).observe(ph,{childList:true,subtree:true});run();document.title=document.title.replace(/v\d+/,'v522')})()}catch(e){console.error('v522',e)}</script>
<style id="v523">/* v523: Jobs list borrows Shop's card language, but the picture sits on the RIGHT and the details on the LEFT. Flat rows (no grey card), one hairline between jobs, big rounded picture tile, accent pay, heart on the tile, up to three small tags. */
#phone #jnl{padding:4px 0 120px}
#phone #jnl .dg-r.dg-r{display:flex!important;flex-direction:row;align-items:flex-start;gap:16px;background:none;margin:0 24px;padding:18px 0!important;border:0!important;border-bottom:1px solid var(--chip)!important;border-radius:0}
#phone #jnl .dg-b.dg-b{order:1;flex:1;min-width:0;padding:0!important;margin:0;gap:0!important;min-height:136px}
#phone #jnl .dg-th.dg-th{order:2;width:136px!important;height:136px!important;min-width:136px!important;border-radius:22px!important;flex:none;background:var(--chip)!important}
#phone #jnl .dg-th.dg-th svg{width:72px!important;height:72px!important}
#phone #jnl .dg-t{font-size:17px!important;line-height:23px!important;font-weight:700!important;-webkit-line-clamp:2}
#phone #jnl .dg-s{font-size:13px!important;line-height:18px!important;margin-top:3px!important;color:var(--tt);white-space:normal!important;overflow:visible!important;text-overflow:clip!important}
#phone #jnl .dg-p{font-size:18px!important;line-height:24px;font-weight:800!important;color:var(--tx)!important;margin-top:8px!important;padding-top:0!important;flex-wrap:wrap}
#phone #jnl .dg-p .dg-st{font-size:11px;order:2}
#phone #jnl .jn-sh{display:none!important}
#phone #jnl .jn-sh.jn-sh:has(+ .jn-m){display:block!important;font-size:13px;line-height:18px;margin-top:3px}
#phone #jnl .jn-m.jn-m.jn-m.jn-m{display:flex!important;gap:6px;margin-top:8px;padding-top:0}
#phone #jnl .jn-m .jn-t.jn-t.jn-t{display:inline-block!important;font-size:11px;font-weight:800;padding:3px 9px;border-radius:10px;white-space:nowrap}
#phone #jnl .jn-m .jn-t.jn-t.jn-t.jn-t:nth-child(n+3){display:none!important}
#phone #jnl .jn-m .jn-t.hi{height:auto!important;min-height:0!important;width:auto!important;min-width:0!important;line-height:16px;margin:0!important;position:static!important;background:var(--tint)}
#phone #jnl .jn-m .jn-p{display:none!important}
#phone #jnl .dg-h.dg-h{right:8px!important;left:auto!important;top:26px!important;bottom:auto;order:3;z-index:1;background:color-mix(in srgb,var(--bg) 82%,transparent);border-radius:18px}
#phone #jnl .dg-th[data-jh]{background:color-mix(in srgb,hsl(var(--jh) 62% 52%) 17%,var(--bg))!important}
#phone #jnl .dg-r:active .dg-th{transform:scale(.98)}
</style>
<script>try{(function(){var ph=document.getElementById('phone');if(!ph)return;var H=[158,28,262,200,340,48];var run=function(){ph.querySelectorAll('#jnl .dg-r').forEach(function(r){var t=r.querySelector('.dg-th');if(!t||t.dataset.jh)return;var m=/hdOpen\('jobs',(\d+)\)/.exec(r.getAttribute('onclick')||'');if(!m)return;t.dataset.jh=1;t.style.setProperty('--jh',H[(+m[1])%H.length])})};new MutationObserver(run).observe(ph,{childList:true,subtree:true});run();document.title=document.title.replace(/v\d+/,'v523')})()}catch(e){console.error('v523',e)}</script>
<style id="v523m">/* v523: Marketplace list, picture on the LEFT, details on the RIGHT */
#phone #mxl2{display:block!important;padding:4px 0 120px!important}
#phone #mxl2>*:not(.dg-r){padding-left:24px!important;padding-right:24px!important}
#phone #mxl2 .dg-r.dg-r{display:flex!important;flex-direction:row;align-items:flex-start;gap:16px;margin:0 24px;padding:18px 0!important;border:0!important;border-bottom:1px solid var(--chip)!important;border-radius:0;background:none}
#phone #mxl2 .dg-th.dg-th{order:1;width:136px!important;height:136px!important;min-width:136px!important;aspect-ratio:auto;border-radius:22px!important;flex:none;background:var(--chip)!important}
#phone #mxl2 .dg-th.dg-th svg{width:72px!important;height:72px!important}
#phone #mxl2 .dg-b.dg-b{order:2;flex:1;min-width:0;padding:0!important;margin:0;gap:0!important;min-height:136px}
#phone #mxl2 .dg-t{font-size:17px!important;line-height:23px!important;font-weight:700!important}
#phone #mxl2 .dg-s{font-size:13px!important;line-height:18px!important;margin-top:3px!important;white-space:normal}
#phone #mxl2 .dg-p{font-size:18px!important;line-height:24px;font-weight:800!important;color:var(--tx)!important;margin-top:8px!important;padding-top:0!important}
#phone #mxl2 .dg-m.dg-m{display:flex!important;justify-content:flex-start;margin-top:8px}
#phone #mxl2 .dg-h.dg-h{left:8px!important;right:auto!important;top:26px!important;bottom:auto!important;z-index:1;background:color-mix(in srgb,var(--bg) 82%,transparent);border-radius:18px}
</style>
<style id="v523p">/* v523: Property list, picture on the LEFT, details on the RIGHT */
#phone #pnl{padding:4px 0 120px!important}
#phone #pnl .dg-r.dg-r{display:flex!important;flex-direction:row;align-items:flex-start;gap:16px;margin:0 24px;padding:18px 0!important;border:0!important;border-bottom:1px solid var(--chip)!important;border-radius:0;background:none}
#phone #pnl .dg-th.dg-th{order:1;width:136px!important;height:136px!important;min-width:136px!important;aspect-ratio:auto;border-radius:22px!important;flex:none;background:var(--chip)!important}
#phone #pnl .dg-th.dg-th svg{width:72px!important;height:72px!important}
#phone #pnl .dg-b.dg-b{order:2;flex:1;min-width:0;padding:0!important;margin:0;gap:0!important;min-height:136px}
#phone #pnl .dg-t{font-size:17px!important;line-height:23px!important;font-weight:700!important}
#phone #pnl .dg-s{font-size:13px!important;line-height:18px!important;margin-top:3px!important;white-space:normal!important}
#phone #pnl .dg-p{font-size:18px!important;line-height:24px;font-weight:800!important;color:var(--tx)!important;margin-top:8px!important;padding-top:0!important}
#phone #pnl .dg-h.dg-h{left:8px!important;right:auto!important;top:26px!important;bottom:auto!important;z-index:1;background:color-mix(in srgb,var(--bg) 82%,transparent);border-radius:18px}
</style>
<style id="v524">/* v524: Chat for neighbourhood services */
#phone .c24-tg{display:inline-block;margin-left:6px;font-size:11px;font-weight:800;line-height:16px;padding:0 7px;border-radius:8px;background:var(--chip);color:var(--mu);vertical-align:1px}
#phone .c24-tm{margin-left:6px;font-size:12px;font-weight:800}
#phone .c24-th{flex:0 0 44px;width:44px;height:44px;border-radius:12px;background:var(--chip);display:flex;align-items:center;justify-content:center}
#phone .c24-ctx{display:flex;align-items:center;gap:12px;margin:8px 24px 0;padding:12px;border-radius:18px;background:var(--chip);cursor:pointer}
#phone .c24-ctx .c24-th{background:var(--bg)}
#phone .c24-ctx b{display:block;font-size:15px;line-height:20px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
#phone .c24-ctx .c24-pr{font-size:14px;font-weight:800;margin-top:2px}
#phone .c24-st{margin-left:auto;flex:none;font-size:11px;font-weight:800;padding:3px 9px;border-radius:10px;background:var(--tint);color:var(--tintfg)}
#phone .c24-st.sold{background:var(--ln);color:var(--mu)}
#phone .c24-safe{display:flex;gap:10px;align-items:flex-start;margin:10px 24px 0;font-size:13px;line-height:19px;color:var(--mu)}
#phone .c24-safe button{border:0;background:none;color:var(--lk);font-weight:700;font-size:13px;padding:0;flex:none;min-height:44px;margin:-12px 0}
#phone .c24-qk{flex:0 0 100%;display:flex;gap:8px;overflow-x:auto;scrollbar-width:none;padding-bottom:2px}
#phone .c24-qk .cch{flex:none;white-space:nowrap}
#phone .c24-l{display:block;font-size:12px;font-weight:800;opacity:.75;margin-bottom:2px}
</style>
<script>try{(function(){
if(window.__c24)return;window.__c24=1;
const esc=s=>String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/"/g,'&quot;');
const sh=h=>{$('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" role="dialog" aria-modal="true">'+h+'</div>'};
const hs=n=>{let h=0;String(n).split('').forEach(c=>h=(h*31+c.charCodeAt(0))>>>0);return h};
const tmp=w=>Math.max(30,Math.min(99,36.5+(hs(w)%80)/10+((S.mxMt||{})[w]||0)+((((S.jn17||{}).mt)||{})[w]||0)));
const col=t=>t<37.5?'#4C8DF6':t<40?'#2E9E5B':'#F08A24';
const NAME={market:'Market',jobs:'Jobs',property:'Homes',comm:'Neighbours'};
const TABS=[['all','All'],['market','Market'],['jobs','Jobs'],['property','Homes'],['comm','Neighbours']];
S.c24t=S.c24t||'all';S.c24s=S.c24s||{};
const svc=id=>{const m=/^hd(market|jobs|property)(\d+)$/.exec(id||'');if(m)return{k:m[1],i:+m[2],p:1};if(/^cm/.test(id||''))return{k:'comm',p:1};if(/^cn[gs]/.test(id||''))return{k:'comm'};return null};
const itm=s=>s&&s.i!=null&&HD[s.k]?HD[s.k].items.find(x=>x.id===s.i):null;
const price=x=>typeof x.p==='number'?(x.p?fmt(x.p)+' RWF':'Free'):esc(x.p||'');
const tpl=h=>{const t=document.createElement('template');t.innerHTML=h;return t};
const idOf=r=>{const m=/cvOpen\('([^']+)'\)/.exec(r.getAttribute('onclick')||'');return m&&m[1]};

/* inbox: service tabs, a tag and manner temperature by the name, listing picture on the right */
const _m=screens.messages;
screens.messages=function(){const h=_m.apply(this,arguments);const t=tpl(h),f=t.content,ch=f.querySelector('.mm-chips');if(!ch)return h;
 const tabs=document.createElement('div');tabs.className='mm-chips c24-tabs';tabs.setAttribute('role','group');tabs.setAttribute('aria-label','Service');
 tabs.innerHTML=TABS.map(([k,n])=>`<button class="cch ${S.c24t===k?'on':''}" aria-pressed="${S.c24t===k}" onclick="c24T('${k}')">${n}</button>`).join('');ch.after(tabs);
 let kept=0;f.querySelectorAll('.mm-row').forEach(r=>{const id=idOf(r),s=svc(id);
  if(S.c24t!=='all'&&(!s||s.k!==S.c24t)){r.remove();return}kept++;if(!s)return;
  const b=r.querySelector('b'),x=itm(s);if(!b)return;
  let a=`<span class="c24-tg">${NAME[s.k]}</span>`;if(s.p){const v=tmp(b.textContent.trim());a+=`<span class="c24-tm" style="color:${col(v)}">${v.toFixed(1)}°C</span>`}
  b.insertAdjacentHTML('beforeend',a);
  });
 if(!kept&&S.c24t!=='all'){const e=document.createElement('div');e.className='mu';e.style.cssText='padding:48px 32px;text-align:center;line-height:22px';e.textContent='No '+NAME[S.c24t]+' chats yet. Message a neighbour from a listing to start one.';const hostRow=f.querySelector('.c24-tabs');hostRow.after(e)}
 return t.innerHTML};
window.c24T=k=>{S.c24t=k;render('fade-none')};

/* chat: who, what it is about, how to stay safe, and one-tap questions */
const SAFE={market:'Meet in a public place and pay with itunda Pay. Never send money to someone you have not met.',jobs:'Never pay to get a job. Your pay comes through itunda after the shift.',property:'See the home before you pay any deposit, and pay only through itunda.'};
const Q={
 market:[['avail','Still available?'],['lower','Can you go lower?']],
 jobs:[['profile','Send my profile'],['shift','Ask about the shift'],['sameday','Same-day pay?']],
 property:[['avail','Still available?'],['view','Request a viewing'],['deposit','Ask about deposit'],['extra','Extra costs?']],
 comm:[['hello','Hello'],['where','Where exactly?'],['thanks','Thank you']]};
const TX={avail:'Hi, is this still available?',lower:'Could you go a little lower on the price?',profile:'Hi, I would like to apply. Here is my itunda profile.',shift:'What are the hours, and where do I check in?',sameday:'Is the pay the same day?',view:'Could I view it on Saturday morning?',deposit:'How much is the deposit?',extra:'Are water and power included in the rent?',hello:'Hello!',where:'Where exactly is it?',thanks:'Thank you!'};
const RP={avail:'Yes, it is still available.',lower:'I can do a little lower if you can pick it up today.',profile:'Got it, thank you. I will look at it today.',shift:'Shifts start at 08:00. Check in at the site and I will confirm.',sameday:'Yes, pay lands in itunda the same day.',view:'Saturday at 10:00 works. I will send the exact place.',deposit:'One month of rent, paid through itunda.',extra:'Water and power are extra, about 15,000 RWF a month.',hello:'Welcome!',where:'Near the main road. I will send a pin.',thanks:'You are welcome.'};
const LBL=[[/^Can we meet at /,'Meet-up'],[/^Would you take /,'Offer'],[/^I paid safely/,'Paid with itunda Pay'],[/^Got it, thank you! Payment released/,'Deal done']];
const _c=screens.chat;
screens.chat=function(){const h=_c.apply(this,arguments),id=S.chat,s=svc(id);if(!s)return h;
 const t=tpl(h),f=t.content,x=itm(s),bar=f.querySelector('.bar b'),sub=f.querySelector('#mmsub'),cta=f.querySelector('.cta');
 if(bar&&s.p){const v=tmp(bar.textContent.trim());bar.insertAdjacentHTML('beforeend',`<span class="c24-tm" style="color:${col(v)}" aria-label="Manner temperature ${v.toFixed(1)} degrees">${v.toFixed(1)}°C</span>`)}
 let top='';
 if(x){const sold=x.st==='sold',st=s.k==='market'?(sold?'Sold':x.st==='reserved'?'Reserved':'Available'):s.k==='jobs'?((S.hdApplied||{})[x.id]?'Applied':'Open'):'';
  top+=`<div class="c24-ctx" role="button" tabindex="0" aria-label="Open ${esc(x.ti)}" onclick="hdOpen('${s.k}',${x.id})"><span class="c24-th">${gl(x.g||'market',26)}</span><div style="min-width:0"><b>${esc(x.ti)}</b><div class="c24-pr">${price(x)}</div></div>${st?`<span class="c24-st${sold?' sold':''}">${st}</span>`:''}</div>`}
 if(SAFE[s.k]&&!S.c24s[s.k])top+=`<div class="c24-safe"><span>${SAFE[s.k]}</span><button onclick="c24X('${s.k}')">Got it</button></div>`;
 if(top&&sub)sub.insertAdjacentHTML('afterend',top);
 if(cta){let q=(Q[s.k]||[]).map(([k,n])=>`<button class="cch" onclick="c24Say('${k}')">${n}</button>`);
  if(s.k==='market'&&x){if(x.who==='You')q=[['reserved','Mark as reserved'],['sold','Mark as sold'],['','Available again']].map(([v,n])=>`<button class="cch" onclick="c24St(${x.id},'${v}')">${n}</button>`);
   else{if(x.p&&!x.st)q.push(`<button class="cch" onclick="mkOffer(${x.id})">Make an offer</button>`);q.push(`<button class="cch" onclick="mkMeet(${x.id})">Set a meet-up</button>`);if(x.p&&!x.st)q.push(`<button class="cch" onclick="mkPay(${x.id})">Pay safely</button>`)}}
  cta.insertAdjacentHTML('afterbegin',`<div class="c24-qk" role="group" aria-label="Quick messages">${q.join('')}</div>`);
  cta.insertAdjacentHTML('beforebegin','<div style="height:52px" aria-hidden="true"></div>')}
 f.querySelectorAll('.mm-b').forEach(b=>{const tx=b.textContent.trim(),m=LBL.find(l=>l[0].test(tx));if(m)b.insertAdjacentHTML('afterbegin',`<span class="c24-l">${m[1]}</span>`)});
 return t.innerHTML};
window.c24X=k=>{S.c24s[k]=1;render('fade-none')};
window.c24St=(i,v)=>{const x=HD.market.items.find(y=>y.id===i);if(!x)return;x.st=v;toast(v==='sold'?'Marked as sold':v==='reserved'?'Marked as reserved':'Available again');render('fade-none')};
window.c24Say=k=>{const id=S.chat,ms=S.msgs[id]=S.msgs[id]||[],x=['me',TX[k]];x.ts=Date.now();ms.push(x);S.read[id]=1;
 const i=THREADS.findIndex(y=>y.id===id);if(i>0)THREADS.unshift(THREADS.splice(i,1)[0]);render('fade-none');chatEnd();
 setTimeout(()=>{const y=['them',RP[k]||'Okay'];y.ts=Date.now();(S.msgs[id]=S.msgs[id]||[]).push(y);if(S.chat===id&&S.stack[S.stack.length-1]==='chat'){render('fade-none');chatEnd()}},1300)};

/* options: report and block for neighbourhood chats */
const _cs=window.cvSheet;
window.cvSheet=function(id){_cs.apply(this,arguments);if(!svc(id))return;const w=document.querySelector('#layer .sheet>div:last-child');
 if(w)w.insertAdjacentHTML('beforeend',`<button class="mm-act" onclick="c24Rep()">Report</button><button class="mm-act" style="color:var(--er)" onclick="c24Blk('${id}')">Block and archive</button>`)};
window.c24Rep=()=>sh(`<div class="h1" style="font-size:22px;line-height:30px">Report</div><div style="margin-top:12px">${['Did not show up','Rude or unsafe','Asked me to pay outside itunda','Scam or fake listing'].map(r=>`<button class="mm-act" onclick="c24RepGo()">${r}</button>`).join('')}</div>`);
window.c24RepGo=()=>{closeSheet();toast('Reported. We will review it within a day')};
window.c24Blk=id=>{S.mm.arch[id]=true;closeSheet();S.stack=[];S.tab='messages';render('fade-none');toast('Blocked and archived')};
document.title=document.title.replace(/v\d+/,'v524');
})()}catch(e){console.error('chat-v524',e)}</script>
<style id="v525">/* v525: Talk inbox, Daangn-style. One tab row, listing picture + small avatar, area and time beside the name */
#phone .t25-a{position:relative;width:52px;height:52px;flex:0 0 52px}
#phone .t25-th{width:52px;height:52px;border-radius:14px;background:var(--chip);display:flex;align-items:center;justify-content:center}
#phone .t25-av{position:absolute;right:-6px;bottom:-6px;width:26px;height:26px;border-radius:13px;background:var(--ln);border:2px solid var(--bg);display:flex;align-items:center;justify-content:center;color:var(--mu)}
#phone .t25-top{display:flex;align-items:center;gap:6px;min-width:0}
#phone .t25-top b{flex:0 1 auto;min-width:0;max-width:60%;font-size:16px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
#phone .t25-m{flex:1 1 0;min-width:0;font-size:13px;color:var(--mu);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
#phone .t25-ic{display:flex;align-items:center;gap:6px;flex:none}
#phone .t25-dim{opacity:.5}
#phone .t25-dot{display:inline-block;width:6px;height:6px;border-radius:3px;background:var(--br);margin-left:6px;vertical-align:3px}
</style>
<script>try{(function(){
if(window.__t25)return;window.__t25=1;
const esc=s=>String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/"/g,'&quot;');
const svc=id=>{const m=/^hd(market|jobs|property)(\d+)$/.exec(id||'');if(m)return{k:m[1],i:+m[2]};if(/^cm/.test(id||''))return{k:'comm'};return null};
const itm=s=>s&&s.i!=null&&HD[s.k]?HD[s.k].items.find(x=>x.id===s.i):null;
const idOf=r=>{const m=/cvOpen\('([^']+)'\)/.exec(r.getAttribute('onclick')||'');return m&&m[1]};
const unr=t=>S.read[t.id]?0:(t.u||0);
const TB=[['all','All'],['market','Market'],['jobs','Jobs'],['property','Homes'],['comm','Neighbours']];
/* a few starter chats so every tab has something to open */
S.msgs=S.msgs||{};
[['market',4,8,1,[['me','Hi, is "Bicycle, 26 inch" still available?',11],['them','Yes, still available. Can you come on Saturday?',8]]],
 ['jobs',1,60,1,[['me','Hello, I would like to apply.',90],['them','Thanks for applying. Can you start tomorrow at 08:00?',60]]],
 ['property',1,1440,0,[['me','Hello, is this home still available?',1500],['them','Yes. You can view it on Saturday morning.',1440]]]].reverse().forEach(([k,i,age,u,ms])=>{
 const x=HD[k]&&HD[k].items.find(y=>y.id===i),id='hd'+k+i;if(!x||THREADS.find(t=>t.id===id))return;
 THREADS.unshift({id,n:x.who,g:'community',t:age<60?age+' min':age<1440?Math.round(age/60)+' h':'Yesterday',u,sub:x.ti,m:[]});
 S.msgs[id]=ms.map(([w,tx,a])=>{const y=[w,tx];y.ts=Date.now()-a*60000;return y})});
const _m=screens.messages;
screens.messages=function(){const h=_m.apply(this,arguments),t=document.createElement('template');t.innerHTML=h;const f=t.content,M=S.mm||{};
 const chs=f.querySelectorAll('.mm-chips');if(!chs.length)return h;
 const cnt={};THREADS.forEach(x=>{if(M.arch&&M.arch[x.id]||!unr(x))return;const s=svc(x.id),k=s?s.k:'other';cnt[k]=1;cnt.all=1});
 const nA=THREADS.filter(x=>M.arch&&M.arch[x.id]).length,nU=THREADS.filter(x=>!(M.arch&&M.arch[x.id])&&unr(x)).length;
 const on=M.f==='unr'||M.f==='arch'?M.f:(S.c24t||'all');
 const T=TB.concat([['unr','Unread'+(nU?' · '+nU:'')]],nA?[['arch','Archived · '+nA]]:[]);
 let tabs=f.querySelector('.c24-tabs')||chs[0];
 tabs.className='mm-chips c24-tabs';tabs.innerHTML=T.map(([k,n])=>`<button class="cch ${on===k?'on':''}" aria-pressed="${on===k}" onclick="t25T('${k}')">${n}${cnt[k]&&k!=='all'&&k!=='unr'&&k!=='arch'?'<span class="t25-dot" aria-hidden="true"></span>':''}</button>`).join('');
 chs.forEach(c=>{if(c!==tabs)c.remove()});
 f.querySelectorAll('.mm-row').forEach(r=>{const id=idOf(r),s=svc(id),x=itm(s),th=THREADS.find(y=>y.id===id);if(!th)return;
  const nm=th.n,right=r.querySelector('div[style*="space-between"]>span'),ic=right?right.cloneNode(true):null;
  if(ic){const tm=ic.querySelector('.sm.mu');if(tm)tm.remove()}
  const area=x&&x.sub?String(x.sub).split(' · ')[0]:(s&&s.k==='comm'&&/·/.test(th.sub||'')?String(th.sub).split(' · ')[1]:'');
  const meta=(area?area+' · ':'')+th.t;
  const old=r.querySelector('.ico');
  if(old&&s){const a=document.createElement('div');a.className='t25-a';a.innerHTML=`<div class="t25-th">${gl((x&&x.g)||'community',34)}</div><span class="t25-av">${ic_('user',14)}</span>`;old.replaceWith(a)}
  const top=r.querySelector('div[style*="space-between"]');
  if(top){top.className='t25-top';top.removeAttribute('style');top.innerHTML=`<b>${esc(nm)}</b><span class="t25-m">${esc(meta)}</span><span class="t25-ic">${ic?ic.innerHTML:''}</span>`}
  if(s&&s.k==='market'&&x&&x.st==='sold'){r.classList.add('t25-dim');const p=r.querySelector('.sm');if(p)p.textContent='Sold · '+p.textContent}});
 return t.innerHTML};
const ic_=(n,s)=>typeof ic==='function'?ic(n,s):'';
window.t25T=k=>{const M=S.mm;if(k==='unr'||k==='arch'){M.f=k;S.c24t='all'}else{M.f='all';S.c24t=k}render('fade-none')};
document.title=document.title.replace(/v\d+/,'v525');
})()}catch(e){console.error('talk-v525',e)}</script>
<style id="v526">/* v526: Talk chat room, Daangn-style. Status in the title, action chips, avatar + time beside bubbles, scroll-down button */
#phone .c24-ctx{background:none;margin:6px 24px 0;padding:8px 0}
#phone .c24-ctx .c24-th{flex:0 0 52px;width:52px;height:52px;border-radius:12px;background:var(--chip)}
#phone .c24-ctx b{white-space:normal;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;font-weight:500}
#phone .c24-ctx b .t26-s{font-weight:800}
#phone .t26-act{display:flex;gap:8px;overflow-x:auto;scrollbar-width:none;padding:6px 24px 14px;border-bottom:1px solid var(--chip)}
#phone .t26-act button{flex:none;display:flex;align-items:center;gap:6px;min-height:44px;padding:0 16px;border-radius:14px;border:1px solid var(--ln);background:none;color:var(--tx);font:inherit;font-size:15px;font-weight:700;white-space:nowrap}
#phone .t26-pay{display:flex;align-items:center;justify-content:space-between;width:100%;min-height:48px;padding:0 24px;border:0;background:var(--tint);color:var(--tintfg);font:inherit;font-size:15px;font-weight:700;text-align:left}
#phone .c24-safe{margin:14px 24px 0;padding:14px 16px;border:1px solid var(--ln);border-radius:18px;color:var(--tx)}
#phone .c24-safe button{margin:0}
#phone .t26-w{flex-direction:row!important;align-items:flex-end!important;gap:8px}
#phone .t26-w.me{flex-direction:row-reverse!important}
#phone .t26-w .mm-b{max-width:100%}
#phone .t26-w>.mm-b,#phone .t26-w>div[onclick]{max-width:68%;min-width:0}
#phone .t26-w .mm-t{flex:none;white-space:nowrap;padding:0 0 2px}
#phone .t26-av{flex:0 0 36px;width:36px;height:36px;border-radius:18px;background:var(--ln);color:var(--mu);display:flex;align-items:center;justify-content:center;align-self:flex-start}
#phone .t26-sp{flex:0 0 36px}
#phone #t26dn{position:absolute;right:16px;bottom:140px;width:44px;height:44px;border-radius:22px;border:0;background:var(--chip);color:var(--tx);display:none;align-items:center;justify-content:center;box-shadow:0 2px 10px rgba(0,0,0,.25);z-index:5}
</style>
<script>try{(function(){
if(window.__t26)return;window.__t26=1;
const svc=id=>{const m=/^hd(market|jobs|property)(\d+)$/.exec(id||'');return m?{k:m[1],i:+m[2]}:/^cm/.test(id||'')?{k:'comm'}:null};
const itm=s=>s&&s.i!=null&&HD[s.k]?HD[s.k].items.find(x=>x.id===s.i):null;
const ST={Available:'Selling',Reserved:'Reserved',Sold:'Deal done',Open:'Hiring',Applied:'Applied'};
const btn=(f,l,i)=>`<button onclick="${f}">${i?ic(i,18):''}${l}</button>`;
const _c=screens.chat;
screens.chat=function(){const h=_c.apply(this,arguments),id=S.chat,s=svc(id),x=itm(s);
 const t=document.createElement('template');t.innerHTML=h;const f=t.content;
 /* sub line: how fast they reply */
 const sub=f.querySelector('#mmsub');if(sub&&s&&s.k!=='comm'&&!/typing|…/.test(sub.textContent)){const ar=x&&x.sub?String(x.sub).split(' · ')[0]:'';sub.textContent=(ar?ar+' · ':'')+'Usually replies within 10 min'}
 /* title carries the status */
 const ctx=f.querySelector('.c24-ctx');
 if(ctx){const st=ctx.querySelector('.c24-st'),b=ctx.querySelector('b');if(st&&b){b.insertAdjacentHTML('afterbegin',`<span class="t26-s">${ST[st.textContent.trim()]||st.textContent} </span>`);st.remove()}
  const own=x&&x.who==='You',sold=x&&x.st==='sold',row=document.createElement('div');row.className='t26-act';row.setAttribute('role','group');row.setAttribute('aria-label','Actions');
  let a='';
  if(!own){a+=btn('soon()','Call','phone');
   if(s.k==='market'&&!sold)a+=btn(`mkMeet(${x.id})`,'Set a meet-up','cal');
   if(s.k==='property')a+=btn(`c24Say('view')`,'Book a viewing','cal');
   a+=btn('soon()','Leave a review','pencil')}
  row.innerHTML=a;if(a)ctx.after(row);
  if(s.k==='market'&&!own&&!sold&&x.p){const p=document.createElement('button');p.className='t26-pay';p.setAttribute('onclick',`mkPay(${x.id})`);p.innerHTML=`<span>Pay safely with itunda Pay</span><span aria-hidden="true">›</span>`;(f.querySelector('.t26-act')||ctx).after(p)}}
 /* quick chips: the meet-up and pay chips now live above */
 f.querySelectorAll('.c24-qk button').forEach(b=>{const o=b.getAttribute('onclick')||'';if(/mkMeet|mkPay/.test(o))b.remove()});
 /* bubbles: avatar for them, time beside the bubble */
 const pad=[...f.querySelectorAll('div.pad')].find(d=>d.querySelector('.mm-day,.mm-b')),user=ic('user',20);
 if(pad){let prev=false;[...pad.children].forEach(w=>{const st=w.getAttribute&&w.getAttribute('style')||'';if(!/flex-direction:column/.test(st)){prev=false;return}
  const me=/align-items:flex-end/.test(st);if(w.querySelector('.mm-rx')){prev=false;return}
  w.classList.add('t26-w');if(me){w.classList.add('me');prev=false}else{w.insertAdjacentHTML('afterbegin',prev?'<span class="t26-sp"></span>':`<span class="t26-av" aria-hidden="true">${user}</span>`);prev=true}})}
 return t.innerHTML};
/* scroll-down button */
const dn=document.createElement('button');dn.id='t26dn';dn.setAttribute('aria-label','Latest messages');dn.innerHTML=ic('back',22).replace('<svg','<svg style="transform:rotate(-90deg)"');
dn.onclick=()=>{chatEnd();dn.style.display='none'};
const ph=document.getElementById('phone');if(ph)ph.appendChild(dn);
const chk=()=>{const sc=document.getElementById('sc'),on=S.stack&&S.stack[S.stack.length-1]==='chat';dn.style.display=on&&sc&&sc.scrollHeight-sc.scrollTop-sc.clientHeight>240?'flex':'none'};
document.addEventListener('scroll',chk,true);if(ph)new MutationObserver(chk).observe(ph,{childList:true,subtree:true});
document.title=document.title.replace(/v\d+/,'v526');
})()}catch(e){console.error('talk-v526',e)}</script>
<style id="v527">/* v527: Talk, real Call and Leave a review */
#phone .t27-o{display:flex;align-items:center;gap:12px;width:100%;min-height:56px;padding:0 16px;margin-top:10px;border:1px solid var(--ln);border-radius:16px;background:none;color:var(--tx);font:inherit;font-size:16px;font-weight:700;text-align:left}
#phone .t27-o.on{border-color:var(--lk);background:var(--tint)}
#phone .t27-o small{display:block;font-size:13px;font-weight:500;color:var(--mu)}
#phone .t27-chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:16px}
#phone .t26-act button[disabled]{opacity:.5}
</style>
<script>try{(function(){
if(window.__t27)return;window.__t27=1;
const sh=h=>{$('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" role="dialog" aria-modal="true" style="max-height:90%;overflow-y:auto">'+h+'</div>'};
const H='class="h1" style="font-size:22px;line-height:30px"';
const esc=s=>String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/"/g,'&quot;');
const th=()=>THREADS.find(t=>t.id===S.chat);
S.t27r=S.t27r||{};let R={v:null,t:{}};
const TAG={good:['Friendly','On time','Clear and honest','Fast replies'],ok:['Slow replies','Details differed a little'],bad:['Did not show up','Rude','Asked to pay outside itunda']};
const _c=screens.chat;
screens.chat=function(){const h=_c.apply(this,arguments),t=document.createElement('template');t.innerHTML=h;
 t.content.querySelectorAll('.t26-act button').forEach(b=>{const l=b.textContent.trim();
  if(l==='Call')b.setAttribute('onclick','t27Call()');
  else if(l==='Leave a review'){if(S.t27r[S.chat]){b.disabled=true;b.lastChild.textContent='Reviewed'}else b.setAttribute('onclick','t27Rev()')}});
 return t.innerHTML};
window.t27Call=()=>{const t=th();if(!t)return;sh(`<div ${H}>${L2('Call')} ${esc(t.n)}</div><div class="mu" style="font-size:15px;line-height:22px;margin:8px 0 20px">Your number stays hidden. itunda connects the call for you.</div><button class="btn" onclick="t27Go()">Call now</button><button class="btn sec2" style="margin-top:10px" onclick="closeSheet()">Not now</button>`)};
const L2=x=>x;
window.t27Go=()=>{closeSheet();toast('Calling '+(th()||{}).n+'…')};
window.t27Rev=()=>{R={v:null,t:{}};t27Draw()};
function t27Draw(){const t=th();if(!t)return;const O=[['good','Good','I would deal with them again'],['ok','Okay','Nothing special'],['bad','Not good','Something went wrong']];
 sh(`<div ${H}>How was it with ${esc(t.n)}?</div><div class="mu" style="font-size:14px;margin-top:4px">Only they see your tags. Your rating changes their manner temperature.</div>${O.map(([k,n,s])=>`<button class="t27-o ${R.v===k?'on':''}" aria-pressed="${R.v===k}" onclick="t27V('${k}')"><span><span>${n}</span><small>${s}</small></span></button>`).join('')}${R.v?`<div class="t27-chips">${TAG[R.v].map((n,i)=>`<button class="cch ${R.t[n]?'on':''}" aria-pressed="${!!R.t[n]}" onclick="t27T(${i})">${n}</button>`).join('')}</div>`:''}<button class="btn" style="margin-top:20px;${R.v?'':'opacity:.5'}" ${R.v?'':'disabled'} onclick="t27Send()">Send review</button>`)}
window.t27V=k=>{R.v=k;R.t={};t27Draw()};
window.t27T=i=>{const n=TAG[R.v][i];R.t[n]=!R.t[n];t27Draw()};
window.t27Send=()=>{const t=th();if(!R.v||!t)return;S.mxMt=S.mxMt||{};S.mxMt[t.n]=(S.mxMt[t.n]||0)+(R.v==='good'?.5:R.v==='bad'?-.7:0);S.t27r[S.chat]=1;closeSheet();render('fade-none');toast('Review sent. Thank you')};
document.title=document.title.replace(/v\d+/,'v528');
})()}catch(e){console.error('talk-v527',e)}</script>
<style id="v529">
/* v529: Ads, Toss style. An ad is a benefit, not a banner: it sits inside lists the person already reads, wears the same row, and carries a small plain "Ad" tag. No popups, no full-screen takeovers, nothing on Home, Bank, Send, Pay steps or Messages. */
#phone .ad25{display:inline-block;white-space:nowrap;margin-left:6px;padding:1px 6px;border-radius:6px;background:var(--chip);color:var(--mu);font-size:12px;line-height:16px;font-weight:600;vertical-align:1px;letter-spacing:0}
#phone .ad25m{display:flex;align-items:center;gap:12px;margin:12px 24px 0;padding:12px 16px;min-height:64px;border-radius:20px;background:var(--chip);cursor:pointer}
#phone .ad25m .t{font-size:15px;line-height:22px;font-weight:700;display:flex;align-items:center;min-width:0}#phone .ad25m .t .n{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}#phone .ad25m .ad25{flex:none;white-space:nowrap}
#phone .ad25m .s{font-size:13px;line-height:18px;color:var(--mu);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}#phone .ad25m>div:nth-child(2){min-width:0;flex:1}
@media (max-height:760px){#phone .ad25m{display:none}}
#phone .ad25m .ico{flex:none}
#phone .ad25r{font-weight:700;color:var(--lk)}
</style>
<script>try{(function(){
const A={
 simba:{k:'list',ico:'tag',by:'Simba Supermarket',t:'3% back on weekend groceries',s:'Pay with itunda Pay on Saturday or Sunday',b:'Pay with itunda Pay at Simba Supermarket on Saturday or Sunday. The 3% comes back to your Rewards the next day, up to 5,000 RWF a month.',cta:'Pay at Simba',ok:'Scan the Simba QR with itunda Pay'},
 coffee:{k:'mission',ico:'qr',by:'Nyamirambo Coffee House',t:'Pay with QR once, get 300 RWF',s:'One small payment, one reward',b:'Scan the shop QR with itunda Pay and pay any amount. 300 RWF lands in your Rewards within a day. One reward per person.',cta:'Start mission',ok:'Mission started. Scan the QR at the shop'}};
const hid=()=>(S.adHide=S.adHide||{});
const row=id=>{const a=A[id];return `<div class="row tap" onclick="adOpen('${id}')"><div class="ico">${gx(a.ico,30)}</div><div style="min-width:0"><div class="t">${a.by}<span class="ad25">Ad</span></div><div class="s">${a.t}</div></div><div class="r">${a.r?`<span class="ad25r">${a.r}</span>`:''}${ic('chev',16,'var(--tt)')}</div></div>`};
const moment=()=>{if(hid().coffee)return '';const a=A.coffee;return `<div class="ad25m tap" role="button" tabindex="0" onclick="adOpen('coffee')" aria-label="Ad: ${a.t}"><div class="ico">${gx(a.ico,30)}</div><div style="min-width:0;flex:1"><div class="t"><span class="n">${a.by}</span><span class="ad25">Ad</span></div><div class="s">${a.t}</div></div>${ic('chev',16,'var(--tt)')}</div>`};
window.adOpen=id=>{const a=A[id];document.getElementById('layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div style="display:flex;align-items:center"><span class="ad25" style="margin:0">Ad</span><span class="sm mu" style="margin-left:8px">${a.by}</span></div><div class="h1" style="font-size:22px;line-height:30px;margin-top:10px">${a.t}</div><div class="mu" style="font-size:15px;line-height:22px;margin-top:8px">${a.b}</div><div class="sm mu" style="margin-top:14px">You see this because of your area. Ads never use your messages or your balance.</div><button class="btn" style="margin-top:20px" onclick="adGo('${id}')">${a.cta}</button><button class="btn sec2" style="margin-top:10px" onclick="adHide('${id}')">Hide this ad</button></div>`};
window.adGo=id=>{closeSheet();toast(A[id].ok)};
window.adHide=id=>{hid()[id]=1;closeSheet();render('fade-none');toast('Ad hidden')};
const tpl=h=>{const t=document.createElement('template');t.innerHTML=h;return t};
const _b=screens.benefits;
screens.benefits=function(){const h=_b.apply(this,arguments),t=tpl(h);
 [...t.content.querySelectorAll('.sech')].forEach(e=>{const x=e.textContent.trim(),sec=e.parentElement;
  if(x==='Offers for you'&&!hid().simba){const r=sec.querySelector('.row');if(r)r.insertAdjacentHTML('afterend',row('simba'))}
  if(x==='Earn more'&&!hid().coffee)sec.insertAdjacentHTML('beforeend',row('coffee'))});
 return t.innerHTML};
['sent','paydone'].forEach(n=>{const _f=screens[n];if(!_f)return;
 screens[n]=function(){const h=_f.apply(this,arguments),m=moment(),i=h.indexOf('<div class="cta"');return m&&i>0?h.slice(0,i)+m+h.slice(i):h}});
document.title=document.title.replace(/v\d+/,'v529');
})()}catch(e){console.error('ads-v529',e)}</script>
<script>try{(function(){
/* v530: customer side of itunda Front. Scanning the shop's Front QR opens the counter order, Pay uses the normal confirm and receipt flow. */
screens.payorder=()=>`${bar('Nyamirambo Coffee House')}<div class="pad" style="padding-top:20px"><div class="mu sm">Order at the counter</div><div class="big" style="margin-top:4px">7,000 RWF</div></div><div style="margin:20px 24px 0;padding:4px 20px;border-radius:20px;background:var(--chip)">${[['2 × Cappuccino','5,000'],['1 × Croissant','2,000']].map((r,i)=>`<div style="display:flex;justify-content:space-between;height:52px;align-items:center;font-size:15px"><span>${r[0]}</span><b>${r[1]}</b></div>`).join('')}</div><div style="margin:12px 24px 0;padding:4px 20px;border-radius:20px;background:var(--chip)">${[['Pay from',srcN()],['You earn','70 points']].map(r=>`<div style="display:flex;justify-content:space-between;height:52px;align-items:center;font-size:15px"><span class="mu">${r[0]}</span><b>${r[1]}</b></div>`).join('')}</div><div class="cta"><button class="btn" onclick="ppFront()">Pay 7,000 RWF</button></div>`;
window.ppOrder=()=>{S.stack[S.stack.length-1]='payorder';render('push')};
window.ppFront=()=>{S.pm={n:'Nyamirambo Coffee House',sub:'Order at the counter',amt:'7000',g:'bag'};ppConfirm()};
const _sc=screens.paysc;
screens.paysc=function(){const h=_sc.apply(this,arguments),k='<button class="v8chip" onclick="scBad()">',i=h.indexOf(k);
 if(i<0)return h;
 return h.slice(0,i)+'<button class="v8chip" onclick="scHit(()=>ppOrder())">Coffee House order</button>'+h.slice(i)};
document.title=document.title.replace(/v\d+/,'v530');
})()}catch(e){console.error('front-v530',e)}</script>
<style id="v531">
/* v531: Jobs rows feel like work, not a marketplace. A smaller tile with a job-specific icon replaces the big picture, the save heart sits under it, and the pay stays the first thing you read. */
#phone #jnl .dg-th.dg-th.dg-th{width:76px!important;height:76px!important;min-width:76px!important;border-radius:22px!important}
#phone #jnl .dg-th.dg-th.dg-th svg{width:46px!important;height:46px!important}
#phone #jnl .dg-h.dg-h.dg-h{left:auto!important;right:20px!important;top:auto!important;bottom:10px!important;background:none!important}
#phone #jnl .dg-r.dg-r.dg-r{padding:18px 24px 18px!important;min-height:132px}
#phone #jnl .dg-b{min-width:0}
</style>
<script>try{(function(){
const H=HD.jobs;
const pick=x=>{const t=String(x.ti||''),k=x.k||'';
 if(/barista|coffee|caf/i.test(t))return 'coffee';
 if(k==='Food'||/cook|waiter|kitchen|chef|restaurant/i.test(t))return 'restaurant';
 if(k==='Delivery'||/rider|moto|driver|deliver/i.test(t))return 'moto';
 if(k==='Cleaning'||/clean|laundry|garden/i.test(t))return 'house';
 if(k==='Tutoring'||/tutor|teach/i.test(t))return 'school';
 if(k==='Events'||/event|usher/i.test(t))return 'celebrate';
 if(k==='Office'||/office|clerk|admin/i.test(t))return 'briefcase';
 return x.g||'bag'};
H.items.forEach(x=>{if(!x.g||x.g==='bag')x.g=pick(x)});
document.title=document.title.replace(/v\d+/,'v531');
})()}catch(e){console.error('jobs-v531',e)}</script>


<style id="v534">/* v534: signing PIN sheet, calm motion. Before: the sheet shot up and then crept the last 12 px for ~300 ms, every key squished and sprang back, each typed digit popped to 135%, and every step change faded and slid the content again. Now: one smooth slide-up (no overshoot), keys and dots change colour only, steps swap in place. */
#phone #layer:not(.v396out) .sheet:has([data-czpin]){animation:v534up .3s cubic-bezier(.25,.8,.25,1) both!important}
@keyframes v534up{from{transform:translateY(100%)}to{transform:none}}
#phone .czk,#phone .czk:active{transform:none!important}
#phone .czd,#phone .czd.on,#phone .czd.ok,#phone .czd.bad{animation:none!important;transform:none!important}
#phone .czin>*,#phone .czfd{animation:none!important}
@media (prefers-reduced-motion:reduce){#phone #layer:not(.v396out) .sheet:has([data-czpin]){animation-duration:.01ms!important}}
</style>
<script>try{document.title=document.title.replace(/v\d+/,'v534')}catch(e){}</script>
<style id="v535">/* v535: signing PIN sheet has no motion: it appears at its final position (no slide, no bounce, no key re-layout). Keypad matches the login keypad. Before: the keys sat inside the sheet's side margins (columns 84px apart, bunched in the middle) and 12px higher than on the login screen. Now the key grid spans the full phone width like the login pad (columns 108px apart, 32px side padding) and its bottom edge sits at the same height. */
/* the signing PIN sheet is a full page like the onboarding PIN page: centred 30px title, 16px muted line, 16px dots 14px apart, same key pad. */
#phone .sheet:has(:is([data-czpin],[data-cpin],[data-pg])){top:0!important;left:0!important;right:0!important;bottom:0!important;height:auto!important;max-height:none!important;border-radius:0!important;padding:0!important;display:flex!important;flex-direction:column}
#phone .sheet:has(:is([data-czpin],[data-cpin],[data-pg])) .v6b{padding:0!important;margin:0!important;flex:1;min-height:0;display:flex!important;flex-direction:column;overflow:hidden}
#phone .sheet:has(:is([data-czpin],[data-cpin],[data-pg])) #czgo{display:block;width:100%;height:53px!important;min-height:0!important;padding:0!important;margin:auto 0 0!important;border-radius:0!important;font-size:17px;font-weight:700;flex:none}
#phone .sheet:has(:is([data-czpin],[data-cpin],[data-pg])) #czgo:disabled{background:var(--tint)!important;color:var(--tintfg)!important;opacity:1!important}
#phone .sheet:has(:is([data-czpin],[data-cpin],[data-pg])) .keys.tkpsh{margin:0!important;padding:0 32px var(--kb)!important}
#phone .sheet:has(:is([data-czpin],[data-cpin],[data-pg])) .keys.tkpsh .czk{width:auto!important;border-radius:0!important;background:none!important;font-weight:300!important;font-size:28px!important}
#phone #layer:not(.v396out) .sheet:has(:is([data-czpin],[data-cpin],[data-pg])),#phone #layer .sheet:has(:is([data-czpin],[data-cpin],[data-pg])) *{animation:none!important;transition:none!important}
/* every other sheet: one short ease-out slide, no spring tail (the old spring kept creeping for ~500 ms). The other two PIN sheets (Change PIN, card/gate PIN) have no motion, like the signing PIN. */
#phone #layer:not(.v396out) .sheet{animation:v396up .26s cubic-bezier(.2,.8,.2,1) both!important}
#phone #layer:not(.v396out) .sheet:has(:is([data-czpin],[data-cpin],[data-pg])){animation:none!important}
#phone #layer .sheet:has(:is([data-cpin],[data-pg])) *{animation:none!important;transition:none!important}
@media (max-height:700px){#phone .sheet:has(:is([data-czpin],[data-cpin],[data-pg])) .keys.tkpsh{padding-bottom:var(--kb)!important}}
</style>
<script>
/* v550: itunda Front + Naver-style restaurant page. Places: restaurants and cafes get Eat here / To go / Delivery under the Directions button (delivery is itunda Eats, here and to go are itunda Front), plus visitor-review keywords like Naver Places. Front is the table service: Menu (the menu they hand you: tap to add, send to the kitchen, order again any time) > Bill (the waiter brings it: itemised, tip, split between friends) > Pay (the cashier: itunda Pay, MoMo, card or cash at the table) > receipt. To go skips the bill and gives a pickup number. Places hub gets a "Scan table code" row. English only; sample menus. */
try{(()=>{
const FR={p:'',m:'here',t:'7',c:{},s:{},tip:0,sp:0,pm:'pay',st:'Preparing',amt:0};window.__FR=FR;
const e=x=>String(x).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const pl=()=>POI.find(x=>x.n===FR.p)||{n:FR.p,c:'food'};
const menu=()=>{const r=REST.find(x=>x.n===FR.p);if(r)return r.items;return pl().c==='cafe'?[['Macchiato','Espresso with steamed milk',1800],['Cappuccino','',2200],['Croissant','Baked this morning',1200],['Fresh juice','Passion or mango',1800]]:[['Grilled chicken','Half, with chips',6500],['Goat brochette','Salt and onion',2500],['Chips','Crispy, large',1500],['Soda','',800]]};
const sum=o=>Object.keys(o).reduce((a,k)=>a+o[k]*menu()[k][2],0),cnt=o=>Object.keys(o).reduce((a,k)=>a+o[k],0);
const due=()=>{const b=sum(FR.s),t=b+Math.round(b*FR.tip/100);return FR.sp?Math.ceil(t/FR.sp):t};
const bar=(t,s)=>`<div class="mh" style="padding-bottom:0"><button class="ib" aria-label="Back" onclick="back()">${ic('back',24)}</button><div style="flex:1;margin-left:6px"><b style="font-size:19px">${e(t)}</b><div class="mu" style="font-size:13px">${s}</div></div></div>`;
const cta=(l,f,d)=>`<div class="cta"><button class="btn" ${d?'disabled':''} onclick="${f}">${l}</button></div>`;
const who=(i,t,s)=>`<div style="display:flex;gap:12px;align-items:center;margin:14px 24px 0;padding:12px 14px;border-radius:16px;background:var(--tint)"><span style="font-size:26px">${i}</span><div><b>${t}</b><div class="mu" style="font-size:14px">${s}</div></div></div>`;
const stp=n=>FR.m==='here'?`<div style="display:flex;gap:6px;padding:12px 24px 0">${['Menu','Bill','Pay'].map((x,i)=>`<div style="flex:1"><div style="height:4px;border-radius:2px;background:${i<=n?'var(--lk)':'var(--tint)'}"></div><div style="font-size:12px;margin-top:6px;font-weight:${i===n?800:600};color:${i===n?'var(--tx)':'var(--tt)'}">${x}</div></div>`).join('')}</div>`:'';
const chip=(on,f,l)=>`<button class="ocp ${on?'on':''}" onclick="${f}">${l}</button>`;
const row=(l,r,b)=>`<div style="display:flex;justify-content:space-between;padding:7px 24px;${b?'font-weight:800;font-size:18px':''}"><span>${l}</span><span>${r}</span></div>`;
screens.frontmenu=()=>{const m=menu(),n=cnt(FR.c),tot=sum(FR.c),h=FR.m==='here',ns=cnt(FR.s);
return `${bar(FR.p,h?'Table '+FR.t:'To go · pick up at the counter')}${stp(0)}
<div style="display:flex;gap:8px;padding:14px 24px 0">${chip(h,"frM('here')",'Here')}${chip(!h,"frM('togo')",'To go')}</div>
${who('📖',h?'Your menu':'Order ahead',h?'Tap + to add. Send it to the kitchen, order again any time.':'Order now, collect it when it is ready.')}
${h&&ns?`<div style="margin:10px 24px 0;padding:12px 14px;border-radius:14px;background:#E8F7EE;color:#12803C;font-weight:700">In the kitchen · ${ns} item${ns>1?'s':''} · ${fmt(sum(FR.s))} RWF</div>`:''}
${m.map((x,i)=>`<div style="display:flex;align-items:center;gap:12px;padding:14px 24px"><div style="flex:1;min-width:0"><b style="font-size:17px;display:block">${e(x[0])}</b>${x[1]?`<span class="mu" style="font-size:14px">${e(x[1])}</span>`:''}<div style="margin-top:4px">${fmt(x[2])} RWF</div></div>${FR.c[i]?`<button class="ib" aria-label="Remove" onclick="frQ(${i},-1)">−</button><b>${FR.c[i]}</b>`:''}<button class="ib" aria-label="Add" onclick="frQ(${i},1)">+</button></div>`).join('')}
<div style="height:110px"></div>${n?cta(h?`Send to kitchen · ${n} · ${fmt(tot)} RWF`:`Order · ${fmt(tot)} RWF`,h?'frSend()':'frTogo()'):h&&ns?cta('Ask for the bill','frBill()'):cta('Add something','',1)}`};
screens.frontbill=()=>{const m=menu(),b=sum(FR.s),tp=Math.round(b*FR.tip/100);
return `${bar('Your bill','Table '+FR.t+' · '+e(FR.p))}${stp(1)}${who('🧾','Your waiter brought the bill','Check it, add a tip, split it with friends.')}
<div style="padding-top:12px">${Object.keys(FR.s).map(k=>row(FR.s[k]+' × '+e(m[k][0]),fmt(FR.s[k]*m[k][2])+' RWF')).join('')}${row('Tip',fmt(tp)+' RWF')}</div>
<div class="pad" style="padding-top:14px"><b>Tip</b><div style="display:flex;gap:8px;margin-top:8px">${[0,5,10].map(v=>chip(FR.tip===v,`frTip(${v})`,v?v+'%':'No tip')).join('')}</div></div>
<div class="pad" style="padding-top:14px"><b>Split</b><div style="display:flex;gap:8px;margin-top:8px">${[0,2,3,4].map(v=>chip(FR.sp===v,`frSp(${v})`,v?'÷ '+v:'Pay all')).join('')}</div></div>
<div style="padding-top:14px">${row(FR.sp?'Your share':'Total',fmt(due())+' RWF',1)}</div><div style="height:110px"></div>${cta('Go to cashier · '+fmt(due())+' RWF','frGo()')}`};
screens.frontpay=()=>{const a=FR.m==='here'?due():sum(FR.s),low=FR.pm==='pay'&&S.pay<a;
const M=[['pay','itunda Pay','Balance '+fmt(S.pay)+' RWF'],['mtn','MTN MoMo','Approve on your phone'],['card','Card','Cashier brings the card machine'],['cash','Cash','Cashier comes to your table']];
return `${bar('Pay','Table '+FR.t+' · '+e(FR.p))}${stp(2)}${who('💳','The cashier is ready','Choose how you want to pay.')}
<div style="text-align:center;padding:22px 0 6px"><div class="mu" style="font-size:14px">${FR.sp?'Your share':'To pay'}</div><div style="font-size:34px;font-weight:800">${fmt(a)} RWF</div></div>
${M.map(x=>{const on=FR.pm===x[0];return `<div class="tap frck${on?' on':''}" role="checkbox" aria-checked="${on}" tabindex="0" onclick="frPm('${x[0]}')" style="display:flex;align-items:center;gap:12px;padding:14px 24px"><div style="flex:1"><b style="font-weight:${on?800:600}">${x[1]}</b><div class="mu" style="font-size:14px">${x[2]}</div></div><svg class="frck-i" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" stroke="${on?'var(--lk)':'var(--tt)'}" stroke-opacity="${on?1:.5}" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></div>`}).join('')}
${low?'<div class="pad" style="color:var(--er);font-size:14px">Not enough in itunda Pay. Pick another way to pay.</div>':''}<div style="height:110px"></div>${cta('Pay '+fmt(a)+' RWF','frPay()',low)}`};
screens.frontdone=()=>{const h=FR.m==='here';return `<div class="pad" style="text-align:center;padding-top:96px"><div style="font-size:56px">✅</div><div style="font-size:26px;font-weight:800;margin-top:12px">${fmt(FR.amt)} RWF paid</div><div class="mu" style="margin-top:8px;font-size:16px;line-height:23px">${h?'Thanks for eating at '+e(FR.p)+'.'+(FR.sp?' Your friends pay their share on their own phones.':''):'Show this number at the counter.'}</div>${h?'':`<div style="font-size:48px;font-weight:800;margin-top:22px;letter-spacing:2px">Q-48</div><div class="mu">Ready in about 15 min</div>`}<div class="mu" style="margin-top:18px">Paid with ${({pay:'itunda Pay',mtn:'MTN MoMo',card:'card',cash:'cash at the table'})[FR.pm]}</div><div style="margin-top:28px"><b>${FR.rt?'Thanks for rating '+e(FR.p):'How was '+e(FR.p)+'?'}</b><div style="display:flex;justify-content:center;gap:6px;margin-top:10px">${[1,2,3,4,5].map(i=>`<button class="ib" aria-label="${i} star" style="font-size:32px;color:${i<=(FR.rt||0)?'#F5B301':'var(--tint)'}" onclick="frRate(${i})">★</button>`).join('')}</div></div></div>${cta('Done',"frDone()")}`};
const go=s=>{S.stack.push(s);render('push')},re=()=>render('fade-none');
Object.assign(window,{frOpen:(n,m)=>{Object.assign(FR,{p:n,m:m||'here',c:{},s:{},tip:0,sp:0,pm:'pay',rt:0});go('frontmenu')},
frScan:()=>{toast('Table 7 · Grill House');window.frOpen('Grill House','here')},frM:m=>{FR.m=m;re()},frQ:(i,d)=>{FR.c[i]=Math.max(0,(FR.c[i]||0)+d);re()},
frSend:()=>{Object.keys(FR.c).forEach(k=>{if(FR.c[k])FR.s[k]=(FR.s[k]||0)+FR.c[k]});FR.c={};toast('Sent to the kitchen');re()},
frTogo:()=>{FR.s=Object.assign({},FR.c);FR.c={};go('frontpay')},frBill:()=>go('frontbill'),frTip:v=>{FR.tip=v;re()},frSp:v=>{FR.sp=v;re()},frGo:()=>go('frontpay'),frPm:k=>{FR.pm=k;re()},
frPay:()=>{const a=FR.m==='here'?due():sum(FR.s);if(FR.pm==='pay'){if(S.pay<a)return;S.pay-=a}FR.amt=a;go('frontdone')},frDone:()=>{S.stack=['fronthome'];render('fade')},openFront:()=>{S.stack=['fronthome'];render('push')},frResume:()=>go('frontmenu'),frRate:n=>{FR.rt=n;window.FRV=(window.FRV||[]).filter(x=>x.p!==FR.p);window.FRV.unshift({p:FR.p,s:n,m:FR.m,t:FR.t});re()},frMenuOf:n=>{const o=FR.p;FR.p=n;const m=menu();FR.p=o;return m}});
screens.fronthome=()=>{const R=POI.filter(p=>/^(food|cafe)$/.test(p.c)),h=FR.m==='here',live=FR.p&&cnt(FR.s)>0;
return `${bar('Front','Eat here or take away')}<div style="display:flex;gap:8px;padding:14px 24px 0">${chip(h,"frM('here')",'Here')}${chip(!h,"frM('togo')",'To go')}</div>
${live?`<div class="tap" onclick="frResume()" style="margin:14px 24px 0;padding:14px;border-radius:16px;background:#E8F7EE;color:#12803C"><b>Your table · ${e(FR.p)}</b><div style="font-size:14px">Table ${FR.t} · ${fmt(sum(FR.s))} RWF in the kitchen · tap to order more or get the bill</div></div>`:''}
${h?`<div class="tap" onclick="frScan()" style="display:flex;align-items:center;gap:12px;margin:14px 24px 0;padding:14px;border-radius:16px;background:var(--tint)"><span style="font-size:26px">📱</span><div style="flex:1"><b>Scan the table code</b><div class="mu" style="font-size:13px">Menu, bill and payment at your table</div></div>›</div>`:''}
<div class="agt" style="padding-top:18px">${h?'Eat here':'Order to go'}</div>
${R.map(p=>`<div class="tap" onclick="frOpen('${p.n.replace(/'/g,"\\'")}','${FR.m}')" style="display:flex;align-items:center;gap:12px;padding:12px 24px"><span style="font-size:24px">${p.e||'🍽️'}</span><div style="flex:1;min-width:0"><b style="display:block">${e(p.n)}</b><span class="mu" style="font-size:14px">${p.r?'★ '+p.r+' · ':''}${p.d||''}</span></div>›</div>`).join('')}<div style="height:24px"></div>`};
/* v789 itunda Front, Toss Front pass (Toss Place research): the phone works like the Toss mini kiosk. One question per screen, big left-aligned titles, a swipeable promo strip (Toss Front allows up to 10 slides), "Eat here / Take away" asked first as two big cards, a short "picks for you" row with a reason badge (Toss table order: 3 to 5 core items first), tile + Add pill list, cart as a bottom sheet instead of a page, points offered before paying, a random call name for the pickup number, receipt choice, one big CTA at the bottom. */
{const NICK=['Sunny Mango','Happy Papaya','Brave Lion','Cozy Banana','Swift Zebra','Jolly Avocado'];
const ART=n=>/chick/i.test(n)?'🍗':/brochet|skewer|goat|beef/i.test(n)?'🍢':/chip|fries/i.test(n)?'🍟':/soda|juice|water|drink/i.test(n)?'🥤':/coffee|macchiato|cappuccino|latte|espresso|tea/i.test(n)?'☕':/croissant|bread|cake/i.test(n)?'🥐':'🍽️';
const css=document.createElement('style');css.textContent='.ftq{display:inline-flex;align-items:center;background:var(--chip);border-radius:20px;height:40px}.ftq button{width:40px;height:40px;border:0;background:none;font-size:20px;font-weight:700;color:var(--tx)}.ftq b{min-width:18px;text-align:center}.fta{height:40px;padding:0 20px;border:0;border-radius:20px;background:var(--tint);color:var(--tintfg);font-weight:800;font-size:15px}.fts{display:flex;gap:10px;overflow-x:auto;scroll-snap-type:x mandatory;padding:0 24px;scroll-padding:0 24px;scrollbar-width:none}.fts::-webkit-scrollbar{display:none}.ftc2{flex:0 0 86%;scroll-snap-align:start;border-radius:22px;padding:20px;min-height:104px;color:#17171C;display:flex;flex-direction:column;gap:4px}.ftc2 b{font-size:20px;letter-spacing:-.4px}.ftc2 span{font-size:14px}.ftm{flex:1;border:2px solid var(--ln);background:var(--bg);color:var(--tx);border-radius:20px;padding:16px 14px;text-align:left;display:flex;flex-direction:column;gap:2px;font:inherit}.ftm span{font-size:30px}.ftm b{font-size:18px}.ftm small{font-size:13px;color:var(--mu)}.ftm.on{border-color:var(--lk);background:var(--tint)}.fpk{flex:0 0 150px;scroll-snap-align:start;background:var(--chip);border-radius:20px;padding:12px;display:flex;flex-direction:column;gap:2px}.fpk i{height:76px;border-radius:14px;background:var(--bg);display:flex;align-items:center;justify-content:center;font-size:40px;font-style:normal;margin-bottom:8px}.ftb{align-self:flex-start;font-size:11px;font-weight:800;padding:2px 8px;border-radius:8px;background:var(--tint);color:var(--tintfg)}.fti{width:64px;height:64px;border-radius:18px;background:var(--chip);display:flex;align-items:center;justify-content:center;font-size:32px}.fseg{display:flex;gap:4px;background:var(--chip);border-radius:14px;padding:4px}.fseg button{flex:1;height:44px;border:0;border-radius:11px;background:none;font:inherit;font-weight:600;color:var(--mu)}.fseg button.on{background:var(--bg);color:var(--tx);font-weight:800;box-shadow:0 1px 4px rgba(0,0,0,.12)}.ftck{width:96px;height:96px;border-radius:50%;background:var(--br);margin:0 auto;display:grid;place-items:center;animation:ftpop .5s var(--spring)}.ftck path{stroke-dasharray:24;animation:ftd .5s .2s ease-out both}.ftn{margin:22px 24px 0;padding:16px;border-radius:20px;background:var(--tint);color:var(--tx)}.ftn small{font-size:14px;color:var(--mu)}.ftn b{display:block;font-size:44px;line-height:50px;letter-spacing:-1px}.ftsw{width:52px;height:32px;border-radius:16px;border:0;background:var(--ln);position:relative;flex:none}.ftsw::after{content:"";position:absolute;top:4px;left:4px;width:24px;height:24px;border-radius:50%;background:#fff;transition:transform .15s}.ftsw[aria-checked=true]{background:var(--lk)}.ftsw[aria-checked=true]::after{transform:translateX(20px)}@keyframes ftpop{from{transform:scale(.6);opacity:0}to{transform:none;opacity:1}}@keyframes ftd{from{stroke-dashoffset:24}to{stroke-dashoffset:0}}@media (prefers-reduced-motion:reduce){.ftck,.ftck path{animation:none}}';document.head.appendChild(css);
const ttl=(t,s)=>`<div style="padding:20px 24px 4px"><div class="mu" style="font-size:15px">${s}</div><div style="font-size:34px;line-height:42px;font-weight:800;letter-spacing:-.8px">${t}</div></div>`;
const seg=(a,cur,f)=>`<div class="fseg" role="group">${a.map(x=>`<button class="${cur===x[0]?'on':''}" aria-pressed="${cur===x[0]}" onclick="${f}(${typeof x[0]==='string'?`'${x[0]}'`:x[0]})">${x[1]}</button>`).join('')}</div>`;
const stepper=(i,n)=>(FR.p==='Grill House'&&n==='Chips')?'<span class="mu" style="font-size:14px;font-weight:700">Sold out</span>':FR.c[i]?`<span class="ftq"><button aria-label="Remove one ${e(n)}" onclick="frQ(${i},-1)">−</button><b>${FR.c[i]}</b><button aria-label="Add one ${e(n)}" onclick="frQ(${i},1)">+</button></span>`:`<button class="fta" aria-label="Add ${e(n)}" onclick="frQ(${i},1)">Add</button>`;
const sub=()=>FR.m==='here'?'Table '+FR.t+' · '+e(FR.p):'Take away · '+e(FR.p);
const sheetDraw=()=>{const m=menu(),h=FR.m==='here',n=cnt(FR.c),tot=sum(FR.c);if(!n){closeSheet();return}
document.getElementById('layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" role="dialog" aria-label="Your order"><div style="display:flex;justify-content:space-between;align-items:center"><b style="font-size:22px;letter-spacing:-.4px">Your order</b></div><div style="margin-top:12px">${seg([['here','Eat here'],['togo','Take away']],FR.m,'frM2')}</div><div style="margin-top:6px;max-height:240px;overflow:auto">${Object.keys(FR.c).filter(k=>FR.c[k]).map(k=>`<div style="display:flex;align-items:center;gap:12px;padding:10px 0"><span style="font-size:26px">${ART(m[k][0])}</span><div style="flex:1;min-width:0"><b>${e(m[k][0])}</b><div class="mu" style="font-size:14px">${fmt(m[k][2]*FR.c[k])} RWF</div></div>${stepper(k,m[k][0])}</div>`).join('')}</div><div style="display:flex;justify-content:space-between;padding:12px 0 14px;font-weight:800;font-size:18px"><span>Total</span><span>${fmt(tot)} RWF</span></div><button class="btn" onclick="${h?'frSend()':'frTogo()'}">${h?'Send to kitchen':'Pay '+fmt(tot)+' RWF'}</button></div>`};
screens.frontmenu=()=>{const m=menu(),n=cnt(FR.c),tot=sum(FR.c),h=FR.m==='here',ns=cnt(FR.s),B=['Most ordered','Owner’s pick','New'];
return `${bar(FR.p,h?'Table '+FR.t:'Take away · pick up at the counter')}${stp(0)}
${h&&ns?`<div class="tap" onclick="frBill()" style="margin:14px 24px 0;padding:14px;border-radius:16px;background:#E8F7EE;color:#12803C;font-weight:700">In the kitchen · ${ns} item${ns>1?'s':''} · ${fmt(sum(FR.s))} RWF<div style="font-weight:600;font-size:13px">Tap to ask for the bill</div></div>`:''}
<div class="agt" style="padding-top:20px">Picks for you</div><div class="fts" style="padding-top:8px">${m.slice(0,3).map((x,i)=>`<div class="fpk"><i>${ART(x[0])}</i><span class="ftb">${B[i]}</span><b style="margin-top:6px">${e(x[0])}</b><span class="mu" style="font-size:14px;margin-bottom:8px">${fmt(x[2])} RWF</span>${stepper(i,x[0])}</div>`).join('')}</div>
<div class="agt">All menu</div>${m.map((x,i)=>`<div style="display:flex;align-items:center;gap:14px;padding:12px 24px"><div style="flex:1;min-width:0"><b style="font-size:17px;display:block">${e(x[0])}</b>${x[1]?`<span class="mu" style="font-size:14px">${e(x[1])}</span>`:''}<div style="margin-top:4px;font-weight:700">${fmt(x[2])} RWF</div></div><div style="display:flex;flex-direction:column;align-items:center;gap:8px"><div class="fti" aria-hidden="true">${ART(x[0])}</div>${stepper(i,x[0])}</div></div>`).join('')}
<div style="height:110px"></div>${n?cta(`View order · ${n} · ${fmt(tot)} RWF`,'frCart()'):h&&ns?cta('Ask for the bill','frBill()'):cta('Pick something to order','',1)}`};
screens.frontbill=()=>{const m=menu(),b=sum(FR.s),tp=Math.round(b*FR.tip/100);
return `${bar('Your bill',sub())}${stp(1)}${ttl(fmt(due())+' RWF',FR.sp?'Your share':'Total')}
<div style="margin:14px 24px 0;padding:8px 16px;border-radius:20px;background:var(--chip)">${Object.keys(FR.s).map(k=>row(FR.s[k]+' × '+e(m[k][0]),fmt(FR.s[k]*m[k][2])+' RWF').replace('padding:7px 24px','padding:7px 0')).join('')}${row('Tip',fmt(tp)+' RWF').replace('padding:7px 24px','padding:7px 0')}</div>
<div class="agt">Tip</div><div style="padding:6px 24px 0">${seg([[0,'No tip'],[5,'5%'],[10,'10%']],FR.tip,'frTip')}</div>
<div class="agt">Split</div><div style="padding:6px 24px 0">${seg([[0,'Pay all'],[2,'÷ 2'],[3,'÷ 3'],[4,'÷ 4']],FR.sp,'frSp')}</div>
<div style="height:110px"></div>${cta('Pay · '+fmt(due())+' RWF','frGo()')}`};
screens.frontpay=()=>{const a=FR.m==='here'?due():sum(FR.s),low=FR.pm==='pay'&&S.pay<a,pts=Math.floor(a/100);
const M=[['pay','itunda Pay','Balance '+fmt(S.pay)+' RWF'],['mtn','MTN MoMo','Approve on your phone'],['card','Card','Cashier brings the card machine'],['cash','Cash','Cashier comes to your table']];
return `${bar('Pay',sub())}${FR.m==='here'?stp(2):''}${ttl(fmt(a)+' RWF',FR.sp?'Your share':'To pay')}
<div class="agt">Pay with</div>${M.map(x=>{const on=FR.pm===x[0];return `<div class="tap frck${on?' on':''}" role="checkbox" aria-checked="${on}" tabindex="0" onclick="frPm('${x[0]}')" style="display:flex;align-items:center;gap:12px;padding:14px 24px"><div style="flex:1"><b style="font-weight:${on?800:600}">${x[1]}</b><div class="mu" style="font-size:14px">${x[2]}</div></div><svg class="frck-i" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" stroke="${on?'var(--lk)':'var(--tt)'}" stroke-opacity="${on?1:.5}" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></div>`}).join('')}
${low?'<div class="pad" style="color:var(--er);font-size:14px">Not enough in itunda Pay. Pick another way to pay.</div>':''}
<div style="display:flex;align-items:center;gap:12px;margin:16px 24px 0;padding:14px 16px;border-radius:20px;background:var(--tint)"><div style="flex:1"><b>Collect points</b><div class="mu" style="font-size:14px">${FR.pt?'You earn '+pts+' points on this order':'Points are off for this order'}</div></div><button class="ftsw" role="switch" aria-checked="${!!FR.pt}" aria-label="Collect points" onclick="frPt()"></button></div>
<div style="height:110px"></div>${cta('Pay '+fmt(a)+' RWF','frPay()',low)}`};
screens.frontdone=()=>{const h=FR.m==='here',pts=FR.pt?Math.floor(FR.amt/100):0,RB={app:'In my app',print:'Print',none:'No receipt'};
return `<div class="pad" style="text-align:center;padding-top:72px"><div class="ftck"><svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#17171C" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5 9-10"/></svg></div><div style="font-size:30px;line-height:38px;font-weight:800;margin-top:20px;letter-spacing:-.6px">${fmt(FR.amt)} RWF paid</div><div class="mu" style="margin-top:6px">Paid with ${({pay:'itunda Pay',mtn:'MTN MoMo',card:'card',cash:'cash at the table'})[FR.pm]}${pts?' · +'+pts+' points':''}</div></div>
<div class="ftn" style="text-align:center"><small>${h?'Your table':'Your order number'}</small><b>${h?'Table '+FR.t:'Q-'+FR.no}</b><span>${h?'We will bring it to you.'+(FR.sp?' Your friends pay their share on their own phones.':''):'We will call “'+FR.nk+'” when it is ready.'}</span></div>
<div class="agt" style="text-align:center">Receipt</div><div style="padding:6px 24px 0">${seg(Object.keys(RB).map(k=>[k,RB[k]]),FR.rc||'app','frRc')}</div>
<div style="text-align:center;margin-top:22px"><b>${FR.rt?'Thanks for rating '+e(FR.p):'How was '+e(FR.p)+'?'}</b><div style="display:flex;justify-content:center;gap:6px;margin-top:6px">${[1,2,3,4,5].map(i=>`<button class="ib" aria-label="${i} star" style="font-size:32px;color:${i<=(FR.rt||0)?'#F5B301':'var(--tint)'}" onclick="frRate(${i})">★</button>`).join('')}</div></div><div style="height:110px"></div>${cta('Done',"frDone()")}`};
{const o1=window.frOpen,o2=window.frPay,o3=window.frDone;
Object.assign(window,{frOpen:(n,m)=>{FR.rc='app';FR.pt=1;o1(n,m)},frCart:()=>sheetDraw(),
frQ:(i,d)=>{FR.c[i]=Math.max(0,(FR.c[i]||0)+d);re();if(document.querySelector('#layer .sheet'))sheetDraw()},
frM2:k=>{FR.m=k;re();sheetDraw()},frPt:()=>{FR.pt=FR.pt?0:1;re()},frRc:k=>{FR.rc=k;re()},
frSend:()=>{Object.keys(FR.c).forEach(k=>{if(FR.c[k])FR.s[k]=(FR.s[k]||0)+FR.c[k]});FR.c={};closeSheet();toast('Sent to the kitchen');re()},
frTogo:()=>{FR.s=Object.assign({},FR.c);FR.c={};closeSheet();go('frontpay')},
frPay:()=>{const a=FR.m==='here'?due():sum(FR.s);if(FR.pm==='pay'&&S.pay<a)return;FR.nk=NICK[Math.floor(Math.random()*NICK.length)];FR.no=10+Math.floor(Math.random()*90);o2()},
frDone:()=>{closeSheet();o3()}})}}

screens.fronthome=()=>{const R=POI.filter(p=>/^(food|cafe)$/.test(p.c)),h=FR.m==='here',live=FR.p&&cnt(FR.s)>0;
const SL=[['linear-gradient(135deg,#8F89FF,#CFCBFF)','Lunch deal','Pay with itunda and earn double points'],['linear-gradient(135deg,#FFD58A,#FFF0CF)','New on the menu','Fresh juice, passion or mango'],['linear-gradient(135deg,#9BE3C4,#DDF7EC)','Skip the queue','Order here, we call your name']];
const mode=(k,i,t,s)=>`<button class="ftm${FR.m===k?' on':''}" aria-pressed="${FR.m===k}" onclick="frM('${k}')"><span>${i}</span><b>${t}</b><small>${s}</small></button>`;
return `${bar('Front','Order, pay and go')}<div class="fts" style="padding-top:14px">${SL.map(x=>`<div class="ftc2" style="background:${x[0]}"><b>${x[1]}</b><span>${x[2]}</span></div>`).join('')}</div>
<div class="agt">How would you like your order?</div><div style="display:flex;gap:10px;padding:8px 24px 0">${mode('here','🍽️','Eat here','We bring it to your table')}${mode('togo','🛍️','Take away','Pick up at the counter')}</div>

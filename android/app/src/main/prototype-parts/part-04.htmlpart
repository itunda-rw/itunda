<script>
/* v567: fixes found by running it in a browser: the folded section is a plain toggle button instead of a details element (the app's own script force-opens every details element), the opening-hours row takes the closing time from the status line (it said 9 pm while the line said 22:00, and 24-hour places read "Open today Open 24 hours"), and the busy bars and empty stars are visible. */
/* v567 also: the stop's extra minutes now work on the 24-hour clock the route card uses, and the live bus line takes its minutes from the card's own "next in N min" so the two never disagree. */
/* v567 also: the live bus line got its own class name (the app already had an .ar class that indented it), and the last-bus line shows the time left only when it is under 3 hours. */
/* v568: the waiting card now sits above "More about this place" with shorter text. "Avoid stairs" now shows only on bus and walking routes (it was also on car and bike routes). */
/* v566: Naver Maps extras 9. Directions: bus routes show live arrival and crowding like Naver's real-time bus info ("Bus 305 arrives in 4 min · Seats available"; crowding is one of Seats available, Standing room, Crowded). Places: a quiet "Suggest an edit" link at the end of the sheet, like Naver's information-fix suggestion. English only; sample arrivals that change by the minute. */
try{(()=>{
const _p=screens.place,_r=screens.route,M=S.mp;
const st=document.createElement('style');
st.textContent='#phone .nxt{margin-top:10px;font-size:14px;font-weight:700}#phone .nxt span{color:var(--tt);font-weight:600}#phone .nxt .c0{color:#2BA84A}#phone .nxt .c1{color:#F5A524}#phone .nxt .c2{color:#E5484D}#phone .se{display:block;margin:12px 20px 0;padding:0;border:0;background:none;color:var(--tt);font:inherit;font-size:13px;font-weight:700;text-align:left}';
document.head.appendChild(st);
window.plEdit=()=>toast('Thanks, we will review your suggestion');
screens.route=function(){
 const h=String(_r.apply(this,arguments));
 if((M.mode||'bus')!=='bus')return h;

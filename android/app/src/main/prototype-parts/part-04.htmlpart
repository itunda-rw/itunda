#phone .ez-ob div s{position:absolute;top:0;bottom:0;text-decoration:none;opacity:.16}
#phone .ez-ob div.a s{right:0;background:var(--er)}#phone .ez-ob div.b s{left:0;background:var(--ok)}
#phone .ez-ob div span{position:relative}

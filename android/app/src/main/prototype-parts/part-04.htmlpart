st.textContent='#phone .kwd{margin:16px 20px 0}#phone .kwd b{font-size:16px}#phone .kwd small{display:block;color:var(--mu);font-size:12px;margin-top:2px}#phone .kwr{display:flex;align-items:center;gap:10px;margin-top:8px;font-size:14px}#phone .kwr span{flex:none;width:128px}#phone .kwr u{flex:1;height:8px;border-radius:4px;background:var(--chip);text-decoration:none;overflow:hidden}#phone .kwr i{display:block;height:8px;border-radius:4px;background:var(--lk)}#phone .kwr em{font-style:normal;color:var(--mu);font-size:12px;width:34px;text-align:right}#phone .mem{margin:16px 20px 0}#phone .mem b{font-size:16px}#phone .mem input{width:100%;box-sizing:border-box;height:44px;margin-top:8px;border:0;border-radius:14px;background:var(--chip);padding:0 14px;font:inherit;font-size:15px;color:var(--tx);outline:0}#phone .stp{margin:12px 20px 0}#phone .stp .t{border:0;background:none;font:inherit;font-weight:800;color:var(--lk);padding:6px 0}#phone .stl{margin:6px 0 0 6px;border-left:3px solid var(--lk);padding-left:16px}#phone .stl div{position:relative;padding:5px 0;font-size:14px}#phone .stl div:before{content:"";position:absolute;left:-23px;top:11px;width:9px;height:9px;border-radius:5px;background:var(--bg);border:2px solid var(--lk)}#phone .stl small{color:var(--mu);margin-left:6px}#phone .gof{display:flex;gap:10px;align-items:center;margin-top:8px}#phone .gof button{flex:none;height:34px;border:0;border-radius:17px;padding:0 14px;background:var(--chip);color:var(--tx);font:inherit;font-weight:700;font-size:13px}#phone .gof button.on{background:var(--lk);color:#fff}#phone .gof small{color:var(--mu);font-size:12px;line-height:16px}';
document.head.appendChild(st);
const esc=s=>String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
window.plMemo=v=>{M.mem=M.mem||{};const t=String(v).trim().slice(0,80);if(t)M.mem[PL.n]=t;else delete M.mem[PL.n];toast(t?'Note saved':'Note removed')};
window.rtStops=()=>{M.stp=!M.stp;render('fade-none')};
window.rtGet=()=>{M.gof=!M.gof;toast(M.gof?'Get-off alert on':'Get-off alert off');render('fade-none')};

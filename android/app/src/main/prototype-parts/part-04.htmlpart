['Larger text','Voice guide'].forEach(k=>{h=h.replace(new RegExp('<div style="[^"]*"><div style="flex:1"><b>'+k+'</b>.*?</button></div>','s'),'')});
return h.replace('<div class="agt">How would you like','<div style="padding:12px 24px 0"><button class="fta" style="background:var(--chip);color:var(--tx);height:40px" onclick="frAxO()">♿ Accessibility</button></div><div class="agt">How would you like')};
/* 4. how should we call you (take away) */
const CL=[['nick','Nickname'],['sms','Text me'],['pager','Pager']],CT={sms:'We will text you when it is ready.',pager:'Take a pager at the counter. It buzzes when your order is ready.'};

const st=document.createElement('style');
st.textContent='#phone .abr{display:flex;gap:8px;align-items:center;padding:10px 20px 0;overflow-x:auto;scrollbar-width:none}#phone .abr::-webkit-scrollbar{display:none}#phone .abr b{flex:none;font-size:13px;color:var(--mu)}#phone .abr button{flex:none;height:34px;border:0;border-radius:17px;padding:0 13px;background:var(--chip);color:var(--tx);font:inherit;font-weight:700;font-size:13px}#phone .abr button.on{background:var(--lk);color:#fff}#phone .abl{padding:8px 20px 0;font-size:14px;font-weight:700;color:var(--lk)}#phone .own{margin:14px 20px 0;padding:14px 16px;border-radius:16px;background:var(--chip)}#phone .own small{display:block;font-size:12px;font-weight:700;color:var(--mu)}#phone .own div{font-size:15px;margin-top:4px;line-height:22px}#phone .als{margin:14px 0 0;padding:0 20px}#phone .als b{display:block;font-size:15px;margin-bottom:8px}#phone .als div{display:flex;gap:8px;overflow-x:auto;scrollbar-width:none}#phone .als div::-webkit-scrollbar{display:none}#phone .als button{flex:none;height:34px;border:0;border-radius:17px;padding:0 13px;background:var(--chip);color:var(--tx);font:inherit;font-weight:700;font-size:13px;white-space:nowrap}';
document.head.appendChild(st);
window.mpSet=(k,v)=>{if(k==='dp')M.ab=0;return _s(k,v)};
window.mpArr=v=>{M.ab=M.ab===v?0:v;if(M.ab)M.dp=0;render('fade-none')};
screens.route=function(){
 const h=String(_r.apply(this,arguments)),i=h.indexOf('<div class="dpc">');if(i<0)return h;
 const T=document.createElement('div');T.innerHTML=h;
 const d=T.querySelector('.dpc'),b=T.querySelector('.rcd.on .rt1 b');if(!d||!b)return h;
 const x=b.textContent.match(/(?:(\d+)\s*h)?\s*(?:(\d+)\s*min)?/)||[],trip=(+x[1]||0)*60+(+x[2]||0);if(!trip)return h;
 const n=new Date(),now=n.getHours()*60+n.getMinutes(),c0=Math.ceil((now+trip+10)/30)*30,opts=[c0,c0+30,c0+60];
 const row=`<div class="abr"><b>Arrive by</b>${opts.map(o=>`<button class="${M.ab===o?'on':''}" onclick="mpArr(${o})">${f(o)}</button>`).join('')}</div>${M.ab?`<div class="abl">Leave at ${f(M.ab-trip)} to arrive by ${f(M.ab)}</div>`:''}`;
 d.insertAdjacentHTML('afterend',row);return T.innerHTML};
screens.place=function(){
 const h=String(_p.apply(this,arguments)),p=(window.POI||[]).find(z=>z.n===PL.n),T=document.createElement('div');
 if(M.exp||!p)return h;T.innerHTML=h;const mo=T.querySelector('.mo');if(!mo)return h;
 const food=p.c==='food'||p.c==='cafe',k=String(p.id).split('').reduce((a,c)=>a+c.charCodeAt(0),0);

/* v632: Coupang Eats / Coupang Eats Delivery Partner. Eats: the tracking page's restaurant line gets "⚡ Cheetah delivery" when the restaurant is a 20-minute-or-less one, matching the mark in the list. Picker (inside the Picker app): the Earnings tab gets a "Settlement" card like the partner app's: when the week's pay lands (every Wednesday), the week's total so far, and a note that cash out to MoMo is free. English only; sample numbers. */
try{(()=>{
const _t=screens.etrack;
screens.etrack=function(){
 const h=String(_t.apply(this,arguments));
 if(typeof REST==='undefined'||!REST[S.er]||!(REST[S.er].tm<=20))return h;
 const T=document.createElement('div');T.innerHTML=h;const e=T.querySelector('#eta'),s=e&&e.nextElementSibling;
 if(!s||s.textContent.indexOf('Cheetah')>=0)return h;
 s.textContent+=' · ⚡ Cheetah delivery';return T.innerHTML};
})()}catch(x){console.error('coupang-v632',x)}

/* v637: Coupang Eats / Partner. Eats: the restaurant page's delivery-time line gets "⚡ Cheetah" for 20-minute-or-less restaurants, like the list. Picker (inside the Picker app): Earnings (today) shows how long you have been on duty. Business (inside the Business app): "Stop orders at" chips (Off, 18:00, 20:00, 22:00) under Busy mode; at that time Accepting orders turns off by itself and a toast says so. English only; sample behaviour. */
try{(()=>{
const _e=screens.erest;
screens.erest=function(){
 const h=String(_e.apply(this,arguments));
 try{const r=REST[S.er];if(!r||!(r.tm<=20)||h.indexOf('Cheetah')>=0)return h;
 const T=document.createElement('div');T.innerHTML=h;
 const x=[...T.querySelectorAll('.sm.mu,.mu.sm,div,span')].find(n=>!n.children.length&&/\d+\s*(-\s*\d+\s*)?min/.test(n.textContent)&&n.textContent.length<60);
 if(!x)return h;x.textContent+=' · ⚡ Cheetah';return T.innerHTML}catch(e){return h}};
})()}catch(x){console.error('coupang-v637',x)}
</script>
<script>try{document.title=document.title.replace(/v\d+/,'v638')}catch(e){}</script>
<style id="ez639">
/* v639: Eats home, quiet like Shop. One search row, one address/mode line, one chip strip, one promo, four shortcuts, one 2-column feed. */
#phone .ez-top{position:sticky;top:0;z-index:6;background:var(--bg);padding:8px 12px 6px 8px;display:flex;align-items:center;gap:4px}
#phone .ez-ib{position:relative;width:44px;height:44px;border:0;background:none;display:flex;align-items:center;justify-content:center;color:var(--tx);flex:none}
#phone .ez-bd{position:absolute;top:5px;right:3px;min-width:18px;height:18px;border-radius:9px;background:var(--br);color:var(--on);font-size:11px;font-weight:800;display:flex;align-items:center;justify-content:center;padding:0 5px}
#phone .ez-sr{flex:1;min-width:0;height:44px;border-radius:14px;background:var(--chip);display:flex;align-items:center;gap:10px;padding:0 14px;color:var(--mu)}
#phone .ez-sr input{flex:1;min-width:0;height:100%;border:0!important;border-radius:0!important;padding:0!important;margin:0;background:transparent!important;box-shadow:none!important;font:inherit;font-size:15px;color:var(--tx);outline:none;-webkit-appearance:none;appearance:none}
#phone .ez-line{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:6px 24px 0}
#phone .ez-ad{border:0;background:none;font:inherit;color:var(--tx);display:flex;align-items:center;gap:4px;min-height:44px;padding:0;min-width:0;text-align:left}
#phone .ez-ad span{font-size:14px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#phone .ez-ad small{color:var(--mu);font-weight:600;font-size:14px;flex:none}
#phone .ez-md{display:flex;gap:2px;flex:none;background:var(--chip);border-radius:16px;padding:3px}
#phone .ez-md button{border:0;background:none;font:inherit;font-size:13px;font-weight:700;color:var(--mu);height:32px;padding:0 10px;border-radius:13px}
#phone .ez-md button.on{background:var(--bg);color:var(--tx);box-shadow:0 1px 2px rgba(0,0,0,.08)}
#phone .ez-tabs{display:flex;gap:4px;overflow-x:auto;padding:4px 16px 0;scrollbar-width:none}
#phone .ez-tabs::-webkit-scrollbar{display:none}
#phone .ez-tabs button{flex:none;border:0;background:none;font:inherit;font-size:16px;font-weight:700;color:var(--mu);height:44px;padding:0 14px;border-radius:14px;white-space:nowrap}
#phone .ez-tabs button.on{background:var(--chip);color:var(--tx);font-weight:800}
#phone .ez-promo{margin:10px 24px 0;border:0;width:calc(100% - 48px);border-radius:20px;padding:16px 18px;display:flex;align-items:center;gap:12px;text-align:left;font:inherit;color:#191F28;background:#FFE08A}
#phone .ez-promo b{display:block;font-size:17px;line-height:23px;font-weight:800;letter-spacing:-.3px}
#phone .ez-promo small{display:block;font-size:13px;font-weight:600;margin-top:2px;color:#3B4350}
#phone .ez-sc{display:grid;grid-template-columns:repeat(4,1fr);gap:4px;padding:18px 12px 0}
#phone .ez-sc button{border:0;background:none;font:inherit;color:var(--tx);display:flex;flex-direction:column;align-items:center;gap:6px;padding:0;min-width:0}
#phone .ez-sc i{width:56px;height:56px;border-radius:20px;background:var(--chip);display:flex;align-items:center;justify-content:center}
#phone .ez-sc button.on i{background:var(--tint)}
#phone .ez-sc span{font-size:12px;font-weight:700;max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
#phone .ez-h{display:flex;align-items:baseline;justify-content:space-between;padding:24px 24px 10px;font-size:19px;font-weight:800;letter-spacing:-.4px}
#phone .ez-h span{font-size:13px;font-weight:600;color:var(--mu);letter-spacing:0}
#phone .ez-rail{display:flex;gap:12px;overflow-x:auto;padding:0 24px;scrollbar-width:none}
#phone .ez-rail::-webkit-scrollbar{display:none}
#phone .ez-rail .ez-c{flex:none;width:132px}
#phone .ez-fl{display:flex;gap:8px;overflow-x:auto;padding:0 24px 14px;scrollbar-width:none;align-items:center}
#phone .ez-fl::-webkit-scrollbar{display:none}
#phone .ez-fl button{flex:none;border:0;background:var(--chip);color:var(--mu);font:inherit;font-size:14px;font-weight:700;height:36px;padding:0 14px;border-radius:18px;white-space:nowrap}
#phone .ez-fl button.on{background:var(--tint);color:var(--tintfg)}
#phone .ez-fl hr{flex:none;width:1px;height:20px;border:0;background:var(--ln,rgba(128,128,128,.25));margin:0 2px}
#phone .ez-g{display:grid;grid-template-columns:1fr 1fr;gap:20px 12px;padding:0 20px}
#phone .ez-c{border:0;background:none;padding:0;font:inherit;color:var(--tx);text-align:left;min-width:0;cursor:pointer}
#phone .ez-cv{position:relative;aspect-ratio:1/1;border-radius:20px;display:flex;align-items:center;justify-content:center;overflow:hidden}
#phone .ez-rail .ez-cv{aspect-ratio:4/3}
#phone .ez-c.cl .ez-cv{opacity:.45}
#phone .ez-tg{position:absolute;left:8px;top:8px;background:var(--bg);color:var(--tx);font-size:11px;font-weight:800;padding:3px 8px;border-radius:10px}
#phone .ez-hr{position:absolute;right:8px;bottom:8px;width:36px;height:36px;border-radius:18px;background:var(--bg);border:0;display:flex;align-items:center;justify-content:center;padding:0}
#phone .ez-hr svg{width:20px;height:20px}
#phone .ez-cl{position:absolute;left:8px;bottom:8px;background:var(--bg);color:var(--tx);font-size:12px;font-weight:800;padding:4px 10px;border-radius:12px}
#phone .ez-n{margin-top:8px;font-size:15px;font-weight:700;line-height:20px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#phone .ez-m{margin-top:1px;font-size:13px;color:var(--mu);font-weight:600;font-variant-numeric:tabular-nums;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#phone .ez-m b{color:var(--tx);font-weight:700}
#phone .ez-m .g{color:var(--tintfg);font-weight:800}
#phone .ez-em{padding:48px 24px;text-align:center;color:var(--mu)}
#phone .ez-em button{margin-top:14px;border:0;background:var(--tint);color:var(--tintfg);font:inherit;font-weight:800;height:40px;padding:0 18px;border-radius:20px}
#phone .ez-fine{padding:24px 24px 28px;font-size:12px;color:var(--tt);text-align:center}
</style>
<script>
/* v639: Eats home, quiet like Shop (see the v639 style block). Same state and handlers as before (S.e2cat, S.e2sort, S.e2flt, S.pickup, S.efav); only the layout changes. Club and Coupons move into a four-tile shortcut row, the carousel becomes one promo, the four repeating rails go, and the list is a 2-column grid like Shop. */
try{(()=>{
if(typeof screens==='undefined'||typeof REST==='undefined')return;
const T=(e,f,r)=>({en:e,fr:f,rw:r}[S.lang]||e);
const esc=s=>String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/"/g,'&quot;');
const addr=()=>(S.eaddrs&&S.eaddrs[S.eai])||['Home','Kimironko, KG 11 Ave','Kimironko, Kigali'];
const CATS=()=>[['All',T('All','Tout','Byose')],['Brochette','Brochette','Brochette'],['Chicken',T('Chicken','Poulet','Inkoko')],['Pizza','Pizza','Pizza'],['Burgers','Burgers','Burger'],['Local',T('Local','Local','Iwacu')],['Chips',T('Chips','Frites','Chips')],['Bakery',T('Bakery','Boulangerie','Ifuru')],['Coffee',T('Coffee','Café','Ikawa')],['Juice',T('Juice','Jus','Umutobe')],['Healthy','Healthy','Ubuzima'],['Dessert','Dessert','Ibiryoshye']];
const sorters={fast:(a,b)=>a.tm-b.tm,rating:(a,b)=>b.r-a.r||b.rc-a.rc,free:(a,b)=>a.fee-b.fee||a.tm-b.tm,near:(a,b)=>a.d-b.d};
const matches=r=>{const q=S.e2q;if(!q)return true;return (r.n+' '+r.sub+' '+r.cats.join(' ')+' '+r.items.map(x=>x[0]).join(' ')).toLowerCase().includes(q)};
const list=()=>{const f=S.e2flt||{},c=S.e2cat||'All';return REST.map((r,i)=>[r,i]).filter(([r,i])=>(c==='All'||r.cats.includes(c))&&!(f.open&&r.closed)&&!(f.fav&&!S.efav[i])&&matches(r)).sort((a,b)=>(!!a[0].closed-!!b[0].closed)||sorters[S.e2sort||'fast'](a[0],b[0]))};
const isF=()=>(S.e2cat&&S.e2cat!=='All')||S.e2q||(S.e2flt&&(S.e2flt.open||S.e2flt.fav));
const eta=r=>S.pickup?Math.max(10,r.tm-10)+' min':r.tm+' min';
const fee=r=>S.pickup?'':(r.fee?T('Delivery','Livraison','Gutwara')+' '+fmt(r.fee):'<span class="g">'+T('Free delivery','Livraison gratuite','Ku buntu')+'</span>');
const tagOf=r=>r.closed?'':r.tag==='20% off'?T('20% off','-20 %','-20%'):r.tag==='New'?T('New','Nouveau','Gishya'):r.tag==='Popular'?T('Popular','Populaire','Bikunzwe'):'';
const star='<svg width="12" height="12" viewBox="0 0 24 24" fill="#F5A524" aria-hidden="true" style="vertical-align:-1px"><path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9z"/></svg>';
const card=([r,i],rail)=>{const t=tagOf(r),on=!!S.efav[i];
 return `<div class="ez-c tap${r.closed?' cl':''}" role="button" tabindex="0" onclick="openERest(${i})" onkeydown="if(event.key==='Enter')openERest(${i})" aria-label="${esc(r.n)}"><div class="ez-cv" style="background:${r.bg}">${gl(r.g,rail?60:84)}${t?`<span class="ez-tg">${esc(t)}</span>`:''}${r.closed?`<span class="ez-cl">${T('Back at '+r.closed,'Réouvre à '+r.closed,'Irafungura saa '+r.closed)}</span>`:''}<button class="ez-hr" aria-label="${T('Save','Enregistrer','Bika')}" aria-pressed="${on}" onclick="event.stopPropagation();ezFav(${i})">${heart(on)}</button></div><div class="ez-n">${esc(r.n)}</div><div class="ez-m">${star} <b>${r.r.toFixed(1)}</b> (${r.rc}) · ${eta(r)}</div>${rail?'':`<div class="ez-m">${fee(r)||T('Pickup','Retrait','Gufata')}</div>`}</div>`};
const again=()=>{const seen=new Set(),o=[];(S.orders||[]).filter(x=>x.k==='Eats order'&&x.items&&REST[x.r]).forEach(x=>{if(!seen.has(x.r)){seen.add(x.r);o.push([REST[x.r],x.r])}});return o.slice(0,6)};
const listHtml=L=>L.length?L.map(x=>card(x)).join(''):`<div class="ez-em" style="grid-column:1/-1">${T('No restaurants match.','Aucun restaurant trouvé.','Nta resitora ibonetse.')}<br><button onclick="e2Clear()">${T('Clear filters','Effacer les filtres','Siba akayunguruzo')}</button></div>`;
const promo=()=>{if(S.epromo)return '';const p=S.pickup?{bg:'#CFE8FF',t:T('20% off your meal','20 % de réduction','Igabanywa rya 20%'),s:T('Up to 2,000 RWF with EATS20','Jusqu’à 2 000 RWF avec EATS20','Kugeza 2,000 RWF na EATS20'),g:'voucher',a:"e2Promo('EATS20')"}:{bg:'#FFE08A',t:T('Free delivery on your first order','Livraison offerte dès la 1re commande','Kugezwaho ku buntu ku itegeko rya mbere'),s:T('Code FREEDEL, applied at checkout','Code FREEDEL, appliqué au paiement','Kode FREEDEL'),g:'gift',a:"e2Promo('FREEDEL')"};
 return `<button class="ez-promo tap" style="background:${p.bg}" onclick="${p.a}"><span style="flex:1;min-width:0"><b>${p.t}</b><small>${p.s}</small></span>${gl(p.g,52)}</button>`};
const home=()=>{
 const a=addr(),n=eCount(),L=list(),pk=!!S.pickup,fl=S.e2flt||(S.e2flt={open:0,top:0,near:0,fav:0}),cat=S.e2cat||'All',srt=S.e2sort||'fast',ar=again();
 const sb=(k,l)=>`<button class="${srt===k?'on':''}" aria-pressed="${srt===k}" onclick="e2Sort('${k}')">${l}</button>`;
 const fast=REST.map((r,i)=>[r,i]).filter(x=>!x[0].closed&&x[0].tm<=20).sort((x,y)=>x[0].tm-y[0].tm);
 return `<div class="ez-top"><button class="ez-ib" aria-label="${T('Back','Retour','Subira inyuma')}" onclick="back()">${ic('back',24)}</button><label class="ez-sr">${ic('search',20)}<input id="e2q" type="search" enterkeyhint="search" aria-label="${T('Search restaurants','Rechercher','Shakisha')}" placeholder="${T('Search restaurants','Rechercher','Shakisha resitora')}" value="${esc(S.e2q||'')}" oninput="ezSearch(this.value)"></label><button class="ez-ib" aria-label="${T('Orders','Commandes','Ibyatumijwe')}" onclick="S.stack=['shop','eorders'];render('push')"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3h12v18l-3-2-3 2-3-2-3 2z"/><path d="M9 8h6M9 12h6"/></svg></button><button class="ez-ib" aria-label="${T('Cart','Panier','Agaseke')}" onclick="${n?'eCart()':`toast('${T('Your cart is empty','Votre panier est vide','Agaseke karimo ubusa')}')`}">${ic('bag',24)}${n?`<span class="ez-bd">${n}</span>`:''}</button></div>
<div class="ez-line"><button class="ez-ad" onclick="eAddr()" aria-label="${T('Change delivery address','Changer l’adresse','Hindura aderesi')}"><span>${esc(a[1])}</span>${ic('chev',16,'var(--tt)').replace('<svg','<svg style="transform:rotate(90deg);flex:none"')}</button><div class="ez-md" role="group"><button class="${pk?'':'on'}" aria-pressed="${!pk}" onclick="e2Pk(false)">${T('Delivery','Livraison','Gutwara')}</button><button class="${pk?'on':''}" aria-pressed="${pk}" onclick="e2Pk(true)">${T('Pickup','Retrait','Gufata')}</button></div></div>
<div class="ez-tabs" role="group" aria-label="${T('Categories','Catégories','Ibyiciro')}">${CATS().map(([k,l])=>`<button class="${cat===k?'on':''}" aria-pressed="${cat===k}" onclick="e2Cat('${k}')">${l}</button>`).join('')}</div>
${isF()?'':`${promo()}<div class="ez-sc"><button onclick="e2Fast()"><i>${gl('moto',34)}</i><span>${T('Fastest','Rapides','Byihuse')}</span></button><button onclick="e2Cp()"><i>${gl('voucher',34)}</i><span>${T('Coupons','Coupons','Kuponi')}${S.epromo?' ✓':''}</span></button><button onclick="clubSheet()"><i>${gl('gift',34)}</i><span>${S.club?T('Club ✓','Club ✓','Club ✓'):T('Eats Club','Eats Club','Eats Club')}</span></button><button class="${fl.fav?'on':''}" onclick="e2Flt('fav')"><i>${gl('heartred',34)}</i><span>${T('Saved','Favoris','Ibyabitswe')}</span></button></div>
${ar.length?`<div class="ez-h"><b>${T('Order again','Commander à nouveau','Tegeka nanone')}</b></div><div class="ez-rail">${ar.map(x=>card(x,1)).join('')}</div>`:''}`}
<div class="ez-h" id="e2all"><b>${isF()?T('Results','Résultats','Ibyabonetse'):T('Restaurants near you','Restaurants près de vous','Resitora ziri hafi yawe')}</b><span id="e2n">${L.length}</span></div>
<div class="ez-fl" role="group" aria-label="${T('Sort and filter','Trier et filtrer','Tondeka')}">${sb('fast',T('Fastest','Plus rapide','Byihuse'))}${sb('rating',T('Top rated','Mieux notés','Bikunzwe'))}${sb('free',T('Free delivery','Gratuite','Ku buntu'))}${sb('near',T('Nearest','Plus proche','Hafi'))}<hr><button class="${fl.open?'on':''}" aria-pressed="${!!fl.open}" onclick="e2Flt('open')">${T('Open now','Ouvert','Irakinguye')}</button></div>
<div class="ez-g" id="e2list">${listHtml(L)}</div>
<div class="ez-fine">${T('Menus, prices and ratings are sample data.','Menus, prix et notes : données d’exemple.','Menu, ibiciro n’amanota ni urugero.')}</div>${n&&REST[S.er]?`<div class="cta"><button class="e2-cta" onclick="eCart()" aria-label="${T('View cart','Voir le panier','Reba agaseke')}"><span class="n">${n}</span><span class="l">${T('View cart','Voir le panier','Reba agaseke')} · ${esc(REST[S.er].n)}</span><span class="t">${fmt(eSub())} RWF</span></button></div>`:''}`};
const redraw=()=>{const l=document.getElementById('e2list');if(!l)return;const L=list();l.innerHTML=listHtml(L);const c=document.getElementById('e2n');if(c)c.textContent=L.length};
window.ezSearch=v=>{const was=!!isF();S.e2q=v.trim().toLowerCase();if(!!isF()!==was){const pos=v.length;window.e2Rr&&window.e2Rr();const i=document.getElementById('e2q');if(i){i.focus();try{i.setSelectionRange(pos,pos)}catch(e){}}}else redraw()};
window.ezFav=i=>{S.efav[i]=!S.efav[i];window.e2Rr&&window.e2Rr()};
window.e2Cat=c=>{S.e2cat=c;window.e2Rr&&window.e2Rr()};
window.e2Fast=()=>{S.e2sort='fast';window.e2Rr&&window.e2Rr();const t=document.getElementById('e2all'),sc=document.getElementById('sc');if(t&&sc)sc.scrollTo({top:Math.max(0,t.offsetTop-70),behavior:'smooth'})};
const _s=screens.shop;
screens.shop=function(){if(S.shopTab!=='eats')return _s.apply(this,arguments);S.addrOk=true;try{return home()}catch(e){console.error('ez639',e);return _s.apply(this,arguments)}};
})()}catch(x){console.error('eats-v639',x)}
document.title=document.title.replace(/v\d+/,'v639');
</script>
<style id="ez640">
/* v640: Eats restaurant page, quiet. Stats box becomes one line, big Delivery/Pickup buttons become the small switch from the list, Group order becomes a text row, repeated "Popular" badges go. */
#phone .ez-meta{padding:6px 24px 0;font-size:14px;font-weight:600;color:var(--mu);font-variant-numeric:tabular-nums}
#phone .ez-meta b{color:var(--tx);font-weight:800}
#phone .ez-rmd{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px 24px 0}
#phone .ez-grp{border:0;background:none;font:inherit;font-size:14px;font-weight:700;color:var(--tintfg);min-height:44px;padding:0;display:flex;align-items:center;gap:4px}
#phone .e2-bt{display:none!important}
</style>
<script>
/* v640: see the v640 style block. Same handlers (e2Pk, group order) as before. */
try{(()=>{
if(typeof screens==='undefined'||!screens.erest)return;
const T=(e,f,r)=>({en:e,fr:f,rw:r}[S.lang]||e);
const _e=screens.erest;
screens.erest=function(){
 const h=String(_e.apply(this,arguments));
 try{
  const D=document.createElement('div');D.innerHTML=h;
  const st=D.querySelector('.e2-st'),md=D.querySelector('.e2-mode');
  if(!st||!md||D.querySelector('.ez-meta'))return h;
  const v=[...st.querySelectorAll('b')].map(x=>x.textContent.trim());
  const lb=[...st.querySelectorAll('small')].map(x=>x.textContent.trim());
  const meta=document.createElement('div');meta.className='ez-meta';
  meta.innerHTML=v.map((x,i)=>i===0?'<b>'+x+'</b>':lb[i].replace(/^Min order$/,'Min').replace(/^Fee$/,'Fee')+' '+x.replace(' RWF','')).join(' · ');
  const on=!!S.pickup;
  const grpBtn=md.nextElementSibling&&md.nextElementSibling.querySelector('button[onclick]');
  const row=document.createElement('div');row.className='ez-rmd';
  row.innerHTML='<div class="ez-md" role="group"><button class="'+(on?'':'on')+'" aria-pressed="'+!on+'" onclick="e2Pk(false)">'+T('Delivery','Livraison','Gutwara')+'</button><button class="'+(on?'on':'')+'" aria-pressed="'+on+'" onclick="e2Pk(true)">'+T('Pickup','Retrait','Gufata')+'</button></div>'+(grpBtn?'<button class="ez-grp" onclick="'+grpBtn.getAttribute('onclick').replace(/"/g,'&quot;')+'">'+T('Group order','Commande groupée','Gutumiza hamwe')+' ›</button>':'');
  st.replaceWith(meta);md.replaceWith(row);
  if(grpBtn){const w=grpBtn.parentElement;if(w&&w.parentElement)w.remove()}
  return D.innerHTML;
 }catch(e){return h}};
})()}catch(x){console.error('eats-v640',x)}
document.title=document.title.replace(/v\d+/,'v640');
</script>
<style id="ez641">
/* v641: Eats cart. The delivery address and the Delivery/Pickup choice were hidden by an old rule (v431), so checkout never said where the food goes. They come back as one slim block at the top; delivery-time chips line up with the other sections. */
#phone .ez-ck{padding:0 0 18px}
#phone .ez-ck .ez-md{display:inline-flex}
#phone .ez-ckad{width:100%;border:0;background:var(--chip);border-radius:16px;margin-top:12px;min-height:56px;padding:10px 14px;display:flex;align-items:center;gap:12px;font:inherit;color:var(--tx);text-align:left}
#phone .ez-ckad span.t{flex:1;min-width:0}
#phone .ez-ckad small{display:block;font-size:12px;font-weight:600;color:var(--mu)}
#phone .ez-ckad b{display:block;font-size:15px;font-weight:800;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#phone .ez-ckad em{font-style:normal;font-size:14px;font-weight:700;color:var(--tintfg);flex:none}
#phone .screen:has(#enote) .pad .chips{padding-left:0!important;padding-right:0!important}
</style>
<script>
/* v641: see the v641 style block. Uses the existing handlers (setPickup, eAddr). */
try{(()=>{
if(typeof screens==='undefined'||!screens.echeck)return;
const T=(e,f,r)=>({en:e,fr:f,rw:r}[S.lang]||e);
const esc=s=>String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/"/g,'&quot;');
const _c=screens.echeck;
screens.echeck=function(){
 const h=String(_c.apply(this,arguments));
 try{
  if(h.indexOf('ez-ck')>=0)return h;
  const D=document.createElement('div');D.innerHTML=h;
  const pads=[...D.querySelectorAll('.pad')];
  const first=pads.find(p=>p.textContent.indexOf('Your order')>=0||p.querySelector('.e2-ct'))||pads[0];
  if(!first)return h;
  const r=REST[S.er],a=(S.eaddrs&&S.eaddrs[S.eai])||['Home','Kimironko, KG 11 Ave'],pk=!!S.pickup;
  const b=document.createElement('div');b.className='ez-ck';
  b.innerHTML='<div class="ez-md" role="group"><button class="'+(pk?'':'on')+'" aria-pressed="'+!pk+'" onclick="setPickup(false);render(\'fade-none\')">'+T('Delivery','Livraison','Gutwara')+'</button><button class="'+(pk?'on':'')+'" aria-pressed="'+pk+'" onclick="setPickup(true);render(\'fade-none\')">'+T('Pickup','Retrait','Gufata')+'</button></div>'+
   (pk?'<div class="ez-ckad" style="cursor:default"><span class="t"><small>'+T('Pick up at','Retrait à','Gufatira')+'</small><b>'+esc((r&&r.addr)||'')+'</b></span></div>'
      :'<button class="ez-ckad tap" onclick="eAddr()"><span class="t"><small>'+T('Deliver to','Livrer à','Kugezwaho')+'</small><b>'+esc(a[1])+'</b></span><em>'+T('Change','Changer','Hindura')+'</em></button>');
  first.insertBefore(b,first.firstChild);
  return D.innerHTML;
 }catch(e){return h}};
})()}catch(x){console.error('eats-v641',x)}
document.title=document.title.replace(/v\d+/,'v641');
</script>
<style id="ez642">
/* v642: Eats tracking, quiet. The 4-step vertical list becomes a slim 4-segment progress bar (same #tl0..#tl3 elements, so the live updates still work), the subtitle drops the address, and the rider actions line up as plain buttons. */
#phone .pad#tls{display:grid!important;grid-template-columns:repeat(4,1fr);gap:6px;padding-top:16px!important}
#phone #tls .tl{display:flex!important;flex-direction:column;align-items:flex-start;gap:7px;padding:0!important;min-height:0!important;height:auto!important;font-size:12px!important;font-weight:700;line-height:16px;color:var(--mu)}
#phone #tls .tl i{display:block!important;width:100%!important;height:4px!important;border-radius:2px!important;background:var(--chip)!important;border:0!important;padding:0!important}
#phone #tls .tl i svg{display:none!important}
#phone #tls .tl.done i,#phone #tls .tl.on i{background:var(--br)!important}
#phone #tls .tl.on{color:var(--tx);font-weight:800}
#phone #tls .tl.done{color:var(--tx)}
#phone #etx .chips{padding:6px 0 0!important;gap:8px}
#phone #etx .chips button{flex:1;height:48px;border-radius:14px}
#phone #etx .cch.on{background:var(--chip)!important;color:var(--tx)!important}
#phone #etx button[onclick*="Cancel"]{background:none!important}
</style>
<script>
/* v642: see the v642 style block. */
try{(()=>{
if(typeof screens==='undefined'||!screens.etrack)return;
const _t=screens.etrack;
screens.etrack=function(){
 const h=String(_t.apply(this,arguments));
 try{return h.replace(/( · to [^<·]*?)( · ⚡|<\/div>)/,'$2')}catch(e){return h}};
})()}catch(x){console.error('eats-v642',x)}
document.title=document.title.replace(/v\d+/,'v642');
</script>
<style id="ez643">
/* v643: Eats. (1) "Order again" tiles show name and time without cutting them off. (2) Orders: the three actions line up as equal buttons, and an order still in progress gets a Track button. */
#phone .ez-rail .ez-c{width:148px}
#phone .screen:has([onclick^="eReorder"]) .chips{display:flex!important;gap:8px;padding-left:0!important;padding-right:0!important;margin-left:0!important;width:100%!important;overflow:visible!important}
#phone .screen:has([onclick^="eReorder"]) .chips button{flex:1 1 0!important;min-width:0!important;white-space:nowrap;padding:0 6px!important;height:44px;border-radius:14px;background:var(--bg);color:var(--tx);font-weight:700}
#phone .screen:has([onclick^="eReorder"]) .chips button.on{background:var(--on);color:var(--bg)}
#phone .screen:has([onclick^="eReorder"]) .chips button.ez-trk{background:var(--br);color:var(--on)}
</style>
<script>
/* v643: see the v643 style block. */
try{(()=>{
if(typeof screens==='undefined')return;
const T=(e,f,r)=>({en:e,fr:f,rw:r}[S.lang]||e);
const _s=screens.shop;
screens.shop=function(){
 const h=String(_s.apply(this,arguments));
 if(S.shopTab!=='eats'||h.indexOf('ez-rail')<0)return h;
 try{const D=document.createElement('div');D.innerHTML=h;
  D.querySelectorAll('.ez-rail .ez-m').forEach(m=>{m.innerHTML=m.innerHTML.replace(/\s*<\/b>\s*\(\d+\)/,'</b>')});
  return D.innerHTML}catch(e){return h}};
if(screens.eorders){const _o=screens.eorders;
 screens.eorders=function(){
  const h=String(_o.apply(this,arguments));
  try{
   const cur=(S.orders||[]).find(o=>o.k==='Eats order'&&o.items);
   if(!cur||/Delivered|Picked up|Cancel/i.test(cur.s||''))return h;
   const D=document.createElement('div');D.innerHTML=h;
   const first=D.querySelector('.chips button[onclick^="eReorder"]');
   if(!first||D.querySelector('.ez-trk'))return h;
   const b=document.createElement('button');b.className='cch ez-trk';b.setAttribute('onclick',"S.stack=['shop','etrack'];render('push')");
   b.textContent=T('Track','Suivre','Kurikirana');
   first.parentNode.insertBefore(b,first);first.classList.remove('on');
   return D.innerHTML}catch(e){return h}};}
})()}catch(x){console.error('eats-v643',x)}
document.title=document.title.replace(/v\d+/,'v643');
</script>
<style id="ez644">
/* v644: Eats dish sheet, like a shopping product page. Big picture on top, name and price under it, add-ons as rows, and one bottom bar with the quantity stepper next to "Add to cart". */
#phone .ez-pd .ez-pic{height:168px;border-radius:22px;display:flex;align-items:center;justify-content:center;margin:2px 0 14px;overflow:hidden}
#phone .ez-pd .ez-pn{display:flex;flex-direction:column;gap:2px}
#phone .ez-pd .ez-pn .h1{font-size:22px;line-height:28px;margin:0}
#phone .ez-pd .ez-pn b{font-size:18px;font-weight:800;white-space:nowrap}
#phone .ez-pd .chips{justify-content:flex-start!important;padding-left:0!important;height:auto!important;margin:0!important}
#phone .ez-pd .v6cta{display:flex!important;align-items:center;gap:12px}
#phone .ez-pd .v6cta .btn{flex:1;min-width:0;white-space:nowrap;font-size:14px;padding:0 6px;overflow:hidden;text-overflow:ellipsis}
#phone .ez-pd .ez-q{display:flex;align-items:center;gap:2px;margin:0!important;flex:none;background:var(--chip);border-radius:26px;padding:4px}
#phone .ez-pd .ez-q button{width:44px!important;height:44px!important;border-radius:22px!important;background:none!important}
#phone .ez-pd .ez-q b{font-size:17px!important;min-width:22px!important;text-align:center}
</style>
<script>
/* v644: see the v644 style block. Moves existing elements, so eIq, eIad, eIp and eIAdd keep working. */
try{(()=>{
const lay=document.getElementById('layer');if(!lay||typeof REST==='undefined')return;
let busy=0;
const fix=()=>{
 const sh=lay.querySelector('.sheet.v6pg');
 if(!sh||sh.classList.contains('ez-pd')||!sh.querySelector('[onclick="eIAdd()"]')||!REST[S.er])return;
 const body=sh.querySelector('.v6b'),cta=sh.querySelector('.v6cta'),top=body&&body.firstElementChild;
 if(!body||!cta||!top||!top.querySelector('.ico'))return;
 busy=1;
 const r=REST[S.er],svg=top.querySelector('.ico svg');
 if(svg){svg.setAttribute('width','120');svg.setAttribute('height','120')}
 const pic=document.createElement('div');pic.className='ez-pic';pic.style.background=r.bg;if(svg)pic.appendChild(svg);
 const h1=top.querySelector('.h1'),price=h1&&h1.nextElementSibling;
 const pn=document.createElement('div');pn.className='ez-pn';
 if(h1)pn.appendChild(h1);if(price){price.removeAttribute('style');pn.appendChild(price)}
 top.replaceWith(pic);pic.insertAdjacentElement('afterend',pn);
 const stp=[...body.children].find(e=>e.querySelector&&e.querySelector('[onclick^="eIq"]'));
 if(stp){stp.className='ez-q';stp.removeAttribute('style');cta.insertBefore(stp,cta.firstChild)}
 const ab=cta.querySelector('.btn');if(ab&&/^Add to cart/.test(ab.textContent))ab.textContent=ab.textContent.replace(/^Add to cart/,'Add');
 sh.classList.add('ez-pd');
 busy=0;
};
new MutationObserver(()=>{if(!busy)try{fix()}catch(e){busy=0}}).observe(lay,{childList:true,subtree:true});
})()}catch(x){console.error('eats-v644',x)}
document.title=document.title.replace(/v\d+/,'v644');
</script>
<style id="ez645">
/* v645: Eats coupons and Club, like a shopping coupon wallet. Coupons show what they are worth, whether one is applied, and there is a code field again (the cart's promo field is hidden). The Club perks get check marks. */
#phone .ez-cp{display:flex;align-items:center;gap:12px;background:var(--chip);border-radius:18px;padding:12px;margin-top:12px}
#phone .ez-cp i{font-style:normal;flex:none;width:56px;height:56px;border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:16px;font-weight:800;color:#191F28;letter-spacing:-.3px}
#phone .ez-cp .t{flex:1;min-width:0}
#phone .ez-cp .t b{display:block;font-size:16px;font-weight:800}
#phone .ez-cp .t small{display:block;font-size:13px;color:var(--mu);margin-top:2px;line-height:17px}
#phone .ez-cp button{flex:none;border:0;font:inherit;font-size:14px;font-weight:800;height:40px;padding:0 16px;border-radius:20px;background:var(--on);color:var(--bg)}
#phone .ez-cp button:disabled{background:var(--bg);color:var(--mu)}
#phone .ez-cp.ap{outline:2px solid var(--br);outline-offset:-2px}
#phone .ez-cp .rm{background:none;color:var(--mu);height:auto;padding:0;font-size:13px;font-weight:700;display:block;margin-top:4px;text-decoration:underline}
#phone .ez-cd{display:flex;gap:8px;margin-top:22px}
#phone .ez-cd input{flex:1;min-width:0;height:48px;border-radius:14px;border:0;background:var(--chip);padding:0 14px;font:inherit;font-size:15px;color:var(--tx);text-transform:uppercase;outline:none}
#phone .ez-cd button{flex:none;border:0;height:48px;padding:0 18px;border-radius:14px;background:var(--on);color:var(--bg);font:inherit;font-weight:800}
#phone .ez-cer{color:#D92D20;font-size:13px;font-weight:700;margin-top:8px;min-height:18px}
#phone .ez-perk{display:flex;align-items:center;gap:12px;padding:9px 0;font-size:16px;font-weight:700}
#phone .ez-perk i{flex:none;width:28px;height:28px;border-radius:14px;background:var(--tint);color:var(--tintfg);display:flex;align-items:center;justify-content:center}
</style>
<script>
/* v645: see the v645 style block. Uses e2Promo for applying, so the saved code works at checkout as before. */
try{(()=>{
const lay=document.getElementById('layer');if(!lay)return;
const T=(e,f,r)=>({en:e,fr:f,rw:r}[S.lang]||e);
const esc=s=>String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/"/g,'&quot;');
const CK='<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5L19 7"/></svg>';
window.ezUse=c=>{closeSheet();e2Promo(c);window.e2Rr&&window.e2Rr()};
window.ezRm=()=>{S.epromo=null;closeSheet();window.e2Rr&&window.e2Rr();toast(T('Coupon removed','Coupon retiré','Kuponi yakuweho'))};
window.ezCode=()=>{const i=document.getElementById('ezcode'),c=(i&&i.value||'').trim().toUpperCase(),er=document.getElementById('ezcer');
 const ok=c==='FREEDEL'||c==='EATS20';
 if(!c){if(er)er.textContent=T('Enter a code first.','Saisissez d’abord un code.','Banza wandike kode.');return}
 if(!ok){if(er)er.textContent=T('Code not valid. Try EATS20.','Code invalide. Essayez EATS20.','Kode ntiyemewe. Gerageza EATS20.');return}
 if(c==='FREEDEL'&&S.pickup){if(er)er.textContent=T('Free delivery only applies to delivery orders.','La livraison gratuite ne s’applique qu’aux livraisons.','Kugezwaho ku buntu bireba gutwarwa gusa.');return}
 ezUse(c)};
const coupons=()=>[
 {c:'FREEDEL',bg:'#FFE08A',v:T('Free','Gratuit','Ku buntu'),t:T('Free delivery','Livraison gratuite','Kugezwaho ku buntu'),s:T('First order · delivery only','1re commande · livraison seulement','Itegeko rya mbere · gutwarwa gusa'),off:!!S.pickup},
 {c:'EATS20',bg:'#CFE8FF',v:'-20%',t:T('20% off your meal','20 % de réduction','Igabanywa rya 20%'),s:T('Up to 2,000 RWF off','Jusqu’à 2 000 RWF','Kugeza 2,000 RWF')}];
const fix=()=>{
 const sh=lay.querySelector('.sheet.v6pg');if(!sh||sh.classList.contains('ez-cs'))return;
 const b=sh.querySelector('.v6b');if(!b)return;
 const h=b.querySelector('.h1'),tx=h?h.textContent.trim():'';
 if(b.querySelector('[onclick*="e2Promo"]')&&/coupon/i.test(tx)){
  b.innerHTML='<div class="h1" style="font-size:22px;line-height:30px">'+esc(h.textContent)+'</div>'+coupons().map(x=>{const ap=S.epromo===x.c;
   return '<div class="ez-cp'+(ap?' ap':'')+'"><i style="background:'+x.bg+'">'+x.v+'</i><div class="t"><b>'+x.t+'</b><small>'+x.s+' · '+x.c+'</small>'+(ap?'<button class="rm" onclick="ezRm()">'+T('Remove','Retirer','Kuramo')+'</button>':'')+'</div>'+
   (ap?'<button disabled>'+T('Applied','Appliqué','Byakoreshejwe')+' ✓</button>':x.off?'<button disabled>'+T('Delivery only','Livraison','Gutwarwa')+'</button>':'<button onclick="ezUse(\''+x.c+'\')">'+T('Use','Utiliser','Koresha')+'</button>')+'</div>'}).join('')+
   '<div class="ez-cd"><input id="ezcode" placeholder="'+T('Enter a code','Saisir un code','Andika kode')+'" aria-label="'+T('Promo code','Code promo','Kode')+'" autocapitalize="characters" onkeydown="if(event.key===\'Enter\')ezCode()"><button onclick="ezCode()">'+T('Apply','Appliquer','Emeza')+'</button></div><div class="ez-cer" id="ezcer" role="status"></div>';
  sh.classList.add('ez-cs');return}
 if(b.querySelector('[onclick^="clubGo"]')||sh.querySelector('[onclick^="clubGo"]')){
  b.querySelectorAll('.row').forEach(r=>{const t=r.querySelector('.t');if(!t)return;const d=document.createElement('div');d.className='ez-perk';d.innerHTML='<i>'+CK+'</i><span>'+esc(t.textContent)+'</span>';r.replaceWith(d)});
  sh.classList.add('ez-cs')}
};
new MutationObserver(()=>{try{fix()}catch(e){}}).observe(lay,{childList:true,subtree:true});
})()}catch(x){console.error('eats-v645',x)}
document.title=document.title.replace(/v\d+/,'v645');
</script>
<style id="ez646">
/* v646: Eats borrows from Shop. Ranked "Popular this week" rail (like Best sellers) and reviews with Helpful votes, a sort, and the dish ordered (like product reviews). Plain text, no new boxes or lines. */
#phone .ez-rk{position:relative;flex:none;width:132px}
#phone .ez-rk>b{position:absolute;left:10px;top:4px;z-index:2;font-size:26px;line-height:30px;font-style:italic;font-weight:800;color:var(--tx);text-shadow:0 0 6px var(--bg),0 0 2px var(--bg)}
#phone .ez-rv-s{display:flex;gap:18px;padding:14px 24px 0}
#phone .ez-rv-s button{border:0;background:none!important;font:inherit;font-size:15px;font-weight:700;color:var(--mu);min-height:44px;padding:0}
#phone .ez-rv-s button.on{color:var(--tx);font-weight:800}
#phone .ez-rv2{padding:16px 24px 0}
#phone .ez-rv2 .ez-rh{display:flex;justify-content:space-between;align-items:baseline}
#phone .ez-rv2 .ez-ro{font-size:13px;color:var(--mu);font-weight:600;margin-top:2px}
#phone .ez-rv2 .ez-rx{font-size:15px;line-height:22px;margin-top:6px;font-weight:400}
#phone .ez-rv2 button.ez-hp{border:0;background:none!important;box-shadow:none;font:inherit;font-size:14px;font-weight:700;color:var(--mu);min-height:44px;padding:0;border-radius:0;width:auto}
#phone .ez-rv2 button.ez-hp.on{color:var(--tintfg)}
</style>
<script>
try{(()=>{
if(typeof screens==='undefined'||typeof REST==='undefined'||!screens.erest)return;
const T=(e,f,r)=>({en:e,fr:f,rw:r}[S.lang]||e);
const esc=s=>String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/"/g,'&quot;');
S.ervH=S.ervH||{};S.ervS=S.ervS||'new';
const keep=fn=>{const sc=document.getElementById('sc'),t=sc?sc.scrollTop:0;fn();render('fade-none');const z=document.getElementById('sc');if(z)z.scrollTop=t};
window.ezRvS=k=>keep(()=>{S.ervS=k});
window.ezRvH=k=>keep(()=>{S.ervH[k]=!S.ervH[k]});
const RV=/<div class="e2-rv"><div style="display:flex;justify-content:space-between"><b>([^<]*)<\/b><span class="sm mu">([^<]*)<\/span><\/div><div style="font-weight:800;font-size:14px;margin:2px 0;color:#F5A524">(★*)<span[^>]*>(★*)<\/span><\/div><div style="font-size:15px;line-height:21px">([^<]*)<\/div><\/div>/g;
const _e=screens.erest;
screens.erest=function(){const h=_e.apply(this,arguments);try{
 if(S.etab!=='reviews'||h.includes('ez-rv2'))return h;
 const r=REST[S.er];if(!r)return h;
 const dishes=r.items.filter(x=>x[4]!=='addon');
 const L=[];let first=-1;
 h.replace(RV,(m,n,d,s1,s2,t,off)=>{if(first<0)first=off;L.push({n,d,s:s1.length,t,k:S.er+'-'+L.length,h:(n.length*3+s1.length*2)%9+1,dish:dishes.length?dishes[(n.length+L.length*2)%dishes.length][0]:''});return m});
 if(!L.length)return h;
 const hc=v=>v.h+(S.ervH[v.k]?1:0);
 const rows=S.ervS==='help'?[...L].sort((a,b)=>hc(b)-hc(a)):L;
 const bar=`<div class="ez-rv-s" role="group" aria-label="${T('Sort reviews','Trier les avis','Tondeka ibitekerezo')}"><button class="${S.ervS==='help'?'':'on'}" aria-pressed="${S.ervS!=='help'}" onclick="ezRvS('new')">${T('Latest','Récents','Bishya')}</button><button class="${S.ervS==='help'?'on':''}" aria-pressed="${S.ervS==='help'}" onclick="ezRvS('help')">${T('Most helpful','Plus utiles','Bifasha cyane')}</button></div>`;
 const html=bar+rows.map(v=>`<div class="ez-rv2"><div class="ez-rh"><b>${esc(v.n)}</b><span class="sm mu">${esc(v.d)}</span></div><div style="font-weight:800;font-size:14px;margin:2px 0;color:#F5A524">${'★'.repeat(v.s)}<span style="color:var(--ln)">${'★'.repeat(5-v.s)}</span></div>${v.dish?`<div class="ez-ro">${T('Ordered','A commandé','Yatumije')} ${esc(v.dish)}</div>`:''}<div class="ez-rx">${esc(v.t)}</div><button class="ez-hp ${S.ervH[v.k]?'on':''}" aria-pressed="${!!S.ervH[v.k]}" onclick="ezRvH('${v.k}')">${T('Helpful','Utile','Bifasha')} · ${hc(v)}</button></div>`).join('');
 let o=h.replace(RV,'');
 return o.slice(0,first)+html+o.slice(first);
}catch(e){console.error('ez646 reviews',e);return h}};
const _s=screens.shop;
screens.shop=function(){const h=_s.apply(this,arguments);try{
 if(S.shopTab!=='eats'||h.includes('ez-rk'))return h;
 const mark='<div class="ez-h" id="e2all">',at=h.indexOf(mark);
 if(at<0||(S.e2cat&&S.e2cat!=='All')||S.e2q||(S.e2flt&&(S.e2flt.open||S.e2flt.fav)))return h;
 const top=REST.map((r,i)=>[r,i]).filter(x=>!x[0].closed).sort((a,b)=>b[0].r*b[0].rc-a[0].r*a[0].rc).slice(0,5);
 const eta=r=>(S.pickup?Math.max(10,r.tm-10):r.tm)+' min';
 const rail=`<div class="ez-h"><b>${T('Popular this week','Populaires cette semaine','Bikunzwe muri iki cyumweru')}</b></div><div class="ez-rail">${top.map(([r,i],n)=>`<div class="ez-rk"><b aria-hidden="true">${n+1}</b><button class="ez-c tap" style="width:132px" onclick="openERest(${i})" aria-label="${n+1}. ${esc(r.n)}"><div class="ez-cv" style="background:${r.bg}">${gl(r.g,60)}</div><div class="ez-n">${esc(r.n)}</div><div class="ez-m"><b>${r.r.toFixed(1)}</b> (${r.rc}) · ${eta(r)}</div></button></div>`).join('')}</div>`;
 return h.slice(0,at)+rail+h.slice(at);
}catch(e){console.error('ez646 rail',e);return h}};
})()}catch(x){console.error('eats-v646',x)}

#phone .ez-hd .r{display:flex;justify-content:space-between;font-size:14px;margin-top:8px}
</style>
<script id="ez658">
try{(()=>{
if(typeof screens==='undefined'||typeof STK==='undefined'||!S.inv)return;
/* v658: itunda 증권, after Toss 증권. Market list: rank numbers, and each chart is coloured by today's move (it was coloured by the month, so +2.1% showed a red line). Stock page: opens on 1D like Toss so the headline move matches the list; 52-week range bar, an order book (5 sell and 5 buy prices with sizes), a buyers-vs-sellers bar and Sell beside Buy when you hold it. Portfolio: with nothing held, a market snapshot (RSE All Share Index) and "Popular today". Sample data, like the rest of Invest. */
const I=S.inv,T=(e,f)=>({en:e,fr:f||e,rw:e}[S.lang]||e);
const nf=n=>Math.round(n).toLocaleString('en-US');
const hash=s=>{let h=2166136261;for(let i=0;i<s.length;i++){h^=s.charCodeAt(i);h=Math.imul(h,16777619)}return h>>>0};
const rng=seed=>{let a=seed>>>0;return()=>{a=(a+0x6D2B79F5)|0;let z=Math.imul(a^(a>>>15),1|a);z=(z+Math.imul(z^(z>>>7),61|z))^z;return((z^(z>>>14))>>>0)/4294967296}};
const st=tk=>STK.find(x=>x[0]===tk);
const dom=h=>{const d=document.createElement('div');d.innerHTML=h;return d};
const tkOf=e=>((e.getAttribute('onclick')||'').match(/openStock\('([^']+)'/)||[])[1];
const dayPct=tk=>{const s=st(tk),o=I.open&&I.open[tk];return o?(s[2]-o)/o*100:s[3]};
const sgn=n=>(n>=0?'+':'−')+Math.abs(n).toFixed(1)+'%';

/* opens on 1D */
if(typeof window.openStock==='function'){const _o=window.openStock;window.openStock=function(tk){I.rng='1D';return _o.apply(this,arguments)}}

/* market list */
const rank=h=>{const R=dom(h);const rows=[...R.querySelectorAll('.stk')];if(!rows.length)return h;
 rows.forEach((r,i)=>{const tk=tkOf(r);if(!tk||!st(tk))return;
  if(!r.querySelector('.ez-rk')){const k=document.createElement('div');k.className='ez-rk';k.textContent=i+1;r.insertBefore(k,r.firstChild)}
  const p=r.querySelector('svg path');if(p)p.setAttribute('stroke',dayPct(tk)>=0?'var(--ok)':'var(--er)')});
 return R.innerHTML};

/* portfolio, nothing held: snapshot + popular today */
const snap=()=>{const avg=STK.reduce((a,s)=>a+dayPct(s[0]),0)/STK.length,idx=168.42*(1+avg/100),up=avg>=0;
 return `<div class="ez-sn"><div class="a">${T('RSE All Share Index','Indice RSE All Share')}</div><div class="b"><b>${idx.toFixed(2)}</b><span class="sm ${up?'up':'dn'}" style="font-weight:700">${up?'▲':'▼'} ${sgn(avg)} ${T('today','aujourd’hui')}</span></div></div>`};
const popular=()=>{const top=STK.slice().sort((a,b)=>(hash(b[0])%97)-(hash(a[0])%97)).slice(0,3);
 return `<div class="ez-pp"><h3>${T('Popular today','Populaires aujourd’hui')}</h3>${top.map(s=>{const c=dayPct(s[0]);return `<div class="stk" onclick="openStock('${s[0]}')" tabindex="0" role="button"><div class="tk" style="font-size:13px">${s[0]}</div><div style="flex:1;min-width:0"><div style="font-weight:700;font-size:16px">${s[1]}</div><div class="sm mu">${T('Bought by ','Acheté par ')}${40+hash(s[0]+'p')%160} ${T('people today','personnes aujourd’hui')}</div></div><div style="text-align:right;min-width:68px"><div style="font-weight:800">${nf(s[2])}</div><div class="sm ${c>=0?'up':'dn'}" style="font-weight:700">${sgn(c)}</div></div></div>`}).join('')}</div>`};

const _iv=screens.invest;
if(_iv)screens.invest=function(){let h=String(_iv.apply(this,arguments));try{
 if(I.tab==='mkt'&&h.indexOf('class="stk"')>=0&&h.indexOf('ez-rk')<0)return rank(h);
 if(I.tab==='port'&&h.indexOf('Start investing')>=0&&h.indexOf('ez-sn')<0){
  const i=h.indexOf('Start investing'),j=h.lastIndexOf('<div',h.lastIndexOf('<svg',i));
  /* put the snapshot right after the Cash block, i.e. before the empty-state illustration */
  const R=dom(h),box=[...R.querySelectorAll('.pad')].find(e=>/Start investing/.test(e.textContent)&&e.querySelector('svg')&&!e.querySelector('.row'));
  if(box){box.insertAdjacentHTML('beforebegin',snap());
   box.insertAdjacentHTML('afterend',popular());
   return R.innerHTML}}
 return h}catch(e){console.error('ez658 invest',e);return h}};

/* stock page */
const _sk=screens.stock;
if(_sk)screens.stock=function(){let h=String(_sk.apply(this,arguments));try{
 const tk=I.sk,s=st(tk);if(!s||h.indexOf('ez-bx')>=0)return h;
 const R=dom(h),p=s[2],g=rng(hash(tk+'ob')),tick=Math.max(1,Math.round(p*.005));
 /* 52-week range */
 const kv=l=>{const e=[...R.querySelectorAll('*')].find(x=>x.children.length===0&&x.textContent.trim()===l);const n=e&&e.nextElementSibling;return n?parseFloat(n.textContent.replace(/[^\d.]/g,'')):null};
 let hi=kv('52-week high'),lo=kv('52-week low');if(!hi||!lo){hi=Math.round(p*1.1);lo=Math.round(p*.8)}
 const pos=Math.max(0,Math.min(100,(p-lo)/((hi-lo)||1)*100));
 /* order book */
 const asks=[5,4,3,2,1].map(i=>[p+tick*i,Math.round(200+g()*3800)]),bids=[1,2,3,4,5].map(i=>[p-tick*i,Math.round(200+g()*3800)]);
 const mx=Math.max(...asks.map(x=>x[1]),...bids.map(x=>x[1]));
 const row=(c,[pr,q])=>`<div class="${c}"><s style="width:${Math.round(q/mx*70)}%"></s><span>${nf(q)}</span><span class="p">${nf(pr)}</span></div>`;
 const ob=asks.map(a=>row('a',a)).join('')+`<div class="cur"><span class="mu" style="font-weight:600">${T('Now','Maintenant')}</span><span>${nf(p)} RWF</span></div>`+bids.map(a=>row('b',a)).join('');
 /* buyers vs sellers */
 const by=Math.max(30,Math.min(72,Math.round(50+dayPct(tk)*6+(hash(tk+'bs')%11)-5)));
 const blk=`<div class="ez-bx"><h3>${T('52-week range','Fourchette 52 semaines')}</h3><div class="ez-rg"><i style="left:${pos}%"></i></div><div class="ez-rl"><span>${T('Low','Bas')} <b>${nf(lo)}</b></span><span>${T('High','Haut')} <b>${nf(hi)}</b></span></div></div>
<div class="ez-bx"><h3>${T('Order book','Carnet d’ordres')}</h3><div class="sm mu">${T('Shares waiting to be sold (top) and bought (bottom)','Actions à vendre (haut) et à acheter (bas)')}</div><div class="ez-ob">${ob}</div></div>
<div class="ez-bx"><h3>${T('Buyers and sellers today','Acheteurs et vendeurs aujourd’hui')}</h3><div class="ez-br"><i style="width:${by}%;background:var(--ok)"></i><i style="width:${100-by}%;background:var(--er)"></i></div><div class="ez-rl" style="margin-top:6px"><span>${T('Buying','Achats')} <b>${by}%</b></span><span>${T('Selling','Ventes')} <b>${100-by}%</b></span></div></div>`;
 const hd=S.hold&&S.hold[tk]&&S.hold[tk].q>0?(()=>{const q=S.hold[tk].q,av=S.hold[tk].avg,v=q*p,pl=(p-av)*q,pc=(p/av-1)*100;
  return `<div class="ez-hd"><div class="k">${T('Your shares','Vos actions')}</div><div class="v">${nf(v)} RWF</div><div class="r"><span class="mu">${q} ${T('shares','actions')} · ${T('avg','moy.')} ${nf(av)}</span><b class="${pl>=0?'up':'dn'}">${pl>=0?'+':'−'}${nf(Math.abs(pl))} (${sgn(pc)})</b></div></div>`})():'';
 const k=[...R.querySelectorAll('.agt')].find(e=>/^Key stats/.test(e.textContent.trim()));
 const anchor=k&&k.closest('.pad,.sec,div')||k;
 if(k){const host=k.parentElement;(host&&host.children.length>1&&host!==R.querySelector('.screen')?k:k).insertAdjacentHTML('beforebegin',blk)}
 else return h;
 const cta=R.querySelector('.cta');
 if(cta&&S.hold&&S.hold[tk]&&S.hold[tk].q>0&&!/'sell'/.test(cta.innerHTML)){
  cta.insertAdjacentHTML('beforeend',`<button class="btn sec2" style="flex:1;height:52px;font-size:16px;border-radius:16px" onclick="invTrade('${tk}','sell')" data-h44="1">${T('Sell','Vendre')}</button>`)}
 return R.innerHTML}catch(e){console.error('ez658 stock',e);return h}};
})()}catch(x){console.error('v658',x)}
document.title=document.title.replace(/v\d+/,'v658');
</script>
<style id="ez659s">
#phone .ez-nw{padding:14px 0;border-top:1px solid var(--ln)}
#phone .ez-nw:first-of-type{border-top:0}
#phone .ez-nw b{display:block;font-size:16px;line-height:22px;font-weight:700}
#phone .ez-nw small{display:block;margin-top:4px;font-size:13px;color:var(--mu)}
#phone .ez-av{display:flex;gap:10px;overflow-x:auto;scrollbar-width:none;margin:10px -24px 0;padding:0 24px}
#phone .ez-av::-webkit-scrollbar{display:none}
#phone .ez-av div{flex:none;min-width:128px;padding:12px 14px;border-radius:16px;background:var(--chip);cursor:pointer}
#phone .ez-av b{display:block;font-size:14px}#phone .ez-av span{display:block;font-size:13px;color:var(--mu);margin-top:2px}#phone .ez-av em{display:block;font-style:normal;font-size:14px;font-weight:800;margin-top:6px}
</style>
<script id="ez659">
try{(()=>{
if(typeof screens==='undefined'||typeof STK==='undefined'||!S.inv)return;
/* v659: itunda 증권, round 2. Market: Rising and Falling join Top movers / Dividend yield / Name as ranking chips, the rank numbers renumber, and rank numbers and day colours also survive a search (they were lost when the list redrew). Stock page: the top bar shows the company name and the line under the price says "BK · Banking" (Toss puts the name in the header); a News block (three sample headlines) before About; "Investors also viewed" chips that open the other stock. Sample data. */
const I=S.inv,T=(e,f)=>({en:e,fr:f||e,rw:e}[S.lang]||e);
const hash=s=>{let h=2166136261;for(let i=0;i<s.length;i++){h^=s.charCodeAt(i);h=Math.imul(h,16777619)}return h>>>0};
const st=tk=>STK.find(x=>x[0]===tk);
const dom=h=>{const d=document.createElement('div');d.innerHTML=h;return d};
const tkOf=e=>((e.getAttribute('onclick')||'').match(/openStock\('([^']+)'/)||[])[1];
const dayPct=tk=>{const s=st(tk),o=I.open&&I.open[tk];return o?(s[2]-o)/o*100:s[3]};
const sgn=n=>(n>=0?'+':'−')+Math.abs(n).toFixed(1)+'%';
const nf=n=>Math.round(n).toLocaleString('en-US');

/* order + numbering + colours on any element that holds .stk rows */
const tidy=root=>{
 let rows=[...root.querySelectorAll('.stk')].filter(r=>tkOf(r)&&st(tkOf(r)));if(!rows.length)return;
 if(I.rk&&I.sort==='mov'){const par=rows[0].parentElement;rows.sort((a,b)=>I.rk==='up'?dayPct(tkOf(b))-dayPct(tkOf(a)):dayPct(tkOf(a))-dayPct(tkOf(b))).forEach(r=>par.appendChild(r));rows=[...par.querySelectorAll('.stk')]}
 rows.forEach((r,i)=>{let k=r.querySelector('.ez-rk');if(!k){k=document.createElement('div');k.className='ez-rk';r.insertBefore(k,r.firstChild)}k.textContent=i+1;
  const p=r.querySelector('svg path');if(p)p.setAttribute('stroke',dayPct(tkOf(r))>=0?'var(--ok)':'var(--er)')})};

window.invRk=k=>{I.rk=I.rk===k?null:k;I.sort='mov';render('fade-none')};
{const _s=window.invSort;if(typeof _s==='function')window.invSort=k=>{I.rk=null;return _s(k)}}
{const _q=window.invSearch;if(typeof _q==='function')window.invSearch=function(v){const r=_q.apply(this,arguments);try{const e=document.getElementById('ilist');if(e)tidy(e)}catch(x){}return r}}

const _iv=screens.invest;
if(_iv)screens.invest=function(){let h=String(_iv.apply(this,arguments));try{
 if(I.tab!=='mkt'||h.indexOf('class="stk"')<0)return h;
 const R=dom(h),b=[...R.querySelectorAll('button')].find(x=>/^Top movers/.test(x.textContent.trim()));
 if(b&&!R.querySelector('.ez-rkc')){
  const mk=(k,l)=>{const n=b.cloneNode(true);n.textContent=l;n.className=b.className.replace(/\bon\b/g,'').trim()+' ez-rkc';n.setAttribute('onclick',"invRk('"+k+"')");n.removeAttribute('data-h44');if(I.rk===k&&I.sort==='mov')n.classList.add('on');return n};
  if(I.rk&&I.sort==='mov')b.classList.remove('on');
  b.after(mk('up',T('Rising','En hausse')),mk('dn',T('Falling','En baisse')));
  b.nextSibling&&0}
 tidy(R);
 return R.innerHTML}catch(e){console.error('ez659 invest',e);return h}};

const _sk=screens.stock;
if(_sk)screens.stock=function(){let h=String(_sk.apply(this,arguments));try{
 const tk=I.sk,s=st(tk);if(!s||h.indexOf('ez-nw')>=0)return h;
 const R=dom(h);
 const sec=(()=>{const e=[...R.querySelectorAll('*')].find(x=>x.children.length===0&&x.textContent.trim()==='Sector');return e&&e.nextElementSibling?e.nextElementSibling.textContent.trim():''})();
 const bar=R.querySelector('.bar b');if(bar&&bar.textContent.trim()===tk)bar.textContent=s[1];
 const sub=[...R.querySelectorAll('.pad .sm.mu')].find(x=>x.textContent.trim()===s[1]);if(sub)sub.textContent=tk+' · RSE'+(sec?' · '+sec:'');
 const hh=hash(tk+'news'),pc=(2+hh%9),T3=[
  [s[1]+T(' reports '+pc+'% higher half-year profit',' annonce un bénéfice semestriel en hausse de '+pc+' %'),'2 '+T('h ago','h')],
  [T('Analysts keep a steady view on '+s[1]+' ahead of the dividend date','Les analystes restent stables sur '+s[1]+' avant le dividende'),T('Yesterday','Hier')],
  [T('Trading volume in '+tk+' is above its 30-day average','Le volume de '+tk+' dépasse sa moyenne sur 30 jours'),'2 '+T('days ago','j')]];
 const o=hh%3,ord=[T3[o],T3[(o+1)%3],T3[(o+2)%3]];
 const others=STK.filter(x=>x[0]!==tk).sort((a,b)=>hash(tk+a[0])-hash(tk+b[0])).slice(0,4);
 const news=`<div class="pad" style="padding-top:26px"><h3 style="margin:0 0 4px;font-size:18px;font-weight:800">${T('News','Actualités')}</h3>${ord.map(n=>`<div class="ez-nw"><b>${n[0]}</b><small>${T('Market news (sample)','Actualités (exemple)')} · ${n[1]}</small></div>`).join('')}</div>
<div class="pad" style="padding-top:22px"><h3 style="margin:0;font-size:18px;font-weight:800">${T('Investors also viewed','Consultés aussi')}</h3><div class="ez-av">${others.map(x=>{const c=dayPct(x[0]);return `<div onclick="openStock('${x[0]}')" role="button" tabindex="0"><b>${x[1]}</b><span>${x[0]}</span><em class="${c>=0?'up':'dn'}">${nf(x[2])} · ${sgn(c)}</em></div>`}).join('')}</div></div>`;
 const ab=[...R.querySelectorAll('.agt')].find(e=>e.textContent.trim()==='About');
 if(!ab)return R.innerHTML;
 (ab.closest('.pad')||ab).insertAdjacentHTML('beforebegin',news);
 return R.innerHTML}catch(e){console.error('ez659 stock',e);return h}};
})()}catch(x){console.error('v659',x)}
document.title=document.title.replace(/v\d+/,'v659');
</script>
<style id="ez660s">
#phone .ez-my{margin:18px 0 0}
#phone .ez-my h3{margin:0 24px 8px;font-size:18px;font-weight:800}
#phone .ez-mys{display:flex;gap:10px;overflow-x:auto;scrollbar-width:none;padding:0 24px}
#phone .ez-mys::-webkit-scrollbar{display:none}
#phone .ez-mys div{flex:none;min-width:132px;padding:12px 14px;border-radius:16px;background:var(--chip);cursor:pointer}
#phone .ez-mys b{display:block;font-size:14px}#phone .ez-mys span{display:block;font-size:12px;color:var(--mu);margin-top:2px}#phone .ez-mys em{display:block;font-style:normal;font-size:14px;font-weight:800;margin-top:6px}
#phone .ez-my .hint{margin:0 24px;font-size:13px;color:var(--mu)}
.ez-mx{display:flex;align-items:center;gap:8px;margin-top:10px;flex-wrap:wrap}
.ez-mx button{height:34px;padding:0 14px;border:0;border-radius:17px;background:var(--chip);color:var(--tx);font:inherit;font-size:13px;font-weight:700}
.ez-mx button.on{background:var(--tx);color:var(--bg)}
.ez-mx small{flex-basis:100%;font-size:13px;color:var(--mu)}
</style>
<script id="ez660">
try{(()=>{
if(typeof screens==='undefined'||typeof STK==='undefined'||!S.inv)return;
/* v660: itunda 증권, round 3. Market > Stocks: a "My stocks" strip at the top (your holdings and starred stocks with today's move; with none it says how to add one). Order sheet: 25% / 50% / Max chips that size the order from your itunda Bank balance (fee included), and a line "You can buy up to N shares" (or "You hold N shares" when selling). Sample data. */
const I=S.inv,T=(e,f)=>({en:e,fr:f||e,rw:e}[S.lang]||e);
const st=tk=>STK.find(x=>x[0]===tk);
const dom=h=>{const d=document.createElement('div');d.innerHTML=h;return d};
const dayPct=tk=>{const s=st(tk),o=I.open&&I.open[tk];return o?(s[2]-o)/o*100:s[3]};
const sgn=n=>(n>=0?'+':'−')+Math.abs(n).toFixed(1)+'%';
const nf=n=>Math.round(n).toLocaleString('en-US');
const fee=v=>Math.max(100,Math.round(v*.004));

const _iv=screens.invest;
if(_iv)screens.invest=function(){let h=String(_iv.apply(this,arguments));try{
 if(I.tab!=='mkt'||(I.mk&&I.mk!=='stocks')||h.indexOf('ez-my')>=0)return h;
 const R=dom(h),leaf=[...R.querySelectorAll('*')].find(x=>x.children.length===0&&/^Market today/.test(x.textContent.trim()));
 if(!leaf)return h;
 const mine=[...new Set(Object.keys(S.hold||{}).filter(k=>S.hold[k]&&S.hold[k].q>0&&st(k)).concat(Object.keys(I.watch||{}).filter(k=>I.watch[k]&&st(k))))];
 const body=mine.length?`<div class="ez-mys">${mine.map(k=>{const s=st(k),c=dayPct(k),h2=S.hold&&S.hold[k]&&S.hold[k].q>0;return `<div onclick="openStock('${k}')" role="button" tabindex="0"><b>${s[1]}</b><span>${h2?S.hold[k].q+' '+T('shares','actions'):T('Following','Suivi')}</span><em class="${c>=0?'up':'dn'}">${nf(s[2])} · ${sgn(c)}</em></div>`}).join('')}</div>`:`<div class="hint">${T('Tap ☆ on a stock to follow it here.','Touchez ☆ sur une action pour la suivre ici.')}</div>`;
 const blk=`<div class="ez-my"><h3>${T('My stocks','Mes actions')}</h3>${body}</div>`;
 (leaf.closest('.pad')||leaf.parentElement.parentElement).insertAdjacentHTML('beforebegin',blk);
 return R.innerHTML}catch(e){console.error('ez660 invest',e);return h}};

/* order sheet: size chips */
const maxQ=p=>{let q=Math.floor(S.bank/(p*1.004));while(q>0&&q*p+fee(q*p)>S.bank)q--;return Math.max(0,q)};
const enhance=()=>{try{
 const lay=document.getElementById('layer');if(!lay)return;
 const inp=lay.querySelector('#trq');if(!inp||lay.querySelector('.ez-mx'))return;
 const T0=I.tr;if(!T0)return;
 const buy=T0.side==='buy',p=(T0.type==='limit'&&T0.lim)?T0.lim:st(T0.tk)[2];
 const hold=(S.hold[T0.tk]&&S.hold[T0.tk].q)||0;
 const cap=buy?maxQ(p):hold;
 const row=[...lay.querySelectorAll('.req')].filter(r=>r.querySelector('button[onclick^="invQset"]')).pop();if(!row)return;
 const chips=[[.25,'25%'],[.5,'50%'],[1,'Max']].map(([f,l])=>{const n=Math.max(cap?1:0,Math.floor(cap*f));return `<button class="${T0.q===n&&n>0?'on':''}" ${cap?'':'disabled'} onclick="invQset(${n})">${l}</button>`}).join('');
 row.insertAdjacentHTML('afterend',`<div class="ez-mx">${chips}<small>${buy?T('You can buy up to ','Vous pouvez acheter jusqu’à ')+nf(cap)+T(' shares with your itunda Bank balance',' actions avec votre solde itunda Bank'):T('You hold ','Vous détenez ')+nf(cap)+T(' shares',' actions')}</small></div>`)}catch(e){console.error('ez660 sheet',e)}};
const lay=document.getElementById('layer');
if(lay)new MutationObserver(()=>{if(!lay.querySelector('.ez-mx'))enhance()}).observe(lay,{childList:true,subtree:true});
})()}catch(x){console.error('v660',x)}
document.title=document.title.replace(/v\d+/,'v660');
</script>

<style id="q647">
/* v647: itunda Place, Directions, Picker and Business borrow Shop's quiet look. One job per screen: flat rows with no boxes inside boxes, text tabs and tinted chips instead of black pills, one primary button, and the rarely used extras fold behind a single "More" row. Same handlers as before. */
#phone .nvc{position:relative;display:block;padding:14px 24px;margin:0;border:0;background:none;min-height:100px}
#phone .nvc .ph{position:absolute;right:24px;top:14px;width:76px;height:76px;display:block;margin:0}
#phone .nvc .ph>div{display:none}
#phone .nvc .ph>div:first-child{display:flex;width:76px;height:76px;border-radius:22px;align-items:center;justify-content:center;font-size:34px}
#phone .nvc .bt{display:none}
#phone .nvc .n,#phone .nvc .r,#phone .nvc .s{padding-right:92px}
#phone .nvc .n{font-size:17px;font-weight:800}#phone .nvc .n small{display:block;margin:0;font-size:13px}
#phone .mt2{font-size:19px;font-weight:800;letter-spacing:-.4px}
#phone .plc button,#phone .nvf button,#phone .chp button{border:0!important;box-shadow:none!important;background:var(--chip)!important;color:var(--mu)!important;font-weight:700}
#phone .plc button.on,#phone .nvf button[aria-pressed=true],#phone .nvf button.on{background:var(--tint)!important;color:var(--tintfg)!important}
/* place sheet */
#phone .sh2 .hrt{position:static!important;width:auto!important;height:auto!important;min-height:44px;display:block!important;margin:2px 20px 0!important;text-align:left;white-space:normal;line-height:20px}
#phone .nm-p button{border:0!important;box-shadow:none!important;background:var(--chip)!important;color:var(--tx)!important;font-weight:700;border-radius:20px}
#phone .nm-p button.m{background:var(--br)!important;color:var(--on)!important;font-weight:800}
#phone .sh2>.own{margin:14px 20px 0;padding:0!important;border:0!important;background:none!important;border-radius:0;font-size:15px;line-height:22px}
#phone .sh2>.own small{display:block;color:var(--mu);font-size:13px;font-weight:600}
#phone .sh2>.cpn{margin:12px 20px 0;padding:0!important;border:0!important;background:none!important;border-radius:0;display:flex;align-items:center;justify-content:space-between;gap:12px;font-weight:800;color:var(--tintfg)}
#phone .sh2>.cpn small{display:block;color:var(--mu);font-weight:600}
#phone .sh2>.cpn button{border:0;background:var(--tint)!important;color:var(--tintfg)!important;font-weight:800;border-radius:18px;padding:0 16px;min-height:44px}
#phone .sh2>.oah{margin:6px 20px 0}
#phone .sh2>.oah button{border:0!important;background:none!important;padding:0!important;min-height:44px;font:inherit;font-weight:700;color:var(--tintfg)!important}
#phone .mo{margin:6px 20px 0}
#phone .mo>div:not(.mos){background:none!important;border:0!important;border-radius:0!important;padding:0!important;margin:18px 0 0!important;box-shadow:none!important}
#phone .mo>div>b:first-child{display:block;font-size:15px;font-weight:800;margin-bottom:6px}
#phone .mo .pz-x{display:flex;gap:8px;margin:14px 0 0!important}
#phone .mo .pz-x button{border:0;background:var(--chip);color:var(--tx);font:inherit;font-weight:700;border-radius:20px;padding:0 16px;min-height:44px}
/* route screen */
#phone .rst{align-items:center}
#phone .rst .dpp{flex:none;padding:0;margin:0 8px 0 0}
#phone .rst .dpp button{border:0;background:var(--chip);color:var(--tx);font:inherit;font-size:14px;font-weight:700;border-radius:18px;padding:0 14px;min-height:44px;white-space:nowrap}
#phone .rst button{border:0!important;box-shadow:none!important;background:none!important;color:var(--mu)!important;font-weight:700}
#phone .rst button.on{background:var(--chip)!important;color:var(--tx)!important;font-weight:800}
#phone .rsh .stp .gof{display:none}
#phone .rsh .rtm{margin:8px 20px 0}
#phone .rsh .rtm>button.q647m{width:100%;min-height:44px;border:0;background:none;padding:0;display:flex;align-items:center;justify-content:space-between;font:inherit;font-size:15px;font-weight:700;color:var(--tx);text-align:left}
#phone .rsh .rtm>button.q647m:after{content:"⌄";color:var(--tt)}
#phone .rsh .rtm>button.q647m[aria-expanded=true]:after{content:"⌃"}
#phone .rsh .rtm>div{background:none!important;border:0!important;border-radius:0!important;padding:0!important;margin:14px 0 0!important}
#phone .rsh .pax b{white-space:nowrap}#phone:has(.pz-bar) .pz-bar{display:none}#phone .nv-cp,#phone .pz-stamp{background:none!important;padding:0!important;border-radius:0!important;margin-top:8px}#phone .nv-cp button,#phone .pz-stamp button{background:var(--tint)!important;color:var(--tintfg)!important;border:0}#phone .nv-sec{border-top:0!important}#phone .rsh .rcd .rtag{position:static!important;display:inline-block;margin:0 0 6px;font-size:12px}#phone .cmp{font-size:13px;font-weight:600;color:var(--mu)!important}
/* directions hub */
#phone .icx>button.q647i{width:100%;min-height:56px;border:0;background:none;padding:0 24px;display:flex;align-items:center;justify-content:space-between;font:inherit;font-size:16px;font-weight:700;color:var(--tx);text-align:left}
#phone .icx>button.q647i:after{content:"⌄";color:var(--tt)}
#phone .icx>button.q647i[aria-expanded=true]:after{content:"⌃"}
</style>
<script id="q647js">
try{(()=>{
if(typeof screens==='undefined'||typeof S==='undefined')return;
const M=S.mp||{},T=(e,f,r)=>({en:e,fr:f,rw:r}[S.lang]||e);
const keep=fn=>{const sc=document.getElementById('sc'),t=sc?sc.scrollTop:0;fn();render('fade-none');const z=document.getElementById('sc');if(z)z.scrollTop=t};
const dom=h=>{const d=document.createElement('div');d.innerHTML=h;return d};
/* Place: the first screen keeps the name, hours, actions, owner note, coupon and tabs; the long tail folds into "More about this place" */
const FOLD='tps,nws,als,brk,qth,acc,lng,nbs,hwf,pav,myp,vst,prc,gfr,stb,rvt,kwd,mem,oma,se,nb'.split(',').map(c=>':scope > .'+c).join(',');
if(screens.place){const _p=screens.place;
screens.place=function(){const h=String(_p.apply(this,arguments));try{
 if(S.mp.exp||h.indexOf('class="nm-p"')<0||h.indexOf('pz-x')>=0)return h;
 const R=dom(h),sh=R.querySelector('.sh2');if(!sh)return h;
 let mo=sh.querySelector(':scope > .mo');
 const nodes=[...sh.querySelectorAll(FOLD)].filter(n=>n.textContent.trim()||n.querySelector('button,input,label'));
 const extra=[...sh.querySelectorAll('.nm-p > button')].filter(b=>/mpDepart|mpsv/.test(b.getAttribute('onclick')||''));
 sh.querySelectorAll(FOLD).forEach(n=>{if(!nodes.includes(n))n.remove()});
 if(!nodes.length&&!extra.length&&!mo)return h;
 if(!mo){mo=document.createElement('div');mo.className='mo';mo.innerHTML='<button class="mos" aria-expanded="'+!!S.mp.mpMore+'" onclick="mpMoreTg()">'+T('More about this place','Plus d’infos','Ibindi ku hantu')+'</button>';
  const at=sh.querySelector(':scope > .nm-tb')||sh.querySelector(':scope > .nm-ph');at?sh.insertBefore(mo,at):sh.appendChild(mo)}
 if(S.mp.mpMore){

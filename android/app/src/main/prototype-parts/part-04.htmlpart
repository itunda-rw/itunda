<script>
/* v550: Places hub rows like Naver Places: name with the category beside it, rating with visitor-review count, open status, and a photo tile on the right. */
try{(()=>{const _h=screens.placehub;if(!_h)return;const BG=['#FFE8C7','#FFE1D6','#E3F4E8','#E6EAFB'];
screens.placehub=function(){let i=0;return String(_h.apply(this,arguments)).replace(/<div class="pl tap pz-hub" onclick="mpOpenPoi\('([^']+)'\)">([\s\S]*?)<span class="pz-d">([^<]*)<\/span><\/div>/g,(m,id,inn,d)=>{const p=POI.find(x=>x.id===id);if(!p)return m;const r=String(p.r||'').match(/^([\d.]+)(?: \((\d+)\))?/)||[],st=(inn.match(/<span class="pz-s"[^>]*>[\s\S]*?<\/span>/)||[''])[0],ea=/<em>Eats<\/em>/.test(inn);
return `<div class="tap" onclick="mpOpenPoi('${id}')" style="display:flex;align-items:center;gap:14px;padding:14px 24px"><div style="flex:1;min-width:0"><div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap"><b style="font-size:17px">${p.n}</b><span class="mu" style="font-size:13px">${(p.k||'').replace(/ ?· ?itunda Eats/,'')}</span>${ea?'<em style="font-style:normal;font-size:11px;font-weight:800;padding:2px 7px;border-radius:8px;background:#EDEBFF;color:#5B4BE0">Eats</em>':''}</div><div style="font-size:14px;margin-top:4px"><b>★ ${r[1]||''}</b><span class="mu">${r[2]?' · Visitor reviews '+r[2]:''} · ${d}</span></div><div style="font-size:14px;margin-top:3px;font-weight:700;color:${/closed/i.test(st)?'#D92D20':'#12803C'}">${st.replace(/<[^>]*>/g,'')}</div></div><div style="flex:none;width:76px;height:76px;border-radius:14px;background:${BG[i++%4]};display:flex;align-items:center;justify-content:center;font-size:34px">${p.e||'📍'}</div></div>`})}
})()}catch(x){console.error('naver-hub-v550',x)}
</script>
<script>
/* v550: Naver-style place page for restaurants and cafes. A Menu tab after Home (signature dish first, price, photo tile on the right); the bottom bar is Directions and Eat here (itunda Front) instead of Pay here. */
try{(()=>{const _p=screens.place;screens.place=function(){let h=String(_p.apply(this,arguments));const p=POI.find(x=>x.n===PL.n);
if(!p||!M.exp||!/^(food|cafe)$/.test(p.c)||h.indexOf('class="ptabs"')<0)return h;const n=p.n.replace(/'/g,"\\'");
h=h.replace(/(onclick="mpSet\('tab','home'\)">Home<\/button>)/,'$1<button class="" style="flex:0 0 auto;padding:0 16px" onclick="mpSet(\'tab\',\'menu\')">Menu</button>');
h=h.replace(/<button class="on"([^>]*>)Home<\/button>/,(m,r)=>M.tab==='menu'?'<button class=""'+r+'Home</button>':m);
h=h.replace('onclick="plPay()">Pay here</button>','onclick="frOpen(\''+n+'\',\'here\')">Eat here</button>');
if(M.tab!=='menu')return h.replace(/(<button class=")(" [^>]*mpSet\('tab','menu'\))/,'$1$2');
h=h.replace(/(<button class=")"( [^>]*mpSet\('tab','menu'\))/,'$1on"$2');
const i=h.indexOf('class="ptabs"'),j=h.indexOf('</button></div>',i)+15,c=h.indexOf('<div class="cta"');
const m=frMenuOf(p.n),b=m.map((x,k)=>`<div style="display:flex;gap:14px;padding:14px 20px;align-items:center"><div style="flex:1;min-width:0"><b style="font-size:17px">${x[0]}</b>${k===0?' <em style="font-style:normal;font-size:11px;font-weight:800;padding:2px 7px;border-radius:8px;background:#FFF1D6;color:#B25E00">Signature</em>':''}${x[1]?`<div class="mu" style="font-size:14px;margin-top:3px">${x[1]}</div>`:''}<div style="margin-top:6px;font-weight:800">${fmt(x[2])} RWF</div></div><div style="flex:none;width:72px;height:72px;border-radius:14px;background:${['#FFE8C7','#FFE1D6','#E3F4E8','#E6EAFB'][k%4]};display:flex;align-items:center;justify-content:center;font-size:32px">${(window.__menuEmoji||((n,e)=>e))(x[0],p.e||'🍽️')}</div></div>`).join('');
return h.slice(0,j)+'<div style="padding:16px 20px 0"><b style="font-size:19px">Menu</b></div>'+b+'<div class="pad fine" style="padding-top:12px">Menu and prices are sample data.</div><div style="height:104px"></div>'+h.slice(c)}
})()}catch(x){console.error('naver-place-v550',x)}
</script>
<script>
/* v550: Reviews tab like Naver Places. Keyword bars ("what visitors say") beside the score, filters (Photo, Receipt verified), and review cards with the reviewer's review count, photo tiles, visit tags and a green "Receipt verified" badge for reviews written after paying with itunda Front. */
try{(()=>{const _p=screens.place;screens.place=function(){let h=String(_p.apply(this,arguments));const p=POI.find(x=>x.n===PL.n);
if(!p||!M.exp||M.tab!=='reviews'||!/^(food|cafe)$/.test(p.c)||h.indexOf('class="ptabs"')<0)return h;
const i=h.indexOf('class="ptabs"'),j=h.indexOf('</button></div>',i)+15,c=h.indexOf('<div class="cta"');if(j<15||c<0)return h;
const r=String(p.r||'').match(/^([\d.]+)(?: \((\d+)\))?/)||[],K=[['Great food',420],['Good for groups',186],['Fast service',140],['Good value',96],['Clean',58]];
let R=[['Jean P.','J',5,'12 reviews · 4 photos','Best brochettes in the area, cooked fresh.',['Dined in','Table 4'],'3 days ago',2,1],['Sandrine K.','S',4,'7 reviews','Big portions. Service is slow on weekends.',['Dined in'],'1 week ago',0,0],['Patrick H.','P',4,'21 reviews · 9 photos','Good for groups, easy to pay with mobile money.',['To go','Mobile money'],'3 weeks ago',1,1]];
const bg=['#FFE8C7','#FFE1D6','#E3F4E8'],F=window.RVF||'all',mine=(window.FRV||[]).find(x=>x.p===p.n);if(mine)R.unshift(['You','Y',mine.s,'Your review','',[mine.m==='here'?'Dined in':'To go',...(mine.m==='here'?['Table '+mine.t]:[])],'Just now',0,1]);if(F==='photo')R=R.filter(x=>x[7]>0);if(F==='ver')R=R.filter(x=>x[8]);
const top=`<div style="display:flex;gap:18px;align-items:center;padding:20px 24px 6px"><div style="text-align:center;flex:none"><div style="font-size:44px;font-weight:800;letter-spacing:-1px">${r[1]||''}</div><div style="color:#F5B301;font-size:14px">★★★★★</div><div class="sm mu">Visitor reviews ${r[2]||''}</div></div><div style="flex:1;min-width:0">${K.slice(0,4).map(k=>`<div style="display:flex;align-items:center;gap:8px;font-size:12px;margin:5px 0"><span style="width:104px;flex:none;font-weight:700;white-space:nowrap">${k[0]}</span><span style="flex:1;height:6px;border-radius:3px;background:var(--tint)"><span style="display:block;height:6px;border-radius:3px;background:var(--lk);width:${Math.round(k[1]/4.2)}%"></span></span><span class="mu" style="width:28px;text-align:right">${k[1]}</span></div>`).join('')}</div></div>`;
const f=`<div class="chp" style="padding-top:8px"><button class="${F==='all'?'on':''}" onclick="rvF('all')">Latest</button><button class="${F==='photo'?'on':''}" onclick="rvF('photo')">Photo</button><button class="${F==='ver'?'on':''}" onclick="rvF('ver')">Verified</button><button onclick="mpWrite()">Write a review</button></div>`;
const cards=R.map(x=>`<div style="padding:18px 24px"><div style="display:flex;align-items:center;gap:10px"><div style="width:38px;height:38px;border-radius:19px;background:var(--tint);color:var(--tintfg);font-weight:800;display:flex;align-items:center;justify-content:center">${x[1]}</div><div style="flex:1"><b>${x[0]}</b><div class="sm mu">${x[3]||'First review'}</div></div><div style="color:#F5B301;font-size:14px">${'★'.repeat(x[2])}<span style="color:var(--ln)">${'★'.repeat(5-x[2])}</span></div></div>${x[7]?`<div style="display:flex;gap:6px;margin-top:10px">${Array.from({length:x[7]},(_,k)=>`<div style="width:84px;height:84px;border-radius:12px;background:${bg[k%3]};display:flex;align-items:center;justify-content:center;font-size:34px">${p.e||'🍽️'}</div>`).join('')}</div>`:''}${x[4]?`<div style="margin-top:10px;font-size:15px;line-height:22px">${x[4]}</div>`:''}<div style="display:flex;gap:6px;flex-wrap:wrap;margin-top:10px">${x[5].map(t=>`<span style="font-size:12px;font-weight:700;padding:4px 9px;border-radius:10px;background:var(--tint)">${t}</span>`).join('')}${x[8]?'<span style="font-size:12px;font-weight:800;padding:4px 9px;border-radius:10px;background:#E8F7EE;color:#12803C">✓ Receipt verified</span>':''}<span class="sm mu" style="padding:4px 0">${x[6]}</span></div></div>`).join('');
return h.slice(0,j)+top+f+cards+'<div style="height:104px"></div>'+h.slice(c)}
window.rvF=k=>{window.RVF=k;render('fade-none')}})()}catch(x){console.error('naver-reviews-v550',x)}
</script>
<script>
/* v551: Place page, Naver Place layout, every tab. Before: the Home tab had no photo header (a small mosaic mid-page), the other tabs had a different, heavier header (Directions / Call / Share block), the tab row ran off the edge (Info was cut), the bottom bar text overflowed, and Photos and Info were bare. Now: one header for all tabs: a swipeable photo strip with a 1 / N counter, name with category beside it, rating with visitor-review and saved counts, open status with distance and travel time, then an icon row (Call, Save, Directions, Share, Reserve). Six sticky tabs that fit the screen (Home, News, Menu, Reviews, Photos, Info; Nearby moves into Home and shows as a tab when open). Home order like Naver: info rows, coupon, what visitors say, news, menu, reviews. New News tab (owner posts), Photos tab with category chips and a 3-column grid, Info tab with the weekly hours (today in bold), amenities, payment methods and the address. Bottom bar: save heart, Directions, and the place's main action. English only; sample data. */
try{(()=>{
const _p=screens.place;if(!_p)return;
const P=()=>window.POI||[],M=S.mp;
const e=x=>String(x).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const q=x=>String(x).replace(/\\/g,'\\\\').replace(/'/g,"\\'");
const hash=s=>{let h=0;for(const c of String(s))h=(h*31+c.charCodeAt(0))>>>0;return h};
const svd=p=>p.id==='cafe'?!!M.star:!!(M.sv&&M.sv[p.id]);
const BG=['#FFE8C7','#FFE1D6','#E3F4E8','#E6EAFB','#F3E6FA','#FFF4C9'];
const EM={food:['🍲','🍢','🥗','🥤','🪑','🍽️'],cafe:['☕','🍰','🥐','🪴','🪑','🧁']};
const CAT={food:['Food','Interior','Exterior','Menu board'],cafe:['Drinks','Interior','Exterior','Menu board']};
const st=document.createElement('style');
st.textContent=`
#phone .nv-hero{position:relative}
#phone .nv-ph{display:flex;gap:4px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;height:230px}
#phone .nv-ph::-webkit-scrollbar{display:none}
#phone .nv-ph>div{flex:0 0 84%;scroll-snap-align:start;display:flex;align-items:center;justify-content:center;font-size:84px}
#phone .nv-ph>div:first-child{flex-basis:92%}
#phone .nv-ph>div:last-child{flex-basis:100%}
#phone .nv-hb{position:absolute;top:10px;width:40px;height:40px;border:0;border-radius:20px;background:rgba(0,0,0,.42);color:#fff;display:flex;align-items:center;justify-content:center;font-size:20px;font-weight:700;z-index:2}
#phone .nv-hc{position:absolute;right:12px;bottom:10px;background:rgba(0,0,0,.55);color:#fff;font-size:12px;font-weight:700;padding:4px 9px;border-radius:12px}
#phone .nv-t{padding:16px 20px 0}
#phone .nv-n{font-size:23px;font-weight:800;letter-spacing:-.4px;line-height:30px}
#phone .nv-n small{font-size:14px;font-weight:600;color:var(--tt);margin-left:6px;letter-spacing:0}
#phone .nv-r{font-size:14px;margin-top:6px;display:flex;flex-wrap:wrap;gap:4px 10px;align-items:center}
#phone .nv-s{font-size:14px;margin-top:6px}
#phone .nv-q{display:flex;margin:14px 8px 0;border-top:1px solid var(--ln);border-bottom:1px solid var(--ln)}
#phone .nv-q button{flex:1;border:0;background:none;padding:11px 0 9px;font:inherit;font-size:12px;font-weight:700;color:var(--tx);display:flex;flex-direction:column;align-items:center;gap:4px}
#phone .nv-q button i{font-style:normal;font-size:21px;line-height:24px}
#phone .nv-q button.on{color:#E5484D}
#phone .nv-tabs{position:sticky;top:0;z-index:6;display:flex;overflow-x:auto;scrollbar-width:none;background:var(--bg,#fff);border-bottom:1px solid var(--ln);margin-top:0}
#phone .nv-tabs::-webkit-scrollbar{display:none}
#phone .nv-tabs button{flex:1 0 auto;height:48px;border:0;background:none;font:inherit;font-size:15px;font-weight:700;color:var(--tt);padding:0 9px;border-bottom:3px solid transparent;margin-bottom:-1px}
#phone .nv-tabs button.on{color:var(--tx);border-bottom-color:var(--tx)}
#phone .nv-sec{margin:0;padding:22px 20px 6px;border-top:8px solid var(--chip)}#phone .nv-ps{display:flex;gap:6px;overflow-x:auto;scrollbar-width:none;padding:12px 0 8px}#phone .nv-ps::-webkit-scrollbar{display:none}#phone .nv-ps div{flex:none;width:112px;height:112px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:40px}#phone .nv-ob{display:flex;gap:8px;padding:6px 0 14px}#phone .nv-ob button{flex:1;height:48px;border:0;border-radius:14px;background:var(--chip);color:var(--tx);font:inherit;font-weight:800;font-size:15px}
#phone .nv-sec.f{border-top:0}
#phone .nv-h{display:flex;align-items:baseline;gap:8px;font-size:18px;font-weight:800}
#phone .nv-h a{margin-left:auto;font-size:14px;font-weight:700;color:var(--lk)}
#phone .nv-cp{display:flex;align-items:center;gap:12px;margin-top:12px;padding:14px;border-radius:16px;background:var(--tint);position:relative}
#phone .nv-cp b{font-size:16px}
#phone .nv-cp button{margin-left:auto;flex:none;border:0;border-radius:18px;height:36px;padding:0 16px;font:inherit;font-weight:800;font-size:14px;background:var(--lk);color:#fff}
#phone .nv-cp button.dn{background:var(--chip);color:var(--tt)}
#phone .nv-nw{display:flex;gap:12px;padding:14px 0;border-top:1px solid var(--ln)}
#phone .nv-nw:first-of-type{border-top:0}
#phone .nv-nw .tx{flex:1;min-width:0}
#phone .nv-nw .tx b{font-size:16px;display:block}
#phone .nv-nw .tx p{margin:4px 0 0;font-size:14px;line-height:21px;color:var(--mu)}
#phone .nv-nw .im{flex:none;width:68px;height:68px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:30px}
#phone .nv-bd{display:inline-block;font-size:11px;font-weight:800;padding:2px 7px;border-radius:8px;background:#EDEBFF;color:#5B4BE0;margin-right:6px;vertical-align:1px}
#phone .nv-chips{display:flex;gap:8px;overflow-x:auto;scrollbar-width:none;padding:14px 20px 4px}
#phone .nv-chips::-webkit-scrollbar{display:none}
#phone .nv-chips button{flex:none;height:36px;border:0;border-radius:18px;padding:0 15px;background:var(--chip);color:var(--tx);font:inherit;font-weight:700;font-size:14px}
#phone .nv-chips button.on{background:#191F28;color:#fff}
#phone .nv-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:3px;padding:10px 3px 0}
#phone .nv-grid>div{aspect-ratio:1;display:flex;align-items:center;justify-content:center;font-size:36px;position:relative}
#phone .nv-grid>div:first-child{grid-column:span 2;grid-row:span 2;font-size:72px}
#phone .nv-grid em{position:absolute;left:6px;bottom:6px;font-style:normal;font-size:11px;font-weight:700;background:rgba(0,0,0,.5);color:#fff;border-radius:8px;padding:2px 6px}
#phone .nv-hr{display:flex;justify-content:space-between;padding:6px 0;font-size:15px;color:var(--mu)}
#phone .nv-hr.td{color:var(--tx);font-weight:800}
#phone .nv-am{display:flex;flex-wrap:wrap;gap:8px;padding:12px 0 6px}
#phone .nv-am span{font-size:14px;font-weight:600;padding:8px 13px;border-radius:18px;background:var(--chip)}
#phone .nv-am span:before{content:"✓ ";color:#12803C;font-weight:800}
#phone .nv-row{display:flex;gap:12px;align-items:flex-start;padding:12px 0;font-size:15px;line-height:22px}
#phone .nv-row>i{font-style:normal;flex:none;width:24px;text-align:center}
#phone .nv-row a{color:var(--lk);font-weight:700;margin-left:6px}
#phone .nv-bar{display:flex;gap:10px;align-items:center}
#phone .nv-bar .sv{flex:none;width:52px;height:52px;border:1px solid var(--ln);border-radius:16px;background:none;font-size:22px;color:var(--tx)}
#phone .nv-bar .sv.on{color:#E5484D}
#phone .nv-bar .btn{height:52px;font-size:16px;border-radius:16px;white-space:nowrap}
`;
document.head.appendChild(st);

const NEWS={
 food:p=>[['Weekend special',p.e,'Fresh grill every Friday from 17:00','Book a table for four or more and we will keep your favourite corner. Pay with itunda Pay and get a free soda.','2 days ago'],['Open later in the evening','🕙','Now open until late','We extended our hours so you can eat after work. Last orders are 30 minutes before closing.','1 week ago'],['New on the menu','🍽️','Try the fresh fish plate','Cooked to order with chips and a side salad. Ask your waiter for today\'s catch.','3 weeks ago']],
 cafe:p=>[['Seasonal menu',p.e,'New cakes and iced coffee are here','Baked this morning. Come before noon for the best choice.','3 days ago'],['Quiet hours','📚','Work in peace, 14:00 to 16:00','Free Wi-Fi and plenty of sockets. Pay at your table with itunda Front.','2 weeks ago']],
 other:p=>[['Notice','📢','Opening hours for the holidays','We are open as usual. Please call before you visit if you need a specific service.','1 week ago'],['Notice','✅','Now accepting itunda Pay','Pay at the counter with your itunda code. No cash needed.','1 month ago']]
};
const news=p=>(NEWS[p.c]||NEWS.other)(p);
const AMEN={food:['Groups','Takeaway','Parking','Wi-Fi','Outdoor seating','Toilets'],cafe:['Wi-Fi','Sockets','Takeaway','Quiet','Outdoor seating'],hosp:['Open 24 hours','Parking','Pharmacy','Wheelchair access'],pharm:['Delivery','Parking','Card accepted'],atm:['Open 24 hours','Card accepted'],bus:['Shelter','Real-time info']};
const PAY=['itunda Pay','MTN MoMo','Airtel Money','Cash'];
window.CPN=window.CPN||{};
window.plCoupon=id=>{CPN[id]=!CPN[id];toast(CPN[id]?'Coupon added to your wallet':'Coupon removed');render('fade-none')};
window.nvHero=el=>{const n=el.children.length;let i=0,b=1e9;for(let k=0;k<n;k++){const d=Math.abs(el.children[k].offsetLeft-el.offsetLeft-el.scrollLeft);if(d<b){b=d;i=k}}if(el.scrollLeft+el.clientWidth>=el.scrollWidth-4)i=n-1;const c=el.parentElement.querySelector('.nv-hc');if(c)c.textContent=(i+1)+' / '+el.dataset.n};
window.nvPh=k=>{window.PHF=k;render('fade-none')};
const total=p=>{const n=String(p.r||'').match(/\((\d+)\)/);return n?+n[1]:24+hash(p.id)%60};

screens.place=function(){
 let h=String(_p.apply(this,arguments));
 const p=P().find(x=>x.n===PL.n);
 const ci=h.indexOf('<div class="ptabs"');
 if(!p||!M.exp||ci<0)return h;
 const j=h.indexOf('</button></div>',ci)+15,c=h.indexOf('<div class="cta"');
 if(j<15||c<0)return h;
 const head=h.slice(0,ci),body=h.slice(j,c),cta=h.slice(c);
 const tab=M.tab||'home',id=p.id,nm=q(p.n);
 const food=/^(food|cafe)$/.test(p.c);
 const tel=(head.match(/mpCall\('([^']*)'\)/)||[])[1]||'';
 const eta=((head+cta).match(/(\d+\s?h?\s?\d*\s?min|\d+h\s?\d+m|\d+\s?m(?:in)?)\b/)||[])[1]||'';
 const hasRsv=/plRsv\(\)/.test(head);
 const r=String(p.r||'').match(/^([\d.]+)(?: \((\d+)\))?/)||[],saved=svd(p),n=total(p);
 const photoN=(()=>{const m=body.match(/<em>\+(\d+)<\/em>/);return m?+m[1]+3:12+hash(p.id)%20})();
 const em=EM[p.c]||[p.e||'📍','🏢','🛣️','🪪'];
 const heroN=Math.min(6,photoN);
 const tiles=Array.from({length:heroN},(_,k)=>`<div style="background:${BG[k%BG.length]}">${em[k%em.length]}</div>`).join('');
 const open=/closed/i.test(p.o||'')?false:true;
 const st1=String(p.o||'').replace(/^Open · /,'');
 const hero=`<div class="nv-hero"><button class="nv-hb" style="left:12px" aria-label="Back" onclick="mpExp(false)">‹</button><button class="nv-hb" style="right:12px" aria-label="Share" onclick="toast('Link copied')">⤴</button><div class="nv-ph" data-n="${photoN}" onscroll="nvHero(this)" role="button" aria-label="Photos" onclick="mpSet('tab','photos')">${tiles}</div><span class="nv-hc">1 / ${photoN}</span></div>`;
 const cat=String(p.k||'').replace(/ ?· ?itunda Eats/,'');
 const title=`<div class="nv-t"><div class="nv-n">${e(p.n)}<small>${e(cat)}</small></div>
<div class="nv-r">${r[1]?`<b>★ ${r[1]}</b>`:''}${r[2]?`<span class="mu">Visitor reviews ${r[2]}</span>`:''}<span class="mu">Saved ${(120+hash(id)%900)+(saved?1:0)}</span></div>
<div class="nv-s"><b style="color:${open?'#12803C':'#D92D20'}">${open?'Open':'Closed'}</b><span class="mu"> ${e(open?String(p.o||'').replace(/^Open/,'').replace(/^ · /,'· '):'')} · ${e(p.d||'')}${eta?' · 🚌 '+e(eta):''}</span></div></div>`;
 const acts=`<div class="nv-q">${tel?`<button onclick="mpCall('${q(tel)}')"><i>📞</i>Call</button>`:''}<button class="${saved?'on':''}" onclick="mpSave('${q(id)}')"><i>${saved?'♥':'♡'}</i>${saved?'Saved':'Save'}</button><button onclick="mpDir('${q(id)}')"><i>🧭</i>Directions</button><button onclick="toast('Link copied')"><i>🔗</i>Share</button>${hasRsv?`<button onclick="plRsv()"><i>📅</i>Reserve</button>`:''}</div>`;
 const TABS=[['home','Home'],['news','News']].concat(p.c==='food'||p.c==='cafe'?[['menu','Menu']]:[]).concat([['reviews','Reviews'],['photos','Photos'],['info','Info']]);
 if(tab==='nearby')TABS.splice(TABS.length-1,0,['nearby','Nearby']);
 const tabs=`<div class="ptabs nv-tabs" id="nvtabs">${TABS.map(t=>`<button class="${tab===t[0]?'on':''}" onclick="mpSet('tab','${t[0]}')">${t[1]}</button>`).join('')}</div>`;
 const fixSc=()=>setTimeout(()=>{const t=document.getElementById('nvtabs'),a=t&&t.querySelector('.on');if(a)t.scrollLeft=a.offsetLeft-(t.clientWidth-a.offsetWidth)/2},0);
 fixSc();
 const T={content:document.createElement('div')};T.content.innerHTML=body;
 let main='';
 if(tab==='home'){
  const rows=[...T.content.querySelectorAll('.fi')].map(x=>{x.removeAttribute('style');x.style.padding='';return x.outerHTML});
  const ph=T.content.querySelector('.pz-ph');if(ph)ph.remove();
  const more=T.content.querySelector('.pz-more');if(more)more.remove();
  T.content.querySelectorAll('.fi').forEach(x=>x.remove());
  const tags=T.content.querySelector('.pz-tags'),stamp=T.content.querySelector('.pz-stamp');
  const tg=tags?tags.outerHTML:'';if(tags)tags.remove();
  const sp=stamp?stamp.outerHTML:'';if(stamp)stamp.remove();
  const secs=[...T.content.querySelectorAll('.pz-s')],byH=k=>secs.find(x=>(x.querySelector('.pz-h')||{}).textContent&&x.querySelector('.pz-h').textContent.trim().startsWith(k));
  const sMenu=byH('Menu'),sRev=byH('Reviews');
  [sMenu,sRev].forEach(x=>{if(x){x.classList.add('nv-sec');x.classList.remove('pz-s');x.removeAttribute('style')}});
  const menuH=sMenu?sMenu.outerHTML:'',revH=sRev?sRev.outerHTML:'';if(sMenu)sMenu.remove();if(sRev)sRev.remove();const rest=T.content.innerHTML;
  const cp=food?`<div class="nv-sec"><div class="nv-h">Coupon</div><div class="nv-cp"><span style="font-size:26px">🎟️</span><div><b>10% off your bill</b><div class="sm mu">Pay with itunda Pay · until 30 Nov</div></div><button class="${CPN[id]?'dn':''}" onclick="plCoupon('${q(id)}')">${CPN[id]?'Added':'Get'}</button></div></div>`:'';
  const nw=news(p).slice(0,2).map(x=>`<div class="nv-nw" role="button" onclick="mpSet('tab','news')"><div class="tx"><b>${e(x[2])}</b><p>${e(x[3]).slice(0,80)}…</p><div class="sm mu" style="margin-top:6px">${e(x[4])}</div></div><div class="im" style="background:${BG[hash(x[2])%BG.length]}">${x[1]}</div></div>`).join('');
  const nwS=`<div class="nv-sec"><div class="nv-h">News<a onclick="mpSet('tab','news')">See all ›</a></div>${nw}</div>`;
  const tgS=tg?`<div class="nv-sec"><div class="nv-h">What visitors say</div>${tg.replace('class="pz-tags"','class="pz-tags" style="padding:12px 0 6px"')}</div>`:'';
  const spS=sp?`<div style="padding:8px 4px 0">${sp}</div>`:'';
  const nbS=`<div class="nv-sec"><div class="nv-h">Nearby<a onclick="mpSet('tab','nearby')">See more ›</a></div><div class="sm mu" style="padding:8px 0 14px">Other places, bus stops and ATMs around ${e(p.n)}.</div></div>`;
  const extra=`<div class="nv-sec" style="padding-top:8px;border-top:8px solid var(--chip)"><div style="padding:8px 0 14px"><button class="btn sec2" style="height:44px;font-size:15px" onclick="mpDepart()">Use as route start</button></div></div>`;
  const ob=food?`<div class="nv-ob"><button onclick="frOpen('${nm}','here')">🍽️ Eat here</button>${hasRsv?`<button onclick="plRsv()">📅 Reserve</button>`:`<button onclick="frOpen('${nm}','togo')">🛍️ To go</button>`}</div>`:'';const phS=`<div class="nv-sec"><div class="nv-h">Photos<a onclick="mpSet('tab','photos')">See all ›</a></div><div class="nv-ps">${em.concat(em).slice(0,6).map((x,k)=>`<div style="background:${BG[k%BG.length]}">${x}</div>`).join('')}</div></div>`;
  main=`<div class="nv-sec f" style="padding-top:6px">${rows.join('')}${ob}</div>${cp}${spS}${nwS}${menuH}${phS}${tgS}${revH}${rest}${nbS}${extra}<div style="height:104px"></div>`;
 }else if(tab==='news'){
  main=`<div class="nv-sec f" style="padding-top:18px"><div class="nv-h">News <span class="mu" style="font-weight:600;font-size:15px">${news(p).length}</span></div>${news(p).map(x=>`<div class="nv-nw"><div class="tx"><span class="nv-bd">${e(x[0])}</span><span class="sm mu">${e(x[4])}</span><b style="margin-top:6px">${e(x[2])}</b><p>${e(x[3])}</p></div><div class="im" style="background:${BG[hash(x[2])%BG.length]};width:84px;height:84px;font-size:36px">${x[1]}</div></div>`).join('')}</div><div class="pad fine" style="padding-top:8px">Posts from the owner. Sample data.</div><div style="height:104px"></div>`;
 }else if(tab==='photos'){
  const cs=['All'].concat(CAT[p.c]||['Inside','Outside','Visitors']),F=cs.includes(window.PHF)?window.PHF:'All';
  const all=Array.from({length:photoN},(_,k)=>{const c=(CAT[p.c]||['Inside','Outside','Visitors']);return{k,c:c[k%c.length]}});
  const list=all.filter(x=>F==='All'||x.c===F);
  main=`<div class="nv-chips">${cs.map(x=>`<button class="${F===x?'on':''}" onclick="nvPh('${x}')">${x}</button>`).join('')}</div><div class="sm mu" style="padding:10px 20px 0">${list.length} photo${list.length===1?'':'s'}</div><div class="nv-grid">${list.map((x,i)=>`<div style="background:${BG[x.k%BG.length]}">${em[x.k%em.length]}${i===0?`<em>${e(x.c)}</em>`:''}</div>`).join('')}</div><div class="pad fine" style="padding-top:12px">Photos are sample data.</div><div style="height:104px"></div>`;
 }else if(tab==='info'){
  const fi=[...T.content.querySelectorAll('.fi')].map(x=>x.textContent.replace(/\s+/g,' ').replace(/ ?Copy$/,'').trim());
  const addr=fi[0]||'',hrs=fi[1]||'',ph=(fi.find(x=>/^\+?\d[\d ]{7,}$/.test(x))||tel||''),am=fi.filter(x=>!/^\+?\d[\d ]{7,}$/.test(x)&&x!==addr&&x!==hrs).join(', ');
  const hm=hrs.match(/(\d{1,2}:\d{2})\s*[–-]\s*(\d{1,2}:\d{2})/),D=['Sun','Mon','Tue','Wed','Thu','Fri','Sat'],today=new Date().getDay();
  const hr=D.slice(1).concat(D[0]).map((d,i)=>`<div class="nv-hr ${D[today]===d?'td':''}"><span>${d}${D[today]===d?' · Today':''}</span><span>${hm?hm[1]+' – '+hm[2]:e(/24/.test(hrs)?'Open 24 hours':hrs.replace(/^Mon[–-]Sun\s*/,''))}</span></div>`).join('');
  const chips=(am?am.split(/, ?/):[]).concat(AMEN[p.c]||[]).filter((x,i,a)=>x&&a.indexOf(x)===i).slice(0,8);
  main=`<div class="nv-sec f" style="padding-top:18px"><div class="nv-h">Hours</div><div style="padding-top:8px">${hr}</div></div>
<div class="nv-sec"><div class="nv-h">Location</div><div class="nv-row"><i>📍</i><div style="flex:1">${e(addr)}<a onclick="toast('Address copied')">Copy</a><div class="mu sm" style="margin-top:2px">${e(p.d||'')} from you${eta?' · 🚌 '+e(eta):''}</div></div></div><div style="display:flex;gap:10px;padding:2px 0 14px"><button class="btn sec2" style="height:44px;font-size:15px" onclick="mpExp(false)">View on map</button><button class="btn sec2" data-v353="1" style="height:44px;font-size:15px" onclick="mpDir('${q(id)}')">Directions</button></div></div>
${ph?`<div class="nv-sec"><div class="nv-h">Contact</div><div class="nv-row"><i>📞</i><div style="flex:1">${e(ph)}<a onclick="mpCall('${q(ph)}')">Call</a></div></div></div>`:''}
<div class="nv-sec"><div class="nv-h">Amenities</div><div class="nv-am">${chips.map(x=>`<span>${e(x)}</span>`).join('')}</div></div>
${food?`<div class="nv-sec"><div class="nv-h">Payment</div><div class="nv-am">${PAY.map(x=>`<span>${x}</span>`).join('')}</div></div>`:''}
<div class="pad fine" style="padding-top:12px">Hours and details are sample data.</div><div style="height:104px"></div>`;
 }else main=body;
 const m2=cta.match(/<button class="btn sec2"[^>]*>[\s\S]*?<\/button>/);
 const bar=`<div class="cta" style="display:flex;gap:10px;align-items:center"><button class="btn" data-v353="1" style="flex:1.2" onclick="mpDir('${q(id)}')">Directions</button>${m2?m2[0].replace('class="btn sec2"','class="btn sec2" style="flex:1"'):''}</div>`;
 return hero+title+acts+tabs+main+bar;
};
})()}catch(x){console.error('naver-place-v551',x)}
</script>
<script>
/* v554: Places hub as Naver builds it. Result cards: name with category beside it, rating with visitor-review count, open status with distance, a three-photo strip, and Reserve / Directions buttons under it; filter chips on top (Open now, Reservable, Delivery). Cards are split by a thin line. itunda colours and type. English only; sample data. */
try{(()=>{
const _h=screens.placehub;if(!_h)return;
const P=()=>window.POI||[],BG=['#FFE8C7','#FFE1D6','#E3F4E8','#E6EAFB'];
const EM={food:['🍲','🍢','🥗'],cafe:['☕','🍰','🥐'],hosp:['🏥','🩺','🚑'],pharm:['💊','🧴','🏪'],atm:['🏧','💳','🏦'],bus:['🚌','🚏','🛣️']};
const st=document.createElement('style');
st.textContent='#phone .nvc{padding:18px 24px 16px;border-bottom:1px solid var(--ln);cursor:pointer}#phone .nvc .n{font-size:18px;font-weight:800;letter-spacing:-.2px}#phone .nvc .n small{font-size:13px;font-weight:600;color:var(--tt);margin-left:6px;letter-spacing:0}#phone .nvc .r{font-size:14px;margin-top:5px}#phone .nvc .s{font-size:14px;margin-top:3px}#phone .nvc .ph{display:grid;grid-template-columns:2fr 1fr 1fr;gap:3px;margin-top:12px;height:92px;border-radius:14px;overflow:hidden}#phone .nvc .ph div{display:flex;align-items:center;justify-content:center;font-size:32px}#phone .nvc .ph div:first-child{font-size:40px}#phone .nvc .bt{display:flex;gap:8px;margin-top:12px}#phone .nvc .bt button{flex:1;height:38px;border:0;border-radius:12px;background:var(--chip);color:var(--tx);font:inherit;font-weight:700;font-size:14px}#phone .nvf{display:flex;gap:8px;padding:6px 24px 0;overflow-x:auto;scrollbar-width:none}#phone .nvf::-webkit-scrollbar{display:none}#phone .nvf button{flex:none;height:36px;border:0;border-radius:18px;padding:0 15px;background:var(--chip);color:var(--tx);font:inherit;font-weight:700;font-size:14px}#phone .nvf button.on{background:#191F28;color:#fff}';
document.head.appendChild(st);
const F=()=>S.nvF||(S.nvF={rsv:0,eats:0});
window.nvhTg=k=>{F()[k]=F()[k]?0:1;render('fade-none')};
window.nvhGo=(ev,id,fn)=>{ev.stopPropagation();mpOpenPoi(id);setTimeout(()=>{try{fn==='rsv'?plRsv():mpDir(id)}catch(e){}},400)};
screens.placehub=function(){
 const h=String(_h.apply(this,arguments)),f=F();
 const T=document.createElement('div');T.innerHTML=h;
 const rows=[...T.children].filter(x=>/mpOpenPoi\('/.test(x.getAttribute('onclick')||'')&&x.style.display==='flex');
 if(!rows.length)return h;
 const old=T.querySelector('.lvc'),hd=[...T.children].find(x=>x.classList.contains('mt2')&&/Near you/.test(x.textContent));
 const cards=[];
 rows.forEach(r=>{const id=r.getAttribute('onclick').match(/'([^']+)'/)[1],p=P().find(x=>x.id===id);r.remove();if(!p)return;
  const food=/^(food|cafe)$/.test(p.c),eats=/<em[^>]*>Eats<\/em>/.test(r.innerHTML);
  if((f.rsv&&!food)||(f.eats&&!eats))return;
  const rt=String(p.r||'').match(/^([\d.]+)(?: \((\d+)\))?/)||[],stt=(r.innerHTML.match(/font-weight:700;color:(#[0-9A-F]+)">([^<]*)</)||[]),ok=stt[1]!=='#D92D20',em=EM[p.c]||[p.e||'📍','🏢','🛣️'];
  const k=String(p.k||'').replace(/ ?· ?itunda Eats/,'');
  cards.push(`<div class="nvc" onclick="mpOpenPoi('${id}')"><div class="n">${p.n}<small>${k}</small></div>${rt[1]?`<div class="r"><b>★ ${rt[1]}</b><span class="mu"> · Visitor reviews ${rt[2]||''}</span></div>`:''}<div class="s"><b style="color:${ok?'#12803C':'#D92D20'}">${stt[2]||''}</b><span class="mu"> · ${p.d}</span></div><div class="ph">${em.map((e,i)=>`<div style="background:${BG[i]}">${e}</div>`).join('')}</div><div class="bt">${food?`<button onclick="nvhGo(event,'${id}','rsv')">Reserve</button>`:''}<button data-v353="1" onclick="nvhGo(event,'${id}','dir')">Directions</button></div></div>`)});
 if(old)old.remove();
 const chip=(on,fn,l)=>`<button class="${on?'on':''}" aria-pressed="${!!on}" onclick="${fn}">${l}</button>`;
 const bar=`<div class="nvf">${chip(!!S.plOpen,'plOpenTg()','Open now')}${chip(f.rsv,"nvhTg('rsv')",'Reservable')}${chip(f.eats,"nvhTg('eats')",'Delivery')}</div>`+(cards.length?cards.join(''):'<div class="pad mu" style="padding-top:28px;text-align:center">No places match.</div>');
 const w=document.createElement('div');w.innerHTML=bar;let a=hd||T.firstChild;[...w.children].forEach(n=>{a.after(n);a=n});
 return T.innerHTML};
})()}catch(x){console.error('hub-v554',x)}
</script>
<script>
/* v555: Naver Maps style place sheet and Directions. Place sheet (before: big Directions + Pay here + More info, then Front buttons and tags): title with category beside it, rating, status with distance, then one row of pills (Directions filled, Start here, Save, Call, Share, Reserve / Eat here), a three-photo strip with a +N count, and a "See details" link. Directions (before: eight chips in one scrolling row, depart times mixed with sort modes): two pills like Naver Maps, "Depart now" and "Recommended", each cycling through its choices on tap. English only; sample data. */
try{(()=>{
const _p=screens.place,_r=screens.route;
const P=()=>window.POI||[],M=S.mp;
const e=x=>String(x).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const q=x=>String(x).replace(/\\/g,'\\\\').replace(/'/g,"\\'");
const BG=['#FFE8C7','#FFE1D6','#E3F4E8','#E6EAFB'];
const EM={food:['🍲','🍢','🥗'],cafe:['☕','🍰','🥐'],hosp:['🏥','🩺','🚑'],pharm:['💊','🧴','🏪'],atm:['🏧','💳','🏦'],bus:['🚌','🚏','🛣️']};
const svd=p=>p.id==='cafe'?!!M.star:!!(M.sv&&M.sv[p.id]);
const st=document.createElement('style');
st.textContent='#phone .nm-t{padding:4px 20px 0}#phone .nm-n{font-size:24px;font-weight:800;letter-spacing:-.4px}#phone .nm-n small{font-size:14px;font-weight:600;color:var(--tt);margin-left:6px;letter-spacing:0}#phone .nm-p{display:flex;gap:8px;overflow-x:auto;scrollbar-width:none;padding:14px 20px 4px}#phone .nm-p::-webkit-scrollbar{display:none}#phone .nm-p button{flex:none;height:40px;border:1px solid var(--ln);border-radius:20px;padding:0 15px;background:none;color:var(--tx);font:inherit;font-weight:700;font-size:14px;display:flex;align-items:center;gap:6px}#phone .nm-p button.m{background:var(--lk);border-color:var(--lk);color:#fff}#phone .nm-p button.on{color:#E5484D}#phone .nm-ph{display:grid;grid-template-columns:2fr 1fr;grid-template-rows:1fr 1fr;gap:3px;height:150px;margin:14px 20px 0;border-radius:16px;overflow:hidden}#phone .nm-ph div{display:flex;align-items:center;justify-content:center;font-size:30px;position:relative}#phone .nm-ph div:first-child{grid-row:span 2;font-size:56px}#phone .nm-ph em{position:absolute;right:6px;bottom:6px;font-style:normal;font-size:12px;font-weight:700;background:rgba(0,0,0,.55);color:#fff;border-radius:10px;padding:2px 8px}#phone .nm-m{display:block;margin:12px 20px 16px;font-weight:700;font-size:15px;color:var(--lk);background:none;border:0;font-family:inherit}#phone .dpp{display:flex;gap:8px;padding:10px 16px 0}#phone .dpp button{height:36px;border:0;border-radius:18px;padding:0 15px;background:var(--chip);color:var(--tx);font:inherit;font-weight:700;font-size:14px}';
document.head.appendChild(st);
screens.place=function(){
 const h=String(_p.apply(this,arguments)),i=h.indexOf('<div class="sh2">');
 const p=P().find(x=>x.n===PL.n);
 if(M.exp||i<0||!p)return h;
 const id=p.id,food=/^(food|cafe)$/.test(p.c),em=EM[p.c]||[p.e||'📍','🏢','🛣️'];
 const tel=(h.match(/mpCall\('([^']*)'\)/)||[])[1]||'',eta=((h.match(/class="s">🚌 ([^<]*)</)||[])[1]||'').trim();
 const hasRsv=/plRsv\(\)/.test(h),saved=svd(p),r=String(p.r||'').match(/^([\d.]+)(?: \((\d+)\))?/)||[];
 const open=!/closed/i.test(p.o||''),stt=String(p.o||'').replace(/^Open/,'').replace(/^ · /,'');
 const k=String(p.k||'').replace(/ ?· ?itunda Eats/,'');
 const n=4+(r[2]?(+r[2])%30:10);
 const pill=(c,f,l,x)=>`<button class="${c}" ${x||''} onclick="${f}">${l}</button>`;
 const sheet=`<div class="sh2"><div class="hdl" onclick="mpExp(true)" aria-label="Expand"></div><div class="nm-t"><div class="nm-n">${e(p.n)}<small>${e(k)}</small></div>
<div style="font-size:14px;margin-top:6px">${r[1]?`<b>★ ${r[1]}</b><span class="mu"> · Visitor reviews ${r[2]||''}</span>`:''}</div>
<div style="font-size:14px;margin-top:4px"><b style="color:${open?'#12803C':'#D92D20'}">${open?'Open':'Closed'}</b><span class="mu">${stt?' · '+e(stt):''} · ${e(p.d||'')}${eta?' · 🚌 '+e(eta):''}</span></div></div>
<div class="nm-p">${pill('m',`mpDir('${q(id)}')`,'🧭 Directions','data-v353="1"')}${pill('',`mpDepart()`,'Start here')}${pill(saved?'on':'',`mpSave('${q(id)}')`,saved?'♥ Saved':'♡ Save')}${tel?pill('',`mpCall('${q(tel)}')`,'📞 Call'):''}${pill('',`toast('Link copied')`,'🔗 Share')}${hasRsv?pill('',`plRsv()`,'📅 Reserve'):''}${food?pill('',`frOpen('${q(p.n)}','here')`,'🍽️ Eat here'):''}</div>
<div class="nm-ph" role="button" onclick="M.tab='photos';mpExp(true)">${em.map((x,j)=>`<div style="background:${BG[j]}">${x}${j===2?`<em>+${n}</em>`:''}</div>`).join('')}</div>
<button class="nm-m" onclick="mpExp(true)">See details ›</button></div>`;
 return h.slice(0,i)+sheet};
screens.route=function(){
 let h=String(_r.apply(this,arguments));
 const a=h.indexOf('<div class="dpc">');if(a<0)return h;
 const b=h.indexOf('</div>',a)+6;
 const DP=[[0,'Depart now'],[15,'In 15 min'],[30,'In 30 min'],[60,'In 1 hour']],SO=['Recommended','Fastest','Fewest transfers','Least walking'];
 const dp=M.dp||0,di=Math.max(0,DP.findIndex(x=>x[0]===dp)),so=M.so||0,bus=(M.mode||'bus')==='bus';
 const pills=`<div class="dpp"><button onclick="mpSet('dp',${DP[(di+1)%4][0]})">🕑 ${DP[di][1]} ⌄</button>${bus?`<button onclick="M.opt=0;mpSet('so',${(so+1)%4})">${SO[so]} ⌄</button>`:''}</div>`;
 return h.slice(0,a)+pills+h.slice(b)};
})()}catch(x){console.error('naver-maps-v555',x)}
</script>
<script>
/* v556: Directions, route card like Naver Maps. Before: the selected route opened its whole stop-by-stop timeline under the summary, so the card ran past the screen and hid the map. Now: the card shows the summary (time, arrival, fare, leg bar, boarding line) and a "Details" toggle opens the timeline. English only. */
try{(()=>{
const _r=screens.route;if(!_r)return;
const st=document.createElement('style');
st.textContent='#phone .rdt{position:absolute;top:-15px;right:14px;height:30px;padding:0 13px;border:0;border-radius:15px;background:var(--chip);color:var(--tx);font:inherit;font-weight:800;font-size:13px;box-shadow:0 0 0 1px var(--ln)}';
document.head.appendChild(st);
window.rtDtl=()=>{S.mp.dtl=!S.mp.dtl;render('fade-none')};
screens.route=function(){
 const h=String(_r.apply(this,arguments));
 const T=document.createElement('div');T.innerHTML=h;
 const cards=T.querySelectorAll('.rcd.on');
 if(!cards.length)return h;
 cards.forEach(c=>{const tl=c.querySelector('.tl5');if(!tl)return;
  const open=!!S.mp.dtl;
  if(!open)tl.remove();
  tl.insertAdjacentHTML&&0;
  const b=document.createElement('div');b.innerHTML=`<button class="rdt" onclick="event.stopPropagation();rtDtl()">${open?'Hide ⌃':'Details ⌄'}</button>`;
  c.insertBefore(b.firstChild,c.firstChild)});
 return T.innerHTML};
})()}catch(x){console.error('route-v556',x)}
</script>
<script>
/* v557: Naver Maps extras. Directions: under the chosen route, three pills like Naver Maps: "Get-off alert" (a buzz before your stop, on by default for bus), "Avoid stairs" (the route is re-picked without stairs) and "Share" (copies a route link). Places: saving a place now files it in a folder like Naver bookmarks (Favorites, Want to go, Lunch spots); a chip under the pills changes the folder. English only; sample data. */
try{(()=>{
const _p=screens.place,_r=screens.route,M=S.mp;
const FD=['⭐ Favorites','📌 Want to go','🍽️ Lunch spots'];
const st=document.createElement('style');
st.textContent='#phone .rac{display:flex;gap:8px;padding:12px 0 0;flex-wrap:wrap}#phone .rac button,#phone .fdc{height:34px;border:0;border-radius:17px;padding:0 13px;background:var(--chip);color:var(--tx);font:inherit;font-weight:700;font-size:13px}#phone .rac button.on{background:var(--lk);color:#fff}#phone .fdc{display:block;margin:10px 20px 0;height:32px;font-size:13px}';
document.head.appendChild(st);
window.rtAlt=()=>{M.alt=M.alt===undefined?false:!M.alt;toast(M.alt?'We will buzz you before your stop':'Get-off alert is off');render('fade-none')};
window.rtStr=()=>{M.stz=!M.stz;toast(M.stz?'Showing routes without stairs':'Stairs allowed');render('fade-none')};
window.rtShr=()=>{const l='itunda.rw/route/'+encodeURIComponent(PL.n);try{navigator.clipboard.writeText(l)}catch(e){}toast('Route link copied')};
window.fdNext=id=>{M.fd=M.fd||{};M.fd[id]=((M.fd[id]||0)+1)%FD.length;toast('Moved to '+FD[M.fd[id]].slice(3));render('fade-none')};
screens.route=function(){
 const h=String(_r.apply(this,arguments)),T=document.createElement('div');T.innerHTML=h;
 const c=T.querySelector('.rcd.on .rsb');if(!c)return h;
 const bus=(M.mode||'bus')==='bus',al=M.alt!==false;
 c.insertAdjacentHTML('afterend',`<div class="rac">${bus?`<button class="${al?'on':''}" onclick="event.stopPropagation();rtAlt()">🔔 Get-off alert</button>`:''}${(M.mode==='car'||M.mode==='bike')?'':`<button class="${M.stz?'on':''}" onclick="event.stopPropagation();rtStr()">♿ Avoid stairs</button>`}<button onclick="event.stopPropagation();rtShr()">🔗 Share</button></div>`);
 return T.innerHTML};
screens.place=function(){
 const h=String(_p.apply(this,arguments)),p=(window.POI||[]).find(x=>x.n===PL.n),i=h.indexOf('<div class="nm-ph"');
 if(M.exp||i<0||!p)return h;
 const sv=p.id==='cafe'?!!M.star:!!(M.sv&&M.sv[p.id]);if(!sv)return h;
 const f=FD[(M.fd&&M.fd[p.id])||0];
 return h.slice(0,i)+`<button class="fdc" onclick="fdNext('${p.id}')">Saved in ${f} ⌄</button>`+h.slice(i)};
})()}catch(x){console.error('naver-v557',x)}
</script>
<script>
/* v558: Naver Maps extras 2. Directions: "Add stop" pill (Naver's waypoint): each tap picks the next nearby place as a stop on the way, shows "Via <place> · +N min" under the route, and a second tap on "Remove stop" clears it. Places: restaurants and cafes get "Busy hours" bars (like Naver's congestion), the current hour in the brand colour and a plain line, e.g. "Usually busy 12 to 2 pm". English only; sample data. */
try{(()=>{
const _p=screens.place,_r=screens.route,M=S.mp;
const st=document.createElement('style');
st.textContent='#phone .via{margin-top:10px;font-size:14px;font-weight:700}#phone .via span{color:var(--tt);font-weight:600}#phone .bz{margin:14px 20px 0;padding:14px 16px;border-radius:16px;background:var(--chip)}#phone .bz b{font-size:15px}#phone .bz p{margin:2px 0 10px;font-size:13px;color:var(--tt)}#phone .bz div{display:flex;align-items:flex-end;gap:5px;height:44px}#phone .bz i{flex:1;border-radius:4px 4px 0 0;background:#D5D9E0}#phone .bz i.on{background:var(--lk)}#phone .bz small{display:flex;justify-content:space-between;margin-top:4px;font-size:11px;color:var(--tt)}';
document.head.appendChild(st);
const opts=()=>(window.POI||[]).filter(x=>x.n!==PL.n&&x.c!=='bus'&&x.id!=='drop');
window.rtVia=()=>{if(M.via){M.via=null;toast('Stop removed')}else{const o=opts();if(!o.length)return;M.vi=((M.vi||0)+1)%o.length;M.via=o[M.vi].n;toast('Stop added: '+M.via)}render('fade-none')};
screens.route=function(){
 const h=String(_r.apply(this,arguments)),T=document.createElement('div');T.innerHTML=h;
 const c=T.querySelector('.rcd.on .rac');if(!c)return h;
 c.insertAdjacentHTML('beforeend',`<button class="${M.via?'on':''}" onclick="event.stopPropagation();rtVia()">${M.via?'✕ Remove stop':'➕ Add stop'}</button>`);
 if(M.via)c.insertAdjacentHTML('afterend',`<div class="via">Via ${M.via.replace(/</g,'&lt;')} <span>· +6 min</span></div>`);
 return T.innerHTML};
screens.place=function(){

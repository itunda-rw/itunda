const oo=window.frOpen;window.frOpen=(n,m)=>{FR.cl='nick';oo(n,m)}}
/* v795 itunda Front, Toss Front pass 3: (1) category chips on the menu (Toss: group the menu so people find things fast), (2) the way you paid last time is preselected and tagged "Last used" (Toss remembers the payment method), (3) the paid amount counts up once (Toss number motion, skipped for reduced motion). */
{const CT=n=>/soda|juice|water|drink|coffee|macchiato|cappuccino|latte|espresso|\btea\b/i.test(n)?'Drinks':/chip|fries|croissant|bread|cake/i.test(n)?'Sides and sweets':'Mains';
const css=document.createElement('style');css.textContent='.fcat{display:flex;gap:8px;overflow-x:auto;padding:4px 24px 8px;scrollbar-width:none}.fcat::-webkit-scrollbar{display:none}.fcat .ocp{flex:none}';document.head.appendChild(css);

/* v790 Front: voice guide (Toss Front reads each step aloud) + toggle on the Front home */
{const L={menu:'Choose what you would like, then tap View order.',bill:'Check your bill. Add a tip or split it if you like.',pay:'Choose how you want to pay.',done:'Payment done. Thank you!'},LF={menu:'Choisissez, puis touchez Voir la commande.',bill:'Vérifiez l’addition. Ajoutez un pourboire ou partagez.',pay:'Choisissez comment payer.',done:'Paiement terminé. Merci !'};let last='';

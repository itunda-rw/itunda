 const c=T.querySelector('.rcd.on .rac');if(!c)return h;
 const m=new Date().getMinutes(),nx=(c.closest('.rcd')||T).textContent.match(/next in (\d+) min/),w=nx?+nx[1]:(m*7)%11+2,k=(m>>2)%3,L=['Seats available','Standing room','Crowded'];
 c.insertAdjacentHTML('afterend',`<div class="nxt">🚌 Bus 305 arrives in ${w} min <span>· <b class="c${k}">${L[k]}</b></span></div>`);
 return T.innerHTML};
screens.place=function(){
 const h=String(_p.apply(this,arguments)),p=(window.POI||[]).find(x=>x.n===PL.n),i=h.indexOf('<button class="nm-m"');
 if(M.exp||i<0||!p||p.c==='bus'||p.id==='drop')return h;
 return h.slice(0,i)+'<button class="se" onclick="plEdit()">Something wrong? Suggest an edit</button>'+h.slice(i)};
})()}catch(x){console.error('naver-v566',x)}
</script>
<script>

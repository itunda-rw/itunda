const ph=`<div style="display:flex;gap:8px;overflow-x:auto;padding:0 20px 12px">${[['#FFE8C7','🍲'],['#FFE1D6','🍢'],['#E3F4E8','🥗'],['#E6EAFB','🥤']].map(x=>`<div style="flex:none;width:120px;height:120px;border-radius:14px;background:${x[0]};display:flex;align-items:center;justify-content:center;font-size:44px">${x[1]}</div>`).join('')}</div>`;
const svc=ph+`<div style="display:flex;gap:8px;padding:0 20px 10px">${b('🍽️','Front · Eat here',`frOpen('${n}','here')`)}${ri>=0?b('🛵','Eats · Delivery',`plOrderEats(${ri})`):b('🛍️','Front · To go',`frOpen('${n}','togo')`)}</div><div style="display:flex;gap:8px;flex-wrap:wrap;padding:0 20px 8px">${['Tasty food 128','Friendly staff 96','Good value 74','Clean 51'].map(x=>`<span style="padding:7px 12px;border-radius:16px;background:var(--tint);font-size:13px;font-weight:700">${x}</span>`).join('')}</div>`;
return h.replace(/(<button[^>]*onclick="plPay\(\)"[^>]*>)[\s\S]*?(<\/button>)/,'$1Pay here$2').replace(/(More info<\/button>)/,'$1</div>'+svc+'<div>')};
})()}catch(x){console.error('front-v550',x)}


<script id="ez661">
try{(()=>{
if(typeof screens==='undefined'||typeof STK==='undefined'||!S.inv)return;
/* v661: itunda 증권, round 4. Order sheet (buying): "By amount" chips (10K, 50K, 100K, 500K RWF) that pick the most shares that fit the amount with the fee, and say what it buys ("50,000 RWF buys 118 shares, 380 RWF left"). Stock page: when you have a limit order waiting on this stock, a "Waiting orders" card shows it with a Cancel link. Sample data. */
const I=S.inv,T=(e,f)=>({en:e,fr:f||e,rw:e}[S.lang]||e);
const st=tk=>STK.find(x=>x[0]===tk);
const dom=h=>{const d=document.createElement('div');d.innerHTML=h;return d};
const nf=n=>Math.round(n).toLocaleString('en-US');
const fee=v=>Math.max(100,Math.round(v*.004));
const fit=(amt,p)=>{let q=Math.floor(amt/(p*1.004));while(q>0&&q*p+fee(q*p)>amt)q--;return Math.max(0,q)};
window.ezAmt=a=>{const t=I.tr;if(!t)return;const p=(t.type==='limit'&&t.lim)?t.lim:st(t.tk)[2],q=fit(a,p);if(!q){toast(T('That is less than one share','Moins d’une action'));return}
 I.ezA=a;window.invQset(q)};
const enhance=()=>{try{
 const lay=document.getElementById('layer');if(!lay||lay.querySelector('.ez-am'))return;
 const t=I.tr;if(!t||t.side!=='buy')return;const inp=lay.querySelector('#trq');if(!inp)return;
 const mx=lay.querySelector('.ez-mx');const at=mx||[...lay.querySelectorAll('.req')].filter(r=>r.querySelector('button[onclick^="invQset"]')).pop();if(!at)return;
 const p=(t.type==='limit'&&t.lim)?t.lim:st(t.tk)[2];
 const note=(()=>{const a=I.ezA;if(!a)return '';const q=fit(a,p);if(!q||t.q!==q)return '';const left=a-(q*p+fee(q*p));return nf(a)+' RWF '+T('buys ','achète ')+q+T(' shares, ',' actions, ')+nf(left)+' RWF '+T('left',' restants')})();
 at.insertAdjacentHTML('afterend',`<div class="ez-am"><div class="t">${T('Or buy by amount','Ou acheter par montant')}</div><div class="r">${[10000,50000,100000,500000].map(a=>`<button onclick="ezAmt(${a})">${nf(a/1000)}K</button>`).join('')}</div>${note?`<small>${note}</small>`:''}</div>`)}catch(e){console.error('ez661 sheet',e)}};
const lay=document.getElementById('layer');
if(lay)new MutationObserver(()=>{if(!lay.querySelector('.ez-am'))enhance()}).observe(lay,{childList:true,subtree:true});
/* a new order sheet starts without a remembered amount */
{const _t=window.invTrade;if(typeof _t==='function')window.invTrade=function(){I.ezA=0;return _t.apply(this,arguments)}}

const _sk=screens.stock;
if(_sk)screens.stock=function(){let h=String(_sk.apply(this,arguments));try{
 const tk=I.sk,o=(I.orders||[]).filter(x=>x.tk===tk);if(!o.length||h.indexOf('ez-pd')>=0)return h;
 const R=dom(h),at=R.querySelector('.ez-bx')||[...R.querySelectorAll('.agt')].find(e=>/^Key stats/.test(e.textContent.trim()));if(!at)return h;
 const blk=`<div class="ez-pd"><div class="k">${T('Waiting orders','Ordres en attente')}</div>${o.map(x=>`<div class="l"><span>${x.side==='buy'?T('Buy','Achat'):T('Sell','Vente')} ${x.q} ${T('at','à')} ${nf(x.lim)} RWF</span><button onclick="invCancel(${x.id})">${T('Cancel','Annuler')}</button></div>`).join('')}</div>`;
 at.insertAdjacentHTML('beforebegin',blk);return R.innerHTML}catch(e){console.error('ez661 stock',e);return h}};
})()}catch(x){console.error('v661',x)}
document.title=document.title.replace(/v\d+/,'v688');
</script>

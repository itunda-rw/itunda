const heart=(on,s)=>`<svg width="${s||24}" height="${s||24}" viewBox="0 0 24 24" fill="${on?'var(--er)':'rgba(255,255,255,.55)'}" stroke="${on?'var(--er)':'#191F28'}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20s-7-4.500-7-10a4 4 0 017-2.500A4 4 0 0119 10c0 5.500-7 10-7 10z"/></svg>`;

#phone .e2-card .nm{display:flex;align-items:center;gap:8px;margin-top:10px;font-size:17px;font-weight:800;letter-spacing:-.3px}
#phone .e2-card .nm span.t{min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#phone .e2-card .rt{flex:none;font-size:13px;font-weight:700;display:flex;align-items:center;gap:3px}
#phone .e2-card .rt em{font-style:normal;color:var(--mu);font-weight:500}
#phone .e2-card .m{font-size:13px;color:var(--mu);margin-top:3px}
#phone .e2-card .f{font-size:13px;font-weight:700;margin-top:6px;display:flex;gap:6px;flex-wrap:wrap}
#phone .e2-card .f span{background:var(--chip);border-radius:8px;padding:3px 8px}
#phone .e2-card .f span.g{background:var(--tint);color:var(--tintfg)}
#phone .e2-hrt{position:absolute;top:6px;right:6px;width:40px;height:40px;border:0;background:none;display:flex;align-items:center;justify-content:center;z-index:2}
#phone .e2-hrt svg{filter:none}
#phone .e2-cl{position:absolute;inset:0;background:rgba(18,18,22,.62);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:15px;text-align:center;padding:0 16px;z-index:1}
#phone .e2-em{padding:40px 24px;text-align:center;color:var(--mu);font-size:15px;line-height:22px}
#phone .e2-em button{margin-top:14px}
/* restaurant page */
#phone .e2-tb{position:sticky;top:0;height:0;z-index:8}

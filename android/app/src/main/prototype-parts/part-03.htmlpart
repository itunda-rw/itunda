const calc=()=>{const p=V().a,n=V().n,i=RATE/1200,mo=Math.round(p*i/(1-Math.pow(1+i,-n)));return{mo,tot:mo*n,int:mo*n-p}};
const aerr=()=>{const a=V().a;return !a?'':a<AMIN?t3('Minimum is '+fm(AMIN)+' RWF','Nibura ni RWF '+fm(AMIN),'Minimum : '+fm(AMIN)+' RWF'):a>AMAX?t3('Maximum is '+fm(AMAX)+' RWF','Ntarenza RWF '+fm(AMAX),'Maximum : '+fm(AMAX)+' RWF'):''};
const miss=()=>{const v=V();if(v.hh===null)return t3('Answer the first question to continue.','Subiza ikibazo cya mbere ukomeze.','Répondez à la première question pour continuer.');if(v.hh==='n')return t3('VUP microloans are for VUP households.','Inguzanyo za VUP ni iz’ingo ziri muri VUP.','Les microcrédits VUP sont pour les ménages du programme VUP.');if((v.sec||'').trim().length<3)return t3('Type your sector to continue.','Andika umurenge wawe ukomeze.','Saisissez votre secteur pour continuer.');if(!v.pur)return t3('Choose what the loan is for.','Hitamo icyo inguzanyo igenewe.','Choisissez l’usage du prêt.');if(!v.a||aerr())return aerr()||t3('Enter an amount to continue.','Andika amafaranga ukomeze.','Saisissez un montant pour continuer.');return ''};
const chip=(on,fn,l,al)=>`<button class="chip" aria-pressed="${on}" ${al?`aria-label="${al}" `:''}onclick="${fn}" style="min-width:64px;height:44px;border-radius:22px;border:0;padding:0 16px;font-size:15px;font-weight:800;background:${on?'var(--tx)':'var(--chip)'};color:${on?'var(--bg)':'var(--tx)'}">${l}</button>`;
const grp=(h,id)=>`<div ${id?`id="${id}" `:''}style="display:flex;gap:10px;flex-wrap:wrap;padding:10px 24px 0" role="group">${h}</div>`;
const lab=(t,s,f)=>`<div style="padding:24px 24px 0"><label ${f?`for="${f}" `:''}style="font-size:16px;font-weight:800;display:block">${t}</label>${s?`<div class="sm mu" style="margin-top:4px;line-height:19px">${s}</div>`:''}</div>`;
const rw=(a,v,b)=>`<div style="margin:8px 24px 0;display:flex;justify-content:space-between;gap:12px;font-size:15px"><span class="mu">${a}</span><b style="text-align:right;${b?'color:var(--tintfg)':''}">${v}</b></div>`;
const R=(a,v)=>`<div style="display:flex;justify-content:space-between;gap:12px;min-height:40px;align-items:center;font-size:15px"><span class="mu">${a}</span><b style="text-align:right">${v}</b></div>`;
const lay2=h=>{$('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet">'+h+'</div>';if(typeof focusSheet==='function')focusSheet()};
const qHH=()=>{const v=V();return grp([['y',t3('Yes','Yego','Oui')],['u',t3('Not sure','Simbizi','Pas sûr')],['n',t3('No','Oya','Non')]].map(([k,l])=>chip(v.hh===k,`vpSet('hh','${k}')`,l)).join(''))};
const qPur=()=>grp(PUR.map(([k,n])=>chip(V().pur===k,`vpSet('pur','${k}')`,t3(...n))).join(''));
const dyn=()=>{const v=V(),q=calc(),ok=!aerr()&&v.a>=AMIN,m=miss();
const hhNote=v.hh==='u'?`<div style="margin:14px 24px 0;padding:12px 14px;border-radius:14px;background:var(--chip);font-size:14px;line-height:20px">${t3('No problem. Your sector office checks this when you apply.','Nta kibazo. Ibiro by’umurenge bibisuzuma usabye.','Pas de souci. Votre bureau de secteur le vérifie à votre demande.')}</div>`:v.hh==='n'?`<div style="margin:14px 24px 0;padding:14px 16px;border-radius:16px;background:var(--chip);font-size:14px;line-height:20px">${t3('VUP microloans are only for households in the VUP programme. You can look at other loans instead.','Inguzanyo za VUP ni iz’ingo ziri muri gahunda ya VUP gusa. Ushobora kureba izindi nguzanyo.','Les microcrédits VUP sont réservés aux ménages du programme VUP. Vous pouvez voir d’autres prêts.')}<div style="margin-top:10px"><button class="chip" onclick="vpOther()">${t3('See other loans','Reba izindi nguzanyo','Voir d’autres prêts')}</button></div></div>`:'';
return `${hhNote}${v.hh==='n'?'':`${grp(SCS.map(x=>chip(v.a===x,`vpSet('a',${x})`,short(x),fm(x)+' RWF')).join(''),'')}
${lab(t3('Repay over','Ishyura mu','Rembourser sur'))}${grp(TMS.map(x=>chip(v.n===x,`vpSet('n',${x})`,x+' '+t3('months','mezi','mois'))).join(''))}
${ok?rw(t3('Monthly payment','Kwishyura buri kwezi','Mensualité'),fm(q.mo)+' RWF',1)+rw(t3('Interest ('+RATE+'% a year)','Inyungu ('+RATE+'% ku mwaka)','Intérêts ('+RATE+' % par an)'),fm(q.int)+' RWF')+rw(t3('Total to repay','Ugomba kwishyura yose','Total à rembourser'),fm(q.tot)+' RWF'):''}
${lab(t3('What to bring to your sector office','Ibyo kujyana ku murenge','À apporter à votre bureau de secteur'))}<div style="padding:8px 24px 0;font-size:15px;line-height:24px"><div>✓ ${t3('National ID','Indangamuntu','Carte d’identité')}</div><div>✓ ${t3('Proof your household is in VUP','Icyemezo ko urugo rwawe ruri muri VUP','Preuve que votre ménage est dans VUP')}</div></div>`}
<div id="vpM" class="sm" role="status" style="margin:16px 24px 0;min-height:20px;text-align:center;color:var(--mu);font-weight:700">${m&&v.hh!=='n'?m:''}</div>`};
window.vpUpd=()=>{const d=document.getElementById('vpD');if(!d)return;d.innerHTML=dyn();const e=document.getElementById('vpAE');if(e)e.textContent=aerr();const q1=document.getElementById('vpQ1'),q3=document.getElementById('vpQ3');if(q1)q1.innerHTML=qHH();if(q3)q3.innerHTML=qPur();const b=document.getElementById('vpB');if(b){b.disabled=!!miss();b.textContent=t3('Apply for '+fm(V().a)+' RWF','Saba RWF '+fm(V().a),'Demander '+fm(V().a)+' RWF')}};
window.vpSet=(f,v)=>{const was=V().hh;V()[f]=v;if(f==='hh'&&(was==='n'||v==='n')){render('fade-none');return}if(f==='a'){const i=document.getElementById('vpA');if(i)i.value=fmt(v)}vpUpd()};
window.vpType=(f,el)=>{if(f==='a'){const x=el.value.replace(/\D/g,'').slice(0,7);V().a=x?Number(x):0;el.value=x?fmt(x):''}else V().sec=el.value.slice(0,40);vpUpd()};
window.vpOther=()=>{S.stack.push('loan');render('push')};
window.vpReview=()=>{if(miss()||S.apps.vup)return;const v=V(),q=calc();
lay2(`<div class="h1" style="font-size:22px;line-height:30px;margin-top:4px">${t3('Apply for '+fm(v.a)+' RWF?','Gusaba RWF '+fm(v.a)+'?','Demander '+fm(v.a)+' RWF ?')}</div><div style="margin:12px 0 16px">${R(t3('Repay over','Kwishyura mu','Remboursement sur'),v.n+' '+t3('months','mezi','mois'))}${R(t3('Monthly payment','Kwishyura buri kwezi','Mensualité'),fm(q.mo)+' RWF')}${R(t3('Total to repay','Ugomba kwishyura yose','Total à rembourser'),fm(q.tot)+' RWF')}${R(t3('Rate','Inyungu','Taux'),RATE+t3('% a year','% ku mwaka',' % par an'))}${R(t3('Sector','Umurenge','Secteur'),esc48(v.sec.trim()))}${R(t3('For','Igenewe','Usage'),pname(v.pur))}${R(t3('Checked by','Bisuzumwa na','Vérifié par'),t3('Your sector office','Ibiro by’umurenge wawe','Votre bureau de secteur'))}</div><div class="mu sm" style="margin:-4px 0 16px;line-height:20px">${t3('Next: your sector office contacts you to confirm. Money is sent to itunda Pay once approved. You can withdraw until it is approved.','Ibikurikira: ibiro by’umurenge bigufata kugira ngo bibyemeze. Amafaranga yoherezwa muri itunda Pay yemejwe. Ushobora kuyikuraho itaremezwa.','Ensuite : votre bureau de secteur vous contacte pour confirmer. L’argent est envoyé sur itunda Pay après approbation. Vous pouvez retirer la demande avant.')}</div><div style="display:grid;grid-template-columns:1fr 1.8fr;gap:12px"><button class="btn sec2" onclick="closeSheet()">${t3('Cancel','Hagarika','Annuler')}</button><button class="btn" style="white-space:nowrap" onclick="vpSend()">${t3('Send application','Ohereza ubusabe','Envoyer la demande')}</button></div>`)};
window.vpSend=()=>{if(miss()||S.apps.vup){closeSheet();return}const v=V(),q=calc();S.apps.vup={ref:'ITN-'+String(Date.now()).slice(-6),a:v.a,n:v.n,mo:q.mo,tot:q.tot,sec:v.sec.trim(),pur:v.pur,stage:0};closeSheet();render('fade-none');
lay2(`<div class="g3" style="font-size:56px;line-height:1;margin-bottom:10px">📨</div><div class="h1" style="font-size:22px;line-height:30px">${t3('Application sent','Ubusabe bwoherejwe','Demande envoyée')}</div><div class="mu" style="font-size:15px;margin:8px 0 24px;line-height:22px">${t3('Reference '+S.apps.vup.ref+'. Your sector office will contact you to confirm.','Nimero '+S.apps.vup.ref+'. Ibiro by’umurenge bizaguhamagara.','Référence '+S.apps.vup.ref+'. Votre bureau de secteur vous contactera.')}</div><button class="btn" onclick="closeSheet()">OK</button>`)};
window.vpNext=()=>{const a=S.apps.vup;if(!a||a.stage>=3)return;a.stage++;if(a.stage===3){S.pay+=a.a;a.at=Date.now();if(Array.isArray(S.act))S.act.unshift(['wallet','VUP microloan · '+a.ref,'Received · Just now',a.a,'Received']);toast('+'+fm(a.a)+' RWF '+t3('added to itunda Pay','yongewe muri itunda Pay','ajoutés à itunda Pay'))}render('fade-none')};
window.vpWithdraw=()=>lay2(`<div class="h1" style="font-size:22px;line-height:30px;margin-top:4px">${t3('Withdraw your application?','Gukuraho ubusabe bwawe?','Retirer votre demande ?')}</div><div class="mu" style="font-size:15px;margin:8px 0 24px;line-height:22px">${t3('Your sector office will not review it. You can apply again later.','Ibiro by’umurenge ntibizabusuzuma. Ushobora gusaba nanone.','Votre bureau de secteur ne l’examinera pas. Vous pourrez redemander plus tard.')}</div><div style="display:grid;grid-template-columns:1fr 1.8fr;gap:12px"><button class="btn sec2" onclick="closeSheet()">${t3('Keep it','Reka ikomeze','Garder')}</button><button class="btn" style="white-space:nowrap" onclick="vpWithdrawGo()">${t3('Withdraw','Kuraho','Retirer')}</button></div>`);
window.vpWithdrawGo=()=>{delete S.apps.vup;closeSheet();render('fade-none');toast(t3('Application withdrawn','Ubusabe bwakuweho','Demande retirée'))};
const screenVup=()=>{const a=S.apps.vup,v=V(),title=t3('VUP Financial Services','Serivisi z’imari za VUP','Services financiers VUP');
const head=bar(title)+`<div style="padding:22px 24px 0"><div style="width:72px;height:72px;border-radius:36px;background:var(--tint);display:flex;align-items:center;justify-content:center;font-size:36px">🌱</div><div class="h1" style="margin-top:16px">${title}</div><div class="mu" style="font-size:15px;line-height:22px;margin-top:8px">${t3('A government microloan for households in the VUP programme. '+RATE+'% a year, checked by your sector office.','Inguzanyo nto ya Leta ku ngo ziri muri gahunda ya VUP. '+RATE+'% ku mwaka, isuzumwa n’ibiro by’umurenge.','Un microcrédit public pour les ménages du programme VUP. '+RATE+' % par an, vérifié par votre bureau de secteur.')}</div></div>`;
if(a){const st=a.stage,names=[t3('Submitted','Cyoherejwe','Envoyée'),t3('Sector office review','Isuzumwa ry’umurenge','Examen du secteur'),t3('Approved','Cyemejwe','Approuvée'),t3('Funds sent to itunda Pay','Amafaranga yoherejwe muri itunda Pay','Fonds envoyés sur itunda Pay')];
 const desc=[t3('We sent your application to your sector office.','Twohereje ubusabe ku biro by’umurenge.','Nous avons envoyé votre demande à votre bureau de secteur.'),t3('They will contact you to confirm your household.','Bazaguhamagara kwemeza urugo rwawe.','Ils vous contacteront pour confirmer votre ménage.'),t3('Your loan is approved. Funds are on the way.','Inguzanyo yawe yemejwe. Amafaranga araje.','Votre prêt est approuvé. Les fonds arrivent.'),t3('The money is in your itunda Pay.','Amafaranga ari muri itunda Pay yawe.','L’argent est sur votre itunda Pay.')];
 const first=a.at?new Date(a.at+30*864e5).toLocaleDateString(S.lang==='fr'?'fr-FR':'en-GB',{day:'numeric',month:'short',year:'numeric'}):'';
 const tl=names.map((n,i)=>`<div style="display:flex;gap:14px;align-items:flex-start;padding:10px 0"><div style="width:26px;height:26px;border-radius:13px;flex:none;display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:800;background:${i<=st?'var(--lk)':'var(--chip)'};color:${i<=st?'#fff':'var(--mu)'}" ${i===st?'aria-current="step"':''}>${i<st||st===3&&i===3?'✓':i+1}</div><div style="min-width:0"><div style="font-weight:${i===st?800:600};color:${i<=st?'var(--tx)':'var(--mu)'}">${n}</div>${i===st?`<div class="sm mu" style="margin-top:2px;line-height:19px">${desc[i]}</div>`:''}</div></div>`).join('');
 return head+`<div style="margin:18px 24px 0;padding:14px 16px;border-radius:16px;background:var(--tint);color:var(--tintfg);font-size:14px;line-height:20px"><b>${t3('Application sent.','Ubusabe bwoherejwe.','Demande envoyée.')}</b> ${t3('Reference ','Nimero ','Référence ')}${a.ref} · ${fm(a.a)} RWF</div><div style="padding:14px 24px 0">${tl}</div>
${lab(t3('Your loan','Inguzanyo yawe','Votre prêt'))}${rw(t3('Amount','Amafaranga','Montant'),fm(a.a)+' RWF')}${rw(t3('Repay over','Kwishyura mu','Remboursement sur'),(a.n||12)+' '+t3('months','mezi','mois'))}${rw(t3('Monthly payment','Kwishyura buri kwezi','Mensualité'),fm(a.mo||0)+' RWF',1)}${rw(t3('Total to repay','Ugomba kwishyura yose','Total à rembourser'),fm(a.tot||0)+' RWF')}${rw(t3('Sector','Umurenge','Secteur'),esc48(a.sec||''))}${rw(t3('For','Igenewe','Usage'),pname(a.pur))}${first?rw(t3('First payment','Kwishyura bwa mbere','Premier paiement'),first):''}
${st<3?`<div class="pad" style="padding-top:18px"><button class="chip" onclick="vpNext()">${t3('Next step (sample)','Intambwe ikurikira (icyitegererezo)','Étape suivante (exemple)')}</button></div>`:''}<div class="pad fine" style="padding-top:14px">${t3('Sample for this prototype. No real loan is made.','Icyitegererezo cy’iyi porogaramu. Nta nguzanyo nyayo itangwa.','Exemple pour ce prototype. Aucun vrai prêt n’est accordé.')}</div><div style="height:100px"></div>${st<2?`<div class="cta"><button class="btn sec2" style="white-space:nowrap" onclick="vpWithdraw()">${t3('Withdraw application','Kuraho ubusabe','Retirer la demande')}</button></div>`:''}`}
return head+`${lab(t3('Is your household in the VUP programme?','Urugo rwawe ruri muri gahunda ya VUP?','Votre ménage est-il dans le programme VUP ?'))}<div id="vpQ1">${qHH()}</div>
${v.hh==='n'?'':`${lab(t3('Your sector','Umurenge wawe','Votre secteur'),t3('Your sector office checks your application.','Ibiro by’umurenge wawe bisuzuma ubusabe bwawe.','Votre bureau de secteur examine votre demande.'),'vpS')}<div style="padding:8px 24px 0"><input id="vpS" value="${esc48(v.sec)}" oninput="vpType('s',this)" autocomplete="off" placeholder="${t3('e.g. Kimironko','urugero: Kimironko','ex. Kimironko')}" style="width:100%;box-sizing:border-box;height:48px;border:0;border-radius:14px;background:var(--chip);color:var(--tx);padding:0 16px;font:inherit;font-size:16px"></div>
${lab(t3('What is the loan for?','Inguzanyo igenewe iki?','À quoi sert le prêt ?'))}<div id="vpQ3">${qPur()}</div>
${lab(t3('Loan amount','Amafaranga y’inguzanyo','Montant du prêt'),'','vpA')}<div style="padding:8px 24px 0"><div style="display:flex;align-items:baseline;gap:8px;border-bottom:2px solid var(--ln)"><input id="vpA" inputmode="numeric" autocomplete="off" placeholder="0" value="${v.a?fmt(v.a):''}" oninput="vpType('a',this)" aria-describedby="vpAE" style="flex:1;min-width:0;border:0;background:none;color:var(--tx);font:inherit;font-size:24px;font-weight:800;padding:6px 0;outline:0;border-radius:0"><span class="mu" style="font-weight:700">RWF</span></div><div id="vpAE" role="alert" class="sm" style="min-height:20px;margin-top:6px;color:var(--er);font-weight:700">${aerr()}</div></div>`}
<div id="vpD">${dyn()}</div><div class="pad fine" style="padding-top:8px">${t3('Sample terms for this prototype. No real loan is made.','Amabwiriza y’icyitegererezo. Nta nguzanyo nyayo itangwa.','Conditions d’exemple pour ce prototype. Aucun vrai prêt n’est accordé.')}</div><div style="height:100px"></div>${v.hh==='n'?'':`<div class="cta"><button id="vpB" class="btn" style="white-space:nowrap" ${miss()?'disabled':''} onclick="vpReview()">${t3('Apply for '+fm(v.a)+' RWF','Saba RWF '+fm(v.a),'Demander '+fm(v.a)+' RWF')}</button></div>`}`};
const _p=screens.svc;screens.svc=()=>S.svk==='vup'?screenVup():_p();
}
/* v301: VUP Financial Services. Before: English only; amount in four chips, three months options, nothing asked about your household, sector or what the loan is for, one line "Application sent" and then nothing to follow. Now: English, French and Kinyarwanda (fr/rw new copy needs native review); three questions first (is your household in VUP: Yes / Not sure / No; your sector; what the loan is for), "No" explains who the loan is for and links to other loans; the amount is a field (50,000 to 500,000 RWF) with shortcuts, repay over 6 / 12 / 18 months with monthly payment, interest and total; what to bring to the sector office; a line under the form saying what is missing; a review before sending; after sending a four-step tracker (Submitted, Sector office review, Approved, Funds sent) with "Next step (sample)", which sends the money to itunda Pay and Activity and shows the first payment date, and "Withdraw application" until it is approved. */
</script>
<script>
/* v303 Auto-fill (pocket) */
{const t3=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e;
const num=v=>Number(String(v||'').replace(/\D/g,''))||0;
const pk=()=>pkGet(S.pkId);
const MIN=500,MAXA=9999999,CH=[1000,5000,10000,20000],CAP=3650;
const sch=pkGet('sch');if(sch&&!sch.by)sch.by='2027-01-31';
const loc=()=>S.lang==='fr'?'fr-FR':'en-GB';
const day0=()=>{const d=new Date();d.setHours(0,0,0,0);return d};
const nxt=f=>{const d=day0();if(f==='Daily')d.setDate(d.getDate()+1);else if(f==='Weekly')d.setDate(d.getDate()+((6-d.getDay()+7)%7||7));else d.setMonth(d.getMonth()+1,1);return d};
const adv=(d,f)=>{const x=new Date(d);if(f==='Daily')x.setDate(x.getDate()+1);else if(f==='Weekly')x.setDate(x.getDate()+7);else x.setMonth(x.getMonth()+1,1);return x};
const nth=(f,n)=>{let d=nxt(f);for(let i=1;i<n;i++)d=adv(d,f);return d};
const cnt=(f,by)=>{let d=nxt(f),n=0;while(d<=by&&n<CAP){n++;d=adv(d,f)}return n};
const dS=(d,y)=>d.toLocaleDateString(loc(),y?{day:'numeric',month:'short',year:'numeric'}:{weekday:'short',day:'numeric',month:'short'});
const byD=p=>p&&p.by?new Date(p.by+'T23:59:59'):null;
const FQ={Daily:[t3('Every day','Buri munsi','Chaque jour'),t3('Daily','Buri munsi','Chaque jour')],
Weekly:[t3('Every Saturday','Buri wa gatandatu','Chaque samedi'),t3('Weekly','Buri cyumweru','Chaque semaine')],
Monthly:[t3('1st of every month','Ku wa 1 buri kwezi','Le 1er de chaque mois'),t3('Monthly','Buri kwezi','Chaque mois')]};
const fq=f=>({Daily:t3('Every day','Buri munsi','Chaque jour'),Weekly:t3('Every Saturday','Buri wa gatandatu','Chaque samedi'),Monthly:t3('1st of every month','Ku wa 1 buri kwezi','Le 1er de chaque mois')}[f]);
const fql=f=>({Daily:t3('Daily','Buri munsi','Chaque jour'),Weekly:t3('Weekly','Buri cyumweru','Chaque semaine'),Monthly:t3('Monthly','Buri kwezi','Chaque mois')}[f]);
const left=p=>p.t?Math.max(0,p.t-pkBal(p)):0;
/* amount that finishes the goal by its date, rounded up to 500 */
const sug=(p,f)=>{const by=byD(p);if(!p.t||!by||!left(p))return 0;const n=cnt(f,by);if(!n)return 0;return Math.max(MIN,Math.ceil(left(p)/n/500)*500)};
const adErr=()=>{const a=S.au.a;if(!a)return t3('Enter an amount','Andika amafaranga','Saisissez un montant');if(a<MIN)return t3('The least you can set is '+fmt(MIN)+' RWF','Ntoya ni RWF '+fmt(MIN),'Le minimum est de '+fmt(MIN)+' RWF');return ''};
const adDirty=()=>{const p=pk();return !p.auto||S.au.f!==p.auto.f||S.au.a!==p.auto.a};
const adInfo=()=>{const p=pk(),A=S.au,out=[];
 if(S.bank<A.a&&A.a)out.push(t3('Your itunda Bank balance is '+fmt(S.bank)+' RWF, less than this amount. We skip a transfer if your balance is too low.','Amafaranga ufite kuri itunda Bank ni RWF '+fmt(S.bank)+', ari munsi y’ayo. Turasimbuka kohereza iyo amafaranga adahagije.','Votre solde itunda Bank est de '+fmt(S.bank)+' RWF, soit moins que ce montant. Nous sautons un virement si le solde est trop bas.'));
 if(p.t&&A.a>=MIN){const L=left(p);
  if(!L)out.push(t3('Goal already reached','Intego yamaze kugerwaho','Objectif déjà atteint'));
  else{const k=Math.ceil(L/A.a);
   if(k>CAP)out.push(t3('At this amount it takes more than 10 years. Try a larger amount.','Kuri ayo mafaranga bifata imyaka irenga 10. Gerageza menshi kurushaho.','Avec ce montant, il faut plus de 10 ans. Essayez un montant plus élevé.'));
   else{const d=nth(A.f,k),by=byD(p),g=fmt(p.t)+' RWF';
    if(by&&d>by){const s=sug(p,A.f);
     out.push(t3('At this pace you reach '+g+' on '+dS(d,1)+', after '+dS(by,1)+'.','Ku muvuduko ugezeho RWF '+fmt(p.t)+' ku wa '+dS(d,1)+', nyuma ya '+dS(by,1)+'.','À ce rythme, vous atteignez '+g+' le '+dS(d,1)+', après le '+dS(by,1)+'.')+(s&&s!==A.a?' <button onclick="adAmt('+s+')">'+t3('Use '+fmt(s)+' RWF','Koresha RWF '+fmt(s),'Utiliser '+fmt(s)+' RWF')+'</button>':''))}
    else out.push(by?t3('On track: you reach '+g+' on '+dS(d,1)+', before '+dS(by,1)+'.','Uri mu nzira nziza: ugera kuri RWF '+fmt(p.t)+' ku wa '+dS(d,1)+', mbere ya '+dS(by,1)+'.','Dans les temps : vous atteignez '+g+' le '+dS(d,1)+', avant le '+dS(by,1)+'.')
     :t3('Reaches '+g+' on '+dS(d,1),'Ugera kuri RWF '+fmt(p.t)+' ku wa '+dS(d,1),'Atteint '+g+' le '+dS(d,1)))}}}
 return out.map(x=>'<div>'+x+'</div>').join('')};
const adNext=()=>fq(S.au.f)+' · '+t3('next on ','ikurikira ku wa ','prochain le ')+dS(nxt(S.au.f));
function adUpd(){const A=S.au,e=adErr(),sv=$('#ads');if(!sv)return;
 $('#ade').textContent=(S.adT&&e)?e:'';$('#ada').setAttribute('aria-invalid',(S.adT&&e)?'true':'false');
 $('#adnx').textContent=adNext();$('#adn').innerHTML=adInfo();
 document.querySelectorAll('#adf button').forEach(b=>{const on=b.dataset.f===A.f;b.classList.toggle('on',on);b.setAttribute('aria-pressed',on?'true':'false')});
 document.querySelectorAll('#adc button').forEach(b=>{const on=Number(b.dataset.v)===A.a;b.classList.toggle('on',on);b.setAttribute('aria-pressed',on?'true':'false')});
 sv.disabled=!!e||!adDirty()}
window.adFreq=f=>{const p=pk();S.au.f=f;if(S.adAuto){const s=sug(p,f);if(s){S.au.a=s;$('#ada').value=fmt(s)}}adUpd()};
window.adAmt=v=>{S.au.a=v;S.adAuto=false;$('#ada').value=v?fmt(v):'';adUpd()};
window.adType=v=>{const a=Math.min(MAXA,num(v));S.au.a=a;S.adAuto=false;S.adT=true;$('#ada').value=a?fmt(a):'';adUpd()};
window.autoSheet=function(){const p=pk();if(!p)return;S.adT=false;
 if(p.auto){S.au={...p.auto};S.adAuto=false}
 else{const s=sug(p,'Weekly');S.au={f:'Weekly',a:s||5000};S.adAuto=!!s}
 drawAuto()};
window.drawAuto=function(){const p=pk(),A=S.au,on=!!p.auto,b=pkBal(p),pct=p.t?Math.min(100,Math.round(b/p.t*100)):0;
 $('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet mgp" role="dialog" aria-modal="true" aria-label="${t3('Auto-fill','Kuzuza byikora','Remplissage auto')}" style="max-height:92%;overflow-y:auto"><div class="h1" style="font-size:22px;line-height:30px">${t3('Auto-fill','Kuzuza byikora','Remplissage auto')} ${esc48(p.n)}</div>
<div class="mu" style="font-size:14px;margin:6px 0 0;line-height:20px">${t3('Moves money from itunda Bank into this pocket on its own.','Yimura amafaranga kuri itunda Bank ikayashyira muri aka gasanduku ubwayo.','Transfère automatiquement de l’argent d’itunda Bank vers cette poche.')}</div>
<div class="mgsum">${pkIco(p,48)}<div style="min-width:0"><b>${esc48(p.n)}</b><span>${fmt(b)}${p.t?' / '+fmt(p.t):''} RWF${p.t?' · '+pct+'%':''}</span></div></div>
${p.t?`<div class="mgb" style="margin-top:0"><i style="width:${pct}%"></i></div>`:''}
<div class="lab" style="margin-top:20px">${t3('How often','Kangahe','Fréquence')}</div>
<div class="pkauto" id="adf" role="group" aria-label="${t3('How often','Kangahe','Fréquence')}" style="margin-top:8px">${Object.keys(FQ).map(f=>`<button data-f="${f}" aria-pressed="${A.f===f}" class="${A.f===f?'on':''}" onclick="adFreq('${f}')">${fql(f)}</button>`).join('')}</div>
<label class="lab" for="ada" style="margin-top:16px">${t3('Amount each time','Amafaranga buri gihe','Montant à chaque fois')}</label>
<div class="mgf"><input class="in" id="ada" inputmode="numeric" autocomplete="off" value="${A.a?fmt(A.a):''}" aria-describedby="ade" aria-invalid="false" oninput="adType(this.value)" onkeydown="if(event.key==='Enter'&&!$('#ads').disabled)autoSave()"><i>RWF</i></div><div class="mge" id="ade" role="alert"></div>
<div class="pkauto" id="adc" role="group" aria-label="${t3('Quick amounts','Amafaranga yihuse','Montants rapides')}">${CH.map(v=>`<button data-v="${v}" aria-pressed="${A.a===v}" class="${A.a===v?'on':''}" aria-label="${fmt(v)} RWF" onclick="adAmt(${v})">${v/1000}K</button>`).join('')}</div>
<div class="pknext" id="adnx">${adNext()}</div>
<div class="mgn" id="adn" style="line-height:19px">${adInfo()}</div>
<button class="btn" id="ads" style="margin-top:16px" ${adErr()||!adDirty()?'disabled':''} onclick="autoSave()">${on?t3('Save changes','Bika impinduka','Enregistrer'):t3('Start auto-fill','Tangira kuzuza byikora','Activer le remplissage auto')}</button>
${on?`<button class="pkopt" style="justify-content:center;height:48px;margin-top:4px;font-size:15px" onclick="autoRun()">${t3('Run next transfer now (demo)','Ohereza ubu (igerageza)','Lancer le prochain virement (démo)')}</button><button class="mgd" onclick="autoOff()">${t3('Turn off auto-fill','Hagarika kuzuza byikora','Désactiver le remplissage auto')}</button>`:''}</div>`};
window.autoSave=function(){const p=pk();if(!p||!S.au)return;S.adT=true;if(adErr()){adUpd();return}
 p.auto={f:S.au.f,a:S.au.a};closeSheet();render('fade-none');toast(t3('Auto-fill on · ','Kuzuza byikora biratangiye · ','Remplissage auto activé · ')+fq(p.auto.f).toLowerCase()+' · '+fmt(p.auto.a)+' RWF')};
window.autoOff=function(){const p=pk();if(!p)return;delete p.auto;closeSheet();render('fade-none');toast(t3('Auto-fill turned off','Kuzuza byikora byahagaritswe','Remplissage auto désactivé'))};
/* pocket screen: the Auto-fill row follows the language and says what is on */
{const _p=screens.pocket;screens.pocket=function(){let h=_p.apply(this,arguments);if(S.lang==='en')return h;const p=pk();if(!p)return h;
 return h.replace(/(<div class="pkpn">)Auto-fill(<\/div><div class="pkpb" style="font-size:17px">)[^<]*(<\/div>)/,(m,a,b,c)=>a+t3('Auto-fill','Kuzuza byikora','Remplissage auto')+b+(p.auto?fq(p.auto.f)+' · '+fmt(p.auto.a)+' RWF':t3('Off','Ntikoreshwa','Désactivé'))+c)}}
document.title='itunda, clickable prototype v303';
}
/* v303: Auto-fill (pocket). Before: a small pop-up with Daily / Weekly / Monthly and four amounts (1,000 to 20,000), always starting at Weekly 5,000 whatever the goal, only English, the amount could not be typed, and Save was always on. Now: the pocket's name, balance and goal bar at the top; "How often" (Daily / Weekly / Monthly) and "Amount each time" as a field you can type (any amount from 500 RWF, separators as you type, error under the field) with 1K / 5K / 10K / 20K shortcuts; a line with the next date ("Every Saturday · next on Sat, 24 Oct"). For a pocket with a goal and a date (School fees: 300,000 RWF by 31 Jan 2027) the first amount is the one that finishes in time (12,000 RWF weekly, 60,000 monthly, 2,000 daily), it follows the frequency until you pick your own amount, and the note under it says "On track: you reach 300,000 RWF on ..." or, when the amount is too small, the date you would reach it, the deadline and a "Use X RWF" button. A note appears when your itunda Bank balance is lower than the amount (we skip a transfer if it is too low). One full-width button, "Start auto-fill" or "Save changes", which stays off until the amount is valid and something changed; when on, "Run next transfer now (demo)" and "Turn off auto-fill" sit below. The Auto-fill row on the pocket screen follows the language. English, French and Kinyarwanda; fr is new copy and rw is new copy that needs native review, especially "Kuzuza byikora", "Buri wa gatandatu" and "Turasimbuka kohereza". Not in this version: choosing the weekday or the day of the month, and an end date for the auto-fill. */
</script>
<script>
/* v304 Bike rental */
(function(){
const T=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e;
const VH=[{k:'Bike',p:20,e:'\ud83d\udeb2'},{k:'E-scooter',p:50,e:'\ud83d\udef4'}];
const vn=i=>[T('Bike','Igare','Vélo'),T('E-scooter','Scooter y’amashanyarazi','Trottinette électrique')][i];
const vnk=k=>vn(VH.findIndex(x=>x.k===k));
const vu=i=>[T('Unlock a bike','Fungura igare','Déverrouiller un vélo'),T('Unlock an e-scooter','Fungura scooter','Déverrouiller une trottinette')][i];
const vq=i=>[T('Unlock a bike?','Gufungura igare?','Déverrouiller un vélo ?'),T('Unlock an e-scooter?','Gufungura scooter?','Déverrouiller une trottinette ?')][i];
const vl=i=>[T('bike','igare','vélo'),T('e-scooter','scooter','trottinette')][i];
const mn=m=>T(m+' min','iminota '+m,m+' min');
const R=(a,v)=>'<div style="display:flex;justify-content:space-between;gap:12px;min-height:40px;align-items:center;font-size:15px"><span class="mu">'+a+'</span><b style="text-align:right">'+v+'</b></div>';
S.bkr=S.bkr||null;S.bkh=S.bkh||[];S.bkv=S.bkv||0;S.bkav=S.bkav||[6,3];
const lab=t=>'<div style="font-size:16px;font-weight:800;padding:22px 24px 0">'+t+'</div>';
const el=()=>{const r=S.bkr;return r?Date.now()-r.t0+(r.skip||0)*6e4:0};
const mins=()=>Math.max(1,Math.ceil(el()/6e4));
const fare=()=>Math.min(S.pay,mins()*VH[S.bkr.v].p);
const clock=()=>{const s=Math.floor(el()/1000);return Math.floor(s/60)+':'+String(s%60).padStart(2,'0')};
const fareTxt=()=>{const p=VH[S.bkr.v].p;return T(fmt(fare())+' RWF so far at '+p+' RWF a minute','RWF '+fmt(fare())+' kugeza ubu, RWF '+p+' ku munota',fmt(fare())+' RWF jusqu’ici, à '+p+' RWF la minute')};
const addBtn=()=>'<button onclick="sheetAdd()" style="border:0;background:none;padding:6px 0;font:inherit;font-weight:800;color:var(--lk);text-decoration:underline">'+T('Add money','Shyiramo amafaranga','Ajouter de l’argent')+'</button>';
const warn=()=>{if(!S.bkr)return '';const p=VH[S.bkr.v].p,n=Math.max(0,Math.floor((S.pay-mins()*p)/p));if(n>5)return '';
 return '<span style="color:var(--er)">'+(n?T('Your itunda Pay balance covers about '+n+' more minute'+(n>1?'s':'')+'.','Amafaranga ufite muri itunda Pay ahagije ku minota nka '+n+' gusa.','Votre solde itunda Pay couvre environ '+n+' minute'+(n>1?'s':'')+' de plus.'):T('Your itunda Pay balance is used up. End your ride or add money.','Amafaranga yo muri itunda Pay yashize. Rangiza urugendo cyangwa ushyiremo andi.','Votre solde itunda Pay est épuisé. Terminez la course ou ajoutez de l’argent.'))+'</span> '+addBtn()};
const _s=screens.svc;
screens.svc=function(){if(S.svk!=='bike')return _s.apply(this,arguments);
 if(S.bkr){const r=S.bkr,v=VH[r.v];
  return bar(T('Bike rental','Gukodesha igare','Location de vélo'))+'<div style="margin:22px 24px 0;padding:20px;border-radius:20px;background:var(--tint);text-align:center"><div style="font-size:40px">'+v.e+'</div><div class="sm" style="color:var(--tintfg);margin-top:6px">'+T('Ride in progress','Urugendo rurakomeje','Course en cours')+' · '+vn(r.v)+'</div><div id="bkT2" class="big" style="margin-top:8px" aria-live="off">'+clock()+'</div><div id="bkF2" class="sm" style="margin-top:8px;color:var(--tintfg)">'+fareTxt()+'</div></div>'+
  '<div id="bkW2" class="pad sm" style="padding-top:12px;line-height:20px" aria-live="polite">'+warn()+'</div>'+
  '<div class="pad sm mu" style="padding-top:8px;line-height:20px">'+T('Unlock code','Kode yo gufungura','Code de déverrouillage')+' <b style="color:var(--tx)">'+r.code+'</b>. '+T('Lock the '+vl(r.v)+' when you are done, then tap End ride. The fare comes from itunda Pay.','Funga '+vl(r.v)+' urangije, hanyuma ukande Rangiza urugendo. Amafaranga akurwa kuri itunda Pay.','Verrouillez le '+vl(r.v)+' à la fin, puis touchez Terminer la course. Le tarif est prélevé sur itunda Pay.')+'</div><div class="pad" style="padding-top:6px"><button class="sm" style="background:none;border:0;color:var(--lk);font-weight:700;padding:8px 0" onclick="bkrSkip()">'+T('Skip 10 minutes (prototype only)','Simbuka iminota 10 (igerageza gusa)','Avancer de 10 minutes (prototype)')+'</button></div><div style="height:100px"></div><div class="cta"><button class="btn" onclick="bkrEndAsk()">'+T('End ride','Rangiza urugendo','Terminer la course')+'</button></div>'}
 const i=S.bkv,v=VH[i],cost=v.p*15,low=S.pay<cost,none=S.bkav[i]<1;
 const rows=VH.map((x,j)=>{const n=S.bkav[j];return '<div class="row tap" role="radio" aria-checked="'+(i===j)+'" tabindex="0" onclick="bkrPick('+j+')" style="padding:12px 24px;'+(i===j?'background:var(--tint)':'')+'"><div class="ico" style="font-size:22px">'+x.e+'</div><div style="flex:1"><div class="t">'+vn(j)+'</div><div class="s">'+(n?T('15 minutes cost '+fmt(x.p*15)+' RWF · '+n+' here','Iminota 15 ni RWF '+fmt(x.p*15)+' · bihari '+n,'15 minutes : '+fmt(x.p*15)+' RWF · '+n+' ici'):T('None here right now','Nta na kimwe gihari ubu','Aucun ici pour le moment'))+'</div></div><b>'+T(x.p+' RWF / min','RWF '+x.p+' / munota',x.p+' RWF / min')+'</b></div>'}).join('');
 const step=(n,t)=>'<div style="display:flex;gap:12px;align-items:flex-start;padding:6px 24px 0"><div style="width:24px;height:24px;border-radius:12px;background:var(--chip);display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:800;flex:none">'+n+'</div><div style="font-size:15px;line-height:24px">'+t+'</div></div>';
 const block=S.bkh.length?lab(T('Recent rides','Ingendo ziheruka','Courses récentes'))+S.bkh.slice(0,3).map(h=>'<div style="display:flex;justify-content:space-between;gap:12px;padding:12px 24px;font-size:15px"><span>'+vnk(h.v)+' · '+mn(h.m)+'</span><b>'+fmt(h.f)+' RWF</b></div>').join('')
  :lab(T('How it works','Uko bikora','Comment ça marche'))+step(1,T('Scan the QR code on the handlebar.','Sikana QR code iri ku gikoresho cyo kuyobora.','Scannez le code QR sur le guidon.'))+step(2,T('Enter the unlock code on the lock.','Andika kode yo gufungura ku gufunga.','Saisissez le code de déverrouillage sur le cadenas.'))+step(3,T('Lock it when you are done. The ride ends and you pay for the minutes used.','Wongere uyifunge urangije. Urugendo rurarangira ukishyura iminota wakoresheje.','Verrouillez-le à la fin. La course se termine et vous payez les minutes utilisées.'));
 const note=low?'<span style="color:var(--er)">'+T('Keep at least '+fmt(cost)+' RWF (15 minutes) in itunda Pay to rent. You have '+fmt(S.pay)+' RWF.','Gumana nibura RWF '+fmt(cost)+' (iminota 15) muri itunda Pay kugira ngo ukodeshe. Ufite RWF '+fmt(S.pay)+'.','Gardez au moins '+fmt(cost)+' RWF (15 minutes) dans itunda Pay pour louer. Vous avez '+fmt(S.pay)+' RWF.')+'</span> '+addBtn()
  :'<span class="mu">'+T('Paid from itunda Pay · '+fmt(S.pay)+' RWF. Charged when you lock it.','Wishyura ukoresheje itunda Pay · RWF '+fmt(S.pay)+'. Wishyurwa ufunze.','Payé depuis itunda Pay · '+fmt(S.pay)+' RWF. Débité au verrouillage.')+'</span>';
 return bar(T('Bike rental','Gukodesha igare','Location de vélo'))+'<div style="padding:22px 24px 0"><div class="h1">'+T('Rent by the minute','Kodesha ku munota','Louez à la minute')+'</div><div class="mu" style="font-size:15px;line-height:22px;margin-top:8px">'+T('Nearest: Kimironko Market, 120 m','Hafi: Isoko rya Kimironko, m 120','Le plus proche : marché de Kimironko, 120 m')+'</div></div>'+
 '<div role="radiogroup" style="padding-top:12px">'+rows+'</div><div class="pad sm" style="padding-top:14px;line-height:20px" aria-live="polite">'+note+'</div>'+block+
 '<div class="pad fine" style="padding-top:14px">'+T('Sample prices and places for this prototype.','Ibiciro n’aho biherereye ni ibyitegererezo kuri iyi porogaramu.','Prix et lieux d’exemple pour ce prototype.')+'</div><div style="height:100px"></div>'+
 '<div class="cta"><button class="btn" '+(low||none?'disabled ':'')+'style="white-space:nowrap" onclick="bkrAsk()">'+vu(i)+'</button></div>'};
window.bkrPick=i=>{S.bkv=i;render('fade-none')};
const sheet=(h,body,no,yes,go)=>{$('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="h1" style="font-size:22px;line-height:30px;margin-top:4px">'+h+'</div><div style="margin:12px 0 20px">'+body+'</div><div class="row2" style="display:grid;grid-template-columns:1fr 1.8fr"><button class="btn sec2" onclick="closeSheet()">'+no+'</button><button class="btn" style="white-space:nowrap" onclick="'+go+'">'+yes+'</button></div></div>';if(typeof focusSheet==='function')focusSheet()};
window.bkrAsk=()=>{const i=S.bkv,v=VH[i];if(S.pay<v.p*15||S.bkav[i]<1)return;
 sheet(vq(i),R(T('Price','Igiciro','Prix'),T(v.p+' RWF a minute','RWF '+v.p+' ku munota',v.p+' RWF la minute'))+R(T('Where','Aho biri','Lieu'),T('Kimironko Market, 120 m','Isoko rya Kimironko, m 120','Marché de Kimironko, 120 m'))+R(T('Paid from','Yishyurwa kuri','Payé depuis'),'itunda Pay')+R(T('Charged','Yishyurwa','Débité'),T('When you lock it','Iyo uyifunze','Au verrouillage')),T('Cancel','Hagarika','Annuler'),T('Unlock','Fungura','Déverrouiller'),'bkrGo()')};
window.bkrGo=()=>{const i=S.bkv;if(S.bkav[i]<1)return;const code=String(1000+Math.floor(Math.random()*9000));S.bkav[i]--;S.bkr={v:i,t0:Date.now(),skip:0,code};render('fade-none');
 $('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="g3" style="font-size:56px;line-height:1;margin-bottom:10px">\ud83d\udd13</div><div class="h1" style="font-size:22px;line-height:30px">'+T('Unlock code','Kode yo gufungura','Code de déverrouillage')+' '+code+'</div><div class="mu" style="font-size:15px;margin:8px 0 24px;line-height:22px">'+T('Enter it on the lock. Your ride ends when you lock the '+vl(i)+'.','Yandike ku gufunga. Urugendo rurangira iyo ufunze '+vl(i)+'.','Saisissez-le sur le cadenas. Votre course se termine quand vous verrouillez le '+vl(i)+'.')+'</div><button class="btn" onclick="closeSheet()">OK</button></div>';
 if(typeof focusSheet==='function')focusSheet()};
window.bkrSkip=()=>{if(S.bkr){S.bkr.skip=(S.bkr.skip||0)+10;render('fade-none')}};
window.bkrEndAsk=()=>{const r=S.bkr;if(!r)return;const v=VH[r.v],f=fare(),m=mins();
 sheet(T('End your ride?','Urashaka kurangiza urugendo?','Terminer votre course ?'),R(T('Time','Igihe','Durée'),mn(m))+R(T('Price','Igiciro','Prix'),T(v.p+' RWF a minute','RWF '+v.p+' ku munota',v.p+' RWF la minute'))+R(T('Fare','Amafaranga y’urugendo','Tarif'),fmt(f)+' RWF')+R(T('Paid from','Yishyurwa kuri','Payé depuis'),'itunda Pay')+R(T('Balance after','Asigaye','Solde après'),fmt(S.pay-f)+' RWF'),T('Keep riding','Komeza','Continuer'),T('Pay '+fmt(f)+' RWF','Ishyura RWF '+fmt(f),'Payer '+fmt(f)+' RWF'),'bkrEnd()')};
window.bkrEnd=()=>{const r=S.bkr;if(!r)return;const v=VH[r.v],m=mins(),f=fare();S.pay-=f;S.bkh.unshift({v:v.k,m,f});S.bkav[r.v]++;S.bkr=null;
 addAct('bus',T('Bike rental','Gukodesha igare','Location de vélo')+' · '+vn(r.v)+', '+mn(m),'Paid',-f,'Paid');render('fade-none');
 $('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="g3" style="font-size:56px;line-height:1;margin-bottom:10px">\u2705</div><div class="h1" style="font-size:22px;line-height:30px">'+T('Ride ended','Urugendo rurangiye','Course terminée')+'</div><div class="mu" style="font-size:15px;margin:8px 0 8px;line-height:22px">'+vn(r.v)+', '+mn(m)+'. '+T(fmt(f)+' RWF paid from itunda Pay.','RWF '+fmt(f)+' yishyuwe kuri itunda Pay.',fmt(f)+' RWF payés depuis itunda Pay.')+'</div><div style="font-weight:800;margin-bottom:24px">'+T('itunda Pay balance now '+fmt(S.pay)+' RWF','Asigaye kuri itunda Pay: RWF '+fmt(S.pay),'Solde itunda Pay : '+fmt(S.pay)+' RWF')+'</div><button class="btn" onclick="closeSheet()">OK</button></div>';
 if(typeof focusSheet==='function')focusSheet()};
setInterval(()=>{if(!S.bkr)return;const t=document.getElementById('bkT2'),f=document.getElementById('bkF2'),w=document.getElementById('bkW2');if(!t||!f)return;t.textContent=clock();f.textContent=fareTxt();if(w){const h=warn();if(w.innerHTML!==h)w.innerHTML=h}},1000);
document.title='itunda, clickable prototype v304';
})();
/* v304: Bike rental. Before: the page from v206 worked only in English; in French and Kinyarwanda it fell back to the old plain card. One screen held the price list, "How it works", the balance warning and Recent rides all at once, always; the nearest station had no count of bikes, so you could unlock a scooter that was not there; if itunda Pay was too low you only got a red line and a greyed button, with no way to add money; and during a ride nothing told you the balance was running out (the fare just stopped at your balance). Now: the same flow in English, French and Kinyarwanda; "How it works" shows only until you have finished a first ride, then "Recent rides" takes its place; each choice shows how many are here (6 bikes, 3 e-scooters at Kimironko Market), one is taken when you unlock and returned when you end the ride, and a choice with none left shows "None here right now" and the button stays off; the balance line says "Paid from itunda Pay · X RWF" and, when it is too low, offers "Add money" (the same sheet as Pay) beside the line; during a ride, when the balance covers 5 minutes or fewer, a red line says how many minutes are left, or that the balance is used up, with "Add money". Unlock review, code, end-ride review, receipt and the Activity entry follow the language. fr is new copy and rw is new copy that needs native review, especially "Gukodesha igare", "Rangiza urugendo", "Wongere uyifunge" and "Simbuka iminota 10". Not in this version: choosing another station, a map of nearby bikes, and a "ride in progress" hint outside this page. */
</script>
<script>
/* v305 Moto-Taxi ownership: one question per page */
{const t3=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e;
const fm=n=>fmt(Math.round(n)),esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const SC=[1500000,2000000,2500000,3000000],DP=[30,40,50],MS=[6,12,18],TM=[24,36,48],INC=[5000,8000,12000,15000],RATE=14,PMIN=1000000,PMAX=5000000,DAYS=26,N=4;
const short=v=>v>=1e6?(v/1e6)+'M':(v/1e3)+'K';
const M=()=>S.mo;
S.moStep=S.moStep||0;
const calc=p=>{const dn=Math.round(p.a*p.dp/100),loan=p.a-dn,i=RATE/1200,mo=Math.round(loan*i/(1-Math.pow(1+i,-p.n))),sv=Math.round(dn/p.ms/1000)*1000||Math.round(dn/p.ms);return{dn,loan,mo,tot:mo*p.n,int:mo*p.n-loan,sv}};
const okP=()=>M().a>=PMIN&&M().a<=PMAX;
const perr=()=>{const a=M().a;return !a?'':a<PMIN?t3('Minimum is '+fm(PMIN)+' RWF','Nibura ni RWF '+fm(PMIN),'Minimum : '+fm(PMIN)+' RWF'):a>PMAX?t3('Maximum is '+fm(PMAX)+' RWF','Ntarenza RWF '+fm(PMAX),'Maximum : '+fm(PMAX)+' RWF'):''};
const title=()=>t3('Moto-Taxi ownership','Kugira moto-taxi yawe','Devenir propriétaire de moto-taxi');
const chip=(on,fn,l,al)=>`<button class="chip" aria-pressed="${on}" ${al?`aria-label="${al}" `:''}onclick="${fn}" style="min-width:64px;height:44px;border-radius:22px;border:0;padding:0 16px;font-size:15px;font-weight:800;background:${on?'var(--tx)':'var(--chip)'};color:${on?'var(--bg)':'var(--tx)'}">${l}</button>`;
const grp=(h,l)=>`<div style="display:flex;gap:10px;flex-wrap:wrap;padding:14px 24px 0" role="group" ${l?`aria-label="${l}"`:''}>${h}</div>`;
const rw=(a,v,b)=>`<div style="margin:10px 24px 0;display:flex;justify-content:space-between;gap:12px;font-size:15px"><span class="mu">${a}</span><b style="text-align:right;${b?'color:var(--tintfg)':''}">${v}</b></div>`;
const sub=t=>`<div class="mu" style="font-size:15px;line-height:22px;margin-top:8px">${t}</div>`;
const mo=n=>n+' '+t3('months','mezi','mois');
const hdr=()=>`<div class="bar"><button class="ib" aria-label="Back" onclick="wzBack()">${ic('back',24)}</button><b>${title()}</b></div>`;
const cta=(h,dis,fn,id)=>`<div style="height:100px"></div><div class="cta"><button ${id?`id="${id}" `:''}class="btn" style="white-space:nowrap" ${dis?'disabled':''} onclick="${fn}">${h}</button></div>`;
const prog=s=>`<div style="padding:16px 24px 0"><div class="sm mu" style="font-weight:700">${t3('Step '+s+' of '+N,'Intambwe '+s+' kuri '+N,'Étape '+s+' sur '+N)}</div><div style="height:4px;border-radius:2px;background:var(--chip);margin-top:8px;overflow:hidden" role="progressbar" aria-valuenow="${s}" aria-valuemin="1" aria-valuemax="${N}"><div style="height:100%;width:${s*100/N}%;background:var(--lk);transition:width .3s"></div></div></div>`;
const ctx=()=>`<div class="sm mu" style="padding:12px 24px 0">${t3('Motorbike','Moto','Moto')} ${fm(M().a)} RWF</div>`;
const head=(s,h,t)=>`${prog(s)}<div style="padding:18px 24px 0"><div class="h1">${h}</div>${t?sub(t):''}</div>`;
const mine=()=>S.goal&&S.goal.moto,other=()=>S.goal&&!S.goal.moto;
const intro=()=>{const st=(n,t)=>`<div style="display:flex;gap:12px;align-items:center;padding:8px 24px 0"><div style="width:28px;height:28px;border-radius:14px;background:var(--chip);display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:800;flex:none">${n}</div><div style="font-size:16px;line-height:24px">${t}</div></div>`;
 const o=other();
 return `<div style="padding:22px 24px 0"><div style="width:72px;height:72px;border-radius:36px;background:var(--tint);display:flex;align-items:center;justify-content:center;font-size:36px">🏍️</div><div class="h1" style="margin-top:16px">${title()}</div>${sub(t3('Save the down payment, then turn the rest into a loan.','Bika amafaranga y’ibanze, hanyuma isigaye ibe inguzanyo.','Épargnez l’apport, puis transformez le reste en prêt.'))}</div>
${o?`<div style="margin:18px 24px 0;padding:14px 16px;border-radius:16px;background:var(--chip);font-size:14px;line-height:20px">${t3('You already have a savings goal: ','Usanzwe ufite intego yo kubika: ','Vous avez déjà un objectif d’épargne : ')}<b>${esc(S.goal.n)}</b>. ${t3('Finish it or delete it, then come back to start your motorbike goal.','Yirangize cyangwa uyisibe, hanyuma ugaruke.','Terminez-le ou supprimez-le, puis revenez.')}</div>`
 :`<div style="padding-top:18px">${st(1,t3('Save your down payment','Bika amafaranga y’ibanze','Épargnez votre apport'))}${st(2,t3('Apply for the loan','Saba inguzanyo','Demandez le prêt'))}${st(3,t3('Repay a little each month','Ishyura gake buri kwezi','Remboursez un peu chaque mois'))}</div>
<div style="padding:24px 24px 0;font-size:16px;font-weight:800">${t3('Before the loan opens','Mbere y’uko inguzanyo ifungurwa','Avant l’ouverture du prêt')}</div><div style="padding:8px 24px 0;font-size:15px;line-height:24px"><div>✓ ${t3('Valid driving licence','Uruhushya rwo gutwara rukora','Permis de conduire valide')}</div><div>✓ ${t3('Moto-taxi permit','Uruhushya rwa moto-taxi','Permis moto-taxi')}</div></div>`}
<div class="pad fine" style="padding-top:14px">${t3('Sample terms for this prototype. No real loan is made.','Amabwiriza y’icyitegererezo. Nta nguzanyo nyayo itangwa.','Conditions d’exemple pour ce prototype. Aucun vrai prêt n’est accordé.')}</div>
${cta(o?t3('Open my savings goal','Fungura intego yanjye','Ouvrir mon objectif'):t3('Plan my motorbike','Tegura moto yanjye','Planifier ma moto'),0,o?'moOpenGoal()':'wzGo()')}`};
const s1=()=>`${head(1,t3('How much is the motorbike?','Moto igura angahe?','Combien coûte la moto ?'))}
<div style="padding:12px 24px 0"><div style="display:flex;align-items:baseline;gap:8px;border-bottom:2px solid var(--ln)"><input id="wzP" inputmode="numeric" autocomplete="off" placeholder="0" value="${M().a?fmt(M().a):''}" oninput="wzType(this)" aria-describedby="wzE" style="flex:1;min-width:0;border:0;background:none;color:var(--tx);font:inherit;font-size:28px;font-weight:800;padding:6px 0;outline:0;border-radius:0"><span class="mu" style="font-weight:700">RWF</span></div><div id="wzE" role="alert" class="sm" style="min-height:20px;margin-top:6px;color:var(--er);font-weight:700">${perr()}</div></div>
${grp(SC.map(v=>chip(M().a===v,`wzSet('a',${v})`,short(v),fm(v)+' RWF')).join(''),t3('Price shortcuts','Ibiciro byihuse','Raccourcis de prix'))}
<div class="pad sm mu" style="padding-top:14px">${t3('Between '+fm(PMIN)+' and '+fm(PMAX)+' RWF.','Hagati ya RWF '+fm(PMIN)+' na '+fm(PMAX)+'.','Entre '+fm(PMIN)+' et '+fm(PMAX)+' RWF.')}</div>
${cta(t3('Next','Komeza','Suivant'),!okP(),'wzGo()','wzB')}`;
const s2=()=>{const p=M(),q=calc(p);return `${head(2,t3('How much will you put down first?','Uzabanza gutanga angahe?','Quel apport versez-vous d’abord ?'),t3('A bigger down payment means a smaller loan.','Ayo utanze menshi, inguzanyo iba nto.','Plus l’apport est grand, plus le prêt est petit.'))}${ctx()}
${grp(DP.map(v=>chip(p.dp===v,`wzSet('dp',${v})`,v+'%')).join(''),t3('Down payment','Amafaranga y’ibanze','Apport'))}
<div style="padding:22px 24px 0;font-size:16px;font-weight:800">${t3('Save it in','Uyabike mu','Épargner en')}</div>${grp(MS.map(v=>chip(p.ms===v,`wzSet('ms',${v})`,mo(v))).join(''))}
<div style="padding-top:8px">${rw(t3('Down payment to save','Ayo ukwiye kubika','Apport à épargner'),fm(q.dn)+' RWF',1)}${rw(t3('About each month','Nka buri kwezi','Environ par mois'),fm(q.sv)+' RWF')}</div>
${cta(t3('Next','Komeza','Suivant'),0,'wzGo()')}`};
const s3=()=>{const p=M(),q=calc(p);return `${head(3,t3('How long will you repay the loan?','Inguzanyo uzayishyura mu gihe kingana iki?','Sur combien de temps remboursez-vous le prêt ?'))}${ctx()}
${grp(TM.map(v=>chip(p.n===v,`wzSet('n',${v})`,mo(v))).join(''),t3('Repay over','Kwishyura mu','Remboursement sur'))}
<div style="padding-top:8px">${rw(t3('Loan amount','Inguzanyo','Montant du prêt'),fm(q.loan)+' RWF ('+(100-p.dp)+'%)')}${rw(t3('Monthly loan payment','Ishyura buri kwezi','Mensualité du prêt'),fm(q.mo)+' RWF',1)}${rw(t3('Interest in total','Inyungu yose','Intérêts au total'),fm(q.int)+' RWF')}${rw(t3('Total to repay','Ugomba kwishyura yose','Total à rembourser'),fm(q.tot)+' RWF')}${rw(t3('Rate','Inyungu','Taux'),RATE+t3('% a year','% ku mwaka',' % par an'))}</div>
<div class="pad sm mu" style="padding-top:12px;line-height:20px">${t3('The loan opens when your down payment is saved.','Inguzanyo ifungurwa umaze kubika amafaranga y’ibanze.','Le prêt s’ouvre quand votre apport est épargné.')}</div>
${cta(t3('Next','Komeza','Suivant'),0,'wzGo()')}`};
const s4=()=>{const p=M(),q=calc(p),mi=p.inc*DAYS,a1=mi?Math.round(q.sv*100/mi):0,a2=mi?Math.round(q.mo*100/mi):0;
 const tag=s=>s<=30?[t3('Comfortable','Birashoboka','Confortable'),'var(--ok)']:s<=45?[t3('Tight','Biragoye','Serré'),'var(--mu)']:[t3('High','Biri hejuru','Élevé'),'var(--er)'];const t1=tag(a1),t2=tag(a2);
 return `${head(4,t3('Can you afford it?','Birashoboka?','Est-ce abordable ?'),t3('Tap what you expect to earn each day. This is your own estimate, not a promise.','Kanda ibyo utekereza kwinjiza buri munsi. Ni uko ubitekereza, ntibivuze ko bizaba.','Touchez ce que vous comptez gagner par jour. C’est votre estimation, pas une promesse.'))}
${grp(INC.map(v=>chip(p.inc===v,`wzSet('inc',${v})`,fm(v))).join(''),t3('Daily earnings','Ibyo winjiza ku munsi','Gains par jour'))}
<div style="margin:18px 24px 0;padding:14px 16px;border-radius:16px;background:var(--chip);font-size:15px;line-height:22px" aria-live="polite"><div style="display:flex;justify-content:space-between;gap:12px"><span>${t3('Saving ','Kubika ','Épargne ')}${fm(q.sv)} RWF</span><b style="color:${t1[1]}">${a1}% · ${t1[0]}</b></div><div style="display:flex;justify-content:space-between;gap:12px;margin-top:4px"><span>${t3('Loan payment ','Kwishyura ','Mensualité ')}${fm(q.mo)} RWF</span><b style="color:${t2[1]}">${a2}% · ${t2[0]}</b></div><div class="sm mu" style="margin-top:8px">${t3('Share of about '+fm(mi)+' RWF a month ('+DAYS+' working days).','Ku nsimbi nka '+fm(mi)+' ku kwezi (iminsi '+DAYS+' y’akazi).','Part d’environ '+fm(mi)+' RWF par mois ('+DAYS+' jours de travail).')}</div></div>
${cta(t3('Start saving '+fm(q.dn)+' RWF','Tangira kubika RWF '+fm(q.dn),'Commencer à épargner '+fm(q.dn)+' RWF'),0,'moReview()')}`};
const _s=screens.svc;
screens.svc=function(){if(S.svk!=='moto'||mine())return _s.apply(this,arguments);
 const st=other()?0:S.moStep;
 return (st===0?`<div class="bar"><button class="ib" aria-label="Back" onclick="back()">${ic('back',24)}</button><b>${title()}</b></div>`:hdr())+[intro,s1,s2,s3,s4][st]()};
window.wzGo=()=>{if(S.moStep===1&&!okP())return;S.moStep=Math.min(N,S.moStep+1);render('fade-none')};
window.wzBack=()=>{if(S.moStep>0){S.moStep--;render('fade-none')}else back()};
window.wzSet=(f,v)=>{M()[f]=v;S.moMs=M().ms;render('fade-none')};
window.wzType=el=>{const v=el.value.replace(/\D/g,'').slice(0,8);M().a=v?Number(v):0;el.value=v?fmt(v):'';const e=document.getElementById('wzE'),b=document.getElementById('wzB');if(e)e.textContent=perr();el.setAttribute('aria-invalid',perr()?'true':'false');if(b)b.disabled=!okP();document.querySelectorAll('.chip[aria-label$=" RWF"]').forEach(c=>{const on=Number(c.getAttribute('aria-label').replace(/\D/g,''))===M().a;c.setAttribute('aria-pressed',on);c.style.background=on?'var(--tx)':'var(--chip)';c.style.color=on?'var(--bg)':'var(--tx)'})};
const _o=window.openSvc;window.openSvc=function(k){if(k==='moto')S.moStep=0;return _o.apply(this,arguments)};
document.title='itunda, clickable prototype v305';
}
/* v305: Moto-Taxi ownership. Before: the first page asked for everything at once: price, shortcuts, down payment, save-in months, down payment to save, repay months, five loan rows, "Can you afford it?" with earnings, the result box, "Before the loan opens" and the small print, in one long scroll; with another savings goal open you still filled in the whole form and then could not start. Now one question per page, with "Step 2 of 4" and a bar: an intro (three plain steps, what you need, "Plan my motorbike"); 1 How much is the motorbike? (typed price or shortcuts, error under it, Next off until it is 1,000,000 to 5,000,000 RWF); 2 How much will you put down first? (30 / 40 / 50%, save in 6 / 12 / 18 months, down payment to save and about each month); 3 How long will you repay the loan? (24 / 36 / 48 months, loan amount, monthly payment, interest, total, rate); 4 Can you afford it? (daily earnings, share of a month, Comfortable / Tight / High) with "Start saving X RWF", which opens the same review as before. Back goes to the previous question, and from the intro leaves the page; the price and choices are kept. With another savings goal open the page now shows only the intro, the note about that goal and "Open my savings goal". Once the goal exists the page (progress, plan, Save 10,000 / 50,000, Apply for your loan, status) is unchanged. English, French and Kinyarwanda; the new copy in fr is new and in rw needs native review, especially "Tegura moto yanjye", "Uzabanza gutanga angahe?" and "Inguzanyo uzayishyura mu gihe kingana iki?". Not in this version: choosing the bike model, and saving the plan before the goal is created. */
</script>
<script>
/* v306 Student loan */
{const t3=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e;
const fm=n=>fmt(Math.round(n)),esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const AMIN=200000,AMAX=3000000,SCS=[500000,1000000,2000000,3000000],YRS=[1,2,3,4],TMS=[12,24,36],RATES=[11,12],N=5;
const short=v=>v>=1e6?v/1e6+'M':v/1e3+'K';
S.apps=S.apps||{};S.stu=S.stu||{lv:0,uni:'',yrs:2,a:1000000,n:24,letter:''};S.stuStep=0;
const D=()=>S.stu,rate=()=>RATES[D().lv];
const calc=()=>{const p=D().a,n=D().n,i=rate()/1200,mo=Math.round(p*i/(1-Math.pow(1+i,-n)));return{mo,tot:mo*n,int:mo*n-p}};
const aerr=()=>{const a=D().a;return !a?'':a<AMIN?t3('Minimum is '+fm(AMIN)+' RWF','Nibura ni RWF '+fm(AMIN),'Minimum : '+fm(AMIN)+' RWF'):a>AMAX?t3('Maximum is '+fm(AMAX)+' RWF','Ntarenza RWF '+fm(AMAX),'Maximum : '+fm(AMAX)+' RWF'):''};
const aOk=()=>D().a>=AMIN&&D().a<=AMAX,uOk=()=>(D().uni||'').trim().length>=3;
const title=()=>t3('Student loan','Inguzanyo y’abanyeshuri','Prêt étudiant');
const lvName=i=>[t3('Undergraduate','Kaminuza (icyiciro cya mbere)','Premier cycle (licence)'),t3('Postgraduate','Nyuma ya kaminuza (Master)','Master ou plus')][i];
const yr=n=>t3(n+(n>1?' years':' year'),'imyaka '+n,n+(n>1?' ans':' an'));
const mo=n=>n+' '+t3('months','mezi','mois');
const locd=()=>S.lang==='fr'?'fr-FR':'en-GB';
const firstPay=(ts,y)=>{const d=new Date(ts);d.setFullYear(d.getFullYear()+y);d.setMonth(d.getMonth()+1);return d.toLocaleDateString(locd(),{month:'long',year:'numeric'})};
const chip=(on,fn,l,al)=>`<button class="chip" aria-pressed="${on}" ${al?`aria-label="${al}" `:''}onclick="${fn}" style="min-width:64px;height:44px;border-radius:22px;border:0;padding:0 16px;font-size:15px;font-weight:800;background:${on?'var(--tx)':'var(--chip)'};color:${on?'var(--bg)':'var(--tx)'}">${l}</button>`;
const grp=(h,l)=>`<div style="display:flex;gap:10px;flex-wrap:wrap;padding:14px 24px 0" role="group" ${l?`aria-label="${l}"`:''}>${h}</div>`;
const lab=t=>`<div style="padding:22px 24px 0;font-size:16px;font-weight:800">${t}</div>`;
const rw=(a,v,b)=>`<div style="margin:10px 24px 0;display:flex;justify-content:space-between;gap:12px;font-size:15px"><span class="mu">${a}</span><b style="text-align:right;${b?'color:var(--tintfg)':''}">${v}</b></div>`;
const R=(a,v)=>`<div style="display:flex;justify-content:space-between;gap:12px;min-height:40px;align-items:center;font-size:15px"><span class="mu">${a}</span><b style="text-align:right">${v}</b></div>`;
const sub=t=>`<div class="mu" style="font-size:15px;line-height:22px;margin-top:8px">${t}</div>`;
const fine=()=>`<div class="pad fine" style="padding-top:14px">${t3('Sample terms for this prototype. No real loan is made.','Amabwiriza y’icyitegererezo. Nta nguzanyo nyayo itangwa.','Conditions d’exemple pour ce prototype. Aucun vrai prêt n’est accordé.')}</div>`;
const lay2=h=>{$('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet">'+h+'</div>';if(typeof focusSheet==='function')focusSheet()};
const cta=(h,dis,fn,id,sec)=>`<div style="height:100px"></div><div class="cta"><button ${id?`id="${id}" `:''}class="btn${sec?' sec2':''}" style="white-space:nowrap" ${dis?'disabled':''} onclick="${fn}">${h}</button></div>`;
const hdr=(back)=>`<div class="bar"><button class="ib" aria-label="Back" onclick="${back}">${ic('back',24)}</button><b>${title()}</b></div>`;
const prog=s=>`<div style="padding:16px 24px 0"><div class="sm mu" style="font-weight:700">${t3('Step '+s+' of '+N,'Intambwe '+s+' kuri '+N,'Étape '+s+' sur '+N)}</div><div style="height:4px;border-radius:2px;background:var(--chip);margin-top:8px;overflow:hidden" role="progressbar" aria-valuenow="${s}" aria-valuemin="1" aria-valuemax="${N}"><div style="height:100%;width:${s*100/N}%;background:var(--lk);transition:width .3s"></div></div></div>`;
const head=(s,h,t)=>`${prog(s)}<div style="padding:18px 24px 0"><div class="h1">${h}</div>${t?sub(t):''}</div>`;
const intro=()=>{const st=(n,t)=>`<div style="display:flex;gap:12px;align-items:center;padding:8px 24px 0"><div style="width:28px;height:28px;border-radius:14px;background:var(--chip);display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:800;flex:none">${n}</div><div style="font-size:16px;line-height:24px">${t}</div></div>`;
 return `<div style="padding:22px 24px 0"><div style="width:72px;height:72px;border-radius:36px;background:var(--tint);display:flex;align-items:center;justify-content:center;font-size:36px">🎓</div><div class="h1" style="margin-top:16px">${title()}</div>${sub(t3('A BRD higher-education loan: 11% a year for undergraduate, 12% for postgraduate. You start repaying after you graduate.','Inguzanyo ya BRD y’amashuri makuru: 11% ku mwaka kuri kaminuza, 12% nyuma ya kaminuza. Utangira kwishyura umaze kurangiza.','Un prêt BRD pour les études supérieures : 11 % par an en premier cycle, 12 % en master. Vous remboursez après l’obtention du diplôme.'))}</div>
<div style="padding-top:18px">${st(1,t3('Tell us about your studies','Tubwire iby’amasomo yawe','Parlez-nous de vos études'))}${st(2,t3('Choose the amount and how long to repay','Hitamo amafaranga n’igihe cyo kwishyura','Choisissez le montant et la durée'))}${st(3,t3('Upload your admission letter','Ohereza ibaruwa ikwemerera kwiga','Envoyez votre lettre d’admission'))}</div>
${lab(t3('Before you apply','Mbere yo gusaba','Avant de demander'))}<div style="padding:8px 24px 0;font-size:15px;line-height:24px">✓ ${t3('Your admission letter (photo or PDF)','Ibaruwa ikwemerera kwiga (ifoto cyangwa PDF)','Votre lettre d’admission (photo ou PDF)')}</div>${fine()}
${cta(t3('Start my application','Tangira gusaba','Commencer ma demande'),0,'stuGo()')}`};
const s1=()=>`${head(1,t3('What are you studying?','Wiga iki?','Quel est votre niveau ?'))}
<div role="radiogroup" style="padding-top:14px">${[0,1].map(i=>`<div class="row tap" role="radio" aria-checked="${D().lv===i}" tabindex="0" onclick="stuSet('lv',${i})" style="padding:14px 24px;${D().lv===i?'background:var(--tint)':''}"><div style="flex:1"><div class="t">${lvName(i)}</div><div class="s">${t3(RATES[i]+'% a year',RATES[i]+'% ku mwaka',RATES[i]+' % par an')}</div></div><div aria-hidden="true" style="font-size:20px">${D().lv===i?'●':'○'}</div></div>`).join('')}</div>${cta(t3('Next','Komeza','Suivant'),0,'stuGo()')}`;
const s2=()=>`${head(2,t3('Where do you study?','Wiga he?','Où étudiez-vous ?'),t3('Type the name of your university or college.','Andika izina rya kaminuza cyangwa ishuri ryawe.','Saisissez le nom de votre université ou école.'))}
<div style="padding:16px 24px 0"><input id="stuU" value="${esc(D().uni)}" oninput="stuUni(this)" autocomplete="off" placeholder="${t3('e.g. University of Rwanda','urugero: University of Rwanda','ex. University of Rwanda')}" style="width:100%;box-sizing:border-box;height:52px;border:0;border-radius:14px;background:var(--chip);color:var(--tx);padding:0 16px;font:inherit;font-size:17px"><div id="stuUH" class="sm mu" style="margin-top:8px;min-height:20px">${D().uni&&!uOk()?t3('Keep typing, at least 3 letters.','Komeza wandike, nibura inyuguti 3.','Continuez, au moins 3 lettres.'):''}</div></div>${cta(t3('Next','Komeza','Suivant'),!uOk(),'stuGo()','stuB')}`;
const s3=()=>`${head(3,t3('How much do you need?','Ukeneye angahe?','De quel montant avez-vous besoin ?'))}
<div style="padding:12px 24px 0"><div style="display:flex;align-items:baseline;gap:8px;border-bottom:2px solid var(--ln)"><input id="stuA" inputmode="numeric" autocomplete="off" placeholder="0" value="${D().a?fmt(D().a):''}" oninput="stuType(this)" aria-describedby="stuE" style="flex:1;min-width:0;border:0;background:none;color:var(--tx);font:inherit;font-size:28px;font-weight:800;padding:6px 0;outline:0;border-radius:0"><span class="mu" style="font-weight:700">RWF</span></div><div id="stuE" role="alert" class="sm" style="min-height:20px;margin-top:6px;color:var(--er);font-weight:700">${aerr()}</div></div>
${grp(SCS.map(v=>chip(D().a===v,`stuSet('a',${v})`,short(v),fm(v)+' RWF')).join(''),t3('Amount shortcuts','Amafaranga yihuse','Raccourcis de montant'))}
<div class="pad sm mu" style="padding-top:14px">${t3('Between '+fm(AMIN)+' and '+fm(AMAX)+' RWF.','Hagati ya RWF '+fm(AMIN)+' na '+fm(AMAX)+'.','Entre '+fm(AMIN)+' et '+fm(AMAX)+' RWF.')}</div>${cta(t3('Next','Komeza','Suivant'),!aOk(),'stuGo()','stuB')}`;
const s4=()=>{const q=calc(),d=D();return `${head(4,t3('When do you finish, and how long will you repay?','Urarangiza ryari, kandi uzishyura mu gihe kingana iki?','Quand finissez-vous, et sur combien de temps remboursez-vous ?'),t3('You pay nothing while you study.','Nta kwishyura mu gihe wiga.','Vous ne payez rien pendant vos études.'))}
${lab(t3('Years until you graduate','Imyaka isigaye ngo urangize','Années avant le diplôme'))}${grp(YRS.map(v=>chip(d.yrs===v,`stuSet('yrs',${v})`,yr(v))).join(''))}
${lab(t3('Repay over','Kwishyura mu','Rembourser sur'))}${grp(TMS.map(v=>chip(d.n===v,`stuSet('n',${v})`,mo(v))).join(''))}
<div style="padding-top:8px">${rw(t3('Monthly payment (after you graduate)','Kwishyura buri kwezi (umaze kurangiza)','Mensualité (après le diplôme)'),fm(q.mo)+' RWF',1)}${rw(t3('Interest ('+rate()+'% a year)','Inyungu ('+rate()+'% ku mwaka)','Intérêts ('+rate()+' % par an)'),fm(q.int)+' RWF')}${rw(t3('Total to repay','Ugomba kwishyura yose','Total à rembourser'),fm(q.tot)+' RWF')}${rw(t3('First payment','Kwishyura bwa mbere','Premier paiement'),firstPay(Date.now(),d.yrs))}</div>
${cta(t3('Next','Komeza','Suivant'),0,'stuGo()')}`};
const s5=()=>{const L=D().letter;return `${head(5,t3('Upload your admission letter','Ohereza ibaruwa ikwemerera kwiga','Envoyez votre lettre d’admission'),t3('A photo or a PDF. It shows your school has admitted you.','Ifoto cyangwa PDF. Yerekana ko ishuri ryakwemeye.','Une photo ou un PDF. Elle prouve que votre école vous a admis.'))}
<div style="padding:18px 24px 0">${L?`<div style="display:flex;align-items:center;gap:12px;padding:14px 16px;border-radius:16px;background:var(--chip)"><div style="font-size:24px">📄</div><div style="flex:1;min-width:0"><div style="font-weight:800;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${esc(L)}</div><div class="sm mu">${t3('Sample file for this prototype','Idosiye y’icyitegererezo','Fichier d’exemple pour ce prototype')}</div></div><button class="chip" onclick="stuLetter(0)">${t3('Remove','Kuraho','Retirer')}</button></div>`
 :`<button class="btn sec2" style="white-space:nowrap" onclick="stuLetter(1)">${t3('Choose a photo or PDF','Hitamo ifoto cyangwa PDF','Choisir une photo ou un PDF')}</button>`}</div>
${cta(t3('Review application','Subiramo ubusabe','Vérifier la demande'),!L,'stuReview()','stuB')}`};
const form=()=>{const st=S.stuStep;return (st===0?hdr('back()'):hdr('stuBack()'))+[intro,s1,s2,s3,s4,s5][st]()};
const tracker=()=>{const a=S.apps.student,st=a.stage,names=[t3('Submitted','Cyoherejwe','Envoyée'),t3('Admission letter check','Isuzuma ry’ibaruwa yo kwemererwa','Vérification de la lettre'),t3('Approved','Cyemejwe','Approuvée'),t3('Funds sent to itunda Pay','Amafaranga yoherejwe muri itunda Pay','Fonds envoyés sur itunda Pay')];
 const desc=[t3('We received your application and your admission letter.','Twakiriye ubusabe bwawe n’ibaruwa yawe.','Nous avons reçu votre demande et votre lettre.'),t3('We check that your school has admitted you.','Turasuzuma ko ishuri ryakwemeye.','Nous vérifions que votre école vous a admis.'),t3('Your loan is approved. Funds are on the way.','Inguzanyo yawe yemejwe. Amafaranga araje.','Votre prêt est approuvé. Les fonds arrivent.'),t3('The money is in your itunda Pay.','Amafaranga ari muri itunda Pay yawe.','L’argent est sur votre itunda Pay.')];
 const tl=names.map((n,i)=>`<div style="display:flex;gap:14px;align-items:flex-start;padding:10px 0"><div style="width:26px;height:26px;border-radius:13px;flex:none;display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:800;background:${i<=st?'var(--lk)':'var(--chip)'};color:${i<=st?'#fff':'var(--mu)'}" ${i===st?'aria-current="step"':''}>${i<st||st===3&&i===3?'✓':i+1}</div><div style="min-width:0"><div style="font-weight:${i===st?800:600};color:${i<=st?'var(--tx)':'var(--mu)'}">${n}</div>${i===st?`<div class="sm mu" style="margin-top:2px;line-height:19px">${desc[i]}</div>`:''}</div></div>`).join('');
 return hdr('back()')+`<div style="padding:22px 24px 0"><div style="width:72px;height:72px;border-radius:36px;background:var(--tint);display:flex;align-items:center;justify-content:center;font-size:36px">🎓</div><div class="h1" style="margin-top:16px">${title()}</div></div>
<div style="margin:18px 24px 0;padding:14px 16px;border-radius:16px;background:var(--tint);color:var(--tintfg);font-size:14px;line-height:20px"><b>${t3('Application sent.','Ubusabe bwoherejwe.','Demande envoyée.')}</b> ${t3('Reference ','Nimero ','Référence ')}${a.ref} · ${fm(a.a)} RWF</div><div style="padding:14px 24px 0">${tl}</div>
${lab(t3('Your loan','Inguzanyo yawe','Votre prêt'))}${rw(t3('Amount','Amafaranga','Montant'),fm(a.a)+' RWF')}${rw(t3('Level','Icyiciro','Niveau'),lvName(a.lv))}${rw(t3('School','Ishuri','École'),esc(a.uni))}${rw(t3('Repay over','Kwishyura mu','Remboursement sur'),mo(a.n))}${rw(t3('Monthly payment','Kwishyura buri kwezi','Mensualité'),fm(a.mo)+' RWF',1)}${rw(t3('Total to repay','Ugomba kwishyura yose','Total à rembourser'),fm(a.tot)+' RWF')}${rw(t3('First payment','Kwishyura bwa mbere','Premier paiement'),firstPay(a.sent,a.yrs))}
${st<3?`<div class="pad" style="padding-top:18px"><button class="chip" onclick="stuNext()">${t3('Next step (sample)','Intambwe ikurikira (icyitegererezo)','Étape suivante (exemple)')}</button></div>`:''}${fine()}<div style="height:100px"></div>${st<2?`<div class="cta"><button class="btn sec2" style="white-space:nowrap" onclick="stuWithdraw()">${t3('Withdraw application','Kuraho ubusabe','Retirer la demande')}</button></div>`:''}`};
const _s=screens.svc;
screens.svc=function(){if(S.svk!=='student')return _s.apply(this,arguments);return S.apps.student?tracker():form()};
window.stuGo=()=>{const s=S.stuStep;if(s===2&&!uOk())return;if(s===3&&!aOk())return;S.stuStep=Math.min(N,s+1);render('fade-none')};
window.stuBack=()=>{if(S.stuStep>0){S.stuStep--;render('fade-none')}else back()};
window.stuSet=(f,v)=>{D()[f]=v;render('fade-none')};
window.stuUni=el=>{D().uni=el.value.slice(0,60);const b=document.getElementById('stuB'),h=document.getElementById('stuUH');if(b)b.disabled=!uOk();if(h)h.textContent=D().uni&&!uOk()?t3('Keep typing, at least 3 letters.','Komeza wandike, nibura inyuguti 3.','Continuez, au moins 3 lettres.'):''};
window.stuType=el=>{const v=el.value.replace(/\D/g,'').slice(0,7);D().a=v?Number(v):0;el.value=v?fmt(v):'';const e=document.getElementById('stuE'),b=document.getElementById('stuB');if(e)e.textContent=aerr();if(b)b.disabled=!aOk();document.querySelectorAll('.chip[aria-label$=" RWF"]').forEach(c=>{const on=Number(c.getAttribute('aria-label').replace(/\D/g,''))===D().a;c.setAttribute('aria-pressed',on);c.style.background=on?'var(--tx)':'var(--chip)';c.style.color=on?'var(--bg)':'var(--tx)'})};
window.stuLetter=on=>{D().letter=on?'admission-letter.pdf':'';render('fade-none')};
window.stuReview=()=>{if(!D().letter||S.apps.student)return;const d=D(),q=calc();
 lay2(`<div class="h1" style="font-size:22px;line-height:30px;margin-top:4px">${t3('Apply for '+fm(d.a)+' RWF?','Gusaba RWF '+fm(d.a)+'?','Demander '+fm(d.a)+' RWF ?')}</div><div style="margin:12px 0 16px">${R(t3('Level','Icyiciro','Niveau'),lvName(d.lv))}${R(t3('School','Ishuri','École'),esc(d.uni.trim()))}${R(t3('You graduate in','Urangiza mu','Diplôme dans'),yr(d.yrs))}${R(t3('Repay over','Kwishyura mu','Remboursement sur'),mo(d.n))}${R(t3('Monthly payment','Kwishyura buri kwezi','Mensualité'),fm(q.mo)+' RWF')}${R(t3('Interest','Inyungu','Intérêts'),fm(q.int)+' RWF ('+rate()+t3('% a year','% ku mwaka',' % par an')+')')}${R(t3('Total to repay','Ugomba kwishyura yose','Total à rembourser'),fm(q.tot)+' RWF')}${R(t3('Admission letter','Ibaruwa yo kwemererwa','Lettre d’admission'),esc(d.letter))}</div><div class="mu sm" style="margin:-4px 0 16px;line-height:20px">${t3('Next: we check your admission letter. Money is sent to itunda Pay once approved. You can withdraw until it is approved.','Ibikurikira: turasuzuma ibaruwa yawe. Amafaranga yoherezwa muri itunda Pay yemejwe. Ushobora kuyikuraho itaremezwa.','Ensuite : nous vérifions votre lettre. L’argent est envoyé sur itunda Pay après approbation. Vous pouvez retirer la demande avant.')}</div><div style="display:grid;grid-template-columns:1fr 1.8fr;gap:12px"><button class="btn sec2" onclick="closeSheet()">${t3('Cancel','Hagarika','Annuler')}</button><button class="btn" style="white-space:nowrap" onclick="stuSend()">${t3('Send application','Ohereza ubusabe','Envoyer la demande')}</button></div>`)};
window.stuSend=()=>{if(!D().letter||S.apps.student){closeSheet();return}const d=D(),q=calc();S.apps.student={ref:'ITN-'+String(Date.now()).slice(-6),a:d.a,n:d.n,mo:q.mo,tot:q.tot,lv:d.lv,uni:d.uni.trim(),yrs:d.yrs,sent:Date.now(),stage:0};closeSheet();render('fade-none');
 lay2(`<div class="g3" style="font-size:56px;line-height:1;margin-bottom:10px">📨</div><div class="h1" style="font-size:22px;line-height:30px">${t3('Application sent','Ubusabe bwoherejwe','Demande envoyée')}</div><div class="mu" style="font-size:15px;margin:8px 0 24px;line-height:22px">${t3('Reference '+S.apps.student.ref+'. We will check your admission letter.','Nimero '+S.apps.student.ref+'. Turasuzuma ibaruwa yawe.','Référence '+S.apps.student.ref+'. Nous allons vérifier votre lettre.')}</div><button class="btn" onclick="closeSheet()">OK</button>`)};
window.stuNext=()=>{const a=S.apps.student;if(!a||a.stage>=3)return;a.stage++;if(a.stage===3){S.pay+=a.a;if(Array.isArray(S.act))S.act.unshift(['wallet',title()+' · '+a.ref,'Received · Just now',a.a,'Received']);toast('+'+fm(a.a)+' RWF '+t3('added to itunda Pay','yongewe muri itunda Pay','ajoutés à itunda Pay'))}render('fade-none')};
window.stuWithdraw=()=>lay2(`<div class="h1" style="font-size:22px;line-height:30px;margin-top:4px">${t3('Withdraw your application?','Gukuraho ubusabe bwawe?','Retirer votre demande ?')}</div><div class="mu" style="font-size:15px;margin:8px 0 24px;line-height:22px">${t3('We will not review it. You can apply again later.','Ntituzabusuzuma. Ushobora gusaba nanone.','Nous ne l’examinerons pas. Vous pourrez redemander plus tard.')}</div><div style="display:grid;grid-template-columns:1fr 1.8fr;gap:12px"><button class="btn sec2" onclick="closeSheet()">${t3('Keep it','Reka ikomeze','Garder')}</button><button class="btn" style="white-space:nowrap" onclick="stuWithdrawGo()">${t3('Withdraw','Kuraho','Retirer')}</button></div>`);
window.stuWithdrawGo=()=>{delete S.apps.student;S.stuStep=0;S.stu.letter='';closeSheet();render('fade-none');toast(t3('Application withdrawn','Ubusabe bwakuweho','Demande retirée'))};
const _o=window.openSvc;window.openSvc=function(k){if(k==='student')S.stuStep=0;return _o.apply(this,arguments)};
document.title='itunda, clickable prototype v306';
}
/* v306: Student loan. Before: the page was English only (French and Kinyarwanda fell back to a plain card); the first screen held amount shortcuts, level, repay months and the totals; "Apply" said "Upload your admission letter in the next step" but there was no next step: nothing asked for the letter, the school or when you graduate, and after sending the page only said "Application sent". Now one question per page, with "Step 2 of 5" and a bar, after an intro (what it is, three steps, what you need): 1 Level (Undergraduate 11% or Postgraduate 12%); 2 Where do you study? (typed, at least 3 letters); 3 How much do you need? (typed or 500K / 1M / 2M / 3M, 200,000 to 3,000,000 RWF, error under it); 4 When do you finish and how long will you repay? (1 to 4 years to graduate, 12 / 24 / 36 months, monthly payment after you graduate, interest, total, and the month of the first payment); 5 Upload your admission letter (the sample file attaches with one tap and can be removed; Review stays off until it is attached). A review lists everything, then \"Send application\". After sending, the page is a tracker (Submitted, Admission letter check, Approved, Funds sent to itunda Pay) with the loan details and the first payment month, \"Next step (sample)\" (which adds the money to itunda Pay and Activity) and \"Withdraw application\" until it is approved. English, French and Kinyarwanda; fr is new copy and rw is new copy that needs native review, especially \"Kaminuza (icyiciro cya mbere)\", \"Nyuma ya kaminuza (Master)\", \"Wiga he?\" and \"Urarangiza ryari, kandi uzishyura mu gihe kingana iki?\". Not in this version: choosing a real file from the phone, paying the school directly, and a grace-period interest rule. */
</script>
<script>
/* v307 Foreign currency */
{const t3=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e,CODES=['USD','EUR','GBP'],FLAG={USD:'🇺🇸',EUR:'🇪🇺',GBP:'🇬🇧'},RATE={USD:1445,EUR:1680,GBP:1960},MINB=5000,QB=[20000,50000,100000,250000],QG=[10,25,50,100];
const esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const fx=()=>{const x=S.fx;if(!x.d)x.d='buy';if(x.s==null)x.s=0;if(!x.w)x.w={USD:0,EUR:0,GBP:0};if(!x.m)x.m='rwf';if(x.g==null)x.g=100;return x};
const cur=()=>CODES[fx().c]||'USD',d2=n=>(Math.floor(n*100+1e-6)/100).toFixed(2);
const buy=()=>fx().d==='buy',inCur=()=>buy()&&fx().m==='cur';
const calc=()=>{const x=fx(),c=cur(),r=RATE[c],w=x.w[c]||0;let err='',ok=false,pay,get;
 if(buy()){
  if(inCur()){get=Math.floor(x.g*100+1e-6)/100;pay=Math.ceil(Math.round(get*r*100)/100);
   if(!get)err='';else if(pay<MINB)err=t3('Minimum is '+fmt(MINB)+' RWF (about '+d2(MINB/r)+' '+c+')','Nibura ni RWF '+fmt(MINB)+' (hafi '+d2(MINB/r)+' '+c+')','Minimum : '+fmt(MINB)+' RWF (environ '+d2(MINB/r)+' '+c+')');
   else if(pay>S.bank)err=t3('That costs '+fmt(pay)+' RWF. You have '+fmt(S.bank)+' RWF.','Bigura RWF '+fmt(pay)+'. Ufite RWF '+fmt(S.bank)+'.','Cela coûte '+fmt(pay)+' RWF. Vous avez '+fmt(S.bank)+' RWF.');else ok=true}
  else{pay=x.a;get=x.a/r;
   if(!x.a)err='';else if(x.a<MINB)err=t3('Minimum is '+fmt(MINB)+' RWF','Nibura ni RWF '+fmt(MINB),'Minimum : '+fmt(MINB)+' RWF');else if(x.a>S.bank)err=t3('Not enough balance. You have '+fmt(S.bank)+' RWF.','Nta mafaranga ahagije. Ufite RWF '+fmt(S.bank)+'.','Solde insuffisant. Vous avez '+fmt(S.bank)+' RWF.');else ok=true}}
 else{pay=x.s;get=Math.round(x.s*r);
  if(!x.s)err='';else if(x.s<1)err=t3('Minimum is 1.00 '+c,'Nibura ni '+c+' 1.00','Minimum : 1,00 '+c);else if(x.s>w+1e-9)err=t3('Not enough in your '+c+' wallet. You have '+d2(w)+' '+c+'.','Nta mafaranga ahagije muri '+c+'. Ufite '+d2(w)+' '+c+'.','Solde insuffisant. Vous avez '+d2(w)+' '+c+'.');else ok=true}
 return {c,r,w,err,ok,pay,get}};
const quick=()=>buy()?(inCur()?QG.map(n=>[n,String(n),fx().g===n]):QB.map(n=>[n,n/1000+'K',fx().a===n])):[[.25,'25%'],[.5,'50%'],[1,t3('All','Byose','Tout')]].map(([p,l])=>[p,l,Math.abs(fx().s-Math.floor((fx().w[cur()]||0)*p*100)/100)<.005&&fx().s>0]);
const lbl=k=>buy()?(k.ok?(inCur()?t3('Buy '+d2(k.get)+' '+k.c+' for '+fmt(k.pay)+' RWF','Gura '+d2(k.get)+' '+k.c+' kuri RWF '+fmt(k.pay),'Acheter '+d2(k.get)+' '+k.c+' pour '+fmt(k.pay)+' RWF'):t3('Convert '+fmt(k.pay)+' RWF to '+k.c,'Hindura RWF '+fmt(k.pay)+' mu '+k.c,'Convertir '+fmt(k.pay)+' RWF en '+k.c)):t3('Convert to '+k.c,'Hindura mu '+k.c,'Convertir en '+k.c)):(k.ok?t3('Convert '+d2(k.pay)+' '+k.c+' to RWF','Hindura '+k.c+' '+d2(k.pay)+' mu RWF','Convertir '+d2(k.pay)+' '+k.c+' en RWF'):t3('Convert to RWF','Hindura mu RWF','Convertir en RWF'));
const out=k=>buy()?(inCur()?(k.pay?fmt(k.pay)+' RWF':'0 RWF'):(k.pay?d2(k.get)+' '+k.c:'0.00 '+k.c)):(k.pay?fmt(k.get)+' RWF':'0 RWF');
const after=k=>k.ok?t3('itunda Bank after: '+fmt(buy()?S.bank-k.pay:S.bank+k.get)+' RWF','itunda Bank nyuma: RWF '+fmt(buy()?S.bank-k.pay:S.bank+k.get),'itunda Bank après : '+fmt(buy()?S.bank-k.pay:S.bank+k.get)+' RWF'):'';
function fxUpd(){const k=calc(),g=$('#fxg'),e=$('#fxe'),n=$('#fxn'),b=$('#fxb');if(!g)return;
 g.textContent=out(k);e.textContent=k.err;$('#fxi').setAttribute('aria-invalid',k.err?'true':'false');n.textContent=after(k);b.disabled=!k.ok;b.textContent=lbl(k);
 const q=quick();document.querySelectorAll('#fxq button').forEach((el,i)=>{const on=q[i][2];el.classList.toggle('on',on);el.setAttribute('aria-pressed',on?'true':'false')})}
window.fxIn=v=>{const x=fx();
 if(buy()&&!inCur()){x.a=Math.min(999999999,Number(String(v).replace(/\D/g,''))||0);const i=$('#fxi');i.value=x.a?fmt(x.a):''}
 else{let q=String(v).replace(/[^\d.]/g,'');const p=q.split('.');q=p[0].slice(0,9)+(p.length>1?'.'+p[1].slice(0,2):'');if(inCur())x.g=Number(q)||0;else x.s=Number(q)||0;if(q!==String(v))$('#fxi').value=q}
 fxUpd()};
window.fxQ=i=>{const x=fx(),v=quick()[i][0];if(buy()){if(inCur())x.g=v;else x.a=v}else x.s=Math.floor((x.w[cur()]||0)*v*100)/100;render('fade-none')};
window.fxMode=()=>{const x=fx();x.m=x.m==='cur'?'rwf':'cur';render('fade-none')};
const row=(a,v)=>`<div style="display:flex;justify-content:space-between;gap:12px;padding:6px 24px 0;font-size:14px"><span class="mu">${a}</span><span>${v}</span></div>`;
screens.fx=()=>{const x=fx(),k=calc(),c=k.c,b=buy(),ic2=inCur();
 const flagc=CODES.map((cc,i)=>`<button class="${x.c===i?'on':''}" aria-pressed="${x.c===i}" onclick="fxCur(${i})">${FLAG[cc]} ${cc}</button>`).join('');
 const seg=`<div class="cdch" style="margin:16px 24px 0" role="group"><button class="${b?'on':''}" aria-pressed="${b}" onclick="fxDir('buy')">${t3('Buy '+c,'Gura '+c,'Acheter '+c)}</button><button class="${b?'':'on'}" aria-pressed="${!b}" onclick="fxDir('sell')">${t3('Sell '+c,'Gurisha '+c,'Vendre '+c)}</button></div>`;
 const av=b?t3('Available: '+fmt(S.bank)+' RWF','Ahari: RWF '+fmt(S.bank),'Disponible : '+fmt(S.bank)+' RWF'):t3('In your wallet: '+d2(k.w)+' '+c,'Muri wallet: '+d2(k.w)+' '+c,'Dans votre portefeuille : '+d2(k.w)+' '+c);
 const unit=b&&!ic2?'RWF':c,top=b?(ic2?t3('You get','Uhabwa','Vous recevez'):t3('You pay','Wishyura','Vous payez')):t3('You sell','Ugurisha','Vous vendez'),bot=b?(ic2?t3('You pay','Wishyura','Vous payez'):t3('You get','Uhabwa','Vous recevez')):t3('You get','Uhabwa','Vous recevez');
 const val=b?(ic2?(x.g?String(x.g):''):(x.a?fmt(x.a):'')):(x.s?String(x.s):'');
 const mode=b?`<button onclick="fxMode()" style="border:0;background:none;padding:10px 0 0;font:inherit;font-size:14px;font-weight:800;color:var(--lk);text-align:left">${ic2?t3('Enter the amount in RWF','Andika amafaranga muri RWF','Saisir le montant en RWF'):t3('I want an exact amount of '+c,'Nshaka umubare nyawo wa '+c,'Je veux un montant exact en '+c)}</button>`:'';
 const q=quick();
 const held=CODES.filter(cc=>(x.w[cc]||0)>0);
 const wal=held.length?held.map(cc=>{const w=x.w[cc],i=CODES.indexOf(cc);return `<button class="fxw" onclick="fxWal(${i})"><span class="fxf">${FLAG[cc]}</span><span class="nm"><b>${cc}</b><span>${t3('Tap to sell','Kanda ugurishe','Touchez pour vendre')}</span></span><span class="am"><b>${d2(w)} ${cc}</b><span>≈ ${fmt(Math.round(w*RATE[cc]))} RWF</span></span></button>`}).join(''):`<div class="mu" style="padding:0 24px;font-size:15px;line-height:22px">${t3('You hold no foreign currency yet.','Nta mafaranga y’amahanga ufite.','Vous ne détenez pas encore de devises.')}</div>`;
 return `${bar(t3('Foreign currency','Amafaranga y’amahanga','Devises'))}<div class="fxc" role="group" aria-label="${t3('Currency','Ifaranga','Devise')}">${flagc}</div>${seg}
<div class="fxa"><label class="sm mu" for="fxi">${top}</label><div class="fxr"><input class="in" id="fxi" inputmode="${b&&!ic2?'numeric':'decimal'}" autocomplete="off" placeholder="0" value="${val}" oninput="fxIn(this.value)" aria-describedby="fxe" aria-invalid="${!!k.err}"><b>${unit}</b></div><div class="sm mu" style="margin-top:2px">${av}</div>${mode}</div>
<div class="cdch" id="fxq" style="margin:10px 24px 0" role="group" aria-label="${t3('Quick amounts','Umubare uhuse','Montants rapides')}">${q.map(([v,l,on],i)=>`<button class="${on?'on':''}" aria-pressed="${on}" onclick="fxQ(${i})">${l}</button>`).join('')}</div><div class="fxe" id="fxe" role="alert">${k.err}</div>
<div class="fxg"><div class="sm">${bot}</div><b id="fxg">${out(k)}</b></div>
<div style="padding-top:8px">${row(t3('Rate','Igiciro','Taux'),'1 '+c+' = '+fmt(k.r)+' RWF')}${row(t3('Fee','Kiguzi','Frais'),t3('None','Nta kiguzi','Aucun'))}<div class="sm mu" id="fxn" style="padding:6px 24px 0">${after(k)}</div><div class="fine" style="padding:6px 24px 0">${t3('Sample rates for this prototype.','Ibiciro by’icyitegererezo kuri iyi porogaramu.','Taux d’exemple pour ce prototype.')}</div></div>
<div style="padding:22px 24px 8px;font-size:18px;font-weight:800">${t3('Your wallets','Ama wallet yawe','Vos portefeuilles')}</div>${wal}<div style="height:110px"></div>
<div class="cta"><button class="btn" id="fxb" ${k.ok?'':'disabled'} onclick="fxAsk()">${lbl(k)}</button></div>`};
const rw=(a,v)=>`<div style="display:flex;justify-content:space-between;gap:12px;min-height:40px;align-items:center;font-size:15px"><span class="mu">${a}</span><b style="text-align:right">${v}</b></div>`;
window.fxAsk=()=>{const k=calc();if(!k.ok)return;const c=k.c,b=buy();
 const rows=b?rw(t3('You pay','Wishyura','Vous payez'),fmt(k.pay)+' RWF')+rw(t3('You get','Uhabwa','Vous recevez'),d2(k.get)+' '+c)+rw(t3('Rate','Igiciro','Taux'),'1 '+c+' = '+fmt(k.r)+' RWF')+rw(t3('Fee','Kiguzi','Frais'),t3('None','Nta kiguzi','Aucun'))+rw(t3('itunda Bank after','itunda Bank nyuma','itunda Bank après'),fmt(S.bank-k.pay)+' RWF')
 :rw(t3('You sell','Ugurisha','Vous vendez'),d2(k.pay)+' '+c)+rw(t3('You get','Uhabwa','Vous recevez'),fmt(k.get)+' RWF')+rw(t3('Rate','Igiciro','Taux'),'1 '+c+' = '+fmt(k.r)+' RWF')+rw(t3('Fee','Kiguzi','Frais'),t3('None','Nta kiguzi','Aucun'))+rw(t3('Goes to','Bijya muri','Versé sur'),'itunda Bank');
 $('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" role="dialog" aria-modal="true" aria-label="${t3('Review','Suzuma','Vérifier')}"><div class="h1" style="font-size:22px;line-height:30px;margin-top:4px">${b?t3('Convert to '+c+'?','Guhindura mu '+c+'?','Convertir en '+c+' ?'):t3('Sell '+d2(k.pay)+' '+c+'?','Gurisha '+d2(k.pay)+' '+c+'?','Vendre '+d2(k.pay)+' '+c+' ?')}</div><div style="margin:12px 0 20px">${rows}</div><div class="row2" style="display:grid;grid-template-columns:1fr 1.8fr"><button class="btn sec2" onclick="closeSheet()">${t3('Cancel','Reka','Annuler')}</button><button class="btn" style="white-space:nowrap" onclick="fxDo()">${b?t3('Convert','Hindura','Convertir'):t3('Sell','Gurisha','Vendre')}</button></div></div>`;if(typeof focusSheet==='function')focusSheet()};
window.fxDo=()=>{const k=calc();if(!k.ok){closeSheet();return}const x=fx(),c=k.c,b=buy();let tt,bd;
 if(b){S.bank-=k.pay;x.w[c]=(x.w[c]||0)+k.pay/k.r;addAct('cyc','Converted to '+c,'Converted',-k.pay,'Moved');tt=t3('Converted to '+c,'Byahinduwe mu '+c,'Converti en '+c);bd=t3(fmt(k.pay)+' RWF became '+d2(k.get)+' '+c+'. It is in your '+c+' wallet.','RWF '+fmt(k.pay)+' yabaye '+d2(k.get)+' '+c+'. Iri muri wallet yawe ya '+c+'.',fmt(k.pay)+' RWF sont devenus '+d2(k.get)+' '+c+'. Ils sont dans votre portefeuille '+c+'.');x.a=50000;x.g=100}
 else{x.w[c]=Math.max(0,(x.w[c]||0)-k.pay);if(x.w[c]<.005)x.w[c]=0;S.bank+=k.get;addAct('cyc',c+' converted to RWF','Converted',k.get,'Moved');tt=t3(c+' converted to RWF',c+' yahindutse RWF',c+' converti en RWF');bd=t3(d2(k.pay)+' '+c+' became '+fmt(k.get)+' RWF in itunda Bank.',d2(k.pay)+' '+c+' yabaye RWF '+fmt(k.get)+' muri itunda Bank.',d2(k.pay)+' '+c+' sont devenus '+fmt(k.get)+' RWF sur itunda Bank.');x.s=0;x.d=(x.w[c]||0)>0?'sell':'buy'}
 $('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" role="dialog" aria-modal="true" aria-label="${esc(tt)}"><div style="font-size:56px;line-height:1;margin-bottom:10px">💱</div><div class="h1" style="font-size:22px;line-height:30px">${esc(tt)}</div><div class="mu" style="font-size:15px;margin:8px 0 24px;line-height:22px">${esc(bd)}</div><button class="btn" onclick="closeSheet();render('fade-none')">OK</button></div>`;if(typeof focusSheet==='function')focusSheet();render('fade-none')};
/* v312 additions: rate trend, rate alert, wallet total, recent conversions */
const OFF={USD:[-1.1,-.8,-.9,-.4,-.2,-.1,0],EUR:[.7,.5,.2,.3,.1,-.2,0],GBP:[-.4,-.7,-.3,-.1,.2,.1,0]};
const series=c=>OFF[c].map(o=>Math.round(RATE[c]*(1+o/100)));
const al=()=>{const x=fx();if(!x.al)x.al={};return x.al};
const alTxt=(c,a)=>(a.dir==='up'?'≥ ':'≤ ')+fmt(a.v)+' RWF';
const _fx=screens.fx;
screens.fx=()=>{let h=_fx();const c=cur(),sr=series(c),mn=Math.min(...sr),mx=Math.max(...sr),ch=(sr[6]-sr[0])*100/sr[0],up=ch>=0,A=al()[c];
const pts=sr.map((v,i)=>(i*50+5)+','+(52-(v-mn)*44/Math.max(1,mx-mn))).join(' '),last=pts.split(' ')[6].split(',');
const card=`<div style="margin:18px 24px 0;padding:16px;border-radius:20px;background:var(--chip)"><div style="display:flex;justify-content:space-between;align-items:baseline;gap:8px"><b>${c} · ${t3('last 7 days','iminsi 7 ishize','7 derniers jours')}</b><span class="sm" style="font-weight:800;color:${up?'var(--ok)':'var(--er)'}">${up?'▲':'▼'} ${Math.abs(ch).toFixed(1)}%</span></div><svg viewBox="0 0 310 60" width="100%" height="60" role="img" aria-label="${t3('Rate trend for '+c+': '+(up?'up ':'down ')+Math.abs(ch).toFixed(1)+'% in 7 days','Uko igiciro cya '+c+' cyagenze','Évolution du taux '+c)}" style="margin-top:8px;display:block"><polyline points="${pts}" fill="none" stroke="${up?'var(--ok)':'var(--er)'}" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/><circle cx="${last[0]}" cy="${last[1]}" r="4.5" fill="${up?'var(--ok)':'var(--er)'}"/></svg><div class="sm mu" style="display:flex;justify-content:space-between;margin-top:4px"><span>${t3('Low','Gito','Bas')} ${fmt(mn)}</span><span>${t3('High','Hejuru','Haut')} ${fmt(mx)}</span></div><button class="tap" onclick="fxAl()" style="margin-top:12px;width:100%;min-height:48px;border:0;border-radius:14px;background:var(--bg);color:var(--tx);font:inherit;display:flex;align-items:center;justify-content:space-between;gap:10px;padding:0 14px;text-align:left"><span style="font-weight:700">${t3('Rate alert','Imenyesha y’igiciro','Alerte de taux')}</span><span class="sm" style="color:${A?'var(--tintfg)':'var(--mu)'};font-weight:700">${A?alTxt(c,A):t3('Off','Ntikora','Désactivée')} ›</span></button></div>`;
h=h.replace(/(<div style="padding:22px 24px 8px;font-size:18px;font-weight:800">)/,card+'$1');
const tot=CODES.reduce((a,k)=>a+Math.round((fx().w[k]||0)*RATE[k]),0);
const rec=S.act.filter(x=>x[0]==='cyc'&&/converted/i.test(x[1])).slice(0,3),dl=ms=>new Date(ms).toLocaleDateString(({en:'en-GB',fr:'fr-FR',rw:'en-GB'})[S.lang]||'en-GB',{day:'numeric',month:'short'});
const extra=(tot>0?`<div style="display:flex;justify-content:space-between;padding:6px 24px 0;font-size:14px" class="mu"><span>${t3('Total value','Agaciro kose','Valeur totale')}</span><b style="color:var(--tx)">≈ ${fmt(tot)} RWF</b></div>`:'')+`<div style="padding:22px 24px 4px;font-size:18px;font-weight:800">${t3('Recent conversions','Ibyahinduwe vuba','Conversions récentes')}</div><div style="padding:0 24px">${rec.length?rec.map(x=>`<div class="bdr" role="button" tabindex="0" onclick="actOpen(${S.act.indexOf(x)})" style="padding-left:0;padding-right:0"><div class="ico">💱</div><div style="min-width:0"><div class="t">${esc48(x[1])}</div><div class="s">${x[5]?dl(x[5]):''}</div></div><div class="pkv"><b>${x[3]>0?'+':'−'}${fmt(Math.abs(x[3]))} RWF</b></div></div>`).join(''):`<div class="mu" style="font-size:15px;line-height:22px;padding:8px 0">${t3('No conversions yet. They will show here.','Nta cyahinduwe. Bizagaragara hano.','Aucune conversion. Elles apparaîtront ici.')}</div>`}</div>`;
return h.replace('<div style="height:110px"></div>',extra+'<div style="height:110px"></div>')};
window.fxAl=()=>{const c=cur(),r=RATE[c],A=al()[c],q=S.fxq||(S.fxq=A?{...A}:{dir:'up',v:Math.round(r*1.02)});S.fxq=q;
const opts=[['up',1],['up',2],['down',1],['down',2]].map(([d,p])=>{const v=Math.round(r*(1+(d==='up'?p:-p)/100)),on=q.v===v&&q.dir===d;return `<button class="${on?'on':''}" aria-pressed="${on}" onclick="fxAlPick('${d}',${v})">${d==='up'?'▲':'▼'} ${fmt(v)}</button>`}).join('');
$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" role="dialog" aria-modal="true" aria-label="${t3('Rate alert','Imenyesha y’igiciro','Alerte de taux')}"><div class="h1" style="font-size:22px;line-height:30px;margin-top:4px">${t3('Rate alert for '+c,'Imenyesha y’igiciro cya '+c,'Alerte de taux '+c)}</div><div class="mu" style="font-size:15px;line-height:22px;margin:8px 0 4px">${t3('Now 1 '+c+' = '+fmt(r)+' RWF. Tell me when it reaches:','None 1 '+c+' = RWF '+fmt(r)+'. Mbwira iyo igeze kuri:','Actuellement 1 '+c+' = '+fmt(r)+' RWF. Prévenez-moi à :')}</div><div class="cdch" role="group" style="margin:12px 0 0">${opts}</div><div class="sm mu" style="margin-top:12px;line-height:19px">${t3('Sample only. No real notification is sent in this prototype.','Icyitegererezo gusa. Nta menyesha nyaryo rizoherezwa.','Exemple uniquement. Aucune vraie notification n’est envoyée.')}</div><button class="btn" style="margin-top:18px" onclick="fxAlSet()">${t3('Set alert','Shyiraho imenyesha','Activer l’alerte')}</button>${A?`<button class="btn sec2" style="margin-top:10px;color:var(--er)" onclick="fxAlOff()">${t3('Turn off','Zimya','Désactiver')}</button>`:''}</div>`;if(typeof focusSheet==='function')focusSheet()};
window.fxAlPick=(d,v)=>{S.fxq={dir:d,v};window.fxAl()};
window.fxAlSet=()=>{const c=cur(),q=S.fxq;if(!q)return;al()[c]={dir:q.dir,v:q.v};S.fxq=null;closeSheet();render('fade-none');toast(t3('Alert set: '+c+' '+alTxt(c,q),'Imenyesha ryashyizweho: '+c,'Alerte activée : '+c+' '+alTxt(c,q)))};
window.fxAlOff=()=>{delete al()[cur()];S.fxq=null;closeSheet();render('fade-none');toast(t3('Alert off','Imenyesha ryazimijwe','Alerte désactivée'))};
document.title='itunda, clickable prototype v307';
}
/* v307: Foreign currency. Before: you could only type what you pay in RWF, so paying a bill of exactly 100 USD meant guessing the RWF; the rate line was one long sentence that wrapped (rate, no fee and "sample rate, updated just now" together); "Your wallets" always listed USD, EUR and GBP, including the empty ones with "0.00 EUR". Now: under the amount, a link switches between "I want an exact amount of USD" and "Enter the amount in RWF". In the exact mode you type what you get (two decimals, shortcuts 10 / 25 / 50 / 100), the box below shows what you pay in whole RWF (rounded up so you get at least what you asked for), the button reads \"Buy 100.00 USD for 144,500 RWF\", and the minimum and \"not enough balance\" messages are in the same terms (\"That costs 144,500 RWF. You have 120,000 RWF.\"). The rate and the fee are two plain lines, with one short line saying the rates are samples. \"Your wallets\" lists only the currencies you hold, or \"You hold no foreign currency yet.\" Selling, the review sheet, the result sheet and Activity are unchanged. English, French and Kinyarwanda; fr is new copy and rw is new copy that needs native review, especially \"Nshaka umubare nyawo wa USD\", \"Bigura RWF\" and \"Nta mafaranga y’amahanga ufite\". Not in this version: more currencies (KES, UGX), a rate alert, and a rate history. */
</script>
<script>
/* v308 Subscriptions */
{const t3=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e;
const esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const DAY0={'Canal+ Rwanda':3,'MTN data bundle':1,'Gym Kigali':1,'Music streaming':9};
const CAT=[['📡','StarTimes',8000,'Monthly'],['🎬','Netflix',9000,'Monthly'],['☁️','Cloud storage',1500,'Monthly'],['🌐','Home internet',20000,'Monthly'],['📰','News app',2000,'Monthly']];
const QA=[2000,5000,10000,20000],AMIN=500,AMAX=1000000,N=3,MD=[1,5,10,15,20,25,28],WD=[1,2,3,4,5,6,0];
const RWM=['Mutarama','Gashyantare','Werurwe','Mata','Gicurasi','Kamena','Nyakanga','Kanama','Nzeri','Ukwakira','Ugushyingo','Ukuboza'];
const RWD=['Ku cyumweru','Kuwa mbere','Kuwa kabiri','Kuwa gatatu','Kuwa kane','Kuwa gatanu','Kuwa gatandatu'];
const mig=()=>{S.subs.forEach(s=>{if(s[6]==null)s[6]=DAY0[s[1]]!=null?DAY0[s[1]]:1;if(s[7]==null)s[7]=0;if(s[8]==null)s[8]=0})};
const t0=()=>{const d=new Date();d.setHours(0,0,0,0);return d};
const nextOf=s=>{const t=t0();if(s[3]==='Weekly'){const x=new Date(t);x.setDate(x.getDate()+(s[6]-t.getDay()+7)%7);return x}
 let x=new Date(t.getFullYear(),t.getMonth(),s[6]);if(x<t)x=new Date(t.getFullYear(),t.getMonth()+1,s[6]);return x};
const firstOf=(b,d)=>nextOf([0,0,0,b,0,1,d]);
const prevOf=(s,n)=>{const o=[];let d=nextOf(s);for(let i=0;i<n;i++){d=s[3]==='Weekly'?new Date(d.getFullYear(),d.getMonth(),d.getDate()-7):new Date(d.getFullYear(),d.getMonth()-1,s[6]);if(s[8]&&d<new Date(s[8]))break;o.push(d)}return o};
const loc=()=>S.lang==='fr'?'fr-FR':'en-GB';
const fd=(d,w)=>S.lang==='rw'?(w?RWD[d.getDay()]+' ':'')+d.getDate()+' '+RWM[d.getMonth()]:d.toLocaleDateString(loc(),w?{weekday:'short',day:'numeric',month:'short'}:{day:'numeric',month:'short'});
const rel=d=>{const n=Math.round((d-t0())/864e5);return n===0?t3('today','uyu munsi','aujourd’hui'):n===1?t3('tomorrow','ejo','demain'):t3('in '+n+' days','mu minsi '+n,'dans '+n+' jours')};
const wdn=i=>S.lang==='rw'?RWD[i]:new Date(2024,0,7+i).toLocaleDateString(loc(),{weekday:S.lang==='fr'?'short':'short'});
const wdl=i=>S.lang==='rw'?RWD[i]:new Date(2024,0,7+i).toLocaleDateString(loc(),{weekday:'long'});
const bl=b=>b==='Weekly'?t3('Weekly','Buri cyumweru','Hebdomadaire'):t3('Monthly','Buri kwezi','Mensuel');
const per=s=>s[3]==='Weekly'?t3('week','cyumweru','semaine'):t3('month','kwezi','mois');
const mo=s=>s[3]==='Weekly'?s[2]*52/12:s[2];
const upto=days=>{const t=t0(),end=new Date(t.getFullYear(),t.getMonth(),t.getDate()+days),r={sum:0,cnt:0};S.subs.forEach(s=>{if(!s[5])return;let d=nextOf(s);while(d<=end){r.sum+=s[2];r.cnt++;if(s[3]==='Weekly')d=new Date(d.getFullYear(),d.getMonth(),d.getDate()+7);else break}});return r};
const leftMonth=()=>{const t=t0(),days=Math.round((new Date(t.getFullYear(),t.getMonth()+1,0)-t)/864e5);return upto(days)};
const R=(a,v)=>`<div style="display:flex;justify-content:space-between;gap:12px;min-height:40px;align-items:center;font-size:15px"><span class="mu">${a}</span><b style="text-align:right">${v}</b></div>`;
const Rd=(a,v,s)=>`<div style="display:flex;justify-content:space-between;gap:16px;min-height:44px;align-items:center;font-size:15px;padding:4px 0"><span class="mu" style="flex:0 1 40%">${a}</span><span style="flex:1;text-align:right"><b>${v}</b>${s?`<div class="mu" style="font-size:13px;font-weight:400">${s}</div>`:''}</span></div>`;
const Rn=(a,v)=>R(a,v).replace('<b style="text-align:right">','<b style="text-align:right;white-space:nowrap">');
const hd=t=>`<div style="padding:22px 24px 0;font-size:16px;font-weight:800">${t}</div>`;
const fine=t=>`<div class="pad fine" style="padding-top:16px">${t}</div>`;
const cta=(h,dis,fn,id)=>`<div style="height:100px"></div><div class="cta"><button ${id?`id="${id}" `:''}class="btn" style="white-space:nowrap" ${dis?'disabled':''} onclick="${fn}">${h}</button></div>`;
const chip=(on,fn,l,al)=>`<button class="chip" aria-pressed="${on}" ${al?`aria-label="${al}" `:''}onclick="${fn}" style="min-width:64px;height:44px;border-radius:22px;border:0;padding:0 16px;font-size:15px;font-weight:800;background:${on?'var(--tx)':'var(--chip)'};color:${on?'var(--bg)':'var(--tx)'}">${l}</button>`;
const grp=(h,l)=>`<div style="display:flex;gap:10px;flex-wrap:wrap;padding:14px 24px 0" role="group" ${l?`aria-label="${l}"`:''}>${h}</div>`;
const ttl=()=>t3('Subscriptions','Kwiyandikisha buri gihe','Abonnements');
const sheet=(h,body,btns)=>{$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" role="dialog" aria-modal="true" aria-label="${esc(h)}"><div class="h1" style="font-size:22px;line-height:30px;margin-top:4px">${esc(h)}</div>${body}${btns}</div>`;if(typeof focusSheet==='function')focusSheet()};
const addMoneyBtn=()=>`<button onclick="(window.sheetAdd||function(){tab('pay')})()" style="border:0;background:none;padding:8px 0 0;font:inherit;font-size:14px;font-weight:800;color:var(--lk);text-align:left">${t3('Add money','Ongeramo amafaranga','Ajouter de l’argent')}</button>`;

/* ---- list ---- */
screens.subs=()=>{mig();
 const L=S.subs.map((s,i)=>({s,i,d:nextOf(s)})),on=L.filter(x=>x.s[5]).sort((a,b)=>a.d-b.d),off=L.filter(x=>!x.s[5]);
 if(!S.subs.length)return `${bar(ttl())}<div class="pad" style="padding-top:28px"><div class="h1">${t3('No subscriptions','Nta bikishyurwa buri gihe','Aucun abonnement')}</div><div class="mu" style="font-size:15px;margin-top:8px;line-height:22px">${t3('When you add a regular payment, it shows here with its next charge date. You can pause or cancel it any time.','Iyo wongeyeho ikishyurwa buri gihe, kigaragara hano n’itariki ikizakwishyurwaho. Ushobora kugihagarika cyangwa kugikuraho igihe icyo ari cyo cyose.','Quand vous ajoutez un paiement régulier, il apparaît ici avec sa prochaine date de prélèvement. Vous pouvez le mettre en pause ou le résilier à tout moment.')}</div></div>${cta(t3('Add a subscription','Ongeraho ikishyurwa','Ajouter un abonnement'),0,'subAdd()')}`;
 const m=Math.round(on.reduce((a,x)=>a+mo(x.s),0)),yr=Math.round(on.reduce((a,x)=>a+x.s[2]*(x.s[3]==='Weekly'?52:12),0));
 const lm=leftMonth(),w=upto(6),short=w.sum>S.pay;
 const nx=on[0]?`<div class="sm" style="margin-top:8px;line-height:20px"><span class="mu">${t3('Next charge:','Kwishyura gukurikira:','Prochain prélèvement :')}</span> <b>${esc(on[0].s[1])}</b>, ${fmt(on[0].s[2])} RWF, ${rel(on[0].d)}</div>`:'';
 const card=on.length?`<div style="margin:16px 24px 0;padding:6px 16px;border-radius:20px;background:var(--chip)">${Rn(t3('Left to pay this month','Asigaye kwishyurwa muri uku kwezi','Reste à payer ce mois-ci'),fmt(lm.sum)+' RWF')}${Rn(t3('Next 7 days','Iminsi 7 iri imbere','7 prochains jours'),fmt(w.sum)+' RWF')}</div>${short?`<div style="padding:10px 24px 0;font-size:14px;line-height:20px;color:var(--er)" role="alert">${t3('The next 7 days need '+fmt(w.sum)+' RWF, but itunda Pay has '+fmt(S.pay)+' RWF.','Iminsi 7 iri imbere ikeneye RWF '+fmt(w.sum)+', ariko itunda Pay ifite RWF '+fmt(S.pay)+'.','Les 7 prochains jours demandent '+fmt(w.sum)+' RWF, mais itunda Pay contient '+fmt(S.pay)+' RWF.')}</div><div style="padding:0 24px">${addMoneyBtn()}</div>`:''}`:'';
 const row=x=>{const s=x.s,a=s[5];return `<div class="row tap" onclick="subOpen(${x.i})" style="padding:12px 24px"><div class="ico">${s[0]}</div><div style="flex:1;min-width:0"><div class="t" style="opacity:${a?1:.5}">${esc(s[1])}</div><div class="s">${fmt(s[2])} RWF · ${bl(s[3])}</div><div class="s" style="${a&&Math.round((x.d-t0())/864e5)<=3?'font-weight:800;color:var(--tx)':''}">${a?t3('Next ','Ikurikira ','Prochain ')+fd(x.d)+' · '+rel(x.d):t3('Paused','Cyahagaritswe','En pause')}</div></div><div class="sw ${a?'on':''}" role="switch" aria-checked="${!!a}" aria-label="${esc(s[1])}${a?', '+t3('on','gikora','actif'):', '+t3('paused','cyahagaritswe','en pause')}" tabindex="0" onclick="event.stopPropagation();subTg(${x.i})"><i></i></div></div>`};
 return `${bar(ttl())}<div style="padding:20px 24px 4px"><div class="sm mu">${t3('Monthly total','Yose ya buri kwezi','Total mensuel')}</div><div class="big" style="font-size:34px">${fmt(m)} RWF</div><div class="sm mu" style="margin-top:2px">${t3('About '+fmt(yr)+' RWF a year','Hafi RWF '+fmt(yr)+' ku mwaka','Environ '+fmt(yr)+' RWF par an')}</div>${nx}</div>${card}
${on.length?hd(t3('Active','Bikora','Actifs'))+on.map(row).join(''):''}${off.length?hd(t3('Paused, not charged','Byahagaritswe, ntibishyurwa','En pause, non facturés'))+off.map(row).join(''):''}
${fine(t3('Tap a subscription for details, to pause or cancel. Weekly charges are counted as 52 weeks ÷ 12 months. Sample data.','Kanda kuri buri kimwe ubone amakuru, ugihagarike cyangwa ukivane. Ibyishyurwa buri cyumweru bibarwa ku byumweru 52 ÷ amezi 12. Amakuru y’icyitegererezo.','Touchez un abonnement pour voir les détails, le mettre en pause ou le résilier. Les prélèvements hebdomadaires sont comptés sur 52 semaines ÷ 12 mois. Données d’exemple.'))}${cta(t3('Add a subscription','Ongeraho ikishyurwa','Ajouter un abonnement'),0,'subAdd()')}`};
window.subTg=i=>{const s=S.subs[i];if(!s)return;s[5]=s[5]?0:1;toast(s[5]?t3(s[1]+' resumed',s[1]+' cyasubukuwe',s[1]+' repris'):t3(s[1]+' paused',s[1]+' cyahagaritswe',s[1]+' mis en pause'));render('fade-none')};
window.subRem=i=>{const s=S.subs[i];if(!s)return;s[7]=s[7]?0:1;toast(s[7]?t3('Reminder on','Ibyibutsa byafunguwe','Rappel activé'):t3('Reminder off','Ibyibutsa byahagaritswe','Rappel désactivé'));render('fade-none')};

/* ---- details ---- */
screens.subd=()=>{mig();const s=S.subs[S.subi];if(!s)return `${bar(ttl())}`;
 const a=s[5],d=nextOf(s),past=prevOf(s,3);
 const bill=s[3]==='Weekly'?t3('Weekly · every '+wdl(s[6]).toLowerCase(),'Buri cyumweru · '+wdl(s[6]).toLowerCase(),'Hebdomadaire · chaque '+wdl(s[6]).toLowerCase()):t3('Monthly · on day '+s[6],'Buri kwezi · ku munsi wa '+s[6],'Mensuel · le jour '+s[6]);
 const hist=!a?`<div class="mu" style="padding:8px 24px 0;font-size:15px;line-height:22px">${t3('Paused. Nothing is charged until you resume.','Cyahagaritswe. Nta cyishyurwa kugeza ugisubukuye.','En pause. Rien n’est prélevé tant que vous ne le reprenez pas.')}</div>`
  :past.length?past.map(p=>`<div style="display:flex;justify-content:space-between;padding:8px 24px 0;font-size:15px"><span>${fd(p,1)}</span><b>${fmt(s[2])} RWF</b></div>`).join('')
  :`<div class="mu" style="padding:8px 24px 0;font-size:15px;line-height:22px">${t3('No charges yet. The first one is on '+fd(d,1)+'.','Nta cyishyuwe. Icya mbere ni ku wa '+fd(d,1)+'.','Aucun prélèvement pour l’instant. Le premier a lieu le '+fd(d,1)+'.')}</div>`;
 return `${bar(ttl())}<div style="padding:20px 24px 0;display:flex;align-items:center;gap:14px"><div class="ico" style="width:56px;height:56px;font-size:28px">${s[0]}</div><div style="min-width:0"><div class="h1" style="font-size:24px;line-height:30px">${esc(s[1])}</div><div class="mu" style="font-size:15px">${fmt(s[2])} RWF ${t3('a','ku','par')} ${per(s)}</div></div></div>
<div style="margin:18px 24px 0;padding:6px 16px;border-radius:20px;background:var(--chip)">${Rd(t3('Next charge','Kwishyura gukurikira','Prochain prélèvement'),a?fd(d,1):t3('Paused','Cyahagaritswe','En pause'),a?rel(d):t3('Not charged','Ntikishyurwa','Non facturé'))}${Rd(t3('Billing','Uko wishyura','Facturation'),bill)}${Rd(t3('Paid from','Bishyurwa na','Payé depuis'),'itunda Pay',fmt(S.pay)+' RWF')}</div>
<div class="row" style="padding:12px 24px;margin-top:6px"><div style="flex:1;min-width:0"><div class="t">${t3('Remind me the day before','Unyibutse umunsi umwe mbere','Me prévenir la veille')}</div></div><div class="sw ${s[7]?'on':''}" role="switch" aria-checked="${!!s[7]}" aria-label="${t3('Remind me the day before','Unyibutse umunsi umwe mbere','Me prévenir la veille')}" tabindex="0" onclick="subRem(${S.subi})"><i></i></div></div>
${hd(t3('Recent charges','Ibyishyuwe vuba','Derniers prélèvements'))}${hist}
<div class="row2" style="display:grid;grid-template-columns:1fr 1fr;gap:12px;padding:26px 24px 0"><button class="btn sec2" onclick="subTg(${S.subi})">${a?t3('Pause','Hagarika','Mettre en pause'):t3('Resume','Subukura','Reprendre')}</button><button class="btn sec2" style="color:var(--er)" onclick="subAsk(${S.subi})">${t3('Cancel it','Kuraho','Résilier')}</button></div>
${fine(t3('Sample data. No real charge is made.','Amakuru y’icyitegererezo. Nta kwishyura nyako gukorwa.','Données d’exemple. Aucun vrai prélèvement.'))}<div style="height:24px"></div>`};
window.subOpen=i=>{if(!S.subs[i])return;S.subi=i;S.stack.push('subd');render('push')};
window.subAsk=i=>{const s=S.subs[i];if(!s)return;
 sheet(t3('Cancel '+s[1]+'?','Kuraho '+s[1]+'?','Résilier '+s[1]+' ?'),`<div class="mu" style="font-size:15px;margin:8px 0 24px;line-height:22px">${t3('You will not be charged again. To get it back, you set it up again with the provider.','Ntuzongera kwishyurwa. Kugira ngo kigaruke, ugisaba nanone ku kigitanga.','Vous ne serez plus prélevé. Pour le retrouver, vous devez le réactiver auprès du fournisseur.')}</div>`,
 `<div class="row2" style="display:grid;grid-template-columns:1fr 1.4fr;gap:12px"><button class="btn sec2" onclick="closeSheet()">${t3('Keep it','Kigumane','Le garder')}</button><button class="btn" style="white-space:nowrap" onclick="subDel(${i})">${t3('Cancel subscription','Kuraho','Résilier')}</button></div>`)};
window.subDel=i=>{const s=S.subs[i];if(!s)return;const n=s[1];S.subs.splice(i,1);closeSheet();if(S.stack[S.stack.length-1]==='subd')back();else render('fade-none');toast(t3(n+' cancelled',n+' cyakuweho',n+' résilié'))};

/* ---- add: 3 steps ---- */
const SA=()=>S.sa||(S.sa={step:1,pick:-1,name:'',a:0,b:'Monthly',d:1});
const avail=()=>CAT.map((c,i)=>[c,i]).filter(([c])=>!S.subs.some(s=>s[1].toLowerCase()===c[1].toLowerCase()));
const nameOf=()=>{const q=SA();return q.pick>=0?CAT[q.pick][1]:(q.name||'').trim()};
const nerr=()=>{const q=SA();if(q.pick>=0||!q.name)return '';const n=q.name.trim();return n.length<2?t3('Use at least 2 letters','Nibura inyuguti 2','Au moins 2 lettres'):S.subs.some(s=>s[1].toLowerCase()===n.toLowerCase())?t3('You already have this subscription','Usanzwe ufite iki kishyurwa','Vous avez déjà cet abonnement'):''};
const nOk=()=>{const q=SA();return q.pick>=0||(q.name.trim().length>=2&&!nerr())};
const aerr=()=>{const a=SA().a;return !a?'':a<AMIN?t3('Minimum is '+fmt(AMIN)+' RWF','Nibura ni RWF '+fmt(AMIN),'Minimum : '+fmt(AMIN)+' RWF'):a>AMAX?t3('Maximum is '+fmt(AMAX)+' RWF','Ntarenza RWF '+fmt(AMAX),'Maximum : '+fmt(AMAX)+' RWF'):''};
const aOk=()=>{const a=SA().a;return a>=AMIN&&a<=AMAX};
const prog=s=>`<div style="padding:16px 24px 0"><div class="sm mu" style="font-weight:700">${t3('Step '+s+' of '+N,'Intambwe '+s+' kuri '+N,'Étape '+s+' sur '+N)}</div><div style="height:4px;border-radius:2px;background:var(--chip);margin-top:8px;overflow:hidden" role="progressbar" aria-valuenow="${s}" aria-valuemin="1" aria-valuemax="${N}"><div style="height:100%;width:${s*100/N}%;background:var(--lk);transition:width .3s"></div></div></div>`;
const head=(s,h,t)=>`${prog(s)}<div style="padding:18px 24px 0"><div class="h1">${h}</div>${t?`<div class="mu" style="font-size:15px;line-height:22px;margin-top:8px">${t}</div>`:''}</div>`;
const hdr=()=>`<div class="bar"><button class="ib" aria-label="Back" onclick="subaBack()">${ic('back',24)}</button><b>${t3('Add a subscription','Ongeraho ikishyurwa','Ajouter un abonnement')}</b></div>`;
const NX=()=>t3('Next','Komeza','Suivant');
window.subAdd=()=>{S.sa={step:1,pick:-1,name:'',a:0,b:'Monthly',d:1};S.stack.push('suba');render('push')};
window.subaBack=()=>{const q=SA();if(q.step>1){q.step--;render('fade-none')}else back()};
window.subaPick=i=>{const q=SA();q.pick=i;if(i>=0){q.a=CAT[i][2];q.b=CAT[i][3]}else{q.a=0}render('fade-none')};
window.subaName=v=>{const q=SA();q.name=String(v).slice(0,24);const e=nerr();const el=$('#sane'),b=$('#sanb'),i=$('#sani');if(el)el.textContent=e;if(i)i.setAttribute('aria-invalid',e?'true':'false');if(b)b.disabled=!nOk()};
window.subaAmt=v=>{const q=SA();q.a=Math.min(99999999,Number(String(v).replace(/\D/g,''))||0);const i=$('#sai');if(i)i.value=q.a?fmt(q.a):'';subaUpd()};
function subaUpd(){const e=aerr(),el=$('#saae'),b=$('#sanb'),i=$('#sai');if(el)el.textContent=e;if(i)i.setAttribute('aria-invalid',e?'true':'false');if(b)b.disabled=!aOk();document.querySelectorAll('#saq button').forEach((x,k)=>{const on=SA().a===QA[k];x.setAttribute('aria-pressed',on?'true':'false');x.style.background=on?'var(--tx)':'var(--chip)';x.style.color=on?'var(--bg)':'var(--tx)'})}
window.subaQ=v=>{SA().a=v;const i=$('#sai');if(i)i.value=fmt(v);subaUpd()};
window.subaBil=b=>{const q=SA();q.b=b;q.d=b==='Weekly'?1:1;render('fade-none')};
window.subaDay=d=>{SA().d=d;render('fade-none')};
window.subaNext=()=>{const q=SA();if(q.step===1){if(!nOk())return;q.step=2;render('fade-none')}else if(q.step===2){if(!aOk())return;q.step=3;render('fade-none')}else subaReview()};
screens.suba=()=>{const q=SA();
 if(q.step===1){const av=avail();
  const rows=av.map(([c,i])=>`<button class="row tap" role="radio" aria-checked="${q.pick===i}" onclick="subaPick(${i})" style="padding:12px 24px;width:100%;border:0;background:none;text-align:left;font:inherit;color:inherit"><div class="ico">${c[0]}</div><div style="flex:1;min-width:0"><div class="t">${esc(c[1])}</div><div class="s">${t3('Sample price '+fmt(c[2])+' RWF a month','Igiciro cy’icyitegererezo RWF '+fmt(c[2])+' ku kwezi','Prix d’exemple '+fmt(c[2])+' RWF par mois')}</div></div>${q.pick===i?'<span style="font-weight:800;color:var(--lk);font-size:20px" aria-hidden="true">✓</span>':''}</button>`).join('');
  const other=`<button class="row tap" role="radio" aria-checked="${q.pick<0&&q.name!==''||q.pick===-2}" onclick="subaPick(-2)" style="padding:12px 24px;width:100%;border:0;background:none;text-align:left;font:inherit;color:inherit"><div class="ico">✨</div><div style="flex:1;min-width:0"><div class="t">${t3('Something else','Ikindi','Autre chose')}</div></div>${q.pick===-2?'<span style="font-weight:800;color:var(--lk);font-size:20px" aria-hidden="true">✓</span>':''}</button>${q.pick===-2?`<div style="padding:4px 24px 0"><label class="sm mu" for="sani">${t3('Name','Izina','Nom')}</label><input class="in" id="sani" autocomplete="off" maxlength="24" value="${esc(q.name)}" oninput="subaName(this.value)" aria-describedby="sane" aria-invalid="false" style="margin-top:6px"><div class="fxe" id="sane" role="alert" style="min-height:20px;color:var(--er);font-size:14px;margin-top:4px">${esc(nerr())}</div></div>`:''}`;
  return `${hdr()}${head(1,t3('What do you want to add?','Ushaka kongeraho iki?','Que voulez-vous ajouter ?'),t3('Pick one, or choose “Something else” and type the name.','Hitamo kimwe, cyangwa uhitemo “Ikindi” wandike izina.','Choisissez-en un, ou « Autre chose » et saisissez le nom.'))}<div style="padding-top:10px" role="radiogroup">${rows}${other}</div>${cta(NX(),q.pick===-2?!nOk():q.pick===-1,'subaNext()','sanb')}`}
 if(q.step===2){const n=nameOf();
  return `${hdr()}${head(2,t3('How much, and how often?','Angahe, kandi kangahe?','Combien, et à quelle fréquence ?'),esc(n))}
<div class="fxa"><label class="sm mu" for="sai">${t3('Amount each time','Amafaranga buri gihe','Montant à chaque fois')}</label><div class="fxr"><input class="in" id="sai" inputmode="numeric" autocomplete="off" placeholder="0" value="${q.a?fmt(q.a):''}" oninput="subaAmt(this.value)" aria-describedby="saae" aria-invalid="false"><b>RWF</b></div></div><div style="padding:0 24px"><div id="saq" style="display:flex;gap:10px;flex-wrap:wrap;margin-top:14px" role="group" aria-label="${t3('Quick amounts','Umubare uhuse','Montants rapides')}">${QA.map(v=>chip(q.a===v,'subaQ('+v+')',v/1000+'K')).join('')}</div><div id="saae" role="alert" style="min-height:20px;color:var(--er);font-size:14px;margin-top:8px">${aerr()}</div></div>
${hd(t3('How often','Kangahe','Fréquence'))}${grp(['Monthly','Weekly'].map(b=>chip(q.b===b,"subaBil('"+b+"')",bl(b))).join(''),t3('How often','Kangahe','Fréquence'))}
${cta(NX(),!aOk(),'subaNext()','sanb')}`}
 const d=firstOf(q.b,q.d),days=q.b==='Weekly'?WD.map(i=>chip(q.d===i,'subaDay('+i+')',wdn(i),wdl(i))).join(''):MD.map(i=>chip(q.d===i,'subaDay('+i+')',i)).join('');
 return `${hdr()}${head(3,t3('When is it charged?','Kwishyura bizaba ryari?','Quand est-ce prélevé ?'),q.b==='Weekly'?t3('Pick a day of the week.','Hitamo umunsi w’icyumweru.','Choisissez un jour de la semaine.'):t3('Pick a day of the month. It stops at 28 so every month has that day.','Hitamo umunsi w’ukwezi. Ntarenza 28, kugira ngo buri kwezi uwuhorane.','Choisissez un jour du mois. Maximum 28, pour que chaque mois l’ait.'))}
${grp(days,q.b==='Weekly'?t3('Day of the week','Umunsi w’icyumweru','Jour de la semaine'):t3('Day of the month','Umunsi w’ukwezi','Jour du mois'))}
<div style="margin:20px 24px 0;padding:6px 16px;border-radius:20px;background:var(--chip)">${R(t3('First charge','Kwishyura bwa mbere','Premier prélèvement'),fd(d,1)+' · '+rel(d))}</div>${fine(t3('Sample prices. No real payment is set up.','Ibiciro by’icyitegererezo. Nta kishyurwa nyakuri gishyizweho.','Prix d’exemple. Aucun vrai paiement n’est programmé.'))}${cta(NX(),0,'subaNext()','sanb')}`};
window.subaReview=()=>{const q=SA(),n=nameOf(),d=firstOf(q.b,q.d),low=S.pay<q.a;
 sheet(t3('Add '+n+'?','Ongeraho '+n+'?','Ajouter '+n+' ?'),`<div style="margin:12px 0 ${low?6:20}px">${R(t3('Amount','Amafaranga','Montant'),fmt(q.a)+' RWF '+t3('a','ku','par')+' '+per([0,0,0,q.b]))}${R(t3('Billing','Uko wishyura','Facturation'),bl(q.b))}${R(t3('First charge','Kwishyura bwa mbere','Premier prélèvement'),fd(d,1))}${R(t3('Paid from','Bishyurwa na','Payé depuis'),'itunda Pay')}</div>${low?`<div style="font-size:14px;line-height:20px;color:var(--er);margin-bottom:16px">${t3('itunda Pay has '+fmt(S.pay)+' RWF. Add money before the first charge.','itunda Pay ifite RWF '+fmt(S.pay)+'. Ongeramo amafaranga mbere y’uko kwishyura bwa mbere.','itunda Pay contient '+fmt(S.pay)+' RWF. Ajoutez de l’argent avant le premier prélèvement.')}</div>`:''}`,
 `<div class="row2" style="display:grid;grid-template-columns:1fr 1.4fr;gap:12px"><button class="btn sec2" onclick="closeSheet()">${t3('Cancel','Reka','Annuler')}</button><button class="btn" style="white-space:nowrap" onclick="subaDo()">${t3('Add','Ongeraho','Ajouter')}</button></div>`)};
window.subaDo=()=>{const q=SA(),n=nameOf(),ic0=q.pick>=0?CAT[q.pick][0]:'✨';if(!aOk()||!n)return;
 S.subs.push([ic0,n,q.a,q.b,'',1,q.d,0,t0().getTime()]);S.sa=null;closeSheet();S.stack.pop();render('pop');toast(t3(n+' added',n+' cyongeweho',n+' ajouté'))};
document.title='itunda, clickable prototype v308';
}
/* v308: Subscriptions. Before: only English had the v203 page (details, pause, cancel); in French and Kinyarwanda the old plain list came back with no details and no cancel; there was no way to add a subscription (the empty page said "when you set up a regular payment" but offered nothing); the top showed only a monthly total, weekly charges counted as exactly 4 a month, nothing said whether itunda Pay could cover what was coming; the details were a small pop-up with no history and no reminder; \"Next 3 Nov\" and the billing sat on one line that wrapped next to the switch. Now: English, French and Kinyarwanda everywhere; the top shows the monthly total, about how much that is a year (weekly charges are counted as 52 weeks ÷ 12 months, so 5,000 a week is about 21,667 a month, not 20,000), and a card with \"Left to pay this month\" (with the number of charges) and \"Next 7 days\"; if the next 7 days cost more than itunda Pay holds, a red line says so with \"Add money\"; each row has the price and billing on one line and \"Next 1 Nov · in 14 days\" on the next (bold when it is 3 days away or less); tapping a row opens a full page (not a pop-up) with price, next charge, billing (\"Monthly · on day 1\" or \"Weekly · every monday\"), paid from with the itunda Pay balance, \"Remind me the day before\", the last 3 charges (or \"No charges yet. The first one is on ...\" for a new one, or \"Paused. Nothing is charged until you resume.\"), Pause / Resume and Cancel it; cancelling still asks first. New: \"Add a subscription\" (button at the bottom of the list and of the empty page), in 3 steps with \"Step 2 of 3\" and a bar: 1 what (StarTimes, Netflix, Cloud storage, Home internet, News app, or \"Something else\" with a name field, at least 2 letters, no duplicates; ones you already have are not offered), 2 how much (typed, 500 to 1,000,000 RWF, shortcuts 2K / 5K / 10K / 20K, error under the field) and how often (Monthly / Weekly), 3 which day (day 1 to 28 for monthly, a weekday for weekly) with the first charge date shown; a review sheet (a red line if itunda Pay is below the price); then it appears in the list. The dates are worked out from today, so they stay correct. fr is new copy and rw is new copy that needs native review, especially \"Kwiyandikisha buri gihe\" (kept from the menu), \"Ongeraho ikishyurwa\", \"Ibyishyuwe vuba\", \"Unyibutse umunsi umwe mbere\", the weekday and month names, and the sentence about 52 weeks ÷ 12 months. Not in this version: a real charge from itunda Pay on the due date, a real reminder in Messages, yearly billing, choosing another card to pay from, a price-change alert, and a Cancelled list with undo. */
</script>
<style id="v309css">
/* v309: Landlord (saved payee) sheet and list improved. */
.pl-hd{display:flex;align-items:center;gap:14px}
.pl-av{width:56px;height:56px;border-radius:28px;background:var(--tint);color:var(--tintfg);display:flex;align-items:center;justify-content:center;font-size:20px;font-weight:800;flex:none}
.pl-st{margin-left:auto;width:44px;height:44px;border-radius:22px;border:0;background:var(--chip);color:var(--mu);font-size:20px;cursor:pointer;flex:none}
.pl-st.on{color:var(--lk)}
.pl-card{background:var(--chip);border-radius:16px;padding:14px 16px;margin-top:16px}
.pl-card .k{font-size:13px;color:var(--mu)}
.pl-card .v{font-size:16px;font-weight:700;margin-top:2px}
.pl-card .s{font-size:13px;color:var(--mu);margin-top:2px}
.pl-acc{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-top:16px;font-size:15px}
.pl-acc button{border:0;background:var(--chip);color:var(--lk);font:inherit;font-size:13px;font-weight:700;height:36px;padding:0 14px;border-radius:18px;cursor:pointer}
.pl-chips{display:flex;gap:8px;margin-top:16px;flex-wrap:wrap}
.pl-chips button{border:0;background:var(--chip);color:var(--tx);font:inherit;font-size:14px;font-weight:600;height:44px;padding:0 16px;border-radius:22px;cursor:pointer}
.pl-chips button.del{color:var(--er)}
.pl-chips button.pr{background:var(--tint);color:var(--tintfg)}
.pl-sub{font-size:13px;color:var(--mu);margin-top:2px}
</style>
<script>
/* v309: Landlord (saved payee) sheet and list. The sheet now shows an initials avatar, a favourite star in the header, the full account number with Copy, the next scheduled transfer or a "Set up monthly rent" suggestion, the last amount sent, and a primary Send money bar; Schedule and Edit are chips and Delete is a quiet red chip. The Payees list shows the next transfer or last payment under each name. rw/fr strings need native review. */
(function(){
const T=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e;
const esc=s=>String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/"/g,'&quot;');
const pay=id=>S.bp.find(p=>p.id===id);
const pn=p=>p.k||p.n;
const sh=h=>{$('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" style="max-height:86%;overflow-y:auto">'+h+'</div>'};
const loc=()=>({en:'en-GB',fr:'fr-FR',rw:'en-GB'})[S.lang]||'en-GB';
const dts=ms=>new Date(ms).toLocaleDateString(loc(),{weekday:'short',day:'numeric',month:'short'});
const dts2=ms=>new Date(ms).toLocaleDateString(loc(),{day:'numeric',month:'short'});
const ini=n=>String(n).trim().split(/\s+/).slice(0,2).map(w=>(w[0]||'').toUpperCase()).join('')||'?';
const grp=a=>String(a).replace(/(\d{4})(?=\d)/g,'$1 ');
const FRQ=()=>({once:T('one time','rimwe','une fois'),week:T('weekly','buri cyumweru','chaque semaine'),month:T('monthly','buri kwezi','chaque mois')});
const nextSch=id=>(S.bsc||[]).filter(s=>s.pid===id&&!s.done).sort((a,b)=>a.next-b.next)[0];
const lastSent=p=>{const t='To '+p.n;const x=(S.act||[]).find(a=>a[3]<0&&typeof a[1]==='string'&&a[1].indexOf(t)===0);return x||null};
const sub=p=>{const s=nextSch(p.id);if(s)return (s.p?T('Paused','Byahagaritswe','En pause')+' · ':T('Next ','Ikurikira ','Prochain ')+dts2(s.next)+' · ')+Number(s.amt).toLocaleString('en-US')+' RWF';const l=lastSent(p);if(l)return T('Last sent ','Wohereje ','Dernier envoi ')+Number(-l[3]).toLocaleString('en-US')+' RWF';return p.n+' · '+p.bank+' ••'+p.acc.slice(-4)};
const prow=p=>`<div class="row tap" role="button" tabindex="0" onclick="bpOpen(${p.id})"><div class="pl-av" style="width:44px;height:44px;border-radius:22px;font-size:16px">${esc(ini(p.n))}</div><div style="flex:1;min-width:0"><div class="t">${esc(pn(p))}${p.fav?' <span style="color:var(--lk)">★</span>':''}</div><div class="s">${esc(sub(p))}</div></div></div>`;
screens.bkpay=()=>{const l=S.bp.slice().sort((a,b)=>(b.fav?1:0)-(a.fav?1:0));return `${bar(T('Payees','Abakwakira','Bénéficiaires'))}<div class="pad" style="padding-top:12px"><button class="btn" onclick="bpEdit(0)">+ ${T('Add a payee','Ongeraho ukwakira','Ajouter un bénéficiaire')}</button>${l.length?'':`<div class="mu" style="padding-top:24px;text-align:center;line-height:22px">${T('Save people you pay often. Sending takes two taps.','Bika abo wishyura kenshi. Kohereza bifata gukanda kabiri.','Enregistrez vos bénéficiaires habituels. Envoyer prend deux touches.')}</div>`}${l.map(prow).join('')}</div>`};
window.bpCopy=id=>{const p=pay(id);if(!p)return;try{navigator.clipboard&&navigator.clipboard.writeText(p.acc)}catch(e){}toast(T('Account number copied','Nimero ya konti yakoporowe','Numéro de compte copié'))};
window.bpFav=id=>{const p=pay(id);p.fav=p.fav?0:1;render('fade-none');window.bpOpen(id)};
window.bpRent=id=>{closeSheet();bsNew(id)};
window.bpOpen=id=>{const p=pay(id);if(!p)return;const s=nextSch(id),l=lastSent(p);
let card='';
if(s){card=`<div class="pl-card"><div class="k">${s.p?T('Scheduled · paused','Biteganyijwe · byahagaritswe','Programmé · en pause'):T('Next transfer','Kohereza gukurikira','Prochain virement')}</div><div class="v">${Number(s.amt).toLocaleString('en-US')} RWF · ${esc(dts(s.next))}</div><div class="s">${esc(FRQ()[s.fr]||'')}${s.n?' · '+s.n+T(' sent',' byoherejwe',' envoyés'):''}</div><div class="pl-chips" style="margin-top:12px"><button class="pr" onclick="closeSheet();bsRun(${s.id})">${T('Send now','Ohereza ubu','Envoyer')}</button><button onclick="closeSheet();bsSkip(${s.id})">${T('Skip next','Simbuka','Passer')}</button></div></div>`}
else card=`<div class="pl-card"><div class="k">${T('Nothing scheduled','Nta cyateganyijwe','Rien de programmé')}</div><div class="v">${T('Set up monthly rent','Tegura ubukode buri kwezi','Programmez le loyer mensuel')}</div><div class="s">${T('Set it once. We remind you before each transfer.','Tegura rimwe. Tukwibutsa mbere ya buri kohereza.','Programmez une fois. Nous vous rappelons avant chaque virement.')}</div><div class="pl-chips" style="margin-top:12px"><button class="pr" onclick="bpRent(${id})">${T('Schedule','Teganya','Programmer')}</button></div></div>`;
const last=l?`<div class="pl-sub" style="margin-top:12px">${T('Last sent ','Wohereje ','Dernier envoi ')}${Number(-l[3]).toLocaleString('en-US')} RWF</div>`:'';
sh(`<div class="pl-hd"><div class="pl-av">${esc(ini(p.n))}</div><div style="min-width:0"><div ${'class="h1" style="font-size:22px;line-height:28px;margin:0"'}>${esc(pn(p))}</div><div class="pl-sub">${esc(p.n)}</div></div><button class="pl-st${p.fav?' on':''}" aria-pressed="${!!p.fav}" aria-label="${T('Favourite','Ukunzwe','Favori')}" onclick="bpFav(${id})">${p.fav?'★':'☆'}</button></div>
<div class="pl-acc"><div><div class="mu" style="font-size:13px">${esc(p.bank)}</div><b style="letter-spacing:.5px">${esc(grp(p.acc))}</b></div><button onclick="bpCopy(${id})">${T('Copy','Koporora','Copier')}</button></div>
${card}${last}
<div class="pl-chips"><button onclick="bpEdit(${id})">${T('Edit','Hindura','Modifier')}</button>${s?`<button onclick="closeSheet();bkGo('bksch')">${T('Manage transfers','Genzura','Gérer les virements')}</button>`:''}<button class="del" onclick="bpDel(${id})">${T('Delete','Siba','Supprimer')}</button></div>
<div class="bpbar"><button class="btn" onclick="bpSend(${id})">${T('Send money','Ohereza amafaranga','Envoyer de l’argent')}</button></div>`)};
document.title=document.title.replace(/v\d+/,'v320');
})();
</script>
<script>
/* v313: Harvest advance. Before: English only (French and Kinyarwanda fell back to a plain card); it asked for one cooperative ID and nothing else; repayment was only a monthly instalment although the advance is meant to be repaid after the harvest; after sending there was a one-line note and nothing to follow. Now: English, French and Kinyarwanda (fr/rw new copy needs native review); asks for your cooperative, your member ID and what the advance is for (seedlings, fertiliser, tools, pest control, other); the amount is a field (100,000 to 2,000,000 RWF) with shortcuts; you choose "One payment after harvest" (pay it all on one date, interest for the months until then) or "Monthly" (equal instalments), then 4 / 6 / 8 months; the page shows the total to repay and the date of the single payment (or the monthly payment); a line under the form says what is missing; a review before sending; after sending the page tracks the application (Submitted, Cooperative confirms membership, Approved, Funds sent to itunda Pay), you can withdraw until it is approved, and once the funds arrive the money is added to itunda Pay, it shows in Activity, and the page shows when you repay. Sample terms: no real advance is made, and there is no real reminder. */
{const t3=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e;
const fm=n=>fmt(Math.round(n)),esc48=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const AMIN=100000,AMAX=2000000,SCS=[200000,500000,1000000,2000000],TMS=[4,6,8],RATE=12;
const short=v=>v>=1e6?v/1e6+'M':v/1e3+'K';
const USE=[['seed',['Seedlings','Imbuto','Plants']],['fert',['Fertiliser','Ifumbire','Engrais']],['tools',['Tools & equipment','Ibikoresho','Outils et matériel']],['pest',['Pest control','Kurwanya udukoko','Lutte antiparasitaire']],['other',['Other','Ibindi','Autre']]];
const uname=k=>{const p=USE.find(x=>x[0]===k);return p?t3(...p[1]):''};
S.hv=S.hv||{coop:'',cid:'',use:'',a:500000,n:6,m:'one'};
S.apps=S.apps||{};
const H=()=>S.hv;
const addM=(d,n)=>{const x=new Date(d);x.setMonth(x.getMonth()+n);return x};
const dts=d=>new Date(d).toLocaleDateString(S.lang==='fr'?'fr-FR':'en-GB',{day:'numeric',month:'short',year:'numeric'});
const calc=(h)=>{h=h||H();const p=h.a,n=h.n,i=RATE/1200;if(h.m==='one'){const int=Math.round(p*RATE/100*n/12);return{mo:0,tot:p+int,int}}const mo=Math.round(p*i/(1-Math.pow(1+i,-n)));return{mo,tot:mo*n,int:mo*n-p}};
const aerr=()=>{const a=H().a;return !a?'':a<AMIN?t3('Minimum is '+fm(AMIN)+' RWF','Nibura ni RWF '+fm(AMIN),'Minimum : '+fm(AMIN)+' RWF'):a>AMAX?t3('Maximum is '+fm(AMAX)+' RWF','Ntarenza RWF '+fm(AMAX),'Maximum : '+fm(AMAX)+' RWF'):''};
const miss=()=>{const h=H();if((h.coop||'').trim().length<3)return t3('Type your cooperative to continue.','Andika koperative yawe ukomeze.','Saisissez votre coopérative pour continuer.');if((h.cid||'').trim().length<4)return t3('Type your member ID (at least 4 characters).','Andika nimero y’umunyamuryango (nibura inyuguti 4).','Saisissez votre numéro de membre (4 caractères minimum).');if(!h.use)return t3('Choose what the advance is for.','Hitamo icyo avansi igenewe.','Choisissez l’usage de l’avance.');if(!h.a||aerr())return aerr()||t3('Enter an amount to continue.','Andika amafaranga ukomeze.','Saisissez un montant pour continuer.');return ''};
const chip=(on,fn,l,al)=>`<button class="chip" aria-pressed="${on}" ${al?`aria-label="${al}" `:''}onclick="${fn}" style="min-width:64px;height:44px;border-radius:22px;border:0;padding:0 16px;font-size:15px;font-weight:800;background:${on?'var(--tx)':'var(--chip)'};color:${on?'var(--bg)':'var(--tx)'}">${l}</button>`;
const grp=(h,id)=>`<div ${id?`id="${id}" `:''}style="display:flex;gap:10px;flex-wrap:wrap;padding:10px 24px 0" role="group">${h}</div>`;
const lab=(t,s,f)=>`<div style="padding:24px 24px 0"><label ${f?`for="${f}" `:''}style="font-size:16px;font-weight:800;display:block">${t}</label>${s?`<div class="sm mu" style="margin-top:4px;line-height:19px">${s}</div>`:''}</div>`;
const rw=(a,v,b)=>`<div style="margin:8px 24px 0;display:flex;justify-content:space-between;gap:12px;font-size:15px"><span class="mu">${a}</span><b style="text-align:right;${b?'color:var(--tintfg)':''}">${v}</b></div>`;
const R=(a,v)=>`<div style="display:flex;justify-content:space-between;gap:12px;min-height:40px;align-items:center;font-size:15px"><span class="mu">${a}</span><b style="text-align:right">${v}</b></div>`;
const lay2=h=>{$('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet">'+h+'</div>';if(typeof focusSheet==='function')focusSheet()};
const inp=(id,val,ph,fn)=>`<div style="padding:8px 24px 0"><input id="${id}" value="${esc48(val)}" oninput="${fn}" autocomplete="off" placeholder="${ph}" style="width:100%;box-sizing:border-box;height:48px;border:0;border-radius:14px;background:var(--chip);color:var(--tx);padding:0 16px;font:inherit;font-size:16px"></div>`;
const qUse=()=>grp(USE.map(([k,n])=>chip(H().use===k,`hvSet('use','${k}')`,t3(...n))).join(''));
const dyn=()=>{const h=H(),q=calc(),ok=!aerr()&&h.a>=AMIN,m=miss(),one=h.m==='one',due=addM(Date.now(),h.n);
return `${grp(SCS.map(x=>chip(h.a===x,`hvSet('a',${x})`,short(x),fm(x)+' RWF')).join(''))}
${lab(t3('How do you want to repay?','Wifuza kwishyura ute?','Comment voulez-vous rembourser ?'),one?t3('Most coffee is harvested from March to June. You pay once, after you sell.','Ikawa nyinshi isarurwa kuva muri Werurwe kugeza muri Kamena. Wishyura rimwe, umaze kugurisha.','Le café est surtout récolté de mars à juin. Vous payez une fois, après la vente.'):t3('Equal payments every month.','Kwishyura kungana buri kwezi.','Mensualités égales.'))}
${grp([['one',t3('One payment after harvest','Kwishyura rimwe nyuma y’isarura','Un paiement après la récolte')],['mo',t3('Monthly','Buri kwezi','Mensuel')]].map(([k,l])=>chip(h.m===k,`hvSet('m','${k}')`,l)).join(''))}
${lab(one?t3('Pay me back in','Nzishyura mu','Je rembourse dans'):t3('Repay over','Ishyura mu','Rembourser sur'))}${grp(TMS.map(x=>chip(h.n===x,`hvSet('n',${x})`,x+' '+t3('months','mezi','mois'))).join(''))}
${ok?(one?rw(t3('One payment on','Kwishyura rimwe ku wa','Un paiement le'),dts(due),1)+rw(t3('Amount','Amafaranga','Montant'),fm(q.tot)+' RWF',1):rw(t3('Monthly payment','Kwishyura buri kwezi','Mensualité'),fm(q.mo)+' RWF',1))+rw(t3('Interest ('+RATE+'% a year)','Inyungu ('+RATE+'% ku mwaka)','Intérêts ('+RATE+' % par an)'),fm(q.int)+' RWF')+rw(t3('Total to repay','Ugomba kwishyura yose','Total à rembourser'),fm(q.tot)+' RWF'):''}
${lab(t3('What happens next','Ibikurikira','La suite'))}<div style="padding:8px 24px 0;font-size:15px;line-height:24px"><div>1. ${t3('Your cooperative confirms you are a member.','Koperative yawe yemeza ko uri umunyamuryango.','Votre coopérative confirme que vous êtes membre.')}</div><div>2. ${t3('We send the money to itunda Pay.','Twohereza amafaranga muri itunda Pay.','Nous envoyons l’argent sur itunda Pay.')}</div><div>3. ${t3('You repay on your chosen date.','Wishyura ku munsi wahisemo.','Vous remboursez à la date choisie.')}</div></div>
<div id="hvM" class="sm" role="status" style="margin:16px 24px 0;min-height:20px;text-align:center;color:var(--mu);font-weight:700">${m||''}</div>`};
window.hvUpd=()=>{const d=document.getElementById('hvD');if(!d)return;d.innerHTML=dyn();const e=document.getElementById('hvAE');if(e)e.textContent=aerr();const q3=document.getElementById('hvQ3');if(q3)q3.innerHTML=qUse();const b=document.getElementById('hvB');if(b){b.disabled=!!miss();b.textContent=t3('Apply for '+fm(H().a)+' RWF','Saba RWF '+fm(H().a),'Demander '+fm(H().a)+' RWF')}};
window.hvSet=(f,v)=>{H()[f]=v;if(f==='a'){const i=document.getElementById('hvA');if(i)i.value=fm(v)}hvUpd()};
window.hvType=(f,el)=>{if(f==='a'){const x=el.value.replace(/\D/g,'').slice(0,7);H().a=x?Number(x):0;el.value=x?fmt(x):''}else H()[f]=el.value.slice(0,40);hvUpd()};
window.hvReview=()=>{if(miss()||S.apps.harvest&&S.apps.harvest.stage!=null)return;const h=H(),q=calc(),one=h.m==='one';
lay2(`<div class="h1" style="font-size:22px;line-height:30px;margin-top:4px">${t3('Apply for '+fm(h.a)+' RWF?','Gusaba RWF '+fm(h.a)+'?','Demander '+fm(h.a)+' RWF ?')}</div><div style="margin:12px 0 16px">${R(t3('Cooperative','Koperative','Coopérative'),esc48(h.coop.trim()))}${R(t3('Member ID','Nimero y’umunyamuryango','N° de membre'),esc48(h.cid.trim()))}${R(t3('For','Igenewe','Usage'),uname(h.use))}${one?R(t3('One payment on','Kwishyura rimwe ku wa','Un paiement le'),dts(addM(Date.now(),h.n))):R(t3('Repay over','Kwishyura mu','Remboursement sur'),h.n+' '+t3('months','mezi','mois'))+R(t3('Monthly payment','Kwishyura buri kwezi','Mensualité'),fm(q.mo)+' RWF')}${R(t3('Total to repay','Ugomba kwishyura yose','Total à rembourser'),fm(q.tot)+' RWF')}${R(t3('Rate','Inyungu','Taux'),RATE+t3('% a year','% ku mwaka',' % par an'))}</div><div class="mu sm" style="margin:-4px 0 16px;line-height:20px">${t3('Next: your cooperative confirms your membership. Money is sent to itunda Pay once approved. You can withdraw until it is approved.','Ibikurikira: koperative yawe yemeza ko uri umunyamuryango. Amafaranga yoherezwa muri itunda Pay yemejwe. Ushobora kuyikuraho itaremezwa.','Ensuite : votre coopérative confirme votre adhésion. L’argent est envoyé sur itunda Pay après approbation. Vous pouvez retirer la demande avant.')}</div><div style="display:grid;grid-template-columns:1fr 1.8fr;gap:12px"><button class="btn sec2" onclick="closeSheet()">${t3('Cancel','Reka','Annuler')}</button><button class="btn" style="white-space:nowrap" onclick="hvSend()">${t3('Send application','Ohereza ubusabe','Envoyer la demande')}</button></div>`)};
window.hvSend=()=>{if(miss())return;const h=H(),q=calc(),ref='ITN-'+String(Date.now()).slice(-6);S.apps.harvest={ref,a:h.a,n:h.n,m:h.m,mo:q.mo,tot:q.tot,coop:h.coop.trim(),cid:h.cid.trim(),use:h.use,stage:0};closeSheet();render('fade-none');
lay2(`<div class="g3" style="font-size:56px;line-height:1;margin-bottom:10px">📨</div><div class="h1" style="font-size:22px;line-height:30px">${t3('Application sent','Ubusabe bwoherejwe','Demande envoyée')}</div><div class="mu" style="font-size:15px;margin:8px 0 24px;line-height:22px">${t3('Reference '+ref+'. Your cooperative will confirm your membership.','Nimero '+ref+'. Koperative yawe izemeza ko uri umunyamuryango.','Référence '+ref+'. Votre coopérative confirmera votre adhésion.')}</div><button class="btn" onclick="closeSheet()">OK</button>`)};
window.hvNext=()=>{const a=S.apps.harvest;if(!a||a.stage==null||a.stage>=3)return;a.stage++;if(a.stage===3){S.pay+=a.a;a.at=Date.now();if(Array.isArray(S.act))S.act.unshift(['wallet','Harvest advance · '+a.ref,'Received · Just now',a.a,'Received']);toast('+'+fm(a.a)+' RWF '+t3('added to itunda Pay','yongewe muri itunda Pay','ajoutés à itunda Pay'))}render('fade-none')};
window.hvWithdraw=()=>lay2(`<div class="h1" style="font-size:22px;line-height:30px;margin-top:4px">${t3('Withdraw your application?','Gukuraho ubusabe bwawe?','Retirer votre demande ?')}</div><div class="mu" style="font-size:15px;margin:8px 0 24px;line-height:22px">${t3('Your cooperative will not review it. You can apply again later.','Koperative yawe ntizabusuzuma. Ushobora gusaba nanone.','Votre coopérative ne l’examinera pas. Vous pourrez redemander plus tard.')}</div><div style="display:grid;grid-template-columns:1fr 1.8fr;gap:12px"><button class="btn sec2" onclick="closeSheet()">${t3('Keep it','Reka ikomeze','Garder')}</button><button class="btn" style="white-space:nowrap" onclick="hvWithdrawGo()">${t3('Withdraw','Kuraho','Retirer')}</button></div>`);
window.hvWithdrawGo=()=>{delete S.apps.harvest;closeSheet();render('fade-none');toast(t3('Application withdrawn','Ubusabe bwakuweho','Demande retirée'))};
const screenHv=()=>{const a=S.apps.harvest,h=H(),title=t3('Harvest advance','Avansi y’isarura','Avance de récolte');
const head=bar(title)+`<div style="padding:22px 24px 0"><div style="width:72px;height:72px;border-radius:36px;background:var(--tint);display:flex;align-items:center;justify-content:center;font-size:36px">☕</div><div class="h1" style="margin-top:16px">${title}</div><div class="mu" style="font-size:15px;line-height:22px;margin-top:8px">${t3('Input financing for coffee cooperative members, repaid after the harvest. '+RATE+'% a year.','Inguzanyo y’ibikoresho ku banyamuryango ba koperative y’ikawa, yishyurwa nyuma y’isarura. '+RATE+'% ku mwaka.','Financement d’intrants pour les membres d’une coopérative de café, remboursé après la récolte. '+RATE+' % par an.')}</div></div>`;
if(a&&a.stage!=null){const st=a.stage,names=[t3('Submitted','Cyoherejwe','Envoyée'),t3('Cooperative confirms membership','Koperative yemeza ko uri umunyamuryango','La coopérative confirme l’adhésion'),t3('Approved','Cyemejwe','Approuvée'),t3('Funds sent to itunda Pay','Amafaranga yoherejwe muri itunda Pay','Fonds envoyés sur itunda Pay')];
const desc=[t3('We sent your application to your cooperative.','Twohereje ubusabe bwawe kuri koperative yawe.','Nous avons envoyé votre demande à votre coopérative.'),t3('They check your membership and ID.','Barasuzuma ko uri umunyamuryango na nimero yawe.','Elle vérifie votre adhésion et votre numéro.'),t3('Your advance is approved. Funds are on the way.','Avansi yawe yemejwe. Amafaranga araje.','Votre avance est approuvée. Les fonds arrivent.'),t3('The money is in your itunda Pay.','Amafaranga ari muri itunda Pay yawe.','L’argent est sur votre itunda Pay.')];
const tl=names.map((n,i)=>`<div style="display:flex;gap:14px;align-items:flex-start;padding:10px 0"><div style="width:26px;height:26px;border-radius:13px;flex:none;display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:800;background:${i<=st?'var(--lk)':'var(--chip)'};color:${i<=st?'#fff':'var(--mu)'}" ${i===st?'aria-current="step"':''}>${i<st||st===3&&i===3?'✓':i+1}</div><div style="min-width:0"><div style="font-weight:${i===st?800:600};color:${i<=st?'var(--tx)':'var(--mu)'}">${n}</div>${i===st?`<div class="sm mu" style="margin-top:2px;line-height:19px">${desc[i]}</div>`:''}</div></div>`).join('');
const one=a.m==='one',base=a.at||Date.now(),pay=one?dts(addM(base,a.n)):dts(addM(base,1));
return head+`<div style="margin:18px 24px 0;padding:14px 16px;border-radius:16px;background:var(--tint);color:var(--tintfg);font-size:14px;line-height:20px"><b>${t3('Application sent.','Ubusabe bwoherejwe.','Demande envoyée.')}</b> ${t3('Reference ','Nimero ','Référence ')}${a.ref} · ${fm(a.a)} RWF</div><div style="padding:14px 24px 0">${tl}</div>
${lab(t3('Your advance','Avansi yawe','Votre avance'))}${rw(t3('Amount','Amafaranga','Montant'),fm(a.a)+' RWF')}${rw(t3('Cooperative','Koperative','Coopérative'),esc48(a.coop||''))}${rw(t3('For','Igenewe','Usage'),uname(a.use))}${a.m==='one'?rw(t3('One payment after harvest','Kwishyura rimwe nyuma y’isarura','Un paiement après la récolte'),fm(a.tot||0)+' RWF',1):rw(t3('Monthly payment','Kwishyura buri kwezi','Mensualité'),fm(a.mo||0)+' RWF',1)+rw(t3('Repay over','Kwishyura mu','Remboursement sur'),a.n+' '+t3('months','mezi','mois'))}${rw(t3('Total to repay','Ugomba kwishyura yose','Total à rembourser'),fm(a.tot||0)+' RWF')}${st===3?rw(one?t3('Pay on','Kwishyura ku wa','À payer le'):t3('First payment','Kwishyura bwa mbere','Premier paiement'),pay,1):''}
${st<3?`<div class="pad" style="padding-top:18px"><button class="chip" onclick="hvNext()">${t3('Next step (sample)','Intambwe ikurikira (icyitegererezo)','Étape suivante (exemple)')}</button></div>`:''}<div class="pad fine" style="padding-top:14px">${t3('Sample for this prototype. No real advance is made and no real reminder is sent.','Icyitegererezo cy’iyi porogaramu. Nta avansi nyayo itangwa kandi nta menyesha nyaryo ryoherezwa.','Exemple pour ce prototype. Aucune vraie avance n’est accordée et aucun vrai rappel n’est envoyé.')}</div><div style="height:100px"></div>${st<2?`<div class="cta"><button class="btn sec2" style="white-space:nowrap" onclick="hvWithdraw()">${t3('Withdraw application','Kuraho ubusabe','Retirer la demande')}</button></div>`:''}`}
return head+`${lab(t3('Your cooperative','Koperative yawe','Votre coopérative'),'','hvC')}${inp('hvC',h.coop,t3('e.g. Musasa Coffee Cooperative','urugero: Koperative y’Ikawa ya Musasa','ex. Coopérative de café de Musasa'),"hvType('coop',this)")}
${lab(t3('Your member ID','Nimero yawe y’umunyamuryango','Votre numéro de membre'),t3('It is on your membership card. Your cooperative can also tell you.','Iri ku ikarita yawe y’umunyamuryango. Koperative yawe nayo irakubwira.','Il figure sur votre carte de membre. Votre coopérative peut aussi vous le donner.'),'hvI')}${inp('hvI',h.cid,t3('Type the ID on your card','Andika nimero iri ku ikarita','Saisissez le numéro de la carte'),"hvType('cid',this)")}
${lab(t3('What is the advance for?','Avansi igenewe iki?','À quoi sert l’avance ?'))}<div id="hvQ3">${qUse()}</div>
${lab(t3('Advance amount','Amafaranga ya avansi','Montant de l’avance'),'','hvA')}<div style="padding:8px 24px 0"><div style="display:flex;align-items:baseline;gap:8px;border-bottom:2px solid var(--ln)"><input id="hvA" inputmode="numeric" autocomplete="off" placeholder="0" value="${h.a?fmt(h.a):''}" oninput="hvType('a',this)" aria-describedby="hvAE" style="flex:1;min-width:0;border:0;background:none;color:var(--tx);font:inherit;font-size:24px;font-weight:800;padding:6px 0;outline:0;border-radius:0"><span class="mu" style="font-weight:700">RWF</span></div><div id="hvAE" role="alert" class="sm" style="min-height:20px;margin-top:6px;color:var(--er);font-weight:700">${aerr()}</div></div>
<div id="hvD">${dyn()}</div><div class="pad fine" style="padding-top:8px">${t3('Sample terms for this prototype. No real advance is made.','Amabwiriza y’icyitegererezo. Nta avansi nyayo itangwa.','Conditions d’exemple pour ce prototype. Aucune vraie avance n’est accordée.')}</div><div style="height:100px"></div><div class="cta"><button id="hvB" class="btn" style="white-space:nowrap" ${miss()?'disabled':''} onclick="hvReview()">${t3('Apply for '+fm(h.a)+' RWF','Saba RWF '+fm(h.a),'Demander '+fm(h.a)+' RWF')}</button></div>`};
const _p=screens.svc;screens.svc=()=>S.svk==='harvest'?screenHv():_p();
document.title=document.title.replace(/v\d+/,'v320');
}

/* v316: Get a loan is three short steps, one choice per page (Amount, Repay over, Check). Before, amount, term, the terms box and Apply all sat on one page and the last row of the terms was hidden behind the button. Step 2 shows what each term costs per month so you can choose before you commit; tapping a term moves on. The last page lists the full terms and the button names the amount. Your active loan page is unchanged. English only; fr/rw keep the old page. */
(function(){
const fd=d=>d.toLocaleDateString('en-GB',{day:'numeric',month:'long',year:'numeric'});
const d15=k=>{const d=new Date();d.setDate(15);d.setMonth(d.getMonth()+k);return d};
const limOf=f=>{const a=S.lp.a;return Math.max(Math.min(...a),Math.floor(Math.max(...a)*f/1000)*1000)};
const lim=()=>limOf(score()>=700?1:score()>=600?.5:.25);
const need=x=>[[0,.25],[600,.5],[700,1]].find(([,f])=>limOf(f)>=x)[0];
const lockSvg='<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="margin-right:6px;vertical-align:-1px"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>';
const ST=['Amount','Repay over','Check'];
const prev=screens.loan;
screens.loan=()=>{
 if(S.loan||S.lang!=='en'||!S.lp||S.lp.n!=='Get a loan')return prev();
 const k=Math.min(2,S.lst|0),L=lim();if(S.la>L)S.la=Math.max(...S.lp.a.filter(x=>x<=L));
 const c=lcalc(S.la,S.lm),A=S.lp.a;
 const head=`${bar('Get a loan')}<div class="v176" role="status" aria-label="Step ${k+1} of 3"><span class="sg" aria-hidden="true">${[0,1,2].map(i=>`<i class="${i<=k?'on':''}"></i>`).join('')}</span><span>Step ${k+1} of 3 · ${ST[k]}</span></div>`;
 if(k===0){const lk=A.filter(x=>x>L);
  return head+`<div class="pad" style="padding-top:20px"><div class="h1">How much do you need?</div><div class="mu" style="font-size:15px;margin-top:8px">You can borrow up to ${fmt(L)} RWF.</div></div><div role="status" style="padding:24px 24px 0;font-size:40px;line-height:48px;font-weight:800;letter-spacing:-1px;font-variant-numeric:tabular-nums">${fmt(S.la)}<span style="font-size:22px;font-weight:700"> RWF</span></div><div class="pad" style="padding-top:20px"><div class="req">${A.map(x=>x>L?`<button class="lkd" aria-disabled="true" onclick="toast('${fmt(x)} RWF opens at a score of ${need(x)}. Yours is ${score()}.')">${lockSvg}${fmt(x)} RWF</button>`:`<button class="${S.la===x?'on':''}" onclick="S.la=${x};render('fade-none')">${fmt(x)} RWF</button>`).join('')}</div>${lk.length?`<div class="sm mu" style="margin-top:14px;line-height:19px">${lk.map(x=>fmt(x)+' RWF opens at a score of '+need(x)).join('. ')}. Yours is ${score()}.</div>`:''}</div><div class="cta"><button class="btn" onclick="lnNext()">Next</button></div>`}
 if(k===1){const T=S.lp.t;
  return head+`<div class="pad" style="padding-top:20px"><div class="h1">How long to repay ${fmt(S.la)} RWF?</div><div class="mu" style="font-size:15px;margin-top:8px">Pick the monthly payment that suits you.</div></div><div style="padding:12px 24px 0">${T.map((m,i)=>{const q=lcalc(S.la,m),on=m===S.lm,tag=i===0?'Least interest':i===T.length-1?'Smallest monthly payment':'';return `<button onclick="lnTerm(${m})" style="display:flex;justify-content:space-between;align-items:center;gap:12px;width:100%;padding:16px 0;border:0;border-bottom:1px solid var(--ln);background:none;color:inherit;font:inherit;text-align:left"><span style="min-width:0"><b style="font-size:17px;${on?'color:var(--lk)':''}">${m} months${on?' ✓':''}</b><span class="sm mu" style="display:block;margin-top:2px">Total ${fmt(q.tot)} RWF</span>${tag?`<span class="sm" style="display:block;margin-top:2px;color:var(--ok);font-weight:700">${tag}</span>`:''}</span><span style="text-align:right;flex:0 0 auto"><b style="font-size:17px">${fmt(q.mo)} RWF</b><span class="sm mu" style="display:block;margin-top:2px">a month</span></span></button>`}).join('')}</div>`}
 const rows=[['Each month',fmt(c.mo)+' RWF for '+S.lm+' months'],['Total to repay',fmt(c.tot)+' RWF'],['Interest',fmt(c.tot-S.la)+' RWF · '+(+(S.lp.r*100).toFixed(2))+'% a month'],['First payment',fd(d15(1))],['Final payment',fd(d15(S.lm))]];
 return head+`<div class="pad" style="padding-top:20px"><div class="h1">Check before you apply</div></div><div style="padding:16px 24px 0"><div class="sm mu">You get</div><div style="font-size:34px;line-height:42px;font-weight:800;letter-spacing:-.8px;margin-top:2px">${fmt(S.la)} RWF</div></div><div style="margin:20px 24px 0;padding:4px 20px;border-radius:20px;background:var(--chip)">${rows.map(([a,b],i)=>lrow(a,b,i)).join('')}</div><div class="pad fine" style="padding-top:14px;padding-bottom:96px">The money is added to itunda Bank right away. Sample terms for this prototype. No real loan is made.</div><div class="cta"><button class="btn" onclick="lnGo()">Apply for ${fmt(S.la)} RWF</button></div>`};
window.lnNext=()=>{S.lst=(S.lst|0)+1;render('fade-none')};
window.lnTerm=m=>{S.lm=m;S.lst=2;render('fade-none')};
window.lnGo=()=>{const c=lcalc(S.la,S.lm);$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" role="dialog" aria-modal="true" aria-label="Confirm"><div style="margin-bottom:12px">${gl('verified3d',60)}</div><div class="h1" style="font-size:22px;line-height:30px">Confirm it's you</div><div class="mu" style="font-size:15px;margin:8px 0 24px">Borrow ${fmt(S.la)} RWF and repay ${fmt(c.mo)} RWF a month for ${S.lm} months.</div><button class="btn" onclick="loanDo()">Borrow ${fmt(S.la)} RWF</button></div>`};
const _bk2=window.back;window.back=function(){if(S.stack[S.stack.length-1]==='loan'&&!S.loan&&S.lp&&S.lp.n==='Get a loan'&&S.lang==='en'&&(S.lst|0)>0){S.lst--;render('fade-none');return}S.lst=0;return _bk2.apply(this,arguments)};
const _d3=loanDo;loanDo=function(){S.lst=0;return _d3.apply(this,arguments)};
})();

/* v318: Directions. Before: three control rows (route filter tabs, "Leave now" + "Best route", "Avoid stairs") sat above the map, and "Leave now" and "Best route" changed to the next value on every tap without showing the choices. Now: one line says what you have chosen ("Leave now · Best route") and opens a "Route options" sheet where every choice is visible (leave time, which routes to show, sort, avoid stairs). The map gets the space back. The swap button now swaps start and destination (it only showed a toast). */
(function(){
const L=(e,r,f)=>({en:e,rw:r,fr:f}[S.lang]||e);
const M=S.mp;let BFL=[];
const DEPL=()=>[L('Now','Ubu','Maintenant'),L('In 15 min','Mu minota 15','Dans 15 min'),L('In 30 min','Mu minota 30','Dans 30 min'),L('In 1 hour','Mu isaha 1','Dans 1 h')];
const SRT=()=>[L('Best route','Inzira nziza','Meilleur itinéraire'),L('Fewest transfers','Guhindura bike','Moins de correspondances'),L('Least walking','Kugenda make','Moins de marche')];
const swapIc='<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 4v16M8 4 4 8M8 4l4 4M16 20V4M16 20l-4-4M16 20l4-4"/></svg>';
const prev=screens.route;
screens.route=()=>{let h=prev();
 h=h.replace(/<button class="ib" aria-label="Swap" onclick="toast\('Start and destination swapped'\)">[\s\S]*?<\/button>/,()=>`<button class="ib" aria-label="${L('Swap start and destination','Hindura intangiriro n’aho ujya','Inverser départ et arrivée')}" onclick="rtSwap()">${swapIc}</button>`);
 if(M.swp&&!M.from){const a='</span>KG 11 Ave, Kimironko</div>',b='</span>'+PL.n+'</div>';if(h.includes(a)&&h.includes(b))h=h.replace(a,()=>'§A§').replace(b,()=>'§B§').replace('§A§',()=>b).replace('§B§',()=>a)}
 const re1=/<div style="display:flex;gap:22px;padding:0 20px;border-bottom:0;overflow-x:auto">((?:<span[^>]*onclick="mpBf\(\d+\)"[^>]*>[^<]*<\/span>)+)<\/div>/,m1=h.match(re1);
 if(!m1)return h;
 BFL=[...m1[1].matchAll(/onclick="mpBf\(\d+\)">([^<]*)<\/span>/g)].map(x=>x[1]);
 h=h.replace(re1,'');
 const d=M.dep|0,bf=M.bf|0,txt=[d?L('Leave ','Genda ','Partir ')+DEPL()[d].toLowerCase():L('Leave now','Genda ubu','Partir maintenant'),SRT()[M.sort|0]].concat(bf&&BFL[bf]?[BFL[bf].replace(/\s+\d+$/,'')]:[],M.ns?[L('No stairs','Nta ngazi','Sans escaliers')]:[]).join(' · ');
 const sum=`<button onclick="rtOpt()" style="display:flex;align-items:center;gap:10px;width:calc(100% - 40px);margin:10px 20px 0;padding:12px 14px;border:0;border-radius:16px;background:var(--chip);color:inherit;font:inherit;font-size:15px;text-align:left"><span style="flex:1;min-width:0;font-weight:700">${txt}</span><span style="color:var(--lk);font-weight:700;white-space:nowrap">${L('Options','Amahitamo','Options')}</span></button>`;
 h=h.replace(/<div style="display:flex;justify-content:space-between;align-items:center;padding:10px 20px;border-bottom:0;font-size:15px;font-weight:700"><span[^>]*onclick="mpDep\(\)">[^<]*<\/span><span[^>]*onclick="mpSort\(\)">[^<]*<\/span><\/div>/,()=>sum);
 h=h.replace(/<div style="margin:12px 16px 0;border-radius:18px;padding:12px 14px;background:var\(--tint\)[^>]*onclick="mpNs\(\)">[\s\S]*?<\/span><\/div>/,'');
 return h};
window.rtSwap=()=>{M.swp=!M.swp;render('fade-none');toast(L('Start and destination swapped','Intangiriro n’aho ujya byahinduwe','Départ et arrivée inversés'))};
const _a=window.mpArriveAt;window.mpArriveAt=id=>{M.swp=false;return _a(id)};
const ref=()=>{render('fade-none');rtOpt()};
window.rtDep=i=>{M.dep=i;ref()};window.rtBf=i=>{M.bf=i;M.opt=0;ref()};window.rtSrt=i=>{M.sort=i;ref()};window.rtNs=()=>{M.ns=!M.ns;ref()};
window.rtOpt=()=>{const g=(t,it,cur,fn)=>`<div class="sm mu" style="margin:18px 0 8px;font-weight:700">${t}</div><div class="req" style="flex-wrap:wrap;gap:8px">${it.map((x,i)=>`<button class="${cur===i?'on':''}" onclick="${fn}(${i})">${x}</button>`).join('')}</div>`;
 $('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" role="dialog" aria-modal="true" aria-label="${L('Route options','Amahitamo y’inzira','Options d’itinéraire')}"><div class="h1" style="font-size:22px;line-height:30px">${L('Route options','Amahitamo y’inzira','Options d’itinéraire')}</div>${g(L('Leave','Genda','Partir'),DEPL(),M.dep|0,'rtDep')}${BFL.length?g(L('Show','Erekana','Afficher'),BFL,M.bf|0,'rtBf'):''}${g(L('Sort by','Tondeka','Trier par'),SRT(),M.sort|0,'rtSrt')}<button onclick="rtNs()" role="switch" aria-checked="${!!M.ns}" style="display:flex;justify-content:space-between;align-items:center;width:100%;margin-top:18px;padding:14px 0 0;border:0;border-top:1px solid var(--ln);background:none;color:inherit;font:inherit;font-size:16px;font-weight:700;text-align:left"><span>${L('Avoid stairs','Irinde ingazi','Éviter les escaliers')}</span><span class="tg">${M.ns?L('ON','BIRAKORA','OUI'):L('OFF','OYA','NON')}</span></button><button class="btn" style="margin-top:22px" onclick="closeSheet()">${L('Done','Byarangiye','Terminé')}</button></div>`};
})();
</script>
<style id="v319">
/* v319: Maps home spacing. Before: the filter chips touched the search pill (0 px gap), the map overlays sat 12 px from the screen edge while the Nearby sheet used 20 px and the rest of the app uses 24 px. Now: 10 px between search and chips, overlays on a 16 px edge, sheet content on the 24 px grid, hint toast moved down with the chips. */
#phone .fmap .mvs{left:16px;right:16px}
#phone .fmap .mcs.mvc{margin-top:10px;padding:1px 16px}
#phone .fmap .fcrow{padding:0 16px 16px}
#phone .fmap .fms{padding:10px 24px 24px}
#phone .fmap .fms .hdl{margin-bottom:16px}
#phone .fmap .fms .pc{padding:10px 0}
#phone .toast.mphint{top:132px!important}
</style>
<script>
/* v320: Kigali Maps. (1) Map pin sheet: "Depart" and "Arrive" did not say what they do and did not match the Place page; they now read "From here" and "Directions" (Kuva hano / Inzira, Depuis ici / Itinéraire; rw and fr need native review). (2) Search: the screen was two rows of chips and then empty space. A new "Explore nearby" section lists the map categories (Cafe, Food, Bus stops, Pharmacy, ATM); tapping one opens the map already filtered. It hides while you type, like the recent list, and the chosen chip scrolls into view on the map. */
{const t=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e;
const st=document.createElement('style');st.id='v320';
st.textContent='#phone .mpx{padding:20px 24px 0}#phone .mpx h3{font-size:17px;font-weight:800;margin:0 0 4px;letter-spacing:-.2px}#phone .mpx .g{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:12px}#phone .mpx button{display:flex;align-items:center;gap:12px;height:56px;padding:0 16px;border:0;border-radius:16px;background:var(--chip);color:var(--tx);font:inherit;font-size:15px;font-weight:700;text-align:left}#phone .mpx button i{font-style:normal;font-size:22px}';
document.head.appendChild(st);
const _a=screens.mapview;
screens.mapview=()=>{let h=_a();const a=t('From here','Kuva hano','Depuis ici'),b=t('Directions','Inzira','Itinéraire');
return h.replace(/(<button class="p"[^>]*>)(Depart|Gutangira|Départ)(<\/button>)/,'$1'+a+'$3').replace(/(<button class="q"[^>]*>)(Arrive|Kugerayo|Arrivée)(<\/button>)/,'$1'+b+'$3')};
const _b=screens.mapsearch;
screens.mapsearch=()=>{let h=_b();
const C=[['cafe','☕',t('Cafe','Ikawa','Café')],['food','🍽️',t('Food','Ibiryo','Repas')],['bus','🚌',t('Bus stops','Bisi','Arrêts de bus')],['pharm','💊',t('Pharmacy','Farumasi','Pharmacie')],['atm','🏧','ATM']];
const x='<div class="mpx"><h3>'+t('Explore nearby','Shakisha hafi yawe','Explorer à proximité')+'</h3><div class="g">'+C.map(c=>'<button onclick="openMaps();mpCat(\''+c[0]+'\');setTimeout(function(){var e=document.querySelector(\'.fmap .ocp.on\');if(e)e.scrollIntoView({inline:\'center\',block:\'nearest\'})},120)"><i>'+c[1]+'</i>'+c[2]+'</button>').join('')+'</div></div>';
return h.replace(/<\/div>\s*$/,x+'</div>')};
}
</script>
<style id="v320b">
/* v320: map pin sheet buttons on two rows (From here + Directions, then Details, Save, Share) so the clearer labels are not cut off */
#phone .fmap .acts.mp5{display:grid!important;grid-template-columns:repeat(6,1fr)!important;gap:8px!important}
#phone .fmap .acts.mp5>button{grid-column:span 2!important;font-size:14px!important;padding:0 8px!important}
#phone .fmap .acts.mp5>button.p,#phone .fmap .acts.mp5>button.q{grid-column:span 3!important;font-size:15px!important}
</style>
<script>
/* v321: Make an offer. Before: three percent chips, a bare amount and a button, so you could not see what you would save, a very low offer went out unchallenged, a non-negotiable note sat under the button, and nothing said what happens next. Now: one sheet, in order: item and asking price, a note at the top if the price is not marked negotiable (you can still offer), quick chips, your own price, a three-line summary (asking price, your offer, you save), a gentle nudge below 60% of the asking price (not blocking), the button with the amount on it, and one line on what happens next. If you already made an offer the title says "Update your offer" and shows it. Enter sends. No foldables. rw and fr need native review. */
{const t=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e;
const esc=s=>String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/"/g,'&quot;');
const H=HD.market,item=id=>H.items.find(x=>x.id===id);
const sh=h=>{$('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" style="max-height:86%;overflow-y:auto">'+h+'</div>'};
const FLD='style="font-size:17px;height:46px"';
const chipBtn=(on,fn,l)=>`<button class="${on?'on':''}" aria-pressed="${!!on}" onclick="${fn}">${l}</button>`;
const num=s=>Number(String(s).replace(/,/g,''));
const fmtIn=v=>v.replace(/\D/g,'').replace(/\B(?=(\d{3})+(?!\d))/g,',');
const amt=()=>{const x=item(S.mxo.id),o=S.mxo;return o.custom?num(o.custom):Math.round(x.p*(1-o.pc/100)/500)*500};
const bad=()=>{const x=item(S.mxo.id),a=amt();return !(a>0&&a<x.p)};
const hint=()=>{const x=item(S.mxo.id),a=amt();
if(!a)return['var(--er)',t('Enter an amount.','Andika umubare.','Saisissez un montant.')];
if(a>=x.p)return['var(--er)',t('Your offer must be lower than the asking price.','Igiciro watanze kigomba kuba munsi y’icyasabwe.','Votre offre doit être inférieure au prix demandé.')];
if(a<x.p*.6)return['var(--mu)',t('Very low offers are often ignored. Try closer to the asking price.','Ibiciro biri hasi cyane akenshi ntibisubizwa. Gerageza kwegera icyasabwe.','Les offres très basses restent souvent sans réponse. Rapprochez-vous du prix demandé.')];
return['var(--mu)',''];};
const row=(l,v,b)=>`<div style="display:flex;justify-content:space-between;align-items:center;min-height:44px;font-size:${b?17:15}px;${b?'font-weight:800':''}"><span class="${b?'':'mu'}">${l}</span><span>${v}</span></div>`;
const sum=()=>{const x=item(S.mxo.id),a=amt(),ok=!bad(),sv=x.p-a;
return row(t('Asking price','Igiciro cyasabwe','Prix demandé'),fmt(x.p)+' RWF')+row(t('Your offer','Igiciro cyawe','Votre offre'),(a>0?fmt(a):'–')+' RWF',1)+(ok?row(t('You save','Uzigama','Vous économisez'),fmt(sv)+' RWF · '+Math.round(sv/x.p*100)+'%'):'')};
const lab=()=>{const a=amt();return t('Send offer','Ohereza igiciro','Envoyer l’offre')+(a>0&&!bad()?' · '+fmt(a)+' RWF':'')};
const draw=()=>{const x=item(S.mxo.id),o=S.mxo,last=S.mxOffs[x.id],hn=hint();
sh(`<div class="h1" style="font-size:22px;line-height:30px">${last?t('Update your offer','Hindura igiciro cyawe','Modifier votre offre'):t('Make an offer','Tanga igiciro','Faire une offre')}</div><div class="mu" style="font-size:15px;margin:8px 0 0">${esc(x.ti)} · ${fmt(x.p)} RWF</div>`
+(x.neg?'':`<div class="sm" style="margin-top:12px;line-height:20px;padding:10px 14px;border-radius:14px;background:var(--chip)">${t('The seller has not marked this price as negotiable. You can still send an offer.','Umugurisha ntiyavuze ko igiciro gishobora kugabanywa. Ushobora gutanga igiciro uko byagenda kose.','Le vendeur n’a pas indiqué un prix négociable. Vous pouvez quand même envoyer une offre.')}</div>`)
+(last?`<div class="sm mu" style="margin-top:10px">${t('Your last offer','Igiciro cyawe giheruka','Votre dernière offre')}: ${fmt(last)} RWF</div>`:'')
+`<div class="chp" id="mxoch" style="padding:16px 0 0">${[5,10,15].map(n=>chipBtn(!o.custom&&o.pc===n,`mkOffPc(${n})`,'−'+n+'%')).join('')}</div><div class="lab" style="margin-top:14px">${t('Or enter your own price','Cyangwa andika igiciro cyawe','Ou saisissez votre prix')}</div><input class="in" id="mxoc" inputmode="numeric" value="${esc(o.custom)}" oninput="mxoIn()" onkeydown="if(event.key==='Enter')mkOffSend()" aria-label="${t('Your offer (RWF)','Igiciro cyawe (RWF)','Votre offre (RWF)')}" placeholder="${fmt(Math.round(x.p*.9/500)*500)}" ${FLD}>`
+`<div id="mxosum" style="margin-top:16px;padding:4px 16px;border-radius:16px;background:var(--chip)">${sum()}</div><div id="mxow" role="status" class="sm" style="min-height:20px;margin-top:10px;line-height:20px;color:${hn[0]}">${hn[1]}</div><button class="btn" id="mxogo" style="margin-top:10px" ${bad()?'disabled':''} onclick="mkOffSend()">${lab()}</button><div class="sm mu" style="margin-top:12px;text-align:center;line-height:20px">${t('The seller replies in Messages. You only pay if you both agree.','Umugurisha agusubiriza muri Messages. Wishyura ari uko mwemeranyije.','Le vendeur répond dans Messages. Vous ne payez que si vous êtes d’accord.')}</div>`)};
window.mkOffer=id=>{S.mxo={id,pc:10,custom:''};draw()};
window.mkOffPc=n=>{S.mxo.pc=n;S.mxo.custom='';draw()};
window.mxoIn=()=>{const i=$('#mxoc');S.mxo.custom=fmtIn(i.value);i.value=S.mxo.custom;const hn=hint(),w=$('#mxow');
$('#mxosum').innerHTML=sum();w.textContent=hn[1];w.style.color=hn[0];const g=$('#mxogo');g.disabled=bad();g.textContent=lab();
document.querySelectorAll('#mxoch button').forEach(b=>{b.classList.remove('on');b.setAttribute('aria-pressed','false')})};
window.mkOffSend=()=>{if(!S.mxo||bad())return;const x=item(S.mxo.id),a=amt(),th='hdmarket'+x.id,m='Hi, would you accept '+fmt(a)+' RWF for "'+x.ti+'"?';
hdThread(th,x.who,x.ti,[['me',m]]);if(S.msgs[th].length>1||S.msgs[th][0][1]!==m)S.msgs[th].push(['me',m]);S.mxOffs[x.id]=a;
closeSheet();S.tab='messages';openChat(th);toast(t('Offer sent','Igiciro cyoherejwe','Offre envoyée'))};
document.title=document.title.replace(/v\d+/,'v321');}
</script>
<style id="v322">
/* v322: calmer filter sheets */
#phone .fsel{width:100%;height:46px;border:0;border-radius:14px;background:var(--chip);color:var(--tx);font:inherit;font-size:16px;font-weight:700;padding:0 12px;margin-top:8px}
#phone .fseg{display:flex;gap:2px;padding:3px;margin-top:8px;border-radius:14px;background:var(--chip)}
#phone .fseg button{flex:1;min-width:0;min-height:42px;border:0;border-radius:11px;background:none;color:var(--tx);font:inherit;font-size:14px;font-weight:700;line-height:16px;padding:0 4px}
#phone .fseg button.on{background:var(--bg);box-shadow:inset 0 0 0 2px var(--lk)}
#phone .fck{display:grid;grid-template-columns:1fr 1fr;gap:0 16px;margin-top:4px}
#phone .fck button{display:flex;align-items:center;gap:10px;min-height:44px;border:0;background:none;color:var(--tx);font:inherit;font-size:15px;font-weight:600;text-align:left;padding:0}
#phone .fck i{flex:0 0 22px;height:22px;border-radius:7px;border:2px solid var(--tt);box-sizing:border-box;display:flex;align-items:center;justify-content:center;color:#fff;font-style:normal;font-size:14px;line-height:1}
#phone .fck button.on i{background:var(--lk);border-color:var(--lk)}
#phone .fsw{display:flex;width:100%;align-items:center;justify-content:space-between;gap:12px;min-height:52px;border:0;background:none;color:var(--tx);font:inherit;font-size:15px;font-weight:700;text-align:left;padding:0}
#phone .fsec{margin-top:20px}
#phone .fsec>.lab{margin-top:0;font-weight:700;color:var(--tx);font-size:14px}
</style>
<script>
/* v322: Filter. Before: each Filter sheet was a wall of pill chips (Property had about 25: area, type, price, 8 must-haves and three on/off options as chips; Marketplace and Jobs had the same pattern), so single choices, multiple choices and on/off options all looked alike. Now each kind of choice has its own quiet control: Area and Type are a dropdown, a few exclusive options (price, pay type, max price) are one segmented control, multiple choices (condition, must-haves) are plain checkboxes, and on/off options are switches. Show N now counts exactly what the list will show, including the category and search you already set, and says "No matches" instead of "Show 0". Reset is off until a filter is on, and the Show button stays in view while the sheet scrolls. Applies to Marketplace, Jobs and Property. rw and fr need native review. */
{const t=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e;
const esc=s=>String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/"/g,'&quot;');
const sh=h=>{$('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" style="max-height:86%;overflow-y:auto">'+h+'</div>'};
const cnt=()=>{try{return (screens.hood().match(/class="hdc"/g)||[]).length}catch(e){return 0}};
const sec=(l,b)=>`<div class="fsec"><div class="lab">${l}</div>${b}</div>`;
const arg=v=>typeof v==='number'?v:`'${v}'`;
const sel=(k,val,opts,l)=>`<select class="fsel" aria-label="${esc(l)}" onchange="v322('${k}',this.value)">${opts.map(([v,n])=>`<option value="${esc(v)}"${v===val?' selected':''}>${esc(n)}</option>`).join('')}</select>`;
const seg=(k,val,opts)=>`<div class="fseg" role="group">${opts.map(([v,n])=>`<button class="${v===val?'on':''}" aria-pressed="${v===val}" onclick="v322('${k}',${arg(v)})">${esc(n)}</button>`).join('')}</div>`;
const ck=(k,arr,opts)=>`<div class="fck">${opts.map(([v,n])=>{const on=arr.includes(v);return `<button class="${on?'on':''}" aria-pressed="${on}" onclick="v322t('${k}','${v}')"><i aria-hidden="true">${on?'✓':''}</i>${esc(n)}</button>`}).join('')}</div>`;
const sw=(k,on,l)=>`<button class="fsw" role="switch" aria-checked="${!!on}" onclick="v322s('${k}')"><span>${l}</span><span class="sw ${on?'on':''}"><i></i></span></button>`;
let cur=null;
const draw=()=>{const o=document.querySelector('#layer .sheet'),y=o?o.scrollTop:0,n=cnt(),a=cur.active();
sh(`<div class="h1" style="font-size:22px;line-height:30px">${t('Filter','Hitamo','Filtrer')}</div>${cur.body()}<div style="position:sticky;bottom:0;margin:20px -24px -28px;padding:12px 24px 28px;background:var(--bg);border-top:1px solid var(--ln)"><div class="row2"><button class="btn sec2" ${a?'':'disabled'} onclick="v322r()">${t('Reset','Subiramo','Réinitialiser')}</button><button class="btn" ${n?'':'disabled'} onclick="v322a()">${n?t('Show ','Erekana ','Voir ')+n:t('No matches','Nta bihuye','Aucun résultat')}</button></div></div>`);
const p=document.querySelector('#layer .sheet');if(p&&y)p.scrollTop=y};
window.v322=(k,v)=>{cur.set(k,v);draw()};
window.v322t=(k,v)=>{const a=cur.arr(k),i=a.indexOf(v);i<0?a.push(v):a.splice(i,1);draw()};
window.v322s=k=>{cur.flip(k);draw()};
window.v322r=()=>{cur.reset();draw()};
window.v322a=()=>{closeSheet();cur.apply()};
const alertToast=on=>toast(on?t('Alerts on. We will notify you (sample).','Imenyesha zifunguye (urugero).','Alertes activées (exemple).'):t('Alerts off','Imenyesha zafunzwe','Alertes désactivées'));
const allAreas=t('All areas','Ahantu hose','Tous les quartiers');
const anyL=t('Any','Byose','Tous');
/* ---- Marketplace ---- */
window.mxFilt=()=>{const H=HD.market,F=()=>S.mxf;
const CD=[['new',t('New','Gishya','Neuf')],['like',t('Like new','Nka gishya','Comme neuf')],['good',t('Good','Meza','Bon')],['fair',t('Fair','Biremewe','Correct')]];
cur={active:()=>F().cond.length+(F().max?1:0)+(F().hood?1:0),
body:()=>sec(t('Max price (RWF)','Igiciro ntarengwa (RWF)','Prix maximum (RWF)'),seg('max',F().max,[[0,anyL],[20000,'20k'],[50000,'50k'],[100000,'100k']]))+sec(t('Area','Agace','Quartier'),sel('hood',F().hood||'',[['',allAreas]].concat(window.MXAREAS.map(a=>[a,a])),t('Area','Agace','Quartier')))+sec(t('Condition','Imiterere','État'),ck('cond',F().cond,CD)),
set:(k,v)=>{F()[k]=k==='max'?Number(v):v},arr:k=>F()[k],flip:()=>{},
reset:()=>{S.mxf={cond:[],max:0,hood:''}},apply:()=>window.rf2()};draw()};
/* ---- Jobs ---- */
window.jbFilt=()=>{const H=HD.jobs,F=()=>S.jbfl;
const U=[['day',t('day','munsi','jour')],['task',t('task','gikorwa','mission')],['month',t('month','kwezi','mois')]].map(([k,v])=>[k,t('Per ','Ku ','Par ')+v]);
cur={active:()=>(F().area?1:0)+(F().unit?1:0)+(F().hide?1:0),
body:()=>sec(t('Area','Agace','Quartier'),sel('area',F().area||'',[['',allAreas]].concat([...new Set(H.items.map(x=>x.loc))].slice(0,8).map(a=>[a,a])),t('Area','Agace','Quartier')))+sec(t('Pay type','Uburyo bwo kwishyurwa','Type de paie'),seg('unit',F().unit||'',[['',anyL]].concat(U)))+`<div class="fsec">${sw('hide',F().hide,t('Hide filled jobs','Hisha akazi kamaze kuboneka','Masquer les offres pourvues'))}${sw('alert',S.jbAlert,t('Alert me about new matching jobs','Menyesha ku kazi gashya gahuye','M’alerter pour les nouvelles offres'))}</div>`,
set:(k,v)=>{F()[k]=v},arr:()=>[],flip:k=>{if(k==='alert'){S.jbAlert=S.jbAlert?0:1;alertToast(S.jbAlert)}else F()[k]=F()[k]?0:1},
reset:()=>{S.jbfl={area:'',unit:'',hide:0}},apply:()=>window.jbCat(S.jbCat)};draw()};
/* ---- Property ---- */
window.pFilt=()=>{const H=HD.property,f=()=>S.pf;
const KD=[['apt',t('Apartment','Inzu y’ibyumba','Appartement')],['house',t('House','Inzu','Maison')],['room',t('Room','Icyumba','Chambre')],['shop',t('Shop','Iduka','Boutique')],['land',t('Land','Ubutaka','Terrain')]];
const AM=[['water',t('Water','Amazi','Eau')],['power',t('Power','Amashanyarazi','Électricité')],['park',t('Parking','Parikingi','Parking')],['sec',t('Security','Umutekano','Sécurité')],['net',t('Internet','Interineti','Internet')],['gar',t('Garden','Ubusitani','Jardin')],['lift',t('Lift','Lifuti','Ascenseur')],['bal',t('Balcony','Balikoni','Balcon')]];
const BD=[t('Any price','Igiciro cyose','Tout prix'),t('Budget','Gito','Petit budget'),t('Mid-range','Hagati','Moyen'),t('Premium','Hejuru','Haut de gamme')].map((l,i)=>[i,l]);
cur={active:()=>(f().area?1:0)+(f().kind?1:0)+(f().band?1:0)+f().am.length+(f().furn?1:0)+(f().hide?1:0),
body:()=>`<div class="fsec" style="display:flex;gap:12px"><div style="flex:1;min-width:0"><div class="lab" style="margin-top:0;font-weight:700;color:var(--tx);font-size:14px">${t('Area','Agace','Quartier')}</div>${sel('area',f().area||'',[['',allAreas]].concat([...new Set(H.items.map(x=>x.loc))].map(a=>[a,a])),t('Area','Agace','Quartier'))}</div><div style="flex:1;min-width:0"><div class="lab" style="margin-top:0;font-weight:700;color:var(--tx);font-size:14px">${t('Property type','Ubwoko bw’inzu','Type de bien')}</div>${sel('kind',f().kind||'',[['',anyL]].concat(KD),t('Property type','Ubwoko bw’inzu','Type de bien'))}</div></div>`
+sec(t('Price','Igiciro','Prix'),seg('band',f().band||0,BD)+`<div class="sm mu" style="margin-top:8px;line-height:18px">${t('Rent: under 100k, 100k to 300k, over 300k a month. Sale: under 50M, 50M to 150M, over 150M.','Gukodesha: munsi ya 100k, 100k–300k, hejuru ya 300k ku kwezi. Kugurisha: munsi ya 50M, 50M–150M, hejuru ya 150M.','Location : moins de 100k, 100k à 300k, plus de 300k par mois. Vente : moins de 50M, 50M à 150M, plus de 150M.')}</div>`)
+sec(t('Must have','Ibigomba kuba bihari','Indispensable'),ck('am',f().am,AM))
+`<div class="fsec">${sw('furn',f().furn,t('Furnished only','Irimo ibikoresho gusa','Meublé seulement'))}${sw('hide',f().hide,t('Hide rented / sold','Hisha ibyakodeshejwe / ibyagurishijwe','Masquer loués / vendus'))}${sw('alert',S.pAl,t('Alert me about new matches','Menyesha ku bishya bihuye','Alertes nouveautés'))}</div>`,
set:(k,v)=>{f()[k]=k==='band'?Number(v):v},arr:k=>f()[k],flip:k=>{if(k==='alert'){S.pAl=S.pAl?0:1;alertToast(S.pAl)}else f()[k]=f()[k]?0:1},
reset:()=>window.pFr(),apply:()=>render('fade-none')};draw()};
document.title=document.title.replace(/v\d+/,'v322');}
</script>
<style id="v323css">
/* v323: Name your pocket */
.npg .npsub{font-size:15px;line-height:22px;margin:8px 0 0}
.npg label.lab{display:block;margin-top:28px}
.npg .npr{display:flex;align-items:center;gap:16px;margin-top:8px}
.npg .npr .pkico{flex:none}
.npg .npf{position:relative;flex:1;min-width:0}
.npg .npf .in{padding-right:48px}
.npg .npcount{position:absolute;right:0;top:0;height:52px;line-height:52px;font-size:13px;font-weight:600;color:var(--mu)}
.npg .npe{min-height:20px;margin-top:6px;font-size:13px;line-height:18px;font-weight:600;color:var(--er)}
.npg .npch{display:flex;flex-wrap:wrap;gap:8px;margin-top:8px}
.npg .npch button{display:inline-flex;align-items:center;gap:6px;height:44px;padding:0 16px 0 12px;border-radius:22px;border:0;background:var(--chip);color:var(--tx);font:inherit;font-weight:700;font-size:15px}
.npg .npch button.on{background:var(--tx);color:var(--bg)}
.npg .in::placeholder{font-weight:500;color:var(--mu);opacity:.7}
.npg .npi{display:flex;flex-wrap:wrap;gap:8px;margin-top:8px;padding:2px}
.npg .npi button{width:44px;height:44px;border-radius:22px;border:0;background:var(--chip);display:flex;align-items:center;justify-content:center;padding:0}
.npg .npi button.on{box-shadow:0 0 0 2px var(--tx)}
</style>
<script>
/* v323: Name your pocket. Before: a bare name field with Cancel / Create, "Enter a name" or "You already have a pocket with that name" only as a toast after tapping Create, nothing to tell you the 10-pocket limit until you hit it, no icon choice (every new pocket got the same wallet), English only. Now: one page with a short line saying what a pocket is for, the pocket's icon next to the name field and updating as you choose, a 0/20 counter, the "already have that name" and "up to 10 pockets" messages shown under the field as you type (so Create is simply off instead of failing), quick ideas (Trip, Phone, Rent, Gift, Wedding, Food; the ones you already have are hidden) that fill the name and icon, an icon row for any other name, and one "Create pocket" button (Back replaces Cancel; Enter creates). The same checks now run in the quick Trip / Phone chips on the Pockets page. English, French and Kinyarwanda; fr is new copy and rw is new copy that needs native review, like v166 and v217 to v222, especially "Tanga izina ry’agasanduku" and "Kora agasanduku". */
{
const t3=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e;
const IDEAS=[['Trip','Urugendo','Voyage','bus'],['Phone','Telefoni','Téléphone','phone'],['Rent','Ubukode','Loyer','home'],['Gift','Impano','Cadeau','gift'],['Wedding','Ubukwe','Mariage','star'],['Food','Ibiribwa','Courses','food']];
const ICONS=[['wallet','Wallet','Igikapu','Portefeuille'],['bus','Trip','Urugendo','Voyage'],['phone','Phone','Telefoni','Téléphone'],['home','Home','Urugo','Maison'],['gift','Gift','Impano','Cadeau'],['star','Celebration','Ibirori','Fête'],['food','Food','Ibiribwa','Courses']];
const nm=()=>((S.np&&S.np.n)||'').trim();
const MAXE=()=>t3('You can have up to 10 pockets. Delete one to add another.','Ushobora kugira udusanduku 10 gusa. Siba kamwe kugira ngo wongereho.','Vous pouvez avoir 10 poches au maximum. Supprimez-en une pour en ajouter.');
const DUPE=()=>t3('You already have a pocket with that name','Usanzwe ufite agasanduku gafite iryo zina','Vous avez déjà une poche portant ce nom');
const err=()=>{if(S.pk.length>=10)return MAXE();const n=nm().toLowerCase();return n&&S.pk.some(x=>x.n.toLowerCase()===n)?DUPE():''};
window.npUpd=function(){const n=nm(),e=err(),i=$('#pkn');if(!i)return;
$('#npe').textContent=e;i.setAttribute('aria-invalid',e?'true':'false');
$('#npcount').textContent=(S.np.n||'').length+'/20';
$('#npic').innerHTML=pkIco({g:S.np.g},56);
$('#nps').disabled=!n||!!e;
document.querySelectorAll('#npch button').forEach(b=>{const on=b.dataset.n.toLowerCase()===n.toLowerCase();b.classList.toggle('on',on);b.setAttribute('aria-pressed',on?'true':'false')});
document.querySelectorAll('#npi button').forEach(b=>{const on=b.dataset.g===S.np.g;b.classList.toggle('on',on);b.setAttribute('aria-pressed',on?'true':'false')})};
window.npName=v=>{S.np.n=v;npUpd()};
window.npIcon=g=>{S.np.g=g;npUpd()};
window.npIdea=(n,g)=>{S.np.n=n;S.np.g=g;const i=$('#pkn');i.value=n;npUpd();i.focus()};
window.npGo=()=>{if($('#nps').disabled)return;pkAdd(S.np.n,S.np.g)};
window.pkNew=function(){S.np={n:'',g:'wallet'};const used=S.pk.map(x=>x.n.toLowerCase());
const ideas=IDEAS.filter(x=>!used.includes(x[0].toLowerCase())&&!used.includes(t3(x[0],x[1],x[2]).toLowerCase()));
const title=t3('Name your pocket','Tanga izina ry’agasanduku','Nommez votre poche');
$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet npg" role="dialog" aria-modal="true" aria-label="${title}"><div class="h1" style="font-size:22px;line-height:30px">${title}</div><div class="mu npsub">${t3('Set money aside for something specific. You can rename it any time.','Bika amafaranga ku kintu runaka. Ushobora guhindura izina igihe cyose.','Mettez de l’argent de côté pour un projet précis. Vous pourrez la renommer à tout moment.')}</div>
<label class="lab" for="pkn">${t3('Pocket name','Izina ry’agasanduku','Nom de la poche')}</label><div class="npr"><div id="npic">${pkIco({g:'wallet'},56)}</div><div class="npf"><input class="in" id="pkn" maxlength="20" autocomplete="off" placeholder="${t3('For example, Wedding','Urugero: Ubukwe','Par exemple : Mariage')}" aria-describedby="npe" aria-invalid="false" oninput="npName(this.value)" onkeydown="if(event.key==='Enter')npGo()"><span class="npcount" id="npcount" aria-hidden="true">0/20</span></div></div><div class="npe" id="npe" role="alert">${S.pk.length>=10?MAXE():''}</div>
${ideas.length?`<div class="lab" style="margin-top:12px">${t3('Quick ideas','Ibitekerezo byihuse','Idées rapides')}</div><div class="npch" id="npch" role="group">${ideas.map(x=>{const l=t3(x[0],x[1],x[2]);return `<button data-n="${esc48(l)}" aria-pressed="false" onclick="npIdea(this.dataset.n,'${x[3]}')">${gx(x[3],20)}${esc48(l)}</button>`}).join('')}</div>`:''}
<div class="lab" style="margin-top:${ideas.length?24:12}px">${t3('Icon','Ikirango','Icône')}</div><div class="npi" id="npi" role="group">${ICONS.map(x=>`<button data-g="${x[0]}" aria-pressed="${x[0]==='wallet'}" class="${x[0]==='wallet'?'on':''}" aria-label="${t3(x[1],x[2],x[3])}" onclick="npIcon('${x[0]}')">${gx(x[0],26)}</button>`).join('')}</div>
<button class="btn" id="nps" style="margin-top:28px" disabled onclick="npGo()">${t3('Create pocket','Kora agasanduku','Créer la poche')}</button></div>`;
setTimeout(()=>{const i=$('#pkn');i&&i.focus()},60)};
window.pkAdd=function(n,g){n=(n||'').trim().slice(0,20);
if(!n){toast(t3('Enter a name','Andika izina','Saisissez un nom'));return}
if(S.pk.length>=10){toast(t3('You can have up to 10 pockets','Ushobora kugira udusanduku 10 gusa','Vous pouvez avoir 10 poches au maximum'));return}
if(S.pk.some(x=>x.n.toLowerCase()===n.toLowerCase())){toast(DUPE());return}
const p={id:'p'+Date.now(),n,g:g||'wallet',b:0,ir:0,h:[]};S.pk.push(p);closeSheet();openPocket(p.id);
toast(t3(n+' pocket created','Agasanduku '+n+' kakozwe','Poche '+n+' créée'))};
}
document.title=document.title.replace(/v\d+/,'v323');
</script>

<style id="v324css">
/* v324: empty pocket */
.pkem{padding:28px 24px 0}
.pkem .pkemt{font-size:18px;font-weight:800;letter-spacing:-.2px;line-height:26px}
.pkem .pkems{margin-top:6px;font-size:15px;line-height:22px;color:var(--mu)}
.pkem .pkemb{margin-top:12px;height:44px;padding:0 16px;border-radius:22px;border:0;background:var(--chip);color:var(--tx);font:inherit;font-weight:700;font-size:15px}
</style>
<script>
/* v324: Empty pocket. Before: a pocket with 0 RWF (the Interest jar, or any pocket you just created) showed a bottom bar where "Fill", the only thing you can do, was squeezed into a thin sliver next to a greyed-out "Take out" and a cramped "Nothing to take out yet." note; above it, an "All" filter with nothing to filter and a grey line saying "No activity yet." Now: when a pocket has nothing in it, the bottom bar is one full-width "Fill" button (no disabled Take out, no note), the filter row is gone, and the empty state says what the pocket is waiting for ("Nothing here yet", how much you have in itunda Bank to fill it from) with a "Set up auto-fill" shortcut. A pocket that has money, or one that was emptied (so it still has history), keeps the two buttons and the list as before; an emptied pocket gets the single Fill button and keeps its history. English, French and Kinyarwanda; fr is new copy and rw is new copy that needs native review, especially "Nta kintu kirimo ubu" and "Shyiraho kuzuza byikora". */
{
const t3=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e;
const _p=screens.pocket;
screens.pocket=function(){let h=_p.apply(this,arguments);const p=pkGet(S.pkId);if(!p||pkBal(p)>0)return h;
const hist=(p.h||[]).length;
const fill=t3('Fill','Uzuza','Alimenter');
const cta=`<div class="cta"><button class="btn" style="height:52px;font-size:16px;border-radius:16px" onclick="openMv('in')">${fill}</button></div>`;
h=h.replace(/<div class="cta"[\s\S]*?<\/div>\s*$/,cta);
if(!hist){
const em=`<div class="pkem"><div class="pkemt">${t3('Nothing here yet','Nta kintu kirimo ubu','Rien ici pour l’instant')}</div><div class="pkems">${t3('Fill it from itunda Bank, which has '+fmt(S.bank)+' RWF. Or let it fill itself.','Uyuzuze uhereye kuri itunda Bank ifite '+fmt(S.bank)+' RWF. Cyangwa ureke yiyuzuze.','Alimentez-la depuis itunda Bank, qui contient '+fmt(S.bank)+' RWF. Ou laissez-la se remplir seule.')}</div><button class="pkemb" onclick="autoSheet()">${t3('Set up auto-fill','Shyiraho kuzuza byikora','Activer le remplissage auto')}</button></div>`;
h=h.replace(/<button class="pkf"[\s\S]*?<\/button>/,'').replace(/<div class="pkempty">[\s\S]*?<\/div>/,em)}
return h};
}
document.title=document.title.replace(/v\d+/,'v324');
</script>

<script>
/* v325: Home pockets. Before: the Pockets section on Home was the only list there with no icon, so "School fees" and "Emergency fund" looked like captions next to a Fill button while Bills and the accounts above all lead with an icon. Each pocket row now starts with that pocket's own icon, the same one shown in the Pockets list and on the pocket page. No text changed, so rw and fr need nothing new. */
{
const _h=screens.home;
screens.home=function(){let h=_h.apply(this,arguments);
h=h.replace(/(<div class="hr tap"[^>]*onclick="openPocket\('([\w-]+)'\)"[^>]*>)(<div class="hm">)/g,(m,a,id,b)=>{const p=pkGet(id);return p?a+pkIco(p,44)+b:m});
return h};
}
document.title=document.title.replace(/v\d+/,'v325');
</script>
<script>
/* v326: School fees icon. Before: the School fees pocket used the same receipt picture as the electricity bill, so on Home the two rows looked alike and you could not tell a pocket from a bill by its icon. School now uses the graduation cap (already in the icon set) everywhere it appears: Home, the Pockets list, the pocket page and the Manage sheet. No text changed. */
delete GM.school;
document.title=document.title.replace(/v\d+/,'v326');
</script>
<script>
/* v327: Pockets list goal. Before: a pocket with a savings goal showed a short unlabeled bar under its balance, so you could see it was part-way but not toward what. The bar now spans the row and a line under it says how far along you are, like "40% of 300,000 RWF", the same wording the pocket page uses. Pockets without a goal are unchanged. rw and fr need native review. */
{
const t3=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e;
const _l=screens.pockets;
screens.pockets=function(){let h=_l.apply(this,arguments);if(typeof h!=='string')return h;
S.pk.filter(p=>p.t).forEach(p=>{const pct=Math.min(100,Math.round(pkBal(p)/p.t*100));
const re=new RegExp(`(onclick="openPocket\\('${p.id}'\\)"[^>]*>[\\s\\S]*?)<div class="pkbar"[^>]*><i style="width:\\d+%"></i></div>`);
const f=t3(pct+'% of '+fmt(p.t)+' RWF',pct+'% kuri '+fmt(p.t)+' RWF',pct+' % de '+fmt(p.t)+' RWF');
h=h.replace(re,`$1<div class="pkbar" role="progressbar" aria-valuenow="${pct}" aria-valuemin="0" aria-valuemax="100" style="margin-top:8px;height:6px"><i style="width:${pct}%"></i></div><div class="pks" style="margin-top:6px">${f}</div>`)});
return h};
}
document.title=document.title.replace(/v\d+/,'v327');
</script>
<style id="v328">
/* v328: Home buttons in rw/fr. Before: the pill buttons on Home (Add money, Pay, Fill, View) were forced to one line, so a longer word like "Ongeramo amafaranga" or "Ajouter de l'argent" ran past the edge of its pill and was cut off at the screen edge. The pill now keeps its shape for short words and wraps to two centred lines when the word is long. No text changed. */
.hr .hp{white-space:normal!important;height:auto!important;min-height:44px;max-width:132px;padding:6px 14px!important;line-height:17px!important;text-align:center;overflow-wrap:anywhere}
</style>
<script>
document.title=document.title.replace(/v\d+/,'v328');
</script>
<script>
/* v329: dates and "From". Before: in Kinyarwanda and French the Pay account and Activity lists still showed English dates ("Tue, 13 Oct", "Mon, 12 Oct", the month picker "October") and the row "From MTN MoMo", next to Kinyarwanda or French labels. Weekdays, months and "From …" are now translated wherever they appear on a screen. rw and fr need native review. */
{
const D={rw:{Mon:'Kuwa mbere',Tue:'Kuwa kabiri',Wed:'Kuwa gatatu',Thu:'Kuwa kane',Fri:'Kuwa gatanu',Sat:'Kuwa gatandatu',Sun:'Ku cyumweru',
Monday:'Kuwa mbere',Tuesday:'Kuwa kabiri',Wednesday:'Kuwa gatatu',Thursday:'Kuwa kane',Friday:'Kuwa gatanu',Saturday:'Kuwa gatandatu',Sunday:'Ku cyumweru',
Jan:'Mutarama',Feb:'Gashyantare',Mar:'Werurwe',Apr:'Mata',May:'Gicurasi',Jun:'Kamena',Jul:'Nyakanga',Aug:'Kanama',Sep:'Nzeri',Oct:'Ukwakira',Nov:'Ugushyingo',Dec:'Ukuboza',
January:'Mutarama',February:'Gashyantare',March:'Werurwe',April:'Mata',June:'Kamena',July:'Nyakanga',August:'Kanama',September:'Nzeri',October:'Ukwakira',November:'Ugushyingo',December:'Ukuboza'},
fr:{Mon:'lun.',Tue:'mar.',Wed:'mer.',Thu:'jeu.',Fri:'ven.',Sat:'sam.',Sun:'dim.',Monday:'Lundi',Tuesday:'Mardi',Wednesday:'Mercredi',Thursday:'Jeudi',Friday:'Vendredi',Saturday:'Samedi',Sunday:'Dimanche',
Jan:'janv.',Feb:'févr.',Mar:'mars',Apr:'avr.',May:'mai',Jun:'juin',Jul:'juil.',Aug:'août',Sep:'sept.',Oct:'oct.',Nov:'nov.',Dec:'déc.',
January:'Janvier',February:'Février',March:'Mars',April:'Avril',June:'Juin',July:'Juillet',August:'Août',September:'Septembre',October:'Octobre',November:'Novembre',December:'Décembre'}};
const W='Mon|Tue|Wed|Thu|Fri|Sat|Sun|Monday|Tuesday|Wednesday|Thursday|Friday|Saturday|Sunday',M='Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec|January|February|March|April|June|July|August|September|October|November|December';
const rx=new RegExp('\\b('+W+'|'+M+')\\b','g');
const tr=x=>{const m=D[S.lang];if(!m)return x;
x=x.replace(/^(\s*)From (.+?)(\s*)$/,(a,p,n,q)=>p+(S.lang==='rw'?'Kuva kuri ':'De ')+n+q);
if(!/^\s*(?:(?:Mon|Tue|Wed|Thu|Fri|Sat|Sun)[a-z]*,?\s*)?(?:\d{1,2}\s+)?(?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)[a-z]*(?:\s+\d{1,4})?\s*$|^\s*(?:Mon|Tue|Wed|Thu|Fri|Sat|Sun)[a-z]*\s*$/.test(x))return x;
return x.replace(rx,w=>m[w]||w)};
Object.keys(screens).forEach(k=>{const f=screens[k];if(typeof f!=='function')return;
screens[k]=function(){const h=f.apply(this,arguments);return typeof h==='string'&&S.lang!=='en'?h.replace(/>([^<>]+)</g,(a,x)=>'>'+tr(x)+'<'):h}});
}
document.title=document.title.replace(/v\d+/,'v329');
</script>
<style id="v330">
/* v330: Pay from and Home edge. Before: on the Pay tab the two "Pay from" options were different-width pills stacked in a ragged column, with the balance squeezed into the same line as the name. They are now two equal full-width rows with the account on the left and its balance on the right, so you can compare the balances at a glance. On Home the "All" link ended 10 px short of the "See all" links below it; it now lines up with them, and the gap under the Bills / Card / Savings strip is a little tighter. No wording changed except that the balance now shows "RWF". */
.v174 .req:has(button[onclick^="ppSrc"]){display:flex;flex-direction:column;gap:8px}
.v174 .req button[onclick^="ppSrc"]{display:flex;align-items:center;justify-content:space-between;gap:12px;width:100%;min-height:52px;padding:12px 18px;border-radius:16px;text-align:left}
.v174 .req button[onclick^="ppSrc"] b{font-weight:800}
.v174 .req button[onclick^="ppSrc"] span{font-variant-numeric:tabular-nums}
.hc .hf{padding-right:14px!important}
.hc:has(.hf)+.hc{padding-top:8px!important}
</style>
<script>
{
const _p=screens.pay;
screens.pay=function(){let h=_p.apply(this,arguments);if(typeof h!=='string')return h;
return h.replace(/(<button[^>]*onclick="ppSrc\('[\w-]+'\)"[^>]*>)([^<>]+?) · ([\d,]+)(<\/button>)/g,(m,a,n,v,z)=>a+'<span>'+n+'</span><span><b>'+v+'</b> RWF</span>'+z)};
}
document.title=document.title.replace(/v\d+/,'v330');
</script>
<style id="v331">
/* v331: Pockets list, add buttons. Before: the three add buttons (Trip, Phone, Custom) wrapped onto two rows of different lengths, so the last one sat alone under the others. They now share one row as three equal buttons, the same way the day-limit amounts sit on a single line. No text changed. */
.pkchips{display:grid!important;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}
.pkchips .chip{justify-content:center;gap:4px;padding-left:6px;padding-right:6px;white-space:nowrap;overflow:visible}
.pkchips .chip svg{flex:none}
</style>
<script>document.title=document.title.replace(/v\d+/,'v331');</script>
<script>
/* v332: Subscriptions summary. Before: "Left to pay this month" and "Next 7 days" sat in a grey rounded box, the only boxed block on an otherwise flat page, and the box was inset 16 px so its text did not line up with the total above it. The two lines now sit directly on the page, aligned with the total and the list below. No text changed. */
{
const _s=screens.subs;
screens.subs=function(){let h=_s.apply(this,arguments);if(typeof h!=='string')return h;
return h.replace('margin:16px 24px 0;padding:6px 16px;border-radius:20px;background:var(--chip)','margin:8px 24px 0;padding:0')};
}
document.title=document.title.replace(/v\d+/,'v332');
</script>
<style id="v333">
/* v333: Messages, conversation options. Before: the "⋯" button on each conversation was drawn at 40% opacity, about 1.9:1 against the white page, so it was hard to see and easy to miss on a bright screen. It is now drawn at a level that reaches about 3:1, the minimum for a control icon, and stays visibly secondary to the message text. Position and tap area did not change. No text changed. */
.mm-more{opacity:.75!important}
</style>
<script>document.title=document.title.replace(/v\d+/,'v333');</script>
<script>
/* v334: Settings title. Before: Settings was the only pushed screen whose top bar showed just the back arrow and no title, so after tapping "Settings" on Explore nothing on the screen said where you were. The bar now reads "Settings" like Bank, Benefits and Transit. It uses the same word as the Explore link, so it follows the chosen language. Nothing else moved. */
{
const _st=screens.settings;
screens.settings=function(){let h=_st.apply(this,arguments);if(typeof h!=='string')return h;
return h.replace('<b></b>','<b>Settings</b>')};
}
document.title=document.title.replace(/v\d+/,'v334');
</script>
<style id="v335">
/* v335: Edit profile. Before: (1) Cancel and Save were 10 px out of line, because Save inherited a stacking margin meant for a single button above another; (2) the chosen avatar was only a faint tint, so it was hard to tell which one was selected; (3) the nickname field had no visible label, only a line under the text. Now: the two buttons share one baseline; the chosen avatar has a clear ring and is announced as selected; the field has a "Nickname" label above it and a count (such as 11/16) that follows what you type. Nothing else changed. */
.v335 .row2 .btn{margin-top:0!important}
.v335 .av5{display:flex;gap:8px;margin:14px 0 22px}
.v335 .av5 button{width:48px;height:48px;font-size:26px;border-radius:16px;background:var(--chip);border:2px solid transparent;padding:0}
.v335 .av5 button[aria-pressed=true]{background:var(--tint);border-color:var(--lk)}
.v335 .nl{display:flex;justify-content:space-between;font-size:13px;color:var(--mu);font-weight:600}
.v335 .in{margin-top:4px}
</style>
<script>
{
const _me=window.mpfEdit;
window.mpfEdit=function(){
 const cur=document.getElementById('mpn');if(cur&&S.mpf)S.mpf.n=cur.value;
 const o=_me.apply(this,arguments);
 const sh=document.querySelector('.sheet');if(!sh)return o;
 const inp=sh.querySelector('#mpn');if(!inp||sh.querySelector('.nl'))return o;
 const av=inp.previousElementSibling;if(av){av.classList.add('av5');av.setAttribute('role','group');av.setAttribute('aria-label','Avatar');av.removeAttribute('style');av.querySelectorAll('button').forEach(b=>b.setAttribute('aria-pressed',String(b.textContent.trim()===S.mpf.a)))}
 const nl=document.createElement('div');nl.className='nl';nl.innerHTML='<label for="mpn">Nickname</label><span id="mpc"></span>';
 const upd=()=>{nl.lastChild.textContent=[...inp.value].length+'/16'};upd();inp.addEventListener('input',upd);
 inp.parentNode.insertBefore(nl,inp);inp.removeAttribute('aria-label');
 sh.querySelector('.cta,.v6cta,.row2')&&0;
 (inp.closest('.sheet')||sh).classList.add('v335');
 return o};
}
document.title=document.title.replace(/v\d+/,'v335');
</script>
<style id="v336">
/* v336: Foreign currency. Before: (1) the total value of what you hold was a small grey line at the very bottom, under the wallets; (2) the rate chart and rate alert sat between the amount and "Your wallets", so the money you hold was pushed below a screen of chart; (3) "Sell" looked tappable even with nothing to sell, and led to a screen where every amount gave an error; switching to a currency you did not hold while on Sell did the same. Now: (1) when you hold foreign currency, the top of the screen shows its total in RWF in large type; (2) the order is amount, wallets, rate chart and alert, recent conversions; (3) with an empty wallet the Sell tab is greyed and tapping it says "You hold no USD to sell yet" instead of switching, and changing currency on Sell falls back to Buy when that wallet is empty. Conversion, review sheet, result sheet, Activity and the rate alert are unchanged. English, French and Kinyarwanda; fr and rw are new copy and the Kinyarwanda needs native review. */
.v336h{padding:10px 24px 0}.v336h .sm{font-weight:600}.v336h b{display:block;font-size:30px;line-height:38px;letter-spacing:-.6px;margin-top:2px}
.v336off{opacity:.45}
</style>
<script>
{
const t3=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e,CODES=['USD','EUR','GBP'],RATE={USD:1445,EUR:1680,GBP:1960};
const held=c=>((S.fx&&S.fx.w&&S.fx.w[c])||0)>0.004;
const _s=screens.fx;
screens.fx=function(){let h=_s.apply(this,arguments);if(typeof h!=='string')return h;
 const x=S.fx,c=CODES[x.c]||'USD';
 /* 1. total on top, old bottom line removed */
 const tot=CODES.reduce((a,k)=>a+Math.round(((x.w&&x.w[k])||0)*RATE[k]),0);
 h=h.replace(/<div style="display:flex;justify-content:space-between;padding:6px 24px 0;font-size:14px" class="mu"><span>[^<]*<\/span><b[^>]*>[^<]*<\/b><\/div>/,'');
 if(tot>0)h=h.replace(/(<div class="bar">[\s\S]*?<\/b><\/div>)/,'$1<div class="v336h"><div class="sm mu">'+t3('Foreign currency you hold','Amafaranga y’amahanga ufite','Devises détenues')+'</div><b>≈ '+fmt(tot)+' RWF</b></div>');
 /* 2. chart + alert card moves below the wallets */
 const a=h.indexOf('<div style="margin:18px 24px 0;padding:16px;border-radius:20px;background:var(--chip)"><div style="display:flex;justify-content:space-between;align-items:baseline');
 const w=h.indexOf('<div style="padding:22px 24px 8px;font-size:18px;font-weight:800">',a);
 const r=h.indexOf('<div style="padding:22px 24px 4px;font-size:18px;font-weight:800">',w);
 if(a>0&&w>a&&r>w){const card=h.slice(a,w);h=h.slice(0,a)+h.slice(w,r)+card+h.slice(r)}
 /* 3. Sell greyed when nothing to sell */
 if(!held(c))h=h.replace(/<button class="([^"]*)" aria-pressed="(true|false)" onclick="fxDir\('sell'\)">/,'<button class="$1 v336off" aria-pressed="$2" aria-disabled="true" onclick="fxDir(\'sell\')">');
 return h};
const _d=window.fxDir;
window.fxDir=function(d){const c=CODES[S.fx.c]||'USD';
 if(d==='sell'&&!held(c)){toast(t3('You hold no '+c+' to sell yet','Nta '+c+' ufite yo kugurisha','Vous n’avez pas encore de '+c+' à vendre'));return}
 return _d.apply(this,arguments)};
window.fxCur=function(i){const x=S.fx;x.c=i;x.s=0;if(x.d==='sell'&&!held(CODES[i]))x.d='buy';render('fade-none')};
}
document.title=document.title.replace(/v\d+/,'v336');
</script>
<script>
/* v337: Make an offer. Before (v321): the sheet had percent chips (−5%, −10%, −15%) that did not say what you would offer, a separate "Or enter your own price" label and empty box, a grey three-line summary, a separate warning line and the button, so it was tall and you had to do the sum yourself; typing your own price un-selected the chips and left the amount field empty after a chip; there was no way to take an offer back; the sheet did not announce itself as a dialog. Now: the chips show the amount first and the percent below (45,000 / −10%); the field is one large "Your offer" box that is already filled in (your last offer, or 10% off) and that every chip fills in, so you always see exactly what will be sent; the chip that matches the amount stays selected, also when you type the same number; the summary box and the warning become one line under the field: green \"You save 5,000 RWF · 10%\", or the same gentle notes as before (enter an amount, must be lower than the asking price, very low offers are often ignored); chips and typing update the sheet in place instead of redrawing it, so it no longer flickers; if you already made an offer there is a \"Withdraw offer\" button that clears it from the item page and adds a line to the chat; the sheet is a labelled dialog. The button still names the amount, Enter still sends, the message in Messages and the \"Your offer\" line on the item page are unchanged. rw and fr copy for \"Withdraw offer\" and \"Offer withdrawn\" is new and needs native review. */
{const t=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e;
const esc=s=>String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/"/g,'&quot;');
const item=id=>HD.market.items.find(x=>x.id===id),PCS=[5,10,15];
const rd=n=>Math.round(n/500)*500,ca=(x,n)=>rd(x.p*(1-n/100));
const num=s=>Number(String(s).replace(/,/g,''))||0;
const fi=v=>String(v).replace(/\D/g,'').replace(/\B(?=(\d{3})+(?!\d))/g,',');
const amt=()=>num(S.mxo.custom),bad=()=>{const x=item(S.mxo.id),a=amt();return !(a>0&&a<x.p)};
const msg=()=>{const x=item(S.mxo.id),a=amt();
 if(!a)return['var(--er)',t('Enter an amount.','Andika umubare.','Saisissez un montant.')];
 if(a>=x.p)return['var(--er)',t('Your offer must be lower than the asking price.','Igiciro watanze kigomba kuba munsi y’icyasabwe.','Votre offre doit être inférieure au prix demandé.')];
 if(a<x.p*.6)return['var(--mu)',t('Very low offers are often ignored. Try closer to the asking price.','Ibiciro biri hasi cyane akenshi ntibisubizwa. Gerageza kwegera icyasabwe.','Les offres très basses restent souvent sans réponse. Rapprochez-vous du prix demandé.')];
 return['var(--ok)',t('You save','Uzigama','Vous économisez')+' '+fmt(x.p-a)+' RWF · '+Math.round((x.p-a)/x.p*100)+'%']};
const lab=()=>{const a=amt();return t('Send offer','Ohereza igiciro','Envoyer l’offre')+(a>0&&!bad()?' · '+fmt(a)+' RWF':'')};
const upd=()=>{const x=item(S.mxo.id),a=amt(),m=msg(),w=$('#mxow'),g=$('#mxogo');if(!w||!g)return;
 document.querySelectorAll('#mxoch button').forEach((b,i)=>{const on=ca(x,PCS[i])===a;b.classList.toggle('on',on);b.setAttribute('aria-pressed',on?'true':'false')});
 w.textContent=m[1];w.style.color=m[0];$('#mxoc').setAttribute('aria-invalid',bad()&&a>0?'true':'false');g.disabled=bad();g.textContent=lab()};
const draw=()=>{const x=item(S.mxo.id),last=S.mxOffs[x.id],a=amt(),m=msg();
 const chips=PCS.map(n=>{const on=ca(x,n)===a;return `<button class="${on?'on':''}" aria-pressed="${on}" onclick="mkOffPc(${n})" style="flex:1;min-width:0;min-height:56px;border:0;border-radius:16px;padding:6px 4px;line-height:20px;background:${on?'var(--tx)':'var(--chip)'};color:${on?'var(--bg)':'var(--tx)'}"><b style="display:block;font-size:16px">${fmt(ca(x,n))}</b><span style="font-size:13px;font-weight:600;opacity:.8">−${n}%</span></button>`}).join('');
 $('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" role="dialog" aria-modal="true" aria-label="'+esc(last?t('Update your offer','Hindura igiciro cyawe','Modifier votre offre'):t('Make an offer','Tanga igiciro','Faire une offre'))+'" style="max-height:88%;overflow-y:auto">'
 +`<div class="h1" style="font-size:22px;line-height:30px">${last?t('Update your offer','Hindura igiciro cyawe','Modifier votre offre'):t('Make an offer','Tanga igiciro','Faire une offre')}</div><div class="mu" style="font-size:15px;margin:8px 0 0">${esc(x.ti)} · ${t('asking','bisabwa','demandé')} ${fmt(x.p)} RWF</div>`
 +(x.neg?'':`<div class="sm" style="margin-top:12px;line-height:20px;padding:10px 14px;border-radius:14px;background:var(--chip)">${t('The seller has not marked this price as negotiable. You can still send an offer.','Umugurisha ntiyavuze ko igiciro gishobora kugabanywa. Ushobora gutanga igiciro uko byagenda kose.','Le vendeur n’a pas indiqué un prix négociable. Vous pouvez quand même envoyer une offre.')}</div>`)
 +(last?`<div class="sm mu" style="margin-top:10px">${t('Your last offer','Igiciro cyawe giheruka','Votre dernière offre')}: ${fmt(last)} RWF</div>`:'')
 +`<div id="mxoch" role="group" style="display:flex;gap:8px;margin-top:16px">${chips}</div>`
 +`<label class="sm mu" for="mxoc" style="display:block;margin-top:16px;font-weight:600">${t('Your offer','Igiciro cyawe','Votre offre')}</label><div style="display:flex;align-items:center;gap:8px;margin-top:4px;padding:4px 16px;border-radius:16px;background:var(--chip)"><input class="in" id="mxoc" inputmode="numeric" autocomplete="off" value="${esc(S.mxo.custom)}" oninput="mxoIn()" onkeydown="if(event.key==='Enter')mkOffSend()" aria-describedby="mxow" aria-invalid="${bad()&&a>0}" placeholder="0" style="flex:1;min-width:0;border:0;background:none;margin:0;height:52px;font-size:28px;font-weight:800;letter-spacing:-.5px"><b style="color:var(--mu);font-size:18px">RWF</b></div>`
 +`<div id="mxow" role="status" class="sm" style="min-height:20px;margin-top:10px;line-height:20px;font-weight:600;color:${m[0]}">${m[1]}</div><button class="btn" id="mxogo" style="margin-top:10px" ${bad()?'disabled':''} onclick="mkOffSend()">${lab()}</button>`
 +`<div class="sm mu" style="margin-top:12px;text-align:center;line-height:20px">${t('The seller replies in Messages. You only pay if you both agree.','Umugurisha agusubiriza muri Messages. Wishyura ari uko mwemeranyije.','Le vendeur répond dans Messages. Vous ne payez que si vous êtes d’accord.')}</div>`
 +(last?`<button type="button" onclick="mkOffWd()" style="display:block;margin:4px auto 0;border:0;background:none;min-height:44px;padding:0 16px;font:inherit;font-weight:700;color:var(--er)">${t('Withdraw offer','Kuramo igiciro','Retirer l’offre')}</button>`:'')
 +'</div>'};
window.mkOffer=id=>{const x=item(id),last=S.mxOffs[id];S.mxo={id,pc:10,custom:fi(last||ca(x,10))};draw()};
window.mkOffPc=n=>{const x=item(S.mxo.id);S.mxo.pc=n;S.mxo.custom=fi(ca(x,n));$('#mxoc').value=S.mxo.custom;upd()};
window.mxoIn=()=>{const i=$('#mxoc');S.mxo.custom=fi(i.value);i.value=S.mxo.custom;upd()};
window.mkOffSend=()=>{if(!S.mxo||bad())return;const x=item(S.mxo.id),a=amt(),th='hdmarket'+x.id,m='Hi, would you accept '+fmt(a)+' RWF for "'+x.ti+'"?';
 hdThread(th,x.who,x.ti,[['me',m]]);if(S.msgs[th].length>1||S.msgs[th][0][1]!==m)S.msgs[th].push(['me',m]);S.mxOffs[x.id]=a;
 closeSheet();S.tab='messages';openChat(th);toast(t('Offer sent','Igiciro cyoherejwe','Offre envoyée'))};
window.mkOffWd=()=>{if(!S.mxo)return;const x=item(S.mxo.id),th='hdmarket'+x.id;if(!S.mxOffs[x.id])return;delete S.mxOffs[x.id];
 if(S.msgs[th])S.msgs[th].push(['me','I am withdrawing my offer for "'+x.ti+'".']);closeSheet();render('fade-none');toast(t('Offer withdrawn','Igiciro cyakuweho','Offre retirée'))};
}
/* v338: Scan screen. (1) The camera view is dimmed around the frame so the eye goes to the frame; frame corners are bigger and the scan line fades at its ends. (2) Layout is a column instead of fixed offsets, so nothing overlaps on short phones. (3) A code that is tapped is "found" first: the frame turns green with a tick, the phone buzzes, the headline says "Code found", then the next screen opens (no instant jump). (4) Flash shows on/off (filled icon, soft glow on the frame, aria-pressed) and keeps its state. (5) After 6 seconds with no code, a hint suggests the flash or typing the till number. (6) Sample codes are in one scrolling row with 13 px text, 44 px tap height, labelled as prototype only. (7) Status line is read out by screen readers. No copy or flow changes elsewhere. */
(function(){
const T3=(a,b,c)=>({rw:b,fr:c}[S.lang]||a);
const svg=(d,z)=>`<svg width="${z||24}" height="${z||24}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;
const X=svg('<path d="M6 6l12 12M18 6L6 18"/>'),FLASH=svg('<path d="M13 2L5 14h6l-1 8 8-12h-6z"/>'),IMG=svg('<rect x="3" y="4" width="18" height="16" rx="3"/><circle cx="9" cy="10" r="1.6"/><path d="M4 18l5-5 4 4 3-3 4 4"/>',20);
const st=document.createElement('style');
st.textContent=`
.sc2{position:absolute;inset:0;background:#0D0D10;color:#fff;overflow:hidden;display:flex;flex-direction:column}
.sc2 .top{display:flex;align-items:center;justify-content:space-between;padding:12px 8px 0;flex:0 0 auto;z-index:2}
.sc2 .top .ib{color:#fff}
.sc2 #sc2fl{opacity:.7}.sc2 #sc2fl.on{opacity:1;color:#FFD84D}.sc2 #sc2fl.on svg{fill:#FFD84D}
.sc2 .hd{text-align:center;padding:14px 24px 0;flex:0 0 auto}
.sc2 .hd b{display:block;font-size:22px;line-height:28px;font-weight:800}
.sc2 .hd span{display:block;font-size:15px;line-height:21px;opacity:.8;margin-top:6px;min-height:21px}
.sc2 .mid{flex:1 1 auto;display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:0;padding:12px 0}
.sc2fr{position:relative;width:min(240px,62vw);aspect-ratio:1;border-radius:22px;box-shadow:0 0 0 100vmax rgba(0,0,0,.58);transition:box-shadow .25s}
.sc2fr.lit{box-shadow:0 0 0 100vmax rgba(0,0,0,.4),0 0 40px 6px rgba(255,255,255,.22)}
.sc2fr i{position:absolute;width:44px;height:44px;border:5px solid #fff;transition:border-color .2s}
.sc2fr.ok i{border-color:#3DDC97}
.sc2fr .ln{position:absolute;left:14px;right:14px;height:3px;border-radius:2px;background:linear-gradient(90deg,transparent,var(--br,#7472F4) 20%,var(--br,#7472F4) 80%,transparent);animation:sc2l 2.2s ease-in-out infinite alternate}
.sc2fr.ok .ln{display:none}
@keyframes sc2l{from{top:14px}to{top:calc(100% - 17px)}}
.sc2fr .tk{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;opacity:0;transform:scale(.6);transition:opacity .2s,transform .25s}
.sc2fr.ok .tk{opacity:1;transform:none}
.sc2fr .tk b{width:72px;height:72px;border-radius:36px;background:#3DDC97;color:#0D0D10;display:flex;align-items:center;justify-content:center}
.sc2 .acts{display:flex;gap:10px;justify-content:center;margin-top:22px}
.sc2 .bot{flex:0 0 auto;padding:0 0 26px}
.sc2 .bot .lab{font-size:13px;font-weight:700;opacity:.7;padding:0 20px 8px}
.sc2 .row{display:flex;gap:8px;overflow-x:auto;padding:0 20px 2px;scrollbar-width:none}
.sc2 .row::-webkit-scrollbar{display:none}
.sc2 .v8chip{min-height:44px;flex:0 0 auto}
.sc2 .my{text-align:center;margin-top:16px}
.sc2.busy .bot,.sc2.busy .acts{pointer-events:none}
`;
document.head.appendChild(st);
const prev=screens.paysc;
const shops=[...prev().matchAll(/ppMerch\('(\d+)'\)[\s\S]*?<span style="flex:1">([^<]*)<\/span>/g)].map(m=>[m[1],m[2]]);
screens.paysc=()=>{
 const send=S.scanFor==='send',fl=!!S.scFl;
 clearTimeout(window.scIdle);
 window.scIdle=setTimeout(()=>{const h=document.getElementById('sc2hint');if(h&&!document.querySelector('.sc2.busy'))h.textContent=T3('Too dark? Try the flash, or type the till number.','Hari umwijima? Gerageza itara, cyangwa wandike nimero.','Trop sombre ? Essayez le flash ou saisissez le numéro.')},6000);
 return `<div class="sc2"><div class="top"><button id="sc2fl" class="ib${fl?' on':''}" aria-pressed="${fl}" aria-label="${T3('Flash','Itara','Flash')}" onclick="scFlash(this)">${FLASH}</button><button class="ib" aria-label="${T3('Close','Funga','Fermer')}" onclick="back()">${X}</button></div>
<div class="hd"><b id="sc2t">${send?T3('Scan a code to send','Sikana kode kugira wohereze','Scannez un code pour envoyer'):T3('Scan a QR code','Sikana kode ya QR','Scannez un code QR')}</b><span id="sc2hint" role="status" aria-live="polite">${T3('Shops and friends both work.','Abacuruzi n’inshuti byose bikora.','Commerçants et amis fonctionnent.')}</span></div>
<div class="mid"><div class="sc2fr${fl?' lit':''}" id="sc2fr"><i style="top:0;left:0;border-right:0;border-bottom:0;border-radius:22px 0 0 0"></i><i style="top:0;right:0;border-left:0;border-bottom:0;border-radius:0 22px 0 0"></i><i style="bottom:0;left:0;border-right:0;border-top:0;border-radius:0 0 0 22px"></i><i style="bottom:0;right:0;border-left:0;border-top:0;border-radius:0 0 22px 0"></i><div class="ln"></div><div class="tk"><b>${svg('<path d="M5 12.5l4.5 4.5L19 7.5"/>',40)}</b></div></div>
<div class="acts"><button class="v8pill" onclick="scType()">${svg('<path d="M4 20l4-1 11-11a2.1 2.1 0 00-3-3L5 16z"/>',20)}${send?T3('Type in','Andika','Saisir'):T3('Till number','Nimero y’umucuruzi','N° de caisse')}</button><button class="v8pill" onclick="toast('${T3('The photo picker is not in this prototype.','Guhitamo ifoto ntibirimo muri iyi prototype.','Le sélecteur de photos n’est pas dans ce prototype.')}')">${IMG}${T3('From photos','Mu mafoto','Depuis les photos')}</button></div></div>
<div class="bot"><div class="lab">${T3('Try a sample code (prototype)','Gerageza kode y’icyitegererezo','Essayez un code d’exemple')}</div><div class="row"><button class="v8chip" onclick="scHit(()=>scPerson('0788 000 214'))">Amina K.</button>${shops.map(([k,n])=>`<button class="v8chip" onclick="scHit(()=>ppMerch('${k}'))">${esc(n)}</button>`).join('')}</div>
<div class="my"><button class="v8pill out" onclick="S.stack.push('rcode');render('push')">${gx('qr',24)}${T3('My code','Kode yanjye','Mon code')}</button></div></div></div>`};
window.scFlash=b=>{const on=b.getAttribute('aria-pressed')!=='true';S.scFl=on;b.setAttribute('aria-pressed',on);b.classList.toggle('on',on);const f=document.getElementById('sc2fr');if(f)f.classList.toggle('lit',on)};
window.scHit=fn=>{const r=document.querySelector('.sc2');if(!r||r.classList.contains('busy'))return;r.classList.add('busy');
 document.getElementById('sc2fr').classList.add('ok');document.getElementById('sc2t').textContent=T3('Code found','Kode yabonetse','Code détecté');document.getElementById('sc2hint').textContent='';
 try{navigator.vibrate&&!matchMedia('(prefers-reduced-motion:reduce)').matches&&navigator.vibrate(15)}catch(e){}
 setTimeout(()=>{if(document.querySelector('.sc2')===r&&S.stack[S.stack.length-1]==='paysc')fn()},550)};
})();

/* v339: Foreign currency. Before: the screen showed today's rate but not whether it was a good moment, the review sheet gave no sense of how long the rate holds, and after converting the result sheet did not show what you now hold. Now: (1) under the rate and fee, one line puts today's rate in its 7-day range with a coloured dot: near the low is good for buying and near the high is good for selling, the opposite gets a gentle "you may want to wait", and the middle says so; (2) the review sheet says "Rate locked for 30 s" with a countdown that renews itself at 0, so the price you confirm is the price you get; (3) the result sheet adds a line with your new balance (your USD wallet when you buy, itunda Bank when you sell). Conversion, fees, wallets, the rate chart and alerts are unchanged. Still not here: more currencies (KES, UGX, TZS), which need rates below 1 RWF and new shortcut amounts. rw and fr copy is new and needs native review. */
{const t3=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e,CODES=['USD','EUR','GBP'],RATE={USD:1445,EUR:1680,GBP:1960},OFF={USD:[-1.1,-.8,-.9,-.4,-.2,-.1,0],EUR:[.7,.5,.2,.3,.1,-.2,0],GBP:[-.4,-.7,-.3,-.1,.2,.1,0]};
const d2=n=>(Math.floor(n*100+1e-6)/100).toFixed(2);
const _s=screens.fx;
screens.fx=function(){let h=_s.apply(this,arguments);if(typeof h!=='string')return h;
 const x=S.fx,c=CODES[x.c]||'USD',v=OFF[c],mn=Math.min(...v),mx=Math.max(...v),pos=(0-mn)/Math.max(.001,mx-mn),buy=(x.d||'buy')==='buy';
 const low=pos<=.34,high=pos>=.67;let col='var(--mu)',tx;
 if(low){col=buy?'var(--ok)':'var(--er)';tx=buy?t3('Near its 7-day low. A good time to buy.','Hafi n’igiciro gito mu minsi 7. Ni igihe cyiza cyo kugura.','Près de son plus bas sur 7 jours. Bon moment pour acheter.'):t3('Near its 7-day low. You may want to wait before selling.','Hafi n’igiciro gito mu minsi 7. Wategereza mbere yo kugurisha.','Près de son plus bas sur 7 jours. Mieux vaut attendre pour vendre.')}
 else if(high){col=buy?'var(--er)':'var(--ok)';tx=buy?t3('Near its 7-day high. You may want to wait, or set a rate alert.','Hafi n’igiciro cyo hejuru mu minsi 7. Wategereza, cyangwa ushyireho imenyesha.','Près de son plus haut sur 7 jours. Attendez ou activez une alerte.'):t3('Near its 7-day high. A good time to sell.','Hafi n’igiciro cyo hejuru mu minsi 7. Ni igihe cyiza cyo kugurisha.','Près de son plus haut sur 7 jours. Bon moment pour vendre.')}
 else tx=t3('In the middle of its 7-day range.','Hagati mu minsi 7 ishize.','Au milieu de sa fourchette sur 7 jours.');
 const ins='<div class="sm" style="display:flex;gap:8px;align-items:flex-start;padding:8px 24px 0;line-height:19px"><i aria-hidden="true" style="flex:0 0 9px;height:9px;border-radius:5px;margin-top:5px;background:'+col+'"></i><span>'+tx+'</span></div>';
 return h.replace('<div class="sm mu" id="fxn"',ins+'<div class="sm mu" id="fxn"')};
const lk=()=>t3('Rate locked for ','Igiciro gifunze mu ','Taux garanti pendant ');
const _a=window.fxAsk;
window.fxAsk=function(){clearInterval(window.fxLk);const r=_a.apply(this,arguments),L=document.getElementById('layer'),row=L&&L.querySelector('.row2');
 if(!row)return r;let n=30;row.insertAdjacentHTML('beforebegin','<div class="sm mu" id="fxlk" style="text-align:center;margin:-8px 0 14px">'+lk()+n+' s</div>');
 window.fxLk=setInterval(()=>{const e=document.getElementById('fxlk');if(!e||!e.isConnected){clearInterval(window.fxLk);return}n--;if(n<=0){n=30;e.textContent=t3('Rate refreshed. Locked for 30 s','Igiciro cyavuguruwe. Gifunze mu 30 s','Taux actualisé. Garanti 30 s')}else e.textContent=lk()+n+' s'},1000);return r};
const _d=window.fxDo;
window.fxDo=function(){clearInterval(window.fxLk);const x=S.fx,c=CODES[x.c]||'USD',buy=(x.d||'buy')==='buy',r=_d.apply(this,arguments),L=document.getElementById('layer');
 if(!L||L.innerHTML.indexOf('💱')<0)return r;const ok=L.querySelector('button.btn');if(!ok)return r;
 const line=buy?t3('Your '+c+' wallet: ','Wallet yawe ya '+c+': ','Votre portefeuille '+c+' : ')+d2(x.w[c]||0)+' '+c:t3('itunda Bank balance: ','Amafaranga muri itunda Bank: ','Solde itunda Bank : ')+fmt(S.bank)+' RWF';
 ok.insertAdjacentHTML('beforebegin','<div style="font-size:15px;font-weight:800;margin:-8px 0 18px">'+line+'</div>');return r};
}

/* v340: Youth account. Before: once the account was open, a parent could send money and set a weekly limit and nothing else; French and Kinyarwanda fell back to an older English page; there was no list of what you had sent and no way to stop spending. Now (English, French, Kinyarwanda): (1) the balance shows a red "Spending paused" tag when paused; (2) "Pocket money": Off / 1,000 / 2,000 / 5,000 RWF every Monday, with a sentence naming the child, the amount and the next Monday (sample, nothing is sent automatically in the prototype); (3) "Pause spending": one switch that stops the child spending until you turn it back on, with a sentence saying what it does; (4) "Sent to {name}" lists what you sent, newest first, with date and amount, or says nothing has been sent yet. Sending money, the review sheets, the weekly limit and the sign-up page are unchanged; the sign-up page and the review sheets are still English only. rw and fr copy is new and needs native review. */
{const t3=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e;
const esc=x=>String(x).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const cb=(on,fn,txt)=>'<button class="chip" aria-pressed="'+on+'" onclick="'+fn+'" style="min-width:64px;height:44px;border-radius:22px;border:0;padding:0 16px;font-size:15px;font-weight:800;background:'+(on?'var(--tx)':'var(--chip)')+';color:'+(on?'var(--bg)':'var(--tx)')+'">'+txt+'</button>';
const chs=(a,cur,fn,lb)=>'<div style="display:flex;gap:10px;flex-wrap:wrap;padding-top:10px" role="group">'+a.map(v=>cb(v===cur,fn+'('+v+')',lb?lb(v):fmt(v))).join('')+'</div>';
const hd=x=>'<div style="font-size:16px;font-weight:800;padding-top:22px">'+x+'</div>';
const loc=()=>({en:'en-GB',fr:'fr-FR',rw:'en-GB'})[S.lang]||'en-GB';
const nextMon=()=>{const d=new Date();d.setHours(0,0,0,0);d.setDate(d.getDate()+((8-d.getDay())%7||7));return d};
const fd=d=>new Date(d).toLocaleDateString(loc(),{day:'numeric',month:'short'});
const _y=screens.yth,_s=window.ythSend;
window.ythSend=function(n){const Y=S.yth;if(Y){(Y.h=Y.h||[]).unshift([Date.now(),n])}return _s.apply(this,arguments)};
screens.yth=function(){const Y=S.yth;if(!Y)return _y.apply(this,arguments);
 const n=S.ysd||2000,low=S.bank<n,nm=esc(Y.n),pa=!!Y.pause,pm=Y.pm||0,h=Y.h||[];
 const tag=pa?'<span style="display:inline-block;margin-top:10px;padding:5px 12px;border-radius:14px;background:var(--er);color:#fff;font-size:13px;font-weight:800">'+t3('Spending paused','Gukoresha amafaranga byahagaritswe','Dépenses suspendues')+'</span>':'';
 const sw='<div class="row" style="padding:0;cursor:default"><div style="flex:1;min-width:0"><div class="t">'+t3('Pause spending','Hagarika gukoresha','Suspendre les dépenses')+'</div><div class="s" style="line-height:20px">'+(pa?t3(nm+' cannot spend until you turn this off.',nm+' ntashobora gukoresha amafaranga kugeza ubyuguye.',nm+' ne peut plus dépenser tant que vous ne le réactivez pas.'):t3('Stops '+nm+' spending from this account.','Ahagarika '+nm+' gukoresha amafaranga kuri konti.','Empêche '+nm+' de dépenser depuis ce compte.'))+'</div></div><div class="sw'+(pa?' on':'')+'" role="switch" tabindex="0" aria-checked="'+pa+'" aria-label="'+t3('Pause spending','Hagarika gukoresha','Suspendre les dépenses')+'" onclick="ythPause()"><i></i></div></div>';
 const pmTx=pm?t3(nm+' gets '+fmt(pm)+' RWF every Monday from itunda Bank. Next: '+fd(nextMon())+'.',nm+' ahabwa RWF '+fmt(pm)+' buri wa mbere muri itunda Bank. Ubutaha: '+fd(nextMon())+'.',nm+' reçoit '+fmt(pm)+' RWF chaque lundi depuis itunda Bank. Prochain : '+fd(nextMon())+'.'):t3('Send a fixed amount every Monday, so you do not have to remember.','Ohereza amafaranga angana buri wa mbere, utibagiwe.','Envoyez un montant fixe chaque lundi, sans y penser.');
 const rec=h.length?h.slice(0,5).map(x=>'<div class="row" style="padding:8px 0;cursor:default"><div class="ico" style="width:36px;height:36px">💸</div><div style="flex:1;min-width:0"><div class="t" style="font-size:15px">'+t3('Sent to '+nm,'Byoherejwe kuri '+nm,'Envoyé à '+nm)+'</div><div class="s">'+fd(x[0])+'</div></div><b>'+fmt(x[1])+' RWF</b></div>').join(''):'<div class="mu" style="font-size:15px;line-height:22px;padding-top:8px">'+t3('Nothing sent yet. Money you send shows here.','Nta cyoherejwe. Amafaranga yoherejwe azagaragara hano.','Rien envoyé pour l’instant. Les envois apparaîtront ici.')+'</div>';
 return bar(t3(Y.n+"'s account",'Konti ya '+Y.n,'Compte de '+Y.n))+'<div class="pad" style="padding-top:28px"><div class="sm mu">'+t3('Balance','Amafaranga ahari','Solde')+'</div><div class="big" style="margin-top:4px">'+fmt(Y.bal)+' RWF</div><div class="sm mu" style="margin-top:6px">'+t3('Parent-supervised · weekly limit ','Ugenzurwa n’umubyeyi · umupaka wa buri cyumweru ','Supervisé par un parent · plafond hebdomadaire ')+fmt(Y.l)+' RWF</div>'+tag+'</div>'+
 '<div class="pad">'+hd(t3('How much to send?','Wohereza angahe?','Combien envoyer ?'))+chs([2000,5000,10000],n,'ythAmt')+'<div class="sm mu" style="margin-top:14px;line-height:20px" aria-live="polite">'+(low?'<span style="color:var(--er)">'+t3(fmt(n)+' RWF is more than your bank balance of '+fmt(S.bank)+' RWF. Pick a smaller amount.','RWF '+fmt(n)+' irarenze amafaranga ufite muri banki (RWF '+fmt(S.bank)+'). Hitamo make.',fmt(n)+' RWF dépasse votre solde de '+fmt(S.bank)+' RWF. Choisissez moins.')+'</span>':t3('From itunda Bank · balance after '+fmt(S.bank-n)+' RWF','Muri itunda Bank · nyuma hasigaye RWF '+fmt(S.bank-n),'Depuis itunda Bank · solde après '+fmt(S.bank-n)+' RWF'))+'</div><button class="btn" style="width:100%;margin-top:16px;white-space:nowrap" '+(low?'disabled ':'')+'onclick="ythSendReview()">'+t3('Send '+fmt(n)+' RWF to '+nm,'Ohereza RWF '+fmt(n)+' kuri '+nm,'Envoyer '+fmt(n)+' RWF à '+nm)+'</button></div>'+
 '<div class="pad">'+hd(t3('Pocket money','Amafaranga y’ikiyiko','Argent de poche'))+chs([0,1000,2000,5000],pm,'ythPm',v=>v?fmt(v):t3('Off','Zimya','Non'))+'<div class="sm mu" style="margin-top:14px;line-height:20px">'+pmTx+'</div><div class="fine" style="margin-top:6px">'+t3('Sample only. Nothing is sent automatically in this prototype.','Icyitegererezo gusa. Nta kohereza kwikora muri iyi prototype.','Exemple uniquement. Rien n’est envoyé automatiquement dans ce prototype.')+'</div></div>'+
 '<div class="pad">'+hd(t3('Weekly spending limit','Umupaka wa buri cyumweru','Plafond hebdomadaire'))+chs([1000,3000,5000],Y.l,'ythLim')+'<div class="sm mu" style="margin-top:14px;line-height:20px">'+t3(nm+' can spend up to '+fmt(Y.l)+' RWF a week. A change applies straight away.',nm+' ashobora gukoresha RWF '+fmt(Y.l)+' ku cyumweru. Impinduka zihita zikora.',nm+' peut dépenser jusqu’à '+fmt(Y.l)+' RWF par semaine. Un changement s’applique tout de suite.')+'</div></div>'+
 '<div class="pad" style="padding-top:22px">'+sw+'</div>'+
 '<div class="pad">'+hd(t3('Sent to '+nm,'Byoherejwe kuri '+nm,'Envoyé à '+nm))+rec+'</div><div class="pad fine" style="padding-top:20px">'+t3('Sample data for this prototype.','Amakuru y’icyitegererezo.','Données d’exemple pour ce prototype.')+'</div>'};
window.ythAmt=v=>{S.ysd=v;render('fade-none')};
window.ythLim=v=>{S.yth.l=v;render('fade-none')};
window.ythPm=v=>{S.yth.pm=v;render('fade-none');toast(v?t3('Pocket money on','Amafaranga y’ikiyiko arakora','Argent de poche activé'):t3('Pocket money off','Amafaranga y’ikiyiko yazimijwe','Argent de poche désactivé'))};
window.ythPause=()=>{const Y=S.yth;Y.pause=!Y.pause;render('fade-none');toast(Y.pause?t3('Spending paused','Gukoresha byahagaritswe','Dépenses suspendues'):t3('Spending allowed again','Gukoresha byongeye kwemerwa','Dépenses de nouveau autorisées'))};
}

/* v341: Scan screen, the cases that were missing. Before: the screen only worked when every code was good, and "From photos" only showed a message. Now (English, French, Kinyarwanda): (1) a code that cannot be read turns the frame red with a "!" and a short shake (none when the phone asks for reduced motion), the headline says "Can't read this code", the status line says what to do next (try again or type the till number), and the screen is usable again after 2 seconds; a sample chip "Unreadable code" lets you try it; (2) "From photos" opens a sheet with two sample photos: one with a code (continues like a scanned code) and one without ("No code in this photo. Pick a photo where the whole code is visible."). The camera view, flash, found state, idle hint, sample codes and everything after the scan are unchanged. rw and fr copy is new and needs native review. */
(function(){
const T3=(a,b,c)=>({rw:b,fr:c}[S.lang]||a);
const svg=(d,z)=>`<svg width="${z||24}" height="${z||24}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;
const st=document.createElement('style');
st.textContent=`.sc2fr.bad i{border-color:#FF6B5E}.sc2fr.bad .ln{display:none}.sc2fr.bad .tk{opacity:1;transform:none}.sc2fr.bad .tk b{background:#FF6B5E;color:#0D0D10}.sc2fr.bad{animation:sc2s .35s}@keyframes sc2s{0%,100%{transform:none}25%{transform:translateX(-8px)}75%{transform:translateX(8px)}}@media(prefers-reduced-motion:reduce){.sc2fr.bad{animation:none}}`;
document.head.appendChild(st);
const _p=screens.paysc;
screens.paysc=function(){
 let h=_p.apply(this,arguments);if(typeof h!=='string')return h;
 h=h.replace(/onclick="toast\('(?:The photo picker|Guhitamo ifoto|Le sélecteur)[^']*'\)"/,'onclick="scPhotos()"');
 const chip='<button class="v8chip" onclick="scBad()">'+T3('Unreadable code','Kode itasomeka','Code illisible')+'</button>';
 return h.replace(/<\/div>\n<div class="my">/,chip+'</div>\n<div class="my">')};
window.scBad=msg=>{
 const r=document.querySelector('.sc2');if(!r||r.classList.contains('busy'))return;
 r.classList.add('busy');
 const f=document.getElementById('sc2fr'),t=document.getElementById('sc2t'),hint=document.getElementById('sc2hint'),tk=f&&f.querySelector('.tk b');
 const o=t.textContent,oh=tk?tk.innerHTML:'';
 const none=msg==='photo';
 if(tk)tk.innerHTML=svg('<path d="M12 7v6M12 17h.01"/>',40);
 f.classList.add('bad');
 t.textContent=none?T3('No code in this photo','Nta kode iri kuri iyi foto','Aucun code sur cette photo'):T3('Can’t read this code','Kode ntisomwa','Code illisible');
 hint.textContent=none?T3('Pick a photo where the whole code is visible.','Hitamo ifoto igaragaza kode yose.','Choisissez une photo où tout le code est visible.'):T3('This is not an itunda or shop code. Try again, or type the till number.','Iyi si kode ya itunda cyangwa y’umucuruzi. Ongera ugerageze, cyangwa wandike nimero.','Ce n’est pas un code itunda ou commerçant. Réessayez ou saisissez le numéro.');
 try{navigator.vibrate&&!matchMedia('(prefers-reduced-motion:reduce)').matches&&navigator.vibrate([30,60,30])}catch(e){}
 setTimeout(()=>{if(document.querySelector('.sc2')!==r)return;f.classList.remove('bad');if(tk)tk.innerHTML=oh;t.textContent=o;r.classList.remove('busy')},2000)};
window.scPhotos=()=>{
 const r=document.querySelector('.sc2');if(!r||r.classList.contains('busy'))return;
 const row=(e,tt,s,fn)=>'<button class="row" style="width:100%;text-align:left;background:none;border:0;min-height:64px;padding:8px 0" onclick="'+fn+'"><div class="ico" style="width:44px;height:44px">'+e+'</div><div style="flex:1;min-width:0"><div class="t">'+tt+'</div><div class="s">'+s+'</div></div></button>';
 const ttl=T3('Choose a photo','Hitamo ifoto','Choisir une photo');
 document.getElementById('layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" role="dialog" aria-modal="true" aria-label="'+ttl+'"><div class="h1" style="font-size:22px;line-height:30px;margin-top:4px">'+ttl+'</div><div style="margin:12px 0 8px">'
 +row('🥐',T3('Bakery counter','Aho bakorera imigati','Comptoir de la boulangerie'),T3('Has a code','Ifite kode','Avec un code'),"closeSheet();scHit(()=>ppMerch('123456'))")
 +row('🌆',T3('Street view','Ifoto y’umuhanda','Vue de la rue'),T3('No code','Nta kode','Sans code'),"closeSheet();scBad('photo')")
 +'</div><div class="fine">'+T3('Sample photos for this prototype.','Amafoto y’icyitegererezo.','Photos d’exemple pour ce prototype.')+'</div></div>';
 if(typeof focusSheet==='function')focusSheet()};
})();

/* v342: Pay from is a drop-down. Before: on the Pay tab the two accounts were two full-width rows, and on the amount screen after a scan or till number they were two chips. Now both are one row (or one button) showing the account that will pay, with a small arrow; tapping it opens a "Pay from" sheet like the Top up screen, listing itunda Pay (120,500 RWF) and itunda Bank (837,300 RWF) with a tick on the current one. On the Pay tab the row also says "Available" and the balance; on the amount screen the balance stays in the line under the amount. Choosing an account works as before (same toast, same balance checks). No other screens changed. rw and fr copy is new and needs native review. */
(function(){
const T3=(a,b,c)=>({rw:b,fr:c}[S.lang]||a);
const svg=(d,z)=>`<svg width="${z||24}" height="${z||24}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;
const CH='<span style="color:var(--tt);display:flex;flex:none">'+svg('<path d="M6 9l6 6 6-6"/>',18)+'</span>';
const CK='<span style="color:var(--lk);display:flex;width:24px">'+svg('<path d="M5 12.5l4.5 4.5L19 7.5"/>',24)+'</span>';
const OPT=()=>[['pay','itunda Pay',S.pay],['bank','itunda Bank',S.bank]];
const cur=()=>OPT().find(o=>o[0]===S.psrc)||OPT()[0];
const ico=(k,z)=>`<span style="width:${z}px;height:${z}px;border-radius:${z/2}px;background:var(--tint);color:var(--tintfg);display:flex;align-items:center;justify-content:center;font-weight:800;font-size:${Math.round(z*.42)}px;flex:none">${k==='bank'?'B':'P'}</span>`;
const rowTab=()=>{const [k,n,b]=cur();return `<div class="tap" role="button" tabindex="0" aria-haspopup="dialog" onclick="ppFromPick('ppSrc')" style="display:flex;align-items:center;gap:14px;min-height:64px;margin-top:6px;cursor:pointer">${ico(k,44)}<div style="flex:1;min-width:0"><div style="font-size:18px;font-weight:800;display:flex;align-items:center;gap:4px"><span>${n}</span>${CH}</div><div class="sm mu" style="margin-top:2px">${T3('Available ','Ushobora gukoresha ','Disponible ')}${fmt(b)} RWF</div></div></div>`};
const btnAmt=()=>{const n=cur()[1];return `<div style="display:flex;justify-content:center;margin-top:12px"><button class="chip" aria-haspopup="dialog" onclick="ppFromPick('ppSrc2')" style="height:44px;padding:0 16px;gap:6px;display:inline-flex;align-items:center;font-size:15px;font-weight:800"><span class="mu" style="font-weight:600">${T3('Pay from','Ishyura uvuye kuri','Payer depuis')}</span><span>${n}</span>${CH}</button></div>`};
const wrap=(name,re,mk)=>{const _s=screens[name];screens[name]=function(){const h=_s.apply(this,arguments);return typeof h==='string'?h.replace(re,mk):h}};
wrap('pay',/<div class="req"[^>]*>(?:\s*<button[^>]*onclick="ppSrc\('[\w-]+'\)"[\s\S]*?<\/button>\s*)+<\/div>/,rowTab);
wrap('payamt',/<div class="req"[^>]*>(?:\s*<button[^>]*onclick="ppSrc2\('[\w-]+'\)"[\s\S]*?<\/button>\s*)+<\/div>/,btnAmt);
window.ppFromPick=fn=>{const ttl=T3('Pay from','Ishyura uvuye kuri','Payer depuis');
 document.getElementById('layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" role="dialog" aria-modal="true" aria-label="'+ttl+'"><div class="h1" style="font-size:22px;line-height:30px;margin-bottom:8px">'+ttl+'</div>'
 +OPT().map(([k,n,b])=>'<div class="tap" role="button" tabindex="0" onclick="closeSheet();'+fn+'(\''+k+'\')" style="display:flex;align-items:center;gap:14px;padding:10px 0;cursor:pointer;min-height:56px">'+ico(k,44)+'<div style="flex:1;min-width:0"><div style="font-size:17px;font-weight:700">'+n+'</div><div class="sm mu">'+fmt(b)+' RWF</div></div>'+(S.psrc===k?CK:'<span style="width:24px"></span>')+'</div>').join('')+'</div>';
 if(typeof focusSheet==='function')focusSheet()};
})();

/* v345: Toss-style send flow, amount screen shows From / Balance, done screen has Add a note and a free-forever line */
{
const E=s=>String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const T=(en,rw,fr)=>({rw,fr})[S.lang]||en;
const _a=screens.amount;
screens.amount=function(){const h=_a.apply(this,arguments),k='<div id="msg"';
 const ctx=`<div style="margin:0 24px 6px;padding:12px 16px;border-radius:16px;background:var(--chip);display:flex;justify-content:space-between;align-items:center;font-size:14px;text-align:left"><span><span class="mu">${T('From','Biva kuri','Depuis')}</span> <b>itunda Bank</b></span><span class="mu">${T('Balance','Asigaye','Solde')} <b style="color:var(--tx)">${fmt(S.bank)} RWF</b></span></div>`;
 return h.includes(k)&&!h.includes('data-v345')?h.replace(k,ctx.replace('<div ','<div data-v345 ')+k):h};
window.noteSheet=function(){$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" role="dialog" aria-modal="true" aria-label="${T('Add a note','Ongeraho inyandiko','Ajouter une note')}"><div class="h1" style="font-size:22px;line-height:30px;margin-bottom:12px">${T('Add a note','Ongeraho inyandiko','Ajouter une note')}</div><input id="nt45" maxlength="40" value="${E(S.note45||'')}" placeholder="${T('e.g. Rent for October','Urugero: Ubukode bw’Ukwakira','ex. Loyer d’octobre')}" style="width:100%;height:52px;border:0;border-radius:14px;background:var(--chip);padding:0 16px;font:inherit;font-size:16px;color:var(--tx);outline:0;box-sizing:border-box" onkeydown="if(event.key==='Enter')noteSave()"><button class="btn" style="margin-top:16px" onclick="noteSave()">${T('Save','Bika','Enregistrer')}</button></div>`;setTimeout(()=>{const i=document.getElementById('nt45');if(i)i.focus()},60)};
window.noteSave=function(){const i=document.getElementById('nt45');S.note45=i?i.value.trim():'';closeSheet();render('fade-none')};
const _s=screens.sent;
screens.sent=function(){const h=_s.apply(this,arguments),k='<div class="cta" style="border:0">';
 const chip=`<div style="display:flex;justify-content:center;margin-top:20px"><button class="chip tap" onclick="noteSheet()" style="height:40px;padding:0 18px;font-size:15px">${S.note45?E(S.note45):T('Add a note','Ongeraho inyandiko','Ajouter une note')}</button></div><div class="fine" style="text-align:center;margin-top:14px">${T('Sending is always free','Kohereza ni ubuntu buri gihe','L’envoi est toujours gratuit')}</div>`;
 return h.includes(k)?h.replace(k,chip+k):h};
const _f=window.flow;window.flow=function(){S.note45='';return _f.apply(this,arguments)};
}

/* v346: Eats menu shows how much more is needed to reach the minimum order, with a progress bar */
{
const T=(en,rw,fr)=>({rw,fr})[S.lang]||en;
const _e=screens.erest;
screens.erest=function(){const h=_e.apply(this,arguments);
 const r=REST[S.er],sub=eSub();
 if(!r||!sub||sub>=r.min||h.includes('data-v346'))return h;
 const left=r.min-sub,pct=Math.max(6,Math.round(sub/r.min*100));
 const msg=T('Add '+fmt(left)+' RWF more to order','Ongeraho RWF '+fmt(left)+' kugira ngo utumize','Ajoutez '+fmt(left)+' RWF pour commander');
 const hint=`<div data-v346 role="status" style="padding:10px 24px 0"><div style="font-size:13px;font-weight:700;margin-bottom:6px">${msg}</div><div style="height:6px;border-radius:3px;background:var(--chip);overflow:hidden"><div style="width:${pct}%;height:100%;background:var(--br);border-radius:3px"></div></div><div class="fine" style="margin-top:6px">${T('Minimum order','Ntarengwa','Commande minimum')} ${fmt(r.min)} RWF</div></div>`;
 let i=h.indexOf('Pay with');if(i>0)i=h.lastIndexOf('<div',i);if(i<0)i=h.lastIndexOf('<div class="cta"');
 return i>0?h.slice(0,i)+h.slice(i).replace(/(<div class="cta"[^>]*>)/,'$1'+hint):h};
}

/* v347: Pay tab, tighter section spacing so Pay from and Ways to pay show on the first screen */
{
const _p=screens.pay;
screens.pay=function(){const h=_p.apply(this,arguments);
 if(typeof h!=='string'||h.includes('pay347'))return h;
 return '<style>.pay347 .v174h{padding-top:14px!important;margin-bottom:0!important}.pay347 .v174{padding-top:2px!important}.pay347 .v174h+.sec,.pay347 .v174h+.pad,.pay347 .v174h+.chips{padding-top:2px!important}</style><div class="pay347" style="display:contents">'+h+'</div>'};
}

/* v348: Shop tab, tighter section spacing so products start sooner */
{
const _s=screens.shop;
screens.shop=function(){const h=_s.apply(this,arguments);
 if(typeof h!=='string'||S.shopTab==='eats'||h.includes('shop348'))return h;
 return '<style>.shop348 .sec{padding-top:14px!important}.shop348 .sec .sech{margin-bottom:8px!important}.shop348 .pgrid{padding-top:10px!important}</style><div class="shop348" style="display:contents">'+h+'</div>'};
}

/* v349: Marketplace, compact Sell button so it covers less of the listings */
{
const T=(en,rw,fr)=>({rw,fr})[S.lang]||en;
const _h=screens.hood;
screens.hood=function(){const h=_h.apply(this,arguments);
 if(typeof h!=='string'||S.hd!=='market'||h.includes('mk349'))return h;
 return '<style>#phone:has(.mk349) .fab .btn{height:46px;padding:0 20px;font-size:15px;border-radius:23px;width:auto}</style><div class="mk349" style="display:contents">'+h.replace(/(<button class="btn" onclick="hdPost\(\)"[^>]*>)[^<]*(<\/button>)/,'$1+ '+T('Sell','Gurisha','Vendre')+'$2')+'</div>'};
}

/* v350: Property list, removes the filters heading and compacts the safety tip so listings start higher */
{
const T=(en,rw,fr)=>({rw,fr})[S.lang]||en;
const _h=screens.hood;
screens.hood=function(){let h=_h.apply(this,arguments);
 if(typeof h!=='string'||S.hd!=='property')return h;
 h=h.replace('<div class="v174h">Search and filters</div>','');
 return h.replace(/<div style="margin:12px 24px 0;padding:14px 16px;border-radius:20px;background:var\(--tint\)"><b style="color:var\(--tintfg\)">Stay safe<\/b>[\s\S]*?<button class="cch" style="height:40px;margin-top:8px" onclick="([^"]*)">([^<]*)<\/button><\/div>/,
  (m,oc,lb)=>`<div role="note" style="margin:10px 24px 0;padding:10px 12px 10px 16px;border-radius:16px;background:var(--tint);display:flex;align-items:center;gap:10px"><div class="sm" style="flex:1;line-height:18px"><b style="color:var(--tintfg)">${T('Stay safe','Witonde','Restez prudent')}:</b> ${T('see the home and read the contract before paying a deposit.','reba inzu usome amasezerano mbere yo gutanga ingwate.','visitez et lisez le contrat avant de verser une caution.')}</div><button class="cch" style="height:36px;flex:none" onclick="${oc}">${lb}</button></div>`)};
}

/* v351: Jobs list rows show the job type (Part-time, Gig, Full-time) */
{
const T=(en,rw,fr)=>({rw,fr})[S.lang]||en;
const TY={'Part-time':['Part-time','Igihe gito','Temps partiel'],'Gig':['Gig','Akazi k’igihe gito','Mission'],'Full-time':['Full-time','Igihe cyose','Temps plein']};
const tag=()=>{if(S.hd!=='jobs')return;document.querySelectorAll('.hdc[onclick^="hdOpen(\'jobs\'"]').forEach(r=>{if(r.dataset.v351)return;r.dataset.v351=1;const m=/hdOpen\('jobs',(\d+)\)/.exec(r.getAttribute('onclick')),it=m&&HD.jobs.items.find(x=>x.id==m[1]),s=r.querySelector('.s');if(!it||!s||!TY[it.c])return;const t=TY[it.c],c=document.createElement('span');c.textContent=T(...t);c.style.cssText='display:inline-block;margin-top:6px;padding:2px 8px;border-radius:10px;background:var(--tint);color:var(--tintfg);font-size:12px;font-weight:700';s.insertAdjacentElement('afterend',c)})};
new MutationObserver(tag).observe(document.getElementById('phone'),{childList:true,subtree:true});
}

/* v352: Community event cards, I'm going and Remind me side by side under the details */
{
const fix=()=>{document.querySelectorAll('button[onclick*="cmGo("]').forEach(g=>{const card=g.parentElement&&g.parentElement.parentElement;if(!card||card.dataset.v352)return;const r=card.querySelector('button[onclick*="cmRemind("]');if(!r)return;card.dataset.v352=1;const row=document.createElement('div');row.style.cssText='display:flex;gap:8px;margin-top:10px';[g,r].forEach(b=>{b.style.marginTop='0';b.style.flex='1';b.style.justifyContent='center';b.style.whiteSpace='nowrap';b.style.padding='0 10px';row.appendChild(b)});card.appendChild(row)})};
new MutationObserver(fix).observe(document.getElementById('phone'),{childList:true,subtree:true});
}

/* v353: Maps place sheet, the Directions button shows the walking time (about 5 km/h) */
{
const fix=()=>{document.querySelectorAll('#phone button').forEach(b=>{if(b.dataset.v353||!/^Directions$/.test(b.textContent.trim()))return;const sh=b.parentElement&&b.parentElement.parentElement;const m=sh&&/([\d.]+)\s*(km|m)\b(?![\s\S]*\d\s*(km|m)\b)/.exec(sh.innerText.replace(/\u00a0/g,' ').split('Directions')[0].split('\n').filter(l=>/arriving|·.*(km|m)\b|\d\s*(km|m)$/.test(l)).join(' '));if(!m)return;const km=m[2]==='km'?parseFloat(m[1]):parseFloat(m[1])/1000,min=Math.max(1,Math.round(km*12));b.dataset.v353=1;b.textContent='Directions · 🚶 '+min+' min'})};
new MutationObserver(fix).observe(document.getElementById('phone'),{childList:true,subtree:true});
}

/* v354: Explore, a sticky row of section chips jumps to Everyday, Neighbourhood, Money tools and the other groups */
{
const SH={'Your neighbourhood':'Nearby','Places & trips':'Places','Accounts & cards':'Accounts','Money tools':'Money tools'};
const fix=()=>{const ab=document.getElementById('abody');if(!ab||ab.dataset.v354)return;const gs=[...ab.querySelectorAll(':scope > .xg')];if(gs.length<3)return;ab.dataset.v354=1;
 const row=document.createElement('div');row.setAttribute('role','navigation');row.setAttribute('aria-label','Sections');row.style.cssText='position:sticky;top:0;z-index:4;display:flex;gap:8px;overflow-x:auto;padding:10px 24px;background:var(--bg);scrollbar-width:none';
 gs.forEach(g=>{const h=g.querySelector('.xgh');if(!h)return;const t=h.textContent.trim();g.style.scrollMarginTop='64px';const b=document.createElement('button');b.className='chip tap';b.textContent=SH[t]||t;b.style.cssText='flex:none;height:36px;padding:0 14px;font-size:14px;font-weight:700;white-space:nowrap';b.onclick=()=>g.scrollIntoView({block:'start',behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth'});row.appendChild(b)});
 ab.insertBefore(row,ab.firstChild)};
new MutationObserver(fix).observe(document.getElementById('phone'),{childList:true,subtree:true});
}

/* v355: the transfer confirmation is a full page instead of a bottom sheet */
{
const T=(en,rw,fr)=>({rw,fr})[S.lang]||en;
screens.confirm355=function(){const v=Number(S.amt)||0,n=nm9(S.to),rowH=(a,b)=>`<div style="display:flex;justify-content:space-between;align-items:center;min-height:52px;font-size:15px"><span class="mu">${a}</span><b>${b}</b></div>`;
 const warn=S.flagged?`<div style="display:flex;gap:10px;align-items:center;margin:20px 24px 0;color:var(--er);font-size:14px;font-weight:700;line-height:19px">${gl('warning3d',30)}<span>${s9('wn')}</span></div>`:'';
 return `${bar(T('Check and send','Genzura wohereze','Vérifier et envoyer'))}<div class="pad" style="padding-top:28px"><div class="h1">${T('Send '+fmt(v)+' RWF to '+E355(n)+'?','Ohereza RWF '+fmt(v)+' kuri '+E355(n)+'?','Envoyer '+fmt(v)+' RWF à '+E355(n)+' ?')}</div></div>${warn}<div style="margin:32px 24px 0;padding:4px 20px;border-radius:20px;background:var(--chip)">${rowH(s9('rc'),E355(n))}${rowH(T('From','Biva kuri','Depuis'),'itunda Bank')}${rowH(s9('am'),fmt(v)+' RWF')}${rowH(s9('fee'),'0 RWF')}${rowH(T('Balance after','Asigaye nyuma','Solde après'),fmt(Math.max(0,S.bank-v))+' RWF')}</div><div class="fine" style="text-align:center;margin-top:16px">${T('Sending is always free','Kohereza ni ubuntu buri gihe','L’envoi est toujours gratuit')}</div><div class="cta"><button class="btn" onclick="finish()">${S.flagged?s9('sa'):T('Send','Ohereza','Envoyer')}</button></div>`};
const E355=s=>String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
window.confirm_=function(){S.stack.push('confirm355');render('push')};
}
/* v356: payment confirmations (itunda Pay, Shop, Eats, bills) are full pages instead of bottom sheets */
{
screens.sheet356=function(){const P=S.sp356;if(!P)return bar('');
 const d=document.createElement('div');d.innerHTML=P.html;
 d.querySelectorAll('button.sec2').forEach(b=>{if(/closeSheet\(\)/.test(b.getAttribute('onclick')||''))b.remove()});
 const pb=[...d.querySelectorAll('button.btn')].find(b=>!b.classList.contains('sec2'));
 d.querySelectorAll('button[onclick]').forEach(x=>{const o=x.getAttribute('onclick');if(o==='closeSheet()')x.setAttribute('onclick','back()');else if(/^closeSheet\(\);/.test(o))x.setAttribute('onclick','back();'+o.slice(13))});
 let cta='';if(pb){const all=[...d.querySelectorAll('button.btn')];cta='<div class="cta">'+all.map((x,i)=>{if(i)x.style.marginTop='10px';return x.outerHTML}).join('')+'</div>';all.forEach(x=>x.remove())}
 const h=d.querySelector('.h1');if(h)h.removeAttribute('style');
 d.querySelectorAll('[style*="justify-content:center"]').forEach(e=>{if(e.classList.contains('req'))e.style.justifyContent='flex-start'});
 return `${bar('')}<div class="pad" style="padding-top:20px">${d.innerHTML}</div>${cta}`};
const wrap=name=>{const o=window[name];if(typeof o!=='function'||o.w356)return;
 const w=function(){const ly=document.getElementById('layer');const r=o.apply(this,arguments);
  const sh=ly&&ly.querySelector('.sheet');if(!sh)return r;
  S.sp356={html:sh.innerHTML};ly.innerHTML='';
  if(S.stack[S.stack.length-1]==='sheet356')render('fade-none');else{S.stack.push('sheet356');render('push')}
  return r};
 w.w356=1;window[name]=w};
['ppConfirm','shopPay','ePay','billPay'].forEach(wrap);
}
/* v357: more confirmation sheets become full pages (loan, 12-month deposit, buy stock, request money, split bill, gift, add money, SACCO shares) */
{
const w356=window.sheet356wrap||null;
const wrapSheet=name=>{const o=window[name];if(typeof o!=='function'||o.w356)return;
 const w=function(){const ly=document.getElementById('layer');const r=o.apply(this,arguments);
  const sh=ly&&ly.querySelector('.sheet');if(!sh)return r;
  S.sp356={html:sh.innerHTML};ly.innerHTML='';
  if(S.stack[S.stack.length-1]==='sheet356')render('fade-none');else{S.stack.push('sheet356');render('push')}
  return r};
 w.w356=1;window[name]=w};
['loanAsk','depAsk','drawStk','drawReq','drawSplit','drawGift','drawAdd','sheetAdd','buySh'].forEach(wrapSheet);
const popAfter=(name,cond)=>{const o=window[name];if(typeof o!=='function')return;
 window[name]=function(){const r=o.apply(this,arguments);if((!cond||cond.apply(this,arguments))&&S.stack[S.stack.length-1]==='sheet356'){S.stack.pop();render('fade-none')}return r}};
['loanDo','depDo','stkBuy','addMoney','splitMake','giftSend','reqCopy'].forEach(n=>popAfter(n));
popAfter('buySh',(n,ok)=>!!ok);
}
/* v358: Maps. The place sheet shows walking time when the distance leads the line (v353 missed that layout); the route option chips sit above the map instead of over the start marker */
{
const st=document.createElement('style');st.textContent='#sc .mcs:has(>button[onclick*=opt]){position:static!important;margin:0!important;padding:8px 12px 10px!important;height:auto!important;background:var(--bg);order:-1}#sc div:has(>.mcs>button[onclick*=opt]){display:flex;flex-direction:column}#sc div:has(>.mcs>button[onclick*=opt])>svg{flex-shrink:0}#sc .mcs:has(>button[onclick*=opt]) .ocp:not(.on){background:var(--chip)!important;color:var(--tx)}';document.head.appendChild(st);
const fix=()=>{document.querySelectorAll('#phone button').forEach(b=>{if(b.dataset.v353||b.dataset.v358||b.textContent.trim()!=='Directions')return;
 const sh=b.parentElement&&b.parentElement.parentElement;if(!sh)return;
 const ln=sh.innerText.replace(/\u00a0/g,' ').split('Directions')[0].split('\n').find(l=>/^\s*[\d.]+\s*(km|m)\b/.test(l));if(!ln)return;
 const m=/^\s*([\d.]+)\s*(km|m)\b/.exec(ln),km=m[2]==='km'?parseFloat(m[1]):parseFloat(m[1])/1000,min=Math.max(1,Math.round(km*12));
 b.dataset.v358=1;const wt=min>=60?Math.floor(min/60)+' h '+(min%60)+' min':min+' min';b.innerHTML='Directions<span style="display:block;font-size:12px;font-weight:600;opacity:.85;line-height:15px">🚶 '+wt+'</span>'})};
new MutationObserver(fix).observe(document.getElementById('phone'),{childList:true,subtree:true});fix();
}

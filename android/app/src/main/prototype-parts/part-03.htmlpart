  const payH=pay?`<div class="pz-row${c}"><button class="btn${eb?' sec2':''}" onclick="plPay()">${L('Pay here','Ishyura hano','Payer ici')}</button>${rsv?`<button class="btn sec2" onclick="plRsv()">${L('Reserve','Bika','Réserver')}</button>`:''}</div>`:'';
  const actsH=`<div class="pz-acts${c}">${bDir?`<button class="main" onclick="${oc(bDir)}">${L('Directions','Inzira','Itinéraire')}<span class="s">${wt}</span></button>`:''}${bCall?`<button onclick="${oc(bCall)}">${L('Call','Hamagara','Appeler')}</button>`:''}${bShare?`<button onclick="${oc(bShare)}">${L('Share','Sangiza','Partager')}</button>`:''}</div>${(!exp||M.tab==='home')?ebH+payH:''}`;
  if(wrap)wrap.remove();if(eb)eb.remove();

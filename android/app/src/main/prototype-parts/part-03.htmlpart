/* v362: more money confirmations become full pages (airtime, pocket move, itunda Pay, bank transfer, auto top-up, SACCO shares, Eats order, loan repay-all, currency exchange) */
{
const ASK=['airPay','mvAsk','puAsk','bkxAsk','atuReview','shReview','payOrder','loanAll','fxAsk'];
const DUAL={airPay:/airPay\(1\)/,loanAll:/loanAll\(1\)/};
const DO=['mvDo','puDo','bkxDo','atuOffGo','atuSave','orderDone','fxDo'];
const top=()=>S.stack[S.stack.length-1];
const wrapAsk=name=>{const o=window[name];if(typeof o!=='function'||o.w362)return;
 const w=function(){const ly=document.getElementById('layer');const r=o.apply(this,arguments);
  const sh=ly&&ly.querySelector('.sheet');
  if(!sh||(DUAL[name]&&!DUAL[name].test(sh.innerHTML)))return r;
  S.sp356={html:sh.innerHTML};ly.innerHTML='';
  if(top()==='sheet356')render('fade-none');else{S.stack.push('sheet356');render('push')}
  return r};
 w.w362=1;w.w356=1;window[name]=w};
/* the Do functions expect the stack as it was when a sheet sat on top, so the confirmation page leaves it first */
const wrapDo=name=>{const o=window[name];if(typeof o!=='function'||o.w362)return;
 const w=function(){S.stack=S.stack.filter(x=>x!=='sheet356');return o.apply(this,arguments)};
 w.w362=1;window[name]=w};
ASK.forEach(wrapAsk);DO.forEach(wrapDo);
}

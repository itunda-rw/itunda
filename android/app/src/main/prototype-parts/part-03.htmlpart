const CT=['All','Today','Food','Shop','Delivery','Cleaning','Tutoring','Events','Office','Saved','Applied','Shifts','Mine'],STS=['Applied','Viewed','Interview invite'],SP=['Saved','Applied','Shifts','Mine'];
if(S.mxHood===undefined){S.mxHood='Kimironko';S.mxRad=1}
if(S.jnSort===undefined){S.jnSort=0;S.jnQ=''}
if(!H.jn){H.jn=1;
const E={1:['Shop',2,'Mon–Fri · 07:00–13:00'],2:['Delivery',5,'Flexible · you pick the hours'],3:['Tutoring',26,'Saturdays · 09:00–11:00'],4:['Events',50,'One day · 07:00–16:00'],5:['Shop',9,'Mon–Sat · 13:00–19:00'],6:['Office',72,'Mon–Fri · 08:00–17:00'],7:['Office',120,'Mon–Sat · 08:00–16:00']};
H.items.forEach(x=>{const e=E[x.id];if(e){x.k=e[0];x.ago=e[1];x.sh=e[2]}if(x.id===4)x.loc='Kimihurura'});
H.items.push(
{id:8,ti:'Barista helper',g:'bag',c:'Part-time',who:'Kimironko Brew House',n:5000,u:'day',loc:'Kimironko',k:'Food',ago:1,sh:'Mon–Fri · 07:00–13:00',start:'asap',d:'Prepare drinks, wash cups and keep the counter clean. Training on the job.',req:['Friendly and punctual','Can start this week']},
{id:9,ti:'House cleaner',g:'house',c:'Gig',who:'Gisozi Homes',n:4000,u:'day',loc:'Gisozi',k:'Cleaning',ago:6,sh:'Tue and Fri · 08:00–12:00',d:'Clean a family home twice a week. Cleaning supplies are provided.',req:['Honest and careful','Lives in or near Gisozi']},
{id:10,ti:'Pharmacy delivery rider',g:'moto',c:'Gig',who:'Kicukiro Pharmacy',n:600,u:'task',loc:'Kicukiro',k:'Delivery',ago:3,sh:'Flexible · you pick the hours',d:'Deliver medicines to homes in Kicukiro. Paid per delivery, every week.',req:['Own moto','Valid licence']},
{id:11,ti:'Restaurant waiter',g:'bag',c:'Part-time',who:'Kacyiru Kitchen',n:4500,u:'day',loc:'Kacyiru',k:'Food',ago:20,sh:'Wed–Sun · 16:00–22:00',d:'Welcome guests, take orders and serve tables. Tips are yours to keep.',req:['Good with customers','Can work evenings']},
{id:12,ti:'Kitchen helper',g:'bag',c:'Part-time',who:'Remera Pizza',n:3500,u:'day',loc:'Remera',k:'Food',ago:30,sh:'Mon–Sat · 10:00–16:00',d:'Chop vegetables, wash dishes and help the cook. A hot meal is included.',req:['Hard-working','Clean and tidy']});}
const hs=n=>{let h=0;String(n).split('').forEach(c=>h=(h*31+c.charCodeAt(0))>>>0);return h};
const kind=x=>x.k||(/cook|waiter|kitchen|caf|barista|restaurant|chef/i.test(x.ti)?'Food':/shop|cashier|sales|seller/i.test(x.ti)?'Shop':/deliver|rider|moto|driver/i.test(x.ti)?'Delivery':/clean|laundry|garden/i.test(x.ti)?'Cleaning':/tutor|teach/i.test(x.ti)?'Tutoring':/event|usher/i.test(x.ti)?'Events':'Other');
const area=x=>{const l=String(x.loc||'');for(const k in AR)if(l.includes(k))return k;return x.who==='You'?S.mxHood:(l||'Kigali')};
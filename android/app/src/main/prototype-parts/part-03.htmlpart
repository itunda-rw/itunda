/* v365: a short chip row that does not fit a narrow phone wraps instead of being cut off (Cash out "Send to" at 360 px) */
{
const fix=()=>{document.querySelectorAll('#phone .chp').forEach(r=>{if(r.dataset.v365)return;const n=r.querySelectorAll(':scope > button').length;if(n<2||n>3||r.scrollWidth<=r.clientWidth+1)return;r.dataset.v365=1;r.style.flexWrap='wrap';r.style.overflowX='visible'})};
new MutationObserver(fix).observe(document.getElementById('phone'),{childList:true,subtree:true});
window.addEventListener('resize',()=>{document.querySelectorAll('#phone .chp[data-v365]').forEach(r=>{delete r.dataset.v365;r.style.flexWrap='';r.style.overflowX=''});fix()});fix();
}
/* v366: Cash out in Kinyarwanda and French (the page, the review and the done message were English only) */
{
const N='([\\d,]+)';
const D=[
[/Cash out (\d[\d,]*) RWF\?/g,'Kuramo $1 RWF?','Retirer $1 RWF ?'],
[/Cash out (\d[\d,]*) RWF/g,'Kuramo $1 RWF','Retirer $1 RWF'],
[/Cash out requested/g,'Gukuramo byasabwe','Retrait demandé'],
[/Move your pay money to mobile money\./g,'Hindura amafaranga ya itunda Pay muri mobile money.','Transférez l’argent de votre itunda Pay vers votre mobile money.'],
[/This is more than your itunda Pay balance of ([\d,]+) RWF\. Pick a smaller amount\./g,'Ibi birenze asigaye kuri itunda Pay ($1 RWF). Hitamo make.','Ce montant dépasse votre solde itunda Pay de $1 RWF. Choisissez un montant plus petit.'],
[/itunda Pay balance now ([\d,]+) RWF/g,'Asigaye kuri itunda Pay ubu: $1 RWF','Solde itunda Pay maintenant : $1 RWF'],
[/itunda Pay balance:/g,'Asigaye kuri itunda Pay:','Solde itunda Pay :'],
[/left after:/g,'asigaye nyuma:','reste après :'],
[/Limit: ([\d,]+) RWF for each cash out\./g,'Ntarengwa: $1 RWF kuri buri gukuramo.','Limite : $1 RWF par retrait.'],
[/([\d,]+ RWF) is on its way to ([^<]*?)\. It should arrive within a minute\./g,'$1 iri mu nzira igana kuri $2. Igomba kugerayo mu munota umwe.','$1 est en route vers $2. Il devrait arriver dans la minute.'],
[/Pay balance after/g,'Asigaye nyuma','Solde Pay après'],
[/Paid from/g,'Biva kuri','Payé depuis'],
[/Within a minute/g,'Mu munota umwe','Dans la minute'],
[/>Send to</g,'>Ohereza kuri<','>Envoyer vers<'],
[/>Amount</g,'>Amafaranga<','>Montant<'],
[/>Arrives</g,'>Agera<','>Arrive<'],
[/>Fee</g,'>Kiguzi<','>Frais<'],
[/>Free</g,'>Ubuntu<','>Gratuit<'],
[/>Cancel</g,'>Hagarika<','>Annuler<'],
[/>OK</g,'>Sawa<','>OK<'],
[/>Cash out</g,'>Kuramo amafaranga<','>Retirer<']
];
const tr=h=>{const i=S.lang==='rw'?1:2;D.forEach(d=>{h=h.replace(d[0],d[i])});return h};
const asEn=f=>{const l=S.lang;S.lang='en';try{return f()}finally{S.lang=l}};
const on=()=>(S.lang==='rw'||S.lang==='fr')&&S.svk==='cashout';
const os=screens.svc;
screens.svc=function(){if(!on())return os.apply(this,arguments);return tr(asEn(()=>os.apply(this,arguments)))};
const og=window.svcGo;
window.svcGo=function(){if(!on())return og.apply(this,arguments);
 const a=arguments,r=asEn(()=>og.apply(this,a));
 if(S.sp356&&S.stack.includes('sheet356')){S.sp356.html=tr(S.sp356.html);render('fade-none')}
 else if(!S.stack.includes('sheet356')){render('fade-none')}
 const ly=document.getElementById('layer'),sh=ly&&ly.querySelector('.sheet');if(sh)sh.innerHTML=tr(sh.innerHTML);
 return r};
}
/* v370: more Kinyarwanda and French (checkout, legal, passkey, links, friends, account descriptions, Bank figures), after v369: security settings, credit score, daily challenge, signed-in devices, coupons, cashback, SACCO, 12-month deposit, Eats and Marketplace items, plus Shop, Bank, Home and Pay rows that were still English in Kinyarwanda and French (savings and loan descriptions, "Received · Yesterday" activity lines) */
{
const W={
'Interest accrued through yesterday':['Inyungu yabaruwe kugeza ejo hashize','Intérêts accumulés jusqu’à hier'],
'Start your first savings goal':['Tangira intego yawe ya mbere yo kuzigama','Commencez votre premier objectif d’épargne'],

<script>
/* v487: Send money in a chat is a slide-to-pay sheet, same floating style as Shop checkout. You stay in the conversation: pick an amount (stepper or 1,000 / 5,000 / 10,000 / 20,000), see who gets it and where it comes from (itunda Pay), then slide. The amount leaves itunda Pay and appears as a money message in the chat. Not enough balance disables the slider. "Send to someone else" still opens the full send flow. */
try{(()=>{
const L=(e,r,f)=>({en:e,rw:r,fr:f}[S.lang]||e);
const CH=()=>ic('chev',18,'var(--tt)');
const who=()=>{try{return THREADS.find(t=>t.id===S.chat).n}catch(e){return L('this chat','iki kiganiro','ce chat')}};
const Q=[1000,5000,10000,20000];
window.chatPay=function(a){
 if(typeof a==='number')S.cpA=Math.max(500,Math.min(2000000,a));else if(!S.cpA)S.cpA=5000;
 const amt=S.cpA,bad=amt>S.pay,nm=who();
 $('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet bs464" role="dialog" aria-modal="true" aria-label="${L('Send money','Ohereza amafaranga','Envoyer de l’argent')}"><div class="bsh"></div>
 <div class="bsp"><div><b class="pr">${fmt(amt)} RWF</b></div><div class="bsq"><button aria-label="Less" onclick="chatPay(S.cpA-1000)">−</button><b style="min-width:0"></b><button aria-label="More" onclick="chatPay(S.cpA+1000)">+</button></div></div>
 <div class="bsn">${L('To ','Kuri ','À ')}${nm} · ${L('Free to send','Kohereza ni ubuntu','Envoi gratuit')}</div>
 <div class="req" style="margin:0 0 14px">${Q.map(q=>`<button class="${amt===q?'on':''}" onclick="chatPay(${q})">${fmt(q)}</button>`).join('')}</div>
 <div class="bsc">
  <div class="bsr"><div class="tt"><b>${L('Send to','Kohereza kuri','Envoyer à')}</b><span class="m i">${nm}</span></div></div>
  <div class="bsr"><div class="tt"><b>itunda Pay</b><span class="m i">${fmt(S.pay)} RWF</span></div>${CH()}</div>
 </div>
 ${bad?`<div class="bsb er">${L('Not enough balance. Add money first.','Amafaranga ntahagije. Banza wongeremo.','Solde insuffisant. Ajoutez de l’argent.')}</div>`:`<div class="bsb">${L('Balance after: ','Asigaye: ','Solde après : ')}<em>${fmt(S.pay-amt)} RWF</em></div>`}
 <div id="sl8" style="position:relative;height:60px;border-radius:30px;background:${bad?'var(--chip)':'var(--br)'};overflow:hidden;touch-action:none;user-select:none"><div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:17px;color:${bad?'var(--tt)':'var(--on)'}">${L('Slide to pay','Kurura ushyure','Glisser pour payer')}</div><div id="kn8" style="position:absolute;left:6px;top:6px;width:48px;height:48px;border-radius:24px;background:#fff;display:flex;align-items:center;justify-content:center;color:#191F28">${ic('chev',22)}</div></div>
 <button class="tap" style="display:block;margin:14px auto 0;border:0;background:none;color:var(--mu);font:inherit;font-weight:700;font-size:14px" onclick="closeSheet();flow()">${L('Send to someone else','Ohereza undi muntu','Envoyer à quelqu’un d’autre')}</button></div>`;
 const tr=document.getElementById('sl8'),kn=document.getElementById('kn8');if(!tr||bad)return;
 let d=false,sx=0,mx=0;const pos=e=>(e.touches?e.touches[0].clientX:e.clientX);
 const mv=e=>{if(!d)return;mx=Math.max(0,Math.min(tr.clientWidth-60,pos(e)-sx));kn.style.left=(6+mx)+'px'};
 const up=()=>{if(!d)return;d=false;document.removeEventListener('mousemove',mv);document.removeEventListener('mouseup',up);document.removeEventListener('touchmove',mv);document.removeEventListener('touchend',up);if(mx>tr.clientWidth-80)chatPaid();else{kn.style.transition='left .2s';kn.style.left='6px';setTimeout(()=>kn.style.transition='',220)}};
 const dn=e=>{d=true;sx=pos(e);mx=0;document.addEventListener('mousemove',mv);document.addEventListener('mouseup',up);document.addEventListener('touchmove',mv,{passive:true});document.addEventListener('touchend',up)};
 kn.addEventListener('mousedown',dn);kn.addEventListener('touchstart',dn,{passive:true});
};
window.chatPaid=function(){const amt=S.cpA,nm=who();if(!(amt>0)||amt>S.pay)return;S.pay-=amt;
 const ms=S.msgs[S.chat]=S.msgs[S.chat]||[],x=['money',amt];x.ts=Date.now();ms.push(x);
 try{navigator.vibrate&&navigator.vibrate(12)}catch(e){}
 closeSheet();render('fade-none');toast(L('Sent ','Byoherejwe ','Envoyé ')+fmt(amt)+' RWF · '+nm);
 setTimeout(()=>{const c=document.querySelector('#phone .screen');if(c)c.scrollTop=c.scrollHeight},60)};
const _m=window.chatMenu;
window.chatMenu=function(){_m.apply(this,arguments);const l=document.getElementById('layer');if(l)l.innerHTML=l.innerHTML.replace('closeSheet();flow()','S.cpA=0;chatPay()')};
document.title=document.title.replace(/v\d+/,'v487');
})()}catch(e){console.error('chatpay-v487',e)}
</script>
<script>
/* v488: Link your family, rebuilt in our style (English, Kinyarwanda, French). Before: one long form with radio rows, labelled boxes, a hint line and a grey button. Now: "Your family" first when there are invites (avatar, name, what they can see, a quiet Cancel); two big choice cards (A child / A guardian) filled in lavender when chosen; one soft card holding Name and Phone as large bare fields (the number formats itself as you type, 078 123 4567); for a child, three equal weekly-limit pills; one lavender line saying what is shared, read-only; and a bottom button that names the person, or says what is missing instead of staying grey and silent. Review and Cancel-invite are floating sheets like Shop checkout. fr/rw strings need native review. */
try{(()=>{
const L=(e,r,f)=>({en:e,rw:r,fr:f}[S.lang]||e);
const E=x=>String(x==null?'':x).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const dg=v=>String(v||'').replace(/\D/g,'').slice(0,10);
const fp=v=>{v=dg(v);return v.length>6?v.slice(0,3)+' '+v.slice(3,6)+' '+v.slice(6):v.length>3?v.slice(0,3)+' '+v.slice(3):v};
const nmv=()=>String((S.fm||{}).n||'').trim();
const missing=()=>{const p=dg(S.fm.ph);
 if(nmv().length<2)return L('Add their name','Andika izina rye','Ajoutez son prénom');
 if(!p)return L('Add their phone number','Andika nimero ye','Ajoutez son numéro');
 if(!/^07/.test(p))return L('Phone numbers start with 07','Nimero itangirana na 07','Le numéro commence par 07');
 if(p.length<10){const n=10-p.length;return L(n+' more digit'+(n>1?'s':''),'Hasigaye imibare '+n,'Encore '+n+' chiffre'+(n>1?'s':''))}
 if((S.fam||[]).some(x=>dg(x.ph)===p))return L('Already invited','Yamaze gutumirwa','Déjà invité');return ''};
const lbl=()=>L('Send invite to ','Ohereza ubutumire kuri ','Inviter ')+nmv();
const st=document.createElement('style');
st.textContent='#phone .screen .fm9{padding:0 20px}#phone .screen .fm9 .tl{font-size:28px;font-weight:700;letter-spacing:-.6px;line-height:36px;margin-top:18px}#phone .screen .fm9 .sub{color:var(--mu);font-size:15px;line-height:22px;margin-top:8px}#phone .screen .fm9 .sc{font-size:14px;font-weight:600;color:var(--mu);margin:28px 4px 10px}#phone .screen .fm9 .two{display:grid;grid-template-columns:1fr 1fr;gap:10px}#phone .screen .fm9 .rc{border:0;border-radius:22px;background:var(--chip);padding:18px 16px;text-align:left;font:inherit;color:var(--tx);display:flex;flex-direction:column;gap:10px;min-height:156px}#phone .screen .fm9 .rc.on{background:var(--tint);color:var(--tintfg)}#phone .screen .fm9 .rc b{font-size:17px;font-weight:700}#phone .screen .fm9 .rc .d{font-size:13px;line-height:18px;font-weight:500;opacity:.8}#phone .screen .fm9 .card{background:var(--chip);border-radius:22px;padding:10px 18px}#phone .screen .fm9 .fld{padding:10px 0}#phone .screen .fm9 .fld label{display:block;font-size:13px;font-weight:600;color:var(--mu)}#phone .screen .fm9 .fld input{width:100%;border:0;background:none;outline:0;font:inherit;font-size:19px;font-weight:600;color:var(--tx);padding:4px 0 0;height:34px}#phone .screen .fm9 .fld input::placeholder{color:var(--tt);font-weight:500}#phone .screen .fm9 .lim{display:flex;gap:8px}#phone .screen .fm9 .lim button{flex:1;height:48px;border:0;border-radius:24px;background:var(--chip);font:inherit;font-weight:700;font-size:15px;color:var(--tx)}#phone .screen .fm9 .lim button.on{background:var(--tx);color:var(--bg)}#phone .screen .fm9 .see{display:flex;gap:12px;align-items:center;background:var(--tint);color:var(--tintfg);border-radius:20px;padding:14px 16px;margin-top:22px;font-size:14px;line-height:20px;font-weight:600}#phone .screen .fm9 .pp{display:flex;align-items:center;gap:12px;padding:8px 0}#phone .screen .fm9 .av{width:44px;height:44px;border-radius:22px;background:var(--tint);color:var(--tintfg);display:flex;align-items:center;justify-content:center;font-weight:700;flex:none}#phone .screen .fm9 .pp .x{border:0;background:var(--chip);border-radius:16px;height:32px;padding:0 12px;font:inherit;font-weight:700;font-size:13px;color:var(--tx)}';
document.head.appendChild(st);
const role=(k)=>k==='child'?L('A child','Umwana','Un enfant'):L('A guardian','Umurera','Un tuteur');
const ago=x=>x.role==='child'?L('Child · ','Umwana · ','Enfant · ')+fmt(x.lim)+' RWF '+L('a week','mu cyumweru','par semaine'):L('Guardian','Umurera','Tuteur');
const _s=screens.svc;
screens.svc=()=>{if(S.svk!=='family'||!S.fm)return _s();
 try{const f=S.fm,ch=f.role==='child',m=missing(),fam=S.fam||[];
 const list=fam.length?`<div class="sc">${L('Your family','Umuryango wawe','Votre famille')}</div>`+fam.map((x,i)=>`<div class="pp"><div class="av">${E(x.n.split(/\s+/).map(w=>w[0]).join('').slice(0,2).toUpperCase())}</div><div style="flex:1;min-width:0"><b style="display:block;font-size:16px;font-weight:700">${E(x.n)}</b><span class="mu" style="font-size:13px">${ago(x)} · ${L('Waiting for them','Dutegereje ko yemera','En attente')}</span></div><button class="x tap" onclick="famAsk(${i})">${L('Cancel','Kuvanaho','Annuler')}</button></div>`).join(''):'';
 const rc=(k,g,d)=>`<button class="rc ${f.role===k?'on':''}" aria-pressed="${f.role===k}" onclick="famRole('${k}')">${gx(g,40)}<b>${role(k)}</b><span class="d">${d}</span></button>`;
 return bar(L('Family','Umuryango','Famille'))+`<div class="fm9"><div class="tl">${L('Link your family','Huza umuryango wawe','Reliez votre famille')}</div><div class="sub">${L('Add a child or a guardian. You can cancel until they accept.','Ongeraho umwana cyangwa umurera. Ushobora guhagarika kugeza yemeye.','Ajoutez un enfant ou un tuteur. Vous pouvez annuler jusqu’à son acceptation.')}</div>${list}
 <div class="sc">${L('Who are you linking?','Uhuza nde?','Qui reliez-vous ?')}</div><div class="two">${rc('child','child',L('You see their spending and set a weekly limit','Ureba ibyo akoresha ukamushyiriraho igipimo cy’icyumweru','Vous voyez ses dépenses et fixez une limite hebdomadaire'))}${rc('guardian','user',L('They see your spending, read-only','Areba ibyo ukoresha, ntashobora kubihindura','Il voit vos dépenses, en lecture seule'))}</div>
 <div class="sc">${L('Their details','Amakuru ye','Ses informations')}</div><div class="card"><div class="fld"><label for="fN">${L('First name','Izina','Prénom')}</label><input id="fN" value="${E(f.n)}" maxlength="30" autocomplete="off" placeholder="Aline" oninput="famIn('n',this)"></div><div class="fld"><label for="fP">${L('Phone number','Nimero ya telefoni','Numéro de téléphone')}</label><input id="fP" value="${E(fp(f.ph))}" inputmode="tel" autocomplete="off" placeholder="078 123 4567" oninput="famIn('ph',this)"></div></div>
 ${ch?`<div class="sc">${L('Weekly spending limit','Igipimo cy’icyumweru','Limite hebdomadaire')}</div><div class="lim" role="group">${[1000,3000,5000].map(v=>`<button class="${f.lim===v?'on':''}" aria-pressed="${f.lim===v}" onclick="famLim(${v})">${fmt(v)}</button>`).join('')}</div><div class="mu" style="font-size:13px;margin:8px 4px 0">RWF · ${L('You can change it later.','Ushobora kubihindura nyuma.','Modifiable plus tard.')}</div>`:''}
 <div class="see">${gx('shield',28)}<span>${ch?L('You will see their spending, read-only.','Uzabona ibyo akoresha, utabihindura.','Vous verrez ses dépenses, en lecture seule.'):L('They will see your spending, read-only.','Azabona ibyo ukoresha, atabihindura.','Il verra vos dépenses, en lecture seule.')}</span></div></div>
 <div style="height:110px"></div><div class="cta"><button class="btn" id="fGo" style="white-space:nowrap" ${m?'disabled ':''}onclick="famReview()">${m||lbl()}</button></div>`}catch(e){console.error('family-v488',e);return _s()}};
window.famIn=(k,el)=>{if(k==='ph'){const d=dg(el.value);el.value=fp(d);S.fm.ph=d}else S.fm.n=el.value.slice(0,30);const b=document.getElementById('fGo'),m=missing();if(b){b.disabled=!!m;b.textContent=m||lbl()}};
const sh=(title,rows,yes,go,no)=>{$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet bs464" role="dialog" aria-modal="true" aria-label="${title}"><div class="bsh"></div><div class="bsp"><div><b class="pr" style="font-size:22px;line-height:30px">${title}</b></div></div><div class="bsc" style="margin-top:16px">${rows.map(r=>`<div class="bsr"><div class="tt"><b>${r[0]}</b><span class="m i">${r[1]}</span></div></div>`).join('')}</div><button class="btn" style="margin-top:18px" onclick="${go}">${yes}</button><button class="tap" style="display:block;margin:12px auto 0;border:0;background:none;color:var(--mu);font:inherit;font-weight:700;font-size:15px" onclick="closeSheet()">${no}</button></div>`};
window.famReview=()=>{if(missing())return;const f=S.fm,ch=f.role==='child';
 sh(L('Send an invite to ','Ohereza ubutumire kuri ','Inviter ')+E(nmv())+'?',[[L('Linking','Uhuza','Lien'),role(f.role)],[L('Name','Izina','Prénom'),E(nmv())],[L('Phone','Telefoni','Téléphone'),fp(f.ph)]].concat(ch?[[L('Weekly limit','Igipimo cy’icyumweru','Limite hebdomadaire'),fmt(f.lim)+' RWF']]:[]).concat([[ch?L('You can see','Ushobora kureba','Vous voyez'):L('They can see','Ashobora kureba','Il voit'),ch?L('Their spending, read-only','Ibyo akoresha, ntibihinduka','Ses dépenses, lecture seule'):L('Your spending, read-only','Ibyo ukoresha, ntibihinduka','Vos dépenses, lecture seule')]]),L('Send invite','Ohereza ubutumire','Envoyer l’invitation'),'famGo()',L('Cancel','Kuvanaho','Annuler'))};
window.famGo=()=>{if(missing())return;const f=S.fm,n=nmv();S.fam.push({n,ph:dg(f.ph),role:f.role,lim:f.lim});S.fm={role:f.role,n:'',ph:'',lim:f.lim};closeSheet();render('fade-none');toast(L('Invite sent to ','Ubutumire bwoherejwe kuri ','Invitation envoyée à ')+n)};
window.famAsk=i=>{const x=S.fam[i];if(!x)return;sh(L('Cancel the invite to ','Hagarika ubutumire kuri ','Annuler l’invitation à ')+E(x.n)+'?',[[L('Phone','Telefoni','Téléphone'),fp(x.ph)],[L('Linking','Uhuza','Lien'),role(x.role)]],L('Cancel invite','Hagarika ubutumire','Annuler l’invitation'),'famDel('+i+')',L('Keep it','Bugumane','Garder'))};
window.famDel=i=>{const x=S.fam[i];if(!x)return;S.fam.splice(i,1);closeSheet();render('fade-none');toast(L('Invite to ','Ubutumire kuri ','Invitation à ')+x.n+L(' cancelled',' bwahagaritswe',' annulée'))};
document.title=document.title.replace(/v\d+/,'v488');
})()}catch(e){console.error('family-v488',e)}
</script>
<script>
/* v489: Gift in a chat uses the same slide-to-pay sheet as Send money: big amount with − / + (1,000 steps), 2,000 / 5,000 / 10,000 chips, who gets it and where it is paid from, the balance left after, and Slide to pay. Not enough balance disables the slider. The gift still appears in the chat as a gift voucher. fr/rw strings need native review. */
try{(()=>{
const L=(e,r,f)=>({en:e,rw:r,fr:f}[S.lang]||e);
const who=()=>{try{return thr().n}catch(e){return L('this chat','iki kiganiro','ce chat')}};
const CH=()=>ic('chev',18,'var(--tt)');
window.drawGift=function(a){
 if(typeof a==='number')S.giftAmt=Math.max(1000,Math.min(2000000,a));
 const amt=S.giftAmt||5000,bad=amt>S.pay,nm=who();
 $('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet bs464" role="dialog" aria-modal="true" aria-label="${L('Send a gift','Ohereza impano','Envoyer un cadeau')}"><div class="bsh"></div>
 <div class="bsp"><div><b class="pr">${fmt(amt)} RWF</b></div><div class="bsq"><button aria-label="Less" onclick="drawGift(S.giftAmt-1000)">−</button><b style="min-width:0"></b><button aria-label="More" onclick="drawGift(S.giftAmt+1000)">+</button></div></div>
 <div class="bsn">${L('Gift voucher to ','Inyemezabuguzi y’impano kuri ','Bon cadeau pour ')}${nm}</div>
 <div class="req" style="margin:0 0 14px">${[2000,5000,10000].map(q=>`<button class="${amt===q?'on':''}" onclick="drawGift(${q})">${fmt(q)}</button>`).join('')}</div>
 <div class="bsc">
  <div class="bsr"><div class="tt"><b>${L('Gift to','Impano kuri','Cadeau pour')}</b><span class="m i">${nm}</span></div></div>
  <div class="bsr"><div class="tt"><b>itunda Pay</b><span class="m i">${fmt(S.pay)} RWF</span></div>${CH()}</div>
 </div>
 ${bad?`<div class="bsb er">${L('Not enough balance. Add money first.','Amafaranga ntahagije. Banza wongeremo.','Solde insuffisant. Ajoutez de l’argent.')}</div>`:`<div class="bsb">${L('Balance after: ','Asigaye: ','Solde après : ')}<em>${fmt(S.pay-amt)} RWF</em></div>`}
 <div id="sl9" style="position:relative;height:60px;border-radius:30px;background:${bad?'var(--chip)':'var(--br)'};overflow:hidden;touch-action:none;user-select:none"><div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:17px;color:${bad?'var(--tt)':'var(--on)'}">${L('Slide to pay','Kurura ushyure','Glisser pour payer')}</div><div id="kn9" style="position:absolute;left:6px;top:6px;width:48px;height:48px;border-radius:24px;background:#fff;display:flex;align-items:center;justify-content:center;color:#191F28">${ic('chev',22)}</div></div></div>`;
 const tr=document.getElementById('sl9'),kn=document.getElementById('kn9');if(!tr||bad)return;
 let d=false,sx=0,mx=0;const pos=e=>(e.touches?e.touches[0].clientX:e.clientX);
 const mv=e=>{if(!d)return;mx=Math.max(0,Math.min(tr.clientWidth-60,pos(e)-sx));kn.style.left=(6+mx)+'px'};
 const up=()=>{if(!d)return;d=false;document.removeEventListener('mousemove',mv);document.removeEventListener('mouseup',up);document.removeEventListener('touchmove',mv);document.removeEventListener('touchend',up);if(mx>tr.clientWidth-80){try{navigator.vibrate&&navigator.vibrate(12)}catch(e){}giftSend();toast(L('Gift sent · ','Impano yoherejwe · ','Cadeau envoyé · ')+fmt(S.giftAmt)+' RWF')}else{kn.style.transition='left .2s';kn.style.left='6px';setTimeout(()=>kn.style.transition='',220)}};
 const dn=e=>{d=true;sx=pos(e);mx=0;document.addEventListener('mousemove',mv);document.addEventListener('mouseup',up);document.addEventListener('touchmove',mv,{passive:true});document.addEventListener('touchend',up)};
 kn.addEventListener('mousedown',dn);kn.addEventListener('touchstart',dn,{passive:true});
};
document.title=document.title.replace(/v\d+/,'v489');
})()}catch(e){console.error('gift-v489',e)}
</script>
<script>
/* v490: place detail action row. The main button said "Arrive" for most places (only the first cafe was renamed). It now says "Directions" with the trip time under the same rules as the route screen: on foot up to 3 km, otherwise the 35 min bus trip. */
try{(()=>{
const L=(e,r,f)=>({en:e,rw:r,fr:f}[S.lang]||e),P=()=>window.POI||[];
const _p=screens.place;
if(_p)screens.place=()=>{let h=String(_p());const p=P().find(x=>x.n===PL.n);if(!p)return h;
 const km=parseFloat(p.d)||0,t=km>0&&km<=3?'🚶 '+Math.max(1,Math.round(10.2*km))+' min':'🚌 35 min';
 return h.replace(/(<button class="q" onclick="mpArriveAt\('[^']*'\)">)Arrive(<\/button>)/,'$1'+L('Directions','Inzira','Itinéraire')+' · '+t+'$2')};
document.title=document.title.replace(/v\d+/,'v490');
})()}catch(e){console.error('place-v490',e)}
</script>
<script>
/* v491: two fixes. (1) Walk, car and bike routes: the "Now / In 15 min / In 30 min / In 1 h / Share ETA" row from v482 was placed after the sheet closed, so it never showed; it now sits inside the sheet under the arrival time, and the map is shorter on those routes so the row is not hidden behind Start. (2) Places > Map opened with no category selected, so every pin was filtered out and the list said "Nothing nearby"; it now opens on All. */
try{(()=>{
const _r=screens.route;
screens.route=()=>{let h=String(_r());
 const m=h.match(/<\/div>(<div class="lvc">[\s\S]*?<\/div>)<div class="cta">/);
 if(m)h=h.replace(m[0],m[1]+'</div><div class="cta">');if(S.mp.mode!=='bus')h=h.replace('data-k="rt" style="height:330px"','data-k="rt" style="height:262px"');return h};
const _pm=window.plMap;
if(_pm)window.plMap=()=>{S.mp.cat='all';_pm();S.mp.cat='all'};
document.title=document.title.replace(/v\d+/,'v491');
})()}catch(e){console.error('fix-v491',e)}
</script>
<script>
/* v492: every itunda Eats store is now also a place in itunda Places. Each store in REST becomes a map pin and a place page (address, hours, phone, rating, distance, reviews, nearby) under Cafe or Food, shows in Near you, Search and Saved, and its page has an "Order on itunda Eats" button that opens the store's menu. Built from REST at runtime, so new Eats stores appear in Places automatically. */
try{(()=>{
const L=(e,r,f)=>({en:e,rw:r,fr:f}[S.lang]||e);
const EMO={bread:'🥖',brochette:'🍢',rice:'🍚',coffee:'☕',chips:'🍟',fish:'🐟',salad:'🥗',stew:'🍲',cake:'🍰',chicken:'🍗',mandazi:'🍩',tea:'🍵',juice:'🥤',wrap:'🌯'};
const CAFE=/coffee|bread|bakery|dessert|cake|tea/i;
const ph=s=>s?'+250 '+String(s).replace(/^0/,''):'';
function sync(){
 const P=window.POI,X=window.PX,R=typeof REST!=='undefined'?REST:[];if(!P||!X)return;
 R.forEach((r,i)=>{
  const id='eats'+i;if(P.find(p=>p.id===id))return;
  const inf=(typeof INFO!=='undefined'&&INFO[i])||[];
  const cats=r.cats||[r.cat].filter(Boolean),sub=r.sub||cats.join(', ');
  const hrs=r.hrs||inf[1]||'09:00 – 21:00',addr=r.addr||inf[0]||'Kigali',tel=r.ph||inf[2]||'';
  const t=hrs.split(/\s*[–-]\s*/),open=r.closed?'Closed · opens '+r.closed:'Open · closes '+(t[1]||'21:00');
  const ang=i*2.4+.7,rad=Math.max(.5,r.d||1)*80;
  const x=Math.round(Math.max(-100,Math.min(460,250+rad*Math.cos(ang)))),y=Math.round(Math.max(-50,Math.min(640,440+rad*Math.sin(ang))));
  const c=cats.some(k=>CAFE.test(k))?'cafe':'food';
  P.push({id,c,e:EMO[r.g]||(c==='cafe'?'☕':'🍽️'),n:r.n,x,y,k:cats.join(', ')+' · itunda Eats',r:r.r+' ('+r.rc+')',d:(r.d||1).toFixed(1)+' km',o:open,eats:i});
  X[id]={a:addr,p:ph(tel),h:'Mon–Sun '+hrs,g:[r.bg||'#eee',r.bg||'#eee'],f:['Delivery','Pickup','itunda Pay'],
   s:[sub+'. Order delivery or pickup on itunda Eats.',sub+'. Tumiza kuri itunda Eats ugezwaho cyangwa ujye gufata.',sub+'. Commandez en livraison ou à emporter sur itunda Eats.']};
 });
}
window.plOrderEats=i=>openERest(i);
const wrap=n=>{const f=screens[n];if(f)screens[n]=function(){sync();return f.apply(this,arguments)}};
['placehub','mapview','mapsearch','mpsaved','place'].forEach(wrap);
const _pl=screens.place;
if(_pl)screens.place=function(){let h=String(_pl.apply(this,arguments));
 const p=(window.POI||[]).find(x=>x.n===PL.n);if(!p||p.eats===undefined)return h;
 const r=(typeof REST!=='undefined'?REST:[])[p.eats],btn=`<button class="btn" style="width:100%;margin:10px 0 0" onclick="plOrderEats(${p.eats})">${L('Order on itunda Eats','Tumiza kuri itunda Eats','Commander sur itunda Eats')}${r&&r.t?' · '+r.t+' min':''}</button>`;
 return h.replace(/(<div class="acts"[^>]*>[\s\S]*?<\/div>)/,'$1'+btn)};
sync();
document.title=document.title.replace(/v\d+/,'v492');
})()}catch(e){console.error('eats-places-v492',e)}
</script>
<script>
/* v493: itunda Place page, tidied. Before: the action row ran off the screen (Call and Share cut off), Pay here / Reserve / Stamp card sat in a big lilac card with a second heading and a full stamp strip, the tags, the Order button and that card all stacked above the tabs, "Menu 5" had a heading but no items, the opening-hours row used a phone icon, and the sheet over the map repeated the open time and the distance on two lines. Now: ONE action row (Directions with the walk time under it, Call, Share; "From here" moves to the bottom of Home), the Order on itunda Eats button when the place is an Eats store, then one Pay here / Reserve row. The tags and a slim one-line Stamp card (8 dots and a + button) sit inside the Home tab under the tabs, so the other tabs are not pushed down. The hero picture is shorter, the menu shows as a plain list with See all, hours get a clock icon, and the map sheet merges open time and distance into one line and drops the tags and stamp card. */
try{(()=>{
const L=(e,r,f)=>({en:e,rw:r,fr:f}[S.lang]||e),M=S.mp;
const st=document.createElement('style');
st.textContent=`
#phone .pz-acts{display:flex;gap:8px;padding:14px 16px 0}
#phone .pz-acts.c{padding:14px 0 0}
#phone .pz-acts button{height:50px;border-radius:25px;border:1.5px solid var(--ln);background:none;font:inherit;font-weight:700;font-size:15px;color:var(--tx);padding:0 18px;flex:0 0 auto;display:flex;flex-direction:column;align-items:center;justify-content:center;line-height:18px}
#phone .pz-acts button.main{flex:1 1 auto;background:var(--lk);color:#fff;border-color:transparent}
#phone .pz-acts button .s{font-size:12px;font-weight:600;color:inherit;opacity:.9;line-height:14px}
#phone .pz-row{display:flex;gap:8px;padding:10px 16px 0}
#phone .pz-row.c{padding:10px 0 0}
#phone .pz-row .btn{flex:1;height:48px;font-size:15px;margin:0;min-width:0}
#phone .pz-tags{display:flex;gap:8px;overflow-x:auto;padding:16px 16px 0;scrollbar-width:none}
#phone .pz-tags::-webkit-scrollbar{display:none}
#phone .pz-tags span{flex:0 0 auto}
#phone .pz-stamp{margin:12px 16px 0;padding:10px 12px 10px 14px;border-radius:18px;background:var(--chip);display:flex;align-items:center;gap:10px}
#phone .pz-stamp .t{flex:1;min-width:0;font-size:14px;font-weight:800;line-height:18px}
#phone .pz-stamp .t small{display:block;font-size:12px;font-weight:600;color:var(--tt)}
#phone .pz-stamp .d{display:flex;gap:3px;flex:0 0 auto}
#phone .pz-stamp .d i{width:9px;height:9px;border-radius:5px;background:var(--tt);opacity:.3;display:block}
#phone .pz-stamp .d i.on{background:var(--lk);opacity:1}
#phone .pz-ai{margin:20px 16px 0!important;padding:16px!important;background:var(--tint)!important;border-radius:20px!important}
#phone .pz-ai b{color:var(--tintfg)}
#phone .pz-stamp button{flex:0 0 auto;width:34px;height:34px;border-radius:17px;border:0;background:var(--bg);color:var(--lk);font:inherit;font-size:20px;font-weight:800;line-height:34px;padding:0}
#phone .pz-rsv{margin:12px 16px 0;font-size:14px;font-weight:700}
#phone .pz-menu{padding:0 16px}
#phone .pz-menu .r{display:flex;align-items:center;gap:12px;height:52px}
#phone .pz-menu .r i{font-style:normal;font-size:22px;width:36px;height:36px;border-radius:12px;background:var(--chip);display:flex;align-items:center;justify-content:center}
#phone .pz-menu .r span{flex:1;min-width:0;font-size:16px}
#phone .pz-menu .r b{font-size:15px}
#phone .pz-more{padding:6px 16px 0}
#phone .pz-more button{border:0;background:none;color:var(--lk);font:inherit;font-weight:700;font-size:14px;padding:10px 0}
`;
document.head.appendChild(st);
const cur=()=>(window.POI||[]).find(p=>p.n===PL.n)||{id:'cafe',d:'4.4 km'};
const esc=x=>String(x).replace(/"/g,'&quot;');
const _pl=screens.place;
screens.place=function(){
 const h=String(_pl.apply(this,arguments));
 try{
  const t=document.createElement('template');t.innerHTML=h;const R=t.content;
  const acts=R.querySelector('.acts');if(!acts)return h;
  const p=cur(),exp=!!R.querySelector('.ptabs'),padded=/padding:0 16px/.test(acts.parentElement&&acts.parentElement.getAttribute&&acts.parentElement.getAttribute('style')||''),c=(exp&&!padded)?'':' c';
  const bt=k=>[...acts.querySelectorAll('button')].find(b=>k.test(b.getAttribute('onclick')||''));
  const bDir=bt(/mpArrive/),bCall=bt(/mpCall|Calling/),bShare=bt(/Link copied/),bDep=bt(/mpDepart/);
  const km=parseFloat(p.d)||0,wt=km>0&&km<=3?'🚶 '+Math.max(1,Math.round(10.2*km))+' min':'🚌 35 min';

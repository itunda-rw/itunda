#phone .e2-sc button.on{background:var(--tx);color:var(--bg)}
#phone .e2-mq{display:flex;align-items:center;gap:10px;margin:14px 24px 0;height:44px;border-radius:14px;background:var(--chip);padding:0 14px;color:var(--mu)}
#phone .e2-sec h3{margin:0;padding:24px 24px 4px;font-size:19px;font-weight:800;letter-spacing:-.3px}
#phone .e2-it{display:flex;gap:14px;padding:14px 24px;border-bottom:1px solid var(--ln)}
#phone .e2-itx{flex:1;min-width:0;border:0;background:none;font:inherit;color:inherit;text-align:left;padding:0;cursor:pointer}
#phone .e2-in{font-size:16px;font-weight:800;line-height:21px}
#phone .e2-id{font-size:13px;line-height:18px;color:var(--mu);margin-top:3px}
#phone .e2-ip{font-size:15px;font-weight:700;margin-top:8px}
#phone .e2-bt{display:inline-block;font-size:11px;font-weight:800;border-radius:7px;padding:2px 6px;margin-left:6px;vertical-align:2px;background:var(--tint);color:var(--tintfg)}
#phone .e2-th{position:relative;width:96px;height:96px;border-radius:18px;display:flex;align-items:center;justify-content:center;flex:none;margin-right:6px}
#phone .e2-pl{position:absolute;right:-8px;bottom:-8px;min-width:38px;height:38px;border-radius:19px;border:2px solid var(--bg);background:var(--br);color:var(--on);font:inherit;font-size:20px;font-weight:800;display:flex;align-items:center;justify-content:center;padding:0 8px}
#phone .e2-pl.q{background:var(--tx);color:var(--bg);font-size:15px}
#phone .e2-pl[disabled]{background:var(--chip);color:var(--tt)}
#phone .e2-sp{position:absolute;right:-8px;bottom:-8px;height:38px;border-radius:19px;border:2px solid var(--bg);background:var(--tx);color:var(--bg);display:flex;align-items:center}#phone .e2-sp button{width:34px;height:34px;border:0;background:none;color:inherit;font:inherit;font-size:20px;font-weight:800;padding:0}#phone .e2-sp b{min-width:14px;text-align:center;font-size:15px}
#phone .e2-cp{display:flex;align-items:center;gap:10px;width:calc(100% - 48px);margin:12px 24px 0;height:48px;border:1px solid var(--ln);border-radius:14px;background:var(--bg);font:inherit;font-size:14px;color:var(--tx);padding:0 14px;text-align:left}#phone .e2-cp span{flex:1}#phone .e2-cp svg:first-child{color:var(--tintfg)}
#phone .e2-nf{padding:16px 24px 0}
#phone .e2-nf div{display:flex;justify-content:space-between;gap:16px;padding:14px 0;border-bottom:1px solid var(--ln);font-size:15px}
#phone .e2-nf span{color:var(--mu);flex:none}
#phone .e2-nf b{text-align:right}
#phone .e2-rv{padding:14px 24px;border-bottom:1px solid var(--ln)}
#phone .e2-cta{display:flex;align-items:center;gap:10px;width:100%;height:56px;border:0;border-radius:18px;background:var(--br);color:var(--on);font:inherit;font-weight:800;font-size:16px;padding:0 18px}
#phone .e2-cta .n{width:26px;height:26px;border-radius:13px;background:var(--on);color:var(--br);display:flex;align-items:center;justify-content:center;font-size:13px;flex:none}
#phone .e2-cta .l{flex:1;text-align:left;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#phone .e2-cta .t{flex:none}
#phone .e2-fine{padding:18px 24px 0;font-size:12px;color:var(--tt)}
</style>
<script>
(function(){
/* ---------- helpers ---------- */
const T=(e,f,r)=>({en:e,fr:f,rw:r}[S.lang]||e);
const esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const q$=s=>document.querySelector(s);
const svg=(p,s,st)=>`<svg width="${s||22}" height="${s||22}" viewBox="0 0 24 24" fill="none" stroke="${st||'currentColor'}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${p}</svg>`;

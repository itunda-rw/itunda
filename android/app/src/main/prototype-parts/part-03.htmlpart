const fit=(pts,h,padb)=>{let a=1e9,b=-1e9,c=1e9,d=-1e9;pts.forEach(p=>{a=Math.min(a,p[0]);b=Math.max(b,p[0]);c=Math.min(c,p[1]);d=Math.max(d,p[1])});M.v={x:(a+b)/2,y:(c+d)/2,z:Math.min(.6,Math.max(.02,Math.min((W-70)/Math.max(b-a,300),(h-90)/Math.max(d-c,300))))}};

const stat=o=>{o=String(o||'');let m;
 if(m=/^Open · closes (\d\d:\d\d)/.exec(o))return[L('Open till ','Irafunguye kugeza ','Ouvert jusqu’à ')+(m[1]==='00:00'?'midnight':m[1]),0];
 if(m=/^Closed · opens (\d\d:\d\d)/.exec(o))return[L('Closed · opens ','Irafunze · ifungura ','Fermé · ouvre ')+m[1],1];

window.mpPick=pick;window.mpSetEp=(w,id)=>{const n=id?POI.find(p=>p.id===id).n:'My location';if(w)PL.n=n;else M.from=id?n:null;M.opt=0;closeSheet();render('fade-none')};
window.mpSwap=()=>{const a=M.from||'My location';M.from=PL.n==='My location'?null:PL.n;PL.n=a;M.opt=0;render('fade-none')};
const LC=n=>({'305':'#3B7D20','102':'#2E6BF0','311':'#E8730C'})[n]||'#7B4DD6',WR='background:repeating-linear-gradient(var(--tt) 0 3px,transparent 3px 8px)';
if(!document.getElementById('st501')){const st=document.createElement('style');st.id='st501';st.textContent='.dpc{display:flex;gap:8px;overflow-x:auto;padding:10px 16px 0;scrollbar-width:none}.dpc::-webkit-scrollbar{display:none}.dpc button{flex:none;height:34px;padding:0 14px;border:0;border-radius:17px;background:var(--chip);color:var(--tx);font:inherit;font-size:14px;font-weight:700}.dpc button.on{background:var(--tx);color:var(--bg)}.rsh{position:relative;margin-top:-22px;background:var(--bg);border-radius:24px 24px 0 0;padding:8px 16px 0}.rcd{border-radius:20px;background:var(--chip);padding:14px 16px;margin-top:10px}.rcd.on{box-shadow:inset 0 0 0 2px var(--lk)}.rt1{display:flex;align-items:baseline;gap:8px}.rt1 b{font-size:24px;letter-spacing:-.5px}.rt1 span{font-size:14px;color:var(--mu);flex:1}.rt1 em{font-style:normal;font-size:14px;font-weight:700}.rtag{font-size:12px;font-weight:800;color:var(--lk);margin-bottom:2px}.rbr{display:flex;gap:2px;height:26px;margin-top:10px;border-radius:13px;overflow:hidden}.rbr i{display:flex;align-items:center;justify-content:center;font-style:normal;font-size:11px;font-weight:800;white-space:nowrap;overflow:hidden;min-width:0;color:#fff}.rsb{font-size:13px;color:var(--mu);margin-top:8px;line-height:19px}.tl5{margin-top:14px;border-top:1px solid var(--ln);padding-top:12px}.tr5{display:flex;gap:12px;min-height:44px}.tr5 .ra{width:22px;flex:none;display:flex;flex-direction:column;align-items:center}.tr5 .ra u{width:14px;height:14px;border-radius:7px;border:3px solid;background:var(--bg);flex:none;box-sizing:border-box}.tr5 .ra s{flex:1;width:4px;border-radius:2px;margin:2px 0;text-decoration:none}.tr5 .rb{flex:1;min-width:0;padding-bottom:12px;font-size:15px;line-height:21px}.tr5 .rb small{display:block;font-size:13px;color:var(--mu)}.tr5 .rtm{font-size:13px;font-weight:700;color:var(--mu);flex:none}.pl5{display:inline-block;min-width:34px;text-align:center;border-radius:8px;color:#fff;font-size:13px;font-weight:800;padding:1px 6px;margin-right:6px}.nvt{background:var(--lk);color:#fff;border-radius:20px;padding:12px 16px;display:flex;align-items:center;gap:14px}.nvt span{font-size:34px}.nvt b{font-size:28px;display:block;line-height:32px}.nvt small{font-size:14px;line-height:18px;display:block}.nvt2{background:var(--bg);margin:6px 20px 0;border-radius:14px;padding:8px 12px;font-size:13px;font-weight:700}';document.head.appendChild(st)}
function rl(){const m=M.mode||'bus',A=ep(M.from),B=ep(PL.n);let list=rt(m,A,B);if(m==='bus'){const wk=r=>r.legs.filter(l=>l.k==='w').reduce((a,l)=>a+l.m,0),tc=r=>r.legs.filter(l=>l.k==='b').length,f=[null,(a,b)=>a.secs-b.secs,(a,b)=>tc(a)-tc(b)||a.secs-b.secs,(a,b)=>wk(a)-wk(b)][M.so||0];if(f)list=list.slice().sort(f)}return{m,A,B,list}}
const row=(c,dot,body,t,rail)=>`<div class="tr5"><div class="ra">${dot?`<u style="border-color:${c}"></u>`:''}<s style="${rail}"></s></div><div class="rb">${body}</div><span class="rtm">${t||''}</span></div>`;
window.mpSx=k=>{M.sx=M.sx||{};M.sx[k]=!M.sx[k];render('fade-none')};
function detail(r,m,A,B,key){const t0=(M.dp||0)*60;let t=t0,h=row('#2BA84A',1,`<b>${A.n}</b>`,clk(t),m==='bus'?WR:'background:'+COL[m]);
if(m==='bus'){r.legs.forEach((l,i)=>{if(l.k==='w'){t+=l.secs;h+=row('',0,`🚶 ${L('Walk','Genda','Marchez')} ${tm(l.secs)} · ${dm(l.m)}`,'',i===r.legs.length-1?'display:none':WR);return}
t+=l.wait;const c=LC(l.ln),k2=key+'-'+i,mid=l.stops.slice(1,-1),open=(M.sx||{})[k2];
h+=row(c,1,`<span class="pl5" style="background:${c}">${l.ln}</span><b>${L('Board at','Urira kuri','Montez à')} ${l.from}</b>${l.w&&i===1?`<small>${L('Next in','Ikurikira mu','Prochain dans')} ${l.w} min · ${l.w+7} min</small>`:`<small>${L('Transfer: wait','Gutegereza','Correspondance : attente')} ~4 min</small>`}`,clk(t),'background:'+c);
h+=row(c,0,`<div ${mid.length?`onclick="mpSx('${k2}')" style="color:var(--lk);font-weight:700;cursor:pointer"`:'class="mu"'}>${l.stops.length-1} ${L('stops','aho bisi zihagarara','arrêts')} · ${tm(l.secs)}${mid.length?(open?' ⌃':' ⌄'):''}</div>${open?mid.map(n=>`<small>• ${n}</small>`).join(''):''}`,'','background:'+c);
t+=l.secs;h+=row(c,1,`<b>${L('Get off at','Manuka kuri','Descendez à')} ${l.to}</b>`,clk(t),WR)})}
else{t=t0;r.steps.forEach((s,i,a)=>{const e=i===a.length-1;if(i&&!e)h+=row('',0,`<span style="font-size:18px">${s.g}</span> ${s.t}<small>${s.s||''}</small>`,'','background:'+COL[m]);if(e)t=t0+r.secs});}
return h+row('#D92D20',1,`<b>${B.n}</b>`,clk(t0+r.secs),'display:none')}
function card(x,i,o,m,A,B){const on=o===i,t0=(M.dp||0)*60,lab=x.label==='Best'?L('Recommended','Byiza cyane','Recommandé'):x.label==='Shortest'?L('Shortest','Ngufi','Plus court'):x.label==='Fewest transfers'?L('Fewest transfers','Guhindura bike','Moins de correspondances'):L('Alternative','Ubundi buryo','Alternative');
let bar='',sb='',em='';
if(m==='bus'){const T=x.secs;bar=`<div class="rbr">${x.legs.map(l=>l.k==='w'?`<i style="flex:${Math.max(l.secs,70)};background:var(--tt)">🚶 ${Math.max(1,Math.round(l.secs/60))}</i>`:`<i style="flex:${Math.max(l.secs,90)};background:${LC(l.ln)}">${l.ln} · ${Math.round(l.secs/60)}</i>`).join('')}</div>`;const bs=x.legs.filter(l=>l.k==='b'),b=bs[0],wk=x.legs.filter(l=>l.k==='w').reduce((a,l)=>a+l.secs,0);em=x.fare+' RWF';
sb=b?`${L('Board at','Urira kuri','Montez à')} ${b.from} · ${L('next in','ikurikira mu','prochain dans')} ${b.w} min<br>${bs.length>1?(bs.length-1)+' '+L('transfer','guhindura','correspondance'):L('Direct','Nta guhindura','Direct')} · ${L('Walk','Kugenda','Marche')} ${tm(wk)} · ${bs.reduce((a,l)=>a+l.stops.length-1,0)} ${L('stops','aho bisi zihagarara','arrêts')}`:''}
else{if(m==='car'&&x.tr)bar=`<div class="rbr">${x.tr.map(q=>`<i style="flex:${Math.max(1,pl(q.g))};background:${q.c}"></i>`).join('')}</div>`;
sb=`${dm(x.dist)} · ${x.cost}${m==='car'?`<br>${x.delay>90?'🟠 '+L('Slow traffic','Urujya n’uruza ruratinze','Trafic dense')+' +'+tm(x.delay):'🟢 '+L('Smooth traffic','Nta mubyigano','Trafic fluide')} · ${L('Toll free','Nta mahoro','Sans péage')}`:''}`}
return `<div class="rcd ${on?'on':''}" onclick="${on?'':`mpSet('opt',${i})`}"><div class="rtag">${i===0?'✨ ':''}${lab}</div><div class="rt1"><b>${tm(x.secs)}</b><span>${clk(t0)} → ${clk(t0+x.secs)}</span><em>${em}</em></div>${bar}<div class="rsb">${sb}</div>${on?`<div class="tl5">${detail(x,m,A,B,o)}</div>`:''}</div>`}
screens.route=()=>{M._nv=null;const{m,A,B,list}=rl(),o=Math.min(M.opt||0,list.length-1),cur=list[o],key=[A.n,B.n,m].join('|');M._r={list,sel:o,mode:m};M._pins=false;if(M.fk!==key){M.fk=key;fit(cur.pts,190)}
const dot=c=>`<span style="width:12px;height:12px;border-radius:6px;border:3px solid ${c};margin:6px 6px 0 0;flex-shrink:0"></span>`,tms=MODES.map(([k,g])=>{const r=rt(k,A,B)[0];return `<button class="${m===k?'on':''}" onclick="M.opt=0;mpSet('mode','${k}')" aria-label="${k}">${ic(g,20,m===k?'#fff':'var(--mu)')}${tm(r.secs).replace(' min','m').replace(' h ','h')}</button>`}).join('');
const DP=[[0,L('Depart now','Ahaguruka ubu','Partir maintenant')],[15,'+15 min'],[30,'+30 min'],[60,'+1 h']],SO=[L('Recommended','Byiza cyane','Recommandé'),L('Fastest','Byihuse','Plus rapide'),L('Fewest transfers','Guhindura bike','Moins de correspondances'),L('Least walking','Kugenda make','Moins de marche')];
return `<div class="mh" style="padding-bottom:0"><button class="ib" aria-label="Back" onclick="back()">${ic('back',24)}</button><b style="font-size:18px;flex:1">${L('Directions','Inzira','Itinéraire')}</b><button class="ib" aria-label="Swap" onclick="mpSwap()"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 4v16M4 8l4-4 4 4M16 20V4M12 16l4 4 4-4"/></svg></button></div>
<div class="rbox" style="margin-top:8px"><div class="fi tap" style="padding:10px 4px" onclick="mpPick(0)">${dot('#2BA84A')}<span style="flex:1">${A.n}</span></div><div class="fi tap" style="padding:10px 4px;border-top:0" onclick="mpPick(1)">${dot('#D92D20')}<span style="flex:1">${B.n}</span></div></div><div class="modes">${tms}</div>
<div class="dpc">${DP.map(([v,l])=>`<button class="${(M.dp||0)===v?'on':''}" onclick="mpSet('dp',${v})">${v?'🕑 ':''}${l}</button>`).join('')}${m==='bus'?SO.map((l,i)=>`<button class="${(M.so||0)===i?'on':''}" style="background:${(M.so||0)===i?'var(--lk)':'var(--chip)'};color:${(M.so||0)===i?'#fff':'var(--tx)'}" onclick="M.opt=0;mpSet('so',${i})">${l}</button>`).join(''):''}</div>
<div style="position:relative;margin-top:10px">${gm(190)}${ctl(12)}</div><div class="rsh"><div class="hdl"></div>${list.map((x,i)=>card(x,i,o,m,A,B)).join('')}</div><div style="height:100px"></div><div class="cta"><div style="display:flex;gap:10px"><button class="btn sec2" style="flex:0 0 36%" onclick="mpStart(true)">${L('Preview','Reba','Aperçu')}</button><button class="btn" onclick="mpStart(false)">${m==='bus'?'🚌 ':''}${L('Start','Tangira','Démarrer')}</button></div></div>`};
/* ---- turn-by-turn navigation ---- */
let NT=null;const cl=r=>{if(r._cl)return r._cl;const c=[0];for(let i=1;i<r.pts.length;i++)c[i]=c[i-1]+Math.hypot(r.pts[i][0]-r.pts[i-1][0],r.pts[i][1]-r.pts[i-1][1]);return r._cl=c};
function at2(r,f){const c=cl(r),d=f*c[c.length-1];let k=0;while(k<c.length-2&&c[k+1]<d)k++;const a=r.pts[k],b=r.pts[k+1],u=c[k+1]>c[k]?(d-c[k])/(c[k+1]-c[k]):0;return{p:[a[0]+(b[0]-a[0])*u,a[1]+(b[1]-a[1])*u],k,a:Math.atan2(b[1]-a[1],b[0]-a[0])*180/Math.PI+90}}
function nvui(){const N=M.nr,r=N.r,f=M.nv.f,st=r.steps,tot=st.reduce((a,s)=>a+(s.m||0),0)||1,d=f*tot;let i=0,e=st[0].m||0;while(i<st.length-1&&e<=d){i++;e+=st[i].m||0}
const rem=Math.max(0,e-d),last=i>=st.length-1,nx=st[Math.min(i+1,st.length-1)],done=f>=1,left=r.secs*(1-f),sp=Math.round(32+16*Math.sin(f*37));
const top=done?`<div class="nvt" style="background:#0A8F5B"><span>🏁</span><div><b>${L('You have arrived','Wageze','Vous êtes arrivé')}</b><small>${N.B.n}</small></div></div>`:`<div class="nvt"><span>${last?'🏁':nx.g}</span><div><b>${dm(rem)}</b><small>${last?L('Arrive at ','Ugera kuri ','Arrivée : ')+N.B.n:nx.t}</small></div></div>${i+2<st.length?`<div class="nvt2">${L('Then','Hanyuma','Puis')} ${st[i+2].g} ${st[i+2].t}</div>`:''}`;
const bot=done?`<button class="btn" onclick="mpEnd()">${L('Done','Byarangiye','Terminé')}</button>`:`<div style="display:flex;align-items:center;gap:10px"><div style="flex:1;min-width:0"><b style="font-size:26px;color:var(--lk)">${tm(left)}</b><div class="sm mu">${clk(left)} ${L('arrival','kugera','arrivée')} · ${dm(r.dist*(1-f))}${N.mode==='car'?' · '+sp+' km/h':''}</div></div><button class="btn sec2" style="width:auto;padding:0 14px" aria-label="Overview" onclick="mpNvOv()">${M.nv.ov?'📍':'🗺️'}</button><button class="btn sec2" style="width:auto;padding:0 14px" aria-label="Sound" onclick="mpNvMute()">${M.nv.mute?'🔇':'🔊'}</button><button class="btn" style="width:auto;padding:0 18px" onclick="mpEnd()">${L('End','Hagarika','Arrêter')}</button></div>`;
return{top,bot,i,rem,nx,last,done}}
function ntick(){if(S.stack[S.stack.length-1]!=='nav'||!M.nr){clearInterval(NT);NT=null;return}const N=M.nr,v=M.nv;if(v.f>=1){clearInterval(NT);NT=null;return}v.f=Math.min(1,v.f+.0125);const q=at2(N.r,v.f);M._nv=q;if(!v.ov)M.v={x:q.p[0],y:q.p[1],z:M.v.z};
const u=nvui(),b=document.getElementById('nvb'),f=document.getElementById('nvf');if(b)b.innerHTML=u.top;if(f)f.innerHTML=u.bot;if(!u.done&&!u.last&&u.rem<150&&v.say!==u.i&&!v.mute){v.say=u.i;toast(L('In ','Nyuma ya ','Dans ')+dm(u.rem)+': '+u.nx.t)}if(u.done)toast(L('You have arrived','Wageze','Vous êtes arrivé'));draw()}
window.mpStart=pre=>{const{m,B,list}=rl(),r=list[Math.min(M.opt||0,list.length-1)];M.nr={r,mode:m,B,pre:!!pre};M.nv={f:0,say:-1,mute:false,ov:false};M._nv=at2(r,0);M.v={x:M._nv.p[0],y:M._nv.p[1],z:m==='walk'?.25:.16};S.stack.push('nav');render('push');clearInterval(NT);NT=setInterval(ntick,pre?250:500)};
window.mpNvOv=()=>{M.nv.ov=!M.nv.ov;if(M.nv.ov)fit(M.nr.r.pts,540);else M.v={x:M._nv.p[0],y:M._nv.p[1],z:.16};render('fade-none')};
window.mpNvMute=()=>{M.nv.mute=!M.nv.mute;toast(M.nv.mute?L('Voice off','Ijwi rizimye','Voix désactivée'):L('Voice on','Ijwi rifunguye','Voix activée'));render('fade-none')};
window.mpEnd=()=>{const a=M.nv&&M.nv.f>=1;clearInterval(NT);NT=null;M._nv=null;M.nr=null;M.fk=null;M.from=null;S.stack=['mapview'];M.sel=null;render('pop');toast(a?L('Trip finished','Urugendo rurarangiye','Trajet terminé'):L('Navigation ended','Kuyobora byahagaze','Navigation arrêtée'))};
window.mpNext=()=>{};
screens.nav=()=>{const N=M.nr;if(!N)return '';M._r={list:[N.r],sel:0,mode:N.mode};M._pins=false;const u=nvui();return `<div style="position:relative">${gm(540)}<div id="nvb" style="position:absolute;left:10px;right:10px;top:10px">${u.top}</div>${ctl(130)}</div><div class="cta" id="nvf">${u.bot}</div>`};
if(document.title)document.title=document.title.replace(/v\d+/,'v499');
})()}catch(e){console.error('maps-v499',e)}
/* v501: Directions, Naver / Kakao style. Route cards with a leg bar (walk / bus line colours, proportional), fare, boarding stop and next-bus time, expandable stops timeline with clock times, depart-time chips (Now / +15 / +30 / +1 h), bus sort chips (Recommended / Fastest / Fewest transfers / Least walking), car routes coloured by traffic with taxi fare and delay, walk / bike with steps and kcal, and real turn-by-turn navigation: next-turn banner with distance, "Then" preview, moving heading arrow on the map, ETA and distance left, speed, voice prompts, overview toggle and arrival. Code is in the v499 block (route screen) so it shares the road network. */
/* v500: Place page, more like Naver / Kakao Place. Before: the first screen was a flat colour block with one emoji, the hours were one line, Home ended after four info rows, Directions and Pay here sat in the scrolling header (the bottom bar from v498 was missing). Now: a photo strip (one large and two small tiles, "+N" count) that opens Photos, tappable hours that expand to the week with today marked and the last order time, a Reviews block (big rating, stars, 5-to-1 bars, two visitor reviews, See all), a Menu list with prices for cafes and food, a Busy hours chart, and Directions + Pay here pinned in a bar at the bottom. */
try{(function(){
const L=(e,r,f)=>({en:e,rw:r,fr:f}[S.lang]||e),M=S.mp,_p=screens.place;
const hs=s=>{let h=0;for(const c of String(s))h=(h*31+c.charCodeAt(0))>>>0;return h};
const COL={cafe:['#5B3A29','#8A5A3C','#C49A6C'],food:['#A8452B','#D9722F','#F0A95A'],pharm:['#1F7A5A','#3FA37F','#8FD1B5'],hosp:['#2E5FA8','#5B8FD1','#A9C6EA'],atm:['#454D5A','#6B7482','#A5ADBA'],bus:['#2F6B2A','#4F9A45','#9FD197']};
const MENU={cafe:[['Cappuccino',3500],['Iced latte',4000],['Butter croissant',2500],['Rwandan drip coffee',3000]],food:[['Grilled brochette',5000],['Chicken and chips',6500],['Fresh fish plate',8000],['Veggie rice bowl',4500]]};
const REV=[['Aline','Great place, friendly staff and quick service. I will come back.','2 days ago',5],['Eric','Clean and calm. A little busy at lunch but worth it.','1 week ago',4],['Divine','Good value for the price. Easy to find near the main road.','2 weeks ago',5],['Jean Paul','Nice atmosphere and a welcoming owner.','3 weeks ago',4]];
const DAYS=['Mon','Tue','Wed','Thu','Fri','Sat','Sun'],fm=n=>Number(n).toLocaleString('en-US');
const dist=r=>{const a=[Math.pow(r/5,7),Math.pow(r/5,4)*.45,.1,.04,.03],t=a.reduce((x,y)=>x+y,0);return a.map(v=>Math.round(v/t*100))};
const st=document.createElement('style');st.textContent='.pz-ph{display:grid;grid-template-columns:2fr 1fr;grid-template-rows:1fr 1fr;gap:3px;height:176px;margin:14px 16px 0;border-radius:20px;overflow:hidden;cursor:pointer}.pz-ph>div{display:flex;align-items:center;justify-content:center;position:relative;font-size:28px}.pz-ph>div:first-child{grid-row:1/3;font-size:60px}.pz-ph em{position:absolute;right:8px;bottom:6px;background:rgba(0,0,0,.55);color:#fff;font-style:normal;font-size:12px;font-weight:800;padding:2px 8px;border-radius:10px}.pz-s{margin:22px 16px 0;padding-top:20px;border-top:1px solid var(--ln)}.pz-h{display:flex;align-items:baseline;gap:8px;font-size:18px;font-weight:800}.pz-h a{margin-left:auto;font-size:14px;font-weight:700;color:var(--lk);cursor:pointer}.pz-b{display:flex;align-items:center;gap:8px;font-size:12px;color:var(--mu);height:17px}.pz-b i{flex:1;height:6px;border-radius:3px;background:var(--chip)}.pz-b u{display:block;height:6px;border-radius:3px;background:#F5B301}.pz-rv{padding:14px 0;border-top:1px solid var(--ln)}.pz-rv:first-of-type{border-top:0}.pz-d{display:flex;justify-content:space-between;font-size:14px;color:var(--mu);padding:5px 0}.pz-d.on{color:var(--tx);font-weight:800}.pz-mn{display:flex;align-items:center;gap:12px;padding:10px 0;font-size:15px}.pz-mn i{width:44px;height:44px;border-radius:12px;background:var(--chip);display:flex;align-items:center;justify-content:center;font-style:normal;font-size:22px}.pz-bz{display:flex;align-items:flex-end;gap:6px;height:64px;margin-top:14px}.pz-bz i{flex:1;border-radius:4px 4px 0 0;background:var(--chip)}.pz-bz i.on{background:var(--br)}';document.head.appendChild(st);
window.plHrs=()=>{S.hrs=!S.hrs;render('fade-none')};
screens.place=()=>{let h=_p();if(!M.exp)return h;const p=POI.find(x=>x.n===PL.n);if(!p||h.indexOf('class="ptabs"')<0)return h;
const lab=(h.match(/class="btn p"[^>]*>Directions<span class="s">([^<]*)<\/span>/)||[])[1]||'';
h=h.replace(/<div class="pz-cta">[\s\S]*?<\/div>/,'').replace(/<div style="height:30px"><\/div>(?![\s\S]*<div style="height:30px">)/,'<div style="height:104px"></div>');
const bar=h.indexOf('class="cta"')<0?`<div class="cta" style="display:flex;gap:10px"><button class="btn" style="flex:1.4" onclick="mpDir('${p.id}')">${L('Directions','Inzira','Itinéraire')}${lab?' · '+lab:''}</button><button class="btn sec2" style="flex:1" onclick="plPay()">${L('Pay here','Ishyura hano','Payer ici')}</button></div>`:'';
if(M.tab!=='home')return h+bar;
const n=hs(p.id),c=COL[p.c]||COL.cafe,r=parseFloat(p.r)||0,cnt=(String(p.r).match(/\(([^)]+)\)/)||[])[1]||'0',goods=p.c==='cafe'||p.c==='food'||p.c==='pharm'||p.c==='hosp';
h=h.replace(/<div style="margin:14px 16px 0;height:120px;border-radius:24px;background:[^>]*>[^<]*<\/div>/,`<div class="pz-ph" role="button" aria-label="${L('Photos','Amafoto','Photos')}" onclick="mpSet('tab','photos')"><div style="background:${c[0]}">${p.e}</div><div style="background:${c[1]}">${p.e}</div><div style="background:${c[2]}">${p.e}<em>+${6+n%20}</em></div></div>`);
if(goods&&/Open|Closed/.test(p.o||'')){const m=(p.o||'').match(/(\d\d:\d\d)/),cl=m?m[1]:'22:00',t=(m?+cl.slice(0,2)*60+ +cl.slice(3):1320)-30,lo=String(Math.floor(t/60)).padStart(2,'0')+':'+String(t%60).padStart(2,'0'),td=(new Date().getDay()+6)%7;
h=h.replace(/<div class="fi">(<svg[\s\S]*?<\/svg>)<div>(<b[^>]*>(?:Open|Closed)<\/b>[^<]*)<\/div><\/div>/,(a,ic0,s)=>`<div class="fi tap" role="button" aria-expanded="${!!S.hrs}" onclick="plHrs()" style="cursor:pointer">${ic0}<div style="flex:1">${s}</div><span style="transform:rotate(${S.hrs?270:90}deg);display:inline-flex">${ic('chev',16,'var(--tt)')}</span></div>${S.hrs?`<div style="padding:0 0 6px 44px">${DAYS.map((d,i)=>`<div class="pz-d ${i===td?'on':''}"><span>${d}</span><span>${i===6?'09:00':'07:00'} – ${cl}</span></div>`).join('')}${p.c==='cafe'||p.c==='food'?`<div class="pz-d"><span>${L('Last order','Itegeko rya nyuma','Dernière commande')}</span><span>${lo}</span></div>`:''}</div>`:''}`)}
let x='';
if(r){const d=dist(r),full=Math.round(r);x+=`<div class="pz-s"><div class="pz-h">${L('Reviews','Ibitekerezo','Avis')}<span class="mu" style="font-weight:600;font-size:15px">${cnt}</span><a onclick="mpSet('tab','reviews')">${L('See all','Byose','Tout voir')} ›</a></div><div style="display:flex;gap:22px;align-items:center;margin-top:14px"><div style="text-align:center"><div style="font-size:40px;font-weight:800;letter-spacing:-1px;line-height:44px">${r.toFixed(1)}</div><div style="color:#F5B301;font-size:14px;letter-spacing:2px">${'★'.repeat(full)}${'☆'.repeat(5-full)}</div></div><div style="flex:1">${d.map((v,i)=>`<div class="pz-b"><span>${5-i}</span><i><u style="width:${v}%"></u></i></div>`).join('')}</div></div><div style="margin-top:10px">${[0,1].map(i=>{const v=REV[(n+i)%REV.length];return `<div class="pz-rv"><div style="display:flex;align-items:center;gap:10px"><span style="width:32px;height:32px;border-radius:16px;background:var(--tint);color:var(--tintfg);display:flex;align-items:center;justify-content:center;font-weight:800">${v[0][0]}</span><div><b style="font-size:15px">${v[0]}</b><div class="sm mu"><span style="color:#F5B301">★ ${v[3]}</span> · ${v[2]}</div></div></div><div style="margin-top:8px;font-size:15px;line-height:22px">${v[1]}</div></div>`}).join('')}</div></div>`}
if(MENU[p.c]){x+=`<div class="pz-s"><div class="pz-h">${L('Menu','Menu','Menu')}</div>${MENU[p.c].slice(0,3).map(([a,b])=>`<div class="pz-mn"><i>${p.e}</i><span style="flex:1;font-weight:600">${a}</span><b>${fm(b)} RWF</b></div>`).join('')}</div>`}
if(p.c==='cafe'||p.c==='food'){const hr=new Date().getHours(),bz=[8,10,12,14,16,18,20].map((t,i)=>({t,v:28+(hs(p.id+i)%50)+(t===12||t===14?22:0)}));x+=`<div class="pz-s"><div class="pz-h">${L('Busy hours','Igihe cyuzuye','Heures de pointe')}</div><div class="pz-bz">${bz.map(b=>`<i class="${hr>=b.t&&hr<b.t+2?'on':''}" style="height:${b.v}%"></i>`).join('')}</div><div style="display:flex;justify-content:space-between;font-size:11px;color:var(--tt);margin-top:6px">${bz.map(b=>`<span style="flex:1;text-align:center">${b.t}</span>`).join('')}</div><div class="sm mu" style="margin-top:8px">${L('Usually busiest 12:00 – 14:00','Hakunze kuba huzuye 12:00 – 14:00','Souvent plein de 12h à 14h')}</div></div>`}
const k='<div class="pz-ai">',i=h.indexOf(k);h=i<0?h.replace(/(<div style="height:104px">)/,x+'$1'):h.slice(0,i)+x+h.slice(i);
return h+bar};
if(document.title)document.title=document.title.replace(/v\d+/,'v501');
})()}catch(e){console.error('place-v500',e)}
</script>
<script>
/* v509 (adds to v508 and v502, below): a Popular near you strip of the busiest listings above the list, quick questions to the seller (Is it still available?, Can you do a lower price?, Where can we meet?) that open the chat with that message ready, and two neighbour comments about the seller. v508 (adds to v502, below): Marketplace gets Free sharing (a Free chip and free items shown as Free), owner controls to mark a listing Reserved, Available again or Sold, on a buyer's page the listing's chats, saves and views, suggested public meet-up spots near the seller's area, and more from the same seller, and an Alert me button when a search finds nothing. v502: Marketplace, a real neighbourhood marketplace (Daangn style). Before: one flat list of items with a search box. Now: you pick your neighbourhood and range (My area, up to 3 km, up to 8 km) and only see listings near you, each with its distance and how long ago it was posted; rows show a big photo tile, price, Reserved / Sold badges, chat and save counts; Latest / Nearest sort; Saved and Mine tabs; a friendly empty state that widens the range. Listing page: seller card with a manner temperature, verified-neighbour badge, reply rate and deals done, a safe meet-up note, and a Bump to top button on your own listings. English only; rw/fr need native review. */
try{(function(){
const H=HD.market,esc=s=>String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/"/g,'&quot;');
const AR={Kimironko:[5,3],Remera:[3.5,2],Kacyiru:[1,3.5],Gisozi:[1,6],Nyamirambo:[-3,1],Kicukiro:[3,-3]};
const RAD=[[0,'My area'],[3,'Up to 3 km'],[8,'Up to 8 km']],CT=['All','Electronics','Phones','Home','Fashion','Kids','Sports','Free','Saved','Mine'];
if(S.mxHood===undefined){S.mxHood='Kimironko';S.mxRad=1;S.mxSortN=0;S.mxCt='All'}
S.mxHide=S.mxHide||{};
if(!H.fr){H.fr=1;H.items.push({id:901,ti:'Baby clothes, 0–12 months',g:'bag',p:0,sub:'Kimironko · 2 h ago',who:'Aline N.',c:'Kids',cond:'Good',d:'Clean baby clothes my daughter outgrew. Free to a neighbour who can use them. Pick up near Kimironko.'},{id:902,ti:'Wooden bookshelf',g:'house',p:0,sub:'Remera · Yesterday',who:'Joseph T.',c:'Home',cond:'Fair',d:'Sturdy shelf with a few scratches. You collect it.'},{id:903,ti:'Senior 2 textbooks',g:'school',p:0,sub:'Kacyiru · 5 h ago',who:'Claire U.',c:'Kids',cond:'Good',d:'Full set of Senior 2 books. Free for a student who needs them.'})}
const hs=n=>{let h=0;String(n).split('').forEach(c=>h=(h*31+c.charCodeAt(0))>>>0);return h};
const dist=(a,b)=>{const p=AR[a],q=AR[b];return p&&q?Math.hypot(p[0]-q[0],p[1]-q[1]):(a===b?0:4)};
const area=x=>x.sub.split(' · ')[0],when=x=>x.sub.split(' · ')[1]||'Just now';
const age=x=>{const s=when(x);let m;if(/now|min/i.test(s))return 0;if(m=s.match(/(\d+)\s*h/))return+m[1];if(/yesterday/i.test(s))return 24;if(m=s.match(/(\d+)\s*d/))return m[1]*24;return 48};
const km=x=>{const d=dist(S.mxHood,area(x));return d<.5?'0.'+(2+hs(x.id)%6)+' km':d.toFixed(1)+' km'};
const list=()=>{const q=S.mkQ.trim().toLowerCase(),c=S.mxCt,F=S.mxf||{cond:[],max:0,hood:''},R=RAD[S.mxRad][0];
const l=H.items.filter(x=>!S.mxHide[x.id]&&(c==='All'||x.c===c||(c==='Free'&&x.p===0)||(c==='Saved'&&S.hdFav['market:'+x.id])||(c==='Mine'&&x.who==='You'))&&(c==='Saved'||c==='Mine'||dist(S.mxHood,area(x))<=R)&&(!q||(x.ti+' '+x.sub).toLowerCase().includes(q))&&(!F.cond.length||F.cond.includes(x.cond))&&(!F.max||x.p<=F.max)&&(!F.hood||area(x)===F.hood));
return l.sort(S.mxSortN?(a,b)=>dist(S.mxHood,area(a))-dist(S.mxHood,area(b)):(a,b)=>age(a)-age(b))};
const row=x=>{const st=x.st==='sold'?'Sold':x.st==='reserved'?'Reserved':'',ch=2+hs('c'+x.id)%9,lk=1+hs('l'+x.id)%14+(S.hdFav['market:'+x.id]?1:0);
return `<div class="dg-r" role="button" tabindex="0" onclick="hdOpen('market',${x.id})"><div class="dg-th" style="${x.st==='sold'?'opacity:.5':''}">${gl(x.g,44)}</div><div class="dg-b"><div class="dg-t">${esc(x.ti)}</div><div class="dg-s">${esc(area(x))} · ${km(x)} · ${esc(when(x))}</div><div class="dg-p">${st?`<span class="dg-st ${st==='Sold'?'sd':''}">${st}</span>`:''}${x.p?fmt(x.p)+' RWF':'Free'}</div><div class="dg-m">${x.neg?'<span>Negotiable</span>':''}<span>💬 ${ch}</span><span>♡ ${lk}</span></div></div><span class="dg-h" onclick="event.stopPropagation()">${hdHeart('market',x.id)}</span></div>`};
const body=()=>{const l=list();if(!l.length)return `<div class="dg-e"><div style="font-size:40px">🏘️</div><b>${S.mxCt==='Saved'?'Nothing saved yet':S.mxCt==='Mine'?'You have not sold anything yet':'Nothing near '+S.mxHood+' yet'}</b><div class="sm mu">${S.mxCt==='Saved'?'Tap the heart on a listing to keep it here.':S.mxCt==='Mine'?'List something and neighbours can chat with you.':'Try a wider range, or be the first neighbour to list something.'}</div><div style="display:flex;gap:10px;justify-content:center;margin-top:14px">${S.mkQ.trim()?'<button class="cch" onclick="mxAlert()">🔔 Alert me</button>':''}${S.mxRad<2&&S.mxCt!=='Saved'&&S.mxCt!=='Mine'?'<button class="cch" onclick="mxSetRad(2)">Widen range</button>':''}<button class="cch on" onclick="hdPost()">Sell something</button></div></div>`;return hot()+l.map(row).join('')};
const hot=()=>{if(S.mxCt!=='All'||S.mkQ.trim())return '';const l=list().filter(x=>!x.st).sort((a,b)=>hs('c'+b.id)%9-hs('c'+a.id)%9).slice(0,4);return l.length<2?'':`<div style="padding:12px 24px 0"><b>Popular near ${esc(S.mxHood)}</b><div style="display:flex;gap:8px;overflow-x:auto;padding-top:8px">${l.map(x=>`<button class="cch" style="flex:none" onclick="hdOpen('market',${x.id})">🔥 ${esc(x.ti)} · ${x.p?fmt(x.p):'Free'}</button>`).join('')}</div></div>`};
const QS=['Is it still available?','Can you do a lower price?','Where can we meet?'],RQ=['Arrived on time.','Item exactly as described.','Friendly and fair.','Easy to deal with.'];
window.mxAsk=(id,i)=>{const x=H.items.find(y=>y.id===id);if(!x)return;const th='hdmarket'+id;hdThread(th,x.who,x.ti,[['me',QS[i]]]);S.tab='messages';openChat(th)};
const bar_=()=>{const F=S.mxf||{cond:[],max:0,hood:''},n=F.cond.length+(F.max?1:0)+(F.hood?1:0);return `<span class="mu sm">${list().length} near ${esc(S.mxHood)}</span><span style="flex:1"></span><button class="cch" onclick="mxSortT()">${S.mxSortN?'Nearest':'Latest'} ⇅</button><button class="cch ${n?'on':''}" onclick="mxFilt()">Filter${n?' · '+n:''}</button>`};
const chips=()=>CT.map(c=>`<button class="cch ${S.mxCt===c?'on':''}" onclick="mxPick('${c}')">${c}</button>`).join('');
window.mxRedraw=()=>{if($('#mxl2'))$('#mxl2').innerHTML=body();if($('#mxcc'))$('#mxcc').innerHTML=chips();if($('#mxbr'))$('#mxbr').innerHTML=bar_()};
window.mxPick=c=>{S.mxCt=c;mxRedraw()};window.mxSortT=()=>{S.mxSortN=S.mxSortN?0:1;mxRedraw()};
window.mxSearch=v=>{S.mkQ=v;mxRedraw()};
window.mxSetHood=a=>{S.mxHood=a;closeSheet();render('fade-none')};
window.mxSetRad=i=>{S.mxRad=i;closeSheet();render('fade-none')};
window.mxHoodSheet=()=>{$('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="h1" style="font-size:22px;line-height:30px">Your neighbourhood</div><div class="sm mu" style="margin-top:6px;line-height:20px">You see listings from here and nearby, so you can meet and hand over in minutes.</div><div style="margin-top:10px">'+Object.keys(AR).map(a=>`<div class="dg-o" role="button" tabindex="0" onclick="mxSetHood('${a}')"><span>${a}</span><b>${S.mxHood===a?'✓':''}</b></div>`).join('')+'</div><div class="lab" style="margin-top:14px">Range</div><div class="dg-sg">'+RAD.map(([k,l],i)=>`<button class="${S.mxRad===i?'on':''}" onclick="mxSetRad(${i})">${l}</button>`).join('')+'</div></div>'};
window.mxSt=(id,v)=>{const x=H.items.find(i=>i.id===id);if(!x)return;x.st=v;toast(v==='sold'?'Marked as sold':v==='reserved'?'Marked as reserved':'Available again');render('fade-none')};
window.mxAlert=()=>{const q=S.mkQ.trim();if(!q)return;S.mxAl=S.mxAl||[];if(!S.mxAl.includes(q))S.mxAl.push(q);toast('We will tell you when a neighbour near '+S.mxHood+' lists '+q)};
window.mxBump=id=>{const x=H.items.find(i=>i.id===id);if(!x)return;x.sub=area(x)+' · Just now';toast('Moved to the top of '+area(x));render('fade-none')};
const oR=window.rf2;window.rf2=function(){if(S.hd==='market'&&$('#mxl2'))mxRedraw();else if(oR)return oR.apply(this,arguments)};
const oT=window.hdTg;window.hdTg=function(t,id){oT.apply(this,arguments);if(t==='market'&&S.mxCt==='Saved'&&$('#mxl2'))mxRedraw()};
if(!$('#dg502')){const s=document.createElement('style');s.id='dg502';s.textContent=`.dg-loc{display:flex;align-items:center;gap:10px;padding:12px 24px 0}.dg-hb{border:0;background:none;color:var(--tx);font:inherit;font-size:20px;font-weight:800;padding:0;display:flex;align-items:center;gap:6px}.dg-hb i{font-style:normal;font-size:13px;color:var(--tt)}.dg-v{font-size:12px;font-weight:700;padding:3px 9px;border-radius:12px;background:var(--tint);color:var(--tintfg)}.dg-q{margin:12px 24px 0}.dg-q input{width:100%;height:44px;border-radius:22px;border:0;background:var(--chip);color:var(--tx);font:inherit;font-size:15px;padding:0 16px}.dg-ib{display:flex;align-items:center;gap:8px;padding:12px 24px 0}.dg-r{position:relative;display:flex;gap:14px;padding:16px 24px;border-bottom:1px solid var(--chip);cursor:pointer}.dg-th{width:96px;height:96px;flex:none;border-radius:16px;background:var(--tint);display:flex;align-items:center;justify-content:center}.dg-b{flex:1;min-width:0;display:flex;flex-direction:column;gap:3px;padding-right:30px}.dg-t{font-size:16px;line-height:22px;font-weight:600;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical}.dg-s{font-size:13px;color:var(--tt)}.dg-p{font-size:17px;font-weight:800;display:flex;align-items:center;gap:6px}.dg-st{font-size:12px;font-weight:700;padding:2px 8px;border-radius:10px;background:var(--tint);color:var(--tintfg)}.dg-st.sd{background:var(--chip);color:var(--tt)}.dg-m{display:flex;gap:10px;justify-content:flex-end;font-size:13px;color:var(--tt);margin-top:auto}.dg-m span:first-child:not(:last-child){margin-right:auto}.dg-h{position:absolute;right:18px;top:12px}.dg-e{text-align:center;padding:48px 24px;display:flex;flex-direction:column;gap:6px;align-items:center}.dg-o{display:flex;justify-content:space-between;padding:14px 4px;font-size:17px;font-weight:600;border-bottom:1px solid var(--chip);cursor:pointer}.dg-sg{display:flex;gap:6px;background:var(--chip);border-radius:14px;padding:4px;margin-top:8px}.dg-sg button{flex:1;height:40px;border:0;border-radius:11px;background:none;color:var(--tx);font:inherit;font-size:14px;font-weight:600}.dg-sg button.on{background:var(--bg,#fff);box-shadow:0 1px 4px rgba(0,0,0,.14)}.dg-sel{margin:16px 24px 0;padding:16px;border-radius:20px;background:var(--chip)}.dg-sr{display:flex;align-items:center;gap:12px}.dg-av{width:44px;height:44px;border-radius:22px;background:var(--tint);color:var(--tintfg);display:flex;align-items:center;justify-content:center;font-weight:800;font-size:18px}.dg-tmp{text-align:right;min-width:92px}.dg-tb{height:5px;border-radius:3px;background:var(--tint);margin:4px 0 2px;overflow:hidden}.dg-tb i{display:block;height:100%}.dg-tmp span{font-size:11px;color:var(--tt)}.dg-n{font-size:13px;color:var(--tt);margin-top:12px;line-height:19px}`;document.head.appendChild(s)}
const oS=screens.hood;screens.hood=function(){if(S.hd!=='market')return oS.apply(this,arguments);
return `${bar('Marketplace')}<div class="dg-loc"><button class="dg-hb" onclick="mxHoodSheet()">📍 ${esc(S.mxHood)} <i>▾</i></button><span class="dg-v">✓ Verified area</span></div><div class="dg-q"><input id="mxq" type="search" aria-label="Search listings" placeholder="Search in ${esc(S.mxHood)}" value="${esc(S.mkQ)}" oninput="mxSearch(this.value)"></div><div class="chips" style="padding-top:12px" id="mxcc">${chips()}</div><div class="dg-ib" id="mxbr">${bar_()}</div><div id="mxl2" style="padding-top:6px">${body()}</div><div class="pad fine" style="padding-top:18px">Listings are sample data for this prototype.</div><div class="fab"><button class="btn" onclick="hdPost()" style="height:46px;padding:0 20px;font-size:15px;border-radius:23px;width:auto">+ Sell</button></div>`};
const oI=screens.hoodItem;screens.hoodItem=function(){const h=oI.apply(this,arguments);if(S.hd!=='market'||h.includes('dg-sel'))return h;const x=H.items.find(i=>i.id===S.hdI);if(!x)return h;
const mine=x.who==='You',tmp=mine?36.5:36.5+(hs(x.who)%80)/10,col=tmp<37.5?'#4C8DF6':tmp<40?'#2E9E5B':'#F08A24',a=area(x);
const card=mine?`<div class="dg-sel"><div class="dg-sr"><div class="dg-av">${esc(x.who[0])}</div><div style="flex:1"><b>Your listing</b><div class="sm mu">${esc(a)} · posted ${esc(when(x))}</div></div></div><div class="dg-n">💬 ${2+hs('c'+x.id)%9} chats · ♡ ${1+hs('l'+x.id)%14} saves · 👁 ${20+hs('v'+x.id)%80} views</div><button class="cch on" style="margin-top:10px;height:44px" onclick="mxBump(${x.id})">Bump to top</button>${x.st==='sold'?'':`<div style="display:flex;gap:8px;margin-top:8px"><button class="cch" onclick="mxSt(${x.id},'${x.st==='reserved'?'':'reserved'}')">${x.st==='reserved'?'Mark available':'Mark reserved'}</button><button class="cch" onclick="mxSt(${x.id},'sold')">Mark sold</button></div>`}</div>`:`<div class="dg-sel"><div class="dg-sr"><div class="dg-av">${esc(x.who[0])}</div><div style="flex:1;min-width:0"><b>${esc(x.who)}</b><div class="sm mu">${esc(a)} · Verified neighbour</div></div><div class="dg-tmp"><b style="color:${col}">${tmp.toFixed(1)}°C</b><div class="dg-tb"><i style="width:${Math.min(100,(tmp-30)*5)}%;background:${col}"></i></div><span>Manner temperature</span></div></div><div class="dg-n">Replies within an hour · ${70+hs(x.who)%30}% reply rate · ${3+hs(x.who)%20} deals done</div></div><div class="dg-n" style="margin:10px 24px 0">📍 Meet in a public place near ${esc(a)}, like a bus stop, shop or café. Check the item before you pay.</div>`;
let extra='';if(!mine){const o=H.items.filter(y=>y.who===x.who&&y.id!==x.id&&!y.st).slice(0,3);
extra=`<div class="dg-sel" style="margin-top:12px"><div class="dg-n" style="margin:0">💬 ${2+hs('c'+x.id)%9} chats · ♡ ${1+hs('l'+x.id)%14} saves · 👁 ${20+hs('v'+x.id)%80} views</div>${x.st?'':`<div class="lab" style="margin-top:12px">Ask the seller</div><div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:6px">${QS.map((q,i)=>`<button class="cch" onclick="mxAsk(${x.id},${i})">${q}</button>`).join('')}</div>`}<div class="sm" style="line-height:21px;margin-top:12px;color:var(--mu)">💬 “${RQ[hs(x.who)%4]}”<br>💬 “${RQ[(hs(x.who)+2)%4]}”<div style="font-size:12px;color:var(--tt);margin-top:2px">From neighbours who dealt with ${esc(x.who)}</div></div><div class="lab" style="margin-top:12px">Suggested public meet-up spots</div><div class="sm" style="line-height:21px">📍 ${esc(a)} bus stop<br>📍 ${esc(a)} market<br>📍 ${esc(a)} sector office</div></div>${o.length?`<div class="dg-sel" style="margin-top:12px"><b>More from ${esc(x.who)}</b><div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:8px">${o.map(y=>`<button class="cch" onclick="hdOpen('market',${y.id})">${esc(y.ti)}</button>`).join('')}</div></div>`:''}`}
const c=h.indexOf('<div class="cta"');return c>0?h.slice(0,c)+card+extra+h.slice(c):h+card+extra};
if(document.title)document.title=document.title.replace(/v\d+/,'v502');
})()}catch(e){console.error('market-v502',e)}
</script>
<script>
/* v510 (adds to v503, below): Post a job now starts with the shift (days and hours), number of openings and perks (Paid same day, Meal included, Transport), and sets the work location to your neighbourhood; rows and job pages show perks and openings; a Map view shows a pin per area with the number of open jobs, tap a pin to see that area. v503: Jobs, a real neighbourhood job board (Daangn Alba style). Before: one flat list of sample jobs with Part-time / Gig chips. Now: Jobs shares your neighbourhood and range with Marketplace (📍 on top; My area, up to 3 km, up to 8 km), so you only see work close to home. Each row shows distance, how long ago it was posted, pay with the hourly equivalent, the shift (days and hours), a type tag (New, Start ASAP, Part-time, Gig), applicants and your application status. Categories (Food, Shop, Delivery, Cleaning, Tutoring, Events, Office) plus Saved, Applied, Mine; Latest / Nearest sort; Filter and Profile still work. Job page: a When and where card (shift, pay per hour, distance with walk or moto time, posted, applicants), an employer card (verified local business, manner temperature, reply rate, people hired, two neighbour reviews) and a never-pay-to-get-a-job note. Your own jobs show chats, saves, views, applicants and Bump to top. Five new sample jobs so every neighbourhood has work. English only; rw/fr need native review. */
try{(function(){
const H=HD.jobs,esc=s=>String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/"/g,'&quot;');
const AR={Kimironko:[5,3],Remera:[3.5,2],Kimihurura:[2.5,2.5],Kacyiru:[1,3.5],Gisozi:[1,6],Nyamirambo:[-3,1],Nyabugogo:[-3,-1],Kicukiro:[3,-3]};

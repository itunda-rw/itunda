let sheet;if(sel){const me=mePt,B={n:sel.n,p:pp(sel)},ti=['bus','car','walk','bike'].map((m,i)=>`<span class="tg" style="font-size:13px">${['🚌','🚗','🚶','🚲'][i]} ${tm(rt(m,me,B)[0].secs)}</span>`).join(' ');
sheet=`<div class="sh2"><div class="hdl" onclick="mpPin('${sel.id}')"></div><div style="display:flex;align-items:center;gap:8px"><b style="flex:1;font-size:22px;letter-spacing:-.3px">${sel.n}</b><button class="ib" style="background:var(--chip);border-radius:22px" aria-label="Close" onclick="mpPin('${sel.id}')">${X_}</button></div><div class="sm mu" style="margin-top:4px">${sel.k}${sel.r?' · <span style="color:#F5B301">★</span> '+sel.r:''}</div><div style="margin-top:6px;font-size:15px"><b style="color:#2BA84A">${sel.o}</b> · ${sel.d} ${L('from you','uvuye hano','de vous')}</div><div style="margin-top:10px;display:flex;gap:6px;flex-wrap:wrap">${ti}</div><div class="acts" style="padding:14px 0 0"><button class="q" onclick="mpDir('${sel.id}')">${L('Directions','Inzira','Itinéraire')}</button><button class="p" onclick="mpFrom('${sel.id}')">${L('Depart','Gutangira','Départ')}</button><button onclick="mpOpenPoi('${sel.id}')">${L('Details','Amakuru','Détails')}</button><button onclick="toast('${L('Link copied','Link yakopowe','Lien copié')}')">${L('Share','Sangiza','Partager')}</button></div></div>`}
else sheet=`<div class="sh2"><div class="hdl"></div><b style="font-size:19px">${L('Nearby','Hafi yawe','À proximité')}</b>${vis.slice().sort((a,b)=>parseFloat(a.d)-parseFloat(b.d)).slice(0,5).map(p=>`<div class="pc tap" onclick="mpPin('${p.id}')"><i>${p.e}</i><div style="flex:1;min-width:0"><b style="font-size:16px">${p.n}</b><div class="sm mu">${p.k}${p.r?' · ★ '+p.r:''}</div></div><span class="sm mu">${p.d}</span></div>`).join('')}</div>`;
return `<div style="position:relative"><div class="mvs"><button class="ib" aria-label="Back" onclick="back()" style="color:var(--tx)">${ic('back',22)}</button><span style="flex:1" onclick="mpGo('mapsearch')">${L('Search places, bus stops, addresses','Shakisha ahantu, aho bisi zihagarara','Lieux, arrêts, adresses')}</span><button class="ib" aria-label="Search" onclick="mpGo('mapsearch')">${ic('search',20,'var(--tt)')}</button></div><div class="mcs mvc" style="padding:0 12px">${CATS.map(([k,l])=>`<button class="ocp ${M.cat===k?'on':''}" onclick="mpCat('${k}')">${l}</button>`).join('')}</div>${gm(480)}<button class="mb" style="top:130px" aria-label="Layers" onclick="mpLayer()">${ic('grid',20,M.layer?'var(--lk)':'var(--tx)')}</button>${ctl(182)}<button class="mb" style="bottom:46px" aria-label="My location" onclick="mpLoc()">${ic('pin',20,'#2E6BF0')}</button>${M.layer?`<div style="position:absolute;left:12px;bottom:46px;background:var(--bg);border-radius:14px;padding:6px 12px;font-size:13px;font-weight:700">${LAY[M.layer]}</div>`:''}</div>${sheet}<div style="height:24px"></div>`};

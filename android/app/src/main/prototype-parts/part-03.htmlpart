const fix=()=>{document.querySelectorAll('.fl > b').forEach(t=>{const f=t.parentElement,m=f.parentElement,sh=m&&m.nextElementSibling;if(t.dataset.v360||!sh||!sh.classList.contains('sh2'))return;const c=sh.querySelector('.sm.mu');if(!c)return;t.dataset.v360=1;t.textContent=c.textContent.split(/[,·]/)[0].trim()});document.querySelectorAll('.cta').forEach(c=>{if(c.dataset.v360||!c.querySelector('[onclick^="mpStart"]'))return;
 const b=c.querySelector('span > b'),sm=b&&b.parentElement.querySelector('.sm');if(!b||!sm)return;
 const m=/\d{1,2}:\d{2}\s?(?:[ap]m)?/i.exec(sm.textContent);if(!m)return;
 c.dataset.v360=1;const t=m[0].trim(),rest=sm.textContent.replace(m[0],'').trim();b.textContent=t;sm.textContent=rest})};
new MutationObserver(fix).observe(document.getElementById('phone'),{childList:true,subtree:true});fix();

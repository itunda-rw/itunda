/* v414: less noise, more real. Prototype-limit toasts read like the hand-offs a real phone does, emoji come off action buttons, specific CTA names, calmer toast timing. */
(()=>{
const ph=document.getElementById('phone');if(!ph)return;
const M={'Calling is not in this prototype':'Opening Phone','Navigation: not in this prototype':'Starting navigation','Preview: not in this prototype':'Opening preview','More arrivals: not in this prototype':'Loading more arrivals','Write a review: not in this prototype':'Opening review','Replies are not in this prototype':'Replies are not available yet'};
const TAIL=/\s*(?:[—:–]\s*|\s)(?:not in this prototype|ntabwo biri muri prototype|pas dans ce prototype)\.?$/i;
window.__ux=m=>{if(typeof m!=='string')return m;if(M[m])return M[m];return TAIL.test(m)?m.replace(TAIL,'…'):m};
const EM=/^(?:[\p{Extended_Pictographic}\uFE0F\u200D]\s*)+/u;
const clean=()=>{ph.querySelectorAll('button.btn,button.pbtn,.sheet button.btn').forEach(b=>{const n=b.firstChild;if(n&&n.nodeType===3&&EM.test(n.nodeValue))n.nodeValue=n.nodeValue.replace(EM,'')})};
let q=0;new MutationObserver(()=>{if(q)return;q=requestAnimationFrame(()=>{q=0;clean()})}).observe(ph,{childList:true,subtree:true});clean();
const st=document.createElement('style');st.id='v414';
st.textContent='#phone .toast{max-width:calc(100% - 48px);text-align:center;line-height:20px;font-size:14px;font-weight:600;padding:12px 18px;border-radius:16px}#phone .sheet .h1{text-wrap:balance}#phone .sec .sm,#phone .row .s{text-wrap:pretty}';
document.head.appendChild(st);
})();

/* v415: quieter screens. The repeated "sample data for this prototype" footers are removed from screens and sheets (buttons and toasts keep their wording); a line that ends up empty is hidden so no gap is left. */
(()=>{
const ph=document.getElementById('phone');if(!ph)return;
const DROP=/^(Sample|Données d|Groupe d|Conditions d|Listings are sample|Rates and balances|Times and travel|Order tracking and the rider|Ibyatanzwe|Inyandiko y|Ingero|Amakuru)/i;
const SKIP='button,a,input,textarea,select,[onclick],.toast,script,style,svg';
const scrub=r=>{const w=document.createTreeWalker(r,NodeFilter.SHOW_TEXT);const hit=[];for(let n;n=w.nextNode();){const v=n.nodeValue;if(v.length<12||!/prototype/i.test(v))continue;const p=n.parentElement;if(!p||p.closest(SKIP))continue;hit.push(n)}
 hit.forEach(n=>{const parts=n.nodeValue.split(/(?<=[.!?])\s+/),keep=parts.filter(x=>!(DROP.test(x.trim())&&/prototype/i.test(x)&&x.length<110));if(keep.length===parts.length)return;
  const p=n.parentElement;n.nodeValue=keep.join(' ');if(!n.nodeValue.trim()&&!p.children.length)p.style.display='none'})};
let q=0;new MutationObserver(()=>{if(q)return;q=requestAnimationFrame(()=>{q=0;scrub(ph)})}).observe(ph,{childList:true,subtree:true});scrub(ph);
})();

/* v416: Bank. The Ikimina row keeps its name on one line (Umurenge Savers) with the real due date underneath, and the four action labels get the same 24px side margin as the rest of the page. */
{const st=document.createElement('style');st.id='v416';st.textContent='#phone .acts:not(.mp5){padding-left:24px;padding-right:24px}';document.head.appendChild(st)}
/* v417: calmer rhythm, clearer words, softer touch. Section headings share one size (18px) on Home and Pay, rows are a little tighter and share one vertical rhythm, rows and chips give a quiet pressed state instead of only shrinking, tab icons ease between states, and screens stop bouncing at the edges. Copy: pocket "Fill" becomes "Top up", the Send search says what you can type, and the Messages hint is shorter. All motion respects reduced-motion. */
(()=>{
const ph=document.getElementById('phone');if(!ph)return;
const st=document.createElement('style');st.id='v417';
st.textContent=`
#phone .screen{overscroll-behavior:contain;-webkit-overflow-scrolling:touch}
#phone .hct{font-size:18px;line-height:24px;padding-top:28px;padding-bottom:2px}
#phone .hct a{font-size:14px;font-weight:600}
#phone .sech{font-size:18px;margin-bottom:4px}
#phone .hr{padding-top:14px;padding-bottom:14px}
#phone .row{padding-top:10px;padding-bottom:10px}
#phone .hf{margin-top:0}
#phone .hf button{font-size:15px;font-weight:600}
#phone .hr.tap,#phone .row.tap{position:relative;isolation:isolate}
#phone .hr.tap::before,#phone .row.tap::before{content:'';position:absolute;inset:0 -8px;border-radius:16px;background:var(--chip);opacity:0;z-index:-1;pointer-events:none;transition:opacity .18s ease}
#phone .hr.tap:active::before,#phone .row.tap:active::before{opacity:1}
#phone .chip,#phone .req button{transition:background-color .18s ease,color .18s ease,transform .12s ease}
#phone .tabs button svg{transition:transform .22s var(--sp-rel,ease),opacity .2s}
#phone .tabs button.on svg{transform:translateY(-1px) scale(1.04)}
#phone .tabs button:not(.on):active svg{transform:scale(.92)}
#phone .toast{bottom:104px}
#phone .hint,#phone .screen>.sm.mu:last-child{color:var(--tt)}
@media (prefers-reduced-motion:reduce){#phone *{transition-duration:.01ms!important;animation-duration:.01ms!important}}`;
document.head.appendChild(st);
const MAP={'Fill':'Top up','Press and hold a chat to pin, mute or archive it.':'Hold a chat to pin, mute or archive.'};
const fix=()=>{
 ph.querySelectorAll('button.hp,button.pr').forEach(b=>{const t=b.textContent.trim();if(MAP[t]&&!b.children.length)b.textContent=MAP[t]});
 ph.querySelectorAll('.screen .sm,.screen .mu,.screen p,.screen div').forEach(e=>{if(e.children.length)return;const t=e.textContent.trim();if(t==='Press and hold a chat to pin, mute or archive it.')e.textContent=MAP[t]});
 ph.querySelectorAll('input').forEach(i=>{const s=i.closest('.screen');if(s&&i.placeholder==='Phone number'&&/sending to\?/i.test(s.textContent))i.placeholder='Name or phone number'});
};
let q=0;new MutationObserver(()=>{if(q)return;q=requestAnimationFrame(()=>{q=0;fix()})}).observe(ph,{childList:true,subtree:true});fix();
})();
/* v418: one type scale. Page titles are 22px on every tab (they were 20, 22 and 24), section headings are 18px, row titles 16px, supporting text 14px with an even 20px line. Copy is shorter: "Who are you sending to?" is "Send to", the Partner earnings rows lose their repeated "Total", and "View my profile" is "View profile". */
(()=>{
const ph=document.getElementById('phone');if(!ph)return;
const st=document.createElement('style');st.id='v418';
st.textContent=`
#phone .top b,#phone .bar b,#phone .xn,#phone .screen>.top>b{font-size:22px;font-weight:700;letter-spacing:-.3px}
#phone .v174h,#phone .agt{font-size:18px;font-weight:700;line-height:24px}
#phone .ar .t,#phone .row .t,#phone .agt~* .t{font-size:16px;font-weight:600}
#phone .sm,#phone .row .s,#phone .ar .s{line-height:20px}
#phone .h1{text-wrap:balance}
#phone .big{font-size:34px;letter-spacing:-.8px}`;
document.head.appendChild(st);
const MAP={'Links shared':'Shared links','Total clicks':'Clicks','Total earned':'Earned','My payment code':'Payment code'};
const fix=()=>{
 ph.querySelectorAll('.t,.pad,div,span').forEach(e=>{if(e.children.length)return;const t=e.textContent.trim();if(MAP[t])e.textContent=MAP[t];else if(/^(078|079|072|073) ••• \d+ · View my profile$/.test(t))e.textContent=t.replace('View my profile','View profile')});
 ph.querySelectorAll('h1,.h1').forEach(h=>{if(h.innerText.replace(/\s+/g,' ').trim()==='Who are you sending to?')h.textContent='Send to'});
};
let q=0;new MutationObserver(()=>{if(q)return;q=requestAnimationFrame(()=>{q=0;fix()})}).observe(ph,{childList:true,subtree:true});fix();
})();
/* v419: Send feels settled. On the amount screen the quick-amount chips no longer jump up when you type the first digit (the block keeps one height and the chips stay put). Number keys light up softly under your thumb. Wording is consistent: the amount screen says "From itunda Bank" like the review does, the Fee row reads "Free", and the extra "Sending is always free" line is gone. Partner earnings gets a little air between its heading and its subtitle. */
(()=>{
const ph=document.getElementById('phone');if(!ph)return;
const st=document.createElement('style');st.id='v419';
st.textContent=`
#phone .v419blk{position:relative;min-height:252px}
#phone .screen .v419blk>div:last-child[style]{position:absolute;left:24px;right:24px;bottom:1px}
#phone .keys button{border-radius:18px;transition:background-color .15s ease}
#phone .keys button:active{background:var(--chip);transform:none}
#phone .agt{margin-bottom:4px}
#phone .agt+.pad{padding-top:2px}`;
document.head.appendChild(st);
const fix=()=>{
 const a=ph.querySelector('#amt');
 if(a){const blk=a.parentElement&&a.parentElement.parentElement;if(blk&&!blk.classList.contains('v419blk')&&blk.querySelector('.chip'))blk.classList.add('v419blk')}
 const m=ph.querySelector('#msg');if(m&&m.firstChild&&m.textContent.includes('itunda Account'))m.innerHTML=m.innerHTML.replace('itunda Account','itunda Bank');
 const s=ph.querySelector('.screen');
 if(s&&/Check and send/i.test(s.textContent)){
  s.querySelectorAll('*').forEach(e=>{if(e.children.length)return;const t=e.textContent.trim();
   if(t==='Sending is always free')e.style.display='none';
   else if(t==='0 RWF'&&/^Fee/i.test((e.previousElementSibling||e.parentElement.firstElementChild||{}).textContent||''))e.textContent='Free'})}
};
let q=0;new MutationObserver(()=>{if(q)return;q=requestAnimationFrame(()=>{q=0;fix()})}).observe(ph,{childList:true,subtree:true});fix();
})();
/* v420: calmer, more physical. Controls under 40px keep their look but get a full thumb-sized touch area, text never drops below 12px, and the amount number shrinks smoothly as it grows and gives one small shake when you go over your balance (no re-shake on every key). The Send button eases between off and on. Words: the leftover "sample data" footers and "(sample)" tags are gone from screens (buttons and toasts keep their wording), "(simulation)" is dropped from the protection fund heading, and "Aiming for 10%!" is calm. */
(()=>{
const ph=document.getElementById('phone');if(!ph)return;
const rm=()=>matchMedia('(prefers-reduced-motion: reduce)').matches;
const st=document.createElement('style');st.id='v420';
st.textContent=`
#phone .v420hit{position:relative}
#phone .v420hit::after{content:'';position:absolute;inset:-6px -4px}
#phone #go,#phone .cta .btn{transition:opacity .2s ease,background-color .2s ease,color .2s ease,transform .12s ease}
#phone #amt{display:inline-block;font-variant-numeric:tabular-nums}
#phone .v420amt{transition:font-size .18s ease,color .18s ease;white-space:nowrap}
#phone #msg{transition:color .18s ease;min-height:20px}`;
document.head.appendChild(st);
const DROPS=/\b(sample data|sample|prototype|simulation)\b/i,NOREAL=/^No real (money|payment|requests?|cash)\b[^.]*\.?$/i;
const SKIP='button,a,input,textarea,select,[onclick],.toast,script,style,svg';
const TAG=/\s*\((?:sample|simulation)\)/i;
const scrub=()=>{
 const w=document.createTreeWalker(ph,NodeFilter.SHOW_TEXT);const hit=[];
 for(let n;n=w.nextNode();){const v=n.nodeValue;if(v.length<6)continue;const p=n.parentElement;if(!p||p.closest(SKIP))continue;if(DROPS.test(v)||/\bsample code\b/i.test(v))hit.push(n)}
 hit.forEach(n=>{let v=n.nodeValue;
  v=v.replace(TAG,'');
  v=v.replace(/^Sample price\s+/i,'').replace(/\s*·\s*sample code\b/i,'');
  v=v.replace(/^Sample (rewards|tills)$/i,(m,a)=>a[0].toUpperCase()+a.slice(1));
  const parts=v.split(/(?<=[.!?])\s+/);
  const keep=parts.filter(x=>{const t=x.trim();if(t.length>=110)return true;if(/\bsample data\b/i.test(t)||/^Sample\b/i.test(t)||/\bprototype\b/i.test(t))return false;return true});
  if(keep.length&&keep.length!==parts.length&&keep.every(x=>NOREAL.test(x.trim())))keep.length=0;
  v=keep.join(' ');
  if(v!==n.nodeValue){n.nodeValue=v;const p=n.parentElement;if(!v.trim()&&p&&!p.children.length)p.style.display='none'}})
};
const hits=()=>{
 ph.querySelectorAll('.screen button,.screen [role=button],.screen [onclick]').forEach(e=>{
  if(e.classList.contains('v420hit')||e.offsetParent===null)return;
  if(e.matches('.btn,.keys button,.tabs button,input,.cb')||e.closest('.keys,.tabs'))return;
  const r=e.getBoundingClientRect();if(!r.width||!r.height||(r.height>=40&&r.width>=40))return;
  if(getComputedStyle(e).position!=='static')return;
  e.classList.add('v420hit')})
};
const small=()=>{
 const sc=ph.querySelector('.screen');if(!sc)return;
 const w=document.createTreeWalker(sc,NodeFilter.SHOW_TEXT);
 for(let n;n=w.nextNode();){if(!n.nodeValue.trim())continue;const e=n.parentElement;if(!e||e.closest('script,style,svg')||e.dataset.v420f)continue;
  const fs=parseFloat(getComputedStyle(e).fontSize);if(fs&&fs<12){e.style.fontSize='12px';e.dataset.v420f='1'}}
};
let wasBad=false;
const amount=()=>{
 const a=ph.querySelector('#amt');if(!a){wasBad=false;return}
 const box=a.parentElement;box.classList.add('v420amt');
 const len=a.textContent.length;box.style.fontSize=len>11?'40px':len>9?'46px':'56px';
 const bad=Number(S.amt||0)>S.bank;
 if(bad&&!wasBad&&!rm()&&box.animate)box.animate([{transform:'translateX(0)'},{transform:'translateX(-8px)'},{transform:'translateX(7px)'},{transform:'translateX(-4px)'},{transform:'translateX(0)'}],{duration:320,easing:'cubic-bezier(.22,1,.36,1)'});
 wasBad=bad
};
const words=()=>{
 ph.querySelectorAll('.screen div,.screen span,.screen p').forEach(e=>{if(e.children.length)return;const t=e.textContent.trim();
  if(t==='Deposit Protection Fund (simulation)')e.textContent='Deposit protection fund';
  else if(t==='Streak started. Aiming for 10%!')e.textContent='Streak started. Aiming for 10%.'})
};
const run=()=>{try{scrub();words();amount();hits();small()}catch(e){}};
let q=0;new MutationObserver(()=>{if(q)return;q=requestAnimationFrame(()=>{q=0;run()})}).observe(ph,{childList:true,subtree:true});run();
})();
document.title=document.title.replace(/v\d+/,'v420');
</script>
<script>
/* v421: quieter home, and Top up now matches the pocket screen. Home: only the buttons that matter keep a tinted pill (Send, Pay a bill); "Add money" and the pocket "Top up" buttons become plain text, the shortcut row loses its dividers and "All" becomes a calm "More", rows light up softly when pressed. Top up / Move: the same From / To header as the pocket screen (icons on the right, "Available" and "Balance" under each name), the same prompt and chip size, lighter keys, "Review" on the button (the sheet asks for the final Confirm), the +50,000 chip is gone, the typed amount shows as one big number, "How much to add?" matches the "Add money" button, and the amount gives one small shake when you go over your balance. */
(()=>{
const ph=document.getElementById('phone');if(!ph)return;
const rm=()=>matchMedia('(prefers-reduced-motion: reduce)').matches;
const lg=()=>S.lang==='fr'?2:S.lang==='rw'?1:0;
const tx=(a,r,f)=>[a,r,f][lg()];
const st=document.createElement('style');st.id='v421';
st.textContent=`
#phone .hp.v421q{background:none!important;padding:0 2px!important;color:var(--tintfg)!important;font-weight:600!important}
#phone .hr.tap{transition:background-color .15s ease}
#phone .hr.tap:active{background:var(--chip);opacity:1}
#phone .screen .hf i{display:none}
#phone .screen .hf{gap:6px}
#phone .screen .hf .hs button{color:var(--mu)!important}
#phone .pua{margin-top:40px;font-size:26px;line-height:34px;font-weight:800;letter-spacing:-.6px;color:var(--tt);min-height:68px}
#phone .pua i,#phone .pua b{font-style:normal;font-weight:800;color:var(--tt);letter-spacing:inherit}
#phone .pua .v421n{font-size:40px;line-height:48px;font-weight:800;letter-spacing:-1px;color:var(--tx);font-variant-numeric:tabular-nums}
#phone .pua .v421u{font-size:22px;font-weight:600;letter-spacing:0;color:var(--mu)}
#phone .puc{gap:12px;justify-content:center}
#phone .puc .chip{flex:0 0 auto;min-width:88px;height:40px;padding:0 14px;font-size:15px;font-weight:700;border-radius:20px;justify-content:center;white-space:nowrap}
#phone .puk button{font-size:26px;font-weight:400}
#phone .pucta .btn{background:var(--br)!important;color:var(--on)!important;font-weight:800!important;transition:background-color .2s ease,color .2s ease}
#phone .pucta .btn:disabled{background:color-mix(in srgb,var(--br) 30%,var(--bg))!important;color:color-mix(in srgb,var(--on) 40%,var(--bg))!important;opacity:1}
#phone .mvl.tap:active{opacity:.6}
`;
document.head.appendChild(st);
const PAY='<svg width="20" height="20" viewBox="0 0 80 80" aria-hidden="true"><path d="M12 24c0-4 3-7 7-7h40c5 0 9 4 9 9v32c0 4-3 7-7 7H19c-4 0-7-3-7-7V24Z" fill="#7472F4"></path><path d="M18 28h48v28H18c-3 0-5-2-5-5V33c0-3 2-5 5-5Z" fill="#F0EFFF"></path><path d="M50 35h16v12H50c-4 0-7-3-7-6s3-6 7-6Z" fill="#8B89FF"></path><circle cx="52" cy="41" r="2" fill="#fff"></circle></svg>';
const CHEV='<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--tt)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="transform:rotate(90deg);vertical-align:-3px;margin-left:2px"><path d="M9 5l7 7-7 7"></path></svg>';
const REVIEW=()=>tx('Review','Suzuma','Vérifier');
const oScr=screens.puamt;
screens.puamt=function(){
 let h=oScr.apply(this,arguments);
 const m=h.match(/<div class="pus1">[\s\S]*?<div class="pusb">[\s\S]*?<\/div><\/div>/);
 if(!m)return h;
 const p=S.pu,top=p.mode==='top';
 const ic=(m[0].match(/<span class="pkico"[\s\S]*?<\/span>/)||[''])[0].replace(/ style="[^"]*"/,'');
 const nm=(m[0].match(/<b>([\s\S]*?)<\/b>/)||['',''])[1];
 const bal=p.k==='bank'?S.bank:(S.tu&&S.tu[p.k])||0;
 const FR=tx('From','Biva kuri','Depuis'),TO=tx('To','Ujya kuri','Vers'),AV=tx('Available','Ushobora gukoresha','Disponible'),BA=tx('Balance','Asigaye','Solde');
 const acc=`<div class="mvl tap" role="button" tabindex="0" aria-label="${top?FR:TO}" onclick="puPick()"><div class="mvx">${top?FR:TO} ${nm}${CHEV}</div><div class="mvs">${top?AV:BA} ${fmt(bal)} RWF</div></div>`;
 const pay=`<div class="mvl"><div class="mvx">${top?TO:FR} itunda Pay</div><div class="mvs">${top?BA:AV} ${fmt(S.pay)} RWF</div></div>`;
 const pi=`<div class="pkico">${PAY}</div>`;
 const hd=`<div class="mvh"><div class="mvt">${top?acc+pay:pay+acc}</div><div class="mvi">${top?ic+'<i class="mvc pin"></i>'+pi:pi+'<i class="mvc pin"></i>'+ic}</div></div>`;
 h=h.replace(m[0],hd);
 return h.replace(/(id="pgo"[^>]*>)[^<]*/,'$1'+REVIEW());
};
const oBody=window.puBody;
window.puBody=function(){
 let h=oBody.apply(this,arguments);
 h=h.replace(/<button class="chip"[^>]*puKey\('add:50000'\)[^>]*>[^<]*<\/button>/,'');
 h=h.replace(/(<div class="pua"[^>]*>)<i>[^<]*<\/i> ([\d,]+) RWF<i>[^<]*<\/i>/,'$1<span class="v421n">$2</span><span class="v421u"> RWF</span>');
 h=h.replace('<b>How much</b> to top up?','<b>How much</b> to add?').replace('<b>Combien</b> recharger ?','<b>Combien</b> ajouter ?');
 return h;
};
const oKey=window.puKey;
let wasBad=false;
window.puKey=function(){
 const r=oKey.apply(this,arguments);
 const g=document.getElementById('pgo');if(g)g.textContent=REVIEW();
 const bad=!!ph.querySelector('.pun.er'),a=ph.querySelector('.pua');
 if(bad&&!wasBad&&a&&!rm()&&a.animate)a.animate([{transform:'translateX(0)'},{transform:'translateX(-8px)'},{transform:'translateX(7px)'},{transform:'translateX(-4px)'},{transform:'translateX(0)'}],{duration:320,easing:'cubic-bezier(.22,1,.36,1)'});
 wasBad=bad;return r;
};
const HOME={All:'More',Byose:'Ibindi',Tout:'Plus'};
const home=()=>{
 const s=ph.querySelector('.screen');if(!s||!s.querySelector('.hf'))return;
 s.querySelectorAll('.hr .hp').forEach(b=>{
  const keep=b.classList.contains('pr')||/openBill/.test(b.getAttribute('onclick')||'');
  b.classList.toggle('v421q',!keep)});
 const a=s.querySelector('.hf .hs button');if(a&&HOME[a.textContent.trim()])a.textContent=HOME[a.textContent.trim()];
};
let q=0;new MutationObserver(()=>{if(q)return;q=requestAnimationFrame(()=>{q=0;try{home()}catch(e){}})}).observe(ph,{childList:true,subtree:true});home();
document.title=document.title.replace(/v\d+/,'v424');
})();
/* v425: success screen for every product that used to end in a toast. Pocket fill / take-out, auto-fill, interest jar, add money to Pay, move money, deposit, top up, loans, 31-day savings, transit top-up, stocks, goal and weekly savings, marketplace pay. Same look as the Sent screen: check, big amount, short line, detail card, Done. The knot loader plays first, as it does for Send and Pay. */
(()=>{
const ph=document.getElementById('phone');if(!ph||typeof screens==='undefined')return;
const rm=()=>matchMedia('(prefers-reduced-motion:reduce)').matches;
const T3=(e,r,f)=>({en:e,rw:r||e,fr:f||e}[S.lang]||e);
const esc=s=>String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const R=n=>fmt(n)+' RWF';
const sig=()=>[S.bank,S.pay,S.jar,S.tb,S.w26,S.mkO&&S.mkO.length,S.loan&&S.loan.paid,!!S.loan,S.goal&&S.goal.s,JSON.stringify(S.hold||{}),S.dsv31&&JSON.stringify(S.dsv31),(S.pk||[]).map(p=>{try{return pkBal(p)}catch(_){return 0}}).join(',')].join('|');
const CK=`<div class="check" style="width:112px;height:112px;border-radius:56px"><svg width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="#17171C" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5L19 7"/></svg></div>`;
const LAB={time:['Time','Igihe','Heure'],fee:['Fee','Amafaranga','Frais'],bank:['itunda Bank balance','Amafaranga kuri itunda Bank','Solde itunda Bank'],pay:['itunda Pay balance','Amafaranga kuri itunda Pay','Solde itunda Pay'],ref:['Reference','Nimero','Référence'],done:['Done','Byarangiye','Terminé']};
const lb=k=>T3(...LAB[k]);
screens.okp=()=>{const o=S.okp||{amt:0,sub:'',rows:[]};
 const rows=[[lb('time'),new Date().toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'})],...o.rows,[lb('fee'),'0 RWF'],[lb('ref'),o.ref]];
 return `<div style="display:flex;flex-direction:column;align-items:center;padding-top:clamp(28px,12vh,200px)"><div class="g3">${CK}</div><div class="h1" style="margin-top:28px;font-size:34px;line-height:42px">${o.plus?'+':''}${R(o.amt)}</div><div class="mu" style="font-size:16px;margin-top:8px;text-align:center;padding:0 24px">${esc(o.sub)}</div></div><div style="margin:44px 24px 0;padding:4px 20px;border-radius:20px;background:var(--chip)">${rows.map(([a,b],i)=>`<div style="display:flex;justify-content:space-between;gap:16px;height:52px;align-items:center;font-size:15px;border-top:0"><span class="mu">${esc(a)}</span><b style="text-align:right;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${esc(b)}</b></div>`).join('')}</div><div class="cta" style="border:0"><button class="btn" onclick="okpDone()">${lb('done')}</button></div>`};
window.okpDone=()=>{if(S.stack[S.stack.length-1]==='okp')S.stack.pop();render('pop')};
let busy=0,n=0;
/* wrap(name, pre, post): pre(args) runs before and returns context; post(ctx) returns {amt,sub,rows,plus} after the original changed state */
const wrap=(name,pre,post,when)=>{const f=window[name];if(typeof f!=='function'||f.__okp)return;
 const w=function(){if(busy)return;const a=arguments;if(when&&!when(a))return f.apply(this,a);
  let c={};try{c=pre?pre.apply(null,a)||{}:{}}catch(_){}
  const s0=sig(),old=new Set(document.querySelectorAll('.toast')),r=f.apply(this,a);
  if(sig()===s0)return r;
  document.querySelectorAll('.toast').forEach(t=>{if(!old.has(t)){c.msg=t.textContent;t.style.display='none'}});const h1=document.querySelector('#layer .sheet .h1');if(h1)c.h1=h1.textContent;
  let o;try{o=post(c)}catch(_){return r}if(!o)return r;
  o.ref='IT-'+(20500+(++n)*7)+'-'+(n%9+1);S.okp=o;busy=1;
  const txt=({rw:'Birimo gukorwa…',fr:'En cours…'})[S.lang]||'Working…';
  $('#layer').innerHTML=`<div class="sn" role="status" aria-live="polite">${window.itLogo?window.itLogo():''}<div style="font-size:17px;font-weight:800">${txt}</div></div>`;
  setTimeout(()=>{busy=0;$('#layer').innerHTML='';S.stack.push('okp');render('push')},rm()?150:900);
  return r};
 w.__okp=1;window[name]=w};
const bk=()=>[lb('bank'),R(S.bank)];
const run=()=>{
 wrap('mvDo',()=>{const m=S.mv,p=pkGet(m.id);return{v:Number(m.amt),inn:m.dir==='in',p,n:p&&p.n}},c=>({amt:c.v,sub:c.inn?T3('Added to ','Byashyizwe kuri ','Ajouté à ')+c.n:T3('Taken out of ','Byakuwe kuri ','Retiré de ')+c.n,rows:[[T3('Pocket balance','Amafaranga kuri pocket','Solde de la pocket'),R(pkBal(c.p))],bk()]}));
 wrap('autoRun',()=>{const p=pkGet(S.pkId);return{p,a:p&&p.auto?p.auto.a:0}},c=>({amt:c.a,sub:T3('Auto-fill added to ','Kwiyuzuza byashyizwe kuri ','Remplissage auto vers ')+c.p.n,rows:[[T3('Pocket balance','Amafaranga kuri pocket','Solde de la pocket'),R(pkBal(c.p))],bk()]}));
 wrap('jarMove',d=>({d}),c=>({amt:5000,sub:c.d>0?T3('Added to your jar','Byashyizwe mu kibindi cyawe','Ajouté à votre tirelire'):T3('Taken out of your jar','Byakuwe mu kibindi cyawe','Retiré de votre tirelire'),rows:[[T3('Jar balance','Mu kibindi','Solde de la tirelire'),R(S.jar)],bk()]}));
 wrap('addMoney',()=>({a:S.addAmt,s:S.addSrc}),c=>({amt:c.a,plus:1,sub:T3('Added to itunda Pay','Byongewe kuri itunda Pay','Ajouté à itunda Pay'),rows:[[T3('From','Kuva kuri','De'),c.s],[lb('pay'),R(S.pay)]]}));
 wrap('bkMoveGo',()=>{const M=S.bm;return{v:M.amt,out:M.dir==='out'}},c=>({amt:c.v,sub:c.out?T3('Moved to itunda Pay','Byimuriwe kuri itunda Pay','Transféré vers itunda Pay'):T3('Moved to itunda Bank','Byimuriwe kuri itunda Bank','Transféré vers itunda Bank'),rows:[bk(),[lb('pay'),R(S.pay)]]}));
 wrap('bkDepGo',()=>({D:S.bd&&{...S.bd}}),c=>({amt:c.D.amt,plus:1,sub:T3('Deposited to itunda Bank','Byabikijwe kuri itunda Bank','Déposé sur itunda Bank'),rows:[[T3('From','Kuva kuri','De'),c.D.src],bk()]}));
 wrap('puDo',()=>{const p=S.pu;return{v:Number(p.amt||0),top:p.mode==='top'}},c=>({amt:c.v,plus:c.top,sub:c.top?T3('Added to itunda Pay','Byongewe kuri itunda Pay','Ajouté à itunda Pay'):T3('Moved out of itunda Pay','Byakuwe kuri itunda Pay','Retiré de itunda Pay'),rows:[[lb('pay'),R(S.pay)],bk()]}));
 wrap('loanDo',()=>({a:S.la,m:S.lm}),c=>({amt:c.a,plus:1,sub:T3('Loan paid out to itunda Bank','Inguzanyo yashyizwe kuri itunda Bank','Prêt versé sur itunda Bank'),rows:[S.loan?[T3('Monthly payment','Kwishyura buri kwezi','Mensualité'),R(S.loan.mo)]:[T3('Months','Amezi','Mois'),String(c.m)],bk()]}));
 wrap('loanPay',()=>{const L=S.loan;return{mo:L.mo,m:L.m}},c=>({amt:c.mo,sub:S.loan?T3('Loan payment made','Wishyuye inguzanyo','Mensualité payée'):T3('Loan fully repaid. Well done.','Inguzanyo yose yishyuwe. Komeza.','Prêt remboursé. Bravo.'),rows:[[T3('Payments left','Asigaye','Restantes'),String(S.loan?S.loan.m-S.loan.paid:0)],bk()]}));
 wrap('loanAll',()=>{const L=S.loan;return{rem:L.mo*(L.m-L.paid)}},c=>({amt:c.rem,sub:T3('Loan fully repaid. Well done.','Inguzanyo yose yishyuwe. Komeza.','Prêt remboursé. Bravo.'),rows:[bk()]}),a=>a[0]);
 wrap('s31Go',()=>({}),()=>{const s=S.dsv31;return{amt:s.a,sub:s.n===31?T3('Day 31 done. Your bonus is ready.','Umunsi wa 31 urarangiye. Igihembo cyawe kiruzuye.','Jour 31 terminé. Votre bonus est prêt.'):T3('Day '+s.n+' saved. See you tomorrow.','Umunsi wa '+s.n+' wazigamwe. Tuzabonana ejo.','Jour '+s.n+' enregistré. À demain.'),rows:[[T3('Saved so far','Yose hamwe','Épargné'),R(s.t)],bk()]}});
 wrap('s31Collect',()=>({b:S.bank}),c=>({amt:S.bank-c.b,plus:1,sub:T3('Added to itunda Bank','Byongewe kuri itunda Bank','Ajouté à itunda Bank'),rows:[bk()]}));
 wrap('s31Stop',()=>({b:S.bank}),c=>({amt:S.bank-c.b,plus:1,sub:T3('Back in itunda Bank','Byagarutse kuri itunda Bank','De retour sur itunda Bank'),rows:[bk()]}));
 wrap('transitTop',()=>({a:S.topAmt}),c=>({amt:c.a,sub:T3('Transit card topped up','Ikarita yongewemo','Carte de transport rechargée'),rows:[[T3('Card balance','Amafaranga ku ikarita','Solde de la carte'),R(S.tb)],[lb('pay'),R(S.pay)]]}));
 wrap('stkBuy',()=>({k:S.sk,q:S.sq,b:S.bank}),c=>({amt:c.b-S.bank,sub:T3('Bought '+c.q+' '+c.k,'Waguze '+c.q+' '+c.k,'Acheté '+c.q+' '+c.k),rows:[bk()]}));
 wrap('stkSell',()=>({k:S.sk,b:S.bank}),c=>({amt:S.bank-c.b,plus:1,sub:T3('Sold '+c.k,'Wagurishije '+c.k,'Vendu '+c.k),rows:[bk()]}));
 wrap('goalAdd',()=>({}),()=>({amt:1000,sub:T3('Added to your goal','Byashyizwe ku ntego yawe','Ajouté à votre objectif'),rows:[[T3('Saved','Wazigamye','Épargné'),S.goal?R(S.goal.s)+' / '+R(S.goal.t):''],bk()]}));
 wrap('save26',()=>({b:S.bank}),c=>({amt:S.w26*500,sub:T3('Week '+S.w26+' saved','Icyumweru cya '+S.w26+' cyazigamwe','Semaine '+S.w26+' épargnée'),rows:[[T3('Weeks done','Ibyumweru byarangiye','Semaines faites'),S.w26+' / 26'],bk()]}));
 wrap('mkPay',id=>({b:S.bank,id}),c=>({amt:c.b-S.bank,sub:T3('Paid. Held until you confirm.','Byishyuwe. Bibitswe kugeza wemeje.','Payé. Retenu jusqu’à confirmation.'),rows:[bk()]}));

 /* investing, refunds, scheduled transfers */
 const bd=c=>S.bank-c.b, ad=c=>Math.abs(S.bank-c.b), b0=()=>({b:S.bank});
 wrap('invGo',b0,c=>({amt:ad(c),plus:S.bank>c.b,sub:c.h1||'',rows:[bk()]}));
 wrap('invIpoDo',b0,c=>({amt:ad(c),sub:c.msg||'',rows:[bk()]}));
 wrap('invIpoCancel',b0,c=>({amt:ad(c),plus:1,sub:c.msg||'',rows:[bk()]}));
 wrap('invCancel',b0,c=>S.bank>c.b?{amt:ad(c),plus:1,sub:c.msg||'',rows:[bk()]}:null);
 wrap('invDiv',b0,c=>({amt:ad(c),plus:1,sub:T3('Dividend received','Inyungu yakiriwe','Dividende reçu'),rows:[bk()]}));
 wrap('invBondCollect',b0,c=>({amt:ad(c),plus:1,sub:T3('Bond paid out to itunda Bank','Impapuro mpimbano zishyuwe kuri itunda Bank','Obligation versée sur itunda Bank'),rows:[bk()]}));
 wrap('mkCancel',b0,c=>({amt:ad(c),plus:1,sub:c.msg||'',rows:[bk()]}));
 wrap('shRet',()=>({p:S.pay}),c=>({amt:S.pay-c.p,plus:1,sub:c.msg||'',rows:[[lb('pay'),R(S.pay)]]}));
 wrap('bsRun',b0,c=>({amt:ad(c),sub:c.msg||'',rows:[bk()]}));
};
run();
document.title=document.title.replace(/v\d+/,'v425');
})();
</script>

<style id="v426">
/* v426: one Toss keypad everywhere. Before: nine different keypads. Onboarding phone and PIN, Send, Pay, Pay bills, Pocket move and Change PIN each had their own key size, weight, spacing and delete icon (a boxed backspace, a text glyph or an arrow), some had a 00 key, the Send / Pay / Next button sat BELOW the keys as a rounded button, and the PIN sheets (new PIN, card PIN, gate) used grey rounded key tiles. Now every keypad is the Top up keypad from v389-v393, copied from the Toss screens: no tiles, light 28px numbers, a thin arrow as delete, a blank key bottom-left (no 00), rows 62.5px tall on a 845px screen (they scale down on short phones), keys dim while pressed instead of shrinking, and the main button is a full-width 53px bar sitting directly on top of the keys, in the soft brand tint while it is off. Biometric key on onboarding PIN keeps its place bottom-left. The old pads are not touched in code, only in how they look, so every key still does what it did. */
#phone{--kr:clamp(46px,7.4dvh,62.5px);--kb:46px;--kh:calc(var(--kr)*4)}

/* 1. the keypad itself (full screens) */
#phone .screen:has(.keys){overflow:hidden;padding-bottom:0!important}
#phone .screen .keys{position:absolute!important;left:0!important;right:0!important;top:auto!important;bottom:var(--kb)!important;height:var(--kh)!important;margin:0!important;padding:0 12px!important;display:grid!important;grid-template-columns:repeat(3,1fr);grid-template-rows:repeat(4,1fr);gap:0!important;background:none!important}
#phone .keys button,#phone .keys>span{height:auto!important;min-height:0!important;width:auto!important;margin:0!important;padding:0!important;border:0!important;border-radius:0!important;background:none!important;box-shadow:none!important;color:var(--tx);font-size:28px!important;font-weight:300!important;letter-spacing:0!important;line-height:1;display:flex;align-items:center;justify-content:center;transform:none!important;-webkit-tap-highlight-color:transparent;-webkit-user-select:none;user-select:none;touch-action:manipulation;transition:opacity .1s!important}
#phone .keys button:active:not(:disabled){opacity:.4;background:none!important;transform:none!important}
#phone .keys button:disabled{opacity:1;color:var(--tx)}
#phone .keys button.kb94{color:var(--tintfg)}
#phone .keys button svg{display:block}

/* 2. the main button: full-bleed bar right on top of the keys */
#phone #view:has(.keys)>.cta{position:absolute!important;left:0!important;right:0!important;bottom:calc(var(--kb) + var(--kh))!important;padding:0!important;background:transparent!important;display:flex;flex-direction:column-reverse}
#phone #view:has(.keys)>.cta::before{display:none!important}
#phone #view:has(.keys)>.cta .btn,#phone .screen .mvn{display:block;width:100%;height:53px!important;margin:0!important;border-radius:0!important;font-size:17px!important;font-weight:700!important}
#phone #view:has(.keys)>.cta .btn:disabled,#phone .screen .mvn:disabled{background:var(--tint)!important;color:var(--tintfg)!important;opacity:1!important}
#phone .screen .mvn{position:absolute;left:0;right:0;bottom:calc(var(--kb) + var(--kh))}
#phone #view:has(.keys)>.cta .dhint{padding:0 24px 10px!important;text-align:left!important}

#phone .screen .mvq{margin-top:20px!important}

/* 3. the PIN pages that open from a sheet (new PIN, card PIN, gate) */
#phone .sheet .keys.tkpsh{display:grid!important;grid-template-columns:repeat(3,1fr);grid-auto-rows:var(--kr);gap:0!important;margin:auto 0 0!important;padding:0 12px var(--kb)!important}
#phone .sheet.v6pg .v6b:has(>.tkpsh){display:flex;flex-direction:column}
#phone .sheet .keys.tkpsh .czk{height:var(--kr)!important}
#phone .sheet .keys.tkpsh .czk:active{opacity:.4;background:none!important}
/* short phones (about 700px and under): smaller rows and bar, tighter top, so the amount, chips and keys never overlap */
@media (max-height:700px){#phone{--kr:clamp(40px,6.6dvh,46px);--kb:10px}
#phone #view:has(.keys)>.cta .btn,#phone .screen .mvn{height:46px!important;font-size:16px!important}
#phone .keys button{font-size:25px!important}
#phone .screen:has(.keys) .h1{font-size:23px!important;line-height:28px!important}
#phone .screen:has(.keys) .pad{padding-top:8px!important}
#phone .screen:has(.keys) .mu.sm,#phone .screen:has(.keys) [class~=mu][style*="font-size:14px"]{margin-top:4px!important}
#phone .screen:has(.keys) [style*="font-size:56px"]{font-size:44px!important}
#phone .screen:has(.keys) [style*="padding:32px 24px 0"]{padding-top:10px!important}
#phone .screen:has(.keys) [style*="margin-top:16px;display:flex;gap:8px"]{margin-top:8px!important}}
/* v426b: sizes and spacing measured from the two Toss screenshots (390px-wide frame): keys 28px light, rows 62.5px, key columns centred at 86 / 195 / 304px (32px side padding), bar 53px with a 17px semibold label; on Top up / Move the back arrow is 24px and sits at x 18, source name and headline 22px, secondary line 15px, headline 40px under the source, chips 30px high, 14px medium, 8px radius, 8px apart, left-aligned 12px under the headline. */
#phone .screen .keys{padding:0 32px!important}
#phone .keys button{padding-top:3px!important}
#phone .sheet .keys.tkpsh{padding:0 32px var(--kb)!important}
#phone #view:has(.keys)>.cta .btn,#phone #view>.cta #pgo,#phone .screen .mvn{font-weight:700!important}
#phone .screen:has(#pub) .puh .ib{margin-left:-14.5px!important;margin-top:-1px}
#phone .screen:has(#pub) .puh .ib svg{width:24px;height:24px}
#phone .screen:has(#pub) .mvx{font-size:22px!important;line-height:30px!important;font-weight:700!important}
#phone .screen:has(#pub) .mvs{font-size:15px!important;line-height:20px!important;margin-top:1px!important;font-weight:400!important}
#phone .screen:has(#pub) .pua{margin-top:40px!important;min-height:30px!important;height:auto!important;line-height:30px!important}
#phone .screen:has(#pub) .pua .v421n{font-size:24px!important;line-height:30px!important;font-weight:700!important;letter-spacing:-.3px}
#phone .screen:has(#pub) .pua .v421u{font-size:24px!important;line-height:30px!important;font-weight:400!important;color:var(--mu)}
#phone .screen:has(#pub) .puc{margin-top:12px!important;gap:8px!important;justify-content:flex-start!important}
#phone .screen:has(#pub) .puc .chip{height:30px!important;min-height:0!important;padding:0 11px!important;font-size:14px!important;font-weight:500!important;border-radius:8px!important;flex:none}
@media (prefers-reduced-motion:reduce){#phone .keys button{transition:none!important}}

/* v427: keypad spacing. (1) Top up / Move kept its Confirm bar at a hard-coded bottom:296px (46 + 4x62.5, right for an 845px screen only), so on every other phone height the bar floated away from the keys: ~30px on a 740 screen, ~115px on 640-667, and on short phones it covered the amount chips. It now sits on the keys like every other bar (kb + 4 rows) and takes the compact 46px height on short phones. (2) Key rows were sized as a % of screen height (7.4dvh), so a 740px phone got 55px rows although the header and chips leave room for the full 62.5px of the Toss screens. A small script measures the lowest thing above the keys on each screen and gives the rows 62.5px whenever there is room, shrinking them only as far as needed (down to 42px) so nothing above is covered; the CSS formula is the fallback. The gap under the keys tapers from 46px to 10px instead of switching at 700px. (3) Move keys (.mvk) lose their extra 6px top padding / 400 weight / 26px size so they match every other pad. */
#phone{--kb:clamp(10px,calc(100dvh - 700px),46px);--kr:clamp(42px,calc((100dvh - var(--kb) - 480px)/4),62.5px);--kh:calc(var(--kr)*4)}
@media (max-height:700px){#phone{--kb:clamp(10px,calc(100dvh - 700px),46px);--kr:clamp(42px,calc((100dvh - var(--kb) - 480px)/4),62.5px)}}
#phone .pucta{bottom:calc(var(--kb) + var(--kh))!important}
#phone .screen .keys.mvk{padding:0 32px!important;margin:0!important}
#phone .keys.mvk button{font-weight:300!important;font-size:28px!important}
@media (max-height:700px){#phone .pucta .btn{height:46px!important;font-size:16px!important}#phone .keys.mvk button{font-size:25px!important}}

/* v428: quieter Split a bill, Eats and Directions. Same rule as the Toss screens: one question per screen, no boxes inside boxes, no second row of chips. Split (keypad): the category chips and the grey card are gone, the amount sits straight on the page, and "Each pays" is two plain lines without avatars. Split (pick people): the category row and the Clear chip are gone, so there is one row of quick amounts. Eats restaurant: shorter hero without the big illustration, no search box, Group order is one plain line (no card, icon or sub-line), menu rows lose the grey thumbnail tile. Directions: the "Leave now / Best route / Options" strip and the route chips floating on the map are gone (the sheet already says Best and the time), and the bottom bar has one button, Start. */
#phone .screen:has(#spa) .v8cats{display:none!important}
#phone .screen:has(#spa) div:has(>#spa){background:none!important;border-radius:0!important;padding:0 24px!important;margin:20px 0 0!important}
#phone .screen:has(#spa) div:has(>#spa)>.mu{font-size:15px!important;margin-bottom:4px}
#phone .screen:has(#spa) .sec{display:none!important}
#phone .screen:has(#spa) #spr{margin-top:24px!important;padding:0 24px!important}
#phone .screen:has(#spa) #spr>div{height:30px!important;min-height:0!important;padding:0!important;gap:0!important;display:flex!important;align-items:center;justify-content:space-between}
#phone .screen:has(#spa) #spr>div>div:first-child{display:none!important}
#phone .screen:has(#spa) #spr>div>div,#phone .screen:has(#spa) #spr>div>b{font-size:15px!important;font-weight:400!important;color:var(--mu)!important;flex:none!important}
#phone .screen:has(#sbK) #sbK{display:none!important}
#phone .screen:has(#sbK) .pad>.req:not(#sbK){flex-wrap:nowrap!important}
#phone .screen:has(#sbK) .pad>.req:not(#sbK)>button:nth-child(4){display:none!important}
#phone .screen:has(#emq) #emq,#phone .screen:has(#emq) div:has(>#emq){display:none!important}
#phone .screen:has(#emq) button.tap:has(b):has(svg){background:none!important;border-radius:0!important;padding:0!important;min-height:0!important;height:44px!important}
#phone .screen:has(#emq) button.tap:has(b)>span:first-child,#phone .screen:has(#emq) button.tap:has(b) .sm{display:none!important}
#phone .screen:has(#emq) .mi .th{background:none!important;border-radius:0!important}
#phone .screen:has(#emq) .mi .th>svg{display:none!important}
#phone .screen:has(#emq)>div:first-child>svg:not(.ib svg):not(.hrt svg){display:none!important}
#phone .screen:has(#emq)>div:first-child{height:130px!important;min-height:0!important}
#phone .modes+button{display:none!important}
#phone .screen .mcs{display:none!important}
#phone:has(.screen .rbox) #view>.cta .btn.sec2{display:none!important}
#phone:has(.screen .rbox) #view>.cta .btn{flex:1!important}

/* v429: second quieting pass (same rule as v428: one job per screen, no secondary controls competing with the main one). Foreign currency: no "exact amount" link, and under the converted amount only the rate; the fee line, rate warning, bank-after note, chart, wallets, rate alert and history are hidden. Buy airtime: no Clear chip, no "arrives in seconds" line, no Pay-with box (the button says it), no disabled-state hint. Upcoming bills: each bill has one button, Pay (the Remind-me switch and the remove chip are hidden). Shop: no timed banner, no Earn RWF cards, no repeated "Recommended" header. Community: no search bar, one chip row of five, no area row, no tag pills on posts, and only like and comment on each post. Marketplace: six chips and the Sell button moved to the bottom-right corner so it no longer sits over a listing. Transit: the "About fares" essay is hidden. */
#phone .screen:has(.fxg) .fxa button.hit44b{display:none!important}
#phone .screen:has(.fxg) .fxg+div>div:nth-child(n+2){display:none!important}
#phone .screen:has(.fxg) .fxg+div~*{display:none!important}
#phone .screen:has(#airph) #airM{display:none!important}
#phone .screen:has(#airph) .pad>.req:has(button:nth-child(5))>button:nth-child(5){display:none!important}
#phone .screen:has(#airph) .pad>div:has(#airB){display:none!important}
#phone:has(#airph) #view>.cta .dhint{display:none!important}
#phone .bl96>div:last-child{justify-content:flex-end!important;margin-top:-20px!important}
#phone .bl96>div:last-child>*:not(:last-child){display:none!important}
#phone .shop348>div:has(#bn),#phone .shop348>.sec:has(#mis),#phone .shop348>.sec:has(+#shsort){display:none!important}
#phone .screen:has(#cmch) .v143q,#phone .screen:has(#cmch) .v145row{display:none!important}
#phone #cmch button:nth-child(n+6){display:none!important}
#phone #cml .post>div:nth-child(2):has(>span){display:none!important}
#phone #cml .post .act>*:nth-child(n+3){display:none!important}
#phone #mxch button:nth-child(n+7){display:none!important}
#phone:has(.mk349) #mxl{padding-bottom:96px}
#phone:has(.mk349) .fab{justify-content:flex-end!important;padding-right:20px!important}
#phone .screen:has(.bdband) .pad.mu+details{display:none!important}

/* v430: third quieting pass. Move money: no "All" chip, no Balances-after card, no footnote (the button already says "Move 5,000 RWF"). Deposit: no Bank-balance-after card. Request money: no Clear chip. Send to a bank account: the Fee and Daily-limit rows are hidden, only "Arrives" stays. Scan: the "Shops and friends both work" line and From photos are hidden, so the scanner has a title, a frame, Till number and My code. Also a bug fix: the scanner's top strip had a white background, so its white Flash and Close icons were invisible; it is now transparent. */
#phone .screen:has(#bkmA) .pad>.req>button:nth-child(5),#phone .screen:has(#rqA) .pad>.req>button:nth-child(5){display:none!important}
#phone .screen:has(#bkmA) .pad>div:has(>#bkmB),#phone .screen:has(#bkmA) .pad>.fine{display:none!important}
#phone .screen:has(#bkdA) .pad>div:has(>#bkdB){display:none!important}
#phone .screen:has(#bxa) .pad>#bxe+div>div:nth-child(1),#phone .screen:has(#bxa) .pad>#bxe+div>div:nth-child(3){display:none!important}
#phone #sc2hint,#phone .sc2 .acts>*:nth-child(2){display:none!important}
#phone .sc2 .top{background:transparent!important}
#phone .sc2 #sc2t{color:#fff!important;opacity:1!important}
#phone .sc2 .acts button{color:#fff!important;background:rgba(255,255,255,.16)!important;opacity:1!important}

/* v431: fourth quieting pass. Eats cart: only Delivery or pickup, address, your order and tip stay; the rider request, delivery time (defaults to as soon as possible), restaurant note and promo block are hidden. Place card: Directions is the one big button next to Call; From here, Share and Follow are hidden. Cash at an agent: the breakdown keeps "You receive", "Fee" and "Taken from"; the balance rows and the How it works list are hidden. Maps home: the Explore nearby tile grid is hidden. */
#phone .screen:has(#enote)>.pad:nth-child(3),#phone .screen:has(#enote)>.pad:nth-child(4),#phone .screen:has(#enote)>.pad:has(#enote),#phone .screen:has(#enote)>.pad:has(#epm){display:none!important}
#phone .sh2 .acts>button.p,#phone .sh2 .acts>button:nth-child(3),#phone .sh2 .acts>button:nth-child(5){display:none!important}
#phone .sh2 .acts>button.q{flex:1 1 60%!important;grid-column:span 2}
#phone .screen:has(#agA) #agC+div>div:nth-child(1),#phone .screen:has(#agA) #agC+div>div:nth-child(5),#phone .screen:has(#agA) #agC+div+div,#phone .screen:has(#agA) #agC+div+div+.sm{display:none!important}
#phone .screen:has(#mpq) .mpx{display:none!important}

/* v432: Send flow, the screens everyone sees. Amount: the "Daily limit left" line is hidden (the spelled-out amount and "From itunda Bank, available" stay). Check and send: only To, From and Amount; Fee ("Free") and Balance after are hidden. Sent receipt: only Time and Reference; Fee, Balance now and "Sending is always free" are hidden. */
#phone .screen:has(#wd) .v419blk>.sm.mu.tap{display:none!important}
#phone .screen:has(>.pad>.h1):has(>div.fine)>.pad+div>div:nth-child(n+4){display:none!important}
#phone .screen:has(.g3):has(>div>button.chip.tap)>div:nth-child(2)>div:nth-child(2),#phone .screen:has(.g3):has(>div>button.chip.tap)>div:nth-child(2)>div:nth-child(3),#phone .screen:has(.g3):has(>div>button.chip.tap)>.fine{display:none!important}

/* v433: 31-day savings keeps the title, the cup, the amount chips and the button (the benefit rows and "Good to know" are hidden). Mini apps: no search bar and no orphan "Before you pay full price" heading. Money manager: the fine print is hidden and "Why you see this" is plain text instead of a grey card. */
#phone .screen:has(.s31h) .s31h+.pad,#phone .screen:has(.s31h) .s31h+.pad~.pad,#phone .screen:has(.s31h) .s31h+.pad~div:has(+.pad){display:none!important}
#phone .screen:has(.msr) .msr,#phone .screen:has(.msr) .mtabs+.mt2{display:none!important}
#phone .screen:has(>.pad.fine):has(>.pad>.h1) >.pad.fine{display:none!important}
#phone .screen:has(>.pad.fine):has(>.pad>.h1) >.pad>div:has(>b+.mu){background:none!important;padding:0!important;border-radius:0!important}

/* v434: Pay bills: the second "find it on your meter" line, the Bank-balance-after card and the hint under the disabled button are hidden (the top line already says how many digits are missing). Receive money: "Save image", the "leave empty" line and the Clear chip are hidden. */
#phone .screen:has(#bnum) #blNM,#phone .screen:has(#bnum) .pad>div:has(>#blB){display:none!important}
#phone:has(#bnum) #view>.cta .dhint{display:none!important}
#phone .screen:has(#rcQ) button.tap,#phone .screen:has(#rcQ) #rcM,#phone .screen:has(#rcQ) .pad>.req>button:nth-child(4){display:none!important}

/* v435: the itunda card now looks like a bank card. Before: a flat 342x200 purple slab with 28px bubble corners, a big logo and the number in bold type. Now: real card proportions (85.6 x 54 mm, 1.586:1), 16px corners, a soft diagonal sheen and a highlight edge, a depth shadow, a gold EMV chip with the contactless mark beside it (what Toss and Kakao Bank cards show), a smaller logo, name and expiry in small caps, the last four digits in a light tabular face, and DEBIT bottom-right. It works with all three finishes and the frozen state, and it presses in slightly when tapped. */
#phone #cv{height:auto!important;aspect-ratio:1.586;border-radius:16px!important;padding:20px 22px!important;overflow:hidden;
 background-image:linear-gradient(135deg,rgba(255,255,255,.30) 0%,rgba(255,255,255,0) 45%,rgba(0,0,0,.16) 100%),radial-gradient(120% 80% at 100% 0%,rgba(255,255,255,.24),transparent 60%)!important;
 box-shadow:inset 0 1px 0 rgba(255,255,255,.4),inset 0 0 0 1px rgba(255,255,255,.12),0 0 0 .5px rgba(0,0,0,.08),0 24px 32px -20px rgba(18,18,22,.6),0 8px 14px -8px rgba(18,18,22,.3)!important;
 transition:filter .35s,transform .18s}
#phone #cv:active{transform:scale(.985)}
#phone #cv.frozen:active{transform:scale(.97)}
#phone #cv::before{content:"";position:absolute;inset:-30% -25%;background:linear-gradient(115deg,transparent 38%,rgba(255,255,255,.16) 48%,rgba(255,255,255,.04) 56%,transparent 62%);pointer-events:none}
#phone #cv>div:first-child svg{width:30px!important;height:30px!important}
#phone #cv>div:first-child>b{display:none}
#phone #cv #cst{font-size:11px!important;font-weight:700!important;padding:4px 9px!important;border-radius:10px!important;letter-spacing:.2px}
#phone #cv .emv{position:absolute;left:22px;top:42%;width:46px;height:35px;border-radius:7px;
 background:linear-gradient(90deg,transparent 0 33%,rgba(60,40,0,.35) 33% 34%,transparent 34% 66%,rgba(60,40,0,.35) 66% 67%,transparent 67%),linear-gradient(0deg,transparent 0 31%,rgba(60,40,0,.35) 31% 33%,transparent 33% 66%,rgba(60,40,0,.35) 66% 68%,transparent 68%),linear-gradient(135deg,#F3DC9A,#C9A24A 55%,#E6C978);
 box-shadow:inset 0 0 0 1px rgba(90,60,0,.35),0 1px 2px rgba(0,0,0,.2)}
#phone #cv .emv::after{content:"";position:absolute;left:33%;top:31%;width:34%;height:37%;border-radius:3px;border:1px solid rgba(60,40,0,.35)}
#phone #cv .ctl{position:absolute;left:84px;top:calc(42% + 5px);width:26px;height:26px;opacity:.8}
#phone #cv .dbt{position:absolute;right:22px;bottom:20px;font-size:13px;font-weight:800;font-style:italic;letter-spacing:1.4px;opacity:.9}
#phone #cv [style*="letter-spacing:1px"][style*="font-size:18px"],#phone #cv [style*="letter-spacing:2px"]{font-size:15px!important;font-weight:500!important;letter-spacing:2.2px!important;font-variant-numeric:tabular-nums;opacity:.92}
#phone #cv [style*="text-transform:uppercase"]{font-size:11px!important;letter-spacing:1.4px!important;font-weight:700!important}

/* v436: card screens, quieter. Card: the caption under the card is hidden; Controls are plain rows (no grey box, no sub-lines); only the last two card payments show. Order a card: two benefits instead of four, and the finish picker is no longer hidden behind the button. */
#phone .screen:has(#cv) .cdcap{display:none!important}
#phone .screen:has(#cv) .cc95{background:none!important;padding:0 !important;border-radius:0!important}
#phone .screen:has(#cv) .cc95 .r95 .sm{display:none!important}
#phone .screen:has(#cv) .cc95 .r95{min-height:56px!important;padding-top:0!important;padding-bottom:0!important}
#phone .screen:has(#cv) .pad>.bdr:nth-child(n+3){display:none!important}
#phone .screen:has(#cv):has(>.pad>.h1)>.pad:nth-child(4)>div:nth-child(n+3){display:none!important}
#phone .screen:has(#cv):has(>.pad>.h1){padding-bottom:110px!important}
</style>

<script>
/* v426: one Toss keypad everywhere (see the style block v426). This only normalises the markup the old pads produce: the delete key becomes the thin arrow, the 00 key becomes a blank, and the grey tile grids of the PIN sheets get the same class as the full-screen pads. Set KEEP_00=true to bring 00 back. */
(function(){
 const KEEP_00=false;
 const ARROW='<svg data-t26="1" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 12H4.5M10.5 5.5L4 12l6.5 6.5"/></svg>';
 let busy=false;
 function tidy(){
  if(busy)return;busy=true;
  try{
   document.querySelectorAll('#phone .czk').forEach(b=>{const g=b.parentElement;if(g&&!g.classList.contains('tkpsh')){g.classList.add('keys','tkpsh');g.removeAttribute('style')}});
   document.querySelectorAll('#phone .keys').forEach(g=>{
    const k=[...g.children];
    k.forEach((b,i)=>{
     if(b.tagName!=='BUTTON')return;
     const t=(b.textContent||'').trim();
     if(i===11&&!b.classList.contains('kb94')&&!/^\d$/.test(t)&&!b.querySelector('[data-t26]')&&(t===''||/^[⌫<]$/.test(t)||/^(del|b)$/.test(t)||b.querySelector('svg'))&&!b.disabled||(i===11&&/^[⌫<]$/.test(t))){
      if(!b.querySelector('[data-t26]'))b.innerHTML=ARROW;
     }
     if(!KEEP_00&&t==='00'){b.disabled=true;b.tabIndex=-1;b.setAttribute('aria-hidden','true');b.style.visibility='hidden'}
    });
   });
  }catch(e){}
  busy=false;
 }
 let q=0;const mo=new MutationObserver(()=>{tidy()}); /* v535: run at once (before paint) so new keypads never show their first, un-styled layout for a frame */
 const go=()=>{const p=document.getElementById('phone')||document.body;mo.observe(p,{childList:true,subtree:true});tidy()};
 if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',go);else go();
 document.title=document.title.replace(/v\d+/,'v436');
})();
</script>

<script>
/* v427: fit the key rows to the screen above them (see the v427 style block). */
(function(){
 let busy=false,q=0;
 function fit(){
  if(busy)return;busy=true;
  try{
   const ph=document.getElementById('phone');if(!ph)return;
   const sc=ph.querySelector('.screen'),keys=sc&&sc.querySelector('.keys');
   if(!keys){ph.style.removeProperty('--kr');return}
   const sr=sc.getBoundingClientRect();let cb=0;
   const bar=sc.querySelector('.pucta,.mvn')||ph.querySelector('#view>.cta');
   sc.querySelectorAll('*').forEach(e=>{
    if(keys.contains(e)||(bar&&(bar.contains(e)||e.contains(bar)))||e.contains(keys)||e.closest('.mvq'))return;
    if(e.children.length&&!e.matches('svg'))return;
    const cs=getComputedStyle(e);if(cs.visibility==='hidden'||cs.display==='none'||cs.position==='absolute'||cs.position==='fixed'){return}
    const r=e.getBoundingClientRect();if(!r.width||!r.height)return;
    cb=Math.max(cb,r.bottom-sr.top);
   });
   const H=ph.clientHeight,kb=parseFloat(getComputedStyle(keys).bottom)||0;
   const barH=bar?(bar.querySelector('button')||bar).offsetHeight||0:0;
   const kr=Math.max(42,Math.min(62.5,Math.floor((H-kb-barH-cb-10)/4*2)/2));
   if(Math.abs((parseFloat(ph.style.getPropertyValue('--kr'))||0)-kr)>.4)ph.style.setProperty('--kr',kr+'px');
  }catch(e){}finally{busy=false}
 }
 const sched=()=>{fit();if(q)return;q=requestAnimationFrame(()=>{q=0;fit();setTimeout(fit,150);setTimeout(fit,600)})};
 const go=()=>{const p=document.getElementById('phone')||document.body;new MutationObserver(sched).observe(p,{childList:true,subtree:true});addEventListener('resize',sched);fit();setTimeout(fit,80);setTimeout(fit,700)};
 if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',go);else go();
})();
</script>

<script>
/* v435: adds the chip, contactless mark and DEBIT label to the card face (see the v435 style block). */
(function(){
 const CTL='<svg class="ctl" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M7 8.5a5 5 0 010 7"/><path d="M10.5 6.5a8 8 0 010 11"/><path d="M14 4.5a11 11 0 010 15"/></svg>';
 let q=0;
 function add(){q=0;document.querySelectorAll('#phone #cv:not([data-v435])').forEach(c=>{c.setAttribute('data-v435','1');c.insertAdjacentHTML('beforeend','<i class="emv" aria-hidden="true"></i>'+CTL+'<span class="dbt" aria-hidden="true">DEBIT</span>')})}
 const go=()=>{const p=document.getElementById('phone')||document.body;new MutationObserver(()=>{if(!q)q=requestAnimationFrame(add)}).observe(p,{childList:true,subtree:true});add()};
 if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',go);else go();
})();
</script>
<style id="v437css">
/* v437: the itunda card is less of an app widget and more of a real fintech card (Toss Bank, Kakao Bank). Before: masked bullets and an expiry printed on the face, an "Active" pill on the plastic, a glossy sheen, a card that only sat there. Now: a number-less face like modern bank cards (logo, chip, contactless, name, DEBIT; the number and expiry live behind Details), the status moves off the plastic into a quiet line under the card ("•••• 4417 · Active", dot turns grey when frozen), a matte finish with fine grain and a softer sheen, 14px corners (3.5 mm on 85.6 mm), pressed-in lettering. The card has weight: it follows your finger or pointer with a small spring tilt, the sheen slides across as it tilts, it presses in when held, and it settles into place when you open the Card screen. Dragging on the card never opens Details by accident. Reduced-motion users get the still card. */
#phone #cv{border-radius:14px!important;transform:perspective(900px) rotateX(var(--rx,0deg)) rotateY(var(--ry,0deg)) scale(var(--sc,1))!important;transition:filter .35s!important;touch-action:pan-y;will-change:transform;
 background-image:linear-gradient(135deg,rgba(255,255,255,.16) 0%,rgba(255,255,255,0) 48%,rgba(0,0,0,.14) 100%),radial-gradient(120% 80% at 100% 0%,rgba(255,255,255,.12),transparent 60%)!important}
#phone #cv::before{transform:translateX(var(--sh,0px));background:linear-gradient(115deg,transparent 38%,rgba(255,255,255,.10) 48%,rgba(255,255,255,.03) 56%,transparent 62%)}
#phone #cv::after{content:"";position:absolute;inset:0;border-radius:inherit;pointer-events:none;mix-blend-mode:soft-light;opacity:.55;
 background:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='2' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 .5 0 0 0 0 .5 0 0 0 0 .5 0 0 0 .55 0'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>")}
#phone #cv #cst{display:none!important}
#phone #cv [style*="letter-spacing:1px"][style*="font-size:18px"],#phone #cv [style*="letter-spacing:2px"]{display:none!important}
#phone #cv [style*="text-transform:uppercase"]+span{display:none!important}
#phone #cv>div[style*="bottom:22px"]{bottom:20px!important}
#phone #cv>div[style*="bottom:22px"]>div:first-child{font-size:11px!important;letter-spacing:1.4px;text-transform:uppercase;font-weight:700!important}
#phone #cv [style*="text-transform:uppercase"],#phone #cv>div[style*="bottom:22px"]>div:first-child,#phone #cv .dbt{text-shadow:0 1px 0 rgba(255,255,255,.28),0 -1px 0 rgba(0,0,0,.16)}
.cdl{display:flex;align-items:center;justify-content:center;gap:8px;margin:14px 24px 0;font-size:13px;line-height:18px;font-weight:600;color:var(--mu);font-variant-numeric:tabular-nums;letter-spacing:.2px}
.cdl i{width:6px;height:6px;border-radius:3px;background:var(--ok,#1A9E6B)}
.cdl.off i{background:var(--tt,#8B95A1)}
</style>
<script>
/* v437: caption under the card, and the spring tilt (see the v437 style block). */
(function(){
 const RM=matchMedia('(prefers-reduced-motion: reduce)').matches,MAX=9;
 let seen=0,q=0;
 const clamp=(v,a,b)=>Math.max(a,Math.min(b,v));
 function cap(c){
  const st=c.querySelector('#cst'),n=c.querySelector('[style*="letter-spacing:1px"][style*="font-size:18px"]');
  if(!st||!n)return;
  const m=(n.textContent||'').match(/(\d{4})\s*$/);if(!m)return;
  const s=(st.textContent||'').replace(/^[^\p{L}]+/u,'').trim(),fz=c.classList.contains('frozen'),key=m[1]+'|'+s+'|'+fz;
  let d=c.nextElementSibling&&c.nextElementSibling.classList.contains('cdl')?c.nextElementSibling:null;
  if(!d){d=document.createElement('div');c.insertAdjacentElement('afterend',d)}
  if(d.dataset.k!==key){d.dataset.k=key;d.className='cdl'+(fz?' off':'');d.innerHTML='<i></i><span>•••• '+m[1]+' · '+s+'</span>'}
 }
 function wire(c){
  c.dataset.v437='1';
  let rx=0,ry=0,vx=0,vy=0,tx=0,ty=0,s=c.classList.contains('frozen')?.98:1,vs=0,ts=s,raf=0,last=0,drag=0,sx=0,sy=0,moved=0;
  const paint=()=>{c.style.setProperty('--rx',rx.toFixed(2)+'deg');c.style.setProperty('--ry',ry.toFixed(2)+'deg');c.style.setProperty('--sc',s.toFixed(4));c.style.setProperty('--sh',(-ry*3).toFixed(1)+'px')};
  function step(now){
   raf=0;if(!c.isConnected)return;
   const dt=Math.min(.033,(now-last)/1000||.016);last=now;
   ts=(c.classList.contains('frozen')?.98:1)*(drag?.975:1);
   vx+=((tx-rx)*170-vx*15)*dt;rx+=vx*dt;vy+=((ty-ry)*170-vy*15)*dt;ry+=vy*dt;vs+=((ts-s)*300-vs*22)*dt;s+=vs*dt;paint();
   if(Math.abs(vx)+Math.abs(vy)+Math.abs(vs)>.02||Math.abs(tx-rx)+Math.abs(ty-ry)>.02||Math.abs(ts-s)>.0005)raf=requestAnimationFrame(step);
  }
  const kick=()=>{if(!raf){last=performance.now();raf=requestAnimationFrame(step)}};
  if(RM){paint();return}
  if(Date.now()-seen>1200){rx=11;ry=-15;s=.96}
  paint();kick();
  const aim=e=>{const r=c.getBoundingClientRect(),px=clamp((e.clientX-r.left)/r.width,0,1),py=clamp((e.clientY-r.top)/r.height,0,1);ty=(px-.5)*2*MAX;tx=-(py-.5)*2*MAX;kick()};
  const rest=()=>{tx=ty=0;kick()};
  c.addEventListener('pointerdown',e=>{drag=1;sx=e.clientX;sy=e.clientY;moved=0;aim(e)});
  c.addEventListener('pointermove',e=>{if(drag&&Math.hypot(e.clientX-sx,e.clientY-sy)>8)moved=1;if(drag||e.pointerType==='mouse')aim(e)});
  c.addEventListener('pointerup',()=>{drag=0;rest()});
  c.addEventListener('pointercancel',()=>{drag=0;rest()});
  c.addEventListener('pointerleave',()=>{if(!drag)rest()});
  c.addEventListener('click',e=>{if(moved){e.stopImmediatePropagation();e.preventDefault();moved=0}},true);
 }
 function add(){
  q=0;
  document.querySelectorAll('#phone #cv').forEach(c=>{cap(c);if(!c.dataset.v437)wire(c)});
  if(document.querySelector('#phone #cv'))seen=Date.now();
 }
 const go=()=>{const p=document.getElementById('phone')||document.body;new MutationObserver(()=>{if(!q)q=requestAnimationFrame(add)}).observe(p,{childList:true,subtree:true});setInterval(()=>{if(document.querySelector('#phone #cv'))seen=Date.now()},400);add()};
 if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',go);else go();
})();
</script>
<style id="v438css">
/* v438: itunda Bank account screen, closer to Toss Bank and Kakao Bank. Before: an underlined account number, Send and Fill in a bar at the bottom, a promo card inside the ledger, and a ledger of one line (card, bus and food payments come from Pay, so the bank itself looked unused). Now: account number as a quiet line, not an underlined link; Fill and Send sit right under the balance (like the Toss account screen); the promo is gone from the ledger; and the account has a real history (rent, transfers to friends, salary, interest) so the dated list with the balance after each line reads like a bank. */
#phone .bdn{text-decoration:none;font-size:14px;margin-top:22px;letter-spacing:.2px;font-variant-numeric:tabular-nums}
#phone .bdn::after{display:none!important}
#phone .bkact{display:flex;gap:10px;padding:20px 24px 0}
#phone .bkact .btn{flex:1;width:auto;height:52px;font-size:16px;border-radius:16px}
#phone:has(.bkact) .cta{display:none!important}
#phone .screen:has(.bkact) .bdnew{display:none!important}
</style>
<script>
/* v438: Fill / Send under the balance, and sample bank history (see the v438 style block). */
(function(){
 const D=864e5,T=1791660300000;
 function seed(){
  if(typeof S==='undefined'||!S.act||S._v438)return;S._v438=1;
  [['send','Rent','Sent · 8 Oct',-150000,'Sent',T-2*D],
   ['send','Jean Paul','Sent · 5 Oct',-30000,'Sent',T-5*D+36e5],
   ['up','Salary','Received · 30 Sep',650000,'Received',T-10*D-12e5],
   ['up','itunda interest','Received · 28 Sep',4120,'Received',T-12*D],
   ['send','Grace U.','Sent · 20 Sep',-45000,'Sent',T-20*D],
   ['up','Eric M.','Received · 15 Sep',20000,'Received',T-25*D+18e5]].forEach(r=>S.act.push(r));
 }
 let q=0;
 function add(){
  q=0;seed();
  document.querySelectorAll('#phone .screen').forEach(s=>{
   if(!s.querySelector('.bdband')||s.querySelector('.bkact'))return;
   const b=s.querySelector('.bdb'),c=s.querySelector('.cta')||document.querySelector('#phone .cta');if(!b||!c)return;
   const k=document.createElement('div');k.className='bkact';k.innerHTML=c.innerHTML;b.insertAdjacentElement('afterend',k);
  });
 }
 const go=()=>{const p=document.getElementById('phone')||document.body;new MutationObserver(()=>{if(!q)q=requestAnimationFrame(add)}).observe(p,{childList:true,subtree:true});add()};
 if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',go);else go();
})();
</script>
<style id="v439css">
/* v439: itunda Pay opens on the payment code, like Toss Pay and Kakao Pay. Before: Pay opened on the balance, with the code hidden behind a small row, "Pay from" as its own section and a code that never changed. Now: the first thing on Pay is a pay-in-store card: a barcode and a QR on a white panel (so a till can read it in dark mode too), the 12-digit number, the payment source as a chip you tap to change, and a live "New code in 0:48" with a thin bar; the code renews itself every minute and the refresh button renews it now. Tapping the code opens it large, as before. The old code row and the separate Pay from section are gone because the card does both jobs. The codes are sample codes, they do not pay anything. */
.pph{margin:20px 24px 0;padding:16px;border-radius:24px;background:var(--chip)}
.pph-h{display:flex;align-items:center;justify-content:space-between;gap:12px}
.pph-h b{font-size:17px;font-weight:800}
.pph-src{border:0;background:var(--bg);color:var(--tx);height:36px;padding:0 8px 0 14px;border-radius:18px;font:inherit;font-size:14px;font-weight:700;display:flex;align-items:center;gap:2px}
.pph-src svg{transform:rotate(90deg)}.pph-h b{color:var(--tx)}
.pph-code{margin-top:14px;background:#fff;border-radius:16px;padding:16px 16px 12px;display:flex;flex-direction:column;align-items:center;gap:14px;cursor:pointer}
.pph-bc{width:100%}.pph-qr{display:flex}
.pph-n{font-size:15px;font-weight:600;letter-spacing:2px;color:#17171C;font-variant-numeric:tabular-nums}
.pph-f{display:flex;align-items:center;justify-content:space-between;margin-top:12px;font-size:14px;color:var(--mu);font-weight:600;font-variant-numeric:tabular-nums}
.pph-r{border:0;background:none;color:var(--mu);width:44px;height:36px;margin:-6px -10px -6px 0;display:flex;align-items:center;justify-content:center}
.pph-bar{height:3px;border-radius:2px;background:color-mix(in srgb,var(--tx) 10%,transparent);margin-top:8px;overflow:hidden}
.pph-bar i{display:block;height:100%;background:var(--tx);opacity:.7;transition:width 1s linear}
.pay347 .pad:has(>[onclick="ppCode()"]){display:none!important}
.pay347 .v174:has([onclick^="ppFromPick"]){display:none!important}
</style>
<script>
/* v439: the pay-in-store card on Pay (see the v439 style block). */
(function(){
 const T=(e,r,f)=>{const l=(typeof S!=='undefined'&&S.lang)||'en';return l==='rw'?r:l==='fr'?f:e};
 let n=0,left=60;
 const rng=s=>()=>(s=(s*1664525+1013904223)>>>0)/4294967296;
 function mk(){
  const r=rng((Date.now()&0xffffff)+(n++)*7919),N=25,m=[];
  for(let y=0;y<N;y++){m[y]=[];for(let x=0;x<N;x++)m[y][x]=r()<.5?1:0}
  const fnd=(ox,oy)=>{for(let y=-1;y<8;y++)for(let x=-1;x<8;x++){const X=ox+x,Y=oy+y;if(X<0||Y<0||X>=N||Y>=N)continue;const ed=x<0||y<0||x>6||y>6,rg=x==0||y==0||x==6||y==6,co=x>=2&&x<=4&&y>=2&&y<=4;m[Y][X]=ed?0:(rg||co?1:0)}};
  fnd(0,0);fnd(N-7,0);fnd(0,N-7);
  for(let i=8;i<N-8;i++){m[6][i]=i%2?0:1;m[i][6]=i%2?0:1}
  let q='';for(let y=0;y<N;y++)for(let x=0;x<N;x++)if(m[y][x])q+='M'+x+' '+y+'h1v1h-1z';
  let b='',x=0;while(x<196){const w=1+Math.floor(r()*3),g=1+Math.floor(r()*2);b+='M'+x+' 0h'+w+'v40h-'+w+'z';x+=w+g}
  let d='';for(let i=0;i<12;i++)d+=Math.floor(r()*10)+(i%4==3&&i<11?' ':'');
  return{bar:'<svg viewBox="0 0 200 40" width="100%" height="44" preserveAspectRatio="none" aria-hidden="true"><path d="'+b+'" fill="#17171C"/></svg>',
   qr:'<svg viewBox="0 0 '+N+' '+N+'" width="148" height="148" shape-rendering="crispEdges" aria-hidden="true"><path d="'+q+'" fill="#17171C"/></svg>',num:d};
 }
 const fill=h=>{const c=mk();h.querySelector('.pph-bc').innerHTML=c.bar;h.querySelector('.pph-qr').innerHTML=c.qr;h.querySelector('.pph-n').textContent=c.num};
 const upd=h=>{h.querySelector('.pph-t').textContent=T('New code in ','Kode nshya mu ','Nouveau code dans ')+'0:'+String(left).padStart(2,'0');h.querySelector('.pph-bar i').style.width=(left/60*100)+'%'};
 let q=0;
 function add(){
  q=0;const c=document.querySelector('#phone .pay347');if(!c||c.querySelector('.pph'))return;
  const top=c.querySelector('.top'),sr=c.querySelector('[onclick^="ppFromPick"]');if(!top)return;
  const nm=sr&&sr.querySelector('div[style*="font-size:18px"] span')?sr.querySelector('div[style*="font-size:18px"] span').textContent:'itunda Pay';
  const h=document.createElement('div');h.className='pph';
  h.innerHTML='<div class="pph-h"><b>'+T('Pay in store','Kwishyura mu iduka','Payer en magasin')+'</b><button class="pph-src" onclick="ppFromPick(\'ppSrc\')" aria-haspopup="dialog">'+nm+ic('chev',16,'var(--tt)')+'</button></div><div class="pph-code" role="button" tabindex="0" aria-label="'+T('Open code','Fungura kode','Ouvrir le code')+'" onclick="ppCode()"><div class="pph-bc"></div><div class="pph-qr"></div><div class="pph-n"></div></div><div class="pph-f"><span class="pph-t"></span><button class="pph-r" aria-label="'+T('New code','Kode nshya','Nouveau code')+'">'+ic('cyc',18)+'</button></div><div class="pph-bar"><i></i></div>';
  top.insertAdjacentElement('afterend',h);left=60;fill(h);upd(h);
  h.querySelector('.pph-r').onclick=e=>{e.stopPropagation();left=60;fill(h);upd(h)};
 }
 const go=()=>{const p=document.getElementById('phone')||document.body;new MutationObserver(()=>{if(!q)q=requestAnimationFrame(add)}).observe(p,{childList:true,subtree:true});
  setInterval(()=>{const h=document.querySelector('#phone .pph');if(!h)return;left--;if(left<=0){left=60;fill(h)}upd(h)},1000);add()};
 if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',go);else go();
})();
</script>
<style id="v440css">
/* v440: itunda Shop reads like Toss Shopping and Kakao Shopping. Before: the page went straight from the search bar to a grid of cards, each with a photo tile, a red "% off" badge on top of the same percentage in the price, a purple "Earn back" line, a stock line, and no rating. Now: a "Today's deals" row at the top (the discounted products, biggest % first, side by side, with a live "Ends in" clock to midnight); on every product card the rating and review count (the same numbers as the product page), a calmer tile with 16px corners, and one place for the discount (next to the price). The "Earn back" line and the badge on the photo are off the cards (the product page still has the cashback line). */
.dl440{padding:0 0 6px}
#phone .shop348>.sec:has(+.dl440){display:none!important}
.dl-h{display:flex;align-items:baseline;justify-content:space-between;padding:8px 24px 10px}
.dl-h b{font-size:18px;font-weight:800}
.dl-t{font-size:14px;color:var(--mu);font-weight:600;font-variant-numeric:tabular-nums}
.dl-t .cd2{color:var(--er);font-weight:800}
.dl-r{display:flex;gap:12px;overflow-x:auto;padding:0 24px;scrollbar-width:none}.dl-r::-webkit-scrollbar{display:none}
.dl-c{flex:none;width:136px;min-width:136px;max-width:136px;box-sizing:border-box;min-height:0!important;border:0;background:none;padding:0;text-align:left;color:var(--tx);font:inherit;cursor:pointer}
.dl-i{width:136px;height:136px;border-radius:16px;background:var(--chip);display:flex;align-items:center;justify-content:center}
.dl-p{margin-top:8px;white-space:nowrap;font-size:14px;font-weight:800;font-variant-numeric:tabular-nums}.dl-d{color:var(--er);margin-right:4px}.dl-p small{font-size:12px;color:var(--mu);font-weight:700}
.dl-n{margin-top:2px;font-size:13px;color:var(--mu);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#phone .pgrid .pim{border-radius:16px}
#phone .pgrid .dbadge,#phone .pgrid .pc2{display:none!important}
.pcr{margin-top:4px;font-size:13px;color:var(--mu);font-weight:600;font-variant-numeric:tabular-nums}.pcr b{color:var(--tx);font-weight:700}.pcr s{text-decoration:none;color:#F5A623;margin-right:2px}
</style>
<script>
/* v440: Today's deals row and card ratings on Shop (see the v440 style block). */
(function(){
 const T=(e,r,f)=>{const l=(typeof S!=='undefined'&&S.lang)||'en';return l==='rw'?r:l==='fr'?f:e};
 const RT=[5,4,5,3,4,5];
 const left=()=>{const n=new Date(),m=new Date(n);m.setHours(24,0,0,0);const s=Math.max(0,Math.floor((m-n)/1000)),p=v=>String(v).padStart(2,'0');return p(Math.floor(s/3600))+':'+p(Math.floor(s%3600/60))+':'+p(s%60)};
 function rate(i){const a=S.shRv&&S.shRv[i],r=a?a.map(x=>x.r):[RT[i%6],RT[(i+2)%6],RT[(i+4)%6]];return r.length?{v:(r.reduce((s,x)=>s+x,0)/r.length).toFixed(1),n:r.length}:null}
 let q=0;
 function add(){
  q=0;
  document.querySelectorAll('#phone .pc:not([data-v440])').forEach(c=>{
   c.setAttribute('data-v440','1');const m=(c.getAttribute('onclick')||'').match(/openProd\((\d+)\)/);if(!m)return;
   const r=rate(+m[1]);if(!r)return;
   const el=document.createElement('div');el.className='pcr';el.innerHTML='<s>★</s><b>'+r.v+'</b> ('+r.n+')';
   const at=c.querySelector('.po')||c.querySelector('.pp');if(at)at.insertAdjacentElement('afterend',el);
  });
  const so=document.querySelector('#phone #shsort');
  if(so&&!document.querySelector('#phone .dl440')&&typeof PRODS!=='undefined'){
   const l=PRODS.map((x,i)=>[x,i]).filter(([x])=>x.o>x.p&&x.s>0).sort((a,b)=>pct(b[0].p,b[0].o)-pct(a[0].p,a[0].o)).slice(0,5);
   if(l.length){
    const d=document.createElement('div');d.className='dl440';
    d.innerHTML='<div class="dl-h"><b>'+T("Today's deals",'Ibyatanzwe uyu munsi','Offres du jour')+'</b><span class="dl-t">'+T('Ends in ','Birangira mu ','Se termine dans ')+'<span class="cd2">'+left()+'</span></span></div><div class="dl-r">'+l.map(([x,i])=>'<button class="dl-c tap" onclick="openProd('+i+')"><div class="dl-i">'+gl(x.g,56)+'</div><div class="dl-p"><span class="dl-d">'+pct(x.p,x.o)+'%</span>'+fmt(x.p)+' <small>RWF</small></div><div class="dl-n">'+x.n+'</div></button>').join('')+'</div>';
    so.insertAdjacentElement('beforebegin',d);
   }
  }
 }
 const go=()=>{const p=document.getElementById('phone')||document.body;new MutationObserver(()=>{if(!q)q=requestAnimationFrame(add)}).observe(p,{childList:true,subtree:true});
  setInterval(()=>{const e=document.querySelector('#phone .dl440 .cd2');if(e)e.textContent=left()},1000);add()};
 if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',go);else go();
})();
</script>
<style id="v441css">
/* v441: itunda Eats reads like Coupang Eats and Baemin. Before: every restaurant was a 168px-tall picture card, so a screen showed one and a half restaurants, and there was nothing between the filters and that list. Now: the list is compact rows (a 104px picture on the left; name, rating, time and distance, and fee and minimum on the right), about three restaurants per screen, and a "Fastest near you" row sits above the filters, shortest delivery first, so you can pick a place in one glance. The restaurant tag (Free delivery, Popular, New) is a small label on the picture. */
#phone #elist .rcard{display:grid;grid-template-columns:104px minmax(0,1fr);column-gap:14px;align-content:start;align-items:start;padding:0 24px 20px}
#phone #elist .rcard .rimg{grid-row:1/span 3;width:104px;height:104px;border-radius:16px}
#phone #elist .rcard .rimg svg{width:72px!important;height:72px!important}
#phone #elist .rcard .rtag{left:6px;top:auto;bottom:6px;white-space:nowrap;font-size:10px;padding:3px 7px;border-radius:8px}
#phone #elist .rcard>div:nth-child(n+3){font-size:13px!important;line-height:19px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#phone #elist .rcard .hrt{transform:scale(.85);transform-origin:top right}
#phone #elist .rcard>div:not(.rimg){margin-top:0!important;grid-column:2}
#phone #elist .rcard>div:nth-child(2){flex-direction:column!important;align-items:flex-start!important;gap:1px}
#phone #elist .rcard>div:nth-child(n+3){margin-top:2px!important}
.eh-h{padding:8px 24px 10px;font-size:18px;font-weight:800}
.eh-r{display:flex;gap:12px;overflow-x:auto;padding:0 24px 8px;scrollbar-width:none}.eh-r::-webkit-scrollbar{display:none}
.eh-c{flex:none;width:148px;border:0;background:none;padding:0;text-align:left;color:var(--tx);font:inherit;cursor:pointer}
.eh-i{width:148px;height:104px;border-radius:16px;display:flex;align-items:center;justify-content:center}
.eh-n{margin-top:8px;font-size:15px;font-weight:800;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.eh-m{margin-top:2px;font-size:13px;color:var(--mu);font-weight:600;font-variant-numeric:tabular-nums}
</style>
<script>
/* v441: "Fastest near you" row on Eats (see the v441 style block). */
(function(){
 const T=(e,r,f)=>{const l=(typeof S!=='undefined'&&S.lang)||'en';return l==='rw'?r:l==='fr'?f:e};
 let q=0;
 function tidy(){
  document.querySelectorAll('#phone #elist .rcard:not([data-v441])').forEach(c=>{
   c.setAttribute('data-v441','1');const k=c.children;if(k.length<4)return;
   const rt=k[1].querySelector('span'),m=(k[2].textContent||'').match(/\s*·\s*([\d,]+)\s+\S+\s*$/);
   if(rt&&m){rt.textContent=rt.textContent.trim()+' ('+m[1]+')';k[2].textContent=k[2].textContent.replace(m[0],'')}
   k[3].textContent=k[3].textContent.replace(/\s*RWF/g,'');
  });
 }
 function add(){
  q=0;tidy();const so=document.querySelector('#phone #esort');
  if(!so||document.querySelector('#phone .eh440')||typeof REST==='undefined')return;
  const l=REST.map((r,i)=>[r,i]).sort((a,b)=>a[0].tm-b[0].tm).slice(0,5);
  const d=document.createElement('div');d.className='eh440';
  d.innerHTML='<div class="eh-h">'+T('Fastest near you','Byihuse hafi yawe','Les plus rapides près de vous')+'</div><div class="eh-r">'+l.map(([r,i])=>'<button class="eh-c tap" onclick="openERest('+i+')"><div class="eh-i" style="background:'+r.bg+'">'+gl(r.g,56)+'</div><div class="eh-n">'+r.n+'</div><div class="eh-m">★ '+r.r+' · '+r.tm+' min</div></button>').join('')+'</div>';
  const p=so.previousElementSibling;(p&&p.classList.contains('chips')?p:so).insertAdjacentElement('beforebegin',d);
 }
 const go=()=>{const p=document.getElementById('phone')||document.body;new MutationObserver(()=>{if(!q)q=requestAnimationFrame(add)}).observe(p,{childList:true,subtree:true});add()};
 if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',go);else go();
})();
</script>
<style id="eats442css">
/* v442: Eats redesign (delivery-app layout). Flat fills and 1px lines only, matching the rest of the prototype */
#phone .e2-top{position:sticky;top:0;z-index:6;background:var(--bg);padding-bottom:10px}
#phone .e2-ad{display:flex;align-items:center;gap:6px;padding:10px 12px 6px 8px}
#phone .e2-adb{flex:1;min-width:0;display:flex;align-items:center;gap:8px;border:0;background:none;font:inherit;color:inherit;text-align:left;padding:4px 6px;min-height:44px}
#phone .e2-adb b{display:block;font-size:17px;font-weight:800;letter-spacing:-.3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#phone .e2-adb small{display:block;font-size:12px;color:var(--mu);margin-bottom:1px}
#phone .e2-ib{position:relative;width:44px;height:44px;border:0;background:none;display:flex;align-items:center;justify-content:center;color:var(--tx);flex-shrink:0}
#phone .e2-bd{position:absolute;top:5px;right:3px;min-width:18px;height:18px;border-radius:9px;background:var(--br);color:var(--on);font-size:11px;font-weight:800;display:flex;align-items:center;justify-content:center;padding:0 5px}
#phone .e2-sr{margin:0 24px;height:46px;border-radius:14px;background:var(--chip);display:flex;align-items:center;gap:10px;padding:0 14px;color:var(--mu)}
#phone .e2-sr input,#phone .e2-mq input{flex:1;min-width:0;height:100%;border:0!important;border-radius:0!important;padding:0!important;margin:0;background:transparent!important;box-shadow:none!important;font:inherit;font-size:15px;color:var(--tx);outline:none;-webkit-appearance:none;appearance:none}
#phone .e2-mode{display:flex;gap:8px;padding:14px 24px 0}
#phone .e2-mode button{flex:1;height:52px;border:0;border-radius:16px;background:var(--chip);color:var(--mu);display:flex;align-items:center;justify-content:center;gap:8px;font:inherit;font-weight:800;font-size:15px}
#phone .e2-mode button.on{background:var(--tint);color:var(--tintfg)}
#phone .e2-mode small{font-weight:600;font-size:12px;opacity:.85}
#phone .e2-cg{display:grid;grid-template-rows:repeat(2,auto);grid-auto-flow:column;grid-auto-columns:20%;overflow-x:auto;padding:16px 12px 0;row-gap:12px;scrollbar-width:none}
#phone .e2-cg::-webkit-scrollbar{display:none}
#phone .e2-cc{border:0;background:none;font:inherit;color:var(--tx);display:flex;flex-direction:column;align-items:center;gap:6px;padding:0;min-width:0}
#phone .e2-cc i{width:56px;height:56px;border-radius:20px;background:var(--chip);display:flex;align-items:center;justify-content:center;border:2px solid transparent}
#phone .e2-cc span{font-size:12px;font-weight:700;max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
#phone .e2-cc.on i{border-color:var(--br);background:var(--tint)}
#phone .e2-cc.on span{color:var(--tintfg)}
#phone .e2-bn{display:flex;gap:10px;overflow-x:auto;scroll-snap-type:x mandatory;padding:18px 24px 0;scrollbar-width:none}
#phone .e2-bn::-webkit-scrollbar{display:none}
#phone .e2-b{flex:0 0 100%;scroll-snap-align:center;border:0;border-radius:22px;padding:18px 18px;min-height:112px;display:flex;align-items:center;gap:10px;text-align:left;font:inherit;color:#191F28;position:relative;overflow:hidden}
#phone .e2-b b{display:block;font-size:19px;line-height:25px;font-weight:800;letter-spacing:-.4px}
#phone .e2-b span.s{display:block;font-size:13px;margin-top:4px;color:#3B4350!important;font-weight:600}
#phone .e2-b em{font-style:normal;display:inline-block;margin-top:10px;font-size:12px;font-weight:800;background:rgba(25,31,40,.9);color:#fff;border-radius:12px;padding:5px 10px}
#phone .e2-dots{display:flex;justify-content:center;gap:6px;padding-top:10px}
#phone .e2-dots i{width:6px;height:6px;border-radius:3px;background:var(--ln)}
#phone .e2-dots i.on{width:16px;background:var(--tx)}
#phone .e2-h{display:flex;align-items:baseline;justify-content:space-between;padding:26px 24px 0}
#phone .e2-h b{font-size:20px;font-weight:800;letter-spacing:-.4px}
#phone .e2-h span{font-size:13px;color:var(--mu);font-weight:600}
#phone .e2-rail{display:flex;gap:12px;overflow-x:auto;padding:12px 24px 0;scrollbar-width:none}
#phone .e2-rail::-webkit-scrollbar{display:none}
#phone .e2-rc{flex:0 0 156px;border:0;background:none;font:inherit;color:inherit;text-align:left;padding:0;min-width:0}
#phone .e2-rc .cv{height:108px;border-radius:18px;position:relative;display:flex;align-items:center;justify-content:center;overflow:hidden}
#phone .e2-rc b{display:block;font-size:15px;font-weight:800;margin-top:8px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#phone .e2-rc .m{font-size:12px;color:var(--mu);margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#phone .e2-eta{position:absolute;right:8px;bottom:8px;background:var(--bg);color:var(--tx);font-size:12px;font-weight:800;border-radius:10px;padding:4px 8px}
#phone .e2-bdg{position:absolute;left:8px;top:8px;background:var(--tx);color:var(--bg);font-size:11px;font-weight:800;border-radius:9px;padding:4px 8px;max-width:75%;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#phone .e2-bdg.p{background:var(--br);color:var(--on)}
#phone .e2-fl{display:flex;gap:6px;overflow-x:auto;padding:14px 24px 0;scrollbar-width:none}

const fix=()=>{document.querySelectorAll('.fms').forEach(f=>{const h=f.querySelector(':scope > b');if(!h||!f.querySelector('.pc'))return;
 const x=f.classList.contains('x');let w=f.querySelector(':scope > .nh359');
 if(!w){w=document.createElement('div');w.className='nh359';h.replaceWith(w);w.appendChild(h);const bt=document.createElement('button');bt.className='tap';bt.onclick=()=>mpSheet();w.appendChild(bt)}
 const bt=w.querySelector('button'),want=x?T('Show less','Gabanya','Moins'):T('Show more','Erekana byinshi','Voir plus');if(bt.textContent!==want)bt.textContent=want})};

#phone .e2-fl button{flex:none;height:38px;padding:0 14px;border-radius:19px;border:1px solid var(--ln);background:var(--bg);font:inherit;font-weight:700;font-size:14px;color:var(--tx)}
#phone .e2-fl button.on{background:var(--tx);color:var(--bg);border-color:var(--tx)}
#phone .e2-fl .sep{flex:none;width:1px;background:var(--ln);margin:6px 2px}
#phone .e2-card{padding:18px 24px 6px;cursor:pointer;display:block;width:100%;border:0;background:none;font:inherit;color:inherit;text-align:left}
#phone .e2-card .cv{height:156px;border-radius:22px;position:relative;overflow:hidden;display:flex;align-items:center;justify-content:center}
#phone .e2-card .cv .g2{position:absolute;left:18px;bottom:10px;transform:rotate(-14deg)}
#phone .e2-card .cv .g3{position:absolute;right:64px;top:14px;transform:rotate(12deg)}

 const re=/<div class="pz-acts"><button class="main" onclick="([^"]*)"[^>]*>([\s\S]*?)<\/button><button onclick="([^"]*)"[^>]*>[^<]*<\/button><button onclick="([^"]*)"[^>]*>[^<]*<\/button><\/div><div class="pz-row"><button class="btn" onclick="([^"]*)"[^>]*>[^<]*<\/button><button class="btn sec2" onclick="([^"]*)"[^>]*>[^<]*<\/button><\/div>/;
 const m=re.exec(h);if(!m||!sv)return h;
 const star=!!S.mp.star;

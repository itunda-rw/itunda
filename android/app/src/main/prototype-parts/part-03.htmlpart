'Every Kigali bus':['Buri bisi yo mu Kigali','Tous les bus de Kigali'],
'Tap your itunda card or phone':['Kora ku ikarita ya itunda cyangwa telefone yawe','Touchez avec votre carte itunda ou votre téléphone'],
'Top up bus card':['Kongeramo amafaranga ku ikarita ya bisi','Recharger la carte de bus'],
'Games':['Imikino','Jeux'],'Play with friends':['Mukine n’inshuti','Jouez entre amis'],'Word Puzzle':['Gukina amagambo','Jeu de mots'],'Daily puzzle':['Umukino wa buri munsi','Énigme du jour'],'Endless driving':['Gutwara bitarangira','Conduite sans fin'],
'Market Deals':['Amasoko ahendutse','Bonnes affaires'],'Local offers':['Ibyatanzwe hafi yawe','Offres locales'],'Grocery List':['Urutonde rw’ibiribwa','Liste de courses'],'Plan and share':['Teganya usangize','Planifiez et partagez'],'Parcel Track':['Gukurikirana ibipfunyika','Suivi de colis'],'Follow deliveries':['Kurikirana ibitangwa','Suivez vos livraisons'],
'Money':['Amafaranga','Argent'],'Budget Buddy':['Umufasha w’ingengo','Assistant budget'],'Track monthly spend':['Kurikirana ibyo wakoresheje ku kwezi','Suivez vos dépenses mensuelles'],'Rate Watch':['Gukurikirana ibiciro by’ivunjisha','Suivi des taux'],'Currency alerts':['Imenyesha ry’ivunjisha','Alertes de change'],'Receipt Box':['Agasanduku k’inyemezabuguzi','Boîte à reçus'],'Keep your receipts':['Bika inyemezabuguzi zawe','Gardez vos reçus'],
'Travel':['Ingendo','Voyage'],'Live arrivals':['Ahageze ako kanya','Arrivées en direct'],'Trip Planner':['Gutegura urugendo','Planificateur de voyage'],'Plan a weekend':['Teganya impera z’icyumweru','Planifiez un week-end'],'Stay Finder':['Gushaka icumbi','Trouver un logement'],'Guesthouses in Rwanda':['Amacumbi mu Rwanda','Maisons d’hôtes au Rwanda'],
'Learning':['Kwiga','Apprentissage'],'Kinyarwanda 101':['Ikinyarwanda 101','Kinyarwanda 101'],'Learn basics':['Wige ibanze','Apprenez les bases'],'Quiz Night':['Ijoro ry’ibibazo','Soirée quiz'],'Test your knowledge':['Gerageza ubumenyi bwawe','Testez vos connaissances'],'Library':['Isomero','Bibliothèque'],'Free e-books':['Ibitabo bya e-book ku buntu','Livres numériques gratuits'],
'Lifestyle':['Imibereho','Style de vie'],'Recipes':['Amafunguro','Recettes'],'Rwandan classics':['Amafunguro gakondo y’u Rwanda','Classiques rwandais'],'30-day workouts':['Imyitozo y’iminsi 30','Entraînements de 30 jours'],'Local stations':['Radiyo zo hafi','Stations locales'],
'Utilities':['Ibikoresho','Utilitaires'],'Flashlight':['Itara','Lampe torche'],'Quick light':['Itara ryihuse','Lumière rapide'],'Converter':['Uguhindura','Convertisseur'],'Units and sizes':['Ibipimo','Unités et tailles'],'Reminders':['Ibyibutsa','Rappels'],'Never forget':['Ntuzibagirwe','N’oubliez jamais'],
'128 GB, comes with charger and case. Pick up in Kimironko.':['128 GB, ije n’umuriro n’agakingirizo. Uyifatira i Kimironko.','128 Go, livré avec chargeur et coque. À récupérer à Kimironko.'],
'Solid wood, a few small marks. Buyer collects.':['Igiti gikomeye, hari utuntu duke twapfuye. Uyigura ayizanira.','Bois massif, quelques petites marques. À récupérer par l’acheteur.'],
'Worn twice. Bright pattern, very comfortable.':['Yambawe kabiri. Ifite amabara meza, yoroshye cyane.','Portée deux fois. Motif éclatant, très confortable.'],
'Serviced last month. New tyres.':['Yakorewe isuku ukwezi gushize. Amapine mashya.','Révisé le mois dernier. Pneus neufs.'],
'Shop assistant':['Umufasha mu iduka','Vendeur en magasin'],
'Serve customers and keep the counter tidy. Mornings, 5 days a week.':['Kwakira abakiriya no gusukura aho bishyurira. Mu gitondo, iminsi 5 mu cyumweru.','Servir les clients et garder le comptoir en ordre. Le matin, 5 jours par semaine.'],
'Friendly with customers':['Wakira neza abakiriya','Aimable avec les clients'],
'Can start within a week':['Ashobora gutangira mu cyumweru','Peut commencer sous une semaine'],
'Weekend tutor, maths':['Umwarimu wa weekend, imibare','Répétiteur le week-end, maths'],
'Cashier':['Umucungamari w’amafaranga','Caissier'],
'Phone repair apprentice':['Umwigishwa wo gusana telefone','Apprenti réparateur de téléphones'],
'Delivery rider, own moto':['Umushoferi utanga ibicuruzwa, afite moto ye','Livreur à moto, moto personnelle'],
'Flexible hours. You need a moto and a valid licence.':['Amasaha ashobora guhinduka. Ukeneye moto n’uruhushya rukiri ruzima.','Horaires flexibles. Il faut une moto et un permis valide.'],
'Own moto':['Moto yawe bwite','Moto personnelle'],
'Valid licence':['Uruhushya rukiri ruzima','Permis valide'],
'Smartphone':['Telefone igezweho','Smartphone'],
'Event helper':['Umufasha mu birori','Aide événementiel'],
'Help a secondary student prepare for exams. Two hours each Saturday.':['Fasha umunyeshuri wo mu yisumbuye kwitegura ibizamini. Amasaha abiri buri wa gatandatu.','Aidez un élève du secondaire à préparer ses examens. Deux heures chaque samedi.'],
'Secondary maths level':['Urwego rw’imibare rw’ayisumbuye','Niveau maths secondaire'],
'Patient with students':['Wihangana ku banyeshuri','Patient avec les élèves'],
'Set up chairs and welcome guests. One day only.':['Gutunganya intebe no kwakira abashyitsi. Umunsi umwe gusa.','Installer les chaises et accueillir les invités. Une seule journée.'],
'Can lift light items':['Ashobora guterura ibintu byoroheje','Peut porter des objets légers'],
'Available on the day':['Ahari uwo munsi','Disponible le jour même'],
'2-bedroom apartment':['Inzu y’ibyumba 2','Appartement 2 chambres'],
'Second floor, water and electricity on prepaid meters, close to the bus stop.':['Etaje ya kabiri, amazi n’amashanyarazi bya cash power, hafi y’aho bisi zihagarara.','Deuxième étage, eau et électricité sur compteurs prépayés, près de l’arrêt de bus.'],
'Studio near Kigali Heights':['Studio hafi ya Kigali Heights','Studio près de Kigali Heights'],
'Shop on a busy road':['Iduka ku muhanda urimo urujya n’uruza','Boutique sur une route fréquentée'],
'Family house with yard':['Inzu y’umuryango ifite urugo','Maison familiale avec cour'],
'Single room with shared yard':['Icyumba kimwe gifite urugo rusangiwe','Chambre simple avec cour partagée'],
'Quiet street, shared compound, near the market.':['Umuhanda utuje, urugo rusangiwe, hafi y’isoko.','Rue calme, cour partagée, près du marché.'],
'Room in a shared house':['Icyumba mu nzu isangiwe','Chambre dans une maison partagée'],
'3-bedroom house with garden':['Inzu y’ibyumba 3 ifite ubusitani','Maison 3 chambres avec jardin'],
'Titled plot, secure gate, walking distance to schools.':['Ikibanza gifite ibyangombwa, irembo rifite umutekano, hafi y’amashuri ugenda n’amaguru.','Terrain titré, portail sécurisé, à distance de marche des écoles.'],
'2-bedroom flat, city view':['Apartima y’ibyumba 2, ireba umujyi','Appartement 2 chambres, vue sur la ville'],
'Land plot, 600 m²':['Ikibanza cya m² 600','Terrain de 600 m²'],
'4-bedroom villa':['Villa y’ibyumba 4','Villa 4 chambres'],
'Furnished studio with fast internet and a security guard.':['Studio ifite ibikoresho, interineti yihuta n’umuzamu.','Studio meublé avec internet rapide et gardien.']
};
const R=[
[/^Balance ([\d,]+ RWF)$/,(m,i)=>[`Asigaye ${m[1]}`,`Solde : ${m[1]}`][i]],
[/^Earn ([\d,]+) RWF back \((\d+)% cashback\)$/,(m,i)=>[`Subizwa ${m[1]} RWF (cashback ya ${m[2]}%)`,`Gagnez ${m[1]} RWF de cashback (${m[2]} %)`][i]],
[/^(\d+)% off$/,(m,i)=>[`${m[1]}% yagabanyijwe`,`${m[1]} % de réduction`][i]],
[/^(.+) · (\d+) h ago$/,(m,i)=>[`${m[1]} · hashize amasaha ${m[2]}`,`${m[1]} · il y a ${m[2]} h`][i]],
[/^Agent (.+)$/,(m,i)=>i===0?`Umukozi ${m[1]}`:null]
];
let busy=0,q=0;
const run=()=>{q=0;if(S.lang!=='rw'&&S.lang!=='fr')return;const i=S.lang==='rw'?0:1,ph=document.getElementById('phone');if(!ph)return;busy=1;
 const w=document.createTreeWalker(ph,NodeFilter.SHOW_TEXT);let n;const ch=[];
 while(n=w.nextNode()){const t=n.textContent.trim();if(t.length<3)continue;let r=null;if(Object.prototype.hasOwnProperty.call(W,t))r=W[t][i];else for(const [x,f] of R){const m=x.exec(t);if(m){r=f(m,i);break}}
  if(r&&r!==t)ch.push([n,n.textContent.replace(t,r)])}
 ch.forEach(([n,v])=>{n.textContent=v});busy=0};
new MutationObserver(()=>{if(busy||q)return;q=1;requestAnimationFrame(run)}).observe(document.getElementById('phone'),{childList:true,subtree:true,characterData:true});run();
}
/* v374: Intercity bus booking in Kinyarwanda and French. The "English only" gate on the v344 flow is gone: the four rows (Where to?, Which day?, Which bus?, Seats), the pickers, the review, the "Seat booked" message, your tickets, cancelling, the low-balance line and the refund toast now follow the app language, including dates such as "Wed, 21 Oct". The Bike rental flow (v206) stays English only. */
{
const WD={Mon:['kuwa mbere','lun.'],Tue:['kuwa kabiri','mar.'],Wed:['kuwa gatatu','mer.'],Thu:['kuwa kane','jeu.'],Fri:['kuwa gatanu','ven.'],Sat:['kuwa gatandatu','sam.'],Sun:['ku cyumweru','dim.']};
const MO={Jan:['Mutarama','janv.'],Feb:['Gashyantare','févr.'],Mar:['Werurwe','mars'],Apr:['Mata','avr.'],May:['Gicurasi','mai'],Jun:['Kamena','juin'],Jul:['Nyakanga','juil.'],Aug:['Kanama','août'],Sep:['Nzeri','sept.'],Oct:['Ukwakira','oct.'],Nov:['Ugushyingo','nov.'],Dec:['Ukuboza','déc.']};
const DT='((?:Mon|Tue|Wed|Thu|Fri|Sat|Sun), \\d{1,2} (?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec))';
const dt=(s,i)=>{const m=/^(\w{3}), (\d{1,2}) (\w{3})$/.exec(s);return m?`${WD[m[1]][i]} ${m[2]} ${MO[m[3]][i]}`:s};
const seat=(n,i)=>i===0?(n==='1'?'umwanya 1':`imyanya ${n}`):`${n} ${n==='1'?'place':'places'}`;
const W={
'Intercity bus':['Bisi zijya mu ntara','Bus interurbain'],
'Leaves Nyabugogo, KN 3 Rd. 1 bag included.':['Zihagurukira Nyabugogo, KN 3 Rd. Umufuka 1 urimo.','Départ de Nyabugogo, KN 3 Rd. 1 bagage inclus.'],
'Where to?':['Ujya he?','Où allez-vous ?'],
'Which day?':['Umunsi uwuhe?','Quel jour ?'],
'Which bus?':['Bisi iyihe?','Quel bus ?'],
'Choose':['Hitamo','Choisir'],
'Seats':['Imyanya','Nombre de places'],
'Tomorrow':['Ejo','Demain'],
'Times and travel times are samples for this prototype.':['Amasaha n’igihe cy’urugendo ni ingero muri iyi prototype.','Les horaires et durées de trajet sont des exemples pour ce prototype.'],
'Pick a bus time to continue.':['Hitamo isaha ya bisi kugira ngo ukomeze.','Choisissez un horaire de bus pour continuer.'],
'No more buses today. Pick another day.':['Nta bisi zisigaye uyu munsi. Hitamo undi munsi.','Plus de bus aujourd’hui. Choisissez un autre jour.'],
'How many seats?':['Imyanya ingahe?','Combien de places ?'],
'Your tickets':['Amatike yawe','Vos billets'],
'Cancel ticket':['Hagarika itike','Annuler le billet'],
'Route':['Inzira','Trajet'],'Day':['Umunsi','Jour'],'Leaves':['Igenda','Départ'],
'Total':['Igiteranyo','Total'],
'Paid from':['Byishyuwe biturutse kuri','Payé depuis'],
'Balance after':['Asigaye nyuma','Solde après'],
'Free up to 2 h before':['Ubuntu kugeza hasigaye amasaha 2','Gratuit jusqu’à 2 h avant'],
'Seat booked':['Umwanya wafashwe','Place réservée'],
'Ticket':['Itike','Billet'],
'You get back':['Usubizwa','Vous récupérez'],
'Fee':['Ikiguzi','Frais'],
'Free':['Ubuntu','Gratuit'],
'Keep it':['Yigumane','Garder']
};
const R=[
[/^from itunda Pay · balance after ([\d,]+ RWF) · free to cancel up to 2 hours before$/,(m,i)=>[`kuri itunda Pay · asigaye nyuma ${m[1]} · kuhagarika ni ubuntu kugeza hasigaye amasaha 2`,`depuis itunda Pay · solde après : ${m[1]} · annulation gratuite jusqu’à 2 h avant`][i]],
[/^Book (\d+) seats? · ([\d,]+ RWF)$/,(m,i)=>[`Fata ${seat(m[1],0)} · ${m[2]}`,`Réserver ${seat(m[1],1)} · ${m[2]}`][i]],
[/^Book (\d+) seats? to (.+)\?$/,(m,i)=>[`Gufata ${seat(m[1],0)} kuri ${m[2]}?`,`Réserver ${seat(m[1],1)} pour ${m[2]} ?`][i]],
[/^Pay ([\d,]+ RWF)$/,(m,i)=>[`Ishyura ${m[1]}`,`Payer ${m[1]}`][i]],
[/^Arrives about (\d{2}:\d{2})$/,(m,i)=>[`Igera hafi saa ${m[1]}`,`Arrivée vers ${m[1]}`][i]],
[/^(\d+) seats?$/,(m,i)=>i===0?(m[1]==='1'?'umwanya 1':`imyanya ${m[1]}`):`${m[1]} ${m[1]==='1'?'place':'places'}`],
[/^about (\d+) h(?: (\d+))?$/,(m,i)=>i===0?`hafi y’amasaha ${m[1]}${m[2]?` n’iminota ${m[2]}`:''}`:`environ ${m[1]} h${m[2]?` ${m[2]}`:''}`],
[/^Nyabugogo to (.+)$/,(m,i)=>[`Nyabugogo kuri ${m[1]}`,`Nyabugogo vers ${m[1]}`][i]],
[/^Cancel$/,(m,i,n)=>{const p=n.parentElement;return p&&p.classList.contains('mu')?['Guhagarika','Annulation'][i]:['Hagarika','Annuler'][i]}],
[new RegExp('^'+DT+'$'),(m,i)=>dt(m[1],i)],
[new RegExp('^'+DT+' at (\\d{2}:\\d{2})$'),(m,i)=>[`${dt(m[1],0)} saa ${m[2]}`,`${dt(m[1],1)} à ${m[2]}`][i]],
[new RegExp('^'+DT+' at (\\d{2}:\\d{2}) · (\\d+) seats? · ([\\d,]+ RWF)$'),(m,i)=>[`${dt(m[1],0)} saa ${m[2]} · ${seat(m[3],0)} · ${m[4]}`,`${dt(m[1],1)} à ${m[2]} · ${seat(m[3],1)} · ${m[4]}`][i]],
[new RegExp('^Nyabugogo (?:to|kuri|vers) (.+), '+DT+' at (\\d{2}:\\d{2})\\. Show this code at Nyabugogo\\.$'),(m,i)=>[`Nyabugogo kuri ${m[1]}, ${dt(m[2],0)} saa ${m[3]}. Erekana iyi kode i Nyabugogo.`,`Nyabugogo vers ${m[1]}, ${dt(m[2],1)} à ${m[3]}. Présentez ce code à Nyabugogo.`][i]],
[/^itunda Pay balance now ([\d,]+ RWF)\. Your ticket stays on this page\.$/,(m,i)=>[`Amafaranga asigaye kuri itunda Pay ni ${m[1]}. Itike yawe iguma kuri uru rupapuro.`,`Solde itunda Pay : ${m[1]}. Votre billet reste sur cette page.`][i]],
[/^Cancel your ticket to (.+)\?$/,(m,i)=>[`Guhagarika itike yawe ijya i ${m[1]}?`,`Annuler votre billet pour ${m[1]} ?`][i]],
[/^([\d,]+ RWF) in itunda Pay$/,(m,i)=>[`${m[1]} kuri itunda Pay`,`${m[1]} sur itunda Pay`][i]],
[/^([\d,]+ RWF) is more than your itunda Pay balance of ([\d,]+ RWF)\. Pick fewer seats\.$/,(m,i)=>[`${m[1]} irarenze amafaranga ufite kuri itunda Pay (${m[2]}). Hitamo imyanya mike.`,`${m[1]} dépasse votre solde itunda Pay de ${m[2]}. Choisissez moins de places.`][i]],
[/^Ticket cancelled, ([\d,]+ RWF) refunded$/,(m,i)=>[`Itike yahagaritswe, ${m[1]} yasubijwe`,`Billet annulé, ${m[1]} remboursés`][i]],
[/^Intercity bus · (.+)$/,(m,i)=>[`Bisi zijya mu ntara · ${m[1]}`,`Bus interurbain · ${m[1]}`][i]],
[/^Intercity bus refund · (.+)$/,(m,i)=>[`Isubizwa ry’itike ya bisi · ${m[1]}`,`Remboursement bus interurbain · ${m[1]}`][i]]
];
let busy=0,q=0;
const run=()=>{q=0;if(S.lang!=='rw'&&S.lang!=='fr')return;const i=S.lang==='rw'?0:1,ph=document.getElementById('phone');if(!ph)return;busy=1;
 const w=document.createTreeWalker(ph,NodeFilter.SHOW_TEXT);let n;const ch=[];
 while(n=w.nextNode()){const t=n.textContent.trim();if(t.length<2)continue;let r=null;if(Object.prototype.hasOwnProperty.call(W,t))r=W[t][i];else for(const [x,f] of R){const m=x.exec(t);if(m){r=f(m,i,n);break}}
  if(r&&r!==t)ch.push([n,n.textContent.replace(t,r)])}
 ch.forEach(([n,v])=>{n.textContent=v});busy=0};
new MutationObserver(()=>{if(busy||q)return;q=1;requestAnimationFrame(run)}).observe(document.getElementById('phone'),{childList:true,subtree:true,characterData:true});run();
}
/* v375: last English leftovers found by opening every screen in French and Kinyarwanda: the loan page in Kinyarwanda (the "You can borrow up to" line, the sample-terms note, "Apply for 100,000 RWF"), Fill up from the bank ("All 842,300", "Next"), itunda Bank (Manage, New, Received), the Report an issue page ("No open cases"), and "You" and "Due" on the Ikimina round, the Pay account page and the Receive code. */
{
const W={
'Manage':['Gucunga','Gérer'],
'New':['Bishya','Nouveau'],
'Received':['Byakiriwe','Reçu'],
'Next':['Komeza','Suivant'],
'No open cases':['Nta bibazo bifunguye','Aucun dossier ouvert'],
'You':['Wowe','Vous'],
'Due':['Itarishyura','À payer'],
'Higher amounts unlock as your score improves. Sample terms for this prototype. No real loan is made.':['Amafaranga menshi arafunguka uko amanota yawe azamuka. Ibisabwa ni ingero muri iyi prototype. Nta nguzanyo nyayo itangwa.','']
};
const R=[
[/^All ([\d,]+)$/,(m,i)=>[`Yose ${m[1]}`,`Tout ${m[1]}`][i]],
[/^You can borrow up to ([\d,]+ RWF) with your score of (\d+)\.$/,(m,i)=>i===0?`Ushobora kuguza kugeza kuri ${m[1]} ukurikije amanota yawe ya ${m[2]}.`:null],
[/^Apply for ([\d,]+ RWF)$/,(m,i)=>i===0?`Saba ${m[1]}`:null]
];
let busy=0,q=0;
const run=()=>{q=0;if(S.lang!=='rw'&&S.lang!=='fr')return;const i=S.lang==='rw'?0:1,ph=document.getElementById('phone');if(!ph)return;busy=1;
 const w=document.createTreeWalker(ph,NodeFilter.SHOW_TEXT);let n;const ch=[];
 while(n=w.nextNode()){const t=n.textContent.trim();if(t.length<2)continue;let r=null;if(Object.prototype.hasOwnProperty.call(W,t))r=W[t][i];else for(const [x,f] of R){const m=x.exec(t);if(m){r=f(m,i,n);break}}
  if(r&&r!==t)ch.push([n,n.textContent.replace(t,r)])}
 ch.forEach(([n,v])=>{n.textContent=v});busy=0};
new MutationObserver(()=>{if(busy||q)return;q=1;requestAnimationFrame(run)}).observe(document.getElementById('phone'),{childList:true,subtree:true,characterData:true});run();
}
/* v376: SACCO shares in Kinyarwanda and French: the Buy 1 and Buy 5 buttons, the "From itunda Bank · … available" line, the confirm sheet ("Confirm your purchase", "Buy 5 SACCO shares for … from itunda Bank.", Confirm) and the "Bought 5 shares" message. */
{
const sh=(n,i)=>i===0?(n==='1'?'igabane 1':`imigabane ${n}`):`${n} ${n==='1'?'part':'parts'}`;
const W={'At year end':['Mu mpera z’umwaka','En fin d’année'],'Confirm your purchase':['Emeza kugura','Confirmez votre achat'],'Confirm':['Emeza','Confirmer']};
const R=[
[/^Buy (\d+)$/,(m,i)=>[`Gura ${m[1]}`,`Acheter ${m[1]}`][i]],
[/^(?:From|De|Kuva kuri) itunda Bank · ([\d,]+ RWF) available$/,(m,i)=>[`Kuri itunda Bank · hari ${m[1]}`,`Depuis itunda Bank · ${m[1]} disponibles`][i]],
[/^Buy (\d+) SACCO shares? for ([\d,]+ RWF) from itunda Bank\.$/,(m,i)=>[`Gura ${sh(m[1],0)} ya SACCO kuri ${m[2]} kuri itunda Bank.`,`Acheter ${sh(m[1],1)} SACCO pour ${m[2]} depuis itunda Bank.`][i]],
[/^Bought (\d+) shares?$/,(m,i)=>[`Waguze ${sh(m[1],0)}`,`${sh(m[1],1)} ${m[1]==='1'?'achetée':'achetées'}`][i]]
];
let busy=0,q=0;
const run=()=>{q=0;if(S.lang!=='rw'&&S.lang!=='fr')return;const i=S.lang==='rw'?0:1,ph=document.getElementById('phone');if(!ph)return;busy=1;
 const w=document.createTreeWalker(ph,NodeFilter.SHOW_TEXT);let n;const ch=[];
 while(n=w.nextNode()){const t=n.textContent.trim();if(t.length<2)continue;let r=null;if(Object.prototype.hasOwnProperty.call(W,t))r=W[t][i];else for(const [x,f] of R){const m=x.exec(t);if(m){r=f(m,i,n);break}}
  if(r&&r!==t)ch.push([n,n.textContent.replace(t,r)])}
 ch.forEach(([n,v])=>{n.textContent=v});busy=0};
new MutationObserver(()=>{if(busy||q)return;q=1;requestAnimationFrame(run)}).observe(document.getElementById('phone'),{childList:true,subtree:true,characterData:true});run();
}
/* v377: the Notifications sheet (sender lines, "Daily check-in is ready", "Claim +50 RWF in Shop", "31-day savings" reminder, "Mark all as read"), the Ikimina chat line "Next turn is …", the Eats address question ("Is your delivery address right?") and its "Free delivery" label, "5 left" stock labels in Kinyarwanda, "Paid · 08:12" on the Pay tab, and the Notifications title in Kinyarwanda. */
{
const W={
'Daily check-in is ready':['Kwiyandikisha buri munsi biri hafi','Le pointage quotidien est prêt'],
'Claim +50 RWF in Shop. Sample reward.':['Fata +50 RWF muri Shop. Ni igihembo cy’icyitegererezo.','Récupérez +50 RWF dans Boutique. Récompense d’exemple.'],
'Keep your streak going. Sample reminder.':['Komeza uko wabigenzaga. Ni ukwibutsa k’icyitegererezo.','Gardez votre série. Rappel d’exemple.'],
'Mark all as read':['Shyira byose nk’ibisomwe','Tout marquer comme lu'],
'Free delivery':['Kohererezwa ubuntu','Livraison offerte'],
'Notifications':['Ibimenyeshwa','Notifications']
};
const R=[
[/^(.+) sent you a message$/,(m,i)=>[`${m[1]} yagutumye ubutumwa`,`${m[1]} vous a envoyé un message`][i]],
[/^Next turn is (.+)$/,(m,i)=>[`Uzakurikira ni ${m[1]}`,`Prochain tour : ${m[1]}`][i]],
[/^Is your delivery address right\? (.+)$/,(m,i)=>[`Aderesi bakugezaho ni yo? ${m[1]}`,`Votre adresse de livraison est-elle correcte ? ${m[1]}`][i]],
[/^Paid · (\d{2}:\d{2})$/,(m,i)=>[`Yishyuwe · ${m[1]}`,`Payé · ${m[1]}`][i]],
[/^Received · (\d{2}:\d{2})$/,(m,i)=>[`Byakiriwe · ${m[1]}`,`Reçu · ${m[1]}`][i]],
[/^(\d+) left$/,(m,i)=>i===0?`Hasigaye ${m[1]}`:null]
];
let busy=0,q=0;
const run=()=>{q=0;if(S.lang!=='rw'&&S.lang!=='fr')return;const i=S.lang==='rw'?0:1,ph=document.getElementById('phone');if(!ph)return;busy=1;
 const w=document.createTreeWalker(ph,NodeFilter.SHOW_TEXT);let n;const ch=[];
 while(n=w.nextNode()){const t=n.textContent.trim();if(t.length<2)continue;let r=null;if(Object.prototype.hasOwnProperty.call(W,t))r=W[t][i];else for(const [x,f] of R){const m=x.exec(t);if(m){r=f(m,i,n);break}}
  if(r&&r!==t)ch.push([n,n.textContent.replace(t,r)])}
 ch.forEach(([n,v])=>{n.textContent=v});busy=0};
new MutationObserver(()=>{if(busy||q)return;q=1;requestAnimationFrame(run)}).observe(document.getElementById('phone'),{childList:true,subtree:true,characterData:true});run();
}
/* v378: Fixes. (1) The Eats group order (v2xx) and the checkout payment sheet had Kinyarwanda and French swapped, so French showed "Kwishyura", "Tumira", "Amafaranga ntahagije" and Kinyarwanda showed "Payer avec", "Commandez ensemble": about 50 lines now follow the app language. (2) Last English leftovers found by tapping through screens in French and Kinyarwanda: empty cart, Shop "All", "New message", Eats pickup tracking and delivery range, "Sent to", Maps place lines (distance, "Open · closes", next bus), route "Free", "Leave later", and the ride driver line. */
{
const tm=t=>t.replace(/^(\d{2}):00$/,'$1h').replace(/^(\d{2}):(\d{2})$/,'$1h$2');
const KD={'Bus stop':['Ahagarara bisi','Arrêt de bus'],'Restaurant':['Resitora','Restaurant'],'Cafe':['Kafe','Café'],'Pharmacy':['Farumasi','Pharmacie']};
const W={
'Your cart is empty':['Agaseke kawe ntikarimo ikintu','Votre panier est vide'],
'All':['Byose','Tout'],
'All areas':['Uturere twose','Toutes les zones'],
'New message':['Ubutumwa bushya','Nouveau message'],
'Up to 5 km':['Kugeza kuri km 5','Jusqu’à 5 km'],
'Your pickup':['Ibyo uzafata','Votre retrait'],
'Ready for pickup':['Biteguye gufatwa','Prêt à retirer'],
'Call your rider?':['Guhamagara umumotari wawe?','Appeler votre livreur ?'],
'Centered on you':['Hagati yawe','Centré sur vous'],
'Leave later: pick a time':['Genda nyuma: hitamo isaha','Partir plus tard : choisissez l’heure'],
'Driver on the way':['Umushoferi ari mu nzira','Chauffeur en route']
};
const R=[
[/^([\d.]+) km away · ready in (.+) min$/,(m,i)=>[`Km ${m[1]} uvuye hano · biraba biteguye mu minota ${m[2]}`,`à ${m[1]} km · prêt en ${m[2]} min`][i]],
[/^Sent to (.+)$/,(m,i)=>[`Byoherejwe kuri ${m[1]}`,`Envoyé à ${m[1]}`][i]],
[/^(\d+) m from (.+)$/,(m,i)=>[`Metero ${m[1]} uvuye kuri ${m[2]}`,`à ${m[1]} m de ${m[2]}`][i]],
[/^(Bus stop|Restaurant|Cafe|Pharmacy) · Open · closes (\d{2}:\d{2})$/,(m,i)=>[`${KD[m[1]][0]} · Birakinguye · bifunga saa ${m[2]}`,`${KD[m[1]][1]} · Ouvert · ferme à ${tm(m[2])}`][i]],
[/^Bus stop · ([\d, ]+) · Next: (\d+) in (\d+) min$/,(m,i)=>[`Ahagarara bisi · ${m[1]} · Itaha: ${m[2]} mu minota ${m[3]}`,`Arrêt de bus · ${m[1]} · Prochain : ${m[2]} dans ${m[3]} min`][i]],
[/^([\d.]+ km) · Free$/,(m,i)=>[`${m[1]} · Ubuntu`,`${m[1]} · Gratuit`][i]],
[/^(.+ · RAB [\w ]+) · arrives in (\d+) min$/,(m,i)=>[`${m[1]} · agera mu minota ${m[2]}`,`${m[1]} · arrive dans ${m[2]} min`][i]]
];
let busy=0,q=0;
const run=()=>{q=0;if(S.lang!=='rw'&&S.lang!=='fr')return;const i=S.lang==='rw'?0:1,ph=document.getElementById('phone');if(!ph)return;busy=1;
 const w=document.createTreeWalker(ph,NodeFilter.SHOW_TEXT);let n;const ch=[];
 while(n=w.nextNode()){const t=n.textContent.trim();if(t.length<2)continue;let r=null;if(Object.prototype.hasOwnProperty.call(W,t))r=W[t][i];else for(const [x,f] of R){const m=x.exec(t);if(m){r=f(m,i,n);break}}
  if(r&&r!==t)ch.push([n,n.textContent.replace(t,r)])}
 ch.forEach(([n,v])=>{n.textContent=v});busy=0};
new MutationObserver(()=>{if(busy||q)return;q=1;requestAnimationFrame(run)}).observe(document.getElementById('phone'),{childList:true,subtree:true,characterData:true});run();
}
/* v383: Top up (itunda Pay Top up / Move). Before: two quick chips (+10,000, +100,000), no daily limit, no reason shown when the amount was too high, a one-line confirm and a short toast. Now: quick chips +20,000, +50,000, +100,000, "Last 50,000" and "All · amount"; the 1,000,000 RWF daily limit is shown ("Daily limit left") and enforced with a clear message; when the source is short it says how much you have and offers another account that can cover it; the button says "Enter an amount" / "Amount too high" / "Next"; a proper review sheet (From, To, Fee, Arrives, balance after); the done message shows the new Pay balance. EN/RW/FR. */
/* v382: Proof of balance. Before: a fixed paragraph with today's exact balance and a text-only Share. Now: choose what it is for (visa, rent, school fees, employer or bank, other) and it says so on the letter; show the exact balance or only "at least" a rounded-down amount to keep the exact figure private; hide part of the account number; the letter shows time of issue, a 30-day validity date, a reference and a verify line, and updates live as you choose; Share saves it under "Recently issued" on Documents & letters, where it can be opened again (marked Expired after 30 days). EN/RW/FR. */
/* v381: Order together. Before: the host sheet had no way to checkout, showed "1 items" and had French and Kinyarwanda mixed in a few labels. Now: (1) start with friends or with no one and share the link; (2) the group sheet shows the link with a Copy button that says "Copied", each person with what they added and their amount, "Remind" for people who have not joined, a remove button, "Invite more friends", the group total, and "Go to checkout"; it updates live as friends join; (3) "End group order" asks first when friends have added items; (4) the Eats page row says who we are waiting for; (5) checkout shows each person's items and, when splitting, their exact share including delivery and the total friends owe you, a warning when someone has not joined, and a Manage link; (6) proper singular/plural and correct language in EN, RW and FR.  */
/* v380: Take a selfie, live feedback. The live view now checks the picture every 0.7 s and says what to fix (too dark, too bright, face not in the circle, move closer; face checks only where the browser supports FaceDetector), and the ring turns amber until it is right. A blocked camera now says so and how to fix it instead of the generic message. Back stays active during the 3-2-1 countdown so you can cancel. Fix: the two buttons in a row (Back / Open camera, Retake / Use this photo) are now level; a general spacing rule was pushing the second one 10px down. Fix: on short screens the page body was squeezed and its content ran under the fixed buttons without the page scrolling; it now keeps its full height so the whole page scrolls (v382: for every sheet that opens as a page, not only the ID steps). "Check your photo" shows a light check (green tick, or an amber warning with Retake as the main button). EN/RW/FR. All on device, nothing uploaded.
/* v379: Take a selfie. Before: a smiley in a dashed circle and a "Take selfie" button that submitted straight away, so nothing was captured and nothing could be checked or redone. Now: (1) no "Step n of m" wording (v270), a short "before you start" view with three tips (good light, no hat or glasses, face the camera); (2) "Open camera" starts the front camera in a round viewfinder (if the browser has no camera or you say no, a sample photo is used and the page says so, so the flow still works); (3) "Take selfie" counts 3, 2, 1 with a flash, then (4) "Check your photo" shows what was taken with "Retake" and "Use this photo"; (5) the camera is switched off as soon as the photo is taken or the sheet is closed; (6) the "Verification submitted" sheet shows the photo. English, Kinyarwanda and French. The photo stays in memory and is not uploaded. */
{
const T=(e,r,f)=>S.lang==='rw'?r:S.lang==='fr'?f:e;
let stream=null,photo=null,timer=null,mon=null,qual=null,mode='intro',sample=false;
const stopStream=()=>{if(stream){try{stream.getTracks().forEach(t=>t.stop())}catch(e){}stream=null}};
const stop=()=>{clearTimeout(timer);clearInterval(mon);mon=null;stopStream()};
const _cs=window.closeSheet;window.closeSheet=function(){stop();mode='closed';return _cs.apply(this,arguments)};
const label=()=>'';
const H=t=>`<div class="h1" style="font-size:22px;line-height:30px">${t}</div>`;
const SUB=t=>`<div class="mu" style="font-size:15px;margin:8px 0 0;line-height:22px">${t}</div>`;
const wrap=(h,aria)=>{$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" data-v185="1" role="dialog" aria-modal="true" aria-label="${aria}">${h}</div>`;if(typeof focusSheet==='function')focusSheet()};
const frame=(inner,ring)=>`<div style="position:relative;width:224px;height:224px;margin:22px auto 8px"><div id="vfcirc" style="width:224px;height:224px;border-radius:50%;overflow:hidden;background:var(--chip);display:flex;align-items:center;justify-content:center;font-size:84px;box-shadow:0 0 0 4px var(--bg),0 0 0 7px ${ring}" aria-hidden="${inner.indexOf('<img')===0?'false':'true'}">${inner}</div><div id="vfcnt" aria-hidden="true" style="position:absolute;inset:0;border-radius:50%;display:none;align-items:center;justify-content:center;font-size:72px;font-weight:800;color:#fff;background:rgba(0,0,0,.35)"></div><div id="vfflash" aria-hidden="true" style="position:absolute;inset:0;border-radius:50%;background:#fff;opacity:0;pointer-events:none;transition:opacity .25s"></div></div>`;
const tips=()=>`<div style="display:flex;gap:8px;flex-wrap:wrap;justify-content:center;margin-top:6px">${[['☀️',T('Good light','Ahari urumuri','Bonne lumière')],['🧢',T('No hat or glasses','Nta ngofero cyangwa amadarubindi','Sans chapeau ni lunettes')],['👀',T('Face the camera','Reba kamera','Face à la caméra')]].map(([i,t])=>`<span style="background:var(--chip);border-radius:16px;padding:6px 12px;font-size:13px;font-weight:700">${i} ${t}</span>`).join('')}</div>`;
const link=(t,fn)=>`<div style="text-align:center"><button style="background:none;border:0;color:var(--lk);font-weight:700;font-size:14px;padding:12px 8px 0" onclick="${fn}">${t}</button></div>`;
const privacy=()=>`<div class="sm mu" style="text-align:center;margin-top:10px;line-height:18px">${T('Prototype: the photo stays on this device and is not uploaded.','Prototype: ifoto iguma kuri iki gikoresho, ntisohoka.','Prototype : la photo reste sur cet appareil et n’est pas envoyée.')}</div>`;
const ttl=()=>T('Take a selfie','Fata ifoto yawe','Prenez un selfie');
const sub=()=>T('Look at the camera in good light. We match it to your ID.','Reba kamera ahari urumuri. Tuyigereranya n’indangamuntu yawe.','Regardez la caméra, bien éclairé. Nous la comparons à votre pièce.');
const back=()=>T('Back','Subira inyuma','Retour');

function intro(){mode='intro';photo=null;sample=false;
 wrap(label()+H(ttl())+SUB(sub())+frame('🙂','var(--ln)')+tips()+link(T('Use a sample photo','Koresha ifoto y’icyitegererezo','Utiliser une photo d’exemple'),'vfCamSample()')+privacy()+`<div class="row2" style="margin-top:22px"><button class="btn sec2" onclick="vfSelBack()">${back()}</button><button class="btn" onclick="vfCamOpen()">${T('Open camera','Fungura kamera','Ouvrir la caméra')}</button></div>`,ttl())}
function live(video){mode='live';
 wrap(label()+H(ttl())+SUB(sub())+frame(video?'<video id="vfvid" playsinline muted autoplay style="width:100%;height:100%;object-fit:cover;transform:scaleX(-1)"></video>':'🙂','var(--lk)')+`<div id="vfst" role="status" aria-live="polite" class="sm" style="text-align:center;min-height:20px;margin-top:6px;color:var(--mu)"></div>`+privacy()+`<div class="row2" style="margin-top:16px"><button class="btn sec2" id="vfbk" onclick="vfSelBack()">${back()}</button><button class="btn" id="vfshot" disabled onclick="vfShot()">${T('Take selfie','Fata ifoto','Prendre le selfie')}</button></div>`,ttl());
 setSt(video?T('Starting the camera…','Kamera iratangira…','Démarrage de la caméra…'):'')}
const AMB='#D98A00';
const lumOf=(src,w,h)=>{try{const c=document.createElement('canvas');c.width=c.height=24;const x=c.getContext('2d');x.drawImage(src,0,0,w,h,0,0,24,24);const d=x.getImageData(4,4,16,16).data;let t=0;for(let i=0;i<d.length;i+=4)t+=.299*d[i]+.587*d[i+1]+.114*d[i+2];return t/(d.length/4)}catch(e){return null}};
const ring=c=>{const e=$('#vfcirc');if(e)e.style.boxShadow='0 0 0 4px var(--bg),0 0 0 7px '+c};
const MSG={dark:()=>T('It is dark. Face a window or a lamp.','Hari umwijima. Reba ku idirishya cyangwa itara.','Il fait sombre. Placez-vous face à une fenêtre ou une lampe.'),
 bright:()=>T('Too bright. Turn so the light is not behind you.','Urumuri ni rwinshi. Hindukira urumuri rutaba inyuma yawe.','Trop lumineux. Évitez d’avoir la lumière derrière vous.'),
 noface:()=>T('We cannot see your face. Move into the circle.','Ntitubona mu maso hawe. Hinjira mu kizenga.','Nous ne voyons pas votre visage. Placez-le dans le cercle.'),
 far:()=>T('Move a little closer.','Sunikira gato.','Rapprochez-vous un peu.'),
 ok:()=>T('Looks good. Tap Take selfie.','Biranyuze. Kanda Fata ifoto.','Parfait. Touchez Prendre le selfie.'),
 center:()=>T('Center your face in the circle','Shyira mu maso hagati mu kizenga','Centrez votre visage dans le cercle')};
let fd=null;try{if('FaceDetector' in window)fd=new FaceDetector({fastMode:true,maxDetectedFaces:1})}catch(e){fd=null}
const judge=async v=>{if(!v||!v.videoWidth)return 'center';const l=lumOf(v,v.videoWidth,v.videoHeight);if(l!==null){if(l<55)return 'dark';if(l>215)return 'bright'}
 if(fd){try{const f=await fd.detect(v);if(!f.length)return 'noface';if(f[0].boundingBox.width<v.videoWidth*.3)return 'far'}catch(e){fd=null}}
 return fd?'ok':(l===null?'center':'ok')};
function watch(){clearInterval(mon);let busy=false;mon=setInterval(async()=>{if(mode!=='live'||busy)return;const v=$('#vfvid');if(!v)return;busy=true;const r=await judge(v);busy=false;if(mode!=='live'||!$('#vfvid'))return;if($('#vfcnt')&&$('#vfcnt').style.display==='flex')return;setSt(MSG[r]());ring(r==='ok'?'var(--ok)':(r==='center'?'var(--lk)':AMB))},700)}
function setSt(t){const e=$('#vfst');if(e)e.textContent=t}
function ready(){const c=$('#vfcirc'),b=$('#vfshot');if(c)c.style.boxShadow='0 0 0 4px var(--bg),0 0 0 7px var(--lk)';if(b)b.disabled=false;setSt(MSG.center());if(!sample)watch()}
function noCam(msg){stopStream();sample=true;const c=$('#vfcirc');if(c)c.innerHTML='🙂';ready();setSt(msg)}
window.vfCamOpen=()=>{sample=false;live(true);
 if(!(navigator.mediaDevices&&navigator.mediaDevices.getUserMedia)){noCam(T('Camera is not available here. A sample photo is used in this prototype.','Kamera ntiboneka hano. Muri iyi prototype hakoreshwa ifoto y’icyitegererezo.','La caméra n’est pas disponible ici. Une photo d’exemple est utilisée dans ce prototype.'));return}
 let p;try{p=navigator.mediaDevices.getUserMedia({video:{facingMode:'user',width:{ideal:640},height:{ideal:640}},audio:false})}catch(e){p=Promise.reject(e)}
 p.then(s=>{if(mode!=='live'){s.getTracks().forEach(t=>t.stop());return}const v=$('#vfvid');if(!v){s.getTracks().forEach(t=>t.stop());return}stream=s;v.srcObject=s;const g=v.play&&v.play();if(g&&g.catch)g.catch(()=>{});ready()}).catch(e=>{if(mode!=='live')return;const den=e&&(e.name==='NotAllowedError'||e.name==='SecurityError');noCam(den?T('Camera is blocked. Allow it in your browser settings and tap Retake, or continue with a sample photo.','Kamera irafunzwe. Yemere muri paramètres za browser hanyuma ukande Ongera ufate, cyangwa ukomeze n’ifoto y’icyitegererezo.','La caméra est bloquée. Autorisez-la dans les réglages du navigateur puis touchez Reprendre, ou continuez avec une photo d’exemple.'):T('Camera is not available here. A sample photo is used in this prototype.','Kamera ntiboneka hano. Muri iyi prototype hakoreshwa ifoto y’icyitegererezo.','La caméra n’est pas disponible ici. Une photo d’exemple est utilisée dans ce prototype.'))})};
window.vfCamSample=()=>{live(false);noCam(T('Sample photo for this prototype.','Ifoto y’icyitegererezo muri iyi prototype.','Photo d’exemple pour ce prototype.'))};
window.vfSelBack=()=>{stop();if(mode==='live'){intro();return}mode='closed';window.drawId()};
window.vfShot=()=>{const b=$('#vfshot');if(b)b.disabled=true;clearInterval(mon);
 const rm=window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches;let n=3;
 const tick=()=>{const c=$('#vfcnt');if(mode!=='live'||!c)return;if(n>0){c.style.display='flex';c.textContent=n;setSt(T('Hold still','Guma uhagaze','Ne bougez plus')+'…');n--;timer=setTimeout(tick,rm?500:750)}else{c.style.display='none';snap()}};tick()};
function snap(){const v=$('#vfvid'),f=$('#vfflash');photo=null;qual=null;
 if(v&&v.videoWidth){qual={l:lumOf(v,v.videoWidth,v.videoHeight)};try{const s=Math.min(v.videoWidth,v.videoHeight),cv=document.createElement('canvas');cv.width=cv.height=320;const x=cv.getContext('2d');x.translate(320,0);x.scale(-1,1);x.drawImage(v,(v.videoWidth-s)/2,(v.videoHeight-s)/2,s,s,0,0,320,320);photo=cv.toDataURL('image/jpeg',.8)}catch(e){photo=null}}
 if(f){f.style.opacity='.9';setTimeout(()=>{f.style.opacity='0'},120)}

const pp=p=>POS[p.id]||[H[0]+(p.x-170)*20,H[1]+(p.y-240)*20];
const ME=at('KM',-320,20),mePt={n:L('My location','Aho uri','Ma position'),p:ME};
const ep=n=>{if(!n||n==='My location')return mePt;const p=POI.find(x=>x.n===n);return p?{n:p.n,p:pp(p)}:{n:n,p:ND.TW.p}};
const dm=m=>m<1000?Math.max(10,Math.round(m/10)*10)+' m':(m/1000).toFixed(1)+' km';
const tm=s=>{const m=Math.max(1,Math.round(s/60));return m>=60?Math.floor(m/60)+' h '+(m%60)+' min':m+' min'};

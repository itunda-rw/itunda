<script>
/* v486: "Send in this chat" uses the same floating sheet as the Shop checkout modal: inset and fully rounded, grab handle, a title, and one grouped card with Send money, Gift and Split a bill, each with a short line under it and a chevron. Send money shows the itunda Pay balance it will come from. */
try{(()=>{
const L=(e,r,f)=>({en:e,rw:r,fr:f}[S.lang]||e);
window.chatMenu=function(){
 const CH=ic('chev',18,'var(--tt)');
 const it=(ico,t,m,on)=>`<div class="bsr tap" role="button" tabindex="0" onclick="${on}"><div class="ico" style="margin-right:12px">${gl(ico,30)}</div><div class="tt"><b>${t}</b><div class="m">${m}</div></div>${CH}</div>`;
 $('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet bs464" role="dialog" aria-modal="true" aria-label="${L('Send in this chat','Ohereza muri iki kiganiro','Envoyer dans ce chat')}"><div class="bsh"></div>
 <div class="bsp"><div><b class="pr" style="font-size:22px">${L('Send in this chat','Ohereza muri iki kiganiro','Envoyer dans ce chat')}</b></div></div>
 <div class="bsc">
  ${it('send',L('Send money','Ohereza amafaranga','Envoyer de l’argent'),L('From itunda Pay · ','Ziva kuri itunda Pay · ','Depuis itunda Pay · ')+fmt(S.pay)+' RWF',"closeSheet();flow()")}
  ${it('gift',L('Gift','Impano','Cadeau'),L('Send a gift voucher with a message','Ohereza inyemezabuguzi y’impano n’ubutumwa','Envoyez un bon cadeau avec un message'),"giftSheet()")}
  ${it('settle',L('Split a bill','Gabana fagitire','Partager une facture'),L('Share a bill with this chat','Gabana fagitire n’iki kiganiro','Partagez une facture avec ce chat'),"splitSheet()")}
 </div></div>`};
document.title=document.title.replace(/v\d+/,'v486');

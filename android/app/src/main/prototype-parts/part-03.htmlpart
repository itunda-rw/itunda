   row.innerHTML=`${ic0?ic0.outerHTML:''}<div style="flex:1;min-width:0"><div class="pz-n"><b style="font-size:17px;font-weight:600">${p.n}</b>${eats?'<em>Eats</em>':''}</div><span class="pz-m">${rt?'★ '+rt+' · ':''}${k} · <span class="pz-s${bad?' x':''}">${txt}</span></span></div><span class="pz-d">${p.d}</span>`});
  const d=document.createElement('div');d.appendChild(R);return d.innerHTML
 }catch(e){console.error('hub-v494',e);return h}};

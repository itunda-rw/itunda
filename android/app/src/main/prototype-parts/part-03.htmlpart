  const pay=R.querySelector('[onclick="plPay()"]'),rsv=R.querySelector('[onclick="plRsv()"]'),stamp=R.querySelector('[onclick="plStamp()"]');
  const wrap=(pay||stamp||R.querySelector('.tgs')||{closest:()=>null}).closest('div[style*="padding:18px"]');
  const tags=R.querySelector('.tgs'),tagsH=tags?`<div class="pz-tags">${tags.innerHTML}</div>`:'';
  let stH='',rsH='';

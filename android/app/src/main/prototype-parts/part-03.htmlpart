const adj={},hasBus={};for(const k in ND)adj[k]=[];EG.forEach(e=>{adj[e.a].push({to:e.b,e,r:0});adj[e.b].push({to:e.a,e,r:1});if(e.bs.length)hasBus[e.a]=hasBus[e.b]=1});
const dj=(s,t,cost)=>{const d={},pv={},q=new Set(Object.keys(ND));for(const k of q)d[k]=1e18;d[s]=0;while(q.size){let u=null;for(const k of q)if(u===null||d[k]<d[u])u=k;if(d[u]>=1e17)return null;q.delete(u);if(u===t)break;for(const x of adj[u]){const c=cost(x.e);if(d[u]+c<d[x.to]){d[x.to]=d[u]+c;pv[x.to]={u,x}}}}if(d[t]>=1e17)return null;const o=[];for(let k=t;k!==s;k=pv[k].u)o.unshift(pv[k].x);return o.map(x=>({n:x.to,e:x.e,r:x.r,g:x.r?x.e.g.slice().reverse():x.e.g}))};
const near=(P,bus)=>Object.keys(ND).filter(k=>!bus||hasBus[k]).sort((a,b)=>Math.hypot(ND[a].p[0]-P[0],ND[a].p[1]-P[1])-Math.hypot(ND[b].p[0]-P[0],ND[b].p[1]-P[1]))[0];

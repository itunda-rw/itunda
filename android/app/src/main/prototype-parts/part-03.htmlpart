/* seed old demo history item indexes stay valid only for clean carts */
S.e2cat=S.e2cat||'All';S.e2sort=S.e2sort||'fast';S.e2q=S.e2q||'';S.e2flt=S.e2flt||{open:0,top:0,near:0,fav:0};S.e2mq='';

const CATS=()=>[['All',T('All','Tout','Byose'),'restaurant'],['Brochette',T('Brochette','Brochette','Brochette'),'brochette'],['Chicken',T('Chicken','Poulet','Inkoko'),'chicken'],['Pizza','Pizza','pizza'],['Burgers',T('Burgers','Burgers','Burger'),'burger'],['Local',T('Local','Local','Ibiryo by’iwacu'),'rice'],['Chips',T('Chips','Frites','Chips'),'chips'],['Bakery',T('Bakery','Boulangerie','Ifuru'),'bread'],['Coffee',T('Coffee','Café','Ikawa'),'coffee'],['Juice',T('Juice','Jus','Umutobe'),'juice'],['Healthy',T('Healthy','Healthy','Ubuzima'),'salad'],['Dessert',T('Dessert','Dessert','Ibinyobwa biryoshye'),'cake']];
const addr=()=>(S.eaddrs&&S.eaddrs[S.eai])||['Home','Kimironko, KG 11 Ave','Kimironko, Kigali'];
const feeTxt=r=>S.pickup?T('Pickup','Retrait','Gufata'):(r.fee?T('Delivery','Livraison','Gutwara')+' '+fmt(r.fee):T('Free delivery','Livraison gratuite','Kugezwaho ku buntu'));
const etaTxt=r=>S.pickup?Math.max(10,r.tm-10)+' min':r.tm+' min';
const badgeOf=r=>r.closed?'':r.tag==='20% off'?T('20% off','-20 %','-20%'):r.tag==='New'?T('New','Nouveau','Gishya'):r.tag==='Popular'?T('Popular','Populaire','Bikunzwe'):r.tag==='Free delivery'&&!S.pickup?T('Free delivery','Livraison gratuite','Kugezwaho ku buntu'):'';
const cover=(r,sz)=>`<span class="o1"></span><span class="g2">${gl(r.g2||r.g,sz*.5)}</span><span class="g3">${gl(r.g3||r.g,sz*.42)}</span>${gl(r.g,sz)}`;
const inCart=()=>eCount()>0;
const cartBar=(withName)=>{if(!inCart())return'';const r=REST[S.er];return `<div class="cta"><button class="e2-cta" onclick="eCart()" aria-label="${T('View cart','Voir le panier','Reba agaseke')}"><span class="n">${eCount()}</span><span class="l">${T('View cart','Voir le panier','Reba agaseke')}${withName?' · '+esc(r.n):''}</span><span class="t">${RWF(eSub())}</span></button></div>`};

/* ---------- list logic ---------- */
const sorters={fast:(a,b)=>a.tm-b.tm,rating:(a,b)=>b.r-a.r||b.rc-a.rc,free:(a,b)=>a.fee-b.fee||a.tm-b.tm,near:(a,b)=>a.d-b.d};
const matches=r=>{const q=S.e2q;if(!q)return true;return (r.n+' '+r.sub+' '+r.cats.join(' ')+' '+r.items.map(x=>x[0]).join(' ')).toLowerCase().includes(q)};
const list=()=>{const f=S.e2flt,c=S.e2cat;return REST.map((r,i)=>[r,i]).filter(([r,i])=>(c==='All'||r.cats.includes(c))&&!(f.open&&r.closed)&&!(f.top&&r.r<4.7)&&!(f.near&&r.d>2)&&!(f.fav&&!S.efav[i])&&matches(r)).sort((a,b)=>(!!a[0].closed-!!b[0].closed)||sorters[S.e2sort](a[0],b[0]))};
const card=([r,i])=>{const b=badgeOf(r);return `<div class="e2-card tap" role="button" tabindex="0" onclick="openERest(${i})" onkeydown="if(event.key==='Enter')openERest(${i})" aria-label="${esc(r.n)}"><div class="cv" style="background:${r.bg}">${cover(r,84)}${b?`<span class="e2-bdg${r.tag==='20% off'?' p':''}">${esc(b)}</span>`:''}${r.closed?`<div class="e2-cl">${T('Back at '+r.closed,'Réouvre à '+r.closed,'Irafungura saa '+r.closed)}</div>`:`<span class="e2-eta">${etaTxt(r)}</span>`}<button class="e2-hrt" aria-label="${T('Save','Enregistrer','Bika')}" aria-pressed="${!!S.efav[i]}" onclick="event.stopPropagation();e2Fav(${i})">${heart(S.efav[i])}</button></div><div class="nm"><span class="t">${esc(r.n)}</span><span class="rt">${svg('<path d="M12 3l2.700 5.600 6.100.9-4.400 4.300 1 6.100L12 17l-5.400 2.900 1-6.100L3.200 9.500l6.100-.9z"/>',14,'#F5A524').replace('fill="none"','fill="#F5A524"')}${r.r.toFixed(1)} <em>(${r.rc})</em></span></div><div class="m">${esc(r.sub)} · ${r.d} km</div><div class="f"><span${!S.pickup&&!r.fee?' class="g"':''}>${feeTxt(r)}</span>${S.pickup?'':`<span>${T('Min','Min','Nibura')} ${fmt(r.min)}</span>`}${r.tag==='20% off'&&!r.closed?`<span class="g">${T('20% off with EATS20','-20 % avec EATS20','-20% na EATS20')}</span>`:''}</div></div>`};
const rcard=([r,i])=>`<button class="e2-rc tap" onclick="openERest(${i})" aria-label="${esc(r.n)}"><div class="cv" style="background:${r.bg}">${gl(r.g,64)}${r.closed?'':`<span class="e2-eta">${etaTxt(r)}</span>`}</div><b>${esc(r.n)}</b><div class="m">★ ${r.r.toFixed(1)} · ${feeTxt(r)}</div></button>`;
const rail=(t,sub,arr)=>arr.length?`<div class="e2-h"><b>${t}</b><span>${sub}</span></div><div class="e2-rail">${arr.map(rcard).join('')}</div>`:'';
const open=()=>REST.map((r,i)=>[r,i]).filter(x=>!x[0].closed);
const orderAgain=()=>{const seen=new Set(),o=[];(S.orders||[]).filter(x=>x.k==='Eats order'&&x.items&&REST[x.r]).forEach(x=>{if(!seen.has(x.r)){seen.add(x.r);o.push([REST[x.r],x.r])}});return o.slice(0,6)};

/* ---------- home ---------- */
const BN=()=>[
 {bg:'#FFE08A',t:T('Free delivery on your first order','Livraison offerte dès la 1re commande','Kugezwaho ku buntu ku itegeko rya mbere'),s:T('Code FREEDEL, auto-applied at checkout','Code FREEDEL, appliqué au paiement','Kode FREEDEL'),b:T('Use code','Utiliser','Koresha'),g:'gift',a:"e2Promo('FREEDEL')"},
 {bg:'#CFE8FF',t:T('20% off your meal','20 % de réduction','Igabanywa rya 20%'),s:T('Up to 2,000 RWF with EATS20','Jusqu’à 2 000 RWF avec EATS20','Kugeza 2,000 RWF na EATS20'),b:T('Get 20% off','Obtenir -20 %','Fata 20%'),g:'voucher',a:"e2Promo('EATS20')"},
 {bg:'#D9F2D2',t:T('Hungry? Under 20 minutes','Un petit creux ? Moins de 20 min','Ushonje? Munsi y’iminota 20'),s:T('Restaurants close to you, fastest first','Les plus proches, les plus rapides d’abord','Resitora ziri hafi yawe'),b:T('See fastest','Voir','Reba'),g:'moto',a:"e2Fast()"}];
const home=()=>{
 const a=addr(),n=eCount(),L=list(),cats=CATS(),pk=!!S.pickup,fl=S.e2flt,bn=BN();
 const ch=(k,l)=>`<button class="${S.e2sort===k?'on':''}" aria-pressed="${S.e2sort===k}" onclick="e2Sort('${k}')">${l}</button>`;
 const fb=(k,l)=>`<button class="${fl[k]?'on':''}" aria-pressed="${!!fl[k]}" onclick="e2Flt('${k}')">${l}</button>`;
 const filtered=S.e2cat!=='All'||S.e2q||fl.open||fl.top||fl.near||fl.fav;
 const ar=orderAgain();
 return `<div class="e2-top"><div class="e2-ad"><button class="e2-ib" aria-label="${T('Back','Retour','Subira inyuma')}" onclick="back()">${ico('back',24)}</button><button class="e2-adb" onclick="eAddr()" aria-label="${T('Change delivery address','Changer l’adresse','Hindura aderesi')}"><span style="color:var(--tintfg)">${ico('pin',22)}</span><span style="min-width:0;flex:1"><small>${pk?T('Pickup near','Retrait près de','Gufata hafi ya'):T('Deliver to','Livrer à','Kugezwaho')}</small><b>${esc(a[1])} ${ico('chev',16)}</b></span></button><button class="e2-ib" aria-label="${T('Orders','Commandes','Ibyatumijwe')}" onclick="S.stack=['shop','eorders'];render('push')">${ico('rec',24)}</button><button class="e2-ib" aria-label="${T('Cart','Panier','Agaseke')}" onclick="${n?'eCart()':`toast('${T('Your cart is empty','Votre panier est vide','Agaseke karimo ubusa')}')`}">${ico('bag',24)}${n?`<span class="e2-bd">${n}</span>`:''}</button></div><div class="e2-sr">${ico('search',20)}<input id="e2q" type="search" enterkeyhint="search" aria-label="${T('Search restaurants','Rechercher','Shakisha')}" placeholder="${T('Search restaurants or dishes','Restaurants ou plats','Shakisha resitora cyangwa ibiryo')}" value="${esc(S.e2q)}" oninput="e2Search(this.value)"></div></div>
<div class="seg" style="padding-top:6px"><button onclick="setShopTab('shop')">${T('Shop','Boutique','Isoko')}</button><button class="on">${T('Eats','Repas','Ibiryo')}</button></div>
<div class="e2-mode" role="group"><button class="${pk?'':'on'}" aria-pressed="${!pk}" onclick="e2Pk(false)">${ico('moto',22)}<span>${T('Delivery','Livraison','Gutwarirwa')}<br><small>${T('To your door','À votre porte','Ku muryango')}</small></span></button><button class="${pk?'on':''}" aria-pressed="${pk}" onclick="e2Pk(true)">${ico('bag',22)}<span>${T('Pickup','Retrait','Gufata')}<br><small>${T('No delivery fee','Sans frais','Nta kiguzi')}</small></span></button></div>
<button class="e2-cp tap" onclick="e2Cp()">${ico('tag',22)}<span><b>${T('Coupons','Coupons','Kuponi')}</b> · ${T('2 available','2 disponibles','2 zihari')}${S.epromo?' · '+S.epromo+' ✓':''}</span>${ico('back',16).replace('M15 5l-7 7 7 7','M9 5l7 7-7 7')}</button><div class="e2-cg" role="group" aria-label="${T('Categories','Catégories','Ibyiciro')}">${cats.map((c,i)=>i%2?cats[6+(i-1)/2]:cats[i/2]).map(([k,l,g])=>`<button class="e2-cc ${S.e2cat===k?'on':''}" aria-pressed="${S.e2cat===k}" onclick="e2Cat('${k}')"><i>${gl(g,34)}</i><span>${l}</span></button>`).join('')}</div>
${filtered?'':`<div class="e2-bn" id="e2bn" onscroll="e2Bn(this)">${bn.map(x=>`<button class="e2-b tap" style="background:${x.bg}" onclick="${x.a}"><span style="flex:1;min-width:0"><b>${x.t}</b><span class="s">${x.s}</span><em>${x.b}</em></span>${gl(x.g,64)}</button>`).join('')}</div><div class="e2-dots" id="e2dots">${bn.map((x,i)=>`<i class="${i?'':'on'}"></i>`).join('')}</div>
${ar.length?rail(T('Order again','Commander à nouveau','Tegeka nanone'),T('Your recent','Récents','Ibya vuba'),ar):''}
${rail(T('Fastest near you','Les plus rapides','Byihuse hafi yawe'),T('Under 20 min','Moins de 20 min','Munsi y’iminota 20'),open().filter(x=>x[0].tm<=20).sort((a,b)=>a[0].tm-b[0].tm))}
${rail(T('Free delivery','Livraison gratuite','Kugezwaho ku buntu'),'',open().filter(x=>!x[0].fee))}
${rail(T('New on itunda','Nouveau sur itunda','Bishya kuri itunda'),'',open().filter(x=>x[0].tag==='New'))}
${rail(T('Top rated','Les mieux notés','Bikunzwe cyane'),'★ 4.7+',open().filter(x=>x[0].r>=4.7).sort((a,b)=>b[0].r-a[0].r))}`}
<div class="e2-h" id="e2all"><b>${T('All restaurants','Tous les restaurants','Resitora zose')}</b><span id="e2n">${L.length}</span></div>
<div class="e2-fl" role="group" aria-label="${T('Sort','Trier','Tondeka')}">${ch('fast',T('Fastest','Plus rapide','Byihuse'))}${ch('rating',T('Top rated','Mieux notés','Bikunzwe'))}${ch('free',T('Free delivery','Gratuite','Ku buntu'))}${ch('near',T('Nearest','Plus proche','Hafi'))}</div>
<div class="e2-fl" role="group" aria-label="${T('Filters','Filtres','Akayunguruzo')}">${fb('open',T('Open now','Ouvert','Irakinguye'))}${fb('top','★ 4.7+')}${fb('near',T('Under 2 km','Moins de 2 km','Munsi ya km 2'))}${fb('fav',heartTxt())}</div>
<div id="e2list">${listHtml(L)}</div>
<div class="e2-fine">${T('Menus, prices and ratings are sample data.','Menus, prix et notes : données d’exemple.','Menu, ibiciro n’amanota ni urugero.')}</div>${cartBar(true)}`};
const heartTxt=()=>'♥ '+T('Saved','Enregistrés','Ibyabitswe');
const listHtml=L=>L.length?L.map(card).join(''):`<div class="e2-em">${T('No restaurants match.','Aucun restaurant trouvé.','Nta resitora ibonetse.')}<br><button class="cch on" onclick="e2Clear()">${T('Clear filters','Effacer les filtres','Siba akayunguruzo')}</button></div>`;
const redraw=()=>{const l=q$('#e2list');if(!l)return;const L=list();l.innerHTML=listHtml(L);const n=q$('#e2n');if(n)n.textContent=L.length};
const isF=()=>S.e2cat!=='All'||S.e2q||S.e2flt.open||S.e2flt.top||S.e2flt.near||S.e2flt.fav;
window.e2Search=v=>{const was=!!isF();S.e2q=v.trim().toLowerCase();if(!!isF()!==was){const pos=v.length;rr();const i=q$('#e2q');if(i){i.focus();try{i.setSelectionRange(pos,pos)}catch(e){}}}else redraw()};
window.e2Cat=c=>{S.e2cat=c;rr();if(c!=='All'){const t=q$('#e2all'),sc=$('#sc');if(t&&sc)sc.scrollTop=Math.max(0,t.offsetTop-130)}};
window.e2Sort=k=>{S.e2sort=k;rr()};
window.e2Flt=k=>{S.e2flt[k]=S.e2flt[k]?0:1;rr()};
window.e2Clear=()=>{S.e2cat='All';S.e2q='';S.e2flt={open:0,top:0,near:0,fav:0};rr()};
window.e2Pk=v=>{S.pickup=!!v;if(v&&S.epromo==='FREEDEL')S.epromo=null;rr()};
window.e2Fav=i=>{S.efav[i]=!S.efav[i];rr()};
window.e2Fast=()=>{S.e2sort='fast';rr();const t=q$('#e2all'),sc=$('#sc');if(t&&sc)sc.scrollTo({top:Math.max(0,t.offsetTop-130),behavior:'smooth'})};
window.e2Promo=c=>{if(c==='FREEDEL'&&S.pickup){toast(T('Free delivery only applies to delivery orders','La livraison gratuite ne s’applique qu’aux livraisons','Kugezwaho ku buntu bireba gutwarwa gusa'));return}S.epromo=c;toast(T('Code '+c+' saved. It applies at checkout.','Code '+c+' enregistré. Appliqué au paiement.','Kode '+c+' yabitswe.'))};
window.e2Bn=el=>{const i=Math.round(el.scrollLeft/(el.firstElementChild.offsetWidth+10));document.querySelectorAll('#e2dots i').forEach((d,k)=>d.classList.toggle('on',k===i))};

/* ---------- restaurant ---------- */
const sections=r=>{const m=new Map(),pop=[];r.items.forEach((it,k)=>{if(it[4]==='addon')return;if(it[6]==='Popular')pop.push(k);if(!m.has(it[5]))m.set(it[5],[]);m.get(it[5]).push(k)});const out=[];if(pop.length)out.push([T('Popular','Populaires','Bikunzwe'),pop]);m.forEach((v,k)=>out.push([secName(k),v]));return out};
const secName=k=>({Pastries:T('Pastries','Viennoiseries','Utuntu tw’ifu'),Cakes:T('Cakes','Gâteaux','Ibitunguru'),Bread:T('Bread','Pain','Imigati'),Drinks:T('Drinks','Boissons','Ibinyobwa'),Grill:T('Grill','Grillades','Ibyokeje'),Sides:T('Sides','Accompagnements','Ibyiyongera'),Meals:T('Meals','Plats','Amafunguro'),Coffee:T('Coffee','Café','Ikawa'),Tea:T('Tea','Thé','Icyayi'),Bites:T('Bites','Petites faims','Utuntu'),Chicken:T('Chicken','Poulet','Inkoko'),Wraps:T('Wraps','Wraps','Wraps'),Pizzas:'Pizzas',Burgers:'Burgers',Smoothies:'Smoothies',Juices:T('Juices','Jus','Imitobe'),Bowls:T('Bowls','Bols','Bowls'),Chips:'Chips',Combos:'Combos',Fish:T('Fish','Poisson','Amafi'),Salads:T('Salads','Salades','Salade'),Slices:T('Slices','Parts','Ibice'),'Whole cakes':T('Whole cakes','Gâteaux entiers','Ibitunguru byose'),Brochettes:'Brochettes'}[k]||k);
const itemRow=(r,k,inPop)=>{const it=r.items[k],q=S.ecart[k]||0,dis=!!r.closed;return `<div class="e2-it" data-k="${k}" data-s="${esc((it[0]+' '+it[1]).toLowerCase())}"><button class="e2-itx" onclick="${dis?`toast('${T('Back at '+r.closed,'Réouvre à '+r.closed,'Irafungura saa '+r.closed)}')`:`eItem(${k})`}"><div class="e2-in">${esc(it[0])}${it[6]==='Popular'&&!inPop?`<span class="e2-bt">${T('Popular','Populaire','Bikunzwe')}</span>`:''}</div>${it[1]?`<div class="e2-id">${esc(it[1])}</div>`:''}<div class="e2-ip">${RWF(it[2])}</div></button><div class="e2-th" style="background:${r.bg}">${gl(it[3],58)}${q?`<span class="e2-sp"><button aria-label="${T('Remove one','Retirer un','Kuramo kimwe')}" onclick="e2Dec(${k})">−</button><b>${q}</b><button aria-label="${T('Add one','Ajouter un','Ongeraho kimwe')}" onclick="eAdd(${k})">+</button></span>`:`<button class="e2-pl" ${dis?'disabled':''} aria-label="${T('Add','Ajouter','Ongeraho')} ${esc(it[0])}" onclick="eAdd(${k})">+</button>`}</div></div>`};
const REV=[['Aline U.',5,'Fresh and still warm when it arrived.','2 days ago'],['Eric M.',4,'Good portions, a little late on Friday.','1 week ago'],['Claire M.',5,'My weekly order. Always right.','2 weeks ago'],['Jean Paul',5,'Rider was polite and quick. Packaging kept everything hot.','3 weeks ago'],['Divine N.',4,'Tasty, a bit pricey for the portion.','1 month ago']];
const erest=()=>{
 const r=REST[S.er],i=S.er,k=S.etab||'menu',sec=sections(r),pk=!!S.pickup;
 const head=`<div class="e2-tb"><div class="e2-tbi" id="e2tbi"><button class="e2-rb" aria-label="${T('Back','Retour','Subira inyuma')}" onclick="back()">${ico('back',22)}</button><div class="e2-tt">${esc(r.n)}</div><button class="e2-rb" aria-label="${T('Share','Partager','Sangiza')}" onclick="e2Share()">${ico('share',20)}</button><button class="e2-rb" aria-label="${T('Save','Enregistrer','Bika')}" aria-pressed="${!!S.efav[i]}" onclick="e2Fav(${i})">${heart(S.efav[i],22)}</button></div></div>`;
 const hero=`<div class="e2-hero" style="background:${r.bg}">${cover(r,120)}</div>`;
 const info=`<div class="e2-sh"><div class="e2-nmh">${esc(r.n)}</div><div class="e2-rtl"><b style="color:var(--tx)">★ ${r.r.toFixed(1)}</b><span>(${r.rc} ${T('reviews','avis','ibitekerezo')}) · ${r.d} km</span></div><div class="e2-rtl" style="padding-top:2px"><span>${esc(r.sub)}</span></div>
<div class="e2-st"><div><small>${pk?T('Ready in','Prêt en','Bizaba byiteguye'):T('Delivery','Livraison','Kugezwaho')}</small><b>${pk?etaTxt(r):r.t+' min'}</b></div><div><small>${pk?T('Distance','Distance','Intera'):T('Fee','Frais','Igiciro')}</small><b>${pk?r.d+' km':r.fee?fmt(r.fee)+' RWF':T('Free','Gratuit','Ku buntu')}</b></div><div><small>${T('Min order','Minimum','Nibura')}</small><b>${fmt(r.min)} RWF</b></div></div>
<div class="e2-mode" style="padding-top:12px"><button class="${pk?'':'on'}" aria-pressed="${!pk}" onclick="e2Pk(false)" style="height:44px">${ico('moto',20)}<span>${T('Delivery','Livraison','Gutwarirwa')}</span></button><button class="${pk?'on':''}" aria-pressed="${pk}" onclick="e2Pk(true)" style="height:44px">${ico('bag',20)}<span>${T('Pickup','Retrait','Gufata')}</span></button></div>
${r.closed?`<div class="e2-cn" role="status"><b>${T('Not taking orders right now','Ne prend pas de commandes','Ntibakira ibitegeko ubu')}</b><br>${T('Back at '+r.closed+'. You can browse the menu.','Réouvre à '+r.closed+'. Vous pouvez voir le menu.','Irafungura saa '+r.closed+'. Wareba menu.')}</div>`:''}
${r.tag==='20% off'?`<button class="e2-pm tap" onclick="e2Promo('EATS20')">${ico('tag',22)}<span>${T('20% off up to 2,000 RWF','20 % jusqu’à 2 000 RWF','20% kugeza 2,000 RWF')}</span><em>EATS20</em></button>`:!r.fee&&!pk?`<div class="e2-pm">${ico('moto',22)}<span>${T('Free delivery from this restaurant','Livraison gratuite','Kugezwaho ku buntu')}</span></div>`:''}
<div style="padding:12px 24px 0"><button class="tap" style="width:100%;display:flex;align-items:center;gap:12px;border:1px solid var(--ln);border-radius:16px;background:var(--bg);padding:12px 14px;font:inherit;color:inherit;text-align:left" onclick="egStart()"><span style="width:40px;height:40px;border-radius:20px;background:var(--tint);color:var(--tintfg);display:flex;align-items:center;justify-content:center;flex-shrink:0">${svg('<path d="M9 11a3 3 0 100-6 3 3 0 000 6zM3 20c0-3 3-5 6-5s6 2 6 5M17 8a3 3 0 010 6"/>',22)}</span><span style="flex:1"><b style="font-size:15px;display:block">${T('Group order','Commande groupée','Itegeko ry’itsinda')}</b><span class="sm mu">${T('Order together and split the bill','Commandez ensemble et partagez','Mutegeke hamwe mugabane')}</span></span>${svg('<path d="M9 5l7 7-7 7"/>',16,'var(--tt)')}</button></div>
<div class="e2-tabs" role="tablist">${[['menu',T('Menu','Menu','Ibiryo')],['info',T('Info','Infos','Amakuru')],['reviews',T('Reviews','Avis','Ibitekerezo')]].map(([id,l])=>`<button role="tab" aria-selected="${k===id}" class="${k===id?'on':''}" onclick="eTab('${id}')">${l}</button>`).join('')}</div>`;
 let body='';
 if(k==='menu'){body=`<div class="e2-mq">${ico('search',20)}<input id="e2mq" type="search" aria-label="${T('Search the menu','Rechercher dans le menu','Shakisha ku biryo')}" placeholder="${T('Search the menu','Rechercher dans le menu','Shakisha ku biryo')}" oninput="e2Mq(this.value)"></div>
<div class="e2-sc" id="e2sc" role="tablist">${sec.map(([n],j)=>`<button class="${j?'':'on'}" onclick="e2Sec(${j})">${esc(n)}</button>`).join('')}</div>
<div id="e2menu">${sec.map(([n,ks],j)=>`<div class="e2-sec" id="e2s${j}"><h3>${esc(n)}</h3>${ks.map(x=>itemRow(r,x,j===0&&sec[0][0]===T('Popular','Populaires','Bikunzwe'))).join('')}</div>`).join('')}</div><div id="e2mq0" class="e2-em" style="display:none">${T('No dishes match','Aucun plat trouvé','Nta biryo bibonetse')}</div>`}
 else if(k==='info'){body=`<div class="e2-nf">${[[T('Address','Adresse','Aho biherereye'),r.addr],[T('Opening hours','Horaires','Amasaha yo gukora'),r.hrs],[T('Phone','Téléphone','Telefoni'),r.ph],[T('Distance','Distance','Intera'),r.d+' km'],[T('Delivery area','Zone de livraison','Aho bigezwa'),T('Up to 5 km','Jusqu’à 5 km','Kugeza kuri km 5')],[T('Pay with','Payer avec','Kwishyura'),'itunda Pay · '+T('Cash on delivery','Paiement à la livraison','Kwishyura amafaranga')]].map(([a,b])=>`<div><span>${a}</span><b>${esc(b)}</b></div>`).join('')}</div>`}
 else{const dist=[62,25,8,3,2];body=`<div style="display:flex;gap:18px;align-items:center;padding:20px 24px 8px"><div style="text-align:center"><div style="font-size:40px;font-weight:800;letter-spacing:-1px">${r.r.toFixed(1)}</div><div class="sm mu">${r.rc} ${T('reviews','avis','ibitekerezo')}</div></div><div style="flex:1;display:grid;gap:5px">${dist.map((p,n)=>`<div style="display:flex;align-items:center;gap:10px;font-size:13px"><span style="width:10px">${5-n}</span><div style="flex:1;height:8px;border-radius:4px;background:var(--chip)"><div style="width:${p}%;height:8px;border-radius:4px;background:var(--lk)"></div></div><span class="mu" style="width:34px;text-align:right">${p}%</span></div>`).join('')}</div></div>${REV.map(v=>`<div class="e2-rv"><div style="display:flex;justify-content:space-between"><b>${v[0]}</b><span class="sm mu">${v[3]}</span></div><div style="font-weight:800;font-size:14px;margin:2px 0;color:#F5A524">${'★'.repeat(v[1])}<span style="color:var(--ln)">${'★'.repeat(5-v[1])}</span></div><div style="font-size:15px;line-height:21px">${v[2]}</div></div>`).join('')}`}
 return head+hero+info+body+`</div><div class="e2-fine">${T('Menus, prices and ratings are sample data.','Menus, prix et notes : données d’exemple.','Menu, ibiciro n’amanota ni urugero.')}</div>`+cartBar(false)};
window.e2Sec=j=>{const sc=$('#sc'),el=document.getElementById('e2s'+j);if(!sc||!el)return;sc.scrollTo({top:sc.scrollTop+el.getBoundingClientRect().top-sc.getBoundingClientRect().top-160,behavior:'smooth'})};
window.e2Mq=v=>{const q=v.trim().toLowerCase();let any=0;document.querySelectorAll('#e2menu .e2-sec').forEach(s=>{let n=0;s.querySelectorAll('.e2-it').forEach(e=>{const ok=!q||e.dataset.s.includes(q);e.style.display=ok?'':'none';if(ok)n++});s.style.display=n?'':'none';any+=n});const z=document.getElementById('e2mq0');if(z)z.style.display=any?'none':''};
window.e2Share=()=>{const t=REST[S.er].n;try{navigator.clipboard.writeText(t+' on itunda Eats').catch(()=>{})}catch(e){}toast(T('Link copied','Lien copié','Link yakoporowe'))};
document.addEventListener('scroll',e=>{const sc=e.target;if(!sc||sc.id!=='sc')return;const tb=document.getElementById('e2tbi');if(tb)tb.classList.toggle('s',sc.scrollTop>140);const chips=document.getElementById('e2sc');if(!chips)return;const top=sc.getBoundingClientRect().top+170;let a=0;document.querySelectorAll('#e2menu .e2-sec').forEach((s,j)=>{if(s.style.display!=='none'&&s.getBoundingClientRect().top<=top)a=j});chips.querySelectorAll('button').forEach((b,j)=>{const on=j===a;if(on&&!b.classList.contains('on')){b.classList.add('on');const l=b.offsetLeft-24;if(Math.abs(chips.scrollLeft-l)>60)chips.scrollTo({left:l,behavior:'smooth'})}else if(!on)b.classList.remove('on')})},true);

/* ---------- wire into the screen chain ---------- */
const _s=screens.shop;screens.shop=function(){if(S.shopTab!=='eats')return _s.apply(this,arguments);S.addrOk=true;return home()};
const _e=screens.erest;screens.erest=function(){if(!REST[S.er])return _e.apply(this,arguments);return erest()};
const _ec=screens.echeck;screens.echeck=function(){let h=_ec.apply(this,arguments);const r=REST[S.er];if(!r||h.includes('e2-ct'))return h;
h=h.replace(/<div style="display:flex;align-items:center;gap:12px;padding:8px 0">((?:(?!eAdj\()[\s\S])*?eAdj\((\d+),-1\))/g,(m,rest,k)=>{const it=r.items[+k];return `<div style="display:flex;align-items:center;gap:12px;padding:8px 0"><div class="e2-ct" style="width:52px;height:52px;border-radius:16px;background:${r.bg};display:flex;align-items:center;justify-content:center;flex:none">${it?gl(it[3],36):''}</div>`+rest});
const la=h.lastIndexOf('aria-label="Add one"'),i=la<0?-1:h.indexOf('<div class="pad"',la);
const btn=`<button class="tap" onclick="back()" style="display:flex;align-items:center;gap:8px;border:0;background:none;color:var(--tintfg);font:inherit;font-weight:800;font-size:15px;padding:8px 0;min-height:44px">${svg('<path d="M12 5v14M5 12h14"/>',18)} ${T('Add more items','Ajouter des articles','Ongeraho ibindi')}</button>`;
return i>6&&h.slice(i-6,i)==='</div>'?h.slice(0,i-6)+btn+h.slice(i-6):h};
window.e2Rr=rr;
window.e2Cp=()=>{const C=[['FREEDEL',T('Free delivery','Livraison gratuite','Kugezwaho ku buntu'),T('First order, delivery only','1re commande, livraison','Itegeko rya mbere'),'#FFE08A'],['EATS20',T('20% off','-20 %','Igabanywa rya 20%'),T('Up to 2,000 RWF off your meal','Jusqu’à 2 000 RWF','Kugeza 2,000 RWF'),'#CFE8FF']];$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" role="dialog" aria-modal="true"><div class="h1" style="font-size:22px;line-height:30px">${T('Your coupons','Vos coupons','Kuponi zawe')}</div>${C.map(c=>`<div style="display:flex;align-items:center;gap:12px;margin-top:12px;border-radius:16px;background:${c[3]};color:#191F28;padding:14px"><span style="flex:1"><b style="font-size:16px;display:block">${c[1]}</b><span style="font-size:13px">${c[2]} · ${c[0]}</span></span><button class="cch on" ${S.epromo===c[0]?'disabled':''} onclick="closeSheet();e2Promo('${c[0]}');e2Rr()">${S.epromo===c[0]?T('Saved','Enregistré','Byabitswe'):T('Use','Utiliser','Koresha')}</button></div>`).join('')}</div>`};
window.e2Dec=k=>{const q=(S.ecart[k]||0)-1;if(q>0)S.ecart[k]=q;else delete S.ecart[k];rr()};
window.eAdd=k=>{const r=REST[S.er];if(r.closed){toast(T('Back at '+r.closed,'Réouvre à '+r.closed,'Irafungura saa '+r.closed));return}S.ecart[k]=(S.ecart[k]||0)+1;rr()};
})();
</script>

<script id="eats-v443">
(()=>{try{
const R=()=>window.REST||[];const ok=(g)=>{try{return gl(g,40)}catch(e){return ''}};
const _s=screens.shop;
screens.shop=function(){const h=_s.apply(this,arguments);try{
 if(S.shopTab!=='eats'||!h.includes('id="e2bn"')||h.includes('ev3-rank'))return h;
 const top=R().map((r,i)=>[r,i]).sort((a,b)=>b[0].rc*b[0].r-a[0].rc*a[0].r).slice(0,5);
 const html=`<div class="ev3-rank"><div style="display:flex;justify-content:space-between;align-items:baseline;padding:22px 24px 10px"><b style="font-size:18px">Top 5 this week</b><span class="sm mu">Most ordered</span></div><div style="display:flex;gap:12px;overflow-x:auto;padding:0 24px;scrollbar-width:none">${top.map(([r,i],n)=>`<div class="tap" onclick="openERest(${i})" style="flex:0 0 132px;cursor:pointer"><div style="height:96px;border-radius:18px;background:${r.bg};display:flex;align-items:center;justify-content:center;position:relative">${ok(r.g)}<span style="position:absolute;left:8px;top:2px;font-size:28px;font-weight:800;font-style:italic;color:var(--tx)">${n+1}</span></div><b style="display:block;font-size:14px;margin-top:8px">${r.n}</b><div class="sm mu">★ ${r.r} · ${r.t} min</div></div>`).join('')}</div></div>`;
 return h.replace('<div class="e2-bn"',()=>html+'<div class="e2-bn"');
}catch(e){return h}};
const _e=screens.erest;
screens.erest=function(){const h=_e.apply(this,arguments);try{const r=R()[S.er];if(!r)return h;let o=h;
 if(o.includes('class="e2-mq"')&&!o.includes('ev3-pop')){
  const idx=r.items.map((it,k)=>[it,k]).filter(([it])=>it[5]==='Popular');const L=(idx.length?idx:r.items.map((it,k)=>[it,k]).slice(0,4)).slice(0,6);
  const pop=`<div class="ev3-pop" style="padding:18px 0 4px"><b style="font-size:17px;padding:0 24px;display:block;margin-bottom:10px">Popular dishes</b><div style="display:flex;gap:12px;overflow-x:auto;padding:0 24px;scrollbar-width:none">${L.map(([it,k])=>`<div style="flex:0 0 128px"><div style="height:112px;border-radius:18px;background:${r.bg};display:flex;align-items:center;justify-content:center;position:relative">${ok(it[3])}<button aria-label="Add ${String(it[0]).replace(/"/g,'')}" onclick="eAdd(${k})" style="position:absolute;right:6px;bottom:6px;width:34px;height:34px;border-radius:17px;border:0;background:var(--bg);box-shadow:0 2px 8px rgba(0,0,0,.18);font-size:20px;font-weight:800">+</button></div><b style="display:block;font-size:14px;margin-top:8px;line-height:18px">${it[0]}</b><div class="sm mu">${fmt(it[2])} RWF</div></div>`).join('')}</div></div>`;
  o=o.replace('<div class="e2-mq">',()=>pop+'<div class="e2-mq">');
 }
 if(o.includes('class="e2-rv"')&&!o.includes('ev3-ph')){let n=-1;
  o=o.replace(/(<div class="e2-rv">[\s\S]*?line-height:21px">[^<]*<\/div>)/g,(m)=>{n++;let x='';
   if(n%2===0)x+=`<div class="ev3-ph" style="display:flex;gap:6px;margin-top:8px">${r.items.slice(0,3).map(it=>`<div style="width:64px;height:64px;border-radius:12px;background:${r.bg};display:flex;align-items:center;justify-content:center">${ok(it[3])}</div>`).join('')}</div>`;
   if(n%3===0)x+=`<div style="margin-top:8px;padding:10px 12px;border-radius:12px;background:var(--chip);font-size:13px;line-height:19px"><b>Owner reply</b><br>Thank you for ordering from ${r.n}. We hope to see you again soon.</div>`;
   return m+x});
  o=o.replace('<div class="e2-rv">',()=>`<div style="display:flex;gap:6px;padding:4px 24px 0"><span class="cch on" style="display:inline-flex;align-items:center;height:32px;padding:0 14px;border-radius:16px;font-size:13px;font-weight:800">All</span><span class="cch" style="display:inline-flex;align-items:center;height:32px;padding:0 14px;border-radius:16px;background:var(--chip);font-size:13px;font-weight:800">With photos</span></div><div class="e2-rv">`);
 }
 return o}catch(e){return h}};
}catch(e){console.error('eats-v443',e)}})();
</script>
<script id="eats-v444">
(()=>{try{
const FEE=3000;
(window.REST||[]).forEach(r=>{if(r._club)return;let f=r.fee;r._club=1;Object.defineProperty(r,'fee',{configurable:true,enumerable:true,get(){return S.club?0:f},set(v){f=v}})});
window.clubSheet=()=>{const on=!!S.club;$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="h1" style="font-size:22px;line-height:30px">itunda Eats Club</div><div class="mu" style="margin:6px 0 14px">${on?'You are a member. Delivery is free on every order.':fmt(FEE)+' RWF a month. Cancel any time.'}</div>${['Free delivery from every restaurant','No minimum on free delivery','Club-only coupons each week'].map(t=>`<div class="row" style="cursor:default;padding:7px 0"><div class="ico" style="width:32px;height:32px">${ic('plus',16)}</div><div class="t" style="font-size:15px">${t}</div></div>`).join('')}<button class="btn" style="margin-top:16px" onclick="clubGo()">${on?'Cancel membership':'Join for '+fmt(FEE)+' RWF'}</button><button class="btn sec2" style="margin-top:10px" onclick="closeSheet()">Not now</button></div>`};
window.clubGo=()=>{if(S.club){S.club=false;closeSheet();render('fade-none');toast('Membership cancelled');return}
 if(S.pay<FEE){toast('Not enough balance');return}S.pay-=FEE;S.club=true;closeSheet();render('fade-none');toast('Welcome to Eats Club. Delivery is free.')};
const _s=screens.shop;
screens.shop=function(){const h=_s.apply(this,arguments);try{
 if(S.shopTab!=='eats'||h.includes('ev4-club'))return h;const a=h.includes('class="ev3-rank"')?'<div class="ev3-rank"':h.includes('<div class="e2-bn"')?'<div class="e2-bn"':null;if(!a)return h;
 const b=`<div class="ev4-club tap" role="button" tabindex="0" onclick="clubSheet()" style="margin:16px 24px 0;border-radius:20px;background:var(--on);color:#fff;padding:16px 18px;display:flex;align-items:center;justify-content:space-between;cursor:pointer"><div><div style="font-weight:800;font-size:16px">${S.club?'Eats Club member':'Eats Club'}</div><div style="font-size:13px;opacity:.8;margin-top:2px">${S.club?'Free delivery on every order':'Free delivery for '+fmt(FEE)+' RWF a month'}</div></div><span style="font-weight:800;font-size:14px;color:var(--br)">${S.club?'Manage':'Join'}</span></div>`;
 return h.replace(a,()=>b+a)}catch(e){return h}};
const _t=screens.etrack;
screens.etrack=function(){const h=_t.apply(this,arguments);try{return h.replace('Your rider · ★ 4.9','Your rider · ★ 4.9 · Moto RAF 214 K · Helmet on')}catch(e){return h}};
}catch(e){console.error('eats-v444',e)}})();
</script>
<script id="shop-v445">
(()=>{try{
const add=[['Shea body butter, 200 g','Kigali Beauty',5200,6500,'gift',20,'Beauty'],['Natural soap, 3 pack','Musanze Apiary',3000,0,'gift',35,'Beauty'],['Moringa hair oil','Kigali Beauty',4500,5500,'water',14,'Beauty'],['Football, size 5','Kimironko Sports',9500,12000,'celebrate',11,'Sports'],['Skipping rope','Kimironko Sports',2500,0,'money',40,'Sports'],['Yoga mat','Kimironko Sports',14000,18000,'community',7,'Sports'],['Sunflower oil, 5 L','Remera Grocers',11500,13000,'money',25,'Food'],['Rice, 5 kg','Remera Grocers',8900,0,'rice',50,'Food'],['Cotton shirt, men','Kigali Designers',12500,15000,'bag',9,'Fashion'],['Ankara dress','Kimironko Market',22000,28000,'voucher',6,'Fashion'],['Power bank, 10,000 mAh','Nyabugogo Tech',16000,21000,'airtime',13,'Electronics'],['USB-C cable, 1 m','Nyabugogo Tech',2800,0,'airtime',60,'Electronics'],['Ceramic mug set, 4','Gisenyi Weavers',7500,9000,'tea',10,'Home'],['Woven laundry basket','Gisenyi Weavers',13500,0,'community',6,'Home'],['LED desk lamp','Nyabugogo Tech',9800,12500,'bolt',8,'Home'],['Green tea, 40 bags','Musanze Apiary',3800,0,'tea',30,'Food']];
if(PRODS.length<12)add.forEach(a=>PRODS.push({n:a[0],m:a[1],p:a[2],o:a[3],g:a[4],s:a[5],c:a[6]}));
['Beauty','Sports'].forEach(c=>{if(!CATS.includes(c))CATS.push(c)});
const rt=i=>(4.2+((i*7)%8)/10).toFixed(1),rc=i=>40+(i*37)%260,ar=i=>i%3===0?'Arrives today':i%3===1?'Arrives tomorrow':'2 days',fs=p=>p.p>=8000;
const stars=i=>`<span style="color:#F5A524;font-weight:800">★ ${rt(i)}</span> <span class="mu">(${rc(i)})</span>`;
const card=(i,w)=>{const p=PRODS[i],d=pct(p.p,p.o);return `<div class="tap" style="${w?'flex:0 0 150px;':''}cursor:pointer" onclick="openProd(${i})"><div class="pim" style="border-radius:16px;position:relative">${gl(p.g,w?56:60)}${d?`<span style="position:absolute;left:8px;top:8px;background:#D92D20;color:#fff;font-size:11px;font-weight:800;border-radius:6px;padding:2px 6px">${d}%</span>`:''}</div><div style="font-size:14px;font-weight:700;margin-top:8px;line-height:19px">${p.n}</div><div style="margin-top:3px"><b style="font-size:15px">${fmt(p.p)} RWF</b>${p.o?` <s class="mu" style="font-size:12px">${fmt(p.o)}</s>`:''}</div><div style="font-size:12px;margin-top:3px">${stars(i)}</div><div style="font-size:12px;margin-top:3px;font-weight:800;color:${i%3===0?'var(--ok)':'var(--lk)'}">${ar(i)}${fs(p)?' · Free shipping':''}</div></div>`};
const rail=(t,s,ix,rank)=>`<div class="sec shv5" style="padding-bottom:10px;padding-top:26px"><div class="sech" style="margin-bottom:0">${t}<span class="sm mu" style="font-weight:600">${s}</span></div></div><div style="display:flex;gap:12px;overflow-x:auto;scrollbar-width:none;padding:0 24px">${ix.map((i,n)=>rank?`<div style="position:relative;flex:0 0 150px"><b style="position:absolute;left:8px;top:2px;z-index:1;font-size:26px;font-style:italic;font-weight:800">${n+1}</b>${card(i,1).replace('flex:0 0 150px;','')}</div>`:card(i,1)).join('')}</div>`;
const CG=[['All','bag'],['Food','harvest'],['Fashion','voucher'],['Electronics','airtime'],['Home','community'],['Beauty','gift'],['Sports','celebrate'],['Deals','money']];
window.shopQ=v=>{S.shq=v;clearTimeout(window._sq);window._sq=setTimeout(()=>{render('fade-none');const e=document.getElementById('shq5');if(e){e.focus();e.setSelectionRange(99,99)}},300)};
window.shopCat=c=>{if(c==='Deals'){S.shq='';S.shdeal=1}else{S.shdeal=0;S.cat=c}render('fade-none')};
window.quickAdd=(i,e)=>{if(e)e.stopPropagation();S.scart[i]=(S.scart[i]||0)+1;render('fade-none');toast('Added to cart')};
const _s=screens.shop;
screens.shop=function(){const h=_s.apply(this,arguments);try{
 if(S.shopTab==='eats'||h.includes('shv5'))return h;
 const q=(S.shq||'').trim().toLowerCase(),all=PRODS.map((p,i)=>i);
 const inp=`<label style="display:flex;align-items:center;gap:10px;flex:1"><input id="shq5" value="${(S.shq||'').replace(/"/g,'')}" placeholder="Search products or shops" oninput="shopQ(this.value)" style="border:0;background:none;outline:0;font:inherit;font-size:15px;color:var(--tx);width:100%"></label>`;
 let o=h.replace(/(<div style="flex:1;height:44px;border-radius:14px[^>]*>)<svg[\s\S]*?<\/svg>Search products<\/div>/,(m,a)=>a+(ic?ic('search',20):'')+inp+'</div>');
 if(q){const r=all.filter(i=>(PRODS[i].n+' '+PRODS[i].m+' '+PRODS[i].c).toLowerCase().includes(q));
  const k=o.indexOf('</div></div>',o.indexOf('class="seg"'));const head=o.slice(0,o.indexOf('<div style="padding-top:16px"><div class="snap"'));
  return head+`<div class="sec shv5" style="padding-top:18px"><div class="sech">${r.length} results for “${q.replace(/</g,'')}”</div></div><div style="display:grid;grid-template-columns:1fr 1fr;gap:20px 12px;padding:8px 24px 24px">${r.map(i=>card(i)).join('')||'<div class="mu">No products found. Try another word.</div>'}</div>`}
 const grid=`<div class="shv5" style="display:grid;grid-template-columns:repeat(4,1fr);gap:16px 0;padding:22px 12px 0">${CG.map(([c,g])=>`<button onclick="shopCat('${c}')" style="border:0;background:none;display:flex;flex-direction:column;align-items:center;gap:6px;font-size:12px;font-weight:700;color:var(--tx)"><i style="width:54px;height:54px;border-radius:20px;background:var(--chip);display:flex;align-items:center;justify-content:center">${gl(g,32)}</i>${c}</button>`).join('')}</div>`;
 const deals=all.filter(i=>PRODS[i].o).sort((a,b)=>pct(PRODS[b].p,PRODS[b].o)-pct(PRODS[a].p,PRODS[a].o)).slice(0,8);
 const best=all.slice().sort((a,b)=>rt(b)*rc(b)-rt(a)*rc(a)).slice(0,6);
 const fast=all.filter(i=>i%3===0).slice(0,6);
 const strip=`<div class="shv5" style="margin:18px 24px 0;border-radius:16px;background:var(--tint);color:var(--tintfg);padding:12px 16px;font-size:14px;font-weight:800">Free shipping on orders over 8,000 RWF · Arrives today on select items</div>`;
 const extra=strip+grid+rail('Today’s deals','Up to '+pct(PRODS[deals[0]].p,PRODS[deals[0]].o)+'% off',deals)+rail('Best sellers','This week',best,1)+rail('Arrives today','Order now',fast);
 if(S.shdeal){const d=all.filter(i=>PRODS[i].o).sort((a,b)=>pct(PRODS[b].p,PRODS[b].o)-pct(PRODS[a].p,PRODS[a].o));const head=o.slice(0,o.indexOf('<div style="padding-top:16px"><div class="snap"'));return head+`<div class="sec shv5" style="padding-top:18px"><div class="sech">All deals<a onclick="S.shdeal=0;render('fade-none')">Back</a></div></div><div style="display:grid;grid-template-columns:1fr 1fr;gap:20px 12px;padding:8px 24px 24px">${d.map(i=>card(i)).join('')}</div>`}
 return o.replace('<div class="sec" style="padding-top:24px"><div class="sech">Earn RWF',()=>extra+'<div class="sec" style="padding-top:24px"><div class="sech">Earn RWF')
}catch(e){console.error(e);return h}};
}catch(e){console.error('shop-v445',e)}})();
</script>
<script id="split-v446">
(()=>{try{
const _s=screens.shop;
screens.shop=function(){const h=_s.apply(this,arguments);try{
 const eats=S.shopTab==='eats';
 let o=h.replace(/<div class="seg"[^>]*>[\s\S]*?<\/div>/,m=>m.includes('setShopTab')?`<div class="pad" style="padding-top:10px"><div class="h1" style="font-size:24px;line-height:30px">${eats?'Eats':'Shop'}</div><div class="sm mu" style="margin-top:2px">${eats?'Food and drinks from nearby restaurants':'Products from local merchants'}</div></div>`:m);
 return o}catch(e){return h}};
window.setShopTab=k=>{S.shopTab=k;S.stack=['shop'];render('fade-none')};
}catch(e){console.error('split-v446',e)}})();
</script>
<script id="shop-v447">
(()=>{try{
const _p=screens.product;
screens.product=function(){const h=_p.apply(this,arguments);try{
 if(h.includes('pv7'))return h;const i=S.pi,x=PRODS[i];if(!x)return h;
 const dy=n=>{const d=new Date(Date.now()+n*864e5);return d.toLocaleDateString('en',{weekday:'short',month:'short',day:'numeric'})};
 const eta=i%3===0?'Today, order within 3 hours':i%3===1?'Tomorrow, '+dy(1):dy(2)+' to '+dy(3);
 const shops=[[x.m,x.p,'This shop'],['Kigali Online Mart',Math.round(x.p*1.06/100)*100,'Arrives '+dy(2)],['Remera Trading',Math.round(x.p*1.12/100)*100,'Arrives '+dy(3)],['Nyabugogo Wholesale',Math.round(x.p*0.97/100)*100,'Arrives '+dy(4)]];
 const best=Math.min(...shops.map(s=>s[1]));
 const sim=PRODS.map((p,k)=>k).filter(k=>k!==i&&PRODS[k].c===x.c).slice(0,6);
 const sec=`<div class="pv7" style="padding:8px 0 0">
 <div class="pad" style="padding-top:14px"><div style="border-radius:18px;background:var(--chip);padding:14px 16px;display:grid;gap:10px;font-size:14px"><div><b>Delivery</b><div class="mu" style="margin-top:2px">${eta}</div></div><div><b>Shipping</b><div class="mu" style="margin-top:2px">${x.p>=8000?'Free shipping on this item':'1,500 RWF, free over 8,000 RWF'}</div></div><div><b>Returns</b><div class="mu" style="margin-top:2px">Free returns within 7 days if unopened</div></div></div></div>
 <div class="sec" style="padding-top:26px;padding-bottom:6px"><div class="sech" style="margin-bottom:0">Compare prices<span class="sm mu" style="font-weight:600">${shops.length} shops</span></div></div>
 <div class="pad">${shops.map(s=>`<div style="display:flex;align-items:center;gap:12px;padding:12px 0;border-bottom:1px solid var(--ln)"><div style="flex:1"><b style="font-size:15px">${s[0]}</b><div class="sm mu">${s[2]}</div></div><div style="text-align:right"><b>${fmt(s[1])} RWF</b>${s[1]===best?'<div class="sm" style="color:var(--ok);font-weight:800">Lowest price</div>':''}</div></div>`).join('')}<div class="sm mu" style="padding-top:8px">Sample prices from other shops for this prototype.</div></div>
 <div class="sec" style="padding-top:26px;padding-bottom:6px"><div class="sech" style="margin-bottom:0">Seller</div></div>
 <div class="pad"><div style="display:flex;align-items:center;gap:12px;padding:6px 0"><div class="ico">${gl('community',30)}</div><div style="flex:1"><b>${x.m}</b><div class="sm mu">★ ${(4.5+(i%5)/10).toFixed(1)} seller rating · ${300+i*41} orders shipped</div></div><button class="chip" onclick="toast('Shop pages are not in this prototype')">Visit</button></div></div>
 ${sim.length?`<div class="sec" style="padding-top:26px;padding-bottom:10px"><div class="sech" style="margin-bottom:0">Similar products</div></div><div style="display:flex;gap:12px;overflow-x:auto;scrollbar-width:none;padding:0 24px 24px">${sim.map(k=>`<div class="tap" style="flex:0 0 124px;cursor:pointer" onclick="openProd(${k})"><div class="pim" style="border-radius:16px">${gl(PRODS[k].g,50)}</div><div style="font-size:13px;font-weight:700;margin-top:6px;line-height:17px">${PRODS[k].n}</div><b style="font-size:14px">${fmt(PRODS[k].p)} RWF</b></div>`).join('')}</div>`:'<div style="height:24px"></div>'}</div>`;
 let o=h.includes('<div class="cta"')?h.replace('<div class="cta"',()=>sec+'<div class="cta"'):h+sec;
 if(!o.includes('buyNow(')){o=o.replace('<div class="cta">','<div class="cta" style="display:flex;gap:10px">').replace(/(<button class="btn"[^>]*addCart[^>]*>[^<]*<\/button>)/,m=>m.replace('class="btn"','class="btn sec2"')+`<button class="btn" onclick="typeof buyNow==='function'?buyNow(${i}):addCart(${i})">Buy now</button>`)}
 return o}catch(e){return h}};
}catch(e){console.error('shop-v447',e)}})();
</script>
<script id="shop-v448">
(()=>{try{
const ST=['Processing','Packed','Out for delivery','Delivered'];
const mine=()=>S.orders.filter(o=>o.k==='Shop order');
const stage=o=>{if(o.ret)return 3;if(!o.ts)return 0;const s=(Date.now()-o.ts)/1000;return s<15?0:s<40?1:s<80?2:3};
const names=o=>{try{const a=Array.isArray(o.items)?o.items:Object.entries(o.items||{});const n=a.map(it=>{const k=Array.isArray(it)?it[0]:(it.i??it.id??it.k);return PRODS[+k]&&PRODS[+k].n}).filter(Boolean);return n.length?n.slice(0,2).join(', ')+(n.length>2?' +'+(n.length-2):''):'Shop order'}catch(e){return 'Shop order'}};
const dt=o=>o.ts?new Date(o.ts).toLocaleDateString('en',{month:'short',day:'numeric'}):'Today';
window.shReturn=k=>{const o=mine()[k];if(!o||stage(o)<3||o.ret)return;o.ret=1;o.s='Refunded';S.pay+=o.t;render('fade-none');toast('Return approved. '+fmt(o.t)+' RWF refunded to itunda Pay')};
window.shAgain=k=>{const o=mine()[k];if(!o)return;let n=0;try{(Array.isArray(o.items)?o.items:Object.entries(o.items||{})).forEach(it=>{const i=Array.isArray(it)?it[0]:(it.i??it.id??it.k),q=Array.isArray(it)?(it[1]||1):(it.q||1);if(PRODS[+i]){S.scart[+i]=(S.scart[+i]||0)+q;n++}})}catch(e){}
 if(!n){toast('Items are no longer available');return}S.stack=['shop','scart'];render('push')};
screens.sorders=()=>{const l=mine();
 l.forEach(o=>{if(!o.ret)o.s=ST[stage(o)]});
 return `<div class="top" style="padding:12px 24px 0 8px"><button class="ib" aria-label="Back" onclick="back()">${ic('back',24)}</button><b style="font-size:18px">My shop orders</b><span style="width:44px"></span></div>`+
 (l.length?l.map((o,k)=>{const s=stage(o);return `<div class="pad" style="padding-top:18px"><div style="border:1px solid var(--ln);border-radius:20px;padding:16px"><div style="display:flex;justify-content:space-between;gap:10px"><b style="font-size:15px;line-height:20px">${names(o)}</b><span class="sm mu" style="white-space:nowrap">${dt(o)}</span></div><div class="sm mu" style="margin-top:2px">${o.id||'Order'} · ${fmt(o.t)} RWF</div>
 ${o.ret?`<div style="margin-top:12px;font-weight:800;color:var(--ok)">Refunded to itunda Pay</div>`:`<div style="display:flex;gap:4px;margin-top:14px">${ST.map((x,j)=>`<div style="flex:1"><div style="height:5px;border-radius:3px;background:${j<=s?'var(--br)':'var(--chip)'}"></div><div style="font-size:11px;margin-top:5px;font-weight:${j===s?800:600};color:${j<=s?'var(--tx)':'var(--tt)'}">${x}</div></div>`).join('')}</div><div class="sm" style="margin-top:10px;font-weight:700">${s===3?'Delivered. You can return within 7 days.':s===2?'Arriving today. Rider is on the way.':s===1?'Seller packed your order.':'Seller is preparing your order.'}</div>`}
 <div style="display:flex;gap:8px;margin-top:14px"><button class="chip" onclick="shAgain(${k})">Buy again</button>${s===3&&!o.ret?`<button class="chip" onclick="shReturn(${k})">Return</button>`:''}</div></div></div>`}).join(''):`<div class="pad mu" style="padding:40px 24px;text-align:center">No shop orders yet. Orders you place will show up here with live status.</div>`)+'<div style="height:40px"></div>'};
setInterval(()=>{if(S.stack&&S.stack[S.stack.length-1]==='sorders'&&mine().some(o=>!o.ret&&stage(o)<3)){const y=document.querySelector('.screen');const t=y?y.scrollTop:0;render('fade-none');const z=document.querySelector('.screen');if(z)z.scrollTop=t}},5000);
const _s=screens.shop;
screens.shop=function(){const h=_s.apply(this,arguments);try{
 if(S.shopTab==='eats'||h.includes('sh8-o'))return h;const n=mine().filter(o=>!o.ret&&stage(o)<3).length;
 return h.replace('Products from local merchants</div></div>',()=>`Products from local merchants</div><div class="sh8-o" style="display:flex;gap:8px;margin-top:12px"><button class="cch" onclick="S.stack=['shop','sorders'];render('push')">Orders${mine().length?' ('+mine().length+')':''}${n?' · '+n+' on the way':''}</button></div></div>`)}catch(e){return h}};
}catch(e){console.error('shop-v448',e)}})();
</script>
<script id="shop-v449">
(()=>{try{
const rt=i=>(4.2+((i*7)%8)/10).toFixed(1),rc=i=>40+(i*37)%260;
const card=(i,w)=>{const p=PRODS[i],d=pct(p.p,p.o);return `<div class="tap" style="${w?'flex:0 0 138px;':''}cursor:pointer" onclick="openProd(${i})"><div class="pim" style="border-radius:18px">${gl(p.g,w?52:58)}</div><div style="font-size:14px;line-height:19px;margin-top:8px;color:var(--tx)">${p.n}</div><div style="margin-top:3px;font-size:15px;font-weight:800">${d?`<span style="color:var(--er)">${d}%</span> `:''}${fmt(p.p)} RWF</div><div class="sm mu" style="margin-top:2px">★ ${rt(i)} · ${rc(i)}</div></div>`};
const sh=(t,s)=>`<div style="display:flex;justify-content:space-between;align-items:baseline;padding:32px 24px 12px"><b style="font-size:19px;letter-spacing:-.3px">${t}</b>${s?`<span class="sm mu">${s}</span>`:''}</div>`;
const _s=screens.shop;
screens.shop=function(){if(S.shopTab==='eats')return _s.apply(this,arguments);
 try{
 const q=(S.shq||'').trim().toLowerCase(),all=PRODS.map((p,i)=>i),cat=S.cat||'All',n=scCount();
 const orders=S.orders.filter(o=>o.k==='Shop order').length;
 const cb=`<button class="ib" aria-label="Cart" onclick="openCart()" style="position:relative">${ic('bag',24)}${n?`<span style="position:absolute;top:6px;right:4px;min-width:18px;height:18px;border-radius:9px;background:#D92D20;color:#fff;font-size:11px;font-weight:800;display:flex;align-items:center;justify-content:center;padding:0 4px">${n}</span>`:''}</button>`;
 const head=`<div class="top" style="padding:12px 24px 0 8px"><button class="ib" aria-label="Back" onclick="back()">${ic('back',24)}</button><label style="flex:1;height:44px;border-radius:14px;background:var(--chip);display:flex;align-items:center;gap:10px;padding:0 14px;color:var(--mu);margin-right:4px">${ic('search',20)}<input id="shq5" value="${(S.shq||'').replace(/"/g,'')}" placeholder="Search products or shops" oninput="shopQ(this.value)" style="border:0;background:none;outline:0;font:inherit;font-size:15px;color:var(--tx);width:100%"></label>${cb}</div>`;
 const fab=n?`<div class="fab"><button class="btn" onclick="openCart()">View cart · ${n} · ${fmt(scTotal())} RWF</button></div>`:'';
 const grid=l=>`<div style="display:grid;grid-template-columns:1fr 1fr;gap:22px 12px;padding:0 24px 24px">${l.map(i=>card(i)).join('')||'<div class="mu" style="grid-column:1/3;padding:30px 0;text-align:center">No products found. Try another word.</div>'}</div>`;
 if(q){const r=all.filter(i=>(PRODS[i].n+' '+PRODS[i].m+' '+PRODS[i].c).toLowerCase().includes(q));return head+sh(r.length+' results for “'+q.replace(/</g,'')+'”')+grid(r)+fab}
 const tabs=[...(window.CATS||['All']),'Deals'];
 const chips=`<div style="display:flex;gap:8px;overflow-x:auto;scrollbar-width:none;padding:16px 24px 0">${tabs.map(c=>{const on=c==='Deals'?!!S.shdeal:(!S.shdeal&&cat===c);return `<button onclick="shopCat('${c}')" style="flex:none;height:38px;padding:0 16px;border-radius:19px;border:0;font-weight:800;font-size:14px;background:${on?'var(--tx)':'var(--chip)'};color:${on?'var(--bg)':'var(--tx)'}">${c}</button>`}).join('')}</div>`;
 const title=`<div style="display:flex;justify-content:space-between;align-items:center;padding:14px 24px 0"><div class="h1" style="font-size:24px;line-height:30px">Shop</div><button onclick="S.stack=['shop','sorders'];render('push')" style="border:0;background:none;font-weight:800;font-size:14px;color:var(--lk)">My orders${orders?' ('+orders+')':''}</button></div>`;
 if(S.shdeal){const d=all.filter(i=>PRODS[i].o).sort((a,b)=>pct(PRODS[b].p,PRODS[b].o)-pct(PRODS[a].p,PRODS[a].o));return head+title+chips+sh('All deals',d.length+' items')+grid(d)+fab}
 if(cat!=='All'){const r=all.filter(i=>PRODS[i].c===cat);return head+title+chips+sh(cat,r.length+' items')+grid(r)+fab}
 const deals=all.filter(i=>PRODS[i].o).sort((a,b)=>pct(PRODS[b].p,PRODS[b].o)-pct(PRODS[a].p,PRODS[a].o)).slice(0,6);
 const best=all.slice().sort((a,b)=>rt(b)*rc(b)-rt(a)*rc(a)).slice(0,5);
 const rv=(S.rv||[]).filter(i=>PRODS[i]).slice(0,6);
 return head+title+chips
  +sh('Today’s deals','Ends in '+(typeof hms==='function'?hms():''))+`<div style="display:flex;gap:12px;overflow-x:auto;scrollbar-width:none;padding:0 24px">${deals.map(i=>card(i,1)).join('')}</div>`
  +sh('Best sellers','This week')+`<div style="padding:0 24px">${best.map((i,k)=>`<div class="tap" onclick="openProd(${i})" style="display:flex;align-items:center;gap:14px;padding:10px 0;cursor:pointer"><b style="width:18px;font-size:17px">${k+1}</b><div class="pim" style="flex:0 0 64px;height:64px;aspect-ratio:auto;border-radius:16px">${gl(PRODS[i].g,34)}</div><div style="min-width:0"><div style="font-size:15px;line-height:20px">${PRODS[i].n}</div><div style="font-weight:800;font-size:15px">${fmt(PRODS[i].p)} RWF</div></div></div>`).join('')}</div>`
  +(rv.length?sh('Recently viewed')+`<div style="display:flex;gap:12px;overflow-x:auto;scrollbar-width:none;padding:0 24px">${rv.map(i=>card(i,1)).join('')}</div>`:'')
  +sh('All products',all.length+' items')+grid(all)
  +'<div class="pad fine" style="padding-bottom:24px">Products, prices and merchants are sample data.</div>'+fab;
 }catch(e){console.error(e);return _s.apply(this,arguments)}};
}catch(e){console.error('shop-v449',e)}})();
</script>
<script id="shop-v450">
(()=>{try{
const rt=i=>(4.2+((i*7)%8)/10).toFixed(1),rc=i=>6+(i*37)%260,ern=p=>Math.round(p.p*.07/10)*10;
const arr=i=>i%3===0?'Arrives today':i%3===1?'Arrives tomorrow':'Arrives in 2 days';
const TABS=[['home','Home'],['beauty','Beauty'],['fresh','Fresh'],['cat','Categories'],['deal','First-come deals']];
const chip=(t,c)=>`<span style="display:inline-block;font-size:12px;font-weight:700;padding:5px 9px;border-radius:8px;background:${c||'var(--chip)'};margin:6px 6px 0 0;color:var(--tx)">${t}</span>`;
const card=i=>{const p=PRODS[i],d=pct(p.p,p.o);return `<div class="tap" style="cursor:pointer" onclick="openProd(${i})"><div class="pim" style="border-radius:20px;position:relative;aspect-ratio:1/1">${gl(p.g,64)}${d>=25?`<span style="position:absolute;left:10px;top:10px;background:#F04452;color:#fff;font-size:12px;font-weight:800;border-radius:8px;padding:4px 8px">${d}% deal</span>`:''}<button aria-label="Add to cart" onclick="quickAdd(${i},event)" style="position:absolute;right:8px;bottom:8px;width:38px;height:38px;border-radius:19px;border:0;background:rgba(255,255,255,.9);display:flex;align-items:center;justify-content:center;color:#191F28">${ic('bag',20)}</button></div>${d>=20?`<div style="margin-top:8px;border-radius:8px;background:rgba(240,68,82,.14);color:#F04452;font-size:12.5px;font-weight:700;text-align:center;padding:6px 4px">Lowest price in 30 days</div>`:''}<div style="font-size:15px;line-height:21px;margin-top:8px">${p.n}</div><div style="margin-top:3px;font-size:18px;font-weight:800;letter-spacing:-.4px">${d?`<span style="font-size:15px">${d}%</span> `:''}${fmt(p.p)} RWF</div><div>${i%3!==2?chip(arr(i),'rgba(49,130,246,.18)'):''}</div><div style="font-size:13px;margin-top:6px"><span style="color:#F5A524">★</span> ${rt(i)} (${rc(i)})</div><div>${chip('Best seller')}${chip('Earn up to '+fmt(ern(p))+' RWF')}</div></div>`};
const grid=l=>`<div style="display:grid;grid-template-columns:1fr 1fr;gap:26px 12px;padding:0 20px 24px">${l.map(card).join('')||'<div class="mu" style="grid-column:1/3;padding:30px 0;text-align:center">No products found.</div>'}</div>`;
const H=(t,r)=>`<div style="display:flex;justify-content:space-between;align-items:center;padding:28px 24px 14px"><b style="font-size:20px;letter-spacing:-.4px">${t}</b>${r||''}</div>`;
window.stab=k=>{S.stab=k;S.shdeal=0;render('fade-none')};
window.scatSel=c=>{S.scatSel=c;render('fade-none')};
window.evHero=e=>{const n=e.children.length,i=Math.min(n-1,Math.round(e.scrollLeft/(e.children[0].offsetWidth+10)));const b=document.getElementById('hc');if(b)b.textContent=(i+1)+'|'+n};
window.sdDay=k=>{S.sdDay=k;render('fade-none')};
const _s=screens.shop;
screens.shop=function(){if(S.shopTab==='eats')return _s.apply(this,arguments);
 try{
 const all=PRODS.map((p,i)=>i),n=scCount(),tab=S.stab||'home',q=(S.shq||'').trim().toLowerCase();
 const cb=`<button class="ib" aria-label="Cart" onclick="openCart()" style="position:relative">${ic('bag',26)}${n?`<span style="position:absolute;top:4px;right:2px;min-width:18px;height:18px;border-radius:9px;background:#F04452;color:#fff;font-size:11px;font-weight:800;display:flex;align-items:center;justify-content:center;padding:0 4px">${n}</span>`:''}</button>`;
 const head=`<div class="top" style="padding:10px 16px 0 8px"><button class="ib" aria-label="Back" onclick="back()">${ic('back',24)}</button><label style="flex:1;height:46px;border-radius:14px;background:var(--chip);display:flex;align-items:center;gap:10px;padding:0 14px;color:var(--mu);margin-right:2px">${ic('search',20)}<input id="shq5" value="${(S.shq||'').replace(/"/g,'')}" placeholder="Search products" oninput="shopQ(this.value)" style="border:0;background:none;outline:0;font:inherit;font-size:15px;color:var(--tx);width:100%"></label><button class="ib" aria-label="Orders" onclick="S.stack=['shop','sorders'];render('push')">${ic('user',26)}</button>${cb}</div>`;
 const tabs=`<div style="display:flex;gap:4px;overflow-x:auto;scrollbar-width:none;padding:12px 16px 0">${TABS.map(([k,l])=>`<button onclick="stab('${k}')" style="flex:none;height:44px;padding:0 16px;border-radius:14px;border:0;font-size:17px;font-weight:${tab===k?800:600};background:${tab===k?'var(--chip)':'none'};color:${tab===k?'var(--tx)':'var(--mu)'}">${l}</button>`).join('')}</div>`;
 const fab=n?`<div class="fab"><button class="btn" onclick="openCart()">View cart · ${n} · ${fmt(scTotal())} RWF</button></div>`:'';
 if(q){const r=all.filter(i=>(PRODS[i].n+' '+PRODS[i].m+' '+PRODS[i].c).toLowerCase().includes(q));return head+H(r.length+' results for “'+q.replace(/</g,'')+'”')+grid(r)+fab}
 let body='';
 if(tab==='home'){
  const hero=all.filter(i=>PRODS[i].o).sort((a,b)=>pct(PRODS[b].p,PRODS[b].o)-pct(PRODS[a].p,PRODS[a].o)).slice(0,4);
  const cols=['#FDECEF','#E8F1FF','#FFF3DA','#E6F6EC'];
  const qa=[['Daily draw','celebrate',"toast('Draws are not in this prototype')"],['Deals','money',"stab('deal')"],['My orders','bag',"S.stack=['shop','sorders'];render('push')"],['Rewards','gift',"toast('Rewards are not in this prototype')"],['Wishlist','heartred',"toast('Wishlist is saved from each product')"]];
  body=`<div id="hero" onscroll="evHero(this)" style="display:flex;gap:10px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;padding:16px 24px 0">${hero.map((i,k)=>{const p=PRODS[i];return `<div class="tap" onclick="openProd(${i})" style="flex:0 0 100%;scroll-snap-align:center;height:300px;border-radius:28px;background:${cols[k%4]};color:#191F28;padding:26px 24px;position:relative;cursor:pointer;overflow:hidden"><div style="color:#F04452;font-weight:700;font-size:15px">${(k+1)*500} first-come</div><div style="font-size:24px;font-weight:800;line-height:32px;margin-top:6px;max-width:170px">${p.n}</div><div style="font-size:24px;font-weight:800;margin-top:4px">${fmt(p.p)} RWF</div><div style="font-size:13px;opacity:.6;margin-top:46px">Max 1 per day</div><div style="position:absolute;right:20px;top:60px">${gl(p.g,120)}</div></div>`}).join('')}</div><div style="position:relative"><span id="hc" style="position:absolute;right:40px;top:-40px;background:rgba(0,0,0,.45);color:#fff;font-size:13px;font-weight:700;border-radius:14px;padding:4px 12px">1|${hero.length}</span></div>`
  +`<div style="display:flex;justify-content:space-between;padding:22px 12px 0">${qa.map(([l,g,a])=>`<button onclick="${a}" style="flex:1;border:0;background:none;display:flex;flex-direction:column;align-items:center;gap:8px;font-size:13px;font-weight:600;color:var(--tx)"><i style="width:60px;height:60px;border-radius:20px;background:var(--chip);display:flex;align-items:center;justify-content:center">${gl(g,36)}</i>${l}</button>`).join('')}</div>`
  +H('Recommended for you','<span class="sm mu" style="border:1px solid var(--ln);border-radius:6px;padding:2px 8px">Sample</span>')+grid(all);
 }else if(tab==='beauty'||tab==='fresh'){const c=tab==='beauty'?'Beauty':'Food';const l=all.filter(i=>PRODS[i].c===c);
  body=H(c==='Food'?'Fresh and pantry':'Beauty picks','<span class="sm mu">'+l.length+' items</span>')+grid(l);
 }else if(tab==='cat'){const cs=(window.CATS||[]).filter(c=>c!=='All'),sel=S.scatSel&&cs.includes(S.scatSel)?S.scatSel:cs[0],l=all.filter(i=>PRODS[i].c===sel);
  body=`<div style="display:flex;padding:16px 16px 24px;gap:8px"><div style="flex:0 0 96px">${cs.map(c=>`<button onclick="scatSel('${c}')" style="display:block;width:100%;text-align:left;border:0;border-radius:14px;padding:16px 12px;font-size:16px;font-weight:${c===sel?800:600};background:${c===sel?'var(--chip)':'none'};color:${c===sel?'var(--tx)':'var(--mu)'}">${c}</button>`).join('')}</div><div style="flex:1;min-width:0"><div style="display:flex;justify-content:space-between;align-items:center;padding:12px 8px"><b style="font-size:20px">${sel}</b><span class="sm mu">${l.length} items</span></div><div style="display:grid;grid-template-columns:repeat(3,1fr);gap:18px 6px">${l.map(i=>`<div class="tap" onclick="openProd(${i})" style="display:flex;flex-direction:column;align-items:center;gap:8px;cursor:pointer;text-align:center"><div style="width:74px;height:74px;border-radius:37px;background:var(--chip);display:flex;align-items:center;justify-content:center">${gl(PRODS[i].g,44)}</div><span style="font-size:12px;line-height:16px">${PRODS[i].n}</span></div>`).join('')}</div></div></div>`;
 }else{const d=all.filter(i=>PRODS[i].o).sort((a,b)=>pct(PRODS[b].p,PRODS[b].o)-pct(PRODS[a].p,PRODS[a].o)),day=S.sdDay||0;
  const days=[...Array(7)].map((_,k)=>{const t=new Date(Date.now()+k*864e5);return t.toLocaleDateString('en',{month:'numeric',day:'numeric',weekday:'short'})});
  body=`<div style="margin:16px 0 0;height:170px;background:linear-gradient(#2B3A4F,#EEF3F8);display:flex;align-items:flex-start;justify-content:center;padding-top:30px;font-weight:700;color:#4E5968">itunda Shop · Today’s Deal</div>`
  +`<div style="padding:20px 24px 0"><b style="font-size:24px;letter-spacing:-.5px">First-come deals at 00:00</b><div class="mu" style="margin-top:4px;font-size:16px">Ends in <span style="color:#F04452;font-weight:700">${hms()}</span></div></div>`
  +`<div style="display:flex;gap:8px;overflow-x:auto;scrollbar-width:none;padding:16px 24px 0">${days.map((t,k)=>`<button onclick="sdDay(${k})" style="flex:none;height:44px;padding:0 20px;border-radius:22px;border:0;font-size:16px;font-weight:600;background:${k===day?'var(--tx)':'var(--chip)'};color:${k===day?'var(--bg)':'var(--tx)'}">${t}</button>`).join('')}</div>`
  +`<div style="padding:8px 24px 24px">${(day===0?d:d.slice(day%d.length).concat(d.slice(0,day%d.length))).map(i=>{const p=PRODS[i],x=pct(p.p,p.o);return `<div class="tap" onclick="openProd(${i})" style="display:flex;gap:16px;padding:14px 0;cursor:pointer"><div class="pim" style="flex:0 0 140px;height:140px;aspect-ratio:auto;border-radius:20px;position:relative">${gl(p.g,60)}<span style="position:absolute;left:8px;top:8px;background:#F04452;color:#fff;font-size:12px;font-weight:800;border-radius:8px;padding:4px 8px">First-come</span><button aria-label="Add to cart" onclick="quickAdd(${i},event)" style="position:absolute;right:8px;bottom:8px;width:34px;height:34px;border-radius:17px;border:0;background:rgba(255,255,255,.9);color:#191F28;display:flex;align-items:center;justify-content:center">${ic('bag',18)}</button></div><div style="min-width:0"><div style="font-size:16px;line-height:22px">${p.n}</div><div class="mu" style="margin-top:8px;font-size:15px">${x}% <s>${fmt(p.o)} RWF</s></div><div style="color:#F04452;font-size:22px;font-weight:800;letter-spacing:-.5px">Today only ${fmt(p.p)} RWF</div><div style="color:#F04452;font-size:14px;margin-top:2px">Lowest in 60 days · ${hms()}</div><div class="sm mu" style="margin-top:6px">${(1000+i*417).toLocaleString('en')} people viewed</div></div></div>`}).join('')}</div>`;
 }
 return head+tabs+body+'<div class="pad fine" style="padding-bottom:24px">Products, prices and merchants are sample data.</div>'+fab;
 }catch(e){console.error(e);return _s.apply(this,arguments)}};
}catch(e){console.error('shop-v450',e)}})();
</script>
<script id="shop-v451">
(()=>{try{
const rt=i=>(4.2+((i*7)%8)/10).toFixed(1),rcn=i=>6+(i*37)%260,ern=p=>Math.round(p.p*.07/10)*10;
const dy=n=>new Date(Date.now()+n*864e5).toLocaleDateString('en',{weekday:'short',month:'short',day:'numeric'});
const eta=i=>i%3===0?'Arrives today':i%3===1?'Arrives tomorrow, '+dy(1):'Arrives '+dy(2);
const TINT=['#D5ECF6','#FDECEF','#FFF3DA','#E6F6EC'];
const REV=[['K*m',5,'Arrived on time and well packed. Will order again.','Yesterday',1],['S*n',4,'Good value for the price. Quality is as described.','3 days ago',0],['J*a',5,'Bought it for the family and everyone liked it.','1 week ago',1],['A*e',5,'Fast delivery and the seller answered my questions.','2 weeks ago',0],['M*i',4,'Nice, but the box was a little dented.','3 weeks ago',0]];
const sec=(t)=>`<div style="padding:26px 24px 12px"><b style="font-size:19px">${t}</b></div>`;
const tg=(S_,t)=>`<span style="display:inline-block;font-size:12px;font-weight:700;padding:5px 9px;border-radius:8px;background:var(--chip);margin:6px 6px 0 0">${t}</span>`;
window.ptab=k=>{const sc=document.querySelector('.screen'),t=sc?sc.scrollTop:0;S.ptab=k;render('fade-none');const z=document.querySelector('.screen');if(z)z.scrollTop=Math.max(t,0)};
window.pcmp=()=>{const sc=document.querySelector('.screen'),t=sc?sc.scrollTop:0;S.pcmpOn=!S.pcmpOn;render('fade-none');const z=document.querySelector('.screen');if(z)z.scrollTop=t};
window.pgal=e=>{const i=Math.round(e.scrollLeft/e.clientWidth),b=document.getElementById('pgc');if(b)b.textContent=(i+1)+'|4'};
window.pAdd=(i,q)=>{S.scart[i]=(S.scart[i]||0)+q;const sc=document.querySelector('.screen'),t=sc?sc.scrollTop:0;render('fade-none');const z=document.querySelector('.screen');if(z)z.scrollTop=t;toast('Added to cart')};
window.buySheet=i=>{S.bq7=S.bq7||1;if(S.bq7n!==i){S.bq7=1;S.bq7n=i}const x=PRODS[i],q=S.bq7,ship=x.p>=8000?0:1500,tot=x.p*q+ship,bad=tot>S.pay;
 $('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" style="padding-top:18px"><div style="width:44px;height:5px;border-radius:3px;background:var(--ln);margin:0 auto 18px"></div>
 <div style="display:flex;justify-content:space-between;align-items:center"><div><b style="font-size:26px;color:var(--lk)">${fmt(x.p*q)} RWF</b> <span class="sm mu">${ship?'Shipping '+fmt(ship)+' RWF':'Free shipping'}</span></div><div style="display:flex;align-items:center;background:var(--chip);border-radius:14px"><button aria-label="Less" onclick="bqSet7(${i},-1)" style="width:40px;height:44px;border:0;background:none;font-size:22px">−</button><b style="min-width:34px;text-align:center;font-size:18px">${q}</b><button aria-label="More" onclick="bqSet7(${i},1)" style="width:40px;height:44px;border:0;background:none;font-size:22px">+</button></div></div>
 <div class="mu" style="margin-top:8px">${x.n}</div>
 <div style="margin-top:14px;border-radius:20px;background:var(--chip);padding:6px 16px">${[[eta(i)+' · Home','Kimironko, KG 11 Ave, Kigali'],['itunda Pay','Balance '+fmt(S.pay)+' RWF'],['Points','0 RWF used']].map(r=>`<div style="padding:12px 0"><b style="font-size:16px">${r[0]}</b><div class="mu" style="font-size:14px;margin-top:2px">${r[1]}</div></div>`).join('')}</div>
 ${bad?`<div style="color:var(--er);font-size:14px;font-weight:700;margin-top:12px">Not enough balance. Add money first.</div>`:`<div class="mu" style="font-size:14px;margin-top:12px">Earn up to ${fmt(ern(x)*q)} RWF back</div>`}
 <div id="sl7" style="position:relative;height:60px;border-radius:30px;background:${bad?'var(--chip)':'var(--br)'};margin-top:16px;overflow:hidden;touch-action:none;user-select:none"><div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:17px;color:var(--on)">Slide to pay</div><div id="kn7" style="position:absolute;left:6px;top:6px;width:48px;height:48px;border-radius:24px;background:#fff;display:flex;align-items:center;justify-content:center;color:#191F28">${ic('chev',22)}</div></div>
 <div class="sm mu" style="text-align:center;margin-top:10px">I have checked my order</div></div>`;
 const tr=document.getElementById('sl7'),kn=document.getElementById('kn7');if(!tr||bad)return;let d=false,sx=0,mx=0;
 const pos=e=>(e.touches?e.touches[0].clientX:e.clientX);
 const mv=e=>{if(!d)return;mx=Math.max(0,Math.min(tr.clientWidth-60,pos(e)-sx));kn.style.left=(6+mx)+'px'};
 const up=()=>{if(!d)return;d=false;document.removeEventListener('mousemove',mv);document.removeEventListener('mouseup',up);document.removeEventListener('touchmove',mv);document.removeEventListener('touchend',up);if(mx>tr.clientWidth-80)payNow7(i);else{kn.style.transition='left .2s';kn.style.left='6px';setTimeout(()=>kn.style.transition='',220)}};
 const dn=e=>{d=true;sx=pos(e);mx=0;document.addEventListener('mousemove',mv);document.addEventListener('mouseup',up);document.addEventListener('touchmove',mv,{passive:true});document.addEventListener('touchend',up)};
 kn.addEventListener('mousedown',dn);kn.addEventListener('touchstart',dn,{passive:true})};
window.bqSet7=(i,d)=>{S.bq7=Math.max(1,Math.min(PRODS[i].s||9,(S.bq7||1)+d));buySheet(i)};
window.payNow7=i=>{const x=PRODS[i],q=S.bq7||1,ship=x.p>=8000?0:1500,tot=x.p*q+ship;if(tot>S.pay){toast('Not enough balance');return}
 S.pay-=tot;S.orders.unshift({k:'Shop order',s:'Processing',t:tot,items:[[i,q]],ts:Date.now(),id:'IT-'+(4100+S.orders.length*13+i)});S.bq7=1;closeSheet();S.stack=['shop','sorders'];render('push');toast('Order placed')};
const _p=screens.product;
screens.product=function(){try{
 const i=S.pi,x=PRODS[i];if(!x)return _p.apply(this,arguments);
 const d=pct(x.p,x.o),n=scCount(),tab=S.ptab||'reviews',rc=rcn(i),fav=S.fav&&S.fav[i];
 const ov=(a,l,h)=>`<button aria-label="${l}" onclick="${a}" style="width:44px;height:44px;border:0;border-radius:22px;background:rgba(0,0,0,.28);color:#fff;display:flex;align-items:center;justify-content:center;position:relative">${h}</button>`;
 const gal=`<div style="position:relative"><div onscroll="pgal(this)" style="display:flex;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none">${[0,1,2,3].map(k=>`<div style="flex:0 0 100%;scroll-snap-align:start;height:380px;background:${TINT[(i+k)%4]};display:flex;align-items:center;justify-content:center">${gl(x.g,k?110+k*8:150)}</div>`).join('')}</div>
 <div style="position:absolute;left:0;right:0;top:0;display:flex;justify-content:space-between;padding:12px 12px 0">${ov('back()','Back',ic('back',24))}<div style="display:flex;gap:6px">${ov("document.getElementById('shqx')&&0;S.shq='';S.stack=['shop'];render('push')",'Search',ic('search',22))}${ov('openCart()','Cart',ic('bag',24)+(n?`<span style="position:absolute;top:2px;right:0;min-width:18px;height:18px;border-radius:9px;background:#F04452;color:#fff;font-size:11px;font-weight:800;display:flex;align-items:center;justify-content:center;padding:0 4px">${n}</span>`:''))}</div></div>
 <span id="pgc" style="position:absolute;right:14px;bottom:14px;background:rgba(255,255,255,.85);color:#191F28;font-size:13px;font-weight:700;border-radius:14px;padding:4px 12px">1|4</span></div>`;
 const row=(a,b,go)=>`<div ${go?`onclick="${go}"`:''} style="display:flex;align-items:center;gap:16px;padding:12px 0;${go?'cursor:pointer':''}"><span class="mu" style="flex:0 0 64px;font-size:15px">${a}</span><div style="flex:1;font-size:16px">${b}</div>${go?ic('chev',16,'var(--tt)'):''}</div>`;
 const shops=[[x.m,x.p,eta(i)],['Kigali Online Mart',Math.round(x.p*1.06/100)*100,'Arrives '+dy(2)],['Remera Trading',Math.round(x.p*1.12/100)*100,'Arrives '+dy(3)],['Nyabugogo Wholesale',Math.round(x.p*.97/100)*100,'Arrives '+dy(4)]];const best=Math.min(...shops.map(s=>s[1]));
 const info=`<div style="padding:18px 24px 0"><div class="sm mu">${x.m}</div><div style="font-size:21px;font-weight:700;line-height:29px;margin-top:4px">${x.n}</div><div class="mu" style="margin-top:4px;font-size:15px">Origin: see product details</div>
 ${d?`<div class="mu" style="margin-top:18px;font-size:18px"><b style="color:var(--tx)">${d}%</b> <s>${fmt(x.o)} RWF</s></div>`:'<div style="height:18px"></div>'}
 <div style="display:flex;align-items:center;justify-content:space-between;margin-top:2px"><div><b style="font-size:32px;letter-spacing:-.8px">${fmt(x.p)} RWF</b>${d?` <span style="color:#F04452;font-weight:700;font-size:15px">Best price</span>`:''}</div><button onclick="pcmp()" style="border:0;border-radius:14px;background:var(--chip);height:48px;padding:0 18px;font-weight:700;font-size:16px;color:var(--tx)">Compare prices</button></div>
 <div style="margin-top:6px">${x.p>=8000?'Free shipping':'Shipping 1,500 RWF · free over 8,000'}</div></div>
 ${S.pcmpOn?`<div style="margin:14px 24px 0;border-radius:18px;background:var(--chip);padding:4px 16px">${shops.map(s=>`<div style="display:flex;align-items:center;gap:12px;padding:12px 0"><div style="flex:1"><b style="font-size:15px">${s[0]}</b><div class="sm mu">${s[2]}</div></div><div style="text-align:right"><b>${fmt(s[1])} RWF</b>${s[1]===best?'<div class="sm" style="color:#F04452;font-weight:800">Lowest</div>':''}</div></div>`).join('')}<div class="sm mu" style="padding:0 0 12px">Sample prices from other shops.</div></div>`:''}
 <div style="padding:14px 24px 0">${row('Earn',`<span style="color:var(--lk);font-weight:700">Up to ${fmt(ern(x))} RWF</span> back with itunda Pay`,"toast('Cashback is shown as a sample')")}${row('Rating',`<span style="color:#F5A524">★</span> ${rt(i)} (${rc})`,"ptab('reviews')")}${row('Delivery',eta(i),"toast('Delivery to Kimironko, KG 11 Ave')")}${row('Seller',`${x.m} <span style="display:inline-block;font-size:12px;font-weight:700;padding:4px 8px;border-radius:8px;background:var(--chip)">Official</span> <span style="display:inline-block;font-size:12px;font-weight:700;padding:4px 8px;border-radius:8px;background:var(--chip)">Best seller</span>`,"toast('Shop pages are not in this prototype')")}</div>
 <div style="height:12px;background:var(--chip);margin-top:12px"></div>`;
 const tabs=`<div style="position:sticky;top:0;z-index:5;background:var(--bg);display:flex;border-bottom:1px solid var(--ln)">${[['reviews','Reviews ('+rc+')'],['info','Product info']].map(([k,l])=>`<button onclick="ptab('${k}')" style="flex:1;height:54px;border:0;background:none;font-size:17px;font-weight:${tab===k?800:600};color:${tab===k?'var(--tx)':'var(--mu)'};border-bottom:3px solid ${tab===k?'var(--tx)':'transparent'}">${l}</button>`).join('')}</div>`;
 const stars=k=>`<span style="color:#F5A524">${'★'.repeat(k)}</span><span style="color:var(--ln)">${'★'.repeat(5-k)}</span>`;
 const body=tab==='reviews'?`<div style="padding:20px 24px 0"><div class="mu" style="font-size:14px">Reviews from all shops</div><div style="font-size:32px;font-weight:800;margin-top:6px"><span style="color:#F5A524">★★★★★</span> ${rt(i)} <span class="mu" style="font-size:18px;font-weight:600">(${rc})</span></div></div>
  <div style="padding:0 24px">${REV.map(v=>`<div style="padding:20px 0;border-bottom:1px solid var(--ln)"><div style="display:flex;justify-content:space-between"><div>${stars(v[1])} <b style="margin-left:6px">${v[0]}</b> <span class="mu" style="font-size:14px">${v[3]}</span></div></div><div class="mu" style="font-size:14px;margin-top:6px">${x.n} · Seller: ${x.m}</div><div style="display:flex;gap:12px;margin-top:10px">${v[4]?`<div style="flex:0 0 84px;height:84px;border-radius:14px;background:${TINT[i%4]};display:flex;align-items:center;justify-content:center">${gl(x.g,44)}</div>`:''}<div style="font-size:16px;line-height:23px">${v[2]}</div></div></div>`).join('')}</div>`
  :`<div style="padding:8px 0 0">${[['Why people love it',x.n+' from '+x.m+'. Popular with shoppers in Kigali this month.'],['Details','Category: '+x.c+'. '+(x.s<=5?'Only '+x.s+' left in stock.':'In stock and ready to ship.')],['Care and use','Keep in a cool, dry place. See the pack for full instructions.']].map((b,k)=>`<div style="margin:16px 24px 0;border-radius:24px;background:${TINT[(i+k)%4]};color:#191F28;padding:26px 22px;text-align:center"><div style="font-size:20px;font-weight:800;letter-spacing:-.3px">${b[0]}</div><div style="margin:14px 0">${gl(x.g,90)}</div><div style="font-size:15px;line-height:22px">${b[1]}</div></div>`).join('')}<div class="sm mu" style="padding:14px 24px 0">Product details are sample content for this prototype.</div></div>`;
 const more=[...PRODS.keys()].filter(k=>k!==i).slice(0,4);
 const foot=`<div onclick="S.pinf=!S.pinf;render('fade-none')" style="padding:22px 24px;text-align:center;font-size:16px;color:var(--mu);cursor:pointer">Delivery · Returns · Product · Seller info ${ic('chev',14,'var(--tt)')}</div>${S.pinf?`<div style="margin:0 24px;border-radius:16px;background:var(--chip);padding:14px 16px;font-size:14px;line-height:21px"><b>Delivery:</b> ${eta(i)}<br><b>Returns:</b> free within 7 days if unopened<br><b>Seller:</b> ${x.m}</div>`:''}
 <div style="margin:18px 24px 0;border-radius:16px;background:var(--chip);padding:16px;font-size:14px;line-height:21px;color:var(--mu)">If a seller asks for payment outside itunda, cash, or personal details, or the listing looks wrong, please report it.</div>
 <div style="padding:30px 24px 12px"><b style="font-size:20px">You may also like</b></div><div style="display:grid;grid-template-columns:1fr 1fr;gap:22px 12px;padding:0 20px 24px">${more.map(k=>{const p=PRODS[k],dd=pct(p.p,p.o);return `<div class="tap" onclick="openProd(${k})" style="cursor:pointer"><div class="pim" style="border-radius:20px">${gl(p.g,58)}</div><div style="font-size:14px;line-height:20px;margin-top:8px">${p.n}</div><div style="font-size:17px;font-weight:800">${dd?`<span style="font-size:14px">${dd}%</span> `:''}${fmt(p.p)} RWF</div></div>`}).join('')}</div>`;
 const bar=`<div class="cta" style="display:flex;gap:10px;align-items:center;padding:12px 16px 24px"><button aria-label="Save" onclick="tgFav(${i});render('fade-none')" style="width:48px;height:52px;border:0;background:none;display:flex;align-items:center;justify-content:center">${heart(fav)}</button><button onclick="pAdd(${i},1)" style="flex:1;height:56px;border:0;border-radius:18px;background:var(--chip);font-weight:800;font-size:17px;color:var(--tx)">Add to cart</button><button onclick="buySheet(${i})" style="flex:1;height:56px;border:0;border-radius:18px;background:var(--br);font-weight:800;font-size:17px;color:var(--on)">Buy now</button></div>`;
 return gal+info+tabs+body+foot+'<div style="height:96px"></div>'+bar;
 }catch(e){console.error(e);return _p.apply(this,arguments)}};
}catch(e){console.error('shop-v451',e)}})();
</script>
<script id="shop-v452">
(()=>{try{
const FREE=8000;
const _c=screens.scart;
screens.scart=function(){const h=_c.apply(this,arguments);try{
 if(S.sdel==='pick'||h.includes('fs11'))return h;
 const sub=scTotal(),left=FREE-sub,pc=Math.min(100,Math.round(sub/FREE*100));
 const inCart=new Set(Object.keys(S.scart).map(Number));
 const sug=left>0?PRODS.map((p,i)=>i).filter(i=>!inCart.has(i)&&PRODS[i].s>0).sort((a,b)=>Math.abs(PRODS[a].p-left)-Math.abs(PRODS[b].p-left)).slice(0,3):[];
 const box=`<div class="pad fs11" style="padding-top:16px"><div style="border-radius:20px;background:var(--chip);padding:16px"><div style="font-weight:800;font-size:15px">${left>0?'Add '+fmt(left)+' RWF more for free shipping':'You unlocked free shipping'}</div><div style="height:8px;border-radius:4px;background:var(--ln);margin-top:10px;overflow:hidden"><div style="width:${pc}%;height:8px;border-radius:4px;background:${left>0?'var(--br)':'var(--ok)'}"></div></div>${sug.length?`<div style="display:flex;gap:10px;overflow-x:auto;scrollbar-width:none;margin-top:14px">${sug.map(i=>`<div style="flex:0 0 150px;display:flex;align-items:center;gap:8px;background:var(--bg);border-radius:14px;padding:8px"><div class="pim" style="flex:0 0 44px;height:44px;aspect-ratio:auto;border-radius:12px">${gl(PRODS[i].g,26)}</div><div style="min-width:0;flex:1"><div style="font-size:12px;line-height:15px;max-height:30px;overflow:hidden">${PRODS[i].n}</div><b style="font-size:13px">${fmt(PRODS[i].p)}</b></div><button aria-label="Add" onclick="quickAdd(${i},event)" style="width:30px;height:30px;border-radius:15px;border:0;background:var(--br);color:var(--on);font-size:18px;font-weight:800">+</button></div>`).join('')}</div>`:''}</div></div>`;
 const m='<div class="pad" role="radiogroup"',k=h.indexOf(m);return k<0?h:h.slice(0,k)+box+h.slice(k)}catch(e){return h}};
}catch(e){console.error('shop-v452',e)}})();
</script>
<script id="shop-v453">
(()=>{try{
S.urev=S.urev||{};
const itemOf=o=>{const a=Array.isArray(o.items)?o.items:[];const it=a[0];if(!it)return null;const i=Array.isArray(it)?it[0]:(it.i??it.id??it.k);return PRODS[+i]?+i:null};
const mine=()=>S.orders.filter(o=>o.k==='Shop order');
window.revOpen=k=>{const o=mine()[k],i=o&&itemOf(o);if(i==null){toast('This order has no product to review');return}
 S.rvd={k,i,s:5,img:null};const x=PRODS[i];
 $('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" style="max-height:88%;overflow-y:auto"><div class="h1" style="font-size:22px;line-height:30px">Write a review</div><div class="mu" style="margin-top:4px">${x.n}</div>
 <div id="rvst" style="display:flex;gap:6px;margin:18px 0 6px">${[1,2,3,4,5].map(n=>`<button aria-label="${n} stars" onclick="revStar(${n})" style="border:0;background:none;font-size:38px;line-height:1;color:#F5A524;padding:0">★</button>`).join('')}</div>
 <textarea id="rvt" maxlength="300" placeholder="How was it? Quality, delivery, value" style="width:100%;height:110px;border-radius:16px;border:0;background:var(--chip);padding:14px;font:inherit;font-size:15px;color:var(--tx);resize:none;margin-top:8px"></textarea>
 <div style="display:flex;align-items:center;gap:12px;margin-top:12px"><label style="height:44px;padding:0 16px;border-radius:14px;background:var(--chip);display:flex;align-items:center;font-weight:700;font-size:15px;cursor:pointer">Add photo<input type="file" accept="image/*" aria-label="Add a photo" onchange="revPhoto(this)" style="display:none"></label><div id="rvimg" style="width:56px;height:56px;border-radius:12px;background:var(--chip);overflow:hidden;display:none"></div></div>
 <button class="btn" style="margin-top:20px" onclick="revSend()">Submit review</button></div>`};
window.revStar=n=>{S.rvd.s=n;document.querySelectorAll('#rvst button').forEach((b,j)=>b.style.color=j<n?'#F5A524':'var(--ln)')};
window.revPhoto=inp=>{const f=inp.files&&inp.files[0];if(!f)return;const r=new FileReader();r.onload=()=>{const im=new Image();im.onload=()=>{const c=document.createElement('canvas'),m=360,sc=Math.min(1,m/Math.max(im.width,im.height));c.width=Math.round(im.width*sc);c.height=Math.round(im.height*sc);c.getContext('2d').drawImage(im,0,0,c.width,c.height);S.rvd.img=c.toDataURL('image/jpeg',.7);const b=document.getElementById('rvimg');if(b){b.style.display='block';b.innerHTML=`<img src="${S.rvd.img}" alt="Your photo" style="width:100%;height:100%;object-fit:cover">`}};im.src=r.result};r.readAsDataURL(f)};
window.revSend=()=>{const d=S.rvd,t=(document.getElementById('rvt')||{}).value||'';if(!d)return;if(!t.trim()&&!d.img){toast('Write something or add a photo');return}
 (S.urev[d.i]=S.urev[d.i]||[]).unshift({s:d.s,t:t.trim()||'Photo review',img:d.img});const o=mine()[d.k];if(o)o.rev=1;S.rvd=null;closeSheet();render('fade-none');toast('Thanks for your review')};
const _o=screens.sorders;
screens.sorders=function(){let h=_o.apply(this,arguments);try{
 let k=-1;return h.replace(/<button class="chip" onclick="shReturn\((\d+)\)">Return<\/button>/g,(m,n)=>{const o=mine()[+n];return m+(o&&o.rev?'<span class="sm mu" style="align-self:center">Reviewed</span>':`<button class="chip" onclick="revOpen(${n})">Write review</button>`)})}catch(e){return h}};
const _p=screens.product;
screens.product=function(){const h=_p.apply(this,arguments);try{
 const u=S.urev[S.pi]||[];if(!u.length||h.includes('urv'))return h;
 const st=n=>`<span style="color:#F5A524">${'★'.repeat(n)}</span><span style="color:var(--ln)">${'★'.repeat(5-n)}</span>`;
 const html=u.map(r=>`<div class="urv" style="padding:20px 0;border-bottom:1px solid var(--ln)"><div>${st(r.s)} <b style="margin-left:6px">You</b> <span class="mu" style="font-size:14px">Just now</span></div><div style="display:flex;gap:12px;margin-top:10px">${r.img?`<img src="${r.img}" alt="Your photo" style="flex:0 0 84px;height:84px;border-radius:14px;object-fit:cover">`:''}<div style="font-size:16px;line-height:23px">${r.t.replace(/</g,'&lt;')}</div></div></div>`).join('');
 const m='<div style="padding:0 24px"><div style="padding:20px 0;border-bottom:1px solid var(--ln)">',k=h.indexOf(m);if(k<0)return h;
 return (h.slice(0,k)+'<div style="padding:0 24px">'+html+h.slice(k+'<div style="padding:0 24px">'.length)).replace(/Reviews \((\d+)\)/,(a,n)=>'Reviews ('+(+n+u.length)+')')}catch(e){return h}};
const _s=screens.shop;
screens.shop=function(){const h=_s.apply(this,arguments);try{
 if(S.shopTab==='eats'||(S.stab&&S.stab!=='home')||h.includes('rv12'))return h;
 const rv=(S.rv||[]).filter(i=>PRODS[i]).slice(0,8);if(!rv.length)return h;
 const m='<div style="display:flex;justify-content:space-between;align-items:center;padding:28px 24px 14px"><b style="font-size:20px;letter-spacing:-.4px">Recommended for you',k=h.indexOf(m);if(k<0)return h;
 const box=`<div class="rv12"><div style="padding:28px 24px 14px"><b style="font-size:20px;letter-spacing:-.4px">Recently viewed</b></div><div style="display:flex;gap:12px;overflow-x:auto;scrollbar-width:none;padding:0 24px">${rv.map(i=>`<div class="tap" onclick="openProd(${i})" style="flex:0 0 112px;cursor:pointer"><div class="pim" style="border-radius:18px;aspect-ratio:1/1">${gl(PRODS[i].g,48)}</div><div style="font-size:13px;line-height:18px;margin-top:6px">${PRODS[i].n}</div><b style="font-size:14px">${fmt(PRODS[i].p)} RWF</b></div>`).join('')}</div></div>`;
 return h.slice(0,k)+box+h.slice(k)}catch(e){return h}};
}catch(e){console.error('shop-v453',e)}})();
</script>
<script id="shop-v454">
(()=>{try{
const TINT=['#D5ECF6','#FDECEF','#FFF3DA','#E6F6EC'];
const KEEP=2,H=560;
const SP={Food:[['Storage','Cool, dry place'],['Shelf life','6 to 12 months, see pack'],['Origin','Rwanda']],Fashion:[['Material','Cotton or local fabric'],['Care','Cold wash, dry in shade'],['Origin','Rwanda']],Home:[['Material','Hand-woven natural fibre'],['Care','Wipe with a dry cloth'],['Origin','Rwanda']],Electronics:[['Warranty','Seller warranty, 3 months'],['Box','Item and quick guide'],['Origin','See pack']]};
const keep=(k,fn)=>{const sc=document.querySelector('.screen'),t=sc?sc.scrollTop:0;fn();render('fade-none');const z=document.querySelector('.screen');if(z)z.scrollTop=t};
window.pDet=i=>{const open=S.pdet===i;if(open){S.pdet=null;render('fade-none');const e=document.getElementById('pdet');if(e){e.scrollIntoView({block:'start'});const z=document.querySelector('.screen');if(z)z.scrollTop-=70}}else keep(0,()=>{S.pdet=i})};
window.pRvAll=i=>keep(0,()=>{S.prvAll=i});
const _p=screens.product;
screens.product=function(){let h=_p.apply(this,arguments);try{
 const i=S.pi,x=PRODS[i];if(!x||h.includes('shop-v454'))return h;
 const tab=S.ptab||'reviews',open=S.pdet===i;
 const btn=(a,l,ex)=>`<button onclick="${a}" aria-expanded="${ex}" style="display:block;width:calc(100% - 48px);margin:16px 24px 0;height:56px;border:0;border-radius:18px;background:var(--chip);color:var(--lk);font-weight:800;font-size:17px">${l}</button>`;
 if(tab==='info'){
  const a=h.indexOf('<div style="padding:8px 0 0"><div style="margin:16px 24px 0;border-radius:24px'),E='Product details are sample content for this prototype.</div></div>',b=h.indexOf(E);
  if(a<0||b<0)return h;
  const dd=pct(x.p,x.o),sp=SP[x.c]||SP.Food;
  const card=(k,t,body,ic_)=>`<div style="margin:16px 24px 0;border-radius:24px;background:${TINT[(i+k)%4]};color:#191F28;padding:26px 22px;text-align:center"><div style="font-size:13px;font-weight:800;opacity:.6">0${k+1}</div><div style="font-size:20px;font-weight:800;letter-spacing:-.3px;margin-top:4px">${t}</div><div style="margin:14px 0">${gl(x.g,k?84:96)}</div><div style="font-size:15px;line-height:22px">${body}</div></div>`;
  const hero=`<div style="margin:16px 24px 0;border-radius:24px;background:linear-gradient(160deg,${TINT[i%4]},${TINT[(i+1)%4]});color:#191F28;padding:30px 22px;text-align:center"><div style="font-size:13px;font-weight:700;opacity:.65">${x.m}</div><div style="font-size:26px;font-weight:800;letter-spacing:-.5px;line-height:34px;margin-top:6px">${x.n}</div><div style="margin:16px 0 4px">${gl(x.g,130)}</div><div style="font-size:15px;line-height:22px">${dd?`Now ${dd}% off at ${fmt(x.p)} RWF`:`${fmt(x.p)} RWF`} · ${x.p>=8000?'Free shipping':'Shipping 1,500 RWF'}</div></div>`;
  const c=[['Why people love it',x.n+' from '+x.m+'. Popular with shoppers in Kigali this month.'],['Details','Category: '+x.c+'. '+(x.s<=5?'Only '+x.s+' left in stock.':'In stock and ready to ship.')],['Care and use','Keep in a cool, dry place. See the pack for full instructions.']].map((q,k)=>card(k,q[0],q[1])).join('');
  const rows=[['Seller',x.m],['Category',x.c],['Stock',x.s<=0?'Sold out':x.s<=5?x.s+' left':'In stock'],...sp,['Returns','Free within 7 days if unopened']];
  const spec=`<div style="margin:28px 24px 0"><b style="font-size:19px">Product specs</b><div style="margin-top:10px;border-top:2px solid var(--tx)">${rows.map(r=>`<div style="display:flex;gap:12px;padding:13px 0;border-bottom:1px solid var(--ln);font-size:15px;line-height:21px"><span class="mu" style="flex:0 0 96px">${r[0]}</span><span style="flex:1">${r[1]}</span></div>`).join('')}</div></div>`;
  const good=`<div style="margin:28px 24px 0;border-radius:24px;background:var(--chip);padding:24px 20px"><b style="font-size:19px">Good for</b>${['Everyday use at home or on the go','Gifts for family and friends','Supporting local Rwandan sellers','Quick delivery in Kigali'].map(t=>`<div style="display:flex;align-items:center;gap:12px;margin-top:14px;font-size:16px"><span style="flex:0 0 28px;height:28px;border-radius:14px;background:var(--br);color:var(--on);display:flex;align-items:center;justify-content:center;font-size:15px;font-weight:800">✓</span>${t}</div>`).join('')}</div>`;
  const pr=`<div style="margin:28px 24px 0;text-align:center"><b style="font-size:19px">Our 2 promises</b><div style="display:flex;gap:10px;margin-top:14px">${[['Packed with care','Checked before it leaves the shop'],['7-day returns','Free if unopened']].map(p=>`<div style="flex:1;border-radius:20px;background:var(--chip);padding:18px 10px"><b style="font-size:15px">${p[0]}</b><div class="sm mu" style="margin-top:6px">${p[1]}</div></div>`).join('')}</div></div>`;
  const inner=hero+c+spec+good+pr+`<div class="sm mu" style="padding:18px 24px 6px">Product details are sample content for this prototype.</div>`;
  const box=`<div id="pdet" style="padding-top:8px"><div style="position:relative;${open?'':`max-height:${H}px;overflow:hidden`}">${inner}${open?'':'<div style="position:absolute;left:0;right:0;bottom:0;height:140px;background:linear-gradient(to bottom,transparent,var(--bg));pointer-events:none"></div>'}</div>${btn(`pDet(${i})`,open?'Show less':'See details',open)}</div><!--shop-v454-->`;
  h=h.slice(0,a)+box+h.slice(b+E.length);
 }else{
  let n=0;const all=S.prvAll===i;
  h=h.replace(/<div( class="urv")? style="padding:20px 0;border-bottom:1px solid var\(--ln\)">/g,(m,c)=>(++n>KEEP&&!all)?m.replace('style="','style="display:none;'):m);
  if(n>KEEP&&!all){const rc=(h.match(/Reviews \((\d+)\)/)||[])[1]||n;const m='<div onclick="S.pinf=!S.pinf',k=h.indexOf(m);const b=`<button onclick="pRvAll(${i})" style="display:block;width:calc(100% - 48px);margin:16px 24px 0;height:56px;border:0;border-radius:18px;background:var(--chip);color:var(--tx);font-weight:800;font-size:16px">See all reviews (${rc}) ›</button><!--shop-v454-->`;if(k>=0)h=h.slice(0,k)+b+h.slice(k)}
  else h+='<!--shop-v454-->';
 }
 return h}catch(e){console.error(e);return h}};
}catch(e){console.error('shop-v454',e)}})();
</script>
<script id="shop-v455">
(()=>{try{
S.csel=S.csel||{};S.ctab=S.ctab||'cart';
const keep=fn=>{const sc=document.querySelector('.screen'),t=sc?sc.scrollTop:0;fn();render('fade-none');const z=document.querySelector('.screen');if(z)z.scrollTop=t};
const ids=()=>Object.keys(S.scart).filter(i=>S.scart[i]>0);
const chk=(on,a,l)=>`<button role="checkbox" aria-checked="${!!on}" aria-label="${l}" onclick="${a}" style="flex:0 0 28px;width:28px;height:28px;border:${on?0:'2px solid var(--ln)'};border-radius:9px;background:${on?'var(--br)':'transparent'};color:var(--on);display:flex;align-items:center;justify-content:center;font-size:16px;font-weight:800;padding:0">${on?'✓':''}</button>`;
window.cTab=k=>{S.ctab=k;render('fade-none')};
window.cSel=i=>keep(()=>{S.csel[i]=!S.csel[i]});
window.cSelAll=()=>keep(()=>{const a=ids(),all=a.every(i=>S.csel[i]);S.csel={};if(!all)a.forEach(i=>S.csel[i]=1)});
window.cDel=l=>{const d=(l||ids().filter(i=>S.csel[i]));if(!d.length){toast('Select items to delete');return}
 d.forEach(i=>delete S.scart[i]);S.csel={};if(!ids().length){S.promo=null;S.stack=['shop'];render('pop');toast('Cart is empty');return}render('fade-none');toast(d.length+(d.length>1?' items removed':' item removed'))};
window.cAdd=i=>{if(PRODS[i].s-(S.scart[i]||0)<=0){toast('No more in stock');return}S.scart[i]=(S.scart[i]||0)+1;keep(()=>{});toast('Added to cart')};
window.cFav=i=>keep(()=>{S.fav[i]=!S.fav[i]});
const tabs=()=>{const n=ids().length,T=[['cart','Cart'+(n?' '+n:'')],['recent','Recent'],['wish','Wishlist']];
 return `<div role="tablist" style="display:flex;border-bottom:1px solid var(--ln);margin:0 24px">${T.map(([k,l])=>`<button role="tab" aria-selected="${S.ctab===k}" onclick="cTab('${k}')" style="flex:1;height:52px;border:0;background:none;font-size:16px;font-weight:${S.ctab===k?800:600};color:${S.ctab===k?'var(--tx)':'var(--mu)'};border-bottom:3px solid ${S.ctab===k?'var(--tx)':'transparent'};margin-bottom:-1px">${l}</button>`).join('')}</div>`};
const card=(i,x)=>{const p=PRODS[i],d=pct(p.p,p.o),no=p.s-(S.scart[i]||0)<=0;return `<div style="min-width:0"><div class="pim tap" onclick="openProd(${i})" style="border-radius:20px;position:relative;cursor:pointer">${gl(p.g,58)}${d?`<span style="position:absolute;left:8px;top:8px;background:#F04452;color:#fff;font-size:12px;font-weight:800;border-radius:8px;padding:3px 7px">${d}% off</span>`:''}${x}<button aria-label="Add to cart" onclick="event.stopPropagation();cAdd(${i})" style="position:absolute;right:8px;bottom:8px;width:38px;height:38px;border:0;border-radius:19px;background:rgba(255,255,255,.85);color:#191F28;display:flex;align-items:center;justify-content:center;${no?'opacity:.4':''}">${ic('bag',20)}</button></div><div style="font-size:14px;line-height:20px;margin-top:8px">${p.n}</div><div style="font-size:17px;font-weight:800">${d?`<span style="font-size:14px;color:#F04452">${d}%</span> `:''}${fmt(p.p)} RWF</div><div class="sm mu">${p.s<=5?p.s+' left · ':''}${p.m}</div></div>`};
const grid=(a,x)=>`<div style="display:grid;grid-template-columns:1fr 1fr;gap:22px 12px;padding:20px 24px 120px">${a.map(i=>card(i,x?x(i):'')).join('')}</div>`;
const empty=(t,s)=>`<div style="text-align:center;padding:70px 32px 120px"><div style="font-size:18px;font-weight:800">${t}</div><div class="mu" style="margin-top:8px">${s}</div><button class="btn" style="margin-top:22px" onclick="S.stack=['shop'];render('pop')">Browse products</button></div>`;
const _c=screens.scart;
screens.scart=function(){
 if(S.ctab==='recent'||S.ctab==='wish'){try{
  const rv=(S.rv||[]).filter(i=>PRODS[i]),w=PRODS.map((p,i)=>i).filter(i=>S.fav&&S.fav[i]);
  const body=S.ctab==='recent'?(rv.length?grid(rv):empty('Nothing viewed yet','Products you open will show up here.')):(w.length?grid(w,i=>`<button aria-label="Remove from wishlist" onclick="event.stopPropagation();cFav(${i})" style="position:absolute;right:8px;top:8px;width:32px;height:32px;border:0;border-radius:16px;background:rgba(0,0,0,.3);color:#fff;font-size:16px">✕</button>`):empty('No saved items','Tap the heart on a product to save it.'));
  return bar('Cart')+tabs()+body}catch(e){console.error(e)}}
 let h=_c.apply(this,arguments);
 try{
  if(h.includes('shop-v455'))return h;
  const a=ids(),n=a.length,sel=a.filter(i=>S.csel[i]).length,all=n&&sel===n;
  const m='<div class="pad" style="padding-top:12px">',k=h.indexOf(m);if(k<0)return h;
  const head=tabs()+`<div style="display:flex;align-items:center;gap:12px;padding:14px 24px 2px">${chk(all,'cSelAll()','Select all')}<span style="flex:1;font-size:16px;font-weight:600">Select all (${sel}/${n})</span><button onclick="cDel()" style="height:40px;padding:0 16px;border:0;border-radius:12px;background:var(--chip);color:${sel?'var(--tx)':'var(--mu)'};font-weight:700;font-size:15px">Delete selected</button></div>`;
  let rest=h.slice(k);
  rest=rest.replace(/<div style="display:flex;align-items:center;gap:12px;padding:10px 0">((?:(?!padding:10px 0">)[\s\S])*?)scAdj\((\d+),-1\)/g,(m2,g,i)=>`<div style="display:flex;align-items:center;gap:12px;padding:10px 0">${chk(S.csel[i],`cSel(${i})`,'Select item')}${g}scAdj(${i},-1)`);
  const j=rest.indexOf('<div class="pad" style="padding-top:8px">');
  const note=`<div class="sm mu" style="padding:6px 24px 0;line-height:20px">* Up to 100 items fit in your cart.<br>* Items added over 90 days ago are removed automatically.</div>`;
  if(j>=0)rest=rest.slice(0,j)+note+rest.slice(j);
  rest=rest.replace(/>Pay ([\d,]+) RWF</,(m3,t)=>`>${n} item${n>1?'s':''} · ${t} RWF · Pay<`);
  return h.slice(0,k)+head+rest+'<!--shop-v455-->'}catch(e){console.error(e);return h}};
const _o=window.openCart;
window.openCart=function(){S.ctab='cart';return _o.apply(this,arguments)};
}catch(e){console.error('shop-v455',e)}})();
</script>
<script id="shop-v456">
(()=>{try{
S.shpts=S.shpts==null?453:S.shpts;S.drl=S.drl==null?2:S.drl;S.drlDay=S.drlDay||new Date().toDateString();
const mine=()=>S.orders.filter(o=>o.k==='Shop order'&&o.items);
const rowI=(g,l,r,a)=>`<button onclick="${a}" style="flex:1;border:0;background:none;display:flex;flex-direction:column;align-items:center;gap:8px;padding:6px 0;font-size:14px;font-weight:600;color:var(--tx)"><i style="width:48px;height:48px;border-radius:16px;background:var(--bg);display:flex;align-items:center;justify-content:center">${gl(g,30)}</i>${l}${r?`<span class="sm" style="color:var(--lk);font-weight:800">${r}</span>`:''}</button>`;
const cardS='margin:12px 24px 0;border-radius:24px;background:var(--chip);padding:20px';
const hd=(t,a)=>`<div style="display:flex;justify-content:space-between;align-items:center"><b style="font-size:19px">${t}</b>${a?`<button onclick="${a[1]}" style="border:0;background:none;color:var(--mu);font-size:15px">${a[0]} ›</button>`:''}</div>`;
const itemOf=o=>{const a=o.items[0];return +(Array.isArray(a)?a[0]:a.i)};
const nm=o=>o.items.reduce((a,x)=>a+(Array.isArray(x)?x[1]:x.q),0);
screens.myshop=function(){
 const rv=(S.rv||[]).filter(i=>PRODS[i]).slice(0,3),o=mine().slice(0,2),w=PRODS.map((p,i)=>i).filter(i=>S.fav&&S.fav[i]);
 const bk=`<div class="top" style="padding:12px 16px 0 8px"><button class="ib" aria-label="Back" onclick="back()">${ic('back',24)}</button><span style="flex:1"></span><button class="ib" aria-label="Cart" onclick="openCart()">${ic('bag',24)}</button></div>`;
 const ti=`<div style="display:flex;justify-content:space-between;align-items:center;padding:14px 24px 0"><b style="font-size:26px;letter-spacing:-.5px">My shopping</b><button onclick="toast('Points can be used at checkout in a full version')" style="height:44px;padding:0 18px;border:0;border-radius:22px;background:var(--chip);color:var(--tx);font-weight:800;font-size:17px;display:flex;align-items:center;gap:8px"><span style="width:22px;height:22px;border-radius:11px;background:var(--br);color:var(--on);font-size:13px;display:flex;align-items:center;justify-content:center">P</span>${fmt(S.shpts)} pts</button></div>`;
 const earn=`<button onclick="toast('Cashback is shown as a sample')" style="${cardS};display:block;width:calc(100% - 48px);border:0;text-align:left;color:var(--tx);font-size:17px;font-weight:700;padding:18px 20px">Earn up to 7% back on every order with itunda Pay</button>`;
 const qk=`<div style="${cardS};display:flex;padding:14px 8px">${rowI('gift','Coupons','','toast(\'No coupons right now\')')}${rowI('verified3d','Reviews',mine().filter(x=>!x.rev).length?mine().filter(x=>!x.rev).length+' to write':'',"S.stack=['shop','sorders'];render('push')")}${rowI('heartred','Wishlist',w.length?String(w.length):'',"S.ctab='wish';S.stack=['shop','scart'];render('push')")}${rowI('chat','Inquiries','','toast(\'No inquiries yet\')')}</div>`;
 const rec=`<button onclick="S.ctab='recent';S.stack=['shop','scart'];render('push')" style="${cardS};display:flex;width:calc(100% - 48px);border:0;align-items:center;justify-content:space-between;color:var(--tx)"><b style="font-size:19px">Recently viewed</b><span style="display:flex;align-items:center;gap:8px">${rv.map(i=>`<span class="pim" style="width:44px;height:44px;border-radius:12px;aspect-ratio:auto;display:flex;align-items:center;justify-content:center">${gl(PRODS[i].g,26)}</span>`).join('')}›</span></button>`;
 const ord=`<div style="${cardS}">${hd('Orders',['View all',"S.stack=['shop','sorders'];render('push')"])}${o.length?`<div style="display:flex;gap:14px;margin-top:16px">${o.map(x=>{const i=itemOf(x),p=PRODS[i];return `<div style="flex:0 0 calc(50% - 7px);min-width:0"><div class="pim" style="border-radius:18px;aspect-ratio:1/1">${gl(p.g,56)}</div><div style="font-weight:800;margin-top:10px;font-size:15px">${x.s==='Processing'?'Preparing':x.s}</div><div class="sm mu" style="line-height:18px">${p.n}${nm(x)>1?' · '+nm(x)+' items':''}</div><button onclick="S.stack=['shop','sorders'];render('push')" style="margin-top:10px;width:100%;height:44px;border:0;border-radius:12px;background:var(--bg);color:var(--tx);font-weight:700">Order details</button></div>`}).join('')}</div>`:`<div class="mu" style="padding:18px 0 4px">No shop orders yet.</div>`}</div>`;
 const dr=`<button onclick="openDraw()" style="${cardS};display:flex;width:calc(100% - 48px);border:0;align-items:center;justify-content:space-between;color:var(--tx);text-align:left"><span><b style="font-size:19px">Daily draw</b><div class="mu" style="font-size:14px;margin-top:2px">${S.drl} draw${S.drl===1?'':'s'} left today</div></span>${gl('celebrate',44)}</button>`;
 const sh=`<button onclick="shareShop()" style="${cardS};display:flex;width:calc(100% - 48px);border:0;align-items:center;justify-content:space-between;color:var(--tx)"><b style="font-size:19px">Share link</b><span class="mu" style="font-size:15px">Share a product and earn ›</span></button>`;
 const wl=`<div style="${cardS}">${hd('Wishlist',w.length?['View all',"S.ctab='wish';S.stack=['shop','scart'];render('push')"]:null)}${w.length?`<div style="display:flex;gap:12px;margin-top:14px;overflow-x:auto;scrollbar-width:none">${w.slice(0,5).map(i=>`<div class="tap" onclick="openProd(${i})" style="flex:0 0 110px;cursor:pointer"><div class="pim" style="border-radius:16px;aspect-ratio:1/1">${gl(PRODS[i].g,48)}</div><div style="font-size:13px;line-height:18px;margin-top:6px">${PRODS[i].n}</div><b style="font-size:14px">${fmt(PRODS[i].p)} RWF</b></div>`).join('')}</div>`:`<div class="mu" style="padding:14px 0 4px">Tap the heart on a product to save it.</div>`}</div>`;
 const pay=`<button onclick="toast('Payment and address settings are not in this prototype')" style="${cardS};display:flex;width:calc(100% - 48px);border:0;align-items:center;justify-content:space-between;color:var(--tx)"><b style="font-size:19px">Payment and delivery</b><span class="mu">itunda Pay ›</span></button>`;
 return bk+ti+earn+qk+rec+ord+dr+sh+wl+pay+'<div class="pad fine" style="padding:20px 24px 40px">Points, orders and shops are sample data.</div>'};
window.shareShop=()=>{const u='https://itunda.rw/shop?ref=you';try{navigator.clipboard&&navigator.clipboard.writeText(u)}catch(e){}toast('Share link copied')};
window.openDraw=()=>{const t=new Date().toDateString();if(S.drlDay!==t){S.drlDay=t;S.drl=2}S.drI=S.drI==null?PRODS.findIndex(p=>p.p>=6000):S.drI;S.drRes=null;S.stack=['shop','draw'];render('push')};
window.drGo=()=>{if(S.drl<=0){toast('No draws left today. Come back tomorrow');return}if(S.drBusy)return;S.drBusy=1;S.drl--;const o=document.getElementById('orb');if(o)o.style.animation='orbsh .5s linear 3';
 setTimeout(()=>{S.drBusy=0;const win=Math.random()<.35;if(win)S.shpts+=500;S.drRes=win?'win':'lose';render('fade-none')},1500)};
window.drPick=i=>{S.drI=i;S.drRes=null;render('fade-none')};
screens.draw=function(){const i=S.drI,p=PRODS[i],r=S.drRes;
 const bk=`<div class="top" style="padding:12px 16px 0 8px"><button class="ib" aria-label="Back" onclick="back()">${ic('back',24)}</button><span style="flex:1"></span><button onclick="toast('Draws are free. A win gives 500 points in this prototype.')" style="border:0;background:none;color:var(--mu);font-size:16px;padding:0 12px">Info</button></div>`;
 const head=r==='win'?`<div style="font-size:27px;font-weight:800;line-height:36px">You won<br><span style="color:var(--lk)">500 points</span></div><div class="mu" style="margin-top:8px">Added to your balance: ${fmt(S.shpts)} pts</div>`:r==='lose'?`<div style="font-size:27px;font-weight:800;line-height:36px">Not this time</div><div class="mu" style="margin-top:8px">${S.drl?'Try again, you have '+S.drl+' left today':'Come back tomorrow for more draws'}</div>`:`<div style="font-size:27px;font-weight:800;line-height:36px">Draw to win<br><span style="color:var(--lk)">500 points</span></div><div class="mu" style="margin-top:8px">${S.drl} draw${S.drl===1?'':'s'} left today</div>`;
 return `<style>@keyframes orbsh{0%,100%{transform:translateX(0) rotate(0)}25%{transform:translateX(-10px) rotate(-6deg)}75%{transform:translateX(10px) rotate(6deg)}}</style>`+bk+`<div style="text-align:center;padding:24px 24px 0">${head}</div><div style="display:flex;justify-content:center;padding:28px 0 20px"><div id="orb" style="width:190px;height:190px;border-radius:95px;background:radial-gradient(circle at 35% 30%,#9FD3FF,#3182F6 60%,#1B64DA);box-shadow:0 0 70px rgba(255,200,80,.55);display:flex;align-items:center;justify-content:center;font-size:${r==='win'?'72px':'0'}">${r==='win'?'🎉':''}</div></div><div style="padding:0 24px"><div class="sm mu" style="text-align:center;margin-bottom:10px">Pick a product to draw for</div><div style="display:flex;gap:10px;overflow-x:auto;scrollbar-width:none;justify-content:center">${PRODS.slice(0,5).map((q,k)=>`<button onclick="drPick(${k})" aria-label="${q.n}" style="flex:0 0 56px;height:56px;border-radius:16px;border:${k===i?'2px solid var(--lk)':'2px solid transparent'};background:var(--chip);display:flex;align-items:center;justify-content:center">${gl(q.g,30)}</button>`).join('')}</div><div style="text-align:center;margin-top:12px;font-weight:700">${p.n}</div></div><div class="cta">${r&&S.drl<=0?`<button class="btn" onclick="openProd(${i})">View product</button>`:`<button class="btn" ${S.drl<=0?'disabled':''} onclick="drGo()">${S.drl<=0?'No draws left':r?'Draw again':'Draw'}</button>`}</div>`};
const _s=screens.shop;
screens.shop=function(){let h=_s.apply(this,arguments);try{
 if(S.shopTab==='eats')return h;
 h=h.replace(`aria-label="Orders" onclick="S.stack=['shop','sorders'];render('push')"`,`aria-label="My shopping" onclick="S.stack=['shop','myshop'];render('push')"`)
  .replace("toast('Draws are not in this prototype')","openDraw()")
  .replace("toast('Rewards are not in this prototype')","S.stack=['shop','myshop'];render('push')")
  .replace("toast('Wishlist is saved from each product')","S.ctab='wish';S.stack=['shop','scart'];render('push')");
 return h}catch(e){return h}};
}catch(e){console.error('shop-v456',e)}})();
</script>
<script id="shop-v457">
(()=>{try{
S.qpay=S.qpay==null?true:S.qpay;S.usePts=!!S.usePts;
const PR={ITUNDA10:10,KIGALI5:5};
const tot=()=>{const s=scTotal(),off=S.promo?Math.round(s*(PR[S.promo]||0)/100):0,fee=S.sdel==='pick'||s>=8000?0:1500;return s-off+fee};
const pts=()=>S.usePts?Math.min(S.shpts||0,tot()):0;
window.ptsTg=()=>{const sc=document.querySelector('.screen'),t=sc?sc.scrollTop:0;S.usePts=!S.usePts;render('fade-none');const z=document.querySelector('.screen');if(z)z.scrollTop=t};
const _c=screens.scart;
screens.scart=function(){let h=_c.apply(this,arguments);try{
 if(S.ctab&&S.ctab!=='cart'||h.includes('shop-v457')||!scCount())return h;
 const bal=S.shpts||0,u=pts();
 const row=`<div class="pad" style="padding-top:12px"><div style="border-radius:20px;background:var(--chip);padding:14px 16px;display:flex;align-items:center;gap:12px"><div style="flex:1"><b style="font-size:15px">Use points</b><div class="sm mu">${bal?`${fmt(bal)} pts available${S.usePts?' · using '+fmt(u):''}`:'No points yet. Win some in the daily draw'}</div></div><button role="switch" aria-checked="${S.usePts}" aria-label="Use points" ${bal?'':'disabled'} onclick="ptsTg()" style="width:52px;height:32px;border:0;border-radius:16px;background:${S.usePts?'var(--br)':'var(--ln)'};position:relative;opacity:${bal?1:.5}"><span style="position:absolute;top:3px;left:${S.usePts?23:3}px;width:26px;height:26px;border-radius:13px;background:#fff;transition:left .15s"></span></button></div>${S.usePts&&u?`<div style="display:flex;justify-content:space-between;padding:12px 4px 0;font-size:15px"><span class="mu">Points</span><b style="color:var(--ok)">−${fmt(u)} RWF</b></div><div style="display:flex;justify-content:space-between;padding:6px 4px 0;font-size:15px"><span class="mu">You pay</span><b>${fmt(tot()-u)} RWF</b></div>`:''}</div><!--shop-v457-->`;
 const m='<div class="pad" style="padding-top:8px;border-top:0;margin:0 24px',k=h.indexOf(m);
 return k<0?h:h.slice(0,k)+row+h.slice(k)}catch(e){console.error(e);return h}};
const _d=window.shopDone;
window.shopDone=function(){const u=pts(),n=S.orders.length;if(u)S.pay+=u;const r=_d.apply(this,arguments);
 if(S.orders.length>n){if(u){S.shpts-=u;S.orders[0].pts=u}S.usePts=false;const e=Math.round((S.orders[0].t||0)*.01);if(e){S.shpts+=e;S.orders[0].earn=e}}
 else if(u)S.pay-=u;return r};
/* product page: free draw button */
const _p=screens.product;
screens.product=function(){let h=_p.apply(this,arguments);try{
 const m='<button onclick="pAdd(',k=h.indexOf(m);if(k<0||h.includes('pdraw'))return h;
 return h.slice(0,k)+`<button class="pdraw" aria-label="Free draw" onclick="S.drI=S.pi;openDraw()" style="flex:0 0 auto;height:56px;padding:0 14px;border:0;border-radius:18px;background:rgba(49,130,246,.16);color:var(--lk);font-weight:800;font-size:15px">Draw</button>`+h.slice(k)}catch(e){return h}};
/* shopping settings page */
const sw=(on,a,l)=>`<button role="switch" aria-checked="${on}" aria-label="${l}" onclick="${a}" style="width:52px;height:32px;border:0;border-radius:16px;background:${on?'var(--br)':'var(--ln)'};position:relative"><span style="position:absolute;top:3px;left:${on?23:3}px;width:26px;height:26px;border-radius:13px;background:#fff"></span></button>`;
const li=(t,r,a)=>`<div ${a?`onclick="${a}" style="cursor:pointer;`:'style="'}display:flex;align-items:center;gap:12px;padding:20px 4px;min-height:48px"><b style="flex:1;font-size:17px;font-weight:600">${t}</b>${r}</div>`;
screens.shpay=function(){const ad=S.shAd[S.shAi]||S.shAd[0]||['Home','—'];
 return `<div class="top" style="padding:12px 16px 0 8px"><button class="ib" aria-label="Back" onclick="back()">${ic('back',24)}</button></div><div style="padding:18px 24px 0;font-size:26px;font-weight:800;letter-spacing:-.5px">Payment and delivery</div><div style="margin:20px 24px 0;border-radius:24px;background:var(--chip);padding:6px 20px">${li('Shopping points',`<span class="mu">${fmt(S.shpts||0)} pts</span>`,"toast('Use points at checkout in your cart')")}${li('Payment method',`<span class="mu">itunda Pay · ${fmt(S.pay)} RWF</span>`,"toast('itunda Pay is the only method in this prototype')")}${li('Quick pay',`<span class="mu" style="font-size:15px">${S.qpay?'On':'Off'}</span>`+sw(S.qpay,"S.qpay=!S.qpay;render('fade-none');toast('Quick pay '+(S.qpay?'on':'off'))",'Quick pay'))}${li('Delivery address',`<span class="mu" style="font-size:15px;text-align:right;max-width:150px">${ad[0]}</span>`,'shAddr()')}</div><div class="pad fine" style="padding:16px 28px">Quick pay lets you buy with a slide. Addresses are saved on this device only.</div>`};
const _m=screens.myshop;
if(_m)screens.myshop=function(){return _m.apply(this,arguments).replace("toast('Payment and address settings are not in this prototype')","S.stack=['shop','shpay'];render('push')")};
}catch(e){console.error('shop-v457',e)}})();
</script>
<script id="shop-v458">
(()=>{try{
const PR={ITUNDA10:10,KIGALI5:5};
const tot=()=>{const s=scTotal(),off=S.promo?Math.round(s*(PR[S.promo]||0)/100):0,fee=S.sdel==='pick'||s>=8000?0:1500;return s-off+fee};
const hm=()=>{const n=new Date(),e=new Date(n);e.setHours(24,0,0,0);let s=Math.max(0,Math.floor((e-n)/1e3));const p=v=>String(v).padStart(2,'0');return p(Math.floor(s/3600))+':'+p(Math.floor(s%3600/60))+':'+p(s%60)};
/* 1. points can cover a balance shortfall */
const _c=screens.scart;
screens.scart=function(){let h=_c.apply(this,arguments);try{
 if(S.ctab&&S.ctab!=='cart'||!scCount()||!S.usePts)return h;
 const u=Math.min(S.shpts||0,tot());if(u>0&&tot()-u<=S.pay){
  h=h.replace('class="btn" disabled onclick="shopPay()"','class="btn" onclick="shopPay()"').replace(/<div style="color:var\(--er\);font-size:14px;margin-top:10px">Not enough balance[^<]*<\/div>/,'')}
 return h}catch(e){return h}};
/* 2. deal cards: claimed bar + live countdown */
const _s=screens.shop;
screens.shop=function(){let h=_s.apply(this,arguments);try{
 if(S.shopTab==='eats'||S.stab!=='deal')return h;
 let n=0;return h.replace(/(people viewed<\/div>)/g,(m)=>{const x=(41+n*19+(n*n)%13)%55+40;n++;return m+`<div style="height:6px;border-radius:3px;background:var(--chip);margin-top:10px;overflow:hidden"><div style="width:${x}%;height:6px;border-radius:3px;background:#F04452"></div></div><div class="sm" style="margin-top:4px;color:#F04452;font-weight:700">${x}% claimed${x>=85?' · almost gone':''}</div>`})}catch(e){return h}};
setInterval(()=>{try{if(S.stab!=='deal'||!S.stack||S.stack[S.stack.length-1]!=='shop')return;const sc=document.querySelector('.screen');if(!sc)return;const w=document.createTreeWalker(sc,NodeFilter.SHOW_TEXT),L=[];let n;while(n=w.nextNode())if(/\b\d{2}:\d{2}:\d{2}\b/.test(n.nodeValue))L.push(n);const p=v=>String(v).padStart(2,'0');L.forEach(n=>{n.nodeValue=n.nodeValue.replace(/\b(\d{2}):(\d{2}):(\d{2})\b/,(m,h,mi,s)=>{let t=Math.max(0,+h*3600+ +mi*60+ +s-1);return p(Math.floor(t/3600))+':'+p(Math.floor(t%3600/60))+':'+p(t%60)})})}catch(e){}},1000);
/* 3. price history in compare panel */
const _p=screens.product;
screens.product=function(){let h=_p.apply(this,arguments);try{
 const i=S.pi,x=PRODS[i],m='<div class="sm mu" style="padding:0 0 12px">Sample prices from other shops.</div>',k=h.indexOf(m);
 if(!x||k<0||h.includes('phist'))return h;
 let sd=(i+3)*7919,r=()=>(sd=(sd*9301+49297)%233280)/233280;
 const base=x.o||Math.round(x.p*1.12/100)*100,N=30,a=[];for(let j=0;j<N-1;j++)a.push(Math.round((x.p+(base-x.p)*(.15+.85*r()))/100)*100);a.push(x.p);
 const mn=Math.min(...a,x.p),mx=Math.max(...a),lo=x.p<=mn;
 const bars=a.map((v,j)=>{const hh=14+(v-mn)/Math.max(1,mx-mn)*46;return `<rect x="${j*10.6}" y="${70-hh}" width="7" height="${hh}" rx="2" fill="${j===N-1?'#F04452':v===mn?'var(--lk)':'var(--tt)'}" fill-opacity="${j===N-1||v===mn?1:.45}"/>`}).join('');
 const box=`<div class="phist" style="padding:4px 0 14px;border-top:1px solid var(--ln);margin-top:4px"><div style="display:flex;justify-content:space-between;align-items:baseline;padding-top:12px"><b style="font-size:15px">30-day price</b>${lo?'<span class="sm" style="color:#F04452;font-weight:800">Lowest in 30 days</span>':`<span class="sm mu">${Math.round((x.p-mn)/mn*100)}% above the low</span>`}</div><svg viewBox="0 0 318 74" role="img" aria-label="Price over the last 30 days, lowest ${fmt(mn)} RWF, highest ${fmt(mx)} RWF" style="width:100%;height:auto;margin-top:8px">${bars}</svg><div style="display:flex;justify-content:space-between" class="sm mu"><span>30 days ago</span><span>Today</span></div><div style="display:flex;gap:16px;margin-top:8px;font-size:14px"><span><span class="mu">Low</span> <b>${fmt(mn)}</b></span><span><span class="mu">High</span> <b>${fmt(mx)}</b></span><span><span class="mu">Now</span> <b>${fmt(x.p)}</b></span></div></div>`;
 return h.slice(0,k)+box+h.slice(k)}catch(e){return h}};
}catch(e){console.error('shop-v458',e)}})();
</script>
<script id="shop-v459">
(()=>{try{
S.rvHelp=S.rvHelp||{};S.rvSort=S.rvSort||'new';S.rvPh=!!S.rvPh;
const TINT=['#D5ECF6','#FDECEF','#FFF3DA','#E6F6EC'];
const REV=[['K*m',5,'Arrived on time and well packed. Will order again.','Yesterday',1,12],['S*n',4,'Good value for the price. Quality is as described.','3 days ago',0,3],['J*a',5,'Bought it for the family and everyone liked it.','1 week ago',1,7],['A*e',5,'Fast delivery and the seller answered my questions.','2 weeks ago',0,1],['M*i',4,'Nice, but the box was a little dented.','3 weeks ago',0,0]];
const rt=i=>(4.2+((i*7)%8)/10).toFixed(1),rcn=i=>6+(i*37)%260;
const keep=fn=>{const sc=document.querySelector('.screen'),t=sc?sc.scrollTop:0;fn();render('fade-none');const z=document.querySelector('.screen');if(z)z.scrollTop=t};
window.rvS=k=>keep(()=>{S.rvSort=k});
window.rvP=()=>keep(()=>{S.rvPh=!S.rvPh});
window.rvH=k=>keep(()=>{S.rvHelp[k]=!S.rvHelp[k]});
const st=n=>`<span style="color:#F5A524">${'★'.repeat(n)}</span><span style="color:var(--ln)">${'★'.repeat(5-n)}</span>`;
const _p=screens.product;
screens.product=function(){let h=_p.apply(this,arguments);try{
 const i=S.pi,x=PRODS[i];if(!x||(S.ptab||'reviews')!=='reviews'||h.includes('rvx9'))return h;
 const a=h.indexOf('<div style="padding:20px 24px 0"><div class="mu" style="font-size:14px">Reviews from all shops'),b=h.indexOf('<div onclick="S.pinf=');
 if(a<0||b<a)return h;
 const rc=rcn(i),av=+rt(i);
 /* star distribution that averages near the rating */
 let w=[1,2,6,26,65].map((v,k)=>v*Math.exp((av-4.4)*(k-2)*.9));const sw=w.reduce((p,q)=>p+q,0);w=w.map(v=>Math.round(v/sw*100));
 const urev=(S.urev[i]||[]).map((r,j)=>({n:'You',s:r.s,t:r.t,d:'Just now',p:!!r.img,img:r.img,h:0,k:'u'+j,mine:1}));
 let L=[...urev,...REV.map((r,j)=>({n:r[0],s:r[1],t:r[2],d:r[3],p:!!r[4],h:r[5],k:i+':'+j}))];
 const nph=L.filter(r=>r.p).length;
 if(S.rvPh)L=L.filter(r=>r.p);
 if(S.rvSort==='help')L=[...L].sort((p,q)=>(q.h+(S.rvHelp[q.k]?1:0))-(p.h+(S.rvHelp[p.k]?1:0)));
 const all=S.prvAll===i,shown=all?L:L.slice(0,3);
 const bars=[5,4,3,2,1].map((s,k)=>`<div style="display:flex;align-items:center;gap:10px;height:22px;font-size:13px"><span style="flex:0 0 14px" class="mu">${s}</span><div style="flex:1;height:8px;border-radius:4px;background:var(--chip);overflow:hidden"><div style="width:${w[4-k]}%;height:8px;background:#F5A524"></div></div><span style="flex:0 0 36px;text-align:right" class="mu">${w[4-k]}%</span></div>`).join('');
 const head=`<div class="rvx9" style="padding:20px 24px 0"><div class="mu" style="font-size:14px">Reviews from all shops</div><div style="display:flex;gap:20px;align-items:center;margin-top:8px"><div><div style="font-size:44px;font-weight:800;letter-spacing:-1px;line-height:48px">${rt(i)}</div><div>${st(Math.round(av))}</div><div class="sm mu">${rc} reviews</div></div><div style="flex:1">${bars}</div></div></div>`;
 const ph=L0=>`<div style="padding:18px 24px 0"><b style="font-size:16px">Photo reviews</b> <span class="mu">${nph}</span><div style="display:flex;gap:8px;overflow-x:auto;scrollbar-width:none;margin-top:10px">${[...urev,...REV.map((r,j)=>({p:!!r[4],j}))].filter(r=>r.p).map((r,k)=>r.img?`<img src="${r.img}" alt="Your photo" style="flex:0 0 84px;height:84px;border-radius:14px;object-fit:cover">`:`<div style="flex:0 0 84px;height:84px;border-radius:14px;background:${TINT[(i+k)%4]};display:flex;align-items:center;justify-content:center">${gl(x.g,44)}</div>`).join('')}</div></div>`;
 const chip=(on,a,l)=>`<button onclick="${a}" aria-pressed="${on}" style="flex:none;height:38px;padding:0 16px;border:0;border-radius:19px;font-weight:700;font-size:14px;background:${on?'var(--tx)':'var(--chip)'};color:${on?'var(--bg)':'var(--tx)'}">${l}</button>`;
 const chips=`<div style="display:flex;gap:8px;overflow-x:auto;scrollbar-width:none;padding:18px 24px 0">${chip(S.rvSort==='new','rvS(\'new\')','Latest')}${chip(S.rvSort==='help','rvS(\'help\')','Most helpful')}${chip(S.rvPh,'rvP()','Photo only')}</div>`;
 const item=r=>{const on=!!S.rvHelp[r.k];return `<div style="padding:20px 0;border-bottom:1px solid var(--ln)"><div>${st(r.s)} <b style="margin-left:6px">${r.n}</b> <span class="mu" style="font-size:14px">${r.d}</span></div><div class="mu" style="font-size:14px;margin-top:6px">${x.n} · Seller: ${x.m}</div><div style="display:flex;gap:12px;margin-top:10px">${r.p?(r.img?`<img src="${r.img}" alt="Your photo" style="flex:0 0 84px;height:84px;border-radius:14px;object-fit:cover">`:`<div style="flex:0 0 84px;height:84px;border-radius:14px;background:${TINT[i%4]};display:flex;align-items:center;justify-content:center">${gl(x.g,44)}</div>`):''}<div style="font-size:16px;line-height:23px">${r.t.replace(/</g,'&lt;')}</div></div>${r.mine?'':`<div style="display:flex;justify-content:flex-end;align-items:center;gap:10px;margin-top:10px"><span class="mu" style="font-size:14px">Helpful${r.h+(on?1:0)?' · '+(r.h+(on?1:0)):''}</span><button aria-pressed="${on}" aria-label="Mark helpful" onclick="rvH('${r.k}')" style="width:44px;height:40px;border:0;border-radius:12px;background:${on?'var(--br)':'var(--chip)'};color:${on?'var(--on)':'var(--mu)'};font-size:18px">👍</button></div>`}</div>`};
 const list=`<div style="padding:0 24px">${shown.map(item).join('')||'<div class="mu" style="padding:30px 0;text-align:center">No reviews match this filter.</div>'}</div>`;
 const more=!all&&L.length>3?`<button onclick="pRvAll(${i})" style="display:block;width:calc(100% - 48px);margin:16px 24px 0;height:56px;border:0;border-radius:18px;background:var(--chip);color:var(--tx);font-weight:800;font-size:16px">See all reviews (${rc}) ›</button>`:'';
 return h.slice(0,a)+head+ph()+chips+list+more+h.slice(b)}catch(e){console.error(e);return h}};
}catch(e){console.error('shop-v459',e)}})();
</script>
<script id="shop-v460">
(()=>{try{
S.follow=S.follow||{};
const rt=i=>(4.2+((i*7)%8)/10).toFixed(1),rcn=i=>6+(i*37)%260;
const TINT=['#D5ECF6','#FDECEF','#FFF3DA','#E6F6EC'];
const keep=fn=>{const sc=document.querySelector('.screen'),t=sc?sc.scrollTop:0;fn();render('fade-none');const z=document.querySelector('.screen');if(z)z.scrollTop=t};
window.openSeller=m=>{S.sel=m||PRODS[S.pi].m;S.stack=[...S.stack.filter(s=>s!=='seller'),'seller'];render('push')};
window.flwTg=m=>keep(()=>{S.follow[m]=!S.follow[m];toast(S.follow[m]?'Following '+m:'Unfollowed')});
window.sAdd=i=>{if(PRODS[i].s-(S.scart[i]||0)<=0){toast('No more in stock');return}S.scart[i]=(S.scart[i]||0)+1;keep(()=>{});toast('Added to cart')};
const card=i=>{const p=PRODS[i],d=pct(p.p,p.o);return `<div style="min-width:0"><div class="pim tap" onclick="openProd(${i})" style="border-radius:20px;position:relative;cursor:pointer">${gl(p.g,58)}${d?`<span style="position:absolute;left:8px;top:8px;background:#F04452;color:#fff;font-size:12px;font-weight:800;border-radius:8px;padding:3px 7px">${d}% off</span>`:''}<button aria-label="Add to cart" onclick="event.stopPropagation();sAdd(${i})" style="position:absolute;right:8px;bottom:8px;width:38px;height:38px;border:0;border-radius:19px;background:rgba(255,255,255,.85);color:#191F28;display:flex;align-items:center;justify-content:center">${ic('bag',20)}</button></div><div style="font-size:14px;line-height:20px;margin-top:8px">${p.n}</div><div style="font-size:17px;font-weight:800">${d?`<span style="font-size:14px;color:#F04452">${d}%</span> `:''}${fmt(p.p)} RWF</div><div class="sm"><span style="color:#F5A524">★</span> ${rt(i)} (${rcn(i)})</div></div>`};
screens.seller=function(){const m=S.sel||PRODS[S.pi||0].m,mine=PRODS.map((p,i)=>i).filter(i=>PRODS[i].m===m),oth=PRODS.map((p,i)=>i).filter(i=>PRODS[i].m!==m&&mine.some(k=>PRODS[k].c===PRODS[i].c)).slice(0,4);
 const av=mine.length?(mine.reduce((a,i)=>a+ +rt(i),0)/mine.length).toFixed(1):'—',rc=mine.reduce((a,i)=>a+rcn(i),0),f=!!S.follow[m],fc=120+m.length*37+(f?1:0);
 const cats=[...new Set(mine.map(i=>PRODS[i].c))].join(' · ');
 return `<div style="height:150px;background:linear-gradient(135deg,${TINT[m.length%4]},${TINT[(m.length+2)%4]});position:relative"><button class="ib" aria-label="Back" onclick="back()" style="position:absolute;left:8px;top:12px;background:var(--bg);border-radius:22px">${ic('back',24)}</button><button class="ib" aria-label="Cart" onclick="openCart()" style="position:absolute;right:12px;top:12px;background:var(--bg);border-radius:22px">${ic('bag',24)}</button></div>
 <div style="margin-top:-34px;padding:0 24px;position:relative"><div style="width:68px;height:68px;border-radius:22px;background:var(--bg);border:3px solid var(--bg);display:flex;align-items:center;justify-content:center;box-shadow:0 2px 10px rgba(0,0,0,.12)">${gl(PRODS[mine[0]||0].g,40)}</div>
 <div style="display:flex;align-items:center;gap:12px;margin-top:12px"><div style="flex:1;min-width:0"><div style="font-size:24px;font-weight:800;letter-spacing:-.5px;line-height:30px">${m}</div><div style="margin-top:6px"><span style="display:inline-block;font-size:12px;font-weight:700;padding:4px 8px;border-radius:8px;background:var(--chip)">Official</span> <span style="display:inline-block;font-size:12px;font-weight:700;padding:4px 8px;border-radius:8px;background:var(--chip)">Best seller</span></div></div><button aria-pressed="${f}" onclick="flwTg('${m.replace(/'/g,"\\'")}')" style="height:44px;padding:0 20px;border:0;border-radius:14px;font-weight:800;font-size:15px;background:${f?'var(--chip)':'var(--br)'};color:${f?'var(--tx)':'var(--on)'}">${f?'Following':'Follow'}</button></div>
 <div style="display:flex;margin-top:18px;border-radius:20px;background:var(--chip);padding:14px 0;text-align:center">${[[av+' ★','Rating'],[fmt(rc),'Reviews'],[fmt(fc),'Followers'],[mine.length,'Products']].map(([a,b])=>`<div style="flex:1"><b style="font-size:17px">${a}</b><div class="sm mu">${b}</div></div>`).join('')}</div>
 <div class="sm mu" style="margin-top:12px;line-height:20px">${cats?cats+' · ':''}Ships from Kigali · Replies within a day</div></div>
 <div style="padding:26px 24px 12px"><b style="font-size:19px">Products</b> <span class="mu">${mine.length}</span></div><div style="display:grid;grid-template-columns:1fr 1fr;gap:22px 12px;padding:0 24px">${mine.map(card).join('')}</div>
 ${oth.length?`<div style="padding:30px 24px 12px"><b style="font-size:19px">Similar items from other shops</b></div><div style="display:grid;grid-template-columns:1fr 1fr;gap:22px 12px;padding:0 24px">${oth.map(card).join('')}</div>`:''}
 <div class="pad fine" style="padding:22px 24px 40px">Shops, ratings and followers are sample data.</div>`};
/* similar products sheet */
window.simSheet=()=>{const i=S.pi,x=PRODS[i],l=PRODS.map((p,k)=>k).filter(k=>k!==i).sort((a,b)=>(PRODS[a].c===x.c?0:1)-(PRODS[b].c===x.c?0:1)||Math.abs(PRODS[a].p-x.p)-Math.abs(PRODS[b].p-x.p)).slice(0,6);
 $('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" role="dialog" aria-modal="true" aria-label="Similar products" style="max-height:82%;overflow-y:auto"><div style="width:44px;height:5px;border-radius:3px;background:var(--ln);margin:0 auto 14px"></div><b style="font-size:20px">Similar products</b><div class="sm mu" style="margin-top:4px">Close in price or category to ${x.n}</div><div style="display:grid;grid-template-columns:1fr 1fr;gap:20px 12px;margin-top:16px">${l.map(k=>{const p=PRODS[k],d=pct(p.p,p.o);return `<div class="tap" onclick="closeSheet();openProd(${k})" style="cursor:pointer"><div class="pim" style="border-radius:18px;aspect-ratio:1/1">${gl(p.g,52)}</div><div style="font-size:14px;line-height:19px;margin-top:6px">${p.n}</div><b style="font-size:16px">${d?`<span style="font-size:13px;color:#F04452">${d}%</span> `:''}${fmt(p.p)} RWF</b></div>`}).join('')}</div></div>`};
const _p=screens.product;
screens.product=function(){let h=_p.apply(this,arguments);try{
 h=h.split("toast('Shop pages are not in this prototype')").join("openSeller()");
 const k=h.indexOf('<span id="pgc"');
 if(k>=0&&!h.includes('simchip')){const x=PRODS[S.pi],th=PRODS.map((p,j)=>j).filter(j=>j!==S.pi).slice(0,2);
  h=h.slice(0,k)+`<button class="simchip" onclick="simSheet()" aria-label="Similar products" style="position:absolute;left:12px;bottom:12px;height:40px;padding:0 14px 0 8px;border:0;border-radius:12px;background:rgba(255,255,255,.9);color:#191F28;font-weight:700;font-size:15px;display:flex;align-items:center;gap:6px"><span style="display:flex">${th.map(j=>`<i style="width:24px;height:24px;border-radius:6px;background:${TINT[j%4]};display:flex;align-items:center;justify-content:center;margin-right:-4px">${gl(PRODS[j].g,16)}</i>`).join('')}</span>&nbsp;Similar</button>`+h.slice(k)}
 return h}catch(e){return h}};
}catch(e){console.error('shop-v460',e)}})();
</script>
<script id="shop-v461">
(()=>{try{
const dy=n=>new Date(Date.now()+n*864e5).toLocaleDateString('en',{weekday:'short',month:'short',day:'numeric'});
const eta=i=>i%3===0?'Today if ordered within 3 hours':i%3===1?'Tomorrow, '+dy(1):dy(2);
const TB=[['delivery','Delivery'],['returns','Returns'],['product','Product'],['seller','Seller']];
const kv=(a)=>a.map(([k,v])=>`<div style="display:flex;gap:12px;padding:12px 0;border-bottom:1px solid var(--ln);font-size:15px;line-height:21px"><span class="mu" style="flex:0 0 104px">${k}</span><span style="flex:1">${v}</span></div>`).join('');
const body=(t,i)=>{const x=PRODS[i],ad=(S.shAd&&(S.shAd[S.shAi]||S.shAd[0]))||['Home','KG 11 Ave, Kimironko'],fr=x.p>=8000;
 if(t==='delivery')return kv([['Arrives',eta(i)],['Courier','itunda rider, Kigali'],['Shipping',fr?'Free':'1,500 RWF · free over 8,000 RWF'],['Deliver to',ad[0]+', '+ad[1]],['Pickup','Free at Kimironko pickup point, ready next day'],['Tracking','Live status in My shop orders']]);
 if(t==='returns')return kv([['Window','7 days after delivery'],['Condition','Unopened and unused'],['Refund','To itunda Pay, usually within 1 day'],['Return fee','Free for wrong or damaged items. 1,500 RWF if you change your mind'],['How','My shop orders › Return']])+`<div class="sm mu" style="padding-top:12px">Fresh food and opened items can’t be returned.</div>`;
 if(t==='product')return kv([['Product',x.n],['Category',x.c],['Stock',x.s<=0?'Sold out':x.s<=5?x.s+' left':'In stock'],['Origin','See pack'],['Storage','Cool, dry place'],['Item code','IT-'+(1000+i*37)]]);
 return kv([['Shop',x.m],['Status','Official · Best seller'],['Location','Kigali, Rwanda'],['Replies','Within a day'],['Contact','Chat opens after you order']])+`<button onclick="closeSheet();openSeller()" style="margin-top:14px;width:100%;height:52px;border:0;border-radius:16px;background:var(--chip);color:var(--tx);font-weight:800;font-size:16px">Visit shop ›</button>`};
window.infoSheet=t=>{S.infT=t&&t!=='all'?t:(S.infT||'delivery');if(t==='all')S.infT='delivery';const i=S.pi;
 $('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" role="dialog" aria-modal="true" aria-label="Delivery, returns, product, seller info" style="max-height:84%;overflow-y:auto;padding-top:14px"><div style="width:44px;height:5px;border-radius:3px;background:var(--ln);margin:0 auto 12px"></div><div role="tablist" style="display:flex;border-bottom:1px solid var(--ln)">${TB.map(([k,l])=>`<button role="tab" aria-selected="${S.infT===k}" onclick="infoSheet('${k}')" style="flex:1;height:48px;border:0;background:none;font-size:16px;font-weight:${S.infT===k?800:600};color:${S.infT===k?'var(--tx)':'var(--mu)'};border-bottom:3px solid ${S.infT===k?'var(--tx)':'transparent'};margin-bottom:-1px">${l}</button>`).join('')}</div><div style="padding-top:4px">${body(S.infT,i)}</div></div>`};
const RS=['Asks for payment outside itunda','Asks for cash or personal details','Wrong product information','Looks like a fake or copy','Something else'];
window.reportSheet=()=>{S.rpt=null;rptDraw()};
window.rptPick=k=>{S.rpt=k;rptDraw()};
window.rptSend=()=>{if(S.rpt==null)return;closeSheet();toast('Thanks. We will review this listing');S.rpt=null};
window.rptDraw=()=>{$('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet" role="dialog" aria-modal="true" aria-label="Report" style="padding-top:14px"><div style="width:44px;height:5px;border-radius:3px;background:var(--ln);margin:0 auto 14px"></div><b style="font-size:20px">Report this listing</b><div class="sm mu" style="margin-top:4px">Never pay outside itunda or share personal details.</div><div role="radiogroup" style="margin-top:14px">${RS.map((r,k)=>`<button role="radio" aria-checked="${S.rpt===k}" onclick="rptPick(${k})" style="display:flex;align-items:center;gap:12px;width:100%;text-align:left;border:0;background:none;padding:14px 2px;font-size:16px;color:var(--tx)"><span style="flex:0 0 24px;height:24px;border-radius:12px;border:2px solid ${S.rpt===k?'var(--lk)':'var(--ln)'};display:flex;align-items:center;justify-content:center"><i style="width:12px;height:12px;border-radius:6px;background:${S.rpt===k?'var(--lk)':'transparent'}"></i></span>${r}</button>`).join('')}</div><button class="btn" style="margin-top:12px" ${S.rpt==null?'disabled':''} onclick="rptSend()">Send report</button></div>`};
const _p=screens.product;
screens.product=function(){let h=_p.apply(this,arguments);try{
 h=h.replace(`<div onclick="S.pinf=!S.pinf;render('fade-none')"`,`<div role="button" tabindex="0" onclick="infoSheet('all')"`)
  .split("toast('Delivery to Kimironko, KG 11 Ave')").join("infoSheet('delivery')")
  .replace('<div style="margin:18px 24px 0;border-radius:16px;background:var(--chip);padding:16px;font-size:14px;line-height:21px;color:var(--mu)">If a seller','<div role="button" tabindex="0" onclick="reportSheet()" style="cursor:pointer;margin:18px 24px 0;border-radius:16px;background:var(--chip);padding:16px;font-size:14px;line-height:21px;color:var(--mu)">If a seller');
 return h}catch(e){return h}};
}catch(e){console.error('shop-v461',e)}})();
</script>
<script id="shop-v462">
(()=>{try{
const _p=screens.product;
screens.product=function(){let h=_p.apply(this,arguments);try{
 if(h.includes('pbar2'))return h;
 h=h.replace(/<button class="pdraw"[\s\S]*?<\/button>/,'')
  .replace(/<button onclick="pAdd\((\d+),1\)"[^>]*>Add to cart<\/button>/,(m,i)=>`<button class="pbar2" aria-label="Add to cart" onclick="pAdd(${i},1)" style="flex:0 0 56px;width:56px;height:56px;border:0;border-radius:18px;background:var(--chip);color:var(--tx);display:flex;align-items:center;justify-content:center">${ic('bag',24)}</button>`)
  .replace(/(<button onclick="buySheet\(\d+\)" style="flex:1;)/,'$1');
 const d='<div style="height:12px;background:var(--chip);margin-top:12px"></div>',k=h.indexOf(d);
 if(k>=0)h=h.slice(0,k)+`<div style="padding:0 24px"><button onclick="S.drI=S.pi;openDraw()" style="display:flex;align-items:center;gap:16px;width:100%;border:0;background:none;padding:12px 0;text-align:left;color:var(--tx);font-size:16px"><span class="mu" style="flex:0 0 64px;font-size:15px">Draw</span><span style="flex:1"><span style="color:var(--lk);font-weight:700">Win 500 points</span> in the free daily draw</span>${ic('chev',16,'var(--tt)')}</button></div>`+h.slice(k);
 return h}catch(e){return h}};
}catch(e){console.error('shop-v462',e)}})();
</script>
<script id="shop-v463">
(()=>{try{
S.bpts=!!S.bpts;
const _b=window.buySheet;
window.buySheet=function(i){_b.apply(this,arguments);try{
 const L=document.getElementById('layer'),s=L&&L.querySelector('.sheet');if(!s)return;
 const x=PRODS[i],q=S.bq7||1,ship=x.p>=8000?0:1500,tot=x.p*q+ship,u=S.bpts?Math.min(S.shpts||0,tot):0;
 /* modal instead of bottom sheet */
 s.setAttribute('aria-label','Buy now');
 s.style.cssText='position:absolute;left:20px;right:20px;top:0;bottom:0;margin:auto;height:fit-content;transform:none;border-radius:28px;padding:30px 20px 20px;max-height:90%;overflow-y:auto;animation:none;box-shadow:0 0 0 2000px rgba(0,0,0,.5)';
 const bg=L.querySelector('.sheetbg');if(bg){bg.style.setProperty('background','rgba(0,0,0,.55)','important');bg.style.setProperty('opacity','1','important')}
 const hdl=s.firstElementChild;if(hdl&&hdl.style.height==='5px')hdl.remove();const fx=()=>{const h6=s.querySelector('.v6h');if(h6)h6.style.display='none'};fx();setTimeout(fx,80);setTimeout(fx,350);
 s.insertAdjacentHTML('afterbegin','<div style="font-size:13px;font-weight:700;color:var(--mu);margin-bottom:10px">Quick order</div>');
 s.insertAdjacentHTML('beforeend','<button aria-label="Dismiss" onclick="closeSheet()" style="position:absolute;right:10px;top:10px;width:36px;height:36px;border:0;border-radius:18px;background:var(--chip);color:var(--tx);font-size:16px;z-index:2">✕</button>');
 /* real points row */
 [...s.querySelectorAll('b')].filter(b=>b.textContent==='Points').forEach(b=>{const r=b.parentElement,d=r.querySelector('div'),bal=S.shpts||0;
  r.setAttribute('role','button');r.setAttribute('tabindex','0');r.style.cursor=bal?'pointer':'default';
  if(bal)r.onclick=()=>{S.bpts=!S.bpts;buySheet(i)};
  if(d)d.textContent=!bal?'No points yet':S.bpts?fmt(u)+' RWF used · tap to turn off':'0 RWF used · '+fmt(bal)+' pts available'});
 const pay=s.querySelector('.mu[style*="margin-top:12px"]');
 if(u&&pay)pay.textContent='You pay '+fmt(tot-u)+' RWF after points'
}catch(e){console.error(e)}};
const _n=window.payNow7;
window.payNow7=function(i){const x=PRODS[i],q=S.bq7||1,tot=x.p*q+(x.p>=8000?0:1500),u=S.bpts?Math.min(S.shpts||0,tot):0;
 if(u)S.pay+=u;const n=S.orders.length;_n.apply(this,arguments);
 if(S.orders.length>n){if(u){S.shpts-=u;S.orders[0].pts=u}S.bpts=false}else if(u)S.pay-=u};
}catch(e){console.error('shop-v463',e)}})();
</script>
<style id="modal-v464">
/* v464: Toss-style floating sheet: inset from the edges, fully rounded, grab handle, grouped rows with chevrons, pill slide button */
#phone .sheet:not(.bs464){left:12px;right:12px;bottom:12px;border-radius:32px}
#phone .sheetbg{background:rgba(0,0,0,.55)}
#phone .sheet.bs464{left:12px;right:12px;bottom:12px;border-radius:32px;padding:14px 16px 18px;max-height:calc(100% - 24px);overflow-y:auto;scrollbar-width:none}
#phone .sheet.bs464::-webkit-scrollbar{display:none}
#phone .sheet.bs464::before{display:none}
.bs464 .bsh{width:44px;height:5px;border-radius:3px;background:var(--ln);margin:0 auto 20px}
.bs464 .bsp{display:flex;justify-content:space-between;align-items:center;padding:0 4px}
.bs464 .bsp b.pr{font-size:30px;letter-spacing:-.8px;color:var(--lk)}
.bs464 .bsq{display:flex;align-items:center;background:var(--chip);border-radius:16px;padding:4px}
.bs464 .bsq button{width:36px;height:40px;border:0;background:none;font-size:22px;color:var(--mu)}
.bs464 .bsq b{min-width:44px;height:40px;border-radius:12px;background:var(--bg);display:flex;align-items:center;justify-content:center;font-size:18px}
.bs464 .bsn{margin:10px 4px 0;font-size:15px;color:var(--mu)}
.bs464 .bsc{margin-top:14px;border-radius:26px;background:var(--chip);padding:6px 20px}
.bs464 .bsr{display:flex;align-items:center;gap:10px;width:100%;border:0;background:none;text-align:left;padding:13px 0;color:var(--tx);cursor:default}
.bs464 .bsr[role=button]{cursor:pointer}
.bs464 .bsr .tt{flex:1;min-width:0}
.bs464 .bsr b{font-size:17px}
.bs464 .bsr .m{color:var(--mu);font-size:15px;margin-top:3px;line-height:21px}
.bs464 .bsr .m.i{margin:0 0 0 8px;display:inline;font-size:17px}
.bs464 .bsr svg{flex:none}
.bs464 .bsb{gap:0;margin-top:10px;border-radius:22px;background:var(--chip);padding:14px 20px;font-size:16px;font-weight:700;display:flex;align-items:center;gap:10px}
.bs464 .bsb em{margin:0 4px;font-style:normal;color:var(--lk)}
.bs464 .bsb.er{color:var(--er)}
.bs464 #sl7{margin-top:14px!important}
.bs464 button:focus-visible,.bs464 .bsr:focus-visible{outline:none}
.bs464 .bsf{text-align:center;margin-top:14px;font-size:14px;color:var(--mu)}
</style>
<script id="modal-v464js">
(()=>{try{
const dy=n=>new Date(Date.now()+n*864e5).toLocaleDateString('en',{weekday:'short',month:'short',day:'numeric'});
const eta=i=>i%3===0?'Arrives today':i%3===1?'Arrives tomorrow, '+dy(1):'Arrives '+dy(2);
const ern=p=>Math.round(p.p*.07/10)*10;
const CH=ic('chev',18,'var(--tt)');
window.buySheet=function(i){
 S.bq7=S.bq7||1;if(S.bq7n!==i){S.bq7=1;S.bq7n=i}
 const x=PRODS[i],q=S.bq7,ship=x.p>=8000?0:1500,tot=x.p*q+ship,bal=S.shpts||0,u=S.bpts?Math.min(bal,tot):0,due=tot-u,bad=due>S.pay;
 const ptsM=!bal?'No points yet':S.bpts?fmt(u)+' RWF used':'0 RWF used';
 $('#layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet bs464" role="dialog" aria-modal="true" aria-label="Buy now"><div class="bsh"></div>
 <div class="bsp"><div><b class="pr">${fmt(x.p*q)} RWF</b> </div><div class="bsq"><button aria-label="Less" onclick="bqSet7(${i},-1)">−</button><b>${q}</b><button aria-label="More" onclick="bqSet7(${i},1)">+</button></div></div>
 <div class="bsn">${x.n} · ${ship?'Shipping '+fmt(ship):'Free shipping'}</div>
 <div class="bsc">
  <div class="bsr"><div class="tt"><b>${eta(i)} · Home</b><div class="m">Kimironko, KG 11 Ave, Kigali</div></div>${CH}</div>
  <div class="bsr"><div class="tt"><b>itunda Pay</b><span class="m i">${fmt(S.pay)} RWF</span></div>${CH}</div>
  <div class="bsr" id="bsPts" ${bal?'role="button" tabindex="0"':''}><div class="tt"><b>Points</b><span class="m i">${ptsM}</span></div>${CH}</div>
 </div>
 ${bad?`<div class="bsb er">Not enough balance. Add money first.</div>`:`<div class="bsb">${u?`You pay <em>${fmt(due)} RWF</em> after points`:`Earn up to <em>${fmt(ern(x)*q)} RWF</em> back`}</div>`}
 <div id="sl7" style="position:relative;height:60px;border-radius:30px;background:${bad?'var(--chip)':'var(--br)'};overflow:hidden;touch-action:none;user-select:none"><div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:17px;color:${bad?'var(--tt)':'var(--on)'}">Slide to pay</div><div id="kn7" style="position:absolute;left:6px;top:6px;width:48px;height:48px;border-radius:24px;background:#fff;display:flex;align-items:center;justify-content:center;color:#191F28">${ic('chev',22)}</div></div>
 <div class="bsf">I have checked my order</div></div>`;
 const pr=document.getElementById('bsPts');if(pr&&bal)pr.onclick=()=>{S.bpts=!S.bpts;buySheet(i)};
 const tr=document.getElementById('sl7'),kn=document.getElementById('kn7');if(!tr||bad)return;
 let d=false,sx=0,mx=0;const pos=e=>(e.touches?e.touches[0].clientX:e.clientX);
 const mv=e=>{if(!d)return;mx=Math.max(0,Math.min(tr.clientWidth-60,pos(e)-sx));kn.style.left=(6+mx)+'px'};
 const up=()=>{if(!d)return;d=false;document.removeEventListener('mousemove',mv);document.removeEventListener('mouseup',up);document.removeEventListener('touchmove',mv);document.removeEventListener('touchend',up);if(mx>tr.clientWidth-80)payNow7(i);else{kn.style.transition='left .2s';kn.style.left='6px';setTimeout(()=>kn.style.transition='',220)}};
 const dn=e=>{d=true;sx=pos(e);mx=0;document.addEventListener('mousemove',mv);document.addEventListener('mouseup',up);document.addEventListener('touchmove',mv,{passive:true});document.addEventListener('touchend',up)};
 kn.addEventListener('mousedown',dn);kn.addEventListener('touchstart',dn,{passive:true});
};
}catch(e){console.error('modal-v464',e)}})();
</script>
<script>
/* v474: Places hub. (1) The Browse and My places tiles were invisible because a global rule hides every .mcs row; Browse is now a single row of chips and My places is three plain rows with counts. (2) "Popular near you" listed places 9 km away; it now shows the four nearest places by distance (bus stops and ATMs stay under their own categories). (3) Stamp cards and Recent only appear when there is something to show; Recent no longer lists street addresses. (4) The Directions travel-mode tiles had the same hidden-row bug and are visible again. */
try{(()=>{
const L=(e,r,f)=>({en:e,rw:r,fr:f}[S.lang]||e),M=S.mp,P=()=>window.POI||[];
const st=document.createElement('style');
st.textContent='#phone .screen .mcs.keep{display:flex!important}#phone .screen .plc{display:flex;gap:10px;overflow-x:auto;padding:14px 16px 4px;scrollbar-width:none}#phone .screen .plc::-webkit-scrollbar{display:none}#phone .screen .plc button{flex:none;height:44px;border:0;border-radius:22px;background:var(--chip);color:var(--tx);font:inherit;font-weight:700;font-size:15px;padding:0 16px;display:flex;align-items:center;gap:8px}#phone .screen .plc button:active{opacity:.7}';
document.head.appendChild(st);
const sec=t=>`<div class="mt2" style="padding-top:26px">${t}</div>`;
const km=p=>parseFloat(p.d)||99;
const svd=p=>p.id==='cafe'?!!M.star:!!(M.sv&&M.sv[p.id]);
const prow=p=>`<div class="pl tap" onclick="mpOpenPoi('${p.id}')"><i style="font-style:normal;font-size:20px">${p.e}</i><div style="flex:1;min-width:0"><b style="display:block;font-size:17px;font-weight:600">${p.n}</b><span>${p.k}${p.r?' · ★ '+p.r.split(' ')[0]:''} · ${p.d}</span></div></div>`;
const cnt=(e,l,on,n)=>`<div class="pl tap" onclick="${on}"><i style="font-style:normal;font-size:20px">${e}</i><b>${l}</b><span>${n||''}</span></div>`;
screens.placehub=()=>{
 const near=P().filter(p=>p.c!=='bus'&&p.c!=='atm').sort((a,b)=>km(a)-km(b)).slice(0,4),
  sv=P().filter(svd).length,
  rv=Object.values(M.myrev||{}).reduce((a,x)=>a+x.length,0),
  stk=Object.entries(M.st||{}).filter(x=>x[1]>0),
  rec=(M.rec||[]).filter(r=>P().some(p=>p.n===r[0])).slice(0,3),
  cats=[['🗺️',L('Map','Ikarita','Carte'),'map'],['☕',L('Cafe','Ikawa','Café'),'cafe'],['🍽️',L('Food','Ibiryo','Repas'),'food'],['🏥',L('Hospital','Ibitaro','Hôpital'),'hosp'],['💊',L('Pharmacy','Farumasi','Pharmacie'),'pharm'],['🏧','ATM','atm'],['🚌',L('Bus stops','Bisi','Arrêts'),'bus']];
 return `${bar(L('Places','Ahantu','Lieux'))}
<div class="mps tap" onclick="mpGo('mapsearch')">${ic('search',20,'var(--tt)')}<span style="flex:1">${L('Search places','Shakisha ahantu','Rechercher un lieu')}</span></div>
<div class="plc">${cats.map(c=>`<button onclick="${c[2]==='map'?'plMap()':`plCat('${c[2]}')`}"><span style="font-size:20px">${c[0]}</span>${c[1]}</button>`).join('')}</div>
${sec(L('Near you','Hafi yawe','Près de vous'))}${near.map(prow).join('')}
${sec(L('My places','Ahantu hanjye','Mes lieux'))}${cnt('⭐',L('Saved','Byabitswe','Favoris'),"mpGo('mpsaved')",sv)}${cnt('📅',L('Reservations','Ibyabitswe','Réservations'),"plRsvList()",M.rsv.length)}${cnt('💬',L('My reviews','Ibitekerezo byanjye','Mes avis'),"plReviews()",rv)}
${stk.length?sec(L('Stamp cards','Amakarita y’utubuto','Cartes de tampons'))+stk.map(([id,n])=>{const p=P().find(x=>x.id===id);return p?`<div class="pl tap" onclick="mpOpenPoi('${id}')"><i style="font-style:normal">🎟️</i><b>${p.n}</b><span>${n}/8</span></div>`:''}).join(''):''}
${rec.length?sec(L('Recent','Ibyaheruka','Récents'))+rec.map(r=>{const p=P().find(x=>x.n===r[0]);return `<div class="pl tap" onclick="mpOpenPoi('${p.id}')"><i>${ic('pin',20,'var(--tt)')}</i><b>${r[0]}</b><span>${r[1]}</span></div>`}).join(''):''}
<div class="pad" style="padding-top:28px"><button class="btn" onclick="ppGo('paytill')">${L('Pay at a place','Ishyura ahantu','Payer dans un lieu')}</button></div><div style="height:30px"></div>`};
const _dh=screens.dirhub;
if(_dh)screens.dirhub=()=>String(_dh()).split('class="mcs"').join('class="mcs keep"');
document.title=document.title.replace(/v\d+/,'v474');
})()}catch(e){console.error('places-v474',e)}
</script>
<script>
/* v475: place detail and reservations. (1) The cafe detail said 4.4 km while the Places list said 9.2 km; the distance now always comes from the same place data. (2) Reserve a table: "Time" and "Guests" labels, "1 person" instead of "1 people", a summary line above the button, and the toast says what was booked. (3) Reservations list: each booking shows time and guests and can be cancelled. */
try{(()=>{
const L=(e,r,f)=>({en:e,rw:r,fr:f}[S.lang]||e),M=S.mp,cur=()=>(window.POI||[]).find(p=>p.n===PL.n);
const ppl=n=>n===1?L('1 person','Umuntu 1','1 personne'):n+' '+L('people','abantu','pers.');
const sh=h=>{$('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet">'+h+'</div>'};
const _pl=screens.place;
screens.place=()=>{let h=_pl();const p=cur();
 if(p&&p.d){h=h.replace(/<b>[\d.]+ km<\/b>/,'<b>'+p.d+'</b>')}
 return h};
const lab=t=>`<div style="font-size:14px;font-weight:700;color:var(--mu);margin:16px 0 8px">${t}</div>`;
window.plRsv=()=>{const q=M.rq,p=cur()||{n:PL.n};
 sh(`<div class="h1" style="font-size:22px;line-height:30px">${L('Reserve a table','Bika ameza','Réserver une table')}</div><div class="mu" style="margin:4px 0 0">${p.n}</div>
 ${lab(L('Time','Igihe','Heure'))}<div class="req" style="margin:0">${['12:00','14:00','18:00','20:00'].map(t=>`<button class="${q.t===t?'on':''}" onclick="M.rq.t='${t}';plRsv()">${t}</button>`).join('')}</div>
 ${lab(L('Guests','Abantu','Personnes'))}<div class="req" style="margin:0 0 18px">${[1,2,4,6].map(n=>`<button class="${q.n===n?'on':''}" onclick="M.rq.n=${n};plRsv()">${ppl(n)}</button>`).join('')}</div>
 <div style="text-align:center;font-size:15px;font-weight:700;margin-bottom:12px">${L('Today','Uyu munsi','Aujourd’hui')} · ${q.t} · ${ppl(q.n)}</div>
 <button class="btn" onclick="plBook()">${L('Confirm reservation','Emeza kubika','Confirmer')}</button>`)};
window.plBook=()=>{const q=M.rq,p=cur();M.rsv.unshift({p:p?p.n:PL.n,t:q.t,n:q.n});closeSheet();
 toast(L('Table for ','Ameza y’abantu ','Table pour ')+q.n+' · '+q.t);render('fade-none')};
window.plRsvCx=i=>{M.rsv.splice(i,1);toast(L('Reservation cancelled','Byakuweho','Réservation annulée'));plRsvList()};
window.plRsvList=()=>{const h=M.rsv.length?M.rsv.map((r,i)=>`<div style="display:flex;align-items:center;gap:12px;padding:12px 0"><div style="flex:1;min-width:0"><b style="display:block;font-size:17px;font-weight:600">${r.p}</b><span class="mu" style="font-size:14px">${L('Today','Uyu munsi','Aujourd’hui')} · ${r.t} · ${ppl(r.n)}</span></div><button class="tap" style="border:0;background:var(--chip);border-radius:18px;height:36px;padding:0 14px;font:inherit;font-weight:700;font-size:14px;color:var(--tx)" onclick="plRsvCx(${i})">${L('Cancel','Kuvanaho','Annuler')}</button></div>`).join(''):`<div class="mu" style="padding:14px 0">${L('No reservations yet.','Nta cyemezo cyo kubika.','Aucune réservation.')}</div>`;
 $('#layer').innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="h1" style="font-size:22px;line-height:30px">'+L('Reservations','Ibyabitswe','Réservations')+'</div>'+h+'</div>'};
document.title=document.title.replace(/v\d+/,'v475');
})()}catch(e){console.error('places-v475',e)}
</script>
<script>
/* v476: Directions. (1) Travel mode is a choice (Bus, Car, Walk, Bike) instead of four tiles that jumped to a route; picking a place, Home, Work, a recent route or a search result now goes straight to the route in that mode. (2) Bus stops near you are sorted by distance (the 9 km stop was listed first) and show it. (3) The route screen's mode tabs used the same four times for every destination (a 0.2 km trip said 35m by bus and 1h34m on foot); they now come from the distance, and for trips under 3 km the bus tab is dropped (the sample bus trip is always 35 min, so walking is faster) and the route opens on foot. (4) The "Plan trips around Kigali" line is gone. */
try{(()=>{
const L=(e,r,f)=>({en:e,rw:r,fr:f}[S.lang]||e),M=S.mp,P=()=>window.POI||[],km=p=>parseFloat(p.d)||0;
const st=document.createElement('style');
st.textContent='#phone .screen .plc button.on{background:#191F28;color:#fff}#phone .screen .plc.md{gap:8px}#phone .screen .plc.md button{padding:0 13px;font-size:14px;gap:6px}';
document.head.appendChild(st);
const sec=t=>`<div class="mt2" style="padding-top:22px">${t}</div>`;
const cut=(h,title,fn)=>{const i=h.indexOf('>'+title+'</div>');if(i<0)return h;const s=h.lastIndexOf('<div class="mt2"',i);let e=h.indexOf('<div class="mt2"',i);if(e<0)e=h.length;return h.slice(0,s)+fn()+h.slice(e)};
const MODES=[['🚌',L('Bus','Bisi','Bus'),'bus'],['🚗',L('Car','Imodoka','Voiture'),'car'],['🚶',L('Walk','Genda','Marche'),'walk'],['🚲',L('Bike','Igare','Vélo'),'bike']];
const _d=screens.dirhub;
screens.dirhub=()=>{let h=String(_d());const dh=S.dh||(S.dh={}),cm=dh.mode||'bus';
 h=h.replace(/<div class="pad" style="padding-top:4px"><div class="mu" style="font-size:15px">[^<]*<\/div><\/div>/,'');
 h=cut(h,L('Travel mode','Uburyo bwo kugenda','Mode de transport'),()=>sec(L('Travel mode','Uburyo bwo kugenda','Mode de transport'))+`<div class="plc md" style="padding-top:2px">${MODES.map(m=>`<button class="${cm===m[2]?'on':''}" onclick="dhMode('${m[2]}')"><span style="font-size:20px">${m[0]}</span>${m[1]}</button>`).join('')}</div>`);
 h=cut(h,L('Bus stops near you','Aho bisi zihagarara hafi','Arrêts proches'),()=>{const stops=P().filter(p=>p.c==='bus'&&(!dh.line||p.k.includes(dh.line))).sort((a,b)=>km(a)-km(b)).slice(0,3);
  return sec(L('Bus stops near you','Aho bisi zihagarara hafi','Arrêts proches'))+(stops.length?stops.map(p=>`<div class="pl tap" onclick="mpOpenPoi('${p.id}')"><i style="font-style:normal">🚌</i><div style="flex:1;min-width:0"><b style="display:block;font-size:17px;font-weight:600">${p.n}</b><span>${p.k.replace(/^Bus stop · /,'')} · ${p.d} · ${p.o.replace(/^Next: /,'')}</span></div></div>`).join(''):`<div class="pad mu" style="font-size:14px;padding-top:6px">${L('No stops for this line nearby.','Nta hantu hafi h’iyi bisi.','Aucun arrêt proche pour cette ligne.')}</div>`)});
 return h};
window.dhMode=k=>{(S.dh=S.dh||{}).mode=k;render('fade-none')};
const onHub=()=>S.stack[S.stack.length-1]==='dirhub';
const _g=window.dhGo;
window.dhGo=(id,mode)=>_g(id,(onHub()&&(S.dh||{}).mode)||mode);
window.dhPick=id=>{if(id)window.dhGo(id,'bus')};
const _a=window.mpAddr;
window.mpAddr=(l,a)=>{const hub=onHub(),m=hub&&(S.dh||{}).mode;_a(l,a);if(m&&m!=='bus'){M.mode=m;render('fade-none')}};
const fmt=t=>t>=60?Math.floor(t/60)+'h'+(t%60?(t%60)+'m':''):t+'m';
const _r=screens.route;
screens.route=()=>{const p=P().find(x=>x.n===PL.n),k=p?km(p):0,near=p&&k>0&&k<=3;
 if(near&&M.mode==='bus')M.mode='walk';
 let h=_r();
 if(p&&k>0){const t={car:Math.max(2,Math.round(1.85*k)),walk:Math.max(1,Math.round(10.2*k)),bike:Math.max(1,Math.round(3.05*k))};
  h=h.replace('</svg>17m</button>','</svg>'+fmt(t.car)+'</button>').replace('</svg>1h34m</button>','</svg>'+fmt(t.walk)+'</button>').replace('</svg>28m</button>','</svg>'+fmt(t.bike)+'</button>');
  if(near)h=h.replace(/<button class="[^"]*" onclick="M\.opt=0;mpSet\('mode','bus'\)"[^>]*>[\s\S]*?<\/button>/,'')}
 return h};
document.title=document.title.replace(/v\d+/,'v476');
})()}catch(e){console.error('directions-v476',e)}
</script>
<script>
/* v477: Maps is no longer its own product. The Explore "Map" entry is gone (the group is now "Places & trips" with Places and Directions), "Look up a route in Maps" now opens Directions as "Plan a trip", and the full-screen map opens from Places: a Map chip leads the category row, and Back from the map (or from a category) returns to Places instead of leaving it. */
try{(()=>{
const M=S.mp;
const _om=window.openMaps;
window.plMap=()=>{M.cat=null;_om();S.stack=['placehub','mapview']};
const _pc=window.plCat;
window.plCat=k=>{_pc(k);S.stack=['placehub','mapview']};
document.title=document.title.replace(/v\d+/,'v477');
})()}catch(e){console.error('maps-v477',e)}
</script>
<script>
/* v478: place detail. Every place used the cafe template: a hospital showed "Great coffee, Wi-Fi", Reserve and "8th drink free". Now (1) the tags fit the kind of place (food, pharmacy, hospital; none for ATMs and bus stops), (2) the itunda Place card with Pay, Reserve and stamps only appears for cafes and restaurants ("8th meal free" for restaurants), pharmacies and hospitals get a single Pay here button, ATMs and bus stops get none, (3) "Collect a stamp (demo)" is a small quiet link instead of a full button, and (4) the walking time under Directions now matches the route screen: walking up to 3 km, otherwise the 35 min bus trip. */
try{(()=>{
const L=(e,r,f)=>({en:e,rw:r,fr:f}[S.lang]||e),cur=()=>(window.POI||[]).find(p=>p.n===PL.n);
const TAGS={
 food:[['🍽️',L('Great food','Ibiryo biryoshye','Très bon repas'),420],['👥',L('Good for groups','Byiza ku matsinda','Idéal en groupe'),186],['⚡',L('Fast service','Serivisi yihuse','Service rapide'),143]],
 pharm:[['💊',L('Well stocked','Ifite imiti ihagije','Bien approvisionnée'),96],['⚡',L('Quick service','Serivisi yihuse','Service rapide'),54]],
 hosp:[['🚑',L('Emergency care','Ubutabazi bwihuse','Urgences'),212],['🅿️',L('Parking','Aho guhagarara','Parking'),87]]};
const _pl=screens.place;
screens.place=()=>{let h=_pl();const p=cur();if(!p)return h;const c=p.c;
 const t0='<div style="display:flex;gap:8px;flex-wrap:wrap"><span',ti=h.indexOf(t0);
 if(ti>=0&&c!=='cafe'){const te=h.indexOf('</div>',ti)+6,sm=/<span style="([^"]*)">/.exec(h.slice(ti,te)),sty=sm?sm[1]:'';
  const tg=TAGS[c];h=h.slice(0,ti)+(tg?`<div style="display:flex;gap:8px;flex-wrap:wrap">${tg.map(x=>`<span style="${sty}">${x[0]} ${x[1]} <b style="color:var(--lk)">${x[2]}</b></span>`).join('')}</div>`:'')+h.slice(te)}
 const cs='<div style="margin-top:16px;border-radius:22px;background:var(--tint);padding:16px">',ci=h.indexOf(cs);
 if(ci>=0){const pi=h.indexOf('plStamp()',ci),ce=pi>=0?h.indexOf('</button></div>',pi)+15:-1;
  if(ce>14){let card=h.slice(ci,ce);
   if(c==='cafe'||c==='food'){
    if(c==='food')card=card.replace('8th drink free',L('8th meal free','Icya 8 ni ubuntu','8e repas offert')).replace('Icya 8 ni ubuntu','Icya 8 ni ubuntu').replace('8e boisson offerte','8e repas offert');
    card=card.replace(/<button[^>]*onclick="plStamp\(\)"[^>]*>[^<]*<\/button>/,`<button class="tap" onclick="plStamp()" style="margin-top:8px;border:0;background:none;color:var(--tintfg);font:inherit;font-size:13px;font-weight:700;padding:8px 0;opacity:.8">★ ${L('Collect a stamp (demo)','Fata akabuto (igerageza)','Ajouter un tampon (démo)')}</button>`);
   }else if(c==='pharm'||c==='hosp'){card=`<div style="margin-top:16px"><button class="btn" onclick="plPay()">${L('Pay here','Ishyura hano','Payer ici')}</button></div>`}
   else card='';
   h=h.slice(0,ci)+card+h.slice(ce)}}
 return h};
const fix=()=>{document.querySelectorAll('#phone button').forEach(b=>{if(!b.dataset.v358||b.dataset.v478||!/🚶/.test(b.textContent))return;
 const sh=b.parentElement&&b.parentElement.parentElement;if(!sh)return;
 const ln=sh.innerText.replace(/\u00a0/g,' ').split('Directions')[0].split('\n').find(l=>/^\s*[\d.]+\s*(km|m)\b/.test(l));if(!ln)return;
 const m=/^\s*([\d.]+)\s*(km|m)\b/.exec(ln),km=m[2]==='km'?parseFloat(m[1]):parseFloat(m[1])/1000;
 b.dataset.v478=1;const sp=b.querySelector('span');if(sp)sp.textContent=km>3?'🚌 35 min':'🚶 '+Math.max(1,Math.round(10.2*km))+' min'})};
new MutationObserver(fix).observe(document.getElementById('phone'),{childList:true,subtree:true});fix();
document.title=document.title.replace(/v\d+/,'v478');
})()}catch(e){console.error('place-v478',e)}
</script>
<script>
/* v479: Directions route screen for walk, car and bike. The route option cards were hidden by the global .mcs rule, so the area under the map was blank, and their numbers were fixed (17 min and 7.9 km for a 0.2 km trip). That area now has one summary: the time in large type, the distance, and the arrival time, all from the distance to the place. The "Get destination suggestions from your trips" box (a stub) is gone. */
try{(()=>{
const L=(e,r,f)=>({en:e,rw:r,fr:f}[S.lang]||e),M=S.mp,P=()=>window.POI||[];
const km=p=>parseFloat(p.d)||0;
const clk=m=>{const t=14*60+6+m,h=Math.floor(t/60)%24,mm=t%60;return (h%12||12)+':'+String(mm).padStart(2,'0')+' '+(h<12?'am':'pm')};
const dur=m=>m>=60?Math.floor(m/60)+' h '+(m%60)+' min':m+' min';
const _r=screens.route;
screens.route=()=>{let h=_r();const p=P().find(x=>x.n===PL.n);
 if(!p||!km(p)||M.mode==='bus')return h;
 const s=h.indexOf('<div class="mcs" style="padding:12px 16px 0">'),c=h.indexOf('<div class="cta">');
 if(s<0||c<0||c<s||h.slice(c-6,c)!=='</div>')return h;
 const k=km(p),m=M.mode,mins=m==='car'?Math.max(2,Math.round(1.85*k)):m==='bike'?Math.max(1,Math.round(3.05*k)):Math.max(1,Math.round(10.2*k));
 const lab=m==='car'?L('Drive · usual traffic','Imodoka · urujya n’uruza risanzwe','Voiture · trafic habituel'):m==='bike'?L('Bike','Igare','Vélo'):L('Walk','Genda n’amaguru','Marche');
 const card=`<div style="padding:22px 24px 0"><div style="font-size:14px;font-weight:700;color:var(--lk)">${lab}</div><div style="font-size:34px;font-weight:800;letter-spacing:-.8px;margin-top:2px">${dur(mins)}</div><div class="mu" style="font-size:15px;margin-top:6px">${p.d}</div><div class="mu" style="font-size:15px;margin-top:2px">${L('Leave now · arrive ','Genda ubu · uzagerayo ','Partir maintenant · arrivée ')}${clk(mins)}</div></div>`;
 return h.slice(0,s)+card+h.slice(c-6)};
document.title=document.title.replace(/v\d+/,'v480');
})()}catch(e){console.error('route-v479',e)}
</script>
<script>
/* v481: Places and Directions polish. Directions: the four travel modes share the width (Bike was cut off), bus-line chips wrap instead of running off the edge, "Edit" says what it does, a vertical line joins the From and To dots, and the swap button is an up/down arrow. Route: the bus segment bar (the 305 / 102 label was cropped) is a readable 28px bar; walk, car and bike get Preview next to Start. Place: the tags sit in one swipeable row instead of three staggered lines. Places: category chips fade at the edge to show they scroll. */
try{(()=>{
const L=(e,r,f)=>({en:e,rw:r,fr:f}[S.lang]||e);
const st=document.createElement('style');
st.textContent='#phone .screen .plc{-webkit-mask-image:linear-gradient(90deg,#000 90%,transparent);mask-image:linear-gradient(90deg,#000 90%,transparent)}#phone .screen .plc.md{-webkit-mask-image:none;mask-image:none;overflow:visible}#phone .screen .plc.md button{flex:1;justify-content:center;padding:0 6px;gap:5px;min-width:0}#phone .screen .chp{flex-wrap:wrap}#phone .screen .tgs{flex-wrap:nowrap!important;overflow-x:auto;scrollbar-width:none;margin:0 -16px;padding:0 16px}#phone .screen .tgs::-webkit-scrollbar{display:none}#phone .screen .tgs>span{flex:none;white-space:nowrap}#phone .screen .sh2 .seg{display:flex;height:28px;border-radius:14px;overflow:hidden;margin:14px 0 6px;font-size:12px;font-weight:700;color:#fff}#phone .screen .sh2 .seg>div{display:flex;align-items:center;justify-content:center;height:100%;min-width:0;overflow:hidden}#phone .screen .rbox .fi{position:relative}#phone .screen .rbox .fi+.fi:before{content:"";position:absolute;left:10px;top:-14px;height:20px;border-left:2px dotted var(--tt);opacity:.5}';
document.head.appendChild(st);
const _d=screens.dirhub;
if(_d)screens.dirhub=()=>String(_d()).replace('aria-label="Edit">✎</button>','aria-label="Edit">'+L('Edit','Hindura','Modifier')+'</button>');
const _p=screens.place;
if(_p)screens.place=()=>String(_p()).replace('<div style="display:flex;gap:8px;flex-wrap:wrap"><span','<div class="tgs" style="display:flex;gap:8px;flex-wrap:nowrap"><span');
const _r=screens.route;
screens.route=()=>{let h=String(_r());
 h=h.replace(/(<button class="ib" aria-label="Swap"[^>]*>)[\s\S]*?(<\/button>)/,'$1<span style="font-size:20px;line-height:1">⇅</span>$2');
 if(S.mp.mode!=='bus'&&h.indexOf('mpStart(true)')<0)
  h=h.replace(/<div class="cta">[\s\S]*?<\/div><\/div>/,'<div class="cta"><div style="display:flex;gap:10px"><button class="btn sec2" style="flex:0 0 36%" onclick="mpStart(true)">'+L('Preview','Reba','Aperçu')+'</button><button class="btn" onclick="mpStart(false)">'+L('Start','Tangira','Démarrer')+'</button></div></div>');
 return h};
document.title=document.title.replace(/v\d+/,'v481');
})()}catch(e){console.error('places-directions-v481',e)}
</script>
<script>
/* v482: Walk, car and bike routes. The space between the time summary and Start is now used: choose when to leave (Now, in 15 min, 30 min, 1 h) and the arrival time moves with it, and "Share ETA" copies a message with the place and arrival time. */
try{(()=>{
const L=(e,r,f)=>({en:e,rw:r,fr:f}[S.lang]||e),M=S.mp;
const st=document.createElement('style');
st.textContent='#phone .screen .lvc{display:flex;gap:8px;padding:18px 24px 0;overflow-x:auto;scrollbar-width:none}#phone .screen .lvc::-webkit-scrollbar{display:none}#phone .screen .lvc button{flex:none;height:40px;border:0;border-radius:20px;background:var(--chip);color:var(--tx);font:inherit;font-weight:700;font-size:14px;padding:0 14px}#phone .screen .lvc button.on{background:#191F28;color:#fff}';
document.head.appendChild(st);
const OFF=[[0,L('Now','Ubu','Maintenant')],[15,L('In 15 min','Mu minota 15','Dans 15 min')],[30,L('In 30 min','Mu minota 30','Dans 30 min')],[60,L('In 1 h','Mu isaha 1','Dans 1 h')]];
const add=(t,m)=>{const x=/(\d+):(\d+) (am|pm)/.exec(t);if(!x)return t;let h=(+x[1])%12+(x[3]==='pm'?12:0),n=h*60+(+x[2])+m;h=Math.floor(n/60)%24;return (h%12||12)+':'+String(n%60).padStart(2,'0')+' '+(h<12?'am':'pm')};
window.rtLeave=m=>{M.off=m;render('fade-none')};
window.rtShare=()=>{const a=(document.body.innerText.match(/(\d+:\d+ (am|pm))/g)||[]).pop()||'';const m=L('On my way to ','Ndi mu nzira njya ku ','Je suis en route vers ')+PL.n+L(' · arriving ',' · ngera saa ',' · arrivée ')+a;try{navigator.clipboard.writeText(m).catch(()=>{})}catch(e){}toast(L('ETA copied','Isaha yo kugera yakoporowe','Heure d’arrivée copiée'))};
const _r=screens.route;
screens.route=()=>{let h=String(_r());
 if(M.mode==='bus'||h.indexOf('Leave now · arrive')<0&&h.indexOf('arrive ')<0)return h;
 const o=M.off||0;
 if(o)h=h.replace(/Leave now · arrive (\d+:\d+ (?:am|pm))/,(x,t)=>L('Leave in ','Genda mu minota ','Partir dans ')+o+' min · '+L('arrive ','uzagerayo ','arrivée ')+add(t,o));
 const chips='<div class="lvc">'+OFF.map(x=>'<button class="'+(o===x[0]?'on':'')+'" onclick="rtLeave('+x[0]+')">'+x[1]+'</button>').join('')+'<button onclick="rtShare()">'+L('Share ETA','Sangiza isaha','Partager l’heure')+'</button></div>';
 const i=h.indexOf('<div class="cta">');return i<0?h:h.slice(0,i)+chips+h.slice(i)};
document.title=document.title.replace(/v\d+/,'v482');
})()}catch(e){console.error('route-v482',e)}
</script>
<script>
/* v483: Directions hub order. Saved routes and Recent routes now come right after Travel mode, ahead of Bus stops and Bus lines, because they are what people reopen most; Fares stays last. */
try{(()=>{
const L=(e,r,f)=>({en:e,rw:r,fr:f}[S.lang]||e);
const RK=[L('Travel mode','Uburyo bwo kugenda','Mode de transport'),L('Saved routes','Inzira zabitswe','Itinéraires enregistrés'),L('Recent routes','Inzira zaheruka','Itinéraires récents'),L('Bus stops near you','Aho bisi zihagarara hafi','Arrêts proches'),L('Bus lines','Imirongo ya bisi','Lignes de bus')];
const _d=screens.dirhub;
if(_d)screens.dirhub=()=>{const h=String(_d()),p=h.split('<div class="mt2"');if(p.length<3)return h;
 const head=p.shift(),last=p.pop(),rank=x=>{const t=x.slice(x.indexOf('>')+1,x.indexOf('</div>')),i=RK.indexOf(t);return i<0?9:i};
 const mid=p.map((x,i)=>[rank(x),i,x]).sort((a,b)=>a[0]-b[0]||a[1]-b[1]).map(x=>'<div class="mt2"'+x[2]).join('');
 return head+mid+'<div class="mt2"'+last};
document.title=document.title.replace(/v\d+/,'v483');
})()}catch(e){console.error('dirhub-v483',e)}
</script>
<script>
/* v484: Places hub. "Near you" gets an Open now filter chip and shows each place's status (Open · closes 22:00) under its name, in green when open. */
try{(()=>{
const L=(e,r,f)=>({en:e,rw:r,fr:f}[S.lang]||e),P=()=>window.POI||[],km=p=>parseFloat(p.d)||99;
const isOpen=p=>/^Open/.test(p.o||'');
const tr=o=>String(o||'').replace('Open',L('Open','Irafunguye','Ouvert')).replace('closes',L('closes','ifunga','ferme'));
window.plOpenTg=()=>{S.plOpen=!S.plOpen;render('fade-none')};
const row=p=>`<div class="pl tap" onclick="mpOpenPoi('${p.id}')"><i style="font-style:normal;font-size:20px">${p.e}</i><div style="flex:1;min-width:0"><b style="display:block;font-size:17px;font-weight:600">${p.n}</b><span>${p.k}${p.r?' · ★ '+p.r.split(' ')[0]:''} · ${p.d}</span>${p.o?`<span style="display:block;margin-top:2px;font-weight:600;color:${isOpen(p)?'#1E8E3E':'var(--mu)'}">${tr(p.o)}</span>`:''}</div></div>`;
const _h=screens.placehub;
if(_h)screens.placehub=()=>{const h=String(_h()),T=L('Near you','Hafi yawe','Près de vous'),a=h.indexOf('>'+T+'</div>');if(a<0)return h;
 const s=h.lastIndexOf('<div class="mt2"',a);let e=h.indexOf('<div class="mt2"',a);if(e<0)e=h.indexOf('<div class="pad"',a);if(e<0)return h;
 let l=P().filter(p=>p.c!=='bus'&&p.c!=='atm');if(S.plOpen)l=l.filter(isOpen);l=l.sort((x,y)=>km(x)-km(y)).slice(0,5);
 const chip=`<div class="lvc" style="padding-top:2px;padding-bottom:6px"><button class="${S.plOpen?'on':''}" aria-pressed="${!!S.plOpen}" onclick="plOpenTg()">${L('Open now','Irafunguye ubu','Ouvert maintenant')}</button></div>`;
 return h.slice(0,s)+`<div class="mt2" style="padding-top:26px">${T}</div>`+chip+(l.length?l.map(row).join(''):`<div class="pad mu" style="font-size:14px;padding-top:6px">${L('Nothing open nearby right now.','Nta hantu hafunguye hafi.','Rien d’ouvert à proximité.')}</div>`)+h.slice(e)};
document.title=document.title.replace(/v\d+/,'v484');
})()}catch(e){console.error('placehub-v484',e)}
</script>

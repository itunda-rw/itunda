   const end=[...R.children].reverse().find(d=>/height:30px/.test(d.getAttribute&&d.getAttribute('style')||''));
   if(bDep&&end&&M.tab==='home')end.insertAdjacentHTML('beforebegin',`<div class="pz-more"><button onclick="${oc(bDep)}">${L('Use as route start','Tangira hano','Partir d’ici')}</button></div>`)}
  const d=document.createElement('div');d.appendChild(R);return d.innerHTML
 }catch(e){console.error('place-v493',e);return h}};

POI.forEach(p=>{p.d=(Math.hypot(pp(p)[0]-ME[0],pp(p)[1]-ME[1])*1.25/1000).toFixed(1)+' km'});
const SP={car:{1:8.5,2:6},bike:{1:4.2,2:4.2},walk:{1:1.35,2:1.35},bus:{1:6.5,2:5}};
const ang=g=>Math.atan2(g[g.length-1][1]-g[g.length-2][1],g[g.length-1][0]-g[g.length-2][0])*180/Math.PI,ang0=g=>Math.atan2(g[1][1]-g[0][1],g[1][0]-g[0][0])*180/Math.PI;
function build(mode,A,B,pth,na,nb){const sp=SP[mode],wk=mode==='walk'||mode==='bus',car=mode==='car',as=car?6:mode==='bike'?4.2:1.35,det=wk?1.3:1.2;
const a1=Math.hypot(ND[na].p[0]-A.p[0],ND[na].p[1]-A.p[1])*det,a2=Math.hypot(ND[nb].p[0]-B.p[0],ND[nb].p[1]-B.p[1])*det;
/* v656: start and end beside the same road node: go straight there, not via the node */
if(mode!=='bus'&&!pth.length){const dd=Math.hypot(A.p[0]-B.p[0],A.p[1]-B.p[1])*det;if(dd<a1+a2){const kmd=dd/1000;return{pts:[A.p,B.p],dist:dd,secs:dd/as,steps:[{g:'📍',m:dd,t:L('Start at ','Tangirira kuri ','Départ : ')+A.n,s:L('Head toward ','Jya werekeza ','Direction ')+B.n},{g:'🏁',m:0,t:L('Arrive at ','Ugeze kuri ','Arrivée : ')+B.n,s:dm(dd)}],tr:car?[{g:[A.p,B.p],c:'#2BA84A'}]:null,delay:0,cost:car?L('Taxi ≈ ','Taxi ≈ ','Taxi ≈ ')+(Math.round((1000+450*kmd)/100)*100).toLocaleString('en-US')+' RWF':mode==='bike'?Math.round(kmd*30)+' kcal':Math.round(dd/.75).toLocaleString('en-US')+' '+L('steps','intambwe','pas')+' · '+Math.round(kmd*55)+' kcal'}}}
const LV=e=>(e.a.charCodeAt(0)+e.b.charCodeAt(1)+e.c*3)%5,MU=[1,1,1,1.4,2.1],TC=['#2BA84A','#2BA84A','#2BA84A','#F5B301','#D92D20'];
let pts=[A.p,ND[na].p],dist=a1+a2,secs=a1/as+a2/as,delay=0,tr=car?[{g:[A.p,ND[na].p],c:TC[0]}]:null,steps=[];
pth.forEach(x=>{pts=pts.concat(x.g.slice(1));const s0=x.e.len/sp[x.e.c],lv=car?LV(x.e):0;dist+=x.e.len;secs+=s0*MU[lv];delay+=s0*(MU[lv]-1);if(car)tr.push({g:x.g,c:TC[lv]})});pts.push(B.p);if(car)tr.push({g:[ND[nb].p,B.p],c:TC[0]});
if(mode==='bus'){const legs=[{k:'w',secs:a1/as,m:a1}],line=[];
steps.push({g:'🚶',m:a1,t:L('Walk to ','Genda ugana ','Marchez vers ')+ND[na].n+L(' stop',' aho bisi zihagarara',' (arrêt)'),s:dm(a1)+' · '+tm(a1/as)});
let i=0;while(i<pth.length){let set=pth[i].e.bs.slice(),j=i+1;while(j<pth.length&&set.some(l=>pth[j].e.bs.includes(l))){set=set.filter(l=>pth[j].e.bs.includes(l));j++}
const from=i?pth[i-1].n:na,to=pth[j-1].n,ln=set[0],w=((new Date().getMinutes()+i*2)%6)+1,seg=pth.slice(i,j),ss=seg.reduce((a,x)=>a+x.e.len/sp[x.e.c],0),mm=seg.reduce((a,x)=>a+x.e.len,0);
line.push(ln);legs.push({k:'b',ln,w,wait:i?240:w*60,from:ND[from].n,to:ND[to].n,secs:ss,m:mm,stops:[ND[from].n].concat(seg.map(x=>ND[x.n].n))});
steps.push({g:'🚌',bus:1,m:mm,t:L('Take ','Fata ','Prenez ')+ln+' → '+ND[to].n,s:(i?L('Transfer at ','Guhindurira ','Correspondance à '):L('Board at ','Urira kuri ','Montez à '))+ND[from].n+' · '+seg.length+L(' stops',' aho bisi zihagarara',' arrêts')});i=j}
legs.push({k:'w',secs:a2/as,m:a2});steps.push({g:'🚶',m:a2,t:L('Walk to ','Genda ugana ','Marchez vers ')+B.n,s:dm(a2)+' · '+tm(a2/as)});
secs=legs.reduce((a,l)=>a+l.secs+(l.wait||0),0);const fare=Math.max(400,200*line.length+Math.round(dist/1000)*20);
return{pts,dist,secs,steps,legs,line,fare,cost:'Tap&Go '+fare+' RWF'}}
steps.push({g:'📍',m:a1,t:L('Start at ','Tangirira kuri ','Départ : ')+A.n,s:L('Head toward ','Jya werekeza ','Direction ')+ND[na].n});
let prev=ang(pts.slice(0,2));const gs=[];pth.forEach(x=>{const l=gs[gs.length-1];if(l&&l.nm===x.e.nm)l.len+=x.e.len;else gs.push({nm:x.e.nm,len:x.e.len,a:ang0(x.g)})});
gs.forEach((q,i)=>{const d=((q.a-prev+540)%360)-180,st=Math.abs(d)<25;steps.push({g:i?st?'↑':d>0?'↱':'↰':'↑',m:q.len,t:(i?st?L('Continue on ','Komeza kuri ','Continuez sur '):(d>0?L('Turn right onto ','Kata iburyo kuri ','Tournez à droite sur '):L('Turn left onto ','Kata ibumoso kuri ','Tournez à gauche sur ')):L('Take ','Fata ','Prenez '))+q.nm,s:dm(q.len)});prev=q.a});
steps.push({g:'🏁',m:a2,t:L('Arrive at ','Ugeze kuri ','Arrivée : ')+B.n,s:dm(a2)});
const km=dist/1000,cost=car?L('Taxi ≈ ','Taxi ≈ ','Taxi ≈ ')+(Math.round((1000+450*km)/100)*100).toLocaleString('en-US')+' RWF':mode==='bike'?Math.round(km*30)+' kcal':Math.round(dist/.75).toLocaleString('en-US')+' '+L('steps','intambwe','pas')+' · '+Math.round(km*55)+' kcal';
return{pts,dist,secs,steps,tr,delay,cost}}
function rt(mode,A,B){const bus=mode==='bus',na=near(A.p,bus),nb=near(B.p,bus),f=e=>e.len/(SP[mode][e.c]),ok=e=>!bus||e.bs.length,used={},out=[],seen={},lab=bus?['Best','Fewest transfers','Alternative']:['Best','Shortest','Alternative'];
for(let k=0;k<3;k++){const c=k===1?(e=>e.len):(e=>f(e)*(k===2&&used[e.a+e.b]?3:1)),p=dj(na,nb,e=>ok(e)?c(e):1e18);if(!p)continue;const key=p.map(x=>x.e.a+x.e.b+x.n).join();if(seen[key])continue;seen[key]=1;p.forEach(x=>used[x.e.a+x.e.b]=1);const r=build(mode,A,B,p,na,nb);r.label=out.length?lab[k]:lab[0];out.push(r)}
if(!out.length)out.push(build(mode,A,B,[],na,nb));if(bus)out.forEach((r,i)=>{if(i===1)r.label=r.line.length<out[0].line.length?'Fewest transfers':'Alternative'});return out}
M.v=M.v||{x:ME[0]+500,y:ME[1]-300,z:.06};M.layer=M.layer||0;
window.__rt=rt;window.__ep=ep;window.__tm=tm;/* v657: shared with the Places screens */
const MODES=[['bus','mbus'],['car','mcar'],['walk','mwalk'],['bike','mbike']],COL={bus:'#3B7D20',car:'#2E6BF0',walk:'#2E6BF0',bike:'#2E6BF0'};
function svg(h){const v=M.v,z=v.z,X=x=>((x-v.x)*z+W/2).toFixed(1),Y=y=>((y-v.y)*z+h/2).toFixed(1),pt=p=>X(p[0])+' '+Y(p[1]),sat=M.layer===1,tr=M.layer===2,bg=sat?'#2F4A35':'var(--chip)',rd=sat?'#A8B0A8':'var(--bg)',cs=sat?'#1C2A20':'var(--ln)';
let s=`<svg viewBox="0 0 ${W} ${h}" width="100%" style="display:block;background:${bg};touch-action:none;user-select:none" role="img" aria-label="Map of Kigali">`;
const w1=[at('NB',-900,-1800),at('NB',-400,800),at('NY',-300,-400),at('NY',-700,1500)];
s+=`<path d="M${w1.map(pt).join('L')}" fill="none" stroke="${sat?'#2C5D7A':'#8FBFE8'}" stroke-width="${Math.max(6,500*z)}" opacity=".6" stroke-linecap="round"/><circle cx="${X(H[0]-900)}" cy="${Y(H[1]-1000)}" r="${Math.max(10,600*z)}" fill="${sat?'#3A6A43':'#BFE3B4'}" opacity=".7"/>`;
const ew=e=>(e.c===1?3.5+z*45:2.2+z*28);
EG.forEach(e=>{s+=`<path d="M${e.g.map(pt).join('L')}" fill="none" stroke="${cs}" stroke-width="${ew(e)+2}" stroke-linecap="round" stroke-linejoin="round"/>`});
EG.forEach((e,i)=>{s+=`<path d="M${e.g.map(pt).join('L')}" fill="none" stroke="${tr?['#2BA84A','#F5B301','#D92D20'][(i*7)%3]:rd}" stroke-width="${ew(e)}" stroke-linecap="round" stroke-linejoin="round"/>`;if(z>.05)s+=`<text x="${X(e.g[1][0])}" y="${Y(e.g[1][1])-4}" font-size="9" font-weight="700" fill="${sat?'#dfe':'var(--mu)'}" text-anchor="middle" stroke="${sat?'#1C2A20':'var(--chip)'}" stroke-width="2.5" paint-order="stroke">${e.nm}</text>`});
for(const k in ND)s+=`<text x="${X(ND[k].p[0])}" y="${Y(ND[k].p[1])+16}" font-size="11" font-weight="800" text-anchor="middle" fill="${sat?'#fff':'var(--tt)'}" stroke="${sat?'#1C2A20':'var(--chip)'}" stroke-width="3" paint-order="stroke">${ND[k].n.replace(' Bus Park','').replace(' Taxi Park','')}</text>`;
const R=M._r;if(R){R.list.forEach((r,i)=>{if(i!==R.sel)s+=`<path d="M${r.pts.map(pt).join('L')}" fill="none" stroke="#8B95A1" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" opacity=".7"/>`});const r=R.list[R.sel];if(r&&(M._nv||r.tr)){s+=routeSvg(r,pt,X,Y)}else if(r){s+=`<path d="M${r.pts.map(pt).join('L')}" fill="none" stroke="#fff" stroke-width="10" stroke-linecap="round" stroke-linejoin="round" opacity=".9"/><path d="M${r.pts.map(pt).join('L')}" fill="none" stroke="${COL[R.mode]}" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" ${R.mode==='bike'?'stroke-dasharray="1 9"':R.mode==='walk'?'stroke-dasharray="1 10"':''}/>`;s+=`<circle cx="${X(r.pts[0][0])}" cy="${Y(r.pts[0][1])}" r="9" fill="#2BA84A" stroke="#fff" stroke-width="3"/><circle cx="${X(r.pts[r.pts.length-1][0])}" cy="${Y(r.pts[r.pts.length-1][1])}" r="11" fill="#D92D20" stroke="#fff" stroke-width="3"/>`}}
if(M._pins!==false)POI.filter(p=>M.cat==='all'||p.c===M.cat).forEach(p=>{const q=pp(p),x=X(q[0]),y=Y(q[1]),on=M.sel===p.id;s+=`<g onclick="mpPin('${p.id}')" style="cursor:pointer" role="button" aria-label="${p.n}"><circle cx="${x}" cy="${y-16}" r="${on?20:14}" fill="${on?'var(--lk)':'#E8604C'}" stroke="#fff" stroke-width="3"/><text x="${x}" y="${+y-(on?9:11)}" font-size="${on?19:14}" text-anchor="middle">${p.e}</text>${on||z>.1?`<text x="${x}" y="${+y+10}" font-size="11" font-weight="800" text-anchor="middle" fill="var(--tx)" stroke="var(--bg)" stroke-width="3" paint-order="stroke">${p.n}</text>`:''}</g>`});
const nv=M._nv,mp=nv?nv.p:ME;s+=`<g transform="translate(${X(mp[0])} ${Y(mp[1])})">${nv?`<circle r="18" fill="#2E6BF0" opacity=".2"/><g transform="rotate(${nv.a})"><path d="M0-14L10 10L0 5L-10 10Z" fill="#2E6BF0" stroke="#fff" stroke-width="2.5" stroke-linejoin="round"/></g>`:`<circle class="pulse" r="10" fill="#2E6BF0"/><circle r="8" fill="#2E6BF0" stroke="#fff" stroke-width="3"/>`}</g></svg>`;return s}
function routeSvg(r,pt,X,Y){const nv=M._nv;let s='',pts=r.pts;if(nv){s+=`<path d="M${r.pts.slice(0,nv.k+1).concat([nv.p]).map(pt).join('L')}" fill="none" stroke="#8B95A1" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" opacity=".55"/>`;pts=[nv.p].concat(r.pts.slice(nv.k+1))}
const d='M'+pts.map(pt).join('L');s+=`<path d="${d}" fill="none" stroke="#fff" stroke-width="12" stroke-linecap="round" stroke-linejoin="round"/>`;
if(r.tr&&!nv)r.tr.forEach(q=>{s+=`<path d="M${q.g.map(pt).join('L')}" fill="none" stroke="${q.c}" stroke-width="7" stroke-linecap="round" stroke-linejoin="round"/>`});else s+=`<path d="${d}" fill="none" stroke="${COL[M._r.mode]}" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" ${M._r.mode==='bike'?'stroke-dasharray="1 9"':M._r.mode==='walk'?'stroke-dasharray="1 10"':''}/>`;
const e=r.pts[r.pts.length-1];return s+`<circle cx="${X(r.pts[0][0])}" cy="${Y(r.pts[0][1])}" r="9" fill="#2BA84A" stroke="#fff" stroke-width="3"/><circle cx="${X(e[0])}" cy="${Y(e[1])}" r="11" fill="#D92D20" stroke="#fff" stroke-width="3"/>`}
const draw=()=>{const g=document.getElementById('gm');if(g)g.innerHTML=svg(+g.dataset.h)};
const zoom=f=>{M.v.z=Math.max(.02,Math.min(.6,M.v.z*f));draw()};
window.mpZoom=f=>zoom(f);

#phone .e2-st{display:flex;margin:16px 24px 0;border:1px solid var(--ln);border-radius:18px}
#phone .e2-st div{flex:1;padding:12px 6px;text-align:center;min-width:0}
#phone .e2-st div+div{border-left:1px solid var(--ln)}
#phone .e2-st small{display:block;font-size:12px;color:var(--mu);font-weight:600}
#phone .e2-st b{display:block;font-size:15px;font-weight:800;margin-top:3px}
#phone .e2-pm{margin:12px 24px 0;border-radius:16px;background:var(--tint);color:var(--tintfg);padding:12px 14px;display:flex;align-items:center;gap:10px;font-size:14px;font-weight:700;line-height:19px;border:0;font-family:inherit;text-align:left;width:calc(100% - 48px)}
#phone .e2-pm span{flex:1}
#phone .e2-pm em{font-style:normal;font-size:13px;font-weight:800;background:var(--tintfg);color:var(--bg);border-radius:12px;padding:6px 10px;flex:none}
#phone .e2-cn{margin:12px 24px 0;border-radius:16px;background:var(--chip);padding:12px 14px;font-size:14px;line-height:20px;font-weight:600}
#phone .e2-tabs{position:sticky;top:60px;z-index:6;background:var(--bg);display:flex;gap:26px;padding:0 24px;height:48px;margin-top:16px;border-bottom:1px solid var(--ln)}
#phone .e2-tabs button{border:0;background:none;font:inherit;font-size:16px;font-weight:800;color:var(--tt);border-bottom:3px solid transparent;padding:12px 0 0;height:48px;box-sizing:border-box}
#phone .e2-tabs button.on{color:var(--tx);border-bottom-color:var(--tx)}
#phone .e2-sc{position:sticky;top:108px;z-index:5;background:var(--bg);display:flex;gap:8px;overflow-x:auto;padding:10px 24px;scrollbar-width:none;border-bottom:1px solid var(--ln)}
#phone .e2-sc::-webkit-scrollbar{display:none}

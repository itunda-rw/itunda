document.addEventListener('pointermove',e=>{const p=ps[e.pointerId],g=document.getElementById('gm');if(!p)return;if(!g){delete ps[e.pointerId];return}const k=W/g.getBoundingClientRect().width,ks=Object.keys(ps),dx=e.clientX-p[0],dy=e.clientY-p[1];
if(ks.length==1){M.mv+=Math.abs(dx)+Math.abs(dy);if(M.mv>6&&!cap){cap=1;try{g.setPointerCapture(e.pointerId)}catch(_){}}if(M.mv>6){M.v.x-=dx*k/M.v.z;M.v.y-=dy*k/M.v.z;M.fit=M.fit}}
ps[e.pointerId]=[e.clientX,e.clientY];if(ks.length==2){const a=Object.values(ps),d=Math.hypot(a[0][0]-a[1][0],a[0][1]-a[1][1]);if(pd)zoom(d/pd);pd=d;M.mv=99}draw()});

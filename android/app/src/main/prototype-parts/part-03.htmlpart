 const star=!!S.mp.star,dir=m[2];
 const q=`<div class="pz-q"><button onclick="${m[3]}"><i>📞</i>${L('Call','Hamagara','Appeler')}</button><button onclick="${sv[1]}"><i>${star?'⭐':'☆'}</i>${star?L('Saved','Byabitswe','Enregistré'):L('Save','Bika','Enregistrer')}</button><button onclick="${m[4]}"><i>🔗</i>${L('Share','Sangiza','Partager')}</button><button onclick="${m[6]}"><i>📅</i>${L('Reserve','Bika','Réserver')}</button></div><div class="pz-cta"><button class="btn p" onclick="${m[1]}">${dir}</button><button class="btn sec2" onclick="${m[5]}">${L('Pay here','Ishyura hano','Payer ici')}</button></div>`;
 h=h.replace(re,()=>q).replace(/<button class="ib"[^>]*aria-label="Save"[\s\S]*?<\/button>/,'');
 return h};
document.title=document.title.replace(/v\d+/,'v497');
})()}catch(e){console.error('place-v497',e)}
</script>
<script>

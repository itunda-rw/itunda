var f=function(n){return Number(n).toLocaleString('en-US')};
var on=function(k){return S.lang==='en'&&S.pfG&&S.pfG[k]&&S.pfG[k].open};
var BACK='<button class="ib" aria-label="Back" onclick="back()" style="margin-left:-6px"><span style="font-size:22px">&#8592;</span></button>';
function bar(old,t){var m=typeof old==='string'&&old.match(/^<div class="bar">(<button class="ib"[\s\S]*?<\/button>)/);return '<div class="bar">'+(m?m[1]:BACK)+'<b>'+t+'</b></div>'}

#phone .st926 div{flex:1;display:flex;flex-direction:column;align-items:center;gap:8px;font-size:12px;font-weight:700;color:var(--tt)}
#phone .st926 i{width:36px;height:36px;border-radius:50%;background:var(--chip);display:flex;align-items:center;justify-content:center}
#phone .st926 .d i{background:var(--br)}
#phone .st926 .d i::after{content:"";width:12px;height:7px;border-left:2.5px solid #fff;border-bottom:2.5px solid #fff;transform:rotate(-45deg) translate(1px,-1px);border-radius:1px}
#phone .st926 .t i{background:none;box-shadow:inset 0 0 0 2px var(--br)}
#phone .st926 .t{color:var(--tx)}
#phone .st926 .d i{animation:st926 .4s cubic-bezier(.2,.9,.3,1.3) backwards;animation-delay:calc(var(--k)*70ms)}
@keyframes st926{from{transform:scale(.3);opacity:0}}
@media (prefers-reduced-motion:reduce){#phone .st926 i{animation:none!important}}

<style id="v1023css">
/* v1023: big titles collapse into the top bar as you scroll, like Toss and Kakao. The large heading fades and slides up under the bar while a small centered title slides in; scrolling back reverses it. Solid fills only. */
#phone .screen .bar{position:sticky}
#phone .v23t{position:absolute;left:56px;right:56px;top:0;bottom:6px;display:flex;align-items:center;justify-content:center;font-size:16px;font-weight:800;letter-spacing:-.2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;pointer-events:none;opacity:0;transform:translateY(10px);transition:opacity .2s,transform .28s cubic-bezier(.2,.9,.3,1)}
#phone .v23t.on{opacity:1;transform:none}
#phone .v23h{transition:opacity .12s linear,transform .12s linear;will-change:opacity,transform}
@media (prefers-reduced-motion:reduce){#phone .v23t,#phone .v23h{transition:none}}
</style><script id="v1023js">
(function(){try{
var ph=document.getElementById('phone');if(!ph)return;

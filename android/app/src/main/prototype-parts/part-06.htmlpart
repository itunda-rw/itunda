#phone #sc .sched::after{content:"";position:absolute;left:9px;top:0;bottom:0;width:2px;background:var(--chip)}
#phone #sc .sched:first-of-type::after,#phone #sc .sched:first-child::after{top:50%}
#phone #sc .sched:last-child::after{bottom:50%}
#phone #sc .sched:has(.s[style*="--lk"])::before{background:var(--lk);box-shadow:0 0 0 4px var(--tint)}

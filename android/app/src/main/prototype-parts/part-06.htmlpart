<script id="v948js">(function(){try{
var _p=window.loanPay;
if(_p)window.loanPay=function(ok){var r=_p.apply(this,arguments);
 var sh=document.querySelector('#layer .sheet');
 if(sh&&!ok&&typeof S!=='undefined'&&S.loan&&!sh.querySelector('.v948l')){
  var m=(sh.textContent||'').match(/This is instalment (\d+) of (\d+), due ([^.]+)\. (?:(.+?) will be left to repay|Your loan will be closed)/);
  var para=[].slice.call(sh.querySelectorAll('.mu')).filter(function(e){return /will leave itunda Bank/.test(e.textContent)})[0];
  if(m&&para){var d=document.createElement('div');d.className='v948l';
   var rows=[['Instalment',m[1]+' of '+m[2]],['Due',m[3]],['Left to repay after',m[4]?m[4]:'0 RWF']];
   d.innerHTML=rows.map(function(x){return '<div><span>'+x[0]+'</span><b>'+x[1]+'</b></div>'}).join('');
   para.replaceWith(d)}}
 return r};
var lay=document.getElementById('layer');
if(lay)new MutationObserver(function(){var sh=lay.querySelector('.sheet');
 if(!sh||sh.querySelector('.v945x,.v948x')||sh.querySelector('input,textarea,select'))return;
 var bt=sh.querySelectorAll('button');if(bt.length!==1||!bt[0].classList.contains('btn'))return;
 var b=document.createElement('button');b.className='v945x v948x';b.textContent='Not now';b.onclick=function(){closeSheet()};sh.appendChild(b)
}).observe(lay,{childList:true,subtree:true});
}catch(e){console.warn('v948',e)}})();
</script>
<style id="v949toss">/* v949, Toss-style pass 64. Send amount: the number is left-aligned under the question like Toss, one grey line says what is left, the quick-add chips sit right above the Send bar, and the number tints red when it is over the balance. */

  var bs=[].slice.call(seg.children).filter(function(x){return x.tagName==='BUTTON'});
  var on=seg.querySelector(':scope>button.on');if(bs.length!==p.n||!on||bs.indexOf(on)===p.from)continue;
  var cs=getComputedStyle(on),n=box(on),g=document.createElement('i');g.className='v24g';
  g.style.cssText='left:'+n.l+'px;top:'+n.t+'px;width:'+n.w+'px;height:'+n.h+'px;background:'+cs.backgroundColor+';border-bottom:'+cs.borderBottomWidth+' '+cs.borderBottomStyle+' '+cs.borderBottomColor+';border-radius:'+cs.borderRadius+';box-shadow:'+cs.boxShadow;
  seg.insertBefore(g,seg.firstChild);on.classList.add('v24h');pend=null;

#phone .mcl .mci::before{content:"";position:absolute;left:8px;top:11px;width:11px;height:8px;border-radius:2px;background:rgba(255,255,255,.55)}
#phone .mcl .mci::after{content:"";position:absolute;left:8px;right:8px;bottom:8px;height:3px;border-radius:2px;background:rgba(255,255,255,.35)}

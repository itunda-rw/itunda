  pts=v.map(function(x,i){return [i/(N-1)*VW,VH-(x-lo)/(hi-lo)*VH]});var d=smooth(pts);
  line.setAttribute('d',d);area.setAttribute('d',d+'L'+VW+' '+VH+'L0 '+VH+'Z')};

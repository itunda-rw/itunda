<style id="v926toss">
/* v926: Toss-style pass 53. Manage cards: roomy 72px rows with a 64x40 card face (chip detail), 17px names, a soft "Add a card" button. Daily challenge: a seven-day streak strip (done days filled, today outlined), a larger flame and heading. */
#phone .mcl{padding-top:8px}
#phone .mcl .mcr{display:flex;align-items:center;gap:16px;min-height:72px;padding:8px 0}

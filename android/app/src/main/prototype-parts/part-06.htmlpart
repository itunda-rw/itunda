 tn.forEach(t=>{const m=t.nodeValue.match(RX);if(!m)return;const i=m.index,d=document.createElement('i');d.className='tp-dot';d.style.background=C[m[1]];
  const after=document.createTextNode(t.nodeValue.slice(i+m[0].length));t.nodeValue=t.nodeValue.slice(0,i);t.parentNode.insertBefore(d,t.nextSibling);t.parentNode.insertBefore(after,d.nextSibling)});
 return R.innerHTML}catch(e){console.error('v990 route',e);return h}};
})()}catch(e){console.error('v990',e)}
</script>

#phone#phone #grpslot,#phone#phone #grpslot *,#phone#phone#phone .cta button,#phone#phone#phone .btn{font-family:"Toss Product Sans","Pretendard Variable",Pretendard,-apple-system,BlinkMacSystemFont,"Apple SD Gothic Neo","Noto Sans KR","Segoe UI",system-ui,sans-serif!important}

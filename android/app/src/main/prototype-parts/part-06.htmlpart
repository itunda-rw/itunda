const noEf=n=>{if(!n)return;n.querySelectorAll('.ef').forEach(x=>x.remove());const w=document.createTreeWalker(n,NodeFilter.SHOW_TEXT);let t,a=[];while(t=w.nextNode())a.push(t);a.forEach(t=>{EM.lastIndex=0;if(EM.test(t.nodeValue)){EM.lastIndex=0;t.nodeValue=t.nodeValue.replace(EM,'').replace(/^\s+/,'')}EM.lastIndex=0})};
const _m=screens.mapview;
if(_m)screens.mapview=function(){let h=String(_m.apply(this,arguments));
 return S.lang==='en'?h.replace('Search places, bus stops, addresses','Search places or stops'):h};
const _p=screens.place;
if(_p)screens.place=function(){const h=String(_p.apply(this,arguments));try{

#phone div:has(>.pz-stamp){padding:8px 0 0!important}
#phone .pz-stamp{margin:0 20px!important;border-radius:16px!important;background:var(--chip)!important;padding:14px 16px!important}
/* Places hub: filter chips sit together, left aligned */
#phone .nvf{display:flex!important;gap:8px!important;justify-content:flex-start!important;padding-left:24px!important;padding-right:24px!important}
#phone .nvf button{flex:none!important}
/* Directions route: flat card, tag is plain text, actions are text links */
#phone .rcd.on{border:0!important;box-shadow:none!important;background:none!important}
#phone .rtag{background:none!important;padding:0!important;color:var(--mu)!important;font-size:13px!important;font-weight:600!important}
#phone .rtag .ef{display:none!important}
#phone .rac button{background:none!important;box-shadow:none!important;padding:0 18px 0 0!important;height:36px!important;color:var(--mu)!important;font-size:14px!important;font-weight:600!important;flex:none}
#phone#phone .rac button.on,#phone#phone .rac button.on:active{background:none!important;color:var(--lk)!important}
#phone#phone .rsh .rcd{margin-left:0!important;margin-right:0!important;padding-left:24px!important;padding-right:24px!important}
#phone#phone .rac button{padding:0 18px 0 0!important;min-width:0!important;margin:0!important}
#phone .rac button .ef{display:none!important}
#phone .rac{padding-left:0!important}
#phone .stp .gof{display:none!important}
/* v986: walk and bike action row is one left-aligned line; place tabs (Photos, Nearby) on the 24px edge */
#phone#phone div[data-h44s].rac:has(.v420hit){padding-left:0!important;padding-right:28px!important;justify-content:flex-start!important;gap:0!important;flex-wrap:nowrap!important}
#phone#phone .nv-chips{padding-left:24px!important;padding-right:24px!important}
#phone#phone .nv-grid{padding-left:24px!important;padding-right:24px!important;box-sizing:border-box}
#phone#phone .screen:has(.nv-hero) .pl.tap{padding-left:24px!important;padding-right:24px!important}
/* v985: expanded place page on the same 24px edge as the sheet */
#phone#phone .nv-t,#phone#phone .nv-sec{padding-left:24px!important;padding-right:24px!important}
#phone#phone .nv-ob,#phone#phone .nv-cp{margin-left:0!important;margin-right:0!important}
#phone#phone .pz-stamp{margin:0 24px!important}
/* v984: car route shows no one-colour bar and no second, conflicting taxi price; reviews tab loses the grey band */
#phone .rsh .rbr:has(>i:only-child){display:none!important}
#phone .rsh .cf{display:none!important}
#phone#phone .chp{background:none!important}
#phone#phone .rvs{padding-left:24px!important;padding-right:24px!important;gap:8px!important}
#phone#phone .rvs button{height:36px!important;font-size:14px!important;font-weight:700!important}
#phone#phone .rsh .tf{margin-left:0!important;margin-right:0!important}
/* hubs: search, chip rows and travel modes share the 24px edge */
#phone#phone .mps{margin-left:24px!important;margin-right:24px!important;width:auto!important}
#phone#phone .plc{padding-left:24px!important}
#phone#phone .plc.md{padding-left:24px!important;padding-right:24px!important;gap:6px!important}
#phone#phone .plc.md button{flex:1 1 0!important;min-width:0!important;padding-left:8px!important;padding-right:8px!important}
#phone#phone .chp{padding-left:24px!important}
/* one 24px edge in the route sheet (it was 16, 24, 32, 36 and 40) */
#phone#phone .rsh{padding-left:0!important;padding-right:0!important}
#phone#phone .rsh .rtm,#phone#phone .rsh .ldn,#phone#phone .rsh .tup,#phone#phone .rsh .tgb,#phone#phone .rsh .stp{margin-left:24px!important;margin-right:24px!important}
#phone#phone .rsh .rac{padding-left:0!important;margin-left:0!important}
/* other routes: soft grey cards, tag is plain text */
#phone#phone .rsh .alt{margin:0 24px 10px!important;padding:16px!important;border:0!important;box-shadow:none!important;background:var(--chip)!important;border-radius:16px!important}
#phone#phone .rsh .alt .tg{background:none!important;padding:0!important;color:var(--mu)!important;font-size:13px!important;font-weight:600!important}
#phone#phone .rsh .alt .tg .ef{display:none!important}

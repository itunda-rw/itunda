<script id="v926js">(function(){try{
var L=['S','M','T','W','T','F','S'];
function run(){
 document.querySelectorAll('#phone .screen').forEach(function(sc){
  var h=sc.querySelector('.h1');
  if(!h||sc.dataset.dc926)return;
  var m=h.textContent.match(/^(\d+)-day streak$/);
  if(!m||sc.textContent.indexOf('Finish all three tasks')<0)return;
  sc.dataset.dc926=1;sc.classList.add('dc926');
  var n=Math.min(6,+m[1]),now=new Date(),html='';
  for(var i=6;i>=0;i--){var d=new Date(now);d.setDate(now.getDate()-i);
   var cls=i===0?'t':(i<=n?'d':'');
   html+='<div class="'+cls+'" style="--k:'+(6-i)+'"><i></i>'+L[d.getDay()]+'</div>'}
  var strip=document.createElement('div');strip.className='st926';strip.setAttribute('role','img');strip.setAttribute('aria-label',m[1]+' day streak');strip.innerHTML=html;
  var top=h.parentElement;top.parentElement.insertBefore(strip,top.nextSibling);
 })}
new MutationObserver(run).observe(document.documentElement,{childList:true,subtree:true});run();
var t=function(){document.title=document.title.replace(/v\d+/,'v926')};t();var n=0,iv=setInterval(function(){t();if(++n>14)clearInterval(iv)},500);

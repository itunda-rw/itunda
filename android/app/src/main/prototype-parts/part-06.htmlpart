  const poi=(window.POI||[]).find(x=>x.n===(window.PL&&PL.n));
  if(poi&&/^(cafe|food|pharm|hosp)$/.test(poi.c)){const b=document.createElement('button');b.className='pz980';b.setAttribute('onclick','window.plPay&&plPay()');b.textContent=tl('Pay here','Ishyura hano','Payer ici');mn.appendChild(b)}
  np0.parentNode.insertBefore(mn,np0)}
 const cpn=sh.querySelector('.cpn'),oah=sh.querySelector('.oah'),own=sh.querySelector('.own');

   const go=b?b.getAttribute('onclick'):"openShop('eats')";
   oah.innerHTML='<button class="tp-or" onclick="'+go+'"><div>'+tl('Order ahead','Tayari gutumiza','Commander à l’avance')+(note?'<small>'+note.replace(/</g,'&lt;')+'</small>':'')+'</div></button>';
   w.appendChild(oah)}

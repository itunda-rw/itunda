#phone#phone#phone .tp-offers>.cpn,#phone#phone#phone .tp-offers>.oah{margin:0!important;padding:14px 0!important;background:none!important;border:0!important;border-radius:0!important;box-shadow:none!important;display:flex!important;align-items:center;gap:12px}
#phone#phone#phone .tp-offers>.cpn>span{flex:1;min-width:0;font-size:15px!important;font-weight:700!important;color:var(--tx)!important;line-height:22px}
#phone#phone#phone .tp-offers>.cpn small{display:block;margin-top:2px;font-size:13px!important;font-weight:500!important;color:var(--mu)!important}
#phone#phone#phone .tp-offers>.cpn button{flex:none;height:36px;border:0;border-radius:18px;padding:0 16px;font-size:14px;font-weight:700}
#phone#phone#phone .tp-offers .tp-or{width:100%;border:0!important;background:none!important;padding:0!important;display:flex;align-items:center;gap:12px;text-align:left;font:inherit;color:var(--tx)!important}

#phone .screen .v945rows{margin:28px 24px 0!important;padding:0!important;background:none!important;border-radius:0!important}
#phone .screen .v945rows>div{height:56px!important;font-size:15px!important;gap:16px}
#phone .screen .v945rows>div>b{font-size:16px;font-weight:700;text-align:right}
#phone .screen .v945rows>div:first-child{height:auto!important;min-height:60px;padding:14px 16px!important;margin-bottom:8px;border-radius:16px;background:var(--tint)}
#phone .screen .v945rows>div:first-child>span{color:var(--tintfg)!important;font-weight:600}
#phone .screen .v945rows>div:first-child>b{color:var(--tintfg);font-size:17px}
#phone .screen .v945rows+.fine{padding-top:20px!important}
#layer .sheet .v945x{display:block;width:100%;height:52px;margin-top:8px;border:0;border-radius:16px;background:none;color:var(--mu);font:inherit;font-size:16px;font-weight:600}
#layer .sheet .v945x:active{background:var(--chip);transform:scale(.98)}
</style>
<script id="v945js">(function(){try{

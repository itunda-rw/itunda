<style id="v1022css">
/* v1022: Invest charts, Toss style. Price lines are smooth curves that draw themselves in, a pulsing live dot marks the latest price, a dot follows your finger while you scrub, and the market index card gets its own chart with 1D / 1W / 1M / 3M / 1Y that morphs between ranges. Solid fills only. */
#phone .v22d,#phone .v22l{position:absolute;left:0;top:0;width:12px;height:12px;border-radius:50%;background:var(--c,var(--ok));border:3px solid var(--bg);box-sizing:content-box;margin:-9px 0 0 -9px;pointer-events:none;z-index:2}
#phone .v22d{display:none}
#phone .v22d.on{display:block;animation:v22in .22s cubic-bezier(.2,.9,.3,1.5)}
#phone .v22l{width:8px;height:8px;border-width:2px;margin:-6px 0 0 -6px;opacity:0;transition:opacity .3s .7s}
#phone .v22l.on{opacity:1}
#phone .v22l::after{content:"";position:absolute;inset:-2px;border-radius:50%;background:var(--c,var(--ok));opacity:.35}
@media (prefers-reduced-motion:no-preference){#phone .v22l::after{animation:v22p 1.7s ease-out infinite}}
@keyframes v22p{0%{transform:scale(1);opacity:.4}100%{transform:scale(3);opacity:0}}
@keyframes v22in{from{transform:scale(.3)}to{transform:none}}
#phone .v22i{margin:10px -6px 0;position:relative;touch-action:pan-y;user-select:none;-webkit-user-select:none}
#phone .v22i svg{display:block;width:100%;height:112px;overflow:visible}
#phone .v22cap{position:absolute;left:6px;top:-2px;font-size:12px;font-weight:700;color:var(--mu);pointer-events:none;opacity:0;transition:opacity .15s}
#phone .v22i.sc .v22cap{opacity:1}
#phone .v22tabs{display:flex;justify-content:space-between;gap:4px;margin-top:8px}
#phone .v22t{flex:1;height:34px;border:0;border-radius:17px;background:transparent;color:var(--mu);font-size:13px;font-weight:800;transition:background .2s,color .2s,transform .24s cubic-bezier(.2,.9,.3,1.45)}
#phone .v22t[aria-pressed=true]{background:var(--tx);color:var(--bg)}
#phone .v22t:active{transform:scale(.92)}
</style><script id="v1022js">

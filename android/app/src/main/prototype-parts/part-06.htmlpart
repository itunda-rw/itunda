function ref(){return 'IT-'+String(Math.floor(10000+Math.random()*89999))+'-'+Math.floor(1+Math.random()*9)}

/* ---------- Invite a friend ---------- */
S.inv9=S.inv9||{joined:0};
function invitePage(old){var j=S.inv9.joined,goal=3,pct=Math.round(Math.min(j,goal)/goal*100);
 var steps=[['Share your code','Send your code or link to a friend.'],['They send a first payment','Your friend joins itunda and pays someone.'],['You both get 500 RWF','The reward lands in itunda Pay right away.']].map(function(x,i){return '<div class="iv9-st"><b class="n">'+(i+1)+'</b><div><div class="t">'+x[0]+'</div><div class="s">'+x[1]+'</div></div></div>'}).join('');
 return bar(old,'Invite a friend')+'<div class="pad" style="padding-top:12px"><div class="h1">Invite friends,<br>you both get 500 RWF</div></div>'
 +'<div class="iv9-c"><div class="iv9-l">Your code</div><div class="iv9-code">AMINA-K7</div><button class="iv9-cp tap" onclick="iv9Copy()">Copy code</button></div>'
 +'<div class="pad" style="padding-top:28px"><div class="iv9-h">Friends joined<span>'+j+' of '+goal+'</span></div><div class="iv9-bar" role="progressbar" aria-valuemin="0" aria-valuemax="'+goal+'" aria-valuenow="'+Math.min(j,goal)+'"><i style="width:'+pct+'%"></i></div>'
 +'<div class="mu" style="font-size:15px;margin-top:10px">'+(j?'You earned <b style="color:var(--tx)">'+f(j*500)+' RWF</b> so far.':'Invite friends to start earning.')+'</div></div>'
 +'<div class="pad" style="padding-top:26px"><div class="iv9-h">How it works</div><div style="margin-top:6px">'+steps+'</div><div class="fine" style="padding-top:14px">Sample reward for this prototype. No real money moves.</div></div>'
 +cta(btn('Share invite link','iv9Share()')+'<button class="btn sec2" style="margin-top:8px" onclick="iv9Join()">Prototype: a friend joined</button>').replace('height:150px','height:200px');}
window.iv9Copy=function(){try{navigator.clipboard&&navigator.clipboard.writeText('AMINA-K7')}catch(e){}toast('Code copied')};
window.iv9Share=function(){var o=[['Messages','#34C759','M'],['WhatsApp','#25D366','W'],['Copy link','#8F89FF','L']].map(function(x){return '<button class="iv9-o tap" onclick="iv9Pick(\''+x[0]+'\')"><i style="background:'+x[1]+'">'+x[2]+'</i>'+x[0]+'</button>'}).join('');
 sheet('<div class="h1" style="font-size:22px;line-height:30px">Share invite link</div><div style="margin-top:8px">'+o+'</div>')};
window.iv9Pick=function(n){closeSheet();toast(n==='Copy link'?'Link copied':'Invite ready in '+n)};
window.iv9Join=function(){S.inv9.joined++;S.pay=(S.pay||0)+500;try{confetti()}catch(e){}render('fade-none');toast('A friend joined. +500 RWF in itunda Pay')};

/* ---------- USSD access ---------- */
var MENU='itunda\n1 Balance\n2 Send money\n3 Buy airtime\n4 Pay bill\n0 Exit';
function us(){return S.us9||(S.us9={inp:'',scr:'Dial the code to open the menu.',stage:'dial',d:{}})}
function ussdPage(old){var u=us(),act=u.stage==='dial'?'Call':'Send';
 var keys=['1','2','3','4','5','6','7','8','9','*','0','#'].map(function(k){return '<button class="us9-k tap" aria-label="'+k+'" onclick="us9Key(\''+k+'\')">'+k+'</button>'}).join('');
 return bar(old,'USSD access')+'<div class="pad" style="padding-top:12px"><div class="h1">Try it, no data needed</div><div class="mu" style="font-size:16px;line-height:24px;margin-top:10px">This is how itunda looks on any basic phone.</div></div>'
 +'<div class="us9-ph"><div class="us9-s" aria-live="polite">'+u.scr.replace(/&/g,'&amp;').replace(/</g,'&lt;')+'<div class="us9-in">'+u.inp.replace(/</g,'&lt;')+'</div></div>'
 +'<div class="us9-g">'+keys+'<button class="us9-k tap" aria-label="Delete" onclick="us9Del()">&#9003;</button><button class="us9-k go tap" onclick="us9Go()">'+act+'</button></div></div>'
 +'<div class="pad" style="display:flex;gap:8px;padding-top:14px">'+(u.stage==='dial'?'<button class="chip tap" onclick="us9Fill()">Type *182*7# for me</button>':'')+'<button class="chip tap" onclick="us9Reset()">Start over</button></div>'
 +cta(btn('Copy code *182*7#','us9Copy()'));}
function usSet(stage,scr,d){var u=us();u.stage=stage;u.scr=scr;u.inp='';if(d)u.d=d}
window.us9Key=function(k){var u=us();if(u.inp.length<14){u.inp+=k;render('fade-none')}};
window.us9Del=function(){var u=us();u.inp=u.inp.slice(0,-1);render('fade-none')};
window.us9Fill=function(){us().inp='*182*7#';render('fade-none')};
window.us9Reset=function(){S.us9=null;render('fade-none')};
window.us9Copy=function(){try{navigator.clipboard&&navigator.clipboard.writeText('*182*7#')}catch(e){}toast('Code copied')};
window.us9Go=function(){var u=us(),v=u.inp,s=u.stage,n;
 if(s==='dial'){if(v==='*182*7#')usSet('menu',MENU);else{u.scr='Invalid code.\nTry *182*7#';u.inp=''}}
 else if(s==='menu'){if(v==='1')usSet('info','Balance\n'+f(S.bank)+' RWF\n\n0 Back');
  else if(v==='2')usSet('to','Send money\nEnter phone number:');
  else if(v==='3')usSet('air','Buy airtime\nEnter amount (RWF):');
  else if(v==='4')usSet('info','Pay bill\nPay bills in the app in this prototype.\n\n0 Back');
  else if(v==='0')S.us9=null;
  else{u.scr='Invalid choice\n'+MENU;u.inp=''}}
 else if(s==='info'){if(v==='0')usSet('menu',MENU);else u.inp=''}
 else if(s==='to'){if(v.replace(/\D/g,'').length>=9)usSet('amt','Send to '+v+'\nAmount (RWF):',{to:v});else{u.scr='Send money\nEnter a full phone number:';u.inp=''}}
 else if(s==='amt'){n=+v;if(n>0&&n<=S.bank)usSet('ok','Send '+f(n)+' RWF to '+u.d.to+'?\n1 Yes\n2 No',{to:u.d.to,n:n});
  else{u.scr=(n>S.bank?'Not enough money.\n':'')+'Amount (RWF):';u.inp=''}}
 else if(s==='ok'){if(v==='1'){S.bank-=u.d.n;usSet('info','Sent '+f(u.d.n)+' RWF\nto '+u.d.to+'.\nRef '+ref()+'\n\n0 Menu')}else usSet('menu',MENU)}
 else if(s==='air'){n=+v;if(n>0&&n<=S.bank){S.bank-=n;usSet('info','Airtime of '+f(n)+' RWF\nbought.\n\n0 Menu')}else{u.scr='Buy airtime\n'+(n>S.bank?'Not enough money.\n':'')+'Enter amount (RWF):';u.inp=''}}
 render('fade-none')};

/* ---------- Bike rental ---------- */
var VEH=[{n:'Bike',r:20,e:'<svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="6" cy="16.5" r="3.5"/><circle cx="18" cy="16.5" r="3.5"/><path d="M6 16.5l3.5-7h5l3.5 7M9.5 9.5L8.5 7H7M14.5 9.5L13.7 7H16"/></svg>'},{n:'E-scooter',r:50,e:'<svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="6" cy="18" r="2.5"/><circle cx="18" cy="18" r="2.5"/><path d="M6 18h6l4-12h2M12 18l1.5-5"/></svg>'}];
function bk(){return st('bike')}
function bikePage(old){var b=bk(),i=b.i,v=VEH[b.veh||0];
 if(i===0){var tiles=VEH.map(function(x,j){return '<button class="tap'+((b.veh||0)===j?' on':'')+'" aria-pressed="'+((b.veh||0)===j)+'" onclick="bk9Pick('+j+')"><div class="e">'+x.e+'</div><b>'+x.n+'</b><span>'+x.r+' RWF / min</span></button>'}).join('');
  var st=[['Kimironko Market','120 m','6 bikes, 3 e-scooters'],['Kimironko bus park','340 m','4 bikes, 1 e-scooter'],['Remera Taxi Park','610 m','8 bikes, 5 e-scooters']].map(function(x){return '<div class="iv9-st" style="align-items:center"><b class="n" style="flex-basis:44px;height:44px">&#128205;</b><div style="flex:1"><div class="t">'+x[0]+'</div><div class="s">'+x[2]+'</div></div><b style="font-size:15px;color:var(--mu)">'+x[1]+'</b></div>'}).join('');
  return bar(old,'Bike rental')+'<div class="pad" style="padding-top:12px"><div class="h1">Rent by the minute</div><div class="mu" style="font-size:16px;margin-top:8px">Pick a ride, scan the QR code, go.</div></div><div class="bk9-v">'+tiles+'</div>'
   +'<div class="pad" style="padding-top:26px"><div class="iv9-h">Nearby</div><div style="margin-top:6px">'+st+'</div><div class="fine" style="padding-top:8px">Paid from itunda Pay · '+f(S.pay)+' RWF. Sample prices. No real money moves.</div></div>'+cta(btn('Scan to unlock','bk9Go(1)'))}
 if(i===1)return bar(old,'Scan to unlock')+'<div class="pad" style="padding-top:12px"><div class="h1">Scan the QR code<br>on the handlebar</div></div><div class="bk9-q" role="img" aria-label="Camera viewfinder"></div><div class="mu" style="text-align:center;margin-top:18px;font-size:15px">Hold your phone steady over the code.</div>'+cta(btn('Simulate scan','bk9Go(2)')+'<button class="btn sec2" style="margin-top:8px" onclick="bk9Go(2)">Enter code instead</button>').replace('height:150px','height:200px');
 if(i===2)return bar(old,'Unlock')+'<div class="pad" style="padding-top:12px"><div class="h1">Enter this code<br>on the lock</div><div class="mu" style="font-size:16px;margin-top:8px">Then pull the lock open. '+v.n+' · '+v.r+' RWF / min.</div></div><div class="bk9-d" aria-label="Code 4 8 2 1"><i>4</i><i>8</i><i>2</i><i>1</i></div>'+cta(btn('It is unlocked, start ride','bk9Go(3)'));
 if(i===3){return bar(old,'Riding')+'<div class="pad" style="padding-top:20px;text-align:center"><div class="mu" style="font-size:15px;font-weight:600">'+v.n+' · '+v.r+' RWF / min</div><div class="bk9-t" id="bk9t">00:00</div><div style="font-size:22px;font-weight:800;margin-top:6px"><span id="bk9c">'+v.r+'</span> RWF</div><div class="fine" style="margin-top:12px">Demo speed: one second here is thirty seconds on the road.</div></div>'
  +'<div class="pg21-f"><div><span class="mu">Paid from</span><b>itunda Pay</b></div><div><span class="mu">Rate</span><b>'+v.r+' RWF / min</b></div></div>'+cta(btn('Lock and finish','bk9Go(4)'))}
 var cost=b.cost,min=b.min;
 return '<div class="pad" style="display:flex;flex-direction:column;align-items:center;padding-top:clamp(40px,14vh,160px)"><div class="g3">'+gl('success3d',120)+'</div><div class="h1" style="margin-top:24px;font-size:34px;line-height:42px">'+f(cost)+' RWF</div><div class="mu" style="font-size:16px;margin-top:8px">Ride finished, '+min+' min</div></div>'
  +'<div class="pg21-f" style="margin-top:36px"><div><span class="mu">Vehicle</span><b>'+v.n+'</b></div><div><span class="mu">Rate</span><b>'+v.r+' RWF / min</b></div><div><span class="mu">Paid from</span><b>itunda Pay</b></div><div><span class="mu">Reference</span><b>'+b.ref+'</b></div></div>'+cta(btn('Done','done()'))}
window.bk9Pick=function(j){bk().veh=j;render('fade-none')};
window.bk9Go=function(i){var b=bk();
 if(i===3)b.t0=Date.now();
 if(i===4){var v=VEH[b.veh||0],secs=(Date.now()-b.t0)/1000*30;b.min=Math.max(1,Math.ceil(secs/60));b.cost=b.min*v.r;S.pay=Math.max(0,(S.pay||0)-b.cost);b.ref=ref();try{confetti()}catch(e){}}
 b.i=i;render('push')};
setInterval(function(){var b=S.p9&&S.p9.bike;if(!b||b.i!==3)return;var t=document.getElementById('bk9t'),c=document.getElementById('bk9c');if(!t||!c)return;
 var secs=Math.floor((Date.now()-b.t0)/1000*30),m=Math.floor(secs/60),s=secs%60,v=VEH[b.veh||0];
 t.textContent=(m<10?'0':'')+m+':'+(s<10?'0':'')+s;c.textContent=f(Math.max(1,Math.ceil(secs/60))*v.r)},500);

/* ---------- hooks ---------- */
var MY={invite:invitePage,ussd:ussdPage,bike:bikePage};
var _svc2=screens.svc;
screens.svc=function(){var k=S.svk;var h=_svc2.apply(this,arguments);
 if(MY[k]&&on(k)){try{return MY[k](h)}catch(e){console.warn('v927',e)}}
 return h};
var _os2=window.openSvc;
window.openSvc=function(k){if(MY[k]){S.p9[k]={i:0};if(k==='ussd')S.us9=null}return _os2.apply(this,arguments)};
var _bk2=window.back;
window.back=function(){var t=S.stack&&S.stack[S.stack.length-1],k=S.svk;
 if(t==='svc'&&MY[k]&&on(k)&&k==='bike'){var b=bk();
  if(b.i===3){toast('Lock the bike to finish your ride');return}
  if(b.i===4){b.i=0;return _bk2.apply(this,arguments)}
  if(b.i>0){b.i--;render('pop');return}}
 return _bk2.apply(this,arguments)};
var t=function(){document.title=document.title.replace(/v\d+/,'v927')};t();var n=0,iv=setInterval(function(){t();if(++n>14)clearInterval(iv)},500);
}catch(e){console.warn('v927',e)}})();
</script>

<script>
/* toss-ux v2 */
(function(){try{
var t=document.createElement('div');t.id='t-toast';t.setAttribute('role','status');t.setAttribute('aria-live','polite');
document.addEventListener('DOMContentLoaded',function(){document.body.appendChild(t)});
var tm;window.tossToast=function(m,ms){t.textContent=m;t.classList.add('on');clearTimeout(tm);tm=setTimeout(function(){t.classList.remove('on')},ms||2200)};
window.tossLoading=function(el,ms){if(!el)return;el.setAttribute('data-loading','');setTimeout(function(){el.removeAttribute('data-loading')},ms||900)};
document.addEventListener('click',function(e){var b=e.target.closest&&e.target.closest('.btn,.cta,.chip');if(b&&navigator.vibrate)navigator.vibrate(8)},true);
document.addEventListener('focusin',function(e){var el=e.target;if(/^(INPUT|TEXTAREA)$/.test(el.tagName))setTimeout(function(){el.scrollIntoView({block:'center',behavior:'smooth'})},300)});
var h=document.querySelector('header,.nav,.hd,.bar');if(h){addEventListener('scroll',function(){h.classList.toggle('t-edge',scrollY>4)},{passive:true})}
}catch(e){}})();
</script>
<script>
/* toss-ux v3: transitions, count-up, action feedback */
(function(){try{
var T=document.title||'';
var root=function(){return document.getElementById('app')||document.getElementById('main')||document.querySelector('main')};
function push(){var r=root();if(!r)return;r.classList.remove('t-in');void r.offsetWidth;r.classList.add('t-in');window.scrollTo&&window.scrollTo({top:0})}
['go','V','goWork'].forEach(function(n){var f=window[n];if(typeof f!=='function'||f.__t)return;
 var w=function(){var x=f.apply(this,arguments);push();return x};w.__t=1;window[n]=w});
var pend=0;
function scan(){pend=0;var r=root();if(!r)return;
 r.querySelectorAll('.big').forEach(function(el){
  if(el.children.length||el.dataset.cu)return;
  var tx=el.textContent.trim(),m=tx.match(/^([^\d\-]*)(-?[\d,]+(?:\.\d+)?)(.*)$/);
  if(!m||el.dataset.tv===tx)return;
  el.dataset.tv=tx;
  var to=parseFloat(m[2].replace(/,/g,'')),dec=(m[2].split('.')[1]||'').length;
  if(!isFinite(to)||Math.abs(to)<10||matchMedia('(prefers-reduced-motion:reduce)').matches)return;
  el.dataset.cu=1;var t0=performance.now(),d=550;
  (function step(t){var p=Math.min(1,(t-t0)/d),e=1-Math.pow(1-p,3),v=to*e;
   el.textContent=m[1]+v.toLocaleString('en-US',{minimumFractionDigits:dec,maximumFractionDigits:dec})+m[3];
   if(p<1)requestAnimationFrame(step);else{el.textContent=tx;delete el.dataset.cu}})(t0);
 })}
function sched(recs){if(recs&&recs.every(function(r){return r.target.closest&&r.target.closest('[data-cu]')}))return;if(!pend){pend=1;requestAnimationFrame(scan)}}
document.addEventListener('DOMContentLoaded',function(){var r=root();if(!r)return;new MutationObserver(sched).observe(r,{childList:true,subtree:true});sched();push()});
/* action feedback (POS) */
if(/POS/.test(T)){var M=[[/^Accept/,'Order accepted'],[/^Order ready/,'Marked as ready'],[/^Complete order/,'Order completed'],[/^Close shift/,'Shift closed'],[/^Reject/,'Order rejected']];
 document.addEventListener('click',function(e){var b=e.target.closest&&e.target.closest('button,.cta');if(!b)return;var s=b.textContent.trim();
  for(var i=0;i<M.length;i++)if(M[i][0].test(s)){window.tossToast&&window.tossToast(M[i][1]);break}})}
/* Business: ad submit */
if(typeof window.submitAd==='function'){var sa=window.submitAd;window.submitAd=function(){var x=sa.apply(this,arguments);window.tossToast&&window.tossToast('Ad submitted');return x}}
}catch(e){}})();
</script>
<script>
/* toss-ux v5: pending state on commit actions */
(function(){try{
var N=["payOrder", "paySplit", "billPay", "ePay", "shopPay", "stkBuy", "stkSell", "giftSend", "doBuy", "doSell"];
N.forEach(function(n){var f=window[n];if(typeof f!=='function'||f.__l)return;
 var w=function(){var self=this,a=arguments,ev=window.event,b=ev&&ev.target&&ev.target.closest?ev.target.closest('button,.cta,.btn'):null;
  if(!b||!document.contains(b))return f.apply(self,a);
  if(b.hasAttribute('data-loading'))return;
  b.setAttribute('data-loading','');
  setTimeout(function(){b.removeAttribute('data-loading');f.apply(self,a)},650)};
 w.__l=1;window[n]=w});
}catch(e){}})();
</script>
<style id="v929">
/* v929: Profile photo. Before: the profile screen showed only a letter in a circle and could not be changed. Now: tap the photo (it has a + badge) to open "Choose profile photo": a large live preview, Camera and Gallery buttons, a swipeable grid of 24 characters with page dots, and Clear / Save. Save stays off until something changes. */
#phone .pf9-av{position:relative;width:88px;height:88px;border:0;padding:0;background:none;cursor:pointer;border-radius:50%}
#phone .pf9-av .pf9-c{width:100%;height:100%;border-radius:50%;display:flex;align-items:center;justify-content:center;overflow:hidden;background-size:cover;background-position:center}
#phone .pf9-av .pf9-plus{position:absolute;right:-2px;bottom:-2px;width:28px;height:28px;border-radius:50%;background:var(--lk);color:#fff;display:flex;align-items:center;justify-content:center;font-size:20px;line-height:1;border:3px solid var(--bg);font-weight:700}
#phone .pf9-av:focus-visible,#phone .pf9-g button:focus-visible{outline:2px solid var(--br);outline-offset:3px}
#phone .pf9-prev{width:132px;height:132px;border-radius:50%;margin:8px auto 22px;display:flex;align-items:center;justify-content:center;font-size:64px;font-weight:800;overflow:hidden;background-size:cover;background-position:center;transition:background-color .2s}
#phone .pf9-prev span{display:block;animation:pf9pop .28s var(--spring,ease-out)}
@keyframes pf9pop{0%{transform:scale(.6);opacity:0}100%{transform:scale(1);opacity:1}}
#phone .pf9-g{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;margin:0 -4px}
#phone .pf9-g::-webkit-scrollbar{display:none}
#phone .pf9-p{flex:0 0 100%;scroll-snap-align:start;display:grid;grid-template-columns:repeat(5,1fr);gap:14px 0;justify-items:center;padding:4px}
#phone .pf9-g button{width:54px;height:54px;border-radius:50%;border:0;padding:0;font-size:28px;display:flex;align-items:center;justify-content:center;background:var(--chip);color:var(--tx);cursor:pointer;box-shadow:0 0 0 0 var(--lk);transition:box-shadow .15s,transform .15s}
#phone .pf9-g button:active{transform:scale(.92)}
#phone .pf9-g button[aria-pressed=true]{box-shadow:0 0 0 3px var(--bg),0 0 0 5px var(--lk)}
#phone .pf9-dots{display:flex;justify-content:center;gap:8px;margin:16px 0 20px}
#phone .pf9-dots i{width:7px;height:7px;border-radius:50%;background:var(--ln);transition:background .15s}
#phone .pf9-dots i.on{background:var(--lk)}
#phone .pf9-ft{display:flex;gap:10px}
#phone .pf9-ft .btn{flex:1;margin:0!important;padding:0!important;height:56px!important;min-height:0!important;display:flex;align-items:center;justify-content:center}
#phone .pf9-ft .btn.sec{background:var(--tint)!important;color:var(--tintfg)!important}
#phone .pf9-ft .btn:disabled{opacity:.45}
@media (prefers-reduced-motion:reduce){#phone .pf9-prev span{animation:none}}
</style>
<script id="v929js">try{(function(){
if(typeof screens==='undefined'||typeof S==='undefined'||!screens.profile)return;
const T={rw:{'Choose profile photo':'Hitamo ifoto y’umwirondoro','Camera':'Kamera','Gallery':'Galeri','Clear':'Siba','Save':'Bika','Profile photo updated':'Ifoto yavuguruwe','Change profile photo':'Hindura ifoto'},fr:{'Choose profile photo':'Choisir une photo de profil','Camera':'Appareil photo','Gallery':'Galerie','Clear':'Effacer','Save':'Enregistrer','Profile photo updated':'Photo de profil mise à jour','Change profile photo':'Changer la photo'}};
const q=k=>(T[S.lang]&&T[S.lang][k])||k;
const A=[['💙','#3B4F73'],['🦭','#35566B'],['😎','#6E5F12'],['🐰','#5C5584'],['👽','#2F5A1E'],['🦦','#1F4A66'],['💣','#4A4E57'],['🔥','#3A5170'],
['🐼','#4A4F5C'],['🦁','#7A5A14'],['🦊','#8A4A1E'],['🐸','#2E6A3A'],['🦉','#5A4636'],['🐧','#2B4D6B'],['🐙','#7A3A66'],['🌈','#4B4A8A'],
['🚀','#33406B'],['⭐','#7A6414'],['🍀','#2A6A44'],['🎧','#5A3A7A'],['🐳','#1F5A7A'],['🍉','#7A2F3A'],['⚽','#3F4A55'],['🌙','#3A3A6B']];
S.pfa=S.pfa||null;
const initial=()=>((S.name||'Amina Uwase').trim()[0]||'?').toUpperCase().replace(/[<>&]/g,'');
const inner=v=>v&&v.img?'':v&&v.e?`<span>${v.e}</span>`:`<span>${initial()}</span>`;
const sty=v=>v&&v.img?`background-image:url(${v.img})`:v&&v.e?`background-color:${v.bg}`:'background-color:var(--tint);color:var(--tintfg)';
const _p=screens.profile;
screens.profile=function(){
 const h=_p.apply(this,arguments),v=S.pfa;
 return h.replace(/<div style="display:flex;justify-content:center;padding-top:28px"><div [^>]*id="pav">[\s\S]*?<\/div><\/div>/,
  `<div style="display:flex;justify-content:center;padding-top:28px"><button class="pf9-av" aria-label="${q('Change profile photo')}" onclick="pfOpen()"><div class="pf9-c" id="pav" style="${sty(v)};font-size:${v&&v.e?42:34}px;font-weight:800">${inner(v)}</div><span class="pf9-plus" aria-hidden="true">+</span></button></div>`);
};
const _pn=window.pName;
window.pName=function(val){const a=document.getElementById('pav'),keep=S.pfa;const r=_pn.apply(this,arguments);if(keep&&a)a.innerHTML=inner(keep);return r};
const paint=()=>{
 const d=S.pfd,pv=document.getElementById('pf9prev'),sv=document.getElementById('pf9save');if(!pv)return;
 pv.setAttribute('style',sty(d));pv.innerHTML=inner(d);
 document.querySelectorAll('#layer .pf9-g [data-i]').forEach(b=>b.setAttribute('aria-pressed',String(!!d&&d.i==b.dataset.i)));
 if(sv)sv.disabled=JSON.stringify(d||null)===JSON.stringify(S.pfa||null);
};
window.pfOpen=function(){
 S.pfd=S.pfa?Object.assign({},S.pfa):null;
 const cam=`<button aria-label="${q('Camera')}" onclick="document.getElementById('pf9cam').click()"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8h3l1.5-2h7L17 8h3v11H4z"/><circle cx="12" cy="13" r="3.5"/></svg></button>`,gal=`<button aria-label="${q('Gallery')}" onclick="document.getElementById('pf9gal').click()"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="3"/><circle cx="9" cy="9.5" r="1.5"/><path d="M5 18l5-5 3 3 2-2 4 4"/></svg></button>`;
 const B=i=>`<button data-i="${i}" aria-label="${A[i][0]}" aria-pressed="false" onclick="pfPick(${i})">${A[i][0]}</button>`,R=(x,y)=>Array.from({length:y-x},(_,k)=>B(x+k)).join('');
 const pages=[`${cam}${R(0,4)}${gal}${R(4,8)}`,R(8,18),R(18,24)].map(h=>`<div class="pf9-p">${h}</div>`).join('');
 document.getElementById('layer').innerHTML=`<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet bs464" role="dialog" aria-label="${q('Choose profile photo')}"><div class="bsh"></div><div class="h1" style="font-size:22px;line-height:30px;margin-bottom:12px">${q('Choose profile photo')}</div><div class="pf9-prev" id="pf9prev"></div><div class="pf9-g" id="pf9g" onscroll="pfDots()">${pages}</div><div class="pf9-dots" id="pf9d"><i class="on"></i><i></i><i></i></div><div class="pf9-ft"><button class="btn sec" onclick="pfClear()">${q('Clear')}</button><button class="btn" id="pf9save" disabled onclick="pfSave()">${q('Save')}</button></div><input type="file" accept="image/*" capture="user" id="pf9cam" hidden onchange="pfFile(this)"><input type="file" accept="image/*" id="pf9gal" hidden onchange="pfFile(this)"></div>`;
 paint();
};
window.pfPick=i=>{S.pfd={i:String(i),e:A[i][0],bg:A[i][1]};paint()};
window.pfClear=()=>{S.pfd=null;paint()};
window.pfDots=()=>{const g=document.getElementById('pf9g');if(!g)return;const n=Math.round(g.scrollLeft/g.clientWidth);document.querySelectorAll('#pf9d i').forEach((d,k)=>d.classList.toggle('on',k===n))};
window.pfFile=inp=>{const f=inp.files&&inp.files[0];if(!f)return;if(f.size>8e6){toast('Photo is too large');return}
 const r=new FileReader();r.onload=()=>{S.pfd={img:r.result};paint()};r.readAsDataURL(f)};
window.pfSave=()=>{S.pfa=S.pfd||null;closeSheet();toast(q('Profile photo updated'));render('fade-none')};
})();}catch(e){console.error(e)}
</script>
<style id="v930">
/* v930: Home top banner behaves like the Toss Bank one. One slot directly under the app bar, one banner at a time: a small "send to copied account" card when you have just copied an account or phone number, otherwise a large promo card (art, two-line headline with a coloured part, full-width button, round close chip). */
#phone #sc.h9 .hc.b930{padding:0!important;margin:6px 14px 0!important;overflow:hidden;position:relative}
.b930 .bi{width:52px;height:52px;border-radius:26px;background:#6960F9;color:#fff;display:flex;align-items:center;justify-content:center;flex:none}
.b930 .bi svg{stroke:#fff}
.b930 .bx{position:relative;width:44px;height:44px;border:0;background:none;color:var(--tt);display:flex;align-items:center;justify-content:center;flex:none;cursor:pointer}
.b930c{display:flex;align-items:center}
.b930c .bt{flex:1;min-width:0;display:flex;align-items:center;gap:14px;padding:20px 4px 20px 20px;border:0;background:none;text-align:left;color:var(--tx);cursor:pointer;font-family:inherit}
.b930c .bn{flex:1;min-width:0}
.b930c small{display:block;font-size:16px;line-height:22px;color:var(--mu);font-weight:500}
.b930c b{display:block;font-size:22px;line-height:30px;letter-spacing:-.5px;color:var(--lk);font-weight:800;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.b930c .bx{margin-right:12px}
.b930p .bgo{cursor:pointer;display:block}
.b930p .art{position:relative;height:164px;overflow:hidden}
.b930p .art::before{content:"";position:absolute;inset:0;background:radial-gradient(60% 85% at 66% 62%,var(--tint) 0%,rgba(0,0,0,0) 72%)}
.b930p .tiles{position:absolute;left:20px;right:20px;top:24px;display:grid;grid-template-columns:repeat(5,1fr);gap:10px}
.b930p .tiles i{display:block;aspect-ratio:1;border-radius:16px;background:var(--chip)}
.b930p .tiles i:nth-child(-n+5){opacity:.6}
.b930p .tiles i.hi{background:#6960F9;display:flex;align-items:center;justify-content:center;box-shadow:0 10px 30px rgba(105,96,249,.38)}
.b930p .tiles i.hi svg{stroke:#fff}
.b930p .tx{padding:6px 20px 0;font-size:24px;line-height:32px;font-weight:700;letter-spacing:-.6px;color:var(--tx)}
.b930p .tx em{font-style:normal;color:var(--lk)}
.b930p .go{display:block;width:calc(100% - 40px);height:56px;margin:20px 20px 20px;border:0;border-radius:18px;background:#6960F9;color:#fff;font-family:inherit;font-size:17px;font-weight:700;letter-spacing:-.3px;cursor:pointer}
.b930p .bx{position:absolute;top:12px;right:12px}
.b930p .bx::before{content:"";position:absolute;width:32px;height:32px;border-radius:16px;background:var(--chip)}
.b930p .bx svg{position:relative}
</style>
<script>
/* v930: logic. Queue: copied account or number first, then one campaign per app start (invite, QR cashback, daily saving). Closing a banner folds it away and the cards slide up; it stays closed for the day, and the next start shows the next campaign. */
try{(()=>{
const KEY='itunda.b930';let st={};
try{st=JSON.parse(localStorage.getItem(KEY)||'{}')||{}}catch(e){st={}}
const day=new Date().toISOString().slice(0,10);
if(st.d!==day)st={d:day,dis:{},i:st.i||0};
st.i=(st.i||0)+1;
const sv=()=>{try{localStorage.setItem(KEY,JSON.stringify(st))}catch(e){}};sv();
S.b930={gone:false,clip:null};
const tt=(a,b,c)=>({rw:b,fr:c}[S.lang]||a);
const X=()=>ic('plus',22).replace('<svg','<svg style="transform:rotate(45deg)"');
const CAMP=[
 {id:'invite',ic:'gift',go:()=>openSvc('invite'),
  h:()=>tt(['Invite friends,','get <em>10,000 RWF</em>'],['Tumira inshuti,','ubone <em>RWF 10,000</em>'],['Invitez des amis,','recevez <em>10 000 RWF</em>']),
  b:()=>tt('Invite friends','Tumira inshuti','Inviter des amis')},
 {id:'qr',ic:'qr',go:()=>tab('pay'),
  h:()=>tt(['Pay with QR,','get <em>5% back</em>'],['Ishyura na QR,','ubone <em>5% asubizwa</em>'],['Payez par QR,','recevez <em>5 % de cashback</em>']),
  b:()=>tt('Start paying','Tangira kwishyura','Commencer à payer')},
 {id:'save',ic:'coin',go:()=>openGoal(),
  h:()=>tt(['Save a little a day,','earn up to <em>10% bonus</em>'],['Bika buke buri munsi,','ubone igihembo kugeza kuri <em>10%</em>'],['Épargnez un peu par jour,','gagnez jusqu’à <em>10 % de bonus</em>']),
  b:()=>tt('Start saving','Tangira kubika','Commencer à épargner')}
];
const pick=()=>{const a=CAMP.filter(c=>!st.dis[c.id]);return a.length?a[(st.i-1)%a.length]:null};
const banner=()=>{
 const B=S.b930;if(B.gone)return '';
 const dis=tt('Dismiss','Funga','Fermer');
 if(B.clip){
  const c=B.clip,cap=c.acct?tt('Send to copied account','Ohereza kuri konti wakoporoye','Envoyer au compte copié'):tt('Send to copied number','Ohereza kuri nimero wakoporoye','Envoyer au numéro copié');
  const val=(c.acct?'itunda Bank ':'')+c.v;
  return `<div class="hc b930 b930c" id="b930"><button class="bt tap" onclick="bn930go('clip')" aria-label="${cap}, ${val}"><span class="bi">${ic('send',24)}</span><span class="bn"><small>${cap}</small><b>${val}</b></span></button><button class="bx" aria-label="${dis}" onclick="bn930x('clip',event)">${X()}</button></div>`}
 const c=pick();if(!c)return '';
 const t=c.h(),tiles=Array.from({length:9},(_,k)=>k===8?`<i class="hi">${ic(c.ic,26)}</i>`:'<i></i>').join('');
 return `<div class="hc b930 b930p" id="b930"><div class="bgo tap" role="button" tabindex="0" onclick="bn930go('${c.id}')" onkeydown="if(event.key==='Enter')bn930go('${c.id}')"><div class="art" aria-hidden="true"><div class="tiles">${tiles}</div></div><div class="tx">${t[0]}<br>${t[1]}</div></div><button class="go tap" onclick="bn930go('${c.id}')">${c.b()}</button><button class="bx" aria-label="${dis}" onclick="bn930x('${c.id}',event)">${X()}</button></div>`};
window.bn930go=id=>{
 if(id==='clip'){const v=S.b930.clip&&S.b930.clip.v;S.b930.clip=null;flow();if(v)pickGo(v);return}
 const c=CAMP.find(x=>x.id===id);if(c)c.go()};
window.bn930x=(id,ev)=>{
 if(ev)ev.stopPropagation();
 const el=document.getElementById('b930');
 const fin=()=>{if(id==='clip')S.b930.clip=null;else{st.dis[id]=1;sv()}S.b930.gone=true;render('fade-none')};
 if(!el||(window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches)){fin();return}
 el.style.maxHeight=el.offsetHeight+'px';
 el.style.transition='max-height .28s cubic-bezier(.2,.8,.2,1),opacity .2s ease,margin-top .28s cubic-bezier(.2,.8,.2,1)';
 void el.offsetHeight;
 el.style.maxHeight='0px';el.style.opacity='0';el.style.setProperty('margin-top','0','important');
 setTimeout(fin,290)};
/* what counts as "copied": the app's own Copy actions for an account or phone number */
const setClip=(v,acct)=>{S.b930.clip={v:v,acct:!!acct};S.b930.gone=false};
const num=/^\+?\d[\d \-]{7,}$/;
try{const cb=navigator.clipboard,w=cb&&cb.writeText&&cb.writeText.bind(cb);
 if(w)cb.writeText=function(t){try{const s=String(t).trim();if(num.test(s))setClip(s,typeof ACC50!=='undefined'&&s===ACC50)}catch(e){}return w(t)}}catch(e){}
new MutationObserver(ms=>{for(const m of ms)for(const n of m.addedNodes){
 const t=n.nodeType===1&&n.classList&&n.classList.contains('toast')?n.textContent:'';if(!t)continue;
 if(/^(Account number copied|Nimero yakoporowe|Numéro copié)/.test(t)&&typeof ACC50!=='undefined')setClip(ACC50,1);
 else{const m2=t.match(/^Copied\s+(\+?\d[\d \-]{7,})$/);if(m2)setClip(m2[1].trim(),0)}}}).observe(document.body,{childList:true,subtree:true});
const _h=screens.home;
screens.home=function(){
 const was=S.inv701;S.inv701=1;let h;try{h=_h.apply(this,arguments)}finally{S.inv701=was}
 if(typeof h!=='string')return h;
 const b=banner();if(!b)return h;
 let i=h.indexOf('<div class="t848"');if(i<0)i=h.search(/<div class="hc[ "]/);if(i<0)return h;
 return h.slice(0,i)+b+h.slice(i)};
})()}catch(e){console.error(e)}
</script>
<style id="v933">/* v933: the Pay tab follows the system theme. It was dark in every theme; now it is dark in dark and light in light, with the camera view staying dark. */
@media (prefers-color-scheme:light){
:root:not([data-theme=dark]) #phone#phone#phone#phone .pcd{background:var(--bg)!important;color:var(--tx)!important}
:root:not([data-theme=dark]) #phone#phone#phone#phone .pcd .top:has(.tp704bar){--hb-ic:#6B7684!important}
:root:not([data-theme=dark]) #phone#phone#phone#phone .pcd .tabs2{border-bottom-color:var(--ln)}
:root:not([data-theme=dark]) #phone#phone#phone#phone .pcd .tabs2 button{color:var(--mu)}
:root:not([data-theme=dark]) #phone#phone#phone#phone .pcd .tabs2 button[aria-selected=true]{color:var(--tx);border-bottom-color:var(--tx)}
:root:not([data-theme=dark]) #phone#phone#phone#phone .pcd .scn h2{color:#fff}
:root:not([data-theme=dark]) #phone#phone#phone#phone .pcd .cam:after{background:var(--bg)}
:root:not([data-theme=dark]) #phone#phone#phone#phone .pcd .chips button{background:var(--chip);color:var(--tx)}
:root:not([data-theme=dark]) #phone#phone#phone#phone .pcd .chl{color:var(--mu)}
:root:not([data-theme=dark]) #phone#phone#phone#phone .pcd .cardbox{background:var(--chip)}
:root:not([data-theme=dark]) #phone#phone#phone#phone .pcd .lnk{color:var(--lk)}
:root:not([data-theme=dark]) #phone#phone#phone#phone .pcd .pcmc.add{background:var(--chip)!important;color:var(--tx)}
:root:not([data-theme=dark]) #phone#phone#phone#phone .pcd .tpf{background:linear-gradient(var(--bg),var(--bg)) padding-box,linear-gradient(135deg,#2DD08B,#2F6BFF) border-box!important}
:root:not([data-theme=dark]) #phone#phone#phone#phone .pcd .tapt{color:var(--mu)}
}
:root[data-theme=light] #phone#phone#phone#phone .pcd{background:var(--bg)!important;color:var(--tx)!important}
:root[data-theme=light] #phone#phone#phone#phone .pcd .top:has(.tp704bar){--hb-ic:#6B7684!important}
:root[data-theme=light] #phone#phone#phone#phone .pcd .tabs2{border-bottom-color:var(--ln)}
:root[data-theme=light] #phone#phone#phone#phone .pcd .tabs2 button{color:var(--mu)}
:root[data-theme=light] #phone#phone#phone#phone .pcd .tabs2 button[aria-selected=true]{color:var(--tx);border-bottom-color:var(--tx)}
:root[data-theme=light] #phone#phone#phone#phone .pcd .scn h2{color:#fff}
:root[data-theme=light] #phone#phone#phone#phone .pcd .cam:after{background:var(--bg)}
:root[data-theme=light] #phone#phone#phone#phone .pcd .chips button{background:var(--chip);color:var(--tx)}
:root[data-theme=light] #phone#phone#phone#phone .pcd .chl{color:var(--mu)}
:root[data-theme=light] #phone#phone#phone#phone .pcd .cardbox{background:var(--chip)}
:root[data-theme=light] #phone#phone#phone#phone .pcd .lnk{color:var(--lk)}
:root[data-theme=light] #phone#phone#phone#phone .pcd .pcmc.add{background:var(--chip)!important;color:var(--tx)}
:root[data-theme=light] #phone#phone#phone#phone .pcd .tpf{background:linear-gradient(var(--bg),var(--bg)) padding-box,linear-gradient(135deg,#2DD08B,#2F6BFF) border-box!important}
:root[data-theme=light] #phone#phone#phone#phone .pcd .tapt{color:var(--mu)}
</style>
<style id="v936">/* v936: amount screens (Take out, Top up, Move): Toss spacing. Chips sit right on the Next bar, all free space goes to white space between the prompt and the chips, header block starts lower. */
#phone .screen .mvh{padding-top:20px}
#phone .screen .mva{padding-top:56px}
#phone .screen .mvq{position:absolute!important;left:0;right:0;margin:0!important;bottom:calc(var(--kb) + var(--kh) + 53px + 12px)}
@media (max-height:760px){#phone .screen .mvh{padding-top:12px}#phone .screen .mva{padding-top:28px}#phone .screen .mvq{bottom:calc(var(--kb) + var(--kh) + 46px + 10px)}}
</style>
<style id="v940ok">
/* v940: Toss-style pass 55. Success messages (Cash out, Convert, Send and the others) stop being small bottom sheets with an emoji and become a full page like Toss: a brand circle whose check draws itself, a big title, one calm line, and the button at the bottom. Full page instead of a modal, as in the rest of the app. */
#phone .sheet.v940ok{top:0;border-radius:0;padding:0 24px 28px;display:flex;flex-direction:column;align-items:center;text-align:center;animation:v940in .28s cubic-bezier(.2,.8,.2,1)}
#phone .sheet.v940ok>.v940c{margin-top:max(120px,22%);flex:none}
#phone .sheet.v940ok>.h1{margin-top:28px;font-size:26px!important;line-height:34px!important;letter-spacing:-.5px}
#phone .sheet.v940ok>.mu{max-width:300px;font-size:16px!important;line-height:24px!important;margin:10px 0 0!important}
#phone .sheet.v940ok>button:last-child,#phone .sheet.v940ok>.row2:last-child{margin-top:auto;width:100%}
#phone .sheet.v940ok>.btn:not(:last-child){margin-top:auto}
#phone .sheet.v940ok~.sheetbg,#layer:has(.v940ok) .sheetbg{background:transparent}
@keyframes v940in{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}
.v940c{position:relative;width:84px;height:84px}
.v940c i{position:absolute;inset:0;border-radius:50%;background:var(--br,#3182F6);opacity:.16;animation:v940r 1.8s ease-out .5s infinite}
.v940c svg{position:relative;width:84px;height:84px;display:block}
.v940c .d{stroke-dasharray:60;stroke-dashoffset:60;animation:v940d .5s cubic-bezier(.4,0,.2,1) .35s forwards}
.v940c circle{transform-box:fill-box;transform-origin:50% 50%;animation:v940p .45s cubic-bezier(.2,.9,.3,1.3) backwards}
@keyframes v940d{to{stroke-dashoffset:0}}
@keyframes v940p{from{transform:scale(.4);opacity:0}}
@keyframes v940r{0%{transform:scale(1);opacity:.2}100%{transform:scale(1.55);opacity:0}}
@media (prefers-reduced-motion:reduce){.v940c *,#phone .sheet.v940ok{animation:none!important}.v940c .d{stroke-dashoffset:0}}
</style>
<script id="v940js">(function(){try{
var L=document.getElementById('layer');if(!L)return;var q=0;
function run(){q=0;var sh=L.querySelector('.sheet:not(.v940ok)');if(!sh)return;
 var g=sh.querySelector(':scope>.g3');if(!g||g.textContent.trim()!=='\u2705'||!sh.querySelector('button'))return;
 sh.classList.add('v940ok');sh.setAttribute('role','alertdialog');
 g.className='v940c';g.removeAttribute('style');g.setAttribute('aria-hidden','true');
 g.innerHTML='<i></i><svg viewBox="0 0 84 84"><circle cx="42" cy="42" r="42" fill="var(--br,#3182F6)"/><path class="d" d="M26 43l11 11 21-23" fill="none" stroke="#fff" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/></svg>'}
new MutationObserver(function(){if(!q){q=1;requestAnimationFrame(run)}}).observe(L,{childList:true,subtree:true});
}catch(e){console.warn('v940',e)}})();
</script>
<style id="v941toss">/* v941, Toss-style pass 56. Home leads with your money. The big campaign card (invite, QR cashback, daily saving) becomes one slim row under the balance card: small brand icon, one line of text, close button. Tap anywhere on the row to act, like a Toss banner. The copied-number banner stays on top because it is an action you just asked for. */
#phone#phone #sc.h9 .hc.b930.b930p{display:flex!important;align-items:center;padding:14px 52px 14px 16px!important;margin:12px 14px 0!important;min-height:0;border-radius:20px}
#phone#phone .b930p .bgo{display:flex;align-items:center;gap:14px;flex:1;min-width:0}
#phone#phone .b930p .art{height:auto;width:48px;flex:none;overflow:visible}
#phone#phone .b930p .art::before{display:none}
#phone#phone .b930p .tiles{position:static;display:block}
#phone#phone .b930p .tiles i:not(.hi){display:none}
#phone#phone .b930p .tiles i.hi{width:48px;height:48px;aspect-ratio:auto;border-radius:16px;background:var(--tint);box-shadow:none}
#phone#phone .b930p .tiles i.hi svg{stroke:var(--tintfg);width:24px;height:24px}
#phone#phone .b930p .tx{padding:0;font-size:16px;line-height:22px;font-weight:700;letter-spacing:-.3px;min-width:0}
#phone#phone .b930p .tx br{display:none}
#phone#phone .b930p .tx em{white-space:nowrap}
#phone#phone .b930p .go{display:none}
#phone#phone .b930p .bx{top:50%;right:4px;transform:translateY(-50%)}
#phone#phone .b930p .bx::before{display:none}
</style>
<script id="v941js">(function(){try{
if(typeof screens==='undefined'||!screens.home)return;
var _h=screens.home;
function end(h,start){var re=/<(\/?)div\b[^>]*>/g,d=0,m;re.lastIndex=start;while((m=re.exec(h))){d+=m[1]?-1:1;if(d===0)return re.lastIndex}return -1}
screens.home=function(){
 var h=_h.apply(this,arguments);if(typeof h!=='string')return h;
 var a=h.indexOf('<div class="hc b930 b930p"');if(a<0)return h;
 var b=end(h,a);if(b<0)return h;
 var promo=h.slice(a,b).replace('<br>',' '),rest=h.slice(0,a)+h.slice(b);
 var n=rest.indexOf('<div class="hc',a);if(n<0)return h;
 var e=end(rest,n);if(e<0)return h;
 return rest.slice(0,e)+promo+rest.slice(e)};
}catch(e){console.warn('v941',e)}})();
</script>
<style id="v942toss">/* v942, Toss-style pass 57. Find loan: one question, one answer. The lightning picture is gone, the two numbers sit in soft cards, the button is pinned to the bottom, and the loan types become calm 17px rows. */
#phone .v942cta{position:sticky;bottom:0;z-index:3;padding:12px 24px 24px;background:var(--bg)}
#phone .v942stat{display:flex;gap:12px;padding:24px 24px 0}
#phone .v942stat>div{flex:1;background:var(--chip);border-radius:20px;padding:16px!important;border:0!important}

function put(card,svg,replace){var d=document.createElement('div');d.className='i20';d.setAttribute('aria-hidden','true');d.innerHTML=svg;
 if(replace&&card.firstElementChild)card.replaceChild(d,card.firstElementChild);else card.insertBefore(d,card.firstChild)}
function run(){q=0;document.querySelectorAll('#phone .screen div[style*="border-radius:28px"][style*="background:var(--tint)"]:not([data-i20])').forEach(function(c){
 var sc=c.closest('.screen')||c.parentElement,t=sc.textContent;
 if(c.dataset.i20)return;
 if(t.indexOf('Save a little more')>-1&&t.indexOf('every week')>-1){c.dataset.i20=1;put(c,w26(),true)}
 else if(t.indexOf('A first bank account')>-1){c.dataset.i20=1;put(c,yth(),true)}
 else if(t.indexOf('Save together')>-1){c.dataset.i20=1;put(c,ikim(),false)}
 else if(t.indexOf('Own a part')>-1){c.dataset.i20=1;put(c,sacco(),true)}})}
new MutationObserver(function(){if(!q){q=1;requestAnimationFrame(run)}}).observe(document.documentElement,{childList:true,subtree:true});run();
var t=function(){document.title=document.title.replace(/v\d+/,'v922')};t();var n=0,iv=setInterval(function(){t();if(++n>12)clearInterval(iv)},500);
}catch(e){console.warn('v920',e)}})();
</script>
<style id="v921">
/* v922: Toss-style pass 49 (adds Auto top-up, Digital certificate, Verify identity, Bike rental, USSD access and Invite a friend to the six from v921). v921: Toss-style pass 48. Six more products open the way the group account does: say what it is, show one real example, three benefits, the key facts, then (for loans and linking people) terms in plain words and "Did you understand everything?" before the existing flow. Foreign currency, Family, Harvest advance, VUP loan, Student loan, Moto-taxi. */
#phone .pg21-h{margin:26px 24px 0;padding:28px 20px 24px;border-radius:28px;background:var(--tint);color:var(--tintfg);text-align:center}
#phone .pg21-h .i20{margin:-6px 0 4px}
#phone .pg21-b{display:flex;gap:14px;align-items:flex-start;padding:10px 0}
#phone .pg21-b .t{font-size:16px;font-weight:800}
#phone .pg21-b .s{font-size:15px;line-height:22px;margin-top:2px}
#phone .pg21-f{margin:12px 24px 0;padding:4px 20px;border-radius:20px;background:var(--chip)}
#phone .pg21-f>div{display:flex;justify-content:space-between;gap:16px;min-height:48px;align-items:center;font-size:15px}
#phone .pg21-f>div b{text-align:right}
@keyframes pg21pop{0%{transform:scale(.6);opacity:0}70%{transform:scale(1.08);opacity:1}100%{transform:scale(1);opacity:1}}
#phone .pg21-k:focus-visible{outline:2px solid var(--br);outline-offset:2px}
</style>
<script id="v921js">try{(function(){
if(typeof screens==='undefined'||typeof S==='undefined'||typeof gl!=='function')return;
S.pfG=S.pfG||{};
const st=k=>S.pfG[k]||(S.pfG[k]={i:0,ck:[0,0,0],open:0});
const apps=k=>!!(S.apps&&S.apps[k]);

/* ---------- illustrations (same flat style and motion classes as v920) ---------- */
const COIN='<radialGradient id="cg21" cx="35%" cy="30%" r="80%"><stop offset="0" stop-color="#FFE27A"/><stop offset="1" stop-color="#FFB400"/></radialGradient>';
const coin=(x,y,r,t)=>'<g><circle cx="'+x+'" cy="'+y+'" r="'+r+'" fill="url(#cg21)"/><circle cx="'+x+'" cy="'+y+'" r="'+(r*.68)+'" fill="none" stroke="#E69A00" stroke-width="1.6" opacity=".7"/>'+(t?'<text x="'+x+'" y="'+(y+r*.36)+'" text-anchor="middle" font-size="'+(r*1.05)+'" font-weight="800" fill="#A86800" font-family="inherit">'+t+'</text>':'<path d="M'+(x-r*.45)+' '+(y-r*.45)+'a'+(r*.7)+' '+(r*.7)+' 0 0 1 '+(r*.5)+' -'+(r*.2)+'" stroke="#fff" stroke-width="1.8" stroke-linecap="round" fill="none" opacity=".8"/>')+'</g>';
const star=(x,y,k,c)=>'<path class="s20" style="--k:'+k+'" d="M'+x+' '+(y-7)+'Q'+x+' '+y+' '+(x+7)+' '+y+'Q'+x+' '+y+' '+x+' '+(y+7)+'Q'+x+' '+y+' '+(x-7)+' '+y+'Q'+x+' '+y+' '+x+' '+(y-7)+'z" fill="'+(c||'#fff')+'"/>';
const sh=(cx,rx)=>'<ellipse cx="'+cx+'" cy="104" rx="'+rx+'" ry="5" fill="#000" opacity=".08"/>';
const svg=b=>'<div class="i20" aria-hidden="true"><svg viewBox="0 0 240 112">'+'<defs>'+COIN+'</defs>'+b+'</svg></div>';
const face=(x,y,r)=>'<circle cx="'+(x-r*.34)+'" cy="'+(y-r*.08)+'" r="'+(r*.1)+'" fill="#3B2A1A"/><circle cx="'+(x+r*.34)+'" cy="'+(y-r*.08)+'" r="'+(r*.1)+'" fill="#3B2A1A"/><path d="M'+(x-r*.3)+' '+(y+r*.26)+'q'+(r*.3)+' '+(r*.3)+' '+(r*.6)+' 0" stroke="#3B2A1A" stroke-width="'+Math.max(1.6,r*.09)+'" stroke-linecap="round" fill="none"/>';
const ART={
fx:()=>svg(sh(120,100)+'<circle cx="86" cy="58" r="34" fill="var(--br,#8F89FF)"/><circle cx="86" cy="58" r="26" fill="none" stroke="#fff" stroke-width="2" opacity=".5"/><text x="86" y="64" text-anchor="middle" font-size="17" font-weight="800" fill="#fff" font-family="inherit">RWF</text><circle cx="154" cy="58" r="34" fill="url(#cg21)"/><circle cx="154" cy="58" r="26" fill="none" stroke="#E69A00" stroke-width="2" opacity=".6"/><text x="154" y="71" text-anchor="middle" font-size="36" font-weight="800" fill="#A86800" font-family="inherit">$</text><g class="f20"><circle cx="120" cy="20" r="12" fill="#fff"/><path d="M114 17h11m-3-3l3 3-3 3M126 23h-11m3-3l-3 3 3 3" stroke="var(--br,#8F89FF)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" fill="none"/></g><g class="f20" style="animation-delay:-1.2s"><circle cx="26" cy="86" r="13" fill="#6AA3FF"/><text x="26" y="92" text-anchor="middle" font-size="17" font-weight="800" fill="#fff" font-family="inherit">€</text></g><g class="f20" style="animation-delay:-2.2s"><circle cx="216" cy="84" r="13" fill="#3DC48B"/><text x="216" y="90" text-anchor="middle" font-size="17" font-weight="800" fill="#fff" font-family="inherit">£</text></g>'+star(30,34,0,'var(--br,#8F89FF)')+star(214,34,1)),
family:()=>svg(sh(120,92)+'<path d="M62 102c0-20 13-28 30-28s30 8 30 28z" fill="#6AA3FF"/><circle cx="92" cy="48" r="23" fill="#8DBBFF"/>'+face(92,50,23)+'<path d="M128 102c0-15 9-22 22-22s22 7 22 22z" fill="#FFC21A"/><circle cx="150" cy="64" r="17" fill="#FFD966"/>'+face(150,66,17)+'<g class="f20"><path d="M122 30c-7-8-18-2-13 7 3 5 13 11 13 11s10-6 13-11c5-9-6-15-13-7z" fill="#FF7A8A"/></g><g transform="translate(186 26) scale(.8)"><path d="M20 0l20 7v17c0 14-9 23-20 28C9 47 0 38 0 24V7z" fill="#3182F6"/><path d="M11 25l7 7 13-14" stroke="#fff" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/></g>'+star(34,40,0,'var(--br,#8F89FF)')+star(206,84,1)),
harvest:()=>svg(sh(120,100)+'<path d="M64 100c-10-4-14-26-9-40l11-14h40l11 14c5 14 1 36-9 40z" fill="#E8C48A"/><path d="M66 46h40" stroke="#B98A4B" stroke-width="6" stroke-linecap="round"/><path d="M60 62c4 10 4 28 0 36" stroke="#fff" stroke-width="3" stroke-linecap="round" fill="none" opacity=".4"/><g transform="rotate(-25 86 78)"><ellipse cx="86" cy="78" rx="12" ry="17" fill="#6B4226"/><path d="M86 62c-6 8 6 16 0 32" stroke="#E8C48A" stroke-width="2.4" stroke-linecap="round" fill="none"/></g><path d="M172 100c0-18 1-34-1-50" stroke="#3DC48B" stroke-width="4" stroke-linecap="round" fill="none"/><path d="M172 82c-13 0-21-6-22-16 13-1 21 5 22 16z" fill="#3DC48B"/><path d="M172 70c11 0 19-6 19-15-11-1-19 5-19 15z" fill="#5FD6A4"/><circle cx="162" cy="54" r="6" fill="#E5484D"/><circle cx="182" cy="62" r="6" fill="#E5484D"/><circle cx="160" cy="52" r="1.8" fill="#fff" opacity=".7"/><circle cx="180" cy="60" r="1.8" fill="#fff" opacity=".7"/><g class="f20">'+coin(128,30,12)+'</g>'+star(30,30,0,'var(--br,#8F89FF)')+star(220,30,1)+star(124,76,2)),
vup:()=>svg(sh(120,100)+'<rect x="84" y="56" width="60" height="44" rx="6" fill="#fff"/><path d="M76 60l38-33 38 33z" fill="var(--br,#8F89FF)"/><rect x="106" y="76" width="16" height="24" rx="4" fill="#C7DBFF"/><rect x="92" y="66" width="11" height="11" rx="3" fill="#C7DBFF"/><rect x="125" y="66" width="11" height="11" rx="3" fill="#C7DBFF"/><path d="M52 100c0-12 1-22 0-32" stroke="#3DC48B" stroke-width="4" stroke-linecap="round" fill="none"/><path d="M52 86c-10 0-16-5-17-13 10-1 16 4 17 13z" fill="#3DC48B"/><path d="M52 76c8 0 14-5 14-12-8-1-14 4-14 12z" fill="#5FD6A4"/><path d="M188 100c0-10 1-18 0-26" stroke="#3DC48B" stroke-width="4" stroke-linecap="round" fill="none"/><path d="M188 88c-9 0-14-4-15-11 9-1 14 3 15 11z" fill="#5FD6A4"/><g class="f20">'+coin(184,40,12)+'</g>'+star(34,36,0,'var(--br,#8F89FF)')+star(212,80,1)+star(140,24,2)),
student:()=>svg(sh(120,96)+'<rect x="70" y="86" width="100" height="10" rx="4" fill="#6AA3FF"/><rect x="78" y="95" width="84" height="8" rx="4" fill="#FFC21A"/><path d="M84 52v16c0 9 72 9 72 0V52l-36 13z" fill="#6B73A3"/><path d="M120 14l70 25-70 25-70-25z" fill="#4B5275"/><path d="M120 14L82 27" stroke="#fff" stroke-width="3" stroke-linecap="round" opacity=".35"/><path d="M188 40v28" stroke="#FFB400" stroke-width="3" stroke-linecap="round"/><circle cx="188" cy="72" r="5" fill="#FFB400"/><g class="f20">'+coin(32,44,11)+'</g>'+star(214,16,0)+star(30,82,1,'var(--br,#8F89FF)')+star(206,92,2,'var(--br,#8F89FF)')),
moto:()=>svg(sh(120,104)+'<circle cx="66" cy="82" r="17" fill="#4B5275"/><circle cx="66" cy="82" r="8" fill="#C7CCDA"/><circle cx="66" cy="82" r="2.6" fill="#4B5275"/><circle cx="176" cy="82" r="17" fill="#4B5275"/><circle cx="176" cy="82" r="8" fill="#C7CCDA"/><circle cx="176" cy="82" r="2.6" fill="#4B5275"/><path d="M98 62L66 82" stroke="#9AA0B5" stroke-width="5" stroke-linecap="round"/><path d="M148 56l28 26" stroke="#9AA0B5" stroke-width="5" stroke-linecap="round"/><path d="M150 56l8-14h12" stroke="#4B5275" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/><rect x="104" y="68" width="34" height="14" rx="5" fill="#9AA0B5"/><path d="M92 58h54l8 12H92z" fill="var(--br,#8F89FF)"/><rect x="96" y="48" width="36" height="9" rx="4.5" fill="#4B5275"/><circle cx="170" cy="40" r="4.5" fill="#FFE27A"/><g class="f20">'+coin(112,22,11)+'</g>'+star(30,34,0,'var(--br,#8F89FF)')+star(214,40,1)+star(34,96,2))
};

/* ---------- small parts ---------- */
const hd=(h,s)=>'<div class="h1">'+h+'</div>'+(s?'<div class="mu" style="font-size:16px;line-height:24px;margin-top:10px">'+s+'</div>':'');
const rw=(a,b)=>'<div><span class="mu">'+a+'</span><b>'+b+'</b></div>';
const disc=(ic,sz)=>'<div style="width:'+sz+'px;height:'+sz+'px;flex:none;border-radius:50%;background:var(--tint);color:var(--tintfg);display:grid;place-items:center">'+gl(ic,Math.round(sz*.55))+'</div>';
const big=t=>'<div class="big" style="margin-top:10px;color:var(--tx)">'+t+'</div>';
const cap=t=>'<div style="font-size:15px;line-height:22px;margin-top:6px;font-weight:600">'+t+'</div>';
const req=' <span class="mu" style="font-weight:600;font-size:14px">(required)</span>';
const ckRow=(on,fn,tit,sub,strong)=>'<button class="tap pg21-k" role="checkbox" aria-checked="'+on+'" onclick="'+fn+'" style="display:flex;gap:14px;align-items:flex-start;width:100%;text-align:left;border:0;background:none;color:inherit;font:inherit;padding:14px 0;cursor:pointer"><span aria-hidden="true" style="flex:none;width:28px;height:28px;border-radius:14px;box-sizing:border-box;display:grid;place-items:center;font-size:15px;font-weight:800;margin-top:1px;'+(on?'background:var(--br);color:var(--on)':'border:2px solid var(--tt);color:transparent')+'">✓</span><span style="min-width:0"><span style="display:block;font-size:'+(strong?17:16)+'px;font-weight:'+(strong?800:700)+'">'+tit+'</span>'+(sub?'<span class="mu" style="display:block;font-size:14px;line-height:20px;margin-top:2px">'+sub+'</span>':'')+'</span></button>';
const PMT=(p,r,n)=>{const i=r/1200;return Math.round(p*i/(1-Math.pow(1+i,-n)))};
const MO=(()=>{const loan=1400000,mo=PMT(loan,14,24);return{loan,mo}})();

/* ---------- the six products ---------- */
const P={
fx:{ic:'globe',steps:['intro','go'],started:()=>false,
 h:'Hold dollars,<br>euros or pounds',s:'Change RWF into USD, EUR or GBP in seconds. You see the rate and what you get before you confirm.',
 vis:()=>ART.fx()+big('50,000 RWF')+cap('becomes about 34.60 USD at today’s sample rate'),
 ben:[['globe','Three currencies','Hold USD, EUR or GBP next to your RWF.'],['chart','See the rate first','The rate and the amount you get are shown before you confirm.'],['bell','Set a rate alert','Tell us your target rate and we let you know when it gets there.']],
 facts:[['Currencies','USD · EUR · GBP'],['Rate (sample)','1 USD = 1,445 RWF'],['Paid from','itunda Bank']],
 fine:'Rates are sample data for this prototype. No real money moves.',cta:'See today’s rate'},
family:{ic:'community',steps:['intro','terms','ask','go'],started:()=>false,
 h:'See your family’s<br>money, together',s:'Link a child to set their weekly limit, or a guardian who can see your spending. Nothing links until they accept.',
 vis:()=>ART.family()+big('3,000 RWF')+cap('a weekly spending limit you can set for a child'),
 ben:[['lock','You set the limit','For a child, choose a weekly limit and change it any time.'],['verify','Guardians only look','A guardian can see your spending. They cannot move your money.'],['bell','They say yes first','You can cancel until the other person accepts.']],
 facts:[['Link with','A child or a guardian'],['You need','Their first name and phone'],['They must','Accept the link']],
 fine:'Sample family link for this prototype. No real link is made.',cta:'Link my family',
 th:()=>'Link your family<br>safely',
 docs:()=>[['Family link terms','A child can spend within the limit you set. A guardian can see your spending, read-only.'],['Consent','You confirm you may link this person, and they will be asked to accept.'],['Privacy policy','Linked people see only spending you choose to share, and only after they accept.']],
 key:'You can cancel until they accept. This is a prototype and no real link is made.',
 ask:'Linked people can see spending details. If you agree without understanding, it can be hard to use your rights later.'},
harvest:{ic:'money',steps:['intro','terms','ask','go'],started:()=>apps('harvest'),
 h:'Money for your farm,<br>repaid after harvest',s:'Coffee cooperative members get financing for seedlings and tools now, and repay after they sell.',
 vis:()=>ART.harvest()+big('530,000 RWF')+cap('to repay after the harvest, for a 500,000 RWF advance over 6 months (12% a year, sample)'),
 ben:[['money','Money before the harvest','Buy seedlings or tools now. Pay later.'],['cal','Repay when you sell','One payment after harvest, or monthly if you prefer.'],['verify','Your cooperative checks','Your cooperative confirms you are a member first.']],
 facts:[['For','Coffee cooperative members'],['Rate (sample)','12% a year'],['Repay','After harvest, or monthly']],
 fine:'Rates and terms are sample data for this prototype. No real loan is made.',cta:'Get a harvest advance',
 th:()=>'Get a harvest advance<br>with clear terms',
 docs:()=>[['Advance terms','You repay the amount plus 12% a year interest (sample) on the date you choose.'],['Cooperative check','Your cooperative confirms you are a member before we send any money.'],['Privacy policy','We use your details only to review this advance and follow lending rules.']],
 key:'Interest is 12% a year (sample). You repay after the harvest or monthly. This is a prototype and no real loan is made.',
 ask:'An advance has to be repaid with interest. If you agree without understanding, it can be hard to use your rights later.'},
vup:{ic:'money',steps:['intro','terms','ask','go'],started:()=>apps('vup'),
 h:'A small loan<br>for your household',s:'A government microloan for households in the VUP programme. Your sector office checks your application.',
 vis:()=>ART.vup()+big('151,632 RWF')+cap('to repay for a 150,000 RWF loan over 12 months (2% a year, sample)'),
 ben:[['coin','A low rate','2% a year, set for VUP households.'],['verify','Checked near you','Your sector office reviews your application.'],['cal','Repay over 6 to 18 months','Pick the monthly payment that fits your household.']],
 facts:[['For','Households in the VUP programme'],['Rate (sample)','2% a year'],['Amount','50,000 to 500,000 RWF']],
 fine:'Rates and terms are sample data for this prototype. No real loan is made.',cta:'See the VUP loan',
 th:()=>'Apply for a VUP loan<br>with clear terms',
 docs:()=>[['Loan terms','You repay the amount plus 2% a year interest (sample) over the months you choose.'],['Sector office check','Your sector office checks your household is in the VUP programme.'],['Privacy policy','We use your details only to review this loan and follow lending rules.']],
 key:'Interest is 2% a year (sample). You bring your National ID and proof of VUP to your sector office. This is a prototype and no real loan is made.',
 ask:'A loan has to be repaid with interest. If you agree without understanding, it can be hard to use your rights later.'},
student:{ic:'bank',steps:['intro','terms','ask','go'],started:()=>apps('student'),
 h:'Study now,<br>repay after you graduate',s:'A BRD higher-education loan. Your first payment comes only after you finish your studies.',
 vis:()=>ART.student()+big('11% a year')+cap('for undergraduate studies. Postgraduate is 12%. (sample)'),
 ben:[['bank','From BRD','A higher-education loan, paid into your itunda Pay.'],['cal','Repay after graduation','You start repaying after you graduate, not before.'],['chart','See the payment first','Pick how long to repay and see your monthly payment before you apply.']],
 facts:[['Rate (sample)','11% · 12% postgraduate'],['First payment','After you graduate'],['You need','Your admission letter']],
 fine:'Rates and terms are sample data for this prototype. No real loan is made.',cta:'See the student loan',
 th:()=>'Apply for a student loan<br>with clear terms',
 docs:()=>[['Loan terms','Interest is 11% a year, or 12% for postgraduate (sample). You start repaying after you graduate.'],['Admission check','We check that your school has admitted you before the loan is approved.'],['Privacy policy','We use your details only to review this loan and follow lending rules.']],
 key:'Interest is 11% a year (12% postgraduate, sample). You start repaying after you graduate. This is a prototype and no real loan is made.',
 ask:'A loan has to be repaid with interest. If you agree without understanding, it can be hard to use your rights later.',
 onOpen:()=>{if(!S.apps.student&&(S.stuStep|0)===0)S.stuStep=1}},
moto:{ic:'busstop',steps:['intro','terms','ask','go'],started:()=>!!(S.goal&&S.goal.moto),
 h:'Save a down payment,<br>own your moto',s:'Save the down payment first. Then the rest becomes a loan you repay a little each month.',
 vis:()=>ART.moto()+big(fmt(MO.mo)+' RWF')+cap('a month for 24 months, on a 2,000,000 RWF moto with 30% down (14% a year, sample)'),
 ben:[['coin','Down payment first','Save 30% to 50% of the price. We show how much to set aside each month.'],['bank','Then a loan','The rest becomes a loan only after you have saved.'],['chart','Check it fits','We show your payment next to your daily income so you can see if it is comfortable.']],
 facts:[['Moto price','1M to 5M RWF'],['Down payment','30% to 50%'],['You need','Licence and permit']],
 fine:'Rates and terms are sample data for this prototype. No real loan is made.',cta:'Plan my motorbike',
 th:()=>'Plan your moto<br>with clear terms',
 docs:()=>[['Loan terms','After your down payment, the rest is a loan at 14% a year (sample), repaid monthly.'],['Documents','You need a valid driving licence and a moto-taxi permit before the loan opens.'],['Privacy policy','We use your details only to plan this loan and follow lending rules.']],
 key:'Interest is 14% a year (sample). You need a licence and a permit. This is a prototype and no real loan is made.',
 ask:'A loan has to be repaid with interest. If you agree without understanding, it can be hard to use your rights later.'}
};

Object.assign(ART,{
call:()=>svg(sh(120,100)+'<path d="M70 100c0-22 14-32 34-32s34 10 34 32z" fill="#6AA3FF"/><circle cx="104" cy="46" r="25" fill="#FFD9B8"/><path d="M79 44c0-16 11-26 25-26s25 10 25 26c-6-8-14-12-25-12s-19 4-25 12z" fill="#4B5275"/>'+'<rect x="72" y="40" width="9" height="18" rx="4.5" fill="var(--br,#8F89FF)"/><rect x="127" y="40" width="9" height="18" rx="4.5" fill="var(--br,#8F89FF)"/><path d="M131 56q0 12-14 13" stroke="var(--br,#8F89FF)" stroke-width="3" stroke-linecap="round" fill="none"/><circle cx="115" cy="69" r="3.5" fill="var(--br,#8F89FF)"/>'+'<circle cx="96" cy="46" r="2.4" fill="#3B2A1A"/><circle cx="112" cy="46" r="2.4" fill="#3B2A1A"/><path d="M97 55q7 6 14 0" stroke="#3B2A1A" stroke-width="2.4" stroke-linecap="round" fill="none"/>'+'<g class="f20"><rect x="150" y="20" width="58" height="36" rx="14" fill="#fff" stroke="var(--br,#8F89FF)" stroke-width="2"/><path d="M162 56l-4 11 14-11z" fill="#fff" stroke="var(--br,#8F89FF)" stroke-width="2" stroke-linejoin="round"/><rect x="150" y="46" width="30" height="12" fill="#fff"/><circle cx="166" cy="38" r="3.4" fill="var(--br,#8F89FF)"/><circle cx="179" cy="38" r="3.4" fill="var(--br,#8F89FF)"/><circle cx="192" cy="38" r="3.4" fill="var(--br,#8F89FF)"/></g>'+star(36,34,0)+star(214,84,1,'var(--br,#8F89FF)')+star(30,86,2)),
bus:()=>svg(sh(120,100)+'<path d="M18 96h204" stroke="#C7CCDA" stroke-width="3" stroke-linecap="round" stroke-dasharray="2 9"/>'+'<g class="f20"><rect x="52" y="34" width="136" height="56" rx="16" fill="var(--br,#8F89FF)"/><rect x="52" y="34" width="136" height="14" rx="7" fill="#fff" opacity=".2"/>'+'<rect x="64" y="44" width="26" height="20" rx="6" fill="#fff"/><rect x="96" y="44" width="26" height="20" rx="6" fill="#fff"/><rect x="128" y="44" width="26" height="20" rx="6" fill="#fff"/><rect x="160" y="44" width="20" height="36" rx="6" fill="#D6E4FF"/>'+'<rect x="64" y="72" width="60" height="6" rx="3" fill="#fff" opacity=".55"/><circle cx="84" cy="90" r="11" fill="#4B5275"/><circle cx="84" cy="90" r="4.5" fill="#C7CCDA"/><circle cx="156" cy="90" r="11" fill="#4B5275"/><circle cx="156" cy="90" r="4.5" fill="#C7CCDA"/></g>'+'<g class="cd20">'+coin(30,16,10)+'</g>'+star(212,24,0)+star(26,56,1,'var(--br,#8F89FF)')+star(206,70,2)),
cashout:()=>svg(sh(120,100)+'<rect x="22" y="46" width="70" height="50" rx="14" fill="var(--br,#8F89FF)"/><rect x="22" y="46" width="70" height="14" rx="7" fill="#fff" opacity=".22"/><rect x="68" y="64" width="30" height="20" rx="10" fill="#fff"/><circle cx="80" cy="74" r="4" fill="var(--br,#8F89FF)"/>'+'<path d="M104 52Q130 22 160 40" stroke="var(--br,#8F89FF)" stroke-width="2.4" stroke-dasharray="2 7" stroke-linecap="round" fill="none" opacity=".6"/><path d="M154 33l8 8-10 4" stroke="var(--br,#8F89FF)" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" fill="none" opacity=".8"/>'+'<g class="f20">'+coin(124,22,12)+'</g>'+'<rect x="148" y="32" width="62" height="68" rx="13" fill="#4B5275"/><rect x="153" y="40" width="52" height="52" rx="8" fill="#FFD84D"/><circle cx="179" cy="58" r="9" fill="#fff" opacity=".85"/><path d="M174 58l4 4 7-8" stroke="#3DC48B" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" fill="none"/><rect x="162" y="74" width="34" height="5" rx="2.5" fill="#fff" opacity=".7"/><rect x="168" y="83" width="22" height="4" rx="2" fill="#fff" opacity=".5"/>'+star(30,28,0)+star(214,14,1)+star(112,92,2,'var(--br,#8F89FF)')),
atu:()=>svg(sh(120,96)+'<g class="cd20">'+coin(120,16,11)+'</g><rect x="72" y="44" width="96" height="54" rx="14" fill="var(--br,#8F89FF)"/><path d="M72 58h96" stroke="#fff" stroke-width="2" opacity=".35"/><rect x="130" y="66" width="38" height="22" rx="11" fill="#fff"/><circle cx="144" cy="77" r="4.5" fill="var(--br,#8F89FF)"/><path d="M80 52c8-4 20-5 32-5" stroke="#fff" stroke-width="3" stroke-linecap="round" fill="none" opacity=".45"/><g transform="translate(184 30)"><circle cx="16" cy="16" r="16" fill="#3DC48B"/><path d="M16 8v16M8 16h16" stroke="#fff" stroke-width="3.6" stroke-linecap="round"/></g>'+star(34,40,0,'var(--br,#8F89FF)')+star(30,86,1)+star(214,92,2)),
cert:()=>svg(sh(120,86)+'<rect x="78" y="14" width="84" height="86" rx="10" fill="#fff"/><path d="M92 32h40M92 44h56M92 56h30" stroke="#D5D9E6" stroke-width="5" stroke-linecap="round"/><path d="M92 82c6-14 10 8 16-4s8 6 14-2 8 4 14-2" stroke="var(--br,#8F89FF)" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" fill="none"/><g class="f20"><circle cx="154" cy="86" r="14" fill="url(#cg21)"/><path d="M147 86l5 5 9-10" stroke="#fff" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round" fill="none"/></g><g transform="rotate(35 190 52)"><rect x="184" y="24" width="12" height="46" rx="4" fill="#FF8DA3"/><path d="M184 70h12l-6 12z" fill="#4B5275"/></g>'+star(40,40,0,'var(--br,#8F89FF)')+star(40,88,1)+star(214,20,2)),
verify:()=>svg(sh(120,96)+'<rect x="56" y="26" width="120" height="70" rx="12" fill="#fff"/><rect x="56" y="26" width="120" height="14" rx="7" fill="var(--br,#8F89FF)" opacity=".85"/><circle cx="86" cy="64" r="14" fill="#8DBBFF"/>'+face(86,66,14)+'<path d="M110 56h46M110 68h34M70 86h86" stroke="#D5D9E6" stroke-width="5" stroke-linecap="round"/><g transform="translate(150 6)"><g class="f20"><path d="M26 0l26 9v22c0 18-12 30-26 36C12 61 0 49 0 31V9z" fill="#3182F6"/><path d="M14 33l9 9 17-19" stroke="#fff" stroke-width="5.4" stroke-linecap="round" stroke-linejoin="round" fill="none"/></g></g>'+star(34,40,0,'var(--br,#8F89FF)')+star(30,88,1)),
bike:()=>svg(sh(120,104)+'<circle cx="68" cy="78" r="20" fill="none" stroke="#4B5275" stroke-width="5"/><circle cx="172" cy="78" r="20" fill="none" stroke="#4B5275" stroke-width="5"/><path d="M68 78l32-30h46M100 48l12 30h-44M112 78l34-30 26 30M146 48l6-10h12M94 44h14" stroke="var(--br,#8F89FF)" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" fill="none"/><circle cx="112" cy="78" r="5" fill="#FFB400"/><g class="f20">'+coin(120,18,11)+'</g>'+star(30,34,0,'var(--br,#8F89FF)')+star(212,34,1)+star(34,96,2)),
ussd:()=>svg(sh(120,60)+'<rect x="90" y="8" width="60" height="96" rx="12" fill="#4B5275"/><rect x="97" y="16" width="46" height="30" rx="5" fill="#C7F5E1"/><text x="120" y="35" text-anchor="middle" font-size="11" font-weight="800" fill="#12805A" font-family="inherit">*182#</text><g fill="#9AA0B5"><circle cx="105" cy="58" r="4.5"/><circle cx="120" cy="58" r="4.5"/><circle cx="135" cy="58" r="4.5"/><circle cx="105" cy="72" r="4.5"/><circle cx="120" cy="72" r="4.5"/><circle cx="135" cy="72" r="4.5"/><circle cx="105" cy="86" r="4.5"/><circle cx="120" cy="86" r="4.5"/><circle cx="135" cy="86" r="4.5"/></g><g class="f20">'+coin(190,40,12)+'</g><g class="f20" style="animation-delay:-1.4s">'+coin(52,64,10)+'</g>'+star(34,22,0,'var(--br,#8F89FF)')+star(206,84,1)+star(60,94,2)),
invite:()=>svg(sh(120,70)+'<rect x="86" y="52" width="68" height="46" rx="8" fill="#FF7A8A"/><rect x="80" y="40" width="80" height="16" rx="6" fill="#FF9BA8"/><rect x="116" y="40" width="8" height="58" fill="#FFD966"/><path d="M120 40c-8-14-24-12-20-2 3 6 14 4 20 2zM120 40c8-14 24-12 20-2-3 6-14 4-20 2z" fill="none" stroke="#FFB400" stroke-width="4" stroke-linejoin="round"/><g class="f20">'+coin(48,48,12)+'</g><g class="f20" style="animation-delay:-1.6s">'+coin(192,48,12)+'</g>'+star(30,90,0,'var(--br,#8F89FF)')+star(210,92,1)+star(120,12,2))
});

Object.assign(P,{
bus:{ic:'bus',steps:['intro','go'],started:()=>!!S.busGo,
 h:'Book a bus seat<br>from Kigali',s:'Pick where you’re going, the day and the bus. Pay from itunda Pay and get your ticket right here.',
 vis:()=>ART.bus()+big('from 3,000 RWF')+cap('one way from Nyabugogo, 1 bag included'),
 ben:[['bus','A bus every 30 minutes','Leaves Nyabugogo, KN 3 Rd, all day.'],['wallet','Pay in one tap','The fare comes from your itunda Pay balance.'],['cal','Free to cancel','Cancel up to 2 hours before the bus leaves.']],
 facts:[['Departs','Nyabugogo, every 30 min'],['Fare (sample)','3,000 to 7,500 RWF'],['Luggage','1 bag included']],
 fine:'Times and fares are samples for this prototype. No real ticket is issued.',cta:'Find a bus'},
cashout:{ic:'cash',steps:['intro','go'],started:()=>false,
 h:'Move Pay money<br>to mobile money',s:'Send money from itunda Pay to your MTN MoMo or Airtel Money in about a minute. No fee.',
 vis:()=>ART.cashout()+big('5,000 RWF')+cap('arrives on your phone within a minute, free'),
 ben:[['cash','Free, every time','No fee to move your money out.'],['bolt','Arrives in a minute','It shows up in your mobile money wallet fast.'],['lock','You confirm first','See the amount and account before anything is sent.']],
 facts:[['Send to','MTN MoMo or Airtel Money'],['Limit','50,000 RWF each time'],['Fee','Free']],
 fine:'Sample amounts for this prototype. No real money moves.',cta:'Start cash out'},
atu:{ic:'bolt',steps:['intro','terms','ask','go'],started:()=>!!(S.atu&&S.atu.on),
 h:'Keep your Pay balance<br>topped up, automatically',s:'When your itunda Pay balance gets low, we add money for you from the account you pick.',
 vis:()=>ART.atu()+big('20,000 RWF')+cap('added automatically when your itunda Pay balance drops below 10,000 RWF'),
 ben:[['bolt','Refills on its own','Your balance gets low, we top it up. No need to remember.'],['lock','You set the limits','Choose the refill level, the amount, and a monthly limit.'],['bell','A text each time','Get an SMS after every refill, if you want one.']],
 facts:[['Refill level','You choose (10,000 RWF to start)'],['Take it from','MoMo, Airtel Money or itunda Bank'],['Monthly limit','You choose']],
 fine:'Sample amounts for this prototype. No real money moves.',cta:'Set up auto top-up',
 th:()=>'Turn on auto top-up<br>with clear terms',
 docs:()=>[['Auto top-up terms','We take money from the account you pick whenever your balance drops below your refill level, up to your monthly limit.'],['Your money source','You choose which account we take it from, and you can turn auto top-up off any time.'],['Privacy policy','We use your details only to run your refills and follow payment rules.']],
 key:'You choose the level, the amount and the monthly limit. You can turn it off any time. This is a prototype and no real money moves.',
 ask:'Money will leave your account on its own. If you agree without understanding, it can be hard to use your rights later.'},
cert:{ic:'verify',steps:['intro','terms','ask','go'],started:()=>!!(S.cz&&S.cz.st&&S.cz.st!=='none'),
 h:'Sign agreements<br>right in itunda',s:'Get a digital certificate and sign with a 4-digit PIN. A signed copy is kept in your documents.',
 vis:()=>ART.cert()+big('12 months')+cap('one certificate, valid for a year, free to get'),
 ben:[['verify','Sign in seconds','Approve an agreement with your 4-digit PIN.'],['bank','Accepted widely','Banks, SACCOs and employers can accept it.'],['clock','A copy is kept','Every signed agreement is stored in your documents.']],
 facts:[['Valid for','12 months'],['Accepted by','Banks, SACCOs, employers'],['Cost','Free']],
 fine:'Sample certificate for this prototype. Nothing you sign here is legally binding.',cta:'Get my certificate',
 th:()=>'Get your certificate<br>with clear terms',
 docs:()=>[['Certificate terms','Your certificate is valid for 12 months. Signing with your PIN counts as your signature.'],['Your PIN','Keep your 4-digit PIN to yourself. Anyone who has it can sign for you.'],['Privacy policy','We keep signed copies in your documents and use your details only to issue your certificate.']],
 key:'It is free and lasts 12 months. Keep your PIN private. This is a prototype and nothing you sign is binding.',
 ask:'A signature can commit you to an agreement. If you sign without understanding, it can be hard to use your rights later.'},
verify:{ic:'verify',steps:['intro','terms','ask','go'],started:()=>!!S.vf,
 h:'Prove it is you,<br>unlock more',s:'Confirm who you are with your National ID or passport to raise your limits and qualify for loans.',
 vis:()=>ART.verify()+big('5,000,000 RWF')+cap('what you can send each day once you are verified'),
 ben:[['verify','Prove it is you','Use your National ID or passport.'],['up','Higher limits','Send more each day, and qualify for loans.'],['clock','About 3 minutes','Most people finish in a few minutes.']],
 facts:[['You need','National ID or passport'],['Takes','About 3 minutes'],['Unlocks','Higher limits and loans']],
 fine:'Prototype only. No real ID is checked.',cta:'Start verification',
 th:()=>'Verify your identity<br>with clear terms',
 docs:()=>[['ID check terms','We check your ID details to confirm who you are before we raise your limits.'],['Consent to check','You agree that we may check your ID details with the issuer.'],['Privacy policy','We keep your ID details safe and use them only to verify you and follow banking rules.']],
 key:'It takes about 3 minutes. This is a prototype and no real ID is checked.',
 ask:'Your ID details are sensitive. If you agree without understanding, it can be hard to use your rights later.'},
bike:{ic:'busstop',steps:['intro','go'],started:()=>false,
 h:'Rent a bike<br>by the minute',s:'Scan, ride and lock it. You only pay for the minutes you used.',
 vis:()=>ART.bike()+big('300 RWF')+cap('for 15 minutes on a bike, at 20 RWF a minute'),
 ben:[['clock','Pay for the minutes','The ride ends when you lock it. You pay only for the time.'],['verify','Scan and go','Scan the QR on the handlebar and enter the unlock code.'],['busstop','Bikes and e-scooters','Pick whichever is nearest to you.']],
 facts:[['Bike','20 RWF a minute'],['E-scooter','50 RWF a minute'],['Paid from','itunda Pay']],
 fine:'Sample prices for this prototype. No real money moves.',cta:'Find a bike'},
ussd:{ic:'bank',steps:['intro','go'],started:()=>false,
 h:'Bank on any phone,<br>no data needed',s:'No smartphone, no internet. Dial a short code and use itunda from the menu.',
 vis:()=>ART.ussd()+big('*182*7#')+cap('dial this on any phone to open the menu'),
 ben:[['money','Check your balance','See what you have in a few taps.'],['plus','Send money','Send to a phone number from the menu.'],['bolt','Buy airtime','Top up MTN or Airtel.']],
 facts:[['Dial','*182*7#'],['Works on','MTN and Airtel'],['You need','Any phone']],
 fine:'Prototype only. The code is a sample.',cta:'See how it works'},
invite:{ic:'community',steps:['intro','go'],started:()=>false,
 h:'Invite a friend,<br>you both get 500 RWF',s:'Share your code. When your friend sends their first payment, you each get a reward.',
 vis:()=>ART.invite()+big('500 RWF')+cap('each, when your friend sends their first payment'),
 ben:[['community','Share your code','Send your code or invite link to a friend.'],['bolt','They send a first payment','Your friend joins itunda and makes a payment.'],['coin','You both get 500 RWF','The reward goes to you and your friend.']],
 facts:[['Your code','AMINA-K7'],['Reward','500 RWF each'],['Friends joined','0']],
 fine:'Sample reward for this prototype. No real money moves.',cta:'Get my code'}
});

/* ---------- pages ---------- */
const G={
intro:k=>{const c=P[k];
 const ben=c.ben.map(x=>'<div class="pg21-b"><div class="ico" style="width:44px;height:44px;flex:none">'+gl(x[0],26)+'</div><div style="min-width:0"><div class="t">'+x[1]+'</div><div class="s mu">'+x[2]+'</div></div></div>').join('');
 return {b:'<div class="pad" style="padding-top:12px">'+hd(c.h,c.s)+'</div><div class="pg21-h" data-i20="1">'+c.vis()+'</div><div class="pad" style="padding-top:22px">'+ben+'</div><div class="pg21-f">'+c.facts.map(x=>rw(x[0],x[1])).join('')+'</div><div class="pad fine" style="padding-top:16px">'+c.fine+'</div>',cta:{t:c.cta,fn:"pfgNext('"+k+"')"}}},
terms:k=>{const c=P[k],f=st(k),all=f.ck.every(Boolean);
 return {b:'<div class="pad" style="padding-top:12px">'+disc(c.ic,64)+'<div class="h1" style="margin-top:18px">'+c.th()+'</div><div class="mu" style="font-size:16px;margin-top:8px">Review these before you begin.</div><div style="margin-top:20px;padding:2px 16px;border-radius:18px;background:var(--chip)">'+ckRow(all,"pfgCkAll('"+k+"')",'Agree to all required terms','',1)+'</div><div style="margin-top:6px">'+c.docs().map((x,i)=>ckRow(f.ck[i],"pfgCk('"+k+"',"+i+")",x[0]+req,x[1])).join('')+'</div><div class="sm mu" style="margin-top:12px;line-height:20px">'+c.key+'</div></div>',cta:{t:'Agree',fn:"pfgNext('"+k+"')",dis:!all}}},
ask:k=>({b:'<div class="pad" style="padding-top:40px">'+disc('verify',72)+'<div class="h1" style="margin-top:22px">Did you understand<br>everything?</div><div class="mu" style="font-size:16px;line-height:24px;margin-top:10px">'+P[k].ask+'</div></div>',cta:{t:'I understand',fn:"pfgNext('"+k+"')"},sec:{t:'Read again',fn:"pfgPrev('"+k+"')"}})
};
const compose=(k,s,r)=>{const c=P[k],n=c.steps.length-2,i=c.steps.indexOf(s);
 const prog=s==='intro'?'':'<div role="progressbar" aria-label="Progress" aria-valuemin="0" aria-valuemax="'+n+'" aria-valuenow="'+i+'" style="height:3px;margin:0 24px;border-radius:2px;background:var(--chip)"><div style="height:3px;border-radius:2px;background:var(--br);width:'+Math.round(i/n*100)+'%;transition:width .3s"></div></div>';
 const btn='<button class="btn" id="pfgo" '+(r.cta.dis?'disabled ':'')+'onclick="'+r.cta.fn+'" style="white-space:nowrap">'+r.cta.t+'</button>';
 const sec=r.sec?'<button class="btn sec2" style="margin-top:8px;white-space:nowrap" onclick="'+r.sec.fn+'">'+r.sec.t+'</button>':'';
 return bar('')+prog+r.b+'<div style="height:'+(r.sec?190:120)+'px"></div><div class="cta">'+btn+sec+'</div>'};
const page=k=>{const s=P[k].steps[st(k).i];return compose(k,s,G[s](k))};

/* ---------- handlers ---------- */
window.pfgNext=k=>{const c=P[k],s=st(k),nx=c.steps[s.i+1];if(!nx)return;
 if(nx==='go'){s.open=1;if(c.onOpen)try{c.onOpen()}catch(e){}render('push');return}
 s.i++;render('push')};
window.pfgPrev=k=>{const s=st(k);if(s.i>0){s.i--;render('pop')}};
window.pfgCk=(k,i)=>{const s=st(k);s.ck[i]=s.ck[i]?0:1;render('fade-none')};
window.pfgCkAll=k=>{const s=st(k),v=s.ck.every(Boolean)?0:1;s.ck=s.ck.map(()=>v);render('fade-none')};

/* ---------- hook: English only, and only until the person has been through it ---------- */
const gate=k=>S.lang==='en'&&P[k]&&!st(k).open&&!P[k].started();
const _svc=screens.svc;
const OLDHEAD=/<div style="padding:22px 24px 0"><div style="width:72px;height:72px[^"]*">[^<]*<\/div><div class="h1"[^>]*>[^<]*<\/div><div class="mu"[^>]*>[^<]*<\/div><\/div>/;
screens.svc=function(){const k=S.svk;if(P[k]&&k!=='fx'&&gate(k))return page(k);
 const h=_svc.apply(this,arguments);
 /* Harvest and VUP are one long form that repeats the icon, title and blurb the explainer just showed; after it, start at the first question */
 if(k==='call'&&S.lang==='en'&&typeof h==='string')return h.replace(/<div style="width:72px;height:72px[^"]*">[^<]*<\/div>/,'<div style="margin:0 -24px">'+ART.call()+'</div>');
 if(k==='bus'&&S.lang==='en'&&st(k).open&&typeof h==='string')return h.replace(/<div style="padding:22px 24px 0"><div class="h1">Intercity bus<\/div><div class="mu"[^>]*>[^<]*<\/div><\/div>/,'');
 if((k==='harvest'||k==='vup'||k==='cashout')&&S.lang==='en'&&P[k]&&st(k).open&&!apps(k)&&typeof h==='string')return h.replace(OLDHEAD,'');
 return h};
const _fx=screens.fx;
screens.fx=function(){if(gate('fx'))return page('fx');return _fx.apply(this,arguments)};
if(window.icBook&&!window.icBook.__p){const _ib=window.icBook;window.icBook=function(){S.busGo=1;return _ib.apply(this,arguments)};window.icBook.__p=1}
const _os=window.openSvc;
window.openSvc=function(k){if(P[k]&&!st(k).open){const s=st(k);s.i=0;s.ck=[0,0,0]}return _os.apply(this,arguments)};
const _bk=window.back;
window.back=function(){const t=S.stack&&S.stack[S.stack.length-1],k=t==='fx'?'fx':t==='svc'?S.svk:null;
 if(k&&P[k]&&gate(k)){const s=st(k);if(s.i>0){s.i--;render('pop');return}s.ck=[0,0,0]}
 return _bk.apply(this,arguments)};
})()}catch(err){console.error('v921',err)}</script>

<style id="v923toss">
/* v923: Toss-style pass 50. Rides: destination chips become real pills (dark when chosen), vehicles are soft rounded cards with a bigger price, the route box sits inset. Subscriptions: one calm total, the next charge as a soft note, summary in a rounded block, 19px section titles, 48px icon tiles, a dimmer second line, and the total rolls up when the screen opens. */
#phone .screen:has(.rbox) .rbox{margin:14px 24px 0;padding:6px 16px;border-radius:20px}
#phone .screen:has(.rbox) .agt{font-size:19px;font-weight:800;color:var(--tx);padding:28px 24px 0!important}
#phone .screen:has(.rbox) .chp{display:flex;flex-wrap:nowrap!important;gap:8px;overflow-x:auto;scrollbar-width:none;padding:12px 24px 4px!important;background:none!important;height:auto!important}
#phone .screen:has(.rbox) .chp::-webkit-scrollbar{display:none}
#phone .screen:has(.rbox) .chp button{flex:0 0 auto;height:40px;padding:0 18px;border:0;border-radius:20px;background:var(--chip)!important;color:var(--tx)!important;font-size:15px;font-weight:600;letter-spacing:-.2px}
#phone .screen:has(.rbox) .chp button.on{background:var(--tx)!important;color:var(--bg)!important}
#phone .screen:has(.rbox) .chp button:active{transform:scale(.96)}
#phone .screen:has(.rbox) .row.tap{margin:4px 16px 0;padding:14px 16px!important;min-height:76px;border-radius:20px}

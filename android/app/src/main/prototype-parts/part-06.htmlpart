 rows.forEach(function(r){var k=rk(r);
  if(deleted[k]){r.remove();return}
  r.classList.toggle('v21p',!!pinned[k]);
  if(r.getAttribute('data-v21s'))return;r.setAttribute('data-v21s','1');r.classList.add('v21s');wireRow(r)});
 var par=rows[0]&&rows[0].parentNode;if(!par)return;
 var nx=function(el){var n=el.nextElementSibling;while(n&&!n.classList.contains('mm-row'))n=n.nextElementSibling;return n};
 var lead=par.querySelector(':scope>.mm-row');
 [].slice.call(par.querySelectorAll(':scope>.mm-row.v21p')).forEach(function(p){if(p===lead)lead=nx(p);else if(lead)par.insertBefore(p,lead)});
};
var wireRow=function(r){
 var st=null,sup=0;

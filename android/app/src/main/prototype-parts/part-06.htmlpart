<style id="v1007css">
/* v1007: graphics + interaction layer. Cards get depth, the first card gets a brand wash, tabs get an active pill, cards rise in on scroll, buttons ripple, payment success bursts confetti. */
#phone#phone .hc{box-shadow:0 1px 2px rgba(25,31,40,.04),0 10px 28px rgba(98,88,245,.07)}
#phone#phone .top+.hc{position:relative;isolation:isolate}
#phone#phone .top+.hc::before{content:"";position:absolute;inset:0;z-index:-1;border-radius:inherit;pointer-events:none;background:radial-gradient(110% 80% at 100% 0%,rgba(143,137,255,.30) 0%,transparent 60%),radial-gradient(60% 50% at 0% 100%,rgba(143,137,255,.16) 0%,transparent 64%)}
#phone#phone .top+.hc .ha{transition:filter .25s}
#phone.v7hide .top+.hc .ha{filter:blur(9px)}
#phone#phone .tabs button{position:relative;transition:color .2s}
#phone#phone .tabs button.on::before{content:"";position:absolute;top:2px;left:50%;width:22px;height:3px;margin-left:-11px;border-radius:2px;background:var(--cta,#6258F5);animation:v7pill .3s cubic-bezier(.2,.9,.3,1.3)}
#phone#phone .tabs button.on svg{animation:v7tab .4s cubic-bezier(.2,.9,.3,1.4)}
@keyframes v7pill{from{transform:scaleX(0)}}@keyframes v7tab{0%{transform:scale(.78)}60%{transform:scale(1.14)}100%{transform:none}}

#phone .bk9-q::before,#phone .bk9-q::after{content:"";position:absolute;inset:18px;border-radius:14px;border:3px solid var(--br);-webkit-mask:linear-gradient(#000 0 0) top left/36px 36px no-repeat,linear-gradient(#000 0 0) top right/36px 36px no-repeat,linear-gradient(#000 0 0) bottom left/36px 36px no-repeat,linear-gradient(#000 0 0) bottom right/36px 36px no-repeat;mask:linear-gradient(#000 0 0) top left/36px 36px no-repeat,linear-gradient(#000 0 0) top right/36px 36px no-repeat,linear-gradient(#000 0 0) bottom left/36px 36px no-repeat,linear-gradient(#000 0 0) bottom right/36px 36px no-repeat}
#phone .bk9-q::after{inset:auto 26px;top:30px;height:3px;border:0;border-radius:2px;background:var(--br);-webkit-mask:none;mask:none;animation:bk9s 2s ease-in-out infinite alternate}

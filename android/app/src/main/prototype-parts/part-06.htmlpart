#phone#phone#phone#phone .screen .emp{background:transparent!important;border-radius:0!important;padding-top:56px!important}
/* v995: selected destination row is a soft violet tint with rounded corners instead of an edge-to-edge gray bar */
#phone#phone#phone#phone .screen .dvr.on{background:var(--tint)!important;border-radius:16px!important;box-shadow:none!important;margin-left:12px!important;margin-right:12px!important;padding-left:12px!important;padding-right:12px!important}
/* v996: disabled primary buttons keep the brand hue as a soft tint, like Toss, instead of flat gray */
#phone#phone#phone#phone .cta .btn:disabled,#phone#phone#phone#phone .cta .btn[aria-disabled="true"],#phone#phone#phone#phone .btn:disabled:not(.sec2){background:var(--tint)!important;color:var(--tintfg)!important;opacity:.7!important}
</style>
<script>
/* v992: tag selected pill-sized chips so every screen shares one selected style, however the older passes styled them. */
(function(){try{
var raf=0;
function sel(e){return e.classList.contains('on')||e.getAttribute('aria-pressed')==='true'||e.getAttribute('aria-selected')==='true'}
function scan(){raf=0;var ph=document.getElementById('phone');if(!ph)return;nest();
ph.querySelectorAll('.screen button,.screen [role=tab],.screen .tap').forEach(function(e){
 var s=false;
 if(sel(e)&&!e.closest('.tabs,.sw,.keys,.cta,.sheetbg')){var r=e.getBoundingClientRect();
  if(r.height>=26&&r.height<=46&&r.width>0&&r.width<=200&&parseFloat(getComputedStyle(e).borderTopLeftRadius)>=10&&e.textContent.trim().length>0&&e.textContent.trim().length<24&&!e.querySelector('svg:only-child'))s=true}
 if(s){if(e.dataset.sel!=='1')e.dataset.sel='1'}else if(e.dataset.sel)delete e.dataset.sel})}
function nest(){var ph=document.getElementById('phone');if(!ph)return;var pl=ph.getBoundingClientRect().left;ph.querySelectorAll('.screen .sec').forEach(function(e){var r=e.getBoundingClientRect();if(!r.width)return;var c=e.firstElementChild,n=(r.left-pl)>8||(c&&parseFloat(getComputedStyle(c).paddingLeft)>=16&&!(e.parentElement&&e.parentElement.classList.contains('cta')));if(n){if(e.dataset.nest!=='1')e.dataset.nest='1'}else if(e.dataset.nest)delete e.dataset.nest})}
function q(){if(!raf)raf=requestAnimationFrame(scan);clearTimeout(q.t1);clearTimeout(q.t2);q.t1=setTimeout(scan,260);q.t2=setTimeout(scan,900)}
function go(){var ph=document.getElementById('phone');if(!ph)return;
 new MutationObserver(q).observe(ph,{childList:true,subtree:true,attributes:true,attributeFilter:['class','aria-pressed','aria-selected']});q()}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',go);else go();
}catch(e){console.error('v992',e)}})();
</script>

  h.style.opacity=String(1-k*.9);h.style.transform=k?'translateY('+(-k*6).toFixed(1)+'px)':'';
  var now=k>=.7?1:0;if(now!==on){on=now;t.classList.toggle('on',!!on);if(on)try{navigator.vibrate&&navigator.vibrate(3)}catch(e){}}};
 sc.addEventListener('scroll',function(){if(!tick)tick=requestAnimationFrame(run)},{passive:true});
 run()};
var busy=0,go=function(){if(busy)return;busy=1;try{wire()}catch(e){console.error('v1023',e)}busy=0};
new MutationObserver(go).observe(document.getElementById('view')||ph,{childList:true,subtree:false});go();
}catch(e){console.error('v1023',e)}})();
</script>
<style id="v1024css">
/* v1024: segmented tabs glide. When you switch a Toss-style tab or segment (This month / Last month, filters, and similar), the selected pill or underline slides from the old tab to the new one with a soft overshoot instead of jumping. Solid fills only. */
#phone .seg{position:relative}
#phone .seg>.v24g{position:absolute;z-index:0;pointer-events:none;box-sizing:border-box;margin:0}
#phone .seg>button{position:relative;z-index:1}
#phone .seg>button.v24h{background:transparent!important;border-bottom-color:transparent!important;box-shadow:none!important}
</style><script id="v1024js">
(function(){try{

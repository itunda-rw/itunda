 const r=R.querySelectorAll('.nv-r .mu');
 r.forEach(x=>{const t=x.textContent.trim();let m;
  if(m=t.match(/^Visitor reviews (\d+)$/))x.textContent='· '+m[1]+' reviews';
  else if(m=t.match(/^Saved (\d+)$/))x.textContent='· '+m[1]+' saved'});
 R.querySelectorAll('.nv-q > button').forEach(b=>{if(/mpDir\(/.test(b.getAttribute('onclick')||''))b.remove()});
 const ob=R.querySelector('.nv-ob');
 if(ob){[...ob.querySelectorAll('button')].forEach(b=>{if(/plRsv/.test(b.getAttribute('onclick')||''))b.remove()});noEf(ob)}
 noEf(R.querySelector('.nv-cp > span'));noEf(R.querySelector('.pz-stamp > span'));
 const f=R.querySelector('.nv-cp > span');if(f&&!f.textContent.trim())f.remove();
 const f2=R.querySelector('.pz-stamp > span');if(f2&&!f2.textContent.trim())f2.remove();
 const mk=document.createElement('i');mk.setAttribute('data-v989','1');mk.style.display='none';R.insertBefore(mk,R.firstChild);
 return R.innerHTML}catch(e){console.error('v989 place',e);return h}};
})()}catch(e){console.error('v989',e)}

#phone .v942row{min-height:64px!important;gap:14px!important}
#phone .v942row>span:nth-child(2){font-size:17px!important;font-weight:700!important}
#phone .v942row>span:first-child{width:40px!important;height:40px!important;border-radius:14px!important}
</style>
<script id="v942js">(function(){try{
if(typeof screens==='undefined'||!screens.loan)return;
var _l=screens.loan;
screens.loan=function(){
 var h=_l.apply(this,arguments);if(typeof h!=='string')return h;
 var d=document.createElement('div');d.innerHTML=h;
 var s=d;var btn=s&&s.querySelector('.btn[onclick="lhStart()"]');
 if(!btn)return h;
 var cta=btn.parentElement,kids=[].slice.call(s.children);
 var i=kids.indexOf(cta);
 var st=kids[i-2],art=kids[i-1];
 if(st&&/gap:20px/.test(st.getAttribute('style')||''))st.className='v942stat',st.removeAttribute('style');
 if(art&&/justify-content:center/.test(art.getAttribute('style')||'')&&art.querySelector('svg'))art.remove();
 cta.className='v942cta';cta.removeAttribute('style');s.appendChild(cta);
 [].forEach.call(s.querySelectorAll('.tap[role=button]'),function(r){if(r.style.minHeight)r.classList.add('v942row')});
 return d.innerHTML};
}catch(e){console.warn('v942',e)}})();
</script>
<style id="v943toss">/* v943, Toss-style pass 58. Loan amount: the number is the hero (48px), the quick amounts and the "opens at a score" note sit right on the Next bar, and everything else is white space. */
#phone .screen [role=status][style*="font-size:40px"]{font-size:48px!important;line-height:56px!important;letter-spacing:-1.4px!important;padding-top:32px!important}
#phone .screen [role=status][style*="font-size:40px"] span{font-size:24px!important;color:var(--mu);margin-left:2px}

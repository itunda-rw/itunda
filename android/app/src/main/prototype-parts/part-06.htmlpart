#phone .screen:has(#hdl) .hdc .t{font-size:16px!important;line-height:22px!important;font-weight:600!important;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
#phone .screen:has(#hdl) .hdc .s{font-size:13px!important;line-height:18px!important;color:var(--tt)!important;margin-top:3px!important}
#phone .screen:has(#hdl) .hdc .pr{font-size:17px!important;font-weight:700!important;letter-spacing:-.3px;margin-top:6px!important}
#phone .screen:has(#hdl) #hdch{display:flex;flex-wrap:nowrap;gap:8px;overflow-x:auto;scrollbar-width:none;padding:12px 24px 4px!important}
#phone .screen:has(#hdl) #hdch::-webkit-scrollbar{display:none}
#phone .screen:has(#hdl) #hdch .cch{flex:none;height:36px;padding:0 16px;border:0!important;border-radius:18px!important;background:var(--chip)!important;color:var(--tx)!important;font-size:14px;font-weight:600;white-space:nowrap}
#phone .screen:has(#hdl) #hdch .cch.on{background:var(--tx)!important;color:var(--bg)!important}
</style>
<script id="v940t">(function(){var t=function(){document.title=document.title.replace(/v\d+/,'v997')};t();var n=0,iv=setInterval(function(){t();if(++n>14)clearInterval(iv)},500)})();</script>
<style id="v971mk">/* v971, Marketplace list and Talk (chat from a listing). v970 styled #hdl/.hdc, which the Marketplace no longer uses (it is .dg-r now), so the list kept its 136px pictures and grey lines. Now: rows are flat with no line, a 96px rounded picture, the heart sits top-right of the row with no white badge on the picture, and the chat and save counts show again as a quiet 13px line at the bottom-right (Safe pay stays on the left). In Talk the "Pay safely" bar and the safety note become two soft rounded blocks with the same 24px side margin as the messages, and the note is flat grey with no outline. */
#phone #mxl2 .dg-r.dg-r.dg-r{position:relative;gap:14px;margin:0;padding:14px 24px!important;min-height:0;border:0!important;border-bottom:0!important;align-items:flex-start}
#phone #mxl2 .dg-r.dg-r.dg-r .dg-th.dg-th.dg-th{width:96px!important;height:96px!important;min-width:96px!important;max-width:96px!important;flex:0 0 96px!important;border-radius:16px!important}
#phone #mxl2 .dg-r.dg-r.dg-r .dg-b{min-width:0;flex:1;min-height:96px}
#phone #mxl2 .dg-r.dg-r.dg-r .dg-t{padding-right:30px;font-size:16px;line-height:22px;font-weight:600}
#phone #mxl2 .dg-r.dg-r.dg-r .dg-s{font-size:13px;line-height:18px;margin-top:2px}
#phone #mxl2 .dg-r.dg-r.dg-r .dg-p{font-size:17px;font-weight:700;letter-spacing:-.3px;margin-top:4px}
#phone #mxl2 .dg-r.dg-r.dg-r .dg-h.dg-h.dg-h.dg-h{position:absolute!important;top:10px!important;right:14px!important;left:auto!important;bottom:auto!important;width:36px;height:36px;background:none!important;box-shadow:none!important;display:flex;align-items:center;justify-content:center}
#phone #mxl2 .dg-r.dg-r.dg-r .dg-m.dg-m{display:flex!important;align-items:center;gap:10px;justify-content:flex-end;margin-top:auto;padding-top:6px}
#phone #mxl2 .dg-r.dg-r.dg-r .dg-m .mk-sp{margin-right:auto}
#phone #mxl2 .dg-r.dg-r.dg-r .dg-m span:not(.mk-sp){white-space:nowrap;display:inline-flex!important;align-items:center;gap:3px;font-size:13px;line-height:18px;font-weight:500;color:var(--tt)}
#phone .screen .t26-pay{margin:12px 24px 0!important;width:calc(100% - 48px)!important;min-height:48px;border-radius:14px!important;font-size:15px;font-weight:600}
#phone .screen .c24-safe{margin:10px 24px 0!important;padding:12px 16px!important;border:0!important;border-radius:14px!important;background:var(--chip)!important;font-size:13px;line-height:19px;color:var(--mu)!important}
#phone .screen .c24-safe button{font-size:13px}
#phone #mxl2 .dg-r.dg-r.dg-r .dg-th.dg-th.dg-th svg{width:56px!important;height:56px!important}
</style>
<style id="v972pr">/* v972, Property list: same calm rows as Marketplace (v971). No line between homes, a 96px rounded picture, the heart top-right with no badge on the picture, a 17px two-line title, the price as the strong line and one quiet 13px line for type, beds and size. Talk from a home gets the same soft blocks as Marketplace, and the line under the quick-action chips is gone. */
#phone #pnl .dg-r.dg-r.dg-r{position:relative;gap:14px;margin:0;padding:14px 24px!important;border:0!important;border-bottom:0!important;align-items:flex-start}
#phone #pnl .dg-r.dg-r.dg-r .dg-th.dg-th.dg-th{width:96px!important;height:96px!important;min-width:96px!important;max-width:96px!important;flex:0 0 96px!important;border-radius:16px!important}
#phone #pnl .dg-r.dg-r.dg-r .dg-th.dg-th.dg-th svg{width:56px!important;height:56px!important}
#phone #pnl .dg-r.dg-r.dg-r .dg-b.dg-b{min-height:96px}
#phone #pnl .dg-r.dg-r.dg-r .dg-t{font-size:16px!important;line-height:22px!important;font-weight:600!important;padding-right:30px}
#phone #pnl .dg-r.dg-r.dg-r .dg-p{font-size:17px!important;font-weight:700!important;letter-spacing:-.3px;margin-top:4px!important}
#phone #pnl .dg-r.dg-r.dg-r .dg-p i{font-size:13px;font-weight:500;color:var(--tt);font-style:normal}
#phone #pnl .dg-r.dg-r.dg-r .jn-sh{color:var(--tt);margin-top:3px}
#phone #pnl .dg-r.dg-r.dg-r .dg-h.dg-h.dg-h.dg-h{position:absolute!important;top:10px!important;right:14px!important;left:auto!important;bottom:auto!important;width:36px;height:36px;background:none!important;box-shadow:none!important;display:flex;align-items:center;justify-content:center}
#phone .screen .t26-act{border-bottom:0!important;padding-bottom:4px!important}
#phone .screen .c24-ctx{padding:10px 0 6px}
</style>
<style id="v974flat">/* v974, no more glass, and real options. (1) Every blur is off inside the phone: pages and sheets (Set a meet-up, List a home, Post a job, Filter ...), the bottom bar, the action bar and the dim behind sheets are solid and calm, like Toss. (2) Any group of choices on a full page (List a home: Owner/Agent, Available, Costs; Post a job; Perks; ...) was a bare text list with a thin check. They are now 52px soft rows with a round check on the right, and the chosen row turns soft brand. */
#phone#phone#phone#phone,#phone#phone#phone#phone *{-webkit-backdrop-filter:none!important;backdrop-filter:none!important}
#phone#phone#phone#phone .sheetbg{background:rgba(0,0,0,.48)!important}
#phone#phone#phone#phone .sheet:not(.v6pg){background:var(--bg)!important;border:0!important;box-shadow:0 -10px 40px -12px rgba(0,0,0,.18)!important}
#phone#phone#phone#phone .sheet.v6pg{box-shadow:none!important;border:0!important}
#phone#phone#phone#phone .tabs{background:var(--bg)!important;border-top:0!important;box-shadow:0 -1px 0 var(--chip)!important}
#phone#phone#phone#phone .cta{background:var(--bg)!important;border-top:0!important}
#phone #layer .sheet .v6b > div[style*="flex-wrap:wrap"]:has(>.cch){display:flex!important;flex-direction:column;flex-wrap:nowrap!important;gap:8px!important;margin-top:10px!important}
#phone #layer .sheet .v6b > div[style*="flex-wrap:wrap"] > .cch{position:relative;width:100%;min-height:52px;padding:0 52px 0 18px!important;margin:0!important;border:0!important;border-radius:16px!important;background:var(--chip)!important;color:var(--tx)!important;font-size:16px!important;font-weight:600!important;text-align:left;justify-content:flex-start;box-shadow:none!important;transition:background .15s}
#phone #layer .sheet .v6b > div[style*="flex-wrap:wrap"] > .cch::after{content:""!important;position:absolute;right:18px;top:15px;width:22px;height:22px;margin:0;border-radius:11px;border:2px solid #cdd3da!important;background:none;box-sizing:border-box;color:#fff;font-size:13px;font-weight:800;line-height:18px;text-align:center;transform:none!important}
#phone #layer .sheet .v6b > div[style*="flex-wrap:wrap"] > .cch.on{background:var(--tint)!important;color:var(--tintfg)!important;font-weight:600!important}
#phone #layer .sheet .v6b > div[style*="flex-wrap:wrap"] > .cch.on::after{content:"✓"!important;background:var(--lk);border-color:var(--lk)!important}
#phone#phone#phone#phone .dg-sg{display:flex!important;flex-direction:column;gap:8px;margin-top:10px!important}
#phone#phone#phone#phone .dg-sg button{position:relative;width:100%;min-height:52px!important;height:auto;padding:0 52px 0 18px!important;border:0!important;border-radius:16px!important;background:var(--chip)!important;color:var(--tx)!important;font-size:16px!important;font-weight:600!important;text-align:left;justify-content:flex-start!important;box-shadow:none!important;transition:background .15s}
#phone#phone#phone#phone .dg-sg button::after{content:""!important;position:absolute;right:18px;top:15px;width:22px;height:22px;margin:0;border-radius:11px;border:2px solid #cdd3da!important;background:none;box-sizing:border-box;color:#fff;font-size:13px;font-weight:800;line-height:18px;text-align:center;transform:none!important}
#phone#phone#phone#phone .dg-sg button.on{background:var(--tint)!important;color:var(--tintfg)!important}
#phone#phone#phone#phone .dg-sg button.on::after{content:"✓"!important;background:var(--lk);border-color:var(--lk)!important}
</style>
<style id="v973meet">/* v973, Set a meet-up: a plain solid page (no blur or glass), a 26px title, and the choices as real Toss-style options. Where is three 56px rows with a round check on the right; When is a two-column grid of 52px pills. The chosen one turns soft brand with a filled check. */
#phone#phone .sheet.v6pg:has(.mk-s){-webkit-backdrop-filter:none!important;backdrop-filter:none!important;background:var(--bg)!important}
#phone .sheet.v6pg:has(.mk-s) .h1{font-size:26px!important;line-height:34px!important;font-weight:700!important;letter-spacing:-.5px}
#phone .sheet.v6pg:has(.mk-s) .v6b>.sm{font-size:15px;line-height:22px;margin-top:8px!important}
#phone .sheet.v6pg:has(.mk-s) .lab{margin-top:28px!important;font-size:15px;font-weight:600;color:var(--mu);letter-spacing:0}
#phone #layer .sheet.v6pg .v6b > div[style*="flex-wrap:wrap"]:has(>.mk-s){display:flex!important;flex-direction:column;flex-wrap:nowrap!important;gap:8px!important;margin-top:10px!important}
#phone #layer .sheet.v6pg .v6b > div[style*="flex-wrap:wrap"]:has(>.mk-t){display:grid!important;grid-template-columns:1fr 1fr;gap:8px!important;margin-top:10px!important}
#phone #layer .sheet.v6pg .v6b > div[style*="flex-wrap:wrap"] > .cch.mk-s,#phone #layer .sheet.v6pg .v6b > div[style*="flex-wrap:wrap"] > .cch.mk-t{border:0!important;background:var(--chip)!important;background-color:var(--chip)!important;color:var(--tx)!important;font-size:16px;font-weight:600;border-radius:16px!important;box-shadow:none!important;position:relative;transition:background .15s}
#phone #layer .sheet.v6pg .v6b > div[style*="flex-wrap:wrap"] > .cch.mk-s{width:100%;height:56px!important;padding:0 52px 0 18px!important;text-align:left;justify-content:flex-start;font-weight:600!important}
#phone #layer .sheet.v6pg .v6b > div[style*="flex-wrap:wrap"] > .cch.mk-t{height:52px!important;padding:0 12px;text-align:center;justify-content:center;font-size:15px}
#phone #layer .sheet.v6pg .v6b > div[style*="flex-wrap:wrap"] > .cch.mk-s::before{display:none!important}
#phone #layer .sheet.v6pg .v6b > div[style*="flex-wrap:wrap"] > .cch.mk-s::after{content:""!important;position:absolute;right:18px;top:17px!important;bottom:auto!important;left:auto!important;width:22px;height:22px;margin:0!important;border-radius:11px;border:2px solid #cdd3da;background:none;box-sizing:border-box;color:#fff;font-size:13px;font-weight:800;line-height:18px;text-align:center;transform:none!important}
#phone #layer .sheet.v6pg .v6b > div[style*="flex-wrap:wrap"] > .cch.mk-s.on::after{content:"✓"!important;background:var(--lk);border-color:var(--lk)}
#phone #layer .sheet.v6pg .v6b > div[style*="flex-wrap:wrap"] > .cch.mk-s.on,#phone #layer .sheet.v6pg .v6b > div[style*="flex-wrap:wrap"] > .cch.mk-t.on{background:var(--tint)!important;background-color:var(--tint)!important;color:var(--tintfg)!important}
#phone #layer .sheet.v6pg .v6b > div[style*="flex-wrap:wrap"] > .cch.mk-t::before,#phone #layer .sheet.v6pg .v6b > div[style*="flex-wrap:wrap"] > .cch.mk-t::after{display:none!important;content:none!important}
#phone #layer .sheet.v6pg .v6b > div[style*="flex-wrap:wrap"] > .cch.mk-t.on{font-weight:600!important}
</style>
<style id="v975css">
/* v975: the post composer (What do you want to say? / Who should see it? / Ready to post?) is a normal page like Toss, not a glass page. Solid white in light mode, solid #17171C in dark mode: no blur, no smoke, no gradient, nothing from the screen behind shows through. */
#layer:has([data-cqpg]) .sheetbg{display:none!important}
#phone#phone#phone .sheet.v6pg:has([data-cqpg]){--bg:#fff;--tx:#191F28;--mu:#6B7684;--tt:#6B7684;--chip:#F2F4F6;--ln:#E5E8EB;--gl-fill:#F2F4F6;--gl-edge:transparent;--gl-edge2:transparent;
background:#fff!important;background-image:none!important;color:var(--tx);-webkit-backdrop-filter:none!important;backdrop-filter:none!important;box-shadow:none!important;border:0!important;border-radius:0!important}
#phone#phone#phone .sheet.v6pg:has([data-cqpg]) .v6h,#phone#phone#phone .sheet.v6pg:has([data-cqpg]) .v6b,#phone#phone#phone .sheet.v6pg:has([data-cqpg]) .v6cta{background:var(--bg)!important;-webkit-backdrop-filter:none!important;backdrop-filter:none!important;box-shadow:none!important;border:0!important}
@media (prefers-color-scheme:dark){:root:not([data-theme=light]) #phone#phone#phone .sheet.v6pg:has([data-cqpg]){--bg:#17171C;--tx:#fff;--mu:#A0A7B4;--tt:#A0A7B4;--chip:#202027;--ln:#2C2C35;--gl-fill:#202027;background:#17171C!important}}
:root[data-theme=dark] #phone#phone#phone .sheet.v6pg:has([data-cqpg]){--bg:#17171C;--tx:#fff;--mu:#A0A7B4;--tt:#A0A7B4;--chip:#202027;--ln:#2C2C35;--gl-fill:#202027;background:#17171C!important}
</style>
<style id="v975global">
/* v975: no glass anywhere. Normal Toss-style pages: solid page colour (white / #17171C), flat grey cards, solid sheets and menus, a plain dim behind sheets, bars that fade out of the page colour with no smoke, tint or blur. */
:root{--sm-a:transparent;--sm-b:transparent;--mo-pg:#fff;--mo-pgbg:#fff;--mo-dd:#fff;--mo-ddsh:0 8px 24px -8px rgba(0,0,0,.18)}
@media (prefers-color-scheme:dark){:root:not([data-theme=light]){--sm-a:transparent;--sm-b:transparent;--mo-pg:#17171C;--mo-pgbg:#17171C;--mo-dd:#2C2C35;--mo-ddsh:0 8px 24px -8px rgba(0,0,0,.5)}}
:root[data-theme=dark]{--sm-a:transparent;--sm-b:transparent;--mo-pg:#17171C;--mo-pgbg:#17171C;--mo-dd:#2C2C35;--mo-ddsh:0 8px 24px -8px rgba(0,0,0,.5)}
#phone#phone{--gl-base:var(--bg);--gl-fill:var(--chip);--gl-fill2:var(--chip);--gl-tile:var(--chip);--gl-card:var(--chip);--gl-edge:transparent;--gl-edge2:transparent;--gl-shadow:0 0 0 0 transparent;--gl-hi:0 0 0 0 transparent}
/* pages */
#phone#phone#phone .sheet.v6pg{background:var(--bg)!important;background-image:none!important;-webkit-backdrop-filter:none!important;backdrop-filter:none!important;box-shadow:none!important}
#phone#phone#phone .sheet.v6pg .v6h,#phone#phone#phone .sheet.v6pg .v6b{background:var(--bg)!important}
/* sheets and modals: solid card on a plain dim */
#phone .sheetbg.smk-full{-webkit-backdrop-filter:none!important;backdrop-filter:none!important;-webkit-mask-image:none!important;mask-image:none!important}
#phone#phone#phone #layer .sheet:not(.v6pg){background:var(--bg)!important;background-image:none!important;border-radius:24px 24px 0 0!important;box-shadow:none!important;-webkit-backdrop-filter:none!important;backdrop-filter:none!important}
/* bars: solid page colour, fading into the content, no haze or blur */
#phone#phone :is(.top,.xp .xh)::before{background:linear-gradient(180deg,var(--bg) 62%,transparent)!important;-webkit-backdrop-filter:none!important;backdrop-filter:none!important;-webkit-mask-image:none!important;mask-image:none!important}
#phone#phone :is(.tabs,.cta)::before{background:linear-gradient(0deg,var(--bg) 62%,transparent)!important;-webkit-backdrop-filter:none!important;backdrop-filter:none!important;-webkit-mask-image:none!important;mask-image:none!important}
#phone#phone .tabs::before{background:var(--bg)!important;top:0!important}
#phone#phone :is(.screen .bar,.screen .ahead){background:var(--bg)!important}
#phone nav.tabs{-webkit-backdrop-filter:none!important;backdrop-filter:none!important}
/* the button bar of a page sits straight on the page colour: no fade layer behind it */
#phone#phone#phone .sheet.v6pg .v6cta::before,#phone#phone#phone .sheet.v6pg .cta::before{display:none!important}
</style>
<style id="pay976">
/* v976: Pay tab, Toss-style redesign in itunda colours. Theme-aware surface, segmented tabs, big plain type, grey rounded cards, one lavender accent, a payment-method row that opens a bottom sheet. Scan stays dark like every scanner. */
#phone#phone#phone .pcd{--lv:#8F89FF;--soft:var(--mu);background:var(--bg);color:var(--tx)}
#phone#phone#phone .pcd .ib{color:var(--tx)!important}
#phone#phone#phone .pcd .tp704bar span{color:var(--tx)!important;font-size:30px;font-weight:800!important;letter-spacing:-1.2px;line-height:1;transform:translateY(-1px)}
#phone#phone#phone .pcd .tp704bar span::before{content:none}
#phone#phone#phone .pcd .tp704bar{gap:7px}
#phone#phone#phone .pcd .ib.pclang{width:auto!important;min-width:40px;height:32px!important;padding:0 11px;margin:6px 4px 0 0;border-radius:16px!important;background:var(--chip)!important;color:var(--mu)!important;font-size:12px;font-weight:800;letter-spacing:.4px}
/* segmented tabs */
#phone#phone#phone .pcd .tabs2{margin:10px 20px 0;padding:4px;gap:2px;border:0;border-radius:14px;background:var(--chip)}
#phone#phone#phone .pcd .tabs2 button{min-height:40px;border:0;border-radius:11px;color:var(--mu);font-size:15px;font-weight:700;transition:background .2s,color .2s}
#phone#phone#phone .pcd .tabs2 button[aria-selected=true]{background:var(--bg);color:var(--tx);box-shadow:0 1px 3px rgba(0,0,0,.1)}
@media (prefers-color-scheme:dark){:root:not([data-theme=light]) #phone#phone#phone .pcd .tabs2 button[aria-selected=true]{background:#3A3A44}}
:root[data-theme=dark] #phone#phone#phone .pcd .tabs2 button[aria-selected=true]{background:#3A3A44}
#phone#phone#phone .pcd .bd{display:flex;flex-direction:column;min-height:0}
#phone#phone#phone .pcd .pcar{display:none}
/* scan: dark, white corners */
#phone#phone#phone .pcd:has(.cam){--bg:#000;--tx:#fff;--mu:#A0A4AE;--chip:#1E1E24;--ln:#2C2C35;background:#000}
#phone#phone#phone:has(.pcd .cam) nav.tabs::before{background:#000!important}
#phone:has(.pcd .cam) nav.tabs{--bg:#000;--tx:#fff;--tt:#8B95A1;background:#000!important}
#phone#phone#phone .pcd:has(.cam) .tabs2 button[aria-selected=true]{background:#34343D}
#phone#phone#phone .pcd .cam{background:#0A0A0E}
#phone#phone#phone .pcd .cam:after{display:none}
#phone#phone#phone .pcd .scn{padding-top:34px}
#phone#phone#phone .pcd .scn h2{font-size:24px;font-weight:800;letter-spacing:-.5px;color:#fff}
#phone#phone#phone .pcd .sub{color:var(--mu)}
#phone#phone#phone .pcd .fr{width:280px;height:280px;margin-top:30px;background:linear-gradient(90deg,transparent,rgba(143,137,255,.9),transparent) no-repeat 0 12%/100% 2px;animation:pc976s 2.6s ease-in-out infinite alternate}
#phone#phone#phone .pcd .fr.ok,#phone#phone#phone .pcd .fr.bad{animation:none;background-image:none}
#phone#phone#phone .pcd .fr i{width:46px;height:46px;border:5px solid #fff;border-radius:0}
#phone#phone#phone .pcd .fr.ok i{border-color:#2DD08B}
#phone#phone#phone .pcd .fr.bad i{border-color:#FF6B5E}
#phone#phone#phone .pcd .fr:before,#phone#phone#phone .pcd .fr:after{display:none}
@keyframes pc976s{to{background-position:0 88%}}
#phone#phone#phone .pcd .pill{background:#26262E;color:#fff}
#phone#phone#phone .pcd .pill[aria-pressed=true]{background:var(--lv);color:#17171C}
#phone#phone#phone .pcd .chl{color:var(--mu)}
#phone#phone#phone .pcd .chips button{background:#26262E;color:#fff}
/* my code */
#phone#phone#phone .pcd .cardbox{margin:16px 20px 0;padding:20px 16px 16px;border-radius:28px;background:var(--chip);color:var(--tx)}
#phone#phone#phone .pcd .cardbox .q{padding:14px;border-radius:20px;border:0;background:#fff}
#phone#phone#phone .pcd .cardbox .q svg{width:176px;height:176px}
#phone#phone#phone .pcd .src{color:var(--tx)}
#phone#phone#phone .pcd .src small{color:var(--mu)}
#phone#phone#phone .pcd .pc17-ring{margin-top:12px}
#phone#phone#phone .pc17-ring .bg{stroke:rgba(143,137,255,.28)}
#phone#phone#phone .pc17-ring .fg{stroke:var(--cta,#6258F5)}
#phone#phone#phone .pc17-ring b{color:var(--tx)}
#phone#phone#phone .pcd .lnk{color:var(--lk)}
#phone#phone#phone .pcd .cardbox+div .lnk:first-child{color:var(--lk)!important}
#phone#phone#phone .pcd .tp723>.lnk,#phone#phone#phone .pcd .cardbox+div .lnk:last-child{color:var(--tt)!important;font-size:12px;border:1px dashed var(--ln);border-radius:13px;padding:0 10px!important;height:26px!important}
/* tap */
#phone#phone#phone .pcd .tp723{flex:1 1 0;min-height:0;display:flex;flex-direction:column;align-items:center;padding:14px 20px 0!important;max-height:none!important;overflow:visible!important}
#phone#phone#phone .pcd .tpf{flex:1 1 0;min-height:0;width:100%;display:flex;flex-direction:column;border:0;border-radius:28px;background:var(--chip)!important;background-image:none!important}
#phone#phone#phone .pcd .tapw{flex:1 1 0;min-height:0}
#phone#phone#phone .pcd .tapw .rg{background:rgba(143,137,255,.16)}
#phone#phone#phone .pcd .tpf .r1{height:94%;width:auto;max-height:250px;aspect-ratio:1}
#phone#phone#phone .pcd .tpf .r2{height:66%;width:auto;max-height:176px;aspect-ratio:1;background:rgba(143,137,255,.3)}
#phone#phone#phone .pcd .tpf .r3{width:92px;height:92px;border-radius:30px;background:var(--cta,#6258F5);color:var(--ctafg,#fff)!important;box-shadow:none}
#phone#phone#phone .pcd .tpb{max-height:none!important;overflow:visible!important;align-items:flex-end;margin:0!important;height:auto!important;padding:6px 22px 20px!important}
#phone#phone#phone .pcd .tpb small{color:var(--mu)}
#phone#phone#phone .pcd .tpb strong{color:var(--tx);font-size:24px;letter-spacing:-.6px}
#phone#phone#phone .pcd .tpb>div:first-child{cursor:pointer;border-radius:10px}
#phone#phone#phone .pcd .tpb strong::after{content:"";display:inline-block;margin-left:8px;vertical-align:4px;border:5px solid transparent;border-top-color:var(--mu);border-bottom:0}
#phone#phone#phone .pcd .tpb>div:first-child:focus-visible{outline:2px solid var(--lv);outline-offset:4px}
#phone#phone#phone .pcd .tpb button.lnk{background:var(--tint)!important;color:var(--tintfg)!important;height:36px!important;min-height:0!important;padding:0 14px!important;border-radius:12px;font-weight:700;font-size:14px!important}
#phone#phone#phone .pcd .tph{color:var(--mu)}
html:root #phone#phone#phone#phone#phone .pcd .tpf{background:var(--chip)!important;background-image:none!important}
/* payment method row */
#phone#phone#phone .pcd .tsm{flex:0 0 auto;display:flex;align-items:center;gap:12px;width:calc(100% - 40px);margin:12px 20px 16px;padding:14px 16px;border:0;border-radius:20px;background:var(--chip);color:var(--tx);font:inherit;text-align:left;cursor:pointer}
#phone#phone#phone .pcd .tsi{width:42px;height:42px;border-radius:14px;background:var(--tint);display:flex;align-items:center;justify-content:center;flex:none;color:var(--tintfg)}
#phone#phone#phone .pcd .tst{flex:1;min-width:0}
#phone#phone#phone .pcd .tst b{display:block;font-size:16px;font-weight:700;letter-spacing:-.2px}
#phone#phone#phone .pcd .tst small{display:block;font-size:13px;color:var(--mu);margin-top:2px}
#phone#phone#phone .pcd .tsc{font-size:14px;font-weight:700;color:var(--lk)}
@media(prefers-reduced-motion:reduce){#phone#phone#phone .pcd .fr{animation:none;background-position:0 50%}}
</style>
<script>
/* v976: language chip in the Pay bar (the Naver Pay flag button), opens the existing language sheet */
try{(function(){const _p=screens.pay;screens.pay=function(){const h=_p.apply(this,arguments);if(typeof h!=='string'||h.indexOf('pclang')>=0)return h;
const d=document.createElement('div');d.innerHTML=h;const t=d.querySelector('.pcd .top');if(!t||!t.lastElementChild)return h;
t.lastElementChild.insertAdjacentHTML('afterbegin','<button class="ib pclang" aria-label="Language" onclick="langSheet()">'+String(S.lang||'en').toUpperCase()+'</button>');return d.innerHTML}})()}catch(e){}
/* v976: tapping a chat message opens Reply / Copy / reactions as a bottom sheet, not a full page. The page converter skips any sheet that already carries data-pgd. */
try{(function(){const _m=window.cvMsg;if(typeof _m!=='function')return;window.cvMsg=function(){const r=_m.apply(this,arguments);const s=document.querySelector('#layer .sheet');if(s)s.dataset.pgd='1';return r}})()}catch(e){}
/* v976: Tap balance switches the pay source; swiping the Pay body moves between Scan, My code and Tap */
try{(function(){const _p=screens.pay;screens.pay=function(){const h=_p.apply(this,arguments);if(typeof h!=='string'||h.indexOf('class="tpb"')<0&&h.indexOf("class='tpb'")<0&&h.indexOf('tpb')<0)return h;
const d=document.createElement('div');d.innerHTML=h;const b=d.querySelector('.pcd .tpb>div');if(b){b.setAttribute('role','button');b.setAttribute('tabindex','0');b.setAttribute('aria-label','Switch pay source')}return d.innerHTML}})()}catch(e){}
try{const sw=()=>{const k=S.psrc==='bank'?'pay':'bank';if(typeof pcSrc==='function')pcSrc(k)};
document.addEventListener('click',e=>{if(e.target.closest&&e.target.closest('.pcd .tpb>div:first-child'))sw()});
document.addEventListener('keydown',e=>{if((e.key==='Enter'||e.key===' ')&&e.target.matches&&e.target.matches('.pcd .tpb>div:first-child')){e.preventDefault();sw()}});
let x0=0,y0=0,ok=false;
document.addEventListener('touchstart',e=>{const t=e.touches[0];ok=!!(e.target.closest&&e.target.closest('.pcd .bd'))&&!e.target.closest('.pcrl,.chips');x0=t.clientX;y0=t.clientY},{passive:true});
document.addEventListener('touchend',e=>{if(!ok)return;ok=false;const t=e.changedTouches[0],dx=t.clientX-x0,dy=t.clientY-y0;if(Math.abs(dx)<60||Math.abs(dx)<Math.abs(dy)*1.5)return;const n=Math.max(0,Math.min(2,(S.pcT||0)+(dx<0?1:-1)));if(n!==S.pcT&&typeof pcTab==='function')pcTab(n)},{passive:true})}catch(e){}
/* v976: Toss-style payment method row under the panel, opens a bottom sheet to pick the source */
try{(function(){const _p=screens.pay;screens.pay=function(){const h=_p.apply(this,arguments);if(typeof h!=='string'||h.indexOf('class="pcd')<0||S.pcT===0)return h;
const d=document.createElement('div');d.innerHTML=h;const bd=d.querySelector('.pcd .bd');if(!bd||bd.querySelector('.tsm'))return h;
const T=window.T3||(a=>a),bank=S.psrc==='bank',n=bank?'itunda Bank':'itunda Pay Money',v=bank?S.bank:S.pay;
bd.insertAdjacentHTML('beforeend','<button class="tsm" onclick="pcMeth()" aria-label="'+T('Pay with','Ishyura ukoresheje','Payer avec')+' '+n+'"><span class="tsi">'+(typeof knot==='function'?knot(24):'')+'</span><span class="tst"><b>'+n+'</b><small>'+fmt(v)+' RWF'+(bank?'':' · 3% back')+'</small></span><span class="tsc">'+T('Change','Hindura','Modifier')+'</span></button>');
return d.innerHTML}})()}catch(e){}
window.pcMeth=function(){const T=window.T3||(a=>a),cur=S.psrc==='bank'?'bank':'pay';
const R=(k,n,s,i,on)=>'<div class="row tap" style="padding:10px 0" onclick="'+on+'"><div class="ico">'+i+'</div><div style="flex:1;min-width:0"><div class="t">'+n+'</div><div class="s">'+s+'</div></div>'+(k===cur?'<span style="color:var(--lk);font-weight:800;font-size:18px">✓</span>':'')+'</div>';
const L=document.getElementById('layer');L.innerHTML='<div class="sheetbg" onclick="closeSheet()"></div><div class="sheet"><div class="h1" style="font-size:22px;line-height:30px;margin-bottom:6px">'+T('Pay with','Ishyura ukoresheje','Payer avec')+'</div>'
+R('pay','itunda Pay Money',fmt(S.pay)+' RWF · 3% back',typeof knot==='function'?knot(26):'',"pcPick('pay')")
+R('bank','itunda Bank',fmt(S.bank)+' RWF',ic('bank',22),"pcPick('bank')")
+R('card',S.card?'itunda card ··'+S.card.last:T('Get the itunda card','Fata ikarita itunda','Obtenir la carte itunda'),'',ic('card',22),"pcPick('card')")
+R('add',T('Add money','Ongeramo amafaranga','Ajouter de l’argent'),'',ic('plus',22),"closeSheet();sheetAdd()")+'</div>';
const s=L.querySelector('.sheet');if(s)s.dataset.pgd='1'};
window.pcPick=k=>{closeSheet();if(k==='card')openCard();else pcSrc(k)};
document.title='itunda, clickable prototype v976';
</script>
<style id="v977css">
/* v977: Places and Directions, calmer */
/* Directions route: the compare line is noise; the map is shorter so the route card shows */
#phone .rsh .cmp,#phone .screen > .cmp{display:none!important}
#phone .rst{padding-bottom:4px}
/* Places hub: flat rows, quiet tiles */
#phone .nvc{background:none!important;border-radius:0!important;box-shadow:none!important;padding:12px 24px!important;min-height:88px!important;margin:0!important}
#phone .nvc .ph{top:12px!important;width:64px!important;height:64px!important}
#phone .nvc .ph>div:first-child{width:64px!important;height:64px!important;border-radius:18px!important;font-size:30px!important;background:var(--chip)!important}
#phone .nvc .n{padding-right:80px}
/* Place page: Directions is the one big action, the rest are quiet icons */
#phone .nm-p{display:flex!important;flex-wrap:wrap;gap:4px 0!important}
#phone .nm-p button{background:none!important;height:60px!important;flex:1 1 0;min-width:0;border-radius:14px!important;font-size:12px!important;font-weight:600!important;color:var(--mu)!important}
#phone .nm-p button i{font-size:22px!important}
#phone .nm-p button.m{flex:0 0 100%!important;flex-direction:row!important;gap:8px!important;height:52px!important;background:var(--br)!important;color:var(--on)!important;font-size:16px!important;font-weight:800!important;border-radius:16px!important;margin-bottom:6px!important}
#phone .oah{margin:10px 24px 0!important}
#phone .oah button{width:100%!important;height:48px!important;border-radius:16px!important;background:var(--chip)!important;color:var(--tx)!important;padding:0 18px!important;justify-content:center}
#phone#phone .oah button{background:var(--chip)!important;color:var(--tx)!important;width:100%!important;height:48px!important;border-radius:16px!important;font-size:15px!important}
#phone#phone .nm-p button.m{background:var(--br)!important;color:var(--on)!important}
/* v978: scrolling chip rows fade at the edge instead of being cut mid-word */
#phone .rst,#phone .rac{-webkit-mask-image:linear-gradient(90deg,#000 calc(100% - 28px),transparent);mask-image:linear-gradient(90deg,#000 calc(100% - 28px),transparent);scrollbar-width:none;scroll-padding-left:20px}
#phone .rst::-webkit-scrollbar,#phone .rac::-webkit-scrollbar{display:none}
#phone .rac{padding-left:16px!important;padding-right:28px!important}
/* v979: map controls: compass only (rotate, tilt, 2D and north-up are hidden); chip rows fade */
#phone .mcc>button:not(:first-child){display:none!important}
#phone div:has(>.ocp){-webkit-mask-image:linear-gradient(90deg,#000 calc(100% - 28px),transparent);mask-image:linear-gradient(90deg,#000 calc(100% - 28px),transparent)}
#phone .rst button{font-size:14px!important;padding-left:12px!important;padding-right:12px!important}
/* v980: place page: one 24px edge for every block; Pay here sits beside Directions */
#phone .sh2 .nm-t,#phone .sh2 .nm-p{padding-left:24px!important;padding-right:24px!important}
#phone .sh2 .hrt,#phone .sh2 .own,#phone .sh2 .cpn,#phone .sh2 .mo{margin-left:24px!important;margin-right:24px!important}
#phone .sh2 .nm-ph{margin-left:24px!important;margin-right:24px!important}
#phone .nm-p.v980 button.m{flex:1 1 0!important}
#phone .nm-p button.pz980{flex:1 1 0!important;flex-direction:row!important;height:52px!important;background:var(--chip)!important;color:var(--tx)!important;font-size:16px!important;font-weight:800!important;border-radius:16px!important;margin:0 0 6px 8px!important}
#phone#phone .nm-p.v980 button.m,#phone#phone .nm-p.v980 button.pz980{flex:0 0 calc(50% - 4px)!important;width:calc(50% - 4px)!important;justify-content:center!important;margin-bottom:6px!important;padding:0 8px!important;white-space:nowrap}
#phone#phone .nm-p.v980 button.pz980{margin-left:8px!important}
#phone .nm-p.v980 button.m i{flex:none}
/* v982: full place page: Directions lives in the bottom bar only; coupon fits one line */
#phone .nv-q button[onclick^="mpDir"]{display:none!important}
#phone .sh2 .cpn button{height:36px!important;padding:0 14px!important;font-size:14px!important;flex:none}
#phone .sh2 .cpn>span{min-width:0;font-size:15px}
#phone .sh2 .cpn>span{flex:1 1 auto!important;font-size:14px!important;white-space:nowrap}
#phone .sh2 .cpn>span *{font-size:inherit}
#phone .sh2 .cpn>span small{display:block;font-size:12px!important}

</style>
<script>
/* v977 */
try{document.title='itunda, clickable prototype v982'}catch(e){}
/* v980: Pay here next to Directions on cafes, food, pharmacies and clinics */
try{(()=>{const fix=()=>{const bar=document.querySelector('#phone .sh2 .nm-p');if(!bar||bar.dataset.v980)return;
const p=(window.POI||[]).find(x=>x.n===(window.PL&&PL.n));if(!p||!/^(cafe|food|pharm|hosp)$/.test(p.c))return;
const m=bar.querySelector('button.m');if(!m)return;bar.dataset.v980='1';bar.classList.add('v980');
const b=document.createElement('button');b.className='pz980';b.dataset.ez672p='1';b.dataset.h44='1';b.innerHTML='<span>'+(window.L?L('Pay here','Ishyura hano','Payer ici'):'Pay here')+'</span>';b.onclick=()=>window.plPay&&plPay();m.after(b)};
new MutationObserver(fix).observe(document.getElementById('phone'),{childList:true,subtree:true});fix()})()}catch(e){console.error('v980',e)}
/* v981: menu tiles get an icon that fits the item (every row showed the same coffee cup) */
window.__menuEmoji=(n,d)=>{const MAP=[[/croissant|pastry|bread|bun/i,'🥐'],[/juice|smoothie/i,'🧃'],[/cake|dessert|tart|donut|doughnut/i,'🍰'],[/sandwich|wrap/i,'🥪'],[/burger/i,'🍔'],[/pizza/i,'🍕'],[/fries|chips/i,'🍟'],[/brochette|skewer|kebab/i,'🍢'],[/chicken/i,'🍗'],[/fish|tilapia/i,'🐟'],[/rice|pilau/i,'🍚'],[/soup|stew/i,'🍲'],[/salad/i,'🥗'],[/samosa|dumpling/i,'🥟'],[/egg|omelette/i,'🍳'],[/tea\b|chai/i,'🍵'],[/beer|wine/i,'🍺'],[/soda|cola|fanta|water/i,'🥤'],[/macchiato|cappuccino|latte|espresso|coffee|americano|mocha/i,'☕']];const m=MAP.find(x=>x[0].test(n||''));return m?m[1]:d};

</script>
<style id="v983">
/* v983: Place and Directions, Toss pass. Name on its own line, one 24px edge, flat route card, quiet text actions. */
#phone .nm-n,#phone .nv-n{font-size:24px!important;line-height:32px!important;letter-spacing:-.4px!important;font-weight:800!important}

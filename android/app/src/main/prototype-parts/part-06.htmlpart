<style id="v1016css">
/* v1016: first visit to Pay, Explore, Messages or You shows list/card skeletons for under half a second. Reuses the v1015 shimmer. */
#phone#phone.v16sk .screen :is(.row,.hr,.gi,.hc):not(.top *){color:transparent!important;border-color:transparent!important;border-radius:16px;background:linear-gradient(100deg,var(--chip) 30%,color-mix(in srgb,var(--chip) 35%,var(--bg)) 50%,var(--chip) 70%) 120% 0/250% 100%!important;animation:v15sh 1.1s linear infinite;box-shadow:none!important}
#phone#phone.v16sk .screen :is(.row,.hr,.gi,.hc):not(.top *) *{color:transparent!important;opacity:0!important}
#phone#phone.v16sk .screen :is(.row,.hr,.gi,.hc):not(.top *)::before,#phone#phone.v16sk .screen :is(.row,.hr,.gi,.hc):not(.top *)::after{opacity:0!important}
</style><script id="v1016js">
(function(){try{
var ph=document.getElementById('phone');if(!ph)return;
if(matchMedia('(prefers-reduced-motion:reduce)').matches)return;
var seen={home:1},busy=0;
new MutationObserver(function(){
 if(busy||!ph.querySelector('.screen'))return;
 var t,stk;try{if(!S.auth)return;t=S.tab;stk=S.stack.length}catch(e){return}
 if(stk||seen[t])return;seen[t]=1;busy=1;
 ph.classList.add('v16sk');setTimeout(function(){ph.classList.remove('v16sk');busy=0},480)
}).observe(ph,{childList:true,subtree:true});
}catch(e){console.error('v1016',e)}})();
</script>
<style id="v1017css">
/* v1017: empty states get an illustration. "No activity yet", "Nothing matches" and the empty watchlist show a soft violet paper-and-sparkles graphic that floats gently. */
#phone#phone .pkempty{text-align:center}
#phone#phone .pkempty::before{content:"";display:block;width:120px;height:96px;margin:0 auto 12px;background:url("data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%22240%22 height=%22192%22 viewBox=%220 0 120 96%22%3E%3Cellipse cx=%2260%22 cy=%2288%22 rx=%2230%22 ry=%224%22 fill=%22%238F89FF%22 opacity=%22.18%22/%3E%3Ccircle cx=%2260%22 cy=%2246%22 r=%2240%22 fill=%22%238F89FF%22 opacity=%22.14%22/%3E%3Cg transform=%22rotate%28-8 60 48%29%22%3E%3Crect x=%2238%22 y=%2224%22 width=%2244%22 height=%2252%22 rx=%229%22 fill=%22%238F89FF%22 opacity=%22.34%22/%3E%3Crect x=%2238%22 y=%2224%22 width=%2244%22 height=%2252%22 rx=%229%22 fill=%22none%22 stroke=%22%238F89FF%22 stroke-width=%222.4%22 opacity=%22.7%22/%3E%3Crect x=%2246%22 y=%2236%22 width=%2228%22 height=%224.5%22 rx=%222.2%22 fill=%22%238F89FF%22 opacity=%22.75%22/%3E%3Crect x=%2246%22 y=%2247%22 width=%2220%22 height=%224.5%22 rx=%222.2%22 fill=%22%238F89FF%22 opacity=%22.5%22/%3E%3Crect x=%2246%22 y=%2258%22 width=%2224%22 height=%224.5%22 rx=%222.2%22 fill=%22%238F89FF%22 opacity=%22.5%22/%3E%3C/g%3E%3Cpath d=%22M92 18l2.6 6.4L101 27l-6.4 2.6L92 36l-2.6-6.4L83 27l6.4-2.6z%22 fill=%22%23FFC837%22/%3E%3Cpath d=%22M24 40l1.8 4.2L30 46l-4.2 1.8L24 52l-1.8-4.2L18 46l4.2-1.8z%22 fill=%22%23FF7A6B%22 opacity=%22.9%22/%3E%3Ccircle cx=%2298%22 cy=%2262%22 r=%223%22 fill=%22%233DD6A3%22/%3E%3C/svg%3E") center/contain no-repeat;animation:v17in .5s cubic-bezier(.2,.9,.3,1.3) both,v17fl 3.4s .5s ease-in-out infinite}
@keyframes v17in{from{opacity:0;transform:scale(.8) translateY(8px)}}
@keyframes v17fl{50%{transform:translateY(-5px)}}
@media (prefers-reduced-motion:reduce){#phone .pkempty::before{animation:none}}
</style>
<style id="v1018css">
/* v1018: pockets with a savings target get a progress ring around their icon, like Toss goal accounts. The ring fills when the row appears. */
#phone#phone .pkico.v18r{position:relative;overflow:visible}
.v18ring{position:absolute;left:-5px;top:-5px;width:calc(100% + 10px);height:calc(100% + 10px);transform:rotate(-90deg);pointer-events:none}
.v18ring circle{fill:none;stroke-width:3;stroke-linecap:round}
.v18ring .t{stroke:var(--ln)}
.v18ring .f{stroke:var(--cta,#6258F5);stroke-dasharray:100;stroke-dashoffset:var(--o,100)}
</style><script id="v1018js">
(function(){try{
var ph=document.getElementById('phone');if(!ph)return;
var rm=matchMedia('(prefers-reduced-motion:reduce)').matches,last={};
var scan=function(){
 ph.querySelectorAll('[onclick*="openPocket("]').forEach(function(row){
  var ic=row.querySelector('.pkico:not(.v18r)');if(!ic)return;
  var m=/openPocket\('([^']+)'\)/.exec(row.getAttribute('onclick')||'');if(!m)return;
  var p;try{p=S.pk.find(function(x){return x.id===m[1]})}catch(e){return}
  if(!p||!p.t||p.t<=0)return;
  var pct=Math.max(0,Math.min(100,pkBal(p)/p.t*100));
  ic.classList.add('v18r');
  ic.insertAdjacentHTML('beforeend','<svg class="v18ring" viewBox="0 0 54 54" aria-hidden="true"><circle class="t" cx="27" cy="27" r="25" pathLength="100"/><circle class="f" cx="27" cy="27" r="25" pathLength="100" style="--o:'+(100-pct)+'"/></svg>');
  var f=ic.querySelector('.v18ring .f'),from=last.hasOwnProperty(p.id)?last[p.id]:0;last[p.id]=pct;
  if(!rm&&f.animate&&from!==pct)f.animate([{strokeDashoffset:100-from},{strokeDashoffset:100-pct}],{duration:900,delay:from?0:250,easing:'cubic-bezier(.2,.9,.2,1)',fill:'backwards'})})};
new MutationObserver(scan).observe(ph,{childList:true,subtree:true});scan();
}catch(e){console.error('v1018',e)}})();
</script>
<style id="v1019css">
/* v1019: Explore gets an offers carousel under the shortcut row, like the Toss and Kakao benefit banners. Three illustrated cards, swipe or wait, dots show where you are. */
.v19b{position:relative}
.v19t{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;border-radius:24px;-webkit-overflow-scrolling:touch;overscroll-behavior-x:contain}
.v19t::-webkit-scrollbar{display:none}
.v19s{flex:0 0 100%;scroll-snap-align:start;border:0;height:132px;border-radius:24px;background:linear-gradient(135deg,var(--a),var(--b));color:#fff;display:flex;align-items:center;justify-content:space-between;padding:0 14px 0 22px;text-align:left;font:inherit;cursor:pointer;overflow:hidden;position:relative;-webkit-tap-highlight-color:transparent}
.v19s:active{filter:brightness(.96)}
.v19x b{display:block;font-size:20px;line-height:26px;font-weight:800;letter-spacing:-.3px}
.v19x small{display:block;margin-top:6px;font-size:13px;font-weight:600;opacity:.85}
.v19s svg{flex:none;width:112px;height:112px;margin-right:2px;animation:v19fl 3.6s ease-in-out infinite}
.v19d{position:absolute;left:22px;bottom:12px;display:flex;gap:5px;pointer-events:none}
.v19d i{width:6px;height:6px;border-radius:3px;background:rgba(255,255,255,.5);transition:width .3s cubic-bezier(.2,.9,.3,1.2),background .3s}
.v19d i.on{width:16px;background:#fff}
@keyframes v19fl{50%{transform:translateY(-5px) rotate(2deg)}}
@media (prefers-reduced-motion:reduce){.v19s svg{animation:none}}
</style><script id="v1019js">
(function(){try{
var ph=document.getElementById('phone');if(!ph)return;
var rm=matchMedia('(prefers-reduced-motion:reduce)').matches;
var gift='<svg viewBox="0 0 112 112" aria-hidden="true"><rect x="22" y="50" width="68" height="46" rx="10" fill="#fff"/><rect x="16" y="38" width="80" height="20" rx="8" fill="#FFE27A"/><rect x="50" y="38" width="12" height="58" fill="#FF7A6B"/><path d="M56 38c-8-16-26-14-22-4s16 6 22 4zM56 38c8-16 26-14 22-4s-16 6-22 4z" fill="#FF7A6B"/><path d="M92 14l2.4 6 6 2.4-6 2.4-2.4 6-2.4-6-6-2.4 6-2.4z" fill="#FFE27A"/></svg>';
var coin='<svg viewBox="0 0 112 112" aria-hidden="true"><ellipse cx="58" cy="96" rx="34" ry="6" fill="#000" opacity=".12"/><circle cx="46" cy="60" r="32" fill="#FFE27A"/><circle cx="46" cy="60" r="25" fill="none" stroke="#F2B90F" stroke-width="3"/><text x="46" y="69" text-anchor="middle" font-size="26" font-weight="800" fill="#C98B00" font-family="system-ui,sans-serif">3%</text><circle cx="82" cy="40" r="17" fill="#fff"/><path d="M75 40l5 5 9-10" fill="none" stroke="#12B886" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round"/></svg>';
var jar='<svg viewBox="0 0 112 112" aria-hidden="true"><ellipse cx="56" cy="98" rx="30" ry="5" fill="#000" opacity=".12"/><rect x="30" y="32" width="52" height="60" rx="16" fill="#fff"/><rect x="36" y="20" width="40" height="16" rx="7" fill="#FFE27A"/><rect x="42" y="52" width="28" height="6" rx="3" fill="#FF8A5B" opacity=".6"/><circle cx="56" cy="74" r="10" fill="#FFC837"/><path d="M56 69v10M51 74h10" stroke="#fff" stroke-width="3" stroke-linecap="round"/><path d="M92 28l2 5 5 2-5 2-2 5-2-5-5-2 5-2z" fill="#fff"/></svg>';
var S3=[['#6258F5','#8F89FF','Invite friends,<br>get 10,000 RWF','Share your code','openSvc(\'invite\')',gift],['#0FA37F','#3DD6A3','3% back when you<br>pay with itunda Pay','Scan to pay and earn','tab(\'pay\')',coin],['#FF7A45','#FFC837','Save toward a goal<br>with Pockets','Set a target and watch it fill','openPockets()',jar]];
var build=function(){
 var xp=ph.querySelector('.xp:not([data-v19])');if(!xp)return;xp.setAttribute('data-v19','1');
 var pills=xp.querySelector('.xpills');if(!pills)return;
 var cs=getComputedStyle(pills),w=document.createElement('div');w.className='v19b';w.setAttribute('role','region');w.setAttribute('aria-label','Offers');
 w.style.margin='12px '+cs.marginRight+' 0 '+cs.marginLeft;
 w.innerHTML='<div class="v19t">'+S3.map(function(s){return '<button class="v19s" style="--a:'+s[0]+';--b:'+s[1]+'" onclick="'+s[4]+'"><span class="v19x"><b>'+s[2]+'</b><small>'+s[3]+'</small></span>'+s[5]+'</button>'}).join('')+'</div><div class="v19d">'+S3.map(function(_,i){return '<i'+(i?'':' class="on"')+'></i>'}).join('')+'</div>';
 pills.parentNode.insertBefore(w,pills.nextSibling);
 var t=w.querySelector('.v19t'),dots=w.querySelectorAll('.v19d i'),pause=0,idx=0;
 var mark=function(){var n=Math.round(t.scrollLeft/Math.max(1,t.clientWidth));if(n!==idx){idx=n;dots.forEach(function(d,k){d.classList.toggle('on',k===n)})}};
 t.addEventListener('scroll',mark,{passive:true});
 ['pointerdown','touchstart','wheel'].forEach(function(n){t.addEventListener(n,function(){pause=Date.now()+8000},{passive:true})});
 if(!rm){var iv=setInterval(function(){if(!w.isConnected){clearInterval(iv);return}
  if(Date.now()<pause||document.hidden)return;var n=(idx+1)%S3.length;t.scrollTo({left:n*t.clientWidth,behavior:'smooth'})},4500)}

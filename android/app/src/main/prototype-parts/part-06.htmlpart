 var wrap=el('div','v22i');wrap.setAttribute('role','group');wrap.setAttribute('aria-label',tr('Index price chart. Drag across to see values.','Graphique de l’indice. Glissez pour voir les valeurs.'));
 var svg=document.createElementNS(NS,'svg');svg.setAttribute('viewBox','0 0 '+VW+' '+VH);svg.setAttribute('preserveAspectRatio','none');svg.setAttribute('aria-hidden','true');
 var area=document.createElementNS(NS,'path'),line=document.createElementNS(NS,'path');

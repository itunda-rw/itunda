#phone#phone#phone .sh2 .tp-main>button{flex:1 1 0!important;min-width:0!important;height:52px!important;border:0!important;border-radius:16px!important;font-size:16px!important;font-weight:700!important;display:flex!important;align-items:center!important;justify-content:center!important;padding:0!important;margin:0!important}
#phone#phone#phone .sh2 .tp-main>button.m{background:var(--br)!important;color:var(--on,#17171C)!important}

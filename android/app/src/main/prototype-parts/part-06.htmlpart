#phone#phone#phone .tp-offers .tp-or small{display:block;margin-top:2px;font-size:13px;font-weight:500;color:var(--mu);line-height:18px}
#phone#phone#phone .tp-offers .tp-or:after{content:"\203A";color:var(--tt);font-size:22px;line-height:1}
#phone#phone#phone .tp-offers>.oah{border-top:1px solid var(--bd,rgba(127,127,127,.16))!important}
#phone#phone#phone .sh2 .nm-m{display:flex!important;align-items:center;justify-content:space-between;width:calc(100% - 48px);margin:8px 24px 0!important;min-height:52px;padding:0!important;border:0!important;background:none!important;font:inherit;font-size:15px!important;font-weight:700!important;color:var(--tx)!important;text-align:left}
#phone#phone#phone .sh2 .nm-m:after{content:"\203A";color:var(--tt);font-size:22px}
/* --- Directions --- */
#phone#phone#phone .modes{display:flex!important;gap:4px!important;margin:12px 24px 0!important;padding:4px!important;border-radius:16px!important;background:var(--chip)!important;overflow:visible!important}
#phone#phone#phone .modes button{flex:1 1 0!important;min-width:0!important;height:40px!important;border:0!important;border-radius:12px!important;background:none!important;color:var(--mu)!important;font-size:14px!important;font-weight:700!important;padding:0 6px!important;gap:6px!important;justify-content:center!important;box-shadow:none!important}
#phone#phone#phone .modes button.on{background:var(--bg)!important;color:var(--tx)!important;box-shadow:0 1px 3px rgba(0,0,0,.12)!important}
#phone#phone#phone .modes button.on svg{stroke:var(--tx)!important;color:var(--tx)!important}
#phone#phone#phone .rst{padding:6px 24px 0!important;margin:0!important;mask-image:none!important;-webkit-mask-image:none!important}
#phone#phone#phone .rst .dpp button{padding:0!important;background:none!important;height:36px;font-size:14px;font-weight:700;color:var(--mu)}
#phone#phone#phone .rsh .rtag{font-size:13px!important;font-weight:600!important;color:var(--mu)!important;background:none!important;padding:0!important}
#phone#phone#phone .rsh .nxt{margin:14px 0 0!important;padding:0!important;text-indent:0!important;font-size:15px!important;font-weight:700!important;color:var(--tx)!important}
#phone#phone#phone .rsh .lb{margin:4px 0 0!important;padding:0!important;text-indent:0!important;font-size:13px!important;font-weight:500!important;color:var(--mu)!important}
#phone#phone#phone .rsh .tpcard{margin:16px 24px 0;padding:16px;border-radius:20px;background:var(--chip);display:flex;align-items:center;gap:12px}
#phone#phone#phone .rsh .tpcard>div{flex:1;min-width:0;font-size:15px;font-weight:700;line-height:22px}
#phone#phone#phone .rsh .tpcard small{display:block;margin-top:2px;font-size:13px;font-weight:500;color:var(--mu);line-height:18px}
#phone#phone#phone .rsh .tpcard .tup{flex:none;margin:0!important;padding:0!important}
#phone#phone#phone .rsh .tpcard .tup button{height:40px;border:0;border-radius:20px;padding:0 16px;font-size:14px;font-weight:700;white-space:nowrap}
#phone#phone#phone .rsh .stp>button.t{display:flex!important;align-items:center;justify-content:space-between;width:100%;min-height:48px;padding:0!important;border:0!important;background:none!important;font:inherit;font-size:15px!important;font-weight:700!important;color:var(--tx)!important;text-align:left}
#phone#phone#phone .rsh .stp>button.t:after{content:"\203A";color:var(--tt);font-size:22px}
#phone#phone#phone .rsh .rxw{display:flex;flex-wrap:wrap;gap:8px;margin:12px 0 0}
#phone#phone#phone .rsh .rxw button{height:36px;border:0;border-radius:18px;padding:0 14px;background:var(--bg);color:var(--tx);font:inherit;font-size:14px;font-weight:600}
</style>
<script>

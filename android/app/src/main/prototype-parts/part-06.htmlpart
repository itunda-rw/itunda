<style id="v1036css">
/* v1036: a back-to-top pill, like Kakao. After you have scrolled a long way down a list and start scrolling back up, a small "Top" pill floats in above the bottom bar; tap it to glide to the top. It hides again when you scroll down or reach the top. */
#phone .v36{position:absolute;left:50%;z-index:30;display:flex;align-items:center;gap:6px;height:38px;padding:0 16px 0 12px;border:0;border-radius:19px;background:var(--tx);color:var(--bg);font-size:14px;font-weight:800;letter-spacing:-.2px;box-shadow:0 6px 18px rgba(0,0,0,.18);opacity:0;pointer-events:none;translate:-50% 14px;transition:opacity .2s,translate .3s cubic-bezier(.2,.9,.3,1.3)}
#phone .v36.on{opacity:1;pointer-events:auto;translate:-50% 0}
#phone .v36 svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:2.6;stroke-linecap:round;stroke-linejoin:round}
#phone .v36:active{scale:.94}
@media (prefers-reduced-motion:reduce){#phone .v36{transition:none}}
</style><script id="v1036js">

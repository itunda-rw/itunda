<style id="v944toss">/* v944, Toss-style pass 59. Repay over: each term is a soft rounded card instead of a divider row. The monthly payment is the big number, the one you are on gets a brand outline, and "Least interest" and "Smallest monthly payment" become small pills. */
#phone .screen button[onclick^="lnTerm("]{border:0!important;border-radius:20px!important;background:var(--chip)!important;padding:18px 20px!important;margin:0 0 12px!important;box-shadow:inset 0 0 0 2px transparent}
#phone .screen button[onclick^="lnTerm("]:has(.ig){background:var(--tint)!important;box-shadow:inset 0 0 0 2px var(--br)}
#phone .screen button[onclick^="lnTerm("]>span:last-child b{font-size:20px!important;font-weight:800!important;letter-spacing:-.4px}
#phone .screen button[onclick^="lnTerm("]>span:last-child .sm{margin-top:4px!important}
#phone .screen button[onclick^="lnTerm("] .sm[style*="--ok"]{display:inline-block!important;margin-top:8px!important;padding:3px 8px;border-radius:10px;white-space:nowrap;letter-spacing:-.2px;background:color-mix(in srgb,var(--ok) 12%,transparent);font-size:12px;line-height:18px}
#phone .screen button[onclick^="lnTerm("]:active{transform:scale(.98)}
#phone .screen div:has(>button[onclick^="lnTerm("]){padding-top:28px!important}
</style>
<style id="v945toss">/* v945, Toss-style pass 60. Loan check page: "You get" is the hero, the monthly payment is one soft highlighted row, the other terms are flat 56px lines with no box, and the button stays pinned. The confirm sheet gets a quiet "Not now" under the main button. */
#phone .screen .v945h{padding:28px 24px 0!important}
#phone .screen .v945h>div:first-child{font-size:15px;color:var(--mu);font-weight:600}

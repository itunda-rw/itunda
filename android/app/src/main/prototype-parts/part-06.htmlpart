/* v993: gray section cards become flat Toss sections: no fill, bigger headings, more air between groups */
#phone#phone#phone .screen .sec{background:transparent!important;border-radius:0!important;margin-left:0!important;margin-right:0!important;padding:28px 24px 4px!important}

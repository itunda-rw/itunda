 var rg=rig(svg,function(){return pts},VW,VH,function(i){var v=vals[i],d=(v/vals[0]-1)*100,up=d>=0;
   bEl.textContent=v.toFixed(2);cEl.className='sm '+(up?'up':'dn');cEl.textContent=(up?'▲ +':'▼ ')+Math.abs(d).toFixed(2)+'%';cap.textContent=labelAt(cur_r,i)},

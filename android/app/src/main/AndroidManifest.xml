<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Real connectivity-triggered offline-queue replay (2026-07-13):
         ConnectivityManager.registerNetworkCallback requires this. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Real "my location" blue dot on the Map screen (2026-07-19): runtime-requested,
         never assumed granted. See MapScreen.kt's own doc comment. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Real camera-based QR scanning (2026-08-11): a customer scanning a merchant's
         itunda://pay QR directly, see features/shop/impl's own CameraQrScanner.kt. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Real push notifications (2026-08-12): Android 13+ (API 33+) requires this
         runtime-requested permission before ANY notification can post, unlike every
         permission above: notifications without it simply never show, no crash, no
         error, which is why NotificationPermissionPrompt.kt exists (see its own doc
         comment) instead of assuming a manifest declaration alone is enough. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".miniapps.ItundaApplication"
        android:allowBackup="true"
        android:label="Itunda"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Itunda">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Authenticated map handoff for Itunda surfaces and partner apps. The
                 only public action today is `itunda://maps`; route/place parameters
                 are deliberately not claimed until their complete contract exists. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="itunda" android:host="maps" />
            </intent-filter>
        </activity>

        <!-- Apps-in-Itunda mini-app host activities, see miniapps/MiniAppActivity.kt -->
        <activity
            android:name=".miniapps.WalletBalanceMiniAppActivity"
            android:theme="@style/Theme.Itunda.MiniApp"
            android:exported="false" />
        <activity
            android:name=".miniapps.PayBillsMiniAppActivity"
            android:theme="@style/Theme.Itunda.MiniApp"
            android:exported="false" />
        <activity
            android:name=".miniapps.RewardTasksMiniAppActivity"
            android:theme="@style/Theme.Itunda.MiniApp"
            android:exported="false" />
        <activity
            android:name=".miniapps.InsuranceMiniAppActivity"
            android:theme="@style/Theme.Itunda.MiniApp"
            android:exported="false" />
        <!-- Real, dynamically-loaded partner mini-app (2026-07-17); see
             miniapps/PartnerMiniAppLoader.kt. Unlike the four above, its JS bundle is
             downloaded at runtime from a real approved partner's bundleUrl, not bundled
             into this app at build time. -->
        <activity
            android:name=".miniapps.PartnerMiniAppActivity"
            android:theme="@style/Theme.Itunda.MiniApp"
            android:exported="false" />

        <!-- Real FCM push (2026-08-12), see ItundaMessagingService.kt's own doc
             comment. exported=false: only the OS/Play Services may deliver to this
             service, never another app on-device. -->
        <service
            android:name=".push.ItundaMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <!-- Real default channel/icon/color metadata FCM's own notification builder
             reads when a data-only or background-delivered notification message is
             shown by the OS directly (no onMessageReceived call at all): without
             these, a backgrounded/killed-app push renders with the generic system
             default icon (a plain bell) instead of itunda's own mark. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_itunda" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/itunda_notification_brand" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="general" />
    </application>
</manifest>

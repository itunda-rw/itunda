<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Real connectivity-triggered offline-queue replay (2026-07-13):
         ConnectivityManager.registerNetworkCallback requires this. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".miniapps.ItundaApplication"
        android:allowBackup="true"
        android:label="Itunda"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Apps-in-Itunda mini-app host activities, see miniapps/MiniAppActivity.kt -->
        <activity
            android:name=".miniapps.WalletBalanceMiniAppActivity"
            android:theme="@style/Theme.Itunda.MiniApp"
            android:exported="false" />
        <activity
            android:name=".miniapps.PayBillsMiniAppActivity"
            android:theme="@style/Theme.Itunda.MiniApp"
            android:exported="false" />
        <activity
            android:name=".miniapps.RewardTasksMiniAppActivity"
            android:theme="@style/Theme.Itunda.MiniApp"
            android:exported="false" />
    </application>
</manifest>

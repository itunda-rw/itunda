{
  "version": "3.0.0",
  "principle": "One semantic contract, native implementation",
  "components": [
    {
      "id": "button",
      "api": "flat",
      "states": [
        "default",
        "pressed",
        "focus",
        "disabled",
        "loading"
      ],
      "content": [
        "long-label",
        "localization",
        "large-text"
      ],
      "a11y": [
        "name",
        "keyboard",
        "target",
        "motion"
      ],
      "platforms": [
        "web",
        "android",
        "ios"
      ],
      "validation": {
        "required": [
          "states",
          "content",
          "a11y",
          "motion",
          "platforms"
        ]
      },
      "guide": {
        "name": "Button",
        "purpose": "Commit an action with clear hierarchy and immediate feedback.",
        "worstCase": "Long localized action label + loading + large text + reduced motion.",
        "tokens": [
          "brand",
          "control-height",
          "focus"
        ],
        "checklist": [
          "stable loading footprint",
          "visible focus",
          "44px+ target"
        ]
      }
    },
    {
      "id": "text-field",
      "api": "flat",
      "states": [
        "empty",
        "filled",
        "focus",
        "disabled",
        "error",
        "success"
      ],
      "content": [
        "long-label",
        "validation",
        "localization",
        "large-text"
      ],
      "a11y": [
        "label",
        "description",
        "invalid",
        "input-method",
        "target",
        "motion"
      ],
      "platforms": [
        "web",
        "android",
        "ios"
      ],
      "validation": {
        "required": [
          "states",
          "content",
          "a11y",
          "motion",
          "platforms"
        ]
      },
      "guide": {
        "name": "Text field",
        "purpose": "Collect one value with persistent context, validation, and recovery.",
        "worstCase": "Long localized label + validation copy + 150% text + error.",
        "tokens": [
          "field-border",
          "field-fill",
          "focus"
        ],
        "checklist": [
          "label stays visible",
          "invalid is semantic",
          "message remains associated"
        ]
      }
    },

      "validation": {
        "required": [
          "states",
          "content",
          "a11y",
          "motion",
          "platforms"
        ]
      },
      "guide": {
        "name": "Select",
        "purpose": "Choose from a constrained set without hiding the current value.",
        "worstCase": "Long localized options + keyboard navigation + disabled/error.",
        "tokens": [
          "surface",
          "border",
          "focus"
        ],
        "checklist": [
          "current value readable",
          "keyboard model",
          "expanded state"
        ]
      }
    },

      },
      "guide": {
        "name": "Empty state",
        "purpose": "Explain why content is absent and offer a useful next action when appropriate.",
        "worstCase": "Long localized title/message + 150% text + actionable recovery.",
        "tokens": [
          "surface-subtle",
          "text-secondary",
          "control-height"
        ],
        "checklist": [
          "message remains readable",
          "action is optional and clear",
          "no clipped content"
        ]

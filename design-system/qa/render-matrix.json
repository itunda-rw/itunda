{
  "schema": "ids-render-matrix/v1",
  "purpose": "Deterministic cross-platform render verification contract. Matrix entries are required verification targets, not proof that a platform has been rendered.",
  "platforms": {
    "web": {
      "themes": ["light", "dark"],
      "scales": [100, 125, 150],
      "motion": ["normal", "reduced"],
      "viewports": [
        {"id": "mobile", "width": 390, "height": 844},
        {"id": "tablet", "width": 768, "height": 1024},
        {"id": "desktop", "width": 1440, "height": 900}
      ]
    },
    "android": {
      "themes": ["light", "dark"],
      "scales": ["100", "125", "150"],
      "motion": ["normal", "reduced"],
      "viewports": [
        {"id": "compact", "widthDp": 360, "heightDp": 800},
        {"id": "expanded", "widthDp": 600, "heightDp": 960}
      ],
      "scaleNote": "Maps to Android system font/display scaling; exact device verification is required."
    },
    "ios": {
      "themes": ["light", "dark"],
      "scales": ["100", "125", "150"],
      "motion": ["normal", "reduced"],
      "viewports": [
        {"id": "compact", "widthPt": 390, "heightPt": 844},
        {"id": "regular", "widthPt": 430, "heightPt": 932}
      ],
      "scaleNote": "Maps to Dynamic Type/accessibility text sizes; exact device verification is required."
    }
  },
  "requiredComponents": [
    "button",
    "text-field",
    "select",
    "checkbox",
    "radio",
    "switch",
    "tabs",
    "empty-state"
  ],
  "scenarioSets": {
    "button": ["button.default", "button.pressed", "button.disabled", "button.loading", "button.long"],
    "text-field": ["textfield.default", "textfield.focus", "textfield.error", "textfield.success", "textfield.long"],
    "select": ["select.placeholder", "select.focus", "select.disabled", "select.error", "select.success", "select.option-disabled"],
    "checkbox": ["checkbox.checked", "checkbox.indeterminate", "checkbox.disabled", "checkbox.error"],
    "radio": ["radio.checked", "radio.disabled", "radio.error", "radio.group"],
    "switch": ["switch.on", "switch.off", "switch.loading", "switch.disabled", "switch.error"],
    "tabs": ["tabs.selected", "tabs.disabled", "tabs.controls", "tabs.roving-focus"],
    "empty-state": ["empty.default", "empty.error", "empty.success", "empty.long"]
  },
  "verificationDimensions": [
    "structure",
    "visual-state",
    "long-localized-content",
    "large-text",
    "theme",
    "reduced-motion",
    "keyboard-or-native-navigation",
    "accessibility-semantics",
    "minimum-target",
    "no-overflow-or-clipping"
  ],
  "evidenceRule": "A matrix entry becomes verified only when real rendered evidence contains the scenario, component, platform, theme, scale, motion, viewport and current platform-contract signatures required by design-system/qa/evidence-schema.json."
}

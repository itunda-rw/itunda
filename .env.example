# Itunda Fintech Platform - Environment Configuration

# API Configuration
NODE_ENV=development
PORT=3000
API_VERSION=v1

# Database
DATABASE_URL=postgresql://itunda:itunda_password@localhost:5432/itunda_ledger
DATABASE_POOL_SIZE=20
DATABASE_POOL_MIN=5

# Redis
REDIS_URL=redis://localhost:6379
REDIS_DB=0

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CONSUMER_GROUP=itunda-services

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=24h
REFRESH_TOKEN_EXPIRATION=7d

# AWS S3 (for document storage, images)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-key
AWS_SECRET_ACCESS_KEY=your-secret
S3_BUCKET=itunda-uploads

# Email Configuration
EMAIL_SERVICE=sendgrid
SENDGRID_API_KEY=your-sendgrid-key
EMAIL_FROM=noreply@itunda.rw

# SMS Configuration (Twilio or Africa's Talking)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-token
TWILIO_PHONE_NUMBER=+1234567890

# Payment Gateway
PAYMENT_GATEWAY=stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLIC_KEY=pk_test_...

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json

# Security
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=15m
RATE_LIMIT_MAX_REQUESTS=100

# AI/ML Services
ML_API_URL=http://localhost:8000
ML_API_KEY=your-ml-api-key

# Third-party Services
CREDIT_BUREAU_API_URL=https://api.creditbureau.rw
CREDIT_BUREAU_API_KEY=your-key

# Feature Flags
FEATURE_CRYPTO_ENABLED=true
FEATURE_INSURANCE_ENABLED=true
FEATURE_LOANS_ENABLED=true
FEATURE_INVESTMENTS_ENABLED=true

# Monitoring
SENTRY_DSN=https://your-sentry-dsn
NEW_RELIC_LICENSE_KEY=your-license-key

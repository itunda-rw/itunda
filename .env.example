# Itunda private-cloud ecosystem defaults
#
# This file matches the actual repository layout as of 2026-07-14:
# - canonical backend: services/backend (Spring Boot + MySQL + Redis + Kafka)
# - web shell: services/micro-frontends/{host-app,bank-mfe,kyc-mfe}
# - gateway: services/api-gateway
# - optional local infra fallback: infra/docker-compose.yml
#
# If you're using the local Multipass private cloud, generate the live values with:
#   yarn env:private-cloud > .env

# Canonical backend / private cloud
DB_HOST=your-mysql-host
DB_PORT=3306
DB_NAME=itunda
DB_USER=itunda
DB_PASSWORD=change-me

REDIS_HOST=your-redis-host
REDIS_PORT=6379

KAFKA_BOOTSTRAP_SERVERS=your-kafka-host:9092
JWT_SECRET=itunda-dev-secret-do-not-use-in-production

# Optional microservice databases
LEDGER_DB_NAME=itunda_ledger
PAYMENT_DB_NAME=itunda_payment

# Gateway targets
BACKEND_URL=http://localhost:4001
LEDGER_SERVICE_URL=http://localhost:8082
PAYMENT_SERVICE_URL=http://localhost:8081

# Local UI ports
HOST_APP_URL=http://localhost:5000
KYC_MFE_URL=http://localhost:5001
BANK_MFE_URL=http://localhost:5002
API_GATEWAY_URL=http://localhost:3000

# Demo-only provider simulation
RNP_GATEWAY_BASE_URL=

# Optional local Docker fallback
# DB_HOST=localhost
# DB_PORT=3307
# REDIS_HOST=localhost
# REDIS_PORT=16379
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092

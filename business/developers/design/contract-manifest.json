        "placeholder",
        "option-disabled"
      ],
      "content": [
        "long-label",
        "long-option",
        "localization",
        "large-text"
      ],
      "a11y": [
        "label",
        "keyboard",
        "selection",
        "disabled-options",
        "target",
        "motion"
      ],
      "platforms": [
        "web",
        "android",
        "ios"

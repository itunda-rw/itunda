    {
      "id": "empty-state",
      "api": "flat",
      "states": [
        "default"
      ],
      "content": [
        "long-title",
        "long-message",
        "localization",
        "large-text"
      ],
      "a11y": [
        "name",
        "message",
        "action",
        "target",
        "motion"

{
  "version": "1.0.0",
  "purpose": "IDS component API and state parity contract. Platform implementations may use native APIs, but public behavior must satisfy the same contract.",
  "components": {
    "button": {
      "variants": [
        "filled",
        "tinted"
      ],
      "sizes": [
        "large",
        "medium",
        "small"
      ],
      "states": [
        "default",
        "pressed",
        "focus",
        "disabled",
        "loading",
        "success",
        "error"
      ],
      "accessibility": [
        "native-button-role",
        "visible-label",
        "state-not-color-only",
        "minimum-touch-target"
      ],
      "requirements": [
        "keyboard-focus-visible",
        "loading-state-announced",
        "disabled-state-prevents-activation",
        "preserve-label-during-loading"
      ],
      "sources": {
        "android": "android/core/designsystem/src/main/java/rw/itunda/core/designsystem/components/IdsButton.kt",
        "ios": "ios/Core/DesignSystem/Sources/Components/Components.swift",
        "web": "client/design-system/components.css"
      }
    },
    "textField": {
      "states": [
        "empty",
        "focused",
        "filled",
        "disabled",
        "loading",
        "error",
        "success"
      ],
      "requirements": [
        "label",
        "supporting-text",
        "error-recovery",
        "keyboard-appropriate-input",
        "screen-reader-state"
      ],
      "sources": {
        "android": "android/core/designsystem/src/main/java/rw/itunda/core/designsystem/components/IdsTextField.kt",
        "web": "client/design-system/components.css",
        "ios": "ios/Core/DesignSystem/Sources/Components/Components.swift"
      },
      "accessibility": [
        "programmatic-label",
        "screen-reader-state",
        "error-associated-with-field",
        "visible-focus"
      ]
    },
    "listRow": {
      "states": [
        "default",
        "pressed",
        "disabled",
        "selected"
      ],
      "requirements": [
        "leading-content",
        "primary-label",
        "secondary-content",
        "trailing-content",
        "touch-target"
      ],
      "sources": {
        "android": "android/core/designsystem/src/main/java/rw/itunda/core/designsystem/components/IdsListRow.kt",
        "ios": "ios/Core/DesignSystem/Sources/Components/Components.swift",
        "web": "client/design-system/components.css"
      },
      "accessibility": [
        "semantic-row-or-button-role",
        "minimum-touch-target",
        "selected-state-announced"
      ]
    },
    "emptyState": {
      "states": [
        "default",
        "with-action"
      ],
      "requirements": [
        "explanation",
        "next-action-when-applicable",
        "localized-content"
      ],
      "sources": {
        "android": "android/core/designsystem/src/main/java/rw/itunda/core/designsystem/components/HoodShared.kt",
        "ios": "ios/Core/DesignSystem/Sources/Components/IdsStateComponents.swift",
        "web": "client/design-system/components.css"
      },
      "accessibility": [
        "meaningful-heading",
        "decorative-art-hidden",
        "action-has-visible-label"
      ]
    },
    "errorState": {
      "states": [
        "recoverable",
        "terminal"
      ],
      "requirements": [
        "human-readable-message",
        "recovery-action-when-possible",
        "preserve-context"
      ],
      "sources": {
        "android": "android/core/designsystem/src/main/java/rw/itunda/core/designsystem/components/HoodShared.kt",
        "ios": "ios/Core/DesignSystem/Sources/Components/Components.swift",
        "web": "client/design-system/components.css"
      },
      "accessibility": [
        "error-announced",
        "recovery-action-has-visible-label",
        "not-color-only"
      ]
    },
    "skeleton": {
      "states": [
        "loading"
      ],
      "requirements": [
        "preserve-layout",
        "reduced-motion-safe",
        "no-essential-information-only-in-animation"
      ],
      "sources": {
        "android": "android/core/designsystem/src/main/java/rw/itunda/core/designsystem/components/HoodShared.kt",
        "web": "client/design-system/components.css",
        "ios": "ios/Core/DesignSystem/Sources/Components/IdsStateComponents.swift"
      },
      "accessibility": [
        "hidden-from-accessibility-tree",
        "no-essential-information-only-in-animation"
      ]
    },
    "bottomCta": {
      "states": [
        "enabled",
        "disabled",
        "loading"
      ],
      "requirements": [
        "keyboard-safe-area",
        "sticky-action",
        "content-scroll-independence",
        "accessible-label"
      ],
      "sources": {
        "android": "android/core/designsystem/src/main/java/rw/itunda/core/designsystem/components/IdsKeyboardDockedButton.kt",
        "ios": "ios/Core/DesignSystem/Sources/Components/Components.swift",
        "web": "client/design-system/components.css"
      },
      "accessibility": [
        "accessible-action-label",
        "keyboard-safe-content",
        "focus-order-preserved"
      ]
    }
  },
  "completionRule": "A component is IDS-complete only when anatomy, variants, states, accessibility, localization, dark mode, responsive/platform behavior and recovery behavior are documented and tested."
}
